clone.self_compile.string.pin.band_pct = 1
clone.self_compile.string.pin.band_anchor = clone.self_compile.string.round_open
# ⭐ A DECLARED INPUT. The value is not a constant of the tree: it moves with the
# absolute path of the checkout, 7 clones per character, attributed to ONE
# CloneId. Two readings taken at different roots are NOT comparable until this
# law is applied — the belief that they were is what produced the 294 discrepancy
# between main and an agent worktree (todo/t0850).
clone.self_compile.string.pin.waiver = tests/integration.rs 2 declared the PINNED-BY / ROUND-OPENED-BY provenance lines
clone.self_compile.string.pin.input = root_path_len
clone.self_compile.string.pin.input.root_path_len.at = 59
clone.self_compile.string.pin.input.root_path_len.law = value + 7 * (root_path_len - 59)
clone.self_compile.string.pin.input.root_path_len.regen = pwd | tr -d '\n' | wc -c

