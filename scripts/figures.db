clone.self_compile.array.round_open.input = none

clone.self_compile.string.pin.value = 31635281
clone.self_compile.string.pin.unit = string_clone calls, stage-0 self-compile
clone.self_compile.string.pin.polarity = exact-pin
clone.self_compile.string.pin.provenance = measured
clone.self_compile.string.pin.regen = cargo test --test integration --release self_host_clone_ceiling -- --nocapture
clone.self_compile.string.pin.regen_extract = \[clone-ceiling\] string_clone=(?P<value>[0-9_,]+)
clone.self_compile.string.pin.regen_fires = \[clone-ceiling\] [a-z_]+=[0-9]+ .*verdict=
clone.self_compile.string.pin.regen_env = GG_BACKEND=unset
clone.self_compile.string.pin.instrument = tests/integration.rs::self_host_clone_ceiling
clone.self_compile.string.pin.measured_at = 4c473a88
