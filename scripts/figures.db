# ═══════════════════════════════════════════════════════════════════════════
# THE NON-MEMBERS — the rows that prove the two axes are axes
# ═══════════════════════════════════════════════════════════════════════════
# ⚠ A schema validated only against shrink-only ratchets would be a class
# reached by resemblance. Every polarity and every provenance below is occupied
# by a row that is NOT a clone meter.

# ── grow-only × measured ───────────────────────────────────────────────────
row = parity.c_emit.match_floor
parity.c_emit.match_floor.value = 1283
parity.c_emit.match_floor.unit = fixtures whose self-host C emission matches Rust gg
parity.c_emit.match_floor.polarity = grow-only
parity.c_emit.match_floor.provenance = measured
parity.c_emit.match_floor.regen = rm -f tests/fixtures/self_host_lowerer/driver tests/fixtures/self_host_lowerer/driver.c; cargo test --test integration --release c_emit_comparison -- --nocapture
parity.c_emit.match_floor.regen_extract = Total: [0-9]+, Matched: (?P<value>[0-9]+)
parity.c_emit.match_floor.regen_fires = === C Emit Comparison Results ===
parity.c_emit.match_floor.regen_env = GG_BACKEND=unset GG_PARITY_FLOOR_OFF=unset
parity.c_emit.match_floor.regen_forbids = MATCH-count floor (skipped|DISABLED)
parity.c_emit.match_floor.instrument = tests/integration.rs::c_emit_comparison
parity.c_emit.match_floor.measured_at = c0c5d59c
parity.c_emit.match_floor.home = tests/integration.rs:C_EMIT_MATCH_FLOOR
parity.c_emit.match_floor.scan = standard
parity.c_emit.match_floor.caveat = linux + default C backend only; under GG_BACKEND the floor is skipped and a DIFFERENT unseeded count is captured by the same regex
parity.c_emit.match_floor.cost_secs = 3600
parity.c_emit.match_floor.mirror = tests/integration.rs:C_EMIT_MATCH_FLOOR
