row = sanitize.leak.uncited_class_pairs.pin
sanitize.leak.uncited_class_pairs.pin.value = 494
sanitize.leak.uncited_class_pairs.pin.unit = (fixture, leak-class) pairs with no citation naming a todo/ item that exists AND names the pair's top frame
sanitize.leak.uncited_class_pairs.pin.polarity = exact-pin
sanitize.leak.uncited_class_pairs.pin.provenance = derived
sanitize.leak.uncited_class_pairs.pin.authority = tests/sanitize/LEAK_ALLOWLIST.txt columns 2 and 3, joined against todo/<id>.md — a pair counts as CITED only when its column-3 entry names an item that EXISTS and whose body CONTAINS the pair's top-frame symbol
sanitize.leak.uncited_class_pairs.pin.regen = awk -F'\t' '{t=$0; sub(/^[ \t]*/,"",t); if(t ~ /^#/) next; g=$0; gsub(/^[ \t]+|[ \t]+$/,"",g); if(g=="") next; ns=split($2,S,","); for(i=1;i<=ns;i++){s=S[i]; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s!="") pr++}} END{print "leak-allowlist pairs scanned=" pr+0}' tests/sanitize/LEAK_ALLOWLIST.txt; awk -F'\t' '{t=$0; sub(/^[ \t]*/,"",t); if(t ~ /^#/) next; g=$0; gsub(/^[ \t]+|[ \t]+$/,"",g); if(g=="") next; nc=split($3,C,","); ns=split($2,S,","); for(i=1;i<=ns;i++){s=S[i]; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s=="") continue; sym=s; sub(/\*[^*]*$/,"",sym); ids=""; for(j=1;j<=nc;j++){e=C[j]; gsub(/^[ \t]+|[ \t]+$/,"",e); p=index(e,"="); if(p==0) continue; k=substr(e,1,p-1); v=substr(e,p+1); gsub(/^[ \t]+|[ \t]+$/,"",k); gsub(/^[ \t]+|[ \t]+$/,"",v); if(k==sym) ids=(ids=="")?v:ids "," v} print sym "|" ids}}' tests/sanitize/LEAK_ALLOWLIST.txt | while IFS='|' read -r sym ids; do c=0; for id in $(printf '%s' "$ids" | tr ',' ' '); do grep -qF -- "$sym" "todo/$id.md" 2>/dev/null && c=1; done; [ "$c" = 0 ] && echo u; done | wc -l | awk '{print "leak-allowlist uncited pairs=" $1}'
sanitize.leak.uncited_class_pairs.pin.regen_extract = leak-allowlist uncited pairs=(?P<value>[0-9]+)
sanitize.leak.uncited_class_pairs.pin.regen_fires = leak-allowlist pairs scanned=[1-9][0-9]*
sanitize.leak.uncited_class_pairs.pin.regen_env = none
sanitize.leak.uncited_class_pairs.pin.instrument = an awk + grep join over the allowlist and todo/, reproducing tests/lints.rs::sanitize_allowlists_shrink_only's own two-part citation test (the item must EXIST and must NAME the symbol)
sanitize.leak.uncited_class_pairs.pin.measured_at = dc0b0024b
sanitize.leak.uncited_class_pairs.pin.home = tests/lints.rs:UNCITED_LEAK_CLASS_PAIRS
sanitize.leak.uncited_class_pairs.pin.scan = standard
sanitize.leak.uncited_class_pairs.pin.caveat = TARGET IS 0, so this number is EVIDENCE OF A GAP, not of health. ⚠ AND THE TOKEN CHECK IS A FLOOR, NOT A LOCK: two frames account for the majority of rows, so one item naming both would satisfy a pair on every one of them. What stops that is the pair granularity plus a reviewer reading the row's ⚖ ADMITTED block — the number says how much is uncited, the block says whether the citation is true
sanitize.leak.uncited_class_pairs.pin.cost_secs = 120
sanitize.leak.uncited_class_pairs.pin.mirror = tests/lints.rs:UNCITED_LEAK_CLASS_PAIRS
sanitize.leak.uncited_class_pairs.pin.waiver = tests/lints.rs 1 declared the constant's own SEEDED-AT note, which spells the value directly above the declaration as the evidence for not seeding at the pre-edit number
sanitize.leak.uncited_class_pairs.pin.input = none

# ── grow-only × policy ─────────────────────────────────────────────────────
# ⛔ AND IT IS `policy`, NOT `measured`, THOUGH THE REGEN RUNS A SWEEP. This is
# exactly the inference this file exists to refuse: `regen` here measures the
# thing the choice CONSTRAINS (how much of the corpus ran), not the choice
# itself. Read the constant's own block — the section is TITLED "WHY IT IS NOT
# RE-PINNED TIGHT TO THE MEASURED `covered`", and it explains that the slack is
# DELIBERATE, to absorb a load-induced BUILD_FAIL on a busy box. THE VALUE WAS
# CHOSEN. It is the `agents_md.size_ceiling` shape, not the
# `parity.c_emit.match_floor` shape.
# ⇒ THE GENERAL RULE: provenance is decided by WHERE THE VALUE CAME FROM, never
# by what the regen happens to run. A `measured` cell here would also FORBID
# `authority` and so delete the pointer to where the choice is recorded.
row = sanitize.coverage_floor
sanitize.coverage_floor.value = 1743
sanitize.coverage_floor.unit = corpus fixtures that produced a RUN verdict under the sanitizer
sanitize.coverage_floor.polarity = grow-only
sanitize.coverage_floor.provenance = policy
sanitize.coverage_floor.authority = scripts/sanitize_sweep.sh:COVERAGE_FLOOR — the choice, and the reason for the slack, are recorded in the comment block titled "WHY IT IS NOT RE-PINNED TIGHT TO THE MEASURED `covered`" directly above it
sanitize.coverage_floor.regen = cargo build && bash scripts/sanitize_sweep.sh
sanitize.coverage_floor.regen_extract = covered:\s+(?P<value>[0-9]+) \(floor [0-9]+\)
sanitize.coverage_floor.regen_fires = === sanitize sweep ===
sanitize.coverage_floor.regen_env = FIXLIST=unset REPS=unset COVERAGE_FLOOR=unset UNKNOWN_CEILING=unset
sanitize.coverage_floor.regen_forbids = no gg at .* run cargo build first|refusing to measure a poisoned box
sanitize.coverage_floor.instrument = scripts/sanitize_sweep.sh
sanitize.coverage_floor.measured_at = dc0b0024b
sanitize.coverage_floor.home = scripts/sanitize_sweep.sh:COVERAGE_FLOOR
sanitize.coverage_floor.scan = standard
sanitize.coverage_floor.caveat = ⛔ THIS ROW IS BLIND TO ITS OWN CONSTANT. `mirror = none` is FORCED, not chosen: the constant is a shell `${VAR:-N}` default, and figures_db_mirrors_agree's `literal_of` returns None for that shape and PANICS the lint rather than reading it. So if someone weakens COVERAGE_FLOOR in the script, NOTHING here goes red — the waiver below is the only thing that even notices the spelling exists. The regen measures `covered`, which is what the floor constrains, never the floor itself
sanitize.coverage_floor.cost_secs = 3600
sanitize.coverage_floor.mirror = none
sanitize.coverage_floor.waiver = scripts/sanitize_sweep.sh 1 declared the `${VAR:-N}` default that IS the constant; mirror = none is forced for that shape, so this waiver is the row's only declaration of the spelling
sanitize.coverage_floor.input = none
sanitize.coverage_floor.note = FIXLIST is in regen_env for the same reason GG_BACKEND is on the parity rows — a restricted FIXLIST captures a tiny `covered` under the very same regex, with the mechanism nominally green

# ── shrink-only × measured — the instrument's own blind spot, ratcheted ────
# ⚠ ADOPTED AFTER READING THE CONSTANT AT dc0b0024b, NOT ITS REPUTATION. Its
# comment block opened "IT IS A CENSUS, NOT A CEILING" until R48 close, thirteen
# lines above the sentence saying it had become a ratchet; that opening was
# corrected, and the block now says plainly that it is enforced fatally at the
# measured value. It qualifies for this table on every clause of the criterion.
# ⚠ `measured`, NOT `policy`, and the difference from its neighbour is the whole
# point: COVERAGE_FLOOR carries deliberate SLACK below the measurement, this one
# is pinned EXACTLY AT it (R47 close, three full-corpus sweeps agreeing, one
# fixture: `test_timeout`). Nothing was chosen except the polarity.
row = sanitize.unknown_ceiling
sanitize.unknown_ceiling.value = 1
sanitize.unknown_ceiling.unit = corpus fixtures whose outcome the sweep's classifier cannot determine
sanitize.unknown_ceiling.polarity = shrink-only
sanitize.unknown_ceiling.provenance = measured
sanitize.unknown_ceiling.regen = cargo build && bash scripts/sanitize_sweep.sh
sanitize.unknown_ceiling.regen_extract = unknown:\s+(?P<value>[0-9]+) \(classifier could not tell
sanitize.unknown_ceiling.regen_fires = === sanitize sweep ===
sanitize.unknown_ceiling.regen_env = FIXLIST=unset REPS=unset COVERAGE_FLOOR=unset UNKNOWN_CEILING=unset
sanitize.unknown_ceiling.regen_forbids = no gg at .* run cargo build first|refusing to measure a poisoned box
sanitize.unknown_ceiling.instrument = scripts/sanitize_sweep.sh
sanitize.unknown_ceiling.measured_at = dc0b0024b
sanitize.unknown_ceiling.home = scripts/sanitize_sweep.sh:UNKNOWN_CEILING
sanitize.unknown_ceiling.scan = none
sanitize.unknown_ceiling.caveat = ⛔ THIS ROW IS BLIND TO ITS OWN CONSTANT, exactly as sanitize.coverage_floor is: `mirror = none` is FORCED by the `${VAR:-N}` shape, so weakening the constant in the script reds NOTHING here. And scan = none is forced too — the value is a single digit — so unlike its neighbour it does not even get a waiver noticing the spelling. ⚠ WHAT IT COUNTS IS NOT A COMPILER DEFECT: every other ceiling in that script counts one, this counts a LIMITATION OF THE INSTRUMENT, and raising it is an admission that the blind spot grew
sanitize.unknown_ceiling.cost_secs = 3600
sanitize.unknown_ceiling.mirror = none
sanitize.unknown_ceiling.input = none
sanitize.unknown_ceiling.note = shares its regen command and env with sanitize.coverage_floor, so figures.py's (command, env) memo spends ONE sweep on both

# ── exact-pin × derived — the soundness list next door ─────────────────────
row = sanitize.corruption.pin
sanitize.corruption.pin.value = 1
sanitize.corruption.pin.unit = rows in tests/sanitize/CORRUPTION_ALLOWLIST.txt
sanitize.corruption.pin.polarity = exact-pin
sanitize.corruption.pin.provenance = derived
sanitize.corruption.pin.authority = tests/sanitize/CORRUPTION_ALLOWLIST.txt — the lint counts its non-comment, non-blank lines; CORRUPTION_CEILING is a hand-kept pin of that count
sanitize.corruption.pin.regen = awk '{t=$0; sub(/^[ \t]*/,"",t); if(t ~ /^#/) next; g=$0; gsub(/^[ \t]+|[ \t]+$/,"",g); if(g=="") next; rows++} END{print "corruption-allowlist census: rows=" rows+0 " (scanned " NR " lines)"}' tests/sanitize/CORRUPTION_ALLOWLIST.txt
sanitize.corruption.pin.regen_extract = corruption-allowlist census: rows=(?P<value>[0-9]+)
sanitize.corruption.pin.regen_fires = \(scanned [1-9][0-9]* lines\)
sanitize.corruption.pin.regen_env = none
sanitize.corruption.pin.instrument = an awk row census over the allowlist, applying the same filter as tests/lints.rs::sanitize_allowlists_shrink_only's `read()` helper
sanitize.corruption.pin.measured_at = dc0b0024b
sanitize.corruption.pin.home = tests/lints.rs:CORRUPTION_CEILING
sanitize.corruption.pin.scan = none
sanitize.corruption.pin.caveat = a single-digit value the uniqueness scanner structurally cannot police, so figures_db_mirrors_agree plus this regen are the whole enforcement. ⚠ THE ONE ROW IS NOT A DEFECT: it is stack_guard_deep_recursion, whose entire purpose is to prove the stack guard fires, so the honest target here is 1 and not 0 — a SECOND row would ship a known use-after-free class
sanitize.corruption.pin.cost_secs = 30
sanitize.corruption.pin.mirror = tests/lints.rs:CORRUPTION_CEILING
sanitize.corruption.pin.input = none

# ── informational × derived — B2, the trend a human actually reads ────────
# ⛔ ONE DELTA IS NOT THE READING, AND THE LINT SAYS SO IN ITS OWN WORDS: fewer
# rows tolerating more records is exactly why three totals exist. So this row's
# extracted integer is the RECORD total — the debt magnitude — and its regen
# prints the whole census, which `check` echoes underneath the delta line for an
# informational row. Read the printed census, not the single number.
# ⚠ AND DO NOT CLAIM THE TREND IS REPORTED EVERY ROUND CLOSE. `figures.py report`
# is wired into NO round-close step (regenerate: grep -rn 'figures.py' scripts/
# AGENTS.md TODO.md). The LIVE anti-forgetting mechanism for this family is
# figures_db_mirrors_agree, which runs in the battery — and it does not cover
# this row, whose `mirror` is `none`. todo/t0860 owns the missing trigger.
row = sanitize.leak.debt.trend
sanitize.leak.debt.trend.value = 2297
sanitize.leak.debt.trend.unit = leak records tolerated at the declared round-open anchor, against which `check` prints the current total and the delta
sanitize.leak.debt.trend.polarity = informational
sanitize.leak.debt.trend.provenance = derived
sanitize.leak.debt.trend.authority = sanitize.leak.records.round_open — this row carries that anchor's value as its `prev`, and its regen reads tests/sanitize/LEAK_ALLOWLIST.txt at HEAD for `now`
sanitize.leak.debt.trend.regen = awk -F'\t' '{t=$0; sub(/^[ \t]*/,"",t); if(t ~ /^#/) next; g=$0; gsub(/^[ \t]+|[ \t]+$/,"",g); if(g=="") next; rows++; ns=split($2,S,","); for(i=1;i<=ns;i++){s=S[i]; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s=="") continue; n=s; sub(/^.*\*/,"",n); if(n ~ /\+$/){loose++; sub(/\+$/,"",n)} pairs++; records+=n+0}} END{print "leak-allowlist census: rows=" rows+0 " pairs=" pairs+0 " records=" records+0 " loose=" loose+0 " (scanned " NR " lines)"}' tests/sanitize/LEAK_ALLOWLIST.txt
sanitize.leak.debt.trend.regen_extract = census: rows=[0-9]+ pairs=[0-9]+ records=(?P<value>[0-9]+) loose=
sanitize.leak.debt.trend.regen_fires = \(scanned [1-9][0-9]* lines\)
sanitize.leak.debt.trend.regen_env = none
sanitize.leak.debt.trend.instrument = the awk census over tests/sanitize/LEAK_ALLOWLIST.txt (the same run the four HEAD-side leak rows share)
sanitize.leak.debt.trend.measured_at = dc0b0024b
sanitize.leak.debt.trend.home = scripts/figures.db (DB-native)
sanitize.leak.debt.trend.scan = none
sanitize.leak.debt.trend.caveat = NEVER RED by definition, and `mirror = none`, so this row has NO automatic gate whatsoever — nothing in the battery evaluates it, and `figures.py report` is in no round-close procedure (todo/t0860). ⚠ A SINGLE DELTA IS A MISREADING: rows and records legitimately move in OPPOSITE directions inside one round, so read the census the instrument prints beneath the delta, not the delta
sanitize.leak.debt.trend.cost_secs = 30
sanitize.leak.debt.trend.mirror = none
sanitize.leak.debt.trend.input = none
sanitize.leak.debt.trend.note = re-seed this value at round open, together with the three `.round_open` anchors; the four move as one and nothing enforces that
