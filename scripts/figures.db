parity.runtime_diff.match_floor.instrument = tests/integration.rs::self_host_runtime_diff
parity.runtime_diff.match_floor.measured_at = dc0b0024b
parity.runtime_diff.match_floor.home = tests/integration.rs:RUNTIME_DIFF_MATCH_FLOOR
