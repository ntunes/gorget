# Round XXIX Track B — POS coverage for Vector methods synced into the
# check-time oracle at `src/semantic/typecheck.rs::builtin_method_type`.
# Each assertion exercises a method whose TYPE was previously silent-
# accepted through the reject site (`has_inherent_only_impls` at
# `src/semantic/traits.rs` returned FALSE for Vector because
# `equip [T] Vector[T]:` at `lib/std/iter.gg:386` added trait impls) —
# widened gate + oracle arm together make each of these correctly TYPED.
#
# AXIS COVERAGE (Core #12): type = Vector · method-family = full sweep
# of drifted cells (swap_remove, swap, fill, clone, count, zip,
# find_index, filter, map, flat_map, fold, reduce, find) · element =
# int (POS cell for value semantics; a String-elem sibling would exercise
# heap Resource semantics but the type axis is what matters for the
# oracle sync — that's Core #12's TYPE-first prioritization).
#
# RED-VERIFY: revert Vector arm additions at typecheck.rs (or the
# GRIN of the widened gate); each `int expected = ...` binding fails
# with `E_TypeMismatch` (unbound type from the missing arm) or the
# call resolves to `error_id` and the whole print shows `<error>`.

void main():
    Vector[int] v = [3, 1, 4, 1, 5, 9, 2, 6]

    # clone(): receiver_type (Vector[int]) — auto-derivable, works even
    # without an oracle arm, but pinned here as the reference-grade shape.
    Vector[int] cloned = v.clone()
    print(cloned.len())        # 8

    # count(closure -> bool): int (LIVE — protocol ret_int; no equip
    # method wraps count).
    int odd = v.count((int x): x % 2 == 1)
    print(odd)                 # 5 (3,1,1,5,9)

    # fill(n, val): void — mutating; drops existing and refills.
    v.fill(3, 7)
    print(v.len())             # 3
    print(v.get(0).unwrap())   # 7

    # swap(i, j): void — swap two positions in place.
    v.set(0, 10)
    v.set(1, 20)
    v.swap(0, 1)
    print(v.get(0).unwrap())   # 20
    print(v.get(1).unwrap())   # 10

    # swap_remove(i): void — protocol says void (Rust convention would
    # return T, filed as follow-up). Vector shrinks by one.
    Vector[int] w = [100, 200, 300]
    w.swap_remove(0)
    print(w.len())             # 2

    # find_index / zip protocol shapes (ret_int / ret_self) DISAGREE
    # with Rust conventions (Option[int] / Vector[Tuple[T,U]]); filed
    # as follow-ups. The oracle carries the protocol shape for
    # defense-in-depth for Deque (which has no equip); on Vector the
    # equip wrapper at lib/std/iter.gg:428 wins for find_index via
    # trait-registry resolution when method-generic F is inferrable.
    # Not asserted here to avoid encoding the disagreement.

    Vector[int] a = [1, 2, 3]

    # find(closure -> bool): Option[T] — LIVE for Deque (Vector's find
    # routes through the equip wrapper at lib/std/iter.gg:425). This
    # asserts the oracle shape is compatible via the equip route.
    Option[int] fnd = a.find((int x): x > 1)
    if fnd is Some(f):
        print(f)               # 2

    # filter/map/fold/reduce — DEAD in Vector (shadowed by
    # infer_closure_method_type LIVE arms). Assertion pins the LIVE
    # path types; the oracle DEAD arm carries the protocol shape for
    # defense-in-depth.
    Vector[int] filtered = a.filter((int x): x >= 2)
    print(filtered.len())      # 2
    Vector[int] mapped = a.map((int x): x * 10)
    print(mapped.get(1).unwrap())  # 20

    # flat_map — Vector-LIVE cross-type via infer_closure_method_type
    # arm added this track. Cross-type: Vector[int] → Vector[String].
    Vector[String] fm = a.flat_map((int x): [f"n{x}"])
    print(fm.len())            # 3
