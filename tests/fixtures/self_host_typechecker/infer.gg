# Expression type inference for auto/inferred variable declarations.
# Given an expression and scope context, returns a type_id or NO_TYPE.

from std.collections import Vector, Dict
from std.conv import parse_int
from ast import SpannedExpr, SpannedType, Span, Type, Expr, Param, Stmt
from ast import EIntLiteral, EFloatLiteral, EBoolLiteral, EStringLiteral
from ast import ECharLiteral, ENoneLiteral, EIdentifier, ESelfExpr
from ast import EBinaryOp, EUnaryOp, ECall, EMethodCall, EFieldAccess
from ast import EIndex, EClosure, EArrayLiteral, ETupleLiteral
from ast import EStructLiteral, EDotShorthand, ETry, EAs, EMove, EPropagate
from ast import EMutableBorrow, EDeref, EIs, EAwait, ESpawn
from ast import EDictLiteral, EDefaultOp, EBlock, EDo, EFString
from ast import ECatch
from ids import NO_DEF, NO_TYPE
from scope import ScopeTable, DefKind, DefInfo
from scope import DkFunction, DkStruct, DkEnum, DkVariant, DkTrait
from scope import DkVariable, DkConst, DkStatic
from types import TypeTable, ResolvedType, get_stype_at, get_rtype_at, get_int_at
from types import RTFunction, RTVoid, RTPrimitive, RTDefined, RTGeneric
from types import RTTuple, RTArray, RTSlice, RTError, RTNever, RTRef, RTVar
from types import ast_type_to_resolved
from types import FunctionSig, MethodSigShape, MethodResolution, ShapeResolution, EquipInfo
from resolve import ResolveContext
from diagnostic import Diagnostic, DkUndefinedName, DkNoFieldFound, DkNotIndexable
from traits import resolve_method_by_name, resolve_method_shape
from traits import resolve_method_full, resolve_method_for_generic_receiver
from traits import infer_method_targs, substitute_return_type, type_name_of
from traits import substitute_shape_return_generic_receiver
from traits import intrinsic_resolve

# ── Statement return type inference (for closure bodies) ──────

int infer_stmt_return_type(Stmt s, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    match s:
        case SExpr(sexpr):
            return infer_expr_type(sexpr, scopes, &types, &ctx)
        # R39 Phase 2e Round-close fix (2026-08-09) + Core #4 class fold
        # from R39 output-review R1: `return` / `throw` / `break` /
        # `continue` all DIVERGE — the enclosing `EDo` / `EBlock`
        # doesn't produce a value, so its type is Never.  Mirrors Rust
        # gg's divergent-tail predicate at `src/semantic/typecheck.rs`
        # `Expr::Block`:4382 and `Expr::Do`:4407
        # (`matches!(&s.node, Stmt::Return(_) | Stmt::Throw(_) | Stmt::Break | Stmt::Continue)`).
        # Load-bearing for `??`'s divergent-RHS suppression at
        # `typecheck.gg` `check_default_op_rhs`:699 (Round XXXIX Track E
        # Option B ratified 2026-08-09: divergent RHS is legal).  The
        # SReturn(Some(_)) branch previously returned the type of the
        # returned expression — but that's the type of the value being
        # returned OUT OF the function, NOT the type of the enclosing
        # `EDo` (which the return diverges past).  Never is the
        # reference-grade type.  `carrier_op_suppress` at
        # `typecheck.gg:671` already suppresses RTNever, so all four
        # arms accept the divergent RHS shapes on `??` (dop_throw_rhs,
        # snag44_closure_throw_diagnosed, dop_return_rhs,
        # dop_return_bare_rhs, dop_break_rhs, dop_closure_throw_rhs).
        case SReturn(_):
            return types.never_id
        case SThrow(_):
            return types.never_id
        case SBreak():
            return types.never_id
        case SContinue():
            return types.never_id
        else:
            return types.void_id
    return types.void_id

# ── Closure return type inference ──────────────────────────────
# Infers a closure's return type using param_types map for local bindings.

int infer_closure_expr_type(SpannedExpr sexpr, Dict[String, int] param_types, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    match sexpr.expr:
        case EIdentifier(name):
            # Check param_types first
            if param_types.contains(name):
                return param_types.get(name).unwrap()
            # Fall through to normal inference
            return infer_expr_type(sexpr, scopes, &types, &ctx)

        case EBinaryOp(left, op, right):
            if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or" or op == "in":
                return types.bool_id
            int lt = infer_closure_expr_type(*left, param_types, scopes, &types, &ctx)
            if lt >= 0:
                return lt
            return infer_closure_expr_type(*right, param_types, scopes, &types, &ctx)

        case EUnaryOp(op, operand):
            if op == "not":
                return types.bool_id
            return infer_closure_expr_type(*operand, param_types, scopes, &types, &ctx)

        case ECall(callee, args, targs):
            return infer_expr_type(sexpr, scopes, &types, &ctx)

        case EMethodCall(obj, method_name, args, targs):
            return infer_expr_type(sexpr, scopes, &types, &ctx)

        else:
            return infer_expr_type(sexpr, scopes, &types, &ctx)
    return types.void_id

int infer_closure_return_type(Stmt s, Dict[String, int] param_types, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    match s:
        case SExpr(sexpr):
            return infer_closure_expr_type(sexpr, param_types, scopes, &types, &ctx)
        # R39 Phase 2e Round-close R2 (Core #4 sibling of the class fold
        # in `infer_stmt_return_type` above — same divergent-tail
        # enumeration).  A closure body ending in `return` / `throw` /
        # `break` / `continue` has return type Never (the body doesn't
        # produce a value; it diverges).  Load-bearing for `??`'s
        # divergent-RHS suppression when the RHS is a closure like
        # `(): throw x` used through a Callable-typed sink.
        case SReturn(_):
            return types.never_id
        case SThrow(_):
            return types.never_id
        case SBreak():
            return types.never_id
        case SContinue():
            return types.never_id
        else:
            return types.void_id
    return types.void_id

# ── Expression type inference ──────────────────────────────────
#
# Per-expression typed metadata is recorded into `types.expr_types`
# (`Span.start → ResolvedType id`) at sites the lowerer needs to
# query later — the architectural single-source-of-truth for
# expression types (Layering rule 3). The recording is targeted
# rather than uniform across all expressions: a global wrapper that
# recorded every recursive call cost ~100s on self-host's own source
# (≈1M expression nodes, each Dict.put non-trivial). Today the only
# downstream consumer is `lower_expr`'s EMethodCall path, which
# queries by the call's outer span; targeted recording at the
# EMethodCall arm in `infer_expr_type` covers that without paying
# the across-the-board recursive cost. Extend the recording to other
# Expr variants as the lowerer grows new query sites.

# Round XXXIX Track E (owner Option B + LAZY 2026-08-09): helpers for the
# `??` canonical-type computation. Mirror of typecheck.gg's
# `default_op_inner_type` / `default_op_rhs_matches_carrier`, kept local to
# infer.gg so the EBinaryOp arm can call them during type inference (before
# typecheck.gg's carrier-ops walker runs).
int default_op_carrier_inner_type(int type_id, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return -1
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTGeneric(_def_id, targs):
            if targs.len() > 0:
                return targs.get(0).unwrap()
            return -1
        else:
            return -1

# True iff `lhs_type` and `rhs_type` are the same Option/Result carrier shape
# (structurally equal type-args). Type ids are interned so element equality
# is reliable.
bool default_op_carrier_shape_equals(int lhs_type, int rhs_type, TypeTable types):
    if lhs_type < 0 or lhs_type >= types.types.len():
        return false
    if rhs_type < 0 or rhs_type >= types.types.len():
        return false
    ResolvedType lrt = get_rtype_at(types.types, lhs_type)
    ResolvedType rrt = get_rtype_at(types.types, rhs_type)
    match lrt:
        case RTGeneric(l_def, l_targs):
            match rrt:
                case RTGeneric(r_def, r_targs):
                    if l_def != r_def:
                        return false
                    if l_targs.len() != r_targs.len():
                        return false
                    int i = 0
                    while i < l_targs.len():
                        if l_targs.get(i).unwrap() != r_targs.get(i).unwrap():
                            return false
                        i += 1
                    return true
                else:
                    return false
        else:
            return false

int infer_expr_type(SpannedExpr sexpr, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    Expr e = sexpr.expr
    int span_start = sexpr.span.start

    match e:
        case EIntLiteral(n):
            return types.int_id

        case EFloatLiteral(f):
            return types.float_id

        case EBoolLiteral(b):
            return types.bool_id

        case EStringLiteral(s, has_interp):
            if has_interp:
                return types.owned_string_id
            return types.string_id

        case EFString(template, exprs, _specs):
            # f-strings always materialise as owned String — the
            # interpolation segments concat with the literal pieces.
            return types.owned_string_id

        case ECharLiteral(c):
            return types.char_id

        case ENoneLiteral():
            return types.error_id

        case ESelfExpr():
            if types.self_type_id >= 0:
                return types.self_type_id
            return types.error_id

        case EIdentifier(name):
            # Look up via resolution map
            if ctx.resolution_map.contains(span_start):
                int def_id = ctx.resolution_map.get(span_start).unwrap()
                DefInfo d = scopes.get_def(def_id)
                if d.type_id >= 0:
                    return d.type_id
                # If it's a struct/enum name used as constructor, return defined type
                bool is_type = false
                match d.kind:
                    case DkStruct():
                        is_type = true
                    case DkEnum():
                        is_type = true
                    else:
                        pass
                if is_type:
                    return types.defined_id(def_id)
                # Fallback: search parent scopes for same-named def with type
                # (handles with-binding defs that shadow outer typed defs)
                int pscope = scopes.scope_parent_of(d.scope_id)
                if pscope >= 0:
                    if scopes.lookup_from_scope(pscope, name) is Some(alt_def):
                        DefInfo alt_d = scopes.get_def(alt_def)
                        if alt_d.type_id >= 0:
                            return alt_d.type_id
            return NO_TYPE

        case ECall(callee, args, targs):
            # Infer callee type, extract return type from RTFunction
            int callee_type = infer_expr_type(SpannedExpr((*callee).expr, (*callee).span), scopes, &types, &ctx)
            if callee_type >= 0 and callee_type < types.types.len():
                ResolvedType ct = get_rtype_at(types.types, callee_type)
                match ct:
                    case RTFunction(params, ownerships, ret_id):
                        return ret_id
                    case RTDefined(def_id):
                        # Constructor call — return the defined type,
                        # possibly with call-site type args
                        # (e.g. `Vector[int](...)` → RTGeneric).
                        if targs.len() > 0:
                            Vector[int] targ_ids = Vector[int]()
                            for ta in targs:
                                int ta_id = ast_type_to_resolved(ta.ty, ta.span, scopes, &types)
                                targ_ids.push(ta_id)
                            return types.add_type(!RTGeneric(def_id, targ_ids))
                        return callee_type
                    case RTGeneric(def_id, type_args):
                        # Generic constructor — return the generic type
                        return callee_type
                    else:
                        pass
            # Check if callee is an identifier we can look up directly
            match (*callee).expr:
                case EIdentifier(name):
                    if ctx.resolution_map.contains((*callee).span.start):
                        int def_id = ctx.resolution_map.get((*callee).span.start).unwrap()
                        DefInfo d = scopes.get_def(def_id)
                        bool is_struct = false
                        match d.kind:
                            case DkStruct():
                                is_struct = true
                            else:
                                pass
                        bool is_enum = false
                        match d.kind:
                            case DkEnum():
                                is_enum = true
                            case DkVariant():
                                is_enum = true
                            else:
                                pass
                        if is_struct or is_enum:
                            if targs.len() > 0:
                                Vector[int] targ_ids = Vector[int]()
                                for ta in targs:
                                    int ta_id = ast_type_to_resolved(ta.ty, ta.span, scopes, &types)
                                    targ_ids.push(ta_id)
                                return types.add_type(!RTGeneric(def_id, targ_ids))
                            return types.defined_id(def_id)
                else:
                    pass
            return NO_TYPE

        case EStructLiteral(name, field_names, field_values):
            # Look up struct by name
            if scopes.lookup(name) is Some(def_id):
                return types.defined_id(def_id)
            return NO_TYPE

        case EDotShorthand(variant_name, args):
            # .Variant() — type comes from context, not inferable standalone
            return NO_TYPE

        case EBinaryOp(left, op, right):
            # Comparison/logical operators return bool
            if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or" or op == "in":
                return types.bool_id
            int lt = infer_expr_type(SpannedExpr((*left).expr, (*left).span), scopes, &types, &ctx)
            # Round XXXIX Track E (owner Option B + LAZY 2026-08-09):
            # `??` canonical type:
            #   inner T (unwrap form):        `Option[T] ?? T` → T
            #   same carrier (peel-outer):    `Option[T] ?? Option[T]` → Option[T]
            #   divergent RHS:                `Option[T] ?? throw` → T
            # Record into `expr_types` so the lowerer picks the right shape
            # (Layering rule 3 — one source of truth). Reject on wrong RHS is
            # driven from typecheck.gg's `check_default_op_rhs`; this arm just
            # types the result.
            if op == "??":
                int rt = infer_expr_type(SpannedExpr((*right).expr, (*right).span), scopes, &types, &ctx)
                int qq_inner = default_op_carrier_inner_type(lt, types)
                int qq_canonical = lt
                if rt >= 0 and rt < types.types.len():
                    ResolvedType rrt = get_rtype_at(types.types, rt)
                    bool rt_never = false
                    bool rt_var = false
                    bool rt_error = false
                    match rrt:
                        case RTNever():
                            rt_never = true
                        case RTVar(_):
                            rt_var = true
                        case RTError():
                            rt_error = true
                        else:
                            pass
                    if rt_never or rt_var or rt_error:
                        # Divergent / suppression → canonical is inner T
                        # (or LHS carrier if inner extraction failed).
                        if qq_inner >= 0:
                            qq_canonical = qq_inner
                    elif default_op_carrier_shape_equals(lt, rt, types):
                        # RHS matches LHS carrier → peel outer.
                        qq_canonical = lt
                    elif qq_inner >= 0 and qq_inner == rt:
                        # RHS unifies with inner T → unwrap.
                        qq_canonical = qq_inner
                    else:
                        # Mismatch — reject is driven from typecheck.gg's
                        # check_default_op_rhs. Fall through with inner T as
                        # a safe canonical so downstream infer doesn't crash.
                        if qq_inner >= 0:
                            qq_canonical = qq_inner
                types.expr_types.put(sexpr.span.start, qq_canonical)
                return qq_canonical
            # Arithmetic/bitwise: return type of left operand
            return lt

        case EUnaryOp(op, operand):
            if op == "not":
                return types.bool_id
            # neg, bitnot, deref: return operand type
            int ot = infer_expr_type(SpannedExpr((*operand).expr, (*operand).span), scopes, &types, &ctx)
            return ot

        case EFieldAccess(obj, field_name):
            # Look up struct field type from the field types table
            int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            if obj_type >= 0 and obj_type < types.types.len():
                ResolvedType ort = get_rtype_at(types.types, obj_type)
                match ort:
                    case RTDefined(def_id):
                        DefInfo d = scopes.get_def(def_id)
                        String key = f"{d.name}.{field_name}"
                        if types.variant_field_types.contains(key):
                            return types.variant_field_types.get(key).unwrap()
                        # NOTE: a concrete-struct absent-field reject would go
                        # HERE, but the self-host `variant_field_types` table is
                        # INCOMPLETE (misses generic-struct / imported / equip
                        # fields → 45 false positives measured), so it is NOT a
                        # sound "definitely absent" signal. A sound struct reject
                        # needs a complete per-struct field registry — filed as
                        # a follow-up (see RV-A scout report).
                    case RTPrimitive(pname):
                        # `.field` on a primitive (String/int/…) is always
                        # invalid — no named fields exist. REJECT.
                        ctx.diagnostics.push(Diagnostic.error(sexpr.span, DkNoFieldFound(), "no field `" + field_name + "` found on type `" + pname + "`"))
                    case RTTuple(elems):
                        # Tuple index by field: both bare `.0`/`.1` and the
                        # `._0`/`._1` alias (language-reference §4.2/§7.8) index
                        # the tuple. The self-host parser folds BOTH into
                        # EFieldAccess{name} (parser.gg — there is no separate
                        # tuple-index node), so this arm must accept the bare
                        # digit form too; any non-numeric name is absent.
                        int tuple_idx = -1
                        if field_name.starts_with("_") and field_name.len() >= 2:
                            match parse_int(field_name.byte_slice(1, field_name.len())):
                                case Ok(i):
                                    tuple_idx = i
                                else:
                                    pass
                        else:
                            match parse_int(field_name):
                                case Ok(i):
                                    tuple_idx = i
                                else:
                                    pass
                        if tuple_idx >= 0:
                            # Numeric tuple index. Return the element type when in
                            # range; when the index is beyond the CURRENTLY-resolved
                            # element list, return NO_TYPE rather than error — the
                            # self-host's tuple types can be under-resolved (e.g. a
                            # synthetic N-tuple param desugared from closure tuple
                            # destructuring mis-sizes to fewer elements), and the
                            # lowering indexes the real runtime tuple correctly.
                            # Erroring here false-rejects valid programs Rust accepts.
                            if tuple_idx < elems.len():
                                return elems.get(tuple_idx).unwrap()
                            return NO_TYPE
                        # Non-numeric name on a tuple → genuinely absent.
                        ctx.diagnostics.push(Diagnostic.error(sexpr.span, DkNoFieldFound(), "no field `" + field_name + "` found on tuple type"))
                    else:
                        pass
            return NO_TYPE

        case EMethodCall(obj, method_name, args, targs):
            # Trait registry lookup: user-defined equip methods win over the
            # hardcoded collection-method fallback chain below. Returns -1
            # (skip) if the receiver type isn't registered, the method
            # isn't found, or method-generic inference can't resolve the
            # return type cleanly. The hardcoded chain still owns built-in
            # collection runtime methods (Vector.get, Dict.keys, …) where
            # no equip block exists in user-space.
            int reg_obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            if reg_obj_type >= 0 and reg_obj_type < types.types.len():
                MethodResolution reg_res = resolve_method_full(reg_obj_type, method_name, scopes, &types)
                # Receiver-by-name fallback for cases where the receiver's
                # TypeId came back as `defined_id` of an imported type that
                # the registry indexed by its name in another module.
                if not reg_res.found:
                    String recv_name = ""
                    String recv_prim_name = ""
                    Vector[int] recv_targs = Vector[int]()
                    bool is_generic_recv = false
                    ResolvedType reg_obj_rt = get_rtype_at(types.types, reg_obj_type)
                    match reg_obj_rt:
                        case RTDefined(rdef):
                            DefInfo rd = scopes.get_def(rdef)
                            recv_name = rd.name
                        case RTGeneric(rdef, type_args):
                            DefInfo rd = scopes.get_def(rdef)
                            recv_name = rd.name
                            recv_targs = type_args
                            is_generic_recv = true
                        case RTPrimitive(pname):
                            recv_prim_name = pname
                        else:
                            pass
                    # Generic-receiver path: substitution-aware, handles
                    # chained adapter calls like `t1.take(3)` where t1 is
                    # `TakeIter[X, Y]` and the impl is generic over [I, T].
                    if is_generic_recv and recv_name.len() > 0:
                        reg_res = resolve_method_for_generic_receiver(recv_name, recv_targs, reg_obj_type, method_name, scopes, &types)
                    if not reg_res.found and recv_name.len() > 0:
                        reg_res = resolve_method_by_name(types.trait_registry, recv_name, method_name)
                    # Phase 4: intrinsic satisfaction for primitives. Looks
                    # up built-in trait methods that the primitive
                    # intrinsically satisfies (e.g. int.add → Add.add,
                    # str.display → Displayable.display) and substitutes
                    # `Self` placeholders to the receiver's TypeId.
                    if not reg_res.found and recv_prim_name.len() > 0:
                        reg_res = intrinsic_resolve(types.trait_registry, recv_prim_name, reg_obj_type, types.error_id, method_name)
                if reg_res.found:
                    # Generic methods: try Shape-1/2 inference. Compute arg
                    # types up front and feed them to the shape resolver.
                    int reg_ret = reg_res.sig.return_type
                    Vector[int] reg_arg_types = Vector[int]()
                    for a in args:
                        reg_arg_types.push(infer_expr_type(a.value, scopes, &types, &ctx))
                    ShapeResolution sh = resolve_method_shape(types.trait_registry, reg_obj_type, method_name)
                    # Lazy-iterator phase 1b Blocker #2: the TypeId-keyed
                    # shape lookup above fails for a monomorphized generic
                    # receiver (e.g. VectorIter[int]) whose concrete TypeId
                    # never equals the impl's abstract placeholder self_type.
                    # Fall back to the by-NAME shape resolver so `bound`
                    # actually computes for the bare-form terminal calls.
                    if not sh.found:
                        String sh_recv_name = ""
                        ResolvedType sh_recv_rt = get_rtype_at(types.types, reg_obj_type)
                        match sh_recv_rt:
                            case RTDefined(sh_rdef):
                                sh_recv_name = scopes.get_def(sh_rdef).name
                            case RTGeneric(sh_rdef, _):
                                sh_recv_name = scopes.get_def(sh_rdef).name
                            else:
                                pass
                        if sh_recv_name.len() > 0:
                            sh = resolve_method_shape_for_generic_receiver(types.trait_registry, sh_recv_name, method_name)
                    if sh.found:
                        Vector[int] bound = infer_method_targs(sh.shape, reg_arg_types, scopes, types)
                        # EXPLICIT TURBOFISH OVERRIDES INFERENCE. When the call
                        # site wrote turbofish args (`filter_map[int, Option[int](int)]`),
                        # those are the AUTHORITATIVE bindings for the method's
                        # generic params — they win over whatever `infer_method_targs`
                        # guessed. This is load-bearing for the `[U, F]` adapters
                        # (`filter_map`) whose `next` return mentions `U` but whose
                        # only PARAM is `F`: with no `U`-bearing param, the inference
                        # fallback (traits.gg:842) binds `U` from the closure's
                        # RETURN type (`Option[int]`) — but the user wrote `U=int`
                        # (the yielded element type). Honoring the turbofish keeps
                        # the struct instance recorded in `expr_link_types` (→ the
                        # SFor loop-var type + its mono'd `next`) IN AGREEMENT with
                        # the constructor's return type, which already honors the
                        # turbofish. Positional, resolved through the same
                        # `ast_type_to_resolved` the struct ctor uses, so the bound
                        # tid is byte-identical — no name-matching. Only overrides
                        # positions the turbofish actually supplied; a cleanly
                        # resolved tid replaces the inferred one (a partial /
                        # unresolved turbofish leaves the inferred value intact).
                        if targs.len() > 0:
                            int tfi = 0
                            while tfi < targs.len() and tfi < bound.len():
                                SpannedType tf_arg = targs.get(tfi).unwrap()
                                int tf_tid = ast_type_to_resolved(tf_arg.ty, tf_arg.span, scopes, &types)
                                if tf_tid >= 0 and tf_tid != types.error_id:
                                    bound.set(tfi, tf_tid)
                                tfi = tfi + 1
                        # For a GENERIC adapter receiver (RTGeneric, e.g.
                        # `TakeIter[VectorIter[int], int]`), a method-generic
                        # trait-default whose return type mentions `Self`/impl-`T`
                        # (the adapter constructors `filter[F]`/`map[U,F]`/…)
                        # needs the FULL binding set (Self + impl + trait + method),
                        # not just the method generics — otherwise `Self`/`T` stay
                        # unbound and the lazy chain mis-types to `FilterIter[int,…]`.
                        # Try the full-binding path first; fall back to the plain
                        # method-only substitution for base / non-adapter receivers.
                        int subst_ret = -1
                        ResolvedType subst_recv_rt = get_rtype_at(types.types, reg_obj_type)
                        match subst_recv_rt:
                            case RTGeneric(subst_rdef, subst_recv_args):
                                String subst_recv_name = scopes.get_def(subst_rdef).name
                                subst_ret = substitute_shape_return_generic_receiver(subst_recv_name, subst_recv_args, reg_obj_type, sh.shape, bound, scopes, &types)
                            else:
                                pass
                        if subst_ret < 0 or subst_ret == types.error_id:
                            subst_ret = substitute_return_type(sh.shape, bound, scopes, &types)
                        if subst_ret >= 0 and subst_ret != types.error_id:
                            reg_ret = subst_ret
                        # Lazy-iterator phase 1b: record the inferred
                        # method-level targs into the side-table so the
                        # lowerer can monomorphize the bare-form terminal
                        # call to the same userland adapter symbol the
                        # turbofish form produces. Only record when EVERY
                        # method-targ bound cleanly (no -1 / error) AND the
                        # method actually HAS method-level generics — a
                        # shape with zero generic_params would record an
                        # empty vector, which the lowerer must not treat as
                        # a method-generic call.
                        #
                        # SCOPE GATE (phase 1b = TERMINALS ONLY): the lazy
                        # ADAPTERS (`map`/`filter`/`filter_map`) are phase
                        # 1b-iii — their trait-default body CONSTRUCTS a
                        # closure-bearing adapter struct (`MapIter`/`FilterIter`)
                        # whose make-site zero-stores the `GorgetClosure` field
                        # (a separate closure-in-struct ABI fix). Monomorphizing
                        # them here re-emits the receiver's `iter()` body twice
                        # (a duplicate-definition link error). The terminals
                        # (`fold`/`any`/`all`/`find`/`find_index`/`for_each`)
                        # instead call `F` directly inside a `for x in self`
                        # loop and return a scalar/Option — the in-scope set.
                        # This name set IS the owner-drawn phase boundary, not a
                        # semantic decision; 1b-iii replaces it with the typed
                        # closure-bearing-adapter discriminator.
                        bool is_terminal_method = method_name == "fold" or method_name == "any" or method_name == "all" or method_name == "find" or method_name == "find_index" or method_name == "for_each"
                        # Lazy-iterator phase 1b-iii: admit the closure-bearing
                        # ADAPTERS (`map`/`filter`/`filter_map`) via a TYPED
                        # discriminator rather than a 7th hard-coded name. The
                        # adapter's method-targ set carries the closure `F`, so
                        # `bound_has_closure` is true iff ANY inferred targ
                        # resolves to `RTFunction` (a real ResolvedType variant,
                        # `types.gg:18`; `resolved_to_gir_type` already maps
                        # `RTFunction → GorgetClosure`). This makes the bare-form
                        # `.map(double)` (no turbofish) record its inferred targs
                        # so the lowerer mangles to the mono'd
                        # `MapIter__…__GorgetClosure`. (The TURBOFISH form carries
                        # explicit targs already, so this gate is foundation for
                        # the bare form, not load-bearing for that path.)
                        bool bound_has_closure = false
                        for bt in bound:
                            if bt >= 0 and bt < types.types.len():
                                match get_rtype_at(types.types, bt):
                                    case RTFunction(_, _, _):
                                        bound_has_closure = true
                                    else:
                                        pass
                        if (is_terminal_method or bound_has_closure) and sh.shape.generic_params.len() > 0:
                            bool all_bound = true
                            for bt in bound:
                                if bt < 0 or bt == types.error_id:
                                    all_bound = false
                            if all_bound:
                                # Key on the call's UNIQUE span.END, not span.start.
                                # The parser shares ONE span.start across a whole
                                # method chain, so a chain with TWO method-generic
                                # links (`v.iter().take(N).filter(p).map(f)` — both
                                # `.filter[F]` AND `.map[U,F]`) collides on
                                # span.start: only the last `put` survives, so the
                                # other link's bare-form proto records NO targs and
                                # its adapter-constructor method is CALLED-but-never-
                                # DEFINED (CC-fail). span.end is unique per link
                                # (same invariant `expr_link_types` already relies
                                # on), so every method-generic link in the chain
                                # keeps its own targs. The method NAME is still
                                # recorded as a cheap cross-check for the reader.
                                types.expr_method_targs.put(sexpr.span.end, bound)
                                types.expr_method_targs_name.put(sexpr.span.end, method_name)
                    # Receiver-generic substitution: if the method's return
                    # type is `T` and the receiver is `Vector[T]`-shaped,
                    # bind T to the receiver's i-th type arg. We piggy-back
                    # on the registered impl's self_type_ast: the impl's
                    # self_type_ast is `Foo[T]`; binding `T → arg_i` from
                    # the receiver's RTGeneric type_args lets us resolve
                    # `T`-shaped returns without a method-level shape.
                    if reg_ret == types.error_id:
                        ResolvedType reg_obj_rt2 = get_rtype_at(types.types, reg_obj_type)
                        match reg_obj_rt2:
                            case RTGeneric(_, recv_type_args):
                                # Find the matching impl and read its
                                # self_type_ast generic-arg names.
                                int impl_i = 0
                                while impl_i < types.trait_registry.impls.len():
                                    EquipInfo impl_info = types.trait_registry.impls.get(impl_i).unwrap()
                                    if impl_info.self_type == reg_obj_type:
                                        # impl_generic_params lines up
                                        # positionally with recv_type_args.
                                        # We don't have a method shape
                                        # (covered above) — this branch
                                        # only fires when the method's
                                        # return type is bare `T`, so
                                        # without a shape we can't tell
                                        # which generic; skip.
                                        impl_i = types.trait_registry.impls.len()
                                    impl_i = impl_i + 1
                            else:
                                pass
                    if reg_ret >= 0 and reg_ret != types.error_id and reg_ret != types.void_id:
                        # Record into the per-expression side-table so the
                        # lowerer can query the resolved return type for
                        # method-generic calls it can't reconstruct from
                        # fn_sigs (Gap #2 Phase 1 — single source of truth
                        # for method-generic return types).
                        types.expr_types.put(span_start, reg_ret)
                        # Lazy-iterator chain-link oracle: ALSO record this
                        # link's resolved type keyed on the call's UNIQUE
                        # span.END. The parser shares one span.start across a
                        # whole chain, so `expr_types` (keyed on span.start)
                        # collapses every link onto the outermost type — an
                        # inner `.take()` then reads the outer `FilterIter`
                        # type and the lowerer CC-fails. span.END is unique
                        # per link, so this preserves each link's own type.
                        # This persists the per-link output of the recursive
                        # `infer_expr_type` oracle (the receiver was inferred
                        # at the top of this arm via `reg_obj_type`), the
                        # self-host analog of Rust's `infer_expr_ast_type`.
                        types.expr_link_types.put(sexpr.span.end, reg_ret)
                        return reg_ret
            # Infer return type from well-known methods
            if method_name == "len" or method_name == "count":
                return types.int_id
            if method_name == "to_string" or method_name == "to_str" or method_name == "to_lower" or method_name == "to_upper" or method_name == "trim" or method_name == "lower" or method_name == "upper" or method_name == "strip" or method_name == "replace" or method_name == "join" or method_name == "repeat" or method_name == "format" or method_name == "concat" or method_name == "trim_start" or method_name == "trim_end":
                return types.string_id
            # `slice` / `substr` are RECEIVER-AWARE: on a `Vector` they return
            # the receiver's own type; on a String (or anything else) they
            # return `String`. Mirrors the lowerer's receiver-aware arm.
            if method_name == "slice" or method_name == "substr":
                ResolvedType slice_recv_rt = get_rtype_at(types.types, reg_obj_type)
                match slice_recv_rt:
                    case RTGeneric(slice_def, slice_targs):
                        DefInfo slice_d = scopes.get_def(slice_def)
                        if slice_d.name == "Vector":
                            return reg_obj_type
                    case RTDefined(slice_def2):
                        DefInfo slice_d2 = scopes.get_def(slice_def2)
                        if slice_d2.name == "Vector":
                            return reg_obj_type
                    else:
                        pass
                return types.string_id
            if method_name == "split":
                if scopes.lookup("Vector") is Some(vec_def):
                    Vector[int] vec_args = Vector[int]()
                    vec_args.push(types.string_id)
                    return types.add_type(!RTGeneric(vec_def, vec_args))
            # Set-op predicates return bool (mirrors Rust typecheck.rs:5665 —
            # `is_subset`/`is_superset` on Set/HashSet). Sibling of the
            # is_empty/contains arm. Without this the result slot defaults to
            # I64 and a `print(f"{a.is_subset(b)}")` prints 1/0 instead of
            # true/false (the int-instead-of-bool symptom).
            if method_name == "is_empty" or method_name == "contains" or method_name == "starts_with" or method_name == "ends_with" or method_name == "is_subset" or method_name == "is_superset" or method_name == "is_disjoint":
                return types.bool_id
            # Option/Result tag-check intrinsics return bool (mirrors Rust
            # typecheck.rs:5851 `is_some`/`is_none` and :5869 `is_ok`/`is_error`
            # — both `Some(self.types.bool_id)`). This EXACT four-name set is the
            # one source of truth shared with the lowerer's
            # `infer_method_return_type` bool arm (lower_types.gg:1888).
            #
            # Unlike the sibling `is_empty`/`contains` arm above, these are
            # typically CHAINED after a getter (`m.get(k).is_none()`): the
            # parser shares one `span.start` across the whole method chain, so
            # the inner `.get()`'s recorded `Option[T]` (at `expr_types[span.start]`,
            # line 492) COLLIDES onto the outer `.is_none()` — the lowerer's
            # `lookup_expr_gir_type` span.start fallback then types the tag-check
            # result slot as `Option__T` and cc-fails ("incompatible types …
            # 'Option__int64_t' from type 'int'"). Record bool at the UNIQUE
            # `span.end` via `expr_link_types` (checked FIRST for EMethodCall,
            # lower_types.gg:551) so the tag-check node reads its OWN bool type,
            # not the collided getter type. Same span.end oracle the lazy-iterator
            # chain-links use (line 505). Do NOT touch `expr_types[span.start]` —
            # that entry belongs to the inner getter link.
            if method_name == "is_some" or method_name == "is_none" or method_name == "is_ok" or method_name == "is_error":
                types.expr_link_types.put(sexpr.span.end, types.bool_id)
                return types.bool_id
            # Set-ops `union`/`intersection`/`difference` are RECEIVER-AWARE:
            # on a Set/HashSet they return the receiver's OWN type (mirrors
            # Rust typecheck.rs:5670 — `Some(receiver_type)`). Read the typed
            # receiver category (RTGeneric/RTDefined → DefInfo.name), never a
            # name guess. Without this the result slot defaults to I64 and the
            # `Set[int] u = a.union(b)` assignment is `incompatible types`.
            if method_name == "union" or method_name == "intersection" or method_name == "difference" or method_name == "symmetric_difference":
                ResolvedType setop_recv_rt = get_rtype_at(types.types, reg_obj_type)
                match setop_recv_rt:
                    case RTGeneric(setop_def, setop_targs):
                        DefInfo setop_d = scopes.get_def(setop_def)
                        if setop_d.name == "Set" or setop_d.name == "HashSet":
                            return reg_obj_type
                    case RTDefined(setop_def2):
                        DefInfo setop_d2 = scopes.get_def(setop_def2)
                        if setop_d2.name == "Set" or setop_d2.name == "HashSet":
                            return reg_obj_type
                    else:
                        pass
            # `update(other)` on a Dict/HashMap returns void/unit (mirrors Rust
            # typecheck.rs:5613 — `"put" | "set" | "update" => void_id`). It
            # mutates the receiver in place; the call is statement-position.
            # Without this the result slot defaults to I64 and the `void`
            # value-discard path emits `void value not ignored` at cc.
            if method_name == "update":
                ResolvedType upd_recv_rt = get_rtype_at(types.types, reg_obj_type)
                match upd_recv_rt:
                    case RTGeneric(upd_def, upd_targs):
                        DefInfo upd_d = scopes.get_def(upd_def)
                        if upd_d.name == "Dict" or upd_d.name == "HashMap":
                            return types.void_id
                    case RTDefined(upd_def2):
                        DefInfo upd_d2 = scopes.get_def(upd_def2)
                        if upd_d2.name == "Dict" or upd_d2.name == "HashMap":
                            return types.void_id
                    else:
                        pass
            # .unwrap() returns the inner type of Option[T] or Result[T,E]
            if method_name == "unwrap" or method_name == "unwrap_or":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if d.name == "Option" or d.name == "Result":
                                if type_args.len() >= 1:
                                    return get_int_at(type_args, 0)
                        else:
                            pass
            # .get(i) on Vector[T] → Option[T]; on Dict[K,V] → Option[V]
            if method_name == "get":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if d.name == "Vector" or d.name == "Set" or d.name == "HashSet":
                                if type_args.len() >= 1:
                                    # Returns Option[T &]
                                    if scopes.lookup("Option") is Some(option_def):
                                        int ref_tid = types.add_type(!RTRef(get_int_at(type_args, 0)))
                                        Vector[int] opt_args = Vector[int]()
                                        opt_args.push(ref_tid)
                                        return types.add_type(!RTGeneric(option_def, opt_args))
                            if d.name == "Dict" or d.name == "HashMap":
                                if type_args.len() >= 2:
                                    if scopes.lookup("Option") is Some(option_def):
                                        int ref_tid = types.add_type(!RTRef(get_int_at(type_args, 1)))
                                        Vector[int] opt_args = Vector[int]()
                                        opt_args.push(ref_tid)
                                        return types.add_type(!RTGeneric(option_def, opt_args))
                        else:
                            pass
            # .get_or(k, default) on Dict[K,V] → V (the OWNED value type, not a
            # Ref — the inline wrapper clones String values / copies scalars).
            # Without this arm the result slot defaults to I64 and a String-valued
            # get_or assigns a `Str` into an `int64_t` slot (cc type error).
            if method_name == "get_or" or method_name == "get_or_put":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 2:
                                return get_int_at(type_args, 1)
                        else:
                            pass
            # .keys() / .values() on Dict[K,V] → Vector[K] / Vector[V]
            if method_name == "keys":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 1:
                                if scopes.lookup("Vector") is Some(vec_def):
                                    Vector[int] vec_args = Vector[int]()
                                    vec_args.push(get_int_at(type_args, 0))
                                    return types.add_type(!RTGeneric(vec_def, vec_args))
                        else:
                            pass
            if method_name == "values":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 2:
                                if scopes.lookup("Vector") is Some(vec_def):
                                    Vector[int] vec_args = Vector[int]()
                                    vec_args.push(get_int_at(type_args, 1))
                                    return types.add_type(!RTGeneric(vec_def, vec_args))
                        else:
                            pass
            # .items() on Dict → Vector[(K,V)]
            if method_name == "items":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 2:
                                Vector[int] tuple_elems = Vector[int]()
                                tuple_elems.push(get_int_at(type_args, 0))
                                tuple_elems.push(get_int_at(type_args, 1))
                                int tuple_type = types.add_type(!RTTuple(tuple_elems))
                                if scopes.lookup("Vector") is Some(vec_def):
                                    Vector[int] vec_args = Vector[int]()
                                    vec_args.push(tuple_type)
                                    return types.add_type(!RTGeneric(vec_def, vec_args))
                        else:
                            pass
            # .clone() / .copy() / .sorted() / .reversed() returns the same type
            if method_name == "clone" or method_name == "copy" or method_name == "sorted" or method_name == "reversed" or method_name == "filter":
                return infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            # .fold(init, fn) returns the init type
            if method_name == "fold" or method_name == "reduce":
                if args.len() >= 1:
                    SpannedExpr init_arg = args.get(0).unwrap().value
                    return infer_expr_type(init_arg, scopes, &types, &ctx)
            # .parse(String) on primitive type → Option[T] or Result[T, String]
            # e.g. int.parse("99") → Option[int], float.parse("1.5") → Result[float, String]
            if method_name == "parse":
                match (*obj).expr:
                    case EIdentifier(tname):
                        bool is_prim = tname == "int" or tname == "float" or tname == "bool" or tname == "int8" or tname == "int16" or tname == "int32" or tname == "int64" or tname == "uint8" or tname == "uint16" or tname == "uint32" or tname == "uint64"
                        if is_prim:
                            int prim_id = types.primitive_id(tname)
                            # int.parse → Result[int, String], float.parse → Result[float, String]
                            # but for int/float the stdlib uses Option[T]
                            if scopes.lookup("Option") is Some(option_def):
                                Vector[int] opt_args = Vector[int]()
                                opt_args.push(prim_id)
                                int parse_ret = types.add_type(!RTGeneric(option_def, opt_args))
                                # Mirror Rust typecheck.rs:4481 — record the
                                # Option[T] return type for the static
                                # `<prim>.parse(...)` call at its outer span.
                                types.expr_types.put(span_start, parse_ret)
                                return parse_ret
                    else:
                        pass
            # .pop() / .remove() on Vector[T] → Option[T]; Dict[K,V].remove(k)
            # → Option[V] (mirrors Rust gg typecheck.rs:5458 — the removed
            # value transfers out, None when absent).
            #
            # D39 Phase A.3: `swap_remove` joins this arm — same return shape
            # per DD#6 (each receiver's OWN `remove` shape wins). Vector was
            # already void per protocol; Dict/HashMap → Option[V], Set/HashSet
            # → bool.
            if method_name == "pop" or method_name == "remove" or method_name == "swap_remove":
                int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                if obj_type >= 0 and obj_type < types.types.len():
                    ResolvedType ort = get_rtype_at(types.types, obj_type)
                    match ort:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            # Vector.pop/remove → Option[T]; Vector.swap_remove
                            # stays void per protocol (mirrors Rust gg
                            # typecheck.rs:8535: swap_remove | swap | fill).
                            if d.name == "Vector" and type_args.len() >= 1 and method_name != "swap_remove":
                                if scopes.lookup("Option") is Some(option_def):
                                    Vector[int] opt_args = Vector[int]()
                                    opt_args.push(get_int_at(type_args, 0))
                                    return types.add_type(!RTGeneric(option_def, opt_args))
                            if (method_name == "remove" or method_name == "swap_remove") and (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 2:
                                if scopes.lookup("Option") is Some(dict_option_def):
                                    Vector[int] dict_opt_args = Vector[int]()
                                    dict_opt_args.push(get_int_at(type_args, 1))
                                    return types.add_type(!RTGeneric(dict_option_def, dict_opt_args))
                            # Set/HashSet.remove(k) → bool (runtime
                            # `gorget_set_remove` returns whether the element was
                            # present). Mirrors Rust gg builtins.rs:459 (Set.remove
                            # → ret_bool; HashSet shares SET.methods). Without this
                            # the result slot defaults to I64 and a
                            # `print(f"{s.remove(x)}")` prints 1/0 instead of
                            # true/false (the int-instead-of-bool symptom).
                            # swap_remove mirrors the same shape per DD#6.
                            if (method_name == "remove" or method_name == "swap_remove") and (d.name == "Set" or d.name == "HashSet"):
                                return types.bool_id
                        else:
                            pass
            return NO_TYPE

        case EIndex(obj, index):
            # Round XXIX Track A (Core #9 lane parity with Rust
            # `E_NotIndexable`): `[]` is the language's `Index[K,V]`
            # operator; a receiver without an `Index` impl rejects at
            # check-time. Rust side lives at `src/semantic/typecheck.rs`
            # `Expr::Index` arm and gates on `has_trait_impl_by_name`.
            # The SH mirror below covers the builtin costumes:
            # accept Vector/Deque/Dict/HashMap/RTArray/RTSlice/String,
            # REJECT Set/HashSet (D38 — no lookup key) and RTTuple
            # (D39 — dot-N accessor). Anything else falls through to
            # NO_TYPE and downstream check will surface a mismatch.
            int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            if obj_type >= 0 and obj_type < types.types.len():
                ResolvedType ort = get_rtype_at(types.types, obj_type)
                match ort:
                    case RTGeneric(def_id, type_args):
                        DefInfo d = scopes.get_def(def_id)
                        # Vector[T][i] → T. Deque added Round XXIX Track A
                        # for Core #9 lane parity — Rust's intrinsic set
                        # includes Deque; without this line the SH lags.
                        if (d.name == "Vector" or d.name == "Deque") and type_args.len() >= 1:
                            return get_int_at(type_args, 0)
                        if (d.name == "Dict" or d.name == "HashMap") and type_args.len() >= 2:
                            return get_int_at(type_args, 1)
                        if d.name == "Set" or d.name == "HashSet":
                            ctx.diagnostics.push(Diagnostic.error(sexpr.span, DkNotIndexable(), "type `" + d.name + "` is not indexable — `[]` requires an `Index[K,V]` implementation. Iterate with `for x in c:` or use the collection's ratified named accessors (see D38/D39)."))
                            return NO_TYPE
                    case RTArray(elem_id, size):
                        return elem_id
                    case RTSlice(elem_id):
                        return elem_id
                    case RTTuple(elems):
                        ctx.diagnostics.push(Diagnostic.error(sexpr.span, DkNotIndexable(), "type `Tuple` is not indexable — use dot-N field access (`t.0`, `t.1`, ...) — the `[]` operator has no meaning on tuples (D39)."))
                        return NO_TYPE
                    else:
                        pass
                # String indexing → String
                match ort:
                    case RTPrimitive(name):
                        if name == "str" or name == "String":
                            return types.string_id
                    else:
                        pass
            return NO_TYPE

        case EArrayLiteral(elements):
            # Array type from first element
            if elements.len() > 0:
                SpannedExpr first = elements.get(0).unwrap()
                int elem_type = infer_expr_type(first, scopes, &types, &ctx)
                if elem_type >= 0:
                    return types.add_type(!RTArray(elem_type, elements.len()))
            return NO_TYPE

        case ETupleLiteral(elements):
            Vector[int] elem_ids = Vector[int]()
            for elem in elements:
                int et = infer_expr_type(elem, scopes, &types, &ctx)
                elem_ids.push(et)
            return types.add_type(!RTTuple(elem_ids))

        case EDictLiteral(keys, values):
            # Infer Dict[K, V] from first key-value pair
            if keys.len() > 0 and values.len() > 0:
                SpannedExpr first_key = keys.get(0).unwrap()
                SpannedExpr first_val = values.get(0).unwrap()
                int key_type = infer_expr_type(first_key, scopes, &types, &ctx)
                int val_type = infer_expr_type(first_val, scopes, &types, &ctx)
                if key_type >= 0 and val_type >= 0:
                    # Look up Dict def
                    if scopes.lookup("Dict") is Some(dict_def):
                        Vector[int] type_args = Vector[int]()
                        type_args.push(key_type)
                        type_args.push(val_type)
                        return types.add_type(!RTGeneric(dict_def, type_args))
            return NO_TYPE

        case EClosure(params, body):
            # Build RTFunction from closure params and infer return type from body
            Vector[int] param_type_ids = Vector[int]()
            Vector[int] param_ownerships = Vector[int]()
            # Build param name → type map for local inference
            Dict[String, int] param_types = Dict[String, int]()
            for p in params:
                int p_type_id = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
                param_type_ids.push(p_type_id)
                param_ownerships.push(p.ownership)
                param_types.put(p.param_name, p_type_id)
            # Infer return type from last statement in body
            int ret_id = types.void_id
            if body.len() > 0:
                Stmt last = body.get(body.len() - 1).unwrap()
                int inferred_ret = infer_closure_return_type(last, param_types, scopes, &types, &ctx)
                if inferred_ret >= 0:
                    ret_id = inferred_ret
            return types.add_type(!RTFunction(param_type_ids, param_ownerships, ret_id))

        case EPropagate(inner):
            # D29: `expr!` types as its inner expression (the mark is identity
            # on the success value; enforcement lives in typecheck).
            return infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)

        case ETry(inner):
            # try expr — unwraps Result[T,E] → T, Option[T] → T
            int inner_type = infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)
            if inner_type >= 0 and inner_type < types.types.len():
                ResolvedType irt = get_rtype_at(types.types, inner_type)
                match irt:
                    case RTGeneric(def_id, type_args):
                        DefInfo d = scopes.get_def(def_id)
                        if (d.name == "Result" or d.name == "Option") and type_args.len() >= 1:
                            return get_int_at(type_args, 0)
                    else:
                        pass
            return NO_TYPE

        case EAs(inner, target_type):
            # Cast: result is the target type; fall back to inner expr if type fails
            int cast_type = ast_type_to_resolved((*target_type).ty, (*target_type).span, scopes, &types)
            if cast_type >= 0 and cast_type != types.error_id:
                return cast_type
            return infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)

        case EMove(inner):
            return infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)

        case EMutableBorrow(inner):
            return infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)

        case EDeref(inner):
            # `*expr` is valid only on a smart pointer (`Box[T]` → `T`). This arm
            # TYPES the deref (unwrap `Box[T]`); the non-Box REJECT lives in the
            # EXHAUSTIVE typecheck.gg `check_carrier_ops_expr` EDeref arm (which
            # visits EVERY `*x` position — `infer_expr_type` is only driven on
            # `auto` inits + some sub-positions, so a reject HERE would both miss
            # explicitly-typed inits AND double-fire with the exhaustive pass on
            # the positions infer DOES reach). One source of truth: type here,
            # reject there. Returning `error_id` for a non-Box operand keeps
            # downstream inference sound without emitting a (duplicate) diag.
            # See docs/language-reference.md §7.4 + AGENTS.md Core invariant #8.
            int deref_inner_type = infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)
            int deref_resolved = deref_inner_type
            # Peel a single `RTRef` wrapper (`*(&box)`); the self-host has no
            # RTOwned variant, so RTRef is the only ownership wrapper to peel.
            if deref_resolved >= 0 and deref_resolved < types.types.len():
                ResolvedType deref_wrap = get_rtype_at(types.types, deref_resolved)
                match deref_wrap:
                    case RTRef(pointee):
                        deref_resolved = pointee
                    else:
                        pass
            if deref_resolved >= 0 and deref_resolved < types.types.len():
                ResolvedType deref_rt = get_rtype_at(types.types, deref_resolved)
                match deref_rt:
                    case RTGeneric(box_def_id, box_args):
                        DefInfo box_def = scopes.get_def(box_def_id)
                        if box_def.name == "Box" and box_args.len() == 1:
                            # *Box[T] → T
                            return get_int_at(box_args, 0)
                        else:
                            # Non-Box: type as error (the exhaustive pass rejects).
                            return types.error_id
                    case RTVar(_unresolved):
                        # inference incomplete — suppress (mirrors Rust's Var guard)
                        return deref_inner_type
                    case RTError():
                        return deref_inner_type
                    else:
                        # Any other concretely-resolved type is not deref-able;
                        # type as error (the exhaustive pass emits the reject).
                        return types.error_id
            return deref_inner_type


        case EIs(inner, negated, pattern):
            return types.bool_id

        case EAwait(inner):
            # DoubleAwait detection lives in typecheck.gg's walk_expr_closures
            # EAwait case — that path is the only one that visits *every*
            # EAwait exactly once (this `infer_expr_type` recursion is driven
            # by VarDecl init + return-expression walks; pushing the diag
            # here as well would double-fire on VarDecl paths). Mirrors
            # src/semantic/typecheck.rs:2075 (SemanticErrorKind::DoubleAwait).
            #
            # await on Task[T] / Future[T] yields T.
            int await_inner_type = infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)
            if await_inner_type >= 0 and await_inner_type < types.types.len():
                ResolvedType art = get_rtype_at(types.types, await_inner_type)
                match art:
                    case RTGeneric(def_id, type_args):
                        DefInfo d = scopes.get_def(def_id)
                        if (d.name == "Task" or d.name == "Future") and type_args.len() >= 1:
                            # Mirror Rust typecheck.rs:2026 — record the
                            # inner expression's Task/Future TypeId so the
                            # lowerer can recover the awaited generic shape
                            # without re-inferring.
                            types.expr_types.put((*inner).span.start, await_inner_type)
                            return get_int_at(type_args, 0)
                    else:
                        pass
            return NO_TYPE

        case ESpawn(inner):
            # spawn(expr) returns Task[InnerType]. Look up Task in scope
            # and wrap the operand's inferred type.
            int sp_inner_type = infer_expr_type(SpannedExpr((*inner).expr, (*inner).span), scopes, &types, &ctx)
            if sp_inner_type >= 0:
                # Mirror Rust typecheck.rs:2049 — when the spawned inner
                # is itself a Future[T] (typed call to an async fn), record
                # the Future TypeId at the inner span so the lowerer can
                # see the operand as Future-shaped before the Task wrap.
                if sp_inner_type < types.types.len():
                    ResolvedType sp_rt = get_rtype_at(types.types, sp_inner_type)
                    match sp_rt:
                        case RTGeneric(def_id, type_args):
                            DefInfo d = scopes.get_def(def_id)
                            if d.name == "Future" and type_args.len() == 1:
                                types.expr_types.put((*inner).span.start, sp_inner_type)
                        else:
                            pass
                if scopes.lookup("Task") is Some(task_def):
                    Vector[int] task_args = Vector[int]()
                    task_args.push(sp_inner_type)
                    return types.add_type(!RTGeneric(task_def, task_args))
            return NO_TYPE

        case EDefaultOp(left, right):
            # NOTE: the self-host parser lowers `a ?? b` to EBinaryOp(_, "??", _)
            # (parser.gg:1975 + op_str:822), NOT EDefaultOp — so this arm is
            # currently UNREACHED. The LHS-must-be-Option/Result REJECT is driven
            # from the EXHAUSTIVE typecheck.gg `check_carrier_ops_expr` walker
            # (which visits EVERY `??` position exactly once, at EBinaryOp("??")
            # AND this EDefaultOp shape), NOT here — `infer_expr_type` is only
            # driven on `auto` inits + some sub-positions, so a reject here would
            # both miss explicitly-typed inits AND double-fire with the
            # exhaustive pass. This arm just types the result (the RHS/unwrapped
            # type) for the positions infer DOES reach.
            int rt = infer_expr_type(SpannedExpr((*right).expr, (*right).span), scopes, &types, &ctx)
            return rt

        case EBlock(body_stmts):
            # do: block — type is the type of the last expression
            if body_stmts.len() > 0:
                Stmt last = body_stmts.get(body_stmts.len() - 1).unwrap()
                return infer_stmt_return_type(last, scopes, &types, &ctx)
            return NO_TYPE

        case EDo(body_stmts):
            if body_stmts.len() > 0:
                Stmt last = body_stmts.get(body_stmts.len() - 1).unwrap()
                return infer_stmt_return_type(last, scopes, &types, &ctx)
            return NO_TYPE

        case ECatch(ec_inner, _ec_name, _ec_recovery):
            # Track A · SH mirror of Rust `Expr::Catch` at
            # `src/semantic/typecheck.rs:4624`. `catch` resolves the inner
            # `Result[T, E]`; the whole catch expression's type is the OK
            # slot `T`. Extract via `option_or_result_payload(inner_ty, 0)`
            # (axis 0 = Ok, defined at `typecheck.gg:3469`). Inference is
            # diagnostic-free in the SH — the recovery-vs-expected diagnostic
            # emission lives in `typecheck.gg`'s safety-pass ECatch arm.
            int ec_inner_ty = infer_expr_type(SpannedExpr((*ec_inner).expr, (*ec_inner).span), scopes, &types, &ctx)
            if ec_inner_ty < 0:
                return NO_TYPE
            if ec_inner_ty >= types.types.len():
                return NO_TYPE
            ResolvedType ec_rt = get_rtype_at(types.types, ec_inner_ty)
            match ec_rt:
                case RTGeneric(ec_def_id, ec_args):
                    String ec_name = scopes.get_def(ec_def_id).name
                    if ec_name == "Result" and ec_args.len() == 2:
                        return get_int_at(ec_args, 0)
                else:
                    pass
            return ec_inner_ty

        else:
            return NO_TYPE

    return NO_TYPE
