# CLI driver for type-checker comparison testing.
# Reads a .gg file, parses it, resolves names, type-checks, and prints
# canonical TYPE output.
# Usage: driver <path-to-file.gg>

from parser import parse_source
from ast import Module, Item
from scope import ScopeTable
from types import TypeTable
from resolve import resolve_module, ResolveContext
from typecheck import type_check_module
from format_types import format_types
from derive import expand_derives
from meta import expand_meta_types
from std.fs import read_file, file_exists
from std.os import args
from std.collections import Vector

# Try loading lib/std/iter.gg from a few candidate paths and prepend its
# items to `m.items` so the registry/typechecker can see Iterator,
# Iterable, the adapter structs, and their equip blocks. Without this,
# fixture chains like `v.iter().take(n).map(f).collect()` see Iterator
# as a bare trait name with no methods registered.
void try_prepend_std_iter(Module &m):
    Vector[String] candidates = Vector[String]()
    candidates.push("lib/std/iter.gg")
    candidates.push("../lib/std/iter.gg")
    candidates.push("../../lib/std/iter.gg")
    candidates.push("../../../lib/std/iter.gg")
    int i = 0
    while i < candidates.len():
        String p = candidates.get(i).unwrap()
        if file_exists(p):
            String src = read_file(p)
            Module std_m = parse_source(src)
            Vector[Item] merged = Vector[Item]()
            int sj = 0
            while sj < std_m.items.len():
                merged.push(std_m.items.get(sj).unwrap())
                sj = sj + 1
            int uj = 0
            while uj < m.items.len():
                merged.push(m.items.get(uj).unwrap())
                uj = uj + 1
            m.items = merged
            return
        i = i + 1

void main():
    Vector[String] cmd_args = args()
    String path = cmd_args.get(1).unwrap()
    String source = read_file(path)
    Module m = parse_source(source)
    # `try_prepend_std_iter(&m)` is intentionally NOT called for the
    # type_comparison path: Rust's `gorget::semantic::analyze(&mut
    # module, &[])` only sees the single user module (no multi-file
    # loader runs), so prepending std.iter would dump ~150 lines of
    # iter trait/adapter TYPE entries that have no Rust counterpart.
    # Instead, the impl-override-return-type substitution in
    # `resolve_method_for_generic_receiver` (traits.gg) handles user
    # fixtures that explicitly `from std.iter import ...`. The shim
    # at `try_prepend_std_iter` above remains available for future
    # paths (e.g. running this driver against a multi-module entry)
    # but is off for the comparison test.
    expand_derives(&m)
    ScopeTable scopes = ScopeTable.new_scope_table()
    scopes.init()
    TypeTable types = TypeTable.new_type_table()
    expand_meta_types(&m, &types)
    ResolveContext ctx = resolve_module(m, &scopes, &types)
    type_check_module(m, &scopes, &types, ctx)
    print(format_types(scopes, types))
