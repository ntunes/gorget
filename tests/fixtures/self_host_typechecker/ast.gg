# Self-hosting parser AST types for the Gorget programming language.
# Defines all node types used in the abstract syntax tree.

from std.collections import Vector

# ── Spans ────────────────────────────────────────────────────

struct Span:
    int start
    int end

struct SpannedExpr:
    Expr expr
    Span span

struct SpannedType:
    Type ty
    Span span

struct SpannedPattern:
    Pattern pat
    Span span

# ── Types ────────────────────────────────────────────────────

enum Type:
    TPrimitive(String)
    TNamed(String, Vector[SpannedType])
    TArray(Box[SpannedType], int)
    TSlice(Box[SpannedType])
    TTuple(Vector[SpannedType])
    TFunction(Box[SpannedType], Vector[SpannedType], Vector[int])
    TSelf
    TInferred

# ── Patterns ─────────────────────────────────────────────────

enum Pattern:
    PWildcard
    PBinding(String)
    PLiteral(SpannedExpr)
    PConstructor(String, Vector[SpannedPattern])
    PDotShorthand(String, Vector[SpannedPattern])
    PTuple(Vector[SpannedPattern])
    POr(Vector[SpannedPattern])
    PRest

# ── Expressions ──────────────────────────────────────────────

enum Expr:
    EIntLiteral(int)
    EFloatLiteral(float)
    EBoolLiteral(bool)
    EStringLiteral(String, bool)
    ECharLiteral(String)
    ENoneLiteral
    EIdentifier(String)
    ESelfExpr
    EIt
    EBinaryOp(Box[SpannedExpr], String, Box[SpannedExpr])
    EUnaryOp(String, Box[SpannedExpr])
    ECall(Box[SpannedExpr], Vector[SpannedExpr], Vector[String], Vector[SpannedType])
    EMethodCall(Box[SpannedExpr], String, Vector[SpannedExpr], Vector[String], Vector[SpannedType])
    EFieldAccess(Box[SpannedExpr], String)
    EIndex(Box[SpannedExpr], Box[SpannedExpr])
    ERange(Option[Box[SpannedExpr]], Option[Box[SpannedExpr]], bool)
    EIf(Box[SpannedExpr], Vector[Stmt], Vector[ElseBranch])
    EMatch(Box[SpannedExpr], Vector[MatchArm])
    EClosure(Vector[Param], Vector[Stmt])
    EImplicitClosure(Box[SpannedExpr])
    EArrayLiteral(Vector[SpannedExpr])
    ETupleLiteral(Vector[SpannedExpr])
    EDictLiteral(Vector[SpannedExpr], Vector[SpannedExpr])
    EStructLiteral(String, Vector[String], Vector[SpannedExpr])
    EDotShorthand(String, Vector[SpannedExpr])
    ETry(Box[SpannedExpr])
    EMove(Box[SpannedExpr])
    EMutableBorrow(Box[SpannedExpr])
    EDeref(Box[SpannedExpr])
    EAs(Box[SpannedExpr], Box[SpannedType])
    EBlock(Vector[Stmt])
    EListComp(Box[SpannedExpr], String, Box[SpannedExpr], Option[Box[SpannedExpr]])
    ESetComp(Box[SpannedExpr], String, Box[SpannedExpr], Option[Box[SpannedExpr]])
    EDictComp(Box[SpannedExpr], Box[SpannedExpr], String, Box[SpannedExpr], Option[Box[SpannedExpr]])
    EDefaultOp(Box[SpannedExpr], Box[SpannedExpr])
    EIs(Box[SpannedExpr], bool, Box[SpannedPattern])
    EDo(Vector[Stmt])
    EAwait(Box[SpannedExpr])
    ESpawn(Box[SpannedExpr])
    ESpawnBlocking(Box[SpannedExpr])
    ERethrow(Box[SpannedExpr], Option[String], Option[Box[SpannedType]], Box[SpannedExpr])
    ECatch(Box[SpannedExpr], String, Box[SpannedExpr])
    # Local fault-catch (error-model.md §11) — a DISTINCT form from the
    # Result `ECatch` above. `(expr) catch Fault.Overflow: h` /
    # `(expr) catch f: match f`. The pattern selects which fault(s) are
    # caught; the handler runs on the fault path. Inc1 = arithmetic faults.
    EFaultCatch(Box[SpannedExpr], FaultCatchPattern, Box[SpannedExpr])
    EFString(String, Vector[SpannedExpr], Vector[Option[String]])

# How an EFaultCatch selects which fault(s) it intercepts.
#   FcpVariant(qualifier, variant) — `catch Fault.Overflow:` (qualifier is
#     the enum name "Fault", checked in typecheck; variant selects the arm).
#   FcpBinding(name) — `catch f:` binds the constructed Fault value to `name`.
enum FaultCatchPattern:
    FcpVariant(String, String)
    FcpBinding(String)

# ── Statements ───────────────────────────────────────────────

enum Stmt:
    SVarDecl(SpannedType, String, SpannedExpr, int, int, int)
    SAssign(SpannedExpr, SpannedExpr)
    SCompoundAssign(SpannedExpr, String, SpannedExpr)
    SExpr(SpannedExpr)
    SReturn(Option[SpannedExpr])
    SThrow(SpannedExpr)
    SBreak
    SContinue
    SPass
    SMeta
    # PROTOTYPE slice #4: SMetaFor now CARRIES its loop-var names + the
    # iterable expression (e.g. `fields(T)` / `variant_names(T)` /
    # `0..variant_count(T)`) so the delayed-meta engine can UNROLL it per
    # monomorphization, binding the loop vars per concrete T. Previously
    # SMetaFor(body) discarded both (skip_meta_header ate them) → the whole
    # meta-for body silently vanished. Mirrors Rust `Stmt::MetaFor { vars,
    # range, body }` and the meta #3 SMetaIf-carries-condition fix shape.
    SMetaFor(Vector[String], SpannedExpr, Vector[Stmt])
    # PROTOTYPE: SMetaIf now carries its CONDITION (the `meta if <cond>:`
    # expression) so the delayed-meta engine can evaluate it per
    # monomorphization. elif conditions live in the ElseBranch.condition.
    SMetaIf(SpannedExpr, Vector[Stmt], Vector[ElseBranch])
    # PROTOTYPE slice #4b: in-body `meta const <name> = <expr>` carries its
    # binding name + value expression. The delayed-meta engine evaluates the
    # value (e.g. `enum_ordinal(T, vname)`), binds it into the per-mono meta
    # env, and substitutes references in the remaining statements. Mirrors
    # Rust `Stmt::MetaConst { name, value }` (no explicit type — inferred
    # from the value). Previously discarded as bare `SMeta()` at parse.
    SMetaConst(String, SpannedExpr)
    # Meta-for nested INSIDE a match arm. The parser captures the loop
    # variable names + the range expression (e.g. `variant_payloads(T)`)
    # + the inner case-arm templates so that meta.gg's expand_meta_types
    # can iterate the range, substitute the vars in each template's
    # pattern/body, and replace the synthetic wrapping arm with the
    # expanded concrete arms. Lives only between parse and meta
    # expansion — never seen by resolve/typecheck.
    SMetaForMatch(Vector[String], SpannedExpr, Vector[MatchArm])
    # PROTOTYPE (deep-meta): in-body `meta match <expr>: case <val>: ...
    # [else: ...]` — compile-time value match over a meta scrutinee. Carries
    # the scrutinee expr, the case arms (value expr + body), and the else body
    # (empty Vector => no else). Mirrors Rust `Stmt::MetaMatch { scrutinee,
    # arms, else_arm }` (ast.rs:1103). Evaluated by evaluate_delayed_meta_stmts.
    SMetaMatch(SpannedExpr, Vector[MetaMatchArm], Vector[Stmt])
    # PROTOTYPE (deep-meta): in-body `meta while <cond>: body` — compile-time
    # loop, unrolled per-mono until the condition goes false (capped). Carries
    # the condition expr + the body. Mirrors Rust `Stmt::MetaWhile { condition,
    # body }` (ast.rs:1113). Evaluated by evaluate_delayed_meta_stmts.
    SMetaWhile(SpannedExpr, Vector[Stmt])
    SFor(SpannedPattern, SpannedExpr, Vector[Stmt], int, Vector[Stmt])
    SWhile(SpannedExpr, Vector[Stmt], Vector[Stmt])
    SLoop(Vector[Stmt])
    SIf(SpannedExpr, Vector[Stmt], Vector[ElseBranch])
    SMatch(SpannedExpr, Vector[MatchArm])
    SWith(SpannedExpr, String, Vector[Stmt])
    SAssert(SpannedExpr, Option[String])
    SAssertReturn(SpannedExpr, Option[String])
    SNamedScope(String, Vector[Stmt])
    SSelect(Vector[SelectArm])
    SOnError(Vector[Stmt])
    SItem(Item)
    SSnapshot(String, int, SpannedExpr)

# ── Items ────────────────────────────────────────────────────

enum Item:
    IFunction(FunctionDef)
    IStruct(StructDef)
    IEnum(EnumDef)
    ITrait(TraitDef)
    IEquip(EquipBlock)
    IImport(ImportStmt)
    IDirective(String, String)
    ITypeAlias(String, Vector[String], SpannedType)
    INewtype(String, SpannedType)
    IConstDecl(SpannedType, String, SpannedExpr)
    IMetaConst(SpannedType, String, SpannedExpr)
    IMetaType(String, MetaTypeRhs)
    IMetaTypeFunc(String)
    IMetaAssert
    IMetaIf(SpannedExpr, Vector[Item], Vector[ItemElseBranch])
    IMetaLog
    IStaticDecl(SpannedType, String, SpannedExpr)
    IExternBlock(Vector[FunctionDef])
    ITest(String, Vector[SpannedExpr], Vector[String], Vector[Stmt])
    IBench(String, Vector[Stmt])
    ISuiteSetup(Vector[Stmt])
    ISuiteTeardown(Vector[Stmt])

# ── Meta type RHS ────────────────────────────────────────────

enum MetaTypeRhs:
    MtrPlain(SpannedType)
    MtrConditional(SpannedType, String, SpannedType)
    MtrCall(String, Vector[SpannedExpr])
    MtrUnresolved

# ── Supporting structures ────────────────────────────────────

struct Param:
    SpannedType param_type
    String param_name
    int ownership
    Option[SpannedExpr] default_value

struct FunctionDef:
    String name
    Vector[Param] params
    SpannedType return_type
    Vector[String] type_params
    Vector[Stmt] body
    bool is_expr_body
    Option[SpannedType] throws_type
    # True for an `extern int f(...) = "sym"` / `extern "C": ...` alias decl.
    # Typed source of truth replacing the body-shape heuristics (is_expr_body /
    # SReturn(Some)→has_real_body / body.len()>0) the loader+lowerer used to
    # tell a stub from a real fn. Set by the parser at the 2 extern ctors; read
    # by loader.gg's has_real_body gate + lower.gg's body-lowering skip.
    bool is_extern_stub

struct StructDef:
    String name
    Vector[Param] fields
    Vector[String] type_params
    Vector[String] derives

struct EnumDef:
    String name
    Vector[EnumVariant] variants
    Vector[String] type_params
    Vector[String] derives

struct EnumVariant:
    String name
    Vector[SpannedType] fields

struct TraitDef:
    String name
    Vector[String] type_params
    Vector[FunctionDef] methods
    Vector[String] parent_traits

struct EquipBlock:
    SpannedType target
    Vector[String] type_params
    Option[String] trait_name
    Vector[FunctionDef] methods
    Option[String] via_field
    # Generic args from the trait clause, e.g. [TPrimitive("int")] for
    # `with Iterator[int]`. Empty for non-generic traits or when no
    # `with` clause is present. Populated by parser; consumed by
    # traits.gg for call-site Self/T substitution on trait defaults.
    Vector[SpannedType] trait_generic_args

struct MatchArm:
    SpannedPattern pattern
    Option[SpannedExpr] guard
    Vector[Stmt] body

struct ElseBranch:
    Option[SpannedExpr] condition
    Vector[Stmt] body

# A single `case <value>: <body>` arm of a compile-time `meta match`.
# `case_value` is the value expression compared (by meta-value equality)
# against the scrutinee; `body` is the arm's statement list. Mirrors the
# Rust `(Spanned<Expr>, Block)` pair in `Stmt::MetaMatch::arms`.
struct MetaMatchArm:
    SpannedExpr case_value
    Vector[Stmt] body

# Item-level else/elif branch — the top-level `meta if` analogue of
# ElseBranch (which carries statements). `condition` is None for the
# trailing `else:` block, Some(...) for an `elif <cond>:` block.
struct ItemElseBranch:
    Option[SpannedExpr] condition
    Vector[Item] items

struct ImportStmt:
    String module_path
    Vector[String] names
    # Parallel to `names`: the `as`-alias for each imported name, or "" when
    # the name is imported bare. `from X import sin as msin, cos` →
    # names = [sin, cos], aliases = [msin, ""]. Mirrors Rust's
    # `ImportStmt::From { names: Vec<{ name, alias }> }` (resolve.rs:234-241):
    # the alias becomes the locally-visible name; the original drives the C
    # symbol redirect.
    Vector[String] aliases

enum SelectOp:
    SORecv(String, int, SpannedExpr)
    SOSend(SpannedExpr, SpannedExpr)

struct SelectArm:
    SelectOp op
    Vector[Stmt] body

struct Module:
    Vector[Item] items
