# Scope tree and definition table for name resolution.
# Uses flat parallel vectors for scope names to avoid non-Copy codegen issues.

from std.collections import Vector
from ast import Span
from ids import NO_DEF, NO_SCOPE

# ── Definition kinds ────────────────────────────────────────

enum DefKind:
    DkFunction
    DkStruct
    DkEnum
    DkVariant
    DkTrait
    DkTypeAlias
    DkNewtype
    DkVariable
    DkConst
    DkStatic
    DkGenericParam
    DkImport

# ── Definition info ─────────────────────────────────────────

struct DefInfo:
    str name
    DefKind kind
    Span span
    int scope_id
    int type_id
    bool is_mutable
    bool is_param

# ── Scope kinds ─────────────────────────────────────────────

enum ScopeKind:
    SkModule
    SkFunction
    SkBlock
    SkEquipBlock
    SkTraitDef
    SkForLoop

# ── Scope (Copy-friendly — no Dict) ────────────────────────

struct Scope:
    int parent
    ScopeKind kind

# ── Scope table ─────────────────────────────────────────────
# Flat parallel vectors for names avoid non-Copy type issues in codegen.
# Extra is_import/is_trait/is_dummy flags avoid reading self.definitions
# from &self methods (which triggers spurious memset in generated C).

struct ScopeTable:
    Vector[Scope] scopes
    Vector[DefInfo] definitions
    # Flat scope → name → def_id mapping
    Vector[int] name_scope_ids
    Vector[str] name_keys
    Vector[int] name_def_ids
    # Replacement flags (avoid reading definitions from &self)
    Vector[bool] name_is_import
    Vector[bool] name_is_trait
    Vector[bool] name_is_dummy
    int current

# ── Typed accessors (only for immutable self or standalone use) ────

DefInfo get_def_at(Vector[DefInfo] v, int i):
    return v.get(i).unwrap()

Scope get_scope_at(Vector[Scope] v, int i):
    return v.get(i).unwrap()

# ── ScopeTable methods ──────────────────────────────────────

equip ScopeTable:

    ScopeTable new_scope_table(): ScopeTable(
        Vector[Scope](),
        Vector[DefInfo](),
        Vector[int](),
        Vector[str](),
        Vector[int](),
        Vector[bool](),
        Vector[bool](),
        Vector[bool](),
        NO_SCOPE
    )

    void init(&self):
        Scope root = Scope(NO_SCOPE, SkModule())
        self.scopes.push(root)
        self.current = 0

    int push_scope(&self, ScopeKind kind):
        int id = self.scopes.len()
        Scope s = Scope(self.current, kind)
        self.scopes.push(s)
        self.current = id
        return id

    void pop_scope(&self):
        int parent = self.scope_parent_of(self.current)
        if parent >= 0:
            self.current = parent

    # Read scope parent without typed accessor (avoids memset bug)
    int scope_parent_of(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    int define(&self, str name, DefKind kind, Span span):
        return self.define_with_mutability(name, kind, span, false)

    int define_with_mutability(&self, str name, DefKind kind, Span span, bool is_mutable):
        # Check for existing definition in current scope using name table
        int ni = self.find_name_entry(self.current, name)
        if ni >= 0:
            # Read replacement flags from name table (all Copy types)
            bool existing_is_import = self.name_is_import.get(ni).unwrap()
            bool existing_is_trait = self.name_is_trait.get(ni).unwrap()
            bool existing_is_dummy = self.name_is_dummy.get(ni).unwrap()

            bool new_is_import = false
            match kind:
                case DkImport():
                    new_is_import = true
                else:
                    pass
            bool new_is_trait = false
            match kind:
                case DkTrait():
                    new_is_trait = true
                else:
                    pass

            bool allow_replace = false
            if existing_is_import and not new_is_import:
                allow_replace = true
            if existing_is_import and existing_is_dummy:
                allow_replace = true
            if existing_is_trait and existing_is_dummy and not new_is_trait:
                allow_replace = true

            if allow_replace:
                int def_id = self.definitions.len()
                DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, is_mutable, false)
                self.definitions.push(info)
                # Update existing name entry to point to new def
                self.name_def_ids.set(ni, def_id)
                self.name_is_import.set(ni, new_is_import)
                self.name_is_trait.set(ni, new_is_trait)
                bool new_is_dummy = span.start == 0 and span.end == 0
                self.name_is_dummy.set(ni, new_is_dummy)
                return def_id
            # Duplicate definition error — return NO_DEF to signal failure
            return NO_DEF
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, is_mutable, false)
        self.definitions.push(info)
        # Add new name entry with flags
        self.name_scope_ids.push(self.current)
        self.name_keys.push(name)
        self.name_def_ids.push(def_id)
        bool is_import = false
        match kind:
            case DkImport():
                is_import = true
            else:
                pass
        self.name_is_import.push(is_import)
        bool is_trait = false
        match kind:
            case DkTrait():
                is_trait = true
            else:
                pass
        self.name_is_trait.push(is_trait)
        bool is_dummy = span.start == 0 and span.end == 0
        self.name_is_dummy.push(is_dummy)
        return def_id

    # Allocate a definition without inserting into the current scope's name table.
    # Used for non-generic enum variants which have def_ids but aren't in scope.
    int alloc_def(&self, str name, DefKind kind, Span span):
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, false, false)
        self.definitions.push(info)
        return def_id

    # Find name entry index in flat table (returns -1 if not found)
    int find_name_entry(self, int scope_id, str name):
        int i = self.name_scope_ids.len() - 1
        while i >= 0:
            if self.name_scope_ids.get(i).unwrap() == scope_id:
                if self.name_keys.get(i).unwrap() == name:
                    return i
            i = i - 1
        return NO_DEF

    int lookup(self, str name):
        int scope_id = self.current
        while scope_id >= 0:
            int ni = self.find_name_entry(scope_id, name)
            if ni >= 0:
                return self.name_def_ids.get(ni).unwrap()
            Scope s = get_scope_at(self.scopes, scope_id)
            scope_id = s.parent
        return NO_DEF

    int lookup_from_scope(self, int scope_id, str name):
        int sid = scope_id
        while sid >= 0:
            int ni = self.find_name_entry(sid, name)
            if ni >= 0:
                return self.name_def_ids.get(ni).unwrap()
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return NO_DEF

    int lookup_in_scope(self, int scope_id, str name):
        int ni = self.find_name_entry(scope_id, name)
        if ni >= 0:
            return self.name_def_ids.get(ni).unwrap()
        return NO_DEF

    # Search scope and all descendant scopes for a name.
    # Returns the first matching def_id or NO_DEF.
    int lookup_in_subtree(self, int root_scope, str name):
        # Check root scope first
        int ni = self.find_name_entry(root_scope, name)
        if ni >= 0:
            return self.name_def_ids.get(ni).unwrap()
        # Check all child scopes (any scope whose parent chain includes root_scope)
        int sid = root_scope + 1
        while sid < self.scopes.len():
            # Walk parent chain to see if this scope descends from root_scope
            bool is_child = false
            int p = sid
            while p >= 0:
                Scope ps = get_scope_at(self.scopes, p)
                if ps.parent == root_scope:
                    is_child = true
                    p = -1
                elif ps.parent < root_scope:
                    p = -1
                else:
                    p = ps.parent
            if is_child:
                int cni = self.find_name_entry(sid, name)
                if cni >= 0:
                    return self.name_def_ids.get(cni).unwrap()
            sid = sid + 1
        return NO_DEF

    # Like lookup_in_subtree, but skips defs that already have a type assigned.
    # Used by assign_pattern_types to find the correct def when the same name
    # appears in multiple match arm scopes.
    int lookup_in_subtree_untyped(self, int root_scope, str name):
        int ni = self.find_name_entry(root_scope, name)
        if ni >= 0:
            int did = self.name_def_ids.get(ni).unwrap()
            DefInfo d = get_def_at(self.definitions, did)
            if d.type_id < 0:
                return did
        int sid = root_scope + 1
        while sid < self.scopes.len():
            bool is_child = false
            int p = sid
            while p >= 0:
                Scope ps = get_scope_at(self.scopes, p)
                if ps.parent == root_scope:
                    is_child = true
                    p = -1
                elif ps.parent < root_scope:
                    p = -1
                else:
                    p = ps.parent
            if is_child:
                int cni = self.find_name_entry(sid, name)
                if cni >= 0:
                    int cdid = self.name_def_ids.get(cni).unwrap()
                    DefInfo cd = get_def_at(self.definitions, cdid)
                    if cd.type_id < 0:
                        return cdid
            sid = sid + 1
        return NO_DEF

    DefInfo get_def(self, int id):
        return get_def_at(self.definitions, id)

    void set_def_param(&self, int id, bool is_param):
        # Use direct field assignment on definition
        # Can't use get_def_at in &self (memset bug), so reconstruct
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_param = is_param
        self.definitions.set(id, d)

    void set_def_type(&self, int id, int type_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.type_id = type_id
        self.definitions.set(id, d)

    void set_def_scope_id(&self, int id, int scope_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.scope_id = scope_id
        self.definitions.set(id, d)

    int current_scope(self):
        return self.current

    void set_current(&self, int id):
        self.current = id

    int def_count(self):
        return self.definitions.len()

    int scope_count(self):
        return self.scopes.len()

    ScopeKind scope_kind(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.kind

    int scope_parent(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    bool is_descendant_of(self, int child, int parent):
        int sid = child
        while sid >= 0:
            if sid == parent:
                return true
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return false

    int lookup_def_by_span(self, str name, Span span):
        int i = 0
        while i < self.definitions.len():
            DefInfo d = get_def_at(self.definitions, i)
            if d.name == name and d.span.start == span.start and d.span.end == span.end:
                return i
            i = i + 1
        return NO_DEF
