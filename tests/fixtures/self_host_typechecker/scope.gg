# Scope tree and definition table for name resolution.
#
# The name table (`name_scope_ids` + `name_keys` + `name_def_ids`) is
# intentionally a flat parallel-Vector (not a Dict) so that
# `find_name_entry` can scan backwards through insertion order to
# resolve shadowing — the most-recent define for a given (scope, name)
# wins.

from std.collections import Vector, Dict
from ast import Span
from ids import NO_DEF, NO_SCOPE

# ── Definition kinds ────────────────────────────────────────

enum DefKind:
    DkFunction
    DkStruct
    DkEnum
    DkVariant
    DkTrait
    DkTypeAlias
    DkNewtype
    DkVariable
    DkConst
    DkStatic
    DkGenericParam
    DkImport

# ── Definition info ─────────────────────────────────────────

struct DefInfo:
    String name
    DefKind kind
    Span span
    int scope_id
    int type_id
    bool is_mutable
    bool is_param
    # D4/D12 drop-purity taint (mirrors Rust `DefInfo.is_drop_tainted`):
    # a type with a transitive custom `Drop` in its field/payload graph is
    # single-owner; an implicit copy of a live tainted place is rejected.
    # Seeded from `equip T with Drop` + closed under the field-graph fixpoint
    # by `compute_drop_taint` (typecheck.gg). Read via `is_drop_tainted_type`.
    bool is_drop_tainted
    # Ownership sigil for a parameter def (OWN_BORROW/OWN_MUTABLE/OWN_MOVE
    # from parser.gg), or -1 for non-params. Used by D12 position 6
    # (materialize-on-write): a write through a bare BORROW param of a
    # drop-tainted type would privatise an implicit copy. Mirrors Rust
    # `DefInfo.param_ownership`.
    int param_ownership
    # D10(b) Copy axis (mirrors Rust `is_copy_type`'s struct/enum recursion):
    # a type-def is Copy iff it is NOT drop-tainted AND every field / variant
    # payload is (transitively) Copy. Seeded + closed under the field-graph
    # fixpoint by `compute_is_copy` (typecheck.gg), the DUAL of
    # `compute_drop_taint` (non-Copy is the absorbing direction). Only
    # meaningful for RTDefined struct/enum defs; read via `resolved_type_is_copy`.
    bool is_copy

# ── Scope kinds ─────────────────────────────────────────────

enum ScopeKind:
    SkModule
    SkFunction
    SkBlock
    SkEquipBlock
    SkTraitDef
    SkForLoop

# ── Scope (Copy-friendly — no Dict) ────────────────────────

struct Scope:
    int parent
    ScopeKind kind

# ── Scope table ─────────────────────────────────────────────

struct ScopeTable:
    Vector[Scope] scopes
    Vector[DefInfo] definitions
    # Flat scope → name → def_id mapping. Parallel Vectors (not Dict)
    # so `find_name_entry` can scan backwards through insertion order
    # to resolve shadowing — most-recent define wins.
    Vector[int] name_scope_ids
    Vector[String] name_keys
    Vector[int] name_def_ids
    int current
    # PERF index (A): name → the list of name-table entry indices for
    # that name (in INSERTION order). `find_name_entry` scans this small
    # per-name list instead of the whole flat name table. Maintained at
    # the single `name_keys.push` site in `define_with_mutability`.
    Dict[String, Vector[int]] name_index
    # PERF index (B): scope id → its DIRECT child scope ids. Lets the
    # `lookup_in_subtree*` walks visit only descendants instead of every
    # scope. `children.len()` is kept == `scopes.len()`; grown in BOTH
    # `init` (root scope) and `push_scope`.
    Vector[Vector[int]] children
    # Variant name → def_ids. `alloc_def` (used for non-generic enum
    # variants, which are NOT in the value namespace nor the parallel name
    # table) records each variant here so `is_known_variant_name` is an O(K)
    # lookup rather than a linear scan of `definitions`. Mirrors Rust gg's
    # `name_index` role for `is_known_variant_name` (src/semantic/scope.rs:195/442).
    Dict[String, Vector[int]] variant_name_index

# ── Typed accessors ────

DefInfo get_def_at(Vector[DefInfo] v, int i):
    return v.get(i).unwrap()

Scope get_scope_at(Vector[Scope] v, int i):
    return v.get(i).unwrap()

bool def_kind_is_import(DefKind k):
    match k:
        case DkImport():
            return true
        else:
            return false

bool def_kind_is_trait(DefKind k):
    match k:
        case DkTrait():
            return true
        else:
            return false

bool def_kind_is_variant(DefKind k):
    match k:
        case DkVariant():
            return true
        else:
            return false

# Is `name` a known (non-generic) enum variant anywhere in the module?
#
# Non-generic enum variants are allocated via `alloc_def` (which does NOT
# insert into the scope's value namespace nor into the parallel name table)
# — they are accessed via qualified paths (`EnumName.Variant`). When the
# loader's pre-merge qualifier drops an ambiguous bare name, the resolver
# hits an `Identifier(name)` that is not in scope but is still a legitimate
# variant ref; this query lets the resolver stay silent for those names.
# Real undefined names (no variant anywhere) still report normally.
#
# Production-grade O(K) form: `alloc_def` records each variant's def_id in
# `variant_name_index` (name → def_ids), and this consults THAT index — it
# is NOT a linear scan of `definitions`. Mirrors Rust gg's
# `ScopeTable::is_known_variant_name` (src/semantic/scope.rs:442), adapted
# to the self-host's distinct `name_index` meaning (here `name_index` maps
# name → parallel-name-table indices, NOT def_ids, so variants need their
# own def_id index).
bool is_known_variant_name(ScopeTable scopes, String name):
    if scopes.variant_name_index.contains(name):
        Vector[int] ids = scopes.variant_name_index.get(name).unwrap()
        int j = 0
        while j < ids.len():
            int def_id = ids.get(j).unwrap()
            DefInfo d = get_def_at(scopes.definitions, def_id)
            if def_kind_is_variant(d.kind):
                return true
            j += 1
    return false

# ── ScopeTable methods ──────────────────────────────────────

equip ScopeTable:

    ScopeTable new_scope_table(): ScopeTable(
        Vector[Scope](),
        Vector[DefInfo](),
        Vector[int](),
        Vector[String](),
        Vector[int](),
        NO_SCOPE,
        Dict[String, Vector[int]](),
        Vector[Vector[int]](),
        Dict[String, Vector[int]]()
    )

    void init(&self):
        Scope root = Scope(NO_SCOPE, SkModule())
        self.scopes.push(root)
        # PERF index (B): keep `children.len() == scopes.len()`. The root
        # scope is created HERE (not via push_scope), so it needs its own
        # empty child-list slot or every later index is off-by-one. Its
        # parent is NO_SCOPE (-1) — no parent list to append to.
        Vector[int] root_children = []
        self.children.push(!root_children)
        self.current = 0

    int push_scope(&self, ScopeKind kind):
        int id = self.scopes.len()
        int parent = self.current
        Scope s = Scope(parent, kind)
        self.scopes.push(s)
        # PERF index (B): give the new scope its own empty child-list slot
        # (keeps `children.len() == scopes.len()`), then register it as a
        # direct child of its parent. Append to the parent list only when
        # `parent >= 0` (the root's parent is NO_SCOPE == -1).
        Vector[int] new_children = []
        self.children.push(!new_children)
        if parent >= 0:
            self.children.get(parent).unwrap().push(id)
        self.current = id
        return id

    void pop_scope(&self):
        int parent = self.scope_parent_of(self.current)
        if parent >= 0:
            self.current = parent

    # Convenience reader for a scope's parent id.
    int scope_parent_of(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    Option[int] define(&self, String name, DefKind kind, Span !span):
        return self.define_with_mutability(name, kind, !span, false)

    Option[int] define_with_mutability(&self, String name, DefKind kind, Span !span, bool is_mutable):
        # Check for existing definition in current scope using name table
        if self.find_name_entry(self.current, name.clone()) is Some(ni):
            return self.define_replace_or_fail(ni, name, kind, !span, is_mutable)
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name.clone(), kind, span, self.current, NO_DEF, is_mutable, false, false, -1, false)
        self.definitions.push(info)
        # PERF index (A): the new entry lands at index `i` in the parallel
        # name table. Capture `i` and the key BEFORE the `name_keys.push`
        # consumes `name`, then append `i` to the per-name index list (in
        # insertion order — preserves shadowing resolution).
        int i = self.name_keys.len()
        String key = name.clone()
        self.name_scope_ids.push(self.current)
        self.name_keys.push(name)
        self.name_def_ids.push(def_id)
        if self.name_index.contains(key):
            self.name_index.get(key).unwrap().push(i)
        else:
            Vector[int] v = [i]
            self.name_index.put(key, !v)
        return Some(def_id)

    # Try to replace or fail for duplicate definition (extracted for borrow checker)
    Option[int] define_replace_or_fail(&self, int ni, String name, DefKind kind, Span !span, bool is_mutable):
        int existing_def_id = self.name_def_ids.get(ni).unwrap()
        DefInfo existing = get_def_at(self.definitions, existing_def_id)
        bool existing_is_import = def_kind_is_import(existing.kind)
        bool existing_is_trait = def_kind_is_trait(existing.kind)
        bool existing_is_dummy = existing.span.start == 0 and existing.span.end == 0

        bool new_is_import = def_kind_is_import(kind)
        bool new_is_trait = def_kind_is_trait(kind)

        bool allow_replace = false
        if existing_is_import and not new_is_import:
            allow_replace = true
        if existing_is_import and existing_is_dummy:
            allow_replace = true
        if existing_is_trait and existing_is_dummy and not new_is_trait:
            allow_replace = true

        if allow_replace:
            int def_id = self.definitions.len()
            DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, is_mutable, false, false, -1, false)
            self.definitions.push(info)
            self.name_def_ids.set(ni, def_id)
            return Some(def_id)
        # Duplicate definition error — return None to signal failure
        return None()

    # Allocate a definition without inserting into the current scope's name table.
    # Used for non-generic enum variants which have def_ids but aren't in scope.
    int alloc_def(&self, String name, DefKind kind, Span !span):
        int def_id = self.definitions.len()
        # Index variants by name so `is_known_variant_name` is O(K), not a
        # linear scan. Capture the key/variant-ness BEFORE `name` is consumed
        # by the DefInfo ctor below.
        String vkey = name.clone()
        bool is_variant = def_kind_is_variant(kind)
        DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, false, false, false, -1, false)
        self.definitions.push(info)
        if is_variant:
            if self.variant_name_index.contains(vkey):
                self.variant_name_index.get(vkey).unwrap().push(def_id)
            else:
                Vector[int] v = [def_id]
                self.variant_name_index.put(vkey, !v)
        return def_id

    # Find name entry index in flat table (returns None if not found).
    #
    # PERF index (A): instead of scanning the WHOLE flat name table
    # backwards, look up the small per-name index list and scan only
    # THAT backwards. The list is already filtered to `name_keys[i] ==
    # name` by construction (entries are appended in insertion order),
    # so scanning it backward and returning the first entry whose
    # `name_scope_ids[i] == scope_id` yields the SAME winner the old
    # full backward scan did: the highest matching index (most-recent
    # define wins → correct shadowing). Absent name → None, as before.
    Option[int] find_name_entry(self, int scope_id, String name):
        if self.name_index.contains(name):
            Vector[int] idxs = self.name_index.get(name).unwrap()
            int j = idxs.len() - 1
            while j >= 0:
                int i = idxs.get(j).unwrap()
                if self.name_scope_ids.get(i).unwrap() == scope_id:
                    return Some(i)
                j = j - 1
        return None()

    Option[int] lookup(self, String name):
        int scope_id = self.current
        while scope_id >= 0:
            if self.find_name_entry(scope_id, name) is Some(ni):
                return Some(self.name_def_ids.get(ni).unwrap())
            Scope s = get_scope_at(self.scopes, scope_id)
            scope_id = s.parent
        return None()

    Option[int] lookup_from_scope(self, int scope_id, String name):
        int sid = scope_id
        while sid >= 0:
            if self.find_name_entry(sid, name) is Some(ni):
                return Some(self.name_def_ids.get(ni).unwrap())
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return None()

    Option[int] lookup_in_scope(self, int scope_id, String name):
        if self.find_name_entry(scope_id, name) is Some(ni):
            return Some(self.name_def_ids.get(ni).unwrap())
        return None()

    # Collect the transitive descendant scope ids of `root_scope` via the
    # `children` adjacency index (PERF index B). Each scope appears once
    # (the scope graph is a tree), so the worklist terminates. The set is
    # NOT id-sorted; callers that need ascending-id order track the
    # minimum matching id explicitly.
    Vector[int] collect_descendants(self, int root_scope):
        Vector[int] desc = []
        if root_scope < 0 or root_scope >= self.children.len():
            return desc
        Vector[int] root_kids = self.children.get(root_scope).unwrap()
        for k in root_kids:
            desc.push(k)
        int wi = 0
        while wi < desc.len():
            int cur = desc.get(wi).unwrap()
            Vector[int] kids = self.children.get(cur).unwrap()
            for k in kids:
                desc.push(k)
            wi = wi + 1
        return desc

    # Search scope and all descendant scopes for a name.
    # Returns the first matching def_id or None.
    #
    # PERF index (B): visit only the transitive descendants of
    # `root_scope` (via `children`) instead of EVERY scope. The original
    # checked the root first, then scanned scope ids ASCENDING from
    # `root_scope+1`, returning the first descendant with a match — i.e.
    # the match at the SMALLEST descendant id. We reproduce that exactly:
    # check the root first, then over the collected descendant set pick
    # the matching scope with the minimum id (provably identical winner).
    Option[int] lookup_in_subtree(self, int root_scope, String name):
        # Check root scope first
        if self.find_name_entry(root_scope, name) is Some(ni):
            return Some(self.name_def_ids.get(ni).unwrap())
        Vector[int] desc = self.collect_descendants(root_scope)
        int best_sid = -1
        int best_def = NO_DEF
        int di = 0
        while di < desc.len():
            int sid = desc.get(di).unwrap()
            if best_sid < 0 or sid < best_sid:
                if self.find_name_entry(sid, name) is Some(cni):
                    best_sid = sid
                    best_def = self.name_def_ids.get(cni).unwrap()
            di = di + 1
        if best_sid >= 0:
            return Some(best_def)
        return None()

    # Like lookup_in_subtree, but skips defs that already have a type
    # assigned (only returns a def whose `type_id < 0`). Used by
    # assign_pattern_types to find the correct def when the same name
    # appears in multiple match arm scopes.
    #
    # PERF index (B): same descendant-only walk as lookup_in_subtree.
    # CRITICAL — the original does NOT short-circuit on a root match
    # whose `type_id >= 0`: it falls through to the descendants. We
    # preserve that (the root `return` is gated on `type_id < 0`). At
    # every descendant the `type_id < 0` filter applies identically, and
    # we return the qualifying match at the SMALLEST descendant id —
    # exactly what the original ascending scan returned.
    Option[int] lookup_in_subtree_untyped(self, int root_scope, String name):
        if self.find_name_entry(root_scope, name) is Some(ni):
            int did = self.name_def_ids.get(ni).unwrap()
            DefInfo d = get_def_at(self.definitions, did)
            if d.type_id < 0:
                return Some(did)
        Vector[int] desc = self.collect_descendants(root_scope)
        int best_sid = -1
        int best_def = NO_DEF
        int di = 0
        while di < desc.len():
            int sid = desc.get(di).unwrap()
            if best_sid < 0 or sid < best_sid:
                if self.find_name_entry(sid, name) is Some(cni):
                    int cdid = self.name_def_ids.get(cni).unwrap()
                    DefInfo cd = get_def_at(self.definitions, cdid)
                    if cd.type_id < 0:
                        best_sid = sid
                        best_def = cdid
            di = di + 1
        if best_sid >= 0:
            return Some(best_def)
        return None()

    DefInfo get_def(self, int id):
        return get_def_at(self.definitions, id)

    void set_def_param(&self, int id, bool is_param):
        # Use direct field assignment on definition
        # Vector elements aren't mutable in place via .get(); copy, mutate, write back.
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_param = is_param
        self.definitions.set(id, d)

    void set_def_type(&self, int id, int type_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.type_id = type_id
        self.definitions.set(id, d)

    # D4/D12: mark a type def as drop-tainted (set by `compute_drop_taint`).
    void set_def_drop_tainted(&self, int id, bool tainted):
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_drop_tainted = tainted
        self.definitions.set(id, d)

    # D10(b) Copy axis: mark a type def Copy/non-Copy (set by `compute_is_copy`).
    void set_def_is_copy(&self, int id, bool copy):
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_copy = copy
        self.definitions.set(id, d)

    # D12 position 6: record a parameter def's ownership sigil (OWN_*).
    void set_def_param_ownership(&self, int id, int own):
        DefInfo d = self.definitions.get(id).unwrap()
        d.param_ownership = own
        self.definitions.set(id, d)

    void set_def_scope_id(&self, int id, int scope_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.scope_id = scope_id
        self.definitions.set(id, d)

    int current_scope(self):
        return self.current

    void set_current(&self, int id):
        self.current = id

    int def_count(self):
        return self.definitions.len()

    int scope_count(self):
        return self.scopes.len()

    ScopeKind scope_kind(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.kind

    int scope_parent(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    bool is_descendant_of(self, int child, int parent):
        int sid = child
        while sid >= 0:
            if sid == parent:
                return true
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return false

    Option[int] lookup_def_by_span(self, String name, Span span):
        for (i, d) in self.definitions.enumerate():
            if d.name == name and d.span.start == span.start and d.span.end == span.end:
                return Some(i)
        return None()
