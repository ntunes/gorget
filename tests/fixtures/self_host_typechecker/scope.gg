# Scope tree and definition table for name resolution.
#
# The name table (`name_scope_ids` + `name_keys` + `name_def_ids`) is
# intentionally a flat parallel-Vector (not a Dict) so that
# `find_name_entry` can scan backwards through insertion order to
# resolve shadowing — the most-recent define for a given (scope, name)
# wins.

from std.collections import Vector
from ast import Span
from ids import NO_DEF, NO_SCOPE

# ── Definition kinds ────────────────────────────────────────

enum DefKind:
    DkFunction
    DkStruct
    DkEnum
    DkVariant
    DkTrait
    DkTypeAlias
    DkNewtype
    DkVariable
    DkConst
    DkStatic
    DkGenericParam
    DkImport

# ── Definition info ─────────────────────────────────────────

struct DefInfo:
    String name
    DefKind kind
    Span span
    int scope_id
    int type_id
    bool is_mutable
    bool is_param

# ── Scope kinds ─────────────────────────────────────────────

enum ScopeKind:
    SkModule
    SkFunction
    SkBlock
    SkEquipBlock
    SkTraitDef
    SkForLoop

# ── Scope (Copy-friendly — no Dict) ────────────────────────

struct Scope:
    int parent
    ScopeKind kind

# ── Scope table ─────────────────────────────────────────────

struct ScopeTable:
    Vector[Scope] scopes
    Vector[DefInfo] definitions
    # Flat scope → name → def_id mapping. Parallel Vectors (not Dict)
    # so `find_name_entry` can scan backwards through insertion order
    # to resolve shadowing — most-recent define wins.
    Vector[int] name_scope_ids
    Vector[String] name_keys
    Vector[int] name_def_ids
    int current

# ── Typed accessors ────

DefInfo get_def_at(Vector[DefInfo] v, int i):
    return v.get(i).unwrap()

Scope get_scope_at(Vector[Scope] v, int i):
    return v.get(i).unwrap()

bool def_kind_is_import(DefKind k):
    match k:
        case DkImport():
            return true
        else:
            return false

bool def_kind_is_trait(DefKind k):
    match k:
        case DkTrait():
            return true
        else:
            return false

# ── ScopeTable methods ──────────────────────────────────────

equip ScopeTable:

    ScopeTable new_scope_table(): ScopeTable(
        Vector[Scope](),
        Vector[DefInfo](),
        Vector[int](),
        Vector[String](),
        Vector[int](),
        NO_SCOPE
    )

    void init(&self):
        Scope root = Scope(NO_SCOPE, SkModule())
        self.scopes.push(root)
        self.current = 0

    int push_scope(&self, ScopeKind kind):
        int id = self.scopes.len()
        Scope s = Scope(self.current, kind)
        self.scopes.push(s)
        self.current = id
        return id

    void pop_scope(&self):
        int parent = self.scope_parent_of(self.current)
        if parent >= 0:
            self.current = parent

    # Read scope parent without typed accessor (avoids memset bug)
    int scope_parent_of(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    Option[int] define(&self, String name, DefKind kind, Span !span):
        return self.define_with_mutability(name, kind, span, false)

    Option[int] define_with_mutability(&self, String name, DefKind kind, Span !span, bool is_mutable):
        # Check for existing definition in current scope using name table
        if self.find_name_entry(self.current, name.clone()) is Some(ni):
            return self.define_replace_or_fail(ni, name, kind, span, is_mutable)
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name.clone(), kind, span, self.current, NO_DEF, is_mutable, false)
        self.definitions.push(info)
        self.name_scope_ids.push(self.current)
        self.name_keys.push(name)
        self.name_def_ids.push(def_id)
        return Some(def_id)

    # Try to replace or fail for duplicate definition (extracted for borrow checker)
    Option[int] define_replace_or_fail(&self, int ni, String name, DefKind kind, Span !span, bool is_mutable):
        int existing_def_id = self.name_def_ids.get(ni).unwrap()
        DefInfo existing = get_def_at(self.definitions, existing_def_id)
        bool existing_is_import = def_kind_is_import(existing.kind)
        bool existing_is_trait = def_kind_is_trait(existing.kind)
        bool existing_is_dummy = existing.span.start == 0 and existing.span.end == 0

        bool new_is_import = def_kind_is_import(kind)
        bool new_is_trait = def_kind_is_trait(kind)

        bool allow_replace = false
        if existing_is_import and not new_is_import:
            allow_replace = true
        if existing_is_import and existing_is_dummy:
            allow_replace = true
        if existing_is_trait and existing_is_dummy and not new_is_trait:
            allow_replace = true

        if allow_replace:
            int def_id = self.definitions.len()
            DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, is_mutable, false)
            self.definitions.push(info)
            self.name_def_ids.set(ni, def_id)
            return Some(def_id)
        # Duplicate definition error — return None to signal failure
        return None()

    # Allocate a definition without inserting into the current scope's name table.
    # Used for non-generic enum variants which have def_ids but aren't in scope.
    int alloc_def(&self, String name, DefKind kind, Span !span):
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, false, false)
        self.definitions.push(info)
        return def_id

    # Find name entry index in flat table (returns None if not found)
    Option[int] find_name_entry(self, int scope_id, String name):
        int i = self.name_scope_ids.len() - 1
        while i >= 0:
            if self.name_scope_ids.get(i).unwrap() == scope_id:
                if self.name_keys.get(i).unwrap() == name:
                    return Some(i)
            i = i - 1
        return None()

    Option[int] lookup(self, String name):
        int scope_id = self.current
        while scope_id >= 0:
            if self.find_name_entry(scope_id, name) is Some(ni):
                return Some(self.name_def_ids.get(ni).unwrap())
            Scope s = get_scope_at(self.scopes, scope_id)
            scope_id = s.parent
        return None()

    Option[int] lookup_from_scope(self, int scope_id, String name):
        int sid = scope_id
        while sid >= 0:
            if self.find_name_entry(sid, name) is Some(ni):
                return Some(self.name_def_ids.get(ni).unwrap())
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return None()

    Option[int] lookup_in_scope(self, int scope_id, String name):
        if self.find_name_entry(scope_id, name) is Some(ni):
            return Some(self.name_def_ids.get(ni).unwrap())
        return None()

    # Search scope and all descendant scopes for a name.
    # Returns the first matching def_id or None.
    Option[int] lookup_in_subtree(self, int root_scope, String name):
        # Check root scope first
        if self.find_name_entry(root_scope, name) is Some(ni):
            return Some(self.name_def_ids.get(ni).unwrap())
        # Check all child scopes (any scope whose parent chain includes root_scope)
        int sid = root_scope + 1
        while sid < self.scopes.len():
            # Walk parent chain to see if this scope descends from root_scope
            bool is_child = false
            int p = sid
            while p >= 0:
                Scope ps = get_scope_at(self.scopes, p)
                if ps.parent == root_scope:
                    is_child = true
                    p = -1
                elif ps.parent < root_scope:
                    p = -1
                else:
                    p = ps.parent
            if is_child:
                if self.find_name_entry(sid, name) is Some(cni):
                    return Some(self.name_def_ids.get(cni).unwrap())
            sid = sid + 1
        return None()

    # Like lookup_in_subtree, but skips defs that already have a type assigned.
    # Used by assign_pattern_types to find the correct def when the same name
    # appears in multiple match arm scopes.
    Option[int] lookup_in_subtree_untyped(self, int root_scope, String name):
        if self.find_name_entry(root_scope, name) is Some(ni):
            int did = self.name_def_ids.get(ni).unwrap()
            DefInfo d = get_def_at(self.definitions, did)
            if d.type_id < 0:
                return Some(did)
        int sid = root_scope + 1
        while sid < self.scopes.len():
            bool is_child = false
            int p = sid
            while p >= 0:
                Scope ps = get_scope_at(self.scopes, p)
                if ps.parent == root_scope:
                    is_child = true
                    p = -1
                elif ps.parent < root_scope:
                    p = -1
                else:
                    p = ps.parent
            if is_child:
                if self.find_name_entry(sid, name) is Some(cni):
                    int cdid = self.name_def_ids.get(cni).unwrap()
                    DefInfo cd = get_def_at(self.definitions, cdid)
                    if cd.type_id < 0:
                        return Some(cdid)
            sid = sid + 1
        return None()

    DefInfo get_def(self, int id):
        return get_def_at(self.definitions, id)

    void set_def_param(&self, int id, bool is_param):
        # Use direct field assignment on definition
        # Can't use get_def_at in &self (memset bug), so reconstruct
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_param = is_param
        self.definitions.set(id, d)

    void set_def_type(&self, int id, int type_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.type_id = type_id
        self.definitions.set(id, d)

    void set_def_scope_id(&self, int id, int scope_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.scope_id = scope_id
        self.definitions.set(id, d)

    int current_scope(self):
        return self.current

    void set_current(&self, int id):
        self.current = id

    int def_count(self):
        return self.definitions.len()

    int scope_count(self):
        return self.scopes.len()

    ScopeKind scope_kind(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.kind

    int scope_parent(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    bool is_descendant_of(self, int child, int parent):
        int sid = child
        while sid >= 0:
            if sid == parent:
                return true
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return false

    Option[int] lookup_def_by_span(self, String name, Span span):
        for (i, d) in self.definitions.enumerate():
            if d.name == name and d.span.start == span.start and d.span.end == span.end:
                return Some(i)
        return None()
