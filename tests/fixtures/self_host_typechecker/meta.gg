# Meta type alias expansion for the self-hosted type checker.
# Evaluates meta const values and resolves meta type aliases so that
# the type checker can resolve types like `Num` (alias for `int`).

from ast import Module, Item, IMetaConst, IMetaType, IMetaTypeFunc, IFunction, IEquip
from ast import IMetaIf, ItemElseBranch, IImport, ITrait, ImportStmt, TraitDef
from ast import IStruct, IEnum, IConstDecl, IStaticDecl, ITypeAlias, INewtype
from ast import IExternBlock, ITest, IBench, ISuiteSetup, ISuiteTeardown, StructDef
from ast import MetaTypeRhs, MtrPlain, MtrConditional, MtrCall, MtrUnresolved
from ast import SpannedType, Type, TPrimitive, TNamed, TInferred, SpannedExpr, Expr, Span, Param
from ast import EStructLiteral, EAs
from ast import EIntLiteral, EFloatLiteral, EBoolLiteral, EStringLiteral
from ast import EIdentifier, EBinaryOp, EUnaryOp, ECall
from ast import EMethodCall, EFieldAccess, EIndex, EFString, EArrayLiteral
from ast import Stmt, SMatch, SMetaForMatch, SIf, SWhile, SFor, SReturn, SExpr
from ast import SVarDecl, SAssign, SCompoundAssign, SMetaFor, SMetaIf
from ast import MatchArm, ElseBranch, EnumDef, EnumVariant, FunctionDef, EquipBlock
from ast import SpannedPattern, Pattern, PConstructor, PWildcard, PBinding
from types import TypeTable
from std.collections import Vector, Dict
from std.fs import read_file

# ── Constant expression evaluator ─────────────────────────────

# Evaluate a meta const expression to an int value.
# Returns (value, ok).
int eval_int(Expr e, Dict[String, int] &int_env):
    match e:
        case EIntLiteral(n):
            return n
        case EIdentifier(name):
            if int_env.contains(name):
                return int_env[name]
            return 0
        case EBinaryOp(left, op, right):
            int lv = eval_int((*left).expr, &int_env)
            int rv = eval_int((*right).expr, &int_env)
            if op == "+":
                return lv + rv
            elif op == "-":
                return lv - rv
            elif op == "*":
                return lv * rv
            elif op == "/":
                if rv != 0:
                    return lv / rv
                return 0
            elif op == "%":
                if rv != 0:
                    return lv % rv
                return 0
            return 0
        case EUnaryOp(op, operand):
            int v = eval_int((*operand).expr, &int_env)
            if op == "-":
                return 0 - v
            return v
        else:
            return 0

# Evaluate a meta const expression to a bool value.
bool eval_bool(Expr e, Dict[String, bool] &bool_env):
    match e:
        case EBoolLiteral(b):
            return b
        case EIdentifier(name):
            if bool_env.contains(name):
                return bool_env[name]
            return false
        else:
            return false

# ── Type name extraction ──────────────────────────────────────

# Extract the canonical type name string from a SpannedType.
# For primitives, returns the primitive name. For named types without
# generic args, returns the type name. Returns "" on failure.
String meta_type_to_name(Type ty):
    match ty:
        case TPrimitive(name):
            return name
        case TNamed(name, args):
            if args.len() == 0:
                return name
            return ""
        else:
            return ""

# ── Meta type function evaluator ──────────────────────────────

# Evaluate a call to a meta type function like sized_int(8).
# Returns the resolved type name or "" on failure.
String eval_type_func_call(String callee, Vector[SpannedExpr] &call_args,
                        Dict[String, int] &int_env):
    # Currently handles well-known type functions
    if callee == "sized_int" and call_args.len() == 1:
        SpannedExpr arg0 = call_args.get(0).unwrap()
        int bits = eval_int(arg0.expr, &int_env)
        if bits <= 8:
            return "int8"
        elif bits <= 16:
            return "int16"
        elif bits <= 32:
            return "int32"
        else:
            return "int64"
    elif callee == "arch_word_bits":
        return "int64"
    return ""

# ── [PROTOTYPE] sizeof / typename builtins ────────────────────

int meta_type_byte_size(String tn):
    if tn == "int" or tn == "int64" or tn == "uint64" or tn == "float" or tn == "float64":
        return 8
    elif tn == "bool" or tn == "int8" or tn == "uint8":
        return 1
    elif tn == "int16" or tn == "uint16":
        return 2
    elif tn == "int32" or tn == "uint32" or tn == "float32":
        return 4
    elif tn == "String":
        return 32
    elif tn == "cstr":
        return 8
    return 8

int meta_type_align(String tn):
    int sz = meta_type_byte_size(tn)
    if tn == "String":
        return 8
    return sz

String meta_typename(Type ty):
    match ty:
        case TPrimitive(name):
            if name == "str":
                return "String"
            return name
        case TNamed(name, args):
            if args.len() == 0:
                return name
            String inner = ""
            int ai = 0
            while ai < args.len():
                if ai > 0:
                    inner = inner + ", "
                inner = inner + meta_typename(args.get(ai).unwrap().ty)
                ai = ai + 1
            return name + "[" + inner + "]"
        else:
            return ""

# ── [PROTOTYPE] M7 user-function meta evaluator ───────────────
# Interprets a pure primitive-typed function body at compile time so
# `meta int X = square(2)` resolves. Mirrors Rust eval_meta_fn_call.

FunctionDef find_meta_fn(Module &m, String name, bool &found):
    int i = 0
    while i < m.items.len():
        match m.items.get(i).unwrap():
            case IFunction(fdef):
                if fdef.name == name:
                    found = true
                    return fdef
            else:
                pass
        i = i + 1
    found = false
    return FunctionDef("", Vector[Param](), SpannedType(TInferred(), Span(0, 0)), Vector[String](), Vector[Stmt](), false, None, false)

# Evaluate an int expr, recursing into user-fn calls and sizeof/alignof.
int eval_int_ex(Expr e, Dict[String, int] &env, Module &m, int depth, bool &ok):
    if depth > 256:
        ok = false
        return 0
    match e:
        case EIntLiteral(n):
            return n
        case EIdentifier(name):
            if env.contains(name):
                return env[name]
            ok = false
            return 0
        case EBinaryOp(left, op, right):
            int lv = eval_int_ex((*left).expr, &env, &m, depth, &ok)
            int rv = eval_int_ex((*right).expr, &env, &m, depth, &ok)
            if op == "+":
                return lv + rv
            elif op == "-":
                return lv - rv
            elif op == "*":
                return lv * rv
            elif op == "/":
                if rv != 0:
                    return lv / rv
                return 0
            elif op == "%":
                if rv != 0:
                    return lv % rv
                return 0
            ok = false
            return 0
        case EUnaryOp(op, operand):
            int v = eval_int_ex((*operand).expr, &env, &m, depth, &ok)
            if op == "-":
                return 0 - v
            return v
        case ECall(callee, args, _, targs):
            match (*callee).expr:
                case EIdentifier(fn_name):
                    if fn_name == "sizeof" and args.len() == 1:
                        return meta_type_byte_size(meta_typename(arg_as_type(args.get(0).unwrap())))
                    elif fn_name == "alignof" and args.len() == 1:
                        return meta_type_align(meta_typename(arg_as_type(args.get(0).unwrap())))
                    elif fn_name == "arch_word_bits" and args.len() == 0:
                        return 64
                    # User meta-fn call
                    bool fnd = false
                    FunctionDef fdef = find_meta_fn(&m, fn_name, &fnd)
                    if fnd:
                        Dict[String, int] callenv = Dict[String, int]()
                        int pi = 0
                        while pi < fdef.params.len() and pi < args.len():
                            int av = eval_int_ex(args.get(pi).unwrap().expr, &env, &m, depth + 1, &ok)
                            callenv[fdef.params.get(pi).unwrap().param_name] = av
                            pi = pi + 1
                        bool ret = false
                        int rv = eval_meta_fn_body(fdef, &callenv, &m, depth + 1, &ret, &ok)
                        return rv
                    ok = false
                    return 0
                else:
                    ok = false
                    return 0
        else:
            ok = false
            return 0

# Interpret a function body's statements, returning the int value of the
# first `return` reached. Supports if/elif/else, while, var-decl, assign.
int eval_meta_fn_body(FunctionDef fdef, Dict[String, int] &env, Module &m, int depth, bool &returned, bool &ok):
    if fdef.is_expr_body and fdef.body.len() == 1:
        match fdef.body.get(0).unwrap():
            case SExpr(e):
                returned = true
                return eval_int_ex(e.expr, &env, &m, depth, &ok)
            case SReturn(oe):
                match oe:
                    case Some(e):
                        returned = true
                        return eval_int_ex(e.expr, &env, &m, depth, &ok)
                    case None:
                        returned = true
                        return 0
            else:
                pass
    return eval_stmts(fdef.body, &env, &m, depth, &returned, &ok)

int eval_stmts(Vector[Stmt] stmts, Dict[String, int] &env, Module &m, int depth, bool &returned, bool &ok):
    int si = 0
    int iters = 0
    while si < stmts.len():
        Stmt s = stmts.get(si).unwrap()
        match s:
            case SReturn(oe):
                match oe:
                    case Some(e):
                        returned = true
                        return eval_int_ex(e.expr, &env, &m, depth, &ok)
                    case None:
                        returned = true
                        return 0
            case SVarDecl(ty, name, val, _, _, _):
                env[name] = eval_int_ex(val.expr, &env, &m, depth, &ok)
            case SAssign(lhs, rhs):
                match lhs.expr:
                    case EIdentifier(nm):
                        env[nm] = eval_int_ex(rhs.expr, &env, &m, depth, &ok)
                    else:
                        pass
            case SCompoundAssign(lhs, op, rhs):
                match lhs.expr:
                    case EIdentifier(nm):
                        int cur = 0
                        if env.contains(nm):
                            cur = env[nm]
                        int delta = eval_int_ex(rhs.expr, &env, &m, depth, &ok)
                        if op == "+=":
                            env[nm] = cur + delta
                        elif op == "-=":
                            env[nm] = cur - delta
                        elif op == "*=":
                            env[nm] = cur * delta
                        elif op == "/=":
                            if delta != 0:
                                env[nm] = cur / delta
                    else:
                        pass
            case SIf(cond, then_b, else_branches):
                if eval_bool_ex(cond.expr, &env, &m, depth, &ok):
                    int rv = eval_stmts(then_b, &env, &m, depth, &returned, &ok)
                    if returned:
                        return rv
                else:
                    bool took = false
                    int ei = 0
                    while ei < else_branches.len() and not took:
                        ElseBranch eb = else_branches.get(ei).unwrap()
                        bool run_it = false
                        match eb.condition:
                            case Some(c):
                                run_it = eval_bool_ex(c.expr, &env, &m, depth, &ok)
                            case None:
                                run_it = true
                        if run_it:
                            took = true
                            int rv = eval_stmts(eb.body, &env, &m, depth, &returned, &ok)
                            if returned:
                                return rv
                        ei = ei + 1
            case SWhile(cond, body):
                while eval_bool_ex(cond.expr, &env, &m, depth, &ok):
                    iters = iters + 1
                    if iters > 100000:
                        ok = false
                        return 0
                    int rv = eval_stmts(body, &env, &m, depth, &returned, &ok)
                    if returned:
                        return rv
            else:
                pass
        si = si + 1
    return 0

# Evaluate a meta bool const RHS. Handles bool literals/identifiers, int
# comparisons (BITS == 64), and/or/not, and feature()/debug() (false by
# default — no --feature flags under the runtime-diff harness).
bool eval_meta_bool(Expr e, Dict[String, int] &iv, Dict[String, bool] &bv, Module &m, bool &ok):
    match e:
        case EBoolLiteral(b):
            return b
        case EIdentifier(name):
            if bv.contains(name):
                return bv[name]
            ok = false
            return false
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fn_name):
                    if fn_name == "feature":
                        return false
                    elif fn_name == "debug":
                        return false
                    ok = false
                    return false
                else:
                    ok = false
                    return false
        case EUnaryOp(op, operand):
            if op == "not":
                return not eval_meta_bool((*operand).expr, &iv, &bv, &m, &ok)
            ok = false
            return false
        case EBinaryOp(left, op, right):
            if op == "and":
                return eval_meta_bool((*left).expr, &iv, &bv, &m, &ok) and eval_meta_bool((*right).expr, &iv, &bv, &m, &ok)
            elif op == "or":
                return eval_meta_bool((*left).expr, &iv, &bv, &m, &ok) or eval_meta_bool((*right).expr, &iv, &bv, &m, &ok)
            bool iok = true
            int lv = eval_int_ex((*left).expr, &iv, &m, 0, &iok)
            int rv = eval_int_ex((*right).expr, &iv, &m, 0, &iok)
            if iok:
                if op == "==":
                    return lv == rv
                elif op == "!=":
                    return lv != rv
                elif op == "<":
                    return lv < rv
                elif op == ">":
                    return lv > rv
                elif op == "<=":
                    return lv <= rv
                elif op == ">=":
                    return lv >= rv
            ok = false
            return false
        else:
            ok = false
            return false

bool eval_bool_ex(Expr e, Dict[String, int] &env, Module &m, int depth, bool &ok):
    match e:
        case EBoolLiteral(b):
            return b
        case EBinaryOp(left, op, right):
            if op == "and":
                return eval_bool_ex((*left).expr, &env, &m, depth, &ok) and eval_bool_ex((*right).expr, &env, &m, depth, &ok)
            elif op == "or":
                return eval_bool_ex((*left).expr, &env, &m, depth, &ok) or eval_bool_ex((*right).expr, &env, &m, depth, &ok)
            int lv = eval_int_ex((*left).expr, &env, &m, depth, &ok)
            int rv = eval_int_ex((*right).expr, &env, &m, depth, &ok)
            if op == "<":
                return lv < rv
            elif op == ">":
                return lv > rv
            elif op == "<=":
                return lv <= rv
            elif op == ">=":
                return lv >= rv
            elif op == "==":
                return lv == rv
            elif op == "!=":
                return lv != rv
            return false
        case EUnaryOp(op, operand):
            if op == "not":
                return not eval_bool_ex((*operand).expr, &env, &m, depth, &ok)
            return false
        else:
            return false

# Extract the Type from a sizeof/alignof/typename argument expression.
# The argument parses as an expression (EIdentifier for `int`, ECall for
# `Vector[int]` etc.); reconstruct a Type for typename rendering.
Type arg_as_type(SpannedExpr arg):
    match arg.expr:
        case EIdentifier(name):
            if name == "int" or name == "bool" or name == "float" or name == "String" or name == "cstr" or name == "int8" or name == "int16" or name == "int32" or name == "int64" or name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64" or name == "float32" or name == "float64" or name == "str":
                return TPrimitive(name)
            return TNamed(name, Vector[SpannedType]())
        case ECall(callee, args, _, targs):
            match (*callee).expr:
                case EIdentifier(name):
                    Vector[SpannedType] tas = Vector[SpannedType]()
                    int i = 0
                    while i < args.len():
                        tas.push(SpannedType(arg_as_type(args.get(i).unwrap()), arg.span))
                        i = i + 1
                    return TNamed(name, tas)
                else:
                    return TInferred()
        case EIndex(base, idx):
            match (*base).expr:
                case EIdentifier(name):
                    Vector[SpannedType] tas = Vector[SpannedType]()
                    tas.push(SpannedType(arg_as_type(*idx), arg.span))
                    return TNamed(name, tas)
                else:
                    return TInferred()
        else:
            return TInferred()

# ── [PROTOTYPE] meta-const substitution into the AST ──────────
# After collecting const values, replace every EIdentifier reference to
# a known meta const with its literal value, mirroring Rust Phase 2
# `substitute_item`. Only int/bool/str consts are substituted.

SpannedExpr subst_expr(SpannedExpr se, Dict[String, int] &iv, Dict[String, bool] &bv, Dict[String, String] &sv):
    match se.expr:
        case EIdentifier(name):
            if iv.contains(name):
                return SpannedExpr(EIntLiteral(iv[name]), se.span)
            elif bv.contains(name):
                return SpannedExpr(EBoolLiteral(bv[name]), se.span)
            elif sv.contains(name):
                return SpannedExpr(EStringLiteral(sv[name], false), se.span)
            return se
        case EBinaryOp(l, op, r):
            return SpannedExpr(EBinaryOp(Box(subst_expr(*l, &iv, &bv, &sv)), op, Box(subst_expr(*r, &iv, &bv, &sv))), se.span)
        case EUnaryOp(op, operand):
            return SpannedExpr(EUnaryOp(op, Box(subst_expr(*operand, &iv, &bv, &sv))), se.span)
        case ECall(callee, args, arg_names, targs):
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            int i = 0
            while i < args.len():
                na.push(subst_expr(args.get(i).unwrap(), &iv, &bv, &sv))
                i = i + 1
            return SpannedExpr(ECall(Box(subst_expr(*callee, &iv, &bv, &sv)), na, arg_names, targs), se.span)
        case EMethodCall(recv, mname, args, arg_names, targs):
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            int i = 0
            while i < args.len():
                na.push(subst_expr(args.get(i).unwrap(), &iv, &bv, &sv))
                i = i + 1
            return SpannedExpr(EMethodCall(Box(subst_expr(*recv, &iv, &bv, &sv)), mname, na, arg_names, targs), se.span)
        case EFieldAccess(base, fname):
            return SpannedExpr(EFieldAccess(Box(subst_expr(*base, &iv, &bv, &sv)), fname), se.span)
        case EIndex(base, idx):
            return SpannedExpr(EIndex(Box(subst_expr(*base, &iv, &bv, &sv)), Box(subst_expr(*idx, &iv, &bv, &sv))), se.span)
        case EFString(raw, parts):
            Vector[SpannedExpr] np = Vector[SpannedExpr]()
            int i = 0
            while i < parts.len():
                np.push(subst_expr(parts.get(i).unwrap(), &iv, &bv, &sv))
                i = i + 1
            return SpannedExpr(EFString(raw, np), se.span)
        case EArrayLiteral(elems):
            Vector[SpannedExpr] ne = Vector[SpannedExpr]()
            int i = 0
            while i < elems.len():
                ne.push(subst_expr(elems.get(i).unwrap(), &iv, &bv, &sv))
                i = i + 1
            return SpannedExpr(EArrayLiteral(ne), se.span)
        else:
            return se

Vector[Stmt] subst_stmts(Vector[Stmt] stmts, Dict[String, int] &iv, Dict[String, bool] &bv, Dict[String, String] &sv):
    Vector[Stmt] out = Vector[Stmt]()
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        match s:
            case SExpr(e):
                out.push(SExpr(subst_expr(e, &iv, &bv, &sv)))
            case SReturn(oe):
                match oe:
                    case Some(e):
                        out.push(SReturn(Some(subst_expr(e, &iv, &bv, &sv))))
                    case None:
                        out.push(s)
            case SVarDecl(ty, name, val, a, b, c):
                out.push(SVarDecl(ty, name, subst_expr(val, &iv, &bv, &sv), a, b, c))
            case SAssign(lhs, rhs):
                out.push(SAssign(subst_expr(lhs, &iv, &bv, &sv), subst_expr(rhs, &iv, &bv, &sv)))
            case SCompoundAssign(lhs, op, rhs):
                out.push(SCompoundAssign(subst_expr(lhs, &iv, &bv, &sv), op, subst_expr(rhs, &iv, &bv, &sv)))
            case SIf(cond, then_b, else_branches):
                Vector[ElseBranch] nb = Vector[ElseBranch]()
                int ei = 0
                while ei < else_branches.len():
                    ElseBranch eb = else_branches.get(ei).unwrap()
                    Option[SpannedExpr] nc = None
                    match eb.condition:
                        case Some(c):
                            nc = Some(subst_expr(c, &iv, &bv, &sv))
                        case None:
                            nc = None
                    nb.push(ElseBranch(nc, subst_stmts(eb.body, &iv, &bv, &sv)))
                    ei = ei + 1
                out.push(SIf(subst_expr(cond, &iv, &bv, &sv), subst_stmts(then_b, &iv, &bv, &sv), nb))
            case SWhile(cond, body):
                out.push(SWhile(subst_expr(cond, &iv, &bv, &sv), subst_stmts(body, &iv, &bv, &sv)))
            case SFor(pat, iter_e, body, own, else_b):
                out.push(SFor(pat, subst_expr(iter_e, &iv, &bv, &sv), subst_stmts(body, &iv, &bv, &sv), own, subst_stmts(else_b, &iv, &bv, &sv)))
            case SMatch(scrut, arms):
                Vector[MatchArm] na = Vector[MatchArm]()
                int ai = 0
                while ai < arms.len():
                    MatchArm a = arms.get(ai).unwrap()
                    na.push(MatchArm(a.pattern, a.guard, subst_stmts(a.body, &iv, &bv, &sv)))
                    ai = ai + 1
                out.push(SMatch(subst_expr(scrut, &iv, &bv, &sv), na))
            else:
                out.push(s)
        i = i + 1
    return out

void substitute_meta_consts(Module &m, Dict[String, int] &iv, Dict[String, bool] &bv, Dict[String, String] &sv):
    int i = 0
    while i < m.items.len():
        match m.items.get(i).unwrap():
            case IFunction(fdef):
                Vector[Stmt] nb = subst_stmts(fdef.body, &iv, &bv, &sv)
                m.items.set(i, IFunction(FunctionDef(fdef.name, fdef.params, fdef.return_type, fdef.type_params, nb, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub)))
            case IEquip(eqblk):
                Vector[FunctionDef] nm = Vector[FunctionDef]()
                int mi = 0
                while mi < eqblk.methods.len():
                    FunctionDef meth = eqblk.methods.get(mi).unwrap()
                    nm.push(FunctionDef(meth.name, meth.params, meth.return_type, meth.type_params, subst_stmts(meth.body, &iv, &bv, &sv), meth.is_expr_body, meth.throws_type, meth.is_extern_stub))
                    mi = mi + 1
                m.items.set(i, IEquip(EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, nm, eqblk.via_field, eqblk.trait_generic_args)))
            else:
                pass
        i = i + 1

# ── Aliased-import rename (Rust's rewrite_import_aliases Pass-1.5) ──
#
# `from std.math import sin as msin, cos as mcos` makes `msin`/`mcos` the
# LOCALLY-visible names, but the IR backend lowers calls by SURFACE name —
# `map_runtime_name` maps `sin`→`gorget_sin`, and `msin` would map to itself
# (undefined reference). Mirrors Rust gg's `rewrite_import_aliases`
# (src/semantic/rewrite.rs:42-124, wired at src/semantic/mod.rs:248 after
# resolve, before lowering): a pure-AST walk that renames every `alias`
# identifier back to its `original` so the call site spells `sin` before
# `map_runtime_name` runs. The alias→original map is recorded on
# `ImportStmt.aliases` (parallel to `names`) by the parser's `as`-consumption.
#
# Identifier-axis only (the alias is always an imported VALUE/fn name here):
# we rename `EIdentifier` and the `ECall` callee. This is the same coverage
# `subst_expr` provides for meta-const substitution; the structural recursion
# (the `Box(rename...)` rebuild) is the ownership-decided reconstruction
# idiom used throughout this file.
Dict[String, String] collect_import_aliases(Module m):
    Dict[String, String] amap = {}
    for item in m.items:
        match item:
            case IImport(imp):
                int ni = 0
                while ni < imp.names.len():
                    if ni < imp.aliases.len():
                        String alias = imp.aliases.get(ni).unwrap()
                        if alias != "":
                            # alias → original surface name (the C symbol driver).
                            amap.put(alias, imp.names.get(ni).unwrap())
                    ni += 1
            else:
                pass
    return amap

# ── Type-axis rename (Rust's `rename_type`, rewrite.rs:458-487) ──
#
# An imported TYPE can be aliased too — `from geom import Point as P`
# then `P f(P a)`. The IR backend looks the type up by SURFACE name, so
# the local alias `P` must be renamed back to `Point` in every type
# position. This mirrors Rust's `rename_type` for the HEAD-name axis:
# it renames the head name of a `TNamed` (the position an imported type
# alias actually occupies — a param/return/field/const type that IS the
# aliased type). `TPrimitive`/`TSelf`/`TInferred` are leaves and never
# carry an aliasable name.
#
# ⚠ NESTED-TYPE RECURSION IS DEFERRED (live Rust-`gg` compiler bug; the
# exposing artifact is the #[ignore]d `import_type_alias_nested` fixture).
# Rust's `rename_type` ALSO recurses into container element types
# (`Vector[P]` generic args, `[P; N]` / `[P]` element, `(P, int)` tuple
# members, `P(int)` function params/ret).
# Porting that recursion here trips a Rust-`gg` BIR-lowering bug: in a
# large multi-module build (the self-host lowerer), a self-recursive fn
# that pattern-matches on the `Type` enum AND reconstructs a `Type` value
# containing the recursive result mis-resolves the reconstructed enum's
# `EnumInit` struct-id to a builtin (`CRuntimeType`), tripping the LIR
# validator (`field index N out of range for CRuntimeType`). The same
# function compiles standalone; the collision is struct-registry-pressure
# dependent. The head-name rename below is correct and complete for the
# common import-type-alias case; the nested case stays a sharp TODO + an
# #[ignore]d fixture rather than a redesign-around (per "Don't redesign
# around compiler gaps"). When the BIR struct-id bug is fixed, restore the
# `TArray`/`TSlice`/`TTuple`/`TNamed`-args/`TFunction` recursion arms.
SpannedType rename_aliases_type(SpannedType st, Dict[String, String] &amap):
    match st.ty:
        case TNamed(name, args):
            String nn = name
            if amap.contains(name):
                nn = amap[name]
            # Recurse into each generic arg (mirrors Rust rewrite.rs:464):
            # this reconstructs only a `Vector[SpannedType]`, NOT a
            # `Box`-wrapped inner `Type`, so it does NOT trip the BIR
            # struct-id collision. The `TArray`/`TSlice`/`TFunction` arms
            # (which DO reconstruct a `Box[SpannedType]`) stay deferred.
            Vector[SpannedType] nargs = Vector[SpannedType]()
            int ai = 0
            while ai < args.len():
                nargs.push(rename_aliases_type(args.get(ai).unwrap(), &amap))
                ai = ai + 1
            return SpannedType(TNamed(nn, nargs), st.span)
        else:
            return st

# Rename the aliased TYPE in a parameter (param_type) plus any aliased
# VALUE in its default-value expression. Mirrors Rust's per-param body
# of `rename_function` (rewrite.rs:128-133).
Param rename_aliases_param(Param p, Dict[String, String] &amap):
    SpannedType nt = rename_aliases_type(p.param_type, &amap)
    Option[SpannedExpr] nd = None
    match p.default_value:
        case Some(d):
            nd = Some(rename_aliases_expr(d, &amap))
        case None:
            nd = None
    return Param(nt, p.param_name, p.ownership, nd)

Vector[Param] rename_aliases_params(Vector[Param] params, Dict[String, String] &amap):
    Vector[Param] out = Vector[Param]()
    int i = 0
    while i < params.len():
        out.push(rename_aliases_param(params.get(i).unwrap(), &amap))
        i = i + 1
    return out

# Rename aliased names through a whole FunctionDef: param types + default
# exprs, return type, throws type, and the body. Mirrors Rust's
# `rename_function` (rewrite.rs:126-142).
FunctionDef rename_aliases_fn(FunctionDef f, Dict[String, String] &amap):
    Vector[Param] np = rename_aliases_params(f.params, &amap)
    SpannedType nr = rename_aliases_type(f.return_type, &amap)
    Option[SpannedType] nt = None
    match f.throws_type:
        case Some(t):
            nt = Some(rename_aliases_type(t, &amap))
        case None:
            nt = None
    Vector[Stmt] nb = rename_aliases_stmts(f.body, &amap)
    return FunctionDef(f.name, np, nr, f.type_params, nb, f.is_expr_body, nt, f.is_extern_stub)

SpannedExpr rename_aliases_expr(SpannedExpr se, Dict[String, String] &amap):
    match se.expr:
        case EIdentifier(name):
            if amap.contains(name):
                return SpannedExpr(EIdentifier(amap[name]), se.span)
            return se
        case EBinaryOp(l, op, r):
            return SpannedExpr(EBinaryOp(Box(rename_aliases_expr(*l, &amap)), op, Box(rename_aliases_expr(*r, &amap))), se.span)
        case EUnaryOp(op, operand):
            return SpannedExpr(EUnaryOp(op, Box(rename_aliases_expr(*operand, &amap))), se.span)
        case ECall(callee, args, arg_names, targs):
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            int i = 0
            while i < args.len():
                na.push(rename_aliases_expr(args.get(i).unwrap(), &amap))
                i = i + 1
            Vector[SpannedType] nt = Vector[SpannedType]()
            int ti = 0
            while ti < targs.len():
                nt.push(rename_aliases_type(targs.get(ti).unwrap(), &amap))
                ti = ti + 1
            return SpannedExpr(ECall(Box(rename_aliases_expr(*callee, &amap)), na, arg_names, nt), se.span)
        case EMethodCall(recv, mname, args, arg_names, targs):
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            int i = 0
            while i < args.len():
                na.push(rename_aliases_expr(args.get(i).unwrap(), &amap))
                i = i + 1
            Vector[SpannedType] nt = Vector[SpannedType]()
            int ti = 0
            while ti < targs.len():
                nt.push(rename_aliases_type(targs.get(ti).unwrap(), &amap))
                ti = ti + 1
            return SpannedExpr(EMethodCall(Box(rename_aliases_expr(*recv, &amap)), mname, na, arg_names, nt), se.span)
        case EStructLiteral(name, gargs, args):
            String nn = name
            if amap.contains(name):
                nn = amap[name]
            # Generic args are carried as bare type-name strings here (not
            # SpannedType); rename each that names an aliased type.
            Vector[String] ng = Vector[String]()
            int gi = 0
            while gi < gargs.len():
                String g = gargs.get(gi).unwrap()
                if amap.contains(g):
                    ng.push(amap[g])
                else:
                    ng.push(g)
                gi = gi + 1
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            int i = 0
            while i < args.len():
                na.push(rename_aliases_expr(args.get(i).unwrap(), &amap))
                i = i + 1
            return SpannedExpr(EStructLiteral(nn, ng, na), se.span)
        case EAs(inner, ty):
            return SpannedExpr(EAs(Box(rename_aliases_expr(*inner, &amap)), Box(rename_aliases_type(*ty, &amap))), se.span)
        case EFieldAccess(base, fname):
            return SpannedExpr(EFieldAccess(Box(rename_aliases_expr(*base, &amap)), fname), se.span)
        case EIndex(base, idx):
            return SpannedExpr(EIndex(Box(rename_aliases_expr(*base, &amap)), Box(rename_aliases_expr(*idx, &amap))), se.span)
        case EFString(raw, parts):
            Vector[SpannedExpr] np = Vector[SpannedExpr]()
            int i = 0
            while i < parts.len():
                np.push(rename_aliases_expr(parts.get(i).unwrap(), &amap))
                i = i + 1
            return SpannedExpr(EFString(raw, np), se.span)
        case EArrayLiteral(elems):
            Vector[SpannedExpr] ne = Vector[SpannedExpr]()
            int i = 0
            while i < elems.len():
                ne.push(rename_aliases_expr(elems.get(i).unwrap(), &amap))
                i = i + 1
            return SpannedExpr(EArrayLiteral(ne), se.span)
        else:
            return se

Vector[Stmt] rename_aliases_stmts(Vector[Stmt] stmts, Dict[String, String] &amap):
    Vector[Stmt] out = Vector[Stmt]()
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        match s:
            case SExpr(e):
                out.push(SExpr(rename_aliases_expr(e, &amap)))
            case SReturn(oe):
                match oe:
                    case Some(e):
                        out.push(SReturn(Some(rename_aliases_expr(e, &amap))))
                    case None:
                        out.push(s)
            case SVarDecl(ty, name, val, a, b, c):
                # Rename the declared type too — `P x = ...` where `P` is an
                # aliased type (Rust rename_stmt VarDecl, rewrite.rs:153-156).
                out.push(SVarDecl(rename_aliases_type(ty, &amap), name, rename_aliases_expr(val, &amap), a, b, c))
            case SAssign(lhs, rhs):
                out.push(SAssign(rename_aliases_expr(lhs, &amap), rename_aliases_expr(rhs, &amap)))
            case SCompoundAssign(lhs, op, rhs):
                out.push(SCompoundAssign(rename_aliases_expr(lhs, &amap), op, rename_aliases_expr(rhs, &amap)))
            case SThrow(e):
                out.push(SThrow(rename_aliases_expr(e, &amap)))
            case SBreak(oe):
                match oe:
                    case Some(e):
                        out.push(SBreak(Some(rename_aliases_expr(e, &amap))))
                    case None:
                        out.push(s)
            case SLoop(body):
                out.push(SLoop(rename_aliases_stmts(body, &amap)))
            case SWith(e, name, body):
                out.push(SWith(rename_aliases_expr(e, &amap), name, rename_aliases_stmts(body, &amap)))
            case SAssert(cond, msg):
                out.push(SAssert(rename_aliases_expr(cond, &amap), msg))
            case SAssertReturn(cond, msg):
                out.push(SAssertReturn(rename_aliases_expr(cond, &amap), msg))
            case SNamedScope(name, body):
                out.push(SNamedScope(name, rename_aliases_stmts(body, &amap)))
            case SOnError(body):
                out.push(SOnError(rename_aliases_stmts(body, &amap)))
            case SSnapshot(name, n, e):
                out.push(SSnapshot(name, n, rename_aliases_expr(e, &amap)))
            case SIf(cond, then_b, else_branches):
                Vector[ElseBranch] nb = Vector[ElseBranch]()
                int ei = 0
                while ei < else_branches.len():
                    ElseBranch eb = else_branches.get(ei).unwrap()
                    Option[SpannedExpr] nc = None
                    match eb.condition:
                        case Some(c):
                            nc = Some(rename_aliases_expr(c, &amap))
                        case None:
                            nc = None
                    nb.push(ElseBranch(nc, rename_aliases_stmts(eb.body, &amap)))
                    ei = ei + 1
                out.push(SIf(rename_aliases_expr(cond, &amap), rename_aliases_stmts(then_b, &amap), nb))
            case SWhile(cond, body):
                out.push(SWhile(rename_aliases_expr(cond, &amap), rename_aliases_stmts(body, &amap)))
            case SFor(pat, iter_e, body, own, else_b):
                out.push(SFor(pat, rename_aliases_expr(iter_e, &amap), rename_aliases_stmts(body, &amap), own, rename_aliases_stmts(else_b, &amap)))
            case SMatch(scrut, arms):
                Vector[MatchArm] na = Vector[MatchArm]()
                int ai = 0
                while ai < arms.len():
                    MatchArm a = arms.get(ai).unwrap()
                    Option[SpannedExpr] ng = None
                    match a.guard:
                        case Some(g):
                            ng = Some(rename_aliases_expr(g, &amap))
                        case None:
                            ng = None
                    na.push(MatchArm(a.pattern, ng, rename_aliases_stmts(a.body, &amap)))
                    ai = ai + 1
                out.push(SMatch(rename_aliases_expr(scrut, &amap), na))
            else:
                out.push(s)
        i = i + 1
    return out

# Rename every FunctionDef in a method list (equip/trait bodies +
# extern-block sigs). Shared by the item dispatch below.
Vector[FunctionDef] rename_aliases_fns(Vector[FunctionDef] fns, Dict[String, String] &amap):
    Vector[FunctionDef] out = Vector[FunctionDef]()
    int i = 0
    while i < fns.len():
        out.push(rename_aliases_fn(fns.get(i).unwrap(), &amap))
        i = i + 1
    return out

# Mirror of Rust's `rename_item` (rewrite.rs:58-124) — walks EVERY item
# kind and renames aliased names in both the VALUE axis (expr/stmt bodies)
# and the TYPE axis (function signatures, struct field types, enum payload
# types, const/static/typealias/newtype types, equip target type, trait/
# equip/extern method sigs). Item kinds with no aliasable surface (imports,
# directives, meta-*) are left untouched.
void rename_import_aliases(Module &m):
    Dict[String, String] amap = collect_import_aliases(m)
    if amap.len() == 0:
        return
    int i = 0
    while i < m.items.len():
        match m.items.get(i).unwrap():
            case IFunction(fdef):
                m.items.set(i, IFunction(rename_aliases_fn(fdef, &amap)))
            case IEquip(eqblk):
                # Rename the equip TARGET type + the trait NAME (if any) +
                # every method signature/body. Mirrors Rust rewrite.rs:62-68.
                SpannedType ntarget = rename_aliases_type(eqblk.target, &amap)
                Option[String] ntrait = eqblk.trait_name
                match eqblk.trait_name:
                    case Some(tn):
                        if amap.contains(tn):
                            ntrait = Some(amap[tn])
                    case None:
                        pass
                Vector[FunctionDef] nm = rename_aliases_fns(eqblk.methods, &amap)
                m.items.set(i, IEquip(EquipBlock(ntarget, eqblk.type_params, ntrait, nm, eqblk.via_field, eqblk.trait_generic_args)))
            case ITrait(tdef):
                Vector[FunctionDef] tnm = rename_aliases_fns(tdef.methods, &amap)
                m.items.set(i, ITrait(TraitDef(tdef.name, tdef.type_params, tnm, tdef.parent_traits)))
            case IStruct(sdef):
                # Field types are Param.param_type — rename the type axis.
                Vector[Param] nf = rename_aliases_params(sdef.fields, &amap)
                m.items.set(i, IStruct(StructDef(sdef.name, nf, sdef.type_params, sdef.derives)))
            case IEnum(edef):
                # Each variant's tuple payload is a Vector[SpannedType].
                Vector[EnumVariant] nv = Vector[EnumVariant]()
                int vi = 0
                while vi < edef.variants.len():
                    EnumVariant v = edef.variants.get(vi).unwrap()
                    Vector[SpannedType] nft = Vector[SpannedType]()
                    int fi = 0
                    while fi < v.fields.len():
                        nft.push(rename_aliases_type(v.fields.get(fi).unwrap(), &amap))
                        fi = fi + 1
                    nv.push(EnumVariant(v.name, nft))
                    vi = vi + 1
                m.items.set(i, IEnum(EnumDef(edef.name, nv, edef.type_params, edef.derives)))
            case IConstDecl(ty, name, val):
                m.items.set(i, IConstDecl(rename_aliases_type(ty, &amap), name, rename_aliases_expr(val, &amap)))
            case IStaticDecl(ty, name, val):
                m.items.set(i, IStaticDecl(rename_aliases_type(ty, &amap), name, rename_aliases_expr(val, &amap)))
            case ITypeAlias(name, tps, ty):
                m.items.set(i, ITypeAlias(name, tps, rename_aliases_type(ty, &amap)))
            case INewtype(name, ty):
                m.items.set(i, INewtype(name, rename_aliases_type(ty, &amap)))
            case IExternBlock(fns):
                m.items.set(i, IExternBlock(rename_aliases_fns(fns, &amap)))
            case ITest(name, tagexprs, tagnames, body):
                m.items.set(i, ITest(name, tagexprs, tagnames, rename_aliases_stmts(body, &amap)))
            case IBench(name, body):
                m.items.set(i, IBench(name, rename_aliases_stmts(body, &amap)))
            case ISuiteSetup(body):
                m.items.set(i, ISuiteSetup(rename_aliases_stmts(body, &amap)))
            case ISuiteTeardown(body):
                m.items.set(i, ISuiteTeardown(rename_aliases_stmts(body, &amap)))
            else:
                pass
        i = i + 1

# ── Phase 1.5: flatten top-level `meta if` ────────────────────
# Mirror of Rust src/semantic/meta.rs `flatten_meta_ifs` (:865) +
# `pick_meta_if_branch` (:906). Evaluate each top-level IMetaIf's
# condition against the collected consts, splice the winning branch's
# items into m.items, and collect any meta consts the branch declares so
# subsequent references resolve. Loops until no IMetaIf remains (handles
# nested meta-if introduced by a winning branch).

# Collect a single IMetaConst declaration into the const dicts. Used when
# a winning meta-if branch introduces new consts (the spliced items must
# be visible to substitution, exactly like top-level meta consts).
void collect_meta_const(Item mitem, Dict[String, int] &iv, Dict[String, bool] &bv, Dict[String, String] &sv, Module &m):
    match mitem:
        case IMetaConst(mc_type, mc_name, mc_expr):
            String type_name = meta_type_to_name(mc_type.ty)
            if type_name == "int":
                bool ok = true
                int v = eval_int_ex(mc_expr.expr, &iv, &m, 0, &ok)
                if ok:
                    iv[mc_name] = v
            elif type_name == "bool":
                bool ok = true
                bv[mc_name] = eval_meta_bool(mc_expr.expr, &iv, &bv, &m, &ok)
            elif type_name == "str" or type_name == "String":
                match mc_expr.expr:
                    case EStringLiteral(s, _):
                        sv[mc_name] = s
                    else:
                        pass
        else:
            pass

# Return the winning branch's items for a meta-if, evaluating the main
# condition then each elif, else the trailing else (empty if none).
Vector[Item] pick_meta_if_branch(SpannedExpr cond, Vector[Item] then_items, Vector[ItemElseBranch] branches, Dict[String, int] &iv, Dict[String, bool] &bv, Module &m):
    bool ok = true
    bool taken = eval_meta_bool(cond.expr, &iv, &bv, &m, &ok)
    if ok and taken:
        return then_items
    int bi = 0
    while bi < branches.len():
        ItemElseBranch br = branches.get(bi).unwrap()
        match br.condition:
            case Some(ec):
                bool eok = true
                bool etaken = eval_meta_bool(ec.expr, &iv, &bv, &m, &eok)
                if eok and etaken:
                    return br.items
            case None:
                # Trailing else — wins iff no earlier branch did.
                return br.items
        bi = bi + 1
    return Vector[Item]()

void flatten_meta_ifs(Module &m, Dict[String, int] &iv, Dict[String, bool] &bv, Dict[String, String] &sv):
    bool changed = true
    while changed:
        changed = false
        Vector[Item] new_items = Vector[Item]()
        int i = 0
        while i < m.items.len():
            Item mitem = m.items.get(i).unwrap()
            match mitem:
                case IMetaIf(cond, then_items, branches):
                    changed = true
                    Vector[Item] winning = pick_meta_if_branch(cond, then_items, branches, &iv, &bv, &m)
                    int wj = 0
                    while wj < winning.len():
                        Item won = winning.get(wj).unwrap()
                        collect_meta_const(won, &iv, &bv, &sv, &m)
                        new_items.push(won)
                        wj = wj + 1
                else:
                    new_items.push(mitem)
            i = i + 1
        m.items = new_items

# ── Main expansion entry point ────────────────────────────────

void expand_meta_types(Module &m, TypeTable &types, String source_dir):
    # Pass 1: collect meta const values
    Dict[String, int] int_consts = Dict[String, int]()
    Dict[String, bool] bool_consts = Dict[String, bool]()
    Dict[String, String] str_consts = Dict[String, String]()

    for item in m.items:
        match item:
            case IMetaConst(mc_type, mc_name, mc_expr):
                String type_name = meta_type_to_name(mc_type.ty)
                if type_name == "int":
                    bool ok = true
                    int v = eval_int_ex(mc_expr.expr, &int_consts, &m, 0, &ok)
                    if ok:
                        int_consts[mc_name] = v
                elif type_name == "bool":
                    bool ok = true
                    bool_consts[mc_name] = eval_meta_bool(mc_expr.expr, &int_consts, &bool_consts, &m, &ok)
                elif type_name == "str" or type_name == "String":
                    match mc_expr.expr:
                        case EStringLiteral(s, _):
                            str_consts[mc_name] = s
                        case ECall(callee, cargs, _, _):
                            match (*callee).expr:
                                case EIdentifier(fn_name):
                                    if fn_name == "typename" and cargs.len() == 1:
                                        str_consts[mc_name] = meta_typename(arg_as_type(cargs.get(0).unwrap()))
                                    elif fn_name == "embed_file" and cargs.len() == 1:
                                        # Gorget's include_str!: read a file
                                        # relative to the entry source dir at
                                        # compile time, returning its contents
                                        # as a String constant. Mirror Rust
                                        # src/semantic/meta.rs:1086-1106. The
                                        # contents land in str_consts, so the
                                        # subst pass inlines it as a string
                                        # literal exactly like a `meta String`.
                                        match cargs.get(0).unwrap().expr:
                                            case EStringLiteral(rel_path, _):
                                                str_consts[mc_name] = read_file(source_dir + "/" + rel_path)
                                            else:
                                                pass
                                else:
                                    pass
                        else:
                            pass
            else:
                pass

    # Add platform builtins
    int_consts["arch_word_bits"] = 64

    # Phase 1.5: Flatten top-level `meta if` (conditional compilation).
    # Evaluate each IMetaIf condition against the collected consts, splice
    # the winning branch's items into m.items, and collect any meta consts
    # the winning branch declares (so references resolve in substitution).
    # Loops until no IMetaIf remains (handles nested meta-if). Mirrors Rust
    # src/semantic/meta.rs `flatten_meta_ifs` (:865).
    flatten_meta_ifs(&m, &int_consts, &bool_consts, &str_consts)

    # [PROTOTYPE] Phase 2: substitute collected const values into all bodies.
    substitute_meta_consts(&m, &int_consts, &bool_consts, &str_consts)

    # Pass 2: resolve meta type aliases
    for item in m.items:
        match item:
            case IMetaType(mt_name, mt_rhs):
                match mt_rhs:
                    case MtrPlain(rhs_type):
                        String target = meta_type_to_name(rhs_type.ty)
                        if target != "":
                            types.meta_aliases[mt_name] = target
                    case MtrConditional(then_type, cond_name, else_type):
                        bool cond_val = false
                        if bool_consts.contains(cond_name):
                            cond_val = bool_consts[cond_name]
                        if cond_val:
                            String target = meta_type_to_name(then_type.ty)
                            if target != "":
                                types.meta_aliases[mt_name] = target
                        else:
                            String target = meta_type_to_name(else_type.ty)
                            if target != "":
                                types.meta_aliases[mt_name] = target
                    case MtrCall(callee, call_args):
                        # Evaluate the call args, handling arch_word_bits() etc.
                        Vector[SpannedExpr] resolved_args = Vector[SpannedExpr]()
                        int j = 0
                        while j < call_args.len():
                            SpannedExpr arg = call_args.get(j).unwrap()
                            # If arg is a call to a builtin like arch_word_bits()
                            match arg.expr:
                                case ECall(callee_expr, inner_args, _, _):
                                    match (*callee_expr).expr:
                                        case EIdentifier(fn_name):
                                            if fn_name == "arch_word_bits" and inner_args.len() == 0:
                                                resolved_args.push(SpannedExpr(EIntLiteral(64), arg.span))
                                            else:
                                                resolved_args.push(arg)
                                        else:
                                            resolved_args.push(arg)
                                else:
                                    resolved_args.push(arg)
                            j = j + 1
                        String result = eval_type_func_call(callee, &resolved_args, &int_consts)
                        if result != "":
                            types.meta_aliases[mt_name] = result
                    case MtrUnresolved():
                        pass
            else:
                pass

# ── Meta-for-in-match expansion ─────────────────────────────
#
# For each `match X: meta for vname, T in variant_payloads(EnumName):
# case vname(c): ...`, look up EnumName's variants and replace the
# meta-for arm with concrete `case Variant1(c): ...`, `case Variant2(c):
# ...` arms — one per variant. The first loop variable (`vname`) binds
# the variant name and is substituted into PConstructor heads in the
# arm template's pattern. Additional loop variables (`T`, etc.) bind
# variant payload TYPES and would substitute into types in the body —
# the typechecker can usually infer payload types from the concrete
# pattern match so we skip type substitution for now (simplest correct).

# Find all variants of an enum by name. Returns empty if not found.
Vector[EnumVariant] find_enum_variants(Module m, String enum_name):
    Vector[EnumVariant] result = Vector[EnumVariant]()
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IEnum(edef):
                if edef.name == enum_name:
                    int vi = 0
                    while vi < edef.variants.len():
                        result.push(edef.variants.get(vi).unwrap())
                        vi = vi + 1
                    return result
            else:
                pass
        i = i + 1
    return result

# Substitute a single PConstructor head name in a pattern.
# Only the OUTERMOST PConstructor head is rewritten — that's the
# `vname(...)` slot in `case vname(c):`. Inner sub-patterns are
# unchanged (the bound variables like `c` keep their names).
SpannedPattern substitute_pattern_head(SpannedPattern sp, String var_name, String concrete_name):
    match sp.pat:
        case PConstructor(name, args):
            if name == var_name:
                return SpannedPattern(PConstructor(concrete_name, args), sp.span)
        else:
            pass
    return sp

# Clone a MatchArm template with the loop variable substituted in
# the pattern head. Body and guard are unchanged — the typechecker
# resolves bindings via pattern-driven inference.
MatchArm substitute_arm(MatchArm template, String var_name, String concrete_name):
    SpannedPattern new_pat = substitute_pattern_head(template.pattern, var_name, concrete_name)
    return MatchArm(new_pat, template.guard, template.body)

# Try to extract the enum name from a `variant_payloads(EnumName)`
# range expression. Returns "" if the expression doesn't match the
# expected shape.
String extract_variant_payloads_target(SpannedExpr range):
    match range.expr:
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(callee_name):
                    if callee_name == "variant_payloads" and args.len() == 1:
                        SpannedExpr arg0 = args.get(0).unwrap()
                        match arg0.expr:
                            case EIdentifier(en):
                                return en
                            else:
                                return ""
                    return ""
                else:
                    return ""
        else:
            return ""

# Expand any meta-for-in-match arms to concrete arms. Walks `arms`
# once; arms without an SMetaForMatch body pass through unchanged.
Vector[MatchArm] expand_meta_for_arms(Vector[MatchArm] arms, Module m):
    Vector[MatchArm] result = Vector[MatchArm]()
    int i = 0
    while i < arms.len():
        MatchArm arm = arms.get(i).unwrap()
        bool handled = false
        if arm.body.len() == 1:
            Stmt b0 = arm.body.get(0).unwrap()
            match b0:
                case SMetaForMatch(vars, range, templates):
                    handled = true
                    String enum_name = extract_variant_payloads_target(range)
                    if enum_name != "" and vars.len() > 0:
                        Vector[EnumVariant] variants = find_enum_variants(m, enum_name)
                        String var0 = vars.get(0).unwrap()
                        int vi = 0
                        while vi < variants.len():
                            EnumVariant v = variants.get(vi).unwrap()
                            int ti = 0
                            while ti < templates.len():
                                MatchArm template = templates.get(ti).unwrap()
                                result.push(substitute_arm(template, var0, v.name))
                                ti = ti + 1
                            vi = vi + 1
                else:
                    pass
        if not handled:
            result.push(arm)
        i = i + 1
    return result

# Walk a vector of statements, expanding any SMatch.arms that
# contain SMetaForMatch wrappers. Recurses into nested control
# flow (if / while / for / match arms / etc.) so meta-for inside
# nested constructs is also handled.
Vector[Stmt] expand_meta_for_in_stmts(Vector[Stmt] stmts, Module m):
    Vector[Stmt] result = Vector[Stmt]()
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        match s:
            case SMatch(scrutinee, arms):
                Vector[MatchArm] expanded_arms = expand_meta_for_arms(arms, m)
                # Recurse into arm bodies in case they contain nested matches
                Vector[MatchArm] final_arms = Vector[MatchArm]()
                int ai = 0
                while ai < expanded_arms.len():
                    MatchArm a = expanded_arms.get(ai).unwrap()
                    Vector[Stmt] new_body = expand_meta_for_in_stmts(a.body, m)
                    final_arms.push(MatchArm(a.pattern, a.guard, new_body))
                    ai = ai + 1
                result.push(SMatch(scrutinee, final_arms))
            case SIf(cond, then_b, else_branches):
                Vector[Stmt] new_then = expand_meta_for_in_stmts(then_b, m)
                Vector[ElseBranch] new_branches = Vector[ElseBranch]()
                int ei = 0
                while ei < else_branches.len():
                    ElseBranch eb = else_branches.get(ei).unwrap()
                    Vector[Stmt] new_eb_body = expand_meta_for_in_stmts(eb.body, m)
                    new_branches.push(ElseBranch(eb.condition, new_eb_body))
                    ei = ei + 1
                result.push(SIf(cond, new_then, new_branches))
            case SWhile(cond, body):
                result.push(SWhile(cond, expand_meta_for_in_stmts(body, m)))
            case SFor(pat, iter_expr, body, own, else_b):
                result.push(SFor(pat, iter_expr, expand_meta_for_in_stmts(body, m), own, expand_meta_for_in_stmts(else_b, m)))
            else:
                result.push(s)
        i = i + 1
    return result

# Expand meta-for in every function body in the module.
void expand_meta_for_match(Module &m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IFunction(fdef):
                Vector[Stmt] new_body = expand_meta_for_in_stmts(fdef.body, m)
                FunctionDef new_fn = FunctionDef(fdef.name, fdef.params, fdef.return_type, fdef.type_params, new_body, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub)
                m.items.set(i, IFunction(new_fn))
            case IEquip(eqblk):
                Vector[FunctionDef] new_methods = Vector[FunctionDef]()
                int mi = 0
                while mi < eqblk.methods.len():
                    FunctionDef method = eqblk.methods.get(mi).unwrap()
                    Vector[Stmt] new_body = expand_meta_for_in_stmts(method.body, m)
                    FunctionDef new_method = FunctionDef(method.name, method.params, method.return_type, method.type_params, new_body, method.is_expr_body, method.throws_type, method.is_extern_stub)
                    new_methods.push(new_method)
                    mi = mi + 1
                EquipBlock new_eq = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, new_methods, eqblk.via_field, eqblk.trait_generic_args)
                m.items.set(i, IEquip(new_eq))
            else:
                pass
        i = i + 1
