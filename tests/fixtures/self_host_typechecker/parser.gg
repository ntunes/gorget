# ── Token tag extraction ────────────────────────────────────

int token_tag(Token tok):
    match tok:
        case TkKeyword(_):
            return TOK_KEYWORD
        case TkIdentifier(_):
            return TOK_IDENT
        case TkInt(_):
            return TOK_INT
        case TkFloat(_):
            return TOK_FLOAT
        case TkString(_):
            return TOK_STRING
        # TkChar removed — single-quoted literals are now TkString
        case TkBool(_):
            return TOK_BOOL
        case TkPlus:
            return TOK_PLUS
        case TkMinus:
            return TOK_MINUS
        case TkStar:
            return TOK_STAR
        case TkSlash:
            return TOK_SLASH
        case TkPercent:
            return TOK_PERCENT
        case TkEq:
            return TOK_EQ
        case TkLt:
            return TOK_LT
        case TkGt:
            return TOK_GT
        case TkBang:
            return TOK_BANG
        case TkAmpersand:
            return TOK_AMP
        case TkPipe:
            return TOK_PIPE
        case TkCaret:
            return TOK_CARET
        case TkTilde:
            return TOK_TILDE
        case TkDot:
            return TOK_DOT
        case TkQuestion:
            return TOK_QUESTION
        case TkAt:
            return TOK_AT
        case TkUnderscore:
            return TOK_UNDERSCORE
        case TkEqEq:
            return TOK_EQEQ
        case TkBangEq:
            return TOK_BANGEQ
        case TkLtEq:
            return TOK_LTEQ
        case TkGtEq:
            return TOK_GTEQ
        case TkLtLt:
            return TOK_LTLT
        case TkGtGt:
            return TOK_GTGT
        case TkPlusEq:
            return TOK_PLUSEQ
        case TkArrow:
            return TOK_ARROW
        case TkMinusEq:
            return TOK_MINUSEQ
        case TkStarEq:
            return TOK_STAREQ
        case TkSlashEq:
            return TOK_SLASHEQ
        case TkPercentEq:
            return TOK_PERCENTEQ
        case TkDotDot:
            return TOK_DOTDOT
        case TkDotDotEq:
            return TOK_DOTDOTEQ
        case TkQuestionDot:
            return TOK_QUESTIONDOT
        case TkDoubleQuestion:
            return TOK_DOUBLEQUESTION
        case TkLParen:
            return TOK_LPAREN
        case TkRParen:
            return TOK_RPAREN
        case TkLBracket:
            return TOK_LBRACKET
        case TkRBracket:
            return TOK_RBRACKET
        case TkLBrace:
            return TOK_LBRACE
        case TkRBrace:
            return TOK_RBRACE
        case TkColon:
            return TOK_COLON
        case TkComma:
            return TOK_COMMA
        case TkIndent:
            return TOK_INDENT
        case TkDedent:
            return TOK_DEDENT
        case TkNewline:
            return TOK_NEWLINE
        case TkEof:
            return TOK_EOF
        case TkComment(_):
            return TOK_COMMENT
        case TkDocComment(_):
            return TOK_DOCCOMMENT
        case TkError(_):
            return TOK_ERROR
        case TkAmpEq:
            return TOK_AMPEQ
        case TkPipeEq:
            return TOK_PIPEEQ
        case TkCaretEq:
            return TOK_CARETEQ
        case TkLtLtEq:
            return TOK_LTLTEQ
        case TkGtGtEq:
            return TOK_GTGTEQ
        case TkPlusPercent:
            return TOK_PLUSPERCENT
        case TkMinusPercent:
            return TOK_MINUSPERCENT
        case TkStarPercent:
            return TOK_STARPERCENT
        case TkPlusPercentEq:
            return TOK_PLUSPERCENTEQ
        case TkMinusPercentEq:
            return TOK_MINUSPERCENTEQ
        case TkStarPercentEq:
            return TOK_STARPERCENTEQ
        case TkStarStar:
            return TOK_STARSTAR
        case TkStarStarEq:
            return TOK_STARSTAREQ
        # D26 fallible arithmetic operator tokens (5 arith + 2 shift) +
        # compound-fallible-assign reject tokens (7).
        case TkPlusBang:
            return TOK_PLUSBANG
        case TkMinusBang:
            return TOK_MINUSBANG
        case TkStarBang:
            return TOK_STARBANG
        case TkSlashBang:
            return TOK_SLASHBANG
        case TkPercentBang:
            return TOK_PERCENTBANG
        case TkLtLtBang:
            return TOK_LTLTBANG
        case TkGtGtBang:
            return TOK_GTGTBANG
        case TkPlusBangEq:
            return TOK_PLUSBANGEQ
        case TkMinusBangEq:
            return TOK_MINUSBANGEQ
        case TkStarBangEq:
            return TOK_STARBANGEQ
        case TkSlashBangEq:
            return TOK_SLASHBANGEQ
        case TkPercentBangEq:
            return TOK_PERCENTBANGEQ
        case TkLtLtBangEq:
            return TOK_LTLTBANGEQ
        case TkGtGtBangEq:
            return TOK_GTGTBANGEQ
        else:
            return 0

