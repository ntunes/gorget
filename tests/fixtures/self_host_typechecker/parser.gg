                case KwInt32:
                    return KW_INT32
                case KwInt64:
                    return KW_INT64
                case KwUint:
                    return KW_UINT
                case KwUint8:
                    return KW_UINT8
                case KwUint16:
                    return KW_UINT16
                case KwUint32:
                    return KW_UINT32
                case KwUint64:
                    return KW_UINT64
                case KwFloat32:
                    return KW_FLOAT32
                case KwFloat64:
                    return KW_FLOAT64
                case KwPublic:
                    return KW_PUBLIC
                case KwStatic:
                    return KW_STATIC
                case KwType:
                    return KW_TYPE
                case KwNewtype:
                    return KW_NEWTYPE
                case KwDo:
                    return KW_DO
                case KwVia:
                    return KW_VIA
                case KwWhere:
                    return KW_WHERE
                case KwExtends:
                    return KW_EXTENDS
                case KwMove:
                    return KW_MOVE
                case KwMutable:
                    return KW_MUTABLE
                case KwAssert:
                    return KW_ASSERT
                case KwConst:
                    return KW_CONST
                case KwUnsafe:
                    return KW_UNSAFE
                case KwExtern:
                    return KW_EXTERN
                case KwAsync:
                    return KW_ASYNC
                case KwAwait:
                    return KW_AWAIT
                case KwSpawn:
                    return KW_SPAWN
                case KwTest:
                    return KW_TEST
                case KwSuite:
                    return KW_SUITE
                case KwBench:
                    return KW_BENCH
                case KwIt:
                    return KW_IT
                case KwPanic:
                    return KW_PANIC
                case KwShared:
                    return KW_SHARED
                case KwMeta:
                    return KW_META
                case KwSelect:
                    return KW_SELECT
                case KwRethrow:
                    return KW_RETHROW
                case KwMod:
                    return KW_MOD
