                case KwLoop:
                    return KW_LOOP
                case KwIn:
                    return KW_IN
                case KwMatch:
                    return KW_MATCH
                case KwCase:
                    return KW_CASE
                case KwBreak:
                    return KW_BREAK
                case KwContinue:
                    return KW_CONTINUE
                case KwReturn:
                    return KW_RETURN
                case KwPass:
                    return KW_PASS
                case KwAnd:
                    return KW_AND
                case KwOr:
                    return KW_OR
                case KwNot:
                    return KW_NOT
                case KwIs:
                    return KW_IS
                case KwTrue:
                    return KW_TRUE
                case KwFalse:
                    return KW_FALSE
                case KwNone:
                    return KW_NONE
                case KwSome:
                    return KW_SOME
                case KwOk:
                    return KW_OK
                case KwError:
                    return KW_ERROR
                case KwThrow:
                    return KW_THROW
                case KwThrows:
                    return KW_THROWS
                case KwImport:
                    return KW_IMPORT
                case KwFrom:
                    return KW_FROM
                case KwDirective:
                    return KW_DIRECTIVE
                case KwWith:
                    return KW_WITH
                case KwAs:
                    return KW_AS
                case KwSelfLower:
                    return KW_SELF_LOWER
                case KwSelfUpper:
                    return KW_SELF_UPPER
                case KwInt8:
                    return KW_INT8
                case KwInt16:
