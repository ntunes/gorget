# Derive expansion for the self-hosted type checker.
# Generates equip blocks from @derive(...) attributes on structs and enums.
# Mirrors the Rust compiler's derive.rs: generates source text, parses it,
# and appends equip/function items to the module.

from parser import parse_source
from ast import Module, Item, IEquip, IFunction, IStruct, IEnum, StructDef, EnumDef, Param, EnumVariant, SpannedType, Type, TPrimitive, TNamed, TArray, TSlice, TTuple, TFunction, TSelf, TInferred
from std.collections import Vector
from std.conv import int_to_str

# ── Type formatting ─────────────────────────────────────────

String format_ast_type(SpannedType st):
    return format_type_inner(st.ty)

String format_type_inner(Type ty):
    match ty:
        case TPrimitive(name):
            return name
        case TNamed(name, args):
            if args.len() == 0:
                return name
            String result = name
            result = result + "["
            for (i, arg) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_ast_type(arg)
            result = result + "]"
            return result
        case TSelf:
            return "Self"
        case TInferred:
            return "auto"
        else:
            return "auto"

# ── Helpers ─────────────────────────────────────────────────

String generic_suffix(Vector[String] tps):
    if tps.len() == 0:
        return ""
    String result = "["
    for (i, tp) in tps.enumerate():
        if i > 0:
            result = result + ", "
        result = result + tp
    result = result + "]"
    return result

String equip_prefix(Vector[String] tps):
    if tps.len() == 0:
        return ""
    return f"{generic_suffix(tps)} "

# Global counter for unique temp variable names
int derive_var_counter = 0

String next_var():
    int v = derive_var_counter
    derive_var_counter = derive_var_counter + 1
    return "__t" + int_to_str(v)

# ── Collection type detection ───────────────────────────────

# Collection type detection operates on the string type name.
# We avoid String colon-slice `[a:b]` due to C backend GorgetString issues.

String strip_generic_prefix(String ty, String prefix):
    # Check if ty starts with prefix + "[" and ends with "]"
    # Returns inner content or ""
    if not ty.starts_with(prefix):
        return ""
    int plen = prefix.len()
    if ty.len() < plen + 2:
        return ""
    String after = ty.char_at(plen)
    if after != "[":
        return ""
    String last = ty.char_at(ty.len() - 1)
    if last != "]":
        return ""
    # Extract between prefix[ and ]
    return ty.byte_slice(plen + 1, ty.len() - 1)

Option[int] find_top_comma(String s):
    int depth = 0
    int i = 0
    while i < s.len():
        String ch = s.char_at(i)
        if ch == "[":
            depth = depth + 1
        elif ch == "]":
            depth = depth - 1
        elif ch == "," and depth == 0:
            return Some(i)
        i = i + 1
    return None()

String trim_leading(String s):
    int start = 0
    while start < s.len() and s.char_at(start) == " ":
        start = start + 1
    return s.byte_slice(start, s.len())

# Returns "vector", "option", "dict", "hashmap", or ""
String collection_kind(String ty):
    if strip_generic_prefix(ty, "Vector") != "":
        return "vector"
    if strip_generic_prefix(ty, "Option") != "":
        return "option"
    if strip_generic_prefix(ty, "Dict") != "":
        return "dict"
    if strip_generic_prefix(ty, "HashMap") != "":
        return "hashmap"
    return ""

String collection_elem(String ty):
    String inner = strip_generic_prefix(ty, "Vector")
    if inner != "":
        return inner
    return strip_generic_prefix(ty, "Option")

String collection_key(String ty):
    String inner = strip_generic_prefix(ty, "Dict")
    if inner == "":
        inner = strip_generic_prefix(ty, "HashMap")
    if inner == "":
        return ""
    if find_top_comma(inner) is Some(comma):
        return trim_leading(inner.byte_slice(0, comma))
    return ""

String collection_val(String ty):
    String inner = strip_generic_prefix(ty, "Dict")
    if inner == "":
        inner = strip_generic_prefix(ty, "HashMap")
    if inner == "":
        return ""
    if find_top_comma(inner) is Some(comma):
        return trim_leading(inner.byte_slice(comma + 1, inner.len()))
    return ""

# ── Multi-line serialization codegen ────────────────────────

String field_write_lines(String expr, String type_name, String indent):
    String kind = collection_kind(type_name)
    if kind == "vector":
        String elem_ty = collection_elem(type_name)
        String idx = next_var()
        String val = next_var()
        String inner = indent + "    "
        String elem_lines = field_write_lines(val, elem_ty, inner)
        return indent + "ser.begin_seq(" + expr + ".len())\n" + indent + "int " + idx + " = 0\n" + indent + "while " + idx + " < " + expr + ".len():\n" + inner + "ser.elem(" + idx + ")\n" + inner + elem_ty + " " + val + " = " + expr + ".get(" + idx + ").unwrap()\n" + elem_lines + inner + idx + " = " + idx + " + 1\n" + indent + "ser.end_seq()\n"
    if kind == "option":
        String inner_ty = collection_elem(type_name)
        String val = next_var()
        String case_indent = indent + "    "
        String body_indent = indent + "        "
        String write_lines = field_write_lines(val, inner_ty, body_indent)
        return indent + "match " + expr + ":\n" + case_indent + "case Some(" + val + "):\n" + write_lines + case_indent + "case None:\n" + body_indent + "ser.write_null()\n"
    if kind == "dict" or kind == "hashmap":
        String key_ty = collection_key(type_name)
        String val_ty = collection_val(type_name)
        if key_ty == "str" or key_ty == "String":
            String keys_var = next_var()
            String idx = next_var()
            String key_var = next_var()
            String val_var = next_var()
            String inner = indent + "    "
            String val_lines = field_write_lines(val_var, val_ty, inner)
            return indent + "Vector[String] " + keys_var + " = " + expr + ".keys()\n" + indent + "ser.begin_struct(\"\", " + keys_var + ".len())\n" + indent + "int " + idx + " = 0\n" + indent + "while " + idx + " < " + keys_var + ".len():\n" + inner + "String " + key_var + " = " + keys_var + ".get(" + idx + ").unwrap()\n" + inner + "ser.field(" + key_var + ", " + idx + ")\n" + inner + val_ty + " " + val_var + " = " + expr + "[" + key_var + "]\n" + val_lines + inner + idx + " = " + idx + " + 1\n" + indent + "ser.end_struct()\n"
    return indent + field_write_call(expr, type_name) + "\n"

# ── Multi-line deserialization codegen ──────────────────────

String field_read_lines(String name, String type_name, String indent):
    String kind = collection_kind(type_name)
    if kind == "vector":
        String elem_ty = collection_elem(type_name)
        String len_var = next_var()
        String idx = next_var()
        String elem_var = next_var()
        String inner = indent + "    "
        String elem_lines = field_read_lines(elem_var, elem_ty, inner)
        return indent + "int " + len_var + " = de.begin_seq()\n" + indent + type_name + " " + name + " = " + type_name + "()\n" + indent + "int " + idx + " = 0\n" + indent + "while " + idx + " < " + len_var + ":\n" + inner + "de.elem(" + idx + ")\n" + elem_lines + inner + name + ".push(" + elem_var + ")\n" + inner + idx + " = " + idx + " + 1\n" + indent + "de.end_seq()\n"
    if kind == "option":
        String inner_ty = collection_elem(type_name)
        String val_var = next_var()
        String inner = indent + "    "
        String val_lines = field_read_lines(val_var, inner_ty, inner)
        return indent + type_name + " " + name + " = None()\n" + indent + "if not de.is_null():\n" + val_lines + inner + name + " = Some(" + val_var + ")\n"
    if kind == "dict" or kind == "hashmap":
        String key_ty = collection_key(type_name)
        String val_ty = collection_val(type_name)
        if key_ty == "str" or key_ty == "String":
            String keys_var = next_var()
            String idx = next_var()
            String key_var = next_var()
            String val_var = next_var()
            String inner = indent + "    "
            String val_lines = field_read_lines(val_var, val_ty, inner)
            return indent + "de.begin_struct()\n" + indent + "Vector[String] " + keys_var + " = de.keys()\n" + indent + type_name + " " + name + " = " + type_name + "()\n" + indent + "int " + idx + " = 0\n" + indent + "while " + idx + " < " + keys_var + ".len():\n" + inner + "String " + key_var + " = " + keys_var + ".get(" + idx + ").unwrap()\n" + inner + "de.field(" + key_var + ")\n" + val_lines + inner + name + ".put(" + key_var + ", " + val_var + ")\n" + inner + idx + " = " + idx + " + 1\n" + indent + "de.end_struct()\n"
    return indent + field_read_decl(name, type_name) + "\n"

String field_default(String type_name):
    if type_name == "int" or type_name == "int8" or type_name == "int16" or type_name == "int32" or type_name == "int64":
        return "0"
    if type_name == "uint" or type_name == "uint8" or type_name == "uint16" or type_name == "uint32" or type_name == "uint64":
        return "0"
    if type_name == "float" or type_name == "float32" or type_name == "float64":
        return "0.0"
    if type_name == "bool":
        return "false"
    if type_name == "str" or type_name == "String":
        return "\"\""
    if type_name == "String":
        return "String()"
    return type_name + ".default()"

String field_write_call(String expr, String type_name):
    if type_name == "int":
        return "ser.write_int(" + expr + ")"
    if type_name == "int8" or type_name == "int16" or type_name == "int32" or type_name == "int64":
        return "ser.write_int(" + expr + " as int)"
    if type_name == "uint" or type_name == "uint8" or type_name == "uint16" or type_name == "uint32" or type_name == "uint64":
        return "ser.write_int(" + expr + " as int)"
    if type_name == "float":
        return "ser.write_float(" + expr + ")"
    if type_name == "float32" or type_name == "float64":
        return "ser.write_float(" + expr + " as float)"
    if type_name == "bool":
        return "ser.write_bool(" + expr + ")"
    if type_name == "str" or type_name == "String":
        return "ser.write_str(" + expr + ")"
    return expr + ".serialize(ser)"

String field_read_decl(String name, String type_name):
    if type_name == "int":
        return "int " + name + " = de.read_int()"
    if type_name == "float":
        return "float " + name + " = de.read_float()"
    if type_name == "bool":
        return "bool " + name + " = de.read_bool()"
    if type_name == "str" or type_name == "String":
        return "String " + name + " = de.read_str()"
    return type_name + " " + name + " = deserialize_" + type_name + "(de)"

void inject_items(String source, Vector[Item] &new_items):
    Module parsed = parse_source(source)
    for item in parsed.items:
        match item:
            case IEquip(eb):
                new_items.push(IEquip(eb))
            case IFunction(fd):
                new_items.push(IFunction(fd))
            else:
                pass

# ── Variant prefix ──────────────────────────────────────────

String variant_prefix(String type_name, Vector[String] type_params):
    if type_params.len() > 0:
        return ""
    return type_name + "."

# ── Struct derive generators ────────────────────────────────

String gen_struct_equatable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Equatable:\n"
    src = src + "    bool eq(self, " + name + gs + " other):\n"
    if fields.len() == 0:
        src = src + "        return true\n"
    else:
        String cmp = ""
        for (i, f) in fields.enumerate():
            if i > 0:
                cmp = cmp + " and "
            cmp = cmp + "self." + f.param_name + " == other." + f.param_name
        src = src + "        return " + cmp + "\n"
    return src

String gen_struct_displayable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Displayable:\n"
    src = src + "    String display(self):\n"
    if fields.len() == 0:
        src = src + "        return \"" + name + "()\"\n"
    else:
        String parts = ""
        for (i, f) in fields.enumerate():
            if i > 0:
                parts = parts + ", "
            parts = parts + f.param_name + "={self." + f.param_name + "}"
        src = src + "        return f\"" + name + "(" + parts + ")\"\n"
    return src

String gen_struct_debuggable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Debuggable:\n"
    src = src + "    String debug(self):\n"
    if fields.len() == 0:
        src = src + "        return \"" + name + "\"\n"
    else:
        String parts = ""
        for (i, f) in fields.enumerate():
            if i > 0:
                parts = parts + ", "
            parts = parts + f.param_name + ": {self." + f.param_name + ".debug()}"
        src = src + "        return f\"" + name + " {{ " + parts + " }}\"\n"
    return src

String gen_struct_cloneable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Cloneable:\n"
    src = src + "    " + name + gs + " clone(self):\n"
    String args = ""
    for (i, f) in fields.enumerate():
        if i > 0:
            args = args + ", "
        args = args + "self." + f.param_name
    src = src + "        return " + name + gs + "(" + args + ")\n"
    return src

# Emit the per-field Hashable body line. Uniform `self.field.hash(&h)`
# for EVERY field — matches Rust's derive.rs:407 (`self.{name}.hash(&h)`).
# The call-site primitive-`.hash` special case in lower_expr.gg lowers a
# `.hash(&h)` on a primitive receiver (int/String/bool/byte/char) directly
# to the matching `FxHasher__write_int/write_string`, resolving the hasher
# type from the `&h` arg (defaulting to FxHasher when `H` is the unbound
# method generic of the derived `hash[Hasher H]`). Non-primitive fields
# route through the field type's own Hashable impl, same as before.
String hashable_field_line(String access, String ftype):
    return "        " + access + ".hash(&h)\n"

String gen_struct_hashable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Hashable:\n"
    src = src + "    void hash[Hasher H](self, H &h):\n"
    if fields.len() == 0:
        src = src + "        h.write_int(0)\n"
    else:
        for f in fields:
            String ftype = format_ast_type(f.param_type)
            src = src + hashable_field_line("self." + f.param_name, ftype)
    return src

String gen_struct_default(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Default:\n"
    src = src + "    " + name + gs + " default():\n"
    String args = ""
    for (i, f) in fields.enumerate():
        if i > 0:
            args = args + ", "
        args = args + field_default(format_ast_type(f.param_type))
    src = src + "        return " + name + gs + "(" + args + ")\n"
    return src

String gen_struct_serializable(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with Serializable:\n"
    src = src + "    void serialize(self, Box[Serializer] ser):\n"
    src = src + "        ser.begin_struct(\"" + name + "\", " + int_to_str(fields.len()) + ")\n"
    for (i, f) in fields.enumerate():
        String fname = f.param_name
        String ftype = format_ast_type(f.param_type)
        src = src + "        ser.field(\"" + fname + "\", " + int_to_str(i) + ")\n"
        src = src + field_write_lines("self." + fname, ftype, "        ")
    src = src + "        ser.end_struct()\n"
    return src

String gen_struct_deserializable(String name, String gs, Vector[Param] fields):
    String src = "Result[" + name + gs + ", String] deserialize_" + name + "(Box[Deserializer] de):\n"
    src = src + "    de.begin_struct()\n"
    for f in fields:
        String fname = f.param_name
        String ftype = format_ast_type(f.param_type)
        src = src + "    de.field(\"" + fname + "\")\n"
        src = src + field_read_lines(fname, ftype, "    ")
    src = src + "    de.end_struct()\n"
    src = src + "    if de.has_error():\n"
    src = src + "        return Error(de.error())\n"
    String args = ""
    for (j, f) in fields.enumerate():
        if j > 0:
            args = args + ", "
        args = args + f.param_name
    src = src + "    return Ok(" + name + gs + "(" + args + "))\n"
    return src

String gen_struct_from(String name, String gs, String gp, Vector[Param] fields):
    if fields.len() != 1:
        return ""
    Param f = fields.get(0).unwrap()
    String ftype = format_ast_type(f.param_type)
    String src = "equip " + gp + name + gs + " with From[" + ftype + "]:\n"
    src = src + "    " + name + gs + " from(" + ftype + " value):\n"
    src = src + "        return " + name + gs + "(value)\n"
    return src

String gen_struct_try_from(String name, String gs, String gp, Vector[Param] fields):
    if fields.len() != 1:
        return ""
    Param f = fields.get(0).unwrap()
    String ftype = format_ast_type(f.param_type)
    String src = "equip " + gp + name + gs + " with TryFrom[" + ftype + "]:\n"
    src = src + "    Result[" + name + gs + ", String] try_from(" + ftype + " value):\n"
    src = src + "        return Ok(" + name + gs + "(value))\n"
    return src

String gen_struct_from_row(String name, String gs, String gp, Vector[Param] fields):
    String src = "equip " + gp + name + gs + " with FromRow:\n"
    src = src + "    " + name + gs + " from_row(Row row):\n"
    for f in fields:
        String fname = f.param_name
        String ftype = format_ast_type(f.param_type)
        if ftype == "str" or ftype == "String":
            src = src + "        String " + fname + " = row.get(\"" + fname + "\")\n"
        elif ftype == "int" or ftype == "int8" or ftype == "int16" or ftype == "int32" or ftype == "int64" or ftype == "uint" or ftype == "uint8" or ftype == "uint16" or ftype == "uint32" or ftype == "uint64":
            src = src + "        int " + fname + " = row.get_int(\"" + fname + "\")\n"
        elif ftype == "float" or ftype == "float32" or ftype == "float64":
            src = src + "        float " + fname + " = row.get_float(\"" + fname + "\")\n"
        elif ftype == "bool":
            src = src + "        bool " + fname + " = row.get_bool(\"" + fname + "\")\n"
        else:
            src = src + "        String " + fname + " = row.get(\"" + fname + "\")\n"
    String args = ""
    for (j, f) in fields.enumerate():
        if j > 0:
            args = args + ", "
        args = args + f.param_name
    src = src + "        return " + name + gs + "(" + args + ")\n"
    return src

# ── Enum derive generators ──────────────────────────────────

String gen_enum_equatable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Equatable:\n"
    src = src + "    bool eq(self, " + name + gs + " other):\n"
    src = src + "        match self:\n"
    for v in variants:
        int fc = v.fields.len()
        String self_binds = ""
        String other_binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                self_binds = self_binds + ", "
                other_binds = other_binds + ", "
            self_binds = self_binds + "a" + int_to_str(fi)
            other_binds = other_binds + "b" + int_to_str(fi)
        String self_pat = pfx + v.name + "(" + self_binds + ")"
        String other_pat = pfx + v.name + "(" + other_binds + ")"
        String cmp = "true"
        if fc > 0:
            cmp = ""
            for (ci, _) in v.fields.enumerate():
                if ci > 0:
                    cmp = cmp + " and "
                cmp = cmp + "a" + int_to_str(ci) + " == b" + int_to_str(ci)
        src = src + "            case " + self_pat + ":\n"
        src = src + "                match other:\n"
        src = src + "                    case " + other_pat + ":\n"
        src = src + "                        return " + cmp + "\n"
        src = src + "                    else:\n"
        src = src + "                        return false\n"
    return src

String gen_enum_displayable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Displayable:\n"
    src = src + "    String display(self):\n"
    src = src + "        match self:\n"
    for v in variants:
        int fc = v.fields.len()
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        if fc == 0:
            src = src + "            case " + pat + ":\n"
            src = src + "                return \"" + v.name + "()\"\n"
        else:
            String parts = ""
            for (pi, _) in v.fields.enumerate():
                if pi > 0:
                    parts = parts + ", "
                parts = parts + "{a" + int_to_str(pi) + "}"
            src = src + "            case " + pat + ":\n"
            src = src + "                return f\"" + v.name + "(" + parts + ")\"\n"
    return src

String gen_enum_debuggable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Debuggable:\n"
    src = src + "    String debug(self):\n"
    src = src + "        match self:\n"
    for v in variants:
        int fc = v.fields.len()
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        if fc == 0:
            src = src + "            case " + pat + ":\n"
            src = src + "                return \"" + v.name + "\"\n"
        else:
            String parts = ""
            for (pi, _) in v.fields.enumerate():
                if pi > 0:
                    parts = parts + ", "
                parts = parts + "{a" + int_to_str(pi) + ".debug()}"
            src = src + "            case " + pat + ":\n"
            src = src + "                return f\"" + v.name + "(" + parts + ")\"\n"
    return src

String gen_enum_cloneable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Cloneable:\n"
    src = src + "    " + name + gs + " clone(self):\n"
    src = src + "        match self:\n"
    for v in variants:
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        src = src + "            case " + pat + ":\n"
        src = src + "                return " + pfx + v.name + "(" + binds + ")\n"
    return src

String gen_enum_hashable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Hashable:\n"
    src = src + "    void hash[Hasher H](self, H &h):\n"
    src = src + "        match self:\n"
    for (vi, v) in variants.enumerate():
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        src = src + "            case " + pat + ":\n"
        src = src + "                h.write_int(" + int_to_str(vi) + ")\n"
        for (hi, ft) in v.fields.enumerate():
            String ftype = format_ast_type(ft)
            String access = "a" + int_to_str(hi)
            # Same primitive-vs-non-primitive split as the struct case;
            # match arm bodies sit at 16-space indent while
            # `hashable_field_line` returns 8 — pad with 8 more.
            src = src + "        " + hashable_field_line(access, ftype)
    return src

String gen_enum_serializable(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Serializable:\n"
    src = src + "    void serialize(self, Box[Serializer] ser):\n"
    src = src + "        match self:\n"
    for v in variants:
        int fc = v.fields.len()
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        src = src + "            case " + pat + ":\n"
        if fc == 0:
            src = src + "                ser.write_str(\"" + v.name + "\")\n"
        else:
            src = src + "                ser.begin_struct(\"" + v.name + "\", 1)\n"
            src = src + "                ser.field(\"" + v.name + "\", 0)\n"
            src = src + "                ser.begin_seq(" + int_to_str(fc) + ")\n"
            for (si, ft) in v.fields.enumerate():
                src = src + "                ser.elem(" + int_to_str(si) + ")\n"
                String ftype = format_ast_type(ft)
                src = src + "                " + field_write_call("a" + int_to_str(si), ftype) + "\n"
            src = src + "                ser.end_seq()\n"
            src = src + "                ser.end_struct()\n"
    return src

String gen_enum_deserializable(String name, String gs, Vector[EnumVariant] variants, String pfx):
    String src = "Result[" + name + gs + ", String] deserialize_" + name + "(Box[Deserializer] de):\n"
    # Separate unit and data variants
    Vector[String] unit_names = Vector[String]()
    Vector[EnumVariant] data_variants = Vector[EnumVariant]()
    for v in variants:
        if v.fields.len() == 0:
            unit_names.push(v.name)
        else:
            data_variants.push(v.clone())
    if unit_names.len() > 0:
        src = src + "    if de.is_string():\n"
        src = src + "        String de_tag = de.read_str()\n"
        for (ui, uname) in unit_names.enumerate():
            if ui == 0:
                src = src + "        if de_tag == \"" + uname + "\":\n"
            else:
                src = src + "        elif de_tag == \"" + uname + "\":\n"
            src = src + "            return Ok(" + pfx + uname + "())\n"
        src = src + "        return Error(\"unknown variant\")\n"
    if data_variants.len() > 0:
        src = src + "    de.begin_struct()\n"
        for (di, dv) in data_variants.enumerate():
            String cond = "if"
            if di > 0:
                cond = "elif"
            src = src + "    " + cond + " de.has_field(\"" + dv.name + "\"):\n"
            src = src + "        de.field(\"" + dv.name + "\")\n"
            src = src + "        int de_seq_len = de.begin_seq()\n"
            for (dfi, ft) in dv.fields.enumerate():
                src = src + "        de.elem(" + int_to_str(dfi) + ")\n"
                String ftype = format_ast_type(ft)
                String var_name = "a" + int_to_str(dfi)
                src = src + "        " + field_read_decl(var_name, ftype) + "\n"
            src = src + "        de.end_seq()\n"
            src = src + "        de.end_struct()\n"
            src = src + "        if de.has_error():\n"
            src = src + "            return Error(de.error())\n"
            String dargs = ""
            for (dai, _) in dv.fields.enumerate():
                if dai > 0:
                    dargs = dargs + ", "
                dargs = dargs + "a" + int_to_str(dai)
            src = src + "        return Ok(" + pfx + dv.name + "(" + dargs + "))\n"
        src = src + "    de.end_struct()\n"
    src = src + "    return Error(\"unknown variant\")\n"
    return src

String gen_enum_ordinal(String name, String gs, String gp, Vector[EnumVariant] variants, String pfx):
    String src = "equip " + gp + name + gs + " with Ordinal:\n"
    src = src + "    int ordinal(self):\n"
    src = src + "        match self:\n"
    for (vi, v) in variants.enumerate():
        String binds = ""
        for (fi, _) in v.fields.enumerate():
            if fi > 0:
                binds = binds + ", "
            binds = binds + "a" + int_to_str(fi)
        String pat = pfx + v.name + "(" + binds + ")"
        src = src + "            case " + pat + ":\n"
        src = src + "                return " + int_to_str(vi) + "\n"
    return src

# ── Core expansion ──────────────────────────────────────────

void expand_struct_derives(StructDef sd, Vector[Item] &new_items):
    String name = sd.name
    String gs = generic_suffix(sd.type_params)
    String gp = equip_prefix(sd.type_params)
    for trait_name in sd.derives:
        String source = ""
        if trait_name == "Equatable":
            source = gen_struct_equatable(name, gs, gp, sd.fields)
        elif trait_name == "Displayable":
            source = gen_struct_displayable(name, gs, gp, sd.fields)
        elif trait_name == "Debuggable":
            source = gen_struct_debuggable(name, gs, gp, sd.fields)
        elif trait_name == "Cloneable":
            source = gen_struct_cloneable(name, gs, gp, sd.fields)
        elif trait_name == "Hashable":
            source = gen_struct_hashable(name, gs, gp, sd.fields)
        elif trait_name == "Default":
            source = gen_struct_default(name, gs, gp, sd.fields)
        elif trait_name == "Serializable":
            source = gen_struct_serializable(name, gs, gp, sd.fields)
        elif trait_name == "Deserializable":
            source = gen_struct_deserializable(name, gs, sd.fields)
        elif trait_name == "From":
            source = gen_struct_from(name, gs, gp, sd.fields)
        elif trait_name == "TryFrom":
            source = gen_struct_try_from(name, gs, gp, sd.fields)
        elif trait_name == "FromRow":
            source = gen_struct_from_row(name, gs, gp, sd.fields)
        if source != "":
            inject_items(source, &new_items)

void expand_enum_derives(EnumDef ed, Vector[Item] &new_items):
    String name = ed.name
    String gs = generic_suffix(ed.type_params)
    String gp = equip_prefix(ed.type_params)
    String pfx = variant_prefix(name, ed.type_params)
    for trait_name in ed.derives:
        String source = ""
        if trait_name == "Equatable":
            source = gen_enum_equatable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Displayable":
            source = gen_enum_displayable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Debuggable":
            source = gen_enum_debuggable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Cloneable":
            source = gen_enum_cloneable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Hashable":
            source = gen_enum_hashable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Serializable":
            source = gen_enum_serializable(name, gs, gp, ed.variants, pfx)
        elif trait_name == "Deserializable":
            source = gen_enum_deserializable(name, gs, ed.variants, pfx)
        elif trait_name == "Ordinal":
            source = gen_enum_ordinal(name, gs, gp, ed.variants, pfx)
        if source != "":
            inject_items(source, &new_items)

void expand_derives(Module &m):
    Vector[Item] new_items = Vector[Item]()
    for item in m.items:
        match item:
            case IStruct(sd):
                expand_struct_derives(sd, &new_items)
            case IEnum(ed):
                expand_enum_derives(ed, &new_items)
            else:
                pass
    int j = 0
    while j < new_items.len():
        m.items.push(new_items.get(j).unwrap())
        j = j + 1
