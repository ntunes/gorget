# Simplified type table for the resolution phase.
# Mirrors src/semantic/types.rs but only what name resolution needs.

from std.collections import Vector, Dict
from ast import Span, Type, SpannedType, SpannedExpr, Expr
from ids import NO_DEF, NO_TYPE
from scope import ScopeTable, DefKind, NO_DEF

# ── Resolved type variants ──────────────────────────────────

enum ResolvedType:
    RTPrimitive(String)
    RTDefined(int)
    RTGeneric(int, Vector[int])
    RTTuple(Vector[int])
    RTArray(int, int)
    RTSlice(int)
    RTFunction(Vector[int], Vector[int], int)
    RTTraitObject(int)
    RTCallableTrait(int)
    RTMutCallableTrait(int)
    RTConsumeCallableTrait(int)
    RTBoxedCallable(String, int)
    RTVar(int)
    RTError
    RTVoid
    RTNever
    RTRef(int)

# ── Typed accessors ─────────────────────────────────────────

ResolvedType get_rtype_at(Vector[ResolvedType] v, int i):
    # An unresolved type is carried as the sentinel id -1 (mirrors the Rust
    # typechecker's `ResolvedType::Error` for an unresolved/invalid TypeId —
    # Rust's u32 ids can't be -1, so the self-host guards it here). Reading a
    # negative (sentinel) id yields the Error type rather than trapping on
    # unwrap-None. A positive out-of-range id is deliberately NOT masked — it
    # would be a real bug and should trap, matching Rust's bare-index panic.
    # The -1 inflow itself is filed for its own investigation (TODO).
    if i < 0:
        return RTError()
    return v.get(i).unwrap()

SpannedType get_stype_at(Vector[SpannedType] v, int i):
    return v.get(i).unwrap()

int get_int_at(Vector[int] v, int i):
    return v.get(i).unwrap()

# ── Type table ──────────────────────────────────────────────

# ── Trait-registry data (used by typecheck/infer; see traits.gg) ──
# Stored on TypeTable so the registry can ride on the existing `&types`
# threading rather than adding a new parameter to every typechecker
# function. Builder + lookup logic lives in traits.gg.

struct FunctionSig:
    Vector[int] params
    int return_type
    bool has_self
    int self_ownership

struct MethodSigShape:
    Vector[String] generic_params
    Vector[Type] param_types
    Type return_type

struct TraitInfo:
    int def_id
    String name
    Vector[String] method_names
    Vector[FunctionSig] method_sigs
    Vector[bool] method_has_default_body
    Vector[String] shape_method_names
    Vector[MethodSigShape] shape_method_shapes
    Vector[String] trait_generic_params
    Vector[int] parent_trait_ids
    # AST-level shapes for default-bodied methods (mirrors Rust's
    # default_method_sigs). Populated for methods whose body is
    # non-empty so call-site substitution can bind Self / trait-T
    # in the AST return type before resolving to a TypeId.
    Vector[String] default_shape_names
    Vector[MethodSigShape] default_shape_shapes

struct EquipInfo:
    int self_type
    String self_type_name
    int trait_def_id
    String trait_name
    Vector[String] method_names
    Vector[int] method_def_ids
    Vector[FunctionSig] method_sigs
    Vector[String] shape_method_names
    Vector[MethodSigShape] shape_method_shapes
    Type self_type_ast
    Vector[String] impl_generic_params
    String via_field
    # AST args from the trait clause (e.g. [TPrimitive("int")] for
    # `with Iterator[int]`). Empty for non-generic traits / inherent
    # impls. Used at call site to bind trait-T in default-method sigs.
    Vector[Type] trait_generic_args
    # AST-level return type for EVERY impl method (parallel to
    # method_names). Used by `resolve_method_for_generic_receiver`
    # to substitute the impl's generic-param placeholders with the
    # receiver's concrete type args at call time, so e.g.
    # `equip [T] Vector[T] with Iterable[T]: VectorIter[T] iter(&self)`
    # called on `Vector[int]` returns `VectorIter[int]` instead of
    # `VectorIter[T_param_def_id]` (abstract placeholder).
    # Distinct from `shape_method_shapes` which only stores AST shapes
    # for METHOD-GENERIC methods (those with their own `[G]` params).
    Vector[Type] method_return_types_ast

struct TraitRegistry:
    Vector[TraitInfo] traits
    Vector[EquipInfo] impls
    # Index: self_type → indices into `impls` for inherent impls
    # (trait_def_id == NO_DEF). Maintained by `collect_equip`. Used by
    # `resolve_method_full` to skip linear scan over the full impls
    # vector. Mirrors Rust's `inherent_impls: FxHashMap<TypeId, Vec<usize>>`.
    Dict[int, Vector[int]] inherent_impls
    # Index: self_type → indices into `impls` for trait impls (any
    # trait_def_id != NO_DEF). Used by phases 2 and 3 of
    # `resolve_method_full`. Mirrors Rust's `trait_impls`, but keyed on
    # self_type only (the trait+args composite key isn't needed for
    # method resolution — only for duplicate-impl validation, which the
    # self-host typechecker doesn't perform).
    Dict[int, Vector[int]] trait_impls
    # Index: method NAME → 1, for every method registered with method-level
    # generic params (`[G]`). Derived ONCE by `index_method_generic_names`
    # (traits.gg) as a PROJECTION of the `shape_method_names` tables after
    # every collector has run — never written alongside them, so there is no
    # parallel list to keep in sync and a collector added later cannot
    # populate one and forget the other. Read via
    # `registry_has_method_generic_name`.
    #
    # WHY IT IS EXACT, not a heuristic: `expr_method_targs.put` (infer.gg) has
    # exactly ONE write site, reachable only when `sh.found`, and both shape
    # resolvers (`resolve_method_shape` / `..._for_generic_receiver`) look up
    # ONLY `shape_method_names` on an impl or a trait. So a name absent from
    # this index provably cannot reach the `put` — the index is a NECESSARY
    # condition on recording, derived from typed registry metadata rather than
    # matched against a hardcoded name list.
    Dict[String, int] method_generic_names

struct MethodResolution:
    bool found
    FunctionSig sig
    int def_id

struct ShapeResolution:
    bool found
    MethodSigShape shape

struct TypeTable:
    Vector[ResolvedType] types
    Dict[int, int] defined_cache
    int void_id
    int bool_id
    int int_id
    int float_id
    int char_id
    int string_id
    int owned_string_id
    int error_id
    int never_id
    int self_type_id
    Dict[String, int] variant_field_types
    int last_equip_scope
    int equip_def_index
    Dict[String, String] meta_aliases
    int next_type_var
    TraitRegistry trait_registry
    # Side-channel: var_ids of RTVars allocated as the binding-side
    # demotion of a generic-param reference. The formatter renders
    # these as "<error>" (matching Rust's two-tier signature/binding
    # representation), while regular closure-inference RTVars keep
    # their "?N" rendering. See `fresh_generic_var` below.
    Dict[int, bool] generic_var_ids
    # Scope id of the trait-bounded equip we're currently inside, or
    # -1 if not in one. Generic params defined IN that scope (the
    # impl's own [T]) keep their `Defined` rendering — Rust does not
    # demote them. Method-level generics (`[Hasher H]`) inside the
    # method still demote, because their def lives in the method's
    # body scope, not the equip scope.
    int trait_equip_scope_id
    # Per-expression resolved type side-table — key: SpannedExpr.span.start,
    # value: index into `types` (a ResolvedType id). Written by
    # `infer_expr_type` on every call; subsequent calls overwrite (the
    # last computation wins, mirroring Rust's late-binding inference
    # behavior). Read by the lowerer to consume typed metadata without
    # reconstructing expression types from scratch. Layering rule 3:
    # one source of truth per axis — the typechecker computes
    # expression types, the lowerer reads them. (Gap #2 Phase 1.)
    Dict[int, int] expr_types
    # Per-method-call inferred method-level type-args side-table — key:
    # EMethodCall.span.END, value: the Vector of inferred method-targ
    # TypeIds (parallel to `expr_types`). Written by `infer_expr_type`
    # when a method-level-generic equip method (e.g. Iterator's
    # `fold[A,F]`/`any[F]`) is called WITHOUT an explicit turbofish, so
    # the bare-form call site can be monomorphized to the same userland
    # adapter symbol the turbofish form produces. Read by the lowerer at
    # the EMethodCall lowering when the syntactic 4th field is empty
    # (lazy-iterator phase 1b). Layering rule 3: the typechecker infers
    # the method-targs once; the lowerer reads them.
    #
    # ⚠ WHY span.END (not span.start): the parser gives the OUTER and every
    # INNER call of a method chain the SAME `span.start` (the chain's receiver
    # start) — `v.iter().fold(0,f)` makes both the `.iter()` and `.fold()`
    # EMethodCall nodes start at `v`. Keying on span.start collapsed the chain
    # onto one slot (last-`put`-wins), so a chain with two method-generic links
    # (`.filter[F]` AND `.map[U,F]`) lost one link's targs — its adapter ctor
    # was CALLED-but-never-DEFINED (CC-fail). `span.end` is UNIQUE per link
    # (each link ends at a distinct token — the same invariant `expr_link_types`
    # uses), so the KEY ALONE keeps every link's targs separate. The parallel
    # `expr_method_targs_name` still records the writer's METHOD NAME, and the
    # readers (call-site + discovery walk) cross-check it as a cheap
    # belt-and-suspenders guard — it is no longer the load-bearing disambiguator
    # (the unique key is), just a guard against a stale entry.
    Dict[int, Vector[int]] expr_method_targs
    Dict[int, String] expr_method_targs_name
    # Per-CHAIN-LINK resolved type side-table — key: SpannedExpr.span.END,
    # value: index into `types` (a ResolvedType id). Written by
    # `infer_expr_type`'s registry-resolved EMethodCall path alongside
    # `expr_types`.
    #
    # WHY a SECOND table keyed on span.END: the parser gives the OUTER and
    # every INNER call of a method chain the SAME `span.start` (the chain's
    # receiver start) — `v.iter().take(4).filter(p)` makes `.iter()`,
    # `.take()`, `.filter()` all start at `v`. So `expr_types` (keyed on
    # span.start) collapses the whole chain onto one slot (last-writer-wins =
    # the OUTERMOST type), and an INNER link reads the wrong (output) type →
    # the lowerer emits `FilterIter__…__take(...)` and CC-fails. `span.END`
    # is UNIQUE per link (each link ends at a different token), so this table
    # preserves EACH link's own resolved type. The lowerer's
    # `lookup_expr_gir_type` prefers this per-link table for method-chain
    # links and falls back to `expr_types` for non-chain exprs. This is the
    # self-host analog of Rust's recursive span-table-free `infer_expr_ast_type`
    # oracle: the typechecker's recursive `infer_expr_type` already RE-DERIVES
    # each link's type from the trait registry; we just persist its per-link
    # output here instead of letting the span.start collision discard it.
    # `expr_method_targs` now keys on the SAME unique span.end, but it is a
    # SEPARATE Dict storing different values (inferred method-targs, not link
    # types), so the two tables never interfere — the bare-form
    # terminal-recording contract there is untouched.
    Dict[int, int] expr_link_types

equip TypeTable:

    TypeTable new_type_table():
        Vector[ResolvedType] types = Vector[ResolvedType]()
        # Pre-allocate well-known types (order must match Rust's TypeTable::new)
        # 0: void
        types.push(RTVoid())
        # 1: bool
        types.push(RTPrimitive("bool"))
        # 2: int
        types.push(RTPrimitive("int"))
        # 3: float
        types.push(RTPrimitive("float"))
        # 4: char
        types.push(RTPrimitive("char"))
        # 5: String
        types.push(RTPrimitive("str"))
        # 6: String (owned)
        types.push(RTPrimitive("String"))
        # 7: error
        types.push(RTError())
        # 8: never
        types.push(RTNever())
        TraitRegistry empty_reg = TraitRegistry(Vector[TraitInfo](), Vector[EquipInfo](), Dict[int, Vector[int]](), Dict[int, Vector[int]](), Dict[String, int]())
        Dict[int, int] empty_expr_types = Dict[int, int]()
        Dict[int, Vector[int]] empty_expr_method_targs = Dict[int, Vector[int]]()
        Dict[int, String] empty_expr_method_targs_name = Dict[int, String]()
        Dict[int, int] empty_expr_link_types = Dict[int, int]()
        return TypeTable(types, Dict[int, int](), 0, 1, 2, 3, 4, 5, 6, 7, 8, -1, Dict[String, int](), 0, 0, Dict[String, String](), 1, empty_reg, Dict[int, bool](), -1, empty_expr_types, empty_expr_method_targs, empty_expr_method_targs_name, empty_expr_link_types)

    int add_type(&self, ResolvedType !ty):
        int id = self.types.len()
        self.types.push(!ty)
        return id

    int fresh_var(&self):
        int var_id = self.next_type_var
        self.next_type_var = var_id + 1
        return self.add_type(!RTVar(var_id))

    # Allocate a fresh RTVar AND tag it as a generic-param-binding
    # demotion. The formatter renders these as "<error>" (matching
    # Rust's signature-vs-binding asymmetry); see format_types.gg.
    int fresh_generic_var(&self):
        int var_id = self.next_type_var
        self.next_type_var = var_id + 1
        self.generic_var_ids.put(var_id, true)
        return self.add_type(!RTVar(var_id))

    int defined_id(&self, int def_id):
        if self.defined_cache.contains(def_id):
            return self.defined_cache.get(def_id).unwrap()
        int tid = self.add_type(!RTDefined(def_id))
        self.defined_cache.put(def_id, tid)
        return tid

    ResolvedType get(self, int id):
        return get_rtype_at(self.types, id)

    int primitive_id(&self, String prim_name):
        if prim_name == "bool":
            return self.bool_id
        if prim_name == "int":
            return self.int_id
        if prim_name == "float":
            return self.float_id
        if prim_name == "char":
            return self.char_id
        if prim_name == "str":
            return self.string_id
        if prim_name == "String":
            return self.owned_string_id
        if prim_name == "void":
            return self.void_id
        # Other numeric types — search or insert
        for (i, t) in self.types.enumerate():
            match t:
                case RTPrimitive(name):
                    if name == prim_name:
                        return i
                else:
                    pass
        return self.add_type(!RTPrimitive(prim_name))

# ── AST Type → TypeId conversion ────────────────────────────

int ast_type_to_resolved(Type ast_ty, Span span, ScopeTable scopes, TypeTable &types):
    match ast_ty:
        case TPrimitive(name):
            return types.primitive_id(name)

        case TNamed(name, generic_args):
            # Handle cstr as primitive (not in self-hosting lexer as keyword)
            if name == "cstr" and generic_args.len() == 0:
                return types.primitive_id("cstr")
            # Callable[sig] / MutCallable[sig] / ConsumeCallable[sig]
            if generic_args.len() == 1:
                if name == "Callable" or name == "MutCallable" or name == "ConsumeCallable":
                    SpannedType arg0 = get_stype_at(generic_args, 0)
                    int inner = ast_type_to_resolved(arg0.ty, arg0.span, scopes, &types)
                    ResolvedType inner_ty = get_rtype_at(types.types, inner)
                    bool is_fn = false
                    match inner_ty:
                        case RTFunction(_, _, _):
                            is_fn = true
                        else:
                            pass
                    if is_fn:
                        if name == "Callable":
                            return types.add_type(!RTCallableTrait(inner))
                        if name == "MutCallable":
                            return types.add_type(!RTMutCallableTrait(inner))
                        return types.add_type(!RTConsumeCallableTrait(inner))
                    return types.error_id

            if scopes.lookup(name) is Some(def_id):
                DefKind dk = scopes.get_def(def_id).kind
                bool is_type_def = false
                match dk:
                    case DkStruct():
                        is_type_def = true
                    case DkEnum():
                        is_type_def = true
                    case DkTrait():
                        is_type_def = true
                    case DkTypeAlias():
                        # If the alias has been resolved, return the underlying type
                        DefInfo alias_d = scopes.get_def(def_id)
                        if alias_d.type_id >= 0:
                            return alias_d.type_id
                        is_type_def = true
                    case DkNewtype():
                        is_type_def = true
                    case DkGenericParam():
                        is_type_def = true
                    case DkImport():
                        is_type_def = true
                    else:
                        pass
                if is_type_def:
                    if generic_args.len() == 0:
                        return types.defined_id(def_id)
                    Vector[int] resolved_args = Vector[int]()
                    for arg in generic_args:
                        int arg_id = ast_type_to_resolved(arg.ty, arg.span, scopes, &types)
                        resolved_args.push(arg_id)
                    # Box[Trait] → TraitObject
                    if name == "Box" and resolved_args.len() == 1:
                        int inner_tid = get_int_at(resolved_args, 0)
                        ResolvedType inner_rt = get_rtype_at(types.types, inner_tid)
                        match inner_rt:
                            case RTDefined(inner_def_id):
                                DefKind inner_dk = scopes.get_def(inner_def_id).kind
                                bool is_trait = false
                                match inner_dk:
                                    case DkTrait():
                                        is_trait = true
                                    else:
                                        pass
                                if is_trait:
                                    return types.add_type(!RTTraitObject(inner_def_id))
                            case RTCallableTrait(func_id):
                                return types.add_type(!RTBoxedCallable("Callable", func_id))
                            case RTMutCallableTrait(func_id):
                                return types.add_type(!RTBoxedCallable("MutCallable", func_id))
                            case RTConsumeCallableTrait(func_id):
                                return types.add_type(!RTBoxedCallable("ConsumeCallable", func_id))
                            else:
                                pass
                    return types.add_type(!RTGeneric(def_id, resolved_args))
                # Not a type
                return types.error_id
            # Check meta type aliases before giving up
            if types.meta_aliases.contains(name):
                String alias_target = types.meta_aliases[name]
                # Check if target is a primitive type
                if alias_target == "int" or alias_target == "float" or alias_target == "bool" or alias_target == "str" or alias_target == "char" or alias_target == "String" or alias_target == "int8" or alias_target == "int16" or alias_target == "int32" or alias_target == "int64" or alias_target == "uint8" or alias_target == "uint16" or alias_target == "uint32" or alias_target == "uint64" or alias_target == "float32" or alias_target == "float64" or alias_target == "cstr":
                    if generic_args.len() == 0:
                        return types.primitive_id(alias_target)
                    return types.error_id
                # Target is a named type — look it up in scope
                if scopes.lookup(alias_target) is Some(alias_def):
                    if generic_args.len() == 0:
                        return types.defined_id(alias_def)
                    Vector[int] resolved_args = Vector[int]()
                    for arg in generic_args:
                        int arg_id = ast_type_to_resolved(arg.ty, arg.span, scopes, &types)
                        resolved_args.push(arg_id)
                    return types.add_type(!RTGeneric(alias_def, resolved_args))
                return types.error_id
            # Unknown type
            return types.error_id

        case TArray(element, size):
            int elem_id = ast_type_to_resolved((*element).ty, (*element).span, scopes, &types)
            return types.add_type(!RTArray(elem_id, size))

        case TSlice(element):
            int elem_id = ast_type_to_resolved((*element).ty, (*element).span, scopes, &types)
            return types.add_type(!RTSlice(elem_id))

        case TTuple(elements):
            Vector[int] elem_ids = Vector[int]()
            for elem in elements:
                elem_ids.push(ast_type_to_resolved(elem.ty, elem.span, scopes, &types))
            return types.add_type(!RTTuple(elem_ids))

        case TFunction(return_type, params, param_ownerships):
            int ret_id = ast_type_to_resolved((*return_type).ty, (*return_type).span, scopes, &types)
            Vector[int] param_ids = Vector[int]()
            for p in params:
                param_ids.push(ast_type_to_resolved(p.ty, p.span, scopes, &types))
            return types.add_type(!RTFunction(param_ids, param_ownerships, ret_id))

        case TSelf():
            if types.self_type_id >= 0:
                return types.self_type_id
            return types.error_id

        case TInferred():
            return types.error_id
