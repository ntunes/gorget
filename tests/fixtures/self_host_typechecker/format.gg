# AST formatter for the self-hosting Gorget parser.
# Produces canonical string representations of AST nodes for testing.

from std.collections import Vector
from std.conv import int_to_str, float_to_str
from std.math import floor, abs
from ast import Module, Item, Stmt, Expr, Type, Pattern, Span, SpannedExpr, SpannedType, SpannedPattern, FunctionDef, StructDef, EnumDef, EnumVariant, TraitDef, EquipBlock, MatchArm, ElseBranch, Param, ImportStmt, FaultCatchPattern

# ── Float formatting (decimal, no scientific notation) ──────────
# Matches Rust's Display for f64: shortest decimal without e+/e- notation.
# When %g produces scientific notation (e.g. 1e+06), convert to integer string.
# For floats that %g renders in decimal, return as-is.
String format_float_decimal(float f):
    String s = float_to_str(f)
    # If no scientific notation, return as-is
    if not s.contains("e") and not s.contains("E"):
        return s
    # Special values
    if s == "inf" or s == "-inf" or s == "nan":
        return s
    # For values that are exactly integers, convert via int
    # This handles the common case: 1e+06, 3.14159e+06, etc.
    float a = f
    if a < 0.0:
        a = 0.0 - a
    if a == floor(a) and a < 1000000000000000.0:
        int iv = 0
        if f >= 0.0:
            iv = f as int
        else:
            iv = (0.0 - (0.0 - f)) as int
        return int_to_str(iv)
    # For non-integer values with scientific notation, fall back to %g
    # (rare in parser canonical output — most large floats are integer-valued)
    return s

# ── Type formatting ──────────────────────────────────────────

String format_type(SpannedType st):
    match st.ty:
        case TPrimitive(name):
            return "" + name
        case TNamed(name, args):
            if args.len() == 0:
                return "" + name
            String result = name + "["
            for (i, arg) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_type(arg)
            result = result + "]"
            return result
        case TArray(elem, size):
            String es = format_type(*elem)
            return f"[{es}; {size}]"
        case TSlice(elem):
            String es = format_type(*elem)
            return f"[{es}]"
        case TTuple(elems):
            String result = "("
            for (i, e) in elems.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_type(e)
            result = result + ")"
            return result
        case TFunction(ret, params, owns):
            String result = format_type(*ret) + "("
            for (i, p) in params.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_type(p)
            result = result + ")"
            return result
        case TSelf:
            return "Self"
        case TInferred:
            return "auto"
        else:
            return "?"

# ── Pattern formatting ───────────────────────────────────────

String format_pattern(SpannedPattern sp):
    match sp.pat:
        case PWildcard:
            return "_"
        case PBinding(name):
            return "" + name
        case PLiteral(expr):
            return format_expr(expr)
        case PConstructor(name, args):
            if args.len() == 0:
                return "" + name
            String result = name + "("
            for (i, a) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_pattern(a)
            result = result + ")"
            return result
        case PDotShorthand(name, args):
            if args.len() == 0:
                return "." + name
            String result = "." + name + "("
            for (i, a) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_pattern(a)
            result = result + ")"
            return result
        case PTuple(elems):
            String result = "("
            for (i, e) in elems.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_pattern(e)
            result = result + ")"
            return result
        case POr(alts):
            String result = ""
            for (i, a) in alts.enumerate():
                if i > 0:
                    result = result + " | "
                result = result + format_pattern(a)
            return result
        case PRest:
            return ".."
        else:
            return "?"

# ── Expression formatting ────────────────────────────────────

String format_expr(SpannedExpr se):
    match se.expr:
        case EIntLiteral(n):
            return int_to_str(n)
        case EFloatLiteral(f):
            String fs = format_float_decimal(f)
            if not fs.contains(".") and not fs.contains("e") and not fs.contains("E"):
                return fs + ".0"
            return fs
        case EBoolLiteral(b):
            if b:
                return "true"
            return "false"
        case EStringLiteral(s, _):
            return f"\"{s}\""
        case ECharLiteral(c):
            if c.len() == 0:
                return "'\\0'"
            return f"'{c}'"
        case ENoneLiteral:
            return "None"
        case EIdentifier(name):
            return "" + name
        case ESelfExpr:
            return "self"
        case EBinaryOp(l, op, r):
            String ls = format_expr(*l)
            String rs = format_expr(*r)
            return f"({ls} {op} {rs})"
        case EUnaryOp(op, operand):
            String os = format_expr(*operand)
            return f"({op} {os})"
        case ECall(callee, args, targs):
            String cs = format_expr(*callee)
            String result = cs + "("
            for (i, a) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(a.value)
            result = result + ")"
            return result
        case EMethodCall(obj, name, args, targs):
            String os = format_expr(*obj)
            String result = f"{os}.{name}("
            for (i, a) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(a.value)
            result = result + ")"
            return result
        case EFieldAccess(obj, name):
            String os = format_expr(*obj)
            return f"{os}.{name}"
        case EIndex(obj, idx):
            String os = format_expr(*obj)
            String is_ = format_expr(*idx)
            return f"{os}[{is_}]"
        case ERange(lo, hi, inclusive):
            String result = ""
            if lo is Some(b):
                result = format_expr(*b)
            if inclusive:
                result = result + "..="
            else:
                result = result + ".."
            if hi is Some(b):
                result = result + format_expr(*b)
            return result
        case EIf(cond, body, branches):
            String result = f"if {format_expr(*cond)}:{format_block(body)}"
            for br in branches:
                if br.condition is Some(c):
                    result = result + f" elif {format_expr(c)}:"
                else:
                    result = result + " else:"
                result = result + format_block(br.body)
            return result
        case EMatch(subject, arms):
            String result = f"match {format_expr(*subject)}:"
            for arm in arms:
                result = result + f" case {format_pattern(arm.pattern)}:" + format_block(arm.body)
            return result
        case EClosure(params, body):
            String result = "("
            for (i, p) in params.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + f"{format_type(p.param_type)} {p.param_name}"
            result = result + "):" + format_block(body)
            return result
        case EIt():
            return "it"
        case EImplicitClosure(inner):
            return format_expr(*inner)
        case EArrayLiteral(elems):
            String result = "["
            for (i, e) in elems.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(e)
            result = result + "]"
            return result
        case ETupleLiteral(elems):
            String result = "("
            for (i, e) in elems.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(e)
            result = result + ")"
            return result
        case EDictLiteral(keys, vals):
            String open_b = r"{"
            String close_b = r"}"
            String result = open_b
            for (i, k) in keys.enumerate():
                if i > 0:
                    result = result + ", "
                SpannedExpr v = vals.get(i).unwrap()
                result = result + f"{format_expr(k)}: {format_expr(v)}"
            result = result + close_b
            return result
        case EStructLiteral(name, fields, vals):
            String result = f"{name}("
            for (i, v) in vals.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(v)
            result = result + ")"
            return result
        case EDotShorthand(name, args):
            if args.len() == 0:
                return f".{name}"
            String result = f".{name}("
            for (i, a) in args.enumerate():
                if i > 0:
                    result = result + ", "
                result = result + format_expr(a)
            result = result + ")"
            return result
        case ETry(inner):
            return f"{format_expr(*inner)}?"
        case EMove(inner):
            return f"!{format_expr(*inner)}"
        case EMutableBorrow(inner):
            return f"&{format_expr(*inner)}"
        case EDeref(inner):
            return f"*{format_expr(*inner)}"
        case EAs(inner, ty):
            return f"{format_expr(*inner)} as {format_type(*ty)}"
        case EBlock(stmts):
            return f"block:{format_block(stmts)}"
        case EListComp(expr, var, iter, cond):
            String result = f"[{format_expr(*expr)} for {var} in {format_expr(*iter)}"
            if cond is Some(b):
                result = result + f" if {format_expr(*b)}"
            result = result + "]"
            return result
        case ESetComp(expr, var, iter, cond):
            String lb = r"{"
            String rb = r"}"
            String sc_result = lb + f"{format_expr(*expr)} for {var} in {format_expr(*iter)}"
            if cond is Some(b):
                sc_result = sc_result + f" if {format_expr(*b)}"
            sc_result = sc_result + rb
            return sc_result
        case EDictComp(key, val, var, iter, cond):
            String lb = r"{"
            String rb = r"}"
            String dc_result = lb + f"{format_expr(*key)}: {format_expr(*val)} for {var} in {format_expr(*iter)}"
            if cond is Some(b):
                dc_result = dc_result + f" if {format_expr(*b)}"
            dc_result = dc_result + rb
            return dc_result
        case EDefaultOp(l, r):
            return f"({format_expr(*l)} ?? {format_expr(*r)})"
        case EIs(expr, negated, pat):
            String es = format_expr(*expr)
            String ps = format_pattern(*pat)
            if negated:
                return f"({es} is not {ps})"
            return f"({es} is {ps})"
        case EDo(body):
            return f"do:{format_block(body)}"
        case EAwait(inner):
            return f"{format_expr(*inner)}.await()"
        case ESpawn(inner):
            return f"spawn {format_expr(*inner)}"
        case ESpawnBlocking(inner):
            return f"spawn blocking {format_expr(*inner)}"
        case ERethrow(expr, err_name, err_type, transform):
            String rhs = format_expr(*expr)
            if err_name is Some(name):
                SpannedType et = *err_type.unwrap()
                rhs = rhs + f" rethrow ({format_type(et)} {name}): "
            else:
                rhs = rhs + " rethrow "
            rhs = rhs + format_expr(*transform)
            return rhs
        case ECatch(expr, name, recovery):
            return f"{format_expr(*expr)} catch ({name}): {format_expr(*recovery)}"
        case EFaultCatch(fc_expr, fc_pattern, fc_handler):
            # Mirrors Rust gg's `format_expr_canonical` FaultCatch arm:
            # `{inner} catch Fault.{variant}: {handler}` (variant form) /
            # `{inner} catch {name}: {handler}` (binding form).
            String fc_pat = ""
            match fc_pattern:
                case FcpVariant(fc_qual, fc_var):
                    fc_pat = fc_qual + "." + fc_var
                case FcpBinding(fc_name):
                    fc_pat = fc_name
            return f"{format_expr(*fc_expr)} catch {fc_pat}: {format_expr(*fc_handler)}"
        else:
            return "?"

# ── Statement formatting ─────────────────────────────────────

String format_stmt(Stmt s):
    match s:
        case SVarDecl(ty, name, init, own, sk, name_span):
            return f"{format_type(ty)} {name} = {format_expr(init)}"
        case SAssign(lhs, rhs):
            return f"{format_expr(lhs)} = {format_expr(rhs)}"
        case SCompoundAssign(lhs, op, rhs):
            return f"{format_expr(lhs)} {op} {format_expr(rhs)}"
        case SExpr(expr):
            return format_expr(expr)
        case SReturn(val):
            if val is Some(v):
                return f"return {format_expr(v)}"
            return "return"
        case SThrow(val):
            return f"throw {format_expr(val)}"
        case SBreak():
            return "break"
        case SContinue:
            return "continue"
        case SPass:
            return "pass"
        case SMeta:
            return "meta"
        case SMetaConst(mc_name, mc_val):
            return "meta"
        case SMetaFor(mf_vars, mf_iter, body):
            return "meta"
        case SMetaForMatch(_, _, _):
            return "meta"
        case SMetaIf(meta_cond, then_body, branches):
            return "meta"
        case SMetaMatch(_, _, _):
            return "meta"
        case SMetaWhile(_, _):
            return "meta"
        case SFor(pat, iter, body, own, _):
            return f"for {format_pattern(pat)} in {format_expr(iter)}:{format_block(body)}"
        case SWhile(cond, body, _):
            return f"while {format_expr(cond)}:{format_block(body)}"
        case SLoop(body):
            return f"loop:{format_block(body)}"
        case SIf(cond, body, branches):
            String result = f"if {format_expr(cond)}:{format_block(body)}"
            for br in branches:
                match br.condition:
                    case Some(c):
                        result = result + f" elif {format_expr(c)}:"
                    else:
                        result = result + " else:"
                result = result + format_block(br.body)
            return result
        case SMatch(subject, arms):
            String result = f"match {format_expr(subject)}:"
            for arm in arms:
                result = result + f" case {format_pattern(arm.pattern)}:" + format_block(arm.body)
            return result
        case SWith(resource, name, body):
            return f"with {format_expr(resource)} as {name}:{format_block(body)}"
        case SNamedScope(label, body):
            return f"{label}:{format_block(body)}"
        case SSelect(arms):
            String result = "select:"
            for arm in arms:
                match arm.op:
                    case SORecv(name, _, channel):
                        result = result + f" case {name} = {format_expr(channel)}.recv():"
                    case SOSend(channel, value):
                        result = result + f" case {format_expr(channel)}.send({format_expr(value)}):"
                result = result + format_block(arm.body)
            return result
        case SOnError(body):
            return f"on error:{format_block(body)}"
        case SAssert(cond, msg):
            String result = f"assert {format_expr(cond)}"
            match msg:
                case Some(m):
                    result = result + f", \"{m}\""
                else:
                    pass
            return result
        case SAssertReturn(cond, msg):
            String result = f"assert return {format_expr(cond)}"
            match msg:
                case Some(m):
                    result = result + f", \"{m}\""
                else:
                    pass
            return result
        case SItem(item):
            return format_item(item)
        case SSnapshot(name, _, value):
            return f"snapshot \"{name}\" {format_expr(value)}"
        else:
            return "?"

String format_block(Vector[Stmt] stmts):
    if stmts.len() == 0:
        return " pass"
    String result = ""
    for s in stmts:
        result = result + " " + format_stmt(s) + ";"
    return result

# ── Item formatting ──────────────────────────────────────────

String format_item(Item item):
    match item:
        case IFunction(fd):
            return format_function(fd)
        case IStruct(sd):
            return format_struct(sd)
        case IEnum(ed):
            return format_enum(ed)
        case ITrait(td):
            return format_trait(td)
        case IEquip(eq):
            return format_equip(eq)
        case IImport(imp):
            return format_import(imp)
        case IDirective(name, value):
            if value == "":
                return f"directive {name}"
            return f"directive {name} {value}"
        case ITypeAlias(name, tps, ty):
            String result = f"type {name}"
            if tps.len() > 0:
                result = result + "["
                for (i, tp) in tps.enumerate():
                    if i > 0:
                        result = result + ", "
                    result = result + tp
                result = result + "]"
            result = result + f" = {format_type(ty)}"
            return result
        case INewtype(name, inner):
            return f"newtype {name}({format_type(inner)})"
        case IConstDecl(ty, name, val):
            return f"const {format_type(ty)} {name} = {format_expr(val)}"
        case IMetaConst(ty, name, val):
            return f"meta {format_type(ty)} {name} = {format_expr(val)}"
        case IMetaType(name, rhs):
            return f"meta type {name} = <rhs>"
        case IMetaTypeFunc(name):
            return f"meta type {name}(...)"
        case IMetaAssert():
            return "meta assert ..."
        case IMetaIf():
            return "meta if ..."
        case IMetaLog():
            return "meta log ..."
        case IStaticDecl(ty, name, val):
            return f"static {format_type(ty)} {name} = {format_expr(val)}"
        case IExternBlock(fns):
            String result = "extern:"
            for f in fns:
                result = result + f" {format_function(f)};"
            return result
        case ITest(name, _, _, body):
            return f"test \"{name}\":{format_block(body)}"
        case IBench(name, body):
            return f"bench \"{name}\":{format_block(body)}"
        case ISuiteSetup(body):
            return f"suite_setup:{format_block(body)}"
        case ISuiteTeardown(body):
            return f"suite_teardown:{format_block(body)}"
        else:
            return "?"

String format_function(FunctionDef fd):
    String result = f"{format_type(fd.return_type)} {fd.name}"
    if fd.type_params.len() > 0:
        result = result + "["
        for (i, tp) in fd.type_params.enumerate():
            if i > 0:
                result = result + ", "
            result = result + tp
        result = result + "]"
    result = result + "("
    for (i, p) in fd.params.enumerate():
        if i > 0:
            result = result + ", "
        if p.param_name == "self":
            if p.ownership == 1:
                result = result + "&self"
            elif p.ownership == 2:
                result = result + "!self"
            else:
                result = result + "self"
        else:
            result = result + f"{format_type(p.param_type)} {p.param_name}"
    result = result + ")"
    if fd.is_expr_body:
        if fd.body.len() > 0:
            Stmt first = fd.body.get(0).unwrap()
            match first:
                case SReturn(val):
                    match val:
                        case Some(v):
                            result = result + f" = {format_expr(v)}"
                        else:
                            pass
                else:
                    pass
    else:
        result = result + f":{format_block(fd.body)}"
    return result

String format_struct(StructDef sd):
    String result = f"struct {sd.name}"
    if sd.type_params.len() > 0:
        result = result + "["
        for (i, tp) in sd.type_params.enumerate():
            if i > 0:
                result = result + ", "
            result = result + tp
        result = result + "]"
    result = result + ":"
    for f in sd.fields:
        result = result + f" {format_type(f.param_type)} {f.param_name};"
    return result

String format_enum(EnumDef ed):
    String result = f"enum {ed.name}"
    if ed.type_params.len() > 0:
        result = result + "["
        for (i, tp) in ed.type_params.enumerate():
            if i > 0:
                result = result + ", "
            result = result + tp
        result = result + "]"
    result = result + ":"
    for v in ed.variants:
        result = result + f" {v.name}"
        if v.fields.len() > 0:
            result = result + "("
            for (j, ft) in v.fields.enumerate():
                if j > 0:
                    result = result + ", "
                result = result + format_type(ft)
            result = result + ")"
        result = result + ";"
    return result

String format_trait(TraitDef td):
    String result = f"trait {td.name}"
    if td.type_params.len() > 0:
        result = result + "["
        for (i, tp) in td.type_params.enumerate():
            if i > 0:
                result = result + ", "
            result = result + tp
        result = result + "]"
    if td.parent_traits.len() > 0:
        result = result + " extends "
        for (i, e) in td.parent_traits.enumerate():
            if i > 0:
                result = result + ", "
            result = result + e
    result = result + ":"
    for m in td.methods:
        result = result + f" {format_function(m)};"
    return result

String format_equip(EquipBlock eq):
    String result = f"equip {format_type(eq.target)}"
    match eq.trait_name:
        case Some(tn):
            result = result + f" via {tn}"
        else:
            pass
    result = result + ":"
    for m in eq.methods:
        result = result + f" {format_function(m)};"
    return result

String format_import(ImportStmt imp):
    if imp.names.len() > 0:
        String result = f"from {imp.module_path} import "
        for (i, n) in imp.names.enumerate():
            if i > 0:
                result = result + ", "
            result = result + n
            # Render `as <alias>` for an aliased name (parallel `aliases`
            # vector; "" = bare). Round-trip fidelity so the bootstrap's
            # format→re-parse cycle preserves `from X import Y as Z`.
            if i < imp.aliases.len():
                String alias = imp.aliases.get(i).unwrap()
                if alias != "":
                    result = result + " as " + alias
        return result
    return f"import {imp.module_path}"
