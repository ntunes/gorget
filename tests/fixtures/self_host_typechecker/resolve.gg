# Two-pass name resolution for the self-hosting Gorget compiler.
# Pass 1: collect_top_level — register all top-level definitions.
# Pass 2: resolve_bodies — resolve name uses inside function/method bodies.

from std.collections import Vector, Dict
from ast import Span, Module, Item, Stmt, Expr, Type, Pattern
from ast import SpannedExpr, SpannedType, SpannedPattern
from ast import FunctionDef, StructDef, EnumDef, EnumVariant, TraitDef, EquipBlock
from ast import MatchArm, ElseBranch, Param, ImportStmt
from ids import NO_DEF, NO_TYPE, NO_SCOPE
from scope import ScopeTable, DefKind, DefInfo, ScopeKind, Scope
from scope import DkFunction, DkStruct, DkEnum, DkVariant, DkTrait
from scope import DkTypeAlias, DkNewtype, DkVariable, DkConst, DkStatic
from scope import DkGenericParam, DkImport
from scope import SkModule, SkFunction, SkBlock, SkEquipBlock, SkTraitDef, SkForLoop
from scope import get_def_at
from types import TypeTable, ast_type_to_resolved, ResolvedType, get_stype_at
from diagnostic import Diagnostic

# ── Function-body scope register ────────────────────────────
# The Dict gives O(1) lookup of the canonical (last-registered) body
# scope for a name. The parallel Vectors preserve every registration so
# `find_body_scope` can disambiguate by parent chain when a name is
# shared (top-level fn `chain` vs `equip [T] VectorIter[T] with Iterable:
# T chain(...)`). Mirrors Rust gg's similar dual structure.

void fn_scope_set(ResolveContext &ctx, String name, int scope_id):
    ctx.function_body_scopes.put(name, scope_id)
    ctx.fn_scope_names.push(name)
    ctx.fn_scope_ids.push(scope_id)

# ── Resolve context ─────────────────────────────────────────

struct ResolveContext:
    Dict[int, int] resolution_map
    Dict[String, int] function_body_scopes
    Vector[String] fn_scope_names
    Vector[int] fn_scope_ids
    # Typed diagnostic stream — populated by the typechecker pass
    # (this driver dir's typecheck.gg / infer.gg). Replaces the prior
    # silent-failure pattern where type mismatches just propagated
    # `types.error_id`. Drained to stderr by the comparison driver so
    # stdout stays byte-stable for type_comparison.
    Vector[Diagnostic] diagnostics
    # Control-flow context tracked across `type_check_stmt` walks.
    # Mirrors Rust typecheck.rs's `loop_depth` / `current_function_throws`
    # / `current_function_present` — needed to detect break/continue
    # outside a loop, throw in a non-throwing function, and return at
    # module scope. Saved/restored around closure-body walks (closures
    # have their own throws/loop context).
    int loop_depth
    bool current_function_throws
    bool in_function_body

# ── Built-in check ──────────────────────────────────────────

bool is_builtin(String name):
    if name == "print":
        return true
    if name == "format":
        return true
    if name == "len":
        return true
    if name == "type":
        return true
    if name == "int":
        return true
    if name == "int8":
        return true
    if name == "int16":
        return true
    if name == "int32":
        return true
    if name == "int64":
        return true
    if name == "uint":
        return true
    if name == "uint8":
        return true
    if name == "uint16":
        return true
    if name == "uint32":
        return true
    if name == "uint64":
        return true
    if name == "float":
        return true
    if name == "float32":
        return true
    if name == "float64":
        return true
    if name == "bool":
        return true
    if name == "char":
        return true
    if name == "str" or name == "String":
        return true
    return false

# ═══════════════════════════════════════════════════════════
# Pass 1: collect_top_level
# ═══════════════════════════════════════════════════════════

ResolveContext collect_top_level(Module module, ScopeTable &scopes, TypeTable &types):
    ResolveContext ctx = ResolveContext(Dict[int, int](), Dict[String, int](), Vector[String](), Vector[int](), Vector[Diagnostic](), 0, false, false)

    # Register built-in core traits
    Vector[String] trait_names = Vector[String]()
    trait_names.push("Displayable")
    trait_names.push("Debuggable")
    trait_names.push("Equatable")
    trait_names.push("Cloneable")
    trait_names.push("Hashable")
    trait_names.push("Hasher")
    trait_names.push("Drop")
    trait_names.push("Iterator")
    trait_names.push("Iterable")
    trait_names.push("Add")
    trait_names.push("Sub")
    trait_names.push("Mul")
    trait_names.push("Div")
    trait_names.push("Rem")
    trait_names.push("Mod")
    trait_names.push("Neg")
    trait_names.push("Comparable")
    trait_names.push("Index")
    trait_names.push("IndexMut")
    trait_names.push("Default")
    trait_names.push("From")
    trait_names.push("TryFrom")
    trait_names.push("Measurable")
    trait_names.push("Parseable")
    trait_names.push("One")
    trait_names.push("Numeric")
    for tname in trait_names:
        scopes.define(tname, DkTrait(), Span(0, 0))

    # Register String constructor as built-in function
    scopes.define("String", DkFunction(), Span(0, 0))

    # Register built-in collection types as Import placeholders
    Vector[String] col_names = Vector[String]()
    col_names.push("Vector")
    col_names.push("Dict")
    col_names.push("HashMap")
    col_names.push("Set")
    col_names.push("HashSet")
    col_names.push("Box")
    col_names.push("Future")
    col_names.push("Task")
    col_names.push("Channel")
    col_names.push("Shared")
    col_names.push("Weak")
    col_names.push("Mutex")
    col_names.push("Guard")
    col_names.push("TaskGroup")
    col_names.push("FxHasher")
    for cname in col_names:
        scopes.define(cname, DkImport(), Span(0, 0))

    # Register Option[T] and Result[T,E] enum types with variants
    if scopes.define("Option", DkEnum(), Span(0, 0)) is Some(_):
        scopes.define("Some", DkVariant(), Span(0, 0))
        scopes.define("None", DkVariant(), Span(0, 0))

    if scopes.define("Result", DkEnum(), Span(0, 0)) is Some(_):
        scopes.define("Ok", DkVariant(), Span(0, 0))
        scopes.define("Error", DkVariant(), Span(0, 0))

    # Collect all top-level items
    for item in module.items:
        collect_item(item, &scopes, &types)

    return ctx


void collect_item(Item item, ScopeTable &scopes, TypeTable &types):
    match item:
        case IFunction(f):
            scopes.define(f.name, DkFunction(), Span(0, 0))

        case IStruct(s):
            scopes.define(s.name, DkStruct(), Span(0, 0))

        case IEnum(e):
            scopes.define(e.name, DkEnum(), Span(0, 0))
            bool is_generic = e.type_params.len() > 0
            for v in e.variants:
                if is_generic:
                    # Generic enum: keep variant in scope (bare name works)
                    scopes.define(v.name, DkVariant(), Span(0, 0))
                else:
                    # Non-generic enum: allocate without scope insertion
                    scopes.alloc_def(v.name, DkVariant(), Span(0, 0))

        case ITrait(t):
            scopes.define(t.name, DkTrait(), Span(0, 0))

        case IEquip(eq):
            scopes.push_scope(SkEquipBlock())
            for m in eq.methods:
                scopes.define(m.name, DkFunction(), Span(0, 0))
            scopes.pop_scope()

        case IImport(imp):
            collect_import(imp, &scopes)

        case IDirective(_, _):
            pass

        case ITypeAlias(name, _, _):
            scopes.define(name, DkTypeAlias(), Span(0, 0))

        case INewtype(name, _):
            scopes.define(name, DkNewtype(), Span(0, 0))

        case IConstDecl(_, name, _):
            scopes.define(name, DkConst(), Span(0, 0))

        case IMetaConst(_, _, _):
            pass
        case IMetaType(_, _):
            pass
        case IMetaTypeFunc(_):
            pass
        case IMetaAssert():
            pass
        case IMetaIf():
            pass
        case IMetaLog():
            pass

        case IStaticDecl(_, name, _):
            scopes.define(name, DkStatic(), Span(0, 0))

        case IExternBlock(fns):
            for f in fns:
                scopes.define(f.name, DkFunction(), Span(0, 0))

        case ITest(_, _, _, _):
            pass

        case IBench(_, _):
            pass

        case ISuiteSetup(_):
            pass

        case ISuiteTeardown(_):
            pass


void collect_import(ImportStmt imp, ScopeTable &scopes):
    if imp.names.len() == 0:
        # Simple import (e.g. `import xtd.json`) — register last path segment
        String path = imp.module_path
        int dot_pos = -1
        int pi = 0
        while pi < path.byte_len():
            if path.byte_slice(pi, pi + 1) == ".":
                dot_pos = pi
            pi = pi + 1
        if dot_pos >= 0:
            String last = path.byte_slice(dot_pos + 1, path.byte_len())
            scopes.define(last, DkImport(), Span(0, 0))
        else:
            scopes.define(path, DkImport(), Span(0, 0))
        return
    for name in imp.names:
        scopes.define(name, DkImport(), Span(0, 0))

# ═══════════════════════════════════════════════════════════
# Pass 2: resolve_bodies
# ═══════════════════════════════════════════════════════════

void resolve_bodies(Module module, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    for item in module.items:
        resolve_item_body(item, &scopes, &types, &ctx)


void resolve_item_body(Item item, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match item:
        case IFunction(f):
            resolve_function(f, &scopes, &types, &ctx)

        case IEquip(eq):
            resolve_equip_block(eq, &scopes, &types, &ctx)

        case IConstDecl(_, _, val):
            resolve_expr(val, &scopes, &ctx)

        case IMetaConst(_, _, _):
            pass
        case IMetaType(_, _):
            pass
        case IMetaTypeFunc(_):
            pass
        case IMetaAssert():
            pass
        case IMetaIf():
            pass
        case IMetaLog():
            pass

        case IStaticDecl(_, _, val):
            resolve_expr(val, &scopes, &ctx)

        case IExternBlock(fns):
            for f in fns:
                resolve_extern_fn_generics(f, &scopes, &ctx)

        case ITest(_, with_exprs, with_names, body):
            scopes.push_scope(SkFunction())
            for (wi, wexpr) in with_exprs.enumerate():
                resolve_expr(wexpr, &scopes, &ctx)
                String wname = with_names.get(wi).unwrap()
                if wname != "_":
                    scopes.define(wname, DkVariable(), Span(0, 0))
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case IBench(_, body):
            scopes.push_scope(SkFunction())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case ISuiteSetup(body):
            scopes.push_scope(SkFunction())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case ISuiteTeardown(body):
            scopes.push_scope(SkFunction())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        else:
            pass


# Creates a body scope for an extern function and defines its generic type params
# so `register_function_signature` can resolve them via `ast_type_to_resolved`.
# Does NOT define param variable defs — Rust doesn't emit TYPE lines for extern
# params, so we must not either (keeps exact-match count high).
void resolve_extern_fn_generics(FunctionDef f, ScopeTable &scopes, ResolveContext &ctx):
    if f.type_params.len() == 0:
        return
    int body_scope = scopes.push_scope(SkFunction())
    fn_scope_set(&ctx, f.name, body_scope)
    for gp in f.type_params:
        scopes.define(gp, DkGenericParam(), Span(0, 0))
    scopes.pop_scope()


void resolve_function(FunctionDef f, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    int body_scope = scopes.push_scope(SkFunction())

    # Record body scope for this function
    fn_scope_set(&ctx, f.name, body_scope)

    # Define generic type params
    for gp in f.type_params:
        scopes.define(gp, DkGenericParam(), Span(0, 0))

    # Define parameters (always mutable — can reassign params in body)
    for p in f.params:
        if scopes.define_with_mutability(p.param_name, DkVariable(), Span(0, 0), true) is Some(def_id):
            scopes.set_def_param(def_id, true)

    # Resolve body
    resolve_block(f.body, &scopes, &types, &ctx)

    scopes.pop_scope()


void resolve_equip_block(EquipBlock eq, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    scopes.push_scope(SkEquipBlock())

    # Define equip generic params
    for gp in eq.type_params:
        scopes.define(gp, DkGenericParam(), Span(0, 0))

    # Resolve each method
    for m in eq.methods:
        resolve_function(m, &scopes, &types, &ctx)

    scopes.pop_scope()


void resolve_block(Vector[Stmt] stmts, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    for stmt in stmts:
        resolve_stmt(stmt, &scopes, &types, &ctx)


void resolve_stmt(Stmt stmt, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match stmt:
        case SVarDecl(var_type, name, value, ownership, sk, name_span):
            resolve_expr(value, &scopes, &ctx)
            int def_id = -1
            # Tuple destructuring: "(a, b, c)" — define each binding individually
            if name.starts_with("(") and name.ends_with(")"):
                String inner = name.substring(1, name.len() - 1)
                Vector[String] parts = inner.split(", ")
                for part in parts:
                    if part != "_":
                        def_id = scopes.define(part, DkVariable(), Span(0, 0)).unwrap_or(-1)
            else:
                def_id = scopes.define(name, DkVariable(), Span(0, 0)).unwrap_or(-1)
            # Emit RES entry for bindings that captured their name span
            # (shared vars and select recv vars)
            if def_id >= 0 and name_span >= 0:
                ctx.resolution_map.put(name_span, def_id)

        case SExpr(expr):
            resolve_expr(expr, &scopes, &ctx)

        case SAssign(target, value):
            resolve_expr(target, &scopes, &ctx)
            resolve_expr(value, &scopes, &ctx)

        case SCompoundAssign(target, _, value):
            resolve_expr(target, &scopes, &ctx)
            resolve_expr(value, &scopes, &ctx)

        case SReturn(opt_expr):
            if opt_expr is Some(sexpr):
                resolve_expr(sexpr, &scopes, &ctx)

        case SThrow(expr):
            resolve_expr(expr, &scopes, &ctx)

        case SBreak(opt_expr):
            if opt_expr is Some(sexpr):
                resolve_expr(sexpr, &scopes, &ctx)

        case SContinue():
            pass

        case SPass():
            pass

        case SFor(pattern, iterable, body, _, else_body):
            resolve_expr(iterable, &scopes, &ctx)
            scopes.push_scope(SkForLoop())
            define_pattern_bindings(pattern, &scopes)
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()
            if else_body.len() > 0:
                scopes.push_scope(SkBlock())
                resolve_block(else_body, &scopes, &types, &ctx)
                scopes.pop_scope()

        case SWhile(condition, body):
            scopes.push_scope(SkBlock())
            if has_is_patterns(condition.expr):
                resolve_is_condition(condition, &scopes, &ctx)
            else:
                resolve_expr(condition, &scopes, &ctx)
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SLoop(body):
            scopes.push_scope(SkForLoop())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SIf(condition, then_body, elif_branches):
            scopes.push_scope(SkBlock())
            if has_is_patterns(condition.expr):
                resolve_is_condition(condition, &scopes, &ctx)
            else:
                resolve_expr(condition, &scopes, &ctx)
            resolve_block(then_body, &scopes, &types, &ctx)
            scopes.pop_scope()

            for branch in elif_branches:
                scopes.push_scope(SkBlock())
                if branch.condition is Some(cond):
                    if has_is_patterns(cond.expr):
                        resolve_is_condition(cond, &scopes, &ctx)
                    else:
                        resolve_expr(cond, &scopes, &ctx)
                resolve_block(branch.body, &scopes, &types, &ctx)
                scopes.pop_scope()

        case SMatch(scrutinee, arms):
            resolve_expr(scrutinee, &scopes, &ctx)
            for arm in arms:
                scopes.push_scope(SkBlock())
                define_pattern_bindings(arm.pattern, &scopes)
                if arm.guard is Some(g):
                    resolve_expr(g, &scopes, &ctx)
                resolve_block(arm.body, &scopes, &types, &ctx)
                scopes.pop_scope()

        case SWith(expr, name, body):
            scopes.push_scope(SkBlock())
            resolve_expr(expr, &scopes, &ctx)
            scopes.define(name, DkVariable(), Span(0, 0))
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SNamedScope(_, body):
            scopes.push_scope(SkBlock())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SSelect(arms):
            for arm in arms:
                scopes.push_scope(SkBlock())
                match arm.op:
                    case SORecv(name, name_span, channel):
                        resolve_expr(channel, &scopes, &ctx)
                        if scopes.define(name, DkVariable(), Span(0, 0)) is Some(def_id):
                            if name_span >= 0:
                                ctx.resolution_map.put(name_span, def_id)
                    case SOSend(channel, value):
                        resolve_expr(channel, &scopes, &ctx)
                        resolve_expr(value, &scopes, &ctx)
                resolve_block(arm.body, &scopes, &types, &ctx)
                scopes.pop_scope()

        case SOnError(body):
            scopes.push_scope(SkBlock())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SAssert(condition, _):
            resolve_expr(condition, &scopes, &ctx)

        case SAssertReturn(condition, _):
            resolve_expr(condition, &scopes, &ctx)

        case SSnapshot(_, _, value):
            resolve_expr(value, &scopes, &ctx)

        case SMeta():
            pass

        case SMetaFor(body):
            scopes.push_scope(SkBlock())
            resolve_block(body, &scopes, &types, &ctx)
            scopes.pop_scope()

        case SMetaForMatch(_, _, _):
            # Meta expansion runs before resolve (driver.gg ordering).
            # If we still see this here, the expansion didn't happen
            # for some reason — leave it alone, no further work to do.
            pass

        case SMetaIf(then_body, elif_branches):
            scopes.push_scope(SkBlock())
            resolve_block(then_body, &scopes, &types, &ctx)
            scopes.pop_scope()
            for branch in elif_branches:
                scopes.push_scope(SkBlock())
                resolve_block(branch.body, &scopes, &types, &ctx)
                scopes.pop_scope()

        case SItem(item):
            collect_item(item, &scopes, &types)
            resolve_item_body(item, &scopes, &types, &ctx)


# ── Expression resolution ───────────────────────────────────

void resolve_expr(SpannedExpr expr, ScopeTable &scopes, ResolveContext &ctx):
    match expr.expr:
        case EIntLiteral(_):
            pass
        case EFloatLiteral(_):
            pass
        case EBoolLiteral(_):
            pass
        case ECharLiteral(_):
            pass
        case ENoneLiteral():
            pass
        case ESelfExpr():
            pass
        case EStringLiteral(_, _):
            pass

        case EIdentifier(name):
            if scopes.lookup(name) is Some(def_id):
                ctx.resolution_map.put(expr.span.start, def_id)
            elif not is_builtin(name):
                pass

        case EBinaryOp(left, op, right):
            resolve_expr(*left, &scopes, &ctx)
            resolve_expr(*right, &scopes, &ctx)

        case EUnaryOp(_, operand):
            resolve_expr(*operand, &scopes, &ctx)

        case ECall(callee, args, _):
            resolve_expr(*callee, &scopes, &ctx)
            for arg in args:
                resolve_expr(arg, &scopes, &ctx)

        case EMethodCall(receiver, _, args, _):
            resolve_expr(*receiver, &scopes, &ctx)
            for arg in args:
                resolve_expr(arg, &scopes, &ctx)

        case EFieldAccess(object, _):
            resolve_expr(*object, &scopes, &ctx)

        case EIndex(object, index):
            resolve_expr(*object, &scopes, &ctx)
            resolve_expr(*index, &scopes, &ctx)

        case ERange(opt_start, opt_end):
            if opt_start is Some(b):
                resolve_expr(*b, &scopes, &ctx)
            if opt_end is Some(b):
                resolve_expr(*b, &scopes, &ctx)

        case EDefaultOp(lhs, rhs):
            resolve_expr(*lhs, &scopes, &ctx)
            resolve_expr(*rhs, &scopes, &ctx)

        case ETry(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case EMove(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case EMutableBorrow(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case EDeref(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case EAs(inner, _):
            resolve_expr(*inner, &scopes, &ctx)

        case EIs(inner, _, _):
            resolve_expr(*inner, &scopes, &ctx)

        case EIf(condition, then_body, elif_branches):
            resolve_expr(*condition, &scopes, &ctx)
            resolve_block_expr(then_body, &scopes, &ctx)
            for branch in elif_branches:
                if branch.condition is Some(cond):
                    resolve_expr(cond, &scopes, &ctx)
                resolve_block_expr(branch.body, &scopes, &ctx)

        case EMatch(scrutinee, arms):
            resolve_expr(*scrutinee, &scopes, &ctx)
            for arm in arms:
                scopes.push_scope(SkBlock())
                define_pattern_bindings(arm.pattern, &scopes)
                if arm.guard is Some(g):
                    resolve_expr(g, &scopes, &ctx)
                resolve_block_expr(arm.body, &scopes, &ctx)
                scopes.pop_scope()

        case EBlock(stmts):
            scopes.push_scope(SkBlock())
            resolve_block_expr(stmts, &scopes, &ctx)
            scopes.pop_scope()

        case EDo(stmts):
            scopes.push_scope(SkBlock())
            resolve_block_expr(stmts, &scopes, &ctx)
            scopes.pop_scope()

        case EAwait(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case ESpawn(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case ESpawnBlocking(inner):
            resolve_expr(*inner, &scopes, &ctx)

        case ERethrow(expr, eopt, _, transform):
            resolve_expr(*expr, &scopes, &ctx)
            if eopt is Some(ename):
                scopes.push_scope(SkBlock())
                scopes.define(ename, DkVariable(), Span(0, 0))
                resolve_expr(*transform, &scopes, &ctx)
                scopes.pop_scope()
            else:
                resolve_expr(*transform, &scopes, &ctx)

        case ECatch(expr, ename, recovery):
            resolve_expr(*expr, &scopes, &ctx)
            scopes.push_scope(SkBlock())
            scopes.define(ename, DkVariable(), Span(0, 0))
            resolve_expr(*recovery, &scopes, &ctx)
            scopes.pop_scope()

        case EClosure(params, body):
            scopes.push_scope(SkFunction())
            for p in params:
                scopes.define(p.param_name, DkVariable(), Span(0, 0))
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case EIt():
            pass

        case EImplicitClosure(inner):
            scopes.push_scope(SkFunction())
            scopes.define("it", DkVariable(), Span(0, 0))
            resolve_expr(*inner, &scopes, &ctx)
            scopes.pop_scope()

        case EListComp(comp_expr, var_name, iterable, opt_cond):
            resolve_expr(*iterable, &scopes, &ctx)
            scopes.push_scope(SkForLoop())
            scopes.define(var_name, DkVariable(), Span(0, 0))
            resolve_expr(*comp_expr, &scopes, &ctx)
            if opt_cond is Some(b):
                resolve_expr(*b, &scopes, &ctx)
            scopes.pop_scope()

        case ESetComp(comp_expr, var_name, iterable, cond):
            resolve_expr(*iterable, &scopes, &ctx)
            scopes.push_scope(SkForLoop())
            scopes.define(var_name, DkVariable(), Span(0, 0))
            resolve_expr(*comp_expr, &scopes, &ctx)
            resolve_expr(*cond, &scopes, &ctx)
            scopes.pop_scope()

        case EDictComp(key, value, var_name, iterable):
            resolve_expr(*iterable, &scopes, &ctx)
            scopes.push_scope(SkForLoop())
            scopes.define(var_name, DkVariable(), Span(0, 0))
            resolve_expr(*key, &scopes, &ctx)
            resolve_expr(*value, &scopes, &ctx)
            scopes.pop_scope()

        case EArrayLiteral(elements):
            for elem in elements:
                resolve_expr(elem, &scopes, &ctx)

        case ETupleLiteral(elements):
            for elem in elements:
                resolve_expr(elem, &scopes, &ctx)

        case EDictLiteral(keys, values):
            for (di, k) in keys.enumerate():
                resolve_expr(k, &scopes, &ctx)
                SpannedExpr v = values.get(di).unwrap()
                resolve_expr(v, &scopes, &ctx)

        case EStructLiteral(name, _, args):
            if scopes.lookup(name) is Some(def_id):
                ctx.resolution_map.put(expr.span.start, def_id)
            for arg in args:
                resolve_expr(arg, &scopes, &ctx)

        case EDotShorthand(_, args):
            for arg in args:
                resolve_expr(arg, &scopes, &ctx)

        case EFString(_, exprs):
            # Walk pre-parsed interpolation segments so identifiers /
            # closures inside `{...}` get resolved.
            for fe in exprs:
                resolve_expr(fe, &scopes, &ctx)


# ── Block expr resolution (no TypeTable needed) ────────────

void resolve_block_expr(Vector[Stmt] stmts, ScopeTable &scopes, ResolveContext &ctx):
    for stmt in stmts:
        resolve_stmt_expr(stmt, &scopes, &ctx)


void resolve_stmt_expr(Stmt stmt, ScopeTable &scopes, ResolveContext &ctx):
    match stmt:
        case SVarDecl(var_type, name, value, ownership, sk, name_span):
            resolve_expr(value, &scopes, &ctx)
            int def_id = -1
            if name.starts_with("(") and name.ends_with(")"):
                String inner = name.substring(1, name.len() - 1)
                Vector[String] parts = inner.split(", ")
                for part in parts:
                    if part != "_":
                        def_id = scopes.define(part, DkVariable(), Span(0, 0)).unwrap_or(-1)
            else:
                def_id = scopes.define(name, DkVariable(), Span(0, 0)).unwrap_or(-1)
            if sk > 0 and def_id >= 0 and name_span >= 0:
                ctx.resolution_map.put(name_span, def_id)

        case SExpr(expr):
            resolve_expr(expr, &scopes, &ctx)

        case SAssign(target, value):
            resolve_expr(target, &scopes, &ctx)
            resolve_expr(value, &scopes, &ctx)

        case SCompoundAssign(target, _, value):
            resolve_expr(target, &scopes, &ctx)
            resolve_expr(value, &scopes, &ctx)

        case SReturn(opt_expr):
            if opt_expr is Some(sexpr):
                resolve_expr(sexpr, &scopes, &ctx)

        case SThrow(expr):
            resolve_expr(expr, &scopes, &ctx)

        case SBreak(opt_expr):
            if opt_expr is Some(sexpr):
                resolve_expr(sexpr, &scopes, &ctx)

        case SContinue():
            pass

        case SPass():
            pass

        case SFor(pattern, iterable, body, _, else_body):
            resolve_expr(iterable, &scopes, &ctx)
            scopes.push_scope(SkForLoop())
            define_pattern_bindings(pattern, &scopes)
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()
            if else_body.len() > 0:
                scopes.push_scope(SkBlock())
                resolve_block_expr(else_body, &scopes, &ctx)
                scopes.pop_scope()

        case SWhile(condition, body):
            scopes.push_scope(SkBlock())
            resolve_expr(condition, &scopes, &ctx)
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SLoop(body):
            scopes.push_scope(SkForLoop())
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SIf(condition, then_body, elif_branches):
            scopes.push_scope(SkBlock())
            resolve_expr(condition, &scopes, &ctx)
            resolve_block_expr(then_body, &scopes, &ctx)
            scopes.pop_scope()
            for branch in elif_branches:
                scopes.push_scope(SkBlock())
                if branch.condition is Some(cond):
                    resolve_expr(cond, &scopes, &ctx)
                resolve_block_expr(branch.body, &scopes, &ctx)
                scopes.pop_scope()

        case SMatch(scrutinee, arms):
            resolve_expr(scrutinee, &scopes, &ctx)
            for arm in arms:
                scopes.push_scope(SkBlock())
                define_pattern_bindings(arm.pattern, &scopes)
                if arm.guard is Some(g):
                    resolve_expr(g, &scopes, &ctx)
                resolve_block_expr(arm.body, &scopes, &ctx)
                scopes.pop_scope()

        case SWith(expr, name, body):
            scopes.push_scope(SkBlock())
            resolve_expr(expr, &scopes, &ctx)
            scopes.define(name, DkVariable(), Span(0, 0))
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SNamedScope(_, body):
            scopes.push_scope(SkBlock())
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SSelect(arms):
            for arm in arms:
                scopes.push_scope(SkBlock())
                match arm.op:
                    case SORecv(name, name_span, channel):
                        resolve_expr(channel, &scopes, &ctx)
                        if scopes.define(name, DkVariable(), Span(0, 0)) is Some(def_id):
                            if name_span >= 0:
                                ctx.resolution_map.put(name_span, def_id)
                    case SOSend(channel, value):
                        resolve_expr(channel, &scopes, &ctx)
                        resolve_expr(value, &scopes, &ctx)
                resolve_block_expr(arm.body, &scopes, &ctx)
                scopes.pop_scope()

        case SOnError(body):
            scopes.push_scope(SkBlock())
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SAssert(condition, _):
            resolve_expr(condition, &scopes, &ctx)

        case SMetaFor(body):
            scopes.push_scope(SkBlock())
            resolve_block_expr(body, &scopes, &ctx)
            scopes.pop_scope()

        case SMetaForMatch(_, _, _):
            # Meta expansion runs before resolve.
            pass

        case SMetaIf(then_body, elif_branches):
            scopes.push_scope(SkBlock())
            resolve_block_expr(then_body, &scopes, &ctx)
            scopes.pop_scope()
            for branch in elif_branches:
                scopes.push_scope(SkBlock())
                resolve_block_expr(branch.body, &scopes, &ctx)
                scopes.pop_scope()

        else:
            pass


# ── Pattern bindings ────────────────────────────────────────

void define_pattern_bindings(SpannedPattern pattern, ScopeTable &scopes):
    match pattern.pat:
        case PBinding(name):
            scopes.define(name, DkVariable(), Span(0, 0))

        case PConstructor(_, fields):
            for field in fields:
                define_pattern_bindings(field, &scopes)

        case PDotShorthand(_, fields):
            for field in fields:
                define_pattern_bindings(field, &scopes)

        case PTuple(elements):
            for elem in elements:
                define_pattern_bindings(elem, &scopes)

        case POr(alternatives):
            if alternatives.len() > 0:
                SpannedPattern first = alternatives.get(0).unwrap()
                define_pattern_bindings(first, &scopes)

        case PWildcard():
            pass
        case PLiteral(_):
            pass
        case PRest():
            pass


# ── Is-pattern handling ─────────────────────────────────────

bool has_is_patterns(Expr e):
    match e:
        case EIs(_, negated, _):
            if not negated:
                return true
            return false
        case EBinaryOp(left, op, right):
            if op == "and":
                return has_is_patterns((*left).expr) or has_is_patterns((*right).expr)
            return false
        else:
            return false

void resolve_is_condition(SpannedExpr expr, ScopeTable &scopes, ResolveContext &ctx):
    match expr.expr:
        case EBinaryOp(left, op, right):
            if op == "and":
                resolve_is_condition(*left, &scopes, &ctx)
                resolve_is_condition(*right, &scopes, &ctx)
                return
            resolve_expr(expr, &scopes, &ctx)

        case EIs(inner, negated, pattern):
            if not negated:
                resolve_expr(*inner, &scopes, &ctx)
                define_pattern_bindings(*pattern, &scopes)
                return
            resolve_expr(expr, &scopes, &ctx)

        else:
            resolve_expr(expr, &scopes, &ctx)


# ═══════════════════════════════════════════════════════════
# Public entry point
# ═══════════════════════════════════════════════════════════

ResolveContext resolve_module(Module module, ScopeTable &scopes, TypeTable &types):
    ResolveContext ctx = collect_top_level(module, &scopes, &types)
    resolve_bodies(module, &scopes, &types, &ctx)
    return ctx
