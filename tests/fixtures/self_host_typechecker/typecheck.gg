# Minimal type checker for the self-hosting Gorget compiler.
# Walks the AST after name resolution and assigns type IDs to definitions
# based on their declared types.
#
# Phase 1: function signatures and explicit VarDecl types.
# Phase 2: expression type inference for auto/inferred variables.

from std.collections import Vector, Dict
from ast import Module, Item, Stmt, Param, FunctionDef, StructDef, EnumDef
from ast import EnumVariant, TraitDef, EquipBlock, MatchArm, ElseBranch
from ast import SpannedExpr, SpannedType, SpannedPattern, Span, Type, Expr, Pattern
from ast import EMethodCall, EBinaryOp, EIs, EClosure, ECall, EBlock, EDo, EAs, EIdentifier, EFString, SelectArm, SORecv, EMatch
from ast import EFieldAccess, EUnaryOp, EIndex, EIntLiteral
from ast import SExpr, SVarDecl, SReturn
# Full Expr/Stmt surface for the exhaustive unified safety walker (check_safety_*).
from ast import ERange, EIf, EImplicitClosure, EArrayLiteral, ETupleLiteral
from ast import EDictLiteral, EStructLiteral, EDotShorthand, ETry, EMove, EPropagate, EMutableBorrow, EDeref
from ast import EListComp, ESetComp, EDictComp, EDefaultOp, EAwait, ESpawn, ESpawnBlocking
from ast import ERethrow, ECatch
from ast import SAssign, SCompoundAssign, SThrow, SBreak, SContinue, SPass, SFor, SWhile
from ast import SLoop, SMatch, SWith, SAssert, SAssertReturn, SNamedScope, SSelect, SOnError
from ast import SItem, SSnapshot, SMeta, SMetaFor, SMetaIf, SMetaConst, SMetaForMatch
from ast import SMetaMatch, SMetaWhile, SOSend
from ast import EFloatLiteral, EBoolLiteral, EStringLiteral, ECharLiteral, ENoneLiteral, ESelfExpr, EIt
from ast import TPrimitive
from ids import NO_DEF, NO_TYPE
from scope import ScopeTable, DefKind, DefInfo, ScopeKind, SkEquipBlock, SkFunction
from scope import DkFunction, DkStruct, DkEnum, DkVariant, DkTrait
from scope import DkVariable, DkConst, DkStatic, DkGenericParam
from scope import get_def_at, get_scope_at, Scope
from types import TypeTable, ResolvedType, ast_type_to_resolved, get_stype_at
from types import RTFunction, RTVoid, RTPrimitive, RTDefined, RTGeneric
from types import RTTuple, RTArray, RTSlice, RTError, RTVar, RTNever, RTRef, get_rtype_at, get_int_at
from types import RTCallableTrait, RTMutCallableTrait, RTConsumeCallableTrait, RTBoxedCallable
from resolve import ResolveContext
from infer import infer_expr_type, infer_closure_return_type, default_op_carrier_inner_type, default_op_carrier_shape_equals
from traits import build_trait_registry, resolve_method_full, resolve_method_by_name, MethodResolution, is_scalar_primitive_name, primitive_satisfies_trait
from std.conv import int_to_str
from diagnostic import Diagnostic, DkDerefNonBox, DkDefaultOpNonOptional, DkDefaultOpRhsTypeMismatch, DkMainThrowsNonInt, DkValueOutOfRange, DkStringIndexAssign, DkUnsupportedOperator, DkInvalidAssignTarget, DkBreakOutsideLoop, DkContinueOutsideLoop, DkReturnOutsideFunction, DkThrowInNonThrowingFunction, DkMissingFallibleMark, DkUnhandledThrows, DkInferredThrowsUnsupported, DkPositionalAfterNamed, DkRequiredAfterDefault, DkDoubleAwait, DkDuplicateDefinition, DkLocalBorrowBind, DkMoveWithoutOperator, DkBorrowConflict, DkTypeMismatch, DkNoMethodFound, DkAmpInOperandPosition, DkMoveInOperandPosition
from format_types import describe_type

# ── Fallback def lookup by name ──────────────────────────────
# Scans all definitions for a matching name (and optionally DkFunction kind).
# Returns the first match or None.

Option[int] find_def_by_name(ScopeTable scopes, String name, bool require_function):
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.name == name:
            if not require_function:
                return Some(i)
            bool is_fn = false
            match d.kind:
                case DkFunction():
                    is_fn = true
                else:
                    pass
            if is_fn:
                return Some(i)
        i = i + 1
    return None()

# ── Find function body scope from parallel vectors ─────────
# When multiple functions share the same name (e.g. `serialize` across
# derive-generated equip blocks), the Dict only stores the last one.
# This helper searches all stored scopes, picks one whose parent chain
# includes parent_scope.

Option[int] find_body_scope(String name, int parent_scope, ScopeTable scopes, ResolveContext ctx):
    # Two-pass walk: direct-parent match always beats grandparent
    # match, regardless of order. Without this, when a user fixture
    # has a top-level fn named `chain` and std.iter is prepended
    # (which has `chain` as a method on VectorIter), the std.iter
    # chain's grandparent match (module → equip → method-fn-scope)
    # would beat the user's direct-parent match because std.iter's
    # entry comes first in fn_scope_names.
    Option[int] best = None()
    for (i, sn) in ctx.fn_scope_names.enumerate():
        if sn == name:
            int sid = ctx.fn_scope_ids.get(i).unwrap()
            int p = scopes.scope_parent_of(sid)
            if p == parent_scope:
                return Some(sid)
            if best is None:
                best = Some(sid)
    for (j, sn) in ctx.fn_scope_names.enumerate():
        if sn == name:
            int sid = ctx.fn_scope_ids.get(j).unwrap()
            int p = scopes.scope_parent_of(sid)
            if p >= 0:
                int gp = scopes.scope_parent_of(p)
                if gp == parent_scope:
                    return Some(sid)
    return best

# ── Find the next SkEquipBlock scope ───────────────────────
# Returns the next equip-block scope that is a child of parent_scope,
# with scope ID > after_scope. Used for ordered equip block processing.

Option[int] find_next_equip_scope(int parent_scope, int after_scope, ScopeTable scopes):
    int sid = after_scope + 1
    while sid < scopes.scope_count():
        Scope s = get_scope_at(scopes.scopes, sid)
        if s.parent == parent_scope:
            bool is_equip = false
            match s.kind:
                case SkEquipBlock():
                    is_equip = true
                else:
                    pass
            if is_equip:
                # Only return equip scopes that have SkFunction children
                # (pass 1 creates empty equip scopes, pass 2 has the body scopes)
                bool has_fn_child = false
                int csid = sid + 1
                while csid < scopes.scope_count():
                    Scope cs = get_scope_at(scopes.scopes, csid)
                    if cs.parent == sid:
                        match cs.kind:
                            case SkFunction():
                                has_fn_child = true
                            else:
                                pass
                    if cs.parent < sid:
                        csid = scopes.scope_count()
                    csid = csid + 1
                if has_fn_child:
                    return Some(sid)
        sid = sid + 1
    return None()

# ── Find the Nth pass-1 equip scope (contains method defs) ──
# Pass-1 scopes are created during collect_top_level and contain method defs.
# Pass-2 scopes are created during resolve_bodies and contain SkFunction children.
# The Nth equip block in the AST corresponds to the Nth pass-1 scope.

Option[int] find_nth_def_equip_scope(int n, int parent_scope, ScopeTable scopes):
    int count = 0
    int sid = 0
    while sid < scopes.scope_count():
        Scope s = get_scope_at(scopes.scopes, sid)
        if s.parent == parent_scope:
            bool is_equip = false
            match s.kind:
                case SkEquipBlock():
                    is_equip = true
                else:
                    pass
            if is_equip:
                # Check it does NOT have SkFunction children (pass-1 scope)
                bool has_fn_child = false
                int csid = sid + 1
                while csid < scopes.scope_count():
                    Scope cs = get_scope_at(scopes.scopes, csid)
                    if cs.parent == sid:
                        match cs.kind:
                            case SkFunction():
                                has_fn_child = true
                            else:
                                pass
                    if cs.parent < sid:
                        csid = scopes.scope_count()
                    csid = csid + 1
                if not has_fn_child:
                    if count == n:
                        return Some(sid)
                    count = count + 1
        sid = sid + 1
    return None()

# ── Generic-param binding-side demotion ─────────────────────
# Rust's typechecker uses two distinct values for the same generic
# param: `Defined(generic_param_def_id)` for the SIGNATURE slot
# (renders as "T") and a fresh inference variable for the BINDING
# slot (renders as "<error>"). Our resolver produces RTDefined for
# both. To match Rust's two-tier output, we demote a generic-param
# RTDefined to a fresh tagged RTVar at every binding site (function
# params, closure params, VarDecl, const, static, type alias). The
# signature slot keeps the original RTDefined.
#
# Recurses through container types (RTGeneric, RTTuple, RTArray,
# RTSlice, RTRef) so `Pair[T, U]` becomes `Pair[<error>, <error>]`
# and `Vector[T]` becomes `Vector[<error>]` at binding sites.
# Also descends into Callable WRAPPERS (RTCallableTrait,
# RTMutCallableTrait, RTConsumeCallableTrait, RTBoxedCallable) and
# rewrites the wrapped function's params/return — Rust renders
# `Callable[T(int)]` at a binding as `Callable[<error>(int)]`.
# Does NOT descend into bare RTFunction (only the Callable wrapper
# triggers descent) — bare function types are signature-shaped and
# Rust keeps `T` there.
int demote_generic_param_to_var(int type_id, ScopeTable scopes, TypeTable &types):
    if type_id < 0:
        return type_id
    if type_id >= types.types.len():
        return type_id
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTDefined(def_id):
            if def_id < 0:
                return type_id
            DefInfo d = scopes.get_def(def_id)
            match d.kind:
                case DkGenericParam():
                    # Inside a trait-bounded equip block, generic params
                    # defined IN the equip scope (the impl's own [T])
                    # keep their `Defined` rendering — Rust does not
                    # demote them. Method-level generics ([Hasher H])
                    # are defined in the method body scope, so they
                    # still demote.
                    if types.trait_equip_scope_id >= 0 and d.scope_id == types.trait_equip_scope_id:
                        return type_id
                    return types.fresh_generic_var()
                else:
                    return type_id
        case RTGeneric(gen_def_id, args):
            Vector[int] new_args = Vector[int]()
            bool any_changed = false
            for arg_tid in args:
                int new_arg_tid = demote_generic_param_to_var(arg_tid, scopes, &types)
                if new_arg_tid != arg_tid:
                    any_changed = true
                new_args.push(new_arg_tid)
            if any_changed:
                return types.add_type(!RTGeneric(gen_def_id, new_args))
            return type_id
        case RTTuple(elems):
            Vector[int] new_elems = Vector[int]()
            bool any_changed = false
            for elem_tid in elems:
                int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
                if new_elem_tid != elem_tid:
                    any_changed = true
                new_elems.push(new_elem_tid)
            if any_changed:
                return types.add_type(!RTTuple(new_elems))
            return type_id
        case RTArray(elem_tid, size):
            int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
            if new_elem_tid != elem_tid:
                return types.add_type(!RTArray(new_elem_tid, size))
            return type_id
        case RTSlice(elem_tid):
            int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
            if new_elem_tid != elem_tid:
                return types.add_type(!RTSlice(new_elem_tid))
            return type_id
        case RTRef(inner_tid):
            int new_inner_tid = demote_generic_param_to_var(inner_tid, scopes, &types)
            if new_inner_tid != inner_tid:
                return types.add_type(!RTRef(new_inner_tid))
            return type_id
        case RTCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(!RTCallableTrait(new_func_id))
            return type_id
        case RTMutCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(!RTMutCallableTrait(new_func_id))
            return type_id
        case RTConsumeCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(!RTConsumeCallableTrait(new_func_id))
            return type_id
        case RTBoxedCallable(kind_name, func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(!RTBoxedCallable(kind_name, new_func_id))
            return type_id
        else:
            return type_id

# Helper: demote generic params inside the params/return of an
# RTFunction. Only invoked when we know the function is wrapped in
# a Callable trait — bare RTFunction values keep `T`.
int demote_through_function_type(int type_id, ScopeTable scopes, TypeTable &types):
    if type_id < 0:
        return type_id
    if type_id >= types.types.len():
        return type_id
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTFunction(params, ownerships, ret_id):
            Vector[int] new_params = Vector[int]()
            bool any_changed = false
            for p_id in params:
                int new_p_id = demote_generic_param_to_var(p_id, scopes, &types)
                if new_p_id != p_id:
                    any_changed = true
                new_params.push(new_p_id)
            int new_ret_id = demote_generic_param_to_var(ret_id, scopes, &types)
            if new_ret_id != ret_id:
                any_changed = true
            if any_changed:
                return types.add_type(!RTFunction(new_params, ownerships, new_ret_id))
            return type_id
        else:
            return type_id

# ── Type-check a function definition ────────────────────────

# Register a function's signature on its DefInfo without walking the
# body. Used as a pre-pass in type_check_module so callers can resolve
# `auto x = some_fn()` against `some_fn`'s declared return type even
# when `some_fn` appears later in the merged-module item order than
# the caller. Mirror of Rust's `register_function_signature`.
void register_function_signature(FunctionDef func, int parent_scope, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx,int def_scope):
    bool is_generic = func.type_params.len() > 0
    Option[int] body_scope_opt = find_body_scope(func.name, parent_scope, scopes, ctx)
    if body_scope_opt is None and ctx.function_body_scopes.contains(func.name):
        body_scope_opt = Some(ctx.function_body_scopes.get(func.name).unwrap())
    bool has_body_scope = body_scope_opt is Some(_)
    int body_scope = body_scope_opt.unwrap_or(-1)
    int saved_scope = scopes.current_scope()
    if is_generic and has_body_scope:
        scopes.set_current(body_scope)
    int ret_id = ast_type_to_resolved(func.return_type.ty, func.return_type.span, scopes, &types)
    Vector[int] param_type_ids = Vector[int]()
    Vector[int] param_ownerships = Vector[int]()
    for p in func.params:
        int p_type_id = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
        param_type_ids.push(p_type_id)
        param_ownerships.push(p.ownership)
        # Set param type in EVERY body scope that matches this fn name and
        # contains this param. Handles duplicate extern declarations across
        # files (e.g. `__bytes_to_str_raw(b64_buf)` in std.bytes vs
        # `__bytes_to_str_raw(data)` in std.io): self-host's flat-merge
        # loader keeps both bodies but only the first wins the module-scope
        # name; without iterating, the second's params never get typed.
        int binding_type_id = demote_generic_param_to_var(p_type_id, scopes, &types)
        for (fsi, fs_name) in ctx.fn_scope_names.enumerate():
            if fs_name == func.name:
                int bs = ctx.fn_scope_ids.get(fsi).unwrap()
                int bp = scopes.scope_parent_of(bs)
                bool ok = bp == parent_scope
                if not ok and bp >= 0:
                    int bgp = scopes.scope_parent_of(bp)
                    ok = bgp == parent_scope
                if ok:
                    if scopes.lookup_in_scope(bs, p.param_name) is Some(param_def):
                        scopes.set_def_type(param_def, binding_type_id)
                        # D12 position 6: stamp is_param + ownership on the
                        # TYPECHECK-table param def (the one resolution_map +
                        # `check_safety_*` actually read). `resolve_function`
                        # marks a param on the resolve-pass scope table, but the
                        # merged-module typecheck uses a different def id — so the
                        # ownership sigil must be recorded HERE, at the def this
                        # pass resolves, or the materialize-on-write check reads a
                        # stale -1.
                        scopes.set_def_param(param_def, true)
                        scopes.set_def_param_ownership(param_def, p.ownership)
    if is_generic and has_body_scope:
        scopes.set_current(saved_scope)
    int fn_type_id = types.add_type(!RTFunction(param_type_ids, param_ownerships, ret_id))
    Option[int] fn_def_opt = None()
    if def_scope >= 0:
        fn_def_opt = scopes.lookup_in_scope(def_scope, func.name)
    if fn_def_opt is None:
        fn_def_opt = scopes.lookup_in_scope(parent_scope, func.name)
    if fn_def_opt is None:
        fn_def_opt = find_def_by_name(scopes, func.name, true)
    if fn_def_opt is Some(fn_def):
        scopes.set_def_type(fn_def, fn_type_id)
        # D29: classify this callee's fallibility ONCE, keyed by its typed DefId.
        # kind-1 (declared `throws E`) wins over kind-2; an infallible callee is
        # simply absent from the map. The reserved bare `!` inferred-error form
        # (`throws_inferred`) also marks kind-1 (it teaching-rejects at the sig,
        # but a call to it is still fallible).
        if func.throws_type.is_some() or func.throws_inferred:
            ctx.d29_callee_kind.set(fn_def, 1)
        else:
            if d29_type_is_result(ret_id, scopes, types):
                ctx.d29_callee_kind.set(fn_def, 2)

# RequiredAfterDefault — a required (no-default) parameter may not
# follow a parameter that declares a default value. Positional
# call-site resolution is ambiguous otherwise. Walk the params in
# order; once a defaulted param is seen, any later param WITHOUT a
# default is an error. Mirrors Rust's `validate_default_param_ordering`
# (src/semantic/resolve.rs:445), called from THREE decl sites:
# `Item::Function` (resolve.rs:513), `Item::Equip` methods
# (resolve.rs:708) — both reached via `type_check_function` — AND
# trait-method declarations (traits.rs:872), reached via the `ITrait`
# arm of `type_check_item`. Extracted to a shared helper so the one
# check covers the whole class (fix the class, not the instance) and
# the trait path cannot drift from the free-fn/equip path. NOT applied
# to extern fns (Rust's Item::ExternBlock does not validate them).
void check_default_param_ordering(Vector[Param] params, ResolveContext &ctx):
    bool seen_default = false
    for p in params:
        if p.default_value is Some(_):
            seen_default = true
        elif seen_default:
            ctx.diagnostics.push(Diagnostic.error(p.param_type.span, DkRequiredAfterDefault(), f"required parameter `{p.param_name}` follows a parameter with a default value"))

# ── Carrier-operator reject pass (EXHAUSTIVE; AGENTS.md Core #8 + #4) ──────
#
# `lhs ?? rhs` (default operator, parsed as EBinaryOp(_, "??", _)) requires an
# `Option`/`Result` LHS; `*x` (EDeref) requires a `Box[T]`. On any other carrier
# type both silently MISCOMPILE (the lowering reinterprets the value's bits as
# an enum / a garbage pointer — `lower_expr.gg`'s `?? on non-Option` diag_bug
# marker / a `*(int64_t*)(*(void**)&x)` deref). Rust rejects both at typecheck
# (src/semantic/typecheck.rs `Expr::DefaultOp` / `Expr::Deref`); these push the
# self-host TWINS so the driver's diagnostic gate (driver.gg:436 `has_errors` →
# exit(1) BEFORE `lower_module`) HALTS the build instead of emitting garbage C.
#
# CORE #4 — fix the CLASS, not the instance: the reject MUST be driven from a
# pass that visits EVERY expression position. `walk_expr_closures` is a
# closure-FINDING pass that recurses into only a handful of parent shapes and
# `else: pass`es the rest, so a `??`/`*x` nested in EUnaryOp/EIndex/EArrayLiteral/
# EAs/… ESCAPES it (the v1 walk-pass hole that shipped a one-sided reject). This
# walker mirrors resolve.gg's exhaustive `resolve_expr` enumeration (every Expr
# variant + every sub-expression) and is driven ONCE per function body from
# `type_check_function` AFTER `type_check_stmts` (types assigned), so each `??`/
# `*x` is checked EXACTLY ONCE with no double-fire. The arm-count lint
# `carrier_ops_expr_arm_count` (tests/lints.rs) forces every newly-added Expr
# variant through this walker — the next sub-expression-bearing shape cannot
# silently re-open the escape hole.

# True iff `type_id` resolves to an `Option`/`Result` carrier — the `??`-accepted
# set (verified end-to-end: both `Option ?? x` and `Result ?? x` run). The
# idiom mirrors infer.gg:584-588 + Rust's `is_option_or_result_receiver`.
bool carrier_op_is_option_or_result(int type_id, ScopeTable scopes, TypeTable types):
    if type_id >= 0 and type_id < types.types.len():
        ResolvedType rt = get_rtype_at(types.types, type_id)
        match rt:
            case RTGeneric(def_id, _targs):
                DefInfo d = scopes.get_def(def_id)
                return d.name == "Option" or d.name == "Result"
            case RTDefined(def_id2):
                DefInfo d2 = scopes.get_def(def_id2)
                return d2.name == "Option" or d2.name == "Result"
            else:
                return false
    return false

# D29: True iff `type_id` resolves to a `Result[T,E]` — the kind-2 discriminator
# (a declared-`Result` return makes a call fallible even without `throws`, per the
# one-mark-for-both-kinds rule). Result-ONLY (unlike the `??`-carrier helper which
# also accepts Option): the D29 mark rides Result outcomes, `??` rides Option too.
bool d29_type_is_result(int type_id, ScopeTable scopes, TypeTable types):
    if type_id >= 0 and type_id < types.types.len():
        ResolvedType rt = get_rtype_at(types.types, type_id)
        match rt:
            case RTGeneric(def_id, _targs):
                return scopes.get_def(def_id).name == "Result"
            case RTDefined(def_id2):
                return scopes.get_def(def_id2).name == "Result"
            else:
                return false
    return false

# D29: the fallibility kind of a CALL expression — 1 = kind-1 (`throws E`
# callee), 2 = kind-2 (declared-`Result` return callee), 0 = infallible OR
# unclassifiable. Reads the per-callee `d29_callee_kind` map (built once in
# `register_function_signature`) via the callee's TYPED DefId from
# `resolution_map` (layering rule 2 — never the identifier string). Only free-fn
# identifier callees are classified; a method / closure-value / unresolved callee
# returns 0 — CONSERVATIVE by design: the mark on such a call is never a lying
# mark and its bare use is never over-rejected (a known lane gap; the migrated
# corpus's method marks stay accepted). Mirrors the Rust producer's
# throws_type_id → kind-1 / type_is_result(ret) → kind-2 dispatch.
int d29_call_kind(SpannedExpr e, ResolveContext ctx):
    match e.expr:
        case ECall(callee, _args, _targs):
            match (*callee).expr:
                case EIdentifier(_name):
                    int cspan = (*callee).span.start
                    if ctx.resolution_map.contains(cspan):
                        int def_id = ctx.resolution_map.get(cspan).unwrap()
                        if ctx.d29_callee_kind.contains(def_id):
                            return ctx.d29_callee_kind.get(def_id).unwrap()
                    return 0
                else:
                    return 0
        else:
            return 0
    return 0

# D29: does an expression carry the fallible MARK (`expr!` → EPropagate)? Used to
# distinguish a legal marked call from a bare one at each enforcement position.
bool d29_is_marked(SpannedExpr e):
    match e.expr:
        case EPropagate(_inner):
            return true
        else:
            return false

# D29: is this declared type an explicit `Result[T,E]` annotation? Such a dest
# CAPTURES an unmarked fallible call (legal — the annotation carries the
# visibility, 2026-07-17 amendment); a mark on top is redundant.
bool d29_stype_is_result(SpannedType stype):
    match stype.ty:
        case TNamed(name, _args):
            return name == "Result"
        else:
            return false

# D29 enforcement: emit E_MissingFallibleMark at `span`. ONE code for every
# reason (bare / redundant-on-capture / result-arms-on-peeled / mark-on-infallible),
# mirroring the Rust family; the reason rides the message, only the CODE is
# conformance-compared.
void d29_emit(Span span, String message, ResolveContext &ctx):
    ctx.diagnostics.push(Diagnostic.error(span, DkMissingFallibleMark(), message))

void d29_emit_unhandled(Span span, ResolveContext &ctx):
    ctx.diagnostics.push(Diagnostic.error(span, DkUnhandledThrows(), "this call can fail but the error is not handled here; handle it with `catch` or `rethrow`, capture its outcome in an explicitly-typed binding, or declare the enclosing function `throws` to propagate"))

# D29 residual (a): is this mark PROVABLY a lie? Never use kind==0 alone —
# methods/unresolved are unclassifiable and must NOT be MarkOnInfallible while
# residual (d) is OUT (preserves d29_marked_combinator method marks).
bool d29_is_provable_lie(SpannedExpr inner, ResolveContext ctx):
    match inner.expr:
        case EPropagate(_):
            # nested `!!` — outer mark is never on a call
            return true
        case ECall(callee, _args, _targs):
            match (*callee).expr:
                case EIdentifier(_name):
                    int cspan = (*callee).span.start
                    if not ctx.resolution_map.contains(cspan):
                        # unresolved free-fn — unclassifiable, not a proven lie
                        return false
                    int def_id = ctx.resolution_map.get(cspan).unwrap()
                    # resolved free-fn absent from fallibility map = known pure
                    return not ctx.d29_callee_kind.contains(def_id)
                else:
                    # non-identifier callee (method chain, call expression, …)
                    return false
        case EMethodCall(_recv, _m, _a, _t):
            # residual (d) OUT — method marks stay accepted
            return false
        case EIntLiteral(_):
            return true
        case EFloatLiteral(_):
            return true
        case EBoolLiteral(_):
            return true
        case EStringLiteral(_, _):
            return true
        case ECharLiteral(_):
            return true
        case ENoneLiteral():
            return true
        case EIdentifier(_):
            # Result-local `r!` and other value marks
            return true
        case ESelfExpr():
            return true
        case EFieldAccess(_, _):
            return true
        case EIndex(_, _):
            return true
        else:
            # unclassifiable shapes — not a proven lie
            return false

# D29 residual (a)+(b) on `expr!` (EPropagate).
void d29_check_propagate(SpannedExpr marked, SpannedExpr inner, ResolveContext &ctx):
    if d29_is_provable_lie(inner, ctx):
        d29_emit(marked.span, "this `!` does not mark a fallible call — `!` attaches to a call whose callee is declared `throws` or returns `Result[T, E]`, exactly one mark per call; remove it", &ctx)
        return
    int kind = d29_call_kind(inner, ctx)
    if kind < 1:
        # method / unclassifiable — leave accepted (conservative)
        return
    if ctx.d29_in_disposition or ctx.d29_in_result_capture or ctx.d29_can_propagate:
        return
    d29_emit_unhandled(marked.span, &ctx)

# D29 residual (e): bare fallible on SReturn / expr-body — dest-aware table.
# Never call blanket d29_reject_if_bare_fallible here (kind-2 always rejected).
void d29_reject_bare_on_return(SpannedExpr e, ResolveContext &ctx):
    if d29_is_marked(e):
        return
    int kind = d29_call_kind(e, ctx)
    if kind == 1:
        if ctx.d29_return_is_result:
            return
        d29_emit(e.span, "this fallible call must be marked with `!` — mark it to propagate, handle it with `catch`/`rethrow`, or capture it into a `Result` binding", &ctx)
        return
    if kind == 2:
        if ctx.d29_return_is_result:
            return
        if ctx.d29_can_propagate:
            # Route-B auto-prop of Result into T in a throws/Result fn
            return
        d29_emit(e.span, "this fallible call must be marked with `!` — mark it to propagate, handle it with `catch`/`rethrow`, or capture it into a `Result` binding", &ctx)

# D29 (bare-call in a value-DISCARD or disposition/scrutinee position): a
# fallible CALL used WITHOUT the mark silently drops the outcome. Reject unless
# marked. Both kinds. A marked call (`f()!`) has already activated its channel —
# no reject. A non-call / infallible / unclassifiable expression is a no-op.
void d29_reject_if_bare_fallible(SpannedExpr e, ResolveContext &ctx):
    if d29_is_marked(e):
        return
    if d29_call_kind(e, ctx) >= 1:
        d29_emit(e.span, "this fallible call must be marked with `!` — mark it to propagate, handle it with `catch`/`rethrow`, or capture it into a `Result` binding", &ctx)

# D29 bind position (`T x = <init>`): an explicitly `Result`-annotated dest
# CAPTURES the unmarked call (legal); marking it too is the redundant-mark error
# (remove the `!`). A kind-1 (throws) call to a NON-Result dest requires the mark
# (auto/inferred does NOT capture a throws call — 2026-07-17 amendment). A kind-2
# unmarked bind is a legal Result VALUE flow at ANY dest (bind/pass/chain).
void d29_check_bind(SpannedType stype, SpannedExpr init, ResolveContext &ctx):
    bool dest_is_result = d29_stype_is_result(stype)
    if d29_is_marked(init):
        # `Result[T,E] r = f()!` — the mark is redundant at a capture dest.
        if dest_is_result:
            match init.expr:
                case EPropagate(inner):
                    if d29_call_kind(*inner, ctx) >= 1:
                        d29_emit(init.span, "remove the `!`: a `Result`-annotated binding captures the fallible outcome without a mark", &ctx)
                else:
                    pass
        return
    # Unmarked. A kind-1 call requires the mark unless the dest is a Result
    # capture; a kind-2 unmarked call is always a legal value flow.
    if not dest_is_result:
        if d29_call_kind(init, ctx) == 1:
            d29_emit(init.span, "this fallible call must be marked with `!` — an inferred/non-`Result` binding does not capture a `throws` call; mark it, handle it, or annotate the binding `Result[T, E]`", &ctx)

# D29 marked-match peel (`match f()!: case Ok/Error`): the mark peeled the
# scrutinee's `Result` to its success `T`, so `Ok`/`Error` arms can no longer
# match — bind the `Result` to a local first. Only a MARKED kind-1 scrutinee
# peels; a bare scrutinee / kind-2 Result value / T-variant arms are untouched
# (the snag48 T-variant marked-match RUNS). Fires only when an arm discriminates
# a Result variant.
void d29_check_match_peel(SpannedExpr scrut, Vector[MatchArm] arms, ResolveContext &ctx):
    bool marked_kind1 = false
    match scrut.expr:
        case EPropagate(inner):
            if d29_call_kind(*inner, ctx) == 1:
                marked_kind1 = true
        else:
            pass
    if not marked_kind1:
        return
    for arm in arms:
        if d29_pattern_is_result_variant(arm.pattern):
            d29_emit(scrut.span, "`match f()!:` peels the `Result` to its success value — `Ok`/`Error` arms cannot match here; bind the `Result` first (`Result[T, E] r = f()`), then match `r`", &ctx)
            return

# D29: does a pattern discriminate a `Result` variant (`Ok` / `Error`, optionally
# `Result.`-qualified)? Mirrors the Rust `pattern_discriminates_result` helper.
bool d29_pattern_is_result_variant(SpannedPattern pattern):
    match pattern.pat:
        case PConstructor(variant_name, _fields):
            return variant_name == "Ok" or variant_name == "Error"
        case PDotShorthand(variant_name, _fields):
            return variant_name == "Ok" or variant_name == "Error"
        else:
            return false

# True iff `type_id` is a suppression shape — inference incomplete (RTVar) or
# already errored/divergent (RTError/RTNever). Mirrors Rust's Var/error_id/
# never_id guard so valid or divergent (`throw`/`return`/`panic`) code never
# false-positives. NO_TYPE / out-of-range also suppress (inference gave up).
bool carrier_op_suppress(int type_id, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return true
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTVar(_):
            return true
        case RTError():
            return true
        case RTNever():
            return true
        else:
            return false

# Reject `lhs ?? rhs` when `lhs` is neither Option nor Result (with suppression).
void check_default_op_lhs(SpannedExpr lhs, int scope_id, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int lhs_type = infer_expr_type(lhs, scopes, &types, &ctx)
    if carrier_op_suppress(lhs_type, types):
        return
    if not carrier_op_is_option_or_result(lhs_type, scopes, types):
        ctx.diagnostics.push(Diagnostic.error(lhs.span, DkDefaultOpNonOptional(), "default operator `??` requires an `Option` or `Result` left-hand side"))

# Round XXXIX Track E (owner ruling Option B + LAZY 2026-08-09): the RHS of
# `??` must be one of {inner `T` (unwrap), same carrier shape (peel-outer for
# `a ?? b ?? default`), or divergent}. Anything else silently size-truncated
# in the lowering else-branch — SIGSEGV / miscompile (Rust mirror at
# `src/semantic/typecheck.rs Expr::DefaultOp`, R39 Track E). Enforcing here
# retires the class; sibling of `check_default_op_lhs`. Helpers
# `default_op_carrier_inner_type` / `default_op_carrier_shape_equals` are
# imported from infer.gg (single source of truth — Layering rule 3).
void check_default_op_rhs(SpannedExpr lhs, SpannedExpr rhs, int scope_id, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int lhs_type = infer_expr_type(lhs, scopes, &types, &ctx)
    if carrier_op_suppress(lhs_type, types):
        return
    if not carrier_op_is_option_or_result(lhs_type, scopes, types):
        return  # LHS reject is emitted by check_default_op_lhs; skip
    int rhs_type = infer_expr_type(rhs, scopes, &types, &ctx)
    if carrier_op_suppress(rhs_type, types):
        return  # Var / error / never — divergent RHS is legal
    int inner_t = default_op_carrier_inner_type(lhs_type, types)
    bool inner_match = false
    if inner_t >= 0:
        inner_match = (inner_t == rhs_type)
    bool carrier_match = default_op_carrier_shape_equals(lhs_type, rhs_type, types)
    if not inner_match and not carrier_match:
        ctx.diagnostics.push(Diagnostic.error(rhs.span, DkDefaultOpRhsTypeMismatch(), "right-hand side of `??` must be the inner `T` (unwrap), the same carrier shape (peel-outer for `a ?? b ?? default`), or divergent"))
        return
    # SH-lane gap (Core #9): the SH lowerer does NOT yet implement the
    # Option-preserving shape (extract-and-wrap in the Some/Ok branch) because
    # the SH GIR lacks a direct enum-init instruction — accepting a
    # carrier-matching RHS would produce C that GCC rejects with
    # "incompatible types when assigning to 'int64_t' from 'Option__int64_t'"
    # (empirically verified by the R39 Track E output-review). Reject
    # explicitly here with a lane-specific message so the failure is a loud
    # check-time reject (Core #8 reference-grade), not a loud C-emit build-fail
    # or, worse, silent miscompilation. The Rust lane accepts this shape (owner
    # Option B ratification 2026-08-09); the SH lane will follow when the GIR
    # grows the enum-init primitive it needs.
    if carrier_match and not inner_match:
        ctx.diagnostics.push(Diagnostic.error(rhs.span, DkDefaultOpRhsTypeMismatch(), "Option-preserving `??` (carrier-matching RHS) is not yet supported on the self-host lane — rewrite as `a ?? (b ?? default)` (right-nested) or use an unwrapped RHS; the SH lane will accept this shape once its GIR grows direct enum-init"))

# Reject `*x` when `x` is not a `Box[T]` (with the same suppression). Peels a
# single RTRef wrapper (`*(&box)`), mirroring infer.gg's EDeref arm.
void check_deref_operand(SpannedExpr operand, int scope_id, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int inner_type = infer_expr_type(operand, scopes, &types, &ctx)
    int resolved = inner_type
    if resolved >= 0 and resolved < types.types.len():
        ResolvedType wrap = get_rtype_at(types.types, resolved)
        match wrap:
            case RTRef(pointee):
                resolved = pointee
            else:
                pass
    if carrier_op_suppress(resolved, types):
        return
    bool is_box = false
    if resolved >= 0 and resolved < types.types.len():
        ResolvedType rt = get_rtype_at(types.types, resolved)
        match rt:
            case RTGeneric(box_def, box_args):
                DefInfo bd = scopes.get_def(box_def)
                if bd.name == "Box" and box_args.len() == 1:
                    is_box = true
            else:
                pass
    if not is_box:
        ctx.diagnostics.push(Diagnostic.error(operand.span, DkDerefNonBox(), "cannot dereference `*` a non-`Box[T]` value"))

# D10(a) (decisions.md, ratified 2026-07-06): a mutable borrow (`&expr`)
# bound to a name — `auto r = &b`, `r = &b`. A named `&`-binding would alias
# a second writable path to the place (one exclusive writer). Mirrors Rust
# gg's `E_LocalBorrowBind` (`src/semantic/typecheck.rs`, `expr_is_borrow_bind`).
# Compound-shape sites (`int x = if c: &a else: &b`, `match e: case P: &y`,
# `do: &a`, `{ ...; &a }`) recurse into branches/arms/tails via
# `expr_is_borrow_bind` + `stmts_tail_is_borrow_bind` (Round XXVIII Track D
# port from Rust `src/semantic/type_utils.rs`).
#
# Deliberately NOT a deep walk: `&x` nested in a call (`f(&x)`) is the legal
# call-arg form and is never visited here — this helper is only invoked on
# VarDecl inits, assignment RHS, and static initializers.
bool expr_is_borrow_bind(SpannedExpr expr):
    match expr.expr:
        case EMutableBorrow(_inner):
            return true
        case EIf(_c, then_body, elses):
            if stmts_tail_is_borrow_bind(then_body):
                return true
            for eb in elses:
                if stmts_tail_is_borrow_bind(eb.body):
                    return true
            return false
        case EMatch(_sc, arms):
            for arm in arms:
                if stmts_tail_is_borrow_bind(arm.body):
                    return true
            return false
        case EDo(body):
            return stmts_tail_is_borrow_bind(body)
        case EBlock(body):
            return stmts_tail_is_borrow_bind(body)
        else:
            return false

# The value of a `do:` / block expression is its TAIL statement (Gorget
# blocks have no separate tail field — the value is the last statement when
# it produces one). A tail whose value is a `&expr` makes the block a
# borrow-bind. Mirrors Rust `block_tail_is_borrow_bind`.
bool stmts_tail_is_borrow_bind(Vector[Stmt] stmts):
    if stmts.len() == 0:
        return false
    Stmt last = stmts.get(stmts.len() - 1).unwrap()
    match last:
        case SExpr(e):
            return expr_is_borrow_bind(e)
        case SIf(_c, then_body, elses):
            if stmts_tail_is_borrow_bind(then_body):
                return true
            for eb in elses:
                if stmts_tail_is_borrow_bind(eb.body):
                    return true
            return false
        case SMatch(_sc, arms):
            for arm in arms:
                if stmts_tail_is_borrow_bind(arm.body):
                    return true
            return false
        else:
            return false

void check_local_borrow_bind(SpannedExpr init, ResolveContext &ctx):
    if expr_is_borrow_bind(init):
        ctx.diagnostics.push(Diagnostic.error(init.span, DkLocalBorrowBind(), "cannot bind a mutable borrow (`&`) to a name — pass the borrow at a call site (`f(&x)`) or mutate the place directly"))

# ── D4/D12 drop-purity enforcement (mirrors Rust A2-R1 + A2-R2) ────────
#
# A type with a transitive custom `Drop` in its field/payload graph is
# drop-TAINTED and single-owner. An implicit copy of a live tainted PLACE
# at any of the six ownership boundaries is `E_MoveWithoutOperator`
# (self-host `DkMoveWithoutOperator`) — write `!place` (whole identifier)
# or `place.clone()`. Mirrors src/semantic/mod.rs (the taint pass +
# accessor) and src/semantic/safety/{check_stmt,check_expr,helpers}.rs
# (the six positions). Bootstrap-critical: the taint set must be IDENTICAL
# to Rust's, or the self-host would reject its own source.

# Recurse a resolved type: is it drop-tainted? Mirrors Rust
# `is_drop_tainted_type` (src/semantic/mod.rs:486-514) EXACTLY. Borrows
# (RTRef) are NOT copies. The Channel/Shared/Weak/Mutex generic handles are
# the sanctioned multi-owner escape hatch (name-matched inherited debt,
# filed with the Rust side in TODO:243). The self-host `ResolvedType` has no
# `RTOwned` variant, so Rust's `Owned(inner) => recurse` arm has no analogue.
bool is_drop_tainted_type(int type_id, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return false
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTDefined(def_id):
            return scopes.get_def(def_id).is_drop_tainted
        case RTGeneric(def_id, args):
            DefInfo d = scopes.get_def(def_id)
            if d.is_drop_tainted:
                return true
            # Handle types: copying the handle never duplicates a drop.
            if d.name == "Channel" or d.name == "Shared" or d.name == "Weak" or d.name == "Mutex":
                return false
            for a in args:
                if is_drop_tainted_type(a, scopes, types):
                    return true
            return false
        case RTTuple(elems):
            for e in elems:
                if is_drop_tainted_type(e, scopes, types):
                    return true
            return false
        case RTArray(elem, _size):
            return is_drop_tainted_type(elem, scopes, types)
        case RTSlice(elem):
            return is_drop_tainted_type(elem, scopes, types)
        else:
            # RTRef (borrows aren't copies) + everything that can't carry a
            # custom Drop.
            return false

# D4 drop-purity taint computation (D12). Seeds `DefInfo.is_drop_tainted`
# on every type with an `equip T with Drop` impl, then runs the transitive
# fixpoint over struct-field / enum-variant-payload graphs: a type carrying
# a tainted type anywhere in its field graph is itself tainted. Mirrors
# Rust `compute_drop_taint` (src/semantic/mod.rs:522-569). The fixpoint is
# REQUIRED — without it `struct W: R inner` would not be tainted and a bare
# `W w2 = w` bind (which Rust rejects) would be accepted.
void compute_drop_taint(Module module, ScopeTable &scopes, TypeTable &types):
    # Seed: `equip T with Drop` impls. The Drop trait is registered by name;
    # resolve it ONCE here — every downstream read is the typed DefInfo flag.
    Vector[int] seeds = Vector[int]()
    for impl_info in types.trait_registry.impls:
        if impl_info.trait_name == "Drop":
            ResolvedType st = get_rtype_at(types.types, impl_info.self_type)
            match st:
                case RTDefined(sd):
                    seeds.push(sd)
                case RTGeneric(sd, _gargs):
                    seeds.push(sd)
                else:
                    pass
    if seeds.len() == 0:
        return
    for seed_def in seeds:
        scopes.set_def_drop_tainted(seed_def, true)
    # Transitive fixpoint over the struct-field / enum-variant field graph.
    bool changed = true
    while changed:
        changed = false
        for item in module.items:
            match item:
                case IStruct(struct_def):
                    if scopes.lookup(struct_def.name) is Some(sdef_id):
                        if not scopes.get_def(sdef_id).is_drop_tainted:
                            bool tainted = false
                            for field in struct_def.fields:
                                int ft = ast_type_to_resolved(field.param_type.ty, field.param_type.span, scopes, &types)
                                if is_drop_tainted_type(ft, scopes, types):
                                    tainted = true
                            if tainted:
                                scopes.set_def_drop_tainted(sdef_id, true)
                                changed = true
                case IEnum(enum_def):
                    if scopes.lookup(enum_def.name) is Some(edef_id):
                        if not scopes.get_def(edef_id).is_drop_tainted:
                            bool tainted = false
                            for variant in enum_def.variants:
                                for fty in variant.fields:
                                    int ft = ast_type_to_resolved(fty.ty, fty.span, scopes, &types)
                                    if is_drop_tainted_type(ft, scopes, types):
                                        tainted = true
                            if tainted:
                                scopes.set_def_drop_tainted(edef_id, true)
                                changed = true
                else:
                    pass

# D10(b) Copy-axis computation — the DUAL of `compute_drop_taint`. Closes
# `DefInfo.is_copy` over the struct-field / enum-payload graph so a struct/enum
# is Copy iff it is NOT drop-tainted AND every field / variant payload is
# (transitively) Copy — mirroring Rust `is_copy_type`'s struct/enum recursion
# (src/semantic/safety/type_utils.rs:49-80). NON-Copy is the absorbing direction
# (taint's Copy dual): seed every non-tainted type-def optimistically Copy, then
# flip to non-Copy the moment any field is non-Copy, iterating to a fixed point.
# MUST run AFTER `compute_drop_taint` (it reads is_drop_tainted). Without it the
# self-host Copy axis is scalar-only and OVER-REJECTS a struct-of-scalars bare
# read paired with an overlapping `&` writer (the RV-D Copy-axis twin).
void compute_is_copy(Module module, ScopeTable &scopes, TypeTable &types):
    # Seed: a struct/enum def is optimistically Copy unless already drop-tainted.
    for item in module.items:
        match item:
            case IStruct(struct_def):
                if scopes.lookup(struct_def.name) is Some(sdef_id):
                    scopes.set_def_is_copy(sdef_id, not scopes.get_def(sdef_id).is_drop_tainted)
            case IEnum(enum_def):
                if scopes.lookup(enum_def.name) is Some(edef_id):
                    scopes.set_def_is_copy(edef_id, not scopes.get_def(edef_id).is_drop_tainted)
            else:
                pass
    # Fixpoint: flip a still-Copy def to non-Copy if ANY field/payload is non-Copy.
    # `resolved_type_is_copy` reads the CURRENT flags, so a not-yet-flipped
    # referenced struct reads Copy this round and is corrected the next — the
    # monotone flip-to-non-Copy converges.
    bool changed = true
    while changed:
        changed = false
        for item in module.items:
            match item:
                case IStruct(struct_def):
                    if scopes.lookup(struct_def.name) is Some(sdef_id):
                        if scopes.get_def(sdef_id).is_copy:
                            bool all_copy = true
                            for field in struct_def.fields:
                                int ft = ast_type_to_resolved(field.param_type.ty, field.param_type.span, scopes, &types)
                                if not resolved_type_is_copy(ft, scopes, types):
                                    all_copy = false
                            if not all_copy:
                                scopes.set_def_is_copy(sdef_id, false)
                                changed = true
                case IEnum(enum_def):
                    if scopes.lookup(enum_def.name) is Some(edef_id):
                        if scopes.get_def(edef_id).is_copy:
                            bool all_copy = true
                            for variant in enum_def.variants:
                                for fty in variant.fields:
                                    int ft = ast_type_to_resolved(fty.ty, fty.span, scopes, &types)
                                    if not resolved_type_is_copy(ft, scopes, types):
                                        all_copy = false
                            if not all_copy:
                                scopes.set_def_is_copy(edef_id, false)
                                changed = true
                else:
                    pass

# A PLACE expr (mirror Rust `expr_is_place`, helpers.rs:19-31): an
# identifier / self, a field sub-place, or a non-range index chain. `!x`
# (EMove) and `.clone()` (EMethodCall) are NOT places → naturally legal.
bool expr_is_place(Expr e):
    match e:
        case EIdentifier(_):
            return true
        case ESelfExpr():
            return true
        case EFieldAccess(obj, _fname):
            return expr_is_place((*obj).expr)
        case EIndex(obj, index):
            # `x[i]` is a place; `x[a..b]` (slice) is a fresh value.
            bool is_range = false
            match (*index).expr:
                case ERange(_, _, _):
                    is_range = true
                else:
                    pass
            if is_range:
                return false
            return expr_is_place((*obj).expr)
        else:
            return false

# Whole identifier/self (true) vs a field/index sub-place (false) — selects
# the D12 message remedy (mirror Rust `place_shape`, helpers.rs:40-45).
bool place_is_whole(Expr e):
    match e:
        case EIdentifier(_):
            return true
        case ESelfExpr():
            return true
        else:
            return false

# The ROOT binding name of a place chain (mirror Rust `find_root_def_id` →
# def name, read straight off the AST root — the self-host does not rename
# bindings, so the identifier text IS the root name).
String place_root_name(Expr e):
    match e:
        case EIdentifier(name):
            return name.clone()
        case ESelfExpr():
            return "self"
        case EFieldAccess(obj, _fname):
            return place_root_name((*obj).expr)
        case EIndex(obj, _index):
            return place_root_name((*obj).expr)
        else:
            return "<place>"

# The shape-aware D12 message (mirrors Rust A2-R2 `MoveWithoutOperator`
# Display, src/semantic/errors.rs:1022). `{name}` is the place's ROOT
# binding name (the exact sub-place text `hh.r.clone()` vs `hh.clone()` is
# the same filed LOW inaccuracy as Rust, TODO:292).
#   shape 0 = whole identifier/self → `!name` OR `name.clone()`
#   shape 1 = field/index sub-place → `name.clone()` only (bare `!` = partial move)
#   shape 2 = closure capture       → pass-as-arg / `Shared[T]` (NO `!`)
String drop_taint_message(String name, int shape):
    String why = "a resource (a type with a custom `Drop` is single-owner)"
    if shape == 1:
        return f"cannot copy `{name}`: `{name}` is {why} — copy the sub-place with `{name}.clone()` (a bare `!` on a field/index sub-place is a partial move and is rejected)"
    if shape == 2:
        return f"cannot capture `{name}` by value: `{name}` is {why}, so the capture would be an implicit copy — pass it as an argument or wrap it in `Shared[T]`"
    return f"cannot copy `{name}`: `{name}` is {why} — write `!{name}` to move or `{name}.clone()` to copy"

# D4/D12: if `e` is a PLACE whose type is drop-tainted, push a
# `DkMoveWithoutOperator` diagnostic. The place's type is resolved
# STRUCTURALLY via `infer_expr_type` (field/index places typed on demand —
# no bespoke lvalue walker, no sparse-table hole). Used by positions 1
# (bind/assign), 2 (ctor/field-init), 3 (collection put), 4 (return /
# expr-body / closure-tail). `!x`/`.clone()` are not places → accepted.
void reject_tainted_place(SpannedExpr e, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    if not expr_is_place(e.expr):
        return
    int tid = infer_expr_type(e, scopes, &types, &ctx)
    if not is_drop_tainted_type(tid, scopes, types):
        return
    int shape = 1
    if place_is_whole(e.expr):
        shape = 0
    String rname = place_root_name(e.expr)
    ctx.diagnostics.push(Diagnostic.error(e.span, DkMoveWithoutOperator(), drop_taint_message(rname, shape)))

# ── Single-owner INIT-class rejection (the callable/Box/Task carve-out) ──
# Mirrors Rust `needs_explicit_move` (src/semantic/safety/type_utils.rs:102) +
# `require_explicit_move_for_single_owner_init` (check_expr.rs:24) +
# `check_value_needs_move`'s single-owner arm (check_stmt.rs:1485). These types
# have NO implicit-copy path in the lowering (unlike CoW-eligible user structs),
# so a BARE identifier copy at an ownership-init boundary is E_MoveWithoutOperator
# — write `!f` (move) or `f.clone()` (copy). This axis is DISJOINT from the
# drop-taint axis (`reject_tainted_place`): production's `needs_explicit_move` ORs
# drop-taint in, but `tainted_place_name` preempts it at every shared call site,
# so excluding drop-taint here reproduces production exactly with no
# double-diagnosis.

# Is a resolved type single-owner-by-design (carve-out)? Callables (closures) +
# Box/Task/TaskGroup/Guard. NOT drop-tainted types — that axis is
# `reject_tainted_place`'s. Mirrors `needs_explicit_move` within the self-host
# `ResolvedType` vocabulary (no RTOwned variant exists — types.gg).
bool is_single_owner_type(int type_id, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return false
    if is_drop_tainted_type(type_id, scopes, types):
        return false
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTFunction(_p, _o, _r):
            return true
        case RTCallableTrait(_):
            return true
        case RTMutCallableTrait(_):
            return true
        case RTConsumeCallableTrait(_):
            return true
        case RTBoxedCallable(_kind, _fid):
            return true
        case RTGeneric(def_id, _args):
            String n = scopes.get_def(def_id).name
            return n == "Box" or n == "Task" or n == "TaskGroup" or n == "Guard"
        else:
            return false

# The single-owner INIT-class reject message (mirrors Rust MoveWithoutOperator +
# MoveReason::SingleOwner + MoveShape::Whole, errors.rs:1045/1049). An init-class
# copy is always a WHOLE bare identifier (`f`), so only the whole-shape remedy.
String single_owner_message(String name):
    String why = "a single-owner type (no implicit copy)"
    return f"cannot copy `{name}`: `{name}` is {why} — write `!{name}` to move or `{name}.clone()` to copy"

# Reject a BARE single-owner identifier at an ownership-init boundary. `e` is the
# bind RHS / ctor / struct-literal / enum-variant arg. `!x` (EMove) and
# `x.clone()` (EMethodCall) are not bare identifiers → naturally accepted, as is a
# fresh temp (a ctor/call result). `param_exempt` is TRUE only at bind/reassign:
# a param is borrowed from the caller, so re-binding it copies a pointer not the
# value (Rust `!def.is_param`, check_stmt.rs:1464). At a ctor / field-init
# boundary NO exemption applies (check_expr.rs:45 gates on DkVariable only — a
# param IS rejected there).
void reject_single_owner_init(SpannedExpr e, bool param_exempt, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    match e.expr:
        case EIdentifier(_name):
            if ctx.resolution_map.contains(e.span.start):
                int def_id = ctx.resolution_map.get(e.span.start).unwrap()
                DefInfo d = scopes.get_def(def_id)
                bool is_var = false
                match d.kind:
                    case DkVariable():
                        is_var = true
                    else:
                        pass
                if is_var and (not param_exempt or not d.is_param):
                    if is_single_owner_type(d.type_id, scopes, types):
                        ctx.diagnostics.push(Diagnostic.error(e.span, DkMoveWithoutOperator(), single_owner_message(d.name)))
        else:
            pass

# Is this ECall callee a constructor (struct / enum / variant name)? Gates
# D12 position 2 so a PLAIN function-call arg stays a legal BORROW
# (CLAUDE.md "Ownership at Consuming Positions" — only a ctor / field-init
# is a consuming boundary, not a plain call or method arg). `W(a)` (ctor)
# and `use(a)` (plain call) both parse as ECall; ctor-ness is decided by
# resolving the callee to a struct/enum/variant def.
bool is_ctor_callee(SpannedExpr callee, ScopeTable scopes, ResolveContext ctx):
    match callee.expr:
        case EIdentifier(_cname):
            if ctx.resolution_map.contains(callee.span.start):
                int def_id = ctx.resolution_map.get(callee.span.start).unwrap()
                match scopes.get_def(def_id).kind:
                    case DkStruct():
                        return true
                    case DkEnum():
                        return true
                    case DkVariant():
                        return true
                    else:
                        return false
            return false
        else:
            return false

# The DEF id of a place chain's ROOT binding, via the resolution map (keyed
# on the root identifier / self span). Used by D12 position 6 to inspect the
# root param's ownership + type.
Option[int] place_root_def_spanned(SpannedExpr e, ScopeTable scopes, ResolveContext ctx):
    match e.expr:
        case EIdentifier(_name):
            if ctx.resolution_map.contains(e.span.start):
                return Some(ctx.resolution_map.get(e.span.start).unwrap())
            return None()
        case ESelfExpr():
            if ctx.resolution_map.contains(e.span.start):
                return Some(ctx.resolution_map.get(e.span.start).unwrap())
            return None()
        case EFieldAccess(obj, _fname):
            return place_root_def_spanned(*obj, scopes, ctx)
        case EIndex(obj, _index):
            return place_root_def_spanned(*obj, scopes, ctx)
        else:
            return None()

# ── D10(b) same-call PLACE-OVERLAP rejection ─────────────────
# Mirror Rust `check_call_aliasing` (src/semantic/safety/helpers.rs:1179) and
# ggdef `check_arg_place_overlap` (spec/ggdef/src/elaborate/mod.rs:1076). Two
# call args whose PLACES overlap under CONFLICTING sigils are rejected — a
# place has one exclusive writer. The rule ranges over LIVE ALIASES: a
# Copy-typed BARE read is a value snapshot and participates in no overlap
# (D10(b) ADDENDUM + Rider 1 REVISED 2026-07-14). This is the FULL D10 rule —
# the mover-mover arm is IN (owner ruling "B2 SCOPE + LIVENESS-PASS" 2026-07-14):
# `f(!x, !x)` (same-root overlapping movers) is the MAXIMAL place-overlap and is
# REJECTED here with the overlap code. Production's Rust `check_call_aliasing`
# EXCLUDES `(Move,Move)` only because `E_DoubleMove` preempts it one pass earlier;
# the self-host has NO upstream move-tracker, so the faithful mirror lets the arm
# FIRE (reject-with-a-different-code strictly beats ACCEPT). Interim divergence
# (self-host overlap-code vs production/ggdef `E_DoubleMove`) is FILED in the
# self-host-liveness HIGH track (TODO.md); when liveness lands it preempts this arm
# per the ratified pass-order rider (liveness precedes aliasing). The
# mover-then-Copy-read case (`f(!x, x.copy_field)`) stays EXEMPT — the Copy read is
# a SNAPSHOT, not an alias, so it is dropped before the conflict test (only `!x`
# remains → no pair → accept); production/ggdef reject it via E_UseAfterMove, which
# is the LIVENESS axis's job (also filed). Reads the TYPED per-arg
# `CallArg.ownership` — never shape-matches the value (owner directive; layering
# rule 2 typed-not-shape).

# One collected place arg (mirror Rust/ggdef `struct P`). `root` is the binding
# NAME (the self-host does not rename bindings, so the identifier text IS the
# root — matches ggdef's String-keyed root and handles `self` uniformly).
struct ArgPlace:
    String root
    Vector[String] path
    int ownership
    bool is_copy
    Span span

# The projection PATH (outer-to-inner field/tuple segments) of a place expr, or
# None for a non-place (fresh temp, literal, `.clone()`, `.get()`). Tuple fields
# parse as EFieldAccess with numeric-string names ("0"), so no special case is
# needed. EIndex (a scalar index OR a range slice) COLLAPSES to the collection
# root — an index/slice borrow is from the collection itself. Mirrors Rust
# `find_root_def_id_with_path` (helpers.rs:509-511): Index recurses to the
# object regardless of index shape, so a slice `v[a..b]` roots at `v` and
# participates in the same place-overlap axis as `&v`. (Contrast `expr_is_place`,
# which — like production's `expr_is_place` — DOES treat a slice as a fresh value
# for the D12 tainted-place axis; the two axes are deliberately asymmetric.)
Option[Vector[String]] place_projection_path(Expr e):
    match e:
        case EIdentifier(_):
            return Some(Vector[String]())
        case ESelfExpr():
            return Some(Vector[String]())
        case EFieldAccess(obj, fname):
            match place_projection_path((*obj).expr):
                case Some(inner):
                    Vector[String] path = Vector[String]()
                    for s in inner:
                        path.push(s)
                    path.push(fname)
                    return Some(path)
                else:
                    return None()
        case EIndex(obj, _index):
            # A range slice is a live VIEW into the collection, so — like a
            # scalar index — it roots at the collection. Copy-ness of a slice
            # arg is decided by `arg_place_is_copy` on the inferred ELEMENT type
            # (infer returns the element for `v[a..b]`), matching production's
            # `lvalue_value_type` args.last(): a Copy-element slice stays exempt,
            # a non-Copy-element slice conflicts with an overlapping writer.
            return place_projection_path((*obj).expr)
        else:
            return None()

# Two projection paths under the SAME root OVERLAP iff one is a prefix of the
# other (zip stops at the shorter). Disjoint siblings (`a` vs `b`) do NOT
# overlap; an empty path (the whole binding) overlaps every sub-place.
bool paths_overlap_vec(Vector[String] a, Vector[String] b):
    int m = a.len()
    if b.len() < m:
        m = b.len()
    int i = 0
    while i < m:
        if a.get(i).unwrap() != b.get(i).unwrap():
            return false
        i = i + 1
    return true

# Render a place with its call-arg sigil for the diagnostic (`&p`/`!p`/bare).
String render_place_sig(int own, String root, Vector[String] path):
    String s = root
    for seg in path:
        s = s + "." + seg
    if own == OWN_MUTABLE:
        return "&" + s
    if own == OWN_MOVE:
        return "!" + s
    return s

# Copy-ness of a resolved type via the TYPED axis (Rider 2 — NO shape
# heuristic). Mirrors production `is_copy_type` (type_utils.rs:17-88) for the
# cases the self-host `ResolvedType` decides WITHOUT struct field-type metadata:
#   * scalar primitive          → Copy (int/float/bool/char families)
#   * tuple of all-Copy elems    → Copy
#   * borrow (`RTRef`)           → Copy (a pointer; copying it duplicates no buffer)
#   * Channel/Shared/Weak/Mutex  → Copy (opaque handle pointers)
# Str/String, collections and buffer-owning structs are NOT. A struct/enum
# (`RTDefined`) is Copy in production iff it is NOT drop-tainted AND all fields
# are (transitively) Copy — resolved off the per-def `DefInfo.is_copy` flag that
# `compute_is_copy` (below) closes over the field-graph fixpoint, the DUAL of
# `compute_drop_taint`. This mirrors production `is_copy_type`'s struct/enum
# recursion (type_utils.rs:49-80). Unknown → non-Copy.
bool resolved_type_is_copy(int type_id, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return false
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTPrimitive(name):
            return is_scalar_primitive_name(name)
        case RTTuple(elems):
            for e in elems:
                if not resolved_type_is_copy(e, scopes, types):
                    return false
            return true
        case RTRef(_inner):
            return true
        case RTDefined(def_id):
            # A struct/enum is Copy iff NOT drop-tainted AND all fields/payloads
            # are Copy (the precomputed flag). Production `is_copy_type` ANDs the
            # same two axes (type_utils.rs:55-70). A drop-tainted type is NEVER
            # Copy (D4/D12 mutual exclusion) — belt-and-suspenders since
            # compute_is_copy already leaves tainted defs non-Copy.
            DefInfo dd = scopes.get_def(def_id)
            return not dd.is_drop_tainted and dd.is_copy
        case RTGeneric(def_id, _args):
            DefInfo gd = scopes.get_def(def_id)
            return gd.name == "Channel" or gd.name == "Shared" or gd.name == "Weak" or gd.name == "Mutex"
        else:
            return false

# Copy-ness of the arg VALUE. For `v[a..b]` the inferred type is the ELEMENT
# type (infer's EIndex arm), matching production's `lvalue_value_type`
# args.last() — so a Copy-element slice stays exempt from the overlap axis.
bool arg_place_is_copy(SpannedExpr e, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int t = infer_expr_type(e, scopes, &types, &ctx)
    return resolved_type_is_copy(t, scopes, types)

# Reject two call args whose places overlap under conflicting sigils.
void check_call_aliasing(Vector[CallArg] args, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    Vector[ArgPlace] places = Vector[ArgPlace]()
    for a in args:
        match place_projection_path(a.value.expr):
            case Some(path):
                String rname = place_root_name(a.value.expr)
                # Only LOCAL-variable roots (+`self`) participate — a call name /
                # const / variant root is skipped. Mirrors production's
                # `DkVariable` root filter and ggdef's `root == "self" ||
                # local_names.contains`.
                bool is_local = false
                if rname == "self":
                    is_local = true
                elif place_root_def_spanned(a.value, scopes, ctx) is Some(rdid):
                    match scopes.get_def(rdid).kind:
                        case DkVariable():
                            is_local = true
                        else:
                            pass
                if is_local:
                    bool cpy = arg_place_is_copy(a.value, scopes, &types, &ctx)
                    places.push(ArgPlace(rname, path, a.ownership, cpy, a.value.span))
            else:
                pass
    int n = places.len()
    int i = 0
    while i < n:
        int j = i + 1
        while j < n:
            ArgPlace x = places.get(i).unwrap()
            ArgPlace y = places.get(j).unwrap()
            # PASS-ORDER RIDER (liveness precedes aliasing): `x` is the EARLIER arg
            # (i < j, places collected in left-to-right order). If it is a MOVE, it
            # DOMINATES every later use of its place — the second move (`f(!x,!x)`)
            # is E_DoubleMove and a move-then-read (`f(!x, x.data)`) is E_UseAfterMove,
            # both the LIVENESS axis's job (which runs first). Skip the pair so the
            # overlap axis does not double-diagnose. This SUBSUMES the old explicit
            # mover-mover arm AND drops production's redundant BorrowConflict on
            # `f(!x, x.data)` (measured: Rust gg emits UAM + BorrowConflict there;
            # the self-host emits a single UAM — reference-grade-cleaner). A move at
            # arg `j` (LATER) still conflicts with an earlier reader/writer at `i`
            # (`g(n,!n)`, `f(&n,!n)`) — that read-before-move is legal for liveness,
            # so the overlap axis must still fire; hence the guard is on `x` only.
            if x.ownership == OWN_MOVE:
                j = j + 1
                continue
            if x.root == y.root and paths_overlap_vec(x.path, y.path):
                bool x_copy_reader = x.ownership == OWN_BORROW and x.is_copy
                bool y_copy_reader = y.ownership == OWN_BORROW and y.is_copy
                bool has_wm = x.ownership == OWN_MUTABLE or x.ownership == OWN_MOVE or y.ownership == OWN_MUTABLE or y.ownership == OWN_MOVE
                bool both_bare = x.ownership == OWN_BORROW and y.ownership == OWN_BORROW
                if not x_copy_reader and not y_copy_reader and has_wm and not both_bare:
                    String pa = render_place_sig(x.ownership, x.root, x.path)
                    String pb = render_place_sig(y.ownership, y.root, y.path)
                    ctx.diagnostics.push(Diagnostic.error(y.span, DkBorrowConflict(), "cannot pass `" + pa + "` and `" + pb + "` in the same call — their places overlap"))
            j = j + 1
        i = i + 1

# Field-write-addressable builtin collection kinds only
# (CollectionKind::Array | OrderedMap ≡ Vector/Deque/GorgetArray + Dict).
# NARROWER than `is_collection_receiver` — Set/Heap/HashSet/HashMap/Queue/
# Channel must NOT gate get-chain descent (reject ⊆ materialize).
#
# ── SH CoW trap (round-close 2026-07-21) ──
# Rust's get-chain kind gate is structural + BORROWING:
#   collection_kind_of_expr → lvalue_value_type (&self, no re-infer)
# The first SH land used `infer_expr_type` AND threaded ScopeTable /
# TypeTable / ResolveContext BY VALUE into recursive helpers. On the SH
# (weaker CoW: by-value big-table params still-live past a sibling call
# clone), that is a stage-0 clone bomb (12.6M → 121M array_clone). Fix:
# (1) structural lvalue_value_type only — NEVER infer_expr_type;
# (2) hot helpers use bare ScopeTable/TypeTable/ResolveContext params
#     (= CoW borrow, like place_root_def_spanned) — NOT TypeTable-by-value
#     recursion that clones the type table at every FieldAccess step, and
#     NOT `&` write-through (kind gate is read-only);
# (3) get_def_at(scopes.definitions, id) over scopes.get_def(self, …).
bool type_id_is_field_addressable_collection(int type_id, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return false
    ResolvedType t = get_rtype_at(types.types, type_id)
    match t:
        case RTGeneric(def_id, _args):
            # .get on the defs vector — NOT get_def_at(by-value Vector) which
            # would array_clone the entire definitions table per call.
            String n = scopes.definitions.get(def_id).unwrap().name
            return n == "Vector" or n == "Deque" or n == "Dict" or n == "GorgetArray"
        case RTDefined(def_id):
            String n = scopes.definitions.get(def_id).unwrap().name
            return n == "Vector" or n == "Deque" or n == "Dict" or n == "GorgetArray"
        else:
            return false

# Structural lvalue type — mirror of Rust `SafetyChecker::lvalue_value_type`
# (helpers.rs:957). NO full expression inference. Bare table params = borrow.
int lvalue_value_type(SpannedExpr target, ScopeTable scopes, TypeTable types, ResolveContext ctx):
    match target.expr:
        case EIdentifier(_):
            if ctx.resolution_map.contains(target.span.start):
                return scopes.definitions.get(ctx.resolution_map.get(target.span.start).unwrap()).unwrap().type_id
            return -1
        case ESelfExpr():
            return types.self_type_id
        case EFieldAccess(obj, field_name):
            int obj_tid = lvalue_value_type(*obj, scopes, types, ctx)
            if obj_tid < 0 or obj_tid >= types.types.len():
                return -1
            ResolvedType ort = get_rtype_at(types.types, obj_tid)
            match ort:
                case RTDefined(def_id):
                    String sname = scopes.definitions.get(def_id).unwrap().name
                    String key = sname + "." + field_name
                    if types.variant_field_types.contains(key):
                        return types.variant_field_types.get(key).unwrap()
                    return -1
                case RTGeneric(def_id, _args):
                    String sname = scopes.definitions.get(def_id).unwrap().name
                    String key = sname + "." + field_name
                    if types.variant_field_types.contains(key):
                        return types.variant_field_types.get(key).unwrap()
                    return -1
                else:
                    return -1
        case EIndex(obj, _index):
            int obj_tid = lvalue_value_type(*obj, scopes, types, ctx)
            if obj_tid < 0 or obj_tid >= types.types.len():
                return -1
            ResolvedType ort = get_rtype_at(types.types, obj_tid)
            match ort:
                case RTGeneric(_def_id, args):
                    if args.len() > 0:
                        return get_int_at(args, args.len() - 1)
                    return -1
                case RTArray(elem, _n):
                    return elem
                case RTSlice(elem):
                    return elem
                else:
                    return -1
        case EMethodCall(_recv, _m, _a, _t):
            # Rust: recorded expr_types only (peel Ref). Miss → -1, no re-infer.
            if types.expr_types.contains(target.span.start):
                int tid = types.expr_types.get(target.span.start).unwrap()
                if tid < 0 or tid >= types.types.len():
                    return -1
                ResolvedType rt = get_rtype_at(types.types, tid)
                match rt:
                    case RTRef(inner):
                        return inner
                    else:
                        return tid
            return -1
        else:
            return -1

bool is_field_addressable_collection(SpannedExpr recv, ScopeTable scopes, TypeTable types, ResolveContext ctx):
    int tid = lvalue_value_type(recv, scopes, types, ctx)
    return type_id_is_field_addressable_collection(tid, scopes, types)

# Pure syntactic: getter MethodCall in the place chain? Cheap non-get reject.
bool place_chain_has_getter_method(Expr e):
    match e:
        case EFieldAccess(obj, _fname):
            return place_chain_has_getter_method((*obj).expr)
        case EIndex(obj, _index):
            return place_chain_has_getter_method((*obj).expr)
        case EMethodCall(recv, mname, _a, _t):
            if mname == "get" or mname == "first" or mname == "last" or mname == "unwrap" or mname == "expect":
                return true
            return place_chain_has_getter_method((*recv).expr)
        else:
            return false

# Shared descend predicate — mirrors Rust find_get_chain_taint_root MethodCall arm.
bool get_chain_method_descends(SpannedExpr recv, String mname, ScopeTable scopes, TypeTable types, ResolveContext ctx):
    if mname == "get" or mname == "first" or mname == "last":
        return is_field_addressable_collection(recv, scopes, types, ctx)
    if mname == "unwrap" or mname == "expect":
        match recv.expr:
            case EMethodCall(inner, im, _a, _t):
                if im == "get" or im == "first" or im == "last":
                    return is_field_addressable_collection(*inner, scopes, types, ctx)
                return false
            else:
                return false
    return false

# Strict SUPERSET of place_root_def_spanned + MethodCall get-chain arm.
# Bare table params (= borrow). Precondition: place_chain_has_getter_method when hot.
Option[int] get_chain_root_def_spanned(SpannedExpr e, ScopeTable scopes, TypeTable types, ResolveContext ctx):
    match e.expr:
        case EIdentifier(_name):
            if ctx.resolution_map.contains(e.span.start):
                return Some(ctx.resolution_map.get(e.span.start).unwrap())
            return None()
        case ESelfExpr():
            if ctx.resolution_map.contains(e.span.start):
                return Some(ctx.resolution_map.get(e.span.start).unwrap())
            return None()
        case EFieldAccess(obj, _fname):
            return get_chain_root_def_spanned(*obj, scopes, types, ctx)
        case EIndex(obj, _index):
            return get_chain_root_def_spanned(*obj, scopes, types, ctx)
        case EMethodCall(recv, mname, _args, _targs):
            # Kind-gate FIRST (last-use of tables on miss → no clone for the
            # recursive call). On hit, tables are re-borrowed into the recurse.
            if get_chain_method_descends(*recv, mname, scopes, types, ctx):
                return get_chain_root_def_spanned(*recv, scopes, types, ctx)
            return None()
        else:
            return None()

# Name twin for self-root resolution (ESelfExpr often has no DefId).
String get_chain_root_name(SpannedExpr e, ScopeTable scopes, TypeTable types, ResolveContext ctx):
    match e.expr:
        case EIdentifier(name):
            return name.clone()
        case ESelfExpr():
            return "self"
        case EFieldAccess(obj, _fname):
            return get_chain_root_name(*obj, scopes, types, ctx)
        case EIndex(obj, _index):
            return get_chain_root_name(*obj, scopes, types, ctx)
        case EMethodCall(recv, mname, _args, _targs):
            if get_chain_method_descends(*recv, mname, scopes, types, ctx):
                return get_chain_root_name(*recv, scopes, types, ctx)
            return "<place>"
        else:
            return "<place>"

# 2T core (materialize-on-write): bare BORROW param / plain-self of a
# drop-tainted type REJECTED. Get-chain roots via get_chain_root_* superset
# (strict or_else shape, Core #4). Mirrors Rust reject_tainted_materialize_on_write.
bool reject_if_tainted_materialize_root(SpannedExpr place, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    bool maybe_get = place_chain_has_getter_method(place.expr)
    # --- self by name (strict OR get-chain) ---
    String rname = place_root_name(place.expr)
    if rname == "<place>" and maybe_get:
        rname = get_chain_root_name(place, scopes, types, ctx)
    if rname == "self":
        if ctx.self_mode == 0 and is_drop_tainted_type(types.self_type_id, scopes, types):
            ctx.diagnostics.push(Diagnostic.error(place.span, DkMoveWithoutOperator(), drop_taint_message("self", 0)))
            return true
        return false
    # --- def root: strict FIRST, then get-chain superset ---
    Option[int] root_opt = place_root_def_spanned(place, scopes, ctx)
    if root_opt is None and maybe_get:
        root_opt = get_chain_root_def_spanned(place, scopes, types, ctx)
    if root_opt is Some(def_id):
        DefInfo d = scopes.definitions.get(def_id).unwrap()
        if d.is_param and d.param_ownership == 0 and is_drop_tainted_type(d.type_id, scopes, types):
            ctx.diagnostics.push(Diagnostic.error(place.span, DkMoveWithoutOperator(), drop_taint_message(d.name, 0)))
            return true
    return false

# D12 position 6 — LOCAL place-or-get-chain gate only (expr_is_place stays strict).
void reject_materialize_on_write(SpannedExpr target, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    if place_is_whole(target.expr):
        return
    if not expr_is_place(target.expr):
        if not place_chain_has_getter_method(target.expr):
            return
    bool _r = reject_if_tainted_materialize_root(target, scopes, types, &ctx)

# Element-ingesting mutating builtin methods (mirror Rust's protocol
# `is_mutating` element-ingest set, src/ir/lowering/builtins.rs). A bare
# drop-tainted place passed to one of these on a collection receiver copies
# at the ownership boundary (D12 position 3). One centralized name
# classifier (rule 2 — the typecheck stage has no protocol table to query).
bool is_collection_ingest_method(String name):
    return name == "push" or name == "put" or name == "insert" or name == "add" or name == "send" or name == "set" or name == "extend" or name == "update" or name == "get_or_put" or name == "fill" or name == "set_at" or name == "enqueue" or name == "append" or name == "push_front" or name == "push_back"

# EVERY mutating collection builtin — the ingest set PLUS the removing/reordering
# methods (`pop`/`remove`/`clear`/`sort`/…) that mutate the receiver in place.
# Mirrors Rust `is_mutating_builtin_method` (src/ir/lowering/builtins.rs — the
# ALL_PROTOCOLS `is_mutating` set). Used for the 2T RECEIVER-root reject (defect
# C): a mutating builtin on a collection receiver materialises the receiver ROOT,
# so `r.vals.pop()` on a tainted bare param must reject just like `r.vals.push(x)`
# (the ARG-position D12 gate stays on the narrower ingest set — only ingest ARGS
# copy at the boundary).
bool is_mutating_builtin_method(String name):
    if is_collection_ingest_method(name):
        return true
    return name == "pop" or name == "remove" or name == "clear" or name == "reserve" or name == "reverse" or name == "sort" or name == "sort_by" or name == "sort_by_key" or name == "swap" or name == "swap_remove" or name == "pop_front" or name == "pop_back" or name == "dequeue"

# Is the receiver an element-owning collection (Vector/Dict/Set/Heap/…)?
# Gates position 3 so a plain user method named `push`/`add` on a non-
# collection type stays a legal borrow (mirror Rust `is_buffer_owning_receiver`).
bool is_collection_receiver(SpannedExpr receiver, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int rt = infer_expr_type(receiver, scopes, &types, &ctx)
    if rt < 0 or rt >= types.types.len():
        return false
    ResolvedType t = get_rtype_at(types.types, rt)
    match t:
        case RTGeneric(def_id, _args):
            String n = scopes.get_def(def_id).name
            return n == "Vector" or n == "Dict" or n == "HashMap" or n == "Set" or n == "HashSet" or n == "Heap" or n == "Deque" or n == "Queue" or n == "Channel"
        else:
            return false

# D12 position 6 (user `&self` mutator on a tainted borrow-rooted receiver):
# calling a `&self` mutator on a bare BORROW param of a drop-tainted type
# would materialize an implicit copy. Mirrors Rust's pos-6 `is_user_mut`
# branch. Root: strict place root OR get-chain superset (Core #4 two-site).
void reject_amp_self_mutator(SpannedExpr receiver, String method_name, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    Option[int] root_opt = place_root_def_spanned(receiver, scopes, ctx)
    if root_opt is None and place_chain_has_getter_method(receiver.expr):
        root_opt = get_chain_root_def_spanned(receiver, scopes, types, ctx)
    if root_opt is Some(def_id):
        DefInfo d = scopes.definitions.get(def_id).unwrap()
        if d.is_param and d.param_ownership == 0 and is_drop_tainted_type(d.type_id, scopes, types):
            int recv_type = infer_expr_type(receiver, scopes, &types, &ctx)
            MethodResolution mr = resolve_method_full(recv_type, method_name, scopes, &types)
            if mr.found and mr.sig.self_ownership == 1:
                String rname = place_root_name(receiver.expr)
                if rname == "<place>" and place_chain_has_getter_method(receiver.expr):
                    rname = get_chain_root_name(receiver, scopes, types, ctx)
                ctx.diagnostics.push(Diagnostic.error(receiver.span, DkMoveWithoutOperator(), drop_taint_message(rname, 0)))

# Is `anc` the same scope as `node` or an ancestor of it? Used by the
# closure capture walk to tell an OUTER local (a capture) apart from a
# closure param / closure-local (defined in a descendant scope).
bool scope_is_ancestor_or_self(ScopeTable scopes, int anc, int node):
    int cur = node
    while cur >= 0:
        if cur == anc:
            return true
        cur = scopes.scope_parent_of(cur)
    return false

# Collect every identifier reference inside a closure body, for the D12
# position-5 capture free-var walk. Explicit remedies are skipped: an
# `!x` (EMove) operand and a `.clone()` receiver are NOT implicit-copy
# captures.
void collect_idents_stmts(Vector[Stmt] stmts, Vector[SpannedExpr] &out):
    for s in stmts:
        collect_idents_stmt(s, &out)

void collect_idents_stmt(Stmt s, Vector[SpannedExpr] &out):
    match s:
        case SVarDecl(_st, _n, e, _l, _c, _f):
            collect_idents_expr(e, &out)
        case SAssign(t, v):
            collect_idents_expr(t, &out)
            collect_idents_expr(v, &out)
        case SCompoundAssign(t, _op, v):
            collect_idents_expr(t, &out)
            collect_idents_expr(v, &out)
        case SExpr(e):
            collect_idents_expr(e, &out)
        case SReturn(oe):
            if oe is Some(e):
                collect_idents_expr(e, &out)
        case SThrow(e):
            collect_idents_expr(e, &out)
        case SIf(c, b, ebs):
            collect_idents_expr(c, &out)
            collect_idents_stmts(b, &out)
            for eb in ebs:
                if eb.condition is Some(cc):
                    collect_idents_expr(cc, &out)
                collect_idents_stmts(eb.body, &out)
        case SWhile(c, b, eb):
            collect_idents_expr(c, &out)
            collect_idents_stmts(b, &out)
            collect_idents_stmts(eb, &out)
        case SFor(_p, iter_e, b, _fl, eb):
            collect_idents_expr(iter_e, &out)
            collect_idents_stmts(b, &out)
            collect_idents_stmts(eb, &out)
        case SLoop(b):
            collect_idents_stmts(b, &out)
        case SMatch(sc, arms):
            collect_idents_expr(sc, &out)
            for arm in arms:
                if arm.guard is Some(g):
                    collect_idents_expr(g, &out)
                collect_idents_stmts(arm.body, &out)
        case SWith(e, _n, b):
            collect_idents_expr(e, &out)
            collect_idents_stmts(b, &out)
        else:
            pass

void collect_idents_expr(SpannedExpr e, Vector[SpannedExpr] &out):
    match e.expr:
        case EIdentifier(_n):
            out.push(e)
        case EBinaryOp(l, _op, r):
            collect_idents_expr(*l, &out)
            collect_idents_expr(*r, &out)
        case EUnaryOp(_op, o):
            collect_idents_expr(*o, &out)
        case ECall(callee, args, _t):
            collect_idents_expr(*callee, &out)
            for a in args:
                collect_idents_expr(a.value, &out)
        case EMethodCall(recv, mname, args, _t):
            # `x.clone()` is an explicit copy — the receiver is NOT an
            # implicit-copy capture. Other method receivers ARE captured.
            if mname != "clone":
                collect_idents_expr(*recv, &out)
            for a in args:
                collect_idents_expr(a.value, &out)
        case EFieldAccess(o, _f):
            collect_idents_expr(*o, &out)
        case EIndex(o, i):
            collect_idents_expr(*o, &out)
            collect_idents_expr(*i, &out)
        case EStructLiteral(_n, _fs, args):
            for a in args:
                collect_idents_expr(a, &out)
        case EDotShorthand(_v, args):
            for a in args:
                collect_idents_expr(a.value, &out)
        case EArrayLiteral(els):
            for a in els:
                collect_idents_expr(a, &out)
        case ETupleLiteral(els):
            for a in els:
                collect_idents_expr(a, &out)
        case EIf(c, b, ebs):
            collect_idents_expr(*c, &out)
            collect_idents_stmts(b, &out)
            for eb in ebs:
                if eb.condition is Some(cc):
                    collect_idents_expr(cc, &out)
                collect_idents_stmts(eb.body, &out)
        case EMatch(sc, arms):
            collect_idents_expr(*sc, &out)
            for arm in arms:
                if arm.guard is Some(g):
                    collect_idents_expr(g, &out)
                collect_idents_stmts(arm.body, &out)
        case EClosure(_p, b):
            collect_idents_stmts(b, &out)
        case EBlock(b):
            collect_idents_stmts(b, &out)
        case EDo(b):
            collect_idents_stmts(b, &out)
        case ETry(i):
            collect_idents_expr(*i, &out)
        case EPropagate(i):
            collect_idents_expr(*i, &out)
        case EMutableBorrow(i):
            collect_idents_expr(*i, &out)
        case EDeref(i):
            collect_idents_expr(*i, &out)
        case EAs(i, _t):
            collect_idents_expr(*i, &out)
        case EAwait(i):
            collect_idents_expr(*i, &out)
        case EFString(_t, exprs, _s):
            for a in exprs:
                collect_idents_expr(a, &out)
        else:
            # EMove operand (`!x`) is an explicit move, not an implicit-copy
            # capture — deliberately not recursed. Literals / ESelfExpr / EIt
            # carry no capturable outer local.
            pass

# D12 position 5 (closure capture): reject a captured drop-tainted OUTER
# local (a free variable of the closure defined outside it). No capture-list
# syntax exists yet, so the fix-it is to pass the value as an argument or
# wrap it in `Shared[T]`. Mirrors Rust check_expr.rs:964-996.
void reject_tainted_captures(Vector[Stmt] body, int outer_scope, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    Vector[SpannedExpr] idents = Vector[SpannedExpr]()
    collect_idents_stmts(body, &idents)
    Dict[int, bool] reported = Dict[int, bool]()
    for id_expr in idents:
        if ctx.resolution_map.contains(id_expr.span.start):
            int def_id = ctx.resolution_map.get(id_expr.span.start).unwrap()
            DefInfo d = scopes.get_def(def_id)
            bool is_var = false
            match d.kind:
                case DkVariable():
                    is_var = true
                else:
                    pass
            # A capture is an OUTER local: a DkVariable whose scope is the
            # enclosing (walker) scope or an ancestor of it. Closure params /
            # closure-locals live in a descendant scope and are excluded.
            if is_var and is_drop_tainted_type(d.type_id, scopes, types) and scope_is_ancestor_or_self(scopes, d.scope_id, outer_scope):
                if not reported.contains(def_id):
                    reported.put(def_id, true)
                    ctx.diagnostics.push(Diagnostic.error(id_expr.span, DkMoveWithoutOperator(), drop_taint_message(d.name, 2)))

# Exhaustive statement walker — visits every expression position in a body.
# ═══════════════════════════════════════════════════════════════════════════
# UNIFIED SAFETY WALK — drop-purity (D4/D12) + place-overlap (D10b) + liveness
# (use-after-move / double-move) are ARMS of ONE traversal. Mirrors production's
# src/semantic/safety/ module layout: a single per-function walk that threads the
# move-state alongside the stateless carrier-op rejects. Replaces the former two
# parallel walks (check_carrier_ops_* stateless + check_liveness_* stateful).
#
# Liveness mirrors Rust src/semantic/safety/origins.rs check_move(468)/check_use(25)
# + merge_branch_states(568). The self-host had NO move-tracker, so it accepted
# every use-after-move / double-move that Rust gg + ggdef reject (ggdef
# `Slot::Moved`→IllFormed, eval.rs:745). Closes the divergence for the move shapes:
#   • CallArg.ownership == OWN_MOVE  (`f(!x)`)                  — ast.gg CallArg
#   • EMove wrapping a place         (`S y = !x`, `return !x`)  — parser.gg:2496
#   • `!self`-consuming method receivers + ConsumeCallable-typed callees (Part B)
# Move-state is DEFID-keyed (DEEPDEF): the binding identity is the DefId that
# name-resolution produces at the source (layering rule 2 — a typed fact, not the
# identifier string), so two distinct same-named synthetic bindings never collide.
# state.moved[root_def] = the move site's span.start; presence = moved (Rust
# VarState::Moved). `self` has no DefId (ESelfExpr is unresolved) so it keys on the
# reserved -2 sentinel. Whole-binding granularity (matches production's DkVariable
# filter). Move/read/reinit/rebind read the DefId from the USE's resolution_map
# entry; loop-local seeding reads it from the DECLARATION's resolution_map entry
# (SVarDecl name_span + define_pattern_bindings, both recorded by resolve).
struct SafetyState:
    Dict[int, int] moved        # flow-state: root DefId -> move-site span.start; present = moved
    int loop_depth              # structural loop nesting (saved/restored, NOT branch-cloned)
    Dict[int, int] loop_locals  # DefIds bound INSIDE the current loop (moving these is legal)
    int rebind                  # same-stmt rebind target DefId (`x = f(!x)` self-rebind stays legal); -1 = none

# A per-branch snapshot: the flow-state `moved` and the loop-local set are
# DEEP-cloned so a branch's moves/reinits never leak into a sibling or the parent
# join; loop_depth (int) and rebind (String) copy by value. This is the branched
# flow-state clone Rust does implicitly per BranchState.
SafetyState safety_snapshot(SafetyState state):
    return SafetyState(state.moved.clone(), state.loop_depth, state.loop_locals.clone(), state.rebind)

# DEEPDEF: the liveness key of a place's ROOT binding. `self` -> the -2 sentinel
# (distinct from real DefIds >=0 and NO_DEF=-1 — safe because SafetyState is
# fresh per function so there is exactly one self per state). A non-place / global
# / function root, or an unresolved use -> -1 (untrackable, never enters `moved`).
# This is the write-site DefId (layering rule 2): identity comes from the typed
# resolution_map, not the identifier string.
int live_root_key(SpannedExpr place, ScopeTable scopes, ResolveContext ctx):
    if place_root_name(place.expr) == "self":
        return -2
    if place_root_def_spanned(place, scopes, ctx) is Some(rdid):
        match scopes.get_def(rdid).kind:
            case DkVariable():
                return rdid
            else:
                return -1
    return -1

# Rust check_use (origins.rs:25): a read of a moved place is use-after-move.
# `key` is the DefId of the place's root (self -> -2); `name` is only for the message.
void live_check_use(int key, String name, Span span, SafetyState state, ResolveContext &ctx):
    if key == -1:
        return
    if state.moved.contains(key):
        ctx.diagnostics.push(Diagnostic.error(span, DkUseAfterMove(), f"use of `{name}` after it was moved"))

# Re-init a binding to Live (Rust mark_live): a fresh `SVarDecl`/`SAssign` of the
# whole binding makes it usable again. Isolated in a SMALL helper on purpose —
# the discarded `Dict[_,int].remove` result is an `Option[int]`, and threading the
# discard through the large `check_safety_stmt` frame trips a latent Rust-gg
# C-backend coalesce miscompile (Option[int] slot stored an int32 0). Keeping the
# discard in a tiny function sidesteps the coalesce path. (Bug filed — own track.)
void live_reinit(SafetyState &state, int key):
    if key == -1:
        return
    if state.moved.contains(key):
        state.moved.remove(key)

# Rust check_move (origins.rs:468): mark a move site; a second move of an
# already-moved place is a double move. Only whole-binding locals/params/self
# are tracked (Rust's DkVariable filter); a non-place move (`!f()`) has no root.
void live_mark_move(SpannedExpr place, SafetyState &state, ScopeTable scopes, ResolveContext &ctx):
    String root = place_root_name(place.expr)
    if root == "<place>":
        return
    # DEEPDEF: key the move-state by the root binding's DefId (typed identity),
    # not its name — two distinct same-named synthetic bindings (e.g. `case
    # Some(x)` in sibling match arms) must NOT collide. `root` name is kept only
    # for the human-readable diagnostic.
    int root_def = live_root_key(place, scopes, ctx)
    if root_def == -1:
        return
    if state.moved.contains(root_def):
        ctx.diagnostics.push(Diagnostic.error(place.span, DkDoubleMove(), f"`{root}` moved more than once (double move)"))
        return
    # PART C (Rust check_move, origins.rs:495-503): moving an ENCLOSING-scope place
    # inside a loop re-moves it on the next iteration — a static MoveInLoop reject.
    # Exempt: a loop-local (declared / re-init inside the innermost loop body, via
    # live_reinit's loop_locals population) and the same-statement rebind target
    # (`acc = bump(!acc)`, whose move feeds the immediate re-init). loop_depth is 0
    # outside any loop, so this is dormant on straight-line code.
    if state.loop_depth > 0 and not state.loop_locals.contains(root_def) and root_def != state.rebind:
        ctx.diagnostics.push(Diagnostic.error(place.span, DkMoveInLoop(), f"cannot move `{root}` out of an enclosing scope inside a loop — it would be used-after-move on the next iteration"))
        return
    state.moved.set(root_def, place.span.start)

# A branch whose last stmt is a control-flow exit never reaches the join, so its
# move-state is excluded from the merge (Rust merge_branch_states filters
# `s.diverges`, origins.rs:574). Divergence is RECURSIVE: an `if`/`match` whose
# every arm diverges also diverges (Rust sets BranchState.diverges when all
# merged branches diverge). Over-reporting divergence only under-detects (never
# a false positive), so this is purely anti-over-rejection.
bool live_stmts_diverge(Vector[Stmt] stmts):
    if stmts.len() == 0:
        return false
    return live_stmt_diverges(stmts.get(stmts.len() - 1).unwrap())

bool live_stmt_diverges(Stmt s):
    match s:
        case SReturn(_):
            return true
        case SThrow(_):
            return true
        case SBreak():
            return true
        case SContinue():
            return true
        case SIf(_cond, body, else_branches):
            # Diverges iff the then-body AND every else-branch body diverge AND
            # there is an unconditional else (else the no-branch path falls through).
            if not live_stmts_diverge(body):
                return false
            bool has_unconditional_else = false
            for eb in else_branches:
                if not live_stmts_diverge(eb.body):
                    return false
                if eb.condition is None:
                    has_unconditional_else = true
            return has_unconditional_else
        case SMatch(_scrut, arms):
            # A match is exhaustive (typecheck enforces it), so it diverges iff
            # every arm body diverges.
            if arms.len() == 0:
                return false
            for arm in arms:
                if not live_stmts_diverge(arm.body):
                    return false
            return true
        else:
            return false

# Collect the DefIds a pattern introduces (Rust mark_pattern_bindings →
# mark_live). Mirrors resolve.gg's define_pattern_bindings enumeration. DEEPDEF:
# reads each binding's DefId from resolution_map[pattern.span.start] (recorded at
# the DECLARATION by define_pattern_bindings) so loop-local seeding is DefId-keyed
# and consistent with the DefId-keyed move check.
void collect_pattern_defs_into(SpannedPattern pattern, ResolveContext ctx, Vector[int] &out):
    match pattern.pat:
        case PBinding(_name):
            if ctx.resolution_map.contains(pattern.span.start):
                out.push(ctx.resolution_map.get(pattern.span.start).unwrap())
        case PConstructor(_, fields):
            for field in fields:
                collect_pattern_defs_into(field, ctx, &out)
        case PDotShorthand(_, fields):
            for field in fields:
                collect_pattern_defs_into(field, ctx, &out)
        case PTuple(elements):
            for elem in elements:
                collect_pattern_defs_into(elem, ctx, &out)
        case POr(alternatives):
            if alternatives.len() > 0:
                collect_pattern_defs_into(alternatives.get(0).unwrap(), ctx, &out)
        else:
            pass

# Collect the `is`-pattern binding DefIds a boolean condition introduces into its
# guarded branch (`if x is Some(e):` binds `e` in the then-body), recursing the
# and/or/not tree. Over-collecting only ever UNDER-detects a MoveInLoop (adds a
# spurious loop-local) — never a false positive — so a negated `is` is included.
void collect_is_defs_into(SpannedExpr cond, ResolveContext ctx, Vector[int] &out):
    match cond.expr:
        case EIs(_inner, _neg, pat):
            collect_pattern_defs_into(*pat, ctx, &out)
        case EBinaryOp(l, _op, r):
            collect_is_defs_into(*l, ctx, &out)
            collect_is_defs_into(*r, ctx, &out)
        case EUnaryOp(_op, o):
            collect_is_defs_into(*o, ctx, &out)
        else:
            pass

# Walk one alternative branch on a snapshot of the pre-branch state; if it reaches
# the join, fold its NEW moves into `acc`. The union across branches is "moved in
# any branch → moved after" (Rust merge, origins.rs:609). `pat_names` are the
# pattern bindings this branch introduces (match arm / `is`-condition) — inside a
# loop they are loop-local (re-bound each iteration), so seed them.
bool safety_branch(Vector[Stmt] body, Vector[int] pat_defs, int scope_id, SafetyState state, Dict[int, int] &acc, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    SafetyState b = safety_snapshot(state)
    if b.loop_depth > 0:
        for pd in pat_defs:
            b.loop_locals.set(pd, 1)
    check_safety_stmts(body, scope_id, &b, &scopes, &types, &ctx)
    if live_stmts_diverge(body):
        return false
    # Fold this branch's END-state (a re-init inside the branch already dropped
    # its key from `b.moved`, so this is the moved-set as it reaches the join)
    # into the running union. `acc` therefore ends as the union over all
    # reaching branches — "moved in at least one reaching branch".
    for k in b.moved.keys():
        if not acc.contains(k):
            acc.set(k, b.moved.get(k).unwrap())
    return true

# Commit the branch join. `acc` is the union of the moved-sets of the branches
# that REACH the join (their full end-states — a branch that re-inits a var has
# already dropped it, and one that leaves a pre-branch move untouched still
# carries it). A var is moved after the construct iff it is moved on at least
# one path that reaches the join. When some path SKIPS every branch (an `if`
# with no unconditional `else`, or a `match` with no catch-all arm), that
# fall-through path carries the PRE-branch state, so union it in too. Then
# REPLACE `state.moved` with the union — this is what lets a
# move-then-reinit-in-ALL-arms clear a pre-existing move (the old ADD-only
# commit could never DROP a key, so it falsely kept the pre-branch move and
# over-rejected the join use). Mirrors Rust merge_branch_states
# (origins.rs:568-617): the merged state IS the live branches' end-states,
# "moved in any = moved", with `before` pushed as an extra branch when there
# is no explicit else (check_stmt.rs:1168-1170 / 1221-1223). If NO path
# reaches the join (every branch diverges AND there is no fall-through), the
# join is dead code — leave the state untouched (production keeps states[0]).
void safety_commit(Dict[int, int] acc, bool has_fallthrough, bool any_reached, SafetyState &state):
    if not has_fallthrough and not any_reached:
        return
    Dict[int, int] merged = acc.clone()
    if has_fallthrough:
        for k in state.moved.keys():
            if not merged.contains(k):
                merged.set(k, state.moved.get(k).unwrap())
    state.moved = merged

# True iff a `match` arm list has an UNGUARDED catch-all (`PWildcard` /
# `PBinding`). The parser desugars an explicit `else:` to
# `MatchArm(PWildcard, None, body)`, and `case _:` / `case x:` are catch-alls
# too — any of them guarantees every scrutinee value matches SOME arm, so no
# path skips the match (no fall-through). Conservative by construction: a
# variant-exhaustive match with NO catch-all returns false → the join keeps the
# pre-branch fall-through, exactly as production does for a match with no
# explicit `else_arm` (check_stmt.rs:1217-1223).
bool match_has_catch_all(Vector[MatchArm] arms):
    for arm in arms:
        if arm.guard is None:
            match arm.pattern.pat:
                case PWildcard():
                    return true
                case PBinding(_):
                    return true
                else:
                    pass
    return false

# True iff an if/elif chain has an UNCONDITIONAL `else` (an ElseBranch with no
# condition) — then every path is covered by a branch and there is no
# fall-through. Mirrors production pushing `before` only when `else_body` is
# None (check_stmt.rs:1164-1170).
bool elsebranches_have_uncond(Vector[ElseBranch] ebs):
    for eb in ebs:
        if eb.condition is None:
            return true
    return false

# PART C: precise loop-body handling (Rust origins.rs:495-503 + check_stmt.rs:988-1022).
# Walk the body IN-PLACE at loop_depth+1 with a FRESH innermost loop_locals set
# (mirrors loop_local_defs.push(empty) — only vars declared/re-init INSIDE this
# loop body are loop-local, so an outer var moved here is a MoveInLoop, fired in
# live_mark_move). After the body, union the pre-loop and post-body move-sets: the
# loop may run 0 times, so a body-move only "maybe" happens, but a pre-loop move
# stays moved (Rust merge_branch_states([before, after_body])). loop_depth,
# loop_locals and rebind are saved/restored so the loop context never leaks past
# the loop (mirrors the push/pop of loop_local_defs).
void safety_loop_body(Vector[Stmt] body, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    int saved_depth = state.loop_depth
    Dict[int, int] saved_locals = state.loop_locals.clone()
    int saved_rebind = state.rebind
    Dict[int, int] before = state.moved.clone()
    state.loop_depth = saved_depth + 1
    state.loop_locals = Dict[int, int]()
    # D29: a loop body drops its tail statement's value every iteration — the
    # classic silent-Error-drop-per-iteration shape; a bare fallible tail here is
    # a discard (`while c: risky(x)`).
    bool saved_tail_dropped = ctx.d29_tail_dropped
    ctx.d29_tail_dropped = true
    check_safety_stmts(body, scope_id, &state, &scopes, &types, &ctx)
    ctx.d29_tail_dropped = saved_tail_dropped
    state.loop_depth = saved_depth
    state.loop_locals = saved_locals
    state.rebind = saved_rebind
    for k in before.keys():
        if not state.moved.contains(k):
            state.moved.set(k, before.get(k).unwrap())

# A move consumes the whole place; do not also count it as a read. `!f()` (a
# non-place move) has no root — walk its sub-exprs for nested uses instead.
void live_move_operand(SpannedExpr place, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    if place_root_name(place.expr) == "<place>":
        check_safety_expr(place, scope_id, &state, &scopes, &types, &ctx)
    else:
        live_mark_move(place, &state, scopes, &ctx)

# PART B: is `e` a ConsumeCallable-typed value? A call `f()` where `f` is
# ConsumeCallable CONSUMES `f` (single-owner-by-design carve-out — no clone
# path). Mirrors Rust `is_consume_callable_var` (helpers.rs:423). Typed axis
# (layering rule 2): matches the RTConsumeCallableTrait / boxed-ConsumeCallable
# ResolvedType — never a name/shape heuristic.
bool live_is_consume_callable(SpannedExpr e, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    int t = infer_expr_type(e, scopes, &types, &ctx)
    if t < 0 or t >= types.types.len():
        return false
    ResolvedType rt = get_rtype_at(types.types, t)
    match rt:
        case RTConsumeCallableTrait(_):
            return true
        case RTBoxedCallable(kind_name, _):
            return kind_name == "ConsumeCallable"
        else:
            return false

# ── The unified walk. Each Stmt/Expr arm runs BOTH the stateless carrier-op
# rejects (D4/D12 drop-purity, `??`/`*x`) AND the stateful liveness update
# (moves, reads, branch join) in ONE traversal. `scope_id` STAYS an ambient int
# (constant per function body — it never branches). Adding a new safety axis =
# add a SafetyState field + touch the relevant arms; the traversal is shared.
# Loops use PRECISE MoveInLoop tracking (`safety_loop_body`, PART C below): the body
# walks at loop_depth+1 with a fresh innermost loop_locals set, then the pre-loop and
# post-body move-sets are UNIONED (0-iteration safety; a body move stays moved after
# the loop) — mirroring production `origins.rs`. A move of an outer (non-loop-local,
# non-same-stmt-rebound) place inside a loop is a MoveInLoop reject (live_mark_move).
void check_safety_stmts(Vector[Stmt] stmts, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    int n = stmts.len()
    for (i, s) in stmts.enumerate():
        # D29 bare-discard: a bare fallible call whose outcome is DROPPED. A
        # non-tail statement always drops its value; a TAIL statement drops it
        # only in a value-drop block (`ctx.d29_tail_dropped`: a fn/loop body).
        # In a VALUE block (EBlock/EDo/closure/expr-arm, tail_dropped=false) the
        # tail IS the block's value — a legal kind-2 value flow, never a discard.
        match s:
            case SExpr(sexpr):
                bool is_last = i == n - 1
                if (not is_last) or ctx.d29_tail_dropped:
                    d29_reject_if_bare_fallible(sexpr, &ctx)
            else:
                pass
        # Round XXVIII Track C — a TAIL `SExpr(EMove(_))` in a VALUE block
        # (closure body / EBlock / EDo / expr-match-arm — `d29_tail_dropped` is
        # false) is the block's RETURN value at a RESTING boundary. Suppress
        # E_MoveInOperandPosition for that tail-stmt walk so `(): !s` (closure
        # tail Move) legit-moves at the closure return boundary. Direct-Move
        # only (matches Rust `check_stmt::Return`-style direct suppress); a
        # tail `!x + y` compound REJECTS through the recursive descent.
        bool saved_supp_tail_move = ctx.suppress_move_in_operand_position
        bool is_last_stmt = i == n - 1
        if is_last_stmt and not ctx.d29_tail_dropped:
            match s:
                case SExpr(tail_e):
                    match tail_e.expr:
                        case EMove(_move_inner):
                            ctx.suppress_move_in_operand_position = true
                        else:
                            pass
                else:
                    pass
        check_safety_stmt(s, scope_id, &state, &scopes, &types, &ctx)
        ctx.suppress_move_in_operand_position = saved_supp_tail_move

void check_safety_stmt(Stmt s, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match s:
        case SVarDecl(stype, name, init_expr, _own, _sk, name_span):
            check_local_borrow_bind(init_expr, &ctx)
            # D29 bind position: Result-capture (unmarked, legal) vs mark+capture
            # (redundant) vs kind-1-to-non-Result (mark required).
            d29_check_bind(stype, init_expr, &ctx)
            # D12 position 1 (bind): a bare bind of a live drop-tainted place.
            reject_tainted_place(init_expr, scopes, &types, &ctx)
            # Single-owner init class (bind): a bare callable/Box/Task copy at a
            # bind boundary. PARAM-EXEMPT (rebinding a param copies a pointer).
            reject_single_owner_init(init_expr, true, scopes, types, &ctx)
            bool saved_rcap = ctx.d29_in_result_capture
            if d29_stype_is_result(stype):
                ctx.d29_in_result_capture = true
            # D32 (mirrors Rust `src/semantic/safety/check_stmt.rs` Option-D
            # pivot): a direct top-level `&`-init (`S x = &b`) is D10(a) territory
            # — `check_local_borrow_bind` above owns the `E_LocalBorrowBind`
            # message. Suppress the operand-position emit on THIS walk so it
            # doesn't double-message; the inner-place recursion still runs so
            # aliasing/liveness bookkeeping is unaffected. Compound-shape
            # borrow-binds (`int x = if c: &a else: &b`, `match … case P: &y`,
            # `do: &a`, `{ ...; &a }`) reach EMutableBorrow via branches / arms /
            # block tails — the same `expr_is_borrow_bind` predicate covers them
            # here so the operand-position walker doesn't double-message either
            # (Round XXVIII Track D; mirrors Rust safety
            # `suppress_amp_in_operand_position` bracket).
            bool saved_supp_vd = ctx.suppress_amp_in_operand_position
            if expr_is_borrow_bind(init_expr):
                ctx.suppress_amp_in_operand_position = true
            # Round XXVIII Track C — SVarDecl RHS is D32 RESTING /
            # consuming-boundary; suppress E_MoveInOperandPosition for the
            # DIRECT top-level EMove RHS (mirrors Rust check_stmt VarDecl and
            # the sibling MutableBorrow intercept above).
            bool saved_supp_vd_move = ctx.suppress_move_in_operand_position
            match init_expr.expr:
                case EMove(_move_inner):
                    ctx.suppress_move_in_operand_position = true
                else:
                    pass
            check_safety_expr(init_expr, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_vd_move
            ctx.suppress_amp_in_operand_position = saved_supp_vd
            ctx.d29_in_result_capture = saved_rcap
            # Liveness: a fresh binding makes its DefId live again (Rust mark_live);
            # inside a loop it is a loop-local (re-created each iteration → moving it
            # is legal, Rust mark_live adds it to loop_local_defs.last). DEEPDEF: the
            # binding's DefId is read from resolution_map[name_span], recorded at the
            # DECLARATION (parser now emits a real name_span for a whole-binding decl).
            int decl_def = -1
            if name_span >= 0 and ctx.resolution_map.contains(name_span):
                decl_def = ctx.resolution_map.get(name_span).unwrap()
            live_reinit(&state, decl_def)
            if decl_def >= 0 and state.loop_depth > 0:
                state.loop_locals.set(decl_def, 1)
        case SAssign(target, value):
            check_local_borrow_bind(value, &ctx)
            # D12 position 1 (assign): a bare assign of a live drop-tainted place.
            reject_tainted_place(value, scopes, &types, &ctx)
            # Single-owner init class (reassign): a bare callable/Box/Task copy at
            # a whole-reassign boundary. PARAM-EXEMPT (same as bind).
            reject_single_owner_init(value, true, scopes, types, &ctx)
            # D12 position 6 (materialize-on-write via field/index write):
            # `s.id = 9` through a bare BORROW param of a drop-tainted type.
            reject_materialize_on_write(target, scopes, types, &ctx)
            # PART C: record the same-statement rebind target so a `acc = bump(!acc)`
            # left-fold inside a loop is NOT flagged MoveInLoop — the move feeds the
            # immediate re-init (Rust assignment_rebind_target). Set it only for the
            # RHS walk (where the move happens), then restore.
            # DEEPDEF: the rebind target's DefId comes from the target IDENTIFIER's
            # USE resolution (place_root_def_spanned) — a whole-binding assign target
            # is a resolvable use. -1 = not a plain identifier (field/index write).
            int saved_rebind = state.rebind
            int target_def = -1
            match target.expr:
                case EIdentifier(_rnm):
                    if place_root_def_spanned(target, scopes, ctx) is Some(td):
                        target_def = td
                else:
                    pass
            if target_def >= 0:
                state.rebind = target_def
            # D32: `&`-assign RHS — D10(a) owns the reject message (see SVarDecl
            # comment above). `expr_is_borrow_bind` covers direct top-level +
            # compound-shape (`x = if c: &a else: &b`, match/do/block tails);
            # mirrors Rust safety `suppress_amp_in_operand_position` bracket
            # (Round XXVIII Track D).
            bool saved_supp_as = ctx.suppress_amp_in_operand_position
            if expr_is_borrow_bind(value):
                ctx.suppress_amp_in_operand_position = true
            # Round XXVIII Track C — SAssign RHS is D32 RESTING /
            # consuming-boundary; suppress E_MoveInOperandPosition for the
            # DIRECT top-level EMove RHS (mirrors SVarDecl).
            bool saved_supp_as_move = ctx.suppress_move_in_operand_position
            match value.expr:
                case EMove(_move_inner):
                    ctx.suppress_move_in_operand_position = true
                else:
                    pass
            # Liveness: read the RHS (source still live) BEFORE re-initialising the
            # target, so `x = f(x)` reads the old `x` then rebinds it.
            check_safety_expr(value, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_as_move
            ctx.suppress_amp_in_operand_position = saved_supp_as
            state.rebind = saved_rebind
            match target.expr:
                case EIdentifier(_nm):
                    # Whole-binding rebind → live again (Rust mark_live); a rebind
                    # inside a loop makes the target loop-local too.
                    live_reinit(&state, target_def)
                    if target_def >= 0 and state.loop_depth > 0:
                        state.loop_locals.set(target_def, 1)
                else:
                    # Field/index write (`p.f = ...`) reads the root.
                    check_safety_expr(target, scope_id, &state, &scopes, &types, &ctx)
        case SCompoundAssign(target, _op, value):
            # D12 position 6 (materialize-on-write via compound field/index write).
            reject_materialize_on_write(target, scopes, types, &ctx)
            # A compound assign READS the target (uses the old value) — a moved
            # target here is a use-after-move.
            check_safety_expr(target, scope_id, &state, &scopes, &types, &ctx)
            check_safety_expr(value, scope_id, &state, &scopes, &types, &ctx)
        case SExpr(sexpr):
            # D29 bare-discard is enforced in `check_safety_stmts` (index-aware:
            # a discard is a non-tail statement, or a tail in a value-drop block).
            check_safety_expr(sexpr, scope_id, &state, &scopes, &types, &ctx)
        case SReturn(opt_expr):
            if opt_expr is Some(sexpr):
                # D12 position 4 (return + expr-body-fn tail, both normalize to
                # SReturn): a bare return of a live drop-tainted place copies at
                # the return ownership boundary.
                reject_tainted_place(sexpr, scopes, &types, &ctx)
                # D29 residual (e): dest-aware bare-fallible on return/expr-body.
                d29_reject_bare_on_return(sexpr, &ctx)
                # Round XXVIII Track C — SReturn value is D32 RESTING /
                # consuming-boundary; suppress E_MoveInOperandPosition for the
                # DIRECT top-level EMove RHS (mirrors SVarDecl/SAssign; mirror
                # of Rust check_stmt::Return direct-Move suppress).
                bool saved_supp_ret_move = ctx.suppress_move_in_operand_position
                match sexpr.expr:
                    case EMove(_move_inner):
                        ctx.suppress_move_in_operand_position = true
                    else:
                        pass
                check_safety_expr(sexpr, scope_id, &state, &scopes, &types, &ctx)
                ctx.suppress_move_in_operand_position = saved_supp_ret_move
        case SThrow(sexpr):
            # Round XXVIII Track C — SThrow value is D32 RESTING /
            # consuming-boundary (per scout: handler consumes at boundary;
            # filed as owner sub-question, default ALLOW).
            bool saved_supp_throw_move = ctx.suppress_move_in_operand_position
            match sexpr.expr:
                case EMove(_move_inner):
                    ctx.suppress_move_in_operand_position = true
                else:
                    pass
            check_safety_expr(sexpr, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_throw_move
        case SBreak():
            pass
        case SContinue():
            pass
        case SPass():
            pass
        case SMeta():
            pass
        case SMetaFor(_vars, iter_e, body):
            check_safety_expr(iter_e, scope_id, &state, &scopes, &types, &ctx)
            SafetyState mfc = safety_snapshot(state)
            check_safety_stmts(body, scope_id, &mfc, &scopes, &types, &ctx)
        case SMetaIf(cond, body, else_branches):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
            Dict[int, int] mi_acc = Dict[int, int]()
            bool mi_reached = safety_branch(body, Vector[int](), scope_id, state, &mi_acc, &scopes, &types, &ctx)
            for eb in else_branches:
                if eb.condition is Some(c):
                    check_safety_expr(c, scope_id, &state, &scopes, &types, &ctx)
                bool mi_eb_reached = safety_branch(eb.body, Vector[int](), scope_id, state, &mi_acc, &scopes, &types, &ctx)
                mi_reached = mi_reached or mi_eb_reached
            safety_commit(mi_acc, not elsebranches_have_uncond(else_branches), mi_reached, &state)
        case SMetaConst(_name, value):
            check_safety_expr(value, scope_id, &state, &scopes, &types, &ctx)
        case SMetaForMatch(_vars, scrut, arms):
            check_safety_expr(scrut, scope_id, &state, &scopes, &types, &ctx)
            for arm in arms:
                if arm.guard is Some(g):
                    check_safety_expr(g, scope_id, &state, &scopes, &types, &ctx)
                SafetyState mfm = safety_snapshot(state)
                check_safety_stmts(arm.body, scope_id, &mfm, &scopes, &types, &ctx)
        case SMetaMatch(scrut, meta_arms, default_body):
            check_safety_expr(scrut, scope_id, &state, &scopes, &types, &ctx)
            for ma in meta_arms:
                check_safety_expr(ma.case_value, scope_id, &state, &scopes, &types, &ctx)
                SafetyState mmc = safety_snapshot(state)
                check_safety_stmts(ma.body, scope_id, &mmc, &scopes, &types, &ctx)
            SafetyState mmd = safety_snapshot(state)
            check_safety_stmts(default_body, scope_id, &mmd, &scopes, &types, &ctx)
        case SMetaWhile(cond, body):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
            SafetyState mwc = safety_snapshot(state)
            check_safety_stmts(body, scope_id, &mwc, &scopes, &types, &ctx)
        case SFor(_pat, iter_e, body, _flags, else_body):
            # D32 strip: `for x in &coll` / `for i, x in &coll.enumerate()` —
            # the `&` is a BOUNDARY, not an operand.
            check_iterable_maybe_amp(iter_e, scope_id, &state, &scopes, &types, &ctx)
            # PART C precise loop body (the for-pattern binding is NOT loop-local —
            # moving the loop variable IS a MoveInLoop, matching production).
            safety_loop_body(body, scope_id, &state, &scopes, &types, &ctx)
            check_safety_stmts(else_body, scope_id, &state, &scopes, &types, &ctx)
        case SWhile(cond, body, else_body):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
            safety_loop_body(body, scope_id, &state, &scopes, &types, &ctx)
            check_safety_stmts(else_body, scope_id, &state, &scopes, &types, &ctx)
        case SLoop(body):
            safety_loop_body(body, scope_id, &state, &scopes, &types, &ctx)
        case SIf(cond, body, else_branches):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
            Vector[int] then_binds = Vector[int]()
            collect_is_defs_into(cond, ctx, &then_binds)
            Dict[int, int] if_acc = Dict[int, int]()
            bool if_reached = safety_branch(body, then_binds, scope_id, state, &if_acc, &scopes, &types, &ctx)
            for eb in else_branches:
                Vector[int] eb_binds = Vector[int]()
                if eb.condition is Some(c):
                    check_safety_expr(c, scope_id, &state, &scopes, &types, &ctx)
                    collect_is_defs_into(c, ctx, &eb_binds)
                bool if_eb_reached = safety_branch(eb.body, eb_binds, scope_id, state, &if_acc, &scopes, &types, &ctx)
                if_reached = if_reached or if_eb_reached
            safety_commit(if_acc, not elsebranches_have_uncond(else_branches), if_reached, &state)
        case SMatch(scrut, arms):
            # D29 marked-match peel: `match f()!: case Ok/Error` — the mark peeled
            # the Result to `T`, so Result-variant arms cannot match. T-variant
            # arms (snag48) stay legal and RUN.
            d29_check_match_peel(scrut, arms, &ctx)
            check_safety_expr(scrut, scope_id, &state, &scopes, &types, &ctx)
            Dict[int, int] m_acc = Dict[int, int]()
            bool m_reached = false
            for arm in arms:
                if arm.guard is Some(g):
                    check_safety_expr(g, scope_id, &state, &scopes, &types, &ctx)
                Vector[int] arm_binds = Vector[int]()
                collect_pattern_defs_into(arm.pattern, ctx, &arm_binds)
                bool arm_reached = safety_branch(arm.body, arm_binds, scope_id, state, &m_acc, &scopes, &types, &ctx)
                m_reached = m_reached or arm_reached
            safety_commit(m_acc, not match_has_catch_all(arms), m_reached, &state)
        case SWith(e, _name, body):
            check_safety_expr(e, scope_id, &state, &scopes, &types, &ctx)
            check_safety_stmts(body, scope_id, &state, &scopes, &types, &ctx)
        case SAssert(cond, _msg):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
        case SAssertReturn(cond, _msg):
            check_safety_expr(cond, scope_id, &state, &scopes, &types, &ctx)
        case SNamedScope(_name, body):
            check_safety_stmts(body, scope_id, &state, &scopes, &types, &ctx)
        case SSelect(arms):
            for sa in arms:
                match sa.op:
                    case SORecv(_n, _i, e):
                        check_safety_expr(e, scope_id, &state, &scopes, &types, &ctx)
                    case SOSend(chan, val):
                        check_safety_expr(chan, scope_id, &state, &scopes, &types, &ctx)
                        check_safety_expr(val, scope_id, &state, &scopes, &types, &ctx)
                SafetyState sel = safety_snapshot(state)
                check_safety_stmts(sa.body, scope_id, &sel, &scopes, &types, &ctx)
        case SOnError(body):
            check_safety_stmts(body, scope_id, &state, &scopes, &types, &ctx)
        case SItem(_item):
            # Nested item decls (fn/struct/…) are walked via their own
            # type_check_function entry; no expression here to check.
            pass
        case SSnapshot(_name, _kind, e):
            check_safety_expr(e, scope_id, &state, &scopes, &types, &ctx)

# D32 iterable-strip chokepoint (Core #4 one-producer; mirrors Rust
# `src/semantic/safety/check_expr.rs:182-205` `check_iterable_maybe_amp`).
# `for x in &coll` / `for i, x in &coll.enumerate()` / `[expr for x in &coll]`
# are legit write-through-iterable spellings — the `&` here is a BOUNDARY
# (opens the collection for write-through), not an operand. Peel the outer
# `EMutableBorrow` wrapper (and its `.enumerate()`-receiver costume) BEFORE
# recursing so `check_safety_expr`'s `EMutableBorrow` arm does not false-flag.
# Called from SFor + all 3 comprehension iterable sites; a 5th iterable site
# added without going through this helper would silently re-open the false-
# positive class — the `sh_amp_operand_reject_sites_count` lint counts these
# call sites to prevent drift.
void check_iterable_maybe_amp(SpannedExpr iter_e, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match iter_e.expr:
        case EMutableBorrow(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        # Round XXVIII Track C R3 — `[expr for x in !coll]` (comprehension):
        # the comprehension parser places the ownership modifier before `in`
        # so a `!` in a comprehension iterable lands as `EMove` on the
        # iterable. Drain iterables are a BOUNDARY position (D32 RESTING;
        # the container consumes) — peel EMove here so `check_safety_expr`'s
        # `EMove` arm does not false-flag as an operand-position reject.
        case EMove(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EMethodCall(recv, mname, args, targs):
            if mname == "enumerate" and args.len() == 0 and targs.len() == 0:
                match (*recv).expr:
                    case EMutableBorrow(recv_inner):
                        check_safety_expr(*recv_inner, scope_id, &state, &scopes, &types, &ctx)
                    case EMove(recv_inner):
                        # R3 sibling: `.enumerate()` on `!coll` — same strip.
                        check_safety_expr(*recv_inner, scope_id, &state, &scopes, &types, &ctx)
                    else:
                        check_safety_expr(iter_e, scope_id, &state, &scopes, &types, &ctx)
            else:
                check_safety_expr(iter_e, scope_id, &state, &scopes, &types, &ctx)
        else:
            check_safety_expr(iter_e, scope_id, &state, &scopes, &types, &ctx)

# Exhaustive expression walker — mirrors resolve.gg's `resolve_expr` enumeration.
# Visits EVERY sub-expression so no reject/liveness site escapes via an
# un-recursed parent shape.
void check_safety_expr(SpannedExpr expr, int scope_id, SafetyState &state, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match expr.expr:
        case EIntLiteral(_):
            pass
        case EFloatLiteral(_):
            pass
        case EBoolLiteral(_):
            pass
        case EStringLiteral(_, _):
            pass
        case ECharLiteral(_):
            pass
        case ENoneLiteral():
            pass
        case EIdentifier(name):
            # Liveness: a read of a moved place is use-after-move. DEEPDEF: key by
            # the use's DefId (resolution_map) — an unresolved/global name -> -1 skip.
            int use_key = -1
            if ctx.resolution_map.contains(expr.span.start):
                use_key = ctx.resolution_map.get(expr.span.start).unwrap()
            live_check_use(use_key, name, expr.span, state, &ctx)
        case ESelfExpr():
            live_check_use(-2, "self", expr.span, state, &ctx)
        case EIt():
            pass
        case EBinaryOp(left, op, right):
            check_safety_expr(*left, scope_id, &state, &scopes, &types, &ctx)
            check_safety_expr(*right, scope_id, &state, &scopes, &types, &ctx)
            if op == "??":
                check_default_op_lhs(SpannedExpr((*left).expr, (*left).span), scope_id, scopes, &types, &ctx)
                check_default_op_rhs(SpannedExpr((*left).expr, (*left).span), SpannedExpr((*right).expr, (*right).span), scope_id, scopes, &types, &ctx)
            # E_UnsupportedOperator for arith / bitwise binary ops (Rust
            # BinaryOp arm, compound=false). Non-arith ops (`==`, `and`, `in`,
            # `??`) fall through operator_supported_for_type as supported.
            String bin_base = arith_base_op(op)
            if op_trait_name(bin_base) != "" or is_integer_only_op(bin_base):
                int left_ty = infer_expr_type(SpannedExpr((*left).expr, (*left).span), scopes, &types, &ctx)
                check_operator_supported(left_ty, op, false, expr.span, scopes, &types, &ctx)
        case EUnaryOp(_op, operand):
            check_safety_expr(*operand, scope_id, &state, &scopes, &types, &ctx)
        case ECall(callee, args, _targs):
            # STEP 1 (pass-order rider — liveness precedes aliasing): callee
            # liveness + ConsumeCallable-consume (Part B). A call to a
            # ConsumeCallable-typed var CONSUMES it; marking via live_mark_move
            # both records the move AND catches a second call (`f(); f()`) as a
            # double-move, so we skip the plain callee read when consumed.
            bool live_consumed = false
            match (*callee).expr:
                case EIdentifier(_):
                    if live_is_consume_callable(*callee, scopes, &types, &ctx):
                        live_mark_move(*callee, &state, scopes, &ctx)
                        live_consumed = true
                else:
                    pass
            if not live_consumed:
                check_safety_expr(*callee, scope_id, &state, &scopes, &types, &ctx)
            # STEP 2: per-arg loop, left-to-right — liveness move/use + the D12
            # position-2 ctor/field-init reject (a BARE drop-tainted place used as
            # a constructor arg copies at the init boundary; `W(!x)` / `W(&x)` skip
            # the gate). Mirrors Rust gg (src/semantic/safety/helpers.rs:1129).
            bool call_is_ctor = is_ctor_callee(*callee, scopes, ctx)
            for a in args:
                if a.ownership == OWN_MOVE:
                    live_move_operand(a.value, scope_id, &state, &scopes, &types, &ctx)
                else:
                    if call_is_ctor and a.ownership == OWN_BORROW:
                        reject_tainted_place(a.value, scopes, &types, &ctx)
                        # Single-owner init class (ctor / enum-variant): a bare
                        # callable/Box/Task ctor arg. NO param exemption at an
                        # init boundary (a param IS rejected here).
                        reject_single_owner_init(a.value, false, scopes, types, &ctx)
                    # 2T FORMATION: a `&`-arg (`f(&s.field)`, `f(&self)`, `f(&p)`)
                    # materialises the projection/whole ROOT — reject a tainted
                    # plain-self / bare-Borrow-param root (mirror Rust
                    # `reject_tainted_formation_arg`; `&*deref` has no trackable
                    # root, so it self-excludes via `place_root_name`).
                    if a.ownership == OWN_MUTABLE:
                        bool _rf = reject_if_tainted_materialize_root(a.value, scopes, types, &ctx)
                    check_safety_expr(a.value, scope_id, &state, &scopes, &types, &ctx)
            # STEP 3: D10(b) same-call place-overlap (args only, not callee), with
            # Part A's skip-move-first — runs AFTER liveness so `f(!x,!x)` is a
            # double-move (liveness) preempting the overlap arm.
            check_call_aliasing(args, scopes, &types, &ctx)
        case EMethodCall(receiver, method_name, args, _targs):
            # STEP 1: receiver liveness (read) + the D12 pos-6 `&self`-mutator
            # reject + the `!self`-consume — ALL before the arg loop. Marking the
            # receiver moved BEFORE the args is oracle-correct (production consumes
            # self at check_expr.rs:397 before the args at :658; ggdef desugars the
            # receiver as a Move arg0 evaluated first), so `x.consume(x.field)` is a
            # use-after-move on the `x.field` arg.
            check_safety_expr(*receiver, scope_id, &state, &scopes, &types, &ctx)
            # D12 position 6 sibling: a `&self` mutator on a tainted borrow-rooted
            # receiver materialises an implicit copy.
            reject_amp_self_mutator(*receiver, method_name, scopes, &types, &ctx)
            # 2T (defect C — mutating BUILTIN receiver): a mutating builtin
            # (`push`/`put`/…) on a collection receiver materialises the receiver
            # ROOT — reject a plain-self / bare-Borrow-param root of a drop-tainted
            # type (mirror Rust's `is_builtin_mut` receiver reject + get-chain
            # `find_get_chain_taint_root` fallback, check_expr.rs:405-419).
            # Gate: typed collection OR a getter-shaped place chain. Relying only
            # on `is_collection_receiver` (full infer) misses
            # `h.items.get(0).unwrap().tags.push(5)` when infer doesn't surface
            # Vector on the field — Rust still rejects via get-chain root.
            # `reject_if_tainted` + kind-gated get-chain keep USER get precise.
            if is_mutating_builtin_method(method_name):
                if is_collection_receiver(*receiver, scopes, &types, &ctx) or place_chain_has_getter_method((*receiver).expr):
                    bool _rc = reject_if_tainted_materialize_root(*receiver, scopes, types, &ctx)
            # PART B: a `!self`-consuming method consumes the receiver root. Only a
            # bare-place receiver participates (a temp method-chain receiver has no
            # trackable root). Mirrors Rust check_expr.rs:387-403.
            if place_root_name((*receiver).expr) != "<place>":
                int live_recv_ty = infer_expr_type(*receiver, scopes, &types, &ctx)
                MethodResolution live_mr = resolve_method_full(live_recv_ty, method_name, scopes, &types)
                if live_mr.found and live_mr.sig.self_ownership == OWN_MOVE:
                    live_mark_move(*receiver, &state, scopes, &ctx)
            # STEP 2: per-arg loop — liveness move/use + the D12 position-3
            # collection-put reject (a bare drop-tainted place pushed into an
            # element-owning collection copies at the boundary; `coll.push(!x)`
            # skips). Mirrors Rust gg (src/semantic/safety/helpers.rs:1129).
            bool ingest = is_collection_ingest_method(method_name) and is_collection_receiver(*receiver, scopes, &types, &ctx)
            for a in args:
                if a.ownership == OWN_MOVE:
                    live_move_operand(a.value, scope_id, &state, &scopes, &types, &ctx)
                else:
                    if ingest and a.ownership == OWN_BORROW:
                        reject_tainted_place(a.value, scopes, &types, &ctx)
                    # 2T FORMATION (method-call kind): same `&`-arg materialize
                    # reject as the free-call loop (mirror Rust — all call kinds).
                    if a.ownership == OWN_MUTABLE:
                        bool _rf = reject_if_tainted_materialize_root(a.value, scopes, types, &ctx)
                    check_safety_expr(a.value, scope_id, &state, &scopes, &types, &ctx)
            # STEP 3: D10(b) place-overlap (explicit args only — the receiver is
            # not aliasing-checked against args, per Rust).
            check_call_aliasing(args, scopes, &types, &ctx)
        case EFieldAccess(object, _field):
            check_safety_expr(*object, scope_id, &state, &scopes, &types, &ctx)
        case EIndex(object, index):
            check_safety_expr(*object, scope_id, &state, &scopes, &types, &ctx)
            check_safety_expr(*index, scope_id, &state, &scopes, &types, &ctx)
        case ERange(opt_start, opt_end, _incl):
            if opt_start is Some(b):
                check_safety_expr(*b, scope_id, &state, &scopes, &types, &ctx)
            if opt_end is Some(b):
                check_safety_expr(*b, scope_id, &state, &scopes, &types, &ctx)
        case EIf(cond, then_body, elif_branches):
            check_safety_expr(*cond, scope_id, &state, &scopes, &types, &ctx)
            Vector[int] eif_binds = Vector[int]()
            collect_is_defs_into(*cond, ctx, &eif_binds)
            # D29: an if-EXPRESSION's branch tails ARE its value (not dropped).
            bool eif_saved_tail = ctx.d29_tail_dropped
            ctx.d29_tail_dropped = false
            Dict[int, int] eif_acc = Dict[int, int]()
            bool eif_reached = safety_branch(then_body, eif_binds, scope_id, state, &eif_acc, &scopes, &types, &ctx)
            for br in elif_branches:
                Vector[int] br_binds = Vector[int]()
                if br.condition is Some(c):
                    check_safety_expr(c, scope_id, &state, &scopes, &types, &ctx)
                    collect_is_defs_into(c, ctx, &br_binds)
                bool eif_br_reached = safety_branch(br.body, br_binds, scope_id, state, &eif_acc, &scopes, &types, &ctx)
                eif_reached = eif_reached or eif_br_reached
            ctx.d29_tail_dropped = eif_saved_tail
            safety_commit(eif_acc, not elsebranches_have_uncond(elif_branches), eif_reached, &state)
        case EMatch(scrutinee, arms):
            # D29 marked-match peel (expression match) — mirror of the SMatch arm.
            d29_check_match_peel(*scrutinee, arms, &ctx)
            check_safety_expr(*scrutinee, scope_id, &state, &scopes, &types, &ctx)
            # D29: a match-EXPRESSION's arm tails ARE its value (not dropped).
            bool em_saved_tail = ctx.d29_tail_dropped
            ctx.d29_tail_dropped = false
            Dict[int, int] em_acc = Dict[int, int]()
            bool em_reached = false
            for arm in arms:
                if arm.guard is Some(g):
                    check_safety_expr(g, scope_id, &state, &scopes, &types, &ctx)
                Vector[int] em_binds = Vector[int]()
                collect_pattern_defs_into(arm.pattern, ctx, &em_binds)
                bool em_arm_reached = safety_branch(arm.body, em_binds, scope_id, state, &em_acc, &scopes, &types, &ctx)
                em_reached = em_reached or em_arm_reached
            ctx.d29_tail_dropped = em_saved_tail
            safety_commit(em_acc, not match_has_catch_all(arms), em_reached, &state)
        case EClosure(_params, body):
            # The closure BODY executes when the closure is CALLED, not when it is
            # DEFINED — so a move/re-init inside it must not escape to the enclosing
            # state. But a capture that is ALREADY moved-out in the enclosing scope
            # IS a use-after-move when the body reads it. So check the body against
            # a SNAPSHOT of the current move-state (captures visible) with the loop
            # context reset (loop_depth 0 + fresh loop_locals + no rebind — the
            # closure body is NOT inside the enclosing loop), then DISCARD the
            # snapshot so the closure's own moves/re-inits do not leak out. Mirrors
            # production save_branch_state → reset loop ctx → check_expr(body) →
            # restore_branch_state (check_expr.rs:1034-1050). Carrier rejects
            # (tainted capture + expression-tail) still apply below.
            SafetyState cl = safety_snapshot(state)
            cl.loop_depth = 0
            cl.loop_locals = Dict[int, int]()
            cl.rebind = -1
            # D29: a closure's tail statement IS its return value (a value block),
            # not a discard — a bare fallible tail there is a legal value flow
            # (e.g. `.and_then((n): parse(n))` where the callback returns Result).
            # Closures do not inherit outer throws/Result-return propagate context.
            bool cl_saved_tail = ctx.d29_tail_dropped
            bool cl_saved_prop = ctx.d29_can_propagate
            bool cl_saved_ret = ctx.d29_return_is_result
            ctx.d29_tail_dropped = false
            ctx.d29_can_propagate = false
            ctx.d29_return_is_result = false
            # 2T/D2: a closure captures `self` BY VALUE (D5) — an ESelfExpr write
            # inside the closure body targets the closure's OWN copy, not the
            # method's plain-self, so the self-root materialize gate must NOT fire
            # here. Reset self-mode to -1 for the body walk, restore after.
            int cl_saved_self_mode = ctx.self_mode
            ctx.self_mode = -1
            check_safety_stmts(body, scope_id, &cl, &scopes, &types, &ctx)
            ctx.self_mode = cl_saved_self_mode
            ctx.d29_tail_dropped = cl_saved_tail
            ctx.d29_can_propagate = cl_saved_prop
            ctx.d29_return_is_result = cl_saved_ret
            # D12 position 5 (closure capture): a captured tainted OUTER local.
            reject_tainted_captures(body, scope_id, scopes, types, &ctx)
            # D12 position 4 (closure expression-tail): a closure whose body tail
            # IS a bare drop-tainted place (`(R x): x`) returns a copy at the
            # closure return boundary. PARAM-ROOTED tails only: a CAPTURE-rooted
            # tail is already rejected by position 5 above (mirror Rust
            # check_expr.rs:997-1006).
            if body.len() > 0:
                Stmt tail_stmt = body.get(body.len() - 1).unwrap()
                match tail_stmt:
                    case SExpr(tail_expr):
                        bool tail_root_is_capture = false
                        if place_root_def_spanned(tail_expr, scopes, ctx) is Some(rdid):
                            if scope_is_ancestor_or_self(scopes, scopes.get_def(rdid).scope_id, scope_id):
                                tail_root_is_capture = true
                        if not tail_root_is_capture:
                            reject_tainted_place(tail_expr, scopes, &types, &ctx)
                    else:
                        pass
        case EImplicitClosure(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EArrayLiteral(elements):
            # Round XXVIII Track C R1 (walker-driven, per pass-2 reference-
            # grade fold) — container-literal ELEMENTS are D32 consuming init
            # boundaries; a `!x` element is RESTING at the boundary, not an
            # operand reject. Suppress E_MoveInOperandPosition for the whole
            # element walk. Save/restore prev so the flag never leaks past.
            # Mirrors Rust check_expr::Expr::ArrayLiteral bracket.
            bool saved_supp_arr = ctx.suppress_move_in_operand_position
            ctx.suppress_move_in_operand_position = true
            for e in elements:
                check_safety_expr(e, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_arr
        case ETupleLiteral(elements):
            # R1: tuple elements same as array elements.
            bool saved_supp_tup = ctx.suppress_move_in_operand_position
            ctx.suppress_move_in_operand_position = true
            for e in elements:
                check_safety_expr(e, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_tup
        case EDictLiteral(keys, values):
            # R1: dict values/keys same as array elements.
            bool saved_supp_dict = ctx.suppress_move_in_operand_position
            ctx.suppress_move_in_operand_position = true
            for (di, k) in keys.enumerate():
                check_safety_expr(k, scope_id, &state, &scopes, &types, &ctx)
                check_safety_expr(values.get(di).unwrap(), scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_dict
        case EStructLiteral(_name, _fields, args):
            # D12 position 2 (struct field-init): every struct-literal arg is a
            # consuming init boundary. A bare `!x` arg is an EMove (marked below)
            # — the parser PRESERVES the prefix `!` on THIS path (an EMove node),
            # so `reject_single_owner_init` (which only matches a bare
            # EIdentifier) never fires on a legal `S{f: !callable}`. The
            # EDotShorthand arm below now threads the same CallArg ownership sigil
            # and gates on `a.ownership` identically (RV-B). This arm is also
            # UNREACHABLE in today's parser: `S(...)`
            # lowers to ECall and `{...}` to a dict/set literal, so parser.gg
            # never constructs EStructLiteral — only meta.gg's
            # substitution-rebuild arms name it, and they rebuild a pre-existing
            # node. Kept for completeness / the meta path.
            # ⚠ KNOWN MINOR ASYMMETRY (filed LOW, TODO): production's struct-brace
            # single-owner check (check_expr.rs:1183) sits in the `!target_is_ref`
            # branch and SKIPS ref-typed fields (a `Ref[Callable]` field init is a
            # borrow, not a copy). This arm applies the reject to ALL args with no
            # ref-field gate, so it would OVER-REJECT the exotic `S{cbref: f}`
            # where `cbref` is a borrow-typed field. Over-reject-only (never UAF)
            # and unreachable in today's corpus; the heavier per-field ref-flag
            # mirror is deliberately deferred.
            # R1: struct-literal args are consuming init boundaries; blanket-
            # suppress E_MoveInOperandPosition for the whole element walk
            # (mirrors Rust check_expr::Expr::StructLiteral bracket).
            bool saved_supp_str = ctx.suppress_move_in_operand_position
            ctx.suppress_move_in_operand_position = true
            for a in args:
                reject_tainted_place(a, scopes, &types, &ctx)
                # Single-owner init class (struct-literal field): NO param exempt.
                reject_single_owner_init(a, false, scopes, types, &ctx)
                check_safety_expr(a, scope_id, &state, &scopes, &types, &ctx)
            ctx.suppress_move_in_operand_position = saved_supp_str
        case EDotShorthand(_variant, args):
            # D12 position 2 (enum variant init): `.Variant(x)` args are a
            # consuming init boundary — IDENTICAL to the longhand `E.Variant(x)`
            # ECall ctor arm above. The EDotShorthand adapter now threads the full
            # CallArg (with the `!`/`&` ownership sigil) through, so we gate on
            # `a.ownership` exactly like the ECall ctor path: an OWN_MOVE `!x` arg
            # MOVES (marks the move — no reject), and only a bare OWN_BORROW arg
            # hits the D12 pos-2 reject (a drop-tainted / single-owner place
            # copies at the init boundary). This clears BOTH prior over-rejects:
            # the tainted `.Wrap(!r)` and the single-owner `.Wrap(!callable)` that
            # the old sigil-discard adapter mis-flagged as bare copies.
            for a in args:
                if a.ownership == OWN_MOVE:
                    live_move_operand(a.value, scope_id, &state, &scopes, &types, &ctx)
                else:
                    if a.ownership == OWN_BORROW:
                        reject_tainted_place(a.value, scopes, &types, &ctx)
                        # Single-owner init class (enum-variant): NO param exempt.
                        reject_single_owner_init(a.value, false, scopes, types, &ctx)
                    check_safety_expr(a.value, scope_id, &state, &scopes, &types, &ctx)
            # D10(b) same-call place-overlap (args only), mirroring the ECall arm.
            check_call_aliasing(args, scopes, &types, &ctx)
        case ETry(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EPropagate(inner):
            # D29 residual (a)+(b): prove-lie + marked-unhandled.
            d29_check_propagate(expr, *inner, &ctx)
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EMove(inner):
            # Round XXVIII Track C — D32:1278-1281 `!`-in-operand-position
            # reject (SH lane; mirror of Rust `check_expr::Expr::Move` arm
            # chokepoint and ggdef `elaborate_expr::Expr::Move` arm).
            # ONE-PRODUCER chokepoint (Core #4): every operand-position `!`-of-
            # a-place reaches here via its containing walker arm (binop, cond,
            # match scrutinee, index, augassign RHS, f-string interp, `as`-
            # cast, comprehension body, ...). Legit `!`-BOUNDARY spellings
            # never reach this arm with the suppress flag false: call args
            # pre-strip via ownership sigil; SFor iterable ownership pre-
            # strips at parser; comprehension iterable / `.enumerate()`
            # receivers pre-strip via `check_iterable_maybe_amp` (extended in
            # R3 to peel EMove alongside EMutableBorrow); SVarDecl/SAssign/
            # SReturn/SThrow/Send direct top-level `!x` RHS + container-
            # literal element walks set `suppress_move_in_operand_position`
            # for the walk (see the sibling `EMutableBorrow` arm below for the
            # `AmpInOperandPosition` twin pattern). `!f()` (a non-place move)
            # is also gated by the suppress flag because it is a computed
            # rvalue in the same operand position.
            if not ctx.suppress_move_in_operand_position:
                ctx.diagnostics.push(Diagnostic.error(expr.span, DkMoveInOperandPosition(), "`!` in an operand position is not valid — `!` is a boundary modifier that consumes the source at an ownership boundary, not an expression operator"))
            # `S y = !x` / `return !x` — mark the move (or, for a non-place `!f()`,
            # recurse for nested reads).
            live_move_operand(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EMutableBorrow(inner):
            # D32 chokepoint (Core #4 one-producer; mirrors Rust
            # `src/semantic/safety/check_expr.rs:349` `Expr::MutableBorrow` arm).
            # Every operand-position `&`-of-a-place reaches here via its
            # containing walker arm (match sc, binop, cond, index, augassign RHS,
            # f-string interp, closure body, return, throw, tuple/array elem,
            # `as`-cast, comprehension body, ...). Legit `&`-BOUNDARY spellings
            # never reach this arm: call-args are pre-consumed by
            # `parse_ownership_modifier`; for-iterable / comprehension-iterable /
            # `.enumerate()` receivers pre-strip via `check_iterable_maybe_amp`;
            # SVarDecl/SAssign direct top-level `&`-init suppresses so D10(a)
            # `E_LocalBorrowBind` (`check_local_borrow_bind`) owns the reject
            # message (still recurse so inner-place aliasing bookkeeping runs).
            if not ctx.suppress_amp_in_operand_position:
                ctx.diagnostics.push(Diagnostic.error(expr.span, DkAmpInOperandPosition(), "`&` in an operand position is not valid — `&` is a boundary modifier, not an expression operator"))
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EDeref(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
            check_deref_operand(SpannedExpr((*inner).expr, (*inner).span), scope_id, scopes, &types, &ctx)
        case EAs(inner, _target):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EIs(inner, _neg, _pat):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case EBlock(stmts):
            # D29: an EBlock/EDo is a VALUE expression — its tail statement is the
            # block's value, not a discard (tail_dropped=false for the walk).
            bool blk_saved_tail = ctx.d29_tail_dropped
            ctx.d29_tail_dropped = false
            check_safety_stmts(stmts, scope_id, &state, &scopes, &types, &ctx)
            ctx.d29_tail_dropped = blk_saved_tail
        case EDo(stmts):
            bool do_saved_tail = ctx.d29_tail_dropped
            ctx.d29_tail_dropped = false
            check_safety_stmts(stmts, scope_id, &state, &scopes, &types, &ctx)
            ctx.d29_tail_dropped = do_saved_tail
        case EListComp(comp_e, _var, iterable, opt_cond):
            # A comprehension is a LOOP context (the body runs once per element):
            # moving an ENCLOSING local inside it re-moves it every iteration — a
            # per-iteration double-move (E_MoveInLoop). So walk the body on a
            # snapshot with loop_depth bumped and a FRESH loop_locals set (the
            # iteration var is NOT loop-local — moving it is itself a MoveInLoop,
            # matching production + `safety_loop_body`). The snapshot keeps the
            # closure of moves from leaking to the enclosing state. Mirrors
            # production ListComprehension (check_expr.rs:1073-1091):
            # loop_depth+1 + push(empty loop_locals). The iterable is evaluated
            # ONCE before the loop, so it is checked in the enclosing state.
            # D32 iterable strip: `&coll` on a comprehension iterable is a
            # BOUNDARY, not an operand — mirror the SFor peel.
            check_iterable_maybe_amp(*iterable, scope_id, &state, &scopes, &types, &ctx)
            SafetyState lc = safety_snapshot(state)
            lc.loop_depth = lc.loop_depth + 1
            lc.loop_locals = Dict[int, int]()
            check_safety_expr(*comp_e, scope_id, &lc, &scopes, &types, &ctx)
            if opt_cond is Some(b):
                check_safety_expr(*b, scope_id, &lc, &scopes, &types, &ctx)
        case ESetComp(comp_e, _var, iterable, opt_cond):
            check_iterable_maybe_amp(*iterable, scope_id, &state, &scopes, &types, &ctx)
            SafetyState sc = safety_snapshot(state)
            sc.loop_depth = sc.loop_depth + 1
            sc.loop_locals = Dict[int, int]()
            check_safety_expr(*comp_e, scope_id, &sc, &scopes, &types, &ctx)
            if opt_cond is Some(b):
                check_safety_expr(*b, scope_id, &sc, &scopes, &types, &ctx)
        case EDictComp(key, value, _var, iterable, opt_cond):
            check_iterable_maybe_amp(*iterable, scope_id, &state, &scopes, &types, &ctx)
            SafetyState dc = safety_snapshot(state)
            dc.loop_depth = dc.loop_depth + 1
            dc.loop_locals = Dict[int, int]()
            check_safety_expr(*key, scope_id, &dc, &scopes, &types, &ctx)
            check_safety_expr(*value, scope_id, &dc, &scopes, &types, &ctx)
            if opt_cond is Some(b):
                check_safety_expr(*b, scope_id, &dc, &scopes, &types, &ctx)
        case EDefaultOp(left, right):
            # Parser-unreachable (it lowers `??` to EBinaryOp) but kept for
            # completeness — same reject as the EBinaryOp("??") arm.
            check_safety_expr(*left, scope_id, &state, &scopes, &types, &ctx)
            check_safety_expr(*right, scope_id, &state, &scopes, &types, &ctx)
            check_default_op_lhs(SpannedExpr((*left).expr, (*left).span), scope_id, scopes, &types, &ctx)
            check_default_op_rhs(SpannedExpr((*left).expr, (*left).span), SpannedExpr((*right).expr, (*right).span), scope_id, scopes, &types, &ctx)
        case EAwait(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case ESpawn(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case ESpawnBlocking(inner):
            check_safety_expr(*inner, scope_id, &state, &scopes, &types, &ctx)
        case ERethrow(e, _eopt, _etype, transform):
            # D29: a disposition (`rethrow`) activates the error channel — the
            # call it attaches to must carry the mark (`f()! rethrow …`) on BOTH
            # kinds. An unmarked disposition inner is the bare-call error.
            d29_reject_if_bare_fallible(*e, &ctx)
            bool saved_disp_r = ctx.d29_in_disposition
            ctx.d29_in_disposition = true
            check_safety_expr(*e, scope_id, &state, &scopes, &types, &ctx)
            ctx.d29_in_disposition = saved_disp_r
            check_safety_expr(*transform, scope_id, &state, &scopes, &types, &ctx)
        case ECatch(e, _name, recovery):
            # D29: same as ERethrow — `catch` on a fallible CALL requires the mark
            # (`f()! catch …`). A `catch` on a Result LOCAL is not a call and is
            # never classified fallible here, so it stays legal unmarked.
            d29_reject_if_bare_fallible(*e, &ctx)
            bool saved_disp_c = ctx.d29_in_disposition
            ctx.d29_in_disposition = true
            check_safety_expr(*e, scope_id, &state, &scopes, &types, &ctx)
            ctx.d29_in_disposition = saved_disp_c
            check_safety_expr(*recovery, scope_id, &state, &scopes, &types, &ctx)
            # ⚠ Track A · SH mirror REVERTED at round-close 2026-08-06:
            # the SH-side `DkTypeMismatch` emission over-rejected 5 corpus
            # fixtures (`fault_catch_bounds_drop`, `fault_catch_bounds_resource_mut`,
            # `fault_deep_catch_bounds_resource`, `throws_expr_body_tail`,
            # `throws_t_result_resource_inner`) — a mix of (a) legitimate
            # type mismatches the Rust side accepts (Rust's carve-outs cover
            # them; SH's minimal `carrier_op_suppress` did not) and (b)
            # SH-side type-interning inconsistencies where the SAME type has
            # different TypeIds in different scopes (`expected String, found
            # String`). Rust-side `check_recovery_type` at
            # `src/semantic/typecheck.rs` still lands and closes the class
            # for Rust; SH mirror is deferred to a follow-up round that
            # (i) audits the SH's carve-out set vs Rust's three and (ii)
            # investigates the SH type-interning drift. Filed under Round
            # XXXII SH-lag follow-ups in TODO.md.
        case EFString(_tmpl, exprs, _specs):
            for fe in exprs:
                check_safety_expr(fe, scope_id, &state, &scopes, &types, &ctx)

void type_check_function(FunctionDef func, int parent_scope, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx,int def_scope):
    # Register the signature first (idempotent — running it twice for
    # IFunction items already pre-passed in type_check_module just
    # overwrites with the same value). Equip methods aren't pre-passed
    # so they need this call. Generic functions and impl methods need
    # the body-scope signature dance too.
    register_function_signature(func, parent_scope, &scopes, &types, &ctx, def_scope)

    check_default_param_ordering(func.params, &ctx)

    # D29/A31 residual (c): bare `!:` signature is reserved for inferred error
    # sets — teaching-reject until A31 (mirror Rust typecheck.rs:7704-7708).
    if func.throws_inferred:
        ctx.diagnostics.push(Diagnostic.error(func.return_type.span, DkInferredThrowsUnsupported(), "inferred error sets (a bare `!` on the signature) are not yet implemented — declare the error contract explicitly with `throws E`"))

    # R5: walk default-param expressions under non-propagating D29 context so a
    # bare fallible default (`b = boom(1)`) is rejected at the definition site.
    for p in func.params:
        if p.default_value is Some(dflt):
            bool saved_prop = ctx.d29_can_propagate
            ctx.d29_can_propagate = false
            d29_reject_if_bare_fallible(dflt, &ctx)
            # Also reject marked unhandled defaults (mark without a disposition).
            if d29_is_marked(dflt):
                match dflt.expr:
                    case EPropagate(inner):
                        d29_check_propagate(dflt, *inner, &ctx)
                    else:
                        pass
            ctx.d29_can_propagate = saved_prop

    # `main` can only throw `int` (the process exit code). Mirrors the
    # Rust check at src/semantic/typecheck.rs:5197 (SemanticErrorKind::
    # MainThrowsNonInt). First exemplar push site of the typechecker's
    # typed-diagnostic stream — proves the wiring end-to-end while
    # adding a real check the self-host was missing.
    if func.name == "main" and func.throws_type is Some(throws_st):
        bool is_int = false
        match throws_st.ty:
            case TPrimitive(prim_name):
                if prim_name == "int":
                    is_int = true
            else:
                pass
        if not is_int:
            ctx.diagnostics.push(Diagnostic.error(throws_st.span, DkMainThrowsNonInt(), "`main()` can only throw `int` (the process exit code)"))

    # Walk body for VarDecl types
    Option[int] body_scope_opt = find_body_scope(func.name, parent_scope, scopes, ctx)
    if body_scope_opt is None and ctx.function_body_scopes.contains(func.name):
        body_scope_opt = Some(ctx.function_body_scopes.get(func.name).unwrap())
    if body_scope_opt is Some(body_scope):
        # Save/restore the control-flow context across the body walk.
        # Entering a function resets `loop_depth` (no enclosing loop
        # carries through a fn boundary) and updates `current_function_throws`
        # / `in_function_body` based on this fn's signature. Mirrors the
        # Rust typechecker's per-function context save in `check_function`.
        int saved_loop_depth = ctx.loop_depth
        bool saved_throws = ctx.current_function_throws
        bool saved_prop = ctx.d29_can_propagate
        bool saved_ret_res = ctx.d29_return_is_result
        bool saved_in_fn = ctx.in_function_body
        ctx.loop_depth = 0
        ctx.current_function_throws = func.throws_type.is_some()
        ctx.d29_return_is_result = d29_stype_is_result(func.return_type)
        ctx.d29_can_propagate = func.throws_type.is_some() or ctx.d29_return_is_result
        ctx.in_function_body = true
        type_check_stmts(func.body, body_scope, &scopes, &types, &ctx)
        # UNIFIED safety walk (AGENTS.md Core #8 + #4) — driven ONCE per function
        # body AFTER type_check_stmts (so def types are assigned), via the
        # EXHAUSTIVE check_safety_* walker. Runs drop-purity (D4/D12), place-overlap
        # (D10b) and liveness (use-after-move / double-move) as ARMS of ONE
        # traversal. Pass-order rider: liveness precedes aliasing, so `f(!x,!x)` is
        # a double move (not a place-overlap). Fresh SafetyState per function —
        # params are live at entry and no enclosing loop carries across a fn body.
        SafetyState safety = SafetyState(Dict[int, int](), 0, Dict[int, int](), -1)
        # D29: a function BLOCK body drops its tail statement's value (block
        # bodies return via explicit `return`; expr-body tails are SReturn —
        # residual (e) checks bare-fallible there).
        bool saved_tail_dropped = ctx.d29_tail_dropped
        ctx.d29_tail_dropped = true
        # 2T/D2: expose THIS method's self-mode to the self-root materialize gate
        # (OWN_BORROW plain self materialises on write; `&self`/`!self` do not).
        # `types.self_type_id` (set by the IEquip arm) is the equipped type; the
        # first param named `self` carries the mode. Free fns / non-self methods
        # → -1. Saved/restored so it never leaks past this body.
        int saved_self_mode = ctx.self_mode
        ctx.self_mode = -1
        if func.params.len() > 0:
            Param self_p0 = func.params.get(0).unwrap()
            if self_p0.param_name == "self":
                ctx.self_mode = self_p0.ownership
        check_safety_stmts(func.body, body_scope, &safety, &scopes, &types, &ctx)
        ctx.self_mode = saved_self_mode
        ctx.d29_tail_dropped = saved_tail_dropped
        ctx.loop_depth = saved_loop_depth
        ctx.current_function_throws = saved_throws
        ctx.d29_can_propagate = saved_prop
        ctx.d29_return_is_result = saved_ret_res
        ctx.in_function_body = saved_in_fn

# ── Pattern type assignment ────────────────────────────────
# Recursively assigns types to pattern bindings based on a scrutinee type.

void assign_pattern_types(SpannedPattern pattern, int scrutinee_type, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match pattern.pat:
        case PBinding(name):
            if scopes.lookup_in_subtree_untyped(scope_id, name) is Some(def_id):
                DefInfo d = scopes.get_def(def_id)
                # Only assign to variable bindings (not variant names, structs, etc.)
                bool is_variable = false
                match d.kind:
                    case DkVariable():
                        is_variable = true
                    else:
                        pass
                if is_variable:
                    scopes.set_def_type(def_id, scrutinee_type)

        case PConstructor(variant_name, fields):
            # Resolve variant/struct field types from the scrutinee type
            Vector[int] field_types = resolve_variant_field_types(scrutinee_type, variant_name, scopes, types)
            # Arity gate (mirrors Rust typecheck.rs assign_pattern_types): when
            # we know the payload/field list, wrong arity is a type error
            # (was silent — struct patterns then mis-bound via enum tag offset).
            if field_types.len() > 0 and field_types.len() != fields.len():
                String bare = variant_name
                int dpi = -1
                int ci2 = 0
                while ci2 < variant_name.len():
                    if variant_name.char_at(ci2) == ".":
                        dpi = ci2
                    ci2 = ci2 + 1
                if dpi >= 0:
                    bare = ""
                    int di = dpi + 1
                    while di < variant_name.len():
                        bare = bare + variant_name.char_at(di)
                        di = di + 1
                ctx.diagnostics.push(Diagnostic.error(pattern.span, DkTypeMismatch(), "type mismatch: expected `pattern with " + int_to_str(field_types.len()) + " field(s) for `" + bare + "``, found `" + int_to_str(fields.len()) + " field(s)`"))
            for (i, field) in fields.enumerate():
                int ft = -1
                if i < field_types.len():
                    ft = get_int_at(field_types, i)
                if ft >= 0:
                    assign_pattern_types(field, ft, scope_id, &scopes, &types, &ctx)

        case PDotShorthand(variant_name, fields):
            Vector[int] field_types = resolve_variant_field_types(scrutinee_type, variant_name, scopes, types)
            for (i, field) in fields.enumerate():
                int ft = -1
                if i < field_types.len():
                    ft = get_int_at(field_types, i)
                if ft >= 0:
                    assign_pattern_types(field, ft, scope_id, &scopes, &types, &ctx)

        case PTuple(elements):
            # Destructure tuple type
            if scrutinee_type >= 0 and scrutinee_type < types.types.len():
                ResolvedType rt = get_rtype_at(types.types, scrutinee_type)
                match rt:
                    case RTTuple(elem_ids):
                        for (i, elem) in elements.enumerate():
                            int et = -1
                            if i < elem_ids.len():
                                et = get_int_at(elem_ids, i)
                            if et >= 0:
                                assign_pattern_types(elem, et, scope_id, &scopes, &types, &ctx)
                    else:
                        pass

        else:
            pass

# ── Resolve variant field types from a scrutinee type ─────

Vector[int] resolve_variant_field_types(int scrutinee_type, String variant_name, ScopeTable scopes, TypeTable types):
    Vector[int] result = Vector[int]()
    if scrutinee_type < 0 or scrutinee_type >= types.types.len():
        return result

    # Strip qualified prefix: "Color.Blue" → "Blue"
    String lookup_name = variant_name
    int dot_pos = -1
    int ci = 0
    while ci < variant_name.len():
        if variant_name.char_at(ci) == ".":
            dot_pos = ci
        ci = ci + 1
    if dot_pos >= 0:
        String after_dot = ""
        int di = dot_pos + 1
        while di < variant_name.len():
            after_dot = after_dot + variant_name.char_at(di)
            di = di + 1
        lookup_name = after_dot

    ResolvedType rt = get_rtype_at(types.types, scrutinee_type)

    # Handle Option[T]: Some(val) → T, None → nothing
    # Handle Result[T, E]: Ok(val) → T, Error(e) → E
    match rt:
        case RTGeneric(def_id, type_args):
            DefInfo d = scopes.get_def(def_id)
            if d.name == "Option":
                if lookup_name == "Some" and type_args.len() >= 1:
                    result.push(get_int_at(type_args, 0))
            elif d.name == "Result":
                if lookup_name == "Ok" and type_args.len() >= 1:
                    result.push(get_int_at(type_args, 0))
                elif lookup_name == "Error" and type_args.len() >= 2:
                    result.push(get_int_at(type_args, 1))
            else:
                # User-defined generic enum. A variant WITH fields is registered
                # in variant_field_types (IEnum registration skips 0-field
                # variants); approximate its payload as the first concrete type
                # arg for binding types. A variant that is NOT registered has
                # ZERO fields (e.g. `Empty()`) — leave result empty so the arity
                # gate sees 0, not a bogus 1. (The old unconditional push
                # false-rejected `case Empty()` on a generic enum once the arity
                # gate started reading this count.)
                if types.variant_field_types.contains(lookup_name):
                    if type_args.len() >= 1:
                        result.push(get_int_at(type_args, 0))

        case RTDefined(def_id):
            # Struct constructor pattern: `match p: case Point(x, y):` when
            # scrutinee is a struct named Point. Ordered field TypeIds are
            # registered under the bare struct name in IStruct (as a single
            # type or RTTuple for multi-field). Mirrors Rust resolve_variant_field_types.
            DefInfo sdef_info = scopes.get_def(def_id)
            bool is_struct_def = false
            match sdef_info.kind:
                case DkStruct():
                    is_struct_def = true
                else:
                    pass
            if is_struct_def and sdef_info.name == lookup_name:
                if types.variant_field_types.contains(lookup_name):
                    int sft = types.variant_field_types.get(lookup_name).unwrap()
                    if sft >= 0 and sft < types.types.len():
                        ResolvedType srt = get_rtype_at(types.types, sft)
                        match srt:
                            case RTTuple(selems):
                                for e in selems:
                                    result.push(e)
                                return result
                            else:
                                pass
                    result.push(sft)
                    return result
                return result
            # User-defined enum — look up variant field types from type table
            if types.variant_field_types.contains(lookup_name):
                int vft = types.variant_field_types.get(lookup_name).unwrap()
                # Check if it's a tuple — if so, return individual fields
                if vft >= 0 and vft < types.types.len():
                    ResolvedType vrt = get_rtype_at(types.types, vft)
                    match vrt:
                        case RTTuple(elems):
                            for e in elems:
                                result.push(e)
                            return result
                        else:
                            pass
                result.push(vft)
                return result
        else:
            pass

    # Fallback: if the scrutinee type didn't lead anywhere (e.g. shadowed
    # binding obscures the real enum type), look up the qualified variant
    # name directly in variant_field_types — works when the pattern uses
    # `EnumName.Variant(args)` and the enum was registered earlier.
    if result.len() == 0 and types.variant_field_types.contains(lookup_name):
        int fb_vft = types.variant_field_types.get(lookup_name).unwrap()
        if fb_vft >= 0 and fb_vft < types.types.len():
            ResolvedType fb_vrt = get_rtype_at(types.types, fb_vft)
            match fb_vrt:
                case RTTuple(fb_elems):
                    for e in fb_elems:
                        result.push(e)
                else:
                    result.push(fb_vft)
    return result

# ── Extract element type from iterable type ───────────────

Option[int] extract_element_type(int iterable_type, ScopeTable scopes, TypeTable types):
    if iterable_type < 0 or iterable_type >= types.types.len():
        return None()

    ResolvedType rt = get_rtype_at(types.types, iterable_type)

    # String iteration → String (character iteration)
    match rt:
        case RTPrimitive(name):
            if name == "str" or name == "String":
                return Some(types.string_id)
            return None()
        else:
            pass

    # Generic collections: Vector[T], Set[T], HashSet[T] → T
    match rt:
        case RTGeneric(def_id, type_args):
            DefInfo d = scopes.get_def(def_id)
            if d.name == "Vector" or d.name == "Set" or d.name == "HashSet":
                if type_args.len() >= 1:
                    return Some(get_int_at(type_args, 0))
            return None()

        case RTArray(elem_id, size):
            return Some(elem_id)

        case RTSlice(elem_id):
            return Some(elem_id)

        else:
            pass

    return None()

# ── Assign is-pattern types from if/while conditions ──────

void assign_is_condition_types(SpannedExpr expr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match expr.expr:
        case EBinaryOp(left, op, right):
            if op == "and":
                assign_is_condition_types(*left, scope_id, &scopes, &types, &ctx)
                assign_is_condition_types(*right, scope_id, &scopes, &types, &ctx)
                return

        case EIs(inner, negated, pattern):
            if not negated:
                int scrut_type = infer_expr_type(*inner, scopes, &types, &ctx)
                if scrut_type >= 0:
                    assign_pattern_types(*pattern, scrut_type, scope_id, &scopes, &types, &ctx)
                return

        else:
            pass

# ── Check if an expression contains is-patterns ──────────

bool has_is_patterns(Expr e):
    match e:
        case EIs(_, negated, _):
            if not negated:
                return true
            return false
        case EBinaryOp(left, op, right):
            if op == "and":
                return has_is_patterns((*left).expr) or has_is_patterns((*right).expr)
        else:
            pass
    return false

# ── Walk closures in expressions ──────────────────────────
# Finds closure expressions and assigns types to their parameters and bodies.

void walk_expr_closures_with_type(SpannedExpr sexpr, int expected_type, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match sexpr.expr:
        case EClosure(params, body):
            # Extract param types from expected_type if it's RTFunction
            Vector[int] expected_params = Vector[int]()
            if expected_type >= 0 and expected_type < types.types.len():
                ResolvedType ert = get_rtype_at(types.types, expected_type)
                match ert:
                    case RTFunction(ptypes, _, _):
                        expected_params = ptypes
                    case RTCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTMutCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTConsumeCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTBoxedCallable(kind_name, inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    else:
                        pass
            # Assign types to closure parameters
            for (pi, p) in params.enumerate():
                int p_type_id = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
                # If the param type is <error> or void (inferred), use expected type
                if (p_type_id < 0 or p_type_id == types.error_id or p_type_id == types.void_id) and pi < expected_params.len():
                    p_type_id = get_int_at(expected_params, pi)
                # If still unresolved, assign a fresh type variable
                if p_type_id < 0 or p_type_id == types.error_id or p_type_id == types.void_id:
                    p_type_id = types.fresh_var()
                if p_type_id >= 0 and p_type_id != types.error_id:
                    if scopes.lookup_in_subtree_untyped(scope_id, p.param_name) is Some(param_def):
                        int binding_type_id = demote_generic_param_to_var(p_type_id, scopes, &types)
                        scopes.set_def_type(param_def, binding_type_id)
            # Walk closure body for VarDecls and nested closures. Save and
            # reset control-flow context: a closure has its own throws/loop
            # scope; outer-scope `break`/`continue`/`throw` must not pass
            # through the closure boundary. `in_function_body` stays true
            # (a closure IS a function-shaped body). The throws flag and
            # loop depth reset to match a fresh function entry.
            int saved_loop_depth = ctx.loop_depth
            bool saved_throws = ctx.current_function_throws
            ctx.loop_depth = 0
            ctx.current_function_throws = false
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = saved_loop_depth
            ctx.current_function_throws = saved_throws
        else:
            walk_expr_closures_inner(sexpr, scope_id, &scopes, &types, &ctx)

void walk_expr_closures(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    walk_expr_closures_with_type(sexpr, -1, scope_id, &scopes, &types, &ctx)

# ── Class-fix (Round XXVII Track C + Round XXVIII Track A): SH-lane REJECT
# for one-sided Result/Option combinators AND tag-checks on the wrong
# receiver — mirror of the Rust chokepoint at
# `src/semantic/typecheck.rs::reject_wrong_receiver_combinator` (which pins
# the SAME 9 cells via R26A_ARM_MARKER). Wired from the EMethodCall arm of
# `walk_expr_closures_inner` BEFORE the existing resolve/inference logic —
# a wrong-receiver call currently resolves via the receiver's method table
# (or silently misses), lowers, and then either C-compile-crashes (the
# 5 combinator cells) or silently produces wrong output (the 4 tag-check
# cells: Option/Result share the two-variant discriminant layout so
# `.is_some()` on Result etc. "happens to work" for the wrong reason —
# Core #8 both-wrong). This reject fires at typecheck time so the driver's
# `has_errors` gate halts BEFORE lowering.
#
# Void return + push-to-diagnostics matches the SH neighbour convention
# (`PositionalAfterNamed` at :3155, `NoFieldFound` in infer.gg:273 —
# both void, no caller short-circuits on bool).
#
# Covers BOTH combinator (HOF-taking) and tag-check (`.is_*()` inspector)
# shapes — the fn name is historical (XXVII Track C combinator origin);
# rename out of scope for XXVIII Track A.
#
# Class-guard: `tests/lints.rs::sh_reject_wrong_receiver_combinator_arms_count`
# pins the arm count (EXPECTED=9) via a distinctive per-arm marker
# spelled only on the 9 arms below (see the trailing `# R…_ARM_MARKER`
# comments — this doc line and the lint assert-message deliberately
# paraphrase to avoid inflating the count). A new one-sided combinator or
# tag-check MUST land in the Rust chokepoint AND here AND in ggdef's
# `elaborate_method` (Core #9 all-lanes semantic change) with a
# `combinator_<recv>_<method>_rejected.gg` fixture RED-verified per
# Core #12. ggdef tag-check LAG (Core #13 subset-expansion) filed as
# separate follow-up: elaborate currently blanket-rejects tag-checks so
# the wrong-cell case is already blocked, but the right-cell case is not
# yet subset-accepted.
void reject_wrong_receiver_combinator(int receiver_type, String method_name, Span span, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    if receiver_type < 0 or receiver_type >= types.types.len():
        return
    String base_name = ""
    ResolvedType obj_rt = get_rtype_at(types.types, receiver_type)
    match obj_rt:
        case RTDefined(rdef):
            base_name = scopes.get_def(rdef).name
        case RTGeneric(rdef, _):
            base_name = scopes.get_def(rdef).name
        else:
            return
    String hint = ""
    if base_name == "Result" and method_name == "flat_map":
        hint = "Option-only"                                 # R27C_ARM_MARKER
    elif base_name == "Result" and method_name == "filter":
        hint = "Option-only"                                 # R27C_ARM_MARKER
    elif base_name == "Result" and method_name == "flatten":
        hint = "Option-only"                                 # R27C_ARM_MARKER
    elif base_name == "Option" and method_name == "map_err":
        hint = "Result-only"                                 # R27C_ARM_MARKER
    elif base_name == "Option" and method_name == "unwrap_error":
        hint = "Result-only"                                 # R27C_ARM_MARKER
    elif base_name == "Result" and method_name == "is_some":
        hint = "Option-only"                                 # R27C_ARM_MARKER
    elif base_name == "Result" and method_name == "is_none":
        hint = "Option-only"                                 # R27C_ARM_MARKER
    elif base_name == "Option" and method_name == "is_ok":
        hint = "Result-only"                                 # R27C_ARM_MARKER
    elif base_name == "Option" and method_name == "is_error":
        hint = "Result-only"                                 # R27C_ARM_MARKER
    else:
        return
    String msg = "`." + method_name + "()` on " + base_name + " is outside the phase-0 subset (" + hint + ")"
    ctx.diagnostics.push(Diagnostic.error(span, DkNoMethodFound(), msg))

# ── Round XXVIII Track E: SH mirror of production's
# `src/semantic/typecheck.rs::TypeChecker::unify_closure_ret_axis` and
# ggdef's `spec/ggdef/src/elaborate/mod.rs:2373`. Enforces closure-return
# payload-axis unification for the 3 unify-eligible closure-returning
# combinators. Cell mapping (mirrors ggdef `ClosureCombinatorCell`):
#   1 = ResultOrElse  — `Result[T,E].or_else((E) -> Result[T',E'])`  → axis 0 (T'==T)
#   2 = ResultAndThen — `Result[T,E].and_then((T) -> Result[U,E'])`  → axis 1 (E'==E)
#   3 = OptionOrElse  — `Option[T].or_else(() -> Option[T'])`        → axis 0 (T'==T)
#
# Explicitly out-of-class (mirrors production's helper doc-comment):
#   - `.map` / `.map_err` — scalar-returning closures (no axis).
#   - `Result.{flat_map, filter}` + `Option.{map_err, unwrap_error}` —
#     one-sided combinators rejected at `reject_wrong_receiver_combinator`
#     as `E_NoMethodFound` (category error, not an axis-unify cell).
#   - `Option.and_then` / `Option.flat_map` — legitimate cross-type map.
#
# Class-guard: `tests/lints.rs::unify_closure_ret_axis_class_enumeration`
# is the 3-lane twin-count invariant (production + ggdef + THIS SH port).
# The 3 arms below carry a distinctive per-arm trailing marker (see the
# `# R…_CELL_MARKER` comments — this doc line and the lint assert-message
# deliberately paraphrase to avoid inflating the count). A new
# closure-returning combinator MUST land in the Rust chokepoint AND
# ggdef's `combinator_cell` AND HERE (Core #9 all-lanes semantic change)
# with a `combinator_*_cross_type_reject.gg` fixture RED-verified per
# Core #12.
int combinator_axis_cell(String base_name, String method_name):
    if base_name == "Result" and method_name == "or_else":
        return 1                                                 # R28E_CELL_MARKER
    if base_name == "Result" and method_name == "and_then":
        return 2                                                 # R28E_CELL_MARKER
    if base_name == "Option" and method_name == "or_else":
        return 3                                                 # R28E_CELL_MARKER
    return -1

# Payload index within `type_args` for the axis this cell unifies.
# `axis` here is the position that must be a PASSTHROUGH from receiver
# to closure — the OTHER axis is the recovery/map axis and may differ.
int axis_index_for_cell(int cell):
    if cell == 1:
        return 0  # Result.or_else: Ok-axis passthrough
    if cell == 2:
        return 1  # Result.and_then: Err-axis passthrough
    if cell == 3:
        return 0  # Option.or_else: Some-axis passthrough
    return -1

# Extract the payload TypeId at `axis` for an RTGeneric receiver of
# `Option` or `Result`. Returns -1 for non-Option/Result shapes,
# unresolved types (-1 sentinel), or axis out of range — the caller
# no-ops in those cases (mirrors ggdef's `Ty::Unknown` bail).
int option_or_result_payload(int type_id, int axis, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return -1
    if axis < 0:
        return -1
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTGeneric(def_id, type_args):
            String name = scopes.get_def(def_id).name
            if name != "Option" and name != "Result":
                return -1
            if axis >= type_args.len():
                return -1
            return get_int_at(type_args, axis)
        else:
            return -1
    return -1

# Extract the base type name (e.g. "Result", "Option", "Vector") from a
# receiver TypeId's RTDefined/RTGeneric wrapper. Returns "" for
# non-nominal shapes. Mirrors `reject_wrong_receiver_combinator`'s
# inline extraction (kept as a helper because this arm-picker also
# needs it — one shared shape rather than two copies).
String combinator_receiver_base_name(int receiver_type, ScopeTable scopes, TypeTable types):
    if receiver_type < 0 or receiver_type >= types.types.len():
        return ""
    ResolvedType rt = get_rtype_at(types.types, receiver_type)
    match rt:
        case RTDefined(def_id):
            return scopes.get_def(def_id).name
        case RTGeneric(def_id, _targs):
            return scopes.get_def(def_id).name
        else:
            return ""
    return ""

# Infer a closure-arg's declared return type by descending into an
# `EClosure` body's last stmt. Returns -1 on non-closure args
# (already-typed identifier / free-fn ref) — the caller then skips the
# check (we cannot adjudicate what we cannot read). Empty `param_types`
# is deliberate: this runs BEFORE the closure body's typecheck walk,
# so param types are Unknown; the axis extractor bails on Unknown
# (mirrors production's `is_fully_concrete` gate + ggdef's `Ty::Unknown`
# no-op).
int closure_arg_ret_ty(SpannedExpr arg_expr, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    match arg_expr.expr:
        case EClosure(_params, body):
            if body.len() == 0:
                return -1
            Stmt last = body.get(body.len() - 1).unwrap()
            Dict[String, int] empty_pt = Dict[String, int]()
            return infer_closure_return_type(last, empty_pt, scopes, &types, &ctx)
        else:
            return -1
    return -1

# The axis-unify helper — SH mirror of production
# `src/semantic/typecheck.rs::TypeChecker::unify_closure_ret_axis` and
# ggdef `Elaborator::unify_closure_ret_axis`. Emits `E_TypeMismatch`
# (`DkTypeMismatch` → `diag_kind_code`) when the passthrough axis
# differs between receiver and closure return, so the driver's
# `has_errors` gate halts BEFORE lowering.
void unify_closure_ret_axis(int cell, int receiver_type, int closure_ret_type, Span span, ScopeTable scopes, TypeTable types, ResolveContext &ctx):
    if cell < 1 or cell > 3:
        return
    int axis = axis_index_for_cell(cell)
    int recv_payload = option_or_result_payload(receiver_type, axis, scopes, types)
    int closure_payload = option_or_result_payload(closure_ret_type, axis, scopes, types)
    # Bail on non-Option/Result on either side, unresolved payloads, or
    # missing axis slot — the mismatch (if real) surfaces via a distinct
    # upstream diagnostic, never cascade a TypeMismatch on top.
    if recv_payload < 0 or closure_payload < 0:
        return
    if recv_payload == closure_payload:
        return
    String msg = "type mismatch: expected `" + describe_type(receiver_type, scopes, types) + "`, found `" + describe_type(closure_ret_type, scopes, types) + "`"
    ctx.diagnostics.push(Diagnostic.error(span, DkTypeMismatch(), msg))

void walk_expr_closures_inner(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match sexpr.expr:
        case ECall(callee, args, targs):
            walk_expr_closures(*callee, scope_id, &scopes, &types, &ctx)
            # Infer callee type to extract expected param types for closure args
            Vector[int] call_param_types = Vector[int]()
            int callee_type = infer_expr_type(SpannedExpr((*callee).expr, (*callee).span), scopes, &types, &ctx)
            if callee_type >= 0 and callee_type < types.types.len():
                ResolvedType ct = get_rtype_at(types.types, callee_type)
                match ct:
                    case RTFunction(ptypes, _, _):
                        call_param_types = ptypes
                    else:
                        pass
            # PositionalAfterNamed — a positional arg may not follow a named
            # one. Each arg is a CallArg whose `.name` is Some(kw) for a named
            # arg, None for positional. Once a named arg is seen, a later
            # positional arg is rejected. Mirrors src/semantic/typecheck.rs:5314
            # (SemanticErrorKind::PositionalAfterNamed).
            bool seen_named = false
            for (ai, arg) in args.enumerate():
                if arg.name is Some(_aname):
                    seen_named = true
                elif seen_named:
                    ctx.diagnostics.push(Diagnostic.error(arg.value.span, DkPositionalAfterNamed(), "positional argument cannot follow named argument"))
                if ai < call_param_types.len():
                    walk_expr_closures_with_type(arg.value, get_int_at(call_param_types, ai), scope_id, &scopes, &types, &ctx)
                else:
                    walk_expr_closures(arg.value, scope_id, &scopes, &types, &ctx)

        case EMethodCall(obj, method_name, args, targs):
            walk_expr_closures(*obj, scope_id, &scopes, &types, &ctx)
            # PositionalAfterNamed — a positional arg may not follow a named
            # one. Same contract as the ECall case above: each CallArg's `.name`
            # is Some(kw) for a named arg, None for positional. The receiver is
            # the separate `obj` field, NOT part of `args`, so there is no
            # off-by-one against `self` — `args` covers only the EXPLICIT args
            # after the receiver. Invariant #8: this completes the class the
            # free-fn ECall check started. Mirrors src/semantic/typecheck.rs's
            # EMethodCall arm (SemanticErrorKind::PositionalAfterNamed).
            bool m_seen_named = false
            for (mai, marg) in args.enumerate():
                if marg.name is Some(_maname):
                    m_seen_named = true
                elif m_seen_named:
                    ctx.diagnostics.push(Diagnostic.error(marg.value.span, DkPositionalAfterNamed(), "positional argument cannot follow named argument"))
            # Infer receiver element type for collection higher-order methods
            int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            # Round XXVII Track C — class-fix chokepoint: REJECT one-sided
            # Result/Option combinators used on the wrong receiver BEFORE
            # the existing resolve/inference does anything with them. See
            # `reject_wrong_receiver_combinator` above for the ratified 5
            # cells and the ggdef/Rust cross-lane pins.
            reject_wrong_receiver_combinator(obj_type, method_name, sexpr.span, scopes, types, &ctx)
            # Round XXVIII Track E — closure-returning combinator axis-unify.
            # SH mirror of `src/semantic/typecheck.rs::unify_closure_ret_axis`
            # + ggdef `spec/ggdef/src/elaborate/mod.rs:2373`. Collapsed into
            # ONE call site (Core #4 chokepoint) like ggdef; production has
            # one arm per cell. `combinator_axis_cell` returns -1 for
            # out-of-class (`.map` / `.map_err` / one-sided rejected above);
            # closure_arg_ret_ty returns -1 for non-closure args; both cases
            # skip the check without diagnostic (mirrors production/ggdef).
            int _cell = combinator_axis_cell(combinator_receiver_base_name(obj_type, scopes, types), method_name)
            if _cell >= 1 and args.len() >= 1:
                SpannedExpr _clo_arg = args.get(0).unwrap().value
                int _clo_ret = closure_arg_ret_ty(_clo_arg, scopes, &types, &ctx)
                if _clo_ret >= 0:
                    unify_closure_ret_axis(_cell, obj_type, _clo_ret, sexpr.span, scopes, types, &ctx)
            int elem_type = extract_element_type(obj_type, scopes, types).unwrap_or(-1)
            # Resolve full method signature for closure-arg type propagation.
            # This lets (r): body get its param typed when passed to a method
            # expecting Callable[ReturnType(ParamType)].
            Vector[int] method_param_types = Vector[int]()
            if obj_type >= 0 and obj_type < types.types.len():
                MethodResolution mres = resolve_method_full(obj_type, method_name, scopes, &types)
                if not mres.found:
                    String recv_name = ""
                    ResolvedType obj_rt = get_rtype_at(types.types, obj_type)
                    match obj_rt:
                        case RTDefined(rdef):
                            recv_name = scopes.get_def(rdef).name
                        case RTGeneric(rdef, _):
                            recv_name = scopes.get_def(rdef).name
                        else:
                            pass
                    if recv_name.len() > 0:
                        mres = resolve_method_by_name(types.trait_registry, recv_name, method_name)
                if mres.found:
                    method_param_types = mres.sig.params
            for (ai, arg) in args.enumerate():
                int expected = -1
                if elem_type >= 0:
                    if (method_name == "filter" or method_name == "any" or method_name == "all" or method_name == "each") and ai == 0:
                        # (T) -> bool
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        expected = types.add_type(!RTFunction(ptypes, owns, types.bool_id))
                    elif method_name == "map" and ai == 0:
                        # (T) -> ?
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        expected = types.add_type(!RTFunction(ptypes, owns, -1))
                    elif (method_name == "fold" or method_name == "reduce") and ai == 1:
                        # (U, T) -> U
                        int init_type = infer_expr_type(args.get(0).unwrap().value, scopes, &types, &ctx)
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(init_type)
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        owns.push(0)
                        expected = types.add_type(!RTFunction(ptypes, owns, init_type))
                # Fallback: use method signature's param type for this arg index.
                # Enables closure params to be typed when the method expects a
                # Callable/function-type argument (e.g. router.get(path, (r): ...)).
                if expected < 0 and ai < method_param_types.len():
                    expected = get_int_at(method_param_types, ai)
                if expected >= 0:
                    walk_expr_closures_with_type(arg.value, expected, scope_id, &scopes, &types, &ctx)
                else:
                    walk_expr_closures(arg.value, scope_id, &scopes, &types, &ctx)

        case EBinaryOp(left, op, right):
            walk_expr_closures(*left, scope_id, &scopes, &types, &ctx)
            walk_expr_closures(*right, scope_id, &scopes, &types, &ctx)
            # NOTE: the `lhs ?? rhs`-on-non-Option/Result REJECT is NOT here.
            # `walk_expr_closures` is a CLOSURE-FINDING pass that only recurses
            # into a handful of parent shapes (ECall/EMethodCall/EBinaryOp/EAwait/
            # EBlock/EDo/EFString/EMatch) and hits `else: pass` for the rest, so a
            # `??` nested inside EUnaryOp/EIndex/EArrayLiteral/EAs/… ESCAPES it.
            # The reject is driven from the dedicated EXHAUSTIVE walker
            # `check_safety_*` (below), modeled on resolve.gg's `resolve_expr`
            # enumeration, so EVERY `??` position is covered exactly once.

        case EAwait(inner):
            # DoubleAwait — `await await x` is a syntactic mistake. The
            # second await operates on T (already unwrapped from Task[T]),
            # virtually always a bug. Mirrors src/semantic/typecheck.rs:2075
            # (SemanticErrorKind::DoubleAwait). Driven from the walk pass
            # rather than infer.gg's EAwait case so it fires reliably at
            # both VarDecl init AND return-position uses (infer is only
            # driven on the former; the latter currently only walks).
            match (*inner).expr:
                case EAwait(_):
                    ctx.diagnostics.push(Diagnostic.error(sexpr.span, DkDoubleAwait(), "expression is awaited twice — use either `await expr` or `expr.await()`, not both"))
                else:
                    pass
            walk_expr_closures(*inner, scope_id, &scopes, &types, &ctx)

        case EBlock(body_stmts):
            type_check_stmts(body_stmts, scope_id, &scopes, &types, &ctx)

        case EDo(body_stmts):
            type_check_stmts(body_stmts, scope_id, &scopes, &types, &ctx)

        case EFString(template, exprs, _specs):
            # F-string interpolation segments are pre-parsed into real
            # SpannedExpr by the parser; walk them so closures inside
            # `{...}` get their params/body typed.
            for fe in exprs:
                walk_expr_closures(fe, scope_id, &scopes, &types, &ctx)
                # An Option/Result tag-check interpolation
                # (`f"{m.get(k).is_none()}"`) is CHAINED after a getter: the
                # parser shares one span.start across the chain, so the inner
                # getter's recorded `Option[T]` collides onto the outer
                # `.is_none()` and the lowerer types the f-string arg slot as
                # `Option__T` (cc-fail). The `walk` above only infers the
                # RECEIVER `.get()` (line 1112), never the outer tag-check NODE,
                # so its bool type is never recorded at its own span.end. Infer
                # the tag-check node itself so `infer_expr_type`'s tag-check arm
                # (infer.gg) records bool at the UNIQUE span.end
                # (`expr_link_types`), which the lowerer reads FIRST. Scoped to
                # the four tag-check intrinsics — NOT a blanket "infer every
                # interpolation". Even with the nested-f-string synthetic-window
                # collision now fixed (parser.gg — the sub-parser threads the
                # shared counter), blanket inference STILL regresses two
                # independent classes (scout-measured 2026-07-01): (a) char
                # predicates (`c.is_alpha()`) are absent from `infer_expr_type`'s
                # bool arms → mis-typed; (b) an INLINE chained call in an interp
                # (`f"{name.trim().len()}"`) — the `.trim()` recursion writes
                # String at the shared span.start and the outer `.len()` reads it
                # (cc-fail / garbage pointer). The span.start-collision class is a
                # DEEPER bug than the nested-window one; retiring the guard needs
                # every method-return arm to record at span.end AND the lowerer's
                # span.end oracle to be complete for all chains. Filed in TODO.md.
                if fstring_interp_is_tag_check(fe):
                    int _tc_ignore = infer_expr_type(fe, scopes, &types, &ctx)

        case EMatch(scrutinee, arms):
            # Match-as-expression: assign pattern binding types and walk arm bodies.
            # Round XXVIII Track E — WALK the scrutinee too (not just infer):
            # a match scrutinee may be a method call carrying a closure arg
            # (`match p.or_else((): body): ...`), and the axis-unify chokepoint
            # (`unify_closure_ret_axis` in the EMethodCall arm) only fires
            # from the walker. Without this recurse, a cross-type closure
            # return inside a match scrutinee slips past the check.
            walk_expr_closures(*scrutinee, scope_id, &scopes, &types, &ctx)
            int scrut_type = infer_expr_type(SpannedExpr((*scrutinee).expr, (*scrutinee).span), scopes, &types, &ctx)
            for arm in arms:
                if scrut_type >= 0:
                    assign_pattern_types(arm.pattern, scrut_type, scope_id, &scopes, &types, &ctx)
                type_check_stmts(arm.body, scope_id, &scopes, &types, &ctx)

        else:
            pass

# ── Rebuild closure variable type from now-typed params ───────
# After walk_expr_closures assigns types to closure param defs,
# rebuild the RTFunction type for the auto-variable holding the closure.

void rebuild_closure_var_type(String var_name, Vector[Param] cl_params, Vector[Stmt] cl_body, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    # Find each param def that has a type var assigned (from walk_expr_closures)
    Vector[int] param_type_ids = Vector[int]()
    Vector[int] param_ownerships = Vector[int]()
    Vector[int] param_def_ids = Vector[int]()
    Dict[String, int] param_types = Dict[String, int]()
    for p in cl_params:
        # Find the param def with a type-var type (distinguishes from earlier same-name defs)
        int p_def = find_typevar_def(scope_id, p.param_name, scopes, types).unwrap_or(-1)
        int p_tid = types.error_id
        if p_def >= 0:
            DefInfo pd = scopes.get_def(p_def)
            if pd.type_id >= 0:
                p_tid = pd.type_id
        param_type_ids.push(p_tid)
        param_ownerships.push(p.ownership)
        param_def_ids.push(p_def)
        param_types.put(p.param_name, p_tid)
    # Infer return type from closure body with typed params
    int ret_id = types.void_id
    if cl_body.len() > 0:
        Stmt last = cl_body.get(cl_body.len() - 1).unwrap()
        int inferred_ret = infer_closure_return_type(last, param_types, scopes, &types, &ctx)
        if inferred_ret >= 0:
            ret_id = inferred_ret
    # Build the new function type and update the variable
    int fn_type = types.add_type(!RTFunction(param_type_ids, param_ownerships, ret_id))
    if scopes.lookup_in_subtree(scope_id, var_name) is Some(var_def):
        scopes.set_def_type(var_def, fn_type)

Option[int] find_typevar_def(int scope_id, String name, ScopeTable scopes, TypeTable types):
    # Find a def named `name` in the subtree that has a type-var type
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.name == name and d.type_id >= 0:
            ResolvedType rt = get_rtype_at(types.types, d.type_id)
            match rt:
                case RTVar(_):
                    if scopes.is_descendant_of(d.scope_id, scope_id):
                        return Some(i)
                else:
                    pass
        i = i + 1
    return None()

# ── Call-site closure type var resolution ─────────────────────
# After type_check_stmts, scan for calls like `add(3, 4)` where the callee
# has type vars in its function type. Propagate concrete arg types back.

void resolve_closure_types_from_calls(Vector[Stmt] stmts, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    for s in stmts:
        resolve_call_in_stmt(s, scope_id, &scopes, &types, &ctx)

void resolve_call_in_stmt(Stmt s, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match s:
        case SExpr(sexpr):
            resolve_call_in_expr(sexpr, scope_id, &scopes, &types, &ctx)
        case SVarDecl(_, _, init_expr, _, _, _):
            resolve_call_in_expr(init_expr, scope_id, &scopes, &types, &ctx)
        else:
            pass

void resolve_call_in_expr(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match sexpr.expr:
        case ECall(callee, args, targs):
            # Check if callee is an identifier with a function type containing type vars
            match (*callee).expr:
                case EIdentifier(name):
                    if scopes.lookup_in_subtree(scope_id, name) is Some(callee_def):
                        DefInfo cd = scopes.get_def(callee_def)
                        if cd.type_id >= 0:
                            ResolvedType fn_rt = get_rtype_at(types.types, cd.type_id)
                            match fn_rt:
                                case RTFunction(param_tids, ownerships, ret_id):
                                    bool has_var = false
                                    for ptid in param_tids:
                                        ResolvedType prt = get_rtype_at(types.types, ptid)
                                        match prt:
                                            case RTVar(_):
                                                has_var = true
                                            else:
                                                pass
                                    if has_var and args.len() == param_tids.len():
                                        # Build mapping from type var → concrete type
                                        Dict[int, int] var_map = Dict[int, int]()
                                        Vector[int] new_params = Vector[int]()
                                        for (ai, arg) in args.enumerate():
                                            int old_ptid = get_int_at(param_tids, ai)
                                            ResolvedType old_prt = get_rtype_at(types.types, old_ptid)
                                            match old_prt:
                                                case RTVar(var_id):
                                                    int arg_type = infer_expr_type(arg.value, scopes, &types, &ctx)
                                                    if arg_type >= 0 and arg_type != types.error_id:
                                                        new_params.push(arg_type)
                                                        var_map[var_id] = arg_type
                                                    else:
                                                        new_params.push(old_ptid)
                                                else:
                                                    new_params.push(old_ptid)
                                        # Resolve return type: if it's a type var, map it
                                        int new_ret = ret_id
                                        ResolvedType ret_rt = get_rtype_at(types.types, ret_id)
                                        match ret_rt:
                                            case RTVar(var_id):
                                                if var_map.contains(var_id):
                                                    new_ret = var_map.get(var_id).unwrap()
                                            else:
                                                pass
                                        # If return type is still unresolved but params are
                                        # now concrete, infer from the first concrete param
                                        # (heuristic for a + b where a, b are same type)
                                        if new_ret == ret_id:
                                            ResolvedType nr = get_rtype_at(types.types, new_ret)
                                            match nr:
                                                case RTVar(_):
                                                    if new_params.len() > 0:
                                                        new_ret = get_int_at(new_params, 0)
                                                case RTError():
                                                    if new_params.len() > 0:
                                                        new_ret = get_int_at(new_params, 0)
                                                else:
                                                    pass
                                        # Update param defs with concrete types before moving new_params
                                        for (pi, np_tid) in new_params.enumerate():
                                            int old_ptid = get_int_at(param_tids, pi)
                                            if np_tid != old_ptid:
                                                # Find the param def that has the old type var
                                                # and update it to the concrete type
                                                resolve_param_type_var(old_ptid, np_tid, scope_id, &scopes, types)
                                        # Update function type
                                        int new_fn_type = types.add_type(!RTFunction(!new_params, ownerships, new_ret))
                                        scopes.set_def_type(callee_def, new_fn_type)
                                else:
                                    pass
                else:
                    pass
        else:
            pass

void resolve_param_type_var(int old_type_id, int new_type_id, int scope_id, ScopeTable &scopes, TypeTable types):
    # Find any def in the subtree with type_id == old_type_id and update it
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.type_id == old_type_id:
            scopes.set_def_type(i, new_type_id)
        i = i + 1

# ── Method-targs-only recording walk: the snapshot rationale ──
#
# Wherever the per-arm type-check logic does NOT infer an expression, the
# EMethodCall inference arm — the SOLE writer of `expr_method_targs` — never
# runs for the bare-form (no-turbofish) Iterator terminals, and the lowerer
# emits a CALLED-but-never-DEFINED bare symbol (link fail). An explicitly-typed
# binding (`int total = v.iter().fold(0, f)`) is the shape that surfaced it —
# the SVarDecl arm takes the annotation and never infers the initializer — but
# it is NOT the only one: assignment RHS, compound-assign RHS, `return`
# payloads, `if`/`while`/`assert` conditions and every nested expression
# position had the same hole. That is why the recording walk is now driven from
# ONE chokepoint at `type_check_stmt`'s entry over an EXHAUSTIVE traversal,
# instead of from per-arm call sites.
#
# TWO side-effect channels must both be neutralized:
#  1. the BINDING TYPE — the naive fix (`var_type_id = infer_expr_type(init)`)
#     sets it to the inferred `RTArray` instead of the annotated `Vector[int]`
#     and corrupts `set_def_type`, RUN-regressing array-literal lowering (the
#     canary). The walk NEVER writes `var_type_id` (caller keeps the annotation).
#  2. `expr_types` — `infer_expr_type` writes `expr_types[span]` for the
#     registry-resolved calls it visits, and the parser shares ONE span.start
#     across a whole method chain, so the OUTER call's write CLOBBERS the inner
#     receiver's. Inferring the FULL chain top-down here writes a DIFFERENT
#     last-value at that shared key than `walk_expr_closures` (which infers
#     only the receiver) does immediately after — RUN-regressed
#     `string_chained_methods` (`data.trim().to_upper().len()` → the `.to_upper`
#     dispatched to the char overload). We SNAPSHOT `expr_types` and RESTORE it
#     after the walk, so `walk_expr_closures` re-derives `expr_types` exactly as
#     it would have without this walk. (RUN-confirmed both directions.)
#
# ⚠ `expr_types` is the ONLY table restored. The walk also persists
# `expr_method_targs` (the point of the exercise) and — a real, deliberate
# consequence — `expr_link_types` entries that `infer_expr_type` writes for the
# chain links it visits. Those persist because they are keyed on the call's
# UNIQUE `span.end` (see the NOTE below), not on the shared `span.start`, so
# the clobbering channel that forces the `expr_types` snapshot does not exist
# for them: a link's entry can only be re-written by an inference of that SAME
# link. `lower_types.gg` reads `expr_link_types` FIRST for every EMethodCall,
# so a wrong entry would surface as WRONG OUTPUT, not as a link error — the
# corpus runtime-diff is the instrument that adjudicates it.
#
# NOTE: `expr_method_targs` is keyed on the call's UNIQUE `span.end`, NOT the
# shared span.start. So the OUTER terminal (`.fold`) and the INNER receiver
# (`.iter()`) land in DISTINCT slots automatically — each chain link ends at a
# different token, so the key alone keeps every link's targs separate (a chain
# with two method-generic links, `.filter[F]` AND `.map[U,F]`, no longer
# collides away one of them). The recorded method NAME (`expr_method_targs_name`)
# is still checked at the READ sites (lower.gg's call-site + discovery walk) as
# a cheap belt-and-suspenders cross-check — it is no longer the load-bearing
# disambiguator (`span.end` is), it just guards against a stale entry.
# ── Method-targ recording: THE ONE PRODUCER (Core #4 chokepoint) ──
#
# Exhaustive over `enum Expr` in ast.gg. The SOLE recording action is the
# `EMethodCall` arm (delegating to `infer_expr_type`, the sole writer of
# `expr_method_targs`); every other arm exists only to RECURSE, so no
# syntactic position can hide a method call from the recorder. Statement
# bodies carried by expressions (EBlock/EDo/EClosure/EMatch) are NOT walked
# here — `walk_expr_closures` routes those through `type_check_stmts`, which
# re-enters this chokepoint per statement.
# ⚠ `EIf` is the ONE hole in that hand-off: `walk_expr_closures_inner` has no
# `EIf` arm, so the statement bodies of an IF-EXPRESSION are reached by
# nothing. Filed in TODO.md with a `known_gaps` repro; widening that walker is
# the fix, not widening this one (this walker must stay expression-shallow or
# it re-enters the `expr_types` clobbering channel the snapshot exists for).
void record_method_targs_in_expr(SpannedExpr sexpr, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match sexpr.expr:
        case EIntLiteral(_):
            pass
        case EFloatLiteral(_):
            pass
        case EBoolLiteral(_):
            pass
        case EStringLiteral(_, _):
            pass
        case ECharLiteral(_):
            pass
        case ENoneLiteral():
            pass
        case EIdentifier(_):
            pass
        case ESelfExpr():
            pass
        case EIt():
            pass
        case EBinaryOp(r0, _, r2):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r2, &scopes, &types, &ctx)
        case EUnaryOp(_, r1):
            record_method_targs_in_expr(*r1, &scopes, &types, &ctx)
        case ECall(r0, r1, _):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            for __aR1 in r1:
                record_method_targs_in_expr(__aR1.value, &scopes, &types, &ctx)
        case EMethodCall(_, _, margs, _):
            # `infer_expr_type` walks the receiver and records THIS call's
            # method targs. It does NOT record targs for method calls nested
            # in the ARGUMENTS, so recurse into those explicitly.
            int _ignore = infer_expr_type(sexpr, scopes, &types, &ctx)
            for __marg in margs:
                record_method_targs_in_expr(__marg.value, &scopes, &types, &ctx)
        case EFieldAccess(r0, _):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EIndex(r0, r1):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r1, &scopes, &types, &ctx)
        case ERange(r0, r1, _):
            if r0 is Some(__bR0):
                record_method_targs_in_expr(*__bR0, &scopes, &types, &ctx)
            if r1 is Some(__bR1):
                record_method_targs_in_expr(*__bR1, &scopes, &types, &ctx)
        case EIf(r0, _, r2):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            for __ebR2 in r2:
                if __ebR2.condition is Some(__cR2):
                    record_method_targs_in_expr(__cR2, &scopes, &types, &ctx)
        case EMatch(r0, r1):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            for __armR1 in r1:
                if __armR1.guard is Some(__gR1):
                    record_method_targs_in_expr(__gR1, &scopes, &types, &ctx)
        case EClosure(_, _):
            pass
        case EImplicitClosure(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EArrayLiteral(r0):
            for __eR0 in r0:
                record_method_targs_in_expr(__eR0, &scopes, &types, &ctx)
        case ETupleLiteral(r0):
            for __eR0 in r0:
                record_method_targs_in_expr(__eR0, &scopes, &types, &ctx)
        case EDictLiteral(r0, r1):
            for __eR0 in r0:
                record_method_targs_in_expr(__eR0, &scopes, &types, &ctx)
            for __eR1 in r1:
                record_method_targs_in_expr(__eR1, &scopes, &types, &ctx)
        case EStructLiteral(_, _, r2):
            for __eR2 in r2:
                record_method_targs_in_expr(__eR2, &scopes, &types, &ctx)
        case EDotShorthand(_, r1):
            for __aR1 in r1:
                record_method_targs_in_expr(__aR1.value, &scopes, &types, &ctx)
        case ETry(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EMove(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EPropagate(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EMutableBorrow(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EDeref(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EAs(r0, _):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EBlock(_):
            pass
        case EListComp(r0, _, r2, r3):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r2, &scopes, &types, &ctx)
            if r3 is Some(__bR3):
                record_method_targs_in_expr(*__bR3, &scopes, &types, &ctx)
        case ESetComp(r0, _, r2, r3):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r2, &scopes, &types, &ctx)
            if r3 is Some(__bR3):
                record_method_targs_in_expr(*__bR3, &scopes, &types, &ctx)
        case EDictComp(r0, r1, _, r3, r4):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r1, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r3, &scopes, &types, &ctx)
            if r4 is Some(__bR4):
                record_method_targs_in_expr(*__bR4, &scopes, &types, &ctx)
        case EDefaultOp(r0, r1):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r1, &scopes, &types, &ctx)
        case EIs(r0, _, _):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case EDo(_):
            pass
        case EAwait(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case ESpawn(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case ESpawnBlocking(r0):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
        case ERethrow(r0, _, _, r3):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r3, &scopes, &types, &ctx)
        case ECatch(r0, _, r2):
            record_method_targs_in_expr(*r0, &scopes, &types, &ctx)
            record_method_targs_in_expr(*r2, &scopes, &types, &ctx)
        case EFString(_, r1, _):
            for __eR1 in r1:
                record_method_targs_in_expr(__eR1, &scopes, &types, &ctx)

# Statement-level half of the chokepoint. SHALLOW (see `stmt_has_method_call`).
void record_method_targs_in_stmt(Stmt s, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match s:
        case SVarDecl(_, _, t2, _, _, _):
            record_method_targs_in_expr(t2, &scopes, &types, &ctx)
        case SAssign(t0, t1):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            record_method_targs_in_expr(t1, &scopes, &types, &ctx)
        case SCompoundAssign(t0, _, t2):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            record_method_targs_in_expr(t2, &scopes, &types, &ctx)
        case SExpr(t0):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SReturn(t0):
            if t0 is Some(__xT0):
                record_method_targs_in_expr(__xT0, &scopes, &types, &ctx)
        case SThrow(t0):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SBreak():
            pass
        case SContinue():
            pass
        case SPass():
            pass
        case SMeta():
            pass
        case SMetaFor(_, t1, _):
            record_method_targs_in_expr(t1, &scopes, &types, &ctx)
        case SMetaIf(t0, _, t2):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            for __ebT2 in t2:
                if __ebT2.condition is Some(__cT2):
                    record_method_targs_in_expr(__cT2, &scopes, &types, &ctx)
        case SMetaConst(_, t1):
            record_method_targs_in_expr(t1, &scopes, &types, &ctx)
        case SMetaForMatch(_, t1, t2):
            record_method_targs_in_expr(t1, &scopes, &types, &ctx)
            for __armT2 in t2:
                if __armT2.guard is Some(__gT2):
                    record_method_targs_in_expr(__gT2, &scopes, &types, &ctx)
        case SMetaMatch(t0, t1, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            for __maT1 in t1:
                record_method_targs_in_expr(__maT1.case_value, &scopes, &types, &ctx)
        case SMetaWhile(t0, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SFor(_, t1, _, _, _):
            record_method_targs_in_expr(t1, &scopes, &types, &ctx)
        case SWhile(t0, _, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SLoop(_):
            pass
        case SIf(t0, _, t2):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            for __ebT2 in t2:
                if __ebT2.condition is Some(__cT2):
                    record_method_targs_in_expr(__cT2, &scopes, &types, &ctx)
        case SMatch(t0, t1):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
            for __armT1 in t1:
                if __armT1.guard is Some(__gT1):
                    record_method_targs_in_expr(__gT1, &scopes, &types, &ctx)
        case SWith(t0, _, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SAssert(t0, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SAssertReturn(t0, _):
            record_method_targs_in_expr(t0, &scopes, &types, &ctx)
        case SNamedScope(_, _):
            pass
        case SSelect(t0):
            for __saT0 in t0:
                match __saT0.op:
                    case SORecv(_, _, __seT0):
                        record_method_targs_in_expr(__seT0, &scopes, &types, &ctx)
                    case SOSend(__scT0, __svT0):
                        record_method_targs_in_expr(__scT0, &scopes, &types, &ctx)
                        record_method_targs_in_expr(__svT0, &scopes, &types, &ctx)
        case SOnError(_):
            pass
        case SItem(_):
            pass
        case SSnapshot(_, _, t2):
            record_method_targs_in_expr(t2, &scopes, &types, &ctx)

# True iff `fe` is a call to one of the four Option/Result tag-check
# intrinsics (`is_none`/`is_some`/`is_ok`/`is_error`). This EXACT set is the
# one source of truth shared with `infer_expr_type`'s tag-check bool arm
# (infer.gg) and the lowerer's `infer_method_return_type` (lower_types.gg:1888).
# Used by the EFString arm to infer ONLY the tag-check interpolations — the
# minimal set that needs its bool type recorded at its own span.end to beat the
# getter-chain span.start collision — without re-inferring EVERY interpolation
# (which would mis-key other interps onto the parser's synthetic f-string
# span offsets).
bool fstring_interp_is_tag_check(SpannedExpr fe):
    match fe.expr:
        case EMethodCall(_, m, _, _):
            return m == "is_none" or m == "is_some" or m == "is_ok" or m == "is_error"
        else:
            return false
    return false

# CHOKEPOINT GATE — exhaustive over `enum Expr` in ast.gg. Cheap structural
# pre-check so the expr_types snapshot/restore is only paid when a method
# call is actually present. Guarded by the arm-exhaustiveness lint.
bool expr_has_method_call(SpannedExpr sexpr):
    match sexpr.expr:
        case EIntLiteral(_):
            return false
        case EFloatLiteral(_):
            return false
        case EBoolLiteral(_):
            return false
        case EStringLiteral(_, _):
            return false
        case ECharLiteral(_):
            return false
        case ENoneLiteral():
            return false
        case EIdentifier(_):
            return false
        case ESelfExpr():
            return false
        case EIt():
            return false
        case EBinaryOp(h0, _, h2):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h2):
                return true
            return false
        case EUnaryOp(_, h1):
            if expr_has_method_call(*h1):
                return true
            return false
        case ECall(h0, h1, _):
            if expr_has_method_call(*h0):
                return true
            for __aH1 in h1:
                if expr_has_method_call(__aH1.value):
                    return true
            return false
        case EMethodCall(_, _, _, _):
            return true
        case EFieldAccess(h0, _):
            if expr_has_method_call(*h0):
                return true
            return false
        case EIndex(h0, h1):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h1):
                return true
            return false
        case ERange(h0, h1, _):
            if h0 is Some(__bH0):
                if expr_has_method_call(*__bH0):
                    return true
            if h1 is Some(__bH1):
                if expr_has_method_call(*__bH1):
                    return true
            return false
        case EIf(h0, _, h2):
            if expr_has_method_call(*h0):
                return true
            for __ebH2 in h2:
                if __ebH2.condition is Some(__cH2):
                    if expr_has_method_call(__cH2):
                        return true
            return false
        case EMatch(h0, h1):
            if expr_has_method_call(*h0):
                return true
            for __armH1 in h1:
                if __armH1.guard is Some(__gH1):
                    if expr_has_method_call(__gH1):
                        return true
            return false
        case EClosure(_, _):
            return false
        case EImplicitClosure(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EArrayLiteral(h0):
            for __eH0 in h0:
                if expr_has_method_call(__eH0):
                    return true
            return false
        case ETupleLiteral(h0):
            for __eH0 in h0:
                if expr_has_method_call(__eH0):
                    return true
            return false
        case EDictLiteral(h0, h1):
            for __eH0 in h0:
                if expr_has_method_call(__eH0):
                    return true
            for __eH1 in h1:
                if expr_has_method_call(__eH1):
                    return true
            return false
        case EStructLiteral(_, _, h2):
            for __eH2 in h2:
                if expr_has_method_call(__eH2):
                    return true
            return false
        case EDotShorthand(_, h1):
            for __aH1 in h1:
                if expr_has_method_call(__aH1.value):
                    return true
            return false
        case ETry(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EMove(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EPropagate(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EMutableBorrow(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EDeref(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case EAs(h0, _):
            if expr_has_method_call(*h0):
                return true
            return false
        case EBlock(_):
            return false
        case EListComp(h0, _, h2, h3):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h2):
                return true
            if h3 is Some(__bH3):
                if expr_has_method_call(*__bH3):
                    return true
            return false
        case ESetComp(h0, _, h2, h3):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h2):
                return true
            if h3 is Some(__bH3):
                if expr_has_method_call(*__bH3):
                    return true
            return false
        case EDictComp(h0, h1, _, h3, h4):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h1):
                return true
            if expr_has_method_call(*h3):
                return true
            if h4 is Some(__bH4):
                if expr_has_method_call(*__bH4):
                    return true
            return false
        case EDefaultOp(h0, h1):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h1):
                return true
            return false
        case EIs(h0, _, _):
            if expr_has_method_call(*h0):
                return true
            return false
        case EDo(_):
            return false
        case EAwait(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case ESpawn(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case ESpawnBlocking(h0):
            if expr_has_method_call(*h0):
                return true
            return false
        case ERethrow(h0, _, _, h3):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h3):
                return true
            return false
        case ECatch(h0, _, h2):
            if expr_has_method_call(*h0):
                return true
            if expr_has_method_call(*h2):
                return true
            return false
        case EFString(_, h1, _):
            for __eH1 in h1:
                if expr_has_method_call(__eH1):
                    return true
            return false
    return false

# CHOKEPOINT GATE (statement level) — SHALLOW over `enum Stmt`: this
# statement's OWN expressions only. Nested `Vector[Stmt]` bodies are reached
# because `type_check_stmts` invokes `type_check_stmt` — and therefore this
# chokepoint — for every nested statement in turn.
bool stmt_has_method_call(Stmt s):
    match s:
        case SVarDecl(_, _, q2, _, _, _):
            if expr_has_method_call(q2):
                return true
            return false
        case SAssign(q0, q1):
            if expr_has_method_call(q0):
                return true
            if expr_has_method_call(q1):
                return true
            return false
        case SCompoundAssign(q0, _, q2):
            if expr_has_method_call(q0):
                return true
            if expr_has_method_call(q2):
                return true
            return false
        case SExpr(q0):
            if expr_has_method_call(q0):
                return true
            return false
        case SReturn(q0):
            if q0 is Some(__xQ0):
                if expr_has_method_call(__xQ0):
                    return true
            return false
        case SThrow(q0):
            if expr_has_method_call(q0):
                return true
            return false
        case SBreak():
            return false
        case SContinue():
            return false
        case SPass():
            return false
        case SMeta():
            return false
        case SMetaFor(_, q1, _):
            if expr_has_method_call(q1):
                return true
            return false
        case SMetaIf(q0, _, q2):
            if expr_has_method_call(q0):
                return true
            for __ebQ2 in q2:
                if __ebQ2.condition is Some(__cQ2):
                    if expr_has_method_call(__cQ2):
                        return true
            return false
        case SMetaConst(_, q1):
            if expr_has_method_call(q1):
                return true
            return false
        case SMetaForMatch(_, q1, q2):
            if expr_has_method_call(q1):
                return true
            for __armQ2 in q2:
                if __armQ2.guard is Some(__gQ2):
                    if expr_has_method_call(__gQ2):
                        return true
            return false
        case SMetaMatch(q0, q1, _):
            if expr_has_method_call(q0):
                return true
            for __maQ1 in q1:
                if expr_has_method_call(__maQ1.case_value):
                    return true
            return false
        case SMetaWhile(q0, _):
            if expr_has_method_call(q0):
                return true
            return false
        case SFor(_, q1, _, _, _):
            if expr_has_method_call(q1):
                return true
            return false
        case SWhile(q0, _, _):
            if expr_has_method_call(q0):
                return true
            return false
        case SLoop(_):
            return false
        case SIf(q0, _, q2):
            if expr_has_method_call(q0):
                return true
            for __ebQ2 in q2:
                if __ebQ2.condition is Some(__cQ2):
                    if expr_has_method_call(__cQ2):
                        return true
            return false
        case SMatch(q0, q1):
            if expr_has_method_call(q0):
                return true
            for __armQ1 in q1:
                if __armQ1.guard is Some(__gQ1):
                    if expr_has_method_call(__gQ1):
                        return true
            return false
        case SWith(q0, _, _):
            if expr_has_method_call(q0):
                return true
            return false
        case SAssert(q0, _):
            if expr_has_method_call(q0):
                return true
            return false
        case SAssertReturn(q0, _):
            if expr_has_method_call(q0):
                return true
            return false
        case SNamedScope(_, _):
            return false
        case SSelect(q0):
            for __saQ0 in q0:
                match __saQ0.op:
                    case SORecv(_, _, __seQ0):
                        if expr_has_method_call(__seQ0):
                            return true
                    case SOSend(__scQ0, __svQ0):
                        if expr_has_method_call(__scQ0):
                            return true
                        if expr_has_method_call(__svQ0):
                            return true
            return false
        case SOnError(_):
            return false
        case SItem(_):
            return false
        case SSnapshot(_, _, q2):
            if expr_has_method_call(q2):
                return true
            return false
    return false

# THE ONE CALL SITE's entry point: record bare-form method-targs for every
# expression THIS statement carries, WITHOUT perturbing `expr_types` or any
# binding type. Snapshots `expr_types`, runs the recording walk (which writes
# `expr_method_targs` — KEPT — and `expr_types` — DISCARDED), then restores the
# snapshot so `walk_expr_closures` re-derives `expr_types` exactly as it would
# have. Gated on a method call being present (`stmt_has_method_call`) so the
# `Dict.clone()` snapshot is paid only by statements that can need it.
void record_method_targs_for_stmt(Stmt s, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    if not stmt_has_method_call(s):
        return
    Dict[int, int] saved_expr_types = types.expr_types.clone()
    record_method_targs_in_stmt(s, &scopes, &types, &ctx)
    types.expr_types = saved_expr_types

# ── Sized-int literal range check (ValueOutOfRange) ──────────
# Mirrors Rust's IntLiteral/UnaryOp::Neg range check in
# src/semantic/typecheck.rs:1146/1311 (kind SemanticErrorKind::ValueOutOfRange,
# range table `fn int_range` at :182, message at errors.rs:846). Rust rejects a
# literal initializer that does not fit the declared sized-int type
# (`int8 x = 200`); the self-host used to silently accept + lower it.
#
# Fires ONLY when (a) the annotation is one of the 6 SMALLER sized ints
# (int8/16/32, uint8/16/32 — bare `int`=int64 and uint64 are i64-backed in the
# self-host's EIntLiteral, so their checks are unrepresentable / full-range and
# OUT OF SCOPE, matching the brief), and (b) the initializer is a LITERAL: a
# bare `EIntLiteral` or the negative shape `EUnaryOp("-", EIntLiteral)` (a `-N`
# literal parses as unary-neg of N, so the signed value is computed before the
# range check — this both accepts `-128` and rejects `-129`). Non-literal inits
# (`f()`, `a + b`) are NOT const-folded — Rust only range-checks the literal
# site here, and we match that. Inclusive ranges throughout.
void check_sized_int_literal_range(SpannedExpr init_expr, int var_type_id, TypeTable types, ResolveContext &ctx):
    if var_type_id < 0 or var_type_id >= types.types.len():
        return
    ResolvedType vrt = get_rtype_at(types.types, var_type_id)
    String prim_name = ""
    match vrt:
        case RTPrimitive(pname):
            prim_name = pname
        else:
            return
    # Inclusive (min, max) for the smaller sized ints only.
    bool is_sized = false
    int range_min = 0
    int range_max = 0
    if prim_name == "int8":
        is_sized = true
        range_min = -128
        range_max = 127
    elif prim_name == "int16":
        is_sized = true
        range_min = -32768
        range_max = 32767
    elif prim_name == "int32":
        is_sized = true
        range_min = -2147483648
        range_max = 2147483647
    elif prim_name == "uint8":
        is_sized = true
        range_min = 0
        range_max = 255
    elif prim_name == "uint16":
        is_sized = true
        range_min = 0
        range_max = 65535
    elif prim_name == "uint32":
        is_sized = true
        range_min = 0
        range_max = 4294967295
    if not is_sized:
        return
    # Extract the signed literal value, if the initializer is a literal shape.
    bool is_literal = false
    int value = 0
    match init_expr.expr:
        case EIntLiteral(n):
            is_literal = true
            value = n
        case EUnaryOp(op, inner):
            if op == "-":
                match (*inner).expr:
                    case EIntLiteral(n):
                        is_literal = true
                        value = -n
                    else:
                        pass
        else:
            pass
    if not is_literal:
        return
    if value < range_min or value > range_max:
        ctx.diagnostics.push(Diagnostic.error(init_expr.span, DkValueOutOfRange(), f"value {value} is out of range for type {prim_name} (valid range: {range_min}..={range_max})"))

# ── Unsupported operator reject (E_UnsupportedOperator) ─────
# Mirrors Rust `operator_supported_for_type` / `check_operator_supported`
# (src/semantic/typecheck.rs). Gates compound assign (type_check_stmt
# SCompoundAssign, compound=true) and binary arith/bitwise (check_safety
# EBinaryOp, compound=false) so accepted programs never reach the
# resource-moves ICE or broken C for non-Add ops on String/Money/etc.
#
# Type keys come from resolved types (primitive / def name / Array) — never
# from identifier strings. Trait satisfaction uses the typed EquipInfo
# registry + primitive intrinsic helpers (primitive_satisfies_trait).

# Trait-registry key for `ty`. Empty string = don't gate (Error/Never/Var).
String type_key_for_trait_lookup(int type_id, ScopeTable scopes, TypeTable types):
    if type_id < 0 or type_id >= types.types.len():
        return ""
    int tid = type_id
    # Peel one Ref layer (borrowed Money still keys as Money).
    ResolvedType peel = get_rtype_at(types.types, tid)
    match peel:
        case RTRef(inner):
            if inner >= 0 and inner < types.types.len():
                tid = inner
        else:
            pass
    ResolvedType rt = get_rtype_at(types.types, tid)
    match rt:
        case RTPrimitive(name):
            # Rust describe_primitive maps StringType → "String"; SH splits
            # str/String primitives — both key as String for concat/trait lookup.
            if name == "str" or name == "String":
                return "String"
            return name
        case RTDefined(def_id):
            DefInfo d = scopes.get_def(def_id)
            return d.name
        case RTGeneric(def_id, _):
            DefInfo d = scopes.get_def(def_id)
            return d.name
        case RTArray(_, _):
            return "Array"
        case RTError():
            return ""
        case RTNever():
            return ""
        case RTVar(_):
            return ""
        else:
            return ""

# Integer-only primitives (wrap / bitwise / shifts). No float.
bool is_integer_primitive_key(String key):
    if key == "int" or key == "int8" or key == "int16" or key == "int32" or key == "int64":
        return true
    if key == "uint" or key == "uint8" or key == "uint16" or key == "uint32" or key == "uint64":
        return true
    return false

# Normalize compound op spelling to the binary base (`-=` → `-`).
String arith_base_op(String op):
    if op == "+=":
        return "+"
    if op == "-=":
        return "-"
    if op == "*=":
        return "*"
    if op == "/=":
        return "/"
    if op == "%=":
        return "%"
    if op == "+%=":
        return "+%"
    if op == "-%=":
        return "-%"
    if op == "*%=":
        return "*%"
    if op == "**=":
        return "**"
    if op == "&=":
        return "&"
    if op == "|=":
        return "|"
    if op == "^=":
        return "^"
    if op == "<<=":
        return "<<"
    if op == ">>=":
        return ">>"
    return op

bool is_integer_only_op(String base):
    if base == "+%" or base == "-%" or base == "*%":
        return true
    if base == "&" or base == "|" or base == "^" or base == "<<" or base == ">>":
        return true
    return false

# Trait name for an overloadable arithmetic op, or "" if none.
String op_trait_name(String base):
    if base == "+":
        return "Add"
    if base == "-":
        return "Sub"
    if base == "*":
        return "Mul"
    if base == "/":
        return "Div"
    if base == "%":
        return "Rem"
    if base == "mod":
        return "Mod"
    return ""

String op_method_name(String base):
    if base == "+":
        return "add"
    if base == "-":
        return "sub"
    if base == "*":
        return "mul"
    if base == "/":
        return "div"
    if base == "%":
        return "rem"
    if base == "mod":
        return "mod"
    return ""

# Typed registry + intrinsic: does `type_key` implement `trait_name`?
bool has_trait_impl_by_name(TypeTable types, String type_key, String trait_name):
    for impl_info in types.trait_registry.impls:
        if impl_info.self_type_name == type_key and impl_info.trait_name == trait_name:
            return true
    if primitive_satisfies_trait(type_key, trait_name):
        return true
    return false

# Inherent / equip method without requiring the trait name match.
bool has_method_for_type_name(TypeTable types, String type_key, String method):
    for impl_info in types.trait_registry.impls:
        if impl_info.self_type_name == type_key:
            for m in impl_info.method_names:
                if m == method:
                    return true
    return false

# Whether `op` (binary or compound spelling) is supported on `ty`.
# Array-family `+` / `+=` is concat rebind (same as Rust
# `operator_supported_for_type` — compound unrestricted for Vector/Deque/Array).
bool operator_supported_for_type(int ty, String op, bool compound, ScopeTable scopes, TypeTable types):
    # `compound` reserved for future op-specific distinctions (Rust mirrors
    # with `let _ = compound`). Array-family `+`/`+=` share the same support.
    bool _compound_reserved = compound
    String type_key = type_key_for_trait_lookup(ty, scopes, types)
    if type_key == "":
        # Error/Never/Var — don't cascade.
        return true
    String base = arith_base_op(op)
    if is_integer_only_op(base):
        return is_integer_primitive_key(type_key)
    String trait_name = op_trait_name(base)
    if trait_name != "":
        if has_trait_impl_by_name(types, type_key, trait_name):
            return true
        String method = op_method_name(base)
        if method != "" and has_method_for_type_name(types, type_key, method):
            return true
        # Builtin String concatenation — only `+` / `+=`.
        if base == "+" and type_key == "String":
            return true
        # Builtin Vector/Deque/Array concat — binary `+` and compound `+=`
        # (lowered as clone+extend rebind; see emit_compound_arith).
        # `compound` is intentionally unused here (mirrors Rust).
        if base == "+":
            if type_key == "Vector" or type_key == "Deque" or type_key == "Array":
                return true
        return false
    # Non-arithmetic ops gated elsewhere (comparisons / logicals / `in`).
    return true

String unsupported_operator_message(String op, String type_name):
    if type_name == "String":
        return "operator `" + op + "` is not defined for type `String` — String supports `+`/`+=` (concatenation) only"
    String base = arith_base_op(op)
    String trait_name = op_trait_name(base)
    String method = op_method_name(base)
    if trait_name == "":
        return "operator `" + op + "` is not defined for type `" + type_name + "` — only integer numeric types support this operator"
    return "operator `" + op + "` is not defined for type `" + type_name + "` — equip with `" + trait_name + "[" + type_name + "]` (or implement `" + method + "`) to use `" + op + "`"

void check_operator_supported(int ty, String op, bool compound, Span span, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    if operator_supported_for_type(ty, op, compound, scopes, types):
        return
    String type_name = type_key_for_trait_lookup(ty, scopes, types)
    if type_name == "":
        type_name = "<error>"
    ctx.diagnostics.push(Diagnostic.error(span, DkUnsupportedOperator(), unsupported_operator_message(op, type_name)))

# ── Assign-target lvalue gate (E_InvalidAssignTarget) ───────
# Mirrors Rust's check_assign_target_lvalue (typecheck.rs:5472–5483), called
# from Stmt::Assign / Stmt::CompoundAssign (typecheck.rs:4342 / 4362). Allowlist
# is exactly the place forms the lowerer dispatches on: variable, field, index,
# or dereference. SH has no ETupleFieldAccess — digit tuple fields are
# EFieldAccess (Face-D normalize on write), so they share that arm. Anything
# else (`foo() = 1`, `5 += 1`, `(a + b) = x`) must be REJECTED at check time,
# not silently dropped (plain `=`) or ICE'd (compound `OP=`) in lowering.
bool is_assign_target_lvalue(SpannedExpr target):
    match target.expr:
        case EIdentifier(_):
            return true
        case EFieldAccess(_, _):
            return true
        case EIndex(_, _):
            return true
        case EDeref(_):
            return true
        else:
            return false

void check_assign_target_lvalue(SpannedExpr target, ResolveContext &ctx):
    if not is_assign_target_lvalue(target):
        ctx.diagnostics.push(Diagnostic.error(target.span, DkInvalidAssignTarget(), "invalid assignment target: the left side is not an assignable place — assign to a variable, field, tuple field, index (`v[i]`), or dereference (`*p`)"))

# ── String index-assign reject (StringIndexAssign) ──────────
# Mirrors Rust's check_string_index_assign in src/semantic/typecheck.rs:4174
# (kind SemanticErrorKind::StringIndexAssign, message at errors.rs:773),
# called from the Stmt::Assign / Stmt::CompoundAssign arms (typecheck.rs:3324
# /3343). Reject `s[i] = x` / `s[i] += x` when the indexed OBJECT is a String:
# `s[i]` is a documented read-only codepoint view (language-reference SStrings)
# and the lowering has no String index-setter, so these compiled as SILENT
# NO-OPS in the self-host before this gate.
#
# Fires ONLY when the index target's receiver resolves to a String primitive —
# the exact discriminator the EIndex INFERENCE already uses (infer.gg:751-754,
# RTPrimitive("str"|"String")) and which mirrors Rust's `Primitive(StringType)`
# (Rust's owned-`String` and `str` ids BOTH carry PrimitiveType::StringType;
# the self-host splits them into RTPrimitive("String") / RTPrimitive("str")).
# This is a typed resolved-type test, NOT identifier name-matching. Vector/Dict/
# array/slice/user-type index targets all fall through untouched — their
# receivers resolve to RTGeneric/RTArray/RTSlice/RTDefined, never RTPrimitive.
void check_string_index_assign(SpannedExpr target, int scope_id, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
    match target.expr:
        case EIndex(obj, _):
            int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
            if obj_type >= 0 and obj_type < types.types.len():
                ResolvedType ort = get_rtype_at(types.types, obj_type)
                match ort:
                    case RTPrimitive(name):
                        if name == "str" or name == "String":
                            ctx.diagnostics.push(Diagnostic.error(target.span, DkStringIndexAssign(), "strings are not index-assignable: `s[i]` is a read-only codepoint view — build a new string instead (e.g. `s.replace(...)`, slicing + concatenation)"))
                    else:
                        pass
        else:
            pass

# ── Type-check statements (looking for VarDecl with explicit types) ──

void type_check_stmts(Vector[Stmt] stmts, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    for s in stmts:
        type_check_stmt(s, scope_id, &scopes, &types, &ctx)
    # Second pass: propagate call-site argument types to closure type vars
    resolve_closure_types_from_calls(stmts, scope_id, &scopes, &types, &ctx)

void type_check_stmt(Stmt s, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    # Core #4 ONE-PRODUCER CHOKEPOINT: record bare-form method targs for
    # EVERY expression this statement carries, at EVERY syntactic position,
    # BEFORE the per-arm logic runs. Replaces the two hand-wired call sites
    # (SVarDecl-explicit + SExpr) that left 20 of 30 measured positions unwired.
    record_method_targs_for_stmt(s, &scopes, &types, &ctx)
    match s:
        case SVarDecl(stype, name, init_expr, line, col, flags):
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int var_type_id = -1
            if not is_inferred:
                var_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
                # ValueOutOfRange: reject a literal initializer that does not fit
                # the declared sized-int type (`int8 x = 200`), matching Rust gg.
                check_sized_int_literal_range(init_expr, var_type_id, types, &ctx)
            else:
                # Phase 2: infer type from initializer expression
                var_type_id = infer_expr_type(init_expr, scopes, &types, &ctx)
            if var_type_id >= 0:
                if scopes.lookup_in_subtree_untyped(scope_id, name) is Some(var_def):
                    int binding_type_id = demote_generic_param_to_var(var_type_id, scopes, &types)
                    scopes.set_def_type(var_def, binding_type_id)
            # Walk initializer for closures and block expressions
            # Pass expected type so untyped closure params can be inferred
            walk_expr_closures_with_type(init_expr, var_type_id, scope_id, &scopes, &types, &ctx)
            # Rebuild closure function type if it has errors (untyped params)
            if is_inferred and var_type_id >= 0:
                bool has_errors = false
                ResolvedType vrt = get_rtype_at(types.types, var_type_id)
                match vrt:
                    case RTFunction(fn_params, _, fn_ret):
                        for fp_tid in fn_params:
                            if fp_tid == types.error_id:
                                has_errors = true
                        if fn_ret == types.error_id:
                            has_errors = true
                    else:
                        pass
                if has_errors:
                    match init_expr.expr:
                        case EClosure(cl_params, cl_body):
                            rebuild_closure_var_type(name, cl_params, cl_body, scope_id, &scopes, &types, &ctx)
                        else:
                            pass

        case SIf(cond, body, else_branches):
            # Assign types to is-pattern bindings in the condition
            if has_is_patterns(cond.expr):
                assign_is_condition_types(cond, scope_id, &scopes, &types, &ctx)
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)
            for eb in else_branches:
                if eb.condition is Some(econd):
                    if has_is_patterns(econd.expr):
                        assign_is_condition_types(econd, scope_id, &scopes, &types, &ctx)
                type_check_stmts(eb.body, scope_id, &scopes, &types, &ctx)

        case SFor(pat, iter_expr, body, flags, else_body):
            # Infer iterable type and assign element type to loop variable
            int iter_type = infer_expr_type(iter_expr, scopes, &types, &ctx)
            # Check for .enumerate() — assign (int, T) to tuple pattern
            bool is_enumerate = false
            match iter_expr.expr:
                case EMethodCall(obj, method_name, args, targs):
                    if method_name == "enumerate":
                        is_enumerate = true
                        int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, &ctx)
                        if extract_element_type(obj_type, scopes, types) is Some(elem_type):
                            # Create (int, T) tuple type
                            Vector[int] tuple_elems = Vector[int]()
                            tuple_elems.push(types.int_id)
                            tuple_elems.push(elem_type)
                            int tuple_type = types.add_type(!RTTuple(tuple_elems))
                            assign_pattern_types(pat, tuple_type, scope_id, &scopes, &types, &ctx)
                else:
                    pass
            if not is_enumerate:
                if extract_element_type(iter_type, scopes, types) is Some(elem_type):
                    assign_pattern_types(pat, elem_type, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = ctx.loop_depth + 1
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = ctx.loop_depth - 1
            # The else body runs OUTSIDE the loop (loop_depth already
            # restored), and it IS type-checked — the SWhile sibling below has
            # always done this. Without it, nothing inside a `for … else` else
            # block is checked at all, and in particular the method-targ
            # chokepoint (driven per statement from `type_check_stmt`'s entry)
            # never sees it, so a bare Iterator terminal there emits an
            # undefined `VectorIter__…__any`.
            type_check_stmts(else_body, scope_id, &scopes, &types, &ctx)

        case SWhile(cond, body, else_body):
            if has_is_patterns(cond.expr):
                assign_is_condition_types(cond, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = ctx.loop_depth + 1
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = ctx.loop_depth - 1
            type_check_stmts(else_body, scope_id, &scopes, &types, &ctx)

        case SLoop(body):
            ctx.loop_depth = ctx.loop_depth + 1
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)
            ctx.loop_depth = ctx.loop_depth - 1

        case SMatch(expr, arms):
            # Infer scrutinee type and assign to pattern bindings.
            # Round XXVIII Track E — WALK the scrutinee too (not just infer):
            # a statement match's scrutinee may be a method call carrying a
            # closure arg (`match p.or_else((): body): case Some(v): …`), and
            # the axis-unify chokepoint (`unify_closure_ret_axis` in the
            # EMethodCall arm) only fires from the walker. Without this
            # recurse, a cross-type closure return inside a statement-match
            # scrutinee slips past the check — mirror of the EMatch
            # expression-form fix at :3556.
            walk_expr_closures(expr, scope_id, &scopes, &types, &ctx)
            int scrutinee_type = infer_expr_type(expr, scopes, &types, &ctx)
            for arm in arms:
                if scrutinee_type >= 0:
                    assign_pattern_types(arm.pattern, scrutinee_type, scope_id, &scopes, &types, &ctx)
                type_check_stmts(arm.body, scope_id, &scopes, &types, &ctx)

        case SWith(expr, name, body):
            # Infer the type of the with binding (e.g., `with Resource() as r`)
            int with_type = infer_expr_type(expr, scopes, &types, &ctx)
            if with_type >= 0:
                if scopes.lookup_in_subtree(scope_id, name) is Some(with_def):
                    scopes.set_def_type(with_def, with_type)
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        case SNamedScope(name, body):
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        case SOnError(body):
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        case SExpr(sexpr):
            walk_expr_closures(sexpr, scope_id, &scopes, &types, &ctx)

        case SAssign(target, value):
            # E_InvalidAssignTarget: non-lvalue targets (`foo() = 1`) reject at
            # check time (Rust typecheck.rs:4342), matching lower_assign's place
            # forms. Continues into string-index / closure walk like Rust.
            check_assign_target_lvalue(target, &ctx)
            # StringIndexAssign: reject `s[i] = x` when `s` is a String, matching
            # Rust gg (typecheck.rs:3324). The receiver is resolved (not name-
            # matched) so Vector/Dict/array index-assigns stay accepted.
            check_string_index_assign(target, scope_id, scopes, &types, &ctx)
            walk_expr_closures(value, scope_id, &scopes, &types, &ctx)

        case SCompoundAssign(target, op, value):
            # E_InvalidAssignTarget sibling: `5 += 1` must reject at check
            # (Rust typecheck.rs:4362), not ICE in lower_compound_assign.
            check_assign_target_lvalue(target, &ctx)
            # StringIndexAssign sibling: reject `s[i] += x` when `s` is a String,
            # matching Rust gg (typecheck.rs:3343). Before this, SCompoundAssign
            # fell into the `else: pass` arm and the String write-back compiled
            # as a SILENT NO-OP. The value sub-expression is still walked for
            # closures, mirroring the SAssign arm.
            check_string_index_assign(target, scope_id, scopes, &types, &ctx)
            # E_UnsupportedOperator: reject non-Add compound ops on String /
            # Money / etc. (Rust typecheck.rs CompoundAssign arm, compound=true).
            # Array-family `+=` is allowed (concat rebind; Core #9 with Rust T2).
            int ca_target_ty = infer_expr_type(target, scopes, &types, &ctx)
            check_operator_supported(ca_target_ty, op, true, target.span, scopes, &types, &ctx)
            walk_expr_closures(value, scope_id, &scopes, &types, &ctx)

        case SReturn(opt_expr):
            # ReturnOutsideFunction — `return` at module scope. Mirrors
            # src/semantic/typecheck.rs:2833 (SemanticErrorKind::ReturnOutsideFunction).
            # `Stmt` carries no span of its own; if there's a payload we use
            # its span, otherwise a zero span (module-scope returns are rare
            # and span-less is fine for the DIAG line).
            if not ctx.in_function_body:
                Span ret_span = Span(0, 0)
                if opt_expr is Some(rsp):
                    ret_span = rsp.span
                ctx.diagnostics.push(Diagnostic.error(ret_span, DkReturnOutsideFunction(), "return outside of function"))
            if opt_expr is Some(sexpr):
                walk_expr_closures(sexpr, scope_id, &scopes, &types, &ctx)

        case SBreak():
            # BreakOutsideLoop — mirrors src/semantic/typecheck.rs
            # (SemanticErrorKind::BreakOutsideLoop). `loop_depth` is bumped
            # at SFor/SWhile/SLoop entry, reset at function entry, and
            # save/restored across closures.
            if ctx.loop_depth == 0:
                ctx.diagnostics.push(Diagnostic.error(Span(0, 0), DkBreakOutsideLoop(), "break outside of loop"))

        case SContinue():
            # ContinueOutsideLoop — mirrors src/semantic/typecheck.rs:2898
            # (SemanticErrorKind::ContinueOutsideLoop). SContinue carries no
            # span; the diagnostic uses a zero span. Self-host's AST collapses
            # statement spans onto containers (the enclosing fn/block), so
            # this matches the resolution offered for other span-less stmts.
            if ctx.loop_depth == 0:
                ctx.diagnostics.push(Diagnostic.error(Span(0, 0), DkContinueOutsideLoop(), "continue outside of loop"))

        case SThrow(expr):
            # ThrowInNonThrowingFunction — mirrors src/semantic/typecheck.rs:2866
            # (SemanticErrorKind::ThrowInNonThrowingFunction). The enclosing
            # function must declare `throws T` for `throw` to be valid.
            if not ctx.current_function_throws:
                ctx.diagnostics.push(Diagnostic.error(expr.span, DkThrowInNonThrowingFunction(), "throw in function that doesn't declare `throws`"))
            walk_expr_closures(expr, scope_id, &scopes, &types, &ctx)

        case SSelect(arms):
            for arm in arms:
                # Type the recv binding from channel element type
                match arm.op:
                    case SORecv(name, ch_idx, ch_expr):
                        int ch_type = infer_expr_type(ch_expr, scopes, &types, &ctx)
                        if ch_type >= 0 and ch_type < types.types.len():
                            ResolvedType ch_rt = get_rtype_at(types.types, ch_type)
                            match ch_rt:
                                case RTGeneric(def_id, type_args):
                                    DefInfo d = scopes.get_def(def_id)
                                    if (d.name == "Channel" or d.name == "SharedChannel") and type_args.len() >= 1:
                                        int elem_type = get_int_at(type_args, 0)
                                        if scopes.lookup_in_subtree(scope_id, name) is Some(recv_def):
                                            scopes.set_def_type(recv_def, elem_type)
                                else:
                                    pass
                    else:
                        pass
                type_check_stmts(arm.body, scope_id, &scopes, &types, &ctx)

        case SItem(item):
            type_check_item(item, scope_id, &scopes, &types, &ctx)

        case SMetaFor(mf_vars, mf_iter, body):
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        case SMetaForMatch(_, _, _):
            # Meta expansion (meta.gg) replaces these with concrete arms
            # before typecheck. If we still see one, treat it as a no-op.
            pass

        case SMetaIf(meta_cond, then_body, else_branches):
            type_check_stmts(then_body, scope_id, &scopes, &types, &ctx)
            for eb in else_branches:
                type_check_stmts(eb.body, scope_id, &scopes, &types, &ctx)

        case SMetaMatch(mm_scrut, mm_arms, mm_else):
            for mm_arm in mm_arms:
                type_check_stmts(mm_arm.body, scope_id, &scopes, &types, &ctx)
            type_check_stmts(mm_else, scope_id, &scopes, &types, &ctx)

        case SMetaWhile(mw_cond, mw_body):
            type_check_stmts(mw_body, scope_id, &scopes, &types, &ctx)

        else:
            pass

# ── Type-check a single item ───────────────────────────────

void type_check_item(Item item, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    match item:
        case IFunction(func):
            type_check_function(func, scope_id, &scopes, &types, &ctx, -1)

        case IExternBlock(efns):
            # Extern function signatures are already registered in the pre-pass;
            # this arm ensures they're also handled when called outside the module-level
            # pre-pass (e.g. equip blocks or nested scopes). No body to check.
            for efunc in efns:
                register_function_signature(efunc, scope_id, &scopes, &types, &ctx, -1)

        case IStruct(sdef):
            # Reject two fields with the same name in the struct
            # declaration (`struct P: int x; int x`). Mirrors Rust's
            # duplicate-field scan in the `Item::Struct` collection arm
            # (src/semantic/resolve.rs). Before this, both compilers
            # silently ACCEPTED the ill-formed decl and only failed
            # downstream at the C compiler ("duplicate member"). Walk the
            # fields in order; the SECOND occurrence of a name is the error
            # (same message text as Rust so type_comparison stays exact).
            Vector[String] seen_fields = Vector[String]()
            for field in sdef.fields:
                if seen_fields.contains(field.param_name):
                    ctx.diagnostics.push(Diagnostic.error(field.param_type.span, DkDuplicateDefinition(), f"duplicate struct field `{field.param_name}`"))
                else:
                    seen_fields.push(field.param_name)
            # Build a field type lookup table for EFieldAccess inference.
            # Store struct_name.field_name → type_id in variant_field_types dict.
            # Also store ordered positional field types under the bare struct
            # name (single type or RTTuple) so constructor patterns
            # `case Point(x, y):` resolve field types + arity (Core #9).
            Vector[int] ordered_field_ids = Vector[int]()
            for field in sdef.fields:
                int field_type_id = ast_type_to_resolved(field.param_type.ty, field.param_type.span, scopes, &types)
                if field_type_id >= 0:
                    String key = f"{sdef.name}.{field.param_name}"
                    types.variant_field_types.put(key, field_type_id)
                    ordered_field_ids.push(field_type_id)
            if ordered_field_ids.len() == 1:
                types.variant_field_types.put(sdef.name, get_int_at(ordered_field_ids, 0))
            elif ordered_field_ids.len() > 1:
                int struct_tuple_tid = types.add_type(!RTTuple(ordered_field_ids))
                types.variant_field_types.put(sdef.name, struct_tuple_tid)

        case IEnum(edef):
            # Register variant payload types in the type table's variant map
            for var in edef.variants:
                if var.fields.len() > 0:
                    if var.fields.len() == 1:
                        SpannedType ft = get_stype_at(var.fields, 0)
                        int field_type_id = ast_type_to_resolved(ft.ty, ft.span, scopes, &types)
                        types.variant_field_types.put(var.name, field_type_id)
                    else:
                        # Multi-field variant: create tuple type
                        Vector[int] field_ids = Vector[int]()
                        for ft in var.fields:
                            int ftid = ast_type_to_resolved(ft.ty, ft.span, scopes, &types)
                            field_ids.push(ftid)
                        int tuple_tid = types.add_type(!RTTuple(field_ids))
                        types.variant_field_types.put(var.name, tuple_tid)

        case IEquip(eqblk):
            # Find the equip block scope by scanning for the next SkEquipBlock
            # child of the module scope, using last_equip_scope for ordering.
            int equip_scope = scope_id
            if find_next_equip_scope(scope_id, types.last_equip_scope, scopes) is Some(es):
                equip_scope = es
                types.last_equip_scope = es
            # Set current scope to equip scope so generic type params (T etc.)
            # are visible when resolving the target type and method signatures.
            int saved_scope = scopes.current_scope()
            scopes.set_current(equip_scope)
            int self_tid = ast_type_to_resolved(eqblk.target.ty, eqblk.target.span, scopes, &types)
            types.self_type_id = self_tid
            # Equip blocks that EXPLICITLY declare their type params
            # (`equip [T] X[T]:` or `equip [T] X with Y:`) keep impl-T
            # as Defined — Rust shows `T` for both signatures and
            # bindings. Equips with no explicit `[T]` prefix (`equip
            # Box2[T]:`, where T is implicitly the struct's T) demote
            # like regular generic functions. Method-level generics
            # (`[Hasher H]` on a specific method) still demote in
            # either case because their defs live in the method body
            # scope rather than the equip scope.
            int saved_trait_equip = types.trait_equip_scope_id
            bool keep_impl_t = eqblk.trait_name.is_some() or eqblk.type_params.len() > 0
            if keep_impl_t:
                types.trait_equip_scope_id = equip_scope
            else:
                types.trait_equip_scope_id = -1
            # Find the pass-1 equip scope (contains method def definitions)
            # Use equip_def_index to pair pass-1 with pass-2 by order.
            int def_scope = find_nth_def_equip_scope(types.equip_def_index, scope_id, scopes).unwrap_or(equip_scope)
            types.equip_def_index = types.equip_def_index + 1
            for method in eqblk.methods:
                type_check_function(method, equip_scope, &scopes, &types, &ctx, def_scope)
            types.trait_equip_scope_id = saved_trait_equip
            types.self_type_id = -1
            scopes.set_current(saved_scope)

        case ITrait(tdef):
            # Validate required-after-default param ordering on every
            # trait-method declaration (both signature-only and
            # default-bodied), mirroring Rust's unconditional
            # `validate_default_param_ordering(&method.params, ...)` call
            # inside `collect_trait` (traits.rs:872). SCOPED to ONLY this
            # param-ordering check — trait-method bodies/signatures are
            # NOT otherwise type-checked here, matching Rust's targeted call.
            for method in tdef.methods:
                check_default_param_ordering(method.params, &ctx)

        case IConstDecl(stype, name, init_expr):
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int const_type_id = -1
            if not is_inferred:
                const_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
            else:
                const_type_id = infer_expr_type(init_expr, scopes, &types, &ctx)
            if const_type_id >= 0:
                int const_def = scopes.lookup_in_scope(scope_id, name).unwrap_or(-1)
                if const_def < 0:
                    const_def = scopes.lookup_in_subtree(scope_id, name).unwrap_or(-1)
                if const_def >= 0:
                    int binding_type_id = demote_generic_param_to_var(const_type_id, scopes, &types)
                    scopes.set_def_type(const_def, binding_type_id)

        case ITypeAlias(name, type_params, underlying):
            int alias_type_id = ast_type_to_resolved(underlying.ty, underlying.span, scopes, &types)
            if scopes.lookup_in_scope(scope_id, name) is Some(alias_def):
                int binding_type_id = demote_generic_param_to_var(alias_type_id, scopes, &types)
                scopes.set_def_type(alias_def, binding_type_id)

        case IStaticDecl(stype, name, init_expr):
            # D10(a) at module scope — mirrors Rust `typecheck.rs`
            # Item::StaticDecl `expr_is_borrow_bind`. Without this,
            # `Vector[int] G = &BASE` silently accepts on SH and
            # falls through to C-emit (Core #10 miscompile — Round XXVIII
            # Track D). No suppress bracket needed here: the module-item
            # walk does NOT route static initializers through the safety
            # pass, so there's no mirror-walker to double-message.
            check_local_borrow_bind(init_expr, &ctx)
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int static_type_id = -1
            if not is_inferred:
                static_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
            else:
                static_type_id = infer_expr_type(init_expr, scopes, &types, &ctx)
            if static_type_id >= 0:
                int static_def = scopes.lookup_in_scope(scope_id, name).unwrap_or(-1)
                if static_def < 0:
                    static_def = scopes.lookup_in_subtree(scope_id, name).unwrap_or(-1)
                if static_def >= 0:
                    int binding_type_id = demote_generic_param_to_var(static_type_id, scopes, &types)
                    scopes.set_def_type(static_def, binding_type_id)

        case ITest(name, with_exprs, with_names, body):
            # Type with-clause bindings (test "name" with expr as var:)
            for (wi, wexpr) in with_exprs.enumerate():
                if wi >= with_names.len():
                    break
                String wname = with_names.get(wi).unwrap()
                # Unwrap EAs — the parser wraps `expr as name` into EAs(expr, name)
                match wexpr.expr:
                    case EAs(inner, _):
                        wexpr = SpannedExpr((*inner).expr, (*inner).span)
                    else:
                        pass
                int wtype = infer_expr_type(wexpr, scopes, &types, &ctx)
                if wtype >= 0:
                    if scopes.lookup_in_subtree(scope_id, wname) is Some(wdef):
                        scopes.set_def_type(wdef, wtype)
            # Walk test body for VarDecl types
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        case IBench(name, body):
            type_check_stmts(body, scope_id, &scopes, &types, &ctx)

        else:
            pass

# ── Public entry point ──────────────────────────────────────

void type_check_module(Module module, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    # Module-level items are in scope 0 (root)
    int module_scope = 0
    # Set current scope so scope.lookup() works from module level
    scopes.set_current(module_scope)
    # Build the trait registry up front. type_check_function will register
    # struct fields / enum variants as it walks; the registry only needs
    # equip-block self types and method sigs which `ast_type_to_resolved`
    # can compute from the resolved scope tree.
    types.trait_registry = build_trait_registry(module, &scopes, &types, &ctx)
    # Pre-pass: register all function signatures (sets def.type_id for
    # IFunction items) before walking any bodies. Without this, when
    # main's body uses `auto x = imported_fn()` and imported_fn comes
    # later in the merged-module item order, infer_expr_type's
    # EIdentifier lookup reads imported_fn's def.type_id while it's
    # still -1 — and the auto-typed binding fails to resolve. Mirrors
    # Rust's `register_signatures_recursive` (typecheck.rs:5273) which
    # runs before the body-walk pass for exactly this reason.
    for r_item in module.items:
        match r_item:
            case IFunction(r_func):
                register_function_signature(r_func, module_scope, &scopes, &types, &ctx, -1)
            case IExternBlock(efns):
                for efunc in efns:
                    register_function_signature(efunc, module_scope, &scopes, &types, &ctx, -1)
            else:
                pass
    # D4/D12 drop-purity: seed + fixpoint the drop-taint flags BEFORE the
    # item-walk, so the per-function `check_safety_*` reject pass reads a
    # complete taint set. Mirrors Rust pass-3.55 `compute_drop_taint`.
    compute_drop_taint(module, &scopes, &types)
    # D10(b) Copy axis: close the `DefInfo.is_copy` flag over the field graph
    # AFTER drop-taint (it reads is_drop_tainted), so the place-overlap check's
    # `resolved_type_is_copy` sees the struct/enum Copy extent, not scalar-only.
    compute_is_copy(module, &scopes, &types)
    for item in module.items:
        type_check_item(item, module_scope, &scopes, &types, &ctx)
