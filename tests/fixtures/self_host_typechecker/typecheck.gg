# Minimal type checker for the self-hosting Gorget compiler.
# Walks the AST after name resolution and assigns type IDs to definitions
# based on their declared types.
#
# Phase 1: function signatures and explicit VarDecl types.
# Phase 2: expression type inference for auto/inferred variables.

from std.collections import Vector, Dict
from ast import Module, Item, Stmt, Param, FunctionDef, StructDef, EnumDef
from ast import EnumVariant, TraitDef, EquipBlock, MatchArm, ElseBranch
from ast import SpannedExpr, SpannedType, SpannedPattern, Span, Type, Expr, Pattern
from ast import EMethodCall, EBinaryOp, EIs, EClosure, ECall, EBlock, EDo, EAs, EIdentifier, EFString, SelectArm, SORecv, EMatch
from ast import SExpr, SVarDecl, SReturn
from ids import NO_DEF, NO_TYPE
from scope import ScopeTable, DefKind, DefInfo, ScopeKind, SkEquipBlock, SkFunction
from scope import DkFunction, DkStruct, DkEnum, DkVariant, DkTrait
from scope import DkVariable, DkConst, DkStatic, DkGenericParam
from scope import get_def_at, get_scope_at, Scope
from types import TypeTable, ResolvedType, ast_type_to_resolved, get_stype_at
from types import RTFunction, RTVoid, RTPrimitive, RTDefined, RTGeneric
from types import RTTuple, RTArray, RTSlice, RTError, RTVar, get_rtype_at, get_int_at
from types import RTCallableTrait, RTMutCallableTrait, RTConsumeCallableTrait, RTBoxedCallable
from resolve import ResolveContext
from infer import infer_expr_type, infer_closure_return_type
from traits import build_trait_registry, resolve_method_full, resolve_method_by_name, MethodResolution

# ── Fallback def lookup by name ──────────────────────────────
# Scans all definitions for a matching name (and optionally DkFunction kind).
# Returns the first match or None.

Option[int] find_def_by_name(ScopeTable scopes, String name, bool require_function):
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.name == name:
            if not require_function:
                return Some(i)
            bool is_fn = false
            match d.kind:
                case DkFunction():
                    is_fn = true
                else:
                    pass
            if is_fn:
                return Some(i)
        i = i + 1
    return None()

# ── Find function body scope from parallel vectors ─────────
# When multiple functions share the same name (e.g. `serialize` across
# derive-generated equip blocks), the Dict only stores the last one.
# This helper searches all stored scopes, picks one whose parent chain
# includes parent_scope.

int find_body_scope(String name, int parent_scope, ScopeTable scopes, ResolveContext ctx):
    # Two-pass walk: direct-parent match always beats grandparent
    # match, regardless of order. Without this, when a user fixture
    # has a top-level fn named `chain` and std.iter is prepended
    # (which has `chain` as a method on VectorIter), the std.iter
    # chain's grandparent match (module → equip → method-fn-scope)
    # would beat the user's direct-parent match because std.iter's
    # entry comes first in fn_scope_names.
    int best = -1
    for (i, sn) in ctx.fn_scope_names.enumerate():
        if sn == name:
            int sid = ctx.fn_scope_ids.get(i).unwrap()
            int p = scopes.scope_parent_of(sid)
            if p == parent_scope:
                return sid
            if best < 0:
                best = sid
    for (j, sn) in ctx.fn_scope_names.enumerate():
        if sn == name:
            int sid = ctx.fn_scope_ids.get(j).unwrap()
            int p = scopes.scope_parent_of(sid)
            if p >= 0:
                int gp = scopes.scope_parent_of(p)
                if gp == parent_scope:
                    return sid
    return best

# ── Find the next SkEquipBlock scope ───────────────────────
# Returns the next equip-block scope that is a child of parent_scope,
# with scope ID > after_scope. Used for ordered equip block processing.

int find_next_equip_scope(int parent_scope, int after_scope, ScopeTable scopes):
    int sid = after_scope + 1
    while sid < scopes.scope_count():
        Scope s = get_scope_at(scopes.scopes, sid)
        if s.parent == parent_scope:
            bool is_equip = false
            match s.kind:
                case SkEquipBlock():
                    is_equip = true
                else:
                    pass
            if is_equip:
                # Only return equip scopes that have SkFunction children
                # (pass 1 creates empty equip scopes, pass 2 has the body scopes)
                bool has_fn_child = false
                int csid = sid + 1
                while csid < scopes.scope_count():
                    Scope cs = get_scope_at(scopes.scopes, csid)
                    if cs.parent == sid:
                        match cs.kind:
                            case SkFunction():
                                has_fn_child = true
                            else:
                                pass
                    if cs.parent < sid:
                        csid = scopes.scope_count()
                    csid = csid + 1
                if has_fn_child:
                    return sid
        sid = sid + 1
    return -1

# ── Find the Nth pass-1 equip scope (contains method defs) ──
# Pass-1 scopes are created during collect_top_level and contain method defs.
# Pass-2 scopes are created during resolve_bodies and contain SkFunction children.
# The Nth equip block in the AST corresponds to the Nth pass-1 scope.

int find_nth_def_equip_scope(int n, int parent_scope, ScopeTable scopes):
    int count = 0
    int sid = 0
    while sid < scopes.scope_count():
        Scope s = get_scope_at(scopes.scopes, sid)
        if s.parent == parent_scope:
            bool is_equip = false
            match s.kind:
                case SkEquipBlock():
                    is_equip = true
                else:
                    pass
            if is_equip:
                # Check it does NOT have SkFunction children (pass-1 scope)
                bool has_fn_child = false
                int csid = sid + 1
                while csid < scopes.scope_count():
                    Scope cs = get_scope_at(scopes.scopes, csid)
                    if cs.parent == sid:
                        match cs.kind:
                            case SkFunction():
                                has_fn_child = true
                            else:
                                pass
                    if cs.parent < sid:
                        csid = scopes.scope_count()
                    csid = csid + 1
                if not has_fn_child:
                    if count == n:
                        return sid
                    count = count + 1
        sid = sid + 1
    return -1

# ── Generic-param binding-side demotion ─────────────────────
# Rust's typechecker uses two distinct values for the same generic
# param: `Defined(generic_param_def_id)` for the SIGNATURE slot
# (renders as "T") and a fresh inference variable for the BINDING
# slot (renders as "<error>"). Our resolver produces RTDefined for
# both. To match Rust's two-tier output, we demote a generic-param
# RTDefined to a fresh tagged RTVar at every binding site (function
# params, closure params, VarDecl, const, static, type alias). The
# signature slot keeps the original RTDefined.
#
# Recurses through container types (RTGeneric, RTTuple, RTArray,
# RTSlice, RTRef) so `Pair[T, U]` becomes `Pair[<error>, <error>]`
# and `Vector[T]` becomes `Vector[<error>]` at binding sites.
# Also descends into Callable WRAPPERS (RTCallableTrait,
# RTMutCallableTrait, RTConsumeCallableTrait, RTBoxedCallable) and
# rewrites the wrapped function's params/return — Rust renders
# `Callable[T(int)]` at a binding as `Callable[<error>(int)]`.
# Does NOT descend into bare RTFunction (only the Callable wrapper
# triggers descent) — bare function types are signature-shaped and
# Rust keeps `T` there.
int demote_generic_param_to_var(int type_id, ScopeTable scopes, TypeTable &types):
    if type_id < 0:
        return type_id
    if type_id >= types.types.len():
        return type_id
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTDefined(def_id):
            if def_id < 0:
                return type_id
            DefInfo d = scopes.get_def(def_id)
            match d.kind:
                case DkGenericParam():
                    # Inside a trait-bounded equip block, generic params
                    # defined IN the equip scope (the impl's own [T])
                    # keep their `Defined` rendering — Rust does not
                    # demote them. Method-level generics ([Hasher H])
                    # are defined in the method body scope, so they
                    # still demote.
                    if types.trait_equip_scope_id >= 0 and d.scope_id == types.trait_equip_scope_id:
                        return type_id
                    return types.fresh_generic_var()
                else:
                    return type_id
        case RTGeneric(gen_def_id, args):
            Vector[int] new_args = Vector[int]()
            bool any_changed = false
            for arg_tid in args:
                int new_arg_tid = demote_generic_param_to_var(arg_tid, scopes, &types)
                if new_arg_tid != arg_tid:
                    any_changed = true
                new_args.push(new_arg_tid)
            if any_changed:
                return types.add_type(RTGeneric(gen_def_id, new_args))
            return type_id
        case RTTuple(elems):
            Vector[int] new_elems = Vector[int]()
            bool any_changed = false
            for elem_tid in elems:
                int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
                if new_elem_tid != elem_tid:
                    any_changed = true
                new_elems.push(new_elem_tid)
            if any_changed:
                return types.add_type(RTTuple(new_elems))
            return type_id
        case RTArray(elem_tid, size):
            int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
            if new_elem_tid != elem_tid:
                return types.add_type(RTArray(new_elem_tid, size))
            return type_id
        case RTSlice(elem_tid):
            int new_elem_tid = demote_generic_param_to_var(elem_tid, scopes, &types)
            if new_elem_tid != elem_tid:
                return types.add_type(RTSlice(new_elem_tid))
            return type_id
        case RTRef(inner_tid):
            int new_inner_tid = demote_generic_param_to_var(inner_tid, scopes, &types)
            if new_inner_tid != inner_tid:
                return types.add_type(RTRef(new_inner_tid))
            return type_id
        case RTCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(RTCallableTrait(new_func_id))
            return type_id
        case RTMutCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(RTMutCallableTrait(new_func_id))
            return type_id
        case RTConsumeCallableTrait(func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(RTConsumeCallableTrait(new_func_id))
            return type_id
        case RTBoxedCallable(kind_name, func_id):
            int new_func_id = demote_through_function_type(func_id, scopes, &types)
            if new_func_id != func_id:
                return types.add_type(RTBoxedCallable(kind_name, new_func_id))
            return type_id
        else:
            return type_id

# Helper: demote generic params inside the params/return of an
# RTFunction. Only invoked when we know the function is wrapped in
# a Callable trait — bare RTFunction values keep `T`.
int demote_through_function_type(int type_id, ScopeTable scopes, TypeTable &types):
    if type_id < 0:
        return type_id
    if type_id >= types.types.len():
        return type_id
    ResolvedType rt = get_rtype_at(types.types, type_id)
    match rt:
        case RTFunction(params, ownerships, ret_id):
            Vector[int] new_params = Vector[int]()
            bool any_changed = false
            for p_id in params:
                int new_p_id = demote_generic_param_to_var(p_id, scopes, &types)
                if new_p_id != p_id:
                    any_changed = true
                new_params.push(new_p_id)
            int new_ret_id = demote_generic_param_to_var(ret_id, scopes, &types)
            if new_ret_id != ret_id:
                any_changed = true
            if any_changed:
                return types.add_type(RTFunction(new_params, ownerships, new_ret_id))
            return type_id
        else:
            return type_id

# ── Type-check a function definition ────────────────────────

# Register a function's signature on its DefInfo without walking the
# body. Used as a pre-pass in type_check_module so callers can resolve
# `auto x = some_fn()` against `some_fn`'s declared return type even
# when `some_fn` appears later in the merged-module item order than
# the caller. Mirror of Rust's `register_function_signature`.
void register_function_signature(FunctionDef func, int parent_scope, ScopeTable &scopes, TypeTable &types, ResolveContext ctx, int def_scope):
    bool is_generic = func.type_params.len() > 0
    int body_scope = find_body_scope(func.name, parent_scope, scopes, ctx)
    bool has_body_scope = body_scope >= 0
    if not has_body_scope:
        if ctx.function_body_scopes.contains(func.name):
            body_scope = ctx.function_body_scopes.get(func.name).unwrap()
            has_body_scope = true
    int saved_scope = scopes.current_scope()
    if is_generic and has_body_scope:
        scopes.set_current(body_scope)
    int ret_id = ast_type_to_resolved(func.return_type.ty, func.return_type.span, scopes, &types)
    Vector[int] param_type_ids = Vector[int]()
    Vector[int] param_ownerships = Vector[int]()
    for p in func.params:
        int p_type_id = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
        param_type_ids.push(p_type_id)
        param_ownerships.push(p.ownership)
        # Set param type in EVERY body scope that matches this fn name and
        # contains this param. Handles duplicate extern declarations across
        # files (e.g. `__bytes_to_str_raw(b64_buf)` in std.bytes vs
        # `__bytes_to_str_raw(data)` in std.io): self-host's flat-merge
        # loader keeps both bodies but only the first wins the module-scope
        # name; without iterating, the second's params never get typed.
        int binding_type_id = demote_generic_param_to_var(p_type_id, scopes, &types)
        for (fsi, fs_name) in ctx.fn_scope_names.enumerate():
            if fs_name == func.name:
                int bs = ctx.fn_scope_ids.get(fsi).unwrap()
                int bp = scopes.scope_parent_of(bs)
                bool ok = bp == parent_scope
                if not ok and bp >= 0:
                    int bgp = scopes.scope_parent_of(bp)
                    ok = bgp == parent_scope
                if ok:
                    if scopes.lookup_in_scope(bs, p.param_name) is Some(param_def):
                        scopes.set_def_type(param_def, binding_type_id)
    if is_generic and has_body_scope:
        scopes.set_current(saved_scope)
    int fn_type_id = types.add_type(RTFunction(param_type_ids, param_ownerships, ret_id))
    Option[int] fn_def_opt = None()
    if def_scope >= 0:
        fn_def_opt = scopes.lookup_in_scope(def_scope, func.name)
    if fn_def_opt is None:
        fn_def_opt = scopes.lookup_in_scope(parent_scope, func.name)
    if fn_def_opt is None:
        fn_def_opt = find_def_by_name(scopes, func.name, true)
    if fn_def_opt is Some(fn_def):
        scopes.set_def_type(fn_def, fn_type_id)

void type_check_function(FunctionDef func, int parent_scope, ScopeTable &scopes, TypeTable &types, ResolveContext ctx, int def_scope):
    # Register the signature first (idempotent — running it twice for
    # IFunction items already pre-passed in type_check_module just
    # overwrites with the same value). Equip methods aren't pre-passed
    # so they need this call. Generic functions and impl methods need
    # the body-scope signature dance too.
    register_function_signature(func, parent_scope, &scopes, &types, ctx, def_scope)

    # Walk body for VarDecl types
    int body_scope = find_body_scope(func.name, parent_scope, scopes, ctx)
    bool has_body_scope = body_scope >= 0
    if not has_body_scope:
        if ctx.function_body_scopes.contains(func.name):
            body_scope = ctx.function_body_scopes.get(func.name).unwrap()
            has_body_scope = true
    if has_body_scope:
        type_check_stmts(func.body, body_scope, &scopes, &types, ctx)

# ── Pattern type assignment ────────────────────────────────
# Recursively assigns types to pattern bindings based on a scrutinee type.

void assign_pattern_types(SpannedPattern pattern, int scrutinee_type, int scope_id, ScopeTable &scopes, TypeTable &types):
    match pattern.pat:
        case PBinding(name):
            if scopes.lookup_in_subtree_untyped(scope_id, name) is Some(def_id):
                DefInfo d = scopes.get_def(def_id)
                # Only assign to variable bindings (not variant names, structs, etc.)
                bool is_variable = false
                match d.kind:
                    case DkVariable():
                        is_variable = true
                    else:
                        pass
                if is_variable:
                    scopes.set_def_type(def_id, scrutinee_type)

        case PConstructor(variant_name, fields):
            # Resolve variant payload types from the scrutinee type
            Vector[int] field_types = resolve_variant_field_types(scrutinee_type, variant_name, scopes, types)
            for (i, field) in fields.enumerate():
                int ft = -1
                if i < field_types.len():
                    ft = get_int_at(field_types, i)
                if ft >= 0:
                    assign_pattern_types(field, ft, scope_id, &scopes, &types)

        case PDotShorthand(variant_name, fields):
            Vector[int] field_types = resolve_variant_field_types(scrutinee_type, variant_name, scopes, types)
            for (i, field) in fields.enumerate():
                int ft = -1
                if i < field_types.len():
                    ft = get_int_at(field_types, i)
                if ft >= 0:
                    assign_pattern_types(field, ft, scope_id, &scopes, &types)

        case PTuple(elements):
            # Destructure tuple type
            if scrutinee_type >= 0 and scrutinee_type < types.types.len():
                ResolvedType rt = get_rtype_at(types.types, scrutinee_type)
                match rt:
                    case RTTuple(elem_ids):
                        for (i, elem) in elements.enumerate():
                            int et = -1
                            if i < elem_ids.len():
                                et = get_int_at(elem_ids, i)
                            if et >= 0:
                                assign_pattern_types(elem, et, scope_id, &scopes, &types)
                    else:
                        pass

        else:
            pass

# ── Resolve variant field types from a scrutinee type ─────

Vector[int] resolve_variant_field_types(int scrutinee_type, String variant_name, ScopeTable scopes, TypeTable types):
    Vector[int] result = Vector[int]()
    if scrutinee_type < 0 or scrutinee_type >= types.types.len():
        return result

    # Strip qualified prefix: "Color.Blue" → "Blue"
    String lookup_name = variant_name
    int dot_pos = -1
    int ci = 0
    while ci < variant_name.len():
        if variant_name.char_at(ci) == ".":
            dot_pos = ci
        ci = ci + 1
    if dot_pos >= 0:
        String after_dot = ""
        int di = dot_pos + 1
        while di < variant_name.len():
            after_dot = after_dot + variant_name.char_at(di)
            di = di + 1
        lookup_name = after_dot

    ResolvedType rt = get_rtype_at(types.types, scrutinee_type)

    # Handle Option[T]: Some(val) → T, None → nothing
    # Handle Result[T, E]: Ok(val) → T, Error(e) → E
    match rt:
        case RTGeneric(def_id, type_args):
            DefInfo d = scopes.get_def(def_id)
            if d.name == "Option":
                if lookup_name == "Some" and type_args.len() >= 1:
                    result.push(get_int_at(type_args, 0))
            elif d.name == "Result":
                if lookup_name == "Ok" and type_args.len() >= 1:
                    result.push(get_int_at(type_args, 0))
                elif lookup_name == "Error" and type_args.len() >= 2:
                    result.push(get_int_at(type_args, 1))
            else:
                # User-defined generic enum — try to look up variant
                # For now, just return the first type arg as a rough approximation
                if type_args.len() >= 1:
                    result.push(get_int_at(type_args, 0))

        case RTDefined(def_id):
            # User-defined enum — look up variant field types from type table
            if types.variant_field_types.contains(lookup_name):
                int vft = types.variant_field_types.get(lookup_name).unwrap()
                # Check if it's a tuple — if so, return individual fields
                if vft >= 0 and vft < types.types.len():
                    ResolvedType vrt = get_rtype_at(types.types, vft)
                    match vrt:
                        case RTTuple(elems):
                            for e in elems:
                                result.push(e)
                            return result
                        else:
                            pass
                result.push(vft)
                return result
        else:
            pass

    # Fallback: if the scrutinee type didn't lead anywhere (e.g. shadowed
    # binding obscures the real enum type), look up the qualified variant
    # name directly in variant_field_types — works when the pattern uses
    # `EnumName.Variant(args)` and the enum was registered earlier.
    if result.len() == 0 and types.variant_field_types.contains(lookup_name):
        int fb_vft = types.variant_field_types.get(lookup_name).unwrap()
        if fb_vft >= 0 and fb_vft < types.types.len():
            ResolvedType fb_vrt = get_rtype_at(types.types, fb_vft)
            match fb_vrt:
                case RTTuple(fb_elems):
                    for e in fb_elems:
                        result.push(e)
                else:
                    result.push(fb_vft)
    return result

# ── Extract element type from iterable type ───────────────

int extract_element_type(int iterable_type, ScopeTable scopes, TypeTable types):
    if iterable_type < 0 or iterable_type >= types.types.len():
        return -1

    ResolvedType rt = get_rtype_at(types.types, iterable_type)

    # String iteration → String (character iteration)
    match rt:
        case RTPrimitive(name):
            if name == "str" or name == "String":
                return types.string_id
            return -1
        else:
            pass

    # Generic collections: Vector[T], Set[T], HashSet[T] → T
    match rt:
        case RTGeneric(def_id, type_args):
            DefInfo d = scopes.get_def(def_id)
            if d.name == "Vector" or d.name == "Set" or d.name == "HashSet":
                if type_args.len() >= 1:
                    return get_int_at(type_args, 0)
            return -1

        case RTArray(elem_id, size):
            return elem_id

        case RTSlice(elem_id):
            return elem_id

        else:
            pass

    return -1

# ── Assign is-pattern types from if/while conditions ──────

void assign_is_condition_types(SpannedExpr expr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match expr.expr:
        case EBinaryOp(left, op, right):
            if op == "and":
                assign_is_condition_types(*left, scope_id, &scopes, &types, ctx)
                assign_is_condition_types(*right, scope_id, &scopes, &types, ctx)
                return

        case EIs(inner, negated, pattern):
            if not negated:
                int scrut_type = infer_expr_type(*inner, scopes, &types, ctx)
                if scrut_type >= 0:
                    assign_pattern_types(*pattern, scrut_type, scope_id, &scopes, &types)
                return

        else:
            pass

# ── Check if an expression contains is-patterns ──────────

bool has_is_patterns(Expr e):
    match e:
        case EIs(_, negated, _):
            if not negated:
                return true
            return false
        case EBinaryOp(left, op, right):
            if op == "and":
                return has_is_patterns((*left).expr) or has_is_patterns((*right).expr)
        else:
            pass
    return false

# ── Walk closures in expressions ──────────────────────────
# Finds closure expressions and assigns types to their parameters and bodies.

void walk_expr_closures_with_type(SpannedExpr sexpr, int expected_type, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match sexpr.expr:
        case EClosure(params, body):
            # Extract param types from expected_type if it's RTFunction
            Vector[int] expected_params = Vector[int]()
            if expected_type >= 0 and expected_type < types.types.len():
                ResolvedType ert = get_rtype_at(types.types, expected_type)
                match ert:
                    case RTFunction(ptypes, _, _):
                        expected_params = ptypes
                    case RTCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTMutCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTConsumeCallableTrait(inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    case RTBoxedCallable(kind_name, inner_fn):
                        if inner_fn >= 0 and inner_fn < types.types.len():
                            ResolvedType ifn = get_rtype_at(types.types, inner_fn)
                            match ifn:
                                case RTFunction(ptypes, _, _):
                                    expected_params = ptypes
                                else:
                                    pass
                    else:
                        pass
            # Assign types to closure parameters
            for (pi, p) in params.enumerate():
                int p_type_id = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
                # If the param type is <error> or void (inferred), use expected type
                if (p_type_id < 0 or p_type_id == types.error_id or p_type_id == types.void_id) and pi < expected_params.len():
                    p_type_id = get_int_at(expected_params, pi)
                # If still unresolved, assign a fresh type variable
                if p_type_id < 0 or p_type_id == types.error_id or p_type_id == types.void_id:
                    p_type_id = types.fresh_var()
                if p_type_id >= 0 and p_type_id != types.error_id:
                    if scopes.lookup_in_subtree_untyped(scope_id, p.param_name) is Some(param_def):
                        int binding_type_id = demote_generic_param_to_var(p_type_id, scopes, &types)
                        scopes.set_def_type(param_def, binding_type_id)
            # Walk closure body for VarDecls and nested closures
            type_check_stmts(body, scope_id, &scopes, &types, ctx)
        else:
            walk_expr_closures_inner(sexpr, scope_id, &scopes, &types, ctx)

void walk_expr_closures(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    walk_expr_closures_with_type(sexpr, -1, scope_id, &scopes, &types, ctx)

void walk_expr_closures_inner(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match sexpr.expr:
        case ECall(callee, args, targs):
            walk_expr_closures(*callee, scope_id, &scopes, &types, ctx)
            # Infer callee type to extract expected param types for closure args
            Vector[int] call_param_types = Vector[int]()
            int callee_type = infer_expr_type(SpannedExpr((*callee).expr, (*callee).span), scopes, &types, ctx)
            if callee_type >= 0 and callee_type < types.types.len():
                ResolvedType ct = get_rtype_at(types.types, callee_type)
                match ct:
                    case RTFunction(ptypes, _, _):
                        call_param_types = ptypes
                    else:
                        pass
            for (ai, arg) in args.enumerate():
                if ai < call_param_types.len():
                    walk_expr_closures_with_type(arg, get_int_at(call_param_types, ai), scope_id, &scopes, &types, ctx)
                else:
                    walk_expr_closures(arg, scope_id, &scopes, &types, ctx)

        case EMethodCall(obj, method_name, args, targs):
            walk_expr_closures(*obj, scope_id, &scopes, &types, ctx)
            # Infer receiver element type for collection higher-order methods
            int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, ctx)
            int elem_type = extract_element_type(obj_type, scopes, types)
            # Resolve full method signature for closure-arg type propagation.
            # This lets (r): body get its param typed when passed to a method
            # expecting Callable[ReturnType(ParamType)].
            Vector[int] method_param_types = Vector[int]()
            if obj_type >= 0 and obj_type < types.types.len():
                MethodResolution mres = resolve_method_full(types.trait_registry, obj_type, method_name, scopes, &types)
                if not mres.found:
                    String recv_name = ""
                    ResolvedType obj_rt = get_rtype_at(types.types, obj_type)
                    match obj_rt:
                        case RTDefined(rdef):
                            recv_name = scopes.get_def(rdef).name
                        case RTGeneric(rdef, _):
                            recv_name = scopes.get_def(rdef).name
                        else:
                            pass
                    if recv_name.len() > 0:
                        mres = resolve_method_by_name(types.trait_registry, recv_name, method_name)
                if mres.found:
                    method_param_types = mres.sig.params
            for (ai, arg) in args.enumerate():
                int expected = -1
                if elem_type >= 0:
                    if (method_name == "filter" or method_name == "any" or method_name == "all" or method_name == "each") and ai == 0:
                        # (T) -> bool
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        expected = types.add_type(RTFunction(ptypes, owns, types.bool_id))
                    elif method_name == "map" and ai == 0:
                        # (T) -> ?
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        expected = types.add_type(RTFunction(ptypes, owns, -1))
                    elif (method_name == "fold" or method_name == "reduce") and ai == 1:
                        # (U, T) -> U
                        int init_type = infer_expr_type(args.get(0).unwrap(), scopes, &types, ctx)
                        Vector[int] ptypes = Vector[int]()
                        ptypes.push(init_type)
                        ptypes.push(elem_type)
                        Vector[int] owns = Vector[int]()
                        owns.push(0)
                        owns.push(0)
                        expected = types.add_type(RTFunction(ptypes, owns, init_type))
                # Fallback: use method signature's param type for this arg index.
                # Enables closure params to be typed when the method expects a
                # Callable/function-type argument (e.g. router.get(path, (r): ...)).
                if expected < 0 and ai < method_param_types.len():
                    expected = get_int_at(method_param_types, ai)
                if expected >= 0:
                    walk_expr_closures_with_type(arg, expected, scope_id, &scopes, &types, ctx)
                else:
                    walk_expr_closures(arg, scope_id, &scopes, &types, ctx)

        case EBinaryOp(left, op, right):
            walk_expr_closures(*left, scope_id, &scopes, &types, ctx)
            walk_expr_closures(*right, scope_id, &scopes, &types, ctx)

        case EBlock(body_stmts):
            type_check_stmts(body_stmts, scope_id, &scopes, &types, ctx)

        case EDo(body_stmts):
            type_check_stmts(body_stmts, scope_id, &scopes, &types, ctx)

        case EFString(template, exprs):
            # F-string interpolation segments are pre-parsed into real
            # SpannedExpr by the parser; walk them so closures inside
            # `{...}` get their params/body typed.
            for fe in exprs:
                walk_expr_closures(fe, scope_id, &scopes, &types, ctx)

        case EMatch(scrutinee, arms):
            # Match-as-expression: assign pattern binding types and walk arm bodies.
            int scrut_type = infer_expr_type(SpannedExpr((*scrutinee).expr, (*scrutinee).span), scopes, &types, ctx)
            for arm in arms:
                if scrut_type >= 0:
                    assign_pattern_types(arm.pattern, scrut_type, scope_id, &scopes, &types)
                type_check_stmts(arm.body, scope_id, &scopes, &types, ctx)

        else:
            pass

# ── Rebuild closure variable type from now-typed params ───────
# After walk_expr_closures assigns types to closure param defs,
# rebuild the RTFunction type for the auto-variable holding the closure.

void rebuild_closure_var_type(String var_name, Vector[Param] cl_params, Vector[Stmt] cl_body, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    # Find each param def that has a type var assigned (from walk_expr_closures)
    Vector[int] param_type_ids = Vector[int]()
    Vector[int] param_ownerships = Vector[int]()
    Vector[int] param_def_ids = Vector[int]()
    Dict[String, int] param_types = Dict[String, int]()
    for p in cl_params:
        # Find the param def with a type-var type (distinguishes from earlier same-name defs)
        int p_def = find_typevar_def(scope_id, p.param_name, &scopes, &types)
        int p_tid = types.error_id
        if p_def >= 0:
            DefInfo pd = scopes.get_def(p_def)
            if pd.type_id >= 0:
                p_tid = pd.type_id
        param_type_ids.push(p_tid)
        param_ownerships.push(p.ownership)
        param_def_ids.push(p_def)
        param_types.put(p.param_name, p_tid)
    # Infer return type from closure body with typed params
    int ret_id = types.void_id
    if cl_body.len() > 0:
        Stmt last = cl_body.get(cl_body.len() - 1).unwrap()
        int inferred_ret = infer_closure_return_type(last, param_types, scopes, &types, ctx)
        if inferred_ret >= 0:
            ret_id = inferred_ret
    # Build the new function type and update the variable
    int fn_type = types.add_type(RTFunction(param_type_ids, param_ownerships, ret_id))
    if scopes.lookup_in_subtree(scope_id, var_name) is Some(var_def):
        scopes.set_def_type(var_def, fn_type)

int find_typevar_def(int scope_id, String name, ScopeTable &scopes, TypeTable &types):
    # Find a def named `name` in the subtree that has a type-var type
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.name == name and d.type_id >= 0:
            ResolvedType rt = get_rtype_at(types.types, d.type_id)
            match rt:
                case RTVar(_):
                    if scopes.is_descendant_of(d.scope_id, scope_id):
                        return i
                else:
                    pass
        i = i + 1
    return -1

# ── Call-site closure type var resolution ─────────────────────
# After type_check_stmts, scan for calls like `add(3, 4)` where the callee
# has type vars in its function type. Propagate concrete arg types back.

void resolve_closure_types_from_calls(Vector[Stmt] stmts, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    for s in stmts:
        resolve_call_in_stmt(s, scope_id, &scopes, &types, ctx)

void resolve_call_in_stmt(Stmt s, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match s:
        case SExpr(sexpr):
            resolve_call_in_expr(sexpr, scope_id, &scopes, &types, ctx)
        case SVarDecl(_, _, init_expr, _, _, _):
            resolve_call_in_expr(init_expr, scope_id, &scopes, &types, ctx)
        else:
            pass

void resolve_call_in_expr(SpannedExpr sexpr, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match sexpr.expr:
        case ECall(callee, args, targs):
            # Check if callee is an identifier with a function type containing type vars
            match (*callee).expr:
                case EIdentifier(name):
                    if scopes.lookup_in_subtree(scope_id, name) is Some(callee_def):
                        DefInfo cd = scopes.get_def(callee_def)
                        if cd.type_id >= 0:
                            ResolvedType fn_rt = get_rtype_at(types.types, cd.type_id)
                            match fn_rt:
                                case RTFunction(param_tids, ownerships, ret_id):
                                    bool has_var = false
                                    for ptid in param_tids:
                                        ResolvedType prt = get_rtype_at(types.types, ptid)
                                        match prt:
                                            case RTVar(_):
                                                has_var = true
                                            else:
                                                pass
                                    if has_var and args.len() == param_tids.len():
                                        # Build mapping from type var → concrete type
                                        Dict[int, int] var_map = Dict[int, int]()
                                        Vector[int] new_params = Vector[int]()
                                        for (ai, arg) in args.enumerate():
                                            int old_ptid = get_int_at(param_tids, ai)
                                            ResolvedType old_prt = get_rtype_at(types.types, old_ptid)
                                            match old_prt:
                                                case RTVar(var_id):
                                                    int arg_type = infer_expr_type(arg, scopes, &types, ctx)
                                                    if arg_type >= 0 and arg_type != types.error_id:
                                                        new_params.push(arg_type)
                                                        var_map[var_id] = arg_type
                                                    else:
                                                        new_params.push(old_ptid)
                                                else:
                                                    new_params.push(old_ptid)
                                        # Resolve return type: if it's a type var, map it
                                        int new_ret = ret_id
                                        ResolvedType ret_rt = get_rtype_at(types.types, ret_id)
                                        match ret_rt:
                                            case RTVar(var_id):
                                                if var_map.contains(var_id):
                                                    new_ret = var_map.get(var_id).unwrap()
                                            else:
                                                pass
                                        # If return type is still unresolved but params are
                                        # now concrete, infer from the first concrete param
                                        # (heuristic for a + b where a, b are same type)
                                        if new_ret == ret_id:
                                            ResolvedType nr = get_rtype_at(types.types, new_ret)
                                            match nr:
                                                case RTVar(_):
                                                    if new_params.len() > 0:
                                                        new_ret = get_int_at(new_params, 0)
                                                case RTError():
                                                    if new_params.len() > 0:
                                                        new_ret = get_int_at(new_params, 0)
                                                else:
                                                    pass
                                        # Update param defs with concrete types before moving new_params
                                        for (pi, np_tid) in new_params.enumerate():
                                            int old_ptid = get_int_at(param_tids, pi)
                                            if np_tid != old_ptid:
                                                # Find the param def that has the old type var
                                                # and update it to the concrete type
                                                resolve_param_type_var(old_ptid, np_tid, scope_id, &scopes, &types)
                                        # Update function type
                                        int new_fn_type = types.add_type(RTFunction(!new_params, ownerships, new_ret))
                                        scopes.set_def_type(callee_def, new_fn_type)
                                else:
                                    pass
                else:
                    pass
        else:
            pass

void resolve_param_type_var(int old_type_id, int new_type_id, int scope_id, ScopeTable &scopes, TypeTable &types):
    # Find any def in the subtree with type_id == old_type_id and update it
    int i = 0
    while i < scopes.def_count():
        DefInfo d = scopes.get_def(i)
        if d.type_id == old_type_id:
            scopes.set_def_type(i, new_type_id)
        i = i + 1

# ── Type-check statements (looking for VarDecl with explicit types) ──

void type_check_stmts(Vector[Stmt] stmts, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    for s in stmts:
        type_check_stmt(s, scope_id, &scopes, &types, ctx)
    # Second pass: propagate call-site argument types to closure type vars
    resolve_closure_types_from_calls(stmts, scope_id, &scopes, &types, ctx)

void type_check_stmt(Stmt s, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match s:
        case SVarDecl(stype, name, init_expr, line, col, flags):
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int var_type_id = -1
            if not is_inferred:
                var_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
            else:
                # Phase 2: infer type from initializer expression
                var_type_id = infer_expr_type(init_expr, scopes, &types, ctx)
            if var_type_id >= 0:
                if scopes.lookup_in_subtree_untyped(scope_id, name) is Some(var_def):
                    int binding_type_id = demote_generic_param_to_var(var_type_id, scopes, &types)
                    scopes.set_def_type(var_def, binding_type_id)
            # Walk initializer for closures and block expressions
            # Pass expected type so untyped closure params can be inferred
            walk_expr_closures_with_type(init_expr, var_type_id, scope_id, &scopes, &types, ctx)
            # Rebuild closure function type if it has errors (untyped params)
            if is_inferred and var_type_id >= 0:
                bool has_errors = false
                ResolvedType vrt = get_rtype_at(types.types, var_type_id)
                match vrt:
                    case RTFunction(fn_params, _, fn_ret):
                        for fp_tid in fn_params:
                            if fp_tid == types.error_id:
                                has_errors = true
                        if fn_ret == types.error_id:
                            has_errors = true
                    else:
                        pass
                if has_errors:
                    match init_expr.expr:
                        case EClosure(cl_params, cl_body):
                            rebuild_closure_var_type(name, cl_params, cl_body, scope_id, &scopes, &types, ctx)
                        else:
                            pass

        case SIf(cond, body, else_branches):
            # Assign types to is-pattern bindings in the condition
            if has_is_patterns(cond.expr):
                assign_is_condition_types(cond, scope_id, &scopes, &types, ctx)
            type_check_stmts(body, scope_id, &scopes, &types, ctx)
            for eb in else_branches:
                if eb.condition is Some(econd):
                    if has_is_patterns(econd.expr):
                        assign_is_condition_types(econd, scope_id, &scopes, &types, ctx)
                type_check_stmts(eb.body, scope_id, &scopes, &types, ctx)

        case SFor(pat, iter_expr, body, flags, else_body):
            # Infer iterable type and assign element type to loop variable
            int iter_type = infer_expr_type(iter_expr, scopes, &types, ctx)
            # Check for .enumerate() — assign (int, T) to tuple pattern
            bool is_enumerate = false
            match iter_expr.expr:
                case EMethodCall(obj, method_name, args, targs):
                    if method_name == "enumerate":
                        is_enumerate = true
                        int obj_type = infer_expr_type(SpannedExpr((*obj).expr, (*obj).span), scopes, &types, ctx)
                        int elem_type = extract_element_type(obj_type, scopes, types)
                        if elem_type >= 0:
                            # Create (int, T) tuple type
                            Vector[int] tuple_elems = Vector[int]()
                            tuple_elems.push(types.int_id)
                            tuple_elems.push(elem_type)
                            int tuple_type = types.add_type(RTTuple(tuple_elems))
                            assign_pattern_types(pat, tuple_type, scope_id, &scopes, &types)
                else:
                    pass
            if not is_enumerate:
                int elem_type = extract_element_type(iter_type, scopes, types)
                if elem_type >= 0:
                    assign_pattern_types(pat, elem_type, scope_id, &scopes, &types)
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SWhile(cond, body):
            if has_is_patterns(cond.expr):
                assign_is_condition_types(cond, scope_id, &scopes, &types, ctx)
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SLoop(body):
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SMatch(expr, arms):
            # Infer scrutinee type and assign to pattern bindings
            int scrutinee_type = infer_expr_type(expr, scopes, &types, ctx)
            for arm in arms:
                if scrutinee_type >= 0:
                    assign_pattern_types(arm.pattern, scrutinee_type, scope_id, &scopes, &types)
                type_check_stmts(arm.body, scope_id, &scopes, &types, ctx)

        case SWith(expr, name, body):
            # Infer the type of the with binding (e.g., `with Resource() as r`)
            int with_type = infer_expr_type(expr, scopes, &types, ctx)
            if with_type >= 0:
                if scopes.lookup_in_subtree(scope_id, name) is Some(with_def):
                    scopes.set_def_type(with_def, with_type)
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SNamedScope(name, body):
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SOnError(body):
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SExpr(sexpr):
            walk_expr_closures(sexpr, scope_id, &scopes, &types, ctx)

        case SAssign(target, value):
            walk_expr_closures(value, scope_id, &scopes, &types, ctx)

        case SReturn(opt_expr):
            if opt_expr is Some(sexpr):
                walk_expr_closures(sexpr, scope_id, &scopes, &types, ctx)

        case SSelect(arms):
            for arm in arms:
                # Type the recv binding from channel element type
                match arm.op:
                    case SORecv(name, ch_idx, ch_expr):
                        int ch_type = infer_expr_type(ch_expr, scopes, &types, ctx)
                        if ch_type >= 0 and ch_type < types.types.len():
                            ResolvedType ch_rt = get_rtype_at(types.types, ch_type)
                            match ch_rt:
                                case RTGeneric(def_id, type_args):
                                    DefInfo d = scopes.get_def(def_id)
                                    if (d.name == "Channel" or d.name == "SharedChannel") and type_args.len() >= 1:
                                        int elem_type = get_int_at(type_args, 0)
                                        if scopes.lookup_in_subtree(scope_id, name) is Some(recv_def):
                                            scopes.set_def_type(recv_def, elem_type)
                                else:
                                    pass
                    else:
                        pass
                type_check_stmts(arm.body, scope_id, &scopes, &types, ctx)

        case SItem(item):
            type_check_item(item, scope_id, &scopes, &types, ctx)

        case SMetaFor(body):
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case SMetaForMatch(_, _, _):
            # Meta expansion (meta.gg) replaces these with concrete arms
            # before typecheck. If we still see one, treat it as a no-op.
            pass

        case SMetaIf(then_body, else_branches):
            type_check_stmts(then_body, scope_id, &scopes, &types, ctx)
            for eb in else_branches:
                type_check_stmts(eb.body, scope_id, &scopes, &types, ctx)

        else:
            pass

# ── Type-check a single item ───────────────────────────────

void type_check_item(Item item, int scope_id, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    match item:
        case IFunction(func):
            type_check_function(func, scope_id, &scopes, &types, ctx, -1)

        case IExternBlock(efns):
            # Extern function signatures are already registered in the pre-pass;
            # this arm ensures they're also handled when called outside the module-level
            # pre-pass (e.g. equip blocks or nested scopes). No body to check.
            for efunc in efns:
                register_function_signature(efunc, scope_id, &scopes, &types, ctx, -1)

        case IStruct(sdef):
            # Build a field type lookup table for EFieldAccess inference.
            # Store struct_name.field_name → type_id in variant_field_types dict.
            for field in sdef.fields:
                int field_type_id = ast_type_to_resolved(field.param_type.ty, field.param_type.span, scopes, &types)
                if field_type_id >= 0:
                    String key = f"{sdef.name}.{field.param_name}"
                    types.variant_field_types.put(key, field_type_id)

        case IEnum(edef):
            # Register variant payload types in the type table's variant map
            for var in edef.variants:
                if var.fields.len() > 0:
                    if var.fields.len() == 1:
                        SpannedType ft = get_stype_at(var.fields, 0)
                        int field_type_id = ast_type_to_resolved(ft.ty, ft.span, scopes, &types)
                        types.variant_field_types.put(var.name, field_type_id)
                    else:
                        # Multi-field variant: create tuple type
                        Vector[int] field_ids = Vector[int]()
                        for ft in var.fields:
                            int ftid = ast_type_to_resolved(ft.ty, ft.span, scopes, &types)
                            field_ids.push(ftid)
                        int tuple_tid = types.add_type(RTTuple(field_ids))
                        types.variant_field_types.put(var.name, tuple_tid)

        case IEquip(eqblk):
            # Find the equip block scope by scanning for the next SkEquipBlock
            # child of the module scope, using last_equip_scope for ordering.
            int equip_scope = find_next_equip_scope(scope_id, types.last_equip_scope, scopes)
            if equip_scope >= 0:
                types.last_equip_scope = equip_scope
            else:
                equip_scope = scope_id
            # Set current scope to equip scope so generic type params (T etc.)
            # are visible when resolving the target type and method signatures.
            int saved_scope = scopes.current_scope()
            scopes.set_current(equip_scope)
            int self_tid = ast_type_to_resolved(eqblk.target.ty, eqblk.target.span, scopes, &types)
            types.self_type_id = self_tid
            # Equip blocks that EXPLICITLY declare their type params
            # (`equip [T] X[T]:` or `equip [T] X with Y:`) keep impl-T
            # as Defined — Rust shows `T` for both signatures and
            # bindings. Equips with no explicit `[T]` prefix (`equip
            # Box2[T]:`, where T is implicitly the struct's T) demote
            # like regular generic functions. Method-level generics
            # (`[Hasher H]` on a specific method) still demote in
            # either case because their defs live in the method body
            # scope rather than the equip scope.
            int saved_trait_equip = types.trait_equip_scope_id
            bool keep_impl_t = eqblk.trait_name.is_some() or eqblk.type_params.len() > 0
            if keep_impl_t:
                types.trait_equip_scope_id = equip_scope
            else:
                types.trait_equip_scope_id = -1
            # Find the pass-1 equip scope (contains method def definitions)
            # Use equip_def_index to pair pass-1 with pass-2 by order.
            int def_scope = find_nth_def_equip_scope(types.equip_def_index, scope_id, scopes)
            types.equip_def_index = types.equip_def_index + 1
            if def_scope < 0:
                def_scope = equip_scope
            for method in eqblk.methods:
                type_check_function(method, equip_scope, &scopes, &types, ctx, def_scope)
            types.trait_equip_scope_id = saved_trait_equip
            types.self_type_id = -1
            scopes.set_current(saved_scope)

        case IConstDecl(stype, name, init_expr):
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int const_type_id = -1
            if not is_inferred:
                const_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
            else:
                const_type_id = infer_expr_type(init_expr, scopes, &types, ctx)
            if const_type_id >= 0:
                int const_def = scopes.lookup_in_scope(scope_id, name).unwrap_or(-1)
                if const_def < 0:
                    const_def = scopes.lookup_in_subtree(scope_id, name).unwrap_or(-1)
                if const_def >= 0:
                    int binding_type_id = demote_generic_param_to_var(const_type_id, scopes, &types)
                    scopes.set_def_type(const_def, binding_type_id)

        case ITypeAlias(name, type_params, underlying):
            int alias_type_id = ast_type_to_resolved(underlying.ty, underlying.span, scopes, &types)
            if scopes.lookup_in_scope(scope_id, name) is Some(alias_def):
                int binding_type_id = demote_generic_param_to_var(alias_type_id, scopes, &types)
                scopes.set_def_type(alias_def, binding_type_id)

        case IStaticDecl(stype, name, init_expr):
            bool is_inferred = false
            match stype.ty:
                case TInferred():
                    is_inferred = true
                else:
                    pass
            int static_type_id = -1
            if not is_inferred:
                static_type_id = ast_type_to_resolved(stype.ty, stype.span, scopes, &types)
            else:
                static_type_id = infer_expr_type(init_expr, scopes, &types, ctx)
            if static_type_id >= 0:
                int static_def = scopes.lookup_in_scope(scope_id, name).unwrap_or(-1)
                if static_def < 0:
                    static_def = scopes.lookup_in_subtree(scope_id, name).unwrap_or(-1)
                if static_def >= 0:
                    int binding_type_id = demote_generic_param_to_var(static_type_id, scopes, &types)
                    scopes.set_def_type(static_def, binding_type_id)

        case ITest(name, with_exprs, with_names, body):
            # Type with-clause bindings (test "name" with expr as var:)
            for (wi, wexpr) in with_exprs.enumerate():
                if wi >= with_names.len():
                    break
                String wname = with_names.get(wi).unwrap()
                # Unwrap EAs — the parser wraps `expr as name` into EAs(expr, name)
                match wexpr.expr:
                    case EAs(inner, _):
                        wexpr = SpannedExpr((*inner).expr, (*inner).span)
                    else:
                        pass
                int wtype = infer_expr_type(wexpr, scopes, &types, ctx)
                if wtype >= 0:
                    if scopes.lookup_in_subtree(scope_id, wname) is Some(wdef):
                        scopes.set_def_type(wdef, wtype)
            # Walk test body for VarDecl types
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        case IBench(name, body):
            type_check_stmts(body, scope_id, &scopes, &types, ctx)

        else:
            pass

# ── Public entry point ──────────────────────────────────────

void type_check_module(Module module, ScopeTable &scopes, TypeTable &types, ResolveContext ctx):
    # Module-level items are in scope 0 (root)
    int module_scope = 0
    # Set current scope so scope.lookup() works from module level
    scopes.set_current(module_scope)
    # Build the trait registry up front. type_check_function will register
    # struct fields / enum variants as it walks; the registry only needs
    # equip-block self types and method sigs which `ast_type_to_resolved`
    # can compute from the resolved scope tree.
    types.trait_registry = build_trait_registry(module, &scopes, &types)
    # Pre-pass: register all function signatures (sets def.type_id for
    # IFunction items) before walking any bodies. Without this, when
    # main's body uses `auto x = imported_fn()` and imported_fn comes
    # later in the merged-module item order, infer_expr_type's
    # EIdentifier lookup reads imported_fn's def.type_id while it's
    # still -1 — and the auto-typed binding fails to resolve. Mirrors
    # Rust's `register_signatures_recursive` (typecheck.rs:5273) which
    # runs before the body-walk pass for exactly this reason.
    for r_item in module.items:
        match r_item:
            case IFunction(r_func):
                register_function_signature(r_func, module_scope, &scopes, &types, ctx, -1)
            case IExternBlock(efns):
                for efunc in efns:
                    register_function_signature(efunc, module_scope, &scopes, &types, ctx, -1)
            else:
                pass
    for item in module.items:
        type_check_item(item, module_scope, &scopes, &types, ctx)
