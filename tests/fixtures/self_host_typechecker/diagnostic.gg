# Typed diagnostic record produced by the resolution / type-checking
# / lowering / validation passes.
#
# Replaces the free-form `Vector[String] errors` accumulator pattern.
# Span / severity / category are first-class fields rather than baked
# into the message text, so consumers (drivers, CLIs, IDEs) can filter,
# group, render, and emit JSON without re-parsing strings.
#
# Typechecker migration (2026-05-18): the typechecker had no error
# accumulator before this migration — type mismatches and undefined-name
# lookups silently propagated `types.error_id`. This commit adds the
# Diagnostic plumbing (a `Vector[Diagnostic] diagnostics` field on
# `ResolveContext`, threaded through type_check_* via `&ctx`) and
# wires a couple of exemplar push sites; the bulk of mirrored Rust
# sites (47 `self.error(...)` calls in src/semantic/typecheck.rs) will
# follow as separate migrations. Mirrors the resolver POC, parser, and
# lexer patterns — kept per-stage while the cross-directory
# shared-module strategy is settled.

from std.collections import Vector
from std.conv import int_to_str
from std.io import stderr
from ast import Span

# ── Severity ────────────────────────────────────────────────

enum Severity:
    SevError
    SevWarning
    SevSuggestion  # for lints / hints

# ── Diagnostic category ─────────────────────────────────────
#
# One variant per category currently emitted by a stage on the
# accumulator. The typechecker populates its per-code reject kinds
# (`DkDerefNonBox`, `DkBreakOutsideLoop`, … — one per registry code)
# plus `DkUndefinedName` today; the other variants are reserved for
# upstream / downstream stages (parser → DkParseError; resolver →
# DkUndefinedName / DkDuplicateDefinition; lexer → DkLexError;
# lowerer → DkUnreachable).

enum DiagKind:
    # Resolver kinds
    DkUndefinedName        # EIdentifier / EStructLiteral lookup miss
    DkDuplicateDefinition  # `define` rejected — name already bound

    # Parser kinds
    DkParseError           # expect_tok / expect_kw / expected-* sites

    # Lexer kinds
    DkLexError             # unterminated string / char / escape; unexpected char

    # Typechecker kinds (active in this stage)
    DkNotAType             # used a non-type identifier in a type position
    DkNoFieldFound         # `.field` absent on the receiver (E_NoFieldFound)
    DkTypeMismatch         # expected vs actual type disagreement (E_TypeMismatch)
    # Split out of the former coarse DkTypeMismatch — each 1:1 with its registry code:
    DkDerefNonBox          # `*` on a non-`Box[T]` value (E_DerefNonBox)
    DkDefaultOpNonOptional # `??` on a non-Option/Result LHS (E_DefaultOpNonOptional)
    DkMainThrowsNonInt     # `main()` throws a non-`int` (E_MainThrowsNonInt)
    DkValueOutOfRange      # integer literal out of the target type's range (E_ValueOutOfRange)
    DkStringIndexAssign    # `s[i] = x` on a read-only string view (E_StringIndexAssign)
    # Split out of the former coarse DkControlFlow — each 1:1 with its registry code:
    DkBreakOutsideLoop           # `break` outside a loop (E_BreakOutsideLoop)
    DkContinueOutsideLoop        # `continue` outside a loop (E_ContinueOutsideLoop)
    DkReturnOutsideFunction      # `return` outside a function (E_ReturnOutsideFunction)
    DkThrowInNonThrowingFunction # `throw` in a fn without `throws` (E_ThrowInNonThrowingFunction)
    DkMissingFallibleMark        # D29: a fallible call used without the mandatory `!` (E_MissingFallibleMark)
    DkUnhandledThrows            # D29/D23: marked fallible call cannot propagate here (E_UnhandledThrows)
    DkPositionalAfterNamed       # positional arg after a named arg (E_PositionalAfterNamed)
    DkRequiredAfterDefault       # required param after a defaulted param (E_RequiredAfterDefault)
    DkDoubleAwait                # expression awaited twice (E_DoubleAwait)
    DkPrimitiveTraitImpl   # `equip <scalar-primitive> with Trait` — no addressable self
    DkLocalBorrowBind      # D10(a): `auto r = &b` / `r = &b` — local `&`-bind rejected
    DkMoveWithoutOperator  # D4/D12: implicit copy of a live drop-tainted place at an ownership boundary
    DkBorrowConflict       # D10(b): two call args whose places overlap under conflicting sigils
    DkUseAfterMove         # liveness: read of a place already moved (E_UseAfterMove)
    DkDoubleMove           # liveness: second move of a place already moved (E_DoubleMove)
    DkMoveInLoop           # liveness: move of an enclosing-scope place inside a loop (E_MoveInLoop) — re-moved next iteration

    # Reserved for future migrators (kept so the type doesn't churn
    # when lowerer sites migrate).
    DkUnreachable

# ── Diagnostic ──────────────────────────────────────────────

struct Diagnostic:
    Span span
    Severity sev
    DiagKind kind
    String message

# ── Constructors ────────────────────────────────────────────
#
# Prefer the helpers (`Diagnostic.error(...)` etc.) over inline
# struct literals so call sites read like prose and we have one
# place to evolve the shape.

equip Diagnostic:

    Diagnostic error(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevError(), kind, message)

    Diagnostic warn(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevWarning(), kind, message)

    Diagnostic suggest(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevSuggestion(), kind, message)

# ── Rendering ───────────────────────────────────────────────

String severity_str(Severity sev):
    match sev:
        case SevError():
            return "error"
        case SevWarning():
            return "warning"
        case SevSuggestion():
            return "suggestion"

String diag_kind_str(DiagKind kind):
    match kind:
        case DkUndefinedName():
            return "undefined-name"
        case DkDuplicateDefinition():
            return "duplicate-definition"
        case DkParseError():
            return "parse-error"
        case DkLexError():
            return "lex-error"
        case DkNotAType():
            return "not-a-type"
        case DkNoFieldFound():
            return "no-field-found"
        case DkTypeMismatch():
            return "type-mismatch"
        case DkDerefNonBox():
            return "deref-non-box"
        case DkDefaultOpNonOptional():
            return "default-op-non-optional"
        case DkMainThrowsNonInt():
            return "main-throws-non-int"
        case DkValueOutOfRange():
            return "value-out-of-range"
        case DkStringIndexAssign():
            return "string-index-assign"
        case DkBreakOutsideLoop():
            return "break-outside-loop"
        case DkContinueOutsideLoop():
            return "continue-outside-loop"
        case DkReturnOutsideFunction():
            return "return-outside-function"
        case DkThrowInNonThrowingFunction():
            return "throw-in-non-throwing-function"
        case DkMissingFallibleMark():
            return "missing-fallible-mark"
        case DkUnhandledThrows():
            return "unhandled-throws"
        case DkPositionalAfterNamed():
            return "positional-after-named"
        case DkRequiredAfterDefault():
            return "required-after-default"
        case DkDoubleAwait():
            return "double-await"
        case DkPrimitiveTraitImpl():
            return "primitive-trait-impl"
        case DkLocalBorrowBind():
            return "local-borrow-bind"
        case DkUseAfterMove():
            return "use-after-move"
        case DkDoubleMove():
            return "double-move"
        case DkMoveInLoop():
            return "move-in-loop"
        case DkMoveWithoutOperator():
            return "move-without-operator"
        case DkBorrowConflict():
            return "borrow-conflict"
        case DkUnreachable():
            return "unreachable"

# Ratified registry error code (`E_<code>`, spec/prose/diagnostic-codes.md) for a
# diagnostic kind — the machine-readable axis a conformance harness compares (the
# static-rejection analogue of a runtime `trap[T_<code>]`). Returns "" for kinds
# that carry NO code: the lex/parse families (not yet coded) and the reserved
# `DkUnreachable`. Every typechecker reject kind is now split 1:1 with the registry
# (the former coarse `DkTypeMismatch`/`DkControlFlow` multiplexers were broken out
# into per-code kinds — `DkDerefNonBox`, `DkBreakOutsideLoop`, … — so each names
# exactly one code; `DkTypeMismatch` itself now maps to its namesake `E_TypeMismatch`
# for a plain expected-vs-actual disagreement). The code is read from the TYPED kind
# (layering rule 2 — never name-matched off the message text) and only ever rides
# an error-severity headline (warning codes are not rendered — diagnostic-codes.md).
String diag_kind_code(DiagKind kind):
    match kind:
        case DkUseAfterMove():
            return "E_UseAfterMove"
        case DkDoubleMove():
            return "E_DoubleMove"
        case DkMoveInLoop():
            return "E_MoveInLoop"
        case DkMoveWithoutOperator():
            return "E_MoveWithoutOperator"
        case DkBorrowConflict():
            return "E_BorrowConflict"
        case DkLocalBorrowBind():
            return "E_LocalBorrowBind"
        case DkPrimitiveTraitImpl():
            return "E_PrimitiveTraitImpl"
        case DkUndefinedName():
            return "E_UndefinedName"
        case DkDuplicateDefinition():
            return "E_DuplicateDefinition"
        case DkNotAType():
            return "E_NotAType"
        case DkNoFieldFound():
            return "E_NoFieldFound"
        case DkTypeMismatch():
            return "E_TypeMismatch"
        case DkDerefNonBox():
            return "E_DerefNonBox"
        case DkDefaultOpNonOptional():
            return "E_DefaultOpNonOptional"
        case DkMainThrowsNonInt():
            return "E_MainThrowsNonInt"
        case DkValueOutOfRange():
            return "E_ValueOutOfRange"
        case DkStringIndexAssign():
            return "E_StringIndexAssign"
        case DkBreakOutsideLoop():
            return "E_BreakOutsideLoop"
        case DkContinueOutsideLoop():
            return "E_ContinueOutsideLoop"
        case DkReturnOutsideFunction():
            return "E_ReturnOutsideFunction"
        case DkThrowInNonThrowingFunction():
            return "E_ThrowInNonThrowingFunction"
        case DkMissingFallibleMark():
            return "E_MissingFallibleMark"
        case DkUnhandledThrows():
            return "E_UnhandledThrows"
        case DkPositionalAfterNamed():
            return "E_PositionalAfterNamed"
        case DkRequiredAfterDefault():
            return "E_RequiredAfterDefault"
        case DkDoubleAwait():
            return "E_DoubleAwait"
        # Not-yet-coded / reserved kinds render codeless (bare `error:`):
        case DkParseError():
            return ""
        case DkLexError():
            return ""
        case DkUnreachable():
            return ""

# Canonical one-line rendering used by the typechecker comparison test
# driver. Format: `DIAG <severity> <kind> <span_start>:<span_end> <message>`.
# Stderr-routed so the stdout comparison contract (canonical TYPE lines)
# stays byte-stable; type_comparison reads only stdout.
String format_diagnostic(Diagnostic d):
    return "DIAG " + severity_str(d.sev) + " " + diag_kind_str(d.kind) + " " + int_to_str(d.span.start) + ":" + int_to_str(d.span.end) + " " + d.message

# ── Source-grounded rendering (user-facing) ─────────────────
#
# The one-line `format_diagnostic` above is the machine contract used by
# the comparison harness (it must stay byte-stable). What a *user* sees is
# this richer rendering: the design rationale (docs/language-design.md §:
# "errors should point to source, not generated C"; "explain, locate,
# suggest") asks for a Rust-quality message — a `path:line:col` header, the
# offending source line, and a caret run under the exact span.
#
# One renderer, driven entirely off the typed `Diagnostic` value + the
# source text. No phase re-derives line/col; no external crate; the same
# value every phase already pushes is the only input.

# A resolved source position. Byte spans are the storage form (one int
# pair, zero-cost to push); line/col is derived on demand, only when a
# diagnostic is actually rendered — so the hot path pays nothing.
struct LineCol:
    int line   # 1-based
    int col    # 1-based (counts bytes within the line; ASCII source)

# Map a byte offset into `source` to a 1-based (line, col). Single forward
# scan counting newlines — the self-host has no precomputed line index and
# rendering is cold (runs once, at the halt), so a linear scan is the
# simplest correct thing. Clamps an out-of-range offset to the source end
# (imported-module spans are shifted past the entry source; we render them
# against the entry text rather than crash).
LineCol span_to_line_col(String source, int offset):
    int n = source.byte_len()
    int clamped = offset
    if clamped < 0:
        clamped = 0
    if clamped > n:
        clamped = n
    int line = 1
    int line_start = 0
    int i = 0
    while i < clamped:
        if source.byte_at(i) == b'\n':
            line = line + 1
            line_start = i + 1
        i = i + 1
    return LineCol(line, (clamped - line_start) + 1)

# Extract the full source line (no trailing newline) containing `offset`.
String source_line_at(String source, int offset):
    int n = source.byte_len()
    int clamped = offset
    if clamped < 0:
        clamped = 0
    if clamped > n:
        clamped = n
    int start = clamped
    while start > 0 and source.byte_at(start - 1) != b'\n':
        start = start - 1
    int end = clamped
    while end < n and source.byte_at(end) != b'\n':
        end = end + 1
    return source.byte_slice(start, end).clone()

# `n` copies of `s`.
String repeat_str(String s, int n):
    String out = ""
    int i = 0
    while i < n:
        out = out + s
        i = i + 1
    return out

# Number of decimal digits in a non-negative line number (≥1), used to
# size the left gutter so the box rule lines up under the line number.
int digit_count(int n):
    if n < 10:
        return 1
    int d = 0
    int v = n
    while v > 0:
        d = d + 1
        v = v / 10
    return d

# ── ANSI styling (rustc / codespan palette) ─────────────────
#
# The user-facing rendering reproduces `gg check`'s codespan-reporting
# output byte-for-byte, colors included. ESC is byte 0x1b. The palette:
# the `error` word is bold + 256-colour red (index 9); box-drawing rules
# and line numbers are blue; the highlighted span and its caret run are
# red. Each styled token is wrapped RESET-first (codespan resets before
# every span) so the bytes match exactly.
String ANSI_RESET  = "\u{1b}[0m"
String ANSI_BOLD   = "\u{1b}[1m"
String ANSI_RED256 = "\u{1b}[38;5;9m"    # `error` headline
String ANSI_YEL256 = "\u{1b}[38;5;11m"   # `warning` / `suggestion` headline
String ANSI_BLUE   = "\u{1b}[34m"        # box rules + line numbers
String ANSI_RED    = "\u{1b}[31m"        # span highlight + carets

# Headline colour for a severity (codespan: red-9 for errors, yellow-11
# for warnings / notes). The box rules and caret run keep the error
# palette (blue / red) — the diagnostic gate only renders errors.
String severity_color(Severity sev):
    match sev:
        case SevError():
            return ANSI_RED256
        case SevWarning():
            return ANSI_YEL256
        case SevSuggestion():
            return ANSI_YEL256

# Render ONE diagnostic, source-grounded, in rustc / codespan layout:
#
#   error: <message>
#     ┌─ <path>:<line>:<col>
#     │
#   N │ <before><span><after>
#     │        ^^^^   (caret run under the span)
#
# The span text is highlighted inline (red) on the source line and the
# caret run sits directly beneath it. The caret length is the span width
# (>=1), clamped to the visible line. The gutter is `lw+1` wide, where
# `lw` is the digit count of the line number, so the box rule aligns.
String render_diagnostic(Diagnostic d, String source, String path):
    LineCol lc = span_to_line_col(source, d.span.start)
    String src_line = source_line_at(source, d.span.start)
    # Column of the span start within its line (0-based for the pad).
    int col0 = lc.col - 1
    # Caret width = span width, clamped so it never runs past the line.
    int width = d.span.end - d.span.start
    if width < 1:
        width = 1
    int line_len = src_line.byte_len()
    if col0 + width > line_len:
        width = line_len - col0
    if width < 1:
        width = 1

    # Split the source line so the span shows red inline. The slice END is
    # capped at the line length: the `width >= 1` floor above can push
    # `col0 + width` one past the line when the span starts AT end-of-line
    # (`col0 == line_len`), and an out-of-range `byte_slice` panics (it does
    # not clamp). The caret run still uses the un-capped `width` (a caret can
    # point one past the last column, like codespan). Output-neutral for every
    # in-line span (`col0 + width <= line_len`), where `span_end == col0 + width`.
    int span_end = col0 + width
    if span_end > line_len:
        span_end = line_len
    String before = src_line.byte_slice(0, col0).clone()
    String spantext = src_line.byte_slice(col0, span_end).clone()
    String after = src_line.byte_slice(span_end, line_len).clone()

    String line_no = int_to_str(lc.line)
    String gutter = repeat_str(" ", digit_count(lc.line) + 1)  # blank left margin

    # 1) headline: `error[E_<code>]: <message>` — the ratified registry code sits
    #    INSIDE the colored severity run (codespan renders `error[E0382]` as one
    #    styled token), so the machine-readable `error[E_<code>]` substring stays
    #    CONTIGUOUS (no ANSI reset splits `error` from `[`) for a conformance
    #    harness to read. Only error-severity diagnostics whose kind maps to a
    #    registry code carry the `[E_<code>]` segment; warnings and notes render
    #    the bare `severity:` headline.
    String code_seg = ""
    match d.sev:
        case SevError():
            String code = diag_kind_code(d.kind)
            if code != "":
                code_seg = "[" + code + "]"
        else:
            pass
    String headline = ANSI_RESET + ANSI_BOLD + severity_color(d.sev) + severity_str(d.sev) + code_seg + ANSI_RESET + ANSI_BOLD + ": " + d.message + ANSI_RESET
    # 2) location: `  ┌─ path:line:col`
    String location = gutter + ANSI_RESET + ANSI_BLUE + "\u{250c}\u{2500}" + ANSI_RESET + " " + path + ":" + line_no + ":" + int_to_str(lc.col)
    # 3) empty gutter rule: `  │`
    String rule = gutter + ANSI_RESET + ANSI_BLUE + "\u{2502}" + ANSI_RESET
    # 4) source line: `N │ <before><span><after>`
    String body = ANSI_RESET + ANSI_BLUE + line_no + ANSI_RESET + " " + ANSI_RESET + ANSI_BLUE + "\u{2502}" + ANSI_RESET + " " + before + ANSI_RESET + ANSI_RED + spantext + ANSI_RESET + after
    # 5) caret line: `  │   ^^^^`
    String caret = gutter + ANSI_RESET + ANSI_BLUE + "\u{2502}" + ANSI_RESET + " " + repeat_str(" ", col0) + ANSI_RESET + ANSI_RED + repeat_str("^", width) + ANSI_RESET

    return headline + "\n" + location + "\n" + rule + "\n" + body + "\n" + caret

# ── Collection-level helpers (the severity gate) ────────────

int count_errors(Vector[Diagnostic] diags):
    int c = 0
    for d in diags:
        match d.sev:
            case SevError():
                c = c + 1
            else:
                pass
    return c

bool has_errors(Vector[Diagnostic] diags):
    return count_errors(diags) > 0

# Sort diagnostics by span start (stable insertion sort — same ordering
# the typechecker comparison driver already uses, lifted here so every
# consumer shares ONE deterministic order). Returns an index permutation.
Vector[int] diag_order_by_span(Vector[Diagnostic] diags):
    Vector[int] order = Vector[int]()
    int i = 0
    while i < diags.len():
        order.push(i)
        i = i + 1
    int oi = 1
    while oi < order.len():
        int key = order.get(oi).unwrap()
        int key_start = diags.get(key).unwrap().span.start
        int oj = oi - 1
        while oj >= 0:
            int other = order.get(oj).unwrap()
            if diags.get(other).unwrap().span.start <= key_start:
                break
            order.set(oj + 1, other)
            oj = oj - 1
        order.set(oj + 1, key)
        oi = oi + 1
    return order

# Render every diagnostic to stderr, span-sorted, with a final summary
# line. Returns the error count so the driver can decide to halt.
#
# Codespan separates consecutive diagnostics with a blank line, and the
# summary is preceded by one further blank line. Each diagnostic block is
# therefore trailed by one blank line here; the extra blank before the
# summary completes the `…\n\n\nN error(s) found` tail `gg check` emits.
int report_diagnostics(Vector[Diagnostic] diags, String source, String path):
    Vector[int] order = diag_order_by_span(diags)
    int k = 0
    while k < order.len():
        Diagnostic d = diags.get(order.get(k).unwrap()).unwrap()
        print(render_diagnostic(d, source, path), file=stderr)
        print("", file=stderr)
        k = k + 1
    int errs = count_errors(diags)
    if errs > 0:
        print("", file=stderr)
        print(int_to_str(errs) + " error(s) found", file=stderr)
    return errs
