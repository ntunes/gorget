# Trait registry — mirrors src/semantic/traits.rs for the self-host typechecker.
#
# Indexes traits and equip blocks so EMethodCall return-type inference can
# look up methods structurally instead of pattern-matching hardcoded
# method-name strings. Method-level generic args are inferred at the call
# site through MethodSigShape (Shape-1: bind G when it appears as a bare
# param type; Shape-2: bind G when it appears in the return type and a
# function-typed arg's return type fills it in).
#
# Storage uses struct-of-arrays (parallel Vectors over method names)
# rather than Dict[String, MethodInfo] for cache locality during the
# linear scan that dominates resolution. A future refactor could
# migrate to Dict[String, MethodInfo] now that ordering is preserved
# (TODO).

from std.collections import Vector
from ast import Module, Item, Type, FunctionDef, TraitDef, EquipBlock, Param, SpannedType, Span
from ast import ITrait, IEquip
from ast import TPrimitive, TNamed, TArray, TSlice, TTuple, TFunction, TSelf
from ids import NO_DEF, NO_TYPE
from scope import ScopeTable, DefInfo, Scope, get_scope_at
from scope import SkEquipBlock, SkFunction
from types import TypeTable, ResolvedType, ast_type_to_resolved, get_rtype_at
from types import RTGeneric, RTFunction, RTPrimitive
from types import FunctionSig, MethodSigShape, TraitInfo, EquipInfo
from types import TraitRegistry, MethodResolution, ShapeResolution
from resolve import ResolveContext
from diagnostic import Diagnostic, DkPrimitiveTraitImpl

# Data-type definitions (FunctionSig, MethodSigShape, TraitInfo,
# EquipInfo, TraitRegistry, MethodResolution, ShapeResolution) live in
# types.gg so the registry can ride on `&types` threading. This file
# owns the builder + resolver logic.

MethodResolution not_found_resolution():
    return MethodResolution(false, FunctionSig(Vector[int](), -1, false, -1), -1)

ShapeResolution not_found_shape():
    Vector[String] empty_names = Vector[String]()
    Vector[Type] empty_params = Vector[Type]()
    return ShapeResolution(false, MethodSigShape(empty_names, empty_params, TPrimitive("")))

TraitRegistry new_trait_registry():
    return TraitRegistry(Vector[TraitInfo](), Vector[EquipInfo](), Dict[int, Vector[int]](), Dict[int, Vector[int]]())

# ── Helpers: parallel-Vector lookup ──────────────────────────

Option[int] find_method_index(Vector[String] names, String target):
    for (i, n) in names.enumerate():
        if n == target:
            return Some(i)
    return None()

# ── AST type helpers ───────────────────────────────────────
# Walk a Type checking whether `name` appears as a bare TNamed (no args).
# Used by Shape-2 inference to detect which generic params show up in
# the return type.

bool type_mentions_name(Type ty, String name):
    match ty:
        case TNamed(tname, generic_args):
            if generic_args.len() == 0 and tname == name:
                return true
            for arg in generic_args:
                if type_mentions_name(arg.ty, name):
                    return true
            return false
        case TArray(element, size):
            return type_mentions_name((*element).ty, name)
        case TSlice(element):
            return type_mentions_name((*element).ty, name)
        case TTuple(elements):
            for e in elements:
                if type_mentions_name(e.ty, name):
                    return true
            return false
        case TFunction(return_type, params, _):
            if type_mentions_name((*return_type).ty, name):
                return true
            for p in params:
                if type_mentions_name(p.ty, name):
                    return true
            return false
        else:
            return false
    return false

# Resolve an AST Type with a name → TypeId binding map. Substitutes bare
# TNamed names that match a binding; otherwise recurses for generic args
# or falls through to ast_type_to_resolved.

int resolve_with_bindings(Type ty, Vector[String] bind_names, Vector[int] bind_tids, ScopeTable scopes, TypeTable &types):
    match ty:
        case TSelf():
            if find_method_index(bind_names, "Self") is Some(sidx):
                return bind_tids.get(sidx).unwrap()
            return ast_type_to_resolved(ty, Span(0, 0), scopes, &types)
        case TNamed(name, generic_args):
            if generic_args.len() == 0:
                if find_method_index(bind_names, name) is Some(idx):
                    return bind_tids.get(idx).unwrap()
            if generic_args.len() > 0:
                if scopes.lookup(name) is Some(def_id):
                    Vector[int] resolved_args = Vector[int]()
                    for arg in generic_args:
                        int aid = resolve_with_bindings(arg.ty, bind_names, bind_tids, scopes, &types)
                        resolved_args.push(aid)
                    return types.add_type(!RTGeneric(def_id, resolved_args))
            return ast_type_to_resolved(ty, Span(0, 0), scopes, &types)
        else:
            return ast_type_to_resolved(ty, Span(0, 0), scopes, &types)
    return ast_type_to_resolved(ty, Span(0, 0), scopes, &types)

# ── Build FunctionSig from a FunctionDef ─────────────────────
# Returns sig with method-level generics erased to types.error_id (their
# defs aren't in scope at registry-build time).

FunctionSig build_function_sig(FunctionDef func, ScopeTable scopes, TypeTable &types):
    int ret_id = ast_type_to_resolved(func.return_type.ty, func.return_type.span, scopes, &types)
    Vector[int] params = Vector[int]()
    bool has_self = false
    int self_ownership = -1
    for p in func.params:
        if p.param_name == "self":
            has_self = true
            self_ownership = p.ownership
            continue
        int p_tid = ast_type_to_resolved(p.param_type.ty, p.param_type.span, scopes, &types)
        params.push(p_tid)
    return FunctionSig(params, ret_id, has_self, self_ownership)

# Build a MethodSigShape (only meaningful when func.type_params is non-empty;
# the return value is a placeholder shape when type_params is empty).

MethodSigShape build_method_sig_shape(FunctionDef func):
    Vector[Type] param_types = Vector[Type]()
    for p in func.params:
        if p.param_name != "self":
            param_types.push(p.param_type.ty)
    return MethodSigShape(func.type_params, param_types, func.return_type.ty)

# ── type_name: receiver shape → string ────────────────────────

String type_name_of(Type ty):
    match ty:
        case TNamed(name, _):
            return name
        case TPrimitive(name):
            return name
        case TSelf():
            return "Self"
        else:
            return ""
    return ""

# ── Collect a TraitDef into the registry ──────────────────────

void collect_trait(TraitDef trait_def, ScopeTable scopes, TypeTable &types, TraitRegistry &registry):
    Option[int] def_id_opt = scopes.lookup(trait_def.name)
    if def_id_opt is None:
        return
    int def_id = def_id_opt.unwrap()
    Vector[String] method_names = Vector[String]()
    Vector[FunctionSig] method_sigs = Vector[FunctionSig]()
    Vector[bool] method_has_default = Vector[bool]()
    Vector[String] shape_names = Vector[String]()
    Vector[MethodSigShape] shape_shapes = Vector[MethodSigShape]()
    Vector[String] default_shape_names = Vector[String]()
    Vector[MethodSigShape] default_shape_shapes = Vector[MethodSigShape]()
    for method in trait_def.methods:
        FunctionSig sig = build_function_sig(method, scopes, &types)
        method_names.push(method.name)
        method_sigs.push(sig)
        bool has_body = method.is_expr_body or method.body.len() > 0
        method_has_default.push(has_body)
        if method.type_params.len() > 0:
            shape_names.push(method.name)
            shape_shapes.push(build_method_sig_shape(method))
        if has_body:
            default_shape_names.push(method.name)
            default_shape_shapes.push(build_method_sig_shape(method))
    Vector[int] parents = Vector[int]()
    for pname in trait_def.parent_traits:
        if scopes.lookup(pname) is Some(parent_id):
            parents.push(parent_id)
    TraitInfo info = TraitInfo(def_id, trait_def.name, method_names, method_sigs, method_has_default, shape_names, shape_shapes, trait_def.type_params, parents, default_shape_names, default_shape_shapes)
    registry.traits.push(info)

# ── Find the Nth pass-1 equip scope ──────────────────────────

Option[int] registry_find_nth_equip_def_scope(int n, int parent_scope, ScopeTable scopes):
    int count = 0
    int sid = 0
    while sid < scopes.scope_count():
        Scope s = get_scope_at(scopes.scopes, sid)
        if s.parent == parent_scope:
            bool is_equip = false
            match s.kind:
                case SkEquipBlock():
                    is_equip = true
                else:
                    pass
            if is_equip:
                bool has_fn_child = false
                int csid = sid + 1
                while csid < scopes.scope_count():
                    Scope cs = get_scope_at(scopes.scopes, csid)
                    if cs.parent == sid:
                        match cs.kind:
                            case SkFunction():
                                has_fn_child = true
                            else:
                                pass
                    if cs.parent < sid:
                        csid = scopes.scope_count()
                    csid = csid + 1
                if not has_fn_child:
                    if count == n:
                        return Some(sid)
                    count = count + 1
        sid = sid + 1
    return None()

# ── Collect an EquipBlock into the registry ──────────────────

void collect_equip(EquipBlock eq, int equip_scope, ScopeTable &scopes, TypeTable &types, TraitRegistry &registry, ResolveContext &ctx):
    int saved = scopes.current_scope()
    if equip_scope >= 0:
        scopes.set_current(equip_scope)
    int self_tid = ast_type_to_resolved(eq.target.ty, eq.target.span, scopes, &types)
    String self_name = type_name_of(eq.target.ty)
    int trait_def_id = NO_DEF
    String trait_name = ""
    if eq.trait_name is Some(tn):
        if scopes.lookup(tn) is Some(td):
            trait_def_id = td
        trait_name = tn
    # Reject equipping a scalar primitive with a trait. A scalar primitive
    # (int/int8-64/uint/uint8-64/float/float32-64/bool/char) has no
    # addressable heap `self` and no vtable slot, so trait method dispatch —
    # direct OR via `Box[Trait]` — miscompiles (the self-by-pointer ABI
    # derefs the value-as-address → SEGV). Mirrors Rust's `process_impl`
    # reject. Key off the RESOLVED type (Core #2, typed metadata): direct
    # scalars resolve to `RTPrimitive(pname)` via `primitive_id`. Intrinsic
    # trait satisfaction (Hashable/Cloneable/Displayable/Numeric) does NOT go
    # through equip blocks (Phase-4 `primitive_satisfies_trait`), so it is
    # untouched. `str`/`String`/`cstr`/`void` are excluded from the scalar
    # set, so `equip String with Writer` stays legitimate.
    #
    # KNOWN GAP (filed, not fixed here): a `type X = scalar` alias is NOT
    # caught — `collect_equip` runs BEFORE alias `type_id` resolution
    # (ITypeAlias handler in typecheck.gg), so the target resolves to
    # RTDefined, not RTPrimitive. Reordering alias resolution has a
    # disproportionate blast radius (registry-ordering comment upstream), so
    # this is a filed self-host-only asymmetry (Rust meta-inlines the alias
    # before process_impl and does reject). The DIRECT-scalar SEGV — the
    # load-bearing case — is closed in both compilers.
    if trait_name != "":
        match types.get(self_tid):
            case RTPrimitive(pname):
                if is_scalar_primitive_name(pname):
                    ctx.diagnostics.push(Diagnostic.error(eq.target.span, DkPrimitiveTraitImpl(), "cannot equip scalar primitive `" + pname + "` with trait `" + trait_name + "`: scalar primitives cannot be trait method receivers (no addressable `self`), so both direct dispatch and `Box[" + trait_name + "]` trait-object dispatch would miscompile. Wrap the value in a struct and equip that."))
                    scopes.set_current(saved)
                    return
            else:
                pass
    Vector[String] method_names = Vector[String]()
    Vector[int] method_def_ids = Vector[int]()
    Vector[FunctionSig] method_sigs = Vector[FunctionSig]()
    Vector[String] shape_names = Vector[String]()
    Vector[MethodSigShape] shape_shapes = Vector[MethodSigShape]()
    Vector[Type] method_return_types_ast = Vector[Type]()
    for method in eq.methods:
        FunctionSig sig = build_function_sig(method, scopes, &types)
        int mdef = -1
        if equip_scope >= 0:
            mdef = scopes.lookup_in_scope(equip_scope, method.name).unwrap_or(-1)
        method_names.push(method.name)
        method_def_ids.push(mdef)
        method_sigs.push(sig)
        method_return_types_ast.push(method.return_type.ty)
        if method.type_params.len() > 0:
            shape_names.push(method.name)
            shape_shapes.push(build_method_sig_shape(method))
    String via_name = ""
    if eq.via_field is Some(v):
        via_name = v
    # Capture trait generic args (AST-level Type vector) for call-site
    # Self/T substitution. Empty for inherent impls or non-generic traits.
    Vector[Type] trait_args = Vector[Type]()
    for targ in eq.trait_generic_args:
        trait_args.push(targ.ty)
    EquipInfo info = EquipInfo(self_tid, self_name, trait_def_id, trait_name, method_names, method_def_ids, method_sigs, shape_names, shape_shapes, eq.target.ty, eq.type_params, via_name, trait_args, method_return_types_ast)
    registry.impls.push(info)
    int new_idx = registry.impls.len() - 1
    # Maintain the self_type → impl-indices index. Inherent vs trait
    # impls live in disjoint Dicts so `resolve_method_full` can take the
    # correct precedence path without re-scanning. Mirrors Rust's
    # `inherent_impls` (the trait_impls index is self-host-specific —
    # see types.gg for the rationale). `.get(k).unwrap().push(x)` mutates
    # the inner Vector in place through the `Option[Ref[T]]` element
    # pointer (option_ref_borrow Phase 4) — the old "rebuild + put back"
    # workaround (feedback_nested_vector_get_set) is retired.
    if trait_def_id == NO_DEF:
        if registry.inherent_impls.contains(self_tid):
            registry.inherent_impls.get(self_tid).unwrap().push(new_idx)
        else:
            Vector[int] new_indices = [new_idx]
            registry.inherent_impls.put(self_tid, !new_indices)
    else:
        if registry.trait_impls.contains(self_tid):
            registry.trait_impls.get(self_tid).unwrap().push(new_idx)
        else:
            Vector[int] new_indices = [new_idx]
            registry.trait_impls.put(self_tid, !new_indices)
    scopes.set_current(saved)

# ── Built-in trait registration ──────────────────────────────
# Mirrors src/semantic/traits.rs `register_builtin_traits`. Populates
# TraitInfo for each known trait *name* iff the resolver pre-defined it
# in scope (resolve.gg pushes Displayable / Equatable / … into the
# trait_names list at scope init). Uses types.error_id as a placeholder
# for Self / generic-param positions, exactly like the Rust impl —
# call-site substitution will materialise them later (currently a TODO
# follow-on; today these sigs feed the intrinsic-satisfaction path).
#
# Ordering: called after `collect_trait` walks user `trait` decls. If a
# user shadows a built-in name, the user's TraitInfo is already in the
# registry under the same DefId; we skip re-registering.

# Ownership constants (mirror parser.gg's OWN_*).
int trait_own_borrow():
    return 0
int trait_own_mutable():
    return 1
int trait_own_move():
    return 2

bool registry_has_trait_for_def_id(TraitRegistry registry, int def_id):
    for t in registry.traits:
        if t.def_id == def_id:
            return true
    return false

# Build a builtin TraitInfo with a single method.
TraitInfo make_builtin_trait_one(int def_id, String name, String method, FunctionSig sig):
    Vector[String] mn = Vector[String]()
    mn.push(method)
    Vector[FunctionSig] ms = Vector[FunctionSig]()
    ms.push(sig)
    Vector[bool] mh = Vector[bool]()
    mh.push(false)
    Vector[String] sn = Vector[String]()
    Vector[MethodSigShape] ss = Vector[MethodSigShape]()
    Vector[String] gp = Vector[String]()
    Vector[int] ext = Vector[int]()
    Vector[String] dn = Vector[String]()
    Vector[MethodSigShape] dss = Vector[MethodSigShape]()
    return TraitInfo(def_id, name, mn, ms, mh, sn, ss, gp, ext, dn, dss)

# Register a builtin trait by name. No-op if scope doesn't define it
# (resolver controls which builtins exist) or if it's already in the
# registry from user collect_trait.
void register_builtin_method(String trait_name, String method, FunctionSig sig, ScopeTable scopes, TraitRegistry &registry):
    Option[int] def_id_opt = scopes.lookup(trait_name)
    if def_id_opt is None:
        return
    int def_id = def_id_opt.unwrap()
    if registry_has_trait_for_def_id(registry, def_id):
        return
    registry.traits.push(make_builtin_trait_one(def_id, trait_name, method, sig))

# Append a method to an existing builtin trait (used for multi-method
# traits like Hasher).
void append_builtin_method(String trait_name, String method, FunctionSig sig, ScopeTable scopes, TraitRegistry &registry):
    Option[int] def_id_opt = scopes.lookup(trait_name)
    if def_id_opt is None:
        return
    int def_id = def_id_opt.unwrap()
    int i = 0
    while i < registry.traits.len():
        TraitInfo t = registry.traits.get(i).unwrap()
        if t.def_id == def_id:
            t.method_names.push(method)
            t.method_sigs.push(sig)
            t.method_has_default_body.push(false)
            registry.traits.set(i, t)
            return
        i = i + 1

# Helpers to build common FunctionSigs.

FunctionSig sig_self_returns(int ret_id, int self_own):
    return FunctionSig(Vector[int](), ret_id, true, self_own)

FunctionSig sig_self_one_arg(int arg_id, int ret_id, int self_own):
    Vector[int] params = Vector[int]()
    params.push(arg_id)
    return FunctionSig(params, ret_id, true, self_own)

FunctionSig sig_self_two_args(int a1, int a2, int ret_id, int self_own):
    Vector[int] params = Vector[int]()
    params.push(a1)
    params.push(a2)
    return FunctionSig(params, ret_id, true, self_own)

FunctionSig sig_static_no_args(int ret_id):
    return FunctionSig(Vector[int](), ret_id, false, -1)

FunctionSig sig_static_one_arg(int arg_id, int ret_id):
    Vector[int] params = Vector[int]()
    params.push(arg_id)
    return FunctionSig(params, ret_id, false, -1)

# Register every built-in core trait. Walk through each trait name; if
# the resolver pre-defined it AND the user hasn't supplied their own
# TraitDef, install a TraitInfo with placeholder-typed sigs.
void register_builtin_traits(ScopeTable scopes, TypeTable types, TraitRegistry &registry):
    int err = types.error_id
    int void_id = types.void_id
    int bool_id = types.bool_id
    int int_id = types.int_id
    int str_id = types.string_id
    int owned_str_id = types.owned_string_id
    int own_borrow = trait_own_borrow()
    int own_mutable = trait_own_mutable()
    int own_move = trait_own_move()

    # Displayable: String display(self)
    register_builtin_method("Displayable", "display", sig_self_returns(owned_str_id, own_borrow), scopes, &registry)
    # Debuggable: String debug(self)
    register_builtin_method("Debuggable", "debug", sig_self_returns(owned_str_id, own_borrow), scopes, &registry)
    # Equatable: bool eq(self, Self other)
    register_builtin_method("Equatable", "eq", sig_self_one_arg(err, bool_id, own_borrow), scopes, &registry)
    # Cloneable: Self clone(self) — return placeholder
    register_builtin_method("Cloneable", "clone", sig_self_returns(err, own_borrow), scopes, &registry)
    # Hashable: void hash[H](self, H &h)
    register_builtin_method("Hashable", "hash", sig_self_one_arg(err, void_id, own_borrow), scopes, &registry)
    # Hasher: write_int / write_bytes / write_string / finish
    register_builtin_method("Hasher", "write_int", sig_self_one_arg(int_id, void_id, own_mutable), scopes, &registry)
    append_builtin_method("Hasher", "write_bytes", sig_self_one_arg(err, void_id, own_mutable), scopes, &registry)
    append_builtin_method("Hasher", "write_string", sig_self_one_arg(owned_str_id, void_id, own_mutable), scopes, &registry)
    append_builtin_method("Hasher", "finish", sig_self_returns(int_id, own_borrow), scopes, &registry)
    # Ordinal: int ordinal(self)
    register_builtin_method("Ordinal", "ordinal", sig_self_returns(int_id, own_borrow), scopes, &registry)
    # Drop: void drop(!self)
    register_builtin_method("Drop", "drop", sig_self_returns(void_id, own_move), scopes, &registry)
    # Iterable: IterType iter(&self) — return placeholder; concrete from impl
    register_builtin_method("Iterable", "iter", sig_self_returns(err, own_mutable), scopes, &registry)
    # Add[Out] / Sub / Mul / Div / Rem / Mod: Out op(self, Self rhs)
    register_builtin_method("Add", "add", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    register_builtin_method("Sub", "sub", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    register_builtin_method("Mul", "mul", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    register_builtin_method("Div", "div", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    register_builtin_method("Rem", "rem", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    register_builtin_method("Mod", "mod", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    # Neg[Out]: Out neg(self)
    register_builtin_method("Neg", "neg", sig_self_returns(err, own_borrow), scopes, &registry)
    # Comparable: int compare(self, Self other)
    register_builtin_method("Comparable", "compare", sig_self_one_arg(err, int_id, own_borrow), scopes, &registry)
    # Index[K, V]: V get(self, K key)
    register_builtin_method("Index", "get", sig_self_one_arg(err, err, own_borrow), scopes, &registry)
    # IndexMut[K, V]: void set(&self, K key, V value)
    register_builtin_method("IndexMut", "set", sig_self_two_args(err, err, void_id, own_mutable), scopes, &registry)
    # Default: Self default() — static
    register_builtin_method("Default", "default", sig_static_no_args(err), scopes, &registry)
    # From[T]: Self from(T) — static
    register_builtin_method("From", "from", sig_static_one_arg(err, err), scopes, &registry)
    # TryFrom[T]: Result[Self, str] try_from(T) — static
    register_builtin_method("TryFrom", "try_from", sig_static_one_arg(err, err), scopes, &registry)
    # Measurable: int len(self)
    register_builtin_method("Measurable", "len", sig_self_returns(int_id, own_borrow), scopes, &registry)
    # Parseable: Option[Self] parse(str) — static
    register_builtin_method("Parseable", "parse", sig_static_one_arg(str_id, err), scopes, &registry)
    # One: Self one() — static
    register_builtin_method("One", "one", sig_static_no_args(err), scopes, &registry)
    # Numeric: composite — empty methods, extends others
    Option[int] numeric_def_opt = scopes.lookup("Numeric")
    if numeric_def_opt is Some(numeric_def) and not registry_has_trait_for_def_id(registry, numeric_def):
        Vector[int] parents = Vector[int]()
        Vector[String] parent_names = Vector[String]()
        parent_names.push("Add")
        parent_names.push("Sub")
        parent_names.push("Mul")
        parent_names.push("Div")
        parent_names.push("Rem")
        parent_names.push("Mod")
        parent_names.push("Neg")
        parent_names.push("Comparable")
        parent_names.push("Default")
        parent_names.push("One")
        for pn in parent_names:
            if scopes.lookup(pn) is Some(pd):
                parents.push(pd)
        Vector[String] empty_mn = Vector[String]()
        Vector[FunctionSig] empty_ms = Vector[FunctionSig]()
        Vector[bool] empty_mh = Vector[bool]()
        Vector[String] empty_sn = Vector[String]()
        Vector[MethodSigShape] empty_ss = Vector[MethodSigShape]()
        Vector[String] empty_gp = Vector[String]()
        Vector[String] empty_dn = Vector[String]()
        Vector[MethodSigShape] empty_dss = Vector[MethodSigShape]()
        TraitInfo numeric_info = TraitInfo(numeric_def, "Numeric", empty_mn, empty_ms, empty_mh, empty_sn, empty_ss, empty_gp, parents, empty_dn, empty_dss)
        registry.traits.push(numeric_info)

# ── Build the registry for a module ──────────────────────────

TraitRegistry build_trait_registry(Module module, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
    TraitRegistry registry = new_trait_registry()
    int module_scope = 0
    for item_a in module.items:
        match item_a:
            case ITrait(td):
                collect_trait(td, scopes, &types, &registry)
            else:
                pass
    int eq_idx = 0
    for item_b in module.items:
        match item_b:
            case IEquip(eq):
                int equip_scope = registry_find_nth_equip_def_scope(eq_idx, module_scope, scopes).unwrap_or(-1)
                collect_equip(eq, equip_scope, &scopes, &types, &registry, &ctx)
                eq_idx = eq_idx + 1
            else:
                pass
    # Register built-in core traits last so user-defined traits (collected
    # above via collect_trait) win on the same DefId.
    register_builtin_traits(scopes, types, &registry)
    return registry

# ── Supertrait default-method walk ───────────────────────────
# Mirrors Rust `TraitRegistry::find_default_method` (traits.rs): DFS over
# a trait + its `extends` parents for a default method body. Cycle-guarded
# via a visited Vector of def_ids. Returns the OWNING TraitInfo (where the
# default body lives) so callers hand back that trait's def_id for throws
# gates / default-sig substitution — not the equip's child trait def_id.

Option[TraitInfo] find_default_method(TraitRegistry registry, int start_trait_def_id, String method):
    Vector[int] stack = Vector[int]()
    stack.push(start_trait_def_id)
    Vector[int] visited = Vector[int]()
    while stack.len() > 0:
        Option[int] top = stack.pop()
        if top is Some(id):
            bool seen = false
            for v in visited:
                if v == id:
                    seen = true
            if seen:
                continue
            visited.push(id)
            for tinfo in registry.traits:
                if tinfo.def_id == id:
                    if find_method_index(tinfo.method_names, method) is Some(midx):
                        bool has_default = tinfo.method_has_default_body.get(midx).unwrap()
                        if has_default:
                            return Some(tinfo)
                    for parent_id in tinfo.parent_trait_ids:
                        stack.push(parent_id)
    return None()

# ── Default-method Self/T substitution ───────────────────────
# Mirrors `substitute_default_method_sig` in src/semantic/typecheck.rs.
# When phase 3 of resolve_method matches a trait-default method, the
# stored FunctionSig's return_type is `error_id` for any slot that was
# `Self` or trait-T in the source. The AST shape preserves that structure
# in `default_shape_shapes`. We bind `Self → impl.self_type` and
# `trait_generic_params[i] → impl.trait_generic_args[i]` (resolved to
# TypeIds) and walk the AST return type, producing a substituted TypeId.

int substitute_default_return(EquipInfo impl, TraitInfo trait_info, MethodSigShape default_shape, ScopeTable scopes, TypeTable &types):
    Vector[String] bind_names = Vector[String]()
    Vector[int] bind_tids = Vector[int]()
    bind_names.push("Self")
    bind_tids.push(impl.self_type)
    int n = trait_info.trait_generic_params.len()
    if impl.trait_generic_args.len() < n:
        n = impl.trait_generic_args.len()
    int i = 0
    while i < n:
        String tname = trait_info.trait_generic_params.get(i).unwrap()
        Type targ_ast = impl.trait_generic_args.get(i).unwrap()
        int targ_tid = ast_type_to_resolved(targ_ast, Span(0, 0), scopes, &types)
        if targ_tid >= 0:
            bind_names.push(tname)
            bind_tids.push(targ_tid)
        i = i + 1
    return resolve_with_bindings(default_shape.return_type, bind_names, bind_tids, scopes, &types)

# Substitution-aware variant of resolve_method. Inherent + trait-override
# phases (1, 2) behave identically; phase 3 (trait default) additionally
# substitutes Self / trait-T placeholders in the return type before
# returning. Use this from the call site whenever you can — it produces
# concrete TypeIds for default-method return types where the bare
# resolve_method would surface `error_id`.

# Substitute default-method return for a *generic* impl. Differs from
# substitute_default_return: when the impl has its own generics
# (`equip [I, T] TakeIter[I, T] with Iterator[T]:`), the trait_generic_args
# are AST types that reference the impl's locals (e.g. TNamed("T")). We
# first build an impl-arg binding (impl_generic_params[i] →
# recv_args[i]) so the trait args resolve to concrete TypeIds, then add
# `Self → recv_type_id` and `trait_generic_params[i] → resolved trait
# arg[i]` and walk the default-method return AST.

int substitute_default_return_generic(EquipInfo impl, TraitInfo trait_info, MethodSigShape default_shape, int recv_type_id, Vector[String] impl_bind_names, Vector[int] impl_bind_tids, ScopeTable scopes, TypeTable &types):
    Vector[String] bind_names = Vector[String]()
    Vector[int] bind_tids = Vector[int]()
    bind_names.push("Self")
    bind_tids.push(recv_type_id)
    int n = trait_info.trait_generic_params.len()
    if impl.trait_generic_args.len() < n:
        n = impl.trait_generic_args.len()
    int i = 0
    while i < n:
        String tname = trait_info.trait_generic_params.get(i).unwrap()
        Type targ_ast = impl.trait_generic_args.get(i).unwrap()
        int targ_tid = resolve_with_bindings(targ_ast, impl_bind_names, impl_bind_tids, scopes, &types)
        if targ_tid >= 0:
            bind_names.push(tname)
            bind_tids.push(targ_tid)
        i = i + 1
    # Fold impl bindings in too — they might appear directly in the
    # return-type AST (e.g. `Self` in a non-generic position).
    for (bi, impl_bn) in impl_bind_names.enumerate():
        bind_names.push(impl_bn)
        bind_tids.push(impl_bind_tids.get(bi).unwrap())
    return resolve_with_bindings(default_shape.return_type, bind_names, bind_tids, scopes, &types)

# Look up a method for a generic-shaped receiver (RTGeneric). Walks impls
# whose self_type_name matches the receiver's name, binds the impl's
# generic params positionally from the receiver's type args, then runs
# the same three phases as resolve_method_full but with the generic
# substitution kernel. Without this, chains like
# `v.iter().take(n).map(f)` lose all type info past the first call
# because the registered impl's self_type holds abstract placeholder
# TypeIds that no concrete receiver matches.

MethodResolution resolve_method_for_generic_receiver(String recv_name, Vector[int] recv_args, int recv_type_id, String method, ScopeTable scopes, TypeTable &types):
    for impl in types.trait_registry.impls:
        if impl.self_type_name == recv_name:
            # Build impl-generic bindings from the receiver's args.
            Vector[String] impl_bind_names = Vector[String]()
            Vector[int] impl_bind_tids = Vector[int]()
            int n = impl.impl_generic_params.len()
            if recv_args.len() < n:
                n = recv_args.len()
            int bi = 0
            while bi < n:
                String pn = impl.impl_generic_params.get(bi).unwrap()
                int pt = recv_args.get(bi).unwrap()
                impl_bind_names.push(pn)
                impl_bind_tids.push(pt)
                bi = bi + 1
            # Phase 1+2: method directly on this impl. The stored
            # FunctionSig has the impl's generic-param placeholders
            # baked into its TypeIds. To get a concrete return type
            # for chains like `v.iter().map(f).collect()`, substitute
            # the AST return type with the impl-arg bindings — this
            # turns `VectorIter[T]` (placeholder T) into
            # `VectorIter[int]` when the receiver is `Vector[int]`.
            # Mirrors what (a2) does for trait DEFAULT methods, but
            # for IMPL-OVERRIDE methods.
            if find_method_index(impl.method_names, method) is Some(idx):
                FunctionSig sig = impl.method_sigs.get(idx).unwrap()
                if impl.method_return_types_ast.len() > idx and impl.impl_generic_params.len() > 0:
                    Type ret_ast = impl.method_return_types_ast.get(idx).unwrap()
                    int subst_ret = resolve_with_bindings(ret_ast, impl_bind_names, impl_bind_tids, scopes, &types)
                    if subst_ret >= 0 and subst_ret != types.error_id:
                        sig = FunctionSig(sig.params, subst_ret, sig.has_self, sig.self_ownership)
                return MethodResolution(true, sig, impl.method_def_ids.get(idx).unwrap())
            # Phase 3: trait default-method fallback with full
            # generic-receiver substitution. Walks supertraits via
            # `find_default_method` so a parent default is visible
            # through `equip … with Child` (Child extends Base).
            if impl.trait_def_id != NO_DEF:
                if find_default_method(types.trait_registry, impl.trait_def_id, method) is Some(tinfo):
                    if find_method_index(tinfo.method_names, method) is Some(midx):
                        FunctionSig sig = tinfo.method_sigs.get(midx).unwrap()
                        if find_method_index(tinfo.default_shape_names, method) is Some(sidx):
                            MethodSigShape shape = tinfo.default_shape_shapes.get(sidx).unwrap()
                            int subst_ret = substitute_default_return_generic(impl, tinfo, shape, recv_type_id, impl_bind_names, impl_bind_tids, scopes, &types)
                            if subst_ret >= 0 and subst_ret != types.error_id:
                                sig = FunctionSig(sig.params, subst_ret, sig.has_self, sig.self_ownership)
                        return MethodResolution(true, sig, tinfo.def_id)
    return not_found_resolution()

MethodResolution resolve_method_full(int type_id, String method, ScopeTable scopes, TypeTable &types):
    # Phase 1: inherent impls for this type via the typed index.
    # Rust's `inherent_impls.get(&type_id)` equivalent — visits only
    # the impls whose `self_type` matches, skipping the full linear
    # scan over `types.trait_registry.impls`.
    if types.trait_registry.inherent_impls.contains(type_id):
        Vector[int] indices = types.trait_registry.inherent_impls.get(type_id).unwrap()
        for idx_impl in indices:
            EquipInfo impl = types.trait_registry.impls.get(idx_impl).unwrap()
            if find_method_index(impl.method_names, method) is Some(idx):
                return MethodResolution(true, impl.method_sigs.get(idx).unwrap(), impl.method_def_ids.get(idx).unwrap())
    # Phase 2: trait-override impls for this type. Self-host extends
    # Rust's `inherent_impls` design with a parallel `trait_impls`
    # index keyed only on self_type (Rust's trait_impls uses a richer
    # composite key for duplicate-impl validation, which the self-host
    # typechecker doesn't perform — so the simpler key suffices here).
    if types.trait_registry.trait_impls.contains(type_id):
        Vector[int] indices = types.trait_registry.trait_impls.get(type_id).unwrap()
        for idx_impl in indices:
            EquipInfo impl = types.trait_registry.impls.get(idx_impl).unwrap()
            if find_method_index(impl.method_names, method) is Some(idx):
                return MethodResolution(true, impl.method_sigs.get(idx).unwrap(), impl.method_def_ids.get(idx).unwrap())
    # Phase 3: trait default-method fallback. Same per-self_type
    # subset as phase 2, but consults the implemented trait (and its
    # supertraits via `find_default_method`) for a default body when
    # the impl itself doesn't override the method. Returns the
    # OWNING trait's def_id (where the default lives).
    if types.trait_registry.trait_impls.contains(type_id):
        Vector[int] indices = types.trait_registry.trait_impls.get(type_id).unwrap()
        for idx_impl in indices:
            EquipInfo impl = types.trait_registry.impls.get(idx_impl).unwrap()
            if impl.trait_def_id != NO_DEF:
                if find_default_method(types.trait_registry, impl.trait_def_id, method) is Some(tinfo):
                    if find_method_index(tinfo.method_names, method) is Some(midx):
                        FunctionSig sig = tinfo.method_sigs.get(midx).unwrap()
                        if find_method_index(tinfo.default_shape_names, method) is Some(sidx):
                            MethodSigShape shape = tinfo.default_shape_shapes.get(sidx).unwrap()
                            int subst_ret = substitute_default_return(impl, tinfo, shape, scopes, &types)
                            if subst_ret >= 0 and subst_ret != types.error_id:
                                sig = FunctionSig(sig.params, subst_ret, sig.has_self, sig.self_ownership)
                        return MethodResolution(true, sig, tinfo.def_id)
    return not_found_resolution()

# ── Intrinsic-satisfaction helpers ──────────────────────────
# Mirror Rust's is_numeric_primitive / is_numeric_trait /
# is_hashable_primitive / is_copy_displayable_primitive. Used by
# resolve_method's Phase 4 to dispatch builtin-trait methods on
# primitives that don't have an explicit equip block.

bool is_numeric_primitive_name(String name):
    if name == "int" or name == "float":
        return true
    if name == "int8" or name == "int16" or name == "int32" or name == "int64":
        return true
    if name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64":
        return true
    if name == "float32" or name == "float64":
        return true
    return false

# The SCALAR builtins that cannot be trait method receivers: they have no
# addressable heap `self` and no vtable slot, so any `equip <scalar> with
# Trait` block miscompiles (self-by-pointer ABI derefs the value-as-address
# → SEGV / NULL-degraded vtable). `collect_equip` rejects on this set;
# mirrors Rust's `is_scalar_primitive`.
#
# ⚠ DELIBERATELY SEPARATE from `is_numeric_primitive_name` — do NOT fold this
# into that helper. `is_numeric_primitive_name` feeds `primitive_satisfies_trait`
# (numeric-trait dispatch); adding `bool`/`char` there would make them spuriously
# satisfy Add/Sub/Numeric (a semantic regression). This set is a SUPERSET (adds
# bare `uint` + `bool` + `char`) used ONLY for the equip-reject. `str` / `String` /
# `cstr` / `void` are heap/view/unit and are NOT scalars — they are excluded so
# `equip String with Writer` stays legitimate.
bool is_scalar_primitive_name(String name):
    if name == "int" or name == "uint" or name == "float" or name == "bool" or name == "char":
        return true
    if name == "int8" or name == "int16" or name == "int32" or name == "int64":
        return true
    if name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64":
        return true
    if name == "float32" or name == "float64":
        return true
    return false

bool is_hashable_primitive_name(String name):
    if name == "int" or name == "char" or name == "bool" or name == "str" or name == "String":
        return true
    if name == "int8" or name == "int16" or name == "int32" or name == "int64":
        return true
    if name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64":
        return true
    return false

bool is_copy_displayable_primitive_name(String name):
    if is_numeric_primitive_name(name):
        return true
    if name == "str" or name == "bool" or name == "char" or name == "String":
        return true
    return false

bool is_numeric_trait_name(String name):
    if name == "Add" or name == "Sub" or name == "Mul" or name == "Div" or name == "Rem" or name == "Mod":
        return true
    if name == "Neg" or name == "Comparable" or name == "Default" or name == "One" or name == "Numeric":
        return true
    return false

bool is_hashable_trait_name(String name):
    return name == "Hashable" or name == "Equatable"

bool is_copy_displayable_trait_name(String name):
    return name == "Displayable" or name == "Debuggable" or name == "Cloneable"

bool primitive_satisfies_trait(String prim_name, String trait_name):
    if is_numeric_primitive_name(prim_name) and is_numeric_trait_name(trait_name):
        return true
    if is_hashable_primitive_name(prim_name) and is_hashable_trait_name(trait_name):
        return true
    if is_copy_displayable_primitive_name(prim_name) and is_copy_displayable_trait_name(trait_name):
        return true
    # Measurable: types with a length — handled here only for str/String;
    # collections go through the hardcoded len() path so we don't need
    # to special-case them at this layer.
    if trait_name == "Measurable" and (prim_name == "str" or prim_name == "String"):
        return true
    return false

# Look up a method on built-in traits using intrinsic satisfaction. Walks
# every registered builtin trait, checks if `prim_name` intrinsically
# satisfies it, and returns the method's FunctionSig if found. Self / Out
# placeholders in the sig (stored as types.error_id) are substituted to
# the receiver's primitive TypeId — so e.g. `int.add(self, Self) -> Self`
# resolves to `add(self, int) -> int` for int receivers.

MethodResolution intrinsic_resolve(TraitRegistry registry, String prim_name, int prim_type_id, int err_id, String method):
    for tinfo in registry.traits:
        if primitive_satisfies_trait(prim_name, tinfo.name):
            if find_method_index(tinfo.method_names, method) is Some(midx):
                FunctionSig sig = tinfo.method_sigs.get(midx).unwrap()
                FunctionSig substituted = substitute_self_placeholders(sig, prim_type_id, err_id)
                return MethodResolution(true, substituted, tinfo.def_id)
    return not_found_resolution()

# Replace error_id placeholders (Self/Out in built-in sigs) with the
# concrete receiver type. Walks the params Vector and the return slot.
FunctionSig substitute_self_placeholders(FunctionSig sig, int self_tid, int err_id):
    Vector[int] new_params = Vector[int]()
    for p in sig.params:
        if p == err_id:
            new_params.push(self_tid)
        else:
            new_params.push(p)
    int ret = sig.return_type
    if ret == err_id:
        ret = self_tid
    return FunctionSig(new_params, ret, sig.has_self, sig.self_ownership)

# Lookup by self_type_name; fallback when TypeIds don't align across modules.

MethodResolution resolve_method_by_name(TraitRegistry registry, String type_name, String method):
    for impl in registry.impls:
        if impl.self_type_name == type_name:
            if find_method_index(impl.method_names, method) is Some(idx):
                return MethodResolution(true, impl.method_sigs.get(idx).unwrap(), impl.method_def_ids.get(idx).unwrap())
    for impl in registry.impls:
        if impl.self_type_name == type_name and impl.trait_def_id != NO_DEF:
            if find_default_method(registry, impl.trait_def_id, method) is Some(tinfo):
                if find_method_index(tinfo.method_names, method) is Some(midx):
                    return MethodResolution(true, tinfo.method_sigs.get(midx).unwrap(), tinfo.def_id)
    return not_found_resolution()

# Lookup MethodSigShape by (TypeId, method).
# Default-method shapes walk supertraits via `find_default_method`
# (mirrors Rust `resolve_method_shape`).

ShapeResolution resolve_method_shape(TraitRegistry registry, int type_id, String method):
    for impl in registry.impls:
        if impl.self_type == type_id:
            if find_method_index(impl.shape_method_names, method) is Some(idx):
                return ShapeResolution(true, impl.shape_method_shapes.get(idx).unwrap())
    for impl in registry.impls:
        if impl.self_type == type_id and impl.trait_def_id != NO_DEF:
            if find_default_method(registry, impl.trait_def_id, method) is Some(tinfo):
                if find_method_index(tinfo.shape_method_names, method) is Some(midx):
                    return ShapeResolution(true, tinfo.shape_method_shapes.get(midx).unwrap())
    return not_found_shape()

# Lazy-iterator phase 1b Blocker #2: the TypeId-keyed `resolve_method_shape`
# above matches `impl.self_type == type_id`, which FAILS for a freshly
# monomorphized generic-receiver instance (e.g. `VectorIter[int]`) — its
# concrete TypeId never equals the registered impl's abstract placeholder
# self_type. The method itself resolves only via the by-NAME
# `resolve_method_for_generic_receiver` path; this is the shape mirror of
# that path so `infer_method_targs` can compute the method-level targs for
# the bare (no-turbofish) terminal calls (`v.iter().fold(0, f)`). The shape
# is read from the same stores as the TypeId-keyed path:
# `impl.shape_method_shapes` (impl-override) and the owning trait's
# `tinfo.shape_method_shapes` (trait method-generic default, incl. supertrait).
ShapeResolution resolve_method_shape_for_generic_receiver(TraitRegistry registry, String recv_name, String method):
    for impl in registry.impls:
        if impl.self_type_name == recv_name:
            if find_method_index(impl.shape_method_names, method) is Some(idx):
                return ShapeResolution(true, impl.shape_method_shapes.get(idx).unwrap())
    for impl in registry.impls:
        if impl.self_type_name == recv_name and impl.trait_def_id != NO_DEF:
            if find_default_method(registry, impl.trait_def_id, method) is Some(tinfo):
                if find_method_index(tinfo.shape_method_names, method) is Some(midx):
                    return ShapeResolution(true, tinfo.shape_method_shapes.get(midx).unwrap())
    return not_found_shape()

# ── Method-generic inference ──────────────────────────────────
# Returns a Vector[int] of length shape.generic_params.len(); element i
# is the bound TypeId for the i-th generic, or -1 if unbound.
#
# Shape 1: G appears bare as a param's type → bind G to that arg's type.
# Shape 2: G appears in the return type, exactly one arg is a function
#   typed value → bind G to that function's return type.

Vector[int] infer_method_targs(MethodSigShape shape, Vector[int] arg_types, ScopeTable scopes, TypeTable types):
    Vector[int] tids = Vector[int]()
    for _ in shape.generic_params:
        tids.push(-1)
    if shape.param_types.len() != arg_types.len():
        return tids
    for (i, pt) in shape.param_types.enumerate():
        match pt:
            case TNamed(pname, generic_args):
                if generic_args.len() == 0:
                    for (gi, gn) in shape.generic_params.enumerate():
                        if gn == pname and tids.get(gi).unwrap() < 0:
                            int arg_tid = arg_types.get(i).unwrap()
                            if arg_tid >= 0 and arg_tid != types.error_id:
                                tids.set(gi, arg_tid)
            else:
                pass
    for (gi2, gname) in shape.generic_params.enumerate():
        if tids.get(gi2).unwrap() < 0:
            if type_mentions_name(shape.return_type, gname):
                int fn_ret = -1
                bool ambiguous = false
                for at in arg_types:
                    if at >= 0 and at < types.types.len():
                        ResolvedType rt = get_rtype_at(types.types, at)
                        match rt:
                            case RTFunction(_, _, ret_id):
                                if ret_id != types.error_id:
                                    if fn_ret < 0:
                                        fn_ret = ret_id
                                    elif fn_ret != ret_id:
                                        ambiguous = true
                            else:
                                pass
                if fn_ret >= 0 and not ambiguous:
                    tids.set(gi2, fn_ret)
    return tids

# Substitute the shape's return type using inferred targs.
# Returns the resolved TypeId (may still contain unresolved generics if
# inference came up short — caller should treat `error_id` / negative as
# inference-failed).

int substitute_return_type(MethodSigShape shape, Vector[int] bind_tids, ScopeTable scopes, TypeTable &types):
    return resolve_with_bindings(shape.return_type, shape.generic_params, bind_tids, scopes, &types)

# Lazy-iterator chain support: substitute a METHOD-GENERIC trait-default's
# return type for a GENERIC adapter receiver, binding the FULL set:
#   Self            → recv_type_id (the concrete receiver, e.g.
#                     TakeIter[VectorIter[int], int])
#   impl generics   → recv's type args, positionally (e.g. [I, T] → the
#                     receiver's [TakeIter-inner, elem])
#   trait generics  → the impl's trait clause args resolved against the impl
#                     bindings (e.g. `T` in `Iterator[T]`)
#   method generics → the inferred method-level targs (`bound`, e.g. `F`)
#
# WHY: `substitute_return_type` above binds ONLY `shape.generic_params` (the
# method-level `[F]`/`[U,F]`). For an ADAPTER constructor default like
# `FilterIter[Self, T, F] filter[F](self, F p)`, the return type ALSO mentions
# `Self` and the impl's `T` — those stay UNBOUND under the plain path and
# `resolve_with_bindings` falls them through to the bare placeholder def
# (`FilterIter[int, int, F]` — wrong Self/T). For a single-step `.filter` on
# a base `VectorIter` the turbofish form sidesteps this; but a BARE-form
# `.filter` on an adapter receiver in a chain
# (`v.iter().take(4).filter(p)`) hits it and the lowerer then CC-fails on the
# mis-named `FilterIter__int64_t__…`. Binding the full set yields the correct
# `FilterIter[TakeIter[VectorIter[int],int], int, F]`. Mirrors the Self+impl+
# trait binding `substitute_default_return_generic` already does for the
# NON-method-generic defaults, plus the method-level `bound`.
#
# Returns -1 if no impl matches the receiver name (caller keeps its prior
# `reg_ret`), so the base/non-adapter cases are untouched.
int substitute_shape_return_generic_receiver(String recv_name, Vector[int] recv_args, int recv_type_id, MethodSigShape shape, Vector[int] bound, ScopeTable scopes, TypeTable &types):
    for impl in types.trait_registry.impls:
        if impl.self_type_name == recv_name and impl.trait_def_id != NO_DEF:
            # Impl-generic bindings from the receiver's type args (positional).
            Vector[String] impl_bind_names = Vector[String]()
            Vector[int] impl_bind_tids = Vector[int]()
            int n = impl.impl_generic_params.len()
            if recv_args.len() < n:
                n = recv_args.len()
            int bi = 0
            while bi < n:
                impl_bind_names.push(impl.impl_generic_params.get(bi).unwrap())
                impl_bind_tids.push(recv_args.get(bi).unwrap())
                bi = bi + 1
            # Full binding set: Self + trait-generics + impl-generics + method-generics.
            Vector[String] bind_names = Vector[String]()
            Vector[int] bind_tids = Vector[int]()
            bind_names.push("Self")
            bind_tids.push(recv_type_id)
            for tinfo in types.trait_registry.traits:
                if tinfo.def_id == impl.trait_def_id:
                    int tn = tinfo.trait_generic_params.len()
                    if impl.trait_generic_args.len() < tn:
                        tn = impl.trait_generic_args.len()
                    int ti = 0
                    while ti < tn:
                        String tgp = tinfo.trait_generic_params.get(ti).unwrap()
                        Type targ_ast = impl.trait_generic_args.get(ti).unwrap()
                        int targ_tid = resolve_with_bindings(targ_ast, impl_bind_names, impl_bind_tids, scopes, &types)
                        if targ_tid >= 0:
                            bind_names.push(tgp)
                            bind_tids.push(targ_tid)
                        ti = ti + 1
            # Impl locals (e.g. [I, T]) — may appear directly in the return AST.
            for (ii, ibn) in impl_bind_names.enumerate():
                bind_names.push(ibn)
                bind_tids.push(impl_bind_tids.get(ii).unwrap())
            # Method-level generics (e.g. [F]) from the inferred `bound`.
            int mi = 0
            while mi < shape.generic_params.len() and mi < bound.len():
                int mtid = bound.get(mi).unwrap()
                if mtid >= 0 and mtid != types.error_id:
                    bind_names.push(shape.generic_params.get(mi).unwrap())
                    bind_tids.push(mtid)
                mi = mi + 1
            return resolve_with_bindings(shape.return_type, bind_names, bind_tids, scopes, &types)
    return -1
