# CELL: `.flat_map()` x plain-local recv x Option[Money]
# COMMITTED Round XIV (74f566c6+) — combinator-receiver ownership class-fix.
# PRE-FIX (RED-verified at HEAD 6171d564): SIGSEGV (exit 139). PROVES the
#   flat_map defect is NOT projection-gated: even a plain-local receiver
#   crashed. Contrast with map/filter/or_else where plain-local was a live
#   control (worked pre-fix); flat_map's failure axis was result_type, not
#   receiver-materialization. Edit C fixes it.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void main():
    Option[Money] o = make_opt(10)
    Option[int] r = o.flat_map((Money m): Some(size_of(m)))
    if r is Some(v):
        print(v)
