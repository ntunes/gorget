# Set and HashSet with string keys
from std.collections import Set, HashSet

void main():
    # ===== Set[String] =====

    # --- Construction ---
    Set[String] s = Set[String]()
    print(f"{s.len()}")
    print(f"{s.is_empty()}")

    # --- add ---
    s.add("apple")
    s.add("banana")
    s.add("cherry")
    print(f"{s.len()}")
    # duplicate
    s.add("banana")
    print(f"{s.len()}")

    # --- contains ---
    print(f"{s.contains('apple')}")
    print(f"{s.contains('mango')}")

    # --- remove ---
    bool rem1 = s.remove("banana")
    print(f"{rem1}")
    bool rem2 = s.remove("mango")
    print(f"{rem2}")
    print(f"{s.len()}")

    # --- clear ---
    Set[String] s2 = Set[String]()
    s2.add("x")
    s2.clear()
    print(f"{s2.len()}")
    print(f"{s2.is_empty()}")

    # --- Set algebra ---
    Set[String] a = Set[String]()
    a.add("alpha")
    a.add("beta")
    a.add("gamma")
    Set[String] b = Set[String]()
    b.add("beta")
    b.add("gamma")
    b.add("delta")

    # union
    Set[String] u = a.union(b)
    print(f"{u.len()}")

    # intersection
    Set[String] inter = a.intersection(b)
    print(f"{inter.len()}")

    # difference (asymmetric)
    Set[String] diff_ab = a.difference(b)
    print(f"{diff_ab.len()}")
    print(f"{diff_ab.contains('alpha')}")
    Set[String] diff_ba = b.difference(a)
    print(f"{diff_ba.len()}")
    print(f"{diff_ba.contains('delta')}")

    # symmetric_difference
    Set[String] sym = a.symmetric_difference(b)
    print(f"{sym.len()}")
    print(f"{sym.contains('alpha')}")
    print(f"{sym.contains('delta')}")
    print(f"{sym.contains('beta')}")

    # --- is_subset / is_superset ---
    Set[String] sub = Set[String]()
    sub.add("alpha")
    sub.add("beta")
    print(f"{sub.is_subset(a)}")
    print(f"{a.is_subset(sub)}")
    print(f"{a.is_subset(a)}")

    print(f"{a.is_superset(sub)}")
    print(f"{sub.is_superset(a)}")

    # --- Edge cases ---
    Set[String] empty = Set[String]()
    Set[String] u_empty = a.union(empty)
    print(f"{u_empty.len()}")
    Set[String] disjoint = Set[String]()
    disjoint.add("x")
    disjoint.add("y")
    Set[String] i_dis = a.intersection(disjoint)
    print(f"{i_dis.len()}")

    # --- filter ---
    # The `.contains()` read-back below is LOAD-BEARING, not decoration. The
    # Set-HOF filter arm used to mint its result set with a raw
    # `gorget_ordered_set_new` and a HARDCODED 8-byte key, which PRESERVES THE
    # LENGTH and destroys MEMBERSHIP: a `String` element landed in an 8-byte
    # slot and was compared as a pointer. A `.len()`-only assertion is
    # structurally blind to that, and this fixture was green through the whole
    # life of the defect. Do not remove the read-back.
    Set[String] long_names = a.filter((String x): x.len() > 4)
    print(f"{long_names.len()}")
    bool long_has_alpha = long_names.contains("alpha")
    print(f"{long_has_alpha}")

    # --- fold ---
    int total_len = a.fold(0, (int acc, String x): acc + x.len())
    print(f"{total_len}")

    # ===== HashSet[String] =====

    # --- Construction ---
    HashSet[String] hs = HashSet[String]()
    print(f"{hs.len()}")
    print(f"{hs.is_empty()}")

    # --- add ---
    hs.add("red")
    hs.add("green")
    hs.add("blue")
    print(f"{hs.len()}")
    # duplicate
    hs.add("green")
    print(f"{hs.len()}")

    # --- contains ---
    print(f"{hs.contains('red')}")
    print(f"{hs.contains('purple')}")

    # --- remove ---
    bool hrem1 = hs.remove("green")
    print(f"{hrem1}")
    bool hrem2 = hs.remove("purple")
    print(f"{hrem2}")
    print(f"{hs.len()}")

    # --- clear ---
    HashSet[String] hs2 = HashSet[String]()
    hs2.add("z")
    hs2.clear()
    print(f"{hs2.len()}")
    print(f"{hs2.is_empty()}")

    # --- Set algebra (order-independent checks) ---
    HashSet[String] ha = HashSet[String]()
    ha.add("one")
    ha.add("two")
    ha.add("three")
    HashSet[String] hb = HashSet[String]()
    hb.add("two")
    hb.add("three")
    hb.add("four")

    # union
    HashSet[String] hu = ha.union(hb)
    print(f"{hu.len()}")

    # intersection
    HashSet[String] hinter = ha.intersection(hb)
    print(f"{hinter.len()}")

    # difference
    HashSet[String] hdiff = ha.difference(hb)
    print(f"{hdiff.len()}")
    print(f"{hdiff.contains('one')}")

    # symmetric_difference
    HashSet[String] hsym = ha.symmetric_difference(hb)
    print(f"{hsym.len()}")
    print(f"{hsym.contains('one')}")
    print(f"{hsym.contains('four')}")
    print(f"{hsym.contains('two')}")

    # --- fold (order-independent: total length) ---
    int hs_total = ha.fold(0, (int acc, String x): acc + x.len())
    print(f"{hs_total}")

    # --- filter ---
    # Read a member back — see the ordered `filter` above for why a
    # `.len()`-only assertion cannot see this arm's defect. This is the
    # UNORDERED emission site, a second and independently-reachable one.
    HashSet[String] h_short = ha.filter((String x): x.len() <= 3)
    print(f"{h_short.len()}")
    bool short_has_one = h_short.contains("one")
    print(f"{short_has_one}")
