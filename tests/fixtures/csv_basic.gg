from gg.csv import csv_parse, csv_parse_delim, csv_parse_table, csv_stringify, csv_stringify_delim, csv_stringify_table, CsvTable
from std.collections import Vector

void main():
    # ── Simple 2-row CSV ──
    auto csv_r1 = csv_parse("a,b,c\n1,2,3\n")
    match csv_r1:
        case Ok(csv_rows):
            print(csv_rows.len())
            Vector[str] csv_row0 = csv_rows.get(0).unwrap()
            print(csv_row0.get(0).unwrap())
            print(csv_row0.get(1).unwrap())
            print(csv_row0.get(2).unwrap())
            Vector[str] csv_row1 = csv_rows.get(1).unwrap()
            print(csv_row1.get(0).unwrap())
            print(csv_row1.get(1).unwrap())
            print(csv_row1.get(2).unwrap())
        else:
            print("error")

    # ── Quoted fields with embedded commas ──
    auto csv_r2 = csv_parse("name,value\n\"a,b\",c\n")
    match csv_r2:
        case Ok(csv_rows):
            Vector[str] csv_qr = csv_rows.get(1).unwrap()
            print(csv_qr.get(0).unwrap())
            print(csv_qr.get(1).unwrap())
        else:
            print("error")

    # ── Quoted fields with escaped quotes ("") ──
    auto csv_r3 = csv_parse("x\n\"he said \"\"hi\"\"\"\n")
    match csv_r3:
        case Ok(csv_rows):
            Vector[str] csv_qr = csv_rows.get(1).unwrap()
            print(csv_qr.get(0).unwrap())
        else:
            print("error")

    # ── Quoted fields with embedded newlines ──
    auto csv_r4 = csv_parse("x\n\"line1\nline2\"\n")
    match csv_r4:
        case Ok(csv_rows):
            Vector[str] csv_qr = csv_rows.get(1).unwrap()
            print(csv_qr.get(0).unwrap())
        else:
            print("error")

    # ── Custom delimiter (tab) ──
    auto csv_r5 = csv_parse_delim("a\tb\tc\n1\t2\t3\n", "\t")
    match csv_r5:
        case Ok(csv_rows):
            print(csv_rows.len())
            Vector[str] csv_tr = csv_rows.get(0).unwrap()
            print(csv_tr.get(0).unwrap())
            print(csv_tr.get(2).unwrap())
        else:
            print("error")

    # ── Empty fields ──
    auto csv_r6 = csv_parse("a,,b\n")
    match csv_r6:
        case Ok(csv_rows):
            Vector[str] csv_er = csv_rows.get(0).unwrap()
            print(csv_er.len())
            print(csv_er.get(1).unwrap() == "")
        else:
            print("error")

    # ── CsvTable with headers ──
    auto csv_r7 = csv_parse_table("name,age,city\nAlice,30,NYC\nBob,25,LA\n")
    match csv_r7:
        case Ok(csv_tbl):
            print(csv_tbl.row_count())
            print(csv_tbl.col_count())
            print(csv_tbl.get(0, 0))
            print(csv_tbl.get_named(0, "age"))
            print(csv_tbl.get_named(1, "city"))
            print(csv_tbl.has_column("name"))
            print(csv_tbl.has_column("missing"))
            print(csv_tbl.column_index("city"))
            print(csv_tbl.column_index("missing"))
        else:
            print("error")

    # ── Stringify ──
    Vector[Vector[str]] csv_data = Vector[Vector[str]]()
    Vector[str] csv_sr1 = Vector[str]()
    csv_sr1.push("x")
    csv_sr1.push("y")
    csv_data.push(csv_sr1)
    Vector[str] csv_sr2 = Vector[str]()
    csv_sr2.push("1")
    csv_sr2.push("2")
    csv_data.push(csv_sr2)
    str csv_out = csv_stringify(csv_data)
    print(csv_out == "x,y\r\n1,2\r\n")

    # ── Stringify with quoting ──
    Vector[Vector[str]] csv_qdata = Vector[Vector[str]]()
    Vector[str] csv_qr1 = Vector[str]()
    csv_qr1.push("has,comma")
    csv_qr1.push("normal")
    csv_qdata.push(csv_qr1)
    str csv_qout = csv_stringify(csv_qdata)
    print(csv_qout == "\"has,comma\",normal\r\n")

    # ── Stringify table ──
    Vector[str] csv_hdr = Vector[str]()
    csv_hdr.push("a")
    csv_hdr.push("b")
    Vector[Vector[str]] csv_trows = Vector[Vector[str]]()
    Vector[str] csv_tr1 = Vector[str]()
    csv_tr1.push("1")
    csv_tr1.push("2")
    csv_trows.push(csv_tr1)
    CsvTable csv_table = CsvTable(csv_hdr, csv_trows)
    str csv_tout = csv_stringify_table(csv_table)
    print(csv_tout == "a,b\r\n1,2\r\n")

    # ── Empty input ──
    auto csv_r8 = csv_parse("")
    match csv_r8:
        case Ok(csv_rows):
            print(csv_rows.len())
        else:
            print("error")

    # ── Parse error: unterminated quote ──
    auto csv_r9 = csv_parse("\"unterminated\n")
    match csv_r9:
        case Error(csv_msg):
            print(csv_msg)
        else:
            print("unexpected")

    # ── CRLF line endings ──
    auto csv_r10 = csv_parse("a,b\r\n1,2\r\n")
    match csv_r10:
        case Ok(csv_rows):
            print(csv_rows.len())
            Vector[str] csv_cr = csv_rows.get(1).unwrap()
            print(csv_cr.get(0).unwrap())
        else:
            print("error")

    print("done")
