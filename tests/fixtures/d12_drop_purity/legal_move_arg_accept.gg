# D4/D12 over-rejection guard for the call-arg-sigil fix: an explicit `!` move
# at a CTOR arg (pos-2, `W(!a)`) and at a collection put (pos-3, `v.push(!b)`)
# transfers ownership — the source is dead, NOT a live-place implicit copy — so
# both must ACCEPT. Before the sigil fix, `parse_call_args` discarded the `!`
# and pos-2/pos-3 over-rejected these legal moves (the hole that regressed A2-S).
struct R:
    int id

equip R with Drop:
    void drop(!self):
        print(f"drop {self.id}")

struct W:
    R inner

void main():
    R a = R(1)
    W w = W(!a)
    print(w.inner.id)
    R b = R(2)
    Vector[R] v = Vector[R]()
    v.push(!b)
    print(v.len())
