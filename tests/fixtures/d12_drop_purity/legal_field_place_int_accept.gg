# D4/D12 over-rejection guard: binding a NON-tainted field place (`hh.count`,
# an `int`) must NOT be rejected — the structural place resolution only taints
# on the field's own type, not the enclosing struct being tainted. Guards
# against the reroute over-firing on trivially-copyable field reads.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

struct HH:
    R r
    int count

void main():
    HH hh = HH(R(1), 5)
    int n = hh.count
    print(n)
