# D4/D12 position 4 FIELD-place: returning a live drop-tainted FIELD place
# (`return h.r`) is an implicit copy at the return boundary —
# `E_MoveWithoutOperator`, caught by the structural `lvalue_value_type`
# resolution. No `!`-move counterpart (partial move); fix with `.clone()`.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

struct HH:
    R r

R get_r(HH h):
    return h.r

void main():
    HH hh = HH(R(1))
    get_r(hh)
