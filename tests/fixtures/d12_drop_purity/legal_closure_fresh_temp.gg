# D4/D12 legal counterpart (closure): a closure whose tail is a FRESH TEMP
# (`(): R(7)`) moves the freshly-materialized value — never a live-place copy
# — legal.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        print(f"drop {self.id}")

void use(R x):
    print(x.id)

void main():
    auto f = (): R(7)
    use(f())
