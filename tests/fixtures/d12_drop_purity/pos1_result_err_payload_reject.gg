# D4/D12 position 1 GENERIC payload (Result[int, R], Error arm): binding a live
# tainted generic-payload place is an implicit copy. Exercises the RTGeneric
# args-recursion on the SECOND type arg (Result[int, R] is tainted via R in
# the error slot). The `Error(R(1))` setup is a fresh temp → NOT rejected.
# Ported from ggdef d4_bind_result_payload_tainted_both_arms (Error arm).
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

void main():
    Result[int, R] a = Error(R(1))
    Result[int, R] b = a
    print("x")
