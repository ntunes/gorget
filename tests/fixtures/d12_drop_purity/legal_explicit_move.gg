# D4/D12 legal counterpart: an explicit `!` move at a bind is NOT a live-place
# implicit copy — it transfers ownership and the source is dead. Ported from
# ggdef d4_allows_fresh_temp_move_and_explicit_move.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        print(f"drop {self.id}")

void main():
    R a = R(1)
    R b = !a
    print(b.id)
