# D4/D12 position 3 (collection put): pushing a bare live drop-tainted place
# into an element-owning collection copies at the ownership boundary —
# `E_MoveWithoutOperator`. Ported from ggdef d4_position_3_collection_put.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

void main():
    R a = R(1)
    Vector[R] v = Vector[R]()
    v.push(a)
    print(v.len())
