# D4/D12 position 5 (closure capture): capturing a live drop-tainted local in
# a closure is an implicit copy — `E_MoveWithoutOperator`. No capture-list
# syntax exists yet (D5/D7), so the fix is to pass the value as an argument or
# clone it into a dedicated local. Ported from ggdef d4_position_5_capture.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

void use(R x):
    print(x.id)

void main():
    R a = R(1)
    auto f = (): use(a)
    f()
