# D4/D12 position 4 (expression-body tail): an expression-body function whose
# tail IS a bare drop-tainted place returns a copy at the return boundary —
# `E_MoveWithoutOperator`. Mirrors ggdef's expr-body tail
# (spec/ggdef/src/elaborate/mod.rs). The `passthru(a)` call arg is a plain
# borrow (no operator needed there); only the tail `x` is rejected.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

R passthru(R x): x

void main():
    R a = R(1)
    passthru(a)
