# D4/D12 position 2 (ctor / field-init): a bare drop-tainted place used as a
# constructor argument copies at the init ownership boundary —
# `E_MoveWithoutOperator`. Ported from ggdef d4_position_2_ctor_init.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

struct W:
    R inner

void main():
    R a = R(1)
    W w = W(a)
    print(w.inner.id)
