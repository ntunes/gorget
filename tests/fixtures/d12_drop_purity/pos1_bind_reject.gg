# D4/D12 position 1 (bind): a bare bind of a LIVE drop-tainted place is an
# implicit copy — `E_MoveWithoutOperator`. Ported from ggdef d4_position_1_bind
# (spec/ggdef/src/tests.rs). Fix: write `R b = !a` or `R b = a.clone()`.
struct R:
    int id

equip R with Drop:
    void drop(!self):
        pass

void main():
    R a = R(1)
    R b = a
    print(b.id)
