# CELL: `.and_then()` + `.flat_map()` × plain-local recv × Option[Money]
# GRADUATED Round XIV (74f566c6) — combinator-receiver ownership class-fix
# (Edit C: result_type = infer_closure_return_type for and_then/flat_map).
# PRE-FIX (RED-verified at HEAD 6171d564):
#   `gg check`  -> "OK: no semantic errors"          (accepts)
#   C backend   -> builds, binary exits **139 (SIGSEGV)**
#   LLVM backend-> **fails to compile**:
#                  llc: '%v28' defined with type 'i64' but expected 'ptr'
#                       %v60 = phi ptr [ %v28, %bb1 ], [ %v30, %bb2 ]
# The phi was the whole story: pre-fix, the result_type fell through to
# `_ => recv_type` = Option[Money], but the closure produced Option[int]. LLVM
# verifier caught the i64-vs-ptr phi; C backend silently memcpy'd Option[int]
# (16B) into Option[Money] (16B same-layout), then downstream read `.data` as
# a Vector[int] handle -> dereffed the int as a pointer -> SIGSEGV. Core #13:
# LLVM was the sharper instrument here.
# RESOURCE-PAYLOAD-SPECIFIC — the identical program with an `int` payload
# printed 42 and exited 0, so a trivial-payload fixture would be a false
# negative. `Money` wraps a BUILT (heap-forced) `Vector[int]`, not a literal.
# `gg run` propagates 128+signo as exit 128+N since Round XXIV Track B; a
# pre-fix SIGSEGV here surfaces as exit 139 with a stderr diagnostic.
# INTENDED (asserted): both legs print their element count, `11` then `12`.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void main():
    Option[Money] a = make_opt(11)
    Option[int] ra = a.and_then((Money m): Some(size_of(m)))
    if ra is Some(v):
        print(v)

    Option[Money] b = make_opt(12)
    Option[int] rb = b.flat_map((Money m): Some(size_of(m)))
    if rb is Some(v):
        print(v)
