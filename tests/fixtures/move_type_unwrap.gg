void main():
    Vector[Vector[int]] grid = Vector[Vector[int]]()
    Vector[int] row1 = Vector[int]()
    row1.push(1)
    row1.push(2)
    grid.push(row1)
    Vector[int] row2 = Vector[int]()
    row2.push(3)
    row2.push(4)
    grid.push(row2)
    auto first = grid.get(0).unwrap()
    print(first.get(0).unwrap())
    print(first.get(1).unwrap())
    print(grid.len())
