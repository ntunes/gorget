from std.alloc import TrackingAllocator, Arena
from std.collections import Vector

void main():
    with TrackingAllocator() as tracker:
        with Arena(8192) as pool:
            Vector[int] v = Vector[int]()
            v.push(1)
            v.push(2)
            v.push(3)
            print(f"len: {v.len()}")
        print(f"alloc_count > 0: {tracker.alloc_count() > 0}")
        print(f"bytes > 0: {tracker.bytes_allocated() > 0}")
    print("done")
