from std.process import exec
from std.os import getenv

void main():
    auto code = exec("echo hello > /dev/null")
    print(f"{code}")
    str path = getenv("PATH")
    if path.len() > 0:
        print("has_path")
    else:
        print("no_path")
    auto code2 = exec("exit 42")
    print(f"{code2}")
