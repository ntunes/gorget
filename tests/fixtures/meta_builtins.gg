meta int BITS = arch_word_bits()
meta bool IS_64BIT = arch_word_bits() == 64
meta bool HAS_THING = feature("thing")
meta bool IS_DEBUG = debug()

meta if feature("enabled"):
    meta str MSG = "feature enabled"
else:
    meta str MSG = "feature disabled"

void main():
    print(BITS)
    print(IS_64BIT)
    print(HAS_THING)
    print(IS_DEBUG)
    print(MSG)
