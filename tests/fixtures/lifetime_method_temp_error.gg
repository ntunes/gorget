# Lifetime error: str view from method returning owned String, source moved
# (After str/String unification, str takes ownership of method return value;
#  the original TemporaryBorrow error is subsumed by ownership transfer.
#  This test now verifies use-after-move on a view derived from the owned result.)
struct Builder:
    String data

equip Builder:
    String build(self):
        return "result" + ""

void consume(String !s):
    pass

void main():
    Builder b = Builder("hello" + "")
    String temporary = b.build()
    str v = temporary.as_str()
    consume(!temporary)
    print(v)
