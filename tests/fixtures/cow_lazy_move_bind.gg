# EMove class-table row, move-BIND shape (#37 Phase 2): `!v` at a decl-init
# position. The EMove class lowers at many positions with no choke point, so
# laziness is ELIGIBILITY-EXCLUDED for its source (cow_moved_names): the
# `s` bind falls back to the eager clone and prints the PRE-mutation value.
#
# Both compilers agree on the eager semantics (the Rust Expr::Move
# read-through bug was fixed by Chain C item 1); snapshotted.
void main():
    Vector[String] v = ["hello", "world"]
    String s = v.get(0).unwrap()
    Vector[String] w = !v
    w.set(0, "mutated")
    print(f"s = {s}")
    print(f"w0 = {w.get(0).unwrap()}")
