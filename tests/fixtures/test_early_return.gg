# Early return patterns: guard clauses, returns from loops, nested ifs, Option

# 1. Early return from if condition
int abs_val(int x):
    if x < 0:
        return -x
    return x

# 2. Early return from for loop (find first even)
int first_even(Vector[int] v):
    for x in v:
        if x % 2 == 0:
            return x
    return -1

# 3. Early return from while loop
int count_until_five(Vector[int] v):
    int i = 0
    while i < v.len():
        if v[i] == 5:
            return i
        i += 1
    return -1

# 4. Multiple return paths
str classify(int n):
    if n < 0:
        return "negative"
    if n == 0:
        return "zero"
    if n < 10:
        return "small"
    if n < 100:
        return "medium"
    return "large"

# 5. Return in nested if/else
str nested_check(int x, int y):
    if x > 0:
        if y > 0:
            return "both positive"
        else:
            return "x positive, y not"
    else:
        if y > 0:
            return "y positive, x not"
        else:
            return "both non-positive"

# 6. Return None from Option-returning function
Option[int] find_index(Vector[int] v, int target):
    int i = 0
    for x in v:
        if x == target:
            return Some(i)
        i += 1
    return None()

# 7. Guard clause pattern
String greet(str name):
    if name == "":
        return "Hello, stranger!"
    return f"Hello, {name}!"

# 8. Function with single return at end (baseline)
int add_triple(int a, int b, int c):
    int sum = a + b + c
    return sum

# 9. Void function with early return
void print_positive(int x):
    if x <= 0:
        return
    print(f"positive: {x}")

void main():
    # 1. Early return from if
    print(abs_val(-7))
    print(abs_val(3))
    print(abs_val(0))

    # 2. Early return from for loop
    Vector[int] nums = Vector[int]()
    nums.push(1)
    nums.push(3)
    nums.push(4)
    nums.push(6)
    print(first_even(nums))
    Vector[int] odds = Vector[int]()
    odds.push(1)
    odds.push(3)
    odds.push(5)
    print(first_even(odds))

    # 3. Early return from while loop
    Vector[int] vals = Vector[int]()
    vals.push(1)
    vals.push(2)
    vals.push(5)
    vals.push(8)
    print(count_until_five(vals))
    Vector[int] no5 = Vector[int]()
    no5.push(1)
    no5.push(2)
    no5.push(3)
    print(count_until_five(no5))

    # 4. Multiple return paths
    print(classify(-5))
    print(classify(0))
    print(classify(7))
    print(classify(42))
    print(classify(999))

    # 5. Nested if/else returns
    print(nested_check(1, 1))
    print(nested_check(1, -1))
    print(nested_check(-1, 1))
    print(nested_check(-1, -1))

    # 6. Option return
    Vector[int] haystack = Vector[int]()
    haystack.push(10)
    haystack.push(20)
    haystack.push(30)
    Option[int] found = find_index(haystack, 20)
    Option[int] missing = find_index(haystack, 99)
    print(found.unwrap())
    print(missing.is_none())

    # 7. Guard clause
    print(greet(""))
    print(greet("Alice"))

    # 8. Baseline single return
    print(add_triple(1, 2, 3))

    # 9. Void early return
    print_positive(-5)
    print_positive(0)
    print_positive(42)
