# Phase 3 proof-of-concept: lazy `Dict[K, V]` iteration using a `Ref[Dict[K, V]]`
# borrow field. Demonstrates that Phase 1.7's IR groundwork + Phase 2's borrow
# checker compose with the runtime accessors to give us user-space lazy
# iterators that walk the hash-map in place — no `.items()` materialisation,
# no allocation beyond the iterator struct itself.
#
# The runtime accessors `gorget_map_iter_*` are declared as generic externs.
# Per commit `ca9b455f`, generic mono preserves the declared C symbol so a
# single runtime function serves all `Dict[K, V]` instantiations. The
# accessors clone via the map's `key_clone`/`val_clone` hooks so resource-
# typed K/V (String, Vector, …) come out as independent owned copies.

extern "Gorget":
    extern int dict_iter_order_len[K, V](Ref[Dict[K, V]] m) = "gorget_map_iter_order_len"
    extern int dict_iter_order[K, V](Ref[Dict[K, V]] m, int idx) = "gorget_map_iter_order"
    extern void dict_iter_key[K, V](Ref[Dict[K, V]] m, int idx, K &out) = "gorget_map_iter_key"
    extern void dict_iter_value[K, V](Ref[Dict[K, V]] m, int idx, V &out) = "gorget_map_iter_value"

struct DictIterKV[K, V]:
    Ref[Dict[K, V]] source
    int cursor

equip [K, V] DictIterKV[K, V]:
    Option[(K, V)] next(&self):
        int n = dict_iter_order_len[K, V](self.source)
        if self.cursor >= n:
            return None
        int phys = dict_iter_order[K, V](self.source, self.cursor)
        K k = K.default()
        V v = V.default()
        dict_iter_key[K, V](self.source, phys, &k)
        dict_iter_value[K, V](self.source, phys, &v)
        self.cursor = self.cursor + 1
        return Some((k, v))

void main():
    Dict[int, int] d = {}
    d.put(10, 100)
    d.put(20, 200)
    d.put(30, 300)
    auto walker = DictIterKV[int, int](d, 0)
    int sum_k = 0
    int sum_v = 0
    auto step = walker.next()
    while step.is_some():
        auto pair = step.unwrap()
        sum_k = sum_k + pair.0
        sum_v = sum_v + pair.1
        step = walker.next()
    print(sum_k)
    print(sum_v)

    # String keys / int values — exercises the key_clone hook so we don't
    # double-free the buffer the map still owns.
    Dict[String, int] s = {}
    s.put("alpha", 1)
    s.put("beta", 2)
    int slen = dict_iter_order_len[String, int](s)
    int j = 0
    int sum_v2 = 0
    while j < slen:
        int phys = dict_iter_order[String, int](s, j)
        String k = ""
        int v = 0
        dict_iter_key[String, int](s, phys, &k)
        dict_iter_value[String, int](s, phys, &v)
        print(k)
        sum_v2 = sum_v2 + v
        j = j + 1
    print(sum_v2)
