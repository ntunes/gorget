#!parity-excluded scheduling: TaskGroup fan-out over an atomic; stdout aggregates a nondeterministic interleaving
# Stress: spawn 200 tasks in parallel, each adds its index to an atomic counter.
# Tests executor queue scaling, concurrent submit pressure, waker storms.
# Expected: sum of 0..199 = 19900

async void add_to(AtomicInt acc, int value):
    acc.add(value)

async void main():
    shared(atomic) int total = 0
    TaskGroup group = TaskGroup()
    int i = 0
    while i < 200:
        group.spawn(spawn add_to(total, i))
        i += 1
    group.join()
    print(total)
