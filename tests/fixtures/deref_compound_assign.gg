# Compound-assign THROUGH a pointer: `*p OP= v` (Box / &-ref). Plain `*p = v`
# already lowered (lower_assign's Expr::Deref arm, Snag #26); the compound path
# had NO arm and NO catch-all, so `*b += 5` silently DROPPED the write on both
# backends (measured pre-fix: `10, 10, 99`). lower_compound_assign now has a
# Deref arm that reads the pointee THROUGH the deref place, applies the op, and
# stores back (lower-or-reject, Core #10). Same output on both C and LLVM.
#
# Self-host lane: `SCompoundAssign` has a matching EDeref arm (Face-C) that
# RMW-s through the Box place (base once, LoBorrowed read, emit_compound_arith,
# GIDerefStore). Covers owned Box locals AND `&Box` params (SH MutPtr(Box) ABI
# holds Box heap-pointer bits; type_id_to_name peels MutPtr for the Box name).
# Top-level so it enters the SH runtime-diff corpus (Core #9 close proven).

void bump(Box[int] &b, int by):
    *b += by

void main():
    Box[int] b = Box(10)
    print(*b)        # 10
    *b += 5
    print(*b)        # 15
    *b *= 2
    print(*b)        # 30
    bump(&b, 4)      # *b += 4 through a &-borrowed Box
    print(*b)        # 34
    *b = 99          # plain-= through deref (control, unchanged behavior)
    print(*b)        # 99
    print("done")
