# SH-CoW Face-A: Dict `.get(k).unwrap().field` plain assign AND compound.
# Both arms route through the get-chain place producer with allow_map=true
# → gorget_map_get write-through (same class as `d[k].field`).

struct Blk:
    int term

void main():
    Dict[String, Blk] m = {}
    m.set("a", Blk(10))
    m.set("b", Blk(100))
    # Plain field store through get-chain
    m.get("a").unwrap().term = 99
    print(m.get("a").unwrap().term)   # 99
    # Compound field store through the same place producer
    m.get("b").unwrap().term += 5
    print(m.get("b").unwrap().term)   # 105
    # Index sibling still write-throughs (control)
    m["a"].term += 1
    print(m.get("a").unwrap().term)   # 100
    print("done")
