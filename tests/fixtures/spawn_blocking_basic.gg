from std.fs import read_file, write_file

# A regular (non-async) function that does blocking I/O.
String blocking_read(String path):
    return read_file(path)

async void main():
    write_file("/tmp/gorget_spawn_blocking.txt", "spawn_blocking works")

    # spawn blocking runs the function on the blocking thread pool
    Task[String] t = spawn blocking blocking_read("/tmp/gorget_spawn_blocking.txt")
    String result = t.await()
    print(result)
