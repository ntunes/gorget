# gorget-js snag #15c widening — the single-statement sibling of the
# multi-statement class Track G closed.
#
# Post-Track-G, `catch (e):` / `rethrow (e):` bodies whose parser-synthesized
# `Expr::Do` wrap contains a SINGLE terminal-expression stmt (Stmt::Expr /
# Return / Throw) still round-trip through `format_expr(Expr::Do)` at
# `src/formatter/mod.rs:2226`, which unconditionally emits `do:` — so
# `catch (e):\n    fallback(x)` reformats to `catch (e): do:\n    fallback(x)`.
# Same class as snag #15b (move-tail `E_MoveInOperandPosition` regression
# for Throw/Return in these positions after the D27 emit swap): the parser
# accepts either shape at the arm site directly, so re-emitting `do:` is
# both cosmetic rot and a latent breaking-change class.
#
# RETIRED R39 (2026-08-09) by mirroring the Stmt::Throw/Return/Expr carve-out
# from `Expr::Block` (mod.rs:2074-2105) into `Expr::Do` (mod.rs:2112). Both
# AST wrappers now inline single-terminal-expression bodies to the bare form,
# matching what the parser already accepts.
#
# Wired: `fmt_catch_rethrow_single_stmt_no_do_wrap` in `tests/integration.rs`
# asserts (a) no `catch/rethrow ...: do:` appears on any code line (comments
# excluded), (b) the formatted source re-parses, and (c) `gg run` produces
# the same output as the pre-format source ("10\nrecovering\n-1\n200\n").
struct Err:
    String msg

int compute(int x) throws String:
    if x < 0:
        throw "negative"
    return x * 2

int fallback(int x):
    print("recovering")
    return x

int safe(int x):
    return compute(x)! catch (e):
        fallback(x)

int caller_rethrow(int x) throws Err:
    int v = compute(x)! rethrow (String e):
        Err(f"transformed: {e}").msg.len() + 100
    return v + 100

int main():
    print(safe(5))
    print(safe(-1))
    v_or_throw()
    return 0

void v_or_throw():
    int v = caller_rethrow(50)! catch (e):
        e.msg.len()
    print(v)
