# R39 snag #2 — Wide fixture exercising trailing comments across every
# emit_trailing_comment_after / _header sibling-loop class.
#
# Each `# NNN kind` sentinel is a load-bearing marker: the paired
# integration test asserts the exact substring appears on the SAME
# formatted-output line as its owning statement (regex match on
# formatted.lines()). If a per-class regression re-detaches a comment,
# the sentinel migrates to the following line and the test fails.
#
# Why NOT just `fmt_idempotent`: the pre-fix formatter is IDEMPOTENT on
# the WRONG shape (leading-of-next), so an idempotence check accepts it.
# Correctness comes from per-line sentinel assertions here.

struct S:  # 5b container-header
    int a  # 733 struct-field-mid
    int b  # 733 struct-field-last

enum E:  # 5b container-header
    Case  # 774 enum-variant-mid
    Other  # 774 enum-variant-last

trait T:  # 5b container-header
    void m()  # 832 trait-item

equip S with T:  # 5b container-header
    void m():
        print("m")  # 1270 function-body-stmt (via format_block_stmts)

int f(int x):
    int y = x  # 1270 function-body-stmt-mid
    return y  # 1270 function-body-stmt-last (Return trailing)

int g(int x):
    if x > 0:
        return 1  # 1270 if-body (format_block_stmts covers all if/elif/else)
    else:
        return 0  # 1270 else-body

void apply(int x):
    match x:
        case 1:
            print(1)  # 1270 match-arm body (format_block_stmts via format_match_arm)
        else:
            print(0)  # 1270 match-arm else-body

int main():
    print(f(5))
    print(g(10))
    apply(1)
    return 0
