# GIR (Gorget Intermediate Representation) data structures.
# Mirrors the Rust types in src/ir/ for self-hosted IR lowering.

from std.collections import Vector
from std.conv import int_to_str

# ── Pre-allocated primitive type IDs ───────────────────────

const int BOOL_TYPE = 0
const int I8_TYPE = 1
const int I16_TYPE = 2
const int I32_TYPE = 3
const int I64_TYPE = 4
const int U8_TYPE = 5
const int U16_TYPE = 6
const int U32_TYPE = 7
const int U64_TYPE = 8
const int F32_TYPE = 9
const int F64_TYPE = 10
const int UNIT_TYPE = 11
const int PRIM_COUNT = 12

# ── GIR type representation ───────────────────────────────

enum GirType:
    GtBool()
    GtI8()
    GtI16()
    GtI32()
    GtI64()
    GtU8()
    GtU16()
    GtU32()
    GtU64()
    GtF32()
    GtF64()
    GtUnit()
    GtPtr(int)
    GtMutPtr(int)
    GtNamed(String)
    GtFnPtr(Vector[int], int)

# ── Operand — right-hand side value ───────────────────────

enum Operand:
    OpCopy(int)
    OpMove(int)
    OpConstBool(bool)
    OpConstI32(int)
    OpConstI64(int)
    OpConstF64(float)
    OpConstStr(String)
    OpConstUnit()
    OpConstNull()
    OpSizeOf(int)

# ── Binary / comparison operator tags ─────────────────────

const int OP_ADD = 0
const int OP_SUB = 1
const int OP_MUL = 2
const int OP_DIV = 3
const int OP_REM = 4
const int OP_MOD = 5

const int CMP_EQ = 0
const int CMP_NE = 1
const int CMP_LT = 2
const int CMP_LE = 3
const int CMP_GT = 4
const int CMP_GE = 5

# ── Instructions ──────────────────────────────────────────

const int UNOP_NEG = 0
const int UNOP_NOT = 1
const int UNOP_BITNOT = 2

enum Instruction:
    GIAssign(int, Operand)
    GIBinOp(int, int, int, Operand, Operand)
    GIUnOp(int, int, int, Operand)
    GICmp(int, int, int, Operand, Operand)
    GICall(int, String, Vector[Operand])
    GICallExtern(int, String, Vector[Operand])
    GIDrop(int)
    GIDropIfAlive(int)
    GIMoveZero(int)
    GIDeref(int, int, int)    # dst_local, src_local (ptr/Box), inner_ty_id
    GINop()

# ── Terminators ───────────────────────────────────────────

enum Terminator:
    GTNone()
    GTReturn(Operand)
    GTJump(int)
    GTBranch(Operand, int, int)

# ── Basic block ───────────────────────────────────────────

struct BasicBlock:
    Vector[Instruction] insts
    Terminator term

# ── Local variable slot ──────────────────────────────────

struct GirLocal:
    int type_id
    Option[String] name_hint

# ── Function ─────────────────────────────────────────────

struct GirFunction:
    String name
    Vector[int] param_types
    int return_type
    Vector[GirLocal] locals
    Vector[BasicBlock] blocks

# ── Extern declaration ───────────────────────────────────

struct GirExtern:
    String name
    bool is_variadic
    int return_type

# ── Module ───────────────────────────────────────────────

# Struct/enum field info for drop/clone analysis in LIR lowering.
struct GirFieldInfo:
    String name
    String type_name  # resolved type name (e.g., "GorgetString", "Vector__int64_t")

struct GirEnumVariantInfo:
    String name
    Vector[GirFieldInfo] fields

struct GirTypeInfo:
    String name
    Vector[GirFieldInfo] fields          # struct fields
    Vector[GirEnumVariantInfo] variants  # enum variants (empty for structs)
    bool is_enum

struct GirModule:
    Vector[GirFunction] functions
    Vector[GirExtern] externs
    Vector[GirType] type_table
    Dict[String, int] fn_sigs
    # named_types was Dict[String, int]; same Dict[String, _] state-loss bug
    # as the others — `gmod.named_types.put("Lexer", 100)` then
    # `gmod.named_types.get("Lexer")` returns a tid pointing to GtNamed("")
    # at stage-1 runtime (12k+ such corruptions on driver.gg). Parallel
    # Vectors are the unified workaround. See feedback_selfhost_workarounds.md.
    Vector[String] named_keys
    Vector[int] named_vals
    Dict[String, bool] resource_types
    Dict[String, int] type_subs
    Dict[String, String] meta_aliases
    Dict[String, String] call_redirects
    Dict[String, bool] imported_fns
    Dict[String, GirTypeInfo] type_infos  # struct/enum field info for LIR drop analysis
    Dict[String, Vector[bool]] fn_borrow_params  # per-param: true if borrow (&)
    # const_decls: Dict[String, int] normally, but self-host-compiled
    # Dict[String, _] loses its hash_fn in some call paths, so lookups of
    # LT_STRUCT_BASE/I64_TYPE/NO_NAME module-level constants silently
    # miss. Swapped to parallel Vectors. Same reason as LowerCtx.nl_keys
    # — see feedback_selfhost_workarounds.md #9.
    Vector[String] const_keys
    Vector[int] const_vals
    # none_decls was Dict[String, bool]; same workaround.
    Vector[String] none_keys
    # Parallel cache over type_infos: names of registered enum types, and
    # for each enum a Vector of its variant names. Same Dict[String, _]
    # workaround — needed so match_enum_type / match_variant_index can
    # succeed when type_infos.contains() silently misses.
    Vector[String] enum_names
    Vector[Vector[String]] enum_variants
    # Parallel storage for type_infos — same Dict[String, _] state-loss
    # workaround. Populated alongside type_infos.put at construction time;
    # readers prefer the parallel vectors (linear scan; tens of types so
    # cost is negligible). Without this, struct field lookups in stage-1
    # silently miss and EFieldAccess emits "I64(0) placeholder" → all
    # downstream method dispatch on the wrongly-typed receiver fails.
    Vector[String] type_info_keys
    Vector[GirTypeInfo] type_info_vals

# ── Helpers ──────────────────────────────────────────────

# const_decls accessors (see GirModule.const_keys for why these aren't
# Dict operations).
bool const_contains(GirModule &gmod, String name):
    bool found = false
    int i = 0
    while i < gmod.const_keys.len():
        String k = gmod.const_keys.get(i).unwrap()
        if k == name:
            found = true
        i += 1
    return found

int const_lookup(GirModule &gmod, String name):
    int result = 0
    int i = 0
    while i < gmod.const_keys.len():
        String k = gmod.const_keys.get(i).unwrap()
        if k == name:
            result = gmod.const_vals.get(i).unwrap()
        i += 1
    return result

void const_put(GirModule &gmod, String name, int val):
    bool found = false
    int i = 0
    while i < gmod.const_keys.len():
        String k = gmod.const_keys.get(i).unwrap()
        if k == name:
            gmod.const_vals.set(i, val)
            found = true
        i += 1
    if not found:
        gmod.const_keys.push(name.clone())
        gmod.const_vals.push(val)

# none_decls accessors.
bool none_contains(GirModule &gmod, String name):
    bool found = false
    int i = 0
    while i < gmod.none_keys.len():
        String k = gmod.none_keys.get(i).unwrap()
        if k == name:
            found = true
        i += 1
    return found

void none_mark(GirModule &gmod, String name):
    if not none_contains(&gmod, name):
        gmod.none_keys.push(name.clone())

# enum registry accessors. Used when match_enum_type can't trust
# gmod.type_infos.contains() due to the Dict[String, _] bug.
bool enum_registered(GirModule &gmod, String enum_name):
    bool found = false
    int i = 0
    while i < gmod.enum_names.len():
        String k = gmod.enum_names.get(i).unwrap()
        if k == enum_name:
            found = true
        i += 1
    return found

void register_enum(GirModule &gmod, String enum_name, Vector[String] variants):
    if not enum_registered(&gmod, enum_name):
        gmod.enum_names.push(enum_name.clone())
        gmod.enum_variants.push(variants)

# Scan registered enums to find one that declares a given variant.
# Mirrors Rust's `resolve_enum_variant` fallback used by the pattern
# lowerer when the scrutinee's type can't be resolved. Returns empty
# string if no enum has this variant (or if multiple do — we pick the
# first to stay deterministic).
String find_enum_by_variant(GirModule &gmod, String variant_name):
    String result = ""
    int i = 0
    while i < gmod.enum_names.len():
        Vector[String] vs = gmod.enum_variants.get(i).unwrap()
        int j = 0
        while j < vs.len():
            String vn = vs.get(j).unwrap()
            if vn == variant_name and result == "":
                result = gmod.enum_names.get(i).unwrap().clone()
            j += 1
        i += 1
    return result

# Look up the variant index (ordinal) for a given enum + variant.
int enum_variant_index(GirModule &gmod, String enum_name, String variant_name):
    int result = -1
    int i = 0
    while i < gmod.enum_names.len():
        String k = gmod.enum_names.get(i).unwrap()
        if k == enum_name:
            Vector[String] vs = gmod.enum_variants.get(i).unwrap()
            int j = 0
            while j < vs.len():
                String vn = vs.get(j).unwrap()
                if vn == variant_name and result == -1:
                    result = j
                j += 1
        i += 1
    return result

# Parallel-Vector accessors for type_infos — Dict[String, _] state-loss
# workaround. Linear scan; tens of types per module so cost negligible.
bool type_info_contains(GirModule &gmod, String name):
    int i = 0
    while i < gmod.type_info_keys.len():
        String k = gmod.type_info_keys.get(i).unwrap()
        if k == name:
            return true
        i += 1
    return false

int type_info_index(GirModule &gmod, String name):
    int i = 0
    while i < gmod.type_info_keys.len():
        String k = gmod.type_info_keys.get(i).unwrap()
        if k == name:
            return i
        i += 1
    return -1

void type_info_register(GirModule &gmod, String name, GirTypeInfo info):
    int idx = type_info_index(&gmod, name)
    if idx < 0:
        gmod.type_info_keys.push(name.clone())
        gmod.type_info_vals.push(info)
    else:
        gmod.type_info_vals.set(idx, info)

Vector[GirType] init_type_table():
    Vector[GirType] t = []
    t.push(GtBool())
    t.push(GtI8())
    t.push(GtI16())
    t.push(GtI32())
    t.push(GtI64())
    t.push(GtU8())
    t.push(GtU16())
    t.push(GtU32())
    t.push(GtU64())
    t.push(GtF32())
    t.push(GtF64())
    t.push(GtUnit())
    return t

int register_type(GirModule &gmod, GirType gt):
    int id = gmod.type_table.len()
    gmod.type_table.push(gt)
    return id

int lookup_or_register_named(GirModule &gmod, String name):
    # Linear-scan parallel Vectors instead of Dict — the Dict[String, _]
    # state-loss bug (#9 in feedback_selfhost_workarounds.md) returns wrong
    # tids for valid keys at stage-1 runtime, leading to GtNamed("") leakage
    # and 1700+ "base type ''" cascades in stage-2.
    int i = 0
    while i < gmod.named_keys.len():
        String k = gmod.named_keys.get(i).unwrap()
        if k == name:
            return gmod.named_vals.get(i).unwrap()
        i += 1
    int id = register_type(&gmod, GtNamed(name.clone()))
    gmod.named_keys.push(name)
    gmod.named_vals.push(id)
    return id

int register_ptr(GirModule &gmod, int inner):
    return register_type(&gmod, GtPtr(inner))
