# GIR (Gorget Intermediate Representation) data structures.
# Mirrors the Rust types in src/ir/ for self-hosted IR lowering.

from std.collections import Vector, Dict
from std.conv import int_to_str
from ast import Stmt, SpannedExpr, FunctionDef
from types import TypeTable
from scope import ScopeTable
from compiler.data.schema import ResourceMetadata
from compiler.data.schema import CopySemantics, CsTrivial, CsResource, CsRefCounted
from compiler.data.schema import CollectionKind, CkNotCollection, CkVector, CkDeque, CkHeap, CkDict, CkOrderedSet, CkHashSet
from compiler.data.schema import BoxKind, BkNotBox, BkRegularBox, BkTraitBox

# ── Pre-allocated primitive type IDs ───────────────────────

const int BOOL_TYPE = 0
const int I8_TYPE = 1
const int I16_TYPE = 2
const int I32_TYPE = 3
const int I64_TYPE = 4
const int U8_TYPE = 5
const int U16_TYPE = 6
const int U32_TYPE = 7
const int U64_TYPE = 8
const int F32_TYPE = 9
const int F64_TYPE = 10
const int UNIT_TYPE = 11
const int PRIM_COUNT = 12

# Enum-category discriminator for the typed `enum_category` channel on
# GirModule (see `EnumCategory` / `record_enum_category`). A monomorphized
# prelude `Option__<Inner>` / `Result__<Ok>__<Err>` enum is NOT in
# `type_infos` (it has no user `m.items` def), so its payload-field types
# can't be read off a TypeDef the way Rust does. Rather than RE-PARSE the
# mangled name at every reader (the genuinely AMBIGUOUS L→R `__`-boundary
# "smart split" — `Result__Option__int64_t__GorgetString` has two valid
# splits), the MINT site (which holds the typed payload tids already)
# records them here, and every reader looks them up by the enum's GIR type
# id. Single source of truth, one accessor — Layering rule 3; no name
# matching — CLAUDE.md "No name matching".
const int ENUM_CAT_OPTION = 0
const int ENUM_CAT_RESULT = 1

# ── GIR type representation ───────────────────────────────

enum GirType:
    GtBool()
    GtI8()
    GtI16()
    GtI32()
    GtI64()
    GtU8()
    GtU16()
    GtU32()
    GtU64()
    GtF32()
    GtF64()
    GtUnit()
    GtPtr(int)
    GtMutPtr(int)
    GtNamed(String)
    GtFnPtr(Vector[int], int)

# ── Operand — right-hand side value ───────────────────────

enum Operand:
    OpCopy(int)
    OpMove(int)
    # Phase D: explicit clone — source survives the read with refcount
    # bump (or deep copy for non-refcounted resource types). Mirrors
    # Rust's `AssignMode::Clone` in `src/ir/types.rs`.
    OpClone(int)
    # Phase D: explicit borrow — produces a non-owning alias into the
    # source local. The source must outlive every use of the borrow.
    # Mirrors Rust's `AssignMode::Borrow`.
    OpBorrow(int)
    OpConstBool(bool)
    OpConstI32(int)
    OpConstI64(int)
    OpConstF64(float)
    OpConstStr(String)
    OpConstUnit()
    OpConstNull()
    OpSizeOf(int)

# ── Binary / comparison operator tags ─────────────────────

const int OP_ADD = 0
const int OP_SUB = 1
const int OP_MUL = 2
const int OP_DIV = 3
const int OP_REM = 4
const int OP_MOD = 5
# Wrapping arithmetic — `+%` / `-%` / `*%` in source. Lower to LIR
# with `OVF_WRAP` so the C codegen emits plain `+` / `-` / `*` rather
# than the trapping `__builtin_*_overflow` form.
const int OP_ADD_WRAP = 6
const int OP_SUB_WRAP = 7
const int OP_MUL_WRAP = 8

# Bitwise — `&` / `|` / `^` / `<<` / `>>`. Lower to the matching
# `IBitAnd` / `IBitOr` / `IBitXor` / `IShl` / `IShr` LIR inst.
const int OP_BITAND = 9
const int OP_BITOR = 10
const int OP_BITXOR = 11
const int OP_SHL = 12
const int OP_SHR = 13
# Fault-check op (error-model.md §11 Increment 2 (C)): tests the signed
# `INT_MIN / -1` division-overflow condition for a GIFaultCheck routed to a
# `Fault.Overflow` handler. NOT a binop committed by GIBinOp — only ever the
# discriminator operand of a `GIFaultCheck(flag, OP_DIV_OVERFLOW, ty, lhs, rhs)`
# (mirrors Rust gg's `FaultOp::DivOverflow`).
const int OP_DIV_OVERFLOW = 14

# D28 `**` — exponentiation. Lowers to a runtime call to
# `gorget_pow_checked_iN` (traps on overflow OR negative exponent) for
# integer widths, or `gorget_pow` / `gorget_powf` for floats.
const int OP_POW = 15

const int CMP_EQ = 0
const int CMP_NE = 1
const int CMP_LT = 2
const int CMP_LE = 3
const int CMP_GT = 4
const int CMP_GE = 5

# ── Instructions ──────────────────────────────────────────

const int UNOP_NEG = 0
const int UNOP_NOT = 1
const int UNOP_BITNOT = 2

enum Instruction:
    GIAssign(int, Operand)
    GIBinOp(int, int, int, Operand, Operand)
    # Fault-catch checked arithmetic (error-model.md §11). Computes a BOOL
    # flag (dst) = "lhs op rhs would fault" WITHOUT trapping or committing the
    # result; the enclosing block is terminated by a GTBranch on the flag to
    # the active fault-catch handler. Emitted ONLY inside an active fault scope
    # (lower_expr's EBinaryOp gate); lowers 1:1 to LIR IFaultCheck.
    GIFaultCheck(int, int, int, Operand, Operand)   # dst_flag, fault_op, ty, lhs, rhs
    GIUnOp(int, int, int, Operand)
    GICmp(int, int, int, Operand, Operand)
    GICall(int, String, Vector[Operand])
    GICallExtern(int, String, Vector[Operand])
    GIDrop(int)
    GIDropIfAlive(int)
    GIMoveZero(int)
    GIDeref(int, int, int)    # dst_local, src_local (ptr/Box), inner_ty_id
    # Numeric `as`-cast — convert the scalar value in `src` to `to_ty`.
    # Mirrors Rust's `Instruction::Cast { dst, target_type, value }`
    # (src/ir/instructions.rs:227). `src` is a RAW LOCAL ID (the single-
    # source-conversion shape, modelled on GIDeref above), NOT an Operand —
    # the prim-scalar source is always a plain Copy of a local, so there is
    # no clone/borrow mode to carry. `from_ty`/`to_ty` are GIR type ids
    # (F32=9, F64=10); the LIR translation (lir_lower.gg `lower_instruction`)
    # maps BOTH to LIR first, then routes to IIntCast/IFloatCast/IIntToFloat/
    # IFloatToInt per the int/float families (mirrors insts.rs:393-402).
    GICast(int, int, int, int)    # dst_local, src_local, from_ty_id, to_ty_id
    GINop()
    # A.1 (2026-05-22) — typed field-load. Mirrors Rust's
    # `Instruction::FieldLoad { dst, base, field }` in
    # `src/ir/instructions.rs:153-157`. A.2 will wire EFieldAccess
    # at lower.gg to emit this instead of GICallExtern("__field_read_*"),
    # enabling LIR's Ptr-typed-dst dispatch:
    #   • dst is GtPtr/GtMutPtr → pointer alias (no byte-copy)
    #   • else → byte-copy load
    # A.1 status: LIVE — lir_lower.gg:3324 lowers GIFieldLoad, and closure
    # Phase 2 Step B (ByValue captures) emits it in the post-pass body to
    # read each captured env field (`GIFieldLoad(fdst, env_ptr=_1, idx)`).
    GIFieldLoad(int, int, int)    # dst_local, base_local, field_index
    # Store `value` through the pointer held in `ptr_local` — `*ptr = value`.
    # Inverse of GIDeref. Emitted for whole-value writes to a `&`/`!` param
    # (a `GtMutPtr(inner)`-typed local): the slot holds a `T*`, so a plain
    # GIAssign would clobber the pointer slot instead of the pointee. Lowers
    # to `ISlotLoad(ptr) + IStore(ptr_val, value)` — IStore's codegen
    # (lir_codegen.gg) dispatches scalar (`*(T*)ptr = v`) / aggregate
    # (memcpy) / ptr per the value's LIR type, so it covers BOTH non-resource
    # and resource inner. Mirrors Rust gg's `assign` into a `Place{local,
    # [Deref]}` (src/ir/lowering/stmts/assigns.rs:231-243). Carries inner_ty
    # to match GIDeref's shape (unused by the IStore lowering, kept for
    # symmetry / future sized-store needs).
    GIDerefStore(int, Operand, int)    # ptr_local, value, inner_ty_id

# ── Terminators ───────────────────────────────────────────

enum Terminator:
    GTNone()
    GTReturn(Operand)
    GTJump(int)
    GTBranch(Operand, int, int)

# ── Basic block ───────────────────────────────────────────

struct BasicBlock:
    Vector[Instruction] insts
    Terminator term

# ── Local variable slot ──────────────────────────────────

# Phase D ownership state (mirrors Rust's `Local.ownership: OwnershipState`
# in `docs/devbook/13-ownership-in-ir.md`, Phase D). Populated by
# `lower.gg` at every `add_local` site; read by Phase C validators
# (`docs/devbook/26-self-host-frontend.md` §5).
enum LocalOwnership:
    LoOwned        # local owns its data; consume sites move/drop
    LoBorrowed     # local aliases a borrow; consume sites must clone
    LoView         # CoW view (cap=0) into another buffer; auto-materialise on mutation
    LoParam        # function parameter — passed by caller; ABI-controlled lifetime
    LoMaybeOwned   # uninferred / generic / merged-from-multiple-arms

# ConsumeKind classifies the *position* in the lowered GIR where a local
# is read via `op_consume` (lower.gg). It's the typed-metadata
# replacement for an `is_consuming: bool` sidecar that would otherwise
# be threaded through op_consume's ~30 call sites. Phase 2b (Path A
# part 2, 2026-05-20) introduced this enum per CLAUDE.md "No name
# matching" and layering rule 2: every call site explicitly names its
# kind; at non-consume kinds `op_consume` returns `OpBorrow` regardless
# of source ownership; at consume kinds the existing
# LoOwned→OpMove / LoBorrowed→OpBorrow dispatch applies. Helper
# `is_consume_kind(k)` is the single source of truth for the partition.
enum ConsumeKind:
    # ── Consume positions ────────────────────────────────────
    # Receiver of the read takes ownership of the value.
    CkAssign           # SVarDecl/SAssign init RHS → owned local
    CkReturn           # GTReturn value (move into return place)
    CkCallArgOwning    # call arg the callee owns (declared `!T`,
                       # or a specific consuming position: collection
                       # runtime val args for push/put/set/insert/send).
    CkFieldWrite       # __field_write_TYPE_FIELD value (field takes ownership)
    # ── Borrow positions ─────────────────────────────────────
    # Receiver just reads the value; source stays live afterward.
    CkCallArgBorrow    # default call arg — callee declared bare `T`
                       # (or signature unknown). Per CLAUDE.md "Ownership
                       # at Consuming Positions", bare call args propagate
                       # Ptr aliases at zero cost; no clone, no move.
    CkBinOpArg         # GIBinOp / GICmp / GIUnOp operand (arithmetic / compare)
    CkFormatArg        # f-string / printf arg (gorget_string_format / printf — read-only)
    CkMatchPtr         # __field_read_<enum>_<field> args (pointer plumbing only)

# When LoBorrowed, where the borrow originates — used by validators that
# need to flag borrow-into-owned consume sites by source type. Mirrors
# Rust's `BorrowOrigin` in `src/ir/mod.rs:582-624`.
#
# C.1 (2026-05-22) — enum expanded to carry source payloads:
#   • BoParam(int): param-local id (the param itself, self-referential)
#   • BoCollectionElement(int): collection local the borrow indexes into
#   • BoField(int, int): base local + field index for struct-field borrows
#   • BoRuntimeView(int): source local for runtime-view borrows (e.g.
#     string slices, CoW views)
#   • BoAlias(int): transitive alias source local (cow_register_alias)
#   • BoFieldPath(String): multi-layer dotted field path
#     (e.g. "self.data.items") — single LocalId can't encode a chain
#   • BoTupleElement(int, int): tuple temp + 0-based element index, for
#     return-path MoveZero of borrow-sourced tuple elements
#   • BoCowBorrowPending: placeholder for deferred source resolution
#     (set_cow_borrow without source; upgraded by set_cow_borrow_source)
#
# WIRING STATUS (re-censused 2026-07-27; the earlier "payloads are
# present but UNUSED, callers pass sentinel -1" note was stale):
#   • BoField        — WIRED with real ids at five writer sites
#     (lower_expr.gg set_field_borrow x2, lower_match.gg, lower_loops.gg,
#     lower_closures.gg), all via `set_field_borrow` in lower.gg.
#   • BoCollectionElement — WIRED with a real collection local by the
#     for-loop lowering (lower_loops.gg); the general `.get()` path
#     deliberately passes `-1` as "no trackable collection", and
#     lir_lower.gg reads the pair back and keys on the non-negative case.
#   • BoRuntimeView  — WIRED with a real source local (lower_expr.gg
#     box/deref reads, lower_stmt.gg view bindings).
#   • BoAlias        — WIRED with a real source local (lower.gg
#     cow_register_alias, lower_stmt.gg rebind path).
#   • BoParam        — payload still a sentinel `-1` everywhere.
#   • BoFieldPath / BoTupleElement / BoCowBorrowPending — genuinely
#     never constructed; still scaffolding.
# Census command:
#   grep -rn 'Bo[A-Za-z]*(' tests/fixtures/self_host_lowerer/*.gg
enum BorrowOrigin:
    BoNone()                    # not a borrow
    BoParam(int)                # param-local id (self-referential)
    BoCollectionElement(int)    # collection local
    BoField(int, int)           # base local + field index
    BoRuntimeView(int)          # view-source local
    BoAlias(int)                # transitive alias source local
    BoFieldPath(String)         # multi-layer dotted field path
    BoTupleElement(int, int)    # tuple local + element index
    BoCowBorrowPending()        # placeholder for deferred source

struct GirLocal:
    int type_id
    Option[String] name_hint
    LocalOwnership ownership
    BorrowOrigin borrow_origin
    # True iff this local is an owning `!`-move resource PARAMETER (sigil
    # ownership==2). Set by `register_owning_param` after the param's
    # GirLocal is pushed; every other construction site passes `false`.
    # Read at two sites: (D) the consume-mode decision (`op_consume` /
    # `decide_operand_at_consuming_arg` GtMutPtr arms move the param on
    # its last use instead of cloning the pointee) and (C) the
    # `GIDropIfAlive` emission (the drop-fn arg is the loaded `T*` from the
    # slot, not `&slot`). A `&`-borrow (ownership==1) ALSO lowers to
    # GtMutPtr but keeps this `false`, so it is never moved/zeroed/derefed.
    bool owning_param

# ── Function ─────────────────────────────────────────────

struct GirFunction:
    String name
    Vector[int] param_types
    int return_type
    Vector[GirLocal] locals
    Vector[BasicBlock] blocks
    # round-16 Phase-2 (async splice) — typed metadata carried GIR→GIR for the
    # `__shared_async_<f>` post-pass (Layering rule 2: typed fields, not name-
    # re-derived downstream). Both default empty; only an async shared-spawn
    # SOURCE function populates them.
    #   • with_refresh_pairs — FLATTENED (binding_local, param_local) pairs
    #     recorded at `with <&param>:` lowering. After each lock-reacquire the
    #     post-pass re-reads the binding from the freshly-derived facade.
    #     Mirrors Rust gg's `Function.with_refresh_pairs` (`src/ir/mod.rs:397`).
    #   • inner_shared_spawns — `spawn inner(&param)` calls inside this fn whose
    #     `&param` traces back to a shared carrier; the post-pass rewrites them
    #     to the inner token wrapper + forwards the carrier. Mirrors Rust gg's
    #     `Function.inner_shared_spawns` (`src/ir/mod.rs:402`).
    Vector[int] with_refresh_pairs
    Vector[InnerSharedSpawn] inner_shared_spawns

# ── Extern declaration ───────────────────────────────────

struct GirExtern:
    String name
    bool is_variadic
    int return_type

# ── Module ───────────────────────────────────────────────

# Struct/enum field info for drop/clone analysis in LIR lowering.
struct GirFieldInfo:
    String name
    String type_name  # resolved type name (e.g., "GorgetString", "Vector__int64_t")

struct GirEnumVariantInfo:
    String name
    Vector[GirFieldInfo] fields

struct GirTypeInfo:
    String name
    Vector[GirFieldInfo] fields          # struct fields
    Vector[GirEnumVariantInfo] variants  # enum variants (empty for structs)
    bool is_enum

# ── Phase A: typed resource metadata ────────────────────────
# Companion to the Rust-side `TypeMetadata { drop_strategy, copy_semantics,
# collection_kind, ... }` (see `docs/devbook/13-ownership-in-ir.md`, Phase A).
# Self-host scope is `docs/devbook/26-self-host-frontend.md` §3.
# Populated at type-registration time; consumers read instead of
# re-deriving from `name.starts_with("Vector__")` etc.

# (CopySemantics / CollectionKind / BoxKind / GirResourceMetadata moved to
#  compiler/data/schema.gg as the canonical resource-model definitions;
#  imported above as CopySemantics / CollectionKind / BoxKind / ResourceMetadata.)

# Module-level static with a runtime-call initializer (lib/std/io.gg's
# `public static File stdout = _stdout_handle()` etc.).
# Static init-kind tags. These mirror the LIR GINIT_* codes (lir.gg) so
# the lir_lower mapping is a direct pass-through. GGSTATIC_RUNTIME routes
# the `init_expr` through a runtime call (synth fn or `gorget_<sym>()`) at
# the main-prologue; GGSTATIC_BYTES emits `init_expr` as a const C
# initializer at the declaration (scalar-literal statics — mirrors Rust's
# `GlobalInit::Bytes`, `src/ir/mod.rs:726`).
const int GGSTATIC_RUNTIME = 2   # == GINIT_RUNTIME_CALL
const int GGSTATIC_BYTES = 4     # == GINIT_BYTES

struct GirStaticInfo:
    String init_expr  # C expression — `gorget_<sym>()` (RUNTIME) or a C literal (BYTES)
    int type_id       # GIR type id of the declared type
    int init_kind     # GGSTATIC_* (RUNTIME = synth-fn/extern call; BYTES = const init)

# ── Globals (vtables) ────────────────────────────────────────────
# Typed model of a module-level global with a const initializer,
# mirroring Rust's `ir::Global` / `ir::GlobalInit` (`src/ir/mod.rs:713-741`).
# Used for trait-impl `_VTable` globals (a struct of FuncAddr slots). The
# separate `statics` channel above models runtime-call-init statics, so this
# model is kept minimal — only the variants needed for vtables.

# Global initializer kind tags. ADD-AT-END discipline (MEMORY: inserting
# mid-enum shifts ordinals → regressions). These are int consts, not an
# enum, matching the LIR GINIT_* style in lir.gg:281.
const int GGINIT_ZEROED = 0
const int GGINIT_FN_REF = 1   # scalar &fn (by name)
const int GGINIT_STRUCT = 2   # struct-of-inits (vtable)
# Address of the per-concrete-type `Box__<concrete>__drop` wrapper — the
# trait-object vtable's `__drop` glue slot. Carries the mangled CONCRETE
# type name in `fn_name` as TYPED metadata (set once at the vtable-global
# emit in lower.gg); the C backend spells the wrapper symbol at its emit
# boundary. Distinct from GGINIT_FN_REF because the wrapper is backend-
# synthesized (no GIR function exists for it, so an FN_REF would fail the
# func_index lookup and silently lower to a NULL slot). Mirrors Rust gg's
# `GlobalInit::BoxDropRef` (`src/ir/mod.rs`). ADD-AT-END discipline.
const int GGINIT_BOX_DROP_REF = 3

# One field of a struct global init. For vtables every field is
# GGINIT_FN_REF (method slots) or GGINIT_BOX_DROP_REF (the trailing
# `__drop` glue slot), so a flat representation suffices: a kind + one
# String payload. Nested structs are not needed for vtables.
struct GirGlobalField:
    int kind          # GGINIT_* (FN_REF / BOX_DROP_REF / ZEROED for vtables)
    String fn_name    # FN_REF: mangled impl fn name; BOX_DROP_REF: mangled concrete type name

struct GirGlobal:
    String name           # e.g. "Serializer_for_JsonSerializer_vtable"
    int type_id           # GIR type id of the _VTable struct (GtNamed)
    int init_kind         # GGINIT_STRUCT for vtables
    Vector[GirGlobalField] fields   # struct-init fields (ordered slots)
    bool is_const

# ── Lifted closure record (closure Phase 2 Step A) ───────────────
# A closure recorded AT THE MAKE-SITE (lower_expr's EClosure /
# EImplicitClosure / inline-spawn arms) and drained by the post-pass,
# which is the SOLE pusher of `__Closure_N__call`. Replaces the deleted
# `scan_*_for_closures` pre-pass: the make-site is now the single
# closure-id source + recorder, so the two never-reconciled counters
# (make-site `gmod_next_closure_id` vs the scan's local) can no longer
# desync. The record stores everything `lower_closure_body` needs so the
# post-pass never re-derives the signature. (Step B adds the `captures`
# field at END for ByValue captures.)

# closure Phase 2 Step B: a single captured free variable, in capture
# (= env-field = struct-ctor-arg = body GIFieldLoad-index) order. The
# capture VECTOR ORDER is the SINGLE source of truth across all three:
# env-field order == struct-ctor arg order == body GIFieldLoad index.
# `mode` is CAP_BY_VALUE in 2a/2b; CAP_BY_MUT_REF (2c) is used for a
# captured PRIMITIVE that the body MUTATES — the env field holds a
# `MutPtr(T)` to the outer slot (named `MutRef__<T>` so the body
# GIFieldLoad takes the load-stored-pointer path), and reads/writes
# deref through it. Resource/nested/enum mutable captures still STUB.
const int CAP_BY_VALUE = 0    # 2a/2b: bit-copy/clone the value into the env
const int CAP_BY_MUT_REF = 1  # 2c: env holds a MutPtr(T) to the outer slot

# ── Scheduler modes ─────────────────────────────────────────────
# The async scheduler runtime selected for a module (codegen reads
# `LirModule.scheduler_mode` to pick the matching `scheduler_*_runtime.c`).
# Defined HERE (not in lir.gg) so `GirModule.scheduler_mode` can carry the
# directive-selected mode through the GIR layer without a lir→gir layering
# inversion; lir.gg / lir_lower.gg / lir_codegen.gg import these from gir.
const int SCHED_POOL = 0
const int SCHED_THREAD = 1
const int SCHED_INLINE = 2
const int SCHED_SINGLE = 3

struct ClosureCapture:
    String name      # the captured outer-local's name
    int type_id      # GIR type id of the captured value (2a: {0,4,10}; 2c: pointee T)
    int local_id     # the outer local's id at the make-site (for OpCopy / OpBorrow)
    int mode         # CAP_BY_VALUE (2a/2b) / CAP_BY_MUT_REF (2c primitive mutate-through)

struct LiftedClosure:
    int cid                          # closure id (from gmod_next_closure_id)
    String call_name                 # "__Closure_<cid>__call"
    int self_ptr                     # env-ptr type id (*__Closure_<cid>)
    Vector[int] abi_param_types      # full ABI vector [self_ptr, p0, p1, …]
    Vector[int] body_param_types     # the closure's OWN param types [p0, p1, …]
    Vector[String] body_param_names  # the closure's param names (implicit-it: ["it"])
    int return_type
    Vector[Stmt] body
    bool is_implicit                 # true for EImplicitClosure (implicit `it`)
    bool lowerable                   # false → emit the Phase-1 stub; true → lower the body
    # closure Phase 2 Step B: ByValue captures, in env-field/ctor-arg/
    # GIFieldLoad-index order (the single source of truth). Empty for
    # non-capturing closures + inline-spawn/implicit-it records (DEFERRED).
    Vector[ClosureCapture] captures

# Typed payload-type channel for a monomorphized prelude `Option__<Inner>`
# / `Result__<Ok>__<Err>` enum. `category` is `ENUM_CAT_OPTION` /
# `ENUM_CAT_RESULT`. `ok_type` is the Some_0 (Option) / Ok_0 (Result)
# payload GIR type id; `err_type` is the Error_0 payload GIR type id for a
# Result (or -1 for an Option, which has no second payload). Recorded at
# the MINT site (where the typed payload tids are in hand) and read by the
# unwrap / match-destructure / catch / rethrow / auto-prop / LIR
# field-shape sites — none of which re-parse the mangled name. Mirrors the
# `(TypeId, TypeId)` Rust reads off the enum's TypeDef in
# `extract_result_field_types` (`exprs/mod.rs:2845`).
struct EnumCategory:
    int category
    int ok_type
    int err_type

# A thread_spawn(fn[, stack_size]) registration. Mirrors Rust gg's
# `module.runtime.thread_spawned_fns: Vec<(String, TypeId, String, i64)>`
# (`src/ir/mod.rs:99-104`, the 4-tuple: fn_name, return TypeId, payload
# name, stack_size) — carried as a GIR-level channel from the
# `thread_spawn` intrinsic in lower_call to the per-fn wrapper emit
# in lir_codegen. `stack_size` is the requested pthread stack in bytes
# (0 = OS default = plain wrapper, byte-identical to Rust's
# pre-stack-size emit). One size per fn.
struct ThreadSpawnRec:
    String fn_name
    # SYMBOL-NAME axis: the payload type NAME as baked into the
    # `Thread__{name}` symbols at the spawn/join call sites (e.g.
    # "int64_t", "Vector__int64_t", "Point"; "void" for a unit fn). The
    # emitted helper symbols MUST use this name verbatim. The C TYPE that
    # spells the ctx `_result` field / join return is the SEPARATE
    # C-spelling axis, resolved at emit by `thread_payload_c_type`
    # (lir_codegen) — e.g. Vector__int64_t → GorgetArray, Point →
    # __gg_Point. Mirrors Rust gg's `ThreadSpawnedFn.ret_name`.
    String ret_name
    # Monomorphized GIR type id of the spawned fn's return (UNIT_TYPE for a
    # void fn). The TYPED payload channel: recorded once at the spawn
    # intrinsic (which holds the fn_sigs tid already), read by lir_lower to
    # stamp `LirThreadSpawnedFn.ret_lir_ty` so the codegen's call-extern
    # type inference resolves `Thread__T__join` results from typed metadata
    # instead of the I64 name-unknown fallback (which truncated a
    # `Thread[float].join()` result to 0). Mirrors the d12c6545
    # `enum_category.ok_type` mint-site pattern.
    int ret_tid
    int stack_size

# A `spawn fn(args)` registration for a NAMED function (Inc-1: int+void
# returns, scalar by-value params only). Mirrors Rust gg's
# `ctx.spawn.fn_names` set + the `LirSpawnedFn` it ultimately produces
# (`src/lir/types.rs` / `src/backend/c_lir/emit_types.rs:382-540`). Carried
# as a GIR-level channel from the `ESpawn` arm in lower_expr to the
# GIR→LIR copy in lir_lower, which builds the `LirSpawnedFn` consumed by
# `emit_spawn_helpers` in lir_codegen. `ret_c_type` is the C return type
# name ("void" for a unit-returning fn, "int64_t"/"double"/etc. otherwise)
# — the SAME string used to register the `Task__<ret_c>` named type at the
# spawn site, so the emitted helpers and the `emit_mono_typedefs` typedef
# spell the Task type identically (a divergence is a cc-fail). `param_c_types`
# are the per-param C type names (scalar by-value in Inc-1), parallel to the
# synthesized `p0`/`p1`/… param names the C-emit mints. Deduped by fn_name at
# the write site (one helper set per spawned fn).
struct SpawnFnRec:
    String fn_name
    String ret_c_type
    Vector[String] param_c_types

# Per-shared-variable carrier model (mirrors Rust gg's `SharedLocalInfo`,
# `src/ir/lowering/context.rs:41`). A `shared int x = 0` (shared_kind==1,
# ArcMutex strategy) mints a hidden CARRIER local of type
# `Shared__Mutex__<inner_c>` (a `gorget_shared` handle whose `data` holds a
# `gorget_mutex` over the inner value) plus a facade local bound to the user
# name. Every transparent read/write of `x` routes through the carrier's
# lock-chain (`Shared__get` → `Mutex__lock` → `Guard__{get,set,drop}`); a
# `spawn worker(&x)` passes the CARRIER (not `&x`) so the worker owns an
# independently-retained handle and locks it inside the token wrapper.
# Keyed in `ctx.shared` by the variable NAME (the self-host resolves
# identifiers by name, not local-id). `decl_order` is the source-order index
# (ascending lock order in the spawn token wrapper, descending unlock).
# Defined here (not lower.gg) so the GIR-level `PendingSharedAsync` post-pass
# request can carry it without a gir→lower→gir import cycle.
# Resolved sync strategy for a shared binding (SharedLocalInfo.kind). The
# values deliberately REUSE the parser's SVarDecl shared_kind encoding
# (parser.gg parse_shared_var_decl: 1 = auto, 2 = rwlock, 3 = atomic) so the
# typed fact threads AST→GIR without a translation table — ONE source of
# truth (devbook/24 rule 3). Auto resolves to the ArcMutex strategy (the
# self-host has no CFA; Rust's CFA default for written-and-spawned is
# ArcMutex too, `src/semantic/mod.rs:573-596`). Mirrors Rust gg's
# `SharedLocalKind` (`src/ir/lowering/context.rs:56`).
const int SHK_MUTEX = 1   # `shared T x` (auto) → hidden Shared__Mutex__T carrier
const int SHK_RWLOCK = 2  # `shared(rwlock) T x` → hidden RWLock__T carrier
const int SHK_ATOMIC = 3  # `shared(atomic) T x` → hidden AtomicInt/AtomicBool carrier

struct SharedLocalInfo:
    int facade_local        # the user-named local (inner_type slot)
    int hidden_local        # the carrier local (Ptr to the sync carrier)
    int inner_type          # GIR type-id of the inner value (the user's T)
    int carrier_type        # GIR type-id of the sync carrier (Ptr-typed)
    String inner_c          # inner C type name (int64_t / bool / double / …)
    String mutex_mangled    # SHK_MUTEX: "Mutex__<inner_c>"; SHK_RWLOCK: "RWLock__<inner_c>"; SHK_ATOMIC: "AtomicInt"/"AtomicBool"
    String guard_mangled    # SHK_MUTEX: "Guard__<inner_c>"; SHK_RWLOCK: "ReadGuard__<inner_c>" (write guard derives); SHK_ATOMIC: unused ""
    String shared_mangled   # SHK_MUTEX: "Shared__Mutex__<inner_c>"; others: unused ""
    int decl_order          # source declaration order (lock-ordering key)
    int kind                # resolved strategy: SHK_MUTEX / SHK_RWLOCK / SHK_ATOMIC

# round-16 Phase-2 (async splice): a `spawn inner(&param)` LOWERED INSIDE a
# function that will become a `__shared_async_<f>` variant — where `param` is
# a `&`-borrow param of the enclosing fn that traces back to a shared carrier.
# Recorded on the ENCLOSING GirFunction (`inner_shared_spawns`) at the spawn-
# site lowering; consumed by the GIR→GIR post-pass (`build_shared_async_wrapper`)
# to rewrite `__gorget_spawn_<inner>` → `__gorget_spawn___shared_token_<inner>`
# and forward the CARRIER (not a stack value). Mirrors Rust gg's
# `InnerSharedSpawn` (`src/ir/mod.rs`) + `InnerSpawnRewrite`
# (`src/ir/transforms/shared_async.rs:72`). The parallel `shared_arg_*` Vectors
# are (call-arg index, enclosing-param index) pairs — small N, parallel Vectors
# per the self-host idiom (no easy tuple storage in fields).
struct InnerSharedSpawn:
    String callee_name                  # the inner callee (e.g. "modifier")
    Vector[int] shared_arg_call_indices # call-arg position of each shared arg
    Vector[int] shared_arg_param_indices# enclosing-fn param index it maps to (0-based)
    Vector[int] callee_param_types      # the inner callee's GIR param types
    int callee_return_type              # the inner callee's return type
    bool callee_has_awaits              # inner callee has its own yield points?

# round-16 Phase-2 (async splice): a pending request to synthesize the
# `__shared_async_<source_fn>` variant — recorded at the `spawn <async-callee>(&shared)`
# site (`lower_shared_spawn`), processed AFTER all functions are lowered by the
# GIR→GIR post-pass driver (mirrors Rust gg's `PendingSharedVariant`
# `src/ir/transforms/shared_async.rs:58` + the driver `src/ir/lowering/mod.rs:1547`).
struct PendingSharedAsync:
    String source_fn_name               # the async callee already lowered (e.g. "worker")
    String variant_name                 # "__shared_async_<callee>"
    Vector[int] shared_arg_indices      # callee param indices that are shared
    Vector[SharedLocalInfo] shared_arg_infos  # carrier metadata per shared arg
    int return_type

struct GirModule:
    Vector[GirFunction] functions
    Vector[GirExtern] externs
    Vector[GirType] type_table
    Dict[String, int] fn_sigs
    Dict[String, int] named_types  # name → type id; deduped GtNamed registration
    Dict[String, bool] resource_types
    Dict[String, int] type_subs
    Dict[String, String] meta_aliases
    Dict[String, String] call_redirects
    Dict[String, bool] imported_fns
    Dict[String, GirTypeInfo] type_infos  # struct/enum field info for LIR drop analysis
    Dict[String, Vector[bool]] fn_borrow_params  # per-param: true if borrow (&)
    # Per-param: true if `!`-move (OWN_MOVE / ownership==2). Parallel to
    # fn_borrow_params. Used by op_consume call sites to pick
    # CkCallArgOwning for `!T` declared params vs CkCallArgBorrow for bare
    # `T` declared params. Per CLAUDE.md "Ownership at Consuming
    # Positions" + the doc-vs-impl conformance scout (2026-05-21):
    # callee-signature is the authoritative decision; bare `T` always
    # borrows (Ptr alias propagated at zero cost), `!T` is the owning
    # opt-in.
    Dict[String, Vector[bool]] fn_move_params
    # R38 mutation-inference: per equip-method (keyed `Type__mname`, self =
    # param idx 0), true iff the method actually WRITES self (transitively).
    # Computed by `compute_method_mutates_self` — a monotone fixpoint over
    # the module in the pre-pass. Distinguishes a read-only `&self` (getter /
    # `.clone()`) from a mutating one so the named-receiver CoW-materialize
    # gate fires ONLY for genuine mutators (a full `&self`⇒mutating
    # over-approx is a ~12GB clone bomb). Sits alongside the existing
    # `fn_borrow_params`/`fn_move_params`/`resource_types` name-keyed
    # classification caches — one source of truth for this axis.
    Dict[String, bool] method_mutates_self
    # Module-level int constants and None-typed sentinel decls.
    Dict[String, int] const_decls
    # Module-level bool constants — `const bool ENABLED = true`. Mirrors
    # Rust's unified `module_constants` storing `Constant::Bool`. Read by
    # the EIdentifier arm to inline `OpConstBool(value)`.
    Dict[String, bool] bool_const_decls
    # Module-level String constants — `const String GREETING = "hello"`.
    # Mirrors Rust's `Constant::Str`. Read by the EIdentifier arm to inline
    # `OpConstStr(value)` into a fresh GorgetString local.
    Dict[String, String] string_const_decls
    # `Option[T] X = None` module consts → the const's concrete Option
    # type_id, so an EIdentifier reference emits a properly-typed `None`
    # (IEnumInit, tag 1) instead of an 8-byte OpConstUnit() — the latter is
    # over-read by add_local's drop-emission clone as a 40-byte Option.
    Dict[String, int] none_decls
    # Enum registry — used by `find_enum_by_variant` for the inverted
    # variant→enum lookup and by `enum_variant_index` for ordinal
    # resolution. Mirrors Rust's `ctx.resolve_enum_variant`.
    Dict[String, Vector[String]] enum_registry
    # Float constants. Module-level `float EPSILON = 0.000001` etc.
    # lands here so `EIdentifier(EPSILON)` can inline an
    # `OpConstF64(value)` rather than emitting a `[bug] EIdentifier:
    # unknown identifier 'EPSILON'` placeholder. Mirrors Rust gg's
    # unified `module_constants: FxHashMap<String, Constant>` which
    # stores both `Constant::I64` and `Constant::F64` in one table.
    Dict[String, float] float_const_decls
    # Module-level statics with a runtime-call initializer —
    # `public static File stdout = _stdout_handle()` etc. in lib/std/io.gg.
    # Mirrors Rust gg's `LoweringContext::global_names` + `module.globals:
    # Vec<Global>` (`src/ir/lowering/mod.rs:1074-1111`). The init is a
    # zero-arg function call mapped to a C-runtime symbol; `EIdentifier`
    # references resolve through `__global_ref__<name>` in lir_lower
    # against a parallel name→gid map populated by `lir_mod_add_global`.
    Dict[String, GirStaticInfo] statics
    # Phase A: typed resource metadata, keyed by type name. Populated at
    # registration; consumed by lir_lower / lower in place of
    # `name.starts_with("Vector__")` and friends.
    Dict[String, ResourceMetadata] resource_metadata
    # Typechecker side-tables — set once at lower_module start so
    # downstream passes that hold `&gmod` can query per-expression
    # resolved types without threading two extra args through every
    # signature. `tc_types.expr_types` (per-expression
    # `Span.start → type_id`) is the architectural single-source-of-
    # truth for expression types (Layering rule 3); the read accessor
    # is `lookup_expr_gir_type(sexpr, &gmod)`. lir_lower / lir_codegen
    # don't consult these — they're a within-lower-module convenience.
    TypeTable tc_types
    ScopeTable tc_scopes
    # Mono'd Option__X / Result__X__E instances whose payload is a resource.
    # These are emitted as ordinary by-value enum structs (NOT runtime
    # handles), so they must NOT go in `resource_types` — membership there
    # flips the C param/field ABI to pass-by-pointer/void* and breaks the
    # by-value call sites. But at a consuming position they DO own a
    # resource transitively and must be CLONED, not byte-copied. op_consume
    # consults this set (via is_resource_type_name) for the clone decision
    # only; C emission never reads it. Populated by
    # register_optionlike_resource during lower_module; the matching
    # clone/drop fn defs are generated in lir_lower Pass 3 +
    # recursive_drop_enums. See lower.gg's register_optionlike_resource.
    Dict[String, bool] optionlike_resource_types
    # Phase 2b (option_ref_borrow): typed payload-type channel for
    # borrowing-getter Option results. Maps an `Option__Ref__T` GIR type
    # id → the payload `GtPtr(T)` GIR type id. Populated once at
    # Option-of-ref registration (resolved_to_gir_type RTGeneric arm);
    # read at the unwrap / match-destructure sites so they mint a real
    # `GtPtr(T)` payload local WITHOUT parsing `Ref__` out of a mangled
    # name (CLAUDE.md "No name matching"; single source of truth, one
    # accessor — Layering rule 3). The Option id is name-deduped via
    # `named_types`, so the SAME id appears at registration and every
    # read site.
    Dict[int, int] option_ref_payload
    # Module-level globals with a const initializer — trait-impl `_VTable`
    # globals (a struct of FuncAddr slots). Mirrors Rust gg's
    # `module.globals: Vec<Global>` (`src/ir/mod.rs:713-741`), built by
    # `emit_vtable_globals` (`src/ir/lowering/traits.rs:985`). Appended AT
    # END to avoid shifting positional constructor call sites. Empty until
    # the vtable-emission pass populates it (latent in Phase 1).
    Vector[GirGlobal] globals
    # Flat inverted variant→enum index. Mirrors Rust's precomputed
    # `enum_variants: FxHashMap` (`src/ir/lowering/context.rs:267`, O(1)
    # lookup `:1553`). Built FIRST-WRITE-WINS alongside `enum_registry` in
    # the build `IEnum` arm so `enum_variant_parent(name)` becomes an O(1)
    # dict lookup instead of an O(types) scan with a per-type `GirTypeInfo`
    # deep-clone (the #1 array_clone site). First-write-wins == the scan's
    # first-match (insertion-order first enum whose variant matches) — a
    # plain last-wins `.put` would diverge IFF two enums in the unit share a
    # bare variant name. Appended AT END to avoid shifting positional ctor
    # call sites.
    Dict[String, String] enum_variant_parent_idx
    # `directive strip-asserts` active for this module — asserts become
    # no-ops (the SAssert case in lower_stmt emits nothing). Mirrors Rust
    # gg's `LoweringContext.strip_asserts` (`src/ir/lowering/context.rs:282`),
    # populated from the `IDirective("strip-asserts", _)` module item in
    # `lower_module` (mirrors `src/ir/lowering/mod.rs:489`). Appended AT END
    # to avoid shifting positional ctor call sites.
    bool strip_asserts
    # closure Phase 2 Step A: make-site-recorded closures, drained by the
    # post-pass (the SOLE pusher of `__Closure_N__call`). The make-site is
    # the single closure-id source + recorder; the post-pass re-reads
    # `.len()` each iteration (drain-until-empty) so a closure appended
    # mid-drain (an implicit-it inside a lowered body) is picked up.
    # Appended AT END to avoid shifting positional ctor call sites.
    Vector[LiftedClosure] lifted_closures
    # closure Phase 2 Step A: maps `<current_fn_name>\0<varname>` → the
    # closure's `__Closure_<cid>` env-type name, recorded at SVarDecl
    # lowering when the init is a closure. The re-pointed named-spawn pass
    # (`emit_named_closure_spawn_*`) reads this to wire each `spawn f()`'s
    # `__spawn_wrap___Closure_N` to the closure's make-site cid (replacing
    # the deleted `collect_closure_vars_*` / `ncv_id` replay, which was not
    # consistent with the make-site cids for test/generic/equip closures).
    # Keyed by fn-name + NUL + varname so two functions declaring the same
    # `auto f = …` don't collide. Appended AT END.
    Dict[String, String] closure_var_cids
    # Typed payload-type channel for mono'd `Option__<Inner>` /
    # `Result__<Ok>__<Err>` enums, keyed by the enum's GIR type id (the
    # name-deduped `lookup_or_register_named` id, so the SAME id appears at
    # the mint site and every reader). Replaces the genuinely-ambiguous L→R
    # `__`-boundary "smart split" that re-parsed the mangled name to recover
    # the payload types — see `EnumCategory` / `record_enum_category` /
    # `enum_category_of`. Single source of truth, one accessor — Layering
    # rule 3; CLAUDE.md "No name matching". Appended AT END.
    Dict[int, EnumCategory] enum_category
    # ② closure ENV-FIELD leak fix: maps `<fn_name>\0<int_to_str(local_id)>`
    # → the closure's `__Closure_<cid>` env-type name, for a resource/CoW-
    # capturing closure VALUE local (a `GorgetClosure` whose heap env owns
    # String/Vector/struct field SNAPSHOTS). The make-site records it under
    # the GorgetClosure value's `cdst` local id (only when the env owns ≥1
    # resource field); the SVarDecl MoveDirect arm copies the entry onto the
    # fresh `var_local` it mints (the dropped local). The `GorgetClosure`
    # `GIDropIfAlive` lowering reads it: present + `__Closure_N ∈ type_drop_fns`
    # ⇒ emit `__Closure_N__drop(closure.env)` BEFORE `gorget_closure_free`
    # (which frees only the env BLOCK, leaking the field buffers — the
    # auto-generated per-field `__Closure_N__drop` was never invoked). KEY is
    # composite per-function (GIR local-ids are per-function — a bare-int key
    # would COLLIDE across functions); this reuses the exact `closure_var_cids`
    # key idiom. Single source of truth, one accessor — Layering rule 3.
    # Appended AT END.
    Dict[String, String] closure_env_type
    # P0 Bug A: type names that have a USER-DEFINED `drop` method (an
    # `equip <T> with Drop:` whose body runs observable side effects, e.g.
    # `print(...)`). Populated by a pre-pass over `m.items` in `lower_module`
    # (BEFORE any function body is lowered, so the signal is available when
    # `main` is lowered — independent of `gmod.functions` push ordering).
    # Read by the `CloneAndMove` SVarDecl arm: a Branch C-pre ptr-clone of a
    # type WITHOUT a user drop registers for drop (frees the deref-clone's
    # fresh heap — fixes the leak, no observable print). A type WITH a user
    # drop keeps the leak-but-stdout-correct skip (registering would run the
    # user drop a SECOND time, double-printing vs the borrow-no-drop oracle).
    # Typed real-declared-property discriminator, not a name match. Appended
    # AT END to avoid shifting positional ctor call sites.
    Dict[String, bool] types_with_user_drop
    # Set of mangled method names already pushed onto `functions` from
    # `lower_equip_block`. The lazy-adapter chain (`iter_map_inference`-class)
    # reaches `lower_equip_block` for the SAME monomorphized receiver method
    # (`Vector__int64_t__iter` / `VectorDrain__int64_t__drop`) from both an
    # explicit `MapIter[…]` annotation AND the `.map()` chain → the body is
    # emitted TWICE → a C `redefinition` link error. This dedup guards the
    # `lower_equip_block` push only (a localized, pre-existing-bug fix): skip
    # re-push when the mangled name was already emitted from this path. A
    # Dict membership set (NOT an O(n) scan; `fn_sigs` is keyed by return-type,
    # not emit-status, so a fresh set is needed). Appended AT END to avoid
    # shifting positional ctor call sites.
    Dict[String, bool] emitted_fns
    # P0 default-arg fill: per-fn, the parsed default expression for each
    # param (None if the param has no default). Parallel to fn_borrow_params /
    # fn_move_params, registered at every `.put` sibling in the pre-scan +
    # mono'd-ctor + equip-short-key paths. The call-site fill in
    # lower_call (lower_expr.gg) reads `fn_defaults[call_name][idx]` for the
    # trailing param slots an explicit call left unfilled and lowers the
    # default expr with the param's expected type. Mirrors Rust gg's
    # `ctx.fn_defaults` (`src/ir/lowering/mod.rs:680-688`) read by
    # `resolve_call_args` (`src/ir/lowering/exprs/calls.rs:386-445`). Appended
    # AT END to avoid shifting positional ctor call sites.
    Dict[String, Vector[Option[SpannedExpr]]] fn_defaults
    # thread_spawn(fn[, stack_size]) registrations. Populated by the
    # `thread_spawn` intrinsic in lower_call (lower_expr.gg); flows to
    # `LirModule.thread_spawned_fns` in lower_gir_to_lir, then to the
    # per-fn wrapper emit in lir_codegen. Mirrors Rust gg's
    # `module.runtime.thread_spawned_fns` (`src/ir/mod.rs:103`).
    # First-write-wins per fn_name (one stack size per fn). Appended AT END
    # to avoid shifting positional ctor call sites.
    Vector[ThreadSpawnRec] thread_spawned_fns
    # Test-runner registry: one ordered entry per `test` block (in SOURCE
    # order, including `@skip`ped tests which emit NO `__test_N` body). Mirrors
    # Rust gg's `module.runtime.test_fns: Vec<TestFnInfo>` (`src/ir/mod.rs:30`),
    # populated at test-body lowering (`src/ir/lowering/mod.rs:3086`). Copied
    # 1:1 into `LirModule.test_fns` at GIR→LIR; the runner-`main` synthesis in
    # lir_codegen iterates it to print the human-readable test name + drive
    # skip / should_panic reporting — matching the Rust oracle. Empty for
    # non-test modules. Appended AT END to avoid shifting positional ctor call
    # sites.
    Vector[GirTestFn] test_fns
    # Order-independent per-fn DECLARED param VALUE-type ids, keyed by fn name.
    # Populated in the authoritative fn_sigs pre-pass (lower.gg ~:3522, the
    # `IFunction(fsdef)` arm) over ALL module functions BEFORE any body is
    # lowered — so a caller that calls a callee defined TEXTUALLY BELOW it (a
    # forward reference, absent from `gmod.functions` at the caller's lower
    # time) can still recover the callee's param types. Read ONLY as a FALLBACK
    # by `get_fn_param_types` (lower_types.gg) when the primary `gmod.functions`
    # scan misses: the lowered scan returns ABI-WRAPPED (Ptr/MutPtr) tids that
    # the consumer's `&*b`/`!*b` by-pointer detection relies on, so it stays the
    # primary; this fallback only fills the forward-ref hole with the unwrapped
    # VALUE types (the consumer's GtPtr peel handles value types as a correct
    # no-op, and `&`-param detection still works via the order-independent
    # `fn_borrow_params` map). Without this, a bare `None` arg to a forward-ref
    # callee gets NO expected type (the `ai < callee_param_types.len()` guard
    # fails) and lowers to a zeroed `(Option__T){0}` (tag 0 = Some) → segfault.
    # Mirrors Rust gg's order-independent `ctx.fn_sigs` pre-pass
    # (`src/ir/lowering/mod.rs:656`). Same class/shape as fn_borrow_params /
    # fn_move_params / fn_defaults / types_with_user_drop. Appended AT END to
    # avoid shifting positional ctor call sites.
    Dict[String, Vector[int]] fn_param_sigs
    # closure Phase 2 increment 3: typed return-type side-channel for a
    # CALLABLE-valued LOCAL, keyed `<fn_name>\0<int_to_str(local_id)>`. The
    # closure VALUE local is deliberately typed `GorgetClosure` (env-erased,
    # so the heap env is droppable — see the make-site `add_local(...,
    # closure_tid, None)`), which LOSES the closure's FnPtr return type. At a
    # call `print(greet("world"))` the `ECall(EIdentifier(greet))` arm has no
    # `GtFnPtr` to read a return tid from and (in a non-return context) no
    # `ctx.expected_type` either → it defaulted the indirect call to an
    # `int64_t`-return cast. For a `String` (>16B, SysV hidden-sret) result
    # that shifts env-ptr/sret/args → corruption → SIGSEGV. This channel
    # records the closure-sig return type at the make-site (under the
    # GorgetClosure value's `cdst` local id) so the call site can recover it.
    # Mirrors Rust gg's `callable_return_types` side-channel
    # (`src/ir/lowering/context.rs:192`, read at `calls.rs:1208`). Reuses the
    # exact `closure_env_type` composite-per-function key idiom (GIR local-ids
    # are per-function — a bare-int key would COLLIDE across functions). The
    # SVarDecl MoveDirect arm copies the entry onto the fresh `var_local` it
    # mints, exactly as `closure_env_type` does. The call-site read is GATED
    # on `!= UNIT_TYPE` (compute_closure_sig mis-infers a match/if-tail-value
    # body as UNIT — a separate filed gap — and a void-return cast of a used
    # result is a `void value not ignored` CC-FAIL; the guard lets those fall
    # through to the correct baseline `expected_type` path). Single source of
    # truth, one accessor — Layering rule 3. Appended AT END to avoid shifting
    # positional ctor call sites.
    Dict[String, int] closure_value_ret_type
    # Order-independent per-fn ordered DECLARED param NAMES, keyed by fn name.
    # Populated in the authoritative fn_param_sigs pre-pass (lower.gg, the
    # `IFunction(fsdef)` arm) over ALL module functions BEFORE any body is
    # lowered. Read by `lower_call` to REORDER a call's args into parameter
    # order: a named arg that skips a middle DEFAULTED param must land in its
    # by-NAME slot, not the next positional slot (the append-only default-fill
    # cannot recover a mid-skipped slot — `compute(5, offset=10)` would put
    # `offset` into `factor`'s slot). Mirrors Rust gg's `ctx.fn_param_names`
    # (`src/ir/lowering/mod.rs`), read by `resolve_call_args`
    # (`src/ir/lowering/exprs/calls.rs:386-445`). Same class/shape as
    # fn_param_sigs / fn_borrow_params / fn_defaults. Appended AT END to avoid
    # shifting positional ctor call sites.
    Dict[String, Vector[String]] fn_param_names
    # Type name → trait names the type explicitly implements, backing the
    # compile-time `implements(T, "Trait")` meta-predicate. Populated by a
    # pre-pass over `m.items` in `lower_module` (before any function body is
    # lowered) scanning every `IEquip(EquipBlock(target, trait_name))`, which
    # captures both user-written `equip X with Trait` and derive-synthesized
    # equips (expand_derives runs first, driver.gg:389). Read by the
    # `implements` arm of `eval_delayed_meta_cond`. Intrinsic-primitive
    # satisfaction (numeric primitives satisfy numeric traits, etc.) is NOT
    # stored here — it holds by the primitive's nature and is computed in the
    # arm. This is the impl-table half of Rust's
    # `TraitRegistry::has_trait_impl_by_name` (`src/semantic/traits.rs:331`).
    # Appended AT END to avoid shifting positional ctor call sites.
    Dict[String, Vector[String]] trait_impls_by_type
    # `spawn fn(args)` registrations for NAMED functions (Inc-1: int+void
    # returns, scalar by-value params). Populated by the `ESpawn` arm in
    # lower_expr; flows to `LirModule.spawned_fns` in lower_gir_to_lir, then
    # to the per-fn spawn/await helper emit (`emit_spawn_helpers`) in
    # lir_codegen. Mirrors Rust gg's `ctx.spawn.fn_names` → `LirSpawnedFn`
    # pipeline (`src/ir/lowering/exprs/mod.rs:1391-1404` →
    # `src/backend/c_lir/emit_types.rs:382-540`). Deduped by fn_name at the
    # write site. Appended AT END to avoid shifting positional ctor call sites.
    Vector[SpawnFnRec] spawned_fns
    # Active scheduler mode for this module (SCHED_* constant from lir.gg).
    # Set from the `directive scheduler=<mode>` module item in `lower_module`
    # (mirrors Rust gg's `LoweringContext.scheduler_mode`, populated from the
    # `IDirective("scheduler", value)` directive). Threaded into
    # `new_lir_module` so codegen selects the matching scheduler runtime
    # (`scheduler_single_runtime.c` for `scheduler=single`, the deterministic
    # single-thread executor the `shared_stale_*` fixtures rely on). Defaults
    # to SCHED_POOL (0) — the same value the LirModule ctor formerly hardcoded.
    # Appended AT END to avoid shifting positional ctor call sites.
    int scheduler_mode
    # round-16 Phase-2 (async splice): pending `__shared_async_<callee>` variant
    # requests, recorded at each `spawn <async-callee>(&shared)` site by
    # `lower_shared_spawn` and processed AFTER all functions are lowered by the
    # GIR→GIR post-pass driver (`process_pending_shared_async`, mirrors Rust gg's
    # `src/ir/lowering/mod.rs:1547-1620` over `pending_shared_variants`). Deduped
    # by `variant_name` at the write site. Appended AT END to avoid shifting
    # positional ctor call sites.
    Vector[PendingSharedAsync] pending_shared_async
    # round-16 Phase-2 (async splice): function-name → true iff that function's
    # AST body contains a suspension (`.await()` or a blocking call). Computed by
    # a pre-pass over `m.items` at the TOP of `lower_module` (before any body is
    # lowered) so `lower_shared_spawn` — which runs DURING lowering — can pick
    # `__shared_async_<callee>` (async) vs `__shared_token_<callee>` (sync) for a
    # shared spawn. Mirrors Rust gg's per-callee `callee_has_awaits`
    # (`src/ir/lowering/exprs/mod.rs:1247-1250`). Appended AT END to avoid
    # shifting positional ctor call sites.
    Dict[String, bool] async_fns
    # Trait-object dispatch: maps `<MangledTrait>__<method>` → the method's
    # VTable SLOT INDEX (its 0-based position among the trait's self-methods,
    # in declaration order). Populated by the `_VTable` struct-typedef pre-pass
    # (lower.gg ~:4055) at the SAME loop that assigns `slot<idx>` fields — one
    # source of truth for the slot ordering (Layering rule 3). Read by the
    # `Box__<Trait>__<method>` trait-dispatch call intercept (lir_lower) to
    # populate the dispatch-thunk request with the correct vtable slot. Empty
    # for modules with no user trait. Appended AT END to avoid shifting
    # positional ctor call sites.
    Dict[String, int] trait_method_slot
    # Typed payload channel for `Thread[T]` handle types: the name-deduped
    # `Thread__{T}` GIR type id → T's GIR type id (UNIT_TYPE for
    # `Thread[void]`). Written via `record_thread_payload` at every
    # Thread-handle MINT site — the `map_ast_type` TNamed arm and the
    # `resolved_to_gir_type` RTGeneric arm (annotations / params / fields)
    # plus the `thread_spawn` intrinsic in lower_call (unannotated spawns).
    # Read via `thread_payload_tid_of` by the join/id method intercept in
    # lower_expr, so the join result type comes from typed metadata, NOT
    # from slicing the payload name out of the `Thread__` prefix and
    # re-deriving a tid from it (CLAUDE.md "No name matching"; Layering
    # rule 3 — one source of truth, one accessor). Mirrors Rust gg's
    # `TypeMapper.thread_payload_types` (`src/ir/lowering/types.rs`).
    # Appended AT END to avoid shifting positional ctor call sites.
    Dict[int, int] thread_payload_tids
    # R43-C: every TOP-LEVEL free-function's AST definition, keyed by name.
    # Read by `infer_free_fn_targs` (lower_expr.gg) to (a) recover a generic
    # callee's `type_params` + param types for structural arg-type binding and
    # (b) resolve a call-arg's concrete type from a non-generic callee's
    # declared return type. Populated once in `lower_module` alongside
    # `fn_templates`. Lets the discovery pre-pass (lower_generics) AND the
    # per-call mangle site (lower_expr) compute the SAME inferred type-args for
    # a turbofish-free generic free-fn call (`passthrough(producer())`),
    # mirroring Rust gg's `inferred_call_targs` side-table. Appended AT END.
    Dict[String, FunctionDef] fn_ast_defs

# Per-test metadata mirroring Rust's `TestFnInfo` (`src/ir/mod.rs:30`).
# `fn_name` is the emitted `__test_N` symbol ("" for a skipped test, which
# has no body). `display_name` is the source `test "name"` string.
struct GirTestFn:
    String fn_name
    String display_name
    bool should_panic
    String expected_panic_msg   # "" if none
    bool skipped
    String skip_reason          # "" if none

# ── Helpers ──────────────────────────────────────────────

# Record the typed payload types for a mono'd Option/Result enum (the
# single writer for the `enum_category` channel — Layering rule 4,
# "resolve once, write through"). Called at each MINT site where the typed
# payload tids are in hand. `enum_tid` is the name-deduped enum GIR id;
# `ok_tid` is the Some_0/Ok_0 payload; `err_tid` is the Error_0 payload
# (pass -1 for an Option). First-write-wins (the mint is the same
# name-deduped id every time, so a re-record is identical).
void record_enum_category(GirModule &gmod, int enum_tid, int category, int ok_tid, int err_tid):
    if enum_tid < 0:
        return
    if gmod.enum_category.contains(enum_tid):
        return
    gmod.enum_category.put(enum_tid, EnumCategory(category, ok_tid, err_tid))

# Module-level static (runtime-call init) accessors.
bool static_contains(GirModule gmod, String name):
    return gmod.statics.contains(name)

int static_lookup_type(GirModule gmod, String name):
    if gmod.statics.contains(name):
        return gmod.statics.get(name).unwrap().type_id
    return -1

void static_put(GirModule &gmod, String name, String init_expr, int type_id):
    gmod.statics.put(name.clone(), GirStaticInfo(init_expr.clone(), type_id, GGSTATIC_RUNTIME))

# Register a scalar-literal static whose `init_expr` is a const C literal
# (`42LL`, `2.5`, `1`/`0`) emitted at the declaration — NO synth init fn,
# NO main-prologue call. Mirrors Rust's `GlobalInit::Bytes`
# (`src/ir/lowering/mod.rs:2459-2461`, C emit `c_lir/mod.rs:764-767`).
void static_put_bytes(GirModule &gmod, String name, String init_expr, int type_id):
    gmod.statics.put(name.clone(), GirStaticInfo(init_expr.clone(), type_id, GGSTATIC_BYTES))

# Append a const-init global (vtable) to the module; returns its index.
# Mirrors Rust gg pushing onto `module.globals` in `emit_vtable_globals`.
int gir_mod_add_global(GirModule &gmod, GirGlobal g):
    int id = gmod.globals.len()
    gmod.globals.push(g)
    return id

# Scan registered enums to find one that declares a given variant.
# Mirrors Rust's `resolve_enum_variant` fallback used by the pattern
# lowerer when the scrutinee's type can't be resolved. Returns empty
# string if no enum has this variant (or if multiple do — we pick the
# first to stay deterministic).
String find_enum_by_variant(GirModule gmod, String variant_name):
    String result = ""
    Vector[String] enum_names = gmod.enum_registry.keys()
    int i = 0
    while i < enum_names.len():
        String enum_name = enum_names.get(i).unwrap()
        Vector[String] vs = gmod.enum_registry.get(enum_name).unwrap()
        int j = 0
        while j < vs.len():
            String vn = vs.get(j).unwrap()
            if vn == variant_name and result == "":
                result = enum_name.clone()
            j += 1
        i += 1
    return result

# Look up the variant index (ordinal) for a given enum + variant.
int enum_variant_index(GirModule gmod, String enum_name, String variant_name):
    if not gmod.enum_registry.contains(enum_name):
        return -1
    Vector[String] vs = gmod.enum_registry.get(enum_name).unwrap()
    int j = 0
    while j < vs.len():
        String vn = vs.get(j).unwrap()
        if vn == variant_name:
            return j
        j += 1
    return -1

Vector[GirType] init_type_table():
    Vector[GirType] t = []
    t.push(GtBool())
    t.push(GtI8())
    t.push(GtI16())
    t.push(GtI32())
    t.push(GtI64())
    t.push(GtU8())
    t.push(GtU16())
    t.push(GtU32())
    t.push(GtU64())
    t.push(GtF32())
    t.push(GtF64())
    t.push(GtUnit())
    return t

int register_type(GirModule &gmod, GirType gt):
    int id = gmod.type_table.len()
    gmod.type_table.push(gt)
    return id

int lookup_or_register_named(GirModule &gmod, String name):
    if gmod.named_types.contains(name):
        return gmod.named_types.get(name).unwrap()
    int id = register_type(&gmod, GtNamed(name.clone()))
    gmod.named_types.put(name, id)
    return id

int register_ptr(GirModule &gmod, int inner):
    return register_type(&gmod, GtPtr(inner))

# Phase 2b (option_ref_borrow): record / query the typed payload `GtPtr`
# id for a borrowing-getter Option type id. The single accessor for the
# `option_ref_payload` channel (Layering rule 3).
void record_option_ref_payload(GirModule &gmod, int option_tid, int ptr_tid):
    gmod.option_ref_payload.put(option_tid, ptr_tid)

# Peel `GtPtr`/`GtMutPtr` wrappers off `tid`, returning the innermost
# non-pointer id — the key the typed `enum_category` / `option_ref_payload`
# channels are recorded under (`record_enum_category`/`record_option_ref_payload`
# key on the BARE `lookup_or_register_named` id). The self-host Ptr-wraps `&`/`!`
# params (`GtMutPtr`) and bare resource-payload params (`GtPtr`) at the
# type-table level, and receivers/projections can be Ptr aliases too; Rust gg
# models borrows via a SEPARATE ownership channel so its `enum_category(type_id)`
# never peels, but the self-host's pointer-in-the-tid representation means the
# faithful equivalent is to peel here. The three channel accessors call this so
# a borrowed/projected/param alias still classifies as its pointee type. Layering
# rule 3: the peel lives in ONE place, structurally unavoidable, not re-derived
# at each reader (the call-site `peel`-then-read drift was the bug class this
# closes). A pointer-to-Option IS an Option for the type-classification question.
int peel_ptr_tid(GirModule &gmod, int tid):
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtPtr(inner):
                return peel_ptr_tid(&gmod, inner)
            case GtMutPtr(inner):
                return peel_ptr_tid(&gmod, inner)
            else:
                pass
    return tid

# Returns the payload `GtPtr` id for an `Option__Ref__T` type id, or -1
# if this Option is a plain value-payload Option (pop/remove/user enums).
# Peels Ptr/MutPtr aliases first (see `peel_ptr_tid`).
int option_ref_payload_of(GirModule &gmod, int option_tid):
    int t = peel_ptr_tid(&gmod, option_tid)
    if gmod.option_ref_payload.contains(t):
        return gmod.option_ref_payload.get(t).unwrap()
    return -1

# Record the typed payload tid for a `Thread__{T}` handle type — the single
# writer for the `thread_payload_tids` channel (Layering rule 4, resolve
# once / write through). Called at each MINT site where the payload tid is
# in hand: the `map_ast_type` TNamed arm + `resolved_to_gir_type` RTGeneric
# arm (annotations / params / fields) and the `thread_spawn` intrinsic in
# lower_call (unannotated spawns). `payload_tid` is UNIT_TYPE for
# `Thread[void]`. First-write-wins (the handle id is name-deduped, so a
# re-record is identical). Mirrors `record_enum_category`.
void record_thread_payload(GirModule &gmod, int thread_tid, int payload_tid):
    if thread_tid < 0:
        return
    if gmod.thread_payload_tids.contains(thread_tid):
        return
    gmod.thread_payload_tids.put(thread_tid, payload_tid)

# The typed thread-payload accessor: a `Thread__{T}` handle tid → T's tid
# (UNIT_TYPE for `Thread[void]`), or -1 when the (Ptr/MutPtr-peeled) tid is
# not a Thread handle. The join/id method intercept in lower_expr dispatches
# on THIS (typed metadata) instead of a `Thread__` name-prefix test; the
# receiver's type NAME is used only to spell the `Thread__{T}__join`/`__id`
# helper symbol (the symbol axis, where the name IS the contract with the
# emitted helpers). Mirrors `option_ref_payload_of`.
int thread_payload_tid_of(GirModule &gmod, int thread_tid):
    int t = peel_ptr_tid(&gmod, thread_tid)
    if gmod.thread_payload_tids.contains(t):
        return gmod.thread_payload_tids.get(t).unwrap()
    return -1

# True iff `enum_tid` (Ptr/MutPtr-peeled) was recorded as a mono'd
# Option/Result on the typed `enum_category` channel. The single membership
# accessor (Layering rule 3).
bool has_enum_category(GirModule &gmod, int enum_tid):
    return gmod.enum_category.contains(peel_ptr_tid(&gmod, enum_tid))

# The recorded `EnumCategory` for `enum_tid` (Ptr/MutPtr-peeled), or a sentinel
# `EnumCategory(-1, -1, -1)` if none was recorded. Callers gate on
# `has_enum_category` (or on `.category >= 0`) before trusting the
# payloads. Single read accessor for the channel (Layering rule 3).
EnumCategory enum_category_of(GirModule &gmod, int enum_tid):
    int t = peel_ptr_tid(&gmod, enum_tid)
    if gmod.enum_category.contains(t):
        return gmod.enum_category.get(t).unwrap()
    return EnumCategory(-1, -1, -1)
