# GIR (Gorget Intermediate Representation) data structures.
# Mirrors the Rust types in src/ir/ for self-hosted IR lowering.

from std.collections import Vector
from std.conv import int_to_str

# ── Pre-allocated primitive type IDs ───────────────────────

const int BOOL_TYPE = 0
const int I8_TYPE = 1
const int I16_TYPE = 2
const int I32_TYPE = 3
const int I64_TYPE = 4
const int U8_TYPE = 5
const int U16_TYPE = 6
const int U32_TYPE = 7
const int U64_TYPE = 8
const int F32_TYPE = 9
const int F64_TYPE = 10
const int UNIT_TYPE = 11
const int PRIM_COUNT = 12

# ── GIR type representation ───────────────────────────────

enum GirType:
    GtBool()
    GtI8()
    GtI16()
    GtI32()
    GtI64()
    GtU8()
    GtU16()
    GtU32()
    GtU64()
    GtF32()
    GtF64()
    GtUnit()
    GtPtr(int)
    GtMutPtr(int)
    GtNamed(String)
    GtFnPtr(Vector[int], int)

# ── Operand — right-hand side value ───────────────────────

enum Operand:
    OpCopy(int)
    OpMove(int)
    OpConstBool(bool)
    OpConstI32(int)
    OpConstI64(int)
    OpConstF64(float)
    OpConstStr(String)
    OpConstUnit()
    OpConstNull()
    OpSizeOf(int)

# ── Binary / comparison operator tags ─────────────────────

const int OP_ADD = 0
const int OP_SUB = 1
const int OP_MUL = 2
const int OP_DIV = 3
const int OP_REM = 4
const int OP_MOD = 5
# Wrapping arithmetic — `+%` / `-%` / `*%` in source. Lower to LIR
# with `OVF_WRAP` so the C codegen emits plain `+` / `-` / `*` rather
# than the trapping `__builtin_*_overflow` form.
const int OP_ADD_WRAP = 6
const int OP_SUB_WRAP = 7
const int OP_MUL_WRAP = 8

# Bitwise — `&` / `|` / `^` / `<<` / `>>`. Lower to the matching
# `IBitAnd` / `IBitOr` / `IBitXor` / `IShl` / `IShr` LIR inst.
const int OP_BITAND = 9
const int OP_BITOR = 10
const int OP_BITXOR = 11
const int OP_SHL = 12
const int OP_SHR = 13

const int CMP_EQ = 0
const int CMP_NE = 1
const int CMP_LT = 2
const int CMP_LE = 3
const int CMP_GT = 4
const int CMP_GE = 5

# ── Instructions ──────────────────────────────────────────

const int UNOP_NEG = 0
const int UNOP_NOT = 1
const int UNOP_BITNOT = 2

enum Instruction:
    GIAssign(int, Operand)
    GIBinOp(int, int, int, Operand, Operand)
    GIUnOp(int, int, int, Operand)
    GICmp(int, int, int, Operand, Operand)
    GICall(int, String, Vector[Operand])
    GICallExtern(int, String, Vector[Operand])
    GIDrop(int)
    GIDropIfAlive(int)
    GIMoveZero(int)
    GIDeref(int, int, int)    # dst_local, src_local (ptr/Box), inner_ty_id
    GINop()

# ── Terminators ───────────────────────────────────────────

enum Terminator:
    GTNone()
    GTReturn(Operand)
    GTJump(int)
    GTBranch(Operand, int, int)

# ── Basic block ───────────────────────────────────────────

struct BasicBlock:
    Vector[Instruction] insts
    Terminator term

# ── Local variable slot ──────────────────────────────────

struct GirLocal:
    int type_id
    Option[String] name_hint

# ── Function ─────────────────────────────────────────────

struct GirFunction:
    String name
    Vector[int] param_types
    int return_type
    Vector[GirLocal] locals
    Vector[BasicBlock] blocks

# ── Extern declaration ───────────────────────────────────

struct GirExtern:
    String name
    bool is_variadic
    int return_type

# ── Module ───────────────────────────────────────────────

# Struct/enum field info for drop/clone analysis in LIR lowering.
struct GirFieldInfo:
    String name
    String type_name  # resolved type name (e.g., "GorgetString", "Vector__int64_t")

struct GirEnumVariantInfo:
    String name
    Vector[GirFieldInfo] fields

struct GirTypeInfo:
    String name
    Vector[GirFieldInfo] fields          # struct fields
    Vector[GirEnumVariantInfo] variants  # enum variants (empty for structs)
    bool is_enum

# Module-level static with a runtime-call initializer (lib/std/io.gg's
# `public static File stdout = _stdout_handle()` etc.).
struct GirStaticInfo:
    String init_expr  # C expression — currently always `gorget_<sym>()`
    int type_id       # GIR type id of the declared type

struct GirModule:
    Vector[GirFunction] functions
    Vector[GirExtern] externs
    Vector[GirType] type_table
    Dict[String, int] fn_sigs
    Dict[String, int] named_types  # name → type id; deduped GtNamed registration
    Dict[String, bool] resource_types
    Dict[String, int] type_subs
    Dict[String, String] meta_aliases
    Dict[String, String] call_redirects
    Dict[String, bool] imported_fns
    Dict[String, GirTypeInfo] type_infos  # struct/enum field info for LIR drop analysis
    Dict[String, Vector[bool]] fn_borrow_params  # per-param: true if borrow (&)
    # Module-level int constants and None-typed sentinel decls.
    Dict[String, int] const_decls
    Dict[String, bool] none_decls
    # Enum registry — used by `find_enum_by_variant` for the inverted
    # variant→enum lookup and by `enum_variant_index` for ordinal
    # resolution. Mirrors Rust's `ctx.resolve_enum_variant`.
    Dict[String, Vector[String]] enum_registry
    # Float constants. Module-level `float EPSILON = 0.000001` etc.
    # lands here so `EIdentifier(EPSILON)` can inline an
    # `OpConstF64(value)` rather than emitting a `[bug] EIdentifier:
    # unknown identifier 'EPSILON'` placeholder. Mirrors Rust gg's
    # unified `module_constants: FxHashMap<String, Constant>` which
    # stores both `Constant::I64` and `Constant::F64` in one table.
    Dict[String, float] float_const_decls
    # Module-level statics with a runtime-call initializer —
    # `public static File stdout = _stdout_handle()` etc. in lib/std/io.gg.
    # Mirrors Rust gg's `LoweringContext::global_names` + `module.globals:
    # Vec<Global>` (`src/ir/lowering/mod.rs:1074-1111`). The init is a
    # zero-arg function call mapped to a C-runtime symbol; `EIdentifier`
    # references resolve through `__global_ref__<name>` in lir_lower
    # against a parallel name→gid map populated by `lir_mod_add_global`.
    Dict[String, GirStaticInfo] statics

# ── Helpers ──────────────────────────────────────────────

# Module-level static (runtime-call init) accessors.
bool static_contains(GirModule &gmod, String name):
    return gmod.statics.contains(name)

String static_lookup_init(GirModule &gmod, String name):
    if gmod.statics.contains(name):
        return gmod.statics.get(name).unwrap().init_expr.clone()
    return ""

int static_lookup_type(GirModule &gmod, String name):
    if gmod.statics.contains(name):
        return gmod.statics.get(name).unwrap().type_id
    return -1

void static_put(GirModule &gmod, String name, String init_expr, int type_id):
    gmod.statics.put(name.clone(), GirStaticInfo(init_expr.clone(), type_id))

# enum registry accessors.
void register_enum(GirModule &gmod, String enum_name, Vector[String] variants):
    if not gmod.enum_registry.contains(enum_name):
        gmod.enum_registry.put(enum_name.clone(), variants)

# Scan registered enums to find one that declares a given variant.
# Mirrors Rust's `resolve_enum_variant` fallback used by the pattern
# lowerer when the scrutinee's type can't be resolved. Returns empty
# string if no enum has this variant (or if multiple do — we pick the
# first to stay deterministic).
String find_enum_by_variant(GirModule &gmod, String variant_name):
    String result = ""
    Vector[String] enum_names = gmod.enum_registry.keys()
    int i = 0
    while i < enum_names.len():
        String enum_name = enum_names.get(i).unwrap()
        Vector[String] vs = gmod.enum_registry.get(enum_name).unwrap()
        int j = 0
        while j < vs.len():
            String vn = vs.get(j).unwrap()
            if vn == variant_name and result == "":
                result = enum_name.clone()
            j += 1
        i += 1
    return result

# Look up the variant index (ordinal) for a given enum + variant.
int enum_variant_index(GirModule &gmod, String enum_name, String variant_name):
    if not gmod.enum_registry.contains(enum_name):
        return -1
    Vector[String] vs = gmod.enum_registry.get(enum_name).unwrap()
    int j = 0
    while j < vs.len():
        String vn = vs.get(j).unwrap()
        if vn == variant_name:
            return j
        j += 1
    return -1

Vector[GirType] init_type_table():
    Vector[GirType] t = []
    t.push(GtBool())
    t.push(GtI8())
    t.push(GtI16())
    t.push(GtI32())
    t.push(GtI64())
    t.push(GtU8())
    t.push(GtU16())
    t.push(GtU32())
    t.push(GtU64())
    t.push(GtF32())
    t.push(GtF64())
    t.push(GtUnit())
    return t

int register_type(GirModule &gmod, GirType gt):
    int id = gmod.type_table.len()
    gmod.type_table.push(gt)
    return id

int lookup_or_register_named(GirModule &gmod, String name):
    if gmod.named_types.contains(name):
        return gmod.named_types.get(name).unwrap()
    int id = register_type(&gmod, GtNamed(name.clone()))
    gmod.named_types.put(name, id)
    return id

int register_ptr(GirModule &gmod, int inner):
    return register_type(&gmod, GtPtr(inner))
