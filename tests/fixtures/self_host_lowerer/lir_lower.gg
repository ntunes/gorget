# GIR → LIR lowering.
#
# Transforms the high-level GIR (Gorget IR) into low-level LIR (SSA-form IR).
# All implicit operations (drop glue, coercions, vtable dispatch) become
# explicit LIR instructions.

from gir import GirModule, GirFunction, GirLocal, GirType, GirExtern, BasicBlock, Instruction, Terminator, Operand
from gir import GirTypeInfo, GirFieldInfo, GirEnumVariantInfo
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE
from gir import U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE, PRIM_COUNT
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT
from lir import LirModule, LirFunction, LirBlock, LirInst, LirTerm, LirSlot, LirStructDef, LirExtern, LirGlobal
from lir import StructField, BlockParam, SwitchCase, FieldDrop, EnumVariantDrop, TypeDropInfo, FieldInit
from lir import LT_I8, LT_I16, LT_I32, LT_I64, LT_U8, LT_U16, LT_U32, LT_U64
from lir import LT_F32, LT_F64, LT_BOOL, LT_PTR, LT_VOID
from lir import LT_PTR_TO_BASE, LT_STRUCT_BASE
from lir import EK_NOT_ENUM, EK_OPTION
from lir import lir_ptr_to, lir_struct, lir_is_scalar, lir_is_aggregate
from lir import OVF_TRAP, OVF_WRAP
from lir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from lir import ABI_AUTO
from lir import SCHED_POOL
from lir import lir_fn_next_value, lir_fn_add_slot, lir_fn_add_block
from lir import lir_push_inst, lir_set_term
from lir import lir_mod_add_struct, lir_mod_add_function, new_lir_module
from lower import get_fn_param_types
from std.collections import Vector, Dict
from std.conv import int_to_str
from std.conv import float_to_bits
from gir import ResourceMetadata
from gir import BorrowOrigin, BoCollectionElement
from gir import CopySemantics, CsTrivial, CsResource, CsRefCounted
from gir import CollectionKind, CkNotCollection, CkVector, CkDeque, CkHeap, CkDict, CkSet
from gir import BoxKind, BkNotBox, BkRegularBox, BkTraitBox
from compiler.data.resources import RESOURCES
from compiler.data.schema import ResourceEntry, MatchKind, MkExact, MkPrefix
from compiler.data.schema import LirType, LtStructBase, LtPtr


# ── Builtin struct definitions ──────────────────────────────

void register_builtin_structs(LirModule &m, Dict[String, int] &sr):
    # GorgetString: {data: Ptr, cap: I64, len: I64, alloc: Ptr}
    Vector[StructField] str_fields = []
    str_fields.push(StructField("data", LT_PTR))
    str_fields.push(StructField("cap", LT_I64))
    str_fields.push(StructField("len", LT_I64))
    str_fields.push(StructField("alloc", LT_PTR))
    int str_id = lir_mod_add_struct(&m, LirStructDef("GorgetString", str_fields, 0, false, 32, -1))
    sr.put("GorgetString", str_id)
    sr.put("Str", str_id)
    m.type_runtime_map.put("GorgetString", "GorgetString")
    m.type_runtime_map.put("String", "GorgetString")
    m.type_runtime_map.put("Str", "GorgetString")

    # GorgetArray: {data: Ptr, cap: I64, len: I64, elem_size: I64}
    Vector[StructField] arr_fields = []
    arr_fields.push(StructField("data", LT_PTR))
    arr_fields.push(StructField("cap", LT_I64))
    arr_fields.push(StructField("len", LT_I64))
    arr_fields.push(StructField("elem_size", LT_I64))
    int arr_id = lir_mod_add_struct(&m, LirStructDef("GorgetArray", arr_fields, 0, false, 64, -1))
    sr.put("GorgetArray", arr_id)
    m.type_runtime_map.put("GorgetArray", "GorgetArray")

    # GorgetClosure: {fn_ptr: Ptr, env: Ptr}
    Vector[StructField] cls_fields = []
    cls_fields.push(StructField("fn_ptr", LT_PTR))
    cls_fields.push(StructField("env", LT_PTR))
    int cls_id = lir_mod_add_struct(&m, LirStructDef("GorgetClosure", cls_fields, 0, false, 16, -1))
    sr.put("GorgetClosure", cls_id)

    # TraitObj: {data: Ptr, vtable: Ptr}
    Vector[StructField] trait_fields = []
    trait_fields.push(StructField("data", LT_PTR))
    trait_fields.push(StructField("vtable", LT_PTR))
    int trait_id = lir_mod_add_struct(&m, LirStructDef("TraitObj", trait_fields, 0, false, 16, -1))
    sr.put("TraitObj", trait_id)

    # TaskHandle: {task_ptr: Ptr, drop_fn: Ptr}
    Vector[StructField] task_fields = []
    task_fields.push(StructField("task_ptr", LT_PTR))
    task_fields.push(StructField("drop_fn", LT_PTR))
    int task_id = lir_mod_add_struct(&m, LirStructDef("TaskHandle", task_fields, 0, false, 16, -1))
    sr.put("TaskHandle", task_id)

    # GorgetMap: 23 fields, 184 bytes
    Vector[StructField] map_fields = []
    map_fields.push(StructField("keys", LT_PTR))
    map_fields.push(StructField("cap", LT_I64))
    map_fields.push(StructField("values", LT_PTR))
    map_fields.push(StructField("states", LT_PTR))
    map_fields.push(StructField("count", LT_I64))
    map_fields.push(StructField("key_size", LT_I64))
    map_fields.push(StructField("val_size", LT_I64))
    map_fields.push(StructField("alloc", LT_PTR))
    map_fields.push(StructField("order", LT_PTR))
    map_fields.push(StructField("order_len", LT_I64))
    map_fields.push(StructField("tombstones", LT_I64))
    map_fields.push(StructField("hash_fn", LT_PTR))
    map_fields.push(StructField("eq_fn", LT_PTR))
    int map_id = lir_mod_add_struct(&m, LirStructDef("GorgetMap", map_fields, 0, false, 184, -1))
    sr.put("GorgetMap", map_id)
    m.type_runtime_map.put("GorgetMap", "GorgetMap")

    # GorgetSet: same layout as GorgetMap
    Vector[StructField] set_fields = []
    set_fields.push(StructField("keys", LT_PTR))
    set_fields.push(StructField("cap", LT_I64))
    set_fields.push(StructField("values", LT_PTR))
    set_fields.push(StructField("states", LT_PTR))
    set_fields.push(StructField("count", LT_I64))
    set_fields.push(StructField("key_size", LT_I64))
    set_fields.push(StructField("val_size", LT_I64))
    set_fields.push(StructField("alloc", LT_PTR))
    set_fields.push(StructField("order", LT_PTR))
    set_fields.push(StructField("order_len", LT_I64))
    set_fields.push(StructField("tombstones", LT_I64))
    set_fields.push(StructField("hash_fn", LT_PTR))
    set_fields.push(StructField("eq_fn", LT_PTR))
    int set_id = lir_mod_add_struct(&m, LirStructDef("GorgetSet", set_fields, 0, false, 184, -1))
    sr.put("GorgetSet", set_id)
    m.type_runtime_map.put("GorgetSet", "GorgetSet")

    # GorgetRange: {start: I64, end: I64, step: I64}
    Vector[StructField] range_fields = []
    range_fields.push(StructField("start", LT_I64))
    range_fields.push(StructField("end", LT_I64))
    range_fields.push(StructField("step", LT_I64))
    int range_id = lir_mod_add_struct(&m, LirStructDef("GorgetRange", range_fields, 0, false, 24, -1))
    sr.put("GorgetRange", range_id)

# ── Type mapping: GIR type ID → LIR type ───────────────────

# Map a collection name pattern to its runtime struct name. Phase A
# typed-metadata read via `resource_meta_for` (lazy-populating
# accessor); the prefix cascade lives in `build_resource_metadata`
# (single source of truth).
String collection_runtime_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkNotCollection():
                    return ""
                else:
                    return rmeta.runtime_name
        case None:
            return ""
    return ""

# Phase A typed-metadata read via `resource_meta_for`; the prefix
# cascade lives in `build_resource_metadata` (single source of truth).
# The `Heap__` prefix that the legacy cascade marked as opaque is
# now classified as its own `CkHeap` collection kind (same
# GorgetArray runtime as Vector/Deque); every caller of this
# helper checks `collection_runtime_type` first, so the previous
# Heap__→true branch never fired in practice.
bool is_opaque_pointer_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            return rmeta.opaque_handle
        case None:
            return false
    return false

# Phase A typed-metadata read via `resource_meta_for`; the prefix
# cascade lives in `build_resource_metadata` (Guard family →
# runtime_name "Guard").
bool is_guard_struct_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            return rmeta.runtime_name == "Guard"
        case None:
            return false
    return false

# ── Phase A — typed resource-metadata builder ──────────────────
# Single source of truth for `is this type a Vector / Dict / Set / Box /
# opaque handle / ...`. Returns Some(meta) for categorised resource
# types; None for trivial / user-defined types. Populated once at
# `lower_gir_to_lir` entry; consumers read instead of re-deriving.
#
# When migrating a `name.starts_with("X__")` site, the right shape is:
#     match resource_meta_for(&gmod, name):
#         case Some(rmeta):
#             match rmeta.collection_kind:
#                 case CkVector(): ...
#                 ...
# (`meta` is a Gorget keyword; binding name avoids the parser conflict.)
# (See `docs/devbook/26-self-host-frontend.md` §3.)

# Iterate RESOURCES, match by Exact/Prefix.
Option[ResourceMetadata] lookup_resource_table(String name):
    for entry in RESOURCES:
        for mk in entry.match_on:
            match mk:
                case MkExact(s):
                    if name == s:
                        return Some(entry.metadata.clone())
                case MkPrefix(p):
                    if name.starts_with(p):
                        return Some(entry.metadata.clone())
    return None

Option[ResourceMetadata] build_resource_metadata(String name):
    # Try the canonical compiler.data.resources table first.
    Option[ResourceMetadata] tbl = lookup_resource_table(name)
    match tbl:
        case Some(m):
            return Some(m)
        case None:
            pass
    # Built-in runtime structs by exact name.
    if name == "GorgetString" or name == "String" or name == "Str":
        return Some(ResourceMetadata(
            "GorgetString", 32, LtStructBase(),
            Some("gorget_string_free"), Some("gorget_string_clone"),
            Some("gorget_string_materialize_inplace"),
            CsResource(), CkNotCollection(), BkNotBox(), false, None, None, false))
    if name == "GorgetArray":
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkVector(), BkNotBox(), false, None, None, false))
    if name == "GorgetMap":
        return Some(ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, false))
    if name == "GorgetSet":
        return Some(ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkSet(), BkNotBox(), false, None, None, false))
    if name == "GorgetClosure":
        return Some(ResourceMetadata(
            "GorgetClosure", 16, LtStructBase(),
            Some("gorget_closure_free"), Some("gorget_closure_clone"), None,
            CsResource(), CkNotCollection(), BkNotBox(), false, None, None, false))

    # Vector__T → GorgetArray (is_typed_constructor=true).
    if name.starts_with("Vector__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkVector(), BkNotBox(), false, None, None, true))
    # Deque__T → GorgetArray (same runtime, distinct collection kind so
    # downstream can pick double-ended ops without re-prefix-matching).
    if name.starts_with("Deque__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkDeque(), BkNotBox(), false, None, None, true))
    # Heap__T → GorgetArray, but constructed via factory (`Heap.new()`),
    # not the `T(args)` constructor shape.
    if name.starts_with("Heap__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkHeap(), BkNotBox(), false, None, None, false))

    # Dict__K__V / HashMap__K__V — user-code constructors (true);
    # GorgetDict__/GorgetMap__ are self-host mangled forms (false).
    if name.starts_with("Dict__") or name.starts_with("HashMap__"):
        return Some(ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, true))
    if name.starts_with("GorgetDict__") or name.starts_with("GorgetMap__"):
        return Some(ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, false))

    # Set__T / HashSet__T — user-code constructors (true);
    # GorgetSet__ is the self-host mangled form (false).
    if name.starts_with("Set__") or name.starts_with("HashSet__"):
        return Some(ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkSet(), BkNotBox(), false, None, None, true))
    if name.starts_with("GorgetSet__"):
        return Some(ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkSet(), BkNotBox(), false, None, None, false))

    # Box[T] — constructed via runtime alloc helper, not T() shape.
    if name.starts_with("Box__"):
        return Some(ResourceMetadata(
            "Box", 8, LtPtr(),
            None, None, None,
            CsResource(), CkNotCollection(), BkRegularBox(), false, None, None, false))

    # Opaque handles (ref-counted runtime types). Each prefix carries
    # its own method_prefix for the C method-name routing; consumers
    # used to read this via the dedicated `opaque_ptr_method_prefix`
    # cascade (now retired in favour of this typed field).
    # Mutex__/RWLock__/Channel__/Shared__ — `T(args)` user-code
    # constructor shape (is_typed_constructor=true). Other opaque
    # families construct via `T.new()` factories instead.
    if name.starts_with("Mutex__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_mutex"), None, true))
    if name.starts_with("RWLock__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_rwlock"), None, true))
    if name.starts_with("Channel__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_channel"), None, true))
    if name.starts_with("Shared__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_shared"), None, true))
    # Other opaque parameterised families — factory construction shape.
    if name.starts_with("Weak__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_weak"), None, false))
    if name.starts_with("AtomicInt__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_int"), None, false))
    if name.starts_with("AtomicBool__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_bool"), None, false))
    if name.starts_with("Semaphore__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_semaphore"), None, false))
    if name.starts_with("Barrier__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_barrier"), None, false))
    if name.starts_with("OnceFlag__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_once_flag"), None, false))
    if name.starts_with("WaitGroup__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_wait_group"), None, false))
    if name.starts_with("TaskGroup__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_task_group"), None, false))
    if name.starts_with("Thread__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true, None, None, false))

    # Bare-name opaque handles (not parameterised). Method-prefix wiring
    # for these went through a different path historically (direct
    # method dispatch on bare names); leave method_prefix=None.
    if name == "Barrier" or name == "CondVar" or name == "AtomicInt" or name == "AtomicBool" or name == "Process" or name == "Thread" or name == "Semaphore" or name == "WaitGroup" or name == "OnceFlag":
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true, None, None, false))

    # Guard structs — Read/Write variants get their dedicated prefix;
    # the bare Guard__ falls back to "gorget_guard".
    if name.starts_with("ReadGuard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_read_guard"), None, false))
    if name.starts_with("WriteGuard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_write_guard"), None, false))
    if name.starts_with("Guard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_guard"), None, false))

    # Trait box: bare name (no monomorphisation suffix).
    if name == "Box":
        return Some(ResourceMetadata(
            "Box", 8, LtPtr(), None, None, None,
            CsResource(), CkNotCollection(), BkTraitBox(), false, None, None, false))

    # User struct/enum or unknown — caller treats as None.
    return None

# Phase A — typed accessor. Consumers replace `name.starts_with("X__")`
# dispatches with `match resource_meta_for(&gmod, name): case Some(rmeta): ...`
# (See `docs/devbook/26-self-host-frontend.md` §3 / §3.4.)
#
# Lazy population: callers may run BEFORE `lower_gir_to_lir`'s
# bulk-populate loop (e.g. anything inside `lower_module`). When the
# cache misses, fall through to `build_resource_metadata` (the cascade
# source of truth) and memoise the result. After the bulk-populate
# loop runs, every named type is already cached and the slow path
# becomes a single `contains` check.
Option[ResourceMetadata] resource_meta_for(GirModule &gmod, String name):
    if gmod.resource_metadata.contains(name):
        # `.get()` yields `Option[Ref[ResourceMetadata]]`; this fn returns
        # `Option[ResourceMetadata]` (a value). The self-host lowerer's
        # `Option[Ref[T]] → Option[T]` lift (lower.gg `try_lift_option_ref`,
        # wired at the SReturn site) now does the deref + clone at the return
        # boundary — `ResourceMetadata` is a RESOURCE type, so the lift takes
        # its clone branch and yields an owned `Option[ResourceMetadata]`.
        return gmod.resource_metadata.get(name)
    Option[ResourceMetadata] computed = build_resource_metadata(name)
    match computed:
        case Some(rmeta):
            gmod.resource_metadata.put(name.clone(), rmeta.clone())
            return Some(rmeta)
        case None:
            return None
    return None

# Phase A — typed accessor: read method_prefix off the metadata.
# `build_resource_metadata` populates `method_prefix` per-prefix; this
# helper unwraps it via `resource_meta_for` (returns "" when the
# prefix has no method routing — e.g. bare-name opaques like CondVar
# that go through direct method names instead).
String opaque_ptr_method_prefix(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(p):
                    return p
                case None:
                    return ""
        case None:
            return ""
    return ""

# Phase A — typed accessor: read method_prefix off the Guard metadata.
# Defaults to "gorget_guard" for the bare `Guard__` prefix, matching
# the legacy fallback behaviour.
String guard_method_prefix(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(p):
                    return p
                case None:
                    return "gorget_guard"
        case None:
            return "gorget_guard"
    return "gorget_guard"

# Generic template / placeholder type names that should not be emitted as real
# structs in C. These arise from unmonomorphized templates leaking into the
# type table.
bool is_generic_placeholder_name(String name):
    # Mono'd prelude generics (Result__<ok>__E / Option__<inner>) are concrete
    # by construction — built only from RESOLVED return/throws types — even though
    # their fields are synthesized from m.structs (not type_infos keys). The
    # __E/__T suffix check below would otherwise wrongly skip Result__int__E etc.
    if name.starts_with("Result__") or name.starts_with("Option__"):
        return false
    # Single-letter type params: T, E, K, V, U
    if name == "T" or name == "E" or name == "K" or name == "V" or name == "U":
        return true
    # Template ending in a bare type param suffix: TypedColumn__T, Box__T
    if name.ends_with("__T") or name.ends_with("__E") or name.ends_with("__K") or name.ends_with("__V"):
        return true
    # Bare enum variant names (not the Option__X / Result__X parent types)
    if name == "Some" or name == "None" or name == "Ok" or name == "Error" or name == "Err":
        return true
    # C-primitive type aliases that sometimes appear as named types (from
    # field decls like `uint8_t x` being treated as TNamed). They have no
    # struct body — the C preamble provides them via stdint.h.
    if name == "uint8_t" or name == "uint16_t" or name == "uint32_t" or name == "uint64_t":
        return true
    if name == "int8_t" or name == "int16_t" or name == "int32_t" or name == "int64_t":
        return true
    if name == "byte" or name == "size_t" or name == "ssize_t":
        return true
    if name == "float32" or name == "float64" or name == "double":
        return true
    return false

int map_gir_type(int type_id, GirModule &gmod, Dict[String, int] &sr):
    if type_id == BOOL_TYPE:
        return LT_BOOL
    elif type_id == I8_TYPE:
        return LT_I8
    elif type_id == I16_TYPE:
        return LT_I16
    elif type_id == I32_TYPE:
        return LT_I32
    elif type_id == I64_TYPE:
        return LT_I64
    elif type_id == U8_TYPE:
        return LT_U8
    elif type_id == U16_TYPE:
        return LT_U16
    elif type_id == U32_TYPE:
        return LT_U32
    elif type_id == U64_TYPE:
        return LT_U64
    elif type_id == F32_TYPE:
        return LT_F32
    elif type_id == F64_TYPE:
        return LT_F64
    elif type_id == UNIT_TYPE:
        return LT_VOID

    if type_id < 0 or type_id >= gmod.type_table.len():
        return LT_I64

    GirType gt = gmod.type_table.get(type_id).unwrap()
    match gt:
        case GtPtr(inner):
            int inner_ty = map_gir_type(inner, &gmod, &sr)
            int sid = lir_struct_id(inner_ty)
            if sid >= 0:
                return lir_ptr_to(sid)
            return LT_PTR
        case GtMutPtr(inner):
            int inner_ty = map_gir_type(inner, &gmod, &sr)
            int sid = lir_struct_id(inner_ty)
            if sid >= 0:
                return lir_ptr_to(sid)
            return LT_PTR
        case GtNamed(name):
            int sid = sr.get(name).unwrap_or(-1)
            if sid >= 0:
                return lir_struct(sid)
            # Phase A: typed accessor — read populated metadata from
            # the GirModule (populated once at lower_gir_to_lir entry).
            Option[ResourceMetadata] rmeta_opt = resource_meta_for(&gmod, name)
            match rmeta_opt:
                case Some(rmeta):
                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                    if rt_sid >= 0:
                        return lir_struct(rt_sid)
                case None:
                    pass
            return LT_PTR
        case GtFnPtr(_, _):
            int cls_sid = sr.get("GorgetClosure").unwrap_or(-1)
            if cls_sid >= 0:
                return lir_struct(cls_sid)
            return LT_PTR
        else:
            return LT_I64
    return LT_I64

# ── Type definition lowering ────────────────────────────────

# Map a type name (from GirFieldInfo) to an LIR type constant.
# Identify runtime struct names whose `computed_c_size` was set by
# `register_builtin_structs` to match C's actual layout (with
# runtime-only fields like `alloc` that aren't modelled in LirStructDef).
# Pass 4 must skip these — recomputing from the 4 visible fields would
# shrink GorgetArray from 64 to 32 and similarly regress others.
bool is_builtin_runtime_struct(String name):
    if name == "GorgetString" or name == "Str":
        return true
    if name == "GorgetArray" or name == "GorgetMap" or name == "GorgetSet":
        return true
    if name == "GorgetClosure" or name == "TraitObj":
        return true
    if name == "TaskHandle" or name == "GorgetRange":
        return true
    return false

# Ensure a field's type name is resolvable via `sr` so
# `resolve_field_lir_type` doesn't fall through to `LT_PTR`. Called
# from Pass 1c for every struct field and every enum variant field.
# Handles the collection aliases (Vector__*, Dict__*, Set__*, etc.)
# that only appear as field types and never get `lookup_or_register_named`
# treatment during GIR lowering. Silently no-ops for primitives / names
# already registered / types lir_lower doesn't know how to size.
void register_field_type_in_sr(String tname, Dict[String, int] &sr, LirModule &m, GirModule &gmod):
    if tname == "":
        return
    if sr.get(tname).unwrap_or(-1) >= 0:
        return
    # Primitives: no registration needed — resolve_field_lir_type returns
    # the scalar LirType directly.
    if tname == "int64_t" or tname == "int32_t" or tname == "int16_t" or tname == "int8_t":
        return
    if tname == "uint64_t" or tname == "uint32_t" or tname == "uint16_t" or tname == "uint8_t":
        return
    if tname == "double" or tname == "float64" or tname == "float" or tname == "float32":
        return
    if tname == "bool" or tname == "void":
        return
    # Collection aliases → map to the pre-registered runtime struct.
    String rt = collection_runtime_type(tname, &gmod)
    if rt != "":
        int rt_sid = sr.get(rt).unwrap_or(-1)
        if rt_sid >= 0:
            sr.put(tname, rt_sid)
        m.type_runtime_map.put(tname.clone(), rt.clone())
        return
    # Box / Guard / opaque / prelude types we know how to stamp.
    # Phase A typed read: BkRegularBox identifies parameterised Box[T];
    # the trait box (BkTraitBox) for bare `Box` doesn't reach this site
    # (no monomorphisation suffix to register).
    bool tname_is_box = false
    match resource_meta_for(&gmod, tname):
        case Some(rmeta):
            match rmeta.box_kind:
                case BkRegularBox():
                    tname_is_box = true
                else:
                    pass
        case None:
            pass
    if tname_is_box:
        Vector[StructField] box_fields = []
        box_fields.push(StructField("_0", LT_PTR))
        String box_name_ctor = tname.clone()
        int box_id = lir_mod_add_struct(&m, LirStructDef(box_name_ctor, box_fields, 0, false, 8, -1))
        sr.put(tname, box_id)
        m.type_runtime_map.put(tname.clone(), "Box")
        return
    if is_opaque_pointer_type(tname, &gmod):
        m.type_runtime_map.put(tname.clone(), "Ptr")
        String opm = opaque_ptr_method_prefix(tname, &gmod)
        if opm != "":
            m.type_method_prefix_map.put(tname.clone(), opm)
        return
    if is_guard_struct_type(tname, &gmod):
        Vector[StructField] guard_fields = []
        guard_fields.push(StructField("owner", LT_PTR))
        guard_fields.push(StructField("ptr", LT_PTR))
        String guard_name_ctor = tname.clone()
        int guard_id = lir_mod_add_struct(&m, LirStructDef(guard_name_ctor, guard_fields, 0, false, 16, -1))
        sr.put(tname, guard_id)
        m.type_runtime_map.put(tname.clone(), "Guard")
        m.type_method_prefix_map.put(tname.clone(), guard_method_prefix(tname, &gmod))
        return

int resolve_field_lir_type(String type_name, Dict[String, int] &sr):
    if type_name == "int64_t" or type_name == "int":
        return LT_I64
    elif type_name == "int32_t":
        return LT_I32
    elif type_name == "int16_t":
        return LT_I16
    elif type_name == "int8_t":
        return LT_I8
    elif type_name == "uint64_t":
        return LT_U64
    elif type_name == "uint32_t":
        return LT_U32
    elif type_name == "uint16_t":
        return LT_U16
    elif type_name == "uint8_t":
        return LT_U8
    elif type_name == "double" or type_name == "float64":
        return LT_F64
    elif type_name == "float" or type_name == "float32":
        return LT_F32
    elif type_name == "bool":
        return LT_BOOL
    elif type_name == "void":
        return LT_VOID
    # Named types — look up in struct registry
    int sid = sr.get(type_name).unwrap_or(-1)
    if sid >= 0:
        return LT_STRUCT_BASE + sid
    # Fallback: treat as pointer (opaque or unresolved type)
    return LT_PTR

# Register user-defined structs and enums from the GIR type table.
void lower_type_defs(GirModule &gmod, LirModule &m, Dict[String, int] &sr):
    # Two-pass registration: Pass 1 creates placeholder entries,
    # Pass 2 fills in fields.

    # Collect enum variant names to skip them in Pass 1 — they should be
    # represented as their parent enum, not as their own standalone struct.
    Dict[String, bool] enum_variant_names = {}
    Vector[String] ti_all_keys = gmod.type_infos.keys()
    for tname_k in ti_all_keys:
        GirTypeInfo tinfo_k = gmod.type_infos.get(tname_k).unwrap()
        if tinfo_k.is_enum:
            for v in tinfo_k.variants:
                enum_variant_names.put(v.name, true)

    # Pass 1: Pre-register all named types
    for gt in gmod.type_table:
        match gt:
            case GtNamed(name):
                if name == "":
                    continue
                if is_generic_placeholder_name(name) and not gmod.type_infos.contains(name):
                    continue
                if enum_variant_names.contains(name):
                    continue
                if sr.get(name).unwrap_or(-1) < 0:
                    # Phase A: typed dispatch on rmeta.collection_kind /
                    # box_kind / opaque_handle, mirroring the
                    # `register_type_alias_for_collection_or_opaque`
                    # earlier in this file. The inner name-slicing for
                    # elem/key/val extraction stays string-based —
                    # rmeta doesn't carry the parsed names.
                    bool dispatched = false
                    match resource_meta_for(&gmod, name):
                        case Some(rmeta):
                            match rmeta.collection_kind:
                                case CkVector():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Vector__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(8, name.len()))
                                    dispatched = true
                                case CkDeque():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Deque__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(7, name.len()))
                                    dispatched = true
                                case CkHeap():
                                    # Heap[T] is a user-defined generic struct
                                    # (`lib/std/heap.gg`: `struct Heap[T]: Vector[T]
                                    # heap_data`), NOT a runtime collection alias.
                                    # Its `collection_kind=CkHeap` drives ownership
                                    # (Heap.push consumes its arg, in lower.gg) and
                                    # element sizing, but at the LIR type layer it
                                    # MUST route as a UserType: the monomorphized
                                    # drop/clone fns access `self->heap_data`
                                    # (populate_drop_metadata reads its type_infos
                                    # fields), so `Heap__<T>` needs a real struct body
                                    # `struct Heap__<T> { GorgetArray heap_data; }`,
                                    # NOT a `typedef GorgetArray Heap__<T>`. Aliasing it
                                    # to GorgetArray (type_runtime_map + dispatched=true)
                                    # made should_skip_struct drop the body while the
                                    # drop fn still referenced the field → cc-fail
                                    # (heap_basic/advanced/edges). Mirror Rust, which
                                    # deliberately excludes Heap__ from the GorgetArray
                                    # alias path and routes it as UserType
                                    # (src/lir/lower/insts.rs:2008-2012,2024-2029).
                                    # Leave `dispatched=false` so the placeholder block
                                    # below registers Heap__<T> as a user struct; Pass 2
                                    # fills `heap_data` from gmod.type_infos.
                                    if name.starts_with("Heap__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(7, name.len()))
                                case CkSet():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Set__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(5, name.len()))
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_ordered_set_new")
                                    elif name.starts_with("HashSet__") or name.starts_with("GorgetSet__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(9, name.len()))
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_set_new")
                                    dispatched = true
                                case CkDict():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Dict__") or name.starts_with("GorgetDict__"):
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_dict_new")
                                        String d_rest = name.slice(6, name.len())
                                        int d_i = 0
                                        while d_i + 1 < d_rest.byte_len():
                                            if d_rest.byte_at(d_i) == 0x5F and d_rest.byte_at(d_i + 1) == 0x5F:
                                                String d_key = d_rest.slice(0, d_i)
                                                String d_val_rest = d_rest.slice(d_i + 2, d_rest.len())
                                                m.coll_key_type_map.put(name.clone(), d_key.clone())
                                                m.coll_val_type_map.put(name.clone(), d_val_rest.clone())
                                                break
                                            d_i += 1
                                    elif name.starts_with("HashMap__") or name.starts_with("GorgetMap__"):
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_map_new")
                                        int pfx_len = 9
                                        if name.starts_with("GorgetMap__"):
                                            pfx_len = 11
                                        String hm_rest = name.slice(pfx_len, name.len())
                                        int hm_i = 0
                                        while hm_i + 1 < hm_rest.byte_len():
                                            if hm_rest.byte_at(hm_i) == 0x5F and hm_rest.byte_at(hm_i + 1) == 0x5F:
                                                String hm_key = hm_rest.slice(0, hm_i)
                                                String hm_val_rest = hm_rest.slice(hm_i + 2, hm_rest.len())
                                                m.coll_key_type_map.put(name.clone(), hm_key.clone())
                                                m.coll_val_type_map.put(name.clone(), hm_val_rest.clone())
                                                break
                                            hm_i += 1
                                    dispatched = true
                                case CkNotCollection():
                                    pass
                            if not dispatched:
                                # CkNotCollection branch: opaque / Box / Guard.
                                match rmeta.box_kind:
                                    case BkRegularBox():
                                        Vector[StructField] box_fields = []
                                        box_fields.push(StructField("_0", LT_PTR))
                                        String box_name = name.clone()
                                        int box_id = lir_mod_add_struct(&m, LirStructDef(box_name, box_fields, 0, false, 8, -1))
                                        sr.put(name, box_id)
                                        m.type_runtime_map.put(name.clone(), "Box")
                                        dispatched = true
                                    else:
                                        pass
                            if not dispatched and rmeta.opaque_handle:
                                m.type_runtime_map.put(name.clone(), "Ptr")
                                match rmeta.method_prefix:
                                    case Some(opm2):
                                        m.type_method_prefix_map.put(name.clone(), opm2)
                                    case None:
                                        pass
                                dispatched = true
                            if not dispatched and rmeta.runtime_name == "Guard":
                                Vector[StructField] guard_fields = []
                                guard_fields.push(StructField("owner", LT_PTR))
                                guard_fields.push(StructField("ptr", LT_PTR))
                                String guard_name = name.clone()
                                int guard_id = lir_mod_add_struct(&m, LirStructDef(guard_name, guard_fields, 0, false, 16, -1))
                                sr.put(name, guard_id)
                                m.type_runtime_map.put(name.clone(), "Guard")
                                match rmeta.method_prefix:
                                    case Some(gmp):
                                        m.type_method_prefix_map.put(name.clone(), gmp)
                                    case None:
                                        m.type_method_prefix_map.put(name.clone(), "gorget_guard")
                                dispatched = true
                        case None:
                            pass
                    if not dispatched:
                        # User struct/enum / unknown — placeholder filled in Pass 2.
                        Vector[StructField] empty_fields = []
                        String ph_name = name.clone()
                        int sid = lir_mod_add_struct(&m, LirStructDef(ph_name, empty_fields, 0, false, -1, -1))
                        sr.put(name, sid)
                        if name.starts_with("Task__"):
                            m.type_runtime_map.put(name.clone(), "Task")
            else:
                pass

    # Pass 1b: Ensure all types from type_infos have LIR struct entries.
    Vector[String] ti_keys = gmod.type_infos.keys()
    for tname in ti_keys:
        if tname == "":
            continue
        if is_generic_placeholder_name(tname) and not gmod.type_infos.contains(tname):
            continue
        if enum_variant_names.contains(tname):
            continue
        if sr.get(tname).unwrap_or(-1) < 0:
            Vector[StructField] empty_fields = []
            String ph_name = tname.clone()
            int sid = lir_mod_add_struct(&m, LirStructDef(ph_name, empty_fields, 0, false, -1, -1))
            sr.put(tname, sid)

    # Pass 1c: Register collection types referenced only as field types.
    # `Vector[int]` used only inside `MNamed(String, Vector[int])` never
    # appears in `gmod.type_table` (no `map_ast_type` call triggers on a
    # variant-field type), so Pass 1/1b miss it. `resolve_field_lir_type`
    # then falls back to `LT_PTR` (8 bytes), and the containing enum's
    # union-variant max-size calculation undercounts by
    # `sizeof(GorgetArray) - 8 = 56` per occurrence.
    for pc_tname in ti_keys:
        GirTypeInfo pc_info = gmod.type_infos.get(pc_tname).unwrap()
        # Struct fields
        for pcf in pc_info.fields:
            register_field_type_in_sr(pcf.type_name, &sr, &m, &gmod)
        # Enum variant fields
        for pcv in pc_info.variants:
            for pcvf in pcv.fields:
                register_field_type_in_sr(pcvf.type_name, &sr, &m, &gmod)

    # Pass 2: Fill in struct/enum fields from GIR type info.
    for tname in ti_keys:
        int sid = sr.get(tname).unwrap_or(-1)
        if sid < 0:
            continue
        if not gmod.type_infos.contains(tname):
            continue
        GirTypeInfo tinfo = gmod.type_infos.get(tname).unwrap()
        LirStructDef sdef = m.structs.get(sid).unwrap()
        # Only fill if placeholder (empty fields)
        if sdef.fields.len() > 0:
            continue
        if tinfo.is_enum:
            # Enum: tag (I32) + variant fields. We build both the flat
            # field list (for codegen's struct emission) AND compute
            # `computed_c_size` up front so downstream `sizeof(T)` queries
            # via type_elem_size_in_mod / lir_type_byte_size_in_mod land
            # on the correct byte count. Without this the fallback in
            # those helpers summed every variant's fields, giving
            # 12376 bytes for union-layout enums like Item (real size
            # 568) — and the `Vector[Item] items = Vector[Item]()` init
            # in parser.gg got `gorget_array_new(12376)`, guaranteeing
            # every push ran off the end of the allocation.
            Vector[StructField] efields = []
            efields.push(StructField("tag", LT_I32))
            int max_variant_size = 0
            int flat_payload_size = 0
            for vinfo in tinfo.variants:
                int variant_bytes = 0
                int vfi = 0
                while vfi < vinfo.fields.len():
                    GirFieldInfo finfo = vinfo.fields.get(vfi).unwrap()
                    String fname = vinfo.name + "_" + int_to_str(vfi)
                    int fty = resolve_field_lir_type(finfo.type_name, &sr)
                    efields.push(StructField(fname, fty))
                    int field_bytes = lir_type_byte_size_in_mod(fty, &m, 0)
                    variant_bytes = variant_bytes + field_bytes
                    flat_payload_size = flat_payload_size + field_bytes
                    vfi += 1
                if variant_bytes > max_variant_size:
                    max_variant_size = variant_bytes
            # Match Rust backend: union layout when field count > 4 (tag + >3 payload).
            bool is_union = efields.len() > 4
            int ek = 0
            if tname.starts_with("Option__"):
                ek = 1
                # Phase A: register in type_runtime_map for typed dispatch downstream.
                m.type_runtime_map.put(tname.clone(), "Option")
            elif tname.starts_with("Result__"):
                ek = 2
                m.type_runtime_map.put(tname.clone(), "Result")
            elif tinfo.variants.len() > 0:
                ek = 3
            # Both layouts pad to the struct's alignof (max of field
            # alignments), matching C's rule. Union: tag(4) rounded to
            # alignof + max variant payload, rounded to alignof. Flat:
            # tag(4) + sum of payload fields, rounded to alignof.
            int enum_align = struct_alignof_from_fields(&efields, &m)
            int computed_size = 0
            if is_union:
                int padded_max = round_up_to(max_variant_size, enum_align)
                int tag_and_pad = round_up_to(4, enum_align)
                computed_size = tag_and_pad + padded_max
            else:
                int flat_total = 4 + flat_payload_size
                computed_size = round_up_to(flat_total, enum_align)
            if computed_size == 0:
                computed_size = 4
            LirStructDef new_sdef = LirStructDef(sdef.name, efields, ek, is_union, computed_size, -1)
            m.structs.set(sid, new_sdef)
        else:
            # Struct: map fields + pre-compute byte size (sum of field
            # sizes, padded to struct's alignof).
            Vector[StructField] sfields = []
            int s_total = 0
            for finfo in tinfo.fields:
                int fty = resolve_field_lir_type(finfo.type_name, &sr)
                sfields.push(StructField(finfo.name, fty))
                s_total = s_total + lir_type_byte_size_in_mod(fty, &m, 0)
            int s_align = struct_alignof_from_fields(&sfields, &m)
            s_total = round_up_to(s_total, s_align)
            if s_total == 0:
                s_total = 1
            LirStructDef new_sdef = LirStructDef(sdef.name, sfields, 0, false, s_total, -1)
            m.structs.set(sid, new_sdef)

    # Pass 3: Synthesize fields for monomorphized Option__T / Result__T__E
    # placeholders (they don't appear in gmod.type_infos by name).
    int psi = 0
    while psi < m.structs.len():
        LirStructDef psdef = m.structs.get(psi).unwrap()
        if psdef.fields.len() != 0:
            psi += 1
            continue
        String pname = psdef.name
        if pname.starts_with("Option__"):
            String inner = pname.slice(8, pname.len())
            int inner_ty = resolve_field_lir_type(inner, &sr)
            Vector[StructField] ofields = []
            ofields.push(StructField("tag", LT_I32))
            ofields.push(StructField("Some_0", inner_ty))
            # Phase A: register for typed dispatch before pname moves into LirStructDef.
            m.type_runtime_map.put(pname.clone(), "Option")
            # Generate drop/clone for a mono'd Option[Resource]: register a
            # `Some_0` variant-drop (variant index 0 = Some; None has no
            # payload) so emit_enum_drops/emit_enum_clones produce
            # `Option__<inner>__drop` / `__clone`. The self-host never
            # generated these — mono'd prelude generics aren't user
            # `m.items` defs, so Pass 2's type_infos-driven loop misses them
            # — which left an `Option[Resource]` field byte-copied (aliased)
            # at a consuming position and double-freed (MatchArm `guard` /
            # ElseBranch `condition`). Rust emits these (driver.c:11479).
            # Mirrors Pass 2's recursive_drop_enums + type_drop_fns wiring.
            String opt_inner_drop = drop_fn_for_type(inner, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
            if opt_inner_drop != "":
                Vector[EnumVariantDrop] opt_vd = []
                opt_vd.push(EnumVariantDrop(0, "Some", "Some_0", opt_inner_drop.clone(), inner.clone()))
                m.recursive_drop_enums.put(pname.clone(), opt_vd)
                Vector[FieldDrop] opt_nofd = []
                Vector[EnumVariantDrop] opt_vd2 = []
                opt_vd2.push(EnumVariantDrop(0, "Some", "Some_0", opt_inner_drop, inner.clone()))
                m.type_drop_fns.put(pname.clone(), TypeDropInfo(pname + "__drop", opt_nofd, "", opt_vd2))
            LirStructDef opt_sdef = LirStructDef(pname, ofields, 1, false, -1, -1)
            m.structs.set(psi, opt_sdef)
        elif pname.starts_with("Result__"):
            # Split "Result__<Ok>__<Err>". Ok may itself be compound like
            # `Vector__byte`, so a naive left-first `__` split fails. Try
            # each possible `__` position from left to right and accept the
            # first split where BOTH sides resolve to a registered type.
            String rest = pname.slice(8, pname.len())
            String ok_name = ""
            String err_name = ""
            int ok_ty = -1
            int err_ty = -1
            int si = 0
            while si + 1 < rest.byte_len():
                if rest.byte_at(si) == 0x5F and rest.byte_at(si + 1) == 0x5F:
                    String o_try = rest.slice(0, si)
                    String e_try = rest.slice(si + 2, rest.len())
                    int ot = resolve_field_lir_type(o_try, &sr)
                    int et = resolve_field_lir_type(e_try, &sr)
                    # Accept only if both resolve as non-pointer fallbacks
                    # (both registered OR scalar). resolve_field_lir_type
                    # returns LT_PTR for unresolved, which we treat as a miss.
                    if ot != LT_PTR and et != LT_PTR:
                        ok_name = o_try
                        err_name = e_try
                        ok_ty = ot
                        err_ty = et
                        break
                si += 1
            if ok_name == "":
                # Fall back to first-underscore split even if one side misses.
                int si2 = 0
                while si2 + 1 < rest.byte_len():
                    if rest.byte_at(si2) == 0x5F and rest.byte_at(si2 + 1) == 0x5F:
                        ok_name = rest.slice(0, si2)
                        err_name = rest.slice(si2 + 2, rest.len())
                        ok_ty = resolve_field_lir_type(ok_name, &sr)
                        err_ty = resolve_field_lir_type(err_name, &sr)
                        break
                    si2 += 1
            if ok_name != "":
                Vector[StructField] rfields = []
                rfields.push(StructField("tag", LT_I32))
                rfields.push(StructField("Ok_0", ok_ty))
                rfields.push(StructField("Error_0", err_ty))
                # Phase A: register for typed dispatch before pname moves into LirStructDef.
                m.type_runtime_map.put(pname.clone(), "Result")
                # Generate drop/clone for a mono'd Result[Ok,Err] with a
                # resource payload — same rationale as Option above. Ok is
                # variant 0 (Ok_0), Error is variant 1 (Error_0); register a
                # variant-drop for whichever payload(s) are resources.
                String res_ok_drop = drop_fn_for_type(ok_name, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
                String res_err_drop = drop_fn_for_type(err_name, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
                if res_ok_drop != "" or res_err_drop != "":
                    Vector[EnumVariantDrop] res_vd = []
                    Vector[EnumVariantDrop] res_vd2 = []
                    if res_ok_drop != "":
                        res_vd.push(EnumVariantDrop(0, "Ok", "Ok_0", res_ok_drop.clone(), ok_name.clone()))
                        res_vd2.push(EnumVariantDrop(0, "Ok", "Ok_0", res_ok_drop, ok_name.clone()))
                    if res_err_drop != "":
                        res_vd.push(EnumVariantDrop(1, "Error", "Error_0", res_err_drop.clone(), err_name.clone()))
                        res_vd2.push(EnumVariantDrop(1, "Error", "Error_0", res_err_drop, err_name.clone()))
                    m.recursive_drop_enums.put(pname.clone(), res_vd)
                    Vector[FieldDrop] res_nofd = []
                    m.type_drop_fns.put(pname.clone(), TypeDropInfo(pname + "__drop", res_nofd, "", res_vd2))
                LirStructDef res_sdef = LirStructDef(pname, rfields, 2, false, -1, -1)
                m.structs.set(psi, res_sdef)
        psi += 1

    # Pass 4: Fixpoint re-computation of `computed_c_size` for every
    # struct/enum. Pass 2 computes sizes eagerly while processing each
    # type, but the iteration order over `ti_keys` can visit an enum
    # BEFORE the struct it wraps in a variant payload — the wrapped
    # type's fields are still empty placeholders, so `lir_type_byte_size_in_mod`
    # falls back to 8, and the enum's `max_variant_size` underestimates.
    # Iterating until no size changes converges in O(depth-of-type-graph)
    # passes. Concrete bug this fixes: self-host's `Item` enum is
    # wrapped in `Vector[Item]` by `parse_module`; initial Pass 2 saw
    # `FunctionDef` (Item's biggest variant, 560 bytes) as 8 bytes and
    # computed Item's size as 16 instead of 568 — `gorget_array_new(16)`
    # then truncated every parsed top-level item to the first 16 bytes,
    # losing function names, body refs, etc.
    bool changed = true
    int guard_iters = 0
    while changed and guard_iters < 8:
        changed = false
        int rsi = 0
        while rsi < m.structs.len():
            LirStructDef rsdef = m.structs.get(rsi).unwrap()
            if rsdef.fields.len() == 0:
                rsi += 1
                continue
            # Skip builtin runtime structs — `register_builtin_structs`
            # set their `computed_c_size` to match C's actual layout,
            # which includes runtime-only fields (alloc, elem_drop,
            # elem_clone, …) that aren't in the self-host's LirStructDef
            # field list. Recomputing from the 4 visible fields would
            # OVERWRITE 64 bytes with 32 for GorgetArray, etc.
            if is_builtin_runtime_struct(rsdef.name):
                rsi += 1
                continue
            int new_size = 0
            int struct_align_rs = struct_alignof_from_fields(&rsdef.fields, &m)
            if rsdef.is_union_layout and rsdef.enum_kind > 0:
                # Union-layout enum: tag + pad to alignof + max variant.
                # Variant grouping by `VariantName_N` field-name prefix.
                # Each variant's payload is computed with inter-field
                # alignment padding (same rule as flat structs).
                int max_v = 0
                int cur_v = 0
                String cur_pfx = ""
                int rfi = 1
                while rfi < rsdef.fields.len():
                    StructField rsf = rsdef.fields.get(rfi).unwrap()
                    int last_us = rsf.name.len() - 1
                    while last_us > 0:
                        String rch = rsf.name.slice(last_us, last_us + 1)
                        if rch == "_":
                            break
                        last_us -= 1
                    String pfx = rsf.name.slice(0, last_us)
                    int field_sz = lir_type_byte_size_in_mod(rsf.ty, &m, 0)
                    int field_al = alignof_lir_type(rsf.ty, &m, 0)
                    if pfx != cur_pfx:
                        if cur_v > max_v:
                            max_v = cur_v
                        cur_v = 0
                        cur_pfx = pfx
                    cur_v = round_up_to(cur_v, field_al)
                    cur_v = cur_v + field_sz
                    rfi += 1
                if cur_v > max_v:
                    max_v = cur_v
                int padded_max = round_up_to(max_v, struct_align_rs)
                int tag_pad = round_up_to(4, struct_align_rs)
                new_size = tag_pad + padded_max
            else:
                # Flat layout: walk fields, aligning each to its natural
                # boundary before adding its size (mirrors C's struct layout
                # rules — field_i starts at offset round_up(prev_end,
                # alignof(field_i))), then pad total to struct alignof.
                #
                # Previously this summed sizes without inter-field padding,
                # producing a smaller size than C's sizeof. For
                # `DefInfo { Str(32) DefKind(4) Span(16) int64 int64 bool bool }`
                # the naive sum gives 70 → round_up(70, 8) = 72; C gives 80
                # because it pads the 4-byte DefKind to 8 before Span. When
                # the self-host used 72 as `Vector[DefInfo].elem_size` and
                # C's sizeof gave 80, every push wrote 80 bytes at a 72-byte
                # stride — corrupting adjacent elements. Surfaced as a heap
                # overflow in `ScopeTable__set_def_param` during stage-1's
                # own run on the self-host driver.
                int offset = 0
                for rsf2 in rsdef.fields:
                    int fa2 = alignof_lir_type(rsf2.ty, &m, 0)
                    offset = round_up_to(offset, fa2)
                    offset = offset + lir_type_byte_size_in_mod(rsf2.ty, &m, 0)
                new_size = round_up_to(offset, struct_align_rs)
            if new_size == 0:
                new_size = 8
            if new_size != rsdef.computed_c_size:
                changed = true
                LirStructDef updated = LirStructDef(rsdef.name, rsdef.fields, rsdef.enum_kind, rsdef.is_union_layout, new_size, rsdef.computed_c_align)
                m.structs.set(rsi, updated)
            rsi += 1
        guard_iters += 1

# ── Runtime function name mapping ───────────────────────────

String map_runtime_name(String name, LirModule &m, GirModule &gmod):
    # Hardcoded aliases for extern-method stubs whose method name carries
    # the File/stream receiver type (lost to `int64_t__` fallback when the
    # self-host type inference can't keep the receiver as a named type).
    # These correspond to `equip File: extern ...` declarations in std.io.
    if name == "int64_t___write_bytes_buf" or name == "File___write_bytes_buf":
        return "gorget_file_write_bytes_buf"
    if name == "int64_t___read_bytes_buf" or name == "File___read_bytes_buf":
        return "gorget_file_read_bytes_buf"
    if name == "int64_t___flush_buffer" or name == "File___flush_buffer":
        return "gorget_file_flush"
    if name == "int64_t__close" or name == "File__close":
        return "gorget_file_close"
    if name == "_file_open_try":
        return "gorget_file_open_try"
    # Trait-method dispatch: File__write / File__read resolves to the
    # equip-block specialization emitted with a `Writer_for_` / `Reader_for_`
    # prefix.
    if name == "File__write":
        return "Writer_for_File__write"
    if name == "File__read":
        return "Reader_for_File__read"
    if name == "_parse_int_raw":
        return "gorget_parse_int"
    if name == "_parse_float_raw":
        return "gorget_parse_float"
    if name == "_parse_last_error":
        return "gorget_parse_last_error"
    if name == "_stdin_handle":
        return "gorget_stdin_handle"
    if name == "_stdout_handle":
        return "gorget_stdout_handle"
    if name == "_stderr_handle":
        return "gorget_stderr_handle"
    if name == "file_exists":
        return "gorget_file_exists"
    if name == "chr":
        return "gorget_char_chr"
    if name == "__bytes_to_str_raw":
        return "gorget_bytes_to_str"
    # Bare type constructors for opaque pointer types: TaskGroup() → gorget_task_group_new().
    # These have no generic args (pointer typedefs, not generics).
    match name:
        case "TaskGroup":
            return "gorget_task_group_new"
        case "AtomicInt":
            return "gorget_atomic_int_new"
        case "AtomicBool":
            return "gorget_atomic_bool_new"
        case "Barrier":
            return "gorget_barrier_new"
        case "WaitGroup":
            return "gorget_wait_group_new"
        case "OnceFlag":
            return "gorget_once_flag_new"
        case "Semaphore":
            return "gorget_semaphore_new"
        else:
            pass
    # Collection constructors (bare name, no method suffix).
    # Phase A: dispatch on type_runtime_map category + coll_ctor_fn_map.
    if is_collection_constructor(name, &m, &gmod):
        String ctor_cat = type_category_for_name(name, &m)
        if ctor_cat == "GorgetArray":
            return "gorget_array_new"
        elif ctor_cat == "GorgetMap":
            String ctor_fn = coll_ctor_fn_for_name(name, &m)
            if ctor_fn == "":
                ctor_fn = "gorget_map_new"
            if is_string_keyed(name, &m):
                return ctor_fn + "_str"
            return ctor_fn
        elif ctor_cat == "GorgetSet":
            String ctor_fn = coll_ctor_fn_for_name(name, &m)
            if ctor_fn == "":
                ctor_fn = "gorget_set_new"
            if is_string_keyed(name, &m):
                return ctor_fn + "_str"
            return ctor_fn
        elif ctor_cat == "Ptr":
            # Channel/Shared constructors: look up prefix in type_method_prefix_map.
            int ci = 0
            while ci < name.len() - 1:
                if name.slice(ci, ci + 2) == "__":
                    String cp = name.slice(0, ci)
                    if m.type_method_prefix_map.contains(cp):
                        return m.type_method_prefix_map.get(cp).unwrap_or("") + "_new"
                ci += 1
        return name

    # Phase A: collection method dispatch via type_runtime_map + coll_ctor_fn_map.
    String coll_cat = type_category_for_name(name, &m)
    if coll_cat == "GorgetArray":
        return map_array_method(extract_method_name(name))
    if coll_cat == "GorgetMap":
        String method = extract_method_name(name)
        if method == "new":
            String ctor_fn = coll_ctor_fn_for_name(name, &m)
            if ctor_fn == "":
                ctor_fn = "gorget_map_new"
            if is_string_keyed(name, &m):
                return ctor_fn + "_str"
            return ctor_fn
        return map_dict_method(method)
    if coll_cat == "GorgetSet":
        String method = extract_method_name(name)
        if method == "new":
            String ctor_fn = coll_ctor_fn_for_name(name, &m)
            if ctor_fn == "":
                ctor_fn = "gorget_set_new"
            if is_string_keyed(name, &m):
                return ctor_fn + "_str"
            return ctor_fn
        return map_set_method(method)

    # String methods — Phase A: dispatch via type_runtime_map "GorgetString" category.
    if type_category_for_name(name, &m) == "GorgetString":
        String method = extract_method_name(name)
        match method:
            case "push":
                # `String.push(Str chunk)` → `gorget_string_push_char(
                # GorgetString*, Str)`. The old spelling `gorget_string_push`
                # has NO definition (only `_char`/`_byte`/`_int`/… variants),
                # and `gorget_str_push` is a Rust-emitted thin wrapper that
                # lives in the per-MODULE C section (NOT the shared runtime
                # preamble the bootstrap concatenates), so it link-fails when
                # the self-host body calls it. `gorget_string_push_char` IS in
                # the core preamble and has the exact `(GorgetString*, Str)`
                # ABI. Surfaced once io.gg's `equip String with Writer:`
                # (`self.push(chunk)`) became reachable via the FIDELITY
                # vtable globals.
                return "gorget_string_push_char"
            case "len":
                return "gorget_str_codepoint_count"
            case "byte_len":
                return "gorget_str_byte_len"
            case "clone":
                return "gorget_string_clone_to_owned"
            case "free":
                return "gorget_string_free"
            case "substring":
                return "gorget_str_slice"
            case "debug":
                # Debuggable.debug is defined in the runtime as
                # `gorget_string_debug`, not `gorget_str_debug`. Without
                # this special case the fallback emitted the wrong name and
                # stage-1 failed to link.
                return "gorget_string_debug"
            case "concat":
                return "gorget_string_concat"
            case "eq":
                return "gorget_string_eq"
            case "format":
                return "gorget_string_format"
            else:
                return "gorget_str_" + method

    # Phase A — simple prefix dispatch: scan type_method_prefix_map for the type
    # prefix of the method name. Covers Heap, Mutex, RWLock, Guard, ReadGuard,
    # WriteGuard, Weak, AtomicInt, AtomicBool, Semaphore, Barrier, OnceFlag,
    # WaitGroup, TaskGroup, Channel (all registered at lower_type_defs time).
    # "drop" → "free" is a general alias (runtime uses _free for destruction);
    # Guard "drop" → "gorget_guard_release" is the only exception.
    int pfx_i = 0
    while pfx_i < name.len() - 1:
        if name.slice(pfx_i, pfx_i + 2) == "__":
            String pfx_cand = name.slice(0, pfx_i)
            if m.type_method_prefix_map.contains(pfx_cand):
                String pfx = m.type_method_prefix_map.get(pfx_cand).unwrap_or("")
                if pfx != "":
                    String method = extract_method_name(name)
                    # Guard: drop → gorget_guard_release (suffix differs from method name).
                    if pfx == "gorget_guard" and method == "drop":
                        return "gorget_guard_release"
                    # Shared: read → get, write → set aliases.
                    if pfx == "gorget_shared":
                        if method == "read":
                            return "gorget_shared_get"
                        if method == "write":
                            return "gorget_shared_set"
                    # General alias: drop → free.
                    if method == "drop":
                        method = "free"
                    return pfx + "_" + method
        pfx_i += 1

    # Box methods — Phase A: detect via type_runtime_map "Box" category.
    if type_category_for_name(name, &m) == "Box":
        String method = extract_method_name(name)
        match method:
            case "new":
                return "gorget_box_new"
            case "get":
                return "gorget_box_get"
            case "free" | "drop":
                return "gorget_box_free"
            case "clone":
                return "gorget_box_clone"
            else:
                # Box__TYPE without a real method suffix — `Box__SpannedType`
                # is the bare type constructor, not a method call. Leave the
                # name unmapped so codegen can emit __gorget_box_alloc_TYPE.
                return name

    # Scalar-prefixed methods (self-host GIR uses T__method not Vector__T__method)
    if is_scalar_type_prefix(name):
        String method = extract_method_name(name)
        # Dict-only methods (put/keys/values/items) — lost container prefix means
        # we can't tell Dict from Vector, but these methods only exist on Dict.
        if method == "put" or method == "keys" or method == "values" or method == "items":
            return map_dict_method(method)
        # Shared method name, try Dict first (since get works for both Dict and
        # Vector with a 2-arg ABI via gorget_map_get / gorget_array_safe_get).
        if method == "get" or method == "contains" or method == "remove" or method == "clear" or method == "len":
            String dm = map_dict_method(method)
            if dm != "":
                return dm
        # Skip `new` — different arg counts in scalar-prefix context
        if method != "new":
            String arr = map_array_method(method)
            if arr != "":
                return arr
        # Option/Result methods on scalar-prefixed types
        return map_option_result_method(method)

    # Option/Result method dispatch — Phase A: detect via type_runtime_map + enum_variant_parent.
    # Covers variant-prefixed calls (Some__T__method, None__T__method, Ok__T__method, etc.)
    # and type-prefixed calls (Option__T__method, Result__T__E__method).
    String or_cat = type_category_for_name(name, &m)
    if or_cat == "Option":
        String method = extract_method_name(name)
        String opt_res = map_option_result_method(method)
        if opt_res != "":
            return opt_res
        return "__option_" + method
    if or_cat == "Result":
        String method = extract_method_name(name)
        String res_res = map_option_result_method(method)
        if res_res != "":
            # Shared methods (unwrap, map, …) come back with __option_ prefix; convert.
            if res_res.starts_with("__option_"):
                return "__result_" + res_res.slice(9, res_res.len())
            return res_res
        return "__result_" + method

    # Standalone function mappings
    match name:
        case "int_to_str":
            return "gorget_int_to_str"
        case "float_to_str":
            return "gorget_float_to_str"
        case "bool_to_str":
            return "gorget_bool_to_str"
        case "char_to_str":
            return "gorget_char_to_str"
        case "parse_int" | "str_to_int":
            return "gorget_parse_int"
        case "parse_float" | "str_to_float":
            return "gorget_parse_float"
        case "read_file":
            return "gorget_read_file"
        case "read_line":
            return "gorget_read_line"
        case "print_err":
            return "gorget_print_err"
        case "args":
            return "gorget_args"
        case "async_sleep" | "sleep_ms":
            return "gorget_async_sleep"
        case "time_now" | "monotonic_ns":
            return "gorget_monotonic_ns"
        case "time":
            return "gorget_time"
        case "time_ms":
            return "gorget_time_ms"
        case "format_time":
            return "gorget_format_time"
        case "parse_time":
            return "gorget_parse_time"
        else:
            pass

    # No mapping
    return ""

# Map a Vector/Array method name to the runtime function name.
String map_array_method(String method):
    match method:
        case "new":
            return "gorget_array_new"
        case "push":
            return "gorget_array_push"
        case "pop":
            return "gorget_array_safe_pop"
        case "get":
            return "gorget_array_safe_get"
        case "set":
            return "gorget_array_set"
        case "len":
            return "gorget_array_len"
        case "remove":
            return "gorget_array_remove_opt"
        case "insert":
            return "gorget_array_insert"
        case "clone":
            return "gorget_array_clone"
        case "clear":
            return "gorget_array_clear"
        case "extend":
            return "gorget_array_extend"
        case "contains":
            return "gorget_array_contains"
        case "reverse":
            return "gorget_array_reverse"
        case "slice":
            return "gorget_array_slice"
        case "sort":
            return "gorget_array_sort"
        case "last":
            return "gorget_array_safe_last"
        case "first":
            return "gorget_array_safe_first"
        case "is_empty":
            return "gorget_array_is_empty"
        case "capacity":
            return "gorget_array_capacity"
        case "swap":
            return "gorget_array_swap"
        case "index_of":
            return "gorget_array_index_of"
        case "fill":
            # `Vector[T].fill(n, val)` — preallocate capacity and fill
            # n slots with `val`. Rust gg emits this as a direct
            # `gorget_array_fill(...)` call; the self-host's mangled
            # form `Vector__bool__fill` arrives here and routes to the
            # same runtime symbol. Without this arm, stage-1 link fails
            # with "undefined reference to Vector__bool__fill" the
            # moment Phase 1's `liveness` bitset helpers exercise it.
            return "gorget_array_fill"
        case "free":
            return "gorget_array_free"
        else:
            return ""

# Map a Dict/Map method name to the runtime function name.
String map_dict_method(String method):
    match method:
        case "put" | "set":
            return "gorget_map_put"
        case "get":
            return "gorget_map_get"
        case "contains" | "has":
            return "gorget_map_contains"
        case "remove":
            return "gorget_map_remove"
        case "len":
            return "gorget_map_len"
        case "keys":
            return "gorget_map_keys"
        case "values":
            return "gorget_map_values"
        case "clone":
            return "gorget_map_clone"
        case "clear":
            return "gorget_map_clear"
        case "is_empty":
            return "gorget_map_is_empty"
        case "items":
            return "gorget_map_items"
        case "update":
            return "gorget_map_update"
        else:
            return ""

# Map a Set method name to the runtime function name.
String map_set_method(String method):
    match method:
        case "add" | "insert":
            return "gorget_set_add"
        case "contains" | "has":
            return "gorget_set_contains"
        case "remove":
            return "gorget_set_remove"
        case "len":
            return "gorget_set_len"
        case "clone":
            return "gorget_set_clone"
        case "clear":
            return "gorget_set_clear"
        case "is_empty":
            return "gorget_set_is_empty"
        case "union":
            return "gorget_set_union"
        case "intersection":
            return "gorget_set_intersection"
        case "difference":
            return "gorget_set_difference"
        case "is_subset":
            return "gorget_set_is_subset"
        case "is_superset":
            return "gorget_set_is_superset"
        else:
            return ""

# Map an Option/Result method name to its combinator function.
String map_option_result_method(String method):
    match method:
        case "is_none" | "is_some":
            return "__option_" + method
        case "unwrap" | "expect":
            return "__option_" + method
        case "map" | "filter" | "and_then" | "or_else" | "or":
            return "__option_" + method
        case "is_ok":
            return "__result_is_ok"
        case "is_error" | "is_err":
            return "__result_is_error"
        case "unwrap_error" | "unwrap_err":
            return "__result_unwrap_error"
        else:
            return ""

# Phase A — find the type_runtime_map category for a method name (or bare type name).
# Scans __ split points from left to right to find the first registered type prefix.
# Also checks enum_variant_parent to handle variant-prefixed names like Some__T__method.
# Returns "" if no registered type prefix is found.
# Examples: "Vector__int64_t__push" → "GorgetArray"
#           "Box__Foo__clone" → "Box"
#           "Guard__Mutex__int__deref" → "Guard"
#           "Some__int64_t__unwrap" → "Option"  (via enum_variant_parent)
#           "Option__int64_t__map" → "Option"
#           "unknown_fn" → ""
String type_category_for_name(String name, LirModule &m):
    if m.type_runtime_map.contains(name):
        return m.type_runtime_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.type_runtime_map.contains(prefix):
                return m.type_runtime_map.get(prefix).unwrap_or("")
            # Phase A — variant name → parent type lookup for Option/Result.
            # enum_variant_parent maps e.g. "Some__int64_t" → "Option__int64_t".
            if m.enum_variant_parent.contains(prefix):
                String par = m.enum_variant_parent.get(prefix).unwrap_or("")
                if m.type_runtime_map.contains(par):
                    return m.type_runtime_map.get(par).unwrap_or("")
        i += 1
    return ""

String coll_elem_type_for_name(String name, LirModule &m):
    if m.coll_elem_type_map.contains(name):
        return m.coll_elem_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_elem_type_map.contains(prefix):
                return m.coll_elem_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String coll_key_type_for_name(String name, LirModule &m):
    if m.coll_key_type_map.contains(name):
        return m.coll_key_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_key_type_map.contains(prefix):
                return m.coll_key_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String coll_val_type_for_name(String name, LirModule &m):
    if m.coll_val_type_map.contains(name):
        return m.coll_val_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_val_type_map.contains(prefix):
                return m.coll_val_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

# Return the base constructor fn name for Dict/HashMap/Set/HashSet.
# "Dict__K__V" → "gorget_dict_new", "HashMap__K__V" → "gorget_map_new",
# "Set__T" → "gorget_ordered_set_new", "HashSet__T" → "gorget_set_new".
String coll_ctor_fn_for_name(String name, LirModule &m):
    if m.coll_ctor_fn_map.contains(name):
        return m.coll_ctor_fn_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_ctor_fn_map.contains(prefix):
                return m.coll_ctor_fn_map.get(prefix).unwrap_or("")
        i += 1
    return ""

# Check if a name is a bare collection constructor (no method suffix).
# E.g., "Vector__int64_t" is a constructor, "Vector__int64_t__push" is a method.
# Phase A — uses type_runtime_map: registered types are constructors, unregistered
# names with collection prefixes could be method calls.
bool is_collection_constructor(String name, LirModule &m, GirModule &gmod):
    # Fast path: registered collection types (GorgetArray/Map/Set) only.
    # Box, Guard, Task, Ptr, Option, Result, GorgetString are also in
    # type_runtime_map but are NOT collection constructors — only the three
    # collection categories qualify here. "Ptr" (opaque types: Mutex, Channel,
    # Shared, etc.) fall through to the method-suffix check below.
    if m.type_runtime_map.contains(name):
        String cat = m.type_runtime_map.get(name).unwrap_or("")
        if cat == "GorgetArray" or cat == "GorgetMap" or cat == "GorgetSet":
            return true
        if cat != "Ptr":
            return false
    # Slow path: unregistered name or Ptr-category — check prefix + method-suffix.
    # Handles types that haven't been seen as type declarations yet.
    # collection_runtime_type is the source-of-truth for prefix matching.
    if collection_runtime_type(name, &gmod) == "" and not is_opaque_pointer_type(name, &gmod):
        return false
    String method = extract_method_name(name)
    if method == "int64_t" or method == "double" or method == "bool" or method == "int32_t":
        return true
    if method == "int16_t" or method == "int8_t" or method == "uint64_t" or method == "uint32_t":
        return true
    if method == "uint16_t" or method == "uint8_t" or method == "byte" or method == "float":
        return true
    if method == "GorgetString" or method == "Str":
        return true
    if method.len() > 0:
        String first = method.slice(0, 1)
        if first >= "A" and first <= "Z":
            return true
    return false

# Byte size of an LIR scalar / pointer type. For scalar/pointer types
# the answer is fixed; for inline struct fields we consult m.structs and
# recurse — otherwise a Vector[SpannedToken] whose element contains a
# union-layout Token enum gets allocated at 24 bytes instead of 60+
# and pushes stomp adjacent memory. A small depth cap guards against
# accidental self-reference in recursive types.
# Alignment of a LIR type in bytes. Used when computing struct size so
# we pad the total up to the struct's alignof, matching C's rule.
# Hardcoded padding to 8 over-estimated size for structs whose largest
# field is smaller than 8 bytes (e.g. `struct Keyword { int32_t tag }`,
# C sizeof = 4 not 8). That caused `Option[Keyword]` to compute 16 bytes
# while C laid it out as 8, and `return Some(KwXxx)` copied 16 bytes of
# return value into an 8-byte slot — overwriting the caller's stack.
int alignof_lir_type(int ty, LirModule &m, int depth):
    if ty == LT_I8 or ty == LT_U8 or ty == LT_BOOL:
        return 1
    if ty == LT_I16 or ty == LT_U16:
        return 2
    if ty == LT_I32 or ty == LT_U32 or ty == LT_F32:
        return 4
    if ty == LT_I64 or ty == LT_U64 or ty == LT_F64 or ty == LT_PTR:
        return 8
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return 8
    if ty >= LT_STRUCT_BASE:
        int sid = ty - LT_STRUCT_BASE
        if sid < m.structs.len() and depth < 4:
            LirStructDef sdef = m.structs.get(sid).unwrap()
            int max_align = 1
            for sfa in sdef.fields:
                int fa = alignof_lir_type(sfa.ty, &m, depth + 1)
                if fa > max_align:
                    max_align = fa
            return max_align
    return 8

# Compute the struct's alignment from its flat field list (union or flat
# layout doesn't matter for alignof: both are max field alignment).
int struct_alignof_from_fields(Vector[StructField] &fields, LirModule &m):
    int max_align = 1
    for sf in fields:
        int fa = alignof_lir_type(sf.ty, &m, 0)
        if fa > max_align:
            max_align = fa
    return max_align

int round_up_to(int n, int align):
    if align <= 1:
        return n
    int rem = n % align
    if rem == 0:
        return n
    return n + (align - rem)

int lir_type_byte_size_in_mod(int ty, LirModule &m, int depth):
    if ty == LT_I8 or ty == LT_U8 or ty == LT_BOOL:
        return 1
    if ty == LT_I16 or ty == LT_U16:
        return 2
    if ty == LT_I32 or ty == LT_U32 or ty == LT_F32:
        return 4
    if ty == LT_I64 or ty == LT_U64 or ty == LT_F64:
        return 8
    if ty == LT_PTR:
        return 8
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return 8
    if ty >= LT_STRUCT_BASE:
        int sid = ty - LT_STRUCT_BASE
        if sid < m.structs.len() and depth < 4:
            LirStructDef sdef = m.structs.get(sid).unwrap()
            if sdef.computed_c_size > 0:
                return sdef.computed_c_size
            # Union-layout enums get tag (4) + pad + max variant payload.
            # Flat layout (regular struct or small enum) gets sum of all
            # field sizes, aligned to 8. Previously always summed; that
            # overcounted union enums by ~Nx and routed 12376-byte
            # allocations to 568-byte Item elements.
            int align_fb = struct_alignof_from_fields(&sdef.fields, &m)
            if sdef.is_union_layout and sdef.enum_kind > 0:
                int max_v_bytes = 0
                int cur_v_bytes = 0
                String cur_prefix = ""
                int fi_u = 1
                while fi_u < sdef.fields.len():
                    StructField sf_u = sdef.fields.get(fi_u).unwrap()
                    int under_pos = sf_u.name.len() - 1
                    while under_pos > 0:
                        String ch_u = sf_u.name.slice(under_pos, under_pos + 1)
                        if ch_u == "_":
                            break
                        under_pos -= 1
                    String name_prefix = sf_u.name.slice(0, under_pos)
                    if name_prefix != cur_prefix:
                        if cur_v_bytes > max_v_bytes:
                            max_v_bytes = cur_v_bytes
                        cur_v_bytes = 0
                        cur_prefix = name_prefix
                    cur_v_bytes = cur_v_bytes + lir_type_byte_size_in_mod(sf_u.ty, &m, depth + 1)
                    fi_u += 1
                if cur_v_bytes > max_v_bytes:
                    max_v_bytes = cur_v_bytes
                int padded_max_fb = round_up_to(max_v_bytes, align_fb)
                int tag_pad_fb = round_up_to(4, align_fb)
                int u_total = tag_pad_fb + padded_max_fb
                if u_total == 0:
                    return 8
                return u_total
            int total = 0
            for sff in sdef.fields:
                total = total + lir_type_byte_size_in_mod(sff.ty, &m, depth + 1)
            if total == 0:
                return 8
            return round_up_to(total, align_fb)
    return 8

# Get the element size for a type name. Uses m.structs when available to
# sum actual field sizes for user structs; falls back to pointer size when
# the struct can't be resolved.
int type_elem_size_in_mod(String elem, Dict[String, int] &sr, LirModule &m):
    if elem == "int64_t" or elem == "double":
        return 8
    elif elem == "int32_t" or elem == "float":
        return 4
    elif elem == "int16_t" or elem == "uint16_t":
        return 2
    elif elem == "int8_t" or elem == "uint8_t" or elem == "bool" or elem == "byte":
        return 1
    elif elem == "GorgetString" or elem == "Str":
        return 32
    int sid = sr.get(elem).unwrap_or(-1)
    if sid >= 0 and sid < m.structs.len():
        LirStructDef sdef = m.structs.get(sid).unwrap()
        # Pre-computed size (set during type lowering for known runtime
        # structs like GorgetString/GorgetArray) takes precedence.
        if sdef.computed_c_size > 0:
            return sdef.computed_c_size
        # Sum field sizes, recursing into struct-typed fields via the
        # module-aware byte-size helper so SpannedToken et al. with
        # nested union-layout Token payloads get the real size rather
        # than the 8-byte pointer-size fallback.
        int total = 0
        for sff in sdef.fields:
            total = total + lir_type_byte_size_in_mod(sff.ty, &m, 0)
        if total == 0:
            return 8
        # Round up to 8-byte boundary for C struct alignment.
        int rem = total % 8
        if rem != 0:
            total = total + (8 - rem)
        return total
    return 8

# Get element size for a collection constructor using LirModule metadata.
int collection_elem_size_in_mod(String name, Dict[String, int] &sr, LirModule &m):
    String cat = type_category_for_name(name, &m)
    if cat == "GorgetMap" or cat == "Ptr":
        return 8
    String elem = coll_elem_type_for_name(name, &m)
    return type_elem_size_in_mod(elem, &sr, &m)

# Check if dict/set has string keys (uses typed coll_elem/key_type_map).
bool is_string_keyed(String name, LirModule &m):
    String cat = type_category_for_name(name, &m)
    if cat == "GorgetMap":
        String key = coll_key_type_for_name(name, &m)
        return key == "GorgetString" or key == "Str"
    if cat == "GorgetSet":
        String elem = coll_elem_type_for_name(name, &m)
        return elem == "GorgetString" or elem == "Str"
    return false

# Check if a specific arg index of a runtime function needs pointer passing.
bool needs_ptr_arg(String fn_name, int arg_idx):
    # Callable/closure dispatch: arg 0 (the callable) must be a pointer (void**)
    if arg_idx == 0 and (fn_name.starts_with("__callable_") or fn_name.starts_with("__gorget_closure_call_")):
        return true
    # Field reads: arg 0 (the struct) must be a pointer
    if arg_idx == 0 and fn_name.starts_with("__field_read_"):
        return true
    # Field writes: arg 0 (the struct) must be a pointer
    if arg_idx == 0 and fn_name.starts_with("__field_write_"):
        return true
    # Option/Result combinators: arg 1 (the closure) must be a pointer
    if arg_idx == 1 and (fn_name.starts_with("__option_") or fn_name.starts_with("__result_")):
        return true
    # Collection methods: arg 0 (self) is always passed by pointer for mutating methods.
    if arg_idx == 0:
        if fn_name == "gorget_array_push" or fn_name == "gorget_array_set":
            return true
        if fn_name == "gorget_array_insert" or fn_name == "gorget_array_remove_opt":
            return true
        if fn_name == "gorget_array_clear" or fn_name == "gorget_array_reverse":
            return true
        if fn_name == "gorget_array_sort" or fn_name == "gorget_array_extend":
            return true
        if fn_name == "gorget_array_fill":
            # `gorget_array_fill(GorgetArray* arr, size_t n, const void* val_src)`
            # — arg 0 self by pointer (mutating: preallocates capacity and
            # memcpys n copies of val into the buffer). Routed through
            # `Vector__T__fill` by `map_array_method`'s new case (2026-05-20).
            return true
        if fn_name == "gorget_array_free":
            return true
        if fn_name == "gorget_map_put" or fn_name == "gorget_map_remove":
            return true
        if fn_name == "gorget_map_clear" or fn_name == "gorget_map_free":
            return true
        if fn_name == "gorget_set_add" or fn_name == "gorget_set_remove":
            return true
        if fn_name == "gorget_set_clear" or fn_name == "gorget_set_free":
            return true
        if fn_name == "gorget_channel_send" or fn_name == "gorget_channel_close":
            return true
        if fn_name == "gorget_channel_recv" or fn_name == "gorget_channel_try_recv":
            return true
        # Read-only methods also take self by const pointer
        if fn_name == "gorget_array_safe_get" or fn_name == "gorget_array_len":
            return true
        # `gorget_array_get(const GorgetArray* arr, size_t idx)` — the
        # EIndex value-read getter (`v[i]`). Self (arg 0) is the array by
        # const pointer, exactly like gorget_map_get below. Without this the
        # array self-arg passes by value and cc rejects it.
        if fn_name == "gorget_array_get":
            return true
        if fn_name == "gorget_array_is_empty" or fn_name == "gorget_array_contains":
            return true
        if fn_name == "gorget_array_safe_last" or fn_name == "gorget_array_safe_first":
            return true
        if fn_name == "gorget_array_safe_pop" or fn_name == "gorget_array_index_of":
            return true
        if fn_name == "gorget_array_clone" or fn_name == "gorget_array_slice":
            return true
        if fn_name == "gorget_map_get" or fn_name == "gorget_map_len":
            return true
        if fn_name == "gorget_map_contains" or fn_name == "gorget_map_is_empty":
            return true
        if fn_name == "gorget_map_keys" or fn_name == "gorget_map_values":
            return true
        if fn_name == "gorget_map_items":
            return true
        if fn_name == "gorget_map_clone":
            return true
        if fn_name == "gorget_set_contains" or fn_name == "gorget_set_len":
            return true
        if fn_name == "gorget_set_clone" or fn_name == "gorget_set_is_empty":
            return true
        # `gorget_bytes_to_str(const GorgetArray* arr)` — reads a Vector[byte]
        # by const pointer (`__bytes_to_str_raw` / `.to_str()` on a byte
        # buffer). Without this, the array self-arg is passed by value and cc
        # rejects it (`incompatible type for argument 1 of gorget_bytes_to_str`).
        # Surfaced once the io.gg Writer-for-GorgetString impl became reachable
        # via the FIDELITY vtable globals. Mirrors Rust gg's by-pointer ABI.
        if fn_name == "gorget_bytes_to_str":
            return true
        # Note: gorget_str_codepoint_count takes Str by value, NOT by pointer.
        # Clone fns (used by emit_payload_read's blocker-2 path for
        # resource-typed payloads) take the source by `const T*`.
        if fn_name == "gorget_string_clone" or fn_name == "gorget_string_clone_to_owned":
            return true
        if fn_name == "gorget_closure_clone" or fn_name == "gorget_closure_clone_to_owned":
            return true
        # User-type `T__clone` fns (generated by the codegen for any
        # struct/enum with recursive-drop sub-fields) all take `void* __p`
        # in their C signature — emit a SlotAddr for the source.
        if fn_name.ends_with("__clone"):
            return true
    # Element args passed by pointer
    if fn_name == "gorget_array_push" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_set" and arg_idx == 2:
        return true
    if fn_name == "gorget_array_insert" and arg_idx == 2:
        return true
    if fn_name == "gorget_array_fill" and arg_idx == 2:
        # Third arg (val_src) is `const void*` — pointer to the element
        # to broadcast across the n filled slots.
        return true
    if fn_name == "gorget_map_put" and (arg_idx == 1 or arg_idx == 2):
        return true
    if fn_name == "gorget_array_contains" and arg_idx == 1:
        return true
    if fn_name == "gorget_map_get" and arg_idx == 1:
        return true
    if fn_name == "gorget_map_contains" and arg_idx == 1:
        return true
    if fn_name == "gorget_map_remove" and arg_idx == 1:
        return true
    if fn_name == "gorget_set_add" and arg_idx == 1:
        return true
    if fn_name == "gorget_set_contains" and arg_idx == 1:
        return true
    if fn_name == "gorget_set_remove" and arg_idx == 1:
        return true
    if fn_name == "gorget_channel_send" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_extend" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_index_of" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_safe_remove" and arg_idx == 1:
        return true
    # File I/O runtime fns that take aggregate output/buffer structs by pointer.
    # Previously handled by `runtime_arg_needs_addr` in lir_codegen — hoisted
    # to the lir_lower boundary so a SlotAddr carries the pointer natively.
    if fn_name == "gorget_file_open_try" and arg_idx == 2:
        return true
    if fn_name == "gorget_file_write_bytes_buf" and arg_idx == 1:
        return true
    if fn_name == "gorget_file_read_bytes_buf" and arg_idx == 1:
        return true
    return false

# Check if a GIR type ID represents a pointer type (Ptr or MutPtr).
bool is_ptr_type(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType ty = gmod.type_table.get(tid).unwrap()
    match ty:
        case GtPtr(_):
            return true
        case GtMutPtr(_):
            return true
        else:
            return false

# Check if a function name starts with a scalar type prefix (e.g. int64_t__push).
# These come from the self-host GIR where T__method is used instead of Vector__T__method.
bool is_scalar_type_prefix(String name):
    if name.starts_with("int64_t__") or name.starts_with("int32_t__"):
        return true
    if name.starts_with("int16_t__") or name.starts_with("int8_t__"):
        return true
    if name.starts_with("uint64_t__") or name.starts_with("uint32_t__"):
        return true
    if name.starts_with("uint16_t__") or name.starts_with("uint8_t__"):
        return true
    if name.starts_with("double__") or name.starts_with("float__"):
        return true
    if name.starts_with("bool__"):
        return true
    return false

# Size-aware variant used at lower_instruction's `gorget_array_contains`
# site where the element may be a user struct requiring real size lookup.
# True for runtime functions that return a void* pointing to an element
# inside a collection (`Vector.get / .safe_get / .first / .last / .pop`,
# `Dict.get / .remove`). The self-host's `infer_method_return_type`
# flattens these to return the element type directly, but at the C level
# they still return void*. For scalar-element callers, the pointer must
# be dereferenced into the scalar — otherwise the pointer address flows
# downstream as if it were the value. Called from the GICallExtern
# lowering to decide whether to insert an ILoad before the SlotStore.
bool returns_ptr_to_element(String name):
    if name == "gorget_array_get" or name == "gorget_array_safe_get":
        return true
    if name == "gorget_map_get":
        return true
    if name == "gorget_array_safe_last" or name == "gorget_array_safe_first" or name == "gorget_array_safe_pop":
        return true
    if name == "gorget_map_remove" or name == "gorget_array_remove_opt":
        return true
    return false

# ── Tier 1 lift: collection void* → Option wrap ─────────────────
bool is_collection_void_return(String name):
    if name == "gorget_array_get" or name == "gorget_array_pop":
        return true
    if name == "gorget_array_first" or name == "gorget_array_last":
        return true
    if name == "gorget_array_safe_get" or name == "gorget_array_safe_pop":
        return true
    if name == "gorget_array_safe_first" or name == "gorget_array_safe_last":
        return true
    if name == "gorget_array_remove_opt":
        return true
    if name == "gorget_map_get" or name == "gorget_map_remove_opt":
        return true
    if name == "gorget_heap_pop" or name == "gorget_heap_peek":
        return true
    if name == "gorget_shared_get" or name == "gorget_shared_get_ptr":
        return true
    if name == "gorget_channel_recv":
        return true
    return false

bool is_consuming_collection_method(String name):
    if name == "gorget_array_safe_pop" or name == "gorget_array_remove_opt":
        return true
    if name == "gorget_map_remove" or name == "gorget_map_remove_opt":
        return true
    if name == "gorget_set_remove":
        return true
    return false

String resource_clone_fn(int payload_ty, LirModule &m):
    if payload_ty < LT_STRUCT_BASE:
        return ""
    int sid = payload_ty - LT_STRUCT_BASE
    if sid >= m.structs.len():
        return ""
    LirStructDef sdef = m.structs.get(sid).unwrap()
    String name = sdef.name
    if name == "GorgetArray":
        return "gorget_array_clone"
    if name == "GorgetMap":
        return "gorget_map_clone"
    if name == "GorgetSet":
        return "gorget_set_clone"
    if name == "GorgetString":
        return "gorget_string_clone_to_owned"
    if name == "GorgetClosure":
        return "gorget_closure_clone_to_owned"
    if m.recursive_drop_structs.contains(name) or m.recursive_drop_enums.contains(name):
        return name + "__clone"
    return ""

# `dst_is_borrow` (CoW collection-get default): when the GIR result
# local is tagged LoBorrowed/LoView (a non-consuming `.get()`/`.first()`/
# `.last()` whose Option aliases the collection element per CLAUDE.md
# "Ownership at Consuming Positions": collection element reads propagate
# Ptr aliases at zero cost), do NOT deep-clone the aggregate payload into
# the Option — shallow-copy the element header (a borrow alias). The
# borrowed Option is dropped-skipped (a-1) and clone-materialised only at
# genuine consume sites via op_consume's a-5 LoBorrowed→OpClone arm. This
# closes the for-element clone bomb: `for x in coll` over a Vector of
# structs no longer clones every element (was 10M+ Stmt/SpannedExpr clones
# → ~14.5 GB OOM in the self-host driver). Owned results (LoOwned, e.g. a
# `.get().clone()` whose binding owns) keep the eager clone.
int emit_void_ptr_option_wrap(String emit_name, int dst_local, int opt_sid, Vector[int] lir_args, LirFunction &f, int bb, Vector[int] &local_to_slot, LirModule &m, bool dst_is_borrow):
    int raw_ptr = lir_fn_next_value(&f)
    Vector[int] empty_abis = []
    lir_push_inst(&f, bb, ICallExtern(raw_ptr, emit_name, lir_args, emit_name, empty_abis))

    int raw_slot = lir_fn_add_slot(&f, LT_PTR, "")
    lir_push_inst(&f, bb, ISlotStore(raw_slot, raw_ptr, false))

    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_addr_pre = lir_fn_next_value(&f)
    int sz_val = lir_fn_next_value(&f)
    int zero_byte = lir_fn_next_value(&f)
    int sz_bytes = lir_type_byte_size_in_mod(LT_STRUCT_BASE + opt_sid, &m, 0)
    lir_push_inst(&f, bb, ISlotAddr(slot_addr_pre, dst_slot))
    lir_push_inst(&f, bb, IIConst(sz_val, LT_I64, sz_bytes))
    lir_push_inst(&f, bb, IIConst(zero_byte, LT_I32, 0))
    lir_push_inst(&f, bb, IMemset(slot_addr_pre, zero_byte, sz_val))

    int null_val = lir_fn_next_value(&f)
    int is_not_null = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, INullPtr(null_val))
    lir_push_inst(&f, bb, ICmp(is_not_null, CMP_NE, raw_ptr, null_val))

    int some_bb = lir_fn_add_block(&f)
    int none_bb = lir_fn_add_block(&f)
    int merge_bb = lir_fn_add_block(&f)
    Vector[int] empty_args0 = []
    Vector[int] empty_args1 = []
    lir_set_term(&f, bb, TBranch(is_not_null, some_bb, empty_args0, none_bb, empty_args1))

    LirStructDef opt_def = m.structs.get(opt_sid).unwrap()
    int payload_field_ty = LT_I64
    if opt_def.fields.len() >= 2:
        payload_field_ty = opt_def.fields.get(1).unwrap().ty
    bool payload_is_ptr = (payload_field_ty == LT_PTR) or (payload_field_ty >= LT_PTR_TO_BASE and payload_field_ty < LT_STRUCT_BASE)
    bool consuming = is_consuming_collection_method(emit_name)

    int raw_in_some = lir_fn_next_value(&f)
    lir_push_inst(&f, some_bb, ISlotLoad(raw_in_some, raw_slot, LT_PTR))

    int payload_val = -1
    if payload_is_ptr:
        payload_val = raw_in_some
    elif lir_is_aggregate(payload_field_ty):
        String clone_fn = ""
        # CoW: clone the aggregate element into the Option ONLY when the
        # result must own it. Consuming methods (pop/remove) already
        # transferred ownership out of the collection → no clone (shallow
        # move). Non-consuming gets whose GIR local is a borrow alias
        # (dst_is_borrow) → no clone either (the Option borrows the
        # element; consume sites clone on demand). Eager clone remains
        # only for owned (non-borrow) non-consuming results.
        if not consuming and not dst_is_borrow:
            clone_fn = resource_clone_fn(payload_field_ty, &m)
        if clone_fn != "":
            int cloned = lir_fn_next_value(&f)
            Vector[int] cargs = []
            cargs.push(raw_in_some)
            Vector[int] cabis = []
            lir_push_inst(&f, some_bb, ICallExtern(cloned, clone_fn, cargs, clone_fn, cabis))
            int cl_slot = lir_fn_add_slot(&f, payload_field_ty, "")
            int cl_addr = lir_fn_next_value(&f)
            lir_push_inst(&f, some_bb, ISlotStore(cl_slot, cloned, true))
            lir_push_inst(&f, some_bb, ISlotAddr(cl_addr, cl_slot))
            payload_val = cl_addr
        else:
            payload_val = raw_in_some
    else:
        int loaded = lir_fn_next_value(&f)
        lir_push_inst(&f, some_bb, ILoad(loaded, raw_in_some, payload_field_ty))
        payload_val = loaded

    int some_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] some_fields = []
    some_fields.push(FieldInit(1, payload_val))
    lir_push_inst(&f, some_bb, ISlotAddr(some_slot_addr, dst_slot))
    lir_push_inst(&f, some_bb, IEnumInit(some_slot_addr, opt_sid, 0, some_fields))
    Vector[int] empty_args_s = []
    lir_set_term(&f, some_bb, TJump(merge_bb, empty_args_s))

    int none_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] none_fields = []
    lir_push_inst(&f, none_bb, ISlotAddr(none_slot_addr, dst_slot))
    lir_push_inst(&f, none_bb, IEnumInit(none_slot_addr, opt_sid, 1, none_fields))
    Vector[int] empty_args_n = []
    lir_set_term(&f, none_bb, TJump(merge_bb, empty_args_n))

    return merge_bb

int extract_elem_size_from_name_in_mod(String name, Dict[String, int] &sr, LirModule &m):
    String elem = coll_elem_type_for_name(name, &m)
    if elem != "":
        return type_elem_size_in_mod(elem, &sr, &m)
    return 8

String extract_method_name(String name):
    # Find the last "__" and return everything after it
    int last_pos = -1
    int i = 0
    while i < name.len() - 1:
        String c1 = name.slice(i, i + 1)
        String c2 = name.slice(i + 1, i + 2)
        if c1 == "_" and c2 == "_":
            last_pos = i
        i += 1
    if last_pos >= 0 and last_pos + 2 < name.len():
        return name.slice(last_pos + 2, name.len())
    return ""

# ── Canonical-op helpers ────────────────────────────────────

# For prelude variant names (Some/None/Ok/Error), return (variant_tag,
# payload_field_index). payload_field_index = -1 when the variant has no
# payload. Returns (-1, -1) for non-prelude names.
struct VariantInfo:
    int tag
    int payload_field

VariantInfo prelude_variant_info(String name):
    if name == "Some":
        return VariantInfo(0, 1)
    if name == "None":
        return VariantInfo(1, -1)
    if name == "Ok":
        return VariantInfo(0, 1)
    if name == "Error":
        return VariantInfo(1, 2)
    return VariantInfo(-1, -1)

# Attempt to lower a prelude variant constructor (Some/None/Ok/Error) as a
# canonical IEnumInit filling the dst slot in place. Returns true on success;
# false means the caller should fall through to the normal ICallExtern path.
bool try_lower_prelude_variant(String func_name, int dst_local, Vector[Operand] args, LirFunction &f, int bb, Vector[int] &local_to_slot, LirModule &m):
    if dst_local < 0:
        return false
    VariantInfo vi = prelude_variant_info(func_name)
    if vi.tag < 0:
        return false
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_ty = f.slots.get(dst_slot).unwrap().ty
    # Slot must be typed as the parent enum struct. If the self-host lost
    # the type (scalar placeholder), fall back to the old emission path.
    if slot_ty < LT_STRUCT_BASE:
        return false
    int struct_id = slot_ty - LT_STRUCT_BASE
    # Payload value (if variant has a payload field).
    Vector[FieldInit] fields = []
    if vi.payload_field >= 0 and args.len() >= 1:
        Operand payload = args.get(0).unwrap()
        int pval = lower_operand(payload, &f, bb, &local_to_slot, &m)
        fields.push(FieldInit(vi.payload_field, pval))
    # Take the slot's address and emit IEnumInit writing in place.
    int target = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(target, dst_slot))
    lir_push_inst(&f, bb, IEnumInit(target, struct_id, vi.tag, fields))
    return true

# Runtime-provided struct names whose layout the compiler treats as
# opaque. User struct construction for these goes through the runtime
# (`gorget_string_new`, `gorget_array_new`, etc.) — they are NOT lowered
# via IStructInit and must not match the user-struct-ctor intercept.
bool is_runtime_struct_name(String name):
    if name == "GorgetString" or name == "Str" or name == "String":
        return true
    if name == "GorgetArray" or name == "GorgetMap" or name == "GorgetSet":
        return true
    if name == "GorgetClosure" or name == "TraitObj":
        return true
    return false

# Attempt to lower a user struct constructor (e.g. `SpannedToken(tok, s, e)`)
# as a canonical IStructInit filling the dst slot in place. Returns true on
# success; false means the caller should fall through to the old emission
# path (inline `(T){...}` struct literal) which miscompiles by-pointer
# struct-typed args as pointer-to-struct assignments.
bool try_lower_user_struct_ctor(String func_name, int dst_local, Vector[Operand] args, LirFunction &f, int bb, Vector[int] &local_to_slot, Dict[String, int] &sr, LirModule &m):
    if dst_local < 0:
        return false
    # Skip names that other intercepts already own.
    if func_name == "Box" or func_name == "Some" or func_name == "None":
        return false
    if func_name == "Ok" or func_name == "Error":
        return false
    # Runtime-provided opaque types construct via the runtime, not IStructInit.
    if is_runtime_struct_name(func_name):
        return false
    # Look up the struct in the registry. Absent → not a struct ctor.
    int sid = sr.get(func_name).unwrap_or(-1)
    if sid < 0 or sid >= m.structs.len():
        return false
    LirStructDef sdef = m.structs.get(sid).unwrap()
    # Enums + enum variants have different init semantics; skip them.
    if sdef.enum_kind != EK_NOT_ENUM:
        return false
    if m.enum_variant_parent.contains(func_name):
        return false
    # Require positional ctor — arg count must match field count exactly.
    # A mismatch usually means this is a method call that happens to share
    # a name with a struct, or a coercion like `String(x)`.
    if args.len() != sdef.fields.len():
        return false
    # The dst slot must be typed as the target struct. If the self-host
    # lost the type along the way, the old path handles placeholder cases
    # more forgivingly — defer to it.
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_ty = f.slots.get(dst_slot).unwrap().ty
    if slot_ty != LT_STRUCT_BASE + sid:
        return false
    # Lower each arg into a FieldInit entry keyed on the field index.
    Vector[FieldInit] fields = []
    int ai = 0
    while ai < args.len():
        Operand a = args.get(ai).unwrap()
        int aval = lower_operand(a, &f, bb, &local_to_slot, &m)
        fields.push(FieldInit(ai, aval))
        ai += 1
    # Emit SlotAddr + IStructInit. emit_field_store (invoked by the codegen
    # expansion) does per-field memcpy for struct-typed fields — the
    # specific fix for the stage-1 SpannedToken(!tok, …) miscast.
    int target = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(target, dst_slot))
    lir_push_inst(&f, bb, IStructInit(target, sid, fields))
    return true

# ── Operand lowering ────────────────────────────────────────

# Returns the LIR type an operand would produce when lowered. Used by
# canonical-op emitters that need the value's type without lowering it yet.
int operand_lir_type(Operand op, LirFunction &f, Vector[int] &local_to_slot):
    match op:
        case OpConstBool(_):
            return LT_BOOL
        case OpConstI32(_):
            return LT_I32
        case OpConstI64(_):
            return LT_I64
        case OpConstF64(_):
            return LT_F64
        case OpConstStr(_):
            return LT_PTR
        case OpConstNull():
            return LT_PTR
        case OpConstUnit():
            return LT_I32
        case OpSizeOf(_):
            return LT_I64
        case OpCopy(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpMove(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpClone(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpBorrow(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
    return LT_VOID

# Compute the `inner_ty` for IBoxAlloc from an arg operand. By-pointer
# param slots (typed LT_PTR_TO_BASE+sid) are semantically the struct
# VALUE being moved into the Box, not the pointer — unwrap so the Box's
# type inference finds Box__<inner_struct_name>.
int box_inner_ty_from_operand(Operand op, LirFunction &f, Vector[int] &local_to_slot):
    int ty = operand_lir_type(op, &f, &local_to_slot)
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return LT_STRUCT_BASE + (ty - LT_PTR_TO_BASE)
    return ty

# Canonical `Box(x)` lowering: emit IBoxAlloc and store the heap pointer into
# the result slot. Shared by the GICall and GICallExtern handlers.
#
# Retypes the result slot to its `Box__<inner>` struct type when the GIR left
# it scalar (`i64`). The prelude `Box(x)` ctor is absent from fn_sigs/type_infos,
# so lower.gg defaults the result local to I64 → a scalar slot. IBoxAlloc
# produces a `Box__<inner>`-typed (pointer-represented, `typedef void* Box__T`)
# value; storing it into the scalar slot hit ISlotStore's "aggregate-into-scalar
# → 0" give-up, NULLing the box, and the downstream `EFieldAccess(box, …)`
# variant ctor then emitted `(Box__T){0}` → `parse_dot_expr`'s
# `EFieldAccess(Box(lhs), …)` returned a NULL boxed base → deref SIGSEGV in
# `Expr__clone`. Aligning the slot type with IBoxAlloc's result type makes the
# store a direct copy and the variant-arg read pass the box pointer through.
# The Rust-gg driver tolerates the I64 GIR typing because its `run_ssa` keeps
# the box value live in a register; the self-host `lower_gir_to_lir` has none.
# Done at the LIR slot level (not the GIR type) so the GIR-level struct-ctor
# routing is untouched.
void emit_box_alloc(int dst_local, Operand box_arg, LirFunction &f, int bb, Vector[int] &local_to_slot, Dict[String, int] &sr, LirModule &m):
    int box_inner_ty = box_inner_ty_from_operand(box_arg, &f, &local_to_slot)
    int box_val = lower_operand(box_arg, &f, bb, &local_to_slot, &m)
    int box_dst = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IBoxAlloc(box_dst, box_inner_ty, box_val))
    int box_dst_slot = local_to_slot.get(dst_local).unwrap()
    int cur_box_slot_ty = f.slots.get(box_dst_slot).unwrap().ty
    if not lir_is_aggregate(cur_box_slot_ty) and box_inner_ty >= LT_STRUCT_BASE:
        int box_inner_sid = box_inner_ty - LT_STRUCT_BASE
        if box_inner_sid >= 0 and box_inner_sid < m.structs.len():
            String box_inner_name = m.structs.get(box_inner_sid).unwrap().name
            int box_sid = sr.get("Box__" + box_inner_name).unwrap_or(-1)
            if box_sid >= 0:
                LirSlot old_box_slot = f.slots.get(box_dst_slot).unwrap()
                f.slots.set(box_dst_slot, LirSlot(LT_STRUCT_BASE + box_sid, old_box_slot.name))
    lir_push_inst(&f, bb, ISlotStore(box_dst_slot, box_dst, false))

int lower_operand(Operand op, LirFunction &f, int bb, Vector[int] &local_to_slot, LirModule &m):
    match op:
        case OpConstBool(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IBoolConst(dst, v))
            return dst
        case OpConstI32(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I32, v))
            return dst
        case OpConstI64(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I64, v))
            return dst
        case OpConstF64(v):
            int dst = lir_fn_next_value(&f)
            # Store the float's TRUE IEEE-754 bit pattern (not `v as int`, which
            # TRUNCATES the value). C-emit memcpy's these bits back into a double
            # (lir_codegen.gg IFConst), so the constant round-trips exactly.
            # Mirrors Rust Constant::F64(v) → Inst::FConst{bits: v.to_bits()}
            # (src/lir/lower/operands.rs:111).
            lir_push_inst(&f, bb, IFConst(dst, LT_F64, float_to_bits(v)))
            return dst
        case OpConstStr(s):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IStrLit(dst, s))
            return dst
        case OpConstNull():
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, INullPtr(dst))
            return dst
        case OpConstUnit():
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I32, 0))
            return dst
        case OpSizeOf(tid):
            int dst = lir_fn_next_value(&f)
            # TODO: compute actual size from type
            lir_push_inst(&f, bb, IIConst(dst, LT_I64, 8))
            return dst
        case OpCopy(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpMove(local_id):
            # OpMove: load value like OpCopy. The GICallExtern handler
            # converts to SlotAddr when needs_ptr_arg is true.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpClone(local_id):
            # Phase 2c COMMIT 2 + Phase 2.3: OpClone lowers to a real
            # runtime clone call when the source slot holds (or points
            # to) a resource value.
            #
            #   • Value-typed slot (`slot_ty >= LT_STRUCT_BASE`):
            #     `resource_clone_fn` returns the matching
            #     `gorget_*_clone` / `T__clone` symbol for the struct;
            #     we pass `ISlotAddr(slot)` as the by-pointer arg.
            #   • Ptr-to-known-struct slot (`LT_PTR_TO_BASE + sid`):
            #     the slot HOLDS a pointer to the resource (A.2 wired
            #     Ptr-typed dsts at GIFieldLoad reads of resource
            #     fields; B.1 wired Ptr-typed dsts at OpBorrow-source
            #     SVarDecl bindings). The clone fn for the pointee
            #     struct (`LT_STRUCT_BASE + sid`) takes a pointer-to-
            #     resource and produces a fresh owned copy — exactly
            #     what we need. Pass the slot's loaded value (which
            #     IS the pointer) as the by-pointer arg.
            #
            # Without the Ptr-typed branch this handler would fall
            # through to a plain `ISlotLoad` — a byte-copy of the
            # pointer — and the receiver would alias the source
            # buffer. When the source goes out of scope its storage
            # is reclaimed, leaving the receiver's "copy" dangling.
            # Concrete chain: `lower_function` returns a `GirFunction`
            # embedding `ctx.locals`; with A.2 the receiver's local
            # slot is Ptr-typed; without this clone, `gmod.functions`
            # held aliased pointers into freed ctx storage. See
            # `op_consume`'s GtPtr branch (Phase 2.3 Change 1) for the
            # paired writer-side wiring that produces OpClone here.
            #
            # For raw `LT_PTR` slots (no pointee struct info encoded)
            # we have no type signal to pick a clone fn — fall
            # through to plain load (the upstream layer is responsible
            # for tagging these with a more specific type).
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            String clone_fn = ""
            bool slot_is_ptr_to_struct = (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
            bool slot_is_raw_ptr = (slot_ty == LT_PTR)
            if slot_is_ptr_to_struct:
                # Ptr-to-known-struct: route to the pointee's clone fn.
                int pointee_sid = slot_ty - LT_PTR_TO_BASE
                clone_fn = resource_clone_fn(LT_STRUCT_BASE + pointee_sid, &m)
            elif not slot_is_raw_ptr:
                # Value-typed (aggregate / struct) slot: look up the
                # struct's clone fn directly.
                clone_fn = resource_clone_fn(slot_ty, &m)
            if clone_fn != "":
                int dst = lir_fn_next_value(&f)
                Vector[int] cargs = []
                Vector[int] cabis = []
                if slot_is_ptr_to_struct:
                    # The slot already holds a pointer-to-resource —
                    # load the pointer value and pass it directly.
                    int ptr_val = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotLoad(ptr_val, slot, slot_ty))
                    cargs.push(ptr_val)
                else:
                    # Value-typed slot — take its address to pass by
                    # pointer to the clone fn.
                    int addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                    cargs.push(addr)
                lir_push_inst(&f, bb, ICallExtern(dst, clone_fn, cargs, clone_fn, cabis))
                return dst
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpBorrow(local_id):
            # Phase D step 3: OpBorrow tagged at the GIR layer for an
            # explicit non-owning alias. LIR currently lowers it as a
            # plain load; the consumer (call arg / assign) decides
            # whether to take a SlotAddr or load the value. Behavioural
            # parity with OpCopy preserved for non-resource locals.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
    return -1

# ── Instruction lowering ────────────────────────────────────

# Unwrap Ptr/MutPtr to reach the underlying named type. Used by GIDrop /
# GIDropIfAlive to resolve the type name of the local being dropped so the
# matching `<Type>__drop` / `gorget_*_free` runtime symbol can be looked up
# via `drop_fn_for_type`. Mirrors `lower.gg::type_id_to_base_name`; kept
# local to `lir_lower.gg` to avoid a cross-module import.
String gir_type_id_to_base_name(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return ""
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name
        case GtPtr(inner):
            return gir_type_id_to_base_name(inner, &gmod)
        case GtMutPtr(inner):
            return gir_type_id_to_base_name(inner, &gmod)
        else:
            return ""

# Look up a GIR local's type name for drop-fn resolution. Returns "" when
# the local is out of range or its type is a primitive / fn-ptr that has
# no drop function.
String gir_local_type_name(int local_id, Vector[GirLocal] &gir_locals, GirModule &gmod):
    if local_id < 0 or local_id >= gir_locals.len():
        return ""
    int tid = gir_locals.get(local_id).unwrap().type_id
    return gir_type_id_to_base_name(tid, &gmod)

# True iff the GIR local is a FOR-LOOP element borrow — tagged by
# lower_for_vector with BoCollectionElement(coll_local) where coll_local
# is the non-negative source-collection local id. The general `.get()`
# path uses BoCollectionElement(-1), which returns false here so its
# result still owns (eager clone) — protecting the get-mutate-set idiom
# (`t = coll.get(i); t.push(x); coll.set(i, t)`) that relies on `t` being
# an independent owned copy. Only the for-element, whose full lifecycle the
# loop scaffold controls (read-only body → borrow; consume/mutate → a-5
# clone), is safe to shallow-alias. This is the CoW collection-read default
# scoped to the one site that can guarantee it.
bool gir_local_is_for_element(int local_id, Vector[GirLocal] &gir_locals):
    if local_id < 0 or local_id >= gir_locals.len():
        return false
    match gir_locals.get(local_id).unwrap().borrow_origin:
        case BoCollectionElement(coll_local):
            return coll_local >= 0
        else:
            return false

# closure Phase 2 Step B: the LIR closure-pack promotion (mirrors Rust gg's
# `try_closure_pack`, src/lir/lower/operands.rs:1233-1355). When a
# `__Closure_N`-typed value is assigned into a `GorgetClosure`-typed slot,
# REPLACE the plain copy with: heap-alloc the env via
# `__gorget_closure_env_alloc(size)` + memcpy the STACK env into it +
# IClosurePack(dst_slot, heap_ptr, call_func, false). Returns true when it
# fired (the GIAssign arm then skips the plain store).
#
# Detection: dst's GIR local type name == "GorgetClosure" AND src
# (OpCopy/OpMove operand) GIR local type name starts with "__Closure_".
# This is the typed-name read Rust performs at operands.rs:1293 — the env
# struct name → its `__Closure_N__call` LIR fn is the C-emit-boundary
# name-derived mapping the brief sanctions (no typed cid channel from the
# make-site through to here exists yet; the call fn is resolved via
# func_index by the derived name).
bool try_closure_pack(int dst_local, Operand operand, LirFunction &f, int bb, Vector[int] &local_to_slot, Vector[GirLocal] &gir_locals, Dict[String, int] &func_index, GirModule &gmod, LirModule &m):
    if dst_local < 0 or dst_local >= local_to_slot.len():
        return false
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    # The destination must be the GorgetClosure runtime singleton.
    if dst_local >= gir_locals.len():
        return false
    int dst_tid = gir_locals.get(dst_local).unwrap().type_id
    if gir_type_id_to_base_name(dst_tid, &gmod) != "GorgetClosure":
        return false
    # The source must be an OpCopy/OpMove of a __Closure_N-typed local.
    int src_local = -1
    match operand:
        case OpCopy(sl):
            src_local = sl
        case OpMove(sl):
            src_local = sl
        else:
            return false
    if src_local < 0 or src_local >= gir_locals.len():
        return false
    int src_tid = gir_locals.get(src_local).unwrap().type_id
    String src_name = gir_type_id_to_base_name(src_tid, &gmod)
    if not src_name.starts_with("__Closure_"):
        return false
    # Resolve the __Closure_N__call LIR function index.
    String call_fn_name = src_name + "__call"
    if not func_index.contains(call_fn_name):
        return false
    int call_func = func_index.get(call_fn_name).unwrap()
    # Compute the env size from the source slot's LIR struct type.
    if src_local >= local_to_slot.len():
        return false
    int src_slot = local_to_slot.get(src_local).unwrap()
    int src_slot_ty = f.slots.get(src_slot).unwrap().ty
    int env_size = lir_type_byte_size_in_mod(src_slot_ty, &m, 0)
    # Emit: size_val = const env_size.
    int size_val = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IIConst(size_val, LT_I64, env_size))
    # Emit: heap_ptr = __gorget_closure_env_alloc(size_val). The runtime
    # provides it as a `static inline` (runtime_string.c) — no forward decl
    # or extern declaration needed.
    int heap_ptr = lir_fn_next_value(&f)
    Vector[int] alloc_args = [size_val]
    Vector[int] alloc_abis = []
    lir_push_inst(&f, bb, ICallExtern(heap_ptr, "__gorget_closure_env_alloc", alloc_args, "__gorget_closure_env_alloc", alloc_abis))
    # Emit: memcpy(heap_ptr, &stack_env, size_val).
    int src_addr = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(src_addr, src_slot))
    lir_push_inst(&f, bb, IMemcpy(heap_ptr, src_addr, size_val))
    # Emit: ClosurePack { slot: dst_slot, env_ptr: heap_ptr, call_func }.
    lir_push_inst(&f, bb, IClosurePack(dst_slot, heap_ptr, call_func, false))
    return true

int lower_instruction(Instruction inst, LirFunction &f, int bb, Vector[int] &local_to_slot, Vector[GirLocal] &gir_locals, Dict[String, int] &func_index, GirModule &gmod, Dict[String, int] &sr, LirModule &m):
    match inst:
        case GIAssign(local_id, operand):
            # closure Phase 2 Step B: promote a __Closure_N → GorgetClosure
            # assign into a real heap env-alloc + memcpy + ClosurePack (the
            # `try_closure_pack` equivalent). Must run BEFORE the plain
            # store / OpBorrow-Ptr dispatch — it fully handles the assign.
            if try_closure_pack(local_id, operand, &f, bb, &local_to_slot, &gir_locals, &func_index, &gmod, &m):
                return bb
            # D.1 (2026-05-22) — OpBorrow + Ptr-typed-dst + value-typed-src
            # dispatch. The canonical alias shape from B.1's Branch C is
            # `GIAssign(dst, OpBorrow(src))` where the GIR layer tags dst
            # as a borrow alias of src. When dst's slot is Ptr-typed
            # (Branch C retyped per the D.1 follow-up) and src's slot is
            # value-typed (aggregate stored inline), the previous shape
            # `ISlotLoad(src) → ISlotStore(dst)` would byte-copy the
            # aggregate's first 8 bytes into the pointer slot — silently
            # corrupting the alias.
            #
            # Fix: when both conditions match, emit `ISlotAddr(src) →
            # ISlotStore(dst)` instead. The dst slot now holds the address
            # of src's storage; downstream Ptr-typed-slot consumers
            # (GIFieldLoad auto-deref at line ~3164, GICall pass-by-ptr at
            # line ~2602, GICallExtern pass-by-ptr at line ~2891, OpClone
            # short-circuit at line ~2411) all handle Ptr-typed slots
            # correctly, so the alias propagates without further work.
            #
            # Symmetric matches (both Ptr OR both value) keep the byte-copy
            # path — that's the correct shape for both (Ptr→Ptr is pointer
            # copy = alias; value→value is the unconditional byte-copy
            # B.1's pragma already relies on). The OpBorrow operand
            # case-disrcimination is the load-bearing signal: OpCopy /
            # OpMove / OpClone all retain `lower_operand` semantics.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            bool dst_is_ptr = (slot_ty == LT_PTR) or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
            bool handled = false
            if dst_is_ptr:
                # Ptr-typed dst receiving a VALUE-typed source: rebind the
                # pointer slot to the source's storage (`dst = &src`) rather
                # than byte-copying the aggregate's first 8 bytes into a
                # pointer slot (which lir_codegen's give-up branch turns into
                # `dst = NULL`).
                #
                # OpBorrow is the canonical alias shape (B.1 Branch C). But
                # the SAME shape arises for OpMove/OpCopy of a value-typed
                # source into a Ptr-typed dst — the loop-carried
                # rebind-pointer-to-new-value pattern. Canonical example:
                # `parse_expr_bp_with_lhs`'s `lhs = self.parse_dot_expr(lhs)`
                # where `lhs` is a `!`-param (Ptr-typed loop var) and the
                # call result is a by-value SpannedExpr. The GIR is
                # `_3 = move _10` (`move_zero` zeros the result temp `_10`);
                # Rust's codegen emits `lhs_ptr = &result` (the back-edge
                # rebind). Without this, the GIAssign stored NULL into the
                # pointer slot, so the next loop iteration passed NULL as the
                # `!`-moved arg → SIGSEGV reading `lhs.span` (TODO #2).
                #
                # OpClone is intentionally NOT routed here: it materialises a
                # fresh owned value via its own deref+clone path, not an
                # alias of an existing slot.
                int rebind_src = -1
                match operand:
                    case OpBorrow(sl):
                        rebind_src = sl
                    case OpMove(sl):
                        rebind_src = sl
                    case OpCopy(sl):
                        rebind_src = sl
                    else:
                        pass
                if rebind_src >= 0 and rebind_src < local_to_slot.len():
                    int src_slot = local_to_slot.get(rebind_src).unwrap()
                    int src_slot_ty = f.slots.get(src_slot).unwrap().ty
                    bool src_is_ptr = (src_slot_ty == LT_PTR) or (src_slot_ty >= LT_PTR_TO_BASE and src_slot_ty < LT_STRUCT_BASE)
                    if not src_is_ptr:
                        # Value-typed src + Ptr-typed dst: take the
                        # address of src's storage and store it as
                        # the dst's pointer value.
                        int addr_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotAddr(addr_val, src_slot))
                        lir_push_inst(&f, bb, ISlotStore(slot, addr_val, false))
                        handled = true
            if not handled:
                int val = lower_operand(operand, &f, bb, &local_to_slot, &m)
                lir_push_inst(&f, bb, ISlotStore(slot, val, false))

        case GIBinOp(dst_local, op, ty, lhs_op, rhs_op):
            int lhs = lower_operand(lhs_op, &f, bb, &local_to_slot, &m)
            int rhs = lower_operand(rhs_op, &f, bb, &local_to_slot, &m)
            int dst = lir_fn_next_value(&f)
            int lir_ty = map_gir_type(ty, &gmod, &sr)
            if op == OP_ADD:
                lir_push_inst(&f, bb, IAdd(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_SUB:
                lir_push_inst(&f, bb, ISub(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_MUL:
                lir_push_inst(&f, bb, IMul(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_ADD_WRAP:
                lir_push_inst(&f, bb, IAdd(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_SUB_WRAP:
                lir_push_inst(&f, bb, ISub(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_MUL_WRAP:
                lir_push_inst(&f, bb, IMul(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_BITAND:
                lir_push_inst(&f, bb, IBitAnd(dst, lir_ty, lhs, rhs))
            elif op == OP_BITOR:
                lir_push_inst(&f, bb, IBitOr(dst, lir_ty, lhs, rhs))
            elif op == OP_BITXOR:
                lir_push_inst(&f, bb, IBitXor(dst, lir_ty, lhs, rhs))
            elif op == OP_SHL:
                lir_push_inst(&f, bb, IShl(dst, lir_ty, lhs, rhs))
            elif op == OP_SHR:
                lir_push_inst(&f, bb, IShr(dst, lir_ty, lhs, rhs))
            elif op == OP_DIV:
                lir_push_inst(&f, bb, IDiv(dst, lir_ty, lhs, rhs))
            elif op == OP_REM:
                lir_push_inst(&f, bb, IRem(dst, lir_ty, lhs, rhs))
            elif op == OP_MOD:
                lir_push_inst(&f, bb, IMod(dst, lir_ty, lhs, rhs))
            # Store result
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GIUnOp(dst_local, op, ty, operand):
            int val = lower_operand(operand, &f, bb, &local_to_slot, &m)
            int dst = lir_fn_next_value(&f)
            int lir_ty = map_gir_type(ty, &gmod, &sr)
            if op == UNOP_NEG:
                lir_push_inst(&f, bb, INeg(dst, lir_ty, val))
            elif op == UNOP_NOT:
                lir_push_inst(&f, bb, INot(dst, val))
            elif op == UNOP_BITNOT:
                lir_push_inst(&f, bb, IBitNot(dst, lir_ty, val))
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICmp(dst_local, op, ty, lhs_op, rhs_op):
            int lhs = lower_operand(lhs_op, &f, bb, &local_to_slot, &m)
            int rhs = lower_operand(rhs_op, &f, bb, &local_to_slot, &m)
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ICmp(dst, op, lhs, rhs))
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICall(dst_local, func_name, args):
            # Canonical prelude variant constructors: Some/None/Ok/Error fill
            # the dst slot in place via IEnumInit. Struct id comes from the
            # slot's type — no codegen-side name inference needed.
            if try_lower_prelude_variant(func_name, dst_local, args, &f, bb, &local_to_slot, &m):
                return bb
            # Canonical user struct constructors — emits IStructInit with
            # per-field memcpy for struct-typed fields, fixing the stage-1
            # SEGV where inline struct literals cast a by-pointer arg into
            # a struct-typed field.
            if try_lower_user_struct_ctor(func_name, dst_local, args, &f, bb, &local_to_slot, &sr, &m):
                return bb
            # Canonical Box(x): emit IBoxAlloc with explicit inner_ty (unwrapped
            # from the operand's pointer-to-struct type if needed) so downstream
            # Some(Box(x)) resolves to Option__Box__T, not Option__GorgetString.
            if func_name == "Box" and args.len() == 1 and dst_local >= 0:
                emit_box_alloc(dst_local, args.get(0).unwrap(), &f, bb, &local_to_slot, &sr, &m)
                return bb
            # Lower call arguments — check function param types for Ptr(T) params.
            # User functions with resource-type bare params receive Ptr(T),
            # so the caller must pass SlotAddr (pointer) instead of SlotLoad (value).
            Vector[int] fn_param_tys = get_fn_param_types(func_name, &gmod)
            # Effective runtime name (post map_runtime_name) so the
            # `needs_ptr_arg` runtime ABI table is consulted here too — the
            # extern-by-value declaration of a runtime fn (e.g.
            # `extern "C" String __bytes_to_str_raw(Vector[uint8])` →
            # `gorget_bytes_to_str(const GorgetArray*)`) has a by-value GIR
            # param type, so `is_ptr_type` alone would pass the array by value
            # and cc rejects it. Mirrors the GICallExtern arm (line ~2993).
            String gic_eff_name = func_name
            String gic_mapped = map_runtime_name(func_name, &m, &gmod)
            if gic_mapped != "":
                gic_eff_name = gic_mapped
            Vector[int] lir_args = []
            int ai = 0
            while ai < args.len():
                Operand arg = args.get(ai).unwrap()
                # Check if this param is a pointer type in the function signature
                bool pass_by_ptr = false
                if ai < fn_param_tys.len():
                    int pty = fn_param_tys.get(ai).unwrap()
                    if is_ptr_type(pty, &gmod):
                        pass_by_ptr = true
                if not pass_by_ptr and needs_ptr_arg(gic_eff_name, ai):
                    pass_by_ptr = true
                if pass_by_ptr:
                    match arg:
                        case OpCopy(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                # Slot already holds a pointer — load value.
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpMove(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpClone(local_id):
                            # Phase 2c COMMIT 2 Site 2a (GICall pass-by-ptr):
                            # if the source slot holds a resource value, emit
                            # a runtime clone into a FRESH slot and pass the
                            # fresh slot's address. The callee receives an
                            # independent owned copy that it can consume or
                            # mutate without aliasing the caller's data.
                            # Pointer-kind slots fall through to the address
                            # shape (the value already IS a pointer; cloning
                            # the pointer alone wouldn't duplicate the pointee).
                            # Non-resource value types also fall through —
                            # they have no owned data to duplicate.
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            bool slot_is_ptr_kind = (slot_ty == LT_PTR) or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
                            String clone_fn = ""
                            if not slot_is_ptr_kind:
                                clone_fn = resource_clone_fn(slot_ty, &m)
                            if clone_fn != "":
                                int src_addr = lir_fn_next_value(&f)
                                int cloned_val = lir_fn_next_value(&f)
                                int new_slot = lir_fn_add_slot(&f, slot_ty, "")
                                int new_addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(src_addr, slot))
                                Vector[int] cargs = []
                                cargs.push(src_addr)
                                Vector[int] cabis = []
                                lir_push_inst(&f, bb, ICallExtern(cloned_val, clone_fn, cargs, clone_fn, cabis))
                                lir_push_inst(&f, bb, ISlotStore(new_slot, cloned_val, true))
                                lir_push_inst(&f, bb, ISlotAddr(new_addr, new_slot))
                                lir_args.push(new_addr)
                            elif slot_is_ptr_kind:
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpBorrow(local_id):
                            # Phase D step 3: borrow → always pass slot
                            # address (the canonical borrow shape).
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        else:
                            int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                            lir_args.push(arg_val)
                else:
                    int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                    lir_args.push(arg_val)
                ai += 1

            # Check if it's a known function
            if func_index.contains(func_name):
                int func_id = func_index.get(func_name).unwrap()
                int dst = -1
                if dst_local >= 0:
                    dst = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, ICall(dst, func_id, lir_args))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))
            else:
                # Extern or runtime call
                String mapped = map_runtime_name(func_name, &m, &gmod)
                String call_name = func_name
                if mapped != "":
                    call_name = mapped
                # Collection constructors need element size argument(s)
                if is_collection_constructor(func_name, &m, &gmod):
                    # Phase A: dispatch on type_runtime_map category; avoids starts_with.
                    String coll_cat2 = type_category_for_name(func_name, &m)
                    if coll_cat2 == "GorgetMap":
                        # Dict/Map: need key_size + val_size, or just val_size for _str variant
                        String key_ty = coll_key_type_for_name(func_name, &m)
                        String val_ty = coll_val_type_for_name(func_name, &m)
                        if is_string_keyed(func_name, &m):
                            # _str variant: only val_size
                            int val_size = type_elem_size_in_mod(val_ty, &sr, &m)
                            int vs = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(vs, LT_I64, val_size))
                            lir_args.push(vs)
                        else:
                            int key_size = type_elem_size_in_mod(key_ty, &sr, &m)
                            int val_size = type_elem_size_in_mod(val_ty, &sr, &m)
                            int ks = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(ks, LT_I64, key_size))
                            lir_args.push(ks)
                            int vs = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(vs, LT_I64, val_size))
                            lir_args.push(vs)
                    elif coll_cat2 == "GorgetSet":
                        # Set: _str variant takes 0 args, non-str takes 1 (elem_size)
                        if not is_string_keyed(func_name, &m):
                            int elem_size = collection_elem_size_in_mod(func_name, &sr, &m)
                            int size_val = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(size_val, LT_I64, elem_size))
                            lir_args.push(size_val)
                        # else: _str variant, no args needed
                    else:
                        # Vector, Deque, Channel, Shared: 1 arg (elem_size).
                        # Shared is special: size comes FIRST and init_data is
                        # a pointer; handled below via arg reordering.
                        int elem_size = collection_elem_size_in_mod(func_name, &sr, &m)
                        int size_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, IIConst(size_val, LT_I64, elem_size))
                        lir_args.push(size_val)
                # Shared__X constructor re-ordering: gorget_shared_new(size, *val).
                # Replace existing lir_args [val, size] with [size, &val_slot].
                # We cheat by reaching into the last arg emission's lower_operand
                # result — it was a value, but we need its slot's address.
                # Phase A: use call_name (already mapped to gorget_shared_new) instead of starts_with.
                if call_name == "gorget_shared_new" and args.len() >= 1 and lir_args.len() >= 2:
                    # Find the caller's user-arg 0 source (GIR arg 0, OpCopy/OpMove)
                    Operand user0 = args.get(0).unwrap()
                    int src_slot = -1
                    match user0:
                        case OpCopy(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpMove(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpClone(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpBorrow(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        else:
                            pass
                    if src_slot >= 0:
                        int addr_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotAddr(addr_val, src_slot))
                        # lir_args[0] = user val (discard), lir_args[1] = size_val
                        int size_val_last = lir_args.get(lir_args.len() - 1).unwrap()
                        Vector[int] new_args = [size_val_last, addr_val]
                        lir_args = new_args
                int dst = -1
                if dst_local >= 0:
                    dst = lir_fn_next_value(&f)
                Vector[int] empty_abis = []
                lir_push_inst(&f, bb, ICallExtern(dst, call_name, lir_args, func_name, empty_abis))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICallExtern(dst_local, func_name, args):
            # Canonical prelude variants (same as GICall arm).
            if try_lower_prelude_variant(func_name, dst_local, args, &f, bb, &local_to_slot, &m):
                return bb
            # Function-as-value pseudo-intrinsic: `__fn_addr__<name>` —
            # emitted by `lower_expr`'s EIdentifier arm when the
            # identifier resolves to a known function. Convert into an
            # `IFuncAddr(dst, fid)` so the C codegen emits the
            # `static void* __fa_X[] = { (void*)__adapt_<name>, NULL }`
            # callable shape. Mirrors Rust gg's `Constant::FuncRef`
            # → `IFuncAddr` lowering. The `__fn_addr__` prefix is
            # 12 chars; the rest is the target function name.
            if func_name.starts_with("__fn_addr__") and dst_local >= 0:
                String fa_target = func_name.slice(11, func_name.len())
                if func_index.contains(fa_target):
                    int fa_fid = func_index.get(fa_target).unwrap()
                    int fa_dst = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, IFuncAddr(fa_dst, fa_fid))
                    int fa_dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(fa_dst_slot, fa_dst, false))
                    return bb
            # Module-level static reference: `__global_ref__<name>` —
            # emitted by `lower_static_ref_ident` when the identifier is
            # registered in `gmod.static_keys`. Locate the matching
            # `LirGlobal` in `m.globals` (populated in `lower_gir_to_lir`
            # before functions are lowered) and emit `IGlobalAddr(dst,
            # gid)`. Mirrors Rust gg's `Constant::GlobalRef(name)` →
            # `IGlobalAddr` lowering. Prefix is "__global_ref__" (14
            # chars).
            if func_name.starts_with("__global_ref__") and dst_local >= 0:
                String gr_target = func_name.slice(14, func_name.len())
                int gr_gid = -1
                int gri = 0
                while gri < m.globals.len():
                    LirGlobal gr_g = m.globals.get(gri).unwrap()
                    if gr_g.name == gr_target:
                        gr_gid = gri
                    gri += 1
                if gr_gid >= 0:
                    int gr_dst = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, IGlobalAddr(gr_dst, gr_gid))
                    int gr_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int gr_dst_slot_ty = f.slots.get(gr_dst_slot).unwrap().ty
                    # `IGlobalAddr` yields the global's ADDRESS. For a VALUE-typed
                    # destination (scalar like `float INFINITY` / `int`), the
                    # reader wants the VALUE, not the address — load it first.
                    # Mirrors Rust gg's `Constant::GlobalRef` → GlobalAddr+Load
                    # (src/lir/lower/operands.rs:128-134). Without the load the
                    # body emits `&__lir_gN` (a pointer) where a `double` is
                    # expected → float prints 0.0 / `void* > double` cc-fails.
                    # Resource statics (`stdout`/`stderr`/`stdin` — pointer-kind
                    # slots) WANT the address, so gate on a scalar value slot.
                    bool gr_slot_is_ptr_kind = (gr_dst_slot_ty == LT_PTR) or (gr_dst_slot_ty >= LT_PTR_TO_BASE and gr_dst_slot_ty < LT_STRUCT_BASE)
                    if lir_is_scalar(gr_dst_slot_ty) and not gr_slot_is_ptr_kind:
                        int gr_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ILoad(gr_loaded, gr_dst, gr_dst_slot_ty))
                        lir_push_inst(&f, bb, ISlotStore(gr_dst_slot, gr_loaded, false))
                    else:
                        lir_push_inst(&f, bb, ISlotStore(gr_dst_slot, gr_dst, false))
                    return bb
            # Canonical Box(x): emit IBoxAlloc, same as in GICall.
            if func_name == "Box" and args.len() == 1 and dst_local >= 0:
                emit_box_alloc(dst_local, args.get(0).unwrap(), &f, bb, &local_to_slot, &sr, &m)
                return bb
            String mapped_early = map_runtime_name(func_name, &m, &gmod)
            String effective_name = func_name
            if mapped_early != "":
                effective_name = mapped_early
            # Look up function param types for Ptr(T) detection (user struct methods)
            Vector[int] ext_param_tys = get_fn_param_types(func_name, &gmod)
            Vector[int] lir_args = []
            int ai = 0
            while ai < args.len():
                Operand arg = args.get(ai).unwrap()
                # Check runtime ptr-passing table OR function param type
                bool need_ptr = needs_ptr_arg(effective_name, ai)
                if not need_ptr and ai < ext_param_tys.len():
                    int pty = ext_param_tys.get(ai).unwrap()
                    if is_ptr_type(pty, &gmod):
                        need_ptr = true
                if need_ptr:
                    match arg:
                        case OpCopy(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            # If the slot already holds a pointer (e.g. `&self`
                            # params lowered as void*/Ptr-to-struct), LOAD the
                            # pointer value instead of taking the slot's address
                            # — otherwise downstream `(T*)&__slot` reads slot
                            # storage as a struct and gets stack garbage.
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpMove(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpClone(local_id):
                            # Phase 2c COMMIT 2 Site 2 — NOW WIRED (a-5 LIR
                            # side). A by-pointer runtime arg needs an lvalue
                            # (an addressable slot), but OpClone produces an
                            # rvalue: `lower_operand` emits the clone call and
                            # returns the fresh OWNED value (a struct value for
                            # `T__clone`, a thin pointer for String/Closure).
                            # Passing that value directly is the "incompatible
                            # type for argument N of gorget_array_set/push/
                            # map_put" error (the clone is a `T`, the runtime
                            # wants `const void*`). So materialize the clone
                            # into a fresh temp slot of the element type and
                            # pass the slot's ADDRESS — the runtime then
                            # memcpy's the owned bytes into storage, leaving the
                            # borrow source untouched (no double-free; the whole
                            # point of clone-on-borrow at a consuming position).
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            # Element (owned value) type the clone produces:
                            # ptr-to-struct → the pointee; value-struct → itself.
                            int elem_ty = slot_ty
                            if slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE:
                                elem_ty = LT_STRUCT_BASE + (slot_ty - LT_PTR_TO_BASE)
                            int cloned_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                            if elem_ty >= LT_STRUCT_BASE:
                                int tmp_slot = lir_fn_add_slot(&f, elem_ty, "")
                                lir_push_inst(&f, bb, ISlotStore(tmp_slot, cloned_val, true))
                                int caddr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(caddr, tmp_slot))
                                lir_args.push(caddr)
                            else:
                                # Raw LT_PTR / primitive source: no struct type
                                # signal to size a temp slot — pass the loaded
                                # value (legacy best-effort).
                                lir_args.push(cloned_val)
                        case OpBorrow(local_id):
                            # Phase D step 3: borrow → slot address shape.
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE):
                                int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        else:
                            int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                            lir_args.push(arg_val)
                else:
                    int arg_val = lower_operand(arg, &f, bb, &local_to_slot, &m)
                    lir_args.push(arg_val)
                ai += 1
            String mapped = map_runtime_name(func_name, &m, &gmod)
            String call_name = func_name
            if mapped != "":
                call_name = mapped
            # Post-mapping fixups: append extra args for functions that need them.
            if call_name == "gorget_array_contains":
                int es = extract_elem_size_from_name_in_mod(func_name, &sr, &m)
                int esv = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, IIConst(esv, LT_I64, es))
                lir_args.push(esv)
            # gorget_channel_recv(ch, &out): needs output slot address as 2nd arg.
            # gorget_channel_recv_timeout(ch, &out, timeout_ms): needs output + timeout.
            if call_name == "gorget_channel_recv" or call_name == "gorget_channel_try_recv":
                if dst_local >= 0:
                    int out_slot = local_to_slot.get(dst_local).unwrap()
                    int out_addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(out_addr, out_slot))
                    lir_args.push(out_addr)
            # Callable dispatch: emit ICallClosure with correct return type
            if call_name.starts_with("__callable_") or call_name.starts_with("__gorget_closure_call_"):
                int cl_dst = -1
                if dst_local >= 0:
                    cl_dst = lir_fn_next_value(&f)
                # Determine return type from the destination local's type
                int cl_ret = LT_I64
                if dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    cl_ret = f.slots.get(dst_slot).unwrap().ty
                # First arg is the callable, rest are call args
                int cl_closure = lir_args.get(0).unwrap()
                Vector[int] cl_call_args = []
                int cli = 1
                while cli < lir_args.len():
                    cl_call_args.push(lir_args.get(cli).unwrap())
                    cli += 1
                Vector[int] cl_abis = []
                # kind=0 means CallableParam (void*[2] protocol)
                lir_push_inst(&f, bb, ICallClosure(cl_dst, 0, cl_closure, cl_call_args, cl_abis, cl_ret))
                if cl_dst >= 0 and dst_local >= 0:
                    int cl_dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(cl_dst_slot, cl_dst, false))
            else:
                # Tier 1 lift: collection void* → Option wrap. Mirrors
                # src/lir/lower/lifts.rs::emit_void_ptr_option_wrap.
                if dst_local >= 0 and is_collection_void_return(call_name):
                    int lift_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int lift_slot_ty = f.slots.get(lift_dst_slot).unwrap().ty
                    if lift_slot_ty >= LT_STRUCT_BASE:
                        int lift_opt_sid = lift_slot_ty - LT_STRUCT_BASE
                        if lift_opt_sid < m.structs.len():
                            LirStructDef lift_opt_def = m.structs.get(lift_opt_sid).unwrap()
                            if lift_opt_def.enum_kind == EK_OPTION:
                                # CoW: read the GIR result's ownership tag —
                                # a LoBorrowed/LoView get-result aliases the
                                # collection element and must NOT clone (the
                                # for-element clone bomb). Tag set at the get
                                # site in lower.gg (typed check via
                                # option_ref_payload_of / lower_for_vector's
                                # BoCollectionElement).
                                bool wrap_is_borrow = gir_local_is_for_element(dst_local, &gir_locals)
                                int new_bb = emit_void_ptr_option_wrap(call_name, dst_local, lift_opt_sid, lir_args, &f, bb, &local_to_slot, &m, wrap_is_borrow)
                                return new_bb
                int dst = -1
                if dst_local >= 0:
                    # For channel recv, the result is written to the slot directly via &out.
                    # Don't create a value destination — the call returns void.
                    if call_name != "gorget_channel_recv" and call_name != "gorget_channel_try_recv":
                        dst = lir_fn_next_value(&f)
                Vector[int] empty_abis = []
                lir_push_inst(&f, bb, ICallExtern(dst, call_name, lir_args, func_name, empty_abis))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    int dst_slot_ty = f.slots.get(dst_slot).unwrap().ty
                    # Pointer-returning runtime calls (`gorget_array_safe_get`
                    # etc.) return a void* pointing to the element. When the
                    # GIR caller typed the result slot as the element type
                    # (from `infer_method_return_type` flattening `.get()` on
                    # Vector[scalar] to the scalar element directly), emit an
                    # explicit ILoad to dereference the pointer into a scalar
                    # before the SlotStore. Codegen-side fixes don't survive
                    # the SSA pass's scalar-slot promotion (stores/loads get
                    # eliminated, leaving the raw void* flowing downstream
                    # as if it were the int — the `bb = &block_map[i]` bug).
                    bool is_ptr_ret = returns_ptr_to_element(call_name)
                    bool slot_is_ptr_kind = (dst_slot_ty == LT_PTR) or (dst_slot_ty >= LT_PTR_TO_BASE and dst_slot_ty < LT_STRUCT_BASE)
                    # EIndex-exclusive raw getter into a by-value struct dst
                    # (lower.gg EIndex case (c)). The getter returns a void*
                    # pointing at the element; the GIR caller typed the result
                    # slot as the bare aggregate struct, so dereference the
                    # void* with an aggregate `*(StructT*)(void*)` copy-out
                    # (ILoad codegen at lir_codegen.gg:3179) before the
                    # SlotStore — a plain SlotStore of the void* into a struct
                    # slot is the bug this fixes. Keyed on the UNMAPPED
                    # `func_name` (NOT `call_name`): only the EIndex arm emits
                    # the raw `gorget_array_get`/`gorget_map_get` symbols —
                    # `Vector.get()` arrives as `gorget_array_safe_get` and
                    # `Dict.get()` arrives mapped from `Dict__K__V__get`, so
                    # this never catches a `.get()`/`.unwrap()` Option dst.
                    bool eindex_raw_getter = (func_name == "gorget_array_get") or (func_name == "gorget_map_get")
                    if is_ptr_ret and lir_is_scalar(dst_slot_ty) and not slot_is_ptr_kind:
                        int loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ILoad(loaded, dst, dst_slot_ty))
                        lir_push_inst(&f, bb, ISlotStore(dst_slot, loaded, false))
                    elif eindex_raw_getter and lir_is_aggregate(dst_slot_ty):
                        int agg_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ILoad(agg_loaded, dst, dst_slot_ty))
                        lir_push_inst(&f, bb, ISlotStore(dst_slot, agg_loaded, false))
                    else:
                        lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GIDrop(local_id):
            # Unconditional drop: resolve the local's type → drop fn via the
            # typed `drop_fn_for_type` accessor (which reads the populated
            # `type_runtime_map` + `resource_types` metadata, *not* the
            # name), then emit `<drop_fn>(&slot)`. Primitives / non-resource
            # types return "" and the arm becomes a no-op — `drop_fn_for_type`
            # is the single source of truth for whether a type owns
            # droppable data, mirroring Rust's `DropStrategy` lookup in
            # `src/lir/lower/drops.rs::lower_drop`.
            String drop_tn = gir_local_type_name(local_id, &gir_locals, &gmod)
            if drop_tn != "":
                String drop_fn = drop_fn_for_type(drop_tn, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
                if drop_fn != "":
                    int slot = local_to_slot.get(local_id).unwrap()
                    int addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                    Vector[int] drop_args = []
                    drop_args.push(addr)
                    Vector[int] drop_abis = []
                    lir_push_inst(&f, bb, ICallExtern(-1, drop_fn, drop_args, drop_fn, drop_abis))

        case GIDropIfAlive(local_id):
            # Conditional drop: wrap the same drop emission with an
            # `IDropGuardOpen(kind=byte_size+1, &slot)` / `IDropGuardClose`
            # pair. The C codegen emits a `memcmp(&slot, zeros, size) != 0`
            # gate; downstream `drop_elab` (when self-host grows one) can
            # statically resolve Initialized → strip guard / Uninitialized
            # → strip drop / MaybeInitialized → swap memcmp for a bool
            # drop-flag. Until then the runtime memcmp is correct but slow,
            # matching Rust's pre-elaboration shape.
            String dia_tn = gir_local_type_name(local_id, &gir_locals, &gmod)
            if dia_tn != "":
                String dia_drop_fn = drop_fn_for_type(dia_tn, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
                # Mono'd Option/Result locals/scrutinees whose payload owns a
                # resource are NOT in optionlike_resource_types (that dict is
                # field-position-only AND drives the by-value ABI, so we must not
                # add them — see is_droppable_type). But Pass 3 DID generate their
                # `<Type>__drop` and recorded it in type_drop_fns. Use that typed
                # registry as the fallback: it's the authoritative "this type has
                # a generated drop fn" signal (populated only when a payload is a
                # resource, so POD-payload Option/Result correctly stay drop-less).
                if dia_drop_fn == "" and m.type_drop_fns.contains(dia_tn):
                    dia_drop_fn = m.type_drop_fns.get(dia_tn).unwrap().drop_fn_name
                if dia_drop_fn != "":
                    int dia_slot = local_to_slot.get(local_id).unwrap()
                    int dia_slot_ty = f.slots.get(dia_slot).unwrap().ty
                    int dia_size = lir_type_byte_size_in_mod(dia_slot_ty, &m, 0)
                    int dia_addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(dia_addr, dia_slot))
                    # kind encoding: 0=Bool guard, kind-1=byte size for NonZero
                    lir_push_inst(&f, bb, IDropGuardOpen(dia_size + 1, dia_addr))
                    Vector[int] dia_args = []
                    dia_args.push(dia_addr)
                    Vector[int] dia_abis = []
                    lir_push_inst(&f, bb, ICallExtern(-1, dia_drop_fn, dia_args, dia_drop_fn, dia_abis))
                    lir_push_inst(&f, bb, IDropGuardClose)

        case GIMoveZero(local_id):
            # Mark slot as moved — pure dataflow annotation (V6: no Memset for
            # non-projected places). MoveSlot is swept by drop elaboration.
            int slot = local_to_slot.get(local_id).unwrap()
            lir_push_inst(&f, bb, IMoveSlot(slot))

        case GIDeref(dst_local, src_local, inner_ty):
            # *box — load *src pointer value, memcpy sizeof(inner) into
            # dst slot. Works uniformly for scalar and aggregate inner
            # types because the dst slot address is a byte-addressable
            # destination. Matches IBoxAlloc's heap-store shape.
            int inner_lir_ty = map_gir_type(inner_ty, &gmod, &sr)
            int size_bytes = lir_type_byte_size_in_mod(inner_lir_ty, &m, 0)
            int src_slot_d = local_to_slot.get(src_local).unwrap()
            int dst_slot_d = local_to_slot.get(dst_local).unwrap()
            int src_ptr_val = lir_fn_next_value(&f)
            int dst_addr_val = lir_fn_next_value(&f)
            int size_val = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(src_ptr_val, src_slot_d, LT_PTR))
            lir_push_inst(&f, bb, ISlotAddr(dst_addr_val, dst_slot_d))
            lir_push_inst(&f, bb, IIConst(size_val, LT_I64, size_bytes))
            lir_push_inst(&f, bb, IMemcpy(dst_addr_val, src_ptr_val, size_val))

        case GIDerefStore(ds_ptr_local, ds_value, ds_inner_ty):
            # *ptr = value — store `value` THROUGH the pointer held in
            # `ds_ptr_local`'s slot. Used for whole-value writes to a `&`/`!`
            # param (a `GtMutPtr(inner)`-typed local): the slot holds a `T*`,
            # so a GIAssign would clobber the pointer slot, not the pointee.
            #
            # Shape (mirrors Rust gg's `assign` into `Place{local,[Deref]}`,
            # src/ir/lowering/stmts/assigns.rs:231-243):
            #   1. ds_ptr_val = ISlotLoad(ptr_slot, LT_PTR)  — load the pointer.
            #   2. ds_val     = lower_operand(value)         — produce the value.
            #   3. IStore(ds_ptr_val, ds_val)                — `*ptr = value`.
            # IStore's codegen (lir_codegen.gg:3138-3149) dispatches scalar
            # (`*(T*)ptr = v`) / aggregate (memcpy) / ptr per the value's LIR
            # type — covering BOTH non-resource and resource inner. No new LIR
            # inst and no new C-emit arm needed: IStore already exists.
            int ds_ptr_slot = local_to_slot.get(ds_ptr_local).unwrap()
            int ds_ptr_val = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(ds_ptr_val, ds_ptr_slot, LT_PTR))
            int ds_val = lower_operand(ds_value, &f, bb, &local_to_slot, &m)
            lir_push_inst(&f, bb, IStore(ds_ptr_val, ds_val))

        case GINop():
            pass

        case GIFieldLoad(fl_dst_local, fl_base_local, fl_field):
            # A.2 (2026-05-22) — typed field-load dispatch. Mirrors Rust
            # `Instruction::FieldLoad` lowering at
            # `src/lir/lower/insts.rs:800-869`.
            #
            # Shape:
            #   1. base_val = address of the base struct (slot addr OR
            #      ISlotLoad if the slot is itself a pointer — auto-deref
            #      for `&Foo` / `Foo*` params).
            #   2. fptr = IFieldPtr(base_val, struct_id, field).
            #   3. Dispatch on dst GIR type:
            #        • GtPtr(_) / GtMutPtr(_) → ISlotStore(dst_slot, fptr)
            #          — pointer-alias path (no byte-copy).
            #        • else → ILoad(loaded, fptr, field_lir_ty) +
            #          ISlotStore(dst_slot, loaded) — byte-copy path,
            #          observationally identical to the previous
            #          `__field_read_*` GICallExtern lowering.
            #
            # struct_id is resolved by name from the base local's GIR
            # type — `gir_type_id_to_base_name` strips Ptr/MutPtr to
            # reach the named struct, `sr.get(name)` maps to the LIR
            # struct id (the same map that `__field_read_*` codegen
            # uses via `find_struct_type`).
            int fl_base_tid = gir_locals.get(fl_base_local).unwrap().type_id
            String fl_base_tn = gir_type_id_to_base_name(fl_base_tid, &gmod)
            int fl_struct_id = sr.get(fl_base_tn).unwrap_or(-1)
            int fl_base_slot = local_to_slot.get(fl_base_local).unwrap()
            int fl_base_slot_ty = f.slots.get(fl_base_slot).unwrap().ty
            int fl_base_val = lir_fn_next_value(&f)
            # Auto-deref: if the base slot is a pointer kind (LT_PTR or
            # LT_PTR_TO_BASE+sid), the slot HOLDS a pointer — load it
            # rather than taking the slot's address. Matches the OpCopy
            # path the previous `__field_read_*` arg-prep took for
            # is_ptr_type bases (lower.gg line ~4382).
            bool fl_base_is_ptr = (fl_base_slot_ty == LT_PTR) or (fl_base_slot_ty >= LT_PTR_TO_BASE and fl_base_slot_ty < LT_STRUCT_BASE)
            if fl_base_is_ptr:
                lir_push_inst(&f, bb, ISlotLoad(fl_base_val, fl_base_slot, fl_base_slot_ty))
            else:
                lir_push_inst(&f, bb, ISlotAddr(fl_base_val, fl_base_slot))
            # FieldPtr → field address.
            int fl_fptr = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IFieldPtr(fl_fptr, fl_base_val, fl_struct_id, fl_field))
            # Dispatch on dst's GIR type — Ptr(_) → pointer alias,
            # else → byte-copy load. The dst's GIR type is set by
            # `lower.gg`'s EFieldAccess emission: resource fields are
            # Ptr-wrapped (alias path), non-resource fields are
            # value-typed (byte-copy path).
            int fl_dst_tid = gir_locals.get(fl_dst_local).unwrap().type_id
            int fl_dst_slot = local_to_slot.get(fl_dst_local).unwrap()
            bool fl_dst_is_ptr = is_ptr_type(fl_dst_tid, &gmod)
            if fl_dst_is_ptr:
                # Pointer-alias: store the field address directly as
                # the dst's pointer value. No byte-copy.
                lir_push_inst(&f, bb, ISlotStore(fl_dst_slot, fl_fptr, false))
            else:
                # Byte-copy: load the field value through the field
                # pointer, then store into the dst slot. `field_lir_ty`
                # comes from the dst slot's own ty (single source of
                # truth — `local_to_slot` already wired the slot type
                # to the field's value type at local allocation).
                int fl_field_lir_ty = f.slots.get(fl_dst_slot).unwrap().ty
                int fl_loaded = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, ILoad(fl_loaded, fl_fptr, fl_field_lir_ty))
                lir_push_inst(&f, bb, ISlotStore(fl_dst_slot, fl_loaded, false))

    return bb

# ── Terminator lowering ─────────────────────────────────────

LirTerm lower_terminator(Terminator term, LirFunction &f, int bb, Vector[int] &local_to_slot, Vector[int] &block_map, LirModule &m):
    match term:
        case GTReturn(operand):
            int val = lower_operand(operand, &f, bb, &local_to_slot, &m)
            return TRet(val)
        case GTJump(target):
            int lir_target = block_map.get(target).unwrap()
            Vector[int] empty_args = []
            return TJump(lir_target, empty_args)
        case GTBranch(cond_op, then_bb, else_bb):
            int cond = lower_operand(cond_op, &f, bb, &local_to_slot, &m)
            int lir_then = block_map.get(then_bb).unwrap()
            int lir_else = block_map.get(else_bb).unwrap()
            Vector[int] empty_then = []
            Vector[int] empty_else = []
            return TBranch(cond, lir_then, empty_then, lir_else, empty_else)
        case GTNone():
            return TRetVoid()
    return TUnreachable()

# ── Function lowering ───────────────────────────────────────

LirFunction lir_lower_function(GirFunction gfn, GirModule &gmod, Dict[String, int] &sr, Dict[String, int] &func_index, LirModule &m):
    # Map parameter types
    Vector[int] param_types = []
    for pt in gfn.param_types:
        param_types.push(map_gir_type(pt, &gmod, &sr))

    # Map return type
    int ret_type = map_gir_type(gfn.return_type, &gmod, &sr)

    Vector[int] saved_param_types = []
    for spt in param_types:
        saved_param_types.push(spt)

    LirFunction f = LirFunction(gfn.name, param_types, ret_type, [], [], 0, false, "", [], [], [])

    # Create slots for all GIR locals
    Vector[int] local_to_slot = []
    for local in gfn.locals:
        int lir_ty = map_gir_type(local.type_id, &gmod, &sr)
        String slot_name = ""
        match local.name_hint:
            case Some(n):
                slot_name = n
            case None:
                pass
        int slot_id = lir_fn_add_slot(&f, lir_ty, slot_name)
        local_to_slot.push(slot_id)

    # Create blocks
    Vector[int] block_map = []
    for _ in gfn.blocks:
        int blk_id = lir_fn_add_block(&f)
        block_map.push(blk_id)

    # Copy function parameters to their slots (params map to locals 1..N, local 0 is return place)
    if gfn.blocks.len() > 0:
        int param_count = gfn.param_types.len()
        int pci = 0
        while pci < param_count:
            int param_val = lir_fn_next_value(&f)
            int param_lir_ty = saved_param_types.get(pci).unwrap()
            int param_slot = local_to_slot.get(pci + 1).unwrap()
            lir_push_inst(&f, 0, IParamRef(param_val, pci, param_lir_ty))
            lir_push_inst(&f, 0, ISlotStore(param_slot, param_val, false))
            pci += 1

    # Lower instructions and terminators for each block
    int bii = 0
    while bii < gfn.blocks.len():
        BasicBlock gir_blk = gfn.blocks.get(bii).unwrap()
        int lir_bb = block_map.get(bii).unwrap()

        # Lower instructions
        for gir_inst in gir_blk.insts:
            lir_bb = lower_instruction(gir_inst, &f, lir_bb, &local_to_slot, &gfn.locals, &func_index, &gmod, &sr, &m)

        # Lower terminator. Move the local LirTerm into the block —
        # it's a non-Copy enum and `lir_term` is dead after the
        # assignment. The Rust typechecker's FieldAccess fix
        # (mod.rs::populate_def_field_types runs before typecheck +
        # FieldAccess returns the actual field type instead of
        # error_id) now catches the previously-silent copy.
        LirTerm lir_term = lower_terminator(gir_blk.term, &f, lir_bb, &local_to_slot, &block_map, &m)
        lir_set_term(&f, lir_bb, lir_term)

        bii += 1

    return f

# ── Drop metadata population ────────────────────────────────

# Determine the drop function name for a given type name.
# Returns "" if the type doesn't need dropping.
String drop_fn_for_type(String type_name, Dict[String, bool] &resource_types, Dict[String, String] &type_runtime_map, Dict[String, bool] &optionlike, Dict[String, bool] &collision_types):
    # option_ref_borrow RES-5: a `Ref__T` payload is a BORROW (a pointer
    # into a collection the caller owns), never dropped (§2 invariant: only
    # the owner frees). An `Option__Ref__T` is likewise a borrow wrapper.
    # Today this falls through to "" accidentally (Ref__T is never registered
    # as a resource); make it EXPLICIT so a future edit that registers a
    # `Ref__`/`Option__Ref__` type can't silently emit a drop that would free
    # the pointee → double-free. The pointer-ness lands via the LT_PTR
    # fallback in resolve_field_lir_type; the Option struct itself is generated
    # in Pass 3 with no variant-drop because of this guard.
    if type_name.starts_with("Ref__") or type_name.starts_with("Option__Ref__"):
        return ""
    if type_name == "GorgetString" or type_name == "Str":
        return "gorget_string_free"
    if type_name == "GorgetArray":
        return "gorget_array_free"
    if type_name == "GorgetMap":
        return "gorget_map_free"
    if type_name == "GorgetSet":
        return "gorget_set_free"
    if type_name == "GorgetClosure":
        return "gorget_closure_free"
    # Phase A — use type_runtime_map for parameterized collection/resource types.
    # Registered once at type-definition time; no starts_with name matching.
    # Guard contains before get (Dict.get() crashes on missing key in self-host).
    String runtime = ""
    if type_runtime_map.contains(type_name):
        runtime = type_runtime_map.get(type_name).unwrap_or("")
    if runtime == "GorgetArray":
        return "gorget_array_free"
    elif runtime == "GorgetMap":
        return "gorget_map_free"
    elif runtime == "GorgetSet":
        return "gorget_set_free"
    elif runtime == "Ptr" or runtime == "Box":
        return "free"
    elif runtime == "Task":
        return ""
    if resource_types.contains(type_name):
        # Drop-name collision: a user `T.drop(...)` method owns the plain
        # `T__drop` C symbol, so route field/variant drops to the mangled
        # auto-glue name `__gorget_dtor_{T}` (mirrors Rust gg
        # `src/lir/lower/mod.rs:651-655`). The collision set is populated
        # once at the top of `lower_gir_to_lir`, read here via the typed
        # accessor — no name-shape heuristic.
        if collision_types.contains(type_name):
            return "__gorget_dtor_" + type_name
        return type_name + "__drop"
    # Mono'd Option__X / Result__X__E whose payload owns a resource. Kept
    # out of resource_types (to preserve their by-value param/field ABI),
    # so the recursive drop/clone-fn generators would otherwise SKIP an
    # `Option[Resource]` field — e.g. `MatchArm__clone` omitting `guard`,
    # `Stmt__clone` omitting `SReturn`'s payload — producing a SHALLOW
    # clone that shares the inner resource and double-frees. Rust emits the
    # field clone (driver.c MatchArm__clone clones guard). Their `T__drop`/
    # `T__clone` defs are generated via recursive_drop_enums (lir_lower
    # Pass 3); here we just report them droppable so containing structs/
    # enums include the field.
    if optionlike.contains(type_name):
        if collision_types.contains(type_name):
            return "__gorget_dtor_" + type_name
        return type_name + "__drop"
    return ""

# Populate drop/clone metadata on the LirModule from GIR type info.
void populate_drop_metadata(LirModule &m, GirModule &gmod):
    # Pass 1: Struct field drops
    Vector[String] type_keys = gmod.type_infos.keys()
    int ki = 0
    while ki < type_keys.len():
        String type_name = type_keys.get(ki).unwrap()
        GirTypeInfo info = gmod.type_infos.get(type_name).unwrap()
        if info.is_enum:
            ki += 1
            continue
        # Cluster (a), 2026-05-24: the `__imported_type__` skip was REMOVED.
        # Whole-program compilation (bootstrap + every `gg build`) emits ALL
        # user types in ONE C file; the Rust preamble provides only RUNTIME
        # drops (gorget_*_free), NOT user-type `<Type>__drop`. Skipping
        # imported user types left 0 `__drop` defs → undefined references.
        # Double-definition is guarded by `fn_exists()` in emit_struct_drops /
        # emit_type_drop_fns, not by suppressing registration here.
        # Check if this struct has any droppable fields
        Vector[FieldDrop] field_drops = []
        int fi = 0
        while fi < info.fields.len():
            GirFieldInfo finfo = info.fields.get(fi).unwrap()
            String drop_fn = drop_fn_for_type(finfo.type_name, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
            if drop_fn != "":
                field_drops.push(FieldDrop(finfo.name, drop_fn, finfo.type_name))
            fi += 1
        bool is_resource_struct = gmod.resource_types.contains(type_name)
        if field_drops.len() > 0 or is_resource_struct:
            String tname = type_name
            m.recursive_drop_structs.put(tname, field_drops)
            # Also add to type_drop_fns for unified emission. For a drop-name
            # collision type the auto glue takes the mangled name
            # `__gorget_dtor_{T}` (the plain `T__drop` symbol belongs to the
            # user method); emit_struct_drops / the DCE seed read this typed
            # name (Rust gg `src/lir/lower/mod.rs:680-686`).
            String drop_fn_name = type_name + "__drop"
            if m.drop_collision_types.contains(type_name):
                drop_fn_name = "__gorget_dtor_" + type_name
            Vector[FieldDrop] fd_copy = []
            int di = 0
            while di < field_drops.len():
                FieldDrop fd = field_drops.get(di).unwrap()
                fd_copy.push(FieldDrop(fd.field_name, fd.drop_fn_name, fd.field_type_name))
                di += 1
            Vector[EnumVariantDrop] no_evd = []
            m.type_drop_fns.put(type_name, TypeDropInfo(drop_fn_name, fd_copy, "", no_evd))
        ki += 1

    # Pass 2: Enum variant drops
    ki = 0
    while ki < type_keys.len():
        String type_name = type_keys.get(ki).unwrap()
        GirTypeInfo info = gmod.type_infos.get(type_name).unwrap()
        if not info.is_enum:
            ki += 1
            continue
        # Cluster (a): __imported_type__ skip removed — see Pass 1 note.
        Vector[EnumVariantDrop] variant_drops = []
        int vi = 0
        while vi < info.variants.len():
            GirEnumVariantInfo vinfo = info.variants.get(vi).unwrap()
            int vfi = 0
            while vfi < vinfo.fields.len():
                GirFieldInfo finfo = vinfo.fields.get(vfi).unwrap()
                String drop_fn = drop_fn_for_type(finfo.type_name, &gmod.resource_types, &m.type_runtime_map, &gmod.optionlike_resource_types, &m.drop_collision_types)
                if drop_fn != "":
                    # Field name in the C struct is VariantName_N (e.g., Literal_0)
                    # finfo.name is "_N" (e.g., "_0"), so strip the leading underscore
                    String field_idx = finfo.name
                    if field_idx.starts_with("_"):
                        field_idx = field_idx.slice(1, field_idx.len())
                    String c_field = vinfo.name + "_" + field_idx
                    variant_drops.push(EnumVariantDrop(vi, vinfo.name, c_field, drop_fn, finfo.type_name))
                vfi += 1
            vi += 1
        bool is_resource_enum = gmod.resource_types.contains(type_name)
        if variant_drops.len() > 0 or is_resource_enum:
            String tname = type_name
            m.recursive_drop_enums.put(tname, variant_drops)
            # Also add to type_drop_fns. The enum's OWN auto-glue drop name is
            # ALWAYS `{T}__drop` (unguarded) — mirrors Rust `lower/mod.rs:737`
            # and the unguarded enum emit sites (`emit_enum_drops`,
            # lir_codegen.gg:4991/5000). Do NOT apply the struct-branch collision
            # guard here: the DCE seed reads this `drop_fn_name`
            # (lir_codegen.gg:1083-1084) while emit uses `{T}__drop`; guarding here
            # would mismatch them and DCE-prune the real drop fn. The variant-
            # PAYLOAD field types ARE collision-guarded — see `drop_fn_for_type`
            # above (matches Rust mod.rs:714-719) — but the enum's own name is not.
            String drop_fn_name = type_name + "__drop"
            Vector[FieldDrop] no_fd = []
            Vector[EnumVariantDrop] evd_copy = []
            int di = 0
            while di < variant_drops.len():
                EnumVariantDrop evd = variant_drops.get(di).unwrap()
                evd_copy.push(EnumVariantDrop(evd.variant_index, evd.variant_name, evd.field_name, evd.drop_fn_name, evd.field_type_name))
                di += 1
            m.type_drop_fns.put(type_name, TypeDropInfo(drop_fn_name, no_fd, "", evd_copy))
        ki += 1

# ── Module lowering (main entry point) ──────────────────────

LirModule lower_gir_to_lir(GirModule &gmod):
    LirModule m = new_lir_module()
    Dict[String, int] sr = {}

    # ── Phase A — populate typed resource metadata ─────────────
    # Walk every named type and tag its resource shape. Downstream
    # passes read this Dict instead of re-deriving from
    # `name.starts_with("Vector__")` etc. See
    # docs/devbook/26-self-host-frontend.md §3.
    Vector[String] nt_keys = gmod.named_types.keys()
    for tname in nt_keys:
        if not gmod.resource_metadata.contains(tname):
            match build_resource_metadata(tname):
                case Some(rmeta):
                    gmod.resource_metadata.put(tname.clone(), rmeta)
                case None:
                    pass

    # Copy imported-type flags from GirModule (loader stores imported struct
    # and enum names with "__imported_type__NAME" keys). Used downstream to
    # suppress duplicate struct body / drop / clone emission — the Rust
    # preamble already provides them for imported types.
    Vector[String] gm_fn_keys = gmod.imported_fns.keys()
    for k in gm_fn_keys:
        if k.starts_with("__imported_type__"):
            String type_only = k.slice(17, k.len())
            m.imported_type_names.put(type_only, true)

    # Populate enum variant → parent enum map for codegen rewriting of
    # `Variant(args)` calls into inline struct initializers.
    Vector[String] ti_keys_v = gmod.type_infos.keys()
    for tname_v in ti_keys_v:
        GirTypeInfo tinfo_v = gmod.type_infos.get(tname_v).unwrap()
        if tinfo_v.is_enum:
            int vi_v = 0
            while vi_v < tinfo_v.variants.len():
                GirEnumVariantInfo v_v = tinfo_v.variants.get(vi_v).unwrap()
                m.enum_variant_parent.put(v_v.name, tname_v)
                # The variant's ordinal position in the source enum declaration
                # IS its runtime tag. The codegen's struct-field-scan heuristic
                # (emit_call_extern) gets this wrong for unit variants, because
                # unit variants contribute no payload fields. Record the right
                # tag here so callers can look it up.
                m.enum_variant_tag.put(v_v.name, vi_v)
                vi_v += 1

    # Register builtin structs
    register_builtin_structs(&m, &sr)

    # ── Drop-name collision detection ──────────────────────────
    # A USER method whose mangled C symbol is `T__drop` (e.g.
    # `DataFrame.drop(col)` → `DataFrame__drop(self, col)`) COLLIDES with
    # the compiler's auto drop-glue name `T__drop(self)`. When that happens
    # the type is recorded here and ALL field/variant drop call sites route
    # to `__gorget_dtor_{T}` instead, while the auto glue is emitted under
    # that mangled name (the user method keeps the plain `T__drop` symbol).
    # Mirrors Rust gg's `LoweringContext::populate_*` collision check
    # (`src/lir/lower/mod.rs:540-545`): a fn named `{T}__drop` with
    # `params.len() > 1` is a non-destructor (a real Drop impl takes only
    # `self`), so its C name can't double as the field-drop glue.
    #
    # MUST run BEFORE `lower_type_defs` (just below): the Option/Result
    # variant-drop names are built INSIDE lower_type_defs (`:980` / `:1040`)
    # via `drop_fn_for_type`, which reads `m.drop_collision_types`. Populate
    # after lower_type_defs and those names would still say `DataFrame__drop`
    # → the Result/Option `Ok_0` drop site would mis-link to the user 2-arg
    # method and leak. See docs/devbook/24-layering-discipline.md
    # (resolve once, write through: the collision fact is set at this single
    # source and read via the typed `drop_collision_types` accessor).
    int cf = 0
    while cf < gmod.functions.len():
        String fn_name = gmod.functions.get(cf).unwrap().name
        if fn_name.ends_with("__drop") and gmod.functions.get(cf).unwrap().param_types.len() > 1:
            # Strip the trailing "__drop" (6 bytes) to recover the type name.
            String coll_ty = fn_name.slice(0, fn_name.len() - 6)
            # Only a registered struct/enum type can collide with auto glue;
            # ignore a stray `X__drop`-named free fn (guards against a false
            # entry that would mis-route an unrelated type).
            if gmod.type_infos.contains(coll_ty):
                m.drop_collision_types.put(coll_ty, true)
        cf += 1

    # Lower user-defined type definitions
    lower_type_defs(&gmod, &m, &sr)

    # Populate drop/clone metadata from GIR type field info
    populate_drop_metadata(&m, &gmod)

    # Emit module-level statics with runtime-call init — `stdout` /
    # `stderr` / `stdin` from lib/std/io.gg etc. Mirrors Rust gg's
    # `LoweringContext::global_names` + `module.globals` machinery
    # (`src/ir/lowering/mod.rs:1074-1111`). The corresponding
    # `EIdentifier(name)` lowerings emitted `__global_ref__<name>`
    # GICallExterns earlier; the intercept in the GICallExtern arm
    # below scans `m.globals` for the matching name and rewrites to
    # `IGlobalAddr(dst, gid)`. Dict insertion-order iteration keeps the
    # global-id sequence deterministic across runs.
    Vector[String] static_names = gmod.statics.keys()
    for sg_name in static_names:
        GirStaticInfo sg_info = gmod.statics.get(sg_name).unwrap()
        int sg_lir_ty = map_gir_type(sg_info.type_id, &gmod, &sr)
        # Map the GIR static init-kind to the LIR GINIT_* code: GGSTATIC_BYTES
        # → GINIT_BYTES (scalar-literal static = a const C initializer at the
        # declaration, no runtime synth fn — mirrors Rust's `GlobalInit::Bytes`,
        # `src/lir/lower/types.rs:572`); everything else → GINIT_RUNTIME_CALL.
        # `is_const` stays false either way: a `static` is MUTABLE storage
        # (write-backs via SAssign), matching Rust's `is_const:false`.
        int sg_init_kind = GINIT_RUNTIME_CALL
        if sg_info.init_kind == GGSTATIC_BYTES:
            sg_init_kind = GINIT_BYTES
        LirGlobal sg = LirGlobal(sg_name.clone(), sg_lir_ty, sg_init_kind, -1, sg_info.init_expr.clone(), false, [])
        lir_mod_add_global(&m, sg)

    # Build function index: name → FuncId
    Dict[String, int] func_index = {}
    int fi = 0
    while fi < gmod.functions.len():
        GirFunction gfn = gmod.functions.get(fi).unwrap()
        func_index.put(gfn.name.clone(), fi)
        fi += 1

    # Translate const-init globals (trait-impl `_VTable` structs) GIR → LIR.
    # Each GirGlobal is a struct-of-FuncAddr; resolve every GGINIT_FN_REF
    # field's mangled impl-fn name to a FuncId via `func_index` (built just
    # above, so all bodies are already indexed). Mirrors Rust gg's
    # `lower_global_init` resolving `GlobalInit::FnRef(name)` through the
    # func index (`src/lir/lower/types.rs:573-579`). A name with no fid
    # falls back to a GINIT_ZEROED field → NULL slot in C (defensive parity
    # with Rust `types.rs:577`; should not happen given the default-emit
    # guarantee). Latent until the vtable-emission pass populates
    # `gmod.globals` (Phase 4) — this loop is a no-op over an empty vector
    # today.
    for gg_global in gmod.globals:
        int g_ty = map_gir_type(gg_global.type_id, &gmod, &sr)
        Vector[LirGlobalField] lf = []
        for f in gg_global.fields:
            if f.kind == GGINIT_FN_REF:
                if func_index.contains(f.fn_name):
                    int fid = func_index.get(f.fn_name).unwrap()
                    lf.push(LirGlobalField(GINIT_FUNC_ADDR, fid))
                else:
                    lf.push(LirGlobalField(GINIT_ZEROED, -1))
        lir_mod_add_global(&m, LirGlobal(gg_global.name.clone(), g_ty, GINIT_STRUCT, -1, "", gg_global.is_const, lf))

    # Lower extern declarations
    for gext in gmod.externs:
        int ext_ret = map_gir_type(gext.return_type, &gmod, &sr)
        Vector[int] ext_params = []
        Vector[int] ext_abis = []
        m.externs.push(LirExtern(gext.name, ext_params, ext_ret, gext.is_variadic, ext_abis, ABI_AUTO))

    # Lower each function
    for gfn in gmod.functions:
        LirFunction lf = lir_lower_function(gfn, &gmod, &sr, &func_index, &m)
        lir_mod_add_function(&m, lf)

    return m

# ── Dead Global Elimination ─────────────────────────────────────
#
# Drop globals that no function references via IGlobalAddr. Mirrors
# Rust gg's `eliminate_dead_globals` in src/lir/optimize.rs. The
# self-host's `lower_gir_to_lir` unconditionally lowers every entry
# in `gmod.statics` — including stdin/stdout/stderr handles from
# lib/std/io.gg even when the fixture never touches them. Rust gg's
# pass scrubs those out before codegen, so the .c file emits only
# globals actually used. Without this pass, stage-1's emitted body
# carries a tail of dead `__lir_g<N>` declarations whose numbering
# collides with the e2e harness's runtime preamble in
# `self_host_e2e` (`tests/integration.rs:14149`).
#
# For GINIT_RUNTIME_CALL globals the rule is simple: referenced via
# IGlobalAddr ↔ kept. But GINIT_STRUCT (vtable) globals are referenced
# by NO IGlobalAddr — their slot fns are reached only through the
# `(void*)&fn` casts the C backend emits in the global initializer, never
# via an instruction. The dead-global pruner would therefore wrongly
# delete every vtable global. Pass 1 marks any GINIT_STRUCT global as
# referenced unconditionally, mirroring Rust gg's `eliminate_dead_globals`
# keeping any global whose init contains FuncAddrs
# (`src/lir/optimize.rs:436-443`, `global_has_func_addrs`).
void eliminate_dead_globals(LirModule &m):
    if m.globals.len() == 0:
        return
    # Pass 1: collect referenced global ids.
    Dict[int, bool] referenced = {}
    for func in m.functions:
        for blk in func.blocks:
            for inst in blk.insts:
                match inst:
                    case IGlobalAddr(_, gid):
                        referenced.put(gid, true)
                    else:
                        pass
    # Keep vtable globals (FuncAddr-bearing) — referenced indirectly via
    # the `(void*)&fn` casts in the C global initializer, not via any
    # IGlobalAddr instruction. Mirror Rust gg's `eliminate_dead_globals`
    # carve-out (`src/lir/optimize.rs:436-443`, `global_has_func_addrs`).
    int kg = 0
    while kg < m.globals.len():
        if m.globals.get(kg).unwrap().init_kind == GINIT_STRUCT:
            referenced.put(kg, true)
        kg += 1
    if referenced.len() == m.globals.len():
        return
    # Pass 2: build old→new index map and the kept-globals vector.
    Vector[LirGlobal] kept = []
    Dict[int, int] old_to_new = {}
    int gi = 0
    int new_idx = 0
    while gi < m.globals.len():
        if referenced.contains(gi):
            LirGlobal g = m.globals.get(gi).unwrap()
            kept.push(g)
            old_to_new.put(gi, new_idx)
            new_idx += 1
        gi += 1
    m.globals = kept
    # Pass 3: rewrite IGlobalAddr instructions to use new indices.
    int fi2 = 0
    while fi2 < m.functions.len():
        LirFunction func2 = m.functions.get(fi2).unwrap()
        int bi2 = 0
        while bi2 < func2.blocks.len():
            LirBlock blk2 = func2.blocks.get(bi2).unwrap()
            int ii2 = 0
            while ii2 < blk2.insts.len():
                LirInst inst2 = blk2.insts.get(ii2).unwrap()
                match inst2:
                    case IGlobalAddr(dst, gid):
                        int mapped = old_to_new.get(gid).unwrap()
                        blk2.insts.set(ii2, IGlobalAddr(dst, mapped))
                    else:
                        pass
                ii2 += 1
            func2.blocks.set(bi2, blk2)
            bi2 += 1
        m.functions.set(fi2, func2)
        fi2 += 1
