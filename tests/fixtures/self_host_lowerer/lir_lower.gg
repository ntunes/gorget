# GIR → LIR lowering.
#
# Transforms the high-level GIR (Gorget IR) into low-level LIR (SSA-form IR).
# All implicit operations (drop glue, coercions, vtable dispatch) become
# explicit LIR instructions.

from gir import GirModule, GirFunction, GirLocal, GirType, GirExtern, BasicBlock, Instruction, Terminator, Operand
from gir import GirTypeInfo, GirFieldInfo, GirEnumVariantInfo, ThreadSpawnRec, SpawnFnRec
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE
from gir import U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE, PRIM_COUNT
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT
from lir import LirModule, LirFunction, LirBlock, LirInst, LirTerm, LirSlot, LirStructDef, LirExtern, LirGlobal, LirThreadSpawnedFn, DictGetOrReq, BoxWrapperReq, TraitDispatchReq, SharedWrapperReq
from lir import LirSpawnedFn, SpawnParam, CloneParam
from lir import SlotProvenance
from lir import StructField, BlockParam, SwitchCase, FieldDrop, EnumVariantDrop, TypeDropInfo, FieldInit
from lir import GORGET_MAP_STRUCT_SIZE
from lir import LT_I8, LT_I16, LT_I32, LT_I64, LT_U8, LT_U16, LT_U32, LT_U64
from lir import LT_F32, LT_F64, LT_BOOL, LT_PTR, LT_VOID
from lir import LT_PTR_TO_BASE, LT_STRUCT_BASE
from lir import EK_NOT_ENUM, EK_OPTION
from lir import lir_ptr_to, lir_struct, lir_is_scalar, lir_is_aggregate, lir_is_ptr
from lir import OVF_TRAP, OVF_WRAP
from lir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from lir import ABI_AUTO, ABI_OUT_PTR
from gir import SCHED_POOL
from lir import lir_fn_next_value, lir_fn_add_slot, lir_fn_add_block
from lir import lir_push_inst, lir_set_term
from lir import lir_mod_add_struct, lir_mod_add_function, new_lir_module
from lower import get_fn_param_types, type_id_to_name
from gir import EnumCategory, enum_category_of, ENUM_CAT_OPTION, ENUM_CAT_RESULT
from gir import participates_in_fault
from std.collections import Vector, Dict
from std.conv import int_to_str
from std.conv import float_to_bits
from gir import ResourceMetadata
from gir import BorrowOrigin, BoCollectionElement
from gir import CopySemantics, CsTrivial, CsResource, CsRefCounted
from gir import CollectionKind, CkNotCollection, CkVector, CkDeque, CkHeap, CkDict, CkOrderedSet, CkHashSet
from gir import BoxKind, BkNotBox, BkRegularBox, BkTraitBox
from compiler.data.resources import RESOURCES
from compiler.data.schema import ResourceEntry, MatchKind, MkExact, MkPrefix
from compiler.data.schema import LirType, LtStructBase, LtPtr


# ── Builtin struct definitions ──────────────────────────────

void register_builtin_structs(LirModule &m, Dict[String, int] &sr):
    # GorgetString: {data: Ptr, cap: I64, len: I64, alloc: Ptr}
    Vector[StructField] str_fields = []
    str_fields.push(StructField("data", LT_PTR))
    str_fields.push(StructField("cap", LT_I64))
    str_fields.push(StructField("len", LT_I64))
    str_fields.push(StructField("alloc", LT_PTR))
    int str_id = lir_mod_add_struct(&m, LirStructDef("GorgetString", str_fields, 0, false, 32, -1, false))
    sr.put("GorgetString", str_id)
    sr.put("Str", str_id)
    m.type_runtime_map.put("GorgetString", "GorgetString")
    m.type_runtime_map.put("String", "GorgetString")
    m.type_runtime_map.put("Str", "GorgetString")

    # GorgetArray: {data: Ptr, cap: I64, len: I64, elem_size: I64}
    Vector[StructField] arr_fields = []
    arr_fields.push(StructField("data", LT_PTR))
    arr_fields.push(StructField("cap", LT_I64))
    arr_fields.push(StructField("len", LT_I64))
    arr_fields.push(StructField("elem_size", LT_I64))
    int arr_id = lir_mod_add_struct(&m, LirStructDef("GorgetArray", arr_fields, 0, false, 64, -1, false))
    sr.put("GorgetArray", arr_id)
    m.type_runtime_map.put("GorgetArray", "GorgetArray")

    # GorgetClosure: {fn_ptr: Ptr, env: Ptr}
    Vector[StructField] cls_fields = []
    cls_fields.push(StructField("fn_ptr", LT_PTR))
    cls_fields.push(StructField("env", LT_PTR))
    int cls_id = lir_mod_add_struct(&m, LirStructDef("GorgetClosure", cls_fields, 0, false, 16, -1, false))
    sr.put("GorgetClosure", cls_id)

    # TraitObj: {data: Ptr, vtable: Ptr}
    Vector[StructField] trait_fields = []
    trait_fields.push(StructField("data", LT_PTR))
    trait_fields.push(StructField("vtable", LT_PTR))
    int trait_id = lir_mod_add_struct(&m, LirStructDef("TraitObj", trait_fields, 0, false, 16, -1, false))
    sr.put("TraitObj", trait_id)

    # TaskHandle: {task_ptr: Ptr, drop_fn: Ptr}
    Vector[StructField] task_fields = []
    task_fields.push(StructField("task_ptr", LT_PTR))
    task_fields.push(StructField("drop_fn", LT_PTR))
    int task_id = lir_mod_add_struct(&m, LirStructDef("TaskHandle", task_fields, 0, false, 16, -1, false))
    sr.put("TaskHandle", task_id)

    # GorgetMap: 24 fields, 192 bytes (size from GORGET_MAP_STRUCT_SIZE;
    # see runtime_preamble.c GorgetMap — 19 legacy fields + 5 D39 dense-mode
    # fields appended at struct END). The field list below names only the
    # 13 layout/data fields the lowerer needs for member access; the trailing
    # 11 slots (6 function-pointer slots drop/clone/materialize + 5 D39
    # dense-mode fields NULL/0 in legacy mode) are layout-only — the explicit
    # struct size, not this list, is what backend allocation reads.
    Vector[StructField] map_fields = []
    map_fields.push(StructField("keys", LT_PTR))
    map_fields.push(StructField("cap", LT_I64))
    map_fields.push(StructField("values", LT_PTR))
    map_fields.push(StructField("states", LT_PTR))
    map_fields.push(StructField("count", LT_I64))
    map_fields.push(StructField("key_size", LT_I64))
    map_fields.push(StructField("val_size", LT_I64))
    map_fields.push(StructField("alloc", LT_PTR))
    map_fields.push(StructField("order", LT_PTR))
    map_fields.push(StructField("order_len", LT_I64))
    map_fields.push(StructField("tombstones", LT_I64))
    map_fields.push(StructField("hash_fn", LT_PTR))
    map_fields.push(StructField("eq_fn", LT_PTR))
    int map_id = lir_mod_add_struct(&m, LirStructDef("GorgetMap", map_fields, 0, false, GORGET_MAP_STRUCT_SIZE, -1, false))
    sr.put("GorgetMap", map_id)
    m.type_runtime_map.put("GorgetMap", "GorgetMap")

    # GorgetSet: same layout as GorgetMap
    Vector[StructField] set_fields = []
    set_fields.push(StructField("keys", LT_PTR))
    set_fields.push(StructField("cap", LT_I64))
    set_fields.push(StructField("values", LT_PTR))
    set_fields.push(StructField("states", LT_PTR))
    set_fields.push(StructField("count", LT_I64))
    set_fields.push(StructField("key_size", LT_I64))
    set_fields.push(StructField("val_size", LT_I64))
    set_fields.push(StructField("alloc", LT_PTR))
    set_fields.push(StructField("order", LT_PTR))
    set_fields.push(StructField("order_len", LT_I64))
    set_fields.push(StructField("tombstones", LT_I64))
    set_fields.push(StructField("hash_fn", LT_PTR))
    set_fields.push(StructField("eq_fn", LT_PTR))
    int set_id = lir_mod_add_struct(&m, LirStructDef("GorgetSet", set_fields, 0, false, GORGET_MAP_STRUCT_SIZE, -1, false))
    sr.put("GorgetSet", set_id)
    m.type_runtime_map.put("GorgetSet", "GorgetSet")

    # GorgetRange: {start: I64, end: I64, step: I64}
    Vector[StructField] range_fields = []
    range_fields.push(StructField("start", LT_I64))
    range_fields.push(StructField("end", LT_I64))
    range_fields.push(StructField("step", LT_I64))
    int range_id = lir_mod_add_struct(&m, LirStructDef("GorgetRange", range_fields, 0, false, 24, -1, false))
    sr.put("GorgetRange", range_id)

# ── Type mapping: GIR type ID → LIR type ───────────────────

# Map a collection name pattern to its runtime struct name. Phase A
# typed-metadata read via `resource_meta_for` (lazy-populating
# accessor); the prefix cascade lives in `build_resource_metadata`
# (single source of truth).
String collection_runtime_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkNotCollection():
                    return ""
                else:
                    return rmeta.runtime_name
        case None:
            return ""
    return ""

# Phase A typed-metadata read via `resource_meta_for`; the prefix
# cascade lives in `build_resource_metadata` (single source of truth).
# The `Heap__` prefix that the legacy cascade marked as opaque is
# now classified as its own `CkHeap` collection kind (same
# GorgetArray runtime as Vector/Deque); every caller of this
# helper checks `collection_runtime_type` first, so the previous
# Heap__→true branch never fired in practice.
bool is_opaque_pointer_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            return rmeta.opaque_handle
        case None:
            return false
    return false

# Does the STORAGE of field #`field_idx` of struct `type_name` already hold a
# POINTER value? Two cases, both meaning `&field` is a pointer-TO-a-pointer:
#   * a user borrow pointer — `Ref[T]` / `MutRef[T]` (name-derived residual,
#     per the `resolve_field_lir_type` `Ref__` guard: `map_ast_type` lowers
#     these to `GtNamed("Ref__T")`, so no typed id survives to read here);
#   * an opaque-handle resource — Shared/Mutex/RWLock/Channel — whose handle
#     value IS the pointer (typed `.opaque_handle` flag, never a name match).
# Aggregate resources (Vector/Dict/String) are stored INLINE and are therefore
# false: you do pass the aggregate's own address.
#
# ONE SOURCE OF TRUTH for two consumers that must not drift:
#   * `GIFieldLoad` lowering below skips its pointer-ALIAS store for these and
#     LOADS the stored pointer instead (you want the pointee, not the cell);
#   * the `&<projection>` place resolver (`lower_amp_place`, lower_expr.gg)
#     DECLINES these for exactly that reason — the address it could hand back
#     would be the pointee's, not the place's.
bool field_storage_holds_pointer(String type_name, int field_idx, GirModule &gmod):
    if not gmod.type_infos.contains(type_name):
        return false
    GirTypeInfo fsp_info = gmod.type_infos.get(type_name).unwrap()
    if field_idx < 0 or field_idx >= fsp_info.fields.len():
        return false
    String fsp_tn = fsp_info.fields.get(field_idx).unwrap().type_name
    if fsp_tn.starts_with("Ref__") or fsp_tn.starts_with("MutRef__"):
        return true
    return is_opaque_pointer_type(fsp_tn, &gmod)

# Phase A typed-metadata read via `resource_meta_for`; the prefix
# cascade lives in `build_resource_metadata` (Guard family →
# runtime_name "Guard").
bool is_guard_struct_type(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            return rmeta.runtime_name == "Guard"
        case None:
            return false
    return false

# Phase A typed-metadata read via `resource_meta_for`: is this type a
# REFCOUNTED carrier (CsRefCounted) — i.e. retain/release-balanced rather
# than single-owner? Channel / Shared are CsRefCounted (set at the
# `build_resource_metadata` Channel__/Shared__ arms); Mutex / collections
# are CsResource (single-owner). The KEYSTONE spawn lowering reads THIS
# (never a Channel-name prefix test) to decide which spawn-fn params
# must be retained into the spawn ctx — typed-metadata, not a name
# substring (Core #2 / layering rule 2). Future-proofs the Slice-3 Shared
# carrier: it is already CsRefCounted, so it joins clone_params with no
# new name test.
bool is_refcounted_carrier(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.copy_semantics:
                case CsRefCounted():
                    return true
                else:
                    return false
        case None:
            return false
    return false

# ── Phase A — typed resource-metadata builder ──────────────────
# Single source of truth for `is this type a Vector / Dict / Set / Box /
# opaque handle / ...`. Returns Some(meta) for categorised resource
# types; None for trivial / user-defined types. Populated once at
# `lower_gir_to_lir` entry; consumers read instead of re-deriving.
#
# When migrating a `name.starts_with("X__")` site, the right shape is:
#     match resource_meta_for(&gmod, name):
#         case Some(rmeta):
#             match rmeta.collection_kind:
#                 case CkVector(): ...
#                 ...
# (`meta` is a Gorget keyword; binding name avoids the parser conflict.)
# (See `docs/devbook/26-self-host-frontend.md` §3.)

# Iterate RESOURCES, match by Exact/Prefix.
Option[ResourceMetadata] lookup_resource_table(String name):
    for entry in RESOURCES:
        for mk in entry.match_on:
            match mk:
                case MkExact(s):
                    if name == s:
                        return Some(entry.metadata.clone())
                case MkPrefix(p):
                    if name.starts_with(p):
                        return Some(entry.metadata.clone())
    return None

Option[ResourceMetadata] build_resource_metadata(String name):
    # Try the canonical compiler.data.resources table first.
    Option[ResourceMetadata] tbl = lookup_resource_table(name)
    match tbl:
        case Some(m):
            return Some(m)
        case None:
            pass
    # Built-in runtime structs by exact name.
    if name == "GorgetString" or name == "String" or name == "Str":
        return Some(ResourceMetadata(
            "GorgetString", 32, LtStructBase(),
            Some("gorget_string_free"), Some("gorget_string_clone"),
            Some("gorget_string_materialize_inplace"),
            CsResource(), CkNotCollection(), BkNotBox(), false, None, None, false))
    if name == "GorgetArray":
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkVector(), BkNotBox(), false, None, None, false))
    if name == "GorgetMap":
        return Some(ResourceMetadata(
            "GorgetMap", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, false))
    if name == "GorgetSet":
        # Bare runtime name → CkHashSet (the unordered/runtime kind; ordered-
        # ness is a property of the user-visible `Set__` type, mirroring Rust
        # src/ir/types.rs:972 GorgetSet→CollectionKind::Set).
        return Some(ResourceMetadata(
            "GorgetSet", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkHashSet(), BkNotBox(), false, None, None, false))
    if name == "GorgetClosure":
        return Some(ResourceMetadata(
            "GorgetClosure", 16, LtStructBase(),
            Some("gorget_closure_free"), Some("gorget_closure_clone"), None,
            CsResource(), CkNotCollection(), BkNotBox(), false, None, None, false))

    # Callable__/MutCallable__/ConsumeCallable__ — the in-collection callable
    # forms (the user-facing local form lowers to FnPtr; the Named "Callable__…"
    # form only appears as a collection element / dict value / Option payload via
    # resolve_inner_type). All three share the runtime's 16-byte GorgetClosure
    # `{fn_ptr, env}` layout (drop gorget_closure_free, clone gorget_closure_clone),
    # mirroring Rust src/ir/lowering/builtins.rs:998-1056 (c_runtime_alias =
    # "GorgetClosure"). The prefix MUST end in `__` (the mangling separator) so it
    # cannot misfire on a user type — `Callable__GorgetClosure` is the exact
    # mangled spelling. CkNotCollection: a Callable is a scalar resource, not a
    # container; the Pass-1 dispatch below routes it to the pre-registered 16-byte
    # GorgetClosure struct (no fresh empty-`{char __pad;}` body).
    if name.starts_with("Callable__") or name.starts_with("MutCallable__") or name.starts_with("ConsumeCallable__"):
        return Some(ResourceMetadata(
            "GorgetClosure", 16, LtStructBase(),
            Some("gorget_closure_free"), Some("gorget_closure_clone"), None,
            CsResource(), CkNotCollection(), BkNotBox(), false, None, None, false))

    # Vector__T → GorgetArray (is_typed_constructor=true).
    if name.starts_with("Vector__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkVector(), BkNotBox(), false, None, None, true))
    # Deque__T → GorgetArray (same runtime, distinct collection kind so
    # downstream can pick double-ended ops without re-prefix-matching).
    if name.starts_with("Deque__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkDeque(), BkNotBox(), false, None, None, true))
    # Heap__T → GorgetArray, but constructed via factory (`Heap.new()`),
    # not the `T(args)` constructor shape.
    if name.starts_with("Heap__"):
        return Some(ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"), Some("gorget_array_clone"), None,
            CsResource(), CkHeap(), BkNotBox(), false, None, None, false))

    # Dict__K__V / HashMap__K__V — user-code constructors (true);
    # GorgetDict__/GorgetMap__ are self-host mangled forms (false).
    if name.starts_with("Dict__") or name.starts_with("HashMap__"):
        return Some(ResourceMetadata(
            "GorgetMap", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, true))
    if name.starts_with("GorgetDict__") or name.starts_with("GorgetMap__"):
        return Some(ResourceMetadata(
            "GorgetMap", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_map_free"), Some("gorget_map_clone"), None,
            CsResource(), CkDict(), BkNotBox(), false, None, None, false))

    # Set__T / HashSet__T — user-code constructors (true). This is the SINGLE
    # PRODUCER that maps the user-visible type name → typed CollectionKind
    # (mirrors Rust's per-protocol assignment at builtins.rs:453/503). The
    # prefix match here is the ALLOWED name→kind mapping at the source; every
    # downstream consumer reads the resolved CkOrderedSet/CkHashSet variant,
    # never re-probes the prefix. Set__ = ORDERED, HashSet__ = UNORDERED.
    if name.starts_with("Set__"):
        return Some(ResourceMetadata(
            "GorgetSet", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkOrderedSet(), BkNotBox(), false, None, None, true))
    if name.starts_with("HashSet__"):
        return Some(ResourceMetadata(
            "GorgetSet", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkHashSet(), BkNotBox(), false, None, None, true))
    # GorgetSet__ is the self-host mangled form (false) → CkHashSet (runtime kind).
    if name.starts_with("GorgetSet__"):
        return Some(ResourceMetadata(
            "GorgetSet", GORGET_MAP_STRUCT_SIZE, LtStructBase(),
            Some("gorget_set_free"), Some("gorget_set_clone"), None,
            CsResource(), CkHashSet(), BkNotBox(), false, None, None, false))

    # Box[T] — constructed via runtime alloc helper, not T() shape.
    if name.starts_with("Box__"):
        return Some(ResourceMetadata(
            "Box", 8, LtPtr(),
            None, None, None,
            CsResource(), CkNotCollection(), BkRegularBox(), false, None, None, false))

    # Opaque handles (ref-counted runtime types). Each prefix carries
    # its own method_prefix for the C method-name routing; consumers
    # used to read this via the dedicated `opaque_ptr_method_prefix`
    # cascade (now retired in favour of this typed field).
    # Mutex__/RWLock__/Channel__/Shared__ — `T(args)` user-code
    # constructor shape (is_typed_constructor=true). Other opaque
    # families construct via `T.new()` factories instead.
    if name.starts_with("Mutex__"):
        # Mutex is SINGLE-OWNER (unique-free via gorget_mutex_free), NOT
        # refcounted: there is no clone/retain path, the owner alone frees on
        # scope exit. CsResource (owned, drops once) is the accurate semantics;
        # CsRefCounted was wrong. Cosmetic for the drop emission (drop is routed
        # by drop_fn_for_type via the gorget_mutex method-prefix, not by
        # CopySemantics — which the self-host never matches on), but the typed
        # flag must still be correct. (No CsSingleOwner variant exists in the
        # imported CopySemantics enum; CsResource is the single-owner shape.)
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_mutex"), None, true))
    if name.starts_with("RWLock__"):
        # RWLock is SINGLE-OWNER (unique-free via gorget_rwlock_free, NOT
        # refcounted): there is no clone/retain path, the owner alone frees on
        # scope exit. CsResource (owned, drops once) is the accurate semantics;
        # CsRefCounted was wrong. Cosmetic for the drop emission (drop is routed
        # by drop_fn_for_type via the gorget_rwlock method-prefix, not by
        # CopySemantics — which the self-host never matches on), but the typed
        # flag must still be correct. Mirrors the Inc-A Mutex correction above.
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_rwlock"), None, true))
    if name.starts_with("Channel__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_channel"), None, true))
    if name.starts_with("Shared__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_shared"), None, true))
    # Other opaque parameterised families — factory construction shape.
    if name.starts_with("Weak__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_weak"), None, false))
    if name.starts_with("AtomicInt__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_int"), None, false))
    if name.starts_with("AtomicBool__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_bool"), None, false))
    if name.starts_with("Semaphore__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_semaphore"), None, false))
    if name.starts_with("Barrier__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_barrier"), None, false))
    if name.starts_with("OnceFlag__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_once_flag"), None, false))
    if name.starts_with("WaitGroup__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_wait_group"), None, false))
    if name.starts_with("TaskGroup__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_task_group"), None, false))
    if name.starts_with("Thread__"):
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true, None, None, false))

    # Bare atomic handles (round-33 shared(atomic) facade): carry their
    # runtime method_prefix so (a) the `shared(atomic)` carrier's owning
    # local passes `register_owning_opaque_local`'s typed prefix gate
    # (lower_drops.gg) and (b) drop routes through `drop_fn_for_type`'s Ptr
    # arm (no explicit atomic arm → the by-value `free` fallback, which IS
    # the correct teardown for a bare malloc'd atomic handle — nothing
    # nested; `gorget_atomic_int_free(**)` is the by-ADDRESS form and must
    # NOT be paired with the Ptr arm's by-value SlotLoad).
    if name == "AtomicInt":
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_int"), None, false))
    if name == "AtomicBool":
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true,
            Some("gorget_atomic_bool"), None, false))

    # Bare-name opaque handles (not parameterised). Method-prefix wiring
    # for these went through a different path historically (direct
    # method dispatch on bare names); leave method_prefix=None.
    if name == "Barrier" or name == "CondVar" or name == "Process" or name == "Thread" or name == "Semaphore" or name == "WaitGroup" or name == "OnceFlag":
        return Some(ResourceMetadata(
            "Ptr", 8, LtPtr(), None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(), true, None, None, false))

    # Guard structs — Read/Write variants get their dedicated prefix;
    # the bare Guard__ falls back to "gorget_guard".
    if name.starts_with("ReadGuard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_read_guard"), None, false))
    if name.starts_with("WriteGuard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_write_guard"), None, false))
    if name.starts_with("Guard__"):
        return Some(ResourceMetadata(
            "Guard", 16, LtStructBase(), None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(), false,
            Some("gorget_guard"), None, false))

    # Trait box: bare name (no monomorphisation suffix).
    if name == "Box":
        return Some(ResourceMetadata(
            "Box", 8, LtPtr(), None, None, None,
            CsResource(), CkNotCollection(), BkTraitBox(), false, None, None, false))

    # User struct/enum or unknown — caller treats as None.
    return None

# Phase A — typed accessor. Consumers replace `name.starts_with("X__")`
# dispatches with `match resource_meta_for(&gmod, name): case Some(rmeta): ...`
# (See `docs/devbook/26-self-host-frontend.md` §3 / §3.4.)
#
# Lazy population: callers may run BEFORE `lower_gir_to_lir`'s
# bulk-populate loop (e.g. anything inside `lower_module`). When the
# cache misses, fall through to `build_resource_metadata` (the cascade
# source of truth) and memoise the result. After the bulk-populate
# loop runs, every named type is already cached and the slow path
# becomes a single `contains` check.
Option[ResourceMetadata] resource_meta_for(GirModule &gmod, String name):
    if gmod.resource_metadata.contains(name):
        # `.get()` yields `Option[Ref[ResourceMetadata]]`; this fn returns
        # `Option[ResourceMetadata]` (a value). The self-host lowerer's
        # `Option[Ref[T]] → Option[T]` lift (lower.gg `try_lift_option_ref`,
        # wired at the SReturn site) now does the deref + clone at the return
        # boundary — `ResourceMetadata` is a RESOURCE type, so the lift takes
        # its clone branch and yields an owned `Option[ResourceMetadata]`.
        return gmod.resource_metadata.get(name)
    Option[ResourceMetadata] computed = build_resource_metadata(name)
    match computed:
        case Some(rmeta):
            gmod.resource_metadata.put(name.clone(), rmeta.clone())
            return Some(rmeta)
        case None:
            return None
    return None

# Phase A — typed accessor: read method_prefix off the metadata.
# `build_resource_metadata` populates `method_prefix` per-prefix; this
# helper unwraps it via `resource_meta_for` (returns "" when the
# prefix has no method routing — e.g. bare-name opaques like CondVar
# that go through direct method names instead).
String opaque_ptr_method_prefix(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(p):
                    return p
                case None:
                    return ""
        case None:
            return ""
    return ""

# Phase A — typed accessor: read method_prefix off the Guard metadata.
# Defaults to "gorget_guard" for the bare `Guard__` prefix, matching
# the legacy fallback behaviour.
String guard_method_prefix(String name, GirModule &gmod):
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(p):
                    return p
                case None:
                    return "gorget_guard"
        case None:
            return "gorget_guard"
    return "gorget_guard"

# Generic template / placeholder type names that should not be emitted as real
# structs in C. These arise from unmonomorphized templates leaking into the
# type table.
bool is_generic_placeholder_name(String name, GirModule gmod):
    # Mono'd prelude generics (Result__<ok>__E / Option__<inner>) are concrete
    # by construction — built only from RESOLVED return/throws types — even though
    # their fields are synthesized from m.structs (not type_infos keys). The
    # __E/__T suffix check below would otherwise wrongly skip Result__int__E etc.
    if name.starts_with("Result__") or name.starts_with("Option__"):
        return false
    # Single-letter type params: T, E, K, V, U
    if name == "T" or name == "E" or name == "K" or name == "V" or name == "U":
        return true
    # Template ending in a bare type param suffix: TypedColumn__T, Box__T —
    # UNLESS the trailing segment names a DECLARED concrete user type. A user
    # `enum V` / `struct T` is a legal type name, and `Dict__GorgetString__V`
    # is then a CONCRETE collection mono, not a template leak. The meaning
    # decision reads the typed decl registry (gmod.type_infos), not the name
    # shape (round-32 scout: dict_nested_pattern_noncopy_enum CC-FAIL — the
    # `__V` suffix probe misclassified the mono and Pass 1 never registered
    # its runtime alias, so Dict__GorgetString__V/__put/__get stayed unmapped).
    if name.ends_with("__T") or name.ends_with("__E") or name.ends_with("__K") or name.ends_with("__V") or name.ends_with("__U"):
        String ph_tail = name.slice(name.len() - 1, name.len())
        if not gmod.type_infos.contains(ph_tail):
            return true
    # Bare enum variant names (not the Option__X / Result__X parent types)
    if name == "Some" or name == "None" or name == "Ok" or name == "Error" or name == "Err":
        return true
    # C-primitive type aliases that sometimes appear as named types (from
    # field decls like `uint8_t x` being treated as TNamed). They have no
    # struct body — the C preamble provides them via stdint.h.
    if name == "uint8_t" or name == "uint16_t" or name == "uint32_t" or name == "uint64_t":
        return true
    if name == "int8_t" or name == "int16_t" or name == "int32_t" or name == "int64_t":
        return true
    if name == "byte" or name == "size_t" or name == "ssize_t":
        return true
    if name == "float32" or name == "float64" or name == "double":
        return true
    return false

int map_gir_type(int type_id, GirModule &gmod, Dict[String, int] &sr):
    if type_id == BOOL_TYPE:
        return LT_BOOL
    elif type_id == I8_TYPE:
        return LT_I8
    elif type_id == I16_TYPE:
        return LT_I16
    elif type_id == I32_TYPE:
        return LT_I32
    elif type_id == I64_TYPE:
        return LT_I64
    elif type_id == U8_TYPE:
        return LT_U8
    elif type_id == U16_TYPE:
        return LT_U16
    elif type_id == U32_TYPE:
        return LT_U32
    elif type_id == U64_TYPE:
        return LT_U64
    elif type_id == F32_TYPE:
        return LT_F32
    elif type_id == F64_TYPE:
        return LT_F64
    elif type_id == UNIT_TYPE:
        return LT_VOID

    if type_id < 0 or type_id >= gmod.type_table.len():
        return LT_I64

    GirType gt = gmod.type_table.get(type_id).unwrap()
    match gt:
        case GtPtr(inner):
            int inner_ty = map_gir_type(inner, &gmod, &sr)
            int sid = lir_struct_id(inner_ty)
            if sid >= 0:
                return lir_ptr_to(sid)
            return LT_PTR
        case GtMutPtr(inner):
            int inner_ty = map_gir_type(inner, &gmod, &sr)
            int sid = lir_struct_id(inner_ty)
            if sid >= 0:
                return lir_ptr_to(sid)
            return LT_PTR
        case GtNamed(name):
            int sid = sr.get(name).unwrap_or(-1)
            if sid >= 0:
                return lir_struct(sid)
            # Phase A: typed accessor — read populated metadata from
            # the GirModule (populated once at lower_gir_to_lir entry).
            Option[ResourceMetadata] rmeta_opt = resource_meta_for(&gmod, name)
            match rmeta_opt:
                case Some(rmeta):
                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                    if rt_sid >= 0:
                        return lir_struct(rt_sid)
                case None:
                    pass
            return LT_PTR
        case GtFnPtr(_, _):
            int cls_sid = sr.get("GorgetClosure").unwrap_or(-1)
            if cls_sid >= 0:
                return lir_struct(cls_sid)
            return LT_PTR
        else:
            return LT_I64
    return LT_I64

# ── Type definition lowering ────────────────────────────────

# Map a type name (from GirFieldInfo) to an LIR type constant.
# Identify runtime struct names whose `computed_c_size` was set by
# `register_builtin_structs` to match C's actual layout (with
# runtime-only fields like `alloc` that aren't modelled in LirStructDef).
# Pass 4 must skip these — recomputing from the 4 visible fields would
# shrink GorgetArray from 64 to 32 and similarly regress others.
bool is_builtin_runtime_struct(String name):
    if name == "GorgetString" or name == "Str":
        return true
    if name == "GorgetArray" or name == "GorgetMap" or name == "GorgetSet":
        return true
    if name == "GorgetClosure" or name == "TraitObj":
        return true
    if name == "TaskHandle" or name == "GorgetRange":
        return true
    return false

# Ensure a field's type name is resolvable via `sr` so
# `resolve_field_lir_type` doesn't fall through to `LT_PTR`. Called
# from Pass 1c for every struct field and every enum variant field.
# Handles the collection aliases (Vector__*, Dict__*, Set__*, etc.)
# that only appear as field types and never get `lookup_or_register_named`
# treatment during GIR lowering. Silently no-ops for primitives / names
# already registered / types lir_lower doesn't know how to size.
void register_field_type_in_sr(String tname, Dict[String, int] &sr, LirModule &m, GirModule &gmod):
    if tname == "":
        return
    if sr.get(tname).unwrap_or(-1) >= 0:
        return
    # Primitives: no registration needed — resolve_field_lir_type returns
    # the scalar LirType directly.
    if tname == "int64_t" or tname == "int32_t" or tname == "int16_t" or tname == "int8_t":
        return
    if tname == "uint64_t" or tname == "uint32_t" or tname == "uint16_t" or tname == "uint8_t":
        return
    if tname == "double" or tname == "float64" or tname == "float" or tname == "float32":
        return
    if tname == "bool" or tname == "void":
        return
    # Collection aliases → map to the pre-registered runtime struct.
    String rt = collection_runtime_type(tname, &gmod)
    if rt != "":
        int rt_sid = sr.get(rt).unwrap_or(-1)
        if rt_sid >= 0:
            sr.put(tname, rt_sid)
        m.type_runtime_map.put(tname.clone(), rt.clone())
        return
    # Box / Guard / opaque / prelude types we know how to stamp.
    # Phase A typed read: BkRegularBox identifies parameterised Box[T];
    # the trait box (BkTraitBox) for bare `Box` doesn't reach this site
    # (no monomorphisation suffix to register).
    bool tname_is_box = false
    match resource_meta_for(&gmod, tname):
        case Some(rmeta):
            match rmeta.box_kind:
                case BkRegularBox():
                    tname_is_box = true
                else:
                    pass
        case None:
            pass
    if tname_is_box:
        # Trait box (inner has a `_VTable`) → FAT {data, vtable} (16), else
        # value box `{_0}` (8). Sibling of the Pass-1 registrar above.
        String tib_inner = tname.slice(5, tname.len())
        bool tib_is_trait = box_inner_is_trait(tib_inner, gmod)
        Vector[StructField] box_fields = []
        int tib_sz = 8
        if tib_is_trait:
            box_fields.push(StructField("data", LT_PTR))
            box_fields.push(StructField("vtable", LT_PTR))
            tib_sz = 16
        else:
            box_fields.push(StructField("_0", LT_PTR))
        String box_name_ctor = tname.clone()
        int box_id = lir_mod_add_struct(&m, LirStructDef(box_name_ctor, box_fields, 0, false, tib_sz, -1, tib_is_trait))
        sr.put(tname, box_id)
        # Trait box: a REAL emitted struct — keep it OUT of type_runtime_map
        # (see the Pass-1 registrar's note). Value boxes stay "Box".
        if tib_is_trait:
            return
        m.type_runtime_map.put(tname.clone(), "Box")
        # Write-through (sibling of the Pass-1 BkRegularBox arm in
        # lower_type_defs): both Box registrars must populate the typed inner
        # channel so the allocator/wrapper generators read it instead of
        # name-matching. rmeta proved `tname` is a `Box__<inner>` regular box;
        # `5` is the `Box__` mangling-contract length (name PARSING).
        m.coll_elem_type_map.put(tname.clone(), tname.slice(5, tname.len()))
        return
    if is_opaque_pointer_type(tname, &gmod):
        m.type_runtime_map.put(tname.clone(), "Ptr")
        String opm = opaque_ptr_method_prefix(tname, &gmod)
        if opm != "":
            m.type_method_prefix_map.put(tname.clone(), opm)
            # Mirror the lower_type_defs opaque-handle write-through for a
            # Shared-typed STRUCT FIELD (e.g. `Tensor.storage: Shared[Vector[T]]`):
            # record the inner element on coll_elem_type_map so an accessor on a
            # field-only Shared type still resolves its wrapper request. Gated on
            # the RESOLVED `opm` (not a name-match). `Shared__` is 8 chars.
            if opm == "gorget_shared":
                m.coll_elem_type_map.put(tname.clone(), tname.slice(8, tname.len()))
        return
    if is_guard_struct_type(tname, &gmod):
        Vector[StructField] guard_fields = []
        guard_fields.push(StructField("owner", LT_PTR))
        guard_fields.push(StructField("ptr", LT_PTR))
        String guard_name_ctor = tname.clone()
        int guard_id = lir_mod_add_struct(&m, LirStructDef(guard_name_ctor, guard_fields, 0, false, 16, -1, false))
        sr.put(tname, guard_id)
        m.type_runtime_map.put(tname.clone(), "Guard")
        m.type_method_prefix_map.put(tname.clone(), guard_method_prefix(tname, &gmod))
        return

int resolve_field_lir_type(String type_name, Dict[String, int] sr):
    if type_name == "int64_t" or type_name == "int":
        return LT_I64
    elif type_name == "int32_t":
        return LT_I32
    elif type_name == "int16_t":
        return LT_I16
    elif type_name == "int8_t":
        return LT_I8
    elif type_name == "uint64_t":
        return LT_U64
    elif type_name == "uint32_t":
        return LT_U32
    elif type_name == "uint16_t":
        return LT_U16
    elif type_name == "uint8_t":
        return LT_U8
    elif type_name == "double" or type_name == "float64":
        return LT_F64
    elif type_name == "float" or type_name == "float32":
        return LT_F32
    elif type_name == "bool":
        return LT_BOOL
    elif type_name == "void":
        return LT_VOID
    # Ref[T] monomorphs (`Ref__T_mangled`) are borrow pointers — always void*.
    # The GIR represents them as GtNamed("Ref__T") because map_ast_type
    # falls into the TNamed arm for TNamed("Ref",[T]) rather than GtPtr.
    # Regardless, the ABI is a raw pointer (the runtime never allocates a
    # Ref struct; the value IS the address). Return LT_PTR so field defs,
    # Option/Result payload slots, and out-param copies all emit `void*`
    # rather than the 1-byte placeholder struct `{ char __pad; }` that
    # Pass 1 registers when Ref__T appears in the type table.
    # Mirrors Rust lir_lower which routes GtPtr/GtMutPtr to LT_PTR.
    if type_name.starts_with("Ref__"):
        return LT_PTR
    # Named types — look up in struct registry
    int sid = sr.get(type_name).unwrap_or(-1)
    if sid >= 0:
        return LT_STRUCT_BASE + sid
    # Fallback: treat as pointer (opaque or unresolved type)
    return LT_PTR

# Bridge a GIR payload type id (read off the typed `enum_category` channel)
# to its LIR field type — the typed replacement for re-parsing a mono'd
# `Option__`/`Result__` name. A `GtPtr`/`GtMutPtr` payload (a borrowed
# `Option__Ref__T`'s `GtPtr(T)`) maps to `LT_PTR` directly — we must NOT
# strip it to the pointee struct (that's the shallow-copy unsoundness the
# `option_ref_payload` channel guards). A `void`/`unit` Ok payload (a
# `T f() throws E` with `T=void`) maps to `LT_VOID`. Otherwise resolve the
# payload's NAME (a typed `type_id_to_name` lookup off the GtNamed
# registry — NOT a mangled-name split) through `resolve_field_lir_type`.
int gir_payload_to_lir_type(int gir_tid, GirModule &gmod, Dict[String, int] sr):
    if gir_tid == UNIT_TYPE:
        return LT_VOID
    if gir_tid >= 0 and gir_tid < gmod.type_table.len():
        match gmod.type_table.get(gir_tid).unwrap():
            case GtPtr(_):
                return LT_PTR
            case GtMutPtr(_):
                return LT_PTR
            else:
                pass
    return resolve_field_lir_type(type_id_to_name(gir_tid, &gmod), sr)

# Register user-defined structs and enums from the GIR type table.
void lower_type_defs(GirModule &gmod, LirModule &m, Dict[String, int] &sr):
    # Two-pass registration: Pass 1 creates placeholder entries,
    # Pass 2 fills in fields.

    # Collect enum variant names to skip them in Pass 1 — they should be
    # represented as their parent enum, not as their own standalone struct.
    Dict[String, bool] enum_variant_names = {}
    Vector[String] ti_all_keys = gmod.type_infos.keys()
    for tname_k in ti_all_keys:
        GirTypeInfo tinfo_k = gmod.type_infos.get(tname_k).unwrap()
        if tinfo_k.is_enum:
            for v in tinfo_k.variants:
                enum_variant_names.put(v.name, true)

    # Pass 1: Pre-register all named types
    for gt in gmod.type_table:
        match gt:
            case GtNamed(name):
                if name == "":
                    continue
                if is_generic_placeholder_name(name, gmod) and not gmod.type_infos.contains(name):
                    continue
                if enum_variant_names.contains(name):
                    continue
                if sr.get(name).unwrap_or(-1) < 0:
                    # Phase A: typed dispatch on rmeta.collection_kind /
                    # box_kind / opaque_handle, mirroring the
                    # `register_type_alias_for_collection_or_opaque`
                    # earlier in this file. The inner name-slicing for
                    # elem/key/val extraction stays string-based —
                    # rmeta doesn't carry the parsed names.
                    bool dispatched = false
                    match resource_meta_for(&gmod, name):
                        case Some(rmeta):
                            match rmeta.collection_kind:
                                case CkVector():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Vector__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(8, name.len()))
                                    dispatched = true
                                case CkDeque():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Deque__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(7, name.len()))
                                    dispatched = true
                                case CkHeap():
                                    # Heap[T] is a user-defined generic struct
                                    # (`lib/std/heap.gg`: `struct Heap[T]: Vector[T]
                                    # heap_data`), NOT a runtime collection alias.
                                    # Its `collection_kind=CkHeap` drives ownership
                                    # (Heap.push consumes its arg, in lower.gg) and
                                    # element sizing, but at the LIR type layer it
                                    # MUST route as a UserType: the monomorphized
                                    # drop/clone fns access `self->heap_data`
                                    # (populate_drop_metadata reads its type_infos
                                    # fields), so `Heap__<T>` needs a real struct body
                                    # `struct Heap__<T> { GorgetArray heap_data; }`,
                                    # NOT a `typedef GorgetArray Heap__<T>`. Aliasing it
                                    # to GorgetArray (type_runtime_map + dispatched=true)
                                    # made should_skip_struct drop the body while the
                                    # drop fn still referenced the field → cc-fail
                                    # (heap_basic/advanced/edges). Mirror Rust, which
                                    # deliberately excludes Heap__ from the GorgetArray
                                    # alias path and routes it as UserType
                                    # (src/lir/lower/insts.rs:2008-2012,2024-2029).
                                    # Leave `dispatched=false` so the placeholder block
                                    # below registers Heap__<T> as a user struct; Pass 2
                                    # fills `heap_data` from gmod.type_infos.
                                    if name.starts_with("Heap__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(7, name.len()))
                                case CkOrderedSet():
                                    # Ordered set (`Set__T`) → gorget_ordered_set_new.
                                    # The ctor fn is now chosen by the TYPED kind
                                    # (CkOrderedSet), not a `Set__`-prefix
                                    # probe — retiring the fossil. The element-name
                                    # slice still parses the prefix length (string
                                    # parsing, not a meaning decision): `Set__` = 5.
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Set__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(5, name.len()))
                                    m.coll_ctor_fn_map.put(name.clone(), "gorget_ordered_set_new")
                                    dispatched = true
                                case CkHashSet():
                                    # Unordered set (`HashSet__T` / mangled
                                    # `GorgetSet__T`) → gorget_set_new, by TYPED
                                    # kind. Element-name slice: `HashSet__` = 9,
                                    # `GorgetSet__` = 11 (the old shared slice(9)
                                    # mis-sliced GorgetSet__ — fixed per-prefix).
                                    int rt_sid_h = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid_h >= 0:
                                        sr.put(name, rt_sid_h)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("HashSet__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(9, name.len()))
                                    elif name.starts_with("GorgetSet__"):
                                        m.coll_elem_type_map.put(name.clone(), name.slice(11, name.len()))
                                    m.coll_ctor_fn_map.put(name.clone(), "gorget_set_new")
                                    dispatched = true
                                case CkDict():
                                    int rt_sid = sr.get(rmeta.runtime_name).unwrap_or(-1)
                                    if rt_sid >= 0:
                                        sr.put(name, rt_sid)
                                    m.type_runtime_map.put(name.clone(), rmeta.runtime_name.clone())
                                    if name.starts_with("Dict__") or name.starts_with("GorgetDict__"):
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_dict_new")
                                        String d_rest = name.slice(6, name.len())
                                        int d_i = 0
                                        while d_i + 1 < d_rest.byte_len():
                                            if d_rest.byte_at(d_i) == 0x5F and d_rest.byte_at(d_i + 1) == 0x5F:
                                                String d_key = d_rest.slice(0, d_i)
                                                String d_val_rest = d_rest.slice(d_i + 2, d_rest.len())
                                                m.coll_key_type_map.put(name.clone(), d_key.clone())
                                                m.coll_val_type_map.put(name.clone(), d_val_rest.clone())
                                                break
                                            d_i += 1
                                    elif name.starts_with("HashMap__") or name.starts_with("GorgetMap__"):
                                        m.coll_ctor_fn_map.put(name.clone(), "gorget_map_new")
                                        int pfx_len = 9
                                        if name.starts_with("GorgetMap__"):
                                            pfx_len = 11
                                        String hm_rest = name.slice(pfx_len, name.len())
                                        int hm_i = 0
                                        while hm_i + 1 < hm_rest.byte_len():
                                            if hm_rest.byte_at(hm_i) == 0x5F and hm_rest.byte_at(hm_i + 1) == 0x5F:
                                                String hm_key = hm_rest.slice(0, hm_i)
                                                String hm_val_rest = hm_rest.slice(hm_i + 2, hm_rest.len())
                                                m.coll_key_type_map.put(name.clone(), hm_key.clone())
                                                m.coll_val_type_map.put(name.clone(), hm_val_rest.clone())
                                                break
                                            hm_i += 1
                                    dispatched = true
                                case CkNotCollection():
                                    pass
                            if not dispatched:
                                # CkNotCollection branch: opaque / Box / Guard.
                                match rmeta.box_kind:
                                    case BkRegularBox():
                                        # Trait box (`Box__<Trait>`, inner has a
                                        # `_VTable`) → FAT struct {data, vtable}
                                        # (16 bytes), NOT the `{_0}` value-box
                                        # (8). Mirrors Rust gg's TraitObj layout
                                        # (`<Trait>_TraitObj {data, vtable}`).
                                        String box_inner = name.slice(5, name.len())
                                        bool box_is_trait = box_inner_is_trait(box_inner, gmod)
                                        Vector[StructField] box_fields = []
                                        int box_sz = 8
                                        if box_is_trait:
                                            box_fields.push(StructField("data", LT_PTR))
                                            box_fields.push(StructField("vtable", LT_PTR))
                                            box_sz = 16
                                        else:
                                            box_fields.push(StructField("_0", LT_PTR))
                                        String box_name = name.clone()
                                        int box_id = lir_mod_add_struct(&m, LirStructDef(box_name, box_fields, 0, false, box_sz, -1, box_is_trait))
                                        sr.put(name, box_id)
                                        # Trait box: a REAL emitted struct
                                        # (`struct __gg_Box__<Trait> {data, vtable}`),
                                        # so it must NOT go in type_runtime_map (that
                                        # would alias it to `typedef void*` in
                                        # emit_mono_typedefs + skip its struct body in
                                        # should_skip_struct). Value boxes stay "Box".
                                        if box_is_trait:
                                            dispatched = true
                                            continue
                                        m.type_runtime_map.put(name.clone(), "Box")
                                        # Write-through (Layering rule 4): we are inside the
                                        # TYPED `case BkRegularBox()` arm — rmeta proved this
                                        # `name` is a `Box__<inner>` regular box (the
                                        # build_resource_metadata Box arm is the sole producer
                                        # of BkRegularBox). Record the inner C type on the same
                                        # typed channel Vector/Set/Deque use (coll_elem_type_map),
                                        # so the box allocator + get/set wrapper generators read
                                        # it via coll_elem_type_for_name (a `__`-split scan, NOT
                                        # a Box mangled-prefix meaning-decision). `5` is the
                                        # `Box__` mangling-contract length (name PARSING at the
                                        # producer, same as Vector__'s `slice(8,..)` above).
                                        m.coll_elem_type_map.put(name.clone(), name.slice(5, name.len()))
                                        dispatched = true
                                    else:
                                        pass
                            if not dispatched and rmeta.opaque_handle:
                                m.type_runtime_map.put(name.clone(), "Ptr")
                                match rmeta.method_prefix:
                                    case Some(opm2):
                                        m.type_method_prefix_map.put(name.clone(), opm2)
                                        # Write-through (Layering rule 4) for the
                                        # EXPLICIT Shared[T] accessor wrappers. The
                                        # opaque-handle arm is the PRIMARY registrar
                                        # for `Shared__*` locals (build_resource_metadata
                                        # classifies every Shared as opaque_handle +
                                        # method_prefix "gorget_shared", so it skips
                                        # every collection arm and lands HERE). Record
                                        # the inner type on the typed coll_elem_type_map
                                        # channel — gated on the RESOLVED `opm2`, not a
                                        # name-match — so record_shared_wrapper_req can
                                        # read it via coll_elem_type_for_name (which
                                        # returned "" before this entry → skipped every
                                        # wrapper request → undefined `gorget_shared_*`).
                                        # `Shared__` is 8 chars; the slice yields
                                        # `Shared__int64_t`→`int64_t` and
                                        # `Shared__Vector__int64_t`→`Vector__int64_t`.
                                        # (The Shared__Mutex__c CARRIER also lands here,
                                        # adding an inert Shared__Mutex__c→Mutex__c entry
                                        # — harmless: the carrier inlines via GICallExtern
                                        # and never routes through the wrapper arm.)
                                        if opm2 == "gorget_shared":
                                            m.coll_elem_type_map.put(name.clone(), name.slice(8, name.len()))
                                    case None:
                                        pass
                                dispatched = true
                            if not dispatched and rmeta.runtime_name == "Guard":
                                Vector[StructField] guard_fields = []
                                guard_fields.push(StructField("owner", LT_PTR))
                                guard_fields.push(StructField("ptr", LT_PTR))
                                String guard_name = name.clone()
                                int guard_id = lir_mod_add_struct(&m, LirStructDef(guard_name, guard_fields, 0, false, 16, -1, false))
                                sr.put(name, guard_id)
                                m.type_runtime_map.put(name.clone(), "Guard")
                                match rmeta.method_prefix:
                                    case Some(gmp):
                                        m.type_method_prefix_map.put(name.clone(), gmp)
                                    case None:
                                        m.type_method_prefix_map.put(name.clone(), "gorget_guard")
                                dispatched = true
                            if not dispatched and rmeta.runtime_name == "GorgetClosure":
                                # Callable__/MutCallable__/ConsumeCallable__ alias to
                                # the pre-registered 16-byte GorgetClosure struct (set up
                                # in register_builtin_structs). Point `sr` at that struct
                                # id so locals get C type GorgetClosure (no fresh empty
                                # body — should_skip_struct sees the type_runtime_map
                                # "GorgetClosure" category and suppresses it), and
                                # resource_clone_fn (sdef.name == "GorgetClosure") returns
                                # gorget_closure_clone_to_owned for the `.clone()` path.
                                int cls_rt_sid = sr.get("GorgetClosure").unwrap_or(-1)
                                if cls_rt_sid >= 0:
                                    sr.put(name, cls_rt_sid)
                                m.type_runtime_map.put(name.clone(), "GorgetClosure")
                                dispatched = true
                        case None:
                            pass
                    if not dispatched:
                        # User struct/enum / unknown — placeholder filled in Pass 2.
                        Vector[StructField] empty_fields = []
                        String ph_name = name.clone()
                        int sid = lir_mod_add_struct(&m, LirStructDef(ph_name, empty_fields, 0, false, -1, -1, false))
                        sr.put(name, sid)
                        if name.starts_with("Task__"):
                            m.type_runtime_map.put(name.clone(), "Task")
            else:
                pass

    # Pass 1b: Ensure all types from type_infos have LIR struct entries.
    Vector[String] ti_keys = gmod.type_infos.keys()
    for tname in ti_keys:
        if tname == "":
            continue
        if is_generic_placeholder_name(tname, gmod) and not gmod.type_infos.contains(tname):
            continue
        if enum_variant_names.contains(tname):
            continue
        if sr.get(tname).unwrap_or(-1) < 0:
            Vector[StructField] empty_fields = []
            String ph_name = tname.clone()
            int sid = lir_mod_add_struct(&m, LirStructDef(ph_name, empty_fields, 0, false, -1, -1, false))
            sr.put(tname, sid)

    # Pass 1c: Register collection types referenced only as field types.
    # `Vector[int]` used only inside `MNamed(String, Vector[int])` never
    # appears in `gmod.type_table` (no `map_ast_type` call triggers on a
    # variant-field type), so Pass 1/1b miss it. `resolve_field_lir_type`
    # then falls back to `LT_PTR` (8 bytes), and the containing enum's
    # union-variant max-size calculation undercounts by
    # `sizeof(GorgetArray) - 8 = 56` per occurrence.
    for pc_tname in ti_keys:
        GirTypeInfo pc_info = gmod.type_infos.get(pc_tname).unwrap()
        # Struct fields
        for pcf in pc_info.fields:
            register_field_type_in_sr(pcf.type_name, &sr, &m, &gmod)
        # Enum variant fields
        for pcv in pc_info.variants:
            for pcvf in pcv.fields:
                register_field_type_in_sr(pcvf.type_name, &sr, &m, &gmod)

    # Pass 2: Fill in struct/enum fields from GIR type info.
    for tname in ti_keys:
        int sid = sr.get(tname).unwrap_or(-1)
        if sid < 0:
            continue
        if not gmod.type_infos.contains(tname):
            continue
        GirTypeInfo tinfo = gmod.type_infos.get(tname).unwrap()
        LirStructDef sdef = m.structs.get(sid).unwrap()
        # Only fill if placeholder (empty fields)
        if sdef.fields.len() > 0:
            continue
        if tinfo.is_enum:
            # Enum: tag (I32) + variant fields. We build both the flat
            # field list (for codegen's struct emission) AND compute
            # `computed_c_size` up front so downstream `sizeof(T)` queries
            # via type_elem_size_in_mod / lir_type_byte_size_in_mod land
            # on the correct byte count. Without this the fallback in
            # those helpers summed every variant's fields, giving
            # 12376 bytes for union-layout enums like Item (real size
            # 568) — and the `Vector[Item] items = Vector[Item]()` init
            # in parser.gg got `gorget_array_new(12376)`, guaranteeing
            # every push ran off the end of the allocation.
            Vector[StructField] efields = []
            efields.push(StructField("tag", LT_I32))
            int max_variant_size = 0
            int flat_payload_size = 0
            for vinfo in tinfo.variants:
                int variant_bytes = 0
                int vfi = 0
                while vfi < vinfo.fields.len():
                    GirFieldInfo finfo = vinfo.fields.get(vfi).unwrap()
                    String fname = vinfo.name + "_" + int_to_str(vfi)
                    int fty = resolve_field_lir_type(finfo.type_name, sr)
                    efields.push(StructField(fname, fty))
                    int field_bytes = lir_type_byte_size_in_mod(fty, &m, 0)
                    variant_bytes = variant_bytes + field_bytes
                    flat_payload_size = flat_payload_size + field_bytes
                    vfi += 1
                if variant_bytes > max_variant_size:
                    max_variant_size = variant_bytes
            # Match Rust backend: union layout when field count > 4 (tag + >3 payload).
            bool is_union = efields.len() > 4
            # Pass 2 only iterates `gmod.type_infos` keys (USER struct/enum/
            # mono-record names); the prelude monos `Option__T` / `Result__T__E`
            # are never registered there — they're synthesized in Pass 3 below
            # ("they don't appear in gmod.type_infos by name"). So the former
            # `tname`-prefix Option/Result enum-kind arms here
            # were probe-DEAD (0 fires over the full driver self-emit + the
            # Option/Result corpus) — retired. A user enum gets ek=3; an empty
            # one ek=0. (No name-matching: Layering rule 2.)
            int ek = 0
            if tinfo.variants.len() > 0:
                ek = 3
            # Both layouts pad to the struct's alignof (max of field
            # alignments), matching C's rule. Union: tag(4) rounded to
            # alignof + max variant payload, rounded to alignof. Flat:
            # tag(4) + sum of payload fields, rounded to alignof.
            int enum_align = struct_alignof_from_fields(efields, &m)
            int computed_size = 0
            if is_union:
                int padded_max = round_up_to(max_variant_size, enum_align)
                int tag_and_pad = round_up_to(4, enum_align)
                computed_size = tag_and_pad + padded_max
            else:
                int flat_total = 4 + flat_payload_size
                computed_size = round_up_to(flat_total, enum_align)
            if computed_size == 0:
                computed_size = 4
            LirStructDef new_sdef = LirStructDef(sdef.name, efields, ek, is_union, computed_size, -1, sdef.is_trait_box)
            m.structs.set(sid, new_sdef)
        else:
            # Struct: map fields + pre-compute byte size (sum of field
            # sizes, padded to struct's alignof).
            Vector[StructField] sfields = []
            int s_total = 0
            for finfo in tinfo.fields:
                int fty = resolve_field_lir_type(finfo.type_name, sr)
                sfields.push(StructField(finfo.name, fty))
                s_total = s_total + lir_type_byte_size_in_mod(fty, &m, 0)
            int s_align = struct_alignof_from_fields(sfields, &m)
            s_total = round_up_to(s_total, s_align)
            if s_total == 0:
                s_total = 1
            LirStructDef new_sdef = LirStructDef(sdef.name, sfields, 0, false, s_total, -1, sdef.is_trait_box)
            m.structs.set(sid, new_sdef)

    # Pass 3: Synthesize fields for monomorphized Option__T / Result__T__E
    # placeholders (they don't appear in gmod.type_infos by name).
    int psi = 0
    while psi < m.structs.len():
        LirStructDef psdef = m.structs.get(psi).unwrap()
        if psdef.fields.len() != 0:
            psi += 1
            continue
        String pname = psdef.name
        # Look up the typed enum-category record for this mono'd struct (the
        # name-deduped GIR id is `named_types[pname]`). The Some_0/Ok_0/Error_0
        # field TYPES come straight off the channel via `gir_payload_to_lir_type`
        # — no `__`-boundary re-parse of `pname`, which is genuinely ambiguous
        # for nested generics like `Result__Option__int64_t__GorgetString` (the
        # SEGFAULTING mis-split). Layering rule 3 / CLAUDE.md "No name matching".
        #
        # The Option-vs-Result BRANCH SELECTOR reads the typed `EnumCategory`
        # channel (`pec.category`), not the mangled `pname` prefix — migrated
        # off the `pname`-prefix test after a probe over
        # the full driver self-emit + Option/Result corpus showed the channel
        # category and the name prefix AGREE on every one of 3150 placeholder-
        # struct fires (0 disagreements). The legacy inner name-slice fallbacks
        # were provably-unreachable after that migration (the selector arm
        # always re-derives the payload tids from the channel) and are deleted;
        # the inner code now reads `pec.{ok_type, err_type}` directly.
        # Layering rule 2: typed metadata, not names.
        int pname_tid = gmod.named_types.get(pname).unwrap_or(-1)
        EnumCategory pec = enum_category_of(&gmod, pname_tid)
        if pec.category == ENUM_CAT_OPTION:
            # Typed channel: the recorded Some_0 payload tid drives both the
            # field LIR type and the drop-name. A `GtPtr` payload (a borrowed
            # `Option__Ref__T`) is `LT_PTR` and gets NO drop — the typed
            # restatement of the `Ref__`-prefix borrow guard.
            int inner_ty = gir_payload_to_lir_type(pec.ok_type, &gmod, sr)
            String inner = type_id_to_name(pec.ok_type, &gmod)
            bool opt_is_borrow = false
            if pec.ok_type >= 0 and pec.ok_type < gmod.type_table.len():
                match gmod.type_table.get(pec.ok_type).unwrap():
                    case GtPtr(_):
                        opt_is_borrow = true
                    case GtMutPtr(_):
                        opt_is_borrow = true
                    case GtNamed(ref_name):
                        # Ref[T] monomorphs appear as GtNamed("Ref__T") (not GtPtr)
                        # because map_ast_type routes TNamed("Ref",[T]) via the
                        # generic-mangle path. They are borrow pointers (no drop).
                        if ref_name.starts_with("Ref__"):
                            opt_is_borrow = true
                    else:
                        pass
            Vector[StructField] ofields = []
            ofields.push(StructField("tag", LT_I32))
            ofields.push(StructField("Some_0", inner_ty))
            # Phase A: register for typed dispatch before pname moves into LirStructDef.
            m.type_runtime_map.put(pname.clone(), "Option")
            # Generate drop/clone for a mono'd Option[Resource]: register a
            # `Some_0` variant-drop (variant index 0 = Some; None has no
            # payload) so emit_enum_drops/emit_enum_clones produce
            # `Option__<inner>__drop` / `__clone`. The self-host never
            # generated these — mono'd prelude generics aren't user
            # `m.items` defs, so Pass 2's type_infos-driven loop misses them
            # — which left an `Option[Resource]` field byte-copied (aliased)
            # at a consuming position and double-freed (MatchArm `guard` /
            # ElseBranch `condition`). Rust emits these (driver.c:11479).
            # Mirrors Pass 2's recursive_drop_enums + type_drop_fns wiring.
            String opt_inner_drop = ""
            if not opt_is_borrow:
                opt_inner_drop = drop_fn_for_type(inner, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
            if opt_inner_drop != "":
                Vector[EnumVariantDrop] opt_vd = []
                opt_vd.push(EnumVariantDrop(0, "Some", "Some_0", opt_inner_drop.clone(), inner.clone()))
                m.recursive_drop_enums.put(pname.clone(), opt_vd)
                Vector[FieldDrop] opt_nofd = []
                Vector[EnumVariantDrop] opt_vd2 = []
                opt_vd2.push(EnumVariantDrop(0, "Some", "Some_0", opt_inner_drop, inner.clone()))
                m.type_drop_fns.put(pname.clone(), TypeDropInfo(pname + "__drop", opt_nofd, "", opt_vd2))
            LirStructDef opt_sdef = LirStructDef(pname, ofields, 1, false, -1, -1, false)
            m.structs.set(psi, opt_sdef)
        elif pec.category == ENUM_CAT_RESULT:
            # Typed channel: payload tids → field LIR types + drop-names, no
            # `pname` re-parse. A `GtPtr`/`GtMutPtr` payload is `LT_PTR` and
            # gets NO drop (borrowed).
            int ok_ty = gir_payload_to_lir_type(pec.ok_type, &gmod, sr)
            int err_ty = gir_payload_to_lir_type(pec.err_type, &gmod, sr)
            String ok_name = type_id_to_name(pec.ok_type, &gmod)
            String err_name = type_id_to_name(pec.err_type, &gmod)
            bool res_ok_borrow = false
            bool res_err_borrow = false
            if pec.ok_type >= 0 and pec.ok_type < gmod.type_table.len():
                match gmod.type_table.get(pec.ok_type).unwrap():
                    case GtPtr(_):
                        res_ok_borrow = true
                    case GtMutPtr(_):
                        res_ok_borrow = true
                    case GtNamed(ok_ref_name):
                        if ok_ref_name.starts_with("Ref__"):
                            res_ok_borrow = true
                    else:
                        pass
            if pec.err_type >= 0 and pec.err_type < gmod.type_table.len():
                match gmod.type_table.get(pec.err_type).unwrap():
                    case GtPtr(_):
                        res_err_borrow = true
                    case GtMutPtr(_):
                        res_err_borrow = true
                    case GtNamed(err_ref_name):
                        if err_ref_name.starts_with("Ref__"):
                            res_err_borrow = true
                    else:
                        pass
            if ok_name != "":
                Vector[StructField] rfields = []
                rfields.push(StructField("tag", LT_I32))
                rfields.push(StructField("Ok_0", ok_ty))
                rfields.push(StructField("Error_0", err_ty))
                # Phase A: register for typed dispatch before pname moves into LirStructDef.
                m.type_runtime_map.put(pname.clone(), "Result")
                # Generate drop/clone for a mono'd Result[Ok,Err] with a
                # resource payload — same rationale as Option above. Ok is
                # variant 0 (Ok_0), Error is variant 1 (Error_0); register a
                # variant-drop for whichever payload(s) are resources.
                String res_ok_drop = ""
                if not res_ok_borrow:
                    res_ok_drop = drop_fn_for_type(ok_name, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                String res_err_drop = ""
                if not res_err_borrow:
                    res_err_drop = drop_fn_for_type(err_name, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                if res_ok_drop != "" or res_err_drop != "":
                    Vector[EnumVariantDrop] res_vd = []
                    Vector[EnumVariantDrop] res_vd2 = []
                    if res_ok_drop != "":
                        res_vd.push(EnumVariantDrop(0, "Ok", "Ok_0", res_ok_drop.clone(), ok_name.clone()))
                        res_vd2.push(EnumVariantDrop(0, "Ok", "Ok_0", res_ok_drop, ok_name.clone()))
                    if res_err_drop != "":
                        res_vd.push(EnumVariantDrop(1, "Error", "Error_0", res_err_drop.clone(), err_name.clone()))
                        res_vd2.push(EnumVariantDrop(1, "Error", "Error_0", res_err_drop, err_name.clone()))
                    m.recursive_drop_enums.put(pname.clone(), res_vd)
                    Vector[FieldDrop] res_nofd = []
                    m.type_drop_fns.put(pname.clone(), TypeDropInfo(pname + "__drop", res_nofd, "", res_vd2))
                LirStructDef res_sdef = LirStructDef(pname, rfields, 2, false, -1, -1, false)
                m.structs.set(psi, res_sdef)
        psi += 1

    # Pass 4: Fixpoint re-computation of `computed_c_size` for every
    # struct/enum. Pass 2 computes sizes eagerly while processing each
    # type, but the iteration order over `ti_keys` can visit an enum
    # BEFORE the struct it wraps in a variant payload — the wrapped
    # type's fields are still empty placeholders, so `lir_type_byte_size_in_mod`
    # falls back to 8, and the enum's `max_variant_size` underestimates.
    # Iterating until no size changes converges in O(depth-of-type-graph)
    # passes. Concrete bug this fixes: self-host's `Item` enum is
    # wrapped in `Vector[Item]` by `parse_module`; initial Pass 2 saw
    # `FunctionDef` (Item's biggest variant, 560 bytes) as 8 bytes and
    # computed Item's size as 16 instead of 568 — `gorget_array_new(16)`
    # then truncated every parsed top-level item to the first 16 bytes,
    # losing function names, body refs, etc.
    bool changed = true
    int guard_iters = 0
    while changed and guard_iters < 8:
        changed = false
        int rsi = 0
        while rsi < m.structs.len():
            LirStructDef rsdef = m.structs.get(rsi).unwrap()
            if rsdef.fields.len() == 0:
                rsi += 1
                continue
            # Skip builtin runtime structs — `register_builtin_structs`
            # set their `computed_c_size` to match C's actual layout,
            # which includes runtime-only fields (alloc, elem_drop,
            # elem_clone, …) that aren't in the self-host's LirStructDef
            # field list. Recomputing from the 4 visible fields would
            # OVERWRITE 64 bytes with 32 for GorgetArray, etc.
            if is_builtin_runtime_struct(rsdef.name):
                rsi += 1
                continue
            int new_size = 0
            int struct_align_rs = struct_alignof_from_fields(rsdef.fields, &m)
            if rsdef.is_union_layout and rsdef.enum_kind > 0:
                # Union-layout enum: tag + pad to alignof + max variant.
                # Variant grouping by `VariantName_N` field-name prefix.
                # Each variant's payload is computed with inter-field
                # alignment padding (same rule as flat structs).
                int max_v = 0
                int cur_v = 0
                String cur_pfx = ""
                int rfi = 1
                while rfi < rsdef.fields.len():
                    StructField rsf = rsdef.fields.get(rfi).unwrap()
                    int last_us = rsf.name.len() - 1
                    while last_us > 0:
                        String rch = rsf.name.slice(last_us, last_us + 1)
                        if rch == "_":
                            break
                        last_us -= 1
                    String pfx = rsf.name.slice(0, last_us)
                    int field_sz = lir_type_byte_size_in_mod(rsf.ty, &m, 0)
                    int field_al = alignof_lir_type(rsf.ty, &m, 0)
                    if pfx != cur_pfx:
                        if cur_v > max_v:
                            max_v = cur_v
                        cur_v = 0
                        cur_pfx = pfx
                    cur_v = round_up_to(cur_v, field_al)
                    cur_v = cur_v + field_sz
                    rfi += 1
                if cur_v > max_v:
                    max_v = cur_v
                int padded_max = round_up_to(max_v, struct_align_rs)
                int tag_pad = round_up_to(4, struct_align_rs)
                new_size = tag_pad + padded_max
            else:
                # Flat layout: walk fields, aligning each to its natural
                # boundary before adding its size (mirrors C's struct layout
                # rules — field_i starts at offset round_up(prev_end,
                # alignof(field_i))), then pad total to struct alignof.
                #
                # Previously this summed sizes without inter-field padding,
                # producing a smaller size than C's sizeof. For
                # `DefInfo { Str(32) DefKind(4) Span(16) int64 int64 bool bool }`
                # the naive sum gives 70 → round_up(70, 8) = 72; C gives 80
                # because it pads the 4-byte DefKind to 8 before Span. When
                # the self-host used 72 as `Vector[DefInfo].elem_size` and
                # C's sizeof gave 80, every push wrote 80 bytes at a 72-byte
                # stride — corrupting adjacent elements. Surfaced as a heap
                # overflow in `ScopeTable__set_def_param` during stage-1's
                # own run on the self-host driver.
                int offset = 0
                for rsf2 in rsdef.fields:
                    int fa2 = alignof_lir_type(rsf2.ty, &m, 0)
                    offset = round_up_to(offset, fa2)
                    offset = offset + lir_type_byte_size_in_mod(rsf2.ty, &m, 0)
                new_size = round_up_to(offset, struct_align_rs)
            if new_size == 0:
                new_size = 8
            if new_size != rsdef.computed_c_size:
                changed = true
                LirStructDef updated = LirStructDef(rsdef.name, rsdef.fields, rsdef.enum_kind, rsdef.is_union_layout, new_size, rsdef.computed_c_align, rsdef.is_trait_box)
                m.structs.set(rsi, updated)
            rsi += 1
        guard_iters += 1

# ── Runtime function name mapping ───────────────────────────

String map_runtime_name(String name, LirModule &m, GirModule &gmod):
    # Generic-extern binding propagation: lower.gg propagates mangled→c_symbol for
    # instances of generic extern fns (e.g. `__set_iter_order_len__int64_t →
    # gorget_map_iter_order_len`), mirroring Rust's extern_bindings pass.
    # Only use entries that resolve to a C runtime symbol (starts with `gorget_`
    # or `__gorget_`) — not Gorget-to-Gorget module redirects (those are resolved
    # by lower.gg's fn-template lookup before lir_lower runs).
    if gmod.call_redirects.contains(name):
        String ext_redir = gmod.call_redirects.get(name).unwrap_or("")
        if ext_redir.starts_with("gorget_") or ext_redir.starts_with("__gorget_"):
            return ext_redir
    # Hardcoded aliases for extern-method stubs whose method name carries
    # the File/stream receiver type (lost to `int64_t__` fallback when the
    # self-host type inference can't keep the receiver as a named type).
    # These correspond to `equip File: extern ...` declarations in std.io.
    if name == "int64_t___write_bytes_buf" or name == "File___write_bytes_buf":
        return "gorget_file_write_bytes_buf"
    if name == "int64_t___read_bytes_buf" or name == "File___read_bytes_buf":
        return "gorget_file_read_bytes_buf"
    if name == "int64_t___flush_buffer" or name == "File___flush_buffer":
        return "gorget_file_flush"
    if name == "int64_t__close" or name == "File__close":
        return "gorget_file_close"
    if name == "_file_open_try":
        return "gorget_file_open_try"
    # Trait-method dispatch: File__write / File__read resolves to the
    # equip-block specialization emitted with a `Writer_for_` / `Reader_for_`
    # prefix.
    if name == "File__write":
        return "Writer_for_File__write"
    if name == "File__read":
        return "Reader_for_File__read"
    if name == "_parse_int_raw":
        return "gorget_parse_int"
    if name == "_parse_float_raw":
        return "gorget_parse_float"
    if name == "_parse_last_error":
        return "gorget_parse_last_error"
    if name == "_stdin_handle":
        return "gorget_stdin_handle"
    if name == "_stdout_handle":
        return "gorget_stdout_handle"
    if name == "_stderr_handle":
        return "gorget_stderr_handle"
    if name == "file_exists":
        return "gorget_file_exists"
    if name == "chr":
        return "gorget_char_chr"
    if name == "min":
        return "gorget_min"
    if name == "max":
        return "gorget_max"
    if name == "abs":
        return "gorget_abs"
    if name == "sqrt":
        return "gorget_sqrt"
    if name == "pow":
        return "gorget_pow"
    if name == "floor":
        return "gorget_floor"
    if name == "ceil":
        return "gorget_ceil"
    if name == "round":
        return "gorget_round"
    if name == "log":
        return "gorget_log"
    if name == "log2":
        return "gorget_log2"
    if name == "log10":
        return "gorget_log10"
    if name == "sin":
        return "gorget_sin"
    if name == "cos":
        return "gorget_cos"
    if name == "tan":
        return "gorget_tan"
    if name == "asin":
        return "gorget_asin"
    if name == "acos":
        return "gorget_acos"
    if name == "atan":
        return "gorget_atan"
    if name == "atan2":
        return "gorget_atan2"
    if name == "__bytes_to_str_raw":
        return "gorget_bytes_to_str"
    # Bare type constructors for opaque pointer types: TaskGroup() → gorget_task_group_new().
    # These have no generic args (pointer typedefs, not generics).
    match name:
        case "TaskGroup":
            return "gorget_task_group_new"
        case "AtomicInt":
            return "gorget_atomic_int_new"
        case "AtomicBool":
            return "gorget_atomic_bool_new"
        case "Barrier":
            return "gorget_barrier_new"
        case "WaitGroup":
            return "gorget_wait_group_new"
        case "OnceFlag":
            return "gorget_once_flag_new"
        case "Semaphore":
            return "gorget_semaphore_new"
        else:
            pass
    # Collection constructors (bare name, no method suffix).
    # Phase A: dispatch on type_runtime_map category + coll_ctor_fn_map.
    if is_collection_constructor(name, m, &gmod):
        String ctor_cat = type_category_for_name(name, m)
        if ctor_cat == "GorgetArray":
            return "gorget_array_new"
        elif ctor_cat == "GorgetMap":
            String ctor_fn = coll_ctor_fn_for_name(name, m)
            if ctor_fn == "":
                ctor_fn = "gorget_map_new"
            if is_string_keyed(name, m):
                return ctor_fn + "_str"
            return ctor_fn
        elif ctor_cat == "GorgetSet":
            String ctor_fn = coll_ctor_fn_for_name(name, m)
            if ctor_fn == "":
                ctor_fn = "gorget_set_new"
            if is_string_keyed(name, m):
                return ctor_fn + "_str"
            return ctor_fn
        elif ctor_cat == "Ptr":
            # Channel/Shared constructors: look up the method prefix in
            # type_method_prefix_map. The map is keyed by the FULL mangled type
            # name (`Channel__int64_t` → `gorget_channel`, written at
            # lir_lower.gg:679 for opaque-pointer types), so check the whole
            # ctor `name` FIRST. The `__`-stem scan below only matched types
            # whose mangling carries a SECOND `__` before the method (e.g.
            # `Mutex__int64_t__new`, where `Mutex__int64_t` happens to be a
            # prefix); a single-`__` ctor like `Channel__int64_t(cap)` left the
            # stem as bare `Channel` (not a map key) and fell through to a bare,
            # undefined `Channel__int64_t(cap, sizeof)`. Args are already
            # `(cap, sizeof)`-correct (mirrors Rust `Channel__T__new(cap)` →
            # `gorget_channel_new(cap, sizeof(elem))`, c_lir/helpers.rs:230).
            if m.type_method_prefix_map.contains(name):
                return m.type_method_prefix_map.get(name).unwrap_or("") + "_new"
            int ci = 0
            while ci < name.len() - 1:
                if name.slice(ci, ci + 2) == "__":
                    String cp = name.slice(0, ci)
                    if m.type_method_prefix_map.contains(cp):
                        return m.type_method_prefix_map.get(cp).unwrap_or("") + "_new"
                ci += 1
        return name

    # Phase A: collection method dispatch via type_runtime_map + coll_ctor_fn_map.
    String coll_cat = type_category_for_name(name, m)
    if coll_cat == "GorgetArray":
        String arr_method = extract_method_name(name)
        # sorted/unique/sort dispatch to typed stubs keyed by element type so
        # qsort uses the right comparator (mirrors Rust gg
        # `map_monomorphized_to_runtime`, src/lir/lower/calls.rs:318).
        if arr_method == "sorted" or arr_method == "unique" or arr_method == "sort":
            String elem = array_elem_for_sort(name, arr_method)
            String suffix = "generic"
            if elem != "":
                suffix = cmp_suffix_for_elem(elem)
            return "gorget_array_" + arr_method + "_" + suffix
        # reversed: clone + reverse, one stub for all element types.
        if arr_method == "reversed":
            return "gorget_array_reversed"
        return map_array_method(arr_method)
    if coll_cat == "GorgetMap":
        String method = extract_method_name(name)
        if method == "new":
            String ctor_fn = coll_ctor_fn_for_name(name, m)
            if ctor_fn == "":
                ctor_fn = "gorget_map_new"
            if is_string_keyed(name, m):
                return ctor_fn + "_str"
            return ctor_fn
        # `d.get_or(k, default)` → the generated `Dict__K__V__get_or(map, key,
        # default)` inline wrapper (emitted by emit_dict_get_or_wrappers).
        # There is no `gorget_map_get_or` runtime symbol — keep the mangled
        # name unmapped so it dispatches to the wrapper. Mirrors the Box
        # get/set inline-wrapper routing above.
        #
        # Resolve-once / write-through (Layering rule 4): this arm is the TYPED
        # classification site — `coll_cat == "GorgetMap"` (via type_runtime_map)
        # and `method == "get_or"` already proved "this call is a Dict/HashMap
        # get_or". RECORD a wrapper REQUEST here, reading K/V from the TYPED
        # coll_key/val_type_map (no name parse), so emit_dict_get_or_wrappers
        # never re-derives meaning from the mangled Dict/HashMap symbol prefix.
        if method == "get_or" or method == "get_or_put":
            String dgor_key = coll_key_type_for_name(name, m)
            String dgor_val = coll_val_type_for_name(name, m)
            bool dgor_is_put = method == "get_or_put"
            bool dgor_seen = false
            for dgor_r in m.dict_get_or_requests:
                if dgor_r.mangled_name == name:
                    dgor_seen = true
            if not dgor_seen:
                m.dict_get_or_requests.push(DictGetOrReq(name.clone(), dgor_key.clone(), dgor_val.clone(), dgor_is_put))
            return name
        return map_dict_method(method)
    if coll_cat == "GorgetSet":
        String method = extract_method_name(name)
        if method == "new":
            String ctor_fn = coll_ctor_fn_for_name(name, m)
            if ctor_fn == "":
                ctor_fn = "gorget_set_new"
            if is_string_keyed(name, m):
                return ctor_fn + "_str"
            return ctor_fn
        return map_set_method(method)

    # String methods — Phase A: dispatch via type_runtime_map "GorgetString" category.
    if type_category_for_name(name, m) == "GorgetString":
        String method = extract_method_name(name)
        match method:
            case "push":
                # `String.push(Str chunk)` → `gorget_string_push_char(
                # GorgetString*, Str)`. The old spelling `gorget_string_push`
                # has NO definition (only `_char`/`_byte`/`_int`/… variants),
                # and `gorget_str_push` is a Rust-emitted thin wrapper that
                # lives in the per-MODULE C section (NOT the shared runtime
                # preamble the bootstrap concatenates), so it link-fails when
                # the self-host body calls it. `gorget_string_push_char` IS in
                # the core preamble and has the exact `(GorgetString*, Str)`
                # ABI. Surfaced once io.gg's `equip String with Writer:`
                # (`self.push(chunk)`) became reachable via the FIDELITY
                # vtable globals.
                return "gorget_string_push_char"
            case "len":
                return "gorget_str_codepoint_count"
            case "byte_len":
                return "gorget_str_byte_len"
            case "clone":
                return "gorget_string_clone_to_owned"
            case "free":
                return "gorget_string_free"
            case "substring":
                return "gorget_str_slice"
            case "debug":
                # Debuggable.debug is defined in the runtime as
                # `gorget_string_debug`, not `gorget_str_debug`. Without
                # this special case the fallback emitted the wrong name and
                # stage-1 failed to link.
                return "gorget_string_debug"
            case "concat":
                return "gorget_string_concat"
            case "eq":
                return "gorget_string_eq"
            case "format":
                return "gorget_string_format"
            else:
                # Concat-guard (Core #2 / devbook/18:289-301): an EMPTY method
                # must never emit a bare `gorget_str_` (an undefined ref). Rust
                # returns None here via `name.strip_prefix("GorgetString__")?`
                # (calls.rs:396) — the `?` is the guard the concat lacks. An
                # empty method reaching this point means an upstream caller (a
                # ctor like `String()` that the GIR failed to type, lost a `__`
                # separator) — a layering bug to surface loudly, NOT paper over
                # with a silently-undefined symbol. A real `String.<method>`
                # (push/len/clone/…) is handled by the cases above and is
                # unaffected.
                if method == "":
                    panic("map_runtime_name: GorgetString-category name `" + name + "` has no method (would emit a bare `gorget_str_` undefined ref). The ctor/route that produced this name must type its result and carry a `__`-separated method — see lir_lower.gg concat-guard + lower_expr.gg String() ctor arm.")
                return "gorget_str_" + method

    # Phase A — simple prefix dispatch: scan type_method_prefix_map for the type
    # prefix of the method name. Covers Heap, Mutex, RWLock, Guard, ReadGuard,
    # WriteGuard, Weak, AtomicInt, AtomicBool, Semaphore, Barrier, OnceFlag,
    # WaitGroup, TaskGroup, Channel (all registered at lower_type_defs time).
    # "drop" → "free" is a general alias (runtime uses _free for destruction);
    # Guard "drop" → "gorget_guard_release" is the only exception.
    int pfx_i = 0
    while pfx_i < name.len() - 1:
        if name.slice(pfx_i, pfx_i + 2) == "__":
            String pfx_cand = name.slice(0, pfx_i)
            if m.type_method_prefix_map.contains(pfx_cand):
                String pfx = m.type_method_prefix_map.get(pfx_cand).unwrap_or("")
                if pfx != "":
                    String method = extract_method_name(name)
                    # Guards: drop → <prefix>_release (suffix differs from the
                    # method name) — for ALL THREE guard variants (mutex Guard,
                    # rwlock ReadGuard/WriteGuard), one arm for the class
                    # (Core #4): the runtime spells release, not free, and the
                    # general drop→free alias below would emit an undefined
                    # `gorget_read_guard_free`. Mirrors Rust gg calls.rs:457-472.
                    if (pfx == "gorget_guard" or pfx == "gorget_read_guard" or pfx == "gorget_write_guard") and method == "drop":
                        return pfx + "_release"
                    # Shared: read → get, write → set aliases.
                    if pfx == "gorget_shared":
                        if method == "read":
                            return "gorget_shared_get"
                        if method == "write":
                            return "gorget_shared_set"
                        # EXPLICIT Shared[T] accessors (get/at/set_at/slen/clone).
                        # There is no bare `gorget_shared_<method>` runtime symbol
                        # for these — the `return pfx + "_" + method` fallthrough
                        # below would emit an UNDEFINED symbol (link error). Instead
                        # RECORD a typed per-type wrapper request (mirrors the Box
                        # get/set arm) and `return name` UNCHANGED: `name` already IS
                        # the full mangled `Shared__<T>__<method>` symbol, which
                        # emit_shared_method_wrappers spells. `pfx_cand` is the full
                        # type name (`Shared__int64_t` / `Shared__Vector__int64_t`);
                        # the inner element C type comes from the TYPED
                        # coll_elem_type_map (populated in the registrar step 0).
                        # `clone` is the round-17 refcount-bump fix: the wrapper body
                        # is `return gorget_shared_clone(self)` (atomic strong++),
                        # NOT a byte-copy — the latter under-counts the strong ref
                        # and double-frees / UAFs at teardown. The carrier's
                        # get_ptr/new/drop and the spawn-ctx retain/release symbols
                        # are untouched.
                        if method == "get" or method == "at" or method == "set_at" or method == "slen" or method == "clone":
                            record_shared_wrapper_req(&m, pfx_cand, coll_elem_type_for_name(name, m), method)
                            return name
                    # Weak[T].upgrade(): the C runtime `gorget_weak_upgrade`
                    # returns an `int` success flag (CAS strong 0→1), NOT the
                    # control-block pointer — so the raw symbol can't feed the
                    # nullable-ptr→Option lift. Mirror Rust gg (helpers.rs
                    # emit_weak_wrapper): RECORD a typed per-type wrapper request
                    # and `return name` UNCHANGED so the call target is the
                    # generated `Weak__<T>__upgrade` (which returns `self`-or-NULL,
                    # a real `Shared__<T>` pointer). emit_shared_method_wrappers
                    # (kind == "upgrade") spells its body; the nullable-ptr→Option
                    # lift (is_nullable_ptr_fn dispatch) wraps that pointer. The
                    # inner element is the `Weak__` suffix (6 chars). `clone`/`drop`
                    # on Weak fall through to `gorget_weak_clone`/`_free` below.
                    if pfx == "gorget_weak" and method == "upgrade":
                        record_shared_wrapper_req(&m, pfx_cand, pfx_cand.slice(6, pfx_cand.len()), "upgrade")
                        return name
                    # General alias: drop → free.
                    if method == "drop":
                        method = "free"
                    return pfx + "_" + method
        pfx_i += 1

    # Box methods — Phase A: detect via type_runtime_map "Box" category.
    if type_category_for_name(name, m) == "Box":
        String method = extract_method_name(name)
        match method:
            case "get":
                # `b.get()` → the generated `Box__<inner>__get(self)` inline
                # wrapper (emitted by emit_box_method_wrappers). Mirrors Rust
                # gg, which dispatches to the generated `Box__T__get` function
                # (`src/backend/c_lir/helpers.rs:310`), NOT a runtime symbol —
                # there is no `gorget_box_get` in the C runtime.
                #
                # Resolve-once / write-through (Layering rule 4): this arm is
                # the TYPED classification site — `type_category_for_name ==
                # "Box"` (via type_runtime_map) and `method == "get"` already
                # proved "this is a Box get". RECORD a wrapper REQUEST, reading
                # the inner C type from the TYPED coll_elem_type_map (no name
                # parse), so emit_box_method_wrappers never re-derives meaning
                # from a Box mangled-prefix + `__get`-suffix test on the call name.
                record_box_wrapper_req(&m, coll_elem_type_for_name(name, m), false)
                return name
            case "set":
                # `b.set(v)` → the generated `Box__<inner>__set(self, val)`
                # inline wrapper. Same rationale + write-through as `get`.
                record_box_wrapper_req(&m, coll_elem_type_for_name(name, m), true)
                return name
            case "free" | "drop":
                return "gorget_box_free"
            case "clone":
                return "gorget_box_clone"
            else:
                # Box__TYPE without a real method suffix — `Box__SpannedType`
                # is the bare type constructor, not a method call. Leave the
                # name unmapped so codegen can emit __gorget_box_alloc_TYPE.
                return name

    # Scalar-prefixed methods (self-host GIR uses T__method not Vector__T__method)
    if is_scalar_type_prefix(name):
        String method = extract_method_name(name)
        # Dict-only methods (put/keys/values/items) — lost container prefix means
        # we can't tell Dict from Vector, but these methods only exist on Dict.
        if method == "put" or method == "keys" or method == "values" or method == "items":
            return map_dict_method(method)
        # Shared method name, try Dict first (since get works for both Dict and
        # Vector with a 2-arg ABI via gorget_map_get / gorget_array_safe_get).
        if method == "get" or method == "contains" or method == "remove" or method == "clear" or method == "len":
            String dm = map_dict_method(method)
            if dm != "":
                return dm
        # Skip `new` — different arg counts in scalar-prefix context
        if method != "new":
            String arr = map_array_method(method)
            if arr != "":
                return arr
        # Option/Result methods on scalar-prefixed types
        return map_option_result_method(method)

    # Option/Result method dispatch — Phase A: detect via type_runtime_map + enum_variant_parent.
    # Covers variant-prefixed calls (Some__T__method, None__T__method, Ok__T__method, etc.)
    # and type-prefixed calls (Option__T__method, Result__T__E__method).
    String or_cat = type_category_for_name(name, m)
    if or_cat == "Option":
        String method = extract_method_name(name)
        String opt_res = map_option_result_method(method)
        if opt_res != "":
            return opt_res
        return "__option_" + method
    if or_cat == "Result":
        String method = extract_method_name(name)
        String res_res = map_option_result_method(method)
        if res_res != "":
            # Shared methods (unwrap, map, …) come back with __option_ prefix; convert.
            if res_res.starts_with("__option_"):
                return "__result_" + res_res.slice(9, res_res.len())
            return res_res
        return "__result_" + method

    # Standalone function mappings
    match name:
        case "int_to_str":
            return "gorget_int_to_str"
        case "float_to_str":
            return "gorget_float_to_str"
        case "bool_to_str":
            return "gorget_bool_to_str"
        case "char_to_str":
            return "gorget_char_to_str"
        case "parse_int" | "str_to_int":
            return "gorget_parse_int"
        case "parse_float" | "str_to_float":
            return "gorget_parse_float"
        case "read_file":
            return "gorget_read_file"
        case "read_line":
            return "gorget_read_line"
        case "print_err":
            return "gorget_print_err"
        case "args":
            return "gorget_args"
        case "async_sleep" | "sleep_ms":
            return "gorget_async_sleep"
        case "time_now" | "monotonic_ns":
            return "gorget_monotonic_ns"
        case "time":
            return "gorget_time"
        case "time_ms":
            return "gorget_time_ms"
        case "format_time":
            return "gorget_format_time"
        case "parse_time":
            return "gorget_parse_time"
        else:
            pass

    # No mapping
    return ""

# Map a Vector/Array method name to the runtime function name.
String map_array_method(String method):
    match method:
        case "new":
            return "gorget_array_new"
        case "push":
            return "gorget_array_push"
        case "pop":
            return "gorget_array_safe_pop"
        case "get":
            return "gorget_array_safe_get"
        case "set":
            return "gorget_array_set"
        case "len":
            return "gorget_array_len"
        case "remove":
            return "gorget_array_remove_opt"
        case "insert":
            return "gorget_array_insert"
        case "clone":
            return "gorget_array_clone"
        case "clear":
            return "gorget_array_clear"
        case "extend":
            return "gorget_array_extend"
        case "contains":
            return "gorget_array_contains"
        case "reverse":
            return "gorget_array_reverse"
        case "slice":
            return "gorget_array_slice"
        case "sort":
            return "gorget_array_sort"
        case "binary_search":
            return "gorget_array_binary_search"
        case "last":
            return "gorget_array_last"
        case "first":
            return "gorget_array_first"
        case "is_empty":
            return "gorget_array_is_empty"
        case "capacity":
            return "gorget_array_capacity"
        case "reserve":
            # `Vector[T].reserve(n)` — grow allocation to hold at least n
            # elements. Rust gg emits a direct `gorget_array_reserve(arr, n)`
            # call (src/ir/lowering/exprs/calls.rs:1003). The self-host's
            # mangled `Vector__T__reserve` arrives here and routes to the
            # same mutating runtime symbol; arg 0 (self) is by pointer per
            # `needs_ptr_arg`. Without this arm, link fails with
            # "undefined reference to Vector__T__reserve".
            return "gorget_array_reserve"
        case "swap":
            return "gorget_array_swap"
        case "swap_remove":
            # `Vector[T].swap_remove(i)` — O(1) removal by moving the last
            # element into the hole. Rust gg emits a direct
            # `gorget_array_swap_remove(arr, i)` call (runtime.rs ArraySwapRemove);
            # the self-host's mangled `Vector__T__swap_remove` arrives here and
            # routes to the same runtime symbol. Without this arm, link fails
            # with "undefined reference to Vector__T__swap_remove".
            return "gorget_array_swap_remove"
        case "index_of":
            return "gorget_array_index_of"
        case "fill":
            # `Vector[T].fill(n, val)` — preallocate capacity and fill
            # n slots with `val`. Rust gg emits this as a direct
            # `gorget_array_fill(...)` call; the self-host's mangled
            # form `Vector__bool__fill` arrives here and routes to the
            # same runtime symbol. Without this arm, stage-1 link fails
            # with "undefined reference to Vector__bool__fill" the
            # moment Phase 1's `liveness` bitset helpers exercise it.
            return "gorget_array_fill"
        case "free":
            return "gorget_array_free"
        else:
            return ""

# Map a Dict/Map method name to the runtime function name.
String map_dict_method(String method):
    match method:
        case "put" | "set":
            return "gorget_map_put"
        case "get":
            return "gorget_map_get"
        case "contains" | "has":
            return "gorget_map_contains"
        case "remove":
            # `Dict[K,V].remove(k)` → `Option[V]` (the removed value; None if
            # absent). Routes to `gorget_map_remove_opt`, which returns a
            # pointer to a thread-local copy of the removed value (NULL when
            # absent) and transfers value-ownership to the caller — mirrors
            # Rust gg (`calls.rs:356`, `builtins.rs:387` ret_option_val). The
            # bool-returning `gorget_map_remove` is NOT used: it cannot back an
            # `Option[V]` binding (`d.remove(k).unwrap()` → garbage).
            return "gorget_map_remove_opt"
        case "len":
            return "gorget_map_len"
        case "keys":
            return "gorget_map_keys"
        case "values":
            return "gorget_map_values"
        case "clone":
            return "gorget_map_clone"
        case "clear":
            return "gorget_map_clear"
        case "is_empty":
            return "gorget_map_is_empty"
        case "items":
            return "gorget_map_items"
        case "update":
            return "gorget_map_update"
        else:
            return ""

# Map a Set method name to the runtime function name.
String map_set_method(String method):
    match method:
        case "add" | "insert":
            return "gorget_set_add"
        case "contains" | "has":
            return "gorget_set_contains"
        case "remove":
            return "gorget_set_remove"
        case "len":
            return "gorget_set_len"
        case "clone":
            return "gorget_set_clone"
        case "clear":
            return "gorget_set_clear"
        case "is_empty":
            return "gorget_set_is_empty"
        case "union":
            return "gorget_set_union"
        case "intersection":
            return "gorget_set_intersection"
        case "difference":
            return "gorget_set_difference"
        case "symmetric_difference":
            return "gorget_set_symmetric_difference"
        case "is_subset":
            return "gorget_set_is_subset"
        case "is_superset":
            return "gorget_set_is_superset"
        case "is_disjoint":
            return "gorget_set_is_disjoint"
        else:
            return ""

# Map an Option/Result method name to its combinator function.
# SH-2: `flat_map` is in the table (≡ and_then template arm) so production is
# one source of truth; without it the `"__option_" + method` fallback still
# mangles the name but the emit match had no arm → link-fail.
String map_option_result_method(String method):
    match method:
        case "is_none" | "is_some":
            return "__option_" + method
        case "unwrap" | "expect":
            return "__option_" + method
        case "map" | "filter" | "and_then" | "flat_map" | "or_else" | "or" | "flatten" | "unwrap_or_else":
            return "__option_" + method
        case "is_ok":
            return "__result_is_ok"
        case "is_error" | "is_err":
            return "__result_is_error"
        case "unwrap_error" | "unwrap_err":
            return "__result_unwrap_error"
        else:
            return ""

# Phase A — find the type_runtime_map category for a method name (or bare type name).
# Scans __ split points from left to right to find the first registered type prefix.
# Also checks enum_variant_parent to handle variant-prefixed names like Some__T__method.
# Returns "" if no registered type prefix is found.
# Examples: "Vector__int64_t__push" → "GorgetArray"
#           "Box__Foo__clone" → "Box"
#           "Guard__Mutex__int__deref" → "Guard"
#           "Some__int64_t__unwrap" → "Option"  (via enum_variant_parent)
#           "Option__int64_t__map" → "Option"
#           "unknown_fn" → ""
String type_category_for_name(String name, LirModule m):
    if m.type_runtime_map.contains(name):
        return m.type_runtime_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.type_runtime_map.contains(prefix):
                return m.type_runtime_map.get(prefix).unwrap_or("")
            # Phase A — variant name → parent type lookup for Option/Result.
            # enum_variant_parent maps e.g. "Some__int64_t" → "Option__int64_t".
            if m.enum_variant_parent.contains(prefix):
                String par = m.enum_variant_parent.get(prefix).unwrap_or("")
                if m.type_runtime_map.contains(par):
                    return m.type_runtime_map.get(par).unwrap_or("")
        i += 1
    return ""

String coll_elem_type_for_name(String name, LirModule m):
    if m.coll_elem_type_map.contains(name):
        return m.coll_elem_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_elem_type_map.contains(prefix):
                return m.coll_elem_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String coll_key_type_for_name(String name, LirModule m):
    if m.coll_key_type_map.contains(name):
        return m.coll_key_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_key_type_map.contains(prefix):
                return m.coll_key_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String coll_val_type_for_name(String name, LirModule m):
    if m.coll_val_type_map.contains(name):
        return m.coll_val_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_val_type_map.contains(prefix):
                return m.coll_val_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

# Record a `b.get()`/`b.set(v)` inline-wrapper REQUEST onto the typed
# box_wrapper_requests registry, deduped by (inner_c, is_set). Called from
# the typed Box get/set classification arm in map_runtime_name; the codegen
# drain (emit_box_method_wrappers) emits one wrapper per recorded request.
# A blank `inner_c` (coll_elem_type_for_name miss) is skipped — the legacy
# scan likewise emitted nothing for a zero-length inner.
void record_box_wrapper_req(LirModule &m, String inner_c, bool is_set):
    if inner_c == "":
        return
    for r in m.box_wrapper_requests:
        if r.inner_c == inner_c and r.is_set == is_set:
            return
    m.box_wrapper_requests.push(BoxWrapperReq(inner_c.clone(), is_set))

# True iff `Box__<inner>` is a TRAIT box (the inner names a trait with an
# emitted vtable) rather than a value box (the inner names a concrete
# struct/primitive). The discriminator is TYPED, not name-shaped: the
# `_VTable` struct-typedef pre-pass (lower.gg:4034) registered a
# `<inner>_VTable` GirTypeInfo for exactly the non-generic, non-derive
# user traits with ≥1 instance method — so `<inner>_VTable ∈ type_infos`
# is the trait-box signal. A concrete value box (`Box__Expr`) has no
# `Expr_VTable`, so this returns false and the value-box path (fat=false)
# is preserved. Mirrors Rust gg's `try_trait_object_construct` gate on
# `<Trait>_VTable` existing (`src/lir/lower/operands.rs:799`).
bool box_inner_is_trait(String inner, GirModule gmod):
    if inner == "":
        return false
    return gmod.type_infos.contains(inner + "_VTable")

# Record a `Box__<Trait>__<method>` trait-object dispatch-thunk REQUEST onto
# the typed trait_dispatch_requests registry, deduped by (trait, method). The
# call `Box__Greeter__greet(self)` is emitted UNCHANGED by the generic
# call path (the fat trait-box struct is passed by value as `self`); this
# only ensures the thunk that DEFINES that symbol gets emitted at codegen.
# Gated on the `<Trait>_VTable` registered-type discriminator (the trait-box
# signal), NOT a name-shape guess. `func_name` is the mangled callee; a
# non-`Box__` name, a name whose middle isn't a registered trait, or a name
# with no `__`-separated method, is silently a no-op. Returns true iff a
# request was recorded (so the caller knows a thunk will define this symbol).
bool try_record_trait_dispatch(String func_name, int dst_local, LirModule &m, GirModule &gmod, Dict[String, int] &sr):
    if not func_name.starts_with("Box__"):
        return false
    # Parse trait = between `Box__` and the LAST `__`; method = after it.
    String td_rest = func_name.slice(5, func_name.len())
    # Find the last `__` in td_rest.
    int td_sep = -1
    int td_i = 0
    while td_i + 1 < td_rest.byte_len():
        if td_rest.byte_at(td_i) == 0x5F and td_rest.byte_at(td_i + 1) == 0x5F:
            td_sep = td_i
        td_i += 1
    if td_sep < 0:
        return false
    String td_trait = td_rest.slice(0, td_sep)
    String td_method = td_rest.slice(td_sep + 2, td_rest.len())
    # Trait-box discriminator: `<Trait>_VTable` must be a registered type.
    if not gmod.type_infos.contains(td_trait + "_VTable"):
        return false
    # Slot index from the typed method→slot channel.
    int td_slot = gmod.trait_method_slot.get(td_trait + "__" + td_method).unwrap_or(-1)
    if td_slot < 0:
        return false
    # Dedup by (trait, method).
    for tdr in m.trait_dispatch_requests:
        if tdr.trait_name == td_trait and tdr.method == td_method:
            return true
    # Return type: the trait method's REAL LIR return type, read off the
    # `Box__<Trait>__<method>` fn_sig the `_VTable` pre-pass registered from
    # the trait method decl's `return_type` (lower.gg ~:4062 — the single
    # source of truth, the self-host analogue of Rust reading `fn_ret` from
    # the VTable FnPtr field, `insts.rs:2550`). Absent (defensive: a call
    # whose trait wasn't pre-pass-registered) → LT_VOID, matching the old
    # discard-and-return-nothing behaviour. A void method registers UNIT_TYPE
    # → LT_VOID → the call site already emits NO dst (`ret_tid == UNIT_TYPE`,
    # lower_expr.gg:3893) so `dst_local < 0` and `ret_lir_ty == LT_VOID` agree.
    int td_ret_lir = LT_VOID
    if gmod.fn_sigs.contains(func_name):
        td_ret_lir = map_gir_type(gmod.fn_sigs.get(func_name).unwrap(), &gmod, &sr)
    bool td_void = td_ret_lir == LT_VOID
    # User param LIR types for the thunk signature + fn-ptr cast (increment 3).
    # Read off the SAME `fn_param_sigs["Box__<Trait>__<method>"]` the `_VTable`
    # pre-pass registered from the trait method decl (lower.gg — single source
    # of truth, the param sibling of the `fn_sigs` return-type channel above).
    # Index 0 is the `void* self` receiver (emitted implicitly by the thunk), so
    # skip it; indices 1.. are the user params, each already ABI-wrapped
    # (aggregate → GtPtr, `&`/`!` → GtMutPtr). `map_gir_type` lowers each to its
    # LIR type — a Ptr wrapper → LT_PTR (`void*`), a scalar → its scalar LIR type
    # — so the thunk forwards each arg with the PRECISE type the vtable-slot impl
    # fn declares. A miss (defensive: the pre-pass didn't register this symbol)
    # leaves `td_ptys` empty → the void/no-param keystone shape, unchanged.
    Vector[int] td_ptys = []
    if gmod.fn_param_sigs.contains(func_name):
        Vector[int] td_psig = gmod.fn_param_sigs.get(func_name).unwrap()
        int td_pi = 1
        while td_pi < td_psig.len():
            td_ptys.push(map_gir_type(td_psig.get(td_pi).unwrap(), &gmod, &sr))
            td_pi += 1
    m.trait_dispatch_requests.push(TraitDispatchReq(td_trait.clone(), td_method.clone(), td_slot, td_void, !td_ptys, td_ret_lir))
    return true

# Record an EXPLICIT Shared[T] accessor inline-wrapper REQUEST onto the typed
# shared_wrapper_requests registry, deduped by (type_name, kind). Called from
# the typed `gorget_shared` get/at/set_at/slen arm in map_runtime_name; the
# codegen drain (emit_shared_method_wrappers) emits one wrapper per request.
# `type_name` is the full Shared wrapper type (`Shared__int64_t` /
# `Shared__Vector__int64_t`); `inner_c` is the resolved element from the typed
# coll_elem_type_map. A blank `inner_c` (coll_elem_type_for_name miss) is skipped
# — the bare-symbol fallthrough likewise produced nothing usable (the request
# carries the elem so the wrapper body never re-derives it from the name).
void record_shared_wrapper_req(LirModule &m, String type_name, String inner_c, String kind):
    if inner_c == "":
        return
    for r in m.shared_wrapper_requests:
        if r.type_name == type_name and r.kind == kind:
            return
    m.shared_wrapper_requests.push(SharedWrapperReq(type_name.clone(), inner_c.clone(), kind.clone()))

# Return the base constructor fn name for Dict/HashMap/Set/HashSet.
# "Dict__K__V" → "gorget_dict_new", "HashMap__K__V" → "gorget_map_new",
# "Set__T" → "gorget_ordered_set_new", "HashSet__T" → "gorget_set_new".
String coll_ctor_fn_for_name(String name, LirModule m):
    if m.coll_ctor_fn_map.contains(name):
        return m.coll_ctor_fn_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_ctor_fn_map.contains(prefix):
                return m.coll_ctor_fn_map.get(prefix).unwrap_or("")
        i += 1
    return ""

# Check if a name is a bare collection constructor (no method suffix).
# E.g., "Vector__int64_t" is a constructor, "Vector__int64_t__push" is a method.
# Phase A — uses type_runtime_map: registered types are constructors, unregistered
# names with collection prefixes could be method calls.
bool is_collection_constructor(String name, LirModule m, GirModule &gmod):
    # Fast path: registered collection types (GorgetArray/Map/Set) only.
    # Box, Guard, Task, Ptr, Option, Result, GorgetString are also in
    # type_runtime_map but are NOT collection constructors — only the three
    # collection categories qualify here. "Ptr" (opaque types: Mutex, Channel,
    # Shared, etc.) fall through to the method-suffix check below.
    if m.type_runtime_map.contains(name):
        String cat = m.type_runtime_map.get(name).unwrap_or("")
        if cat == "GorgetArray" or cat == "GorgetMap" or cat == "GorgetSet":
            return true
        if cat != "Ptr":
            return false
    # Slow path: unregistered name or Ptr-category — check prefix + method-suffix.
    # Handles types that haven't been seen as type declarations yet.
    # collection_runtime_type is the source-of-truth for prefix matching.
    if collection_runtime_type(name, &gmod) == "" and not is_opaque_pointer_type(name, &gmod):
        return false
    String method = extract_method_name(name)
    if method == "int64_t" or method == "double" or method == "bool" or method == "int32_t":
        return true
    if method == "int16_t" or method == "int8_t" or method == "uint64_t" or method == "uint32_t":
        return true
    if method == "uint16_t" or method == "uint8_t" or method == "byte" or method == "float":
        return true
    if method == "GorgetString" or method == "Str":
        return true
    if method.len() > 0:
        String first = method.slice(0, 1)
        if first >= "A" and first <= "Z":
            return true
    return false

# Byte size of an LIR scalar / pointer type. For scalar/pointer types
# the answer is fixed; for inline struct fields we consult m.structs and
# recurse — otherwise a Vector[SpannedToken] whose element contains a
# union-layout Token enum gets allocated at 24 bytes instead of 60+
# and pushes stomp adjacent memory. A small depth cap guards against
# accidental self-reference in recursive types.
# Alignment of a LIR type in bytes. Used when computing struct size so
# we pad the total up to the struct's alignof, matching C's rule.
# Hardcoded padding to 8 over-estimated size for structs whose largest
# field is smaller than 8 bytes (e.g. `struct Keyword { int32_t tag }`,
# C sizeof = 4 not 8). That caused `Option[Keyword]` to compute 16 bytes
# while C laid it out as 8, and `return Some(KwXxx)` copied 16 bytes of
# return value into an 8-byte slot — overwriting the caller's stack.
int alignof_lir_type(int ty, LirModule &m, int depth):
    if ty == LT_I8 or ty == LT_U8 or ty == LT_BOOL:
        return 1
    if ty == LT_I16 or ty == LT_U16:
        return 2
    if ty == LT_I32 or ty == LT_U32 or ty == LT_F32:
        return 4
    if ty == LT_I64 or ty == LT_U64 or ty == LT_F64 or ty == LT_PTR:
        return 8
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return 8
    if ty >= LT_STRUCT_BASE:
        int sid = ty - LT_STRUCT_BASE
        if sid < m.structs.len() and depth < 4:
            LirStructDef sdef = m.structs.get(sid).unwrap()
            int max_align = 1
            for sfa in sdef.fields:
                int fa = alignof_lir_type(sfa.ty, &m, depth + 1)
                if fa > max_align:
                    max_align = fa
            return max_align
    return 8

# Compute the struct's alignment from its flat field list (union or flat
# layout doesn't matter for alignof: both are max field alignment).
int struct_alignof_from_fields(Vector[StructField] fields, LirModule &m):
    int max_align = 1
    for sf in fields:
        int fa = alignof_lir_type(sf.ty, &m, 0)
        if fa > max_align:
            max_align = fa
    return max_align

int round_up_to(int n, int align):
    if align <= 1:
        return n
    int rem = n % align
    if rem == 0:
        return n
    return n + (align - rem)

int lir_type_byte_size_in_mod(int ty, LirModule &m, int depth):
    if ty == LT_I8 or ty == LT_U8 or ty == LT_BOOL:
        return 1
    if ty == LT_I16 or ty == LT_U16:
        return 2
    if ty == LT_I32 or ty == LT_U32 or ty == LT_F32:
        return 4
    if ty == LT_I64 or ty == LT_U64 or ty == LT_F64:
        return 8
    if ty == LT_PTR:
        return 8
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return 8
    if ty >= LT_STRUCT_BASE:
        int sid = ty - LT_STRUCT_BASE
        if sid < m.structs.len() and depth < 4:
            LirStructDef sdef = m.structs.get(sid).unwrap()
            if sdef.computed_c_size > 0:
                return sdef.computed_c_size
            # Union-layout enums get tag (4) + pad + max variant payload.
            # Flat layout (regular struct or small enum) gets sum of all
            # field sizes, aligned to 8. Previously always summed; that
            # overcounted union enums by ~Nx and routed 12376-byte
            # allocations to 568-byte Item elements.
            int align_fb = struct_alignof_from_fields(sdef.fields, &m)
            if sdef.is_union_layout and sdef.enum_kind > 0:
                int max_v_bytes = 0
                int cur_v_bytes = 0
                String cur_prefix = ""
                int fi_u = 1
                while fi_u < sdef.fields.len():
                    StructField sf_u = sdef.fields.get(fi_u).unwrap()
                    int under_pos = sf_u.name.len() - 1
                    while under_pos > 0:
                        String ch_u = sf_u.name.slice(under_pos, under_pos + 1)
                        if ch_u == "_":
                            break
                        under_pos -= 1
                    String name_prefix = sf_u.name.slice(0, under_pos)
                    if name_prefix != cur_prefix:
                        if cur_v_bytes > max_v_bytes:
                            max_v_bytes = cur_v_bytes
                        cur_v_bytes = 0
                        cur_prefix = name_prefix
                    cur_v_bytes = cur_v_bytes + lir_type_byte_size_in_mod(sf_u.ty, &m, depth + 1)
                    fi_u += 1
                if cur_v_bytes > max_v_bytes:
                    max_v_bytes = cur_v_bytes
                int padded_max_fb = round_up_to(max_v_bytes, align_fb)
                int tag_pad_fb = round_up_to(4, align_fb)
                int u_total = tag_pad_fb + padded_max_fb
                if u_total == 0:
                    return 8
                return u_total
            int total = 0
            for sff in sdef.fields:
                total = total + lir_type_byte_size_in_mod(sff.ty, &m, depth + 1)
            if total == 0:
                return 8
            return round_up_to(total, align_fb)
    return 8

# Get the element size for a type name. Uses m.structs when available to
# sum actual field sizes for user structs; falls back to pointer size when
# the struct can't be resolved.
int type_elem_size_in_mod(String elem, Dict[String, int] sr, LirModule &m):
    if elem == "int64_t" or elem == "double":
        return 8
    elif elem == "int32_t" or elem == "float":
        return 4
    elif elem == "int16_t" or elem == "uint16_t":
        return 2
    elif elem == "int8_t" or elem == "uint8_t" or elem == "bool" or elem == "byte":
        return 1
    elif elem == "GorgetString" or elem == "Str":
        return 32
    int sid = sr.get(elem).unwrap_or(-1)
    if sid >= 0 and sid < m.structs.len():
        LirStructDef sdef = m.structs.get(sid).unwrap()
        # Pre-computed size (set during type lowering for known runtime
        # structs like GorgetString/GorgetArray) takes precedence.
        if sdef.computed_c_size > 0:
            return sdef.computed_c_size
        # Sum field sizes, recursing into struct-typed fields via the
        # module-aware byte-size helper so SpannedToken et al. with
        # nested union-layout Token payloads get the real size rather
        # than the 8-byte pointer-size fallback.
        int total = 0
        for sff in sdef.fields:
            total = total + lir_type_byte_size_in_mod(sff.ty, &m, 0)
        if total == 0:
            return 8
        # Round up to 8-byte boundary for C struct alignment.
        int rem = total % 8
        if rem != 0:
            total = total + (8 - rem)
        return total
    return 8

# Get element size for a collection constructor using LirModule metadata.
int collection_elem_size_in_mod(String name, Dict[String, int] sr, LirModule &m):
    String cat = type_category_for_name(name, m)
    if cat == "GorgetMap" or cat == "Ptr":
        # EXPLICIT Shared[T] ctor (`Shared__int64_t` / `Shared__Vector__int64_t`
        # / `Shared__Config`): `gorget_shared_new(size, &val)` copies `size` bytes
        # of the BOXED VALUE T into the shared control block — `size` must be
        # `sizeof(T)`, NOT a bare 8. The Ptr→8 default truncated a `Shared[Config]`
        # (16B→8B garbage) and a `Shared[Vector[T]]` (GorgetArray→8B garbage, so
        # `.slen()`/`.at()` saw len 0). Resolve the boxed element via the TYPED
        # coll_elem_type_map (populated for Shared in the lower_type_defs registrar)
        # and size it like a collection element. Mirrors Rust's
        # `Shared__T__new` wrapper: `gorget_shared_new(sizeof(T), &val)`
        # (src/backend/c_lir/helpers.rs:248). Gated on the RESOLVED method-prefix
        # (`gorget_shared`), NOT a name-match. The Shared__Mutex carrier never
        # reaches here (its `__new` ctor is NOT is_collection_constructor → the
        # concurrency_elem_size path handles its 8-byte mutex-pointer size).
        if cat == "Ptr" and m.type_method_prefix_map.get(name).unwrap_or("") == "gorget_shared":
            String shared_elem = coll_elem_type_for_name(name, m)
            if shared_elem != "":
                return type_elem_size_in_mod(shared_elem, sr, &m)
        return 8
    String elem = coll_elem_type_for_name(name, m)
    return type_elem_size_in_mod(elem, sr, &m)

# Check if dict/set has string keys (uses typed coll_elem/key_type_map).
bool is_string_keyed(String name, LirModule m):
    String cat = type_category_for_name(name, m)
    if cat == "GorgetMap":
        String key = coll_key_type_for_name(name, m)
        return key == "GorgetString" or key == "Str"
    if cat == "GorgetSet":
        String elem = coll_elem_type_for_name(name, m)
        return elem == "GorgetString" or elem == "Str"
    return false

# Check if a specific arg index of a runtime function needs pointer passing.
bool needs_ptr_arg(String fn_name, int arg_idx):
    # Callable/closure dispatch: arg 0 (the callable) must be a pointer (void**)
    if arg_idx == 0 and (fn_name.starts_with("__callable_") or fn_name.starts_with("__gorget_closure_call_")):
        return true
    # Field reads: arg 0 (the struct) must be a pointer
    if arg_idx == 0 and fn_name.starts_with("__field_read_"):
        return true
    # Field writes: arg 0 (the struct) must be a pointer
    if arg_idx == 0 and fn_name.starts_with("__field_write_"):
        return true
    # Option/Result combinators: arg 1 (the closure) must be a pointer
    if arg_idx == 1 and (fn_name.starts_with("__option_") or fn_name.starts_with("__result_")):
        return true
    # Collection methods: arg 0 (self) is always passed by pointer for mutating methods.
    if arg_idx == 0:
        if fn_name == "gorget_array_push" or fn_name == "gorget_array_set":
            return true
        if fn_name == "gorget_array_insert" or fn_name == "gorget_array_remove_opt":
            return true
        if fn_name == "gorget_array_clear" or fn_name == "gorget_array_reverse":
            return true
        if fn_name == "gorget_array_sort" or fn_name == "gorget_array_extend":
            return true
        # `gorget_array_swap(GorgetArray* arr, size_t i, size_t j)` and
        # `gorget_array_swap_remove(GorgetArray* arr, size_t index)` both mutate
        # the array in place → arg 0 (self) by pointer. Mirrors the Rust runtime
        # sig registry (`runtime.rs` ArraySwap/ArraySwapRemove: arg0 = A::Ptr).
        # Without this the self-arg passes by value and cc rejects
        # "incompatible type for argument 1".
        if fn_name == "gorget_array_swap" or fn_name == "gorget_array_swap_remove":
            return true
        if fn_name == "gorget_array_fill":
            # `gorget_array_fill(GorgetArray* arr, size_t n, const void* val_src)`
            # — arg 0 self by pointer (mutating: preallocates capacity and
            # memcpys n copies of val into the buffer). Routed through
            # `Vector__T__fill` by `map_array_method`'s new case (2026-05-20).
            return true
        if fn_name == "gorget_array_free":
            return true
        if fn_name == "gorget_map_put" or fn_name == "gorget_map_remove" or fn_name == "gorget_map_remove_opt":
            return true
        if fn_name == "gorget_map_clear" or fn_name == "gorget_map_free":
            return true
        # `gorget_map_update(void* __dst_ptr, GorgetMap __other)` MUTATES the
        # receiver in place (merges other's entries via put_cloned). Self (arg
        # 0) MUST pass by pointer — by value would mutate a stack COPY (wrong +
        # a likely UAF after the rehash reallocates the copy's storage). Mirrors
        # the Rust ABI (`legacy_self_by_ptr` → every non-`_new` gorget_map_*
        # passes self by ptr; `emit_types.rs:2741` signature is `void* __dst_ptr`).
        if fn_name == "gorget_map_update":
            return true
        if fn_name == "gorget_set_add" or fn_name == "gorget_set_remove":
            return true
        if fn_name == "gorget_set_clear" or fn_name == "gorget_set_free":
            return true
        # Set-op stubs (`gorget_set_union`/`_intersection`/`_difference` +
        # predicates `_is_subset`/`_is_superset`) take self (arg 0) by POINTER:
        # their emitted bodies cast `(GorgetSet*)__self_ptr` and read
        # `__self->order`/`->cap`/`->states` (emit_types.rs:2677-2897). Mirrors
        # the Rust ABI (`legacy_self_by_ptr` → every non-`_new` gorget_set_*
        # passes self by ptr). Without this the receiver passes by value and cc
        # rejects "incompatible type for argument 1" against the `void*` param.
        if fn_name == "gorget_set_union" or fn_name == "gorget_set_intersection" or fn_name == "gorget_set_difference":
            return true
        if fn_name == "gorget_set_symmetric_difference":
            return true
        if fn_name == "gorget_set_is_subset" or fn_name == "gorget_set_is_superset" or fn_name == "gorget_set_is_disjoint":
            return true
        if fn_name == "gorget_channel_send" or fn_name == "gorget_channel_close":
            return true
        if fn_name == "gorget_channel_recv" or fn_name == "gorget_channel_try_recv":
            return true
        # Guard set/get/release/get_ptr: arg 0 (the guard) is a
        # `gorget_guard_t*` — pass the guard slot's ADDRESS, not the 16-byte
        # struct by value. Without this, cc rejects "incompatible type for
        # argument 1" (the runtime wants a pointer to the guard struct).
        if fn_name == "gorget_guard_set" or fn_name == "gorget_write_guard_set":
            return true
        if fn_name == "gorget_guard_get" or fn_name == "gorget_guard_get_ptr":
            return true
        if fn_name == "gorget_read_guard_get" or fn_name == "gorget_write_guard_get":
            return true
        # get_ptr variants for the RWLock guard family (used by the Guard[T]
        # field-access auto-deref) — same by-address rule as the Mutex
        # `gorget_guard_get_ptr` above.
        if fn_name == "gorget_read_guard_get_ptr" or fn_name == "gorget_write_guard_get_ptr":
            return true
        if fn_name == "gorget_guard_release":
            return true
        # Release variants for the RWLock guard family (shared(rwlock) facade
        # guard drops) — same by-address rule as `gorget_guard_release` above
        # (`gorget_read_guard_release(gorget_read_guard_t* g)`).
        if fn_name == "gorget_read_guard_release" or fn_name == "gorget_write_guard_release":
            return true
        # Read-only methods also take self by const pointer
        if fn_name == "gorget_array_safe_get" or fn_name == "gorget_array_len":
            return true
        # `gorget_array_reserve(GorgetArray* arr, size_t n)` mutates the
        # array's allocation; `gorget_array_capacity(const GorgetArray* arr)`
        # reads it. Both take self (arg 0) by pointer. Sibling of the
        # push/len/get rows above — without these, the self-arg passes by
        # value and cc rejects "incompatible type for argument 1".
        if fn_name == "gorget_array_reserve" or fn_name == "gorget_array_capacity":
            return true
        # `gorget_array_get(const GorgetArray* arr, size_t idx)` — the
        # EIndex value-read getter (`v[i]`). Self (arg 0) is the array by
        # const pointer, exactly like gorget_map_get below. Without this the
        # array self-arg passes by value and cc rejects it.
        if fn_name == "gorget_array_get":
            return true
        if fn_name == "gorget_array_is_empty" or fn_name == "gorget_array_contains":
            return true
        if fn_name == "gorget_array_safe_last" or fn_name == "gorget_array_safe_first":
            return true
        # first/last return `void*` into the array element; self by const ptr.
        if fn_name == "gorget_array_first" or fn_name == "gorget_array_last":
            return true
        # In-place typed sort (gorget_array_sort_{int,float,str,generic}):
        # self (arg 0) is a `void* __p` pointer to the array it mutates.
        if fn_name.starts_with("gorget_array_sort_"):
            return true
        if fn_name == "gorget_array_safe_pop" or fn_name == "gorget_array_index_of":
            return true
        if fn_name == "gorget_array_clone" or fn_name == "gorget_array_slice":
            return true
        # sorted/reversed/unique: clone-and-transform runtime stubs whose
        # self (arg 0) is a `void* __p` pointer to the source GorgetArray
        # (mirrors Rust gg's by-pointer ABI for these synthesised stubs).
        if fn_name.starts_with("gorget_array_sorted_") or fn_name == "gorget_array_reversed":
            return true
        if fn_name.starts_with("gorget_array_unique_"):
            return true
        # binary_search(const GorgetArray* a, const void* key): self by ptr.
        if fn_name == "gorget_array_binary_search":
            return true
        if fn_name == "gorget_map_get" or fn_name == "gorget_map_len":
            return true
        # `Dict__K__V__get_or_put(GorgetMap* __m, K __k, V __d)` — the mutating
        # get-or-put inline wrapper. Self (arg 0) is the map BY POINTER so the
        # miss-side `gorget_map_put` persists into the CALLER's map (the map is
        # a by-value struct of pointers + count; a put on a stack copy is lost
        # and UAFs after a rehash). The read-only `get_or` variant passes the
        # map by value, so this row is `__get_or_put`-specific. The flag is on
        # the TYPED DictGetOrReq.is_put at the request site; the mangled-name
        # test here is the C-emit ABI boundary (the symbol IS the contract).
        if fn_name.ends_with("__get_or_put"):
            return true
        if fn_name == "gorget_map_contains" or fn_name == "gorget_map_is_empty":
            return true
        if fn_name == "gorget_map_keys" or fn_name == "gorget_map_values":
            return true
        if fn_name == "gorget_map_items":
            return true
        # Dict/HashMap for-loop iteration accessors (lower_for_dict): self
        # (arg 0) is the map by const pointer. `gorget_map_iter_cap(const
        # void*)`, `gorget_map_iter_state(const void*, idx)`,
        # `gorget_map_iter_key/value(const void*, idx, void* out)`.
        if fn_name == "gorget_map_iter_cap" or fn_name == "gorget_map_iter_state":
            return true
        # Ordered-set for-loop accessors (lower_for_set): `gorget_map_iter_order_len
        # (const void*)`, `gorget_map_iter_order(const void*, i)`.
        if fn_name == "gorget_map_iter_order_len" or fn_name == "gorget_map_iter_order":
            return true
        if fn_name == "gorget_map_iter_key" or fn_name == "gorget_map_iter_value":
            return true
        if fn_name == "gorget_map_clone":
            return true
        # `gorget_map_new_like(const GorgetMap* src)` — the Dict-HOF `filter`
        # result ctor (lower_expr.gg). Reads the receiver map by const pointer
        # (same ABI as gorget_map_clone) to copy its order/size/fn-ptr config.
        # Without this the by-value map is passed and cc rejects argument 1.
        if fn_name == "gorget_map_new_like":
            return true
        if fn_name == "gorget_set_contains" or fn_name == "gorget_set_len":
            return true
        if fn_name == "gorget_set_clone" or fn_name == "gorget_set_is_empty":
            return true
        # Drain accessor: `gorget_set_drain_entry(const void* s, idx, void* out)`
        # arg 0 (s) is the Set by const pointer — same ABI as iter accessors.
        if fn_name == "gorget_set_drain_entry":
            return true
        # `gorget_bytes_to_str(const GorgetArray* arr)` — reads a Vector[byte]
        # by const pointer (`__bytes_to_str_raw` / `.to_str()` on a byte
        # buffer). Without this, the array self-arg is passed by value and cc
        # rejects it (`incompatible type for argument 1 of gorget_bytes_to_str`).
        # Surfaced once the io.gg Writer-for-GorgetString impl became reachable
        # via the FIDELITY vtable globals. Mirrors Rust gg's by-pointer ABI.
        if fn_name == "gorget_bytes_to_str":
            return true
        # `gorget_string_push_char(GorgetString* s, Str c)` mutates the builder
        # in place — self (arg 0) is by pointer (the GorgetString receiver).
        if fn_name == "gorget_string_push_char":
            return true
        # The `gorget_str_*` String-builder spellings (`push`/`push_line`/
        # `push_char` fall-throughs from map_runtime_name's `gorget_str_` +
        # method arm) ALSO take self by pointer (GorgetString receiver). These
        # are the names BEFORE the scalar-overload redirect at the call-emit
        # site rewrites them to `gorget_string_push_{int,float,bool}` etc., so
        # the self-by-ptr decision must key off the pre-redirect name here.
        # Mirrors Rust gg `src/backend/c_lir/helpers.rs:752` `legacy_self_by_ptr`
        # (gorget_str_push | gorget_str_push_line | gorget_str_push_char).
        if fn_name == "gorget_str_push" or fn_name == "gorget_str_push_line" or fn_name == "gorget_str_push_char":
            return true
        # StringBuilder reset/capacity thin-wrappers (`s.clear()`/`s.capacity()`
        # → gorget_str_{clear,capacity}) also take the GorgetString receiver by
        # pointer — their emitted bodies read/write `s->len`/`s->cap`
        # (lir_codegen.gg emit_str_builder_wrappers, mirroring Rust gg
        # emit_types.rs:2566-2611). Same `legacy_self_by_ptr` row (Rust
        # helpers.rs:752-756). Without this the receiver passes by value and cc
        # rejects "incompatible type for argument 1".
        if fn_name == "gorget_str_clear" or fn_name == "gorget_str_capacity":
            return true
        # Note: gorget_str_codepoint_count takes Str by value, NOT by pointer.
        # Clone fns (used by emit_payload_read's blocker-2 path for
        # resource-typed payloads) take the source by `const T*`.
        if fn_name == "gorget_string_clone" or fn_name == "gorget_string_clone_to_owned":
            return true
        if fn_name == "gorget_closure_clone" or fn_name == "gorget_closure_clone_to_owned":
            return true
        # User-type `T__clone` fns (generated by the codegen for any
        # struct/enum with recursive-drop sub-fields) all take `void* __p`
        # in their C signature — emit a SlotAddr for the source.
        if fn_name.ends_with("__clone"):
            return true
    # Element args passed by pointer
    if fn_name == "gorget_array_push" and arg_idx == 1:
        return true
    # binary_search key (arg 1): `const void* key` — pass the search key's
    # slot address, exactly like the push element above.
    if fn_name == "gorget_array_binary_search" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_set" and arg_idx == 2:
        return true
    if fn_name == "gorget_array_insert" and arg_idx == 2:
        return true
    if fn_name == "gorget_array_fill" and arg_idx == 2:
        # Third arg (val_src) is `const void*` — pointer to the element
        # to broadcast across the n filled slots.
        return true
    if fn_name == "gorget_map_put" and (arg_idx == 1 or arg_idx == 2):
        return true
    # lower_for_dict key/value extraction: arg 2 is the `void* out` slot the
    # accessor writes the (owned-cloned) key/value into — pass the bound
    # local's slot ADDRESS, not its value.
    if fn_name == "gorget_map_iter_key" and arg_idx == 2:
        return true
    if fn_name == "gorget_map_iter_value" and arg_idx == 2:
        return true
    # Drain accessor: arg 2 is `void* out_key` written by the callee (output slot).
    # Must be passed as ISlotAddr so the callee can write the drained key into the slot.
    # Mirrors gorget_map_iter_key/value arg 2 — same by-address out-param ABI.
    if fn_name == "gorget_set_drain_entry" and arg_idx == 2:
        return true
    # Dict drain accessor: `gorget_map_drain_entry(const void* m, idx, void* out_key,
    # void* out_val)` — args 2 (out_key) AND 3 (out_val) are out-buffers the callee
    # writes into. Without these the borrow operands pass by value (NULL) → memcpy(NULL)
    # → SIGSEGV. Mirrors Rust gg `helpers.rs:699 "gorget_map_drain_entry" => &[2,3]` and
    # the gorget_set_drain_entry sibling above (set has only out_key at arg 2).
    if fn_name == "gorget_map_drain_entry" and (arg_idx == 2 or arg_idx == 3):
        return true
    if fn_name == "gorget_array_contains" and arg_idx == 1:
        return true
    if fn_name == "gorget_map_get" and arg_idx == 1:
        return true
    if fn_name == "gorget_map_contains" and arg_idx == 1:
        return true
    if (fn_name == "gorget_map_remove" or fn_name == "gorget_map_remove_opt") and arg_idx == 1:
        return true
    if fn_name == "gorget_set_add" and arg_idx == 1:
        return true
    if fn_name == "gorget_set_contains" and arg_idx == 1:
        return true
    if fn_name == "gorget_set_remove" and arg_idx == 1:
        return true
    if fn_name == "gorget_channel_send" and arg_idx == 1:
        return true
    # Guard set value (arg 1): `gorget_guard_set(g, void* val, size)` — the
    # value is passed BY ADDRESS (the runtime memcpy's `size` bytes from it
    # into the guarded data). Mirrors Rust's `&(T){val}` (A::VoidElem ABI,
    # runtime.rs:468). The size (arg 2) is appended by the post-mapping fixup.
    if (fn_name == "gorget_guard_set" or fn_name == "gorget_write_guard_set") and arg_idx == 1:
        return true
    # `cv.wait(g)` → `gorget_condvar_wait_guard(void* cv, gorget_guard_t* g)`
    # (the std.sync extern binding). The guard (arg 1) must be the guard slot
    # ADDRESS — the runtime needs `&guard->mutex->lock` for pthread_cond_wait.
    # With Guard typedef'd as the 16-byte `gorget_guard_t` struct, a by-value
    # pass would be a struct-vs-pointer type error.
    if fn_name == "gorget_condvar_wait_guard" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_extend" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_index_of" and arg_idx == 1:
        return true
    if fn_name == "gorget_array_safe_remove" and arg_idx == 1:
        return true
    # File I/O runtime fns that take aggregate output/buffer structs by pointer.
    # Previously handled by `runtime_arg_needs_addr` in lir_codegen — hoisted
    # to the lir_lower boundary so a SlotAddr carries the pointer natively.
    if fn_name == "gorget_file_open_try" and arg_idx == 2:
        return true
    if fn_name == "gorget_file_write_bytes_buf" and arg_idx == 1:
        return true
    if fn_name == "gorget_file_read_bytes_buf" and arg_idx == 1:
        return true
    return false

# Out-param ABI table (sibling of `needs_ptr_arg`): true when arg `arg_idx`
# of `fn_name` is a `void* out` the callee writes the (owned) result INTO —
# the pointee slot is initialized BY the call. Tagged ABI_OUT_PTR in the
# ICallExtern arg_abis so drop-elaboration keeps the slot's drop alive (#11).
# Currently only the Dict/Set iteration accessors' arg 2. Mirrors Rust gg's
# AbiKind::OutPtr on gorget_map_iter_key/value arg 2 (src/lir/runtime.rs).
bool out_param_arg(String fn_name, int arg_idx):
    if fn_name == "gorget_map_iter_key" and arg_idx == 2:
        return true
    if fn_name == "gorget_map_iter_value" and arg_idx == 2:
        return true
    # Drain accessor: arg 2 is `void* out_key` written by the callee.
    if fn_name == "gorget_set_drain_entry" and arg_idx == 2:
        return true
    # Dict drain: args 2 (out_key) and 3 (out_val) are out-buffers the callee
    # writes into. Mirrors Rust gg `helpers.rs:699 => &[2,3]` and the set sibling.
    # Inert for int K/V (no drop) but correct/forward-looking for resource K/V so
    # the drained slots wire their drops (ABI_OUT_PTR tagging for #11).
    if fn_name == "gorget_map_drain_entry" and (arg_idx == 2 or arg_idx == 3):
        return true
    return false

# Check if a GIR type ID represents a pointer type (Ptr or MutPtr).
bool is_ptr_type(int tid, GirModule gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType ty = gmod.type_table.get(tid).unwrap()
    match ty:
        case GtPtr(_):
            return true
        case GtMutPtr(_):
            return true
        else:
            return false

# True iff the LIR type-id names a `Box__<inner>` struct. Box types register as
# structs (`>= LT_STRUCT_BASE`) but are `typedef void*` in C (pointer-
# represented). A box VALUE therefore lives in a slot whose `slot_ty` is a
# struct id even though the slot HOLDS a pointer — the by-pointer-ABI arg path
# must LOAD that pointer (ISlotLoad), not address-take the slot (ISlotAddr).
# Reads the typed `type_runtime_map` (no name-matching). This is the
# `lir_type_is_box` twin (defined in lir_codegen.gg, not importable here) —
# kept in sync with the inlined copy in the GIDropIfAlive Box-drop path below.
bool lir_slot_is_box(int ty, LirModule m):
    if ty < LT_STRUCT_BASE:
        return false
    int sid = ty - LT_STRUCT_BASE
    if sid < 0 or sid >= m.structs.len():
        return false
    String nm = m.structs.get(sid).unwrap().name
    if not m.type_runtime_map.contains(nm):
        return false
    return m.type_runtime_map.get(nm).unwrap_or("") == "Box"

# Check if a function name starts with a scalar type prefix (e.g. int64_t__push).
# These come from the self-host GIR where T__method is used instead of Vector__T__method.
bool is_scalar_type_prefix(String name):
    if name.starts_with("int64_t__") or name.starts_with("int32_t__"):
        return true
    if name.starts_with("int16_t__") or name.starts_with("int8_t__"):
        return true
    if name.starts_with("uint64_t__") or name.starts_with("uint32_t__"):
        return true
    if name.starts_with("uint16_t__") or name.starts_with("uint8_t__"):
        return true
    if name.starts_with("double__") or name.starts_with("float__"):
        return true
    if name.starts_with("bool__"):
        return true
    return false

# Size-aware variant used at lower_instruction's `gorget_array_contains`
# site where the element may be a user struct requiring real size lookup.
# True for runtime functions that return a void* pointing to an element
# inside a collection (`Vector.get / .safe_get / .first / .last / .pop`,
# `Dict.get / .remove`). The self-host's `infer_method_return_type`
# flattens these to return the element type directly, but at the C level
# they still return void*. For scalar-element callers, the pointer must
# be dereferenced into the scalar — otherwise the pointer address flows
# downstream as if it were the value. Called from the GICallExtern
# lowering to decide whether to insert an ILoad before the SlotStore.
bool returns_ptr_to_element(String name):
    if name == "gorget_array_get" or name == "gorget_array_safe_get":
        return true
    if name == "gorget_map_get":
        return true
    if name == "gorget_array_safe_last" or name == "gorget_array_safe_first" or name == "gorget_array_safe_pop":
        return true
    if name == "gorget_map_remove_opt" or name == "gorget_array_remove_opt":
        return true
    # `gorget_guard_get(g)` returns `g->ptr` — a `void*` AT the guarded data,
    # not the value. A scalar `g.get()` dst slot needs ONE deref (`*(T*)ptr`)
    # to read the value. Rust inlines this as FieldPtr+Load+Load; the
    # self-host calls the runtime getter (which returns the data ptr) and
    # then derefs it once via the shared ptr-to-element ILoad path below.
    if name == "gorget_guard_get" or name == "gorget_read_guard_get" or name == "gorget_write_guard_get":
        return true
    return false

# ── Tier 1 lift: collection void* → Option wrap ─────────────────
bool is_collection_void_return(String name):
    if name == "gorget_array_get" or name == "gorget_array_pop":
        return true
    if name == "gorget_array_first" or name == "gorget_array_last":
        return true
    if name == "gorget_array_safe_get" or name == "gorget_array_safe_pop":
        return true
    if name == "gorget_array_safe_first" or name == "gorget_array_safe_last":
        return true
    if name == "gorget_array_remove_opt":
        return true
    if name == "gorget_map_get" or name == "gorget_map_remove_opt":
        return true
    if name == "gorget_heap_pop" or name == "gorget_heap_peek":
        return true
    if name == "gorget_shared_get" or name == "gorget_shared_get_ptr":
        return true
    if name == "gorget_channel_recv":
        return true
    return false

bool is_consuming_collection_method(String name):
    if name == "gorget_array_safe_pop" or name == "gorget_array_remove_opt":
        return true
    if name == "gorget_map_remove" or name == "gorget_map_remove_opt":
        return true
    if name == "gorget_set_remove":
        return true
    return false

String resource_clone_fn(int payload_ty, LirModule m):
    if payload_ty < LT_STRUCT_BASE:
        return ""
    int sid = payload_ty - LT_STRUCT_BASE
    if sid >= m.structs.len():
        return ""
    LirStructDef sdef = m.structs.get(sid).unwrap()
    String name = sdef.name
    if name == "GorgetArray":
        return "gorget_array_clone"
    if name == "GorgetMap":
        return "gorget_map_clone"
    if name == "GorgetSet":
        return "gorget_set_clone"
    if name == "GorgetString":
        return "gorget_string_clone_to_owned"
    if name == "GorgetClosure":
        return "gorget_closure_clone_to_owned"
    if m.recursive_drop_structs.contains(name) or m.recursive_drop_enums.contains(name):
        return name + "__clone"
    return ""

# P0 Bug B (fold the siblings): the SHARED by-pointer OpClone arm for BOTH
# the GICall (user-fn) and GICallExtern (runtime) pass-by-ptr paths. Returns
# the LIR value to push into `lir_args`.
#
# A by-pointer arg needs an lvalue (an addressable slot). `lower_operand` on
# an `OpClone` emits the clone call and returns the fresh OWNED value (a
# struct value for `T__clone`, a thin pointer for String/Closure):
#   • value-struct source slot (`slot_ty >= LT_STRUCT_BASE`):
#     `lower_operand` takes the slot's address and calls `<T>__clone` →
#     the cloned struct VALUE.  elem_ty == slot_ty.
#   • ptr-to-known-struct source slot (`LT_PTR_TO_BASE..LT_STRUCT_BASE`):
#     `lower_operand` loads the pointer and calls the POINTEE's clone fn →
#     a fresh owned pointee VALUE.  elem_ty is the dereferenced pointee
#     struct type (`LT_STRUCT_BASE + (slot_ty - LT_PTR_TO_BASE)`).
# In BOTH cases the clone is a struct VALUE that must be materialised into a
# fresh temp slot of the element type, whose ADDRESS is passed by pointer —
# the callee receives an independent owned copy it can consume or mutate
# WITHOUT aliasing the caller's element. (Before the fold the GICall arm
# fell through to passing the raw aliased pointer for a ptr-to-struct source
# — NO clone — while the GICallExtern twin cloned: the duplicated-and-drifted
# OpClone-arm bug this helper retires.)
#
# Raw `LT_PTR` / primitive sources have no struct type signal to size a temp
# slot — pass the loaded clone value directly (legacy best-effort, matching
# the prior GICallExtern fall-through).
int lower_clone_arg_by_ptr(Operand arg, int local_id, LirFunction &f, int bb, Vector[int] local_to_slot, LirModule m):
    int slot = local_to_slot.get(local_id).unwrap()
    int slot_ty = f.slots.get(slot).unwrap().ty
    # Element (owned value) type the clone produces:
    # ptr-to-struct → the pointee; value-struct → itself.
    int elem_ty = slot_ty
    if slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE:
        elem_ty = LT_STRUCT_BASE + (slot_ty - LT_PTR_TO_BASE)
    int cloned_val = lower_operand(arg, &f, bb, local_to_slot, m)
    if elem_ty >= LT_STRUCT_BASE:
        int tmp_slot = lir_fn_add_slot(&f, elem_ty, "")
        lir_push_inst(&f, bb, ISlotStore(tmp_slot, cloned_val, true))
        int caddr = lir_fn_next_value(&f)
        lir_push_inst(&f, bb, ISlotAddr(caddr, tmp_slot))
        return caddr
    return cloned_val

# `dst_is_borrow` (CoW collection-get default): when the GIR result
# local is tagged LoBorrowed/LoView (a non-consuming `.get()`/`.first()`/
# `.last()` whose Option aliases the collection element per CLAUDE.md
# "Ownership at Consuming Positions": collection element reads propagate
# Ptr aliases at zero cost), do NOT deep-clone the aggregate payload into
# the Option — shallow-copy the element header (a borrow alias). The
# borrowed Option is dropped-skipped (a-1) and clone-materialised only at
# genuine consume sites via op_consume's a-5 LoBorrowed→OpClone arm. This
# closes the for-element clone bomb: `for x in coll` over a Vector of
# structs no longer clones every element (was 10M+ Stmt/SpannedExpr clones
# → ~14.5 GB OOM in the self-host driver). Owned results (LoOwned, e.g. a
# `.get().clone()` whose binding owns) keep the eager clone.
int emit_void_ptr_option_wrap(String emit_name, int dst_local, int opt_sid, Vector[int] lir_args, LirFunction &f, int bb, Vector[int] local_to_slot, LirModule &m, bool dst_is_borrow):
    int raw_ptr = lir_fn_next_value(&f)
    Vector[int] empty_abis = []
    lir_push_inst(&f, bb, ICallExtern(raw_ptr, emit_name, lir_args, emit_name, empty_abis))

    int raw_slot = lir_fn_add_slot(&f, LT_PTR, "")
    lir_push_inst(&f, bb, ISlotStore(raw_slot, raw_ptr, false))

    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_addr_pre = lir_fn_next_value(&f)
    int sz_val = lir_fn_next_value(&f)
    int zero_byte = lir_fn_next_value(&f)
    int sz_bytes = lir_type_byte_size_in_mod(LT_STRUCT_BASE + opt_sid, &m, 0)
    lir_push_inst(&f, bb, ISlotAddr(slot_addr_pre, dst_slot))
    lir_push_inst(&f, bb, IIConst(sz_val, LT_I64, sz_bytes))
    lir_push_inst(&f, bb, IIConst(zero_byte, LT_I32, 0))
    lir_push_inst(&f, bb, IMemset(slot_addr_pre, zero_byte, sz_val))

    int null_val = lir_fn_next_value(&f)
    int is_not_null = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, INullPtr(null_val))
    lir_push_inst(&f, bb, ICmp(is_not_null, CMP_NE, raw_ptr, null_val))

    int some_bb = lir_fn_add_block(&f)
    int none_bb = lir_fn_add_block(&f)
    int merge_bb = lir_fn_add_block(&f)
    Vector[int] empty_args0 = []
    Vector[int] empty_args1 = []
    lir_set_term(&f, bb, TBranch(is_not_null, some_bb, empty_args0, none_bb, empty_args1))

    LirStructDef opt_def = m.structs.get(opt_sid).unwrap()
    int payload_field_ty = LT_I64
    if opt_def.fields.len() >= 2:
        payload_field_ty = opt_def.fields.get(1).unwrap().ty
    bool payload_is_ptr = (payload_field_ty == LT_PTR) or (payload_field_ty >= LT_PTR_TO_BASE and payload_field_ty < LT_STRUCT_BASE)
    bool consuming = is_consuming_collection_method(emit_name)

    int raw_in_some = lir_fn_next_value(&f)
    lir_push_inst(&f, some_bb, ISlotLoad(raw_in_some, raw_slot, LT_PTR))

    int payload_val = -1
    if payload_is_ptr:
        payload_val = raw_in_some
    elif lir_is_aggregate(payload_field_ty):
        String clone_fn = ""
        # CoW: clone the aggregate element into the Option ONLY when the
        # result must own it. Consuming methods (pop/remove) already
        # transferred ownership out of the collection → no clone (shallow
        # move). Non-consuming gets whose GIR local is a borrow alias
        # (dst_is_borrow) → no clone either (the Option borrows the
        # element; consume sites clone on demand). Eager clone remains
        # only for owned (non-borrow) non-consuming results.
        if not consuming and not dst_is_borrow:
            clone_fn = resource_clone_fn(payload_field_ty, m)
        if clone_fn != "":
            int cloned = lir_fn_next_value(&f)
            Vector[int] cargs = []
            cargs.push(raw_in_some)
            Vector[int] cabis = []
            lir_push_inst(&f, some_bb, ICallExtern(cloned, clone_fn, cargs, clone_fn, cabis))
            int cl_slot = lir_fn_add_slot(&f, payload_field_ty, "")
            int cl_addr = lir_fn_next_value(&f)
            lir_push_inst(&f, some_bb, ISlotStore(cl_slot, cloned, true))
            lir_push_inst(&f, some_bb, ISlotAddr(cl_addr, cl_slot))
            payload_val = cl_addr
        else:
            payload_val = raw_in_some
    else:
        int loaded = lir_fn_next_value(&f)
        lir_push_inst(&f, some_bb, ILoad(loaded, raw_in_some, payload_field_ty))
        payload_val = loaded

    int some_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] some_fields = []
    some_fields.push(FieldInit(1, payload_val))
    lir_push_inst(&f, some_bb, ISlotAddr(some_slot_addr, dst_slot))
    lir_push_inst(&f, some_bb, IEnumInit(some_slot_addr, opt_sid, 0, some_fields))
    Vector[int] empty_args_s = []
    lir_set_term(&f, some_bb, TJump(merge_bb, empty_args_s))

    int none_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] none_fields = []
    lir_push_inst(&f, none_bb, ISlotAddr(none_slot_addr, dst_slot))
    lir_push_inst(&f, none_bb, IEnumInit(none_slot_addr, opt_sid, 1, none_fields))
    Vector[int] empty_args_n = []
    lir_set_term(&f, none_bb, TJump(merge_bb, empty_args_n))

    return merge_bb

# Scalar sentinel → Option wrap for index_of/find. Mirrors Rust
# src/lir/lower/lifts.rs::emit_sentinel_scalar_option_wrap (lines 448-478):
# the call returns a raw i64 index; `raw >= 0 ? Some(raw) : None`. The raw int
# is used DIRECTLY as the Some payload — NO LT_PTR slot, NO ISlotStore/ISlotLoad,
# NO INullPtr, NO ILoad deref (the ptr sibling above does all of that because it
# dereferences a pointer-sentinel; doing it here would treat the integer index as
# a pointer = garbage/segfault, corrupting the ~14 internal index_of().unwrap()
# sites + diverging bootstrap). The Some/None EnumInit shape mirrors the ptr
# sibling (ISlotAddr(dst_slot) → IEnumInit tag 0/1).
int emit_sentinel_scalar_option_wrap(String emit_name, int dst_local, int opt_sid, Vector[int] lir_args, LirFunction &f, int bb, Vector[int] local_to_slot, LirModule &m):
    int raw_val = lir_fn_next_value(&f)
    Vector[int] empty_abis = []
    lir_push_inst(&f, bb, ICallExtern(raw_val, emit_name, lir_args, emit_name, empty_abis))

    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_addr_pre = lir_fn_next_value(&f)
    int sz_val = lir_fn_next_value(&f)
    int zero_byte = lir_fn_next_value(&f)
    int sz_bytes = lir_type_byte_size_in_mod(LT_STRUCT_BASE + opt_sid, &m, 0)
    lir_push_inst(&f, bb, ISlotAddr(slot_addr_pre, dst_slot))
    lir_push_inst(&f, bb, IIConst(sz_val, LT_I64, sz_bytes))
    lir_push_inst(&f, bb, IIConst(zero_byte, LT_I32, 0))
    lir_push_inst(&f, bb, IMemset(slot_addr_pre, zero_byte, sz_val))

    int const0 = lir_fn_next_value(&f)
    int is_found = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IIConst(const0, LT_I64, 0))
    lir_push_inst(&f, bb, ICmp(is_found, CMP_GE, raw_val, const0))

    int some_bb = lir_fn_add_block(&f)
    int none_bb = lir_fn_add_block(&f)
    int merge_bb = lir_fn_add_block(&f)
    Vector[int] empty_args0 = []
    Vector[int] empty_args1 = []
    lir_set_term(&f, bb, TBranch(is_found, some_bb, empty_args0, none_bb, empty_args1))

    # Some arm: raw_val used DIRECTLY as the i64 payload (field 1).
    int some_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] some_fields = []
    some_fields.push(FieldInit(1, raw_val))
    lir_push_inst(&f, some_bb, ISlotAddr(some_slot_addr, dst_slot))
    lir_push_inst(&f, some_bb, IEnumInit(some_slot_addr, opt_sid, 0, some_fields))
    Vector[int] empty_args_s = []
    lir_set_term(&f, some_bb, TJump(merge_bb, empty_args_s))

    # None arm.
    int none_slot_addr = lir_fn_next_value(&f)
    Vector[FieldInit] none_fields = []
    lir_push_inst(&f, none_bb, ISlotAddr(none_slot_addr, dst_slot))
    lir_push_inst(&f, none_bb, IEnumInit(none_slot_addr, opt_sid, 1, none_fields))
    Vector[int] empty_args_n = []
    lir_set_term(&f, none_bb, TJump(merge_bb, empty_args_n))

    return merge_bb

# Predicate: methods whose mapped runtime symbol returns a raw i64 sentinel
# index that must be wrapped into Option[int] (Rust's sentinel_to_option set
# {find, index_of, ...}). Keyed on MAPPED gorget_* names (call_name at the
# dispatch site is map_runtime_name'd) — gorget_str_index_of/find (String) AND
# gorget_array_index_of (Vector, since the §1 type flip is receiver-blind).
bool is_sentinel_scalar_method(String name):
    if name == "gorget_str_index_of" or name == "gorget_str_find":
        return true
    if name == "gorget_array_index_of":
        return true
    return false

# Predicate: calls whose result is a nullable pointer (non-NULL == Some, NULL ==
# None) that must be wrapped into Option[T]. Currently the `Weak__<T>__upgrade`
# typed wrapper (returns a `Shared__<T>` pointer or NULL). Keyed on the MAPPED
# `call_name`, which for upgrade is the UNCHANGED mangled name (map_runtime_name's
# gorget_weak arm records a wrapper request and returns `name`). Mirrors Rust gg's
# is_nullable_ptr_fn_lir (src/lir/lower/lifts.rs:44).
bool is_nullable_ptr_fn(String name):
    return name.starts_with("Weak__") and name.ends_with("__upgrade")

int extract_elem_size_from_name_in_mod(String name, Dict[String, int] sr, LirModule &m):
    String elem = coll_elem_type_for_name(name, m)
    if elem != "":
        return type_elem_size_in_mod(elem, sr, &m)
    return 8

# Extract the inner-type sizeof from a monomorphized concurrency ctor /
# guard-set name (`Mutex__int64_t__new`, `RWLock__T__new`, `Guard__T__set`,
# `WriteGuard__T__set`). The type sits between the family prefix and the
# trailing `__method`. Mirrors Rust gg's `concurrency_elem_size`
# (src/lir/lower/types.rs:36). Returns 8 (a pointer-size default) on miss.
int concurrency_elem_size_in_mod(String name, Dict[String, int] sr, LirModule &m):
    Vector[String] prefixes = ["Mutex__", "RWLock__", "Shared__", "Guard__", "ReadGuard__", "WriteGuard__"]
    for pfx in prefixes:
        if name.starts_with(pfx):
            String rest = name.slice(pfx.len(), name.len())
            # Find the LAST `__` (the `__method` boundary); the elem is before it.
            int last = -1
            int ci = 0
            while ci < rest.len() - 1:
                if rest.slice(ci, ci + 2) == "__":
                    last = ci
                ci += 1
            if last > 0:
                String elem = rest.slice(0, last)
                return type_elem_size_in_mod(elem, sr, &m)
    return 8

# Map a monomorphized element-type name to a qsort comparator suffix.
# Mirrors Rust gg's `cmp_suffix_for_elem` (src/lir/lower/calls.rs:176).
String cmp_suffix_for_elem(String elem):
    if elem == "int64_t" or elem == "int32_t" or elem == "int16_t" or elem == "int8_t":
        return "int"
    if elem == "uint64_t" or elem == "uint32_t" or elem == "uint16_t" or elem == "uint8_t":
        return "int"
    if elem == "double" or elem == "float":
        return "float"
    if elem == "Str" or elem == "GorgetString":
        return "str"
    return "generic"

# Extract the element type from a `Vector__ELEM__method` mangled name
# (strip the `Vector__` prefix and the trailing `__method`).
String array_elem_for_sort(String name, String method):
    String rest = name
    if name.starts_with("Vector__"):
        rest = name.slice(8, name.len())
    String tail = "__" + method
    if rest.ends_with(tail):
        return rest.slice(0, rest.len() - tail.len())
    return ""

String extract_method_name(String name):
    # Find the last "__" and return everything after it
    int last_pos = -1
    int i = 0
    while i < name.len() - 1:
        String c1 = name.slice(i, i + 1)
        String c2 = name.slice(i + 1, i + 2)
        if c1 == "_" and c2 == "_":
            last_pos = i
        i += 1
    if last_pos >= 0 and last_pos + 2 < name.len():
        return name.slice(last_pos + 2, name.len())
    return ""

# ── Canonical-op helpers ────────────────────────────────────

# For prelude variant names (Some/None/Ok/Error), return (variant_tag,
# payload_field_index). payload_field_index = -1 when the variant has no
# payload. Returns (-1, -1) for non-prelude names.
struct VariantInfo:
    int tag
    int payload_field

VariantInfo prelude_variant_info(String name):
    if name == "Some":
        return VariantInfo(0, 1)
    if name == "None":
        return VariantInfo(1, -1)
    if name == "Ok":
        return VariantInfo(0, 1)
    if name == "Error":
        return VariantInfo(1, 2)
    return VariantInfo(-1, -1)

# Attempt to lower a prelude variant constructor (Some/None/Ok/Error) as a
# canonical IEnumInit filling the dst slot in place. Returns true on success;
# false means the caller should fall through to the normal ICallExtern path.
bool try_lower_prelude_variant(String func_name, int dst_local, Vector[Operand] args, LirFunction &f, int bb, Vector[int] local_to_slot, LirModule m):
    if dst_local < 0:
        return false
    VariantInfo vi = prelude_variant_info(func_name)
    if vi.tag < 0:
        return false
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_ty = f.slots.get(dst_slot).unwrap().ty
    # Slot must be typed as the parent enum struct. If the self-host lost
    # the type (scalar placeholder), fall back to the old emission path.
    if slot_ty < LT_STRUCT_BASE:
        return false
    int struct_id = slot_ty - LT_STRUCT_BASE
    # Payload value (if variant has a payload field).
    Vector[FieldInit] fields = []
    if vi.payload_field >= 0 and args.len() >= 1:
        Operand payload = args.get(0).unwrap()
        int pval = lower_operand(payload, &f, bb, local_to_slot, m)
        fields.push(FieldInit(vi.payload_field, pval))
    # Take the slot's address and emit IEnumInit writing in place.
    int target = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(target, dst_slot))
    lir_push_inst(&f, bb, IEnumInit(target, struct_id, vi.tag, fields))
    return true

# Runtime-provided struct names whose layout the compiler treats as
# opaque. User struct construction for these goes through the runtime
# (`gorget_string_new`, `gorget_array_new`, etc.) — they are NOT lowered
# via IStructInit and must not match the user-struct-ctor intercept.
bool is_runtime_struct_name(String name):
    if name == "GorgetString" or name == "Str" or name == "String":
        return true
    if name == "GorgetArray" or name == "GorgetMap" or name == "GorgetSet":
        return true
    if name == "GorgetClosure" or name == "TraitObj":
        return true
    return false

# Attempt to lower a user struct constructor (e.g. `SpannedToken(tok, s, e)`)
# as a canonical IStructInit filling the dst slot in place. Returns true on
# success; false means the caller should fall through to the old emission
# path (inline `(T){...}` struct literal) which miscompiles by-pointer
# struct-typed args as pointer-to-struct assignments.
bool try_lower_user_struct_ctor(String func_name, int dst_local, Vector[Operand] args, LirFunction &f, int bb, Vector[int] local_to_slot, Dict[String, int] sr, LirModule m):
    if dst_local < 0:
        return false
    # Skip names that other intercepts already own.
    if func_name == "Box" or func_name == "Some" or func_name == "None":
        return false
    if func_name == "Ok" or func_name == "Error":
        return false
    # Runtime-provided opaque types construct via the runtime, not IStructInit.
    if is_runtime_struct_name(func_name):
        return false
    # Look up the struct in the registry. Absent → not a struct ctor.
    int sid = sr.get(func_name).unwrap_or(-1)
    if sid < 0 or sid >= m.structs.len():
        return false
    LirStructDef sdef = m.structs.get(sid).unwrap()
    # Enums + enum variants have different init semantics; skip them.
    if sdef.enum_kind != EK_NOT_ENUM:
        return false
    if m.enum_variant_parent.contains(func_name):
        return false
    # Require positional ctor — arg count must match field count exactly.
    # A mismatch usually means this is a method call that happens to share
    # a name with a struct, or a coercion like `String(x)`.
    if args.len() != sdef.fields.len():
        return false
    # The dst slot must be typed as the target struct. If the self-host
    # lost the type along the way, the old path handles placeholder cases
    # more forgivingly — defer to it.
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    int slot_ty = f.slots.get(dst_slot).unwrap().ty
    if slot_ty != LT_STRUCT_BASE + sid:
        return false
    # Lower each arg into a FieldInit entry keyed on the field index.
    Vector[FieldInit] fields = []
    int ai = 0
    while ai < args.len():
        Operand a = args.get(ai).unwrap()
        int aval = lower_operand(a, &f, bb, local_to_slot, m)
        fields.push(FieldInit(ai, aval))
        ai += 1
    # Emit SlotAddr + IStructInit. emit_field_store (invoked by the codegen
    # expansion) does per-field memcpy for struct-typed fields — the
    # specific fix for the stage-1 SpannedToken(!tok, …) miscast.
    int target = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(target, dst_slot))
    lir_push_inst(&f, bb, IStructInit(target, sid, fields))
    return true

# ── Operand lowering ────────────────────────────────────────

# Returns the LIR type an operand would produce when lowered. Used by
# canonical-op emitters that need the value's type without lowering it yet.
int operand_lir_type(Operand op, LirFunction f, Vector[int] local_to_slot):
    match op:
        case OpConstBool(_):
            return LT_BOOL
        case OpConstI32(_):
            return LT_I32
        case OpConstI64(_):
            return LT_I64
        case OpConstF64(_):
            return LT_F64
        case OpConstStr(_):
            return LT_PTR
        case OpConstNull():
            return LT_PTR
        case OpConstUnit():
            return LT_I32
        case OpSizeOf(_):
            return LT_I64
        case OpCopy(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpMove(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpClone(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
        case OpBorrow(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            return f.slots.get(slot).unwrap().ty
    return LT_VOID

# Compute the `inner_ty` for IBoxAlloc from an arg operand. By-pointer
# param slots (typed LT_PTR_TO_BASE+sid) are semantically the struct
# VALUE being moved into the Box, not the pointer — unwrap so the Box's
# type inference finds Box__<inner_struct_name>.
int box_inner_ty_from_operand(Operand op, LirFunction f, Vector[int] local_to_slot):
    int ty = operand_lir_type(op, f, local_to_slot)
    if ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE:
        return LT_STRUCT_BASE + (ty - LT_PTR_TO_BASE)
    return ty

# Canonical `Box(x)` lowering: emit IBoxAlloc and store the heap pointer into
# the result slot. Shared by the GICall and GICallExtern handlers.
#
# Retypes the result slot to its `Box__<inner>` struct type when the GIR left
# it scalar (`i64`). The prelude `Box(x)` ctor is absent from fn_sigs/type_infos,
# so lower.gg defaults the result local to I64 → a scalar slot. IBoxAlloc
# produces a `Box__<inner>`-typed (pointer-represented, `typedef void* Box__T`)
# value; storing it into the scalar slot hit ISlotStore's "aggregate-into-scalar
# → 0" give-up, NULLing the box, and the downstream `EFieldAccess(box, …)`
# variant ctor then emitted `(Box__T){0}` → `parse_dot_expr`'s
# `EFieldAccess(Box(lhs), …)` returned a NULL boxed base → deref SIGSEGV in
# `Expr__clone`. Aligning the slot type with IBoxAlloc's result type makes the
# store a direct copy and the variant-arg read pass the box pointer through.
# The Rust-gg driver tolerates the I64 GIR typing because its `run_ssa` keeps
# the box value live in a register; the self-host `lower_gir_to_lir` has none.
# Done at the LIR slot level (not the GIR type) so the GIR-level struct-ctor
# routing is untouched.
void emit_box_alloc(int dst_local, Operand box_arg, LirFunction &f, int bb, Vector[int] local_to_slot, Dict[String, int] &sr, LirModule &m):
    int box_inner_ty = box_inner_ty_from_operand(box_arg, f, local_to_slot)
    int box_val = lower_operand(box_arg, &f, bb, local_to_slot, m)
    int box_dst = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IBoxAlloc(box_dst, box_inner_ty, box_val))
    int box_dst_slot = local_to_slot.get(dst_local).unwrap()
    int cur_box_slot_ty = f.slots.get(box_dst_slot).unwrap().ty
    if not lir_is_aggregate(cur_box_slot_ty) and box_inner_ty >= LT_STRUCT_BASE:
        int box_inner_sid = box_inner_ty - LT_STRUCT_BASE
        if box_inner_sid >= 0 and box_inner_sid < m.structs.len():
            String box_inner_name = m.structs.get(box_inner_sid).unwrap().name
            # Register `Box__<Concrete>` as a VALUE box if absent, so the
            # box-result temp is typed `Box__<Concrete>` — carrying the
            # concrete identity forward to the `Box[Trait] ← Box[Concrete]`
            # assignment (where the trait-object fat struct is built,
            # mirroring Rust's `try_trait_object_construct` reading the
            # concrete from the SOURCE type). Value boxes already have this
            # struct registered; a trait-boxed concrete (English boxed as
            # Greeter) does not, so mint it here as a plain `{_0: ptr}`.
            int box_sid = sr.get("Box__" + box_inner_name).unwrap_or(-1)
            if box_sid < 0:
                Vector[StructField] vb_fields = []
                vb_fields.push(StructField("_0", LT_PTR))
                box_sid = lir_mod_add_struct(&m, LirStructDef("Box__" + box_inner_name, vb_fields, 0, false, 8, -1, false))
                sr.put("Box__" + box_inner_name, box_sid)
                m.type_runtime_map.put("Box__" + box_inner_name, "Box")
                m.coll_elem_type_map.put("Box__" + box_inner_name, box_inner_name.clone())
            LirSlot old_box_slot = f.slots.get(box_dst_slot).unwrap()
            f.slots.set(box_dst_slot, LirSlot(LT_STRUCT_BASE + box_sid, old_box_slot.name))
    lir_push_inst(&f, bb, ISlotStore(box_dst_slot, box_dst, false))

# Emit the trait-object FAT struct construction for a `Box[Trait] ← Box[Concrete]`
# assignment. `dst_slot` is the FAT `Box__<Trait>` slot ({data, vtable}); `src_slot`
# is the `Box__<Concrete>` value-box slot (holds the data pointer). Reads the
# concrete from the src struct name, selects `<Trait>_for_<Concrete>_vtable`, and
# emits `dst = {data = *src, vtable = &vtable_global}`. Mirrors Rust gg's
# `try_trait_object_construct` (`src/lir/lower/operands.rs:760`). Returns true iff
# it emitted the construction (dst was a fat trait box + the vtable global exists).
bool try_emit_trait_obj_construct(int dst_slot, int src_slot, LirFunction &f, int bb, LirModule m):
    int dst_ty = f.slots.get(dst_slot).unwrap().ty
    int src_ty = f.slots.get(src_slot).unwrap().ty
    if dst_ty < LT_STRUCT_BASE or src_ty < LT_STRUCT_BASE:
        return false
    int dst_sid = dst_ty - LT_STRUCT_BASE
    int src_sid = src_ty - LT_STRUCT_BASE
    if dst_sid < 0 or dst_sid >= m.structs.len() or src_sid < 0 or src_sid >= m.structs.len():
        return false
    LirStructDef dst_def = m.structs.get(dst_sid).unwrap()
    LirStructDef src_def = m.structs.get(src_sid).unwrap()
    # dst must be a FAT trait box; src must be a `Box__<Concrete>` value box
    # (name-parse the concrete — the `Box__` mangling contract). The typed
    # `is_trait_box` flag (set once at the two Box registrars off the
    # `_VTable`-registry probe) IS the discriminator — the former
    # 2-field/"vtable"-name shape heuristic is retired (devbook/24 rule 2).
    if not dst_def.is_trait_box:
        return false
    if not dst_def.name.starts_with("Box__") or not src_def.name.starts_with("Box__"):
        return false
    String toc_trait = dst_def.name.slice(5, dst_def.name.len())
    String toc_concrete = src_def.name.slice(5, src_def.name.len())
    # Select the vtable global `<Trait>_for_<Concrete>_vtable`.
    String toc_vt_name = toc_trait + "_for_" + toc_concrete + "_vtable"
    int toc_vt_gid = -1
    for (tgi, tg) in m.globals.enumerate():
        if tg.name == toc_vt_name:
            toc_vt_gid = tgi
    if toc_vt_gid < 0:
        return false
    # data (field 0) = *src (the box value = the data pointer).
    int toc_src_addr = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(toc_src_addr, src_slot))
    int toc_data = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ILoad(toc_data, toc_src_addr, LT_PTR))
    # vtable (field 1) = &vtable_global.
    int toc_vt_addr = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IGlobalAddr(toc_vt_addr, toc_vt_gid))
    Vector[FieldInit] toc_fields = []
    toc_fields.push(FieldInit(0, toc_data))
    toc_fields.push(FieldInit(1, toc_vt_addr))
    int toc_target = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(toc_target, dst_slot))
    lir_push_inst(&f, bb, IStructInit(toc_target, dst_sid, toc_fields))
    return true

int lower_operand(Operand op, LirFunction &f, int bb, Vector[int] local_to_slot, LirModule m):
    match op:
        case OpConstBool(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IBoolConst(dst, v))
            return dst
        case OpConstI32(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I32, v))
            return dst
        case OpConstI64(v):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I64, v))
            return dst
        case OpConstF64(v):
            int dst = lir_fn_next_value(&f)
            # Store the float's TRUE IEEE-754 bit pattern (not `v as int`, which
            # TRUNCATES the value). C-emit memcpy's these bits back into a double
            # (lir_codegen.gg IFConst), so the constant round-trips exactly.
            # Mirrors Rust Constant::F64(v) → Inst::FConst{bits: v.to_bits()}
            # (src/lir/lower/operands.rs:111).
            lir_push_inst(&f, bb, IFConst(dst, LT_F64, float_to_bits(v)))
            return dst
        case OpConstStr(s):
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IStrLit(dst, s))
            return dst
        case OpConstNull():
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, INullPtr(dst))
            return dst
        case OpConstUnit():
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IIConst(dst, LT_I32, 0))
            return dst
        case OpSizeOf(tid):
            int dst = lir_fn_next_value(&f)
            # TODO: compute actual size from type
            lir_push_inst(&f, bb, IIConst(dst, LT_I64, 8))
            return dst
        case OpCopy(local_id):
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpMove(local_id):
            # OpMove: load value like OpCopy. The GICallExtern handler
            # converts to SlotAddr when needs_ptr_arg is true.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpClone(local_id):
            # Phase 2c COMMIT 2 + Phase 2.3: OpClone lowers to a real
            # runtime clone call when the source slot holds (or points
            # to) a resource value.
            #
            #   • Value-typed slot (`slot_ty >= LT_STRUCT_BASE`):
            #     `resource_clone_fn` returns the matching
            #     `gorget_*_clone` / `T__clone` symbol for the struct;
            #     we pass `ISlotAddr(slot)` as the by-pointer arg.
            #   • Ptr-to-known-struct slot (`LT_PTR_TO_BASE + sid`):
            #     the slot HOLDS a pointer to the resource (A.2 wired
            #     Ptr-typed dsts at GIFieldLoad reads of resource
            #     fields; B.1 wired Ptr-typed dsts at OpBorrow-source
            #     SVarDecl bindings). The clone fn for the pointee
            #     struct (`LT_STRUCT_BASE + sid`) takes a pointer-to-
            #     resource and produces a fresh owned copy — exactly
            #     what we need. Pass the slot's loaded value (which
            #     IS the pointer) as the by-pointer arg.
            #
            # Without the Ptr-typed branch this handler would fall
            # through to a plain `ISlotLoad` — a byte-copy of the
            # pointer — and the receiver would alias the source
            # buffer. When the source goes out of scope its storage
            # is reclaimed, leaving the receiver's "copy" dangling.
            # Concrete chain: `lower_function` returns a `GirFunction`
            # embedding `ctx.locals`; with A.2 the receiver's local
            # slot is Ptr-typed; without this clone, `gmod.functions`
            # held aliased pointers into freed ctx storage. See
            # `op_consume`'s GtPtr branch (Phase 2.3 Change 1) for the
            # paired writer-side wiring that produces OpClone here.
            #
            # For raw `LT_PTR` slots (no pointee struct info encoded)
            # we have no type signal to pick a clone fn — fall
            # through to plain load (the upstream layer is responsible
            # for tagging these with a more specific type).
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            String clone_fn = ""
            bool slot_is_ptr_to_struct = (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
            bool slot_is_raw_ptr = (slot_ty == LT_PTR)
            if slot_is_ptr_to_struct:
                # Ptr-to-known-struct: route to the pointee's clone fn.
                int pointee_sid = slot_ty - LT_PTR_TO_BASE
                clone_fn = resource_clone_fn(LT_STRUCT_BASE + pointee_sid, m)
            elif not slot_is_raw_ptr:
                # Value-typed (aggregate / struct) slot: look up the
                # struct's clone fn directly.
                clone_fn = resource_clone_fn(slot_ty, m)
            if clone_fn != "":
                int dst = lir_fn_next_value(&f)
                Vector[int] cargs = []
                Vector[int] cabis = []
                if slot_is_ptr_to_struct:
                    # The slot already holds a pointer-to-resource —
                    # load the pointer value and pass it directly.
                    int ptr_val = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotLoad(ptr_val, slot, slot_ty))
                    cargs.push(ptr_val)
                else:
                    # Value-typed slot — take its address to pass by
                    # pointer to the clone fn.
                    int addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                    cargs.push(addr)
                lir_push_inst(&f, bb, ICallExtern(dst, clone_fn, cargs, clone_fn, cabis))
                return dst
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
        case OpBorrow(local_id):
            # Phase D step 3: OpBorrow tagged at the GIR layer for an
            # explicit non-owning alias. LIR currently lowers it as a
            # plain load; the consumer (call arg / assign) decides
            # whether to take a SlotAddr or load the value. Behavioural
            # parity with OpCopy preserved for non-resource locals.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(dst, slot, slot_ty))
            return dst
    return -1

# ── Instruction lowering ────────────────────────────────────

# Unwrap Ptr/MutPtr to reach the underlying named type. Used by GIDrop /
# GIDropIfAlive to resolve the type name of the local being dropped so the
# matching `<Type>__drop` / `gorget_*_free` runtime symbol can be looked up
# via `drop_fn_for_type`. Mirrors `lower.gg::type_id_to_base_name`; kept
# local to `lir_lower.gg` to avoid a cross-module import.
String gir_type_id_to_base_name(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return ""
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name
        case GtPtr(inner):
            return gir_type_id_to_base_name(inner, &gmod)
        case GtMutPtr(inner):
            return gir_type_id_to_base_name(inner, &gmod)
        else:
            return ""

# Look up a GIR local's type name for drop-fn resolution. Returns "" when
# the local is out of range or its type is a primitive / fn-ptr that has
# no drop function.
String gir_local_type_name(int local_id, Vector[GirLocal] gir_locals, GirModule &gmod):
    if local_id < 0 or local_id >= gir_locals.len():
        return ""
    int tid = gir_locals.get(local_id).unwrap().type_id
    return gir_type_id_to_base_name(tid, &gmod)

# True iff the GIR local is a FOR-LOOP element borrow — tagged by
# lower_for_vector with BoCollectionElement(coll_local) where coll_local
# is the non-negative source-collection local id. The general `.get()`
# path uses BoCollectionElement(-1), which returns false here so its
# result still owns (eager clone) — protecting the get-mutate-set idiom
# (`t = coll.get(i); t.push(x); coll.set(i, t)`) that relies on `t` being
# an independent owned copy. Only the for-element, whose full lifecycle the
# loop scaffold controls (read-only body → borrow; consume/mutate → a-5
# clone), is safe to shallow-alias. This is the CoW collection-read default
# scoped to the one site that can guarantee it.
bool gir_local_is_for_element(int local_id, Vector[GirLocal] gir_locals):
    if local_id < 0 or local_id >= gir_locals.len():
        return false
    match gir_locals.get(local_id).unwrap().borrow_origin:
        case BoCollectionElement(coll_local):
            return coll_local >= 0
        else:
            return false

# Tier E §8.1: true iff the GIR local is an owning `!`-move resource
# PARAMETER (sigil ownership==2), tagged by `register_owning_param` in
# lower.gg. The slot for such a param holds a `T*` (the caller transferred
# the pointer in), so the GIDropIfAlive emission passes the LOADED pointer
# (`ISlotLoad(slot)`) — not `&slot` (`ISlotAddr`) — to `T__drop`. A
# `&`-borrow ALSO lowers to GtMutPtr but keeps owning_param=false, so it
# returns false here and is dropped/derefed by neither path (it isn't even
# registered). Mirrors `gir_local_is_for_element` — a typed-field read, no
# new coupling.
bool gir_local_is_owning_param(int local_id, Vector[GirLocal] gir_locals):
    if local_id < 0 or local_id >= gir_locals.len():
        return false
    return gir_locals.get(local_id).unwrap().owning_param

# closure Phase 2 Step B: the LIR closure-pack promotion (mirrors Rust gg's
# `try_closure_pack`, src/lir/lower/operands.rs:1233-1355). When a
# `__Closure_N`-typed value is assigned into a `GorgetClosure`-typed slot,
# REPLACE the plain copy with: heap-alloc the env via
# `__gorget_closure_env_alloc(size)` + memcpy the STACK env into it +
# IClosurePack(dst_slot, heap_ptr, call_func, false). Returns true when it
# fired (the GIAssign arm then skips the plain store).
#
# Detection: dst's GIR local type name == "GorgetClosure" AND src
# (OpCopy/OpMove operand) GIR local type name starts with "__Closure_".
# This is the typed-name read Rust performs at operands.rs:1293 — the env
# struct name → its `__Closure_N__call` LIR fn is the C-emit-boundary
# name-derived mapping the brief sanctions (no typed cid channel from the
# make-site through to here exists yet; the call fn is resolved via
# func_index by the derived name).
bool try_closure_pack(int dst_local, Operand operand, LirFunction &f, int bb, Vector[int] local_to_slot, Vector[GirLocal] gir_locals, Dict[String, int] func_index, GirModule &gmod, LirModule &m):
    if dst_local < 0 or dst_local >= local_to_slot.len():
        return false
    int dst_slot = local_to_slot.get(dst_local).unwrap()
    # The destination must be the GorgetClosure runtime singleton.
    if dst_local >= gir_locals.len():
        return false
    int dst_tid = gir_locals.get(dst_local).unwrap().type_id
    if gir_type_id_to_base_name(dst_tid, &gmod) != "GorgetClosure":
        return false
    # The source must be an OpCopy/OpMove of a __Closure_N-typed local.
    int src_local = -1
    match operand:
        case OpCopy(sl):
            src_local = sl
        case OpMove(sl):
            src_local = sl
        else:
            return false
    if src_local < 0 or src_local >= gir_locals.len():
        return false
    int src_tid = gir_locals.get(src_local).unwrap().type_id
    String src_name = gir_type_id_to_base_name(src_tid, &gmod)
    if not src_name.starts_with("__Closure_"):
        return false
    # Resolve the __Closure_N__call LIR function index.
    String call_fn_name = src_name + "__call"
    if not func_index.contains(call_fn_name):
        return false
    int call_func = func_index.get(call_fn_name).unwrap()
    # Compute the env size from the source slot's LIR struct type.
    if src_local >= local_to_slot.len():
        return false
    int src_slot = local_to_slot.get(src_local).unwrap()
    int src_slot_ty = f.slots.get(src_slot).unwrap().ty
    int env_size = lir_type_byte_size_in_mod(src_slot_ty, &m, 0)
    # Emit: size_val = const env_size.
    int size_val = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, IIConst(size_val, LT_I64, env_size))
    # Emit: heap_ptr = __gorget_closure_env_alloc(size_val). The runtime
    # provides it as a `static inline` (runtime_string.c) — no forward decl
    # or extern declaration needed.
    int heap_ptr = lir_fn_next_value(&f)
    Vector[int] alloc_args = [size_val]
    Vector[int] alloc_abis = []
    lir_push_inst(&f, bb, ICallExtern(heap_ptr, "__gorget_closure_env_alloc", alloc_args, "__gorget_closure_env_alloc", alloc_abis))
    # Emit: memcpy(heap_ptr, &stack_env, size_val).
    int src_addr = lir_fn_next_value(&f)
    lir_push_inst(&f, bb, ISlotAddr(src_addr, src_slot))
    lir_push_inst(&f, bb, IMemcpy(heap_ptr, src_addr, size_val))
    # Emit: ClosurePack { slot: dst_slot, env_ptr: heap_ptr, call_func }.
    lir_push_inst(&f, bb, IClosurePack(dst_slot, heap_ptr, call_func, false))
    return true

int lower_instruction(Instruction inst, LirFunction &f, int bb, Vector[int] local_to_slot, Vector[GirLocal] gir_locals, Dict[String, int] func_index, GirModule &gmod, Dict[String, int] &sr, LirModule &m):
    match inst:
        case GIAssign(local_id, operand):
            # closure Phase 2 Step B: promote a __Closure_N → GorgetClosure
            # assign into a real heap env-alloc + memcpy + ClosurePack (the
            # `try_closure_pack` equivalent). Must run BEFORE the plain
            # store / OpBorrow-Ptr dispatch — it fully handles the assign.
            if try_closure_pack(local_id, operand, &f, bb, local_to_slot, gir_locals, func_index, &gmod, &m):
                return bb
            # Trait-object construction: `Box[Trait] ← Box[Concrete]`. When the
            # dst is a FAT trait box and the src is a `Box__<Concrete>` value
            # box, build the {data, vtable} fat struct instead of a byte-copy.
            # Mirrors Rust gg's `try_trait_object_construct` (operands.rs:760).
            int ga_src = -1
            match operand:
                case OpCopy(gsl):
                    ga_src = gsl
                case OpMove(gsl):
                    ga_src = gsl
                else:
                    pass
            if ga_src >= 0:
                int ga_dst_slot = local_to_slot.get(local_id).unwrap()
                int ga_src_slot = local_to_slot.get(ga_src).unwrap()
                if try_emit_trait_obj_construct(ga_dst_slot, ga_src_slot, &f, bb, m):
                    return bb
            # D.1 (2026-05-22) — OpBorrow + Ptr-typed-dst + value-typed-src
            # dispatch. The canonical alias shape from B.1's Branch C is
            # `GIAssign(dst, OpBorrow(src))` where the GIR layer tags dst
            # as a borrow alias of src. When dst's slot is Ptr-typed
            # (Branch C retyped per the D.1 follow-up) and src's slot is
            # value-typed (aggregate stored inline), the previous shape
            # `ISlotLoad(src) → ISlotStore(dst)` would byte-copy the
            # aggregate's first 8 bytes into the pointer slot — silently
            # corrupting the alias.
            #
            # Fix: when both conditions match, emit `ISlotAddr(src) →
            # ISlotStore(dst)` instead. The dst slot now holds the address
            # of src's storage; downstream Ptr-typed-slot consumers
            # (GIFieldLoad auto-deref at line ~3164, GICall pass-by-ptr at
            # line ~2602, GICallExtern pass-by-ptr at line ~2891, OpClone
            # short-circuit at line ~2411) all handle Ptr-typed slots
            # correctly, so the alias propagates without further work.
            #
            # Symmetric matches (both Ptr OR both value) keep the byte-copy
            # path — that's the correct shape for both (Ptr→Ptr is pointer
            # copy = alias; value→value is the unconditional byte-copy
            # B.1's pragma already relies on). The OpBorrow operand
            # case-disrcimination is the load-bearing signal: OpCopy /
            # OpMove / OpClone all retain `lower_operand` semantics.
            int slot = local_to_slot.get(local_id).unwrap()
            int slot_ty = f.slots.get(slot).unwrap().ty
            bool dst_is_ptr = (slot_ty == LT_PTR) or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
            bool handled = false
            if dst_is_ptr:
                # Ptr-typed dst receiving a VALUE-typed source: rebind the
                # pointer slot to the source's storage (`dst = &src`) rather
                # than byte-copying the aggregate's first 8 bytes into a
                # pointer slot (which lir_codegen's give-up branch turns into
                # `dst = NULL`).
                #
                # OpBorrow is the canonical alias shape (B.1 Branch C). But
                # the SAME shape arises for OpMove/OpCopy of a value-typed
                # source into a Ptr-typed dst — the loop-carried
                # rebind-pointer-to-new-value pattern. Canonical example:
                # `parse_expr_bp_with_lhs`'s `lhs = self.parse_dot_expr(lhs)`
                # where `lhs` is a `!`-param (Ptr-typed loop var) and the
                # call result is a by-value SpannedExpr. The GIR is
                # `_3 = move _10` (`move_zero` zeros the result temp `_10`);
                # Rust's codegen emits `lhs_ptr = &result` (the back-edge
                # rebind). Without this, the GIAssign stored NULL into the
                # pointer slot, so the next loop iteration passed NULL as the
                # `!`-moved arg → SIGSEGV reading `lhs.span` (TODO #2).
                #
                # OpClone is intentionally NOT routed here: it materialises a
                # fresh owned value via its own deref+clone path, not an
                # alias of an existing slot.
                int rebind_src = -1
                match operand:
                    case OpBorrow(sl):
                        rebind_src = sl
                    case OpMove(sl):
                        rebind_src = sl
                    case OpCopy(sl):
                        rebind_src = sl
                    else:
                        pass
                if rebind_src >= 0 and rebind_src < local_to_slot.len():
                    int src_slot = local_to_slot.get(rebind_src).unwrap()
                    int src_slot_ty = f.slots.get(src_slot).unwrap().ty
                    bool src_is_ptr = (src_slot_ty == LT_PTR) or (src_slot_ty >= LT_PTR_TO_BASE and src_slot_ty < LT_STRUCT_BASE)
                    if lir_slot_is_box(src_slot_ty, m):
                        # BOX src: `Box__T` is `typedef void*`, so the slot
                        # already HOLDS the heap address — the alias is the
                        # slot's VALUE, not its address. `ISlotAddr` here would
                        # produce a pointer to the box variable itself (`T**`),
                        # and every field projection through it would read the
                        # pointer's own bytes as a struct.
                        #
                        # A box slot is struct-KIND (`lir_struct(sid)` with
                        # `type_runtime_map[name] == "Box"`, per
                        # `lir_slot_is_box`), so it lands in the value-typed
                        # branch below unless it is discriminated FIRST. Same
                        # box-slot discrimination the extern arg-prep and
                        # `GIDeref` already perform.
                        int box_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotLoad(box_val, src_slot, LT_PTR))
                        lir_push_inst(&f, bb, ISlotStore(slot, box_val, false))
                        handled = true
                    elif not src_is_ptr:
                        # Value-typed src + Ptr-typed dst: take the
                        # address of src's storage and store it as
                        # the dst's pointer value.
                        int addr_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotAddr(addr_val, src_slot))
                        lir_push_inst(&f, bb, ISlotStore(slot, addr_val, false))
                        handled = true
            if not handled:
                int val = lower_operand(operand, &f, bb, local_to_slot, m)
                lir_push_inst(&f, bb, ISlotStore(slot, val, false))

        case GIBinOp(dst_local, op, ty, lhs_op, rhs_op):
            int lhs = lower_operand(lhs_op, &f, bb, local_to_slot, m)
            int rhs = lower_operand(rhs_op, &f, bb, local_to_slot, m)
            int dst = lir_fn_next_value(&f)
            int lir_ty = map_gir_type(ty, &gmod, &sr)
            if op == OP_ADD:
                lir_push_inst(&f, bb, IAdd(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_SUB:
                lir_push_inst(&f, bb, ISub(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_MUL:
                lir_push_inst(&f, bb, IMul(dst, lir_ty, lhs, rhs, OVF_TRAP))
            elif op == OP_ADD_WRAP:
                lir_push_inst(&f, bb, IAdd(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_SUB_WRAP:
                lir_push_inst(&f, bb, ISub(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_MUL_WRAP:
                lir_push_inst(&f, bb, IMul(dst, lir_ty, lhs, rhs, OVF_WRAP))
            elif op == OP_BITAND:
                lir_push_inst(&f, bb, IBitAnd(dst, lir_ty, lhs, rhs))
            elif op == OP_BITOR:
                lir_push_inst(&f, bb, IBitOr(dst, lir_ty, lhs, rhs))
            elif op == OP_BITXOR:
                lir_push_inst(&f, bb, IBitXor(dst, lir_ty, lhs, rhs))
            elif op == OP_SHL:
                lir_push_inst(&f, bb, IShl(dst, lir_ty, lhs, rhs))
            elif op == OP_SHR:
                lir_push_inst(&f, bb, IShr(dst, lir_ty, lhs, rhs))
            elif op == OP_DIV:
                lir_push_inst(&f, bb, IDiv(dst, lir_ty, lhs, rhs))
            elif op == OP_REM:
                lir_push_inst(&f, bb, IRem(dst, lir_ty, lhs, rhs))
            elif op == OP_MOD:
                lir_push_inst(&f, bb, IMod(dst, lir_ty, lhs, rhs))
            # Store result
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GIFaultCheck(dst_local, op, ty, lhs_op, rhs_op):
            # Fault-catch checked arithmetic (error-model.md §11.2): emit the
            # bool FLAG (no trap, no result commit) → store into the flag local.
            # The enclosing block's GTBranch (set at GIR build) reads the flag.
            int fc_lhs = lower_operand(lhs_op, &f, bb, local_to_slot, m)
            int fc_rhs = lower_operand(rhs_op, &f, bb, local_to_slot, m)
            int fc_dst = lir_fn_next_value(&f)
            int fc_ty = map_gir_type(ty, &gmod, &sr)
            lir_push_inst(&f, bb, IFaultCheck(fc_dst, op, fc_ty, fc_lhs, fc_rhs))
            int fc_dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(fc_dst_slot, fc_dst, false))

        case GIUnOp(dst_local, op, ty, operand):
            int val = lower_operand(operand, &f, bb, local_to_slot, m)
            int dst = lir_fn_next_value(&f)
            int lir_ty = map_gir_type(ty, &gmod, &sr)
            if op == UNOP_NEG:
                lir_push_inst(&f, bb, INeg(dst, lir_ty, val))
            elif op == UNOP_NOT:
                lir_push_inst(&f, bb, INot(dst, val))
            elif op == UNOP_BITNOT:
                lir_push_inst(&f, bb, IBitNot(dst, lir_ty, val))
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICmp(dst_local, op, ty, lhs_op, rhs_op):
            int lhs = lower_operand(lhs_op, &f, bb, local_to_slot, m)
            int rhs = lower_operand(rhs_op, &f, bb, local_to_slot, m)
            int dst = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ICmp(dst, op, lhs, rhs))
            int dst_slot = local_to_slot.get(dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICall(dst_local, func_name, args):
            # Canonical prelude variant constructors: Some/None/Ok/Error fill
            # the dst slot in place via IEnumInit. Struct id comes from the
            # slot's type — no codegen-side name inference needed.
            if try_lower_prelude_variant(func_name, dst_local, args, &f, bb, local_to_slot, m):
                return bb
            # Canonical user struct constructors — emits IStructInit with
            # per-field memcpy for struct-typed fields, fixing the stage-1
            # SEGV where inline struct literals cast a by-pointer arg into
            # a struct-typed field.
            if try_lower_user_struct_ctor(func_name, dst_local, args, &f, bb, local_to_slot, sr, m):
                return bb
            # Canonical Box(x): emit IBoxAlloc with explicit inner_ty (unwrapped
            # from the operand's pointer-to-struct type if needed) so downstream
            # Some(Box(x)) resolves to Option__Box__T, not Option__GorgetString.
            if func_name == "Box" and args.len() == 1 and dst_local >= 0:
                emit_box_alloc(dst_local, args.get(0).unwrap(), &f, bb, local_to_slot, &sr, &m)
                return bb
            # Trait-object dispatch: `Box__<Trait>__<method>(self, ...)`. The
            # generic call path below emits the call UNCHANGED (fat trait-box
            # passed by value); this records a request so codegen emits the
            # thunk that DEFINES the symbol. Non-trait-box names no-op.
            bool _td_recorded = try_record_trait_dispatch(func_name, dst_local, &m, &gmod, &sr)
            # Lower call arguments — check function param types for Ptr(T) params.
            # User functions with resource-type bare params receive Ptr(T),
            # so the caller must pass SlotAddr (pointer) instead of SlotLoad (value).
            Vector[int] fn_param_tys = get_fn_param_types(func_name, gmod)
            # Effective runtime name (post map_runtime_name) so the
            # `needs_ptr_arg` runtime ABI table is consulted here too — the
            # extern-by-value declaration of a runtime fn (e.g.
            # `extern "C" String __bytes_to_str_raw(Vector[uint8])` →
            # `gorget_bytes_to_str(const GorgetArray*)`) has a by-value GIR
            # param type, so `is_ptr_type` alone would pass the array by value
            # and cc rejects it. Mirrors the GICallExtern arm (line ~2993).
            String gic_eff_name = func_name
            String gic_mapped = map_runtime_name(func_name, &m, &gmod)
            if gic_mapped != "":
                gic_eff_name = gic_mapped
            Vector[int] lir_args = []
            int ai = 0
            while ai < args.len():
                Operand arg = args.get(ai).unwrap()
                # Check if this param is a pointer type in the function signature
                bool pass_by_ptr = false
                if ai < fn_param_tys.len():
                    int pty = fn_param_tys.get(ai).unwrap()
                    if is_ptr_type(pty, gmod):
                        pass_by_ptr = true
                if not pass_by_ptr and needs_ptr_arg(gic_eff_name, ai):
                    pass_by_ptr = true
                if pass_by_ptr:
                    match arg:
                        case OpCopy(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                # Slot already holds a pointer (incl. a Box,
                                # which is `typedef void*` even though its slot
                                # type is `>= LT_STRUCT_BASE`) — load the pointer
                                # value, NOT `&slot`. Passing `&slot` for a Box
                                # param sends the box-slot ADDRESS (`void**`) so
                                # `*b` in the callee reads garbage → segfault
                                # (snag41_audit_box_string_deref).
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpMove(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpClone(local_id):
                            # P0 Bug B (fold the siblings): route through the
                            # SHARED by-ptr clone helper so a ptr-to-struct
                            # source DEREFS to the pointee struct type and
                            # CLONES (independent owned copy) — same as the
                            # GICallExtern twin. Before the fold this arm passed
                            # the raw aliased pointer for a ptr-to-struct source
                            # (resource_clone_fn requires `>= LT_STRUCT_BASE`),
                            # so a borrowed resource consumed into a USER fn's
                            # owning Ptr param ALIASED instead of cloning.
                            lir_args.push(lower_clone_arg_by_ptr(arg, local_id, &f, bb, local_to_slot, m))
                        case OpBorrow(local_id):
                            # Phase D step 3: borrow → always pass slot
                            # address (the canonical borrow shape).
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                # Box / pointer-holding slot — pass the pointer
                                # value, not `&slot` (see the OpCopy arm above).
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        else:
                            int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                            lir_args.push(arg_val)
                else:
                    int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                    lir_args.push(arg_val)
                ai += 1

            # Check if it's a known function
            if func_index.contains(func_name):
                int func_id = func_index.get(func_name).unwrap()
                int dst = -1
                if dst_local >= 0:
                    dst = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, ICall(dst, func_id, lir_args))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))
            else:
                # Extern or runtime call
                String mapped = map_runtime_name(func_name, &m, &gmod)
                String call_name = func_name
                if mapped != "":
                    call_name = mapped
                # Float-arg dispatch: gorget_abs/gorget_min/gorget_max → float variants
                # when any GIR arg's slot is LT_F64/LT_F32. Mirrors Rust gg
                # `src/lir/lower/insts.rs:505-517`.
                if call_name == "gorget_abs" or call_name == "gorget_min" or call_name == "gorget_max":
                    bool has_float_arg = false
                    for fad_op in args:
                        int fad_lid = -1
                        match fad_op:
                            case OpCopy(fl):
                                fad_lid = fl
                            case OpMove(fl):
                                fad_lid = fl
                            case OpClone(fl):
                                fad_lid = fl
                            case OpBorrow(fl):
                                fad_lid = fl
                            else:
                                pass
                        if fad_lid >= 0 and fad_lid < local_to_slot.len():
                            int fad_slot = local_to_slot.get(fad_lid).unwrap()
                            if fad_slot >= 0 and fad_slot < f.slots.len():
                                int fad_ty = f.slots.get(fad_slot).unwrap().ty
                                if fad_ty == LT_F64 or fad_ty == LT_F32:
                                    has_float_arg = true
                    if has_float_arg:
                        if call_name == "gorget_abs":
                            call_name = "gorget_fabs"
                        elif call_name == "gorget_min":
                            call_name = "gorget_fmin"
                        elif call_name == "gorget_max":
                            call_name = "gorget_fmax"
                # Collection constructors need element size argument(s)
                if is_collection_constructor(func_name, m, &gmod):
                    # Phase A: dispatch on type_runtime_map category; avoids starts_with.
                    String coll_cat2 = type_category_for_name(func_name, m)
                    if coll_cat2 == "GorgetMap":
                        # Dict/Map: need key_size + val_size, or just val_size for _str variant
                        String key_ty = coll_key_type_for_name(func_name, m)
                        String val_ty = coll_val_type_for_name(func_name, m)
                        if is_string_keyed(func_name, m):
                            # _str variant: only val_size
                            int val_size = type_elem_size_in_mod(val_ty, sr, &m)
                            int vs = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(vs, LT_I64, val_size))
                            lir_args.push(vs)
                        else:
                            int key_size = type_elem_size_in_mod(key_ty, sr, &m)
                            int val_size = type_elem_size_in_mod(val_ty, sr, &m)
                            int ks = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(ks, LT_I64, key_size))
                            lir_args.push(ks)
                            int vs = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(vs, LT_I64, val_size))
                            lir_args.push(vs)
                    elif coll_cat2 == "GorgetSet":
                        # Set: _str variant takes 0 args, non-str takes 1 (elem_size)
                        if not is_string_keyed(func_name, m):
                            int elem_size = collection_elem_size_in_mod(func_name, sr, &m)
                            int size_val = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(size_val, LT_I64, elem_size))
                            lir_args.push(size_val)
                        # else: _str variant, no args needed
                    else:
                        # Vector, Deque, Channel, Shared: 1 arg (elem_size).
                        # Shared is special: size comes FIRST and init_data is
                        # a pointer; handled below via arg reordering.
                        int elem_size = collection_elem_size_in_mod(func_name, sr, &m)
                        int size_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, IIConst(size_val, LT_I64, elem_size))
                        lir_args.push(size_val)
                # Concurrency ctor re-ordering: gorget_{shared,mutex,rwlock}_new(size, &val).
                # The runtime ABI is `gorget_<kind>_new(size_t size, void* init)` —
                # so the final args are `[sizeof(T), &init_val]`.
                # SIBLING-SITE FIX (was `gorget_shared_new`-only): Mutex/RWLock
                # share the identical (size, &init) runtime ABI — Rust handles all
                # three uniformly at `src/lir/lower/insts.rs:3437-3446`
                # (`matches!(emit_name, "gorget_mutex_new" | "gorget_shared_new" |
                # "gorget_rwlock_new")`). Phase A: dispatch on the MAPPED call_name.
                #
                # Two callers reach here with different `lir_args` shapes:
                #   • bare `Shared__T`     → is_collection_constructor TRUE  →
                #     size already APPENDED above → lir_args = [val, size].
                #   • `Mutex__T__new` /    → is_collection_constructor FALSE →
                #     `RWLock__T__new`        no size appended → lir_args = [val].
                # Normalise both to `[size, &val]` by computing the size from
                # `func_name` (the UNMAPPED ctor name) via concurrency_elem_size
                # when it was not already appended (mirrors Rust reading
                # `original_name` for `concurrency_elem_size`).
                if (call_name == "gorget_shared_new" or call_name == "gorget_mutex_new" or call_name == "gorget_rwlock_new") and args.len() >= 1 and lir_args.len() >= 1:
                    # Find the caller's user-arg 0 source (GIR arg 0, OpCopy/OpMove)
                    Operand user0 = args.get(0).unwrap()
                    int src_slot = -1
                    match user0:
                        case OpCopy(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpMove(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpClone(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        case OpBorrow(lid):
                            src_slot = local_to_slot.get(lid).unwrap()
                        else:
                            pass
                    if src_slot >= 0:
                        int addr_val = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotAddr(addr_val, src_slot))
                        int size_val_cc = -1
                        if lir_args.len() >= 2:
                            # Size already appended (bare `Shared__T` collection-ctor path).
                            size_val_cc = lir_args.get(lir_args.len() - 1).unwrap()
                        else:
                            # `__new` path: no size appended — compute it from the
                            # UNMAPPED ctor name (e.g. `Mutex__int64_t__new`).
                            int cc_sz = concurrency_elem_size_in_mod(func_name, sr, &m)
                            size_val_cc = lir_fn_next_value(&f)
                            lir_push_inst(&f, bb, IIConst(size_val_cc, LT_I64, cc_sz))
                        Vector[int] new_args = [size_val_cc, addr_val]
                        lir_args = new_args
                int dst = -1
                if dst_local >= 0:
                    dst = lir_fn_next_value(&f)
                Vector[int] empty_abis = []
                lir_push_inst(&f, bb, ICallExtern(dst, call_name, lir_args, func_name, empty_abis))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GICallExtern(dst_local, func_name, args):
            # Canonical prelude variants (same as GICall arm).
            if try_lower_prelude_variant(func_name, dst_local, args, &f, bb, local_to_slot, m):
                return bb
            # Trait-object dispatch: record the thunk request (same as GICall
            # arm). The call is emitted UNCHANGED below; codegen emits the thunk.
            bool _tde_recorded = try_record_trait_dispatch(func_name, dst_local, &m, &gmod, &sr)
            # Function-as-value pseudo-intrinsic: `__fn_addr__<name>` —
            # emitted by `lower_expr`'s EIdentifier arm when the
            # identifier resolves to a known function. Convert into an
            # `IFuncAddr(dst, fid)` so the C codegen emits the
            # `static void* __fa_X[] = { (void*)__adapt_<name>, NULL }`
            # callable shape. Mirrors Rust gg's `Constant::FuncRef`
            # → `IFuncAddr` lowering. The `__fn_addr__` prefix is
            # 12 chars; the rest is the target function name.
            if func_name.starts_with("__fn_addr__") and dst_local >= 0:
                String fa_target = func_name.slice(11, func_name.len())
                if func_index.contains(fa_target):
                    int fa_fid = func_index.get(fa_target).unwrap()
                    int fa_dst = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, IFuncAddr(fa_dst, fa_fid))
                    int fa_dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(fa_dst_slot, fa_dst, false))
                    return bb
            # Module-level static reference: `__global_ref__<name>` —
            # emitted by `lower_static_ref_ident` when the identifier is
            # registered in `gmod.static_keys`. Locate the matching
            # `LirGlobal` in `m.globals` (populated in `lower_gir_to_lir`
            # before functions are lowered) and emit `IGlobalAddr(dst,
            # gid)`. Mirrors Rust gg's `Constant::GlobalRef(name)` →
            # `IGlobalAddr` lowering. Prefix is "__global_ref__" (14
            # chars).
            if func_name.starts_with("__global_ref__") and dst_local >= 0:
                String gr_target = func_name.slice(14, func_name.len())
                int gr_gid = -1
                int gr_global_ty = LT_VOID
                int gr_init_kind = -1
                # CoW for-element BORROW scan (no LirGlobal__clone): reads
                # gr_g.name / gr_g.ty / gr_g.init_kind only; enumerate()
                # preserves the global index gri.
                for (gri, gr_g) in m.globals.enumerate():
                    if gr_g.name == gr_target:
                        gr_gid = gri
                        gr_global_ty = gr_g.ty
                        gr_init_kind = gr_g.init_kind
                if gr_gid >= 0:
                    int gr_dst = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, IGlobalAddr(gr_dst, gr_gid))
                    int gr_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int gr_dst_slot_ty = f.slots.get(gr_dst_slot).unwrap().ty
                    # `IGlobalAddr` yields the global's ADDRESS. The reader of a
                    # `GlobalRef` sometimes wants the VALUE (load) and sometimes
                    # the ADDRESS (no load). Mirrors Rust gg's `Constant::GlobalRef`
                    # → GlobalAddr+Load vs `GlobalRefPtr` → GlobalAddr-only
                    # (src/lir/lower/operands.rs:128-134). The self-host has no
                    # GlobalRef/GlobalRefPtr split, so we reconstruct the intent
                    # from two TYPED facts (devbook/24, no name test):
                    #
                    #   (1) SCALAR VALUE READ — `float INFINITY` / a `print(count)`
                    #       read of `static int count`. The dst SLOT is the scalar
                    #       value (`lir_is_scalar(slot_ty) and not ptr-kind`); load
                    #       the scalar. WRITE TARGETS (`count = count + 1`) reuse
                    #       the same `__global_ref__` but land in a PTR-kind dst
                    #       slot (the slot holds `&__lir_gN` to store through), so
                    #       `not gr_slot_is_ptr_kind` correctly SKIPS the load there
                    #       — loading would emit `*(T*)value = …` (store through a
                    #       value, not a pointer → cc-fail / crash). This is the
                    #       ORIGINAL gate, preserved verbatim.
                    #
                    #   (2) POINTER-HANDLE VALUE READ — a RUNTIME-ALLOCATED opaque
                    #       sync handle (`static AtomicInt counter` → the GLOBAL is
                    #       declared `void* __lir_gN`, GINIT_RUNTIME_CALL). The dst
                    #       slot is PTR-kind (it receives the handle for
                    #       `counter.add(1)`); the global HOLDS the handle pointer,
                    #       so load it — passing `&__lir_gN` (a `GorgetAtomicInt**`)
                    #       would mangle `int64_t__add` / cc-fail. Gated on the
                    #       GLOBAL's OWN type being a pointer AND GINIT_RUNTIME_CALL,
                    #       which separates a sync handle from a `&self`-method
                    #       receiver on a STRUCT global (`static File stdout` /
                    #       `static Counter c` — those globals are aggregate STRUCTS,
                    #       `lir_is_ptr(global_ty)` is false, so NO load; the slot
                    #       already holds `&__lir_gN`, the correct receiver address).
                    bool gr_slot_is_ptr_kind = (gr_dst_slot_ty == LT_PTR) or (gr_dst_slot_ty >= LT_PTR_TO_BASE and gr_dst_slot_ty < LT_STRUCT_BASE)
                    bool gr_global_is_ptr = (gr_global_ty == LT_PTR) or (gr_global_ty >= LT_PTR_TO_BASE and gr_global_ty < LT_STRUCT_BASE)
                    bool gr_do_load = false
                    int gr_load_ty = gr_dst_slot_ty
                    if lir_is_scalar(gr_dst_slot_ty) and not gr_slot_is_ptr_kind:
                        # (1) scalar value read — load the scalar value.
                        gr_do_load = true
                    elif gr_slot_is_ptr_kind and gr_global_is_ptr and gr_init_kind == GINIT_RUNTIME_CALL:
                        # (2) runtime-allocated pointer handle — load the handle.
                        gr_do_load = true
                    if gr_do_load:
                        int gr_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ILoad(gr_loaded, gr_dst, gr_load_ty))
                        lir_push_inst(&f, bb, ISlotStore(gr_dst_slot, gr_loaded, false))
                    else:
                        lir_push_inst(&f, bb, ISlotStore(gr_dst_slot, gr_dst, false))
                    return bb
            # Canonical Box(x): emit IBoxAlloc, same as in GICall.
            if func_name == "Box" and args.len() == 1 and dst_local >= 0:
                emit_box_alloc(dst_local, args.get(0).unwrap(), &f, bb, local_to_slot, &sr, &m)
                return bb
            # A DEFINED user function (present in func_index) ALWAYS wins over
            # the runtime-symbol remap — mirrors Rust gg
            # `src/lir/lower/insts.rs:533` (the `func_index.get(func)`
            # direct-call branch precedes the map_monomorphized_to_runtime
            # fallback) AND the GICall twin's func_index check (~line 4069).
            # Without this, a USER equip method whose mangled name collides with
            # a runtime family PREFIX — `equip String: … my_len` →
            # `GorgetString__my_len`, caught by the `MkPrefix("GorgetString__")`
            # family — is wrongly rewritten to the nonexistent builtin
            # `gorget_str_my_len` (undefined-ref / wrong Result-vs-int ABI).
            # Builtins (`GorgetString__len`, `gorget_str_*`) have NO func_index
            # entry, so they still remap; only user-defined bodies are protected.
            bool _gce_is_user_fn = func_index.contains(func_name)
            String mapped_early = ""
            if not _gce_is_user_fn:
                mapped_early = map_runtime_name(func_name, &m, &gmod)
            String effective_name = func_name
            if mapped_early != "":
                effective_name = mapped_early
            # Look up function param types for Ptr(T) detection (user struct methods)
            Vector[int] ext_param_tys = get_fn_param_types(func_name, gmod)
            Vector[int] lir_args = []
            int ai = 0
            while ai < args.len():
                Operand arg = args.get(ai).unwrap()
                # Check runtime ptr-passing table OR function param type
                bool need_ptr = needs_ptr_arg(effective_name, ai)
                if not need_ptr and ai < ext_param_tys.len():
                    int pty = ext_param_tys.get(ai).unwrap()
                    if is_ptr_type(pty, gmod):
                        need_ptr = true
                if need_ptr:
                    match arg:
                        case OpCopy(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            # If the slot already holds a pointer (e.g. `&self`
                            # params lowered as void*/Ptr-to-struct, OR a Box —
                            # `typedef void*` though its slot type is
                            # `>= LT_STRUCT_BASE`), LOAD the pointer value instead
                            # of taking the slot's address — otherwise downstream
                            # `(T*)&__slot` reads slot storage as a struct and
                            # gets stack garbage (the Box-as-param segfault class).
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpMove(local_id):
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        case OpClone(local_id):
                            # P0 Bug B (fold the siblings): the GICall twin now
                            # routes through this SAME shared helper. A by-ptr
                            # runtime arg needs an addressable lvalue; the helper
                            # derefs a ptr-to-struct source to the pointee type,
                            # clones via `lower_operand`, materialises into a
                            # fresh temp slot, and passes its ADDRESS (the runtime
                            # memcpy's the owned bytes into storage, leaving the
                            # borrow source untouched — no double-free, the whole
                            # point of clone-on-borrow at a consuming position).
                            lir_args.push(lower_clone_arg_by_ptr(arg, local_id, &f, bb, local_to_slot, m))
                        case OpBorrow(local_id):
                            # Phase D step 3: borrow → slot address shape.
                            int slot = local_to_slot.get(local_id).unwrap()
                            int slot_ty = f.slots.get(slot).unwrap().ty
                            if slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE) or lir_slot_is_box(slot_ty, m):
                                int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                                lir_args.push(arg_val)
                            else:
                                int addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                                lir_args.push(addr)
                        else:
                            int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                            lir_args.push(arg_val)
                else:
                    int arg_val = lower_operand(arg, &f, bb, local_to_slot, m)
                    lir_args.push(arg_val)
                ai += 1
            # Same func_index-first guard as the `mapped_early` site above
            # (sibling completeness — a user fn is never remapped to a runtime
            # symbol at either remap point).
            String mapped = ""
            if not _gce_is_user_fn:
                mapped = map_runtime_name(func_name, &m, &gmod)
            String call_name = func_name
            if mapped != "":
                call_name = mapped
            # String.push / push_char / push_line value-type dispatch. The Str-ABI
            # variants (gorget_string_push_char / gorget_str_push_line) carry a
            # `Str` arg, so a bool/int/float value must route to the typed runtime
            # variant or its value gets zeroed to `(Str){0}` at codegen. Mirrors
            # Rust gg `src/lir/lower/insts.rs:4357-4387` (gorget_str_push tier-3b).
            if (call_name == "gorget_string_push_char" or call_name == "gorget_str_push_line") and args.len() == 2:
                bool spd_is_line = call_name == "gorget_str_push_line"
                int spd_lid = -1
                match args.get(1).unwrap():
                    case OpCopy(spl):
                        spd_lid = spl
                    case OpMove(spl):
                        spd_lid = spl
                    case OpClone(spl):
                        spd_lid = spl
                    case OpBorrow(spl):
                        spd_lid = spl
                    else:
                        pass
                if spd_lid >= 0 and spd_lid < local_to_slot.len():
                    int spd_slot = local_to_slot.get(spd_lid).unwrap()
                    if spd_slot >= 0 and spd_slot < f.slots.len():
                        int spd_ty = f.slots.get(spd_slot).unwrap().ty
                        if spd_ty == LT_BOOL:
                            if spd_is_line:
                                call_name = "gorget_string_push_line_bool"
                            else:
                                call_name = "gorget_string_push_bool"
                        elif spd_ty == LT_F64 or spd_ty == LT_F32:
                            if spd_is_line:
                                call_name = "gorget_string_push_line_float"
                            else:
                                call_name = "gorget_string_push_float"
                        elif spd_ty == LT_I8 or spd_ty == LT_I16 or spd_ty == LT_I32 or spd_ty == LT_I64 or spd_ty == LT_U8 or spd_ty == LT_U16 or spd_ty == LT_U32 or spd_ty == LT_U64:
                            if spd_is_line:
                                call_name = "gorget_string_push_line_int"
                            else:
                                call_name = "gorget_string_push_int"
            # Post-mapping fixups: append extra args for functions that need them.
            if call_name == "gorget_array_contains":
                int es = extract_elem_size_from_name_in_mod(func_name, sr, &m)
                int esv = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, IIConst(esv, LT_I64, es))
                lir_args.push(esv)
            # gorget_guard_set(g, &val, size) / gorget_write_guard_set: append
            # sizeof(elem) as the 3rd arg (the runtime memcpy's `size` bytes).
            # arg 0 (guard) + arg 1 (value) already passed by-address via
            # needs_ptr_arg. The elem size comes from the UNMAPPED `func_name`
            # (`Guard__int64_t__set`). Mirrors Rust insts.rs:3463.
            if call_name == "gorget_guard_set" or call_name == "gorget_write_guard_set":
                int ges = concurrency_elem_size_in_mod(func_name, sr, &m)
                int gesv = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, IIConst(gesv, LT_I64, ges))
                lir_args.push(gesv)
            # gorget_channel_recv(ch, &out): needs output slot address as 2nd arg.
            # gorget_channel_recv_timeout(ch, &out, timeout_ms): needs output + timeout.
            if call_name == "gorget_channel_recv" or call_name == "gorget_channel_try_recv":
                if dst_local >= 0:
                    int out_slot = local_to_slot.get(dst_local).unwrap()
                    int out_addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(out_addr, out_slot))
                    lir_args.push(out_addr)
            # Callable dispatch: emit ICallClosure with correct return type
            if call_name.starts_with("__callable_") or call_name.starts_with("__gorget_closure_call_"):
                int cl_dst = -1
                if dst_local >= 0:
                    cl_dst = lir_fn_next_value(&f)
                # Determine return type from the destination local's type
                int cl_ret = LT_I64
                if dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    cl_ret = f.slots.get(dst_slot).unwrap().ty
                # First arg is the callable, rest are call args
                int cl_closure = lir_args.get(0).unwrap()
                Vector[int] cl_call_args = []
                int cli = 1
                while cli < lir_args.len():
                    cl_call_args.push(lir_args.get(cli).unwrap())
                    cli += 1
                Vector[int] cl_abis = []
                # kind=0 means CallableParam (void*[2] protocol)
                lir_push_inst(&f, bb, ICallClosure(cl_dst, 0, cl_closure, cl_call_args, cl_abis, cl_ret))
                if cl_dst >= 0 and dst_local >= 0:
                    int cl_dst_slot = local_to_slot.get(dst_local).unwrap()
                    lir_push_inst(&f, bb, ISlotStore(cl_dst_slot, cl_dst, false))
            else:
                # Tier 1 lift: collection void* → Option wrap. Mirrors
                # src/lir/lower/lifts.rs::emit_void_ptr_option_wrap.
                #
                # EXCLUDE the EIndex-exclusive raw getters (`gorget_array_get`/
                # `gorget_map_get`, keyed on the UNMAPPED `func_name` — a `.get()`
                # arrives as `gorget_array_safe_get` / mapped from `Dict__K__V__get`,
                # never these raw symbols). For `vec[i]` the dst Option-ness means the
                # *element type* is `Option[T]`, NOT that we must wrap a nullable
                # pointer: wrapping here reads only `*(int64_t*)ptr` (the tag) and
                # rebuilds a bogus `Some(tag)`, so every `Vector[Option[T]]` index
                # read collapsed to `Some(0)` (test_if_expressions / _collections_nested /
                # _vector_edge_cases). Skipping the lift lets EIndex fall through to
                # the unified is_ptr_ret aggregate `*(StructT*)(void*)` ILoad copy-out.
                bool eix_raw_get_lift = (func_name == "gorget_array_get") or (func_name == "gorget_map_get")
                if dst_local >= 0 and is_collection_void_return(call_name) and not eix_raw_get_lift:
                    int lift_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int lift_slot_ty = f.slots.get(lift_dst_slot).unwrap().ty
                    if lift_slot_ty >= LT_STRUCT_BASE:
                        int lift_opt_sid = lift_slot_ty - LT_STRUCT_BASE
                        if lift_opt_sid < m.structs.len():
                            LirStructDef lift_opt_def = m.structs.get(lift_opt_sid).unwrap()
                            if lift_opt_def.enum_kind == EK_OPTION:
                                # CoW: read the GIR result's ownership tag —
                                # a LoBorrowed/LoView get-result aliases the
                                # collection element and must NOT clone (the
                                # for-element clone bomb). Tag set at the get
                                # site in lower.gg (typed check via
                                # option_ref_payload_of / lower_for_vector's
                                # BoCollectionElement).
                                bool wrap_is_borrow = gir_local_is_for_element(dst_local, gir_locals)
                                int new_bb = emit_void_ptr_option_wrap(call_name, dst_local, lift_opt_sid, lir_args, &f, bb, local_to_slot, &m, wrap_is_borrow)
                                return new_bb
                # Nullable-ptr → Option wrap for `Weak[T].upgrade()`. The typed
                # `Weak__<T>__upgrade` wrapper returns a `Shared__<T>` pointer (alive)
                # or NULL (dead) — wrap `ptr ? Some(ptr) : None`. Mirrors Rust gg's
                # is_nullable_ptr_fn_lir + emit_nullable_ptr_option_wrap (lifts.rs:44/617).
                # Reuses emit_void_ptr_option_wrap: the Some_0 payload is a Ptr
                # (`Shared__<T>`), so its payload_is_ptr path stores the raw pointer
                # directly (no clone, no deref) — exactly the Rust EnumInit shape.
                if dst_local >= 0 and is_nullable_ptr_fn(call_name):
                    int nu_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int nu_slot_ty = f.slots.get(nu_dst_slot).unwrap().ty
                    if nu_slot_ty >= LT_STRUCT_BASE:
                        int nu_opt_sid = nu_slot_ty - LT_STRUCT_BASE
                        if nu_opt_sid < m.structs.len():
                            LirStructDef nu_opt_def = m.structs.get(nu_opt_sid).unwrap()
                            if nu_opt_def.enum_kind == EK_OPTION:
                                int nu_new_bb = emit_void_ptr_option_wrap(call_name, dst_local, nu_opt_sid, lir_args, &f, bb, local_to_slot, &m, false)
                                return nu_new_bb
                # Scalar sentinel → Option wrap: index_of/find return a raw i64
                # sentinel (-1 == not found) that the §1 type flip typed as
                # Option[int]. Wrap `raw >= 0 ? Some(raw) : None`. Mirrors the
                # ptr-sentinel sibling above; obtains the Option__int64_t sid
                # the same way (from the EK_OPTION dst slot type).
                if dst_local >= 0 and is_sentinel_scalar_method(call_name):
                    int scal_dst_slot = local_to_slot.get(dst_local).unwrap()
                    int scal_slot_ty = f.slots.get(scal_dst_slot).unwrap().ty
                    if scal_slot_ty >= LT_STRUCT_BASE:
                        int scal_opt_sid = scal_slot_ty - LT_STRUCT_BASE
                        if scal_opt_sid < m.structs.len():
                            LirStructDef scal_opt_def = m.structs.get(scal_opt_sid).unwrap()
                            if scal_opt_def.enum_kind == EK_OPTION:
                                int scal_new_bb = emit_sentinel_scalar_option_wrap(call_name, dst_local, scal_opt_sid, lir_args, &f, bb, local_to_slot, &m)
                                return scal_new_bb
                int dst = -1
                if dst_local >= 0:
                    # For channel recv, the result is written to the slot directly via &out.
                    # Don't create a value destination — the call returns void.
                    if call_name != "gorget_channel_recv" and call_name != "gorget_channel_try_recv":
                        dst = lir_fn_next_value(&f)
                # Build per-arg ABI tags. Empty unless an out-param is present
                # (out_param_arg): then a full-length vector tags ABI_OUT_PTR at
                # the out-param positions (ABI_AUTO elsewhere) so drop-elab
                # recognizes the callee-initialized pointee slot (#11). The
                # abi positions align with `lir_args` 1:1 for the iter accessors
                # (no fixup appends args for them).
                Vector[int] call_abis = []
                bool has_out_param = false
                int abi_i = 0
                while abi_i < lir_args.len():
                    if out_param_arg(effective_name, abi_i):
                        call_abis.push(ABI_OUT_PTR)
                        has_out_param = true
                    else:
                        call_abis.push(ABI_AUTO)
                    abi_i += 1
                if not has_out_param:
                    call_abis = []
                lir_push_inst(&f, bb, ICallExtern(dst, call_name, lir_args, func_name, call_abis))
                if dst >= 0 and dst_local >= 0:
                    int dst_slot = local_to_slot.get(dst_local).unwrap()
                    int dst_slot_ty = f.slots.get(dst_slot).unwrap().ty
                    # Pointer-returning runtime calls (`gorget_array_safe_get`,
                    # `gorget_guard_get`, EIndex `gorget_array_get` /
                    # `gorget_map_get`, etc.) return a void* pointing at the
                    # element. When the GIR caller typed the result slot as
                    # the element type itself (scalar *or* aggregate —
                    # `GorgetArray` / `Str` / `GorgetMap` from Guard.get, or
                    # a by-value struct from EIndex), emit an explicit ILoad
                    # to dereference the pointer into that type before the
                    # SlotStore. A bare SlotStore of void* into a non-ptr
                    # slot is a C type error (aggregate) or a silent value
                    # corruption (scalar — the `bb = &block_map[i]` bug).
                    # Codegen-side fixes don't survive SSA scalar-slot
                    # promotion. Unified under `returns_ptr_to_element` (which
                    # already lists guard getters + array/map getters) —
                    # do NOT gate the aggregate arm on an EIndex-only name
                    # list; Guard.get aggregates need the same `*(T*)ptr`
                    # copy-out as EIndex (Round XVI Track 3A / R-GET).
                    # Pure pointer-typed slots keep the raw void* (no ILoad).
                    bool is_ptr_ret = returns_ptr_to_element(call_name)
                    bool slot_is_ptr_kind = (dst_slot_ty == LT_PTR) or (dst_slot_ty >= LT_PTR_TO_BASE and dst_slot_ty < LT_STRUCT_BASE)
                    if is_ptr_ret and not slot_is_ptr_kind and (lir_is_scalar(dst_slot_ty) or lir_is_aggregate(dst_slot_ty)):
                        int loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ILoad(loaded, dst, dst_slot_ty))
                        lir_push_inst(&f, bb, ISlotStore(dst_slot, loaded, false))
                    else:
                        lir_push_inst(&f, bb, ISlotStore(dst_slot, dst, false))

        case GIDrop(local_id):
            # Unconditional drop: resolve the local's type → drop fn via the
            # typed `drop_fn_for_type` accessor (which reads the populated
            # `type_runtime_map` + `resource_types` metadata, *not* the
            # name), then emit `<drop_fn>(&slot)`. Primitives / non-resource
            # types return "" and the arm becomes a no-op — `drop_fn_for_type`
            # is the single source of truth for whether a type owns
            # droppable data, mirroring Rust's `DropStrategy` lookup in
            # `src/lir/lower/drops.rs::lower_drop`.
            String drop_tn = gir_local_type_name(local_id, gir_locals, &gmod)
            if drop_tn != "":
                String drop_fn = drop_fn_for_type(drop_tn, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                if drop_fn != "":
                    int slot = local_to_slot.get(local_id).unwrap()
                    # Drop-fn arg. The default is `&slot` (ISlotAddr): a by-value
                    # local's slot holds the value and `T__drop(&slot)` /
                    # `gorget_guard_release(&slot)` (inline 16-byte guard) want the
                    # slot ADDRESS. But a PTR-HANDLE runtime (Ptr/Box, e.g.
                    # `Channel__T`) stores the handle pointer IN the slot, and its
                    # runtime drop (`gorget_channel_release(GorgetChannel*)` /
                    # `free(void*)`) wants that handle BY VALUE — passing `&slot`
                    # (a `T**`) frees/releases the stack-slot address →
                    # `munmap_chunk(): invalid pointer` SIGABRT. Load the slot and
                    # pass the value, mirroring (1) the GIDropIfAlive arm's
                    # dia_owns_ptr/dia_is_box ISlotLoad below and (2) Rust's
                    # Trivial("free") SlotLoad (drops.rs:209-217). Gated on the
                    # TYPED runtime category + PvOwnedPtr provenance — never a
                    # slot-shape or name heuristic.
                    bool drop_loads_value = false
                    if m.type_runtime_map.contains(drop_tn):
                        String drop_rt = m.type_runtime_map.get(drop_tn).unwrap_or("")
                        if drop_rt == "Ptr" or drop_rt == "Box":
                            drop_loads_value = true
                    if not drop_loads_value and slot >= 0 and slot < f.slot_provenance.len():
                        match f.slot_provenance.get(slot).unwrap():
                            case PvOwnedPtr():
                                drop_loads_value = true
                            else:
                                pass
                    int addr = lir_fn_next_value(&f)
                    if drop_loads_value:
                        lir_push_inst(&f, bb, ISlotLoad(addr, slot, LT_PTR))
                    else:
                        lir_push_inst(&f, bb, ISlotAddr(addr, slot))
                    Vector[int] drop_args = []
                    drop_args.push(addr)
                    Vector[int] drop_abis = []
                    lir_push_inst(&f, bb, ICallExtern(-1, drop_fn, drop_args, drop_fn, drop_abis))

        case GIDropIfAlive(local_id):
            # Conditional drop: wrap the same drop emission with an
            # `IDropGuardOpen(kind=byte_size+1, &slot)` / `IDropGuardClose`
            # pair. The C codegen emits a `memcmp(&slot, zeros, size) != 0`
            # gate; downstream `drop_elab` (when self-host grows one) can
            # statically resolve Initialized → strip guard / Uninitialized
            # → strip drop / MaybeInitialized → swap memcmp for a bool
            # drop-flag. Until then the runtime memcmp is correct but slow,
            # matching Rust's pre-elaboration shape.
            String dia_tn = gir_local_type_name(local_id, gir_locals, &gmod)
            if dia_tn != "":
                # ── FAT trait-box drop (`Box[Trait]` local) ──
                # A fat trait box ({data, vtable}) is deliberately OUT of
                # type_runtime_map (it's a real emitted struct, not a
                # `typedef void*` alias), so `drop_fn_for_type` below returns
                # "" for it and this arm used to emit NOTHING — leaking the
                # data box AND the concrete payload's own resources on every
                # scope exit. Drop it through the vtable's `__drop` glue slot
                # instead: guard on the 16-byte fat struct, load vtable
                # (field 1), load `__drop`, call it with &data (field 0).
                # `Box__<Concrete>__drop(void** slot)` drops the payload,
                # frees the box, and nulls *slot — idempotent under the
                # surrounding guard. The call is UNCHECKED by design: an
                # unresolvable concrete (equip-primitive) has a NULL slot in
                # BOTH compilers (see the lower.gg NULL-degrade note; the
                # class is already broken at dispatch and filed for
                # typecheck-reject). Keyed on the TYPED `is_trait_box` flag.
                # Mirrors Rust gg's trait-box drop path
                # (`src/lir/lower/drops.rs`).
                bool dia_tb_handled = false
                int dia_tb_slot = local_to_slot.get(local_id).unwrap()
                int dia_tb_ty = f.slots.get(dia_tb_slot).unwrap().ty
                if dia_tb_ty >= LT_STRUCT_BASE:
                    int dia_tb_sid = dia_tb_ty - LT_STRUCT_BASE
                    if dia_tb_sid >= 0 and dia_tb_sid < m.structs.len():
                        LirStructDef dia_tb_def = m.structs.get(dia_tb_sid).unwrap()
                        if dia_tb_def.is_trait_box:
                            # Trait name = post-`Box__` suffix (the mangling
                            # contract, same slice the two Box registrars
                            # used); `__drop` index found BY NAME in the
                            # `_VTable` def (appended LAST, but resolution is
                            # by-name like Rust's VTABLE_DROP_FIELD search so
                            # a future append can't silently misindex).
                            String dia_tb_trait = dia_tb_def.name.slice(5, dia_tb_def.name.len())
                            int dia_tb_vt_sid = sr.get(dia_tb_trait + "_VTable").unwrap_or(-1)
                            int dia_tb_drop_idx = -1
                            if dia_tb_vt_sid >= 0 and dia_tb_vt_sid < m.structs.len():
                                LirStructDef dia_tb_vt_def = m.structs.get(dia_tb_vt_sid).unwrap()
                                for (dia_tb_fi, dia_tb_fld) in dia_tb_vt_def.fields.enumerate():
                                    if dia_tb_fld.name == "__drop":
                                        dia_tb_drop_idx = dia_tb_fi
                            if dia_tb_drop_idx >= 0:
                                int dia_tb_addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ISlotAddr(dia_tb_addr, dia_tb_slot))
                                # Guard stays on `&slot` (ISlotAddr) per
                                # drop_elab's build_val_to_slot — same rule as
                                # the value-drop path below.
                                int dia_tb_size = lir_type_byte_size_in_mod(dia_tb_ty, &m, 0)
                                lir_push_inst(&f, bb, IDropGuardOpen(dia_tb_size + 1, dia_tb_addr))
                                int dia_tb_vt_addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, IFieldPtr(dia_tb_vt_addr, dia_tb_addr, dia_tb_sid, 1))
                                int dia_tb_vt = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ILoad(dia_tb_vt, dia_tb_vt_addr, LT_PTR))
                                int dia_tb_dslot_addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, IFieldPtr(dia_tb_dslot_addr, dia_tb_vt, dia_tb_vt_sid, dia_tb_drop_idx))
                                int dia_tb_drop_fn = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, ILoad(dia_tb_drop_fn, dia_tb_dslot_addr, LT_PTR))
                                int dia_tb_data_addr = lir_fn_next_value(&f)
                                lir_push_inst(&f, bb, IFieldPtr(dia_tb_data_addr, dia_tb_addr, dia_tb_sid, 0))
                                Vector[int] dia_tb_args = []
                                dia_tb_args.push(dia_tb_data_addr)
                                lir_push_inst(&f, bb, ICallPtr(-1, dia_tb_drop_fn, dia_tb_args))
                                lir_push_inst(&f, bb, IDropGuardClose)
                                dia_tb_handled = true
                String dia_drop_fn = drop_fn_for_type(dia_tn, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                # Mono'd Option/Result locals/scrutinees whose payload owns a
                # resource are NOT in optionlike_resource_types (that dict is
                # field-position-only AND drives the by-value ABI, so we must not
                # add them — see is_droppable_type). But Pass 3 DID generate their
                # `<Type>__drop` and recorded it in type_drop_fns. Use that typed
                # registry as the fallback: it's the authoritative "this type has
                # a generated drop fn" signal (populated only when a payload is a
                # resource, so POD-payload Option/Result correctly stay drop-less).
                if dia_drop_fn == "" and m.type_drop_fns.contains(dia_tn):
                    dia_drop_fn = m.type_drop_fns.get(dia_tn).unwrap().drop_fn_name
                if dia_drop_fn != "" and not dia_tb_handled:
                    int dia_slot = local_to_slot.get(local_id).unwrap()
                    int dia_slot_ty = f.slots.get(dia_slot).unwrap().ty
                    int dia_size = lir_type_byte_size_in_mod(dia_slot_ty, &m, 0)
                    int dia_addr = lir_fn_next_value(&f)
                    lir_push_inst(&f, bb, ISlotAddr(dia_addr, dia_slot))
                    # kind encoding: 0=Bool guard, kind-1=byte size for NonZero.
                    # The GUARD stays on `&slot` (ISlotAddr): `drop_elab`'s
                    # `build_val_to_slot` maps ONLY ISlotAddr producers → slots,
                    # so the guard's value must be the ISlotAddr result for the
                    # NonZero memcmp / static suppression to trace back to the
                    # slot. Switching this to ISlotLoad would sever that map and
                    # reintroduce the double-free. The DROP-FN ARG below differs
                    # for owning `!`-params (see dia_drop_arg).
                    lir_push_inst(&f, bb, IDropGuardOpen(dia_size + 1, dia_addr))
                    # Tier E §8.1: the drop-fn arg. For a normal by-value local
                    # the slot holds the value and `T__drop(&slot)` is correct, so
                    # the arg is `dia_addr` (=&slot). But an owning `!`-MOVE
                    # resource param's slot holds a `T*` (the caller transferred
                    # the pointer in) — `T__drop` wants that `T*`, so we pass the
                    # LOADED pointer (`ISlotLoad(slot)`), not `&slot`. Keyed on the
                    # TYPED owning_param flag (NEVER slot-shape): a `&`-borrow also
                    # lowers to GtMutPtr but keeps owning_param=false and isn't even
                    # registered for drop, so it never reaches this arm.
                    int dia_drop_arg = dia_addr
                    # P2 — the drop consumer reads the OWNEDPTR VARIANT (the
                    # single source of truth for "this ptr-slot owns + heap-
                    # frees its pointee"), into which the projection folded
                    # `owning_param`. The GIR `owning_param` field stays as
                    # the projection SOURCE (read in the slot-creation loop);
                    # here we read the projected variant, NOT a parallel flag.
                    # Fall back to the GIR read only when the slot has no
                    # provenance entry (out of range — a defensive guard; the
                    # original-local slots that reach this drop ARE projected).
                    bool dia_owns_ptr = false
                    if dia_slot >= 0 and dia_slot < f.slot_provenance.len():
                        match f.slot_provenance.get(dia_slot).unwrap():
                            case PvOwnedPtr():
                                dia_owns_ptr = true
                            else:
                                dia_owns_ptr = false
                    else:
                        dia_owns_ptr = gir_local_is_owning_param(local_id, gir_locals)
                    if dia_owns_ptr:
                        int dia_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotLoad(dia_loaded, dia_slot, LT_PTR))
                        dia_drop_arg = dia_loaded
                    # Ptr-handle local (runtime=="Ptr": Channel/Mutex/Shared/…): the
                    # slot holds the HANDLE pointer by value (LT_PTR slot, NOT an
                    # aggregate), and its runtime drop wants that handle BY VALUE —
                    # `gorget_channel_release(GorgetChannel*)` / `free(void*)`. Passing
                    # `&slot` (a `T**`) would release/free the stack-slot address →
                    # `munmap_chunk(): invalid pointer` SIGABRT (or, when it doesn't
                    # abort, decrement a garbage refcount and LEAK the channel). Load
                    # the slot, exactly like the owning-`!`-param and Box arms, and
                    # like Rust's Trivial("free") SlotLoad (drops.rs:209-217). Keyed on
                    # the TYPED runtime category (not a name/slot-shape heuristic); the
                    # owning-param case above already handled PvOwnedPtr ptr-slots, so
                    # this only adds the owned-LOCAL ptr-handle (PvValue) case.
                    bool dia_is_ptr_handle = false
                    if not dia_owns_ptr and m.type_runtime_map.contains(dia_tn):
                        if m.type_runtime_map.get(dia_tn).unwrap_or("") == "Ptr":
                            dia_is_ptr_handle = true
                    if dia_is_ptr_handle:
                        int dia_ph_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotLoad(dia_ph_loaded, dia_slot, LT_PTR))
                        dia_drop_arg = dia_ph_loaded
                    # Box[T] local: a Box is `typedef void*` (pointer-represented)
                    # but its slot is `Box__T`-typed (aggregate). drop_fn_for_type
                    # maps Box→`free`, which wants the HEAP pointer the box holds —
                    # NOT `&slot` (the stack-slot address), which `free(&slot)` would
                    # abort on with `munmap_chunk(): invalid pointer`. Pass the LOADED
                    # pointer, like an owning `!`-param. The GUARD above stays on
                    # `&slot` (ISlotAddr) per drop_elab's build_val_to_slot — only the
                    # drop-fn ARG changes. Inlined `lir_type_is_box(dia_slot_ty)`
                    # (m.structs + m.type_runtime_map, both in scope). Mirrors Rust
                    # src/lir/lower/drops.rs:264-275 (SlotLoad{Ptr} → free the value).
                    bool dia_is_box = false
                    String dia_box_inner_name = ""
                    if dia_slot_ty >= LT_STRUCT_BASE:
                        int dia_box_sid = dia_slot_ty - LT_STRUCT_BASE
                        if dia_box_sid >= 0 and dia_box_sid < m.structs.len():
                            String dia_box_nm = m.structs.get(dia_box_sid).unwrap().name
                            if m.type_runtime_map.contains(dia_box_nm):
                                if m.type_runtime_map.get(dia_box_nm).unwrap_or("") == "Box":
                                    dia_is_box = true
                                    # Inner type = post-`Box__` suffix of the
                                    # mangled struct name. The self-host LirStructDef
                                    # has NO typed box_inner_type field yet (Rust gg
                                    # carries one — src/lir/mod.rs:1544, devbook/29
                                    # Snag #13), so the `Box__` mangling is the only
                                    # contract available at THIS drop site, the same
                                    # one emit_box_alloc:2869 and the dia_is_box probe
                                    # above already rely on. Typed-field port is a
                                    # TODO follow-up.
                                    if dia_box_nm.starts_with("Box__"):
                                        dia_box_inner_name = dia_box_nm.slice(5, dia_box_nm.len())
                    if dia_is_box and not dia_owns_ptr:
                        int dia_box_loaded = lir_fn_next_value(&f)
                        lir_push_inst(&f, bb, ISlotLoad(dia_box_loaded, dia_slot, LT_PTR))
                        dia_drop_arg = dia_box_loaded
                        # Box-inner-drop. The box drop_fn below resolves to
                        # `free` (runtime=="Box"), which releases ONLY the box
                        # allocation — leaking the inner String/Array/struct
                        # buffer. Mirror Rust's generated `Box__<Inner>__drop`
                        # (src/backend/c_lir/emit_types.rs:1491-1493): drop the
                        # inner value THROUGH the box pointer (which points
                        # straight at the inner) BEFORE the `free`. dia_box_loaded
                        # IS that heap pointer. POD inner → drop fn "" → no-op.
                        if dia_box_inner_name != "":
                            String dia_inner_drop = drop_fn_for_type(dia_box_inner_name, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                            # `drop_fn_for_type` is a name-keyed lookup over
                            # `type_runtime_map`, which does NOT carry the
                            # `Callable__`/`MutCallable__`/`ConsumeCallable__`
                            # monos (they alias straight to the pre-registered
                            # GorgetClosure struct without a per-name runtime-map
                            # entry — lir_lower.gg:946). So a `Box[Callable]`
                            # inner resolves to "" above and its closure ENV
                            # (`__gorget_closure_env_alloc`) LEAKS on the bare box
                            # `free`. `resource_meta_for` IS the typed channel
                            # that classifies those prefixes (lir_lower.gg:260 →
                            # runtime "GorgetClosure", drop_fn
                            # `gorget_closure_free`); consult it for the inner
                            # drop fn when the name-keyed lookup misses. The box
                            # pointer points straight at the inner GorgetClosure,
                            # so `gorget_closure_free(box_ptr)` frees `c->env`
                            # (no-op on a NULL env) BEFORE the box `free` — one
                            # owner, no double-free. No name-prefix routing here:
                            # the prefix classification lives inside the typed
                            # `resource_meta_for`, read via its `drop_fn` field.
                            if dia_inner_drop == "":
                                match resource_meta_for(&gmod, dia_box_inner_name):
                                    case Some(dia_inner_rmeta):
                                        match dia_inner_rmeta.drop_fn:
                                            case Some(dia_rm_drop):
                                                dia_inner_drop = dia_rm_drop
                                            case None:
                                                pass
                                    case None:
                                        pass
                            if dia_inner_drop == "" and m.type_drop_fns.contains(dia_box_inner_name):
                                dia_inner_drop = m.type_drop_fns.get(dia_box_inner_name).unwrap().drop_fn_name
                            if dia_inner_drop != "":
                                Vector[int] dia_in_args = []
                                dia_in_args.push(dia_box_loaded)
                                Vector[int] dia_in_abis = []
                                lir_push_inst(&f, bb, ICallExtern(-1, dia_inner_drop, dia_in_args, dia_inner_drop, dia_in_abis))
                    # ② closure ENV-FIELD leak fix — for a resource/CoW-capturing
                    # `GorgetClosure` value, `gorget_closure_free` frees only the
                    # env BLOCK, leaking the captured String/Vector/struct field
                    # buffers. The auto-generated `__Closure_N__drop(env*)` frees
                    # those, but is never invoked. Route it here: a recorded
                    # `closure_env_type` entry (gated at the make-site to a
                    # genuinely-resource-owning env) + a generated `__Closure_N`
                    # drop => emit `__Closure_N__drop(closure.env)` BEFORE
                    # `gorget_closure_free` (which zeroes env). The entry presence
                    # gate is load-bearing: a stub / no-capture closure has a NULL
                    # env + NO entry, so the env-load+dtor is never emitted for it
                    # (no NULL deref). Keyed by `f.name + NUL + local_id` (the
                    # per-function composite — bare ints collide across fns).
                    # NOTE: this GorgetClosure env-field sub-block is UNREACHABLE
                    # for owning `!`-params — it's gated on a `closure_env_type`
                    # entry, which is keyed ONLY at closure make-sites, and a
                    # `!`-param is never a make-site. So `dia_addr` (=&slot) stays
                    # correct here even though the drop-fn arg above is the loaded
                    # pointer for owning params; if a future make-site ever tags a
                    # `!`-param, this assumption must be revisited.
                    if dia_tn == "GorgetClosure":
                        String cevt_key = f.name + "\0" + int_to_str(local_id)
                        if gmod.closure_env_type.contains(cevt_key):
                            String cevt_env_tn = gmod.closure_env_type.get(cevt_key).unwrap()
                            if m.type_drop_fns.contains(cevt_env_tn):
                                String cevt_drop_fn = m.type_drop_fns.get(cevt_env_tn).unwrap().drop_fn_name
                                int gc_sid = sr.get("GorgetClosure").unwrap_or(-1)
                                if gc_sid >= 0:
                                    # closure.env is field 1 ({fn_ptr@0, env@1}).
                                    # `dia_addr` is `&slot` (the GorgetClosure*).
                                    int cevt_fptr = lir_fn_next_value(&f)
                                    lir_push_inst(&f, bb, IFieldPtr(cevt_fptr, dia_addr, gc_sid, 1))
                                    int cevt_env = lir_fn_next_value(&f)
                                    lir_push_inst(&f, bb, ILoad(cevt_env, cevt_fptr, LT_PTR))
                                    Vector[int] cevt_args = []
                                    cevt_args.push(cevt_env)
                                    Vector[int] cevt_abis = []
                                    lir_push_inst(&f, bb, ICallExtern(-1, cevt_drop_fn, cevt_args, cevt_drop_fn, cevt_abis))
                    Vector[int] dia_args = []
                    dia_args.push(dia_drop_arg)
                    Vector[int] dia_abis = []
                    lir_push_inst(&f, bb, ICallExtern(-1, dia_drop_fn, dia_args, dia_drop_fn, dia_abis))
                    lir_push_inst(&f, bb, IDropGuardClose)

        case GIMoveZero(local_id):
            # Mark slot as moved — pure dataflow annotation (V6: no Memset for
            # non-projected places). MoveSlot is swept by drop elaboration.
            int slot = local_to_slot.get(local_id).unwrap()
            lir_push_inst(&f, bb, IMoveSlot(slot))

        case GIDeref(dst_local, src_local, inner_ty):
            # *box — load *src pointer value, memcpy sizeof(inner) into
            # dst slot. Works uniformly for scalar and aggregate inner
            # types because the dst slot address is a byte-addressable
            # destination. Matches IBoxAlloc's heap-store shape.
            int inner_lir_ty = map_gir_type(inner_ty, &gmod, &sr)
            int size_bytes = lir_type_byte_size_in_mod(inner_lir_ty, &m, 0)
            int src_slot_d = local_to_slot.get(src_local).unwrap()
            int dst_slot_d = local_to_slot.get(dst_local).unwrap()
            int src_ptr_val = lir_fn_next_value(&f)
            int dst_addr_val = lir_fn_next_value(&f)
            int size_val = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(src_ptr_val, src_slot_d, LT_PTR))
            lir_push_inst(&f, bb, ISlotAddr(dst_addr_val, dst_slot_d))
            lir_push_inst(&f, bb, IIConst(size_val, LT_I64, size_bytes))
            lir_push_inst(&f, bb, IMemcpy(dst_addr_val, src_ptr_val, size_val))

        case GICast(cast_dst_local, cast_src_local, cast_from_ty, cast_to_ty):
            # Numeric `as`-cast — load the scalar source, emit the family-
            # appropriate LIR cast, store to the dst slot. Mirrors Rust's
            # LIR Cast lowering (src/lir/lower/insts.rs:393-402).
            #
            # ENCODING (load-bearing): GICast carries GIR type ids (F32=9,
            # F64=10), but lir_is_integer/lir_is_float operate on LIR ids
            # (LT_F32=8, LT_F64=9). Map BOTH endpoints GIR→LIR FIRST (model
            # the GIBinOp arm's `map_gir_type` at :3291), THEN apply the
            # int/float family predicate uniformly. The LIR-mapped `to_ty`
            # is also what the LIR cast op + c_type_name expect.
            int cast_from_lir = map_gir_type(cast_from_ty, &gmod, &sr)
            int cast_to_lir = map_gir_type(cast_to_ty, &gmod, &sr)
            int cast_src_slot = local_to_slot.get(cast_src_local).unwrap()
            int cast_src_slot_ty = f.slots.get(cast_src_slot).unwrap().ty
            int cast_val = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(cast_val, cast_src_slot, cast_src_slot_ty))
            int cast_dst = lir_fn_next_value(&f)
            bool cast_src_float = lir_is_float(cast_from_lir)
            bool cast_to_float = lir_is_float(cast_to_lir)
            if cast_src_float and not cast_to_float:
                lir_push_inst(&f, bb, IFloatToInt(cast_dst, cast_val, cast_to_lir))
            elif cast_src_float and cast_to_float:
                lir_push_inst(&f, bb, IFloatCast(cast_dst, cast_val, cast_to_lir))
            elif not cast_src_float and cast_to_float:
                lir_push_inst(&f, bb, IIntToFloat(cast_dst, cast_val, cast_to_lir))
            else:
                lir_push_inst(&f, bb, IIntCast(cast_dst, cast_val, cast_to_lir))
            int cast_dst_slot = local_to_slot.get(cast_dst_local).unwrap()
            lir_push_inst(&f, bb, ISlotStore(cast_dst_slot, cast_dst, false))

        case GIDerefStore(ds_ptr_local, ds_value, ds_inner_ty):
            # *ptr = value — store `value` THROUGH the pointer held in
            # `ds_ptr_local`'s slot. Used for whole-value writes to a `&`/`!`
            # param (a `GtMutPtr(inner)`-typed local): the slot holds a `T*`,
            # so a GIAssign would clobber the pointer slot, not the pointee.
            #
            # Shape (mirrors Rust gg's `assign` into `Place{local,[Deref]}`,
            # src/ir/lowering/stmts/assigns.rs:231-243):
            #   1. ds_ptr_val = ISlotLoad(ptr_slot, LT_PTR)  — load the pointer.
            #   2. ds_val     = lower_operand(value)         — produce the value.
            #   3. IStore(ds_ptr_val, ds_val)                — `*ptr = value`.
            # IStore's codegen (lir_codegen.gg:3138-3149) dispatches scalar
            # (`*(T*)ptr = v`) / aggregate (memcpy) / ptr per the value's LIR
            # type — covering BOTH non-resource and resource inner. No new LIR
            # inst and no new C-emit arm needed: IStore already exists.
            int ds_ptr_slot = local_to_slot.get(ds_ptr_local).unwrap()
            int ds_ptr_val = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, ISlotLoad(ds_ptr_val, ds_ptr_slot, LT_PTR))
            int ds_val = lower_operand(ds_value, &f, bb, local_to_slot, m)
            # Drop-on-overwrite: `*ptr = X` must free the OLD heap pointee
            # before the store, else `*b = X` (Box[String]) leaks the
            # previous buffer. Order mirrors Rust's emit_field_store_with_
            # cleanup (src/ir/lowering/stmts/assigns.rs:763-790): materialise
            # the new value FIRST (ds_val above), drop the OLD pointee, THEN
            # store. This is SAFE *only because* the write-site (lower_expr.gg
            # EDeref) now tags the `*b` rvalue LoBorrowed → op_consume clones
            # it → ds_val is an INDEPENDENT buffer, so freeing the old pointee
            # can never dangle the new value (`*b = *b` deep-clones first).
            # Primitives/POD inner → drop_fn_for_type returns "" → no-op.
            # gorget_string_free is double-free safe (if(cap==0)return) for a
            # static/zeroed old value.
            String ds_inner_tn = gir_type_id_to_base_name(ds_inner_ty, &gmod)
            if ds_inner_tn != "":
                String ds_old_drop = drop_fn_for_type(ds_inner_tn, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                if ds_old_drop != "":
                    Vector[int] ds_od_args = []
                    ds_od_args.push(ds_ptr_val)
                    Vector[int] ds_od_abis = []
                    lir_push_inst(&f, bb, ICallExtern(-1, ds_old_drop, ds_od_args, ds_old_drop, ds_od_abis))
            lir_push_inst(&f, bb, IStore(ds_ptr_val, ds_val))

        case GINop():
            pass

        case GIFieldLoad(fl_dst_local, fl_base_local, fl_field):
            # A.2 (2026-05-22) — typed field-load dispatch. Mirrors Rust
            # `Instruction::FieldLoad` lowering at
            # `src/lir/lower/insts.rs:800-869`.
            #
            # Shape:
            #   1. base_val = address of the base struct (slot addr OR
            #      ISlotLoad if the slot is itself a pointer — auto-deref
            #      for `&Foo` / `Foo*` params).
            #   2. fptr = IFieldPtr(base_val, struct_id, field).
            #   3. Dispatch on dst GIR type:
            #        • GtPtr(_) / GtMutPtr(_) → ISlotStore(dst_slot, fptr)
            #          — pointer-alias path (no byte-copy).
            #        • else → ILoad(loaded, fptr, field_lir_ty) +
            #          ISlotStore(dst_slot, loaded) — byte-copy path,
            #          observationally identical to the previous
            #          `__field_read_*` GICallExtern lowering.
            #
            # struct_id is resolved by name from the base local's GIR
            # type — `gir_type_id_to_base_name` strips Ptr/MutPtr to
            # reach the named struct, `sr.get(name)` maps to the LIR
            # struct id (the same map that `__field_read_*` codegen
            # uses via `find_struct_type`).
            int fl_base_tid = gir_locals.get(fl_base_local).unwrap().type_id
            String fl_base_tn = gir_type_id_to_base_name(fl_base_tid, &gmod)
            int fl_struct_id = sr.get(fl_base_tn).unwrap_or(-1)
            int fl_base_slot = local_to_slot.get(fl_base_local).unwrap()
            int fl_base_slot_ty = f.slots.get(fl_base_slot).unwrap().ty
            int fl_base_val = lir_fn_next_value(&f)
            # Auto-deref: if the base slot is a pointer kind (LT_PTR or
            # LT_PTR_TO_BASE+sid), the slot HOLDS a pointer — load it
            # rather than taking the slot's address. Matches the OpCopy
            # path the previous `__field_read_*` arg-prep took for
            # is_ptr_type bases (lower.gg line ~4382).
            bool fl_base_is_ptr = (fl_base_slot_ty == LT_PTR) or (fl_base_slot_ty >= LT_PTR_TO_BASE and fl_base_slot_ty < LT_STRUCT_BASE)
            if fl_base_is_ptr:
                lir_push_inst(&f, bb, ISlotLoad(fl_base_val, fl_base_slot, fl_base_slot_ty))
            else:
                lir_push_inst(&f, bb, ISlotAddr(fl_base_val, fl_base_slot))
            # FieldPtr → field address.
            int fl_fptr = lir_fn_next_value(&f)
            lir_push_inst(&f, bb, IFieldPtr(fl_fptr, fl_base_val, fl_struct_id, fl_field))
            # Dispatch on dst's GIR type — Ptr(_) → pointer alias,
            # else → byte-copy load. The dst's GIR type is set by
            # `lower.gg`'s EFieldAccess emission: resource fields are
            # Ptr-wrapped (alias path), non-resource fields are
            # value-typed (byte-copy path).
            int fl_dst_tid = gir_locals.get(fl_dst_local).unwrap().type_id
            int fl_dst_slot = local_to_slot.get(fl_dst_local).unwrap()
            bool fl_dst_is_ptr = is_ptr_type(fl_dst_tid, gmod)
            # Exception to the alias path: if the FIELD itself is a user
            # borrow pointer (`Ref[T]` / `MutRef[T]`), its storage ALREADY
            # holds a pointer value — `&field` (fl_fptr) is a pointer-to-
            # pointer, so storing it as the dst's pointer yields `**T` and
            # every downstream reader (print, method-receiver self, extern
            # arg) dereferences garbage. We must LOAD the stored pointer
            # through fl_fptr instead (the else byte-copy/load branch). This
            # mirrors Rust `src/lir/lower/insts.rs:1029-1034`, which computes
            # `field_is_ptr` from the field's own GIR type and fires the
            # alias store only `if dst_is_ptr && !field_is_ptr`.
            #
            # Metadata source: the field's GIR type is NOT reachable as a
            # typed id at this LIR site — `GirFieldInfo` (gir.gg:308) stores
            # only the field's resolved type NAME, and `map_ast_type` lowers
            # `Ref[T]`/`MutRef[T]` to `GtNamed("Ref__T")`/`GtNamed("MutRef__T")`
            # (no GtPtr; see `resolve_field_lir_type`'s `Ref__` guard at the
            # top of this file, ~line 708). So re-resolving the name would
            # bottom out at the SAME `Ref__` residual the
            # `resolve_field_gir_type` bridge uses (lower_types.gg:942, the
            # documented one name-derived heuristic). We therefore read the
            # field's declared type name and check the borrow-ptr prefix
            # directly — the same accepted residual as `resolve_field_lir_type`.
            # `fl_field_value_is_ptr` = the field's STORAGE already holds a
            # pointer value, so `&field` (fl_fptr) is a pointer-to-pointer and
            # must be LOADed (the else branch), never alias-stored. Two cases:
            #   • user borrow pointer (`Ref[T]` / `MutRef[T]`) — name-derived
            #     residual per the `resolve_field_lir_type` `Ref__` guard above.
            #   • opaque-handle resource (Shared/Mutex/RWLock/Channel/…) — the
            #     handle value IS a pointer (`GorgetShared*` etc.), so the field
            #     slot stores a pointer just like a borrow ptr. Keyed off the
            #     TYPED `resource_meta_for(...).opaque_handle` flag via
            #     `is_opaque_pointer_type` (lir_lower.gg:164), NOT a `Shared__`
            #     name match (Core #2). Aggregate resources (Vector/Dict/String)
            #     have opaque_handle=false → they keep the alias-store `&field`
            #     path (you DO pass the aggregate's address). This mirrors the
            #     Rust `field_is_ptr` carve-out at insts.rs:1029-1034 ("load the
            #     pointer value first").
            bool fl_field_value_is_ptr = field_storage_holds_pointer(fl_base_tn, fl_field, &gmod)
            if fl_dst_is_ptr and not fl_field_value_is_ptr:
                # Pointer-alias: store the field address directly as
                # the dst's pointer value. No byte-copy.
                lir_push_inst(&f, bb, ISlotStore(fl_dst_slot, fl_fptr, false))
            else:
                # Byte-copy: load the field value through the field
                # pointer, then store into the dst slot. `field_lir_ty`
                # comes from the dst slot's own ty (single source of
                # truth — `local_to_slot` already wired the slot type
                # to the field's value type at local allocation).
                int fl_field_lir_ty = f.slots.get(fl_dst_slot).unwrap().ty
                int fl_loaded = lir_fn_next_value(&f)
                lir_push_inst(&f, bb, ILoad(fl_loaded, fl_fptr, fl_field_lir_ty))
                lir_push_inst(&f, bb, ISlotStore(fl_dst_slot, fl_loaded, false))

    return bb

# ── Terminator lowering ─────────────────────────────────────

LirTerm lower_terminator(Terminator term, LirFunction &f, int bb, Vector[int] local_to_slot, Vector[int] block_map, LirModule m):
    match term:
        case GTReturn(operand):
            int val = lower_operand(operand, &f, bb, local_to_slot, m)
            return TRet(val)
        case GTJump(target):
            int lir_target = block_map.get(target).unwrap()
            Vector[int] empty_args = []
            return TJump(lir_target, empty_args)
        case GTBranch(cond_op, then_bb, else_bb):
            int cond = lower_operand(cond_op, &f, bb, local_to_slot, m)
            int lir_then = block_map.get(then_bb).unwrap()
            int lir_else = block_map.get(else_bb).unwrap()
            Vector[int] empty_then = []
            Vector[int] empty_else = []
            return TBranch(cond, lir_then, empty_then, lir_else, empty_else)
        case GTNone():
            return TRetVoid()
    return TUnreachable()

# ── Function lowering ───────────────────────────────────────

LirFunction lir_lower_function(GirFunction gfn, GirModule &gmod, Dict[String, int] &sr, Dict[String, int] func_index, LirModule &m):
    # Map parameter types
    Vector[int] param_types = []
    for pt in gfn.param_types:
        param_types.push(map_gir_type(pt, &gmod, &sr))

    # Map return type
    int ret_type = map_gir_type(gfn.return_type, &gmod, &sr)

    Vector[int] saved_param_types = []
    for spt in param_types:
        saved_param_types.push(spt)

    # Cross-frame fault (Inc-2.1a-iv): a participating callee carries one
    # synthesized trailing `GtMutPtr(i32)` fault-slot param; record the count so
    # the closure adapter declares ONLY the user params + passes NULL for the
    # slot (a phantom forwarded slot is a wild write). Typed read of the module
    # set, never name-matched (devbook/24 rule 2); 0 for the common case.
    int fault_slot_count = 0
    if participates_in_fault(gmod, gfn.name):
        fault_slot_count = 1
    LirFunction f = LirFunction(gfn.name, param_types, ret_type, [], [], 0, false, "", [], [], [], [], fault_slot_count)

    # Create slots for all GIR locals
    Vector[int] local_to_slot = []
    for local in gfn.locals:
        int lir_ty = map_gir_type(local.type_id, &gmod, &sr)
        String slot_name = ""
        match local.name_hint:
            case Some(n):
                slot_name = n
            case None:
                pass
        int slot_id = lir_fn_add_slot(&f, lir_ty, slot_name)
        local_to_slot.push(slot_id)
        # P2 — project SlotProvenance from the GIR ownership axis, GATED on
        # the LIR layout axis: only POINTER-shaped slots can be
        # OwnedPtr/Borrowed (the read-routing decision is about LAYOUT). A
        # scalar/aggregate-VALUE LoParam/LoBorrowed slot stays PvValue.
        # The !-owning-param is PvOwnedPtr (folds `local.owning_param` into
        # the variant); a ptr-aliasing LoBorrowed/LoView/LoParam is
        # PvBorrowed; everything else PvValue. This is the SOLE projection
        # site — "resolve once, write through".
        SlotProvenance prov = PvValue()
        if lir_is_ptr(lir_ty):
            if local.owning_param:
                prov = PvOwnedPtr()
            else:
                match local.ownership:
                    case LoBorrowed():
                        prov = PvBorrowed(local.borrow_origin)
                    case LoView():
                        prov = PvBorrowed(local.borrow_origin)
                    case LoParam():
                        # ⚠ a ptr-shaped NON-owning param IS a borrow — do
                        # NOT fall through to PvValue (that would flip the
                        # read-routing for borrowed param slots, breaking the
                        # param-deref class).
                        prov = PvBorrowed(local.borrow_origin)
                    else:
                        prov = PvValue()
        f.slot_provenance.push(prov)

    # Create blocks
    Vector[int] block_map = []
    for _ in gfn.blocks:
        int blk_id = lir_fn_add_block(&f)
        block_map.push(blk_id)

    # Copy function parameters to their slots (params map to locals 1..N, local 0 is return place)
    if gfn.blocks.len() > 0:
        int param_count = gfn.param_types.len()
        int pci = 0
        while pci < param_count:
            int param_val = lir_fn_next_value(&f)
            int param_lir_ty = saved_param_types.get(pci).unwrap()
            int param_slot = local_to_slot.get(pci + 1).unwrap()
            lir_push_inst(&f, 0, IParamRef(param_val, pci, param_lir_ty))
            lir_push_inst(&f, 0, ISlotStore(param_slot, param_val, false))
            pci += 1

    # Lower instructions and terminators for each block.
    # CoW for-element BORROW scan (no BasicBlock__clone): reads gir_blk.insts
    # and gir_blk.term only; enumerate() preserves the block index bii.
    for (bii, gir_blk) in gfn.blocks.enumerate():
        int lir_bb = block_map.get(bii).unwrap()

        # Lower instructions
        for gir_inst in gir_blk.insts:
            lir_bb = lower_instruction(gir_inst, &f, lir_bb, local_to_slot, gfn.locals, func_index, &gmod, &sr, &m)

        # Lower terminator. Move the local LirTerm into the block —
        # it's a non-Copy enum and `lir_term` is dead after the
        # assignment. The Rust typechecker's FieldAccess fix
        # (mod.rs::populate_def_field_types runs before typecheck +
        # FieldAccess returns the actual field type instead of
        # error_id) now catches the previously-silent copy.
        LirTerm lir_term = lower_terminator(gir_blk.term, &f, lir_bb, local_to_slot, block_map, m)
        lir_set_term(&f, lir_bb, lir_term)

    return f

# ── Drop metadata population ────────────────────────────────

# Determine the drop function name for a given type name.
# Returns "" if the type doesn't need dropping.
String drop_fn_for_type(String type_name, Dict[String, bool] resource_types, Dict[String, String] type_runtime_map, Dict[String, bool] optionlike, Dict[String, bool] collision_types, Dict[String, String] method_prefix_map):
    # option_ref_borrow RES-5: a `Ref__T` payload is a BORROW (a pointer
    # into a collection the caller owns), never dropped (§2 invariant: only
    # the owner frees). An `Option__Ref__T` is likewise a borrow wrapper.
    # Today this falls through to "" accidentally (Ref__T is never registered
    # as a resource); make it EXPLICIT so a future edit that registers a
    # `Ref__`/`Option__Ref__` type can't silently emit a drop that would free
    # the pointee → double-free. The pointer-ness lands via the LT_PTR
    # fallback in resolve_field_lir_type; the Option struct itself is generated
    # in Pass 3 with no variant-drop because of this guard.
    if type_name.starts_with("Ref__") or type_name.starts_with("Option__Ref__"):
        return ""
    if type_name == "GorgetString" or type_name == "Str":
        return "gorget_string_free"
    if type_name == "GorgetArray":
        return "gorget_array_free"
    if type_name == "GorgetMap":
        return "gorget_map_free"
    if type_name == "GorgetSet":
        return "gorget_set_free"
    if type_name == "GorgetClosure":
        return "gorget_closure_free"
    # Phase A — use type_runtime_map for parameterized collection/resource types.
    # Registered once at type-definition time; no starts_with name matching.
    # Guard contains before get (Dict.get() crashes on missing key in self-host).
    String runtime = ""
    if type_runtime_map.contains(type_name):
        runtime = type_runtime_map.get(type_name).unwrap_or("")
    if runtime == "GorgetArray":
        return "gorget_array_free"
    elif runtime == "GorgetMap":
        return "gorget_map_free"
    elif runtime == "GorgetSet":
        return "gorget_set_free"
    elif runtime == "Ptr" or runtime == "Box":
        # A `Channel__T` Ptr-handle drops by RELEASING its refcount (atomic
        # dec → auto-close + free at zero, channel_runtime.c gorget_channel_
        # release), NOT a raw `free` of the handle. A raw `free` would (a) leak
        # the channel's ring buffer + pthread mutex/condvars and (b) — because
        # the GIDrop arm hands the handle off by VALUE for ptr-runtimes (see the
        # ISlotLoad gate there, mirroring Rust's Trivial("free") SlotLoad) —
        # double/mis-free under the tracking allocator. Route via the TYPED
        # `method_prefix_map` (`Channel__int64_t` → `gorget_channel`, written at
        # lir_lower.gg:679) + `_release`, matching on the prefix VALUE (NOT a
        # `Channel__` name substring — the same prefix-value dispatch the
        # simple-method arm uses at lir_lower.gg:1590 for `gorget_guard`). Rust
        # emits a per-type wrapper `Channel__T__drop(self){gorget_channel_
        # release(*self);}` (c_lir/helpers.rs:241); the self-host has no
        # wrappers, so it routes the GIDrop straight to the runtime release.
        if method_prefix_map.contains(type_name):
            String pdrop_pfx = method_prefix_map.get(type_name).unwrap_or("")
            if pdrop_pfx == "gorget_channel":
                return pdrop_pfx + "_release"
            # A `Shared__T` / `Shared__Mutex__T` Ptr-handle (round-16 shared
            # carrier) is REFCOUNTED: its drop decrements the strong count and,
            # at zero, frees the inner data + control block (shared_runtime.c
            # gorget_shared_drop). NOTE the release symbol is `_drop`, NOT
            # `_release` — there is no `gorget_shared_release`. Same TYPED
            # prefix-VALUE dispatch as the Channel arm above (the carrier-NESS
            # is decided by `method_prefix == "gorget_shared"`, never a name
            # substring). Rust emits a per-type wrapper `Shared__T__drop(self)
            # {gorget_shared_drop(*self);}`; the self-host routes the GIDrop
            # straight to the runtime release.
            if pdrop_pfx == "gorget_shared":
                # SUB-SELECTION (still inside the typed gorget_shared arm): the
                # `shared int x` carrier is `Shared__Mutex__T` — its `data`
                # holds an INNER `GorgetMutex*` that plain gorget_shared_drop
                # would leak (Rust gg leaks it too — `Shared__Mutex__T__drop`
                # → `gorget_shared_drop` only frees the data buffer, not the
                # mutex; ASan confirms 176 bytes leaked there). Route the carrier
                # to `gorget_shared_mutex_drop`, which frees the inner mutex at
                # the last strong ref. This is the C-emit drop-symbol selection
                # (the symbol IS the runtime contract); the `__Mutex__` infix
                # test is a STRUCTURAL inner-type check (via `contains`, NOT a
                # `starts_with` meaning-test) AFTER the typed `gorget_shared`
                # gate already proved "this is a shared carrier" — it only picks
                # the variant that also frees the nested handle. A plain
                # `Shared[T]` (no inner Mutex) keeps the leak-equivalent
                # `gorget_shared_drop` (its data is a value, not a handle, so
                # there is nothing nested to free).
                if type_name.contains("__Mutex__"):
                    return "gorget_shared_mutex_drop"
                return pdrop_pfx + "_drop"
            # A `Weak__T` Ptr-handle is REFCOUNTED (the non-owning half of the
            # Arc/Weak pair): its drop DECREMENTS the WEAK count and frees the
            # control block only when BOTH strong AND weak reach zero
            # (shared_runtime.c gorget_weak_drop). A raw `free` (the generic Ptr
            # fallthrough below) would unconditionally free the still-shared
            # control block → the live `Shared__T`'s later `gorget_shared_drop`
            # is a heap-use-after-free / double-free (ASan-confirmed on
            # shared_weak.gg). Same TYPED prefix-VALUE dispatch as the
            # gorget_shared arm above; the release symbol is `_drop` (there is no
            # `gorget_weak_release`). Mirrors Rust gg's per-type wrapper
            # `Weak__T__drop(self) { gorget_weak_drop(*self); }`.
            # NOTE: `register_owning_opaque_local` (lower_drops.gg:340, allowlist
            # {mutex,rwlock,shared,atomic_int,atomic_bool}) intentionally OMITS
            # gorget_weak — `downgrade`'s result is a bare `GtNamed(Weak__T)`, not
            # a ctor-minted `GtPtr(inner)`, so it returns early at that fn's
            # `GtPtr`-required gate (lower_drops.gg:364) and the Weak local is drop-
            # registered via the ordinary declared-local path instead. So the
            # opaque-local allowlist ↔ drop_fn_for_type lockstep stays honest.
            if pdrop_pfx == "gorget_weak":
                return pdrop_pfx + "_drop"
            # A `Mutex__T` Ptr-handle is SINGLE-OWNER (not refcounted): its drop
            # FREES the handle via `gorget_mutex_free` (mutex_runtime.c:37 —
            # destroys the pthread mutex, frees the waiter array + data + the
            # handle), NOT a refcount `_release`. Route via the TYPED
            # `method_prefix_map` (`Mutex__int64_t` → `gorget_mutex`, written at
            # lir_lower.gg:679) + `_free`, matching on the prefix VALUE (NOT a
            # `Mutex__` name substring — same prefix-value dispatch as the
            # Channel arm above). Rust gg emits a per-type wrapper
            # `Mutex__T__drop(self){gorget_mutex_free(*self);}`
            # (c_lir/helpers.rs:290); the self-host has no wrappers, so it routes
            # the GIDrop straight to `gorget_mutex_free`. The owner-only free is
            # safe because borrow params are never drop-registered in the
            # self-host (lower_closures.gg:108-149 registers only `!arg` owning
            # params), so a Mutex borrow-param can never double-free.
            if pdrop_pfx == "gorget_mutex":
                return pdrop_pfx + "_free"
            # An `RWLock__T` Ptr-handle is SINGLE-OWNER (not refcounted), exactly
            # like Mutex: its drop FREES the handle via `gorget_rwlock_free`
            # (sync_runtime.c:131 — destroys the pthread rwlock, frees the waiter
            # array + data + the handle), NOT a refcount `_release`. Route via the
            # TYPED `method_prefix_map` (`RWLock__int64_t` → `gorget_rwlock`) +
            # `_free`, matching on the prefix VALUE (NOT an `RWLock__` name
            # substring — same prefix-value dispatch as the Mutex/Channel arms
            # above). Rust gg emits a per-type wrapper
            # `RWLock__T__drop(self){gorget_rwlock_free(*self);}`
            # (c_lir/helpers.rs:300); the self-host has no wrappers, so it routes
            # the GIDrop straight to `gorget_rwlock_free`. The owner-only free is
            # safe because borrow params are never drop-registered in the self-host
            # (lower_closures.gg registers only `!arg` owning params), so an RWLock
            # borrow-param can never double-free. This arm MUST stay paired with
            # the `register_owning_opaque_local` gate (lower_drops.gg:389) that
            # registers the RWLock owning local for drop in the first place.
            if pdrop_pfx == "gorget_rwlock":
                return pdrop_pfx + "_free"
        return "free"
    elif runtime == "Guard":
        # A `Guard__T`/`ReadGuard__T`/`WriteGuard__T` local drops by RELEASING
        # the held lock. The release fn is PER-VARIANT — a Mutex guard unlocks
        # via `gorget_guard_release` (pthread_mutex_unlock), but a RWLock
        # ReadGuard/WriteGuard unlocks via `gorget_read_guard_release`/
        # `gorget_write_guard_release` (pthread_rwlock_unlock). Routing ALL
        # three to `gorget_guard_release` left the rwlock LOCKED on scope exit
        # → the next reader/writer DEADLOCKS. The variant comes from the TYPED
        # `type_method_prefix_map` (`gorget_guard`/`gorget_read_guard`/
        # `gorget_write_guard`, written at lir_lower.gg:658) + `_release` —
        # NOT a `ReadGuard__` name substring. Rust gg emits a per-type wrapper
        # `Guard__T__drop(self) { <prefix>_release(self); }`; the self-host
        # routes the GIDrop straight to the runtime release (the GIDrop arm
        # passes `&slot`, matching the `*_guard_t*` param).
        if method_prefix_map.contains(type_name):
            String gdrop_pfx = method_prefix_map.get(type_name).unwrap_or("")
            if gdrop_pfx != "":
                return gdrop_pfx + "_release"
        return "gorget_guard_release"
    elif runtime == "Task":
        return ""
    if resource_types.contains(type_name):
        # Drop-name collision: a user `T.drop(...)` method owns the plain
        # `T__drop` C symbol, so route field/variant drops to the mangled
        # auto-glue name `__gorget_dtor_{T}` (mirrors Rust gg
        # `src/lir/lower/mod.rs:651-655`). The collision set is populated
        # once at the top of `lower_gir_to_lir`, read here via the typed
        # accessor — no name-shape heuristic.
        if collision_types.contains(type_name):
            return "__gorget_dtor_" + type_name
        return type_name + "__drop"
    # Mono'd Option__X / Result__X__E whose payload owns a resource. Kept
    # out of resource_types (to preserve their by-value param/field ABI),
    # so the recursive drop/clone-fn generators would otherwise SKIP an
    # `Option[Resource]` field — e.g. `MatchArm__clone` omitting `guard`,
    # `Stmt__clone` omitting `SReturn`'s payload — producing a SHALLOW
    # clone that shares the inner resource and double-frees. Rust emits the
    # field clone (driver.c MatchArm__clone clones guard). Their `T__drop`/
    # `T__clone` defs are generated via recursive_drop_enums (lir_lower
    # Pass 3); here we just report them droppable so containing structs/
    # enums include the field.
    if optionlike.contains(type_name):
        if collision_types.contains(type_name):
            return "__gorget_dtor_" + type_name
        return type_name + "__drop"
    return ""

# Populate drop/clone metadata on the LirModule from GIR type info.
void populate_drop_metadata(LirModule &m, GirModule gmod):
    # Pass 1: Struct field drops
    Vector[String] type_keys = gmod.type_infos.keys()
    int ki = 0
    while ki < type_keys.len():
        String type_name = type_keys.get(ki).unwrap()
        GirTypeInfo info = gmod.type_infos.get(type_name).unwrap()
        if info.is_enum:
            ki += 1
            continue
        # Cluster (a), 2026-05-24: the `__imported_type__` skip was REMOVED.
        # Whole-program compilation (bootstrap + every `gg build`) emits ALL
        # user types in ONE C file; the Rust preamble provides only RUNTIME
        # drops (gorget_*_free), NOT user-type `<Type>__drop`. Skipping
        # imported user types left 0 `__drop` defs → undefined references.
        # Double-definition is guarded by `fn_exists()` in emit_struct_drops /
        # emit_type_drop_fns, not by suppressing registration here.
        # Check if this struct has any droppable fields
        Vector[FieldDrop] field_drops = []
        int fi = 0
        while fi < info.fields.len():
            GirFieldInfo finfo = info.fields.get(fi).unwrap()
            String drop_fn = drop_fn_for_type(finfo.type_name, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
            if drop_fn != "":
                field_drops.push(FieldDrop(finfo.name, drop_fn, finfo.type_name))
            fi += 1
        bool is_resource_struct = gmod.resource_types.contains(type_name)
        if field_drops.len() > 0 or is_resource_struct:
            String tname = type_name
            m.recursive_drop_structs.put(tname, field_drops)
            # ③(c): detect a user `Drop` impl — a GIR fn named "{type_name}__drop"
            # with EXACTLY 1 param (the `!self` destructor). >1 params = a
            # non-destructor method (DataFrame.drop(cols)) handled by the
            # existing collision loop; 0/absent = no user Drop. Mirrors Rust
            # DropStrategy::Custom (drops.rs:307-346) — the type has a Drop impl,
            # so the unified `__gorget_dtor_{T}` runs the user fn FIRST then the
            # per-field auto-drops. This gate lives inside `field_drops.len() > 0
            # or is_resource_struct` so a FIELDLESS user-Drop type (not in
            # recursive_drop_structs / not emitted as `__gorget_dtor_`) is NOT
            # routed to a missing symbol — it keeps calling `{T}__drop` directly.
            String user_drop = ""
            # CoW for-element BORROW scan (no GirFunction__clone): reads gf.name
            # and gf.param_types only.
            for gf in gmod.functions:
                if gf.name == type_name + "__drop" and gf.param_types.len() == 1:
                    user_drop = gf.name
            # Also add to type_drop_fns for unified emission. For a drop-name
            # collision type OR a user-Drop type the auto glue takes the mangled
            # name `__gorget_dtor_{T}` (the plain `T__drop` symbol belongs to the
            # user method); emit_struct_drops / the DCE seed read this typed
            # name (Rust gg `src/lir/lower/mod.rs:680-686`).
            String drop_fn_name = type_name + "__drop"
            if m.drop_collision_types.contains(type_name) or user_drop != "":
                drop_fn_name = "__gorget_dtor_" + type_name
                # Route drop SITES to the renamed glue. drop_fn_for_type reads
                # drop_collision_types; without this the site keeps calling the
                # user method directly. For the user-Drop case this also records
                # the rename so the GIDropIfAlive lowering resolves
                # __gorget_dtor_{T}.
                m.drop_collision_types.put(type_name, true)
            Vector[FieldDrop] fd_copy = []
            int di = 0
            while di < field_drops.len():
                FieldDrop fd = field_drops.get(di).unwrap()
                fd_copy.push(FieldDrop(fd.field_name, fd.drop_fn_name, fd.field_type_name))
                di += 1
            Vector[EnumVariantDrop] no_evd = []
            m.type_drop_fns.put(type_name, TypeDropInfo(drop_fn_name, fd_copy, user_drop, no_evd))
        ki += 1

    # Pass 2: Enum variant drops
    ki = 0
    while ki < type_keys.len():
        String type_name = type_keys.get(ki).unwrap()
        GirTypeInfo info = gmod.type_infos.get(type_name).unwrap()
        if not info.is_enum:
            ki += 1
            continue
        # Cluster (a): __imported_type__ skip removed — see Pass 1 note.
        Vector[EnumVariantDrop] variant_drops = []
        # CoW for-element BORROW scans (no GirEnumVariantInfo__clone): read
        # vinfo.fields/vinfo.name and finfo fields only; enumerate() preserves
        # the variant index vi used in EnumVariantDrop.
        for (vi, vinfo) in info.variants.enumerate():
            for finfo in vinfo.fields:
                String drop_fn = drop_fn_for_type(finfo.type_name, gmod.resource_types, m.type_runtime_map, gmod.optionlike_resource_types, m.drop_collision_types, m.type_method_prefix_map)
                if drop_fn != "":
                    # Field name in the C struct is VariantName_N (e.g., Literal_0)
                    # finfo.name is "_N" (e.g., "_0"), so strip the leading underscore
                    String field_idx = finfo.name
                    if field_idx.starts_with("_"):
                        field_idx = field_idx.slice(1, field_idx.len())
                    String c_field = vinfo.name + "_" + field_idx
                    variant_drops.push(EnumVariantDrop(vi, vinfo.name, c_field, drop_fn, finfo.type_name))
        bool is_resource_enum = gmod.resource_types.contains(type_name)
        if variant_drops.len() > 0 or is_resource_enum:
            String tname = type_name
            m.recursive_drop_enums.put(tname, variant_drops)
            # ③(c)/#12: detect a user `Drop` impl — a 1-param GIR fn named
            # `{type_name}__drop` (the `!self` destructor). >1 params = a
            # non-destructor method (handled by the 2-param collision loop);
            # 0/absent = no user Drop. (REUSES Pass-1's 1-param scan shape.)
            # A user-Drop enum's `{T}__drop` C symbol IS the user body, so the
            # auto variant-payload-drop glue must take the mangled name
            # `__gorget_dtor_{T}` — otherwise `emit_enum_drops`' `fn_exists`
            # gate sees the user `{T}__drop` and SKIPS emitting the auto glue,
            # leaking the variant payload. The `drop_collision_types` entry is
            # already seeded by the user-Drop pre-pass in `lower_gir_to_lir`
            # (so field/variant SITES route to the glue via `drop_fn_for_type`);
            # here we record `user_drop_fn` (so `emit_enum_drops` runs the user
            # body FIRST, then the switch) and the mangled `drop_fn_name`.
            #
            # Strategy B keeps BOTH the DCE-seed name (lir_codegen.gg enum DCE
            # loop) AND the emit name as `__gorget_dtor_{T}`, so they cannot
            # mismatch — mirrors `emit_struct_drops`' user-Drop path. Mirrors
            # Rust `lower/mod.rs:680-686`. The clone name is unchanged
            # (`{Enum}__clone`, flowing from `emit_enum_clones`); `drop_to_clone_fn`
            # maps `__gorget_dtor_` → `{Enum}__clone` too.
            String user_drop = ""
            # CoW for-element BORROW scan (no GirFunction__clone): reads gf.name
            # and gf.param_types only.
            for gf in gmod.functions:
                if gf.name == type_name + "__drop" and gf.param_types.len() == 1:
                    user_drop = gf.name
            String drop_fn_name = type_name + "__drop"
            if m.drop_collision_types.contains(type_name) or user_drop != "":
                drop_fn_name = "__gorget_dtor_" + type_name
                # Route variant-drop SITES to the renamed glue (idempotent —
                # the pre-pass already seeded this for user-Drop types).
                m.drop_collision_types.put(type_name, true)
            Vector[FieldDrop] no_fd = []
            Vector[EnumVariantDrop] evd_copy = []
            int di = 0
            while di < variant_drops.len():
                EnumVariantDrop evd = variant_drops.get(di).unwrap()
                evd_copy.push(EnumVariantDrop(evd.variant_index, evd.variant_name, evd.field_name, evd.drop_fn_name, evd.field_type_name))
                di += 1
            m.type_drop_fns.put(type_name, TypeDropInfo(drop_fn_name, no_fd, user_drop, evd_copy))
        ki += 1

# ── Module lowering (main entry point) ──────────────────────

LirModule lower_gir_to_lir(GirModule &gmod):
    LirModule m = new_lir_module(gmod.scheduler_mode)
    Dict[String, int] sr = {}

    # ── Phase A — populate typed resource metadata ─────────────
    # Walk every named type and tag its resource shape. Downstream
    # passes read this Dict instead of re-deriving from
    # `name.starts_with("Vector__")` etc. See
    # docs/devbook/26-self-host-frontend.md §3.
    Vector[String] nt_keys = gmod.named_types.keys()
    for tname in nt_keys:
        if not gmod.resource_metadata.contains(tname):
            match build_resource_metadata(tname):
                case Some(rmeta):
                    gmod.resource_metadata.put(tname.clone(), rmeta)
                case None:
                    pass

    # Copy imported-type flags from GirModule (loader stores imported struct
    # and enum names with "__imported_type__NAME" keys). Used downstream to
    # suppress duplicate struct body / drop / clone emission — the Rust
    # preamble already provides them for imported types.
    Vector[String] gm_fn_keys = gmod.imported_fns.keys()
    for k in gm_fn_keys:
        if k.starts_with("__imported_type__"):
            String type_only = k.slice(17, k.len())
            m.imported_type_names.put(type_only, true)

    # Populate enum variant → parent enum map for codegen rewriting of
    # `Variant(args)` calls into inline struct initializers.
    Vector[String] ti_keys_v = gmod.type_infos.keys()
    for tname_v in ti_keys_v:
        GirTypeInfo tinfo_v = gmod.type_infos.get(tname_v).unwrap()
        if tinfo_v.is_enum:
            # CoW for-element BORROW scan (no GirEnumVariantInfo__clone): reads
            # v_v.name only; enumerate() preserves the variant tag vi_v.
            for (vi_v, v_v) in tinfo_v.variants.enumerate():
                # BARE-name keys (`Empty` → `RxNode`). LAST-WRITE-WINS (plain
                # `.put`), the PRE-EXISTING behavior — deliberately UNCHANGED.
                # The template-vs-mono resolution depends on it: both `Wrapper`
                # (the generic template) and `Wrapper__int64_t` (its mono) define
                # the variant `Value`; the mono is iterated/registered such that
                # the bare `Value` resolves to the layout the C-emit must mint.
                # A first-write-wins guard here flips that and mis-mints the
                # template struct into a mono slot (cc-fail: `__gg_Wrapper` into
                # `__gg_Wrapper__int64_t`). The CROSS-ENUM collision
                # (`RxNode.Empty`/`ParseError.Empty`) is handled NOT by touching
                # this bare map but by the QUALIFIED keys below + the GIR-side
                # qualification of the bare ctor name (`lower_expr.gg`,
                # non-generic parent only). Mirrors Rust gg: the name-keyed map is
                # a last-mile convenience for already-disambiguated names, the
                # qualified / receiver-driven path is the collision arbiter
                # (src/loader.rs:907-940, methods.rs:281-296).
                m.enum_variant_parent.put(v_v.name, tname_v)
                # The variant's ordinal position in the source enum declaration
                # IS its runtime tag. The codegen's struct-field-scan heuristic
                # (emit_call_extern) gets this wrong for unit variants, because
                # unit variants contribute no payload fields. Record the right
                # tag here so callers can look it up.
                m.enum_variant_tag.put(v_v.name, vi_v)
                # QUALIFIED keys (`RxNode__Empty` → `RxNode`, tag 0). Always
                # unambiguous — a qualified ctor name (`EnumName.Variant()`, or a
                # bare ctor the GIR disambiguated via the expected type) carries
                # its own parent, so it must NOT route through the collision-prone
                # bare map. The C-emit (`lir_codegen.gg` enum-variant ctor path)
                # reads these directly when `name.contains("__")`. Additive — does
                # NOT alter any existing bare-key lookup.
                String qual_key = tname_v + "__" + v_v.name
                m.enum_variant_parent.put(qual_key, tname_v)
                m.enum_variant_tag.put(qual_key, vi_v)

    # Register builtin structs
    register_builtin_structs(&m, &sr)

    # ── Drop-name collision detection ──────────────────────────
    # A USER method whose mangled C symbol is `T__drop` (e.g.
    # `DataFrame.drop(col)` → `DataFrame__drop(self, col)`) COLLIDES with
    # the compiler's auto drop-glue name `T__drop(self)`. When that happens
    # the type is recorded here and ALL field/variant drop call sites route
    # to `__gorget_dtor_{T}` instead, while the auto glue is emitted under
    # that mangled name (the user method keeps the plain `T__drop` symbol).
    # Mirrors Rust gg's `LoweringContext::populate_*` collision check
    # (`src/lir/lower/mod.rs:540-545`): a fn named `{T}__drop` with
    # `params.len() > 1` is a non-destructor (a real Drop impl takes only
    # `self`), so its C name can't double as the field-drop glue.
    #
    # MUST run BEFORE `lower_type_defs` (just below): the Option/Result
    # variant-drop names are built INSIDE lower_type_defs (`:980` / `:1040`)
    # via `drop_fn_for_type`, which reads `m.drop_collision_types`. Populate
    # after lower_type_defs and those names would still say `DataFrame__drop`
    # → the Result/Option `Ok_0` drop site would mis-link to the user 2-arg
    # method and leak. See docs/devbook/24-layering-discipline.md
    # (resolve once, write through: the collision fact is set at this single
    # source and read via the typed `drop_collision_types` accessor).
    int cf = 0
    while cf < gmod.functions.len():
        String fn_name = gmod.functions.get(cf).unwrap().name
        if fn_name.ends_with("__drop") and gmod.functions.get(cf).unwrap().param_types.len() > 1:
            # Strip the trailing "__drop" (6 bytes) to recover the type name.
            String coll_ty = fn_name.slice(0, fn_name.len() - 6)
            # Only a registered struct/enum type can collide with auto glue;
            # ignore a stray `X__drop`-named free fn (guards against a false
            # entry that would mis-route an unrelated type).
            if gmod.type_infos.contains(coll_ty):
                m.drop_collision_types.put(coll_ty, true)
        cf += 1

    # ── User-`Drop` impl pre-pass (#12) ─────────────────────────
    # A user `T.drop(!self)` impl emits the plain `T__drop(self)` C symbol
    # (1 param), which COLLIDES with the auto drop-glue name `T__drop` — the
    # same collision as the 2-param method loop above, but for the
    # destructor `drop` itself. Populate `drop_collision_types` for EVERY
    # such struct AND enum here, BEFORE `populate_drop_metadata` Pass 1/2 run.
    #
    # WHY a pre-pass and not per-row detection: Pass 1/2 resolve a containing
    # type's FIELD/VARIANT drop names via `drop_fn_for_type`, which reads
    # `drop_collision_types`. `type_infos.keys()` is insertion-order, so an
    # `Outer { Inner field }` declared before `Inner` would resolve
    # `Outer.inner`'s drop to the bare user `Inner__drop` (no inner-field
    # frees) → leak. Seeding ALL user-Drop types up front makes field-drop
    # resolution order-INDEPENDENT (covers struct-field-of-enum,
    # enum-payload-of-struct, and nested holes). Typed gate
    # `type_infos.contains(T)` — no name-shape heuristic. Mirrors the 2-param
    # loop's single-source-of-truth discipline (24-layering-discipline.md).
    # CoW for-element BORROW scan (no GirFunction__clone): reads gf.name and
    # gf.param_types only.
    for gf in gmod.functions:
        if gf.name.ends_with("__drop") and gf.param_types.len() == 1:
            # Strip the trailing "__drop" (6 bytes) to recover the type name.
            String drop_ty = gf.name.slice(0, gf.name.len() - 6)
            if gmod.type_infos.contains(drop_ty):
                m.drop_collision_types.put(drop_ty, true)

    # Lower user-defined type definitions
    lower_type_defs(&gmod, &m, &sr)

    # Populate drop/clone metadata from GIR type field info
    populate_drop_metadata(&m, gmod)

    # Emit module-level statics with runtime-call init — `stdout` /
    # `stderr` / `stdin` from lib/std/io.gg etc. Mirrors Rust gg's
    # `LoweringContext::global_names` + `module.globals` machinery
    # (`src/ir/lowering/mod.rs:1074-1111`). The corresponding
    # `EIdentifier(name)` lowerings emitted `__global_ref__<name>`
    # GICallExterns earlier; the intercept in the GICallExtern arm
    # below scans `m.globals` for the matching name and rewrites to
    # `IGlobalAddr(dst, gid)`. Dict insertion-order iteration keeps the
    # global-id sequence deterministic across runs.
    Vector[String] static_names = gmod.statics.keys()
    for sg_name in static_names:
        GirStaticInfo sg_info = gmod.statics.get(sg_name).unwrap()
        int sg_lir_ty = map_gir_type(sg_info.type_id, &gmod, &sr)
        # Map the GIR static init-kind to the LIR GINIT_* code: GGSTATIC_BYTES
        # → GINIT_BYTES (scalar-literal static = a const C initializer at the
        # declaration, no runtime synth fn — mirrors Rust's `GlobalInit::Bytes`,
        # `src/lir/lower/types.rs:572`); everything else → GINIT_RUNTIME_CALL.
        # `is_const` stays false either way: a `static` is MUTABLE storage
        # (write-backs via SAssign), matching Rust's `is_const:false`.
        int sg_init_kind = GINIT_RUNTIME_CALL
        if sg_info.init_kind == GGSTATIC_BYTES:
            sg_init_kind = GINIT_BYTES
        LirGlobal sg = LirGlobal(sg_name.clone(), sg_lir_ty, sg_init_kind, -1, sg_info.init_expr.clone(), false, [])
        lir_mod_add_global(&m, sg)

    # Build function index: name → FuncId
    Dict[String, int] func_index = {}
    # CoW for-element BORROW scan (no GirFunction__clone): reads gfn.name only;
    # enumerate() preserves the function index fi.
    for (fi, gfn) in gmod.functions.enumerate():
        func_index.put(gfn.name.clone(), fi)

    # Translate const-init globals (trait-impl `_VTable` structs) GIR → LIR.
    # Each GirGlobal is a struct-of-FuncAddr; resolve every GGINIT_FN_REF
    # field's mangled impl-fn name to a FuncId via `func_index` (built just
    # above, so all bodies are already indexed). Mirrors Rust gg's
    # `lower_global_init` resolving `GlobalInit::FnRef(name)` through the
    # func index (`src/lir/lower/types.rs:573-579`). A name with no fid
    # falls back to a GINIT_ZEROED field → NULL slot in C (defensive parity
    # with Rust `types.rs:577`; should not happen given the default-emit
    # guarantee). Latent until the vtable-emission pass populates
    # `gmod.globals` (Phase 4) — this loop is a no-op over an empty vector
    # today.
    for gg_global in gmod.globals:
        int g_ty = map_gir_type(gg_global.type_id, &gmod, &sr)
        Vector[LirGlobalField] lf = []
        for f in gg_global.fields:
            if f.kind == GGINIT_FN_REF:
                if func_index.contains(f.fn_name):
                    int fid = func_index.get(f.fn_name).unwrap()
                    lf.push(LirGlobalField(GINIT_FUNC_ADDR, fid, ""))
                else:
                    lf.push(LirGlobalField(GINIT_ZEROED, -1, ""))
            elif f.kind == GGINIT_BOX_DROP_REF:
                # Vtable `__drop` glue slot: forward the typed concrete name.
                # NOT routed through the FN_REF/func_index path — the
                # `Box__<concrete>__drop` wrapper is backend-synthesized (no
                # GIR/LIR function), so an FN_REF would miss the index and
                # silently lower to a NULL slot. Mirrors Rust gg's
                # `BoxDropRef → BoxDropAddr` arm (`src/lir/lower/types.rs`).
                lf.push(LirGlobalField(GINIT_BOX_DROP_ADDR, -1, f.fn_name.clone()))
            else:
                # Field-count PARITY for any other kind (incl. GGINIT_ZEROED,
                # the NULL-degrade drop slot for unresolvable concretes): a
                # skipped field would SHIFT every later vtable slot against
                # the `_VTable` struct layout. Lower to a NULL slot.
                lf.push(LirGlobalField(GINIT_ZEROED, -1, ""))
        lir_mod_add_global(&m, LirGlobal(gg_global.name.clone(), g_ty, GINIT_STRUCT, -1, "", gg_global.is_const, lf))

    # Lower extern declarations
    for gext in gmod.externs:
        int ext_ret = map_gir_type(gext.return_type, &gmod, &sr)
        Vector[int] ext_params = []
        Vector[int] ext_abis = []
        m.externs.push(LirExtern(gext.name, ext_params, ext_ret, gext.is_variadic, ext_abis, ABI_AUTO))

    # Lower each function
    for gfn in gmod.functions:
        LirFunction lf = lir_lower_function(gfn, &gmod, &sr, func_index, &m)
        lir_mod_add_function(&m, lf)

    # Thread-spawned fn metadata (thread_spawn intrinsic → per-fn wrapper emit).
    # Mirrors Rust gg's GIR→LIR copy (`src/lir/lower/mod.rs:465-471`).
    for tsf_rec in gmod.thread_spawned_fns:
        # Map the typed payload tid through the SAME gir→lir type mapping
        # every fn return uses (one source of truth) — LT_VOID for void.
        int tsf_ret_lir = LT_VOID
        if tsf_rec.ret_tid != UNIT_TYPE:
            tsf_ret_lir = map_gir_type(tsf_rec.ret_tid, &gmod, &sr)
        m.thread_spawned_fns.push(LirThreadSpawnedFn(tsf_rec.fn_name.clone(), tsf_rec.ret_name.clone(), tsf_ret_lir, tsf_rec.stack_size))

    # Async spawn fn metadata (`spawn fn(args)` → per-fn spawn/await helper
    # emit, Inc-1). Sibling of the thread_spawned_fns copy above. Build the
    # `LirSpawnedFn` from the GIR `SpawnFnRec`: synthesize `p0`/`p1`/… param
    # names parallel to the carried `param_c_types` (scalar by-value in Inc-1),
    # carry the ret_c_type verbatim (the SAME string used to register the
    # `Task__<ret_c>` named type), and leave `ref_param_indices`/`clone_params`
    # empty (Inc-2/Inc-3). Mirrors Rust gg (`src/lir/lower/mod.rs` async copy →
    # `src/backend/c_lir/emit_types.rs:382-540`).
    for spawn_rec in gmod.spawned_fns:
        Vector[SpawnParam] sp_params = []
        int spi = 0
        while spi < spawn_rec.param_c_types.len():
            String sp_cty = spawn_rec.param_c_types.get(spi).unwrap()
            sp_params.push(SpawnParam("p" + int_to_str(spi), sp_cty.clone()))
            spi += 1
        Vector[int] sp_ref_indices = []
        Vector[CloneParam] sp_clone_params = []
        # KEYSTONE: re-derive clone_params (refcounted carriers that must be
        # retained when captured into the spawn ctx) from the producer fn's GIR
        # param type names. Mirrors Rust gg's clone_params detection
        # (`src/lir/lower/mod.rs:445-452`, Channel__/Shared__/Weak__). The
        # membership decision reads the TYPED `CsRefCounted` copy-semantics flag
        # (`is_refcounted_carrier` → `resource_meta_for` → `.copy_semantics`,
        # set at the build_resource_metadata Channel arm), NOT a
        # Channel-name prefix substring — Core #2 / layering rule 2,
        # resolve-once/write-through (devbook/24). Behavior-identical for the
        # current corpus (only Channel both passes `spawn_shape_supported` AND is
        # CsRefCounted) and future-proofs the Slice-3 Shared carrier (already
        # CsRefCounted, so it joins clone_params with no new name test).
        Vector[int] sp_gir_ptys = get_fn_param_types(spawn_rec.fn_name, gmod)
        int spci = 0
        while spci < sp_gir_ptys.len():
            String spc_nm = type_id_to_name(sp_gir_ptys.get(spci).unwrap(), &gmod)
            if is_refcounted_carrier(spc_nm, &gmod):
                # Capture the carrier's TYPED method-prefix (gorget_channel /
                # gorget_shared) so codegen routes the retain/release runtime
                # symbols off the VALUE, not a name-prefix test on the carrier
                # name (Core #2). `resource_meta_for` is the single source.
                String spc_mp = ""
                match resource_meta_for(&gmod, spc_nm):
                    case Some(spc_meta):
                        match spc_meta.method_prefix:
                            case Some(mp):
                                spc_mp = mp
                            case None:
                                pass
                    case None:
                        pass
                sp_clone_params.push(CloneParam(spci, spc_nm.clone(), spc_mp.clone()))
            spci += 1
        m.spawned_fns.push(LirSpawnedFn(spawn_rec.fn_name.clone(), !sp_params, spawn_rec.ret_c_type.clone(), !sp_ref_indices, !sp_clone_params))

    # Test-runner metadata: copy the ordered GIR test registry (built at
    # test-body lowering, in source order, including skipped tests) 1:1 into
    # `LirModule.test_fns`. Mirrors Rust gg's `runtime.test_fns →
    # module.test_fns` copy (`src/lir/lower/mod.rs:518`). The runner-main
    # synthesis iterates `m.test_fns` directly for label / skip / should_panic.
    for gtf in gmod.test_fns:
        m.test_fns.push(LirTestFn(gtf.fn_name.clone(), gtf.display_name.clone(), gtf.should_panic, gtf.expected_panic_msg.clone(), gtf.skipped, gtf.skip_reason.clone(), -1))

    return m

# ── Dead Global Elimination ─────────────────────────────────────
#
# Drop globals that no function references via IGlobalAddr. Mirrors
# Rust gg's `eliminate_dead_globals` in src/lir/optimize.rs. The
# self-host's `lower_gir_to_lir` unconditionally lowers every entry
# in `gmod.statics` — including stdin/stdout/stderr handles from
# lib/std/io.gg even when the fixture never touches them. Rust gg's
# pass scrubs those out before codegen, so the .c file emits only
# globals actually used. Without this pass, stage-1's emitted body
# carries a tail of dead `__lir_g<N>` declarations whose numbering
# collides with the e2e harness's runtime preamble in
# `self_host_e2e` (`tests/integration.rs:14149`).
#
# For GINIT_RUNTIME_CALL globals the rule is simple: referenced via
# IGlobalAddr ↔ kept. But GINIT_STRUCT (vtable) globals are referenced
# by NO IGlobalAddr — their slot fns are reached only through the
# `(void*)&fn` casts the C backend emits in the global initializer, never
# via an instruction. The dead-global pruner would therefore wrongly
# delete every vtable global. Pass 1 marks any GINIT_STRUCT global as
# referenced unconditionally, mirroring Rust gg's `eliminate_dead_globals`
# keeping any global whose init contains FuncAddrs
# (`src/lir/optimize.rs:436-443`, `global_has_func_addrs`).
void eliminate_dead_globals(LirModule &m):
    if m.globals.len() == 0:
        return
    # Pass 1: collect referenced global ids.
    Dict[int, bool] referenced = {}
    for func in m.functions:
        for blk in func.blocks:
            for inst in blk.insts:
                match inst:
                    case IGlobalAddr(_, gid):
                        referenced.put(gid, true)
                    else:
                        pass
    # Keep vtable globals (FuncAddr-bearing) — referenced indirectly via
    # the `(void*)&fn` casts in the C global initializer, not via any
    # IGlobalAddr instruction. Mirror Rust gg's `eliminate_dead_globals`
    # carve-out (`src/lir/optimize.rs:436-443`, `global_has_func_addrs`).
    int kg = 0
    while kg < m.globals.len():
        if m.globals.get(kg).unwrap().init_kind == GINIT_STRUCT:
            referenced.put(kg, true)
        kg += 1
    if referenced.len() == m.globals.len():
        return
    # Pass 2: build old→new index map and the kept-globals vector.
    Vector[LirGlobal] kept = []
    Dict[int, int] old_to_new = {}
    int gi = 0
    int new_idx = 0
    while gi < m.globals.len():
        if referenced.contains(gi):
            LirGlobal g = m.globals.get(gi).unwrap()
            kept.push(g)
            old_to_new.put(gi, new_idx)
            new_idx += 1
        gi += 1
    m.globals = kept
    # Pass 3: rewrite IGlobalAddr instructions to use new indices.
    int fi2 = 0
    while fi2 < m.functions.len():
        LirFunction func2 = m.functions.get(fi2).unwrap()
        int bi2 = 0
        while bi2 < func2.blocks.len():
            LirBlock blk2 = func2.blocks.get(bi2).unwrap()
            int ii2 = 0
            while ii2 < blk2.insts.len():
                LirInst inst2 = blk2.insts.get(ii2).unwrap()
                match inst2:
                    case IGlobalAddr(dst, gid):
                        int mapped = old_to_new.get(gid).unwrap()
                        blk2.insts.set(ii2, IGlobalAddr(dst, mapped))
                    else:
                        pass
                ii2 += 1
            func2.blocks.set(bi2, blk2)
            bi2 += 1
        m.functions.set(fi2, func2)
        fi2 += 1
