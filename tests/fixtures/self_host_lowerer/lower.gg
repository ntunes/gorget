# Minimal AST → GIR lowerer.
# Handles: functions with primitive types, int/float/bool/string literals,
# binary ops, function calls, variable declarations, return statements, print().

from std.collections import Vector, Dict
from std.conv import int_to_str, float_to_str
from ast import Module, Item, FunctionDef, Param, Stmt, Expr, SpannedExpr, SpannedType, ElseBranch, EquipBlock, StructDef, EnumDef, EnumVariant, Type, MatchArm
from scope import ScopeTable, DefInfo
from types import TypeTable, ResolvedType
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction, Terminator
from gir import Operand, GirType, GirExtern, GirTypeInfo, GirFieldInfo, GirEnumVariantInfo, LiftedClosure
from gir import ClosureCapture, CAP_BY_VALUE, CAP_BY_MUT_REF
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE, U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE, PRIM_COUNT
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT
from gir import init_type_table, register_type, lookup_or_register_named, register_ptr
from gir import ResourceMetadata
# FIDELITY Phase 4: vtable-global emission (struct-of-FuncAddr globals for
# non-derive trait impls). Mirrors Rust gg's `emit_vtable_globals`
# (`src/ir/lowering/traits.rs:985`). GirTypeInfo/GirFieldInfo/
# lookup_or_register_named are already imported above.
from gir import GirGlobal, GirGlobalField, gir_mod_add_global, GGINIT_FN_REF, GGINIT_STRUCT
# Scalar-literal statics register as a const-bytes global (GGSTATIC_BYTES)
# rather than a runtime synth fn — mirrors Rust's `GlobalInit::Bytes`.
from gir import GGSTATIC_RUNTIME, GGSTATIC_BYTES, static_put_bytes
# Phase 2b (Path A part 2): typed position-class enum for op_consume
# dispatch. See gir.gg::ConsumeKind for the full partition.
from gir import ConsumeKind, CkAssign, CkReturn, CkCallArgBorrow, CkCallArgOwning, CkFieldWrite
from gir import CkBinOpArg, CkFormatArg, CkMatchPtr
# CollectionKind variants — needed to type/construct the kind in
# `collection_kind_of` and to key the collection owning-arg lookup
# (`collection_builtin_method`, reading COLLECTION_BUILTIN_METHODS).
from gir import CollectionKind, CkVector, CkDeque, CkHeap, CkDict, CkSet, CkNotCollection
# Phase A — typed-metadata classifier shared with lir_lower.gg. The
# `name.starts_with("X__")` cascade lives there as the single source
# of truth for which monomorphised type names belong to which runtime
# family; `resource_meta_for` is the lazy-populating accessor that
# memoises results into `gmod.resource_metadata`.
from lir_lower import resource_meta_for
# Typed builtin-method declaration tables — the single source of truth
# for the String-view / collection-owning-arg / String-return facts the
# lowerer used to recognise via raw name-match lists (CLAUDE.md "No name
# matching"). Read via `string_builtin_method` / `collection_builtin_method`
# (mirror lir_lower.gg's `build_resource_metadata` reading RESOURCES).
from compiler.data.resources import STRING_BUILTIN_METHODS, COLLECTION_BUILTIN_METHODS
from compiler.data.schema import BuiltinMethodDecl, BuiltinMethodEntry
from compiler.data.schema import BuiltinRetKind, BrkString, BrkInfer

# ── Lowering context ─────────────────────────────────────

# DropScope kind tags. Mirrors Rust's `DropScopeKind` enum in
# `src/ir/lowering/drops.rs` — kept as int constants because the
# self-host's typed-metadata story is GIR-level, not enum-shaped (the
# Rust copy of the enum maps onto these ints 1:1 via match).
const int DSK_FUNCTION = 0
const int DSK_LOOP = 1
const int DSK_BLOCK = 2

# One entry per local that needs to be dropped when its enclosing scope
# exits. Fields mirror Rust's `DropEntry` in `src/ir/lowering/drops.rs`:
#   • local_id: GIR local slot to drop
#   • type_id: GIR type id, used by Phase 2/3 emission to call
#     `drop_fn_for_type` via gir_local_type_name. Stored on the entry
#     rather than re-looked-up so any later type updates don't drift
#     from the registration intent.
#   • maybe_moved: set by `mark_local_moved` at consume sites that
#     transfer ownership out of the local. Today the emission path
#     always emits `GIDropIfAlive` (defensive — mirrors Rust's post-
#     Snag #30 unconditional shape, where the LIR `drop_elab` pass
#     statically elides the runtime memcmp when init is provably
#     unconditional). The flag is recorded for future invariant
#     audits and for downstream consumers (e.g. the
#     `tighten_owned_operand_modes` post-pass) that need to know
#     which locals had ownership transferred away.
struct DropEntry:
    int local_id
    int type_id
    bool maybe_moved

# A drop scope corresponds to a language construct that owns locals.
# `kind` is one of DSK_*; `entries` lists locals registered in this
# scope in declaration order (drops are emitted in reverse / LIFO).
struct DropScope:
    int kind
    Vector[DropEntry] entries

# Tracks owned locals and emits drop instructions at scope boundaries.
# Mirrors Rust's `DropElaborator` (`src/ir/lowering/drops.rs`). Scope
# discipline: pushed at function entry / loop entry / each if-branch /
# match-arm entry, popped (with drop emission) at the corresponding
# exit. Early exits (return / break / continue) call
# `emit_drops_for_early_exit` to walk the scope stack innermost-out
# down to (and including) the target scope kind, emitting drops along
# the way without popping.
struct DropElaborator:
    Vector[DropScope] scopes

# Phase 2c COMMIT 3 Prereq C — deferred drop-emission record.
#
# Background: `emit_scope_drops` / `emit_drops_for_early_exit` are
# called INLINE during `lower_stmt`. The `maybe_moved` gate they
# would consult is set by `mark_local_moved` inside
# `wire_one_operand` (the post-pass `wire_liveness_into_modes`).
# That post-pass runs AFTER all inline emit calls have returned, so
# at inline emit time `maybe_moved` is universally false — the gate
# is a no-op.
#
# The fix: convert inline emission to a queue (append a
# `DropEmission` entry for every drop a scope-pop / early-exit
# would have emitted). After `wire_liveness_into_modes` populates
# `maybe_moved`, walk the queue and emit each pending drop, gated
# on `not entry.maybe_moved`.
#
# Fields:
#   • local_id: GIR local slot the deferred drop targets. Mirrors
#     the LIFO walk's `entry.local_id` at the inline emit site.
#   • target_block: index into `ctx.block_insts` where the drop
#     should be inserted. Recorded at the time the inline emit
#     site is reached (= `ctx.current_block`).
#   • insert_at_inst_idx: position within `target_block`'s
#     instruction vector where the drop should land. For natural-
#     scope-exit drops, this is `block_insts.get(target_block).len()`
#     at the inline call site (end of block, where the drop would
#     have been pushed). For early-exit drops (SReturn/SBreak/
#     SContinue), the drop lands BEFORE the terminator — the same
#     end-of-block position, because the early-exit emits drops
#     into the current block before setting its terminator.
#   • dse_scope_idx + entry_idx: pair of indices to read the
#     `maybe_moved` flag from at flush time. `dse_scope_idx` is the
#     index into `ctx.drop_elab.scopes` AT THE TIME OF RECORD; the
#     scope may have been popped by flush time, so we hold the
#     index into a captured snapshot, not a live pointer.
#
# **For Prereq C, the queue is recorded but `flush_drop_queue` is
# a no-op** — actual `GIDropIfAlive` emission lands in COMMIT 3.
# This commit ships only the structural plumbing: the struct,
# the field on `LowerCtx`, the constructors initialising it, and
# the flush hook wired in at the post-wire_liveness sites.
struct DropEmission:
    int local_id
    int target_block
    int insert_at_inst_idx
    int dse_scope_idx
    int entry_idx

# Ok/Error payload GIR type ids extracted from a monomorphized
# `Result__<OkT>__<ErrT>` name. Mirrors the (TypeId, TypeId) tuple Rust
# returns from `extract_result_field_types` (`exprs/mod.rs:2845`).
struct ResultPayloadTypes:
    int ok_type
    int err_type

# Key/value GIR type NAMES split out of a monomorphized `Dict__K__V`
# name. Mirrors the (String, String) tuple Rust's `parse_dict_kv_types`
# returns (`stmts/for_loops.rs:949`). Same multi-value-return-as-struct
# idiom as `ResultPayloadTypes` above.
struct DictKvNames:
    String key_name
    String val_name

# closure Phase 2 Step A: the metadata `compute_closure_sig` derives for a
# closure make-site, packaged so the make-site and the post-pass compute
# identical signatures (a struct return rather than a 5-tuple, mirroring
# the `ResultPayloadTypes` idiom above). Stored verbatim into a
# `LiftedClosure` record; the post-pass passes these straight to
# `lower_closure_body` so it never re-derives the signature.
struct ClosureSig:
    Vector[int] abi_param_types      # full ABI vector [self_ptr, p0, p1, …]
    int self_ptr                     # env-ptr type id (*__Closure_<cid>)
    Vector[int] body_param_types     # the closure's OWN param types [p0, p1, …]
    Vector[String] body_param_names  # the closure's param names (implicit-it: ["it"])
    int return_type

# closure Phase 2 Step B: result of the make-site capture COLLECTOR+
# CLASSIFIER. `caps` is the ordered, deduped capture list (env-field /
# struct-ctor-arg / GIFieldLoad-index order). `unliftable` is the SAFETY
# net: set true if ANY capture-shaped free var is NOT a genuine outer
# local (unresolvable, or `self`) — the closure then STAYS STUBBED
# (exactly as Phase 1 would). `seen` dedups per-name records so a body
# referencing a capture twice (`base + base`) pushes `base` ONCE.
struct CaptureCollector:
    Vector[ClosureCapture] caps
    Dict[String, bool] seen
    bool unliftable

struct LowerCtx:
    Vector[GirLocal] locals
    Vector[Vector[Instruction]] block_insts
    Vector[Terminator] block_terms
    int current_block
    # Maps local-binding name → GIR local id.
    Dict[String, int] named_locals
    # Stack of (continue_target, break_target) bb ids for the enclosing
    # loops. break / continue inside a loop body jump to the innermost
    # pair. Pushed at loop entry, popped at exit. Parallel Vectors because
    # Gorget doesn't have easy tuple storage in fields.
    Vector[int] loop_continue_stack
    Vector[int] loop_break_stack
    # Element-type hint threaded from SVarDecl (`Vector[T] x = []`) down
    # into EArrayLiteral / EDictLiteral so the allocator call receives
    # sizeof(T) instead of a hardcoded 8. Empty string means "no hint —
    # caller didn't know the container's element type". Consumed (cleared)
    # as soon as the literal handler reads them.
    String pending_vec_elem_tyname
    String pending_dict_key_tyname
    String pending_dict_val_tyname
    bool pending_dict_ordered
    # Name of the function currently being lowered. Threaded for
    # diagnostic attribution — without this, the ~58k EIdentifier
    # unknown-identifier bug reports can't be tied back to specific
    # function bodies, which is what we need to figure out which
    # lowering paths fail to populate `named_locals`.
    String current_fn_name
    # Drop elaboration state: scope stack + per-scope drop entries.
    # Lifecycle: pushed at function entry (DSK_FUNCTION), per-loop
    # (DSK_LOOP) and per-branch (DSK_BLOCK); popped at corresponding
    # exits. Early-exit terminators (SReturn/SBreak/SContinue) walk
    # the stack innermost-out and emit drops along the way. See the
    # DropElaborator docstring for the architectural contract.
    DropElaborator drop_elab
    # Phase 2c COMMIT 3 Prereq C — deferred drop-emission queue.
    # `emit_scope_drops` / `emit_drops_for_early_exit` append a
    # `DropEmission` entry per pending drop instead of emitting
    # inline. After `wire_liveness_into_modes` populates
    # `maybe_moved`, `flush_drop_queue` walks the queue and emits
    # `GIDropIfAlive` for each entry gated on `not maybe_moved`.
    # See DropEmission docstring. For Prereq C, queue recording
    # ships but flush is a no-op; COMMIT 3 flips flush to real
    # emission.
    Vector[DropEmission] drop_queue
    # Expected-type propagation (mirrors Rust gg's
    # `LoweringContext.func_state.expected_type`). Set by writer sites
    # (SVarDecl, SAssign, SReturn, call-arg loop, struct field-init)
    # to the destination's declared type immediately BEFORE recursing
    # into `lower_expr`; restored to the saved value (`prev`) on
    # return. Reader sites — bare `Ok`/`Error`/`Some`/`None` constructor
    # calls in `lower_call`, the bare `None` literal in `lower_expr`,
    # `EIdentifier(name)` resolution — consult this field to resolve a
    # context-dependent type that the local expression shape cannot
    # determine alone (the variant name does not carry the parent enum's
    # full monomorphised name, etc.). `-1` is the sentinel for "no
    # expectation set". See `docs/plans/self_host_ssa_cleanup.md` §7.
    int expected_type
    # `on error:` cleanup blocks registered in the current function, in
    # source order. Mirrors Rust gg's
    # `LoweringContext.func_state.on_error_blocks`
    # (`src/ir/lowering/stmts/mod.rs:342`). `SOnError(body)` pushes the
    # body here; the error-exit paths (SThrow's Result.Error return, and
    # ERethrow's Error return) drain them in LIFO order via
    # `emit_on_error_cleanups` (mirrors Rust's `emit_on_error_cleanups`
    # at `stmts/mod.rs:357`, called from `lower_throw`/`lower_rethrow_expr`).
    # A bare push with no consumer would be dead code, so the consumer is
    # wired at both error-return sites.
    Vector[Vector[Stmt]] on_error_blocks
    # One-shot suppress flag for the centralized Result→T auto-propagation
    # hook (mirrors Rust gg's `func_state.suppress_auto_prop`,
    # `src/ir/lowering/context.rs:249` + `exprs/mod.rs:78`). Sites that need
    # the RAW `Result` operand even at a Call/MethodCall position — match
    # scrutinees whose arms discriminate `Ok`/`Error`/`Some`/`None`, `catch`
    # inner, `rethrow` inner — set this true immediately before calling
    # `lower_expr`. `lower_expr` consumes it (resets to false) at entry, so
    # nested sub-expressions still auto-prop normally. Default false.
    bool suppress_auto_prop

# ── Helpers ──────────────────────────────────────────────

Option[String] NO_NAME = None

# named_locals helpers — kept as a thin layer over the Dict so we can
# swap the storage shape without touching call sites.
bool nl_contains(LowerCtx &ctx, String name):
    return ctx.named_locals.contains(name)

int nl_get(LowerCtx &ctx, String name):
    if ctx.named_locals.contains(name):
        return ctx.named_locals.get(name).unwrap()
    return -1

void nl_put(LowerCtx &ctx, String name, int val):
    ctx.named_locals.put(name.clone(), val)

# Diagnostic helper for unhandled AST variants. Called from the
# `else: ...` fall-through arms in lower_stmt / lower_expr. The message
# is wrapped in a /* ... */ C comment so it embeds harmlessly in the
# stage-0 stdout → stage-1 C channel. After a stage-0 run,
# `grep '\[lower_fail\]' stage1.c` surfaces every silently-dropped
# variant encountered during compilation.
void lower_fail(String msg):
    print("/* [lower_fail] " + msg + " */")

# Diagnostics for silent-fallback sites. Earlier versions of the
# self-host made several dispatch functions (map_binop,
# infer_method_return_type, collection_element_type, type_id_to_name,
# EFieldAccess, EIdentifier) quietly return a sentinel value for any
# unrecognised input — hiding real bugs that compounded into runtime
# corruption. Every "hard bug" fallback now emits a `[bug]` diagnostic
# so the mis-compilation is visible in the produced output. Grep
# `\[bug\]` on stage-0/stage-1 output to surface them.
#
# Loud by default; if the diagnostic volume gets painful (stage-1 running
# on its own source emits ~58k diagnostics today because many function
# parameters aren't ending up in `named_locals` — a separate bug still
# under investigation), grep for the unique messages via
# `sort -u | uniq -c` and wrap compilation in `| grep -v '\\[bug\\]'` to
# mute the stream while still having the counts on demand.
void diag_bug(String site, String msg):
    print("/* [bug] " + site + ": " + msg + " */")

void diag_warn(String site, String msg):
    print("/* [warn] " + site + ": " + msg + " */")

# Return the variant name of a Stmt. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling.
# Return the variant name of an Expr. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling. Mirrors
# `stmt_kind` for the Expr side.
String expr_kind(Expr e):
    match e:
        case EIntLiteral(_):
            return "EIntLiteral"
        case EFloatLiteral(_):
            return "EFloatLiteral"
        case EBoolLiteral(_):
            return "EBoolLiteral"
        case EStringLiteral(_, _):
            return "EStringLiteral"
        case ECharLiteral(_):
            return "ECharLiteral"
        case ENoneLiteral:
            return "ENoneLiteral"
        case EIdentifier(_):
            return "EIdentifier"
        case ESelfExpr:
            return "ESelfExpr"
        case EIt:
            return "EIt"
        case EBinaryOp(_, _, _):
            return "EBinaryOp"
        case EUnaryOp(_, _):
            return "EUnaryOp"
        case ECall(_, _, _):
            return "ECall"
        case EMethodCall(_, _, _, _):
            return "EMethodCall"
        case EFieldAccess(_, _):
            return "EFieldAccess"
        case EIndex(_, _):
            return "EIndex"
        case ERange(_, _):
            return "ERange"
        case EIf(_, _, _):
            return "EIf"
        case EMatch(_, _):
            return "EMatch"
        case EClosure(_, _):
            return "EClosure"
        case EImplicitClosure(_):
            return "EImplicitClosure"
        case EArrayLiteral(_):
            return "EArrayLiteral"
        case ETupleLiteral(_):
            return "ETupleLiteral"
        case EDictLiteral(_, _):
            return "EDictLiteral"
        case EStructLiteral(_, _, _):
            return "EStructLiteral"
        case EDotShorthand(_, _):
            return "EDotShorthand"
        case ETry(_):
            return "ETry"
        case EMove(_):
            return "EMove"
        case EMutableBorrow(_):
            return "EMutableBorrow"
        case EDeref(_):
            return "EDeref"
        case EAs(_, _):
            return "EAs"
        case EBlock(_):
            return "EBlock"
        case EListComp(_, _, _, _):
            return "EListComp"
        case ESetComp(_, _, _, _):
            return "ESetComp"
        case EDictComp(_, _, _, _):
            return "EDictComp"
        case EDefaultOp(_, _):
            return "EDefaultOp"
        case EIs(_, _, _):
            return "EIs"
        case EDo(_):
            return "EDo"
        case EAwait(_):
            return "EAwait"
        case ESpawn(_):
            return "ESpawn"
        case ESpawnBlocking(_):
            return "ESpawnBlocking"
        else:
            return "?unknown_expr?"

String pat_kind(Pattern p):
    match p:
        case PWildcard:
            return "PWildcard"
        case PBinding(_):
            return "PBinding"
        case PLiteral(_):
            return "PLiteral"
        case PConstructor(_, _):
            return "PConstructor"
        case PDotShorthand(_, _):
            return "PDotShorthand"
        case PTuple(_):
            return "PTuple"
        case POr(_):
            return "POr"
        case PRest:
            return "PRest"
        else:
            return "?unknown_pat?"

String stmt_kind(Stmt s):
    match s:
        case SVarDecl(_, _, _, _, _, _):
            return "SVarDecl"
        case SAssign(_, _):
            return "SAssign"
        case SCompoundAssign(_, _, _):
            return "SCompoundAssign"
        case SExpr(_):
            return "SExpr"
        case SReturn(_):
            return "SReturn"
        case SThrow(_):
            return "SThrow"
        case SBreak(_):
            return "SBreak"
        case SContinue:
            return "SContinue"
        case SPass:
            return "SPass"
        case SMeta:
            return "SMeta"
        case SMetaFor(_):
            return "SMetaFor"
        case SMetaIf(_, _):
            return "SMetaIf"
        case SFor(_, _, _, _, _):
            return "SFor"
        case SWhile(_, _):
            return "SWhile"
        case SLoop(_):
            return "SLoop"
        case SIf(_, _, _):
            return "SIf"
        case SMatch(_, _):
            return "SMatch"
        case SMetaForMatch(_, _, _):
            return "SMetaForMatch"
        case SWith(_, _, _):
            return "SWith"
        case SAssert(_, _):
            return "SAssert"
        case SAssertReturn(_, _):
            return "SAssertReturn"
        case SNamedScope(_, _):
            return "SNamedScope"
        case SSelect(_):
            return "SSelect"
        case SOnError(_):
            return "SOnError"
        case SItem(_):
            return "SItem"
        case SSnapshot(_, _, _):
            return "SSnapshot"
    return "?unknown_stmt?"

int add_local(LowerCtx &ctx, int type_id, Option[String] name):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, LoOwned(), BoNone(), false))
    return id

# Phase D step 2: same as `add_local` but with explicit ownership / borrow
# origin. Use when the local's ownership state is something other than the
# default LoOwned/BoNone — e.g. function parameters (LoParam/BoParam),
# locals bound to collection-getter results (LoBorrowed/BoCollectionElement),
# CoW view results (LoView/BoRuntimeView). Validators in Phase C read
# these fields to decide whether a consume site needs a clone, a move,
# or a borrow. See `docs/devbook/26-self-host-frontend.md` §4.
int add_local_with(LowerCtx &ctx, int type_id, Option[String] name, LocalOwnership ownership, BorrowOrigin borrow_origin):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, ownership, borrow_origin, false))
    return id

# Phase 3 (2026-05-22) — Class 8 keystone fix.
#
# Allocate a fresh local that BINDS to an existing source local: if `src`
# is itself a borrow (LoBorrowed) or a view (LoView) into someone else's
# heap, the fresh dst MUST inherit that ownership tag — otherwise the
# downstream `GIAssign(dst, op_consume(src, ...))` byte-copies the alias
# into an LoOwned slot, which COMMIT 3 / Phase 2.3 then treats as a real
# owner and either double-frees (drop-at-scope-exit) or clones a borrowed-
# interior pointer (crash inside the clone).
#
# Mirrors the SVarDecl Prereq B carve-out at line ~4842 — single source of
# truth at the writer site. Every intermediate-temp binding that the
# lowerer emits as `add_local + GIAssign(dst, op_consume(src, kind))`
# routes through here so the LoBorrowed/LoView tag propagates through the
# chain. Sites that consciously want a FRESH-OWNED binding (e.g., an
# explicit `.clone()`) keep using `add_local` and don't go through this
# helper — the inheritance only fires when the source itself is a borrow.
#
# Caller contract: the returned local is meant to be assigned via
# `GIAssign(dst, op_consume(src, kind))` (or an equivalent) immediately
# after the call. Consumers that later mutate the dst (e.g., a SVarDecl
# rebinding the local on later reassignment) are responsible for the
# usual ownership updates — the helper only sets the INITIAL tag.
#
# See `docs/devbook/11-copy-on-write.md` (materialisation points) and
# `CLAUDE.md` "Layering discipline — debugging heuristic":
# the bug at every chain link was missing inheritance at the WRITER
# site; fixing it at the reader (op_consume) requires per-call
# heuristics, while fixing it at the writer is a one-liner.
int add_local_inheriting(LowerCtx &ctx, int type_id, Option[String] name, int src):
    GirLocal src_loc = ctx.locals.get(src).unwrap()
    match src_loc.ownership:
        case LoBorrowed():
            return add_local_with(&ctx, type_id, name, LoBorrowed(), src_loc.borrow_origin)
        case LoView():
            return add_local_with(&ctx, type_id, name, LoView(), src_loc.borrow_origin)
        else:
            return add_local(&ctx, type_id, name)

# String methods that return a non-owning VIEW (cap==0) aliasing the
# receiver's buffer are now declared in STRING_BUILTIN_METHODS
# (compiler/data/resources.gg) via the `returns_view` column, mirroring
# Rust's `returns_view: true` builtins (`src/ir/lowering/builtins.rs`
# GorgetString block). The runtime helpers (`gorget_str_slice`/`_trim`/
# `_strip`/...) all return `gorget_str_view_region` into `self.data`, so
# the result local MUST be tagged LoView at the consume site (below) — see
# the LoView tagging comment there for the dangling-alias corruption this
# prevents. Read via `string_builtin_method(mname).returns_view`.

# Collection kind of a (possibly mangled) receiver type name, or
# CkNotCollection if `tname` isn't a known resource collection.
# Thin wrapper over `resource_meta_for` so callers can read the kind
# without each re-matching the Option (single source of truth: the
# lazy cascade in lir_lower.gg).
CollectionKind collection_kind_of(GirModule &gmod, String tname):
    match resource_meta_for(&gmod, tname):
        case Some(rm):
            return rm.collection_kind
        case None:
            return CkNotCollection()

# Per CLAUDE.md "Ownership at Consuming Positions": a collection mutator
# takes OWNERSHIP of the value it stores (and, for Dict, the key). The
# per-(kind, method, index) owning-arg truth that used to live in a
# `is_owning_mutator_arg` name+index match is now DATA in
# COLLECTION_BUILTIN_METHODS (compiler/data/resources.gg), keyed by the
# RESOLVED CollectionKind and read at the consume site via
# `collection_builtin_method(kind, mname).owning_arg_positions`.
#
# Reference: Rust's `consuming_positions`
# (`src/ir/lowering/exprs/methods.rs:1850`) is name-keyed (push/add/… →
# [0]; put/set/insert → [0,1]) and gated only by excluding GorgetString
# string-builders — Rust can be name-only because it consumes BOTH
# put/set/insert positions and the index arg is a primitive (so
# `ensure_owned_at_consuming_arg` is a no-op there). The self-host stays
# KIND-AWARE because the kind disambiguates `set` = (idx,value) on a
# Vector vs (key,value) on a Dict, and `insert` = (idx,value) on a Vector
# vs (value) on a Set; the resolved kind is also the safety boundary
# against hijacking a user method that happens to share a name. Aligns
# with the runtime by-pointer-into-storage args in lir_lower.gg's
# `needs_ptr_arg` (gorget_array_push@1, _set@2, _insert@2,
# gorget_map_put@1&2, gorget_set_add@1).

# Typed-table accessors over STRING_BUILTIN_METHODS / COLLECTION_BUILTIN_METHODS
# (compiler.data.resources) — mirror lir_lower.gg's `lookup_resource_table`
# reading RESOURCES. They replace the three raw name-match lists with a
# single typed source of truth; consumers read the typed columns
# (returns_view / owning_arg_positions / ret_kind) off the returned decl.

# Variant-to-variant CollectionKind equality (no derived `==`; pure match
# over two real enums — never an int code). Used to key the collection
# builtin table by the RESOLVED receiver kind.
bool collection_kind_eq(CollectionKind a, CollectionKind b):
    match a:
        case CkVector():
            match b:
                case CkVector():
                    return true
                else:
                    return false
        case CkDeque():
            match b:
                case CkDeque():
                    return true
                else:
                    return false
        case CkHeap():
            match b:
                case CkHeap():
                    return true
                else:
                    return false
        case CkDict():
            match b:
                case CkDict():
                    return true
                else:
                    return false
        case CkSet():
            match b:
                case CkSet():
                    return true
                else:
                    return false
        case CkNotCollection():
            match b:
                case CkNotCollection():
                    return true
                else:
                    return false

# True iff `x` is a member of `v`. Explicit loop (not the `in` operator)
# so the self-host lowerer's own bootstrap doesn't depend on `in`-membership
# lowering for a Vector[int].
bool int_vec_contains(Vector[int] v, int x):
    for e in v:
        if e == x:
            return true
    return false

# Look up a String builtin method by name. Returns the typed decl (carrying
# the independent returns_view + ret_kind columns) or None for non-String
# builtins. Consult under the existing String-receiver gate at the call site.
Option[BuiltinMethodDecl] string_builtin_method(String mname):
    for d in STRING_BUILTIN_METHODS:
        if d.name == mname:
            return Some(d.clone())
    return None

# Look up a collection mutator declaration by RESOLVED CollectionKind +
# method name. Returns the typed decl (carrying owning_arg_positions) or
# None. The kind must come from the resource table (collection_kind_of),
# never from a re-listed receiver type-name alias.
Option[BuiltinMethodDecl] collection_builtin_method(CollectionKind kind, String mname):
    for entry in COLLECTION_BUILTIN_METHODS:
        if collection_kind_eq(entry.collection_kind, kind):
            for d in entry.methods:
                if d.name == mname:
                    return Some(d.clone())
    return None

void emit(LowerCtx &ctx, Instruction inst):
    ctx.block_insts.get(ctx.current_block).unwrap().push(inst)

int new_block(LowerCtx &ctx):
    int id = ctx.block_insts.len()
    Vector[Instruction] empty_insts = []
    ctx.block_insts.push(!empty_insts)
    ctx.block_terms.push(GTNone())
    return id

void switch_to(LowerCtx &ctx, int block_id):
    ctx.current_block = block_id

void set_terminator(LowerCtx &ctx, Terminator term):
    ctx.block_terms.set(ctx.current_block, term)

# Phase 2c COMMIT 3 Prereq B-extension (2026-05-21) — propagate a
# LoBorrowed/LoView ownership tag from `src` onto `dst` when `dst`
# is a method-chain result that byte-aliases `src`'s data. Without
# this, `.unwrap()` of a borrowed Option / Result produces an
# LoOwned local that double-frees the alias when COMMIT 3 drops it
# at scope exit.
#
# Caller contract:
#   • `dst` was just allocated by `emit_payload_read` (or a similar
#     method-chain handler). Its current ownership tag is whatever
#     `emit_payload_read` set — typically LoBorrowed/BoField if no
#     clone fired, LoOwned if the payload was materialised via
#     `<Type>__clone`.
#   • `src` is the receiver whose ownership we want to inherit.
#
# Demotion rule (mirrors Rust's `materialise_via_clone` post-pass
# in `src/ir/lowering/method_call.rs:412`): only demote when dst
# is currently a borrow alias. If dst is LoOwned, the upstream
# already cloned and dst genuinely owns its data — demoting would
# skip the drop at scope exit and leak.
#
# Result-side rule:
#   • src LoBorrowed → dst LoBorrowed (inherit src's borrow_origin)
#   • src LoView     → dst LoView (inherit src's borrow_origin)
#   • src LoOwned/LoParam/LoMaybeOwned → no change (dst keeps its
#     own ownership; the chain produced a fresh owner whose drop
#     is independent).
void inherit_borrow_from(LowerCtx &ctx, int dst, int src):
    GirLocal dst_loc = ctx.locals.get(dst).unwrap()
    GirLocal src_loc = ctx.locals.get(src).unwrap()
    # Only demote if dst is currently a borrow alias (no clone fired).
    bool dst_is_alias = false
    match dst_loc.ownership:
        case LoBorrowed():
            dst_is_alias = true
        case LoView():
            dst_is_alias = true
        else:
            pass
    if not dst_is_alias:
        return
    # Inherit ownership + borrow_origin from src when src is itself
    # a borrow. Owned src → no propagation (the alias bridges across
    # ownership transfer, which is fine — the dst still aliases
    # heap that src owns, but src's scope-exit drop covers the
    # heap regardless of which local is registered).
    LocalOwnership new_own = dst_loc.ownership
    BorrowOrigin new_origin = dst_loc.borrow_origin
    bool propagate = false
    match src_loc.ownership:
        case LoBorrowed():
            new_own = LoBorrowed()
            new_origin = src_loc.borrow_origin
            propagate = true
        case LoView():
            new_own = LoView()
            new_origin = src_loc.borrow_origin
            propagate = true
        else:
            pass
    if not propagate:
        return
    GirLocal updated = GirLocal(dst_loc.type_id, dst_loc.name_hint, new_own, new_origin, dst_loc.owning_param)
    ctx.locals.set(dst, updated)

# ── BorrowOrigin tracking helpers (C.1, 2026-05-22) ─────────
#
# Dead-code scaffolding to mirror Rust's borrow/return-corruption
# machinery (`src/ir/lowering/context.rs:2255-2410`). Subsequent
# commits wire callers:
#   • A.2: `EFieldAccess` writes `set_field_borrow` at GIFieldLoad
#     emission so the dst local carries its parent struct's identity.
#   • B.1: bare-identifier rebinds in SVarDecl call `cow_register_alias`
#     so the dst inherits the source's origin transitively.
#   • E.1: return-path validator reads back via `field_borrow_origin`
#     to flag "returning a borrow into a local stack frame".
#
# C.1 itself adds the enum payloads + these helpers but no caller is
# wired — validation gate is build/lib/lowerer_comparison stays green
# precisely because nothing reads/writes the new state.

# Small helper struct for `field_borrow_origin` return — Gorget doesn't
# have a generic `Pair` and inlining the two ints into separate Option
# returns would change the helper's shape from Rust's
# `Option<(LocalId, u32)>`. Keeping the struct local to this module
# preserves the Rust-side signature 1:1 at the call sites that A.2
# / B.1 will introduce.
struct FieldBorrowPair:
    int base
    int field

# Write `BoField(base, field)` as `dst`'s borrow_origin. Mirrors Rust's
# `set_field_borrow` (`src/ir/lowering/context.rs:2255`).
#
# Caller contract (A.2): called immediately after `add_local_with` /
# emit_payload_read materialises a `dst` local that carries a struct-
# field borrow. `base` is the parent aggregate local; `field` is the
# 0-based index into the struct/variant payload.
#
# Dead code at C.1: no caller wired. A.2 wires the EFieldAccess path.
void set_field_borrow(LowerCtx &ctx, int dst, int base, int field):
    if dst < 0 or dst >= ctx.locals.len():
        return
    GirLocal loc = ctx.locals.get(dst).unwrap()
    GirLocal updated = GirLocal(loc.type_id, loc.name_hint, loc.ownership, BoField(base, field), loc.owning_param)
    ctx.locals.set(dst, updated)

# Read back the `(base, field)` pair from a local's borrow_origin.
# Returns None when the local isn't a BoField borrow. Mirrors Rust's
# `field_borrow_origin` (`src/ir/lowering/context.rs:2268`).
#
# Dead code at C.1: no caller reads. E.1 wires the return-path
# validator that pattern-matches on this.
Option[FieldBorrowPair] field_borrow_origin(LowerCtx &ctx, int local):
    if local < 0 or local >= ctx.locals.len():
        return None
    GirLocal loc = ctx.locals.get(local).unwrap()
    match loc.borrow_origin:
        case BoField(base, field):
            return Some(FieldBorrowPair(base, field))
        else:
            return None

# Register `alias` as a transitive borrow of `source`. Writes
# `BoAlias(source)` into the alias's borrow_origin so downstream
# resolvers can chase the chain to the root. Mirrors Rust's
# `cow_register_alias` (`src/ir/lowering/context.rs:2532`).
#
# Note: Rust's version eagerly resolves the chain at write time
# (`cow_resolve_root`) and stores the ROOT, not the immediate source.
# The self-host helper stores the immediate source — chain-walk is
# the reader's job, mirroring how `add_local_inheriting` propagates
# origins one step at a time. The two strategies are observationally
# equivalent as long as the reader walks; B.1 will pick the strategy
# (probably chase-on-write, matching Rust) when it wires callers.
#
# Dead code at C.1: no caller wired. B.1 wires the bare-rebind path
# in SVarDecl / decide_operand_at_consuming_arg.
void cow_register_alias(LowerCtx &ctx, int alias, int source):
    if alias < 0 or alias >= ctx.locals.len():
        return
    GirLocal alias_loc = ctx.locals.get(alias).unwrap()
    GirLocal updated = GirLocal(alias_loc.type_id, alias_loc.name_hint, alias_loc.ownership, BoAlias(source), alias_loc.owning_param)
    ctx.locals.set(alias, updated)

# ── SVarDecl assign-mode decision tree (B.1, 2026-05-22) ────
#
# Mirrors Rust's `lower_var_decl_assign_mode`
# (`src/ir/lowering/stmts/mod.rs:1055-1273`). Seven branches A-G,
# each predicated on the cross-product of (source ownership,
# source type, declared type, liveness, CoW-safety). The branches
# collapse to one of three emission strategies, returned via the
# `SVarDeclEmission` enum below.
#
# Pragmas in this self-host port:
#   • `declared_is_live = true` everywhere. Self-host's
#     `compute_liveness` runs AFTER lowering, so at SVarDecl
#     emission time there's no last-use info to consult. The
#     wire pass refines OpMove vs OpClone downstream; Branch F's
#     "dead source" case isn't reachable from initial lowering
#     with this conservative assumption — that's OK.
#   • CoW-safe = true. Rust's `is_cow_unsafe_at` checks the
#     `@mut:path` set from `cow_after_block`; self-host doesn't
#     track this yet. Conservative direction: allow Branch C to
#     fire (alias instead of clone). If correctness issues surface
#     we can defer to Branch D's clone fallback.
#   • Branch C does NOT retype dst's slot to Ptr(T). Rust retypes
#     and `set_ref` so the LIR backend takes a SlotAddr at the
#     assignment. Self-host's `OpBorrow → ISlotLoad` shape would
#     load the 32-byte resource VALUE into an 8-byte LT_PTR slot —
#     either truncating bytes or hitting the `lir_codegen.gg:2611`
#     "ptr slot ← aggregate value → assign NULL" coercion. Until
#     a `GIBorrow` instruction (or per-assign SlotAddr dispatch) is
#     wired in lir_lower, Branch C stays at the value-typed slot;
#     the LoBorrowed ownership tag carries the borrow-semantic. The
#     byte-aliasing works because both slots hold the same value
#     representation, and `register_local_for_drop` is skipped for
#     the alias (drop discipline preserved).
#
# Why `add_local_inheriting` stays. Phase 3's intermediate-temp
# binding helper (lower.gg:~435) is for sites that bind FROM a
# single source local at IR construction time (match scrutinee,
# PBinding, PCtor field, etc.) — those sites do not go through the
# 7-branch tree. Only user-level SVarDecl declarations with a
# declared type take this path.

enum SVarDeclEmission:
    BorrowAlias()                  # mark dst LoBorrowed/BoAlias, no drop register
    CloneAndMove(String)           # emit `<clone_fn>(&src)` then Move into dst
    MoveDirect()                   # existing path — direct Move via op_consume

# Decide which of the three emission strategies SVarDecl should use
# for `var_type x = val`. Returns an `SVarDeclEmission` variant; the
# caller emits the corresponding IR. Pragmas: declared_is_live=true,
# CoW-safe=true (see top-of-section docstring).
SVarDeclEmission decide_svardecl_emission(LowerCtx &ctx, GirModule &gmod, int val, int var_type):
    if val < 0 or val >= ctx.locals.len():
        return MoveDirect()
    GirLocal val_loc = ctx.locals.get(val).unwrap()
    int source_type = val_loc.type_id
    String source_tname = type_id_to_name(source_type, &gmod)
    String var_tname = type_id_to_name(var_type, &gmod)
    bool source_is_resource = is_resource_type_name(source_tname, &gmod)
    # A GtPtr/GtMutPtr SOURCE (e.g. the `GtPtr(GorgetString)` borrow that
    # `coll.get(i).unwrap()` yields from an Option[Ref] payload) must NOT take
    # the value-alias Branch A — it has to fall through to Branch C-pre's
    # deref+clone. Mirrors Rust `lower_var_decl_assign_mode`
    # (src/ir/lowering/stmts/mod.rs:1140-1141), whose `same_type_string` test
    # compares the SOURCE's type id to the value GorgetString id — a Ptr source
    # fails it. The self-host's `var_tname == "GorgetString"` is a name-collapse
    # (`type_id_to_name(GtPtr(GorgetString))` → "GorgetString") and `var_type`
    # stays `GtPtr(GorgetString)` because the declared-type override (~line 5577)
    # only fires for "__" names — so without this typed guard, Branch A
    # BorrowAlias pre-empts Branch C-pre and the owned bind aliases the
    # collection element → use-after-free (populate_drop_metadata's
    # `recursive_drop_structs.put(tname, …)` dangling String key, lir_lower.gg
    # :3589). Typed check, not a name match.
    bool source_is_ptr_type = false
    if source_type >= 0 and source_type < gmod.type_table.len():
        match gmod.type_table.get(source_type).unwrap():
            case GtPtr(_):
                source_is_ptr_type = true
            case GtMutPtr(_):
                source_is_ptr_type = true
            else:
                pass
    bool is_string_same_type = (source_type == var_type) and (var_tname == "GorgetString") and (not source_is_ptr_type)
    String clone_fn = resolve_payload_clone_fn(var_tname, &gmod)

    bool source_is_borrow_alias = false
    match val_loc.ownership:
        case LoBorrowed():
            source_is_borrow_alias = true
        case LoView():
            source_is_borrow_alias = true
        else:
            pass

    # Branch A — (live) GorgetString same-type, source IS a borrow alias.
    # Value-aliasing `String b = a` shape where `a` is itself a borrow
    # into another aggregate. Inherit the chain so the root owner's drop
    # covers both. (Rust additionally fires Branch A for fresh-Owned
    # sources via `set_shared_heap`; the self-host pragma defers that
    # because there's no SharedHeap ownership state nor drop tracker
    # that consults it — fresh-Owned String sources continue through
    # MoveDirect, which transfers ownership cleanly.)
    if source_is_borrow_alias and is_string_same_type:
        return BorrowAlias()

    # Branch B — Owned + (live) non-resource source, cross-type clone_fn
    # available (e.g. Str → GorgetString). Self-host doesn't have a
    # distinct non-resource cloneable type, so this branch is effectively
    # dead — kept for parity / future evolution. The cstr→GorgetString
    # coercion at the SVarDecl handler entry handles the analogous
    # path before this tree fires.
    match val_loc.ownership:
        case LoOwned():
            if (not source_is_resource) and (source_type != var_type) and (clone_fn != ""):
                return CloneAndMove(clone_fn)
        else:
            pass

    # Branch C-pre (option_ref_borrow Phase 4a) — GtPtr-to-resource source
    # bound to an OWNED local. This is the `T x = coll.get(i).unwrap()` shape:
    # `.get()` now returns `Option[Ref[T]]`, so the unwrapped payload is a
    # `GtPtr(T)` borrow (`LoBorrowed`) whose pointer is the element's address
    # in the collection. Aliasing it into an "owned" `x` (Branch C →
    # BorrowAlias) would make `x` share the collection's heap → double-free
    # when both drop. The owned bind must instead DEREF+CLONE the pointee:
    # `T__clone(OpBorrow(val))` materializes a fresh, independent owner.
    #
    # Match on the GIR TYPE, not the name: `type_id_to_name(GtPtr(T))`
    # collapses to "T" (lower.gg:~2884), so `source_tname` already reads as
    # the resource pointee name — indistinguishable from a value-typed `T`
    # source by name alone. The typed `GtPtr(inner)` shape is the only sound
    # discriminator. This branch MUST precede Branch C (whose name-based
    # `source_is_resource and source_is_borrow_alias` would otherwise fire
    # BorrowAlias for this exact shape).
    #
    # `GtMutPtr(inner)` is handled symmetrically. `&T` (MutableBorrow) and
    # `!T` (Move) params both lower to `GtMutPtr(T)` (resolve_param_type at
    # context.rs:1613; mirrored at lower.gg:~7255). The `String call_name =
    # fname` shape — bare-binding a `&String` param into a value-typed
    # local — has exactly the same dangling-alias risk as `GtPtr` if not
    # cloned: the dst slot would point into the caller's storage, and a
    # `gmod.call_redirects.contains(call_name)` Dict-key hash later would
    # dereference a slot that wasn't owned by this frame (NULL after
    # frame-exit zeroing). Concretely this was the lower_call SIGSEGV in
    # self_host_bootstrap_fixed_point: the s1bin emitted `__s77 = NULL;`
    # because the dst slot type stayed `GtMutPtr(String)` while the
    # OpClone result was a value `Str` — lir_codegen.gg:2809-2810's
    # "pointer slot receiving aggregate value → assign NULL" give-up
    # branch fired. The structural fix is here at the writer: clone+move
    # at the var-decl site so the dst is value-typed and the slot store
    # is a clean value-into-value copy.
    #
    # `OpBorrow(val)` on a `GtPtr`/`GtMutPtr`/`LT_PTR` slot passes the
    # POINTER value (the `const T*` the clone fn wants), not the slot
    # address — verified at lir_lower.gg:~2830-2843 (GICallExtern
    # OpBorrow arm, `slot_ty == LT_PTR` → pass loaded value directly).
    # So `CloneAndMove`'s `GICallExtern(cloned, clone_fn, [OpBorrow(val)])`
    # (lower.gg:~5586) deref-clones correctly for both.
    if source_type >= 0 and source_type < gmod.type_table.len():
        GirType src_gt = gmod.type_table.get(source_type).unwrap()
        match src_gt:
            case GtPtr(inner_tid):
                String pointee_tname = type_id_to_name(inner_tid, &gmod)
                String pointee_clone_fn = resolve_payload_clone_fn(pointee_tname, &gmod)
                if pointee_clone_fn != "":
                    return CloneAndMove(pointee_clone_fn)
            case GtMutPtr(inner_tid):
                String pointee_tname_m = type_id_to_name(inner_tid, &gmod)
                String pointee_clone_fn_m = resolve_payload_clone_fn(pointee_tname_m, &gmod)
                if pointee_clone_fn_m != "":
                    return CloneAndMove(pointee_clone_fn_m)
            else:
                pass

    # Branch C — live resource SOURCE that's a borrow alias (transitive
    # chain). Mirrors Rust's `is_resource_type(rhs_type)` predicate where
    # `rhs_type` is the SOURCE's type. Self-host pragma: fire only for
    # already-borrow sources (LoBorrowed/LoView). Fresh-Owned resource
    # sources flow through MoveDirect; without `set_shared_heap` /
    # alias-tracked drop, MoveDirect's ownership transfer is the safe
    # default — the dst becomes the sole owner and registers for drop.
    # This collapses Rust's "Branch C for Owned + Branch C for borrowed"
    # asymmetry into the borrowed half only; the Owned half is handled
    # by MoveDirect. Functionally observable difference: zero — Rust's
    # Owned-Branch-C path is the `set_shared_heap` shape whose self-host
    # equivalent isn't built yet.
    if source_is_resource and source_is_borrow_alias:
        return BorrowAlias()

    # Branch D — live resource source, CoW-unsafe + non-Borrowed source.
    # Self-host's CoW-safe pragma never triggers this branch from C
    # falling through directly; kept as a defensive defer for any future
    # `is_cow_unsafe_at` wire-up. Borrowed sources skip — cloning a borrow
    # chain would compound the alias issue, not resolve it.
    if source_is_resource and (not source_is_borrow_alias) and (clone_fn != ""):
        # No CoW-unsafe trigger today, so don't preemptively clone.
        # Leave for future is_cow_unsafe_at wire-up. The fresh-Owned
        # resource path falls through to MoveDirect below.
        pass

    # Branch E — View source, same-type. Rust emits a clone-to-owned
    # so the alias materializes into an independent owner (captures the
    # CoW-view's `auto x = s.slice(...)` shape where x must outlive the
    # underlying buffer's mutation point). Self-host's CoW-safe pragma
    # routes LoView sources through Branch C above (BorrowAlias) — the
    # CoW-default-borrow design intent is to alias, not materialize.
    # If a `cow_after_block` / `is_cow_unsafe_at` wire-up lands later
    # and flips Branch C off for a specific (local, position) pair,
    # this branch becomes reachable; for now it's dead.

    # Branch F + G — fall through to direct Move. Primitives, FnPtr,
    # non-resource user types, AND fresh-Owned resource sources (per
    # the self-host's Owned-Branch-A/C pragma) all land here. Move is
    # identity-by-bytes for primitives; for resources, op_consume
    # returns OpMove and the wire pass refines based on liveness.
    return MoveDirect()

# ── Drop elaboration (mirrors src/ir/lowering/drops.rs) ─────
#
# A drop scope corresponds to a language construct that owns locals
# (function / loop body / if-branch / match-arm / etc.). At scope
# entry we push a fresh DropScope; at scope exit we pop and emit a
# `GIDropIfAlive(local_id)` for every owned, resource-typed local
# registered in that scope, LIFO order.
#
# Early exits (return / break / continue) walk the scope stack
# innermost-out and emit drops without popping — the surrounding
# scope's later pop_drop_scope is responsible for cleanup if the
# early exit branch is the only path through the scope.
#
# Why GIDropIfAlive (not GIDrop)?  The LIR-side handler in
# `lir_lower.gg:2989-3015` wraps the runtime drop call in an
# `IDropGuardOpen(byte_size+1) / IDropGuardClose` pair, which the
# C codegen materialises as `if (memcmp(&slot, zeros, size) != 0)
# <drop>`. That's a safe, defensive guard: function-entry slots
# are calloc-zeroed, runtime drop fns are NULL-safe, so worst
# case for a possibly-uninit slot is one memcmp returning 0 and
# the drop suppressed. Rust's DropElaborator (`drops.rs:506,542`)
# also emits DropIfAlive unconditionally post-Snag #30 (2026-05-10
# nested-match double-free); we follow the same defensive shape.
# The downstream LIR `drop_elab` pass statically elides the
# memcmp when slot init is provably unconditional, recovering
# the unconditional-drop codegen quality.
#
# Resource classification: `is_droppable_type` checks the local's
# GIR type against `build_resource_metadata` (the single source of
# truth shared with lir_lower.gg) AND `gmod.resource_types` (for
# user-defined struct/enum types with resource fields, populated at
# `lower_module` entry before any function is lowered). Primitives
# and Ptr/MutPtr/FnPtr types are not droppable. Mirrors Rust's
# `needs_drop` in `src/ir/types.rs`.

void init_drop_elab(DropElaborator &de):
    de.scopes = []

void push_drop_scope(DropElaborator &de, int kind):
    Vector[DropEntry] entries = []
    de.scopes.push(DropScope(kind, !entries))

# Emit drops for every entry in the given scope, LIFO order, using
# GIDropIfAlive (see top-of-section docstring for the unconditional-
# DropIfAlive rationale).
#
# **Status: ACTIVE.** Emission runs unconditionally — for each entry
# registered in the scope we emit `GIDropIfAlive(entry.local_id)` in
# reverse registration order. A String/Vector/Dict/Box (or a user
# resource-containing struct, see `is_droppable_type`) bound in a scope
# IS dropped at scope exit today. (The earlier "Phase 2 emission is
# DISABLED / would double-free" note was retired once the move-out side
# matured: `SReturn` move-zeros the returned local and excludes it from
# the scope-exit drops (:7227-7229), and the LIR `IDropGuardOpen` memcmp
# gate suppresses drops of moved-out / zeroed slots — so a moved value is
# dropped exactly once, by its receiver, not double-freed here. The
# scope-tracking + register-local infrastructure is the live drop path,
# not a standalone foundation.)
#
# `bootstrap_fixed_point` (stage-1==stage-2 byte-identical) is the
# strongest regression net here: the driver self-compiles its own scopes
# and re-converges.
void emit_scope_drops(LowerCtx &ctx, Vector[DropEntry] entries):
    # Cluster (a) probe: emit GIDropIfAlive unconditionally in LIFO order.
    int i = entries.len() - 1
    while i >= 0:
        DropEntry entry = entries.get(i).unwrap()
        emit(&ctx, GIDropIfAlive(entry.local_id))
        i = i - 1

# Pop the innermost scope and emit its drops at the current block IF
# the current block's terminator is still GTNone (i.e. we're on the
# natural fall-through exit). When the terminator is already set
# (explicit return / break / continue already emitted their own
# drops via emit_drops_for_early_exit), pop without re-emitting to
# avoid stranding dead instructions after a finalised terminator.
void pop_drop_scope(LowerCtx &ctx):
    if ctx.drop_elab.scopes.len() == 0:
        return
    DropScope scope = ctx.drop_elab.scopes.get(ctx.drop_elab.scopes.len() - 1).unwrap()
    Terminator cur_term = ctx.block_terms.get(ctx.current_block).unwrap()
    bool fall_through = false
    match cur_term:
        case GTNone():
            fall_through = true
        else:
            pass
    if fall_through:
        emit_scope_drops(&ctx, scope.entries)
    ctx.drop_elab.scopes.pop()

# Pop the innermost scope WITHOUT emitting drops. Used at the loop-
# entry/exit pairing in `lower_loop`/`lower_while`/`lower_for_*` — the
# loop body's terminator is either a back-edge jump (no drops needed —
# the same locals re-enter the body next iteration) or a break/continue
# (which already emitted its own drops via emit_drops_for_early_exit).
void pop_drop_scope_no_emit(LowerCtx &ctx):
    if ctx.drop_elab.scopes.len() == 0:
        return
    ctx.drop_elab.scopes.pop()

# Check whether a GIR type id refers to a droppable type. Used at every
# SVarDecl / param-registration site to decide whether to add the local
# to the current drop scope. Primitives, Ptr/MutPtr/FnPtr, and POD user
# types (no resource field) are non-droppable.
#
# Two droppable classes qualify:
#   1. RUNTIME resource types (`resource_meta_for`/`build_resource_metadata`
#      returns Some) — GorgetString, GorgetArray, Vector__T, Dict__K__V,
#      Box__T, Mutex__/Shared__/Channel__/etc. — always have a runtime
#      `gorget_*_free` in the C preamble, so the emitted `<drop_fn>(&slot)`
#      resolves at link time.
#   2. USER struct/enum types that transitively contain a resource field
#      (collected into `gmod.resource_types` by the fixpoint at :11779-11809).
#      `populate_drop_metadata` (lir_lower.gg:3658) emits a `<Type>__drop`
#      for each via the recursive_drop_structs/recursive_drop_enums tables
#      (the old `__imported_type__` skip that produced "0 defs" was removed
#      2026-05-24), so `Def__drop`/`Stage__drop`/etc. ARE defined and the
#      drop calls link. A value-typed local of such a type leaked before it
#      was registered (leak_method_return_loop).
#
# Mirror of Rust's `needs_drop` (`src/ir/types.rs`) which delegates to
# TypeRegistry.needs_drop — same split: runtime resource OR user
# resource-containing struct/enum = yes, POD = no.
bool is_droppable_type(int type_id, GirModule &gmod):
    if type_id < 0 or type_id < PRIM_COUNT:
        return false
    if type_id >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(type_id).unwrap()
    String tname = ""
    match gt:
        case GtNamed(n):
            tname = n
        case GtPtr(_):
            # Ptr/MutPtr are non-owning aliases — the pointee's
            # owner is responsible for dropping it.
            return false
        case GtMutPtr(_):
            return false
        case GtFnPtr(_, _):
            return false
        else:
            return false
    # Runtime resource types (GorgetString/GorgetArray/Vector__T/Dict__K__V/
    # Box__T/Mutex__/etc.) have a `gorget_*_free` defined in the C preamble —
    # `resource_meta_for` returns Some for them.
    match resource_meta_for(&gmod, tname):
        case Some(_):
            return true
        case None:
            pass
    # User struct/enum types that transitively contain a resource field are
    # collected into `gmod.resource_types` (the fixpoint at :11779-11809), and
    # `populate_drop_metadata` (lir_lower.gg:3658) emits a `<Type>__drop` for
    # each. So a value-typed local of such a type IS droppable. (Only GtNamed
    # reaches here — GtPtr/GtMutPtr/GtFnPtr returned false above. Mangled
    # Option/Result names live in the SEPARATE optionlike_resource_types dict,
    # so this check stays clean and never matches them.)
    if gmod.resource_types.contains(tname):
        return true
    # Mono'd Option__X / Result__X__E whose payload owns a resource and that
    # appears as a LOCAL / return-value / scrutinee type (the field-position
    # instances ARE in optionlike_resource_types, but locals/returns are NOT —
    # register_optionlike_resource only walks struct/enum fields). We must NOT
    # add these to optionlike_resource_types: that dict ALSO drives the
    # clone/borrow ABI (is_resource_type_name), and flipping a by-value
    # Result__int__String param to "resource" breaks its pass-by-value ABI
    # (variant_auto_ok_inference: `show(r)` passed `&r` to a by-value param).
    # Instead decompose the mangled name structurally and check payload
    # droppability — a pure DROP-axis decision, no ABI side-effect. lir_lower's
    # drop_fn_for_type mirrors this so the GIDropIfAlive resolves <Type>__drop.
    if gmod.optionlike_resource_types.contains(tname):
        return true
    # Mono'd Option/Result droppability: read the payload tids off the
    # typed `enum_category` channel (no mangled-name re-parse). A recorded
    # `Option__Ref__T` carries its `GtPtr(T)` payload here, which
    # `is_droppable_type` correctly rejects (a borrow alias isn't dropped),
    # so the former `Option__Ref__` carve-out is subsumed.
    EnumCategory ec = enum_category_of(&gmod, type_id)
    if ec.category == ENUM_CAT_RESULT:
        if is_droppable_type(ec.ok_type, &gmod) or is_droppable_type(ec.err_type, &gmod):
            return true
    elif ec.category == ENUM_CAT_OPTION:
        if is_droppable_type(ec.ok_type, &gmod):
            return true
    return false

# Register a local in the innermost drop scope. Skips non-droppable
# types so callers can call this blindly after add_local. Skips when
# no scope is open (defensive — should never happen during normal
# function lowering, but cheap to guard).
void register_local_for_drop(LowerCtx &ctx, int local_id, int type_id, GirModule &gmod):
    if not is_droppable_type(type_id, &gmod):
        return
    if ctx.drop_elab.scopes.len() == 0:
        return
    # a-1 (the root fix): only OWNERS get dropped. A local that aliases a
    # borrow (LoBorrowed) or a CoW view (LoView) does NOT own its data —
    # registering it for drop double-frees the real owner's heap (the
    # over-drop that made stage-1's array_free/map_free counts exceed Rust's).
    # Mirrors Rust's register_local, which only registers owned resource
    # locals. (Owning `!T` params arrive here already filtered by the
    # p.ownership==2 gate and are LoParam/LoOwned, so they are unaffected.)
    match ctx.locals.get(local_id).unwrap().ownership:
        case LoBorrowed():
            return
        case LoView():
            return
        else:
            pass
    int top = ctx.drop_elab.scopes.len() - 1
    DropScope scope = ctx.drop_elab.scopes.get(top).unwrap()
    scope.entries.push(DropEntry(local_id, type_id, false))
    ctx.drop_elab.scopes.set(top, scope)

# ── Tier E §8.1: owning `!`-param exit drop ──────────────────────
#
# Register an owning `!`-move resource PARAMETER (sigil ownership==2) for
# drop at function exit. DEDICATED — NOT a reuse of `register_local_for_drop`
# — for two load-bearing reasons:
#
#   (1) It must SET `owning_param=true` on the param's GirLocal. The shared
#       fn doesn't, and that flag is read at the consume-mode decision (D)
#       and the GIDropIfAlive emission (C). Without it the `!`-param is
#       never moved-on-transfer and the drop arg derefs the wrong cell.
#   (2) The param slot is `GtMutPtr(inner)` — `is_droppable_type` REJECTS
#       GtMutPtr (a pointer alias isn't dropped), so passing the wrapper to
#       the shared fn is a silent no-op (the original bug). We deref to
#       `inner` and gate on `is_droppable_type(inner)` so the registration
#       gate passes for a droppable pointee (resource struct, mono'd
#       Option/Result) and skips a non-droppable one (e.g. `!int`).
#
# `maybe_moved` stays false: the §8.1 drop-flag dataflow (the LIR memcmp
# guard, statically resolvable once self-host grows a drop_elab) handles
# transfer — a consumed param flips its slot to UNINITIALIZED via the
# GIMoveZero the move-on-consume (D) emits, and the guard suppresses the
# re-drop. We do NOT pre-mark maybe_moved here (that would suppress the
# drop on the NO-transfer path — the very leak we are fixing).
#
# Caller: the two param-setup loops (`lower_function` free-fn and the
# method loop) call this in place of `register_local_for_drop` at the
# `p.ownership == 2` gate. `&`-borrows (ownership==1) never reach here —
# they are NOT registered (the caller's gate is ownership==2 only), so
# their GirLocal keeps `owning_param=false` and is never moved/derefed.
void register_owning_param(LowerCtx &ctx, int local_id, int type_id, GirModule &gmod):
    if ctx.drop_elab.scopes.len() == 0:
        return
    if local_id < 0 or local_id >= ctx.locals.len():
        return
    # Deref the GtMutPtr(inner) wrapper to the underlying pointee T. The
    # `!`-param slot holds a `T*`; the drop axis cares about T's dropability.
    int inner_tid = type_id
    if type_id >= 0 and type_id < gmod.type_table.len():
        match gmod.type_table.get(type_id).unwrap():
            case GtMutPtr(inner):
                inner_tid = inner
            case GtPtr(inner):
                inner_tid = inner
            else:
                pass
    if not is_droppable_type(inner_tid, &gmod):
        return
    # Set owning_param=true on the param's GirLocal (rebuild-and-set; the
    # GirLocal is a value type — mirror the ctx.locals.set idiom).
    GirLocal ploc = ctx.locals.get(local_id).unwrap()
    ctx.locals.set(local_id, GirLocal(ploc.type_id, ploc.name_hint, ploc.ownership, ploc.borrow_origin, true))
    # Register the inner T for exit drop. Only local_id is load-bearing at
    # emission (GIDropIfAlive resolves the type from the local's own slot),
    # but we record inner_tid for consistency with register_local_for_drop.
    int top = ctx.drop_elab.scopes.len() - 1
    DropScope oscope = ctx.drop_elab.scopes.get(top).unwrap()
    oscope.entries.push(DropEntry(local_id, inner_tid, false))
    ctx.drop_elab.scopes.set(top, oscope)

# Mark a local as "maybe moved" — used at consume sites that transfer
# ownership out of the local. Walks the scope stack innermost-out;
# matches the first entry with the given local_id and sets its
# maybe_moved flag. No-op if the local isn't registered (e.g. it's a
# borrow / non-resource / wasn't tracked).
void mark_local_moved(LowerCtx &ctx, int local_id):
    int si = ctx.drop_elab.scopes.len() - 1
    while si >= 0:
        DropScope scope = ctx.drop_elab.scopes.get(si).unwrap()
        int ei = 0
        while ei < scope.entries.len():
            DropEntry entry = scope.entries.get(ei).unwrap()
            if entry.local_id == local_id:
                entry.maybe_moved = true
                scope.entries.set(ei, entry)
                ctx.drop_elab.scopes.set(si, scope)
                return
            ei += 1
        si -= 1

# Snapshot `maybe_moved` flags across every live scope. Used by branch
# lowerings (lower_if, lower_match) to restore the pre-branch view
# before lowering each alternative branch — otherwise a mark_local_moved
# in the then-branch pollutes the elif-branch's view. Mirrors Rust's
# `DropElaborator::snapshot_moved` (`drops.rs:300-308`).
#
# Storage shape: flat Vector[bool] indexed by (sidx * MAX_PER_SCOPE +
# eidx). MAX_PER_SCOPE is conservatively large; self-host functions
# rarely exceed ~50 droppable locals per scope.
const int SNAPSHOT_MAX_PER_SCOPE = 4096

Vector[bool] snap_moved_state(DropElaborator &de):
    Vector[bool] out = []
    int si = 0
    while si < de.scopes.len():
        DropScope scope = de.scopes.get(si).unwrap()
        int ei = 0
        while ei < scope.entries.len():
            DropEntry entry = scope.entries.get(ei).unwrap()
            # Pad to (si+1)*MAX_PER_SCOPE so flat indexing works:
            # entries beyond the current scope's entry count are
            # implicit false (not yet recorded). We push entries
            # for THIS scope at their (ei + base) position; reads
            # default-to-false for missing indices in restore.
            int target_pos = si * SNAPSHOT_MAX_PER_SCOPE + ei
            while out.len() <= target_pos:
                out.push(false)
            out.set(target_pos, entry.maybe_moved)
            ei += 1
        si += 1
    return out

# Restore `maybe_moved` flags from a snapshot. Entries added since the
# snapshot keep their current `maybe_moved` (they're newer than the
# snapshot frame, occupying positions beyond the snapshot's len).
void restore_moved(DropElaborator &de, Vector[bool] snap):
    int si = 0
    while si < de.scopes.len():
        DropScope scope = de.scopes.get(si).unwrap()
        int ei = 0
        while ei < scope.entries.len():
            int pos = si * SNAPSHOT_MAX_PER_SCOPE + ei
            if pos < snap.len():
                DropEntry entry = scope.entries.get(ei).unwrap()
                bool was = snap.get(pos).unwrap()
                entry.maybe_moved = was
                scope.entries.set(ei, entry)
            ei += 1
        de.scopes.set(si, scope)
        si += 1

# Union `maybe_moved` flags from a branch snapshot into the current
# state — conservative join. If any branch moved a local, the post-
# join state treats it as maybe-moved. Mirrors Rust's `union_moved`
# (`drops.rs:328-337`).
void union_moved(DropElaborator &de, Vector[bool] branch_snap):
    int si = 0
    while si < de.scopes.len():
        DropScope scope = de.scopes.get(si).unwrap()
        int ei = 0
        while ei < scope.entries.len():
            int pos = si * SNAPSHOT_MAX_PER_SCOPE + ei
            if pos < branch_snap.len():
                bool branch_moved = branch_snap.get(pos).unwrap()
                if branch_moved:
                    DropEntry entry = scope.entries.get(ei).unwrap()
                    entry.maybe_moved = true
                    scope.entries.set(ei, entry)
            ei += 1
        de.scopes.set(si, scope)
        si += 1

# Emit cleanup drops for an early exit (return / break / continue).
# Walks scopes innermost-out, would emit GIDropIfAlive for every entry,
# until (and INCLUDING) the target scope kind. For return, target=
# DSK_FUNCTION (drop everything up through Function). For break /
# continue, target=DSK_LOOP. `exclude_local` optionally skips a
# specific local (e.g. _0 — the return place being moved out).
#
# Does NOT pop scopes — that's the surrounding scope's responsibility
# at its natural exit point.
#
# **Phase 2 status: emission is DISABLED.** See `emit_scope_drops`
# docstring for the gap analysis. Scope walking is preserved for
# Phase 3 / future drop_elab to hook into. When the self-host gains
# proper move-out / drop semantics, the no-op walk below becomes a
# one-line `emit(&ctx, GIDropIfAlive(entry.local_id))` inside the
# skip-check.
void emit_drops_for_early_exit(LowerCtx &ctx, int target_kind, Option[int] exclude_local):
    int si = ctx.drop_elab.scopes.len() - 1
    while si >= 0:
        DropScope scope = ctx.drop_elab.scopes.get(si).unwrap()
        int ei = scope.entries.len() - 1
        while ei >= 0:
            DropEntry entry = scope.entries.get(ei).unwrap()
            bool skip = false
            match exclude_local:
                case Some(excl):
                    if entry.local_id == excl:
                        skip = true
                case None:
                    pass
            if not skip:
                emit(&ctx, GIDropIfAlive(entry.local_id))
            ei -= 1
        if scope.kind == target_kind:
            return
        si -= 1

# Phase 2c COMMIT 3 Prereq C — flush the deferred drop queue.
#
# Called AFTER `wire_liveness_into_modes` populates `maybe_moved`
# on every DropEntry. Walks `ctx.drop_queue` and, for each pending
# emission, decides whether to emit a real `GIDropIfAlive` at the
# recorded position gated on `not entry.maybe_moved`.
#
# **Prereq C status**: this is a no-op. The queue is still empty
# because `emit_scope_drops` and `emit_drops_for_early_exit` are
# also still no-ops (they don't push to the queue yet). The
# infrastructure ships standalone so COMMIT 3 can plug in the two
# halves — queue-write at scope-pop / early-exit sites + real
# `GIDropIfAlive` emission here — without further plumbing churn.
#
# When COMMIT 3 enables emission, this body becomes the canonical
# "read maybe_moved, insert GIDropIfAlive at target_block /
# insert_at_inst_idx if the flag says drop is live" loop. The
# scope/entry indices on each `DropEmission` are exactly what the
# read-side needs to look up `maybe_moved` from the captured
# `drop_elab` state — `dse_scope_idx` indexes the scopes snapshot
# (note: scopes have been popped by now, so we'd need to snapshot
# them at queue-record time or pre-flatten the entry directly into
# `DropEmission`. The follow-up commit will pick the right shape).
void flush_drop_queue(LowerCtx &ctx):
    # Prereq C: queue is empty (no recorders), so this loop is a
    # no-op. Touch each entry to keep the field exercised — the
    # release build's dead-field elimination would otherwise hide
    # any constructor-site omissions until COMMIT 3 ships.
    int qi = 0
    while qi < ctx.drop_queue.len():
        DropEmission _em = ctx.drop_queue.get(qi).unwrap()
        int _lid = _em.local_id
        qi += 1

# ── Operand-mode dispatch (Phase C step 5c + Path A Phase 2b) ───
#
# `op_consume` picks the right operand mode for reading `lid` at a
# position whose semantics are described by the typed `ConsumeKind`
# argument. It enforces the *Ownership at Consuming Positions*
# discipline from CLAUDE.md:
#
#   • Non-consume position (CkCallArgBorrow / CkBinOpArg / CkFormatArg /
#     CkMatchPtr) — receiver just reads the value; source stays live.
#     Always returns `OpBorrow(lid)` regardless of source ownership.
#     Phase 2c emission will treat this as a pointer alias. The
#     CkCallArgBorrow inclusion implements the doc model directly: per
#     CLAUDE.md "Ownership at Consuming Positions", bare-call-arg sites
#     propagate Ptr aliases at zero cost; clones only fire at the
#     CkCallArgOwning sites (collection runtime val args + `!T` declared
#     params).
#   • Consume position (CkAssign / CkReturn / CkCallArgOwning /
#     CkFieldWrite) — receiver takes ownership. Dispatch by source:
#       - Non-resource source     → OpCopy (byte-copy is sound for
#         scalars and Ptr/MutPtr aliases; the validator already filters
#         these out).
#       - LoBorrowed/LoView source → OpBorrow (the alias propagates; no
#         ownership transfer at this layer. Phase 2c will flip this to
#         OpClone — the receiver must materialise its own copy).
#       - LoOwned/LoParam/LoMaybeOwned resource → OpMove (the post-pass
#         `wire_liveness_into_modes` may demote to OpClone if not the
#         CFG-last use of `lid`).
#
# Phase 2b — `ConsumeKind` enum (typed metadata) replaces the
# implicit "every op_consume caller is consuming" boolean sidecar.
# Per CLAUDE.md "No name matching" + layering rule 2: each call site
# explicitly names its kind; ambiguous shapes (nested method calls
# whose mutating-status depends on the callee) STOP and file as TODO
# rather than defaulting to consume-with-conservative-clone.
#
# OpClone now emits a real runtime clone call (`lir_lower.gg:2453-2521`);
# OpMove/OpBorrow/OpCopy still lower to `ISlotLoad`. The ownership labels
# written here are the contract that drives clone vs load vs addr selection
# in `lir_lower.gg:2349-2521`.

# Callee-signature-driven classifier for regular call args.
# Returns CkCallArgOwning iff `fname` is in fn_move_params AND the
# `arg_idx`-th param is declared `!T` (OWN_MOVE / ownership==2).
# Otherwise returns CkCallArgBorrow — per CLAUDE.md "Ownership at
# Consuming Positions", bare-`T` callee params propagate the caller's
# Ptr alias at zero cost. Mirrors Rust's `lower_call_arg` switching on
# `param.ownership` (`src/ir/lowering/exprs/calls.rs:187-194`).
#
# Sites that ALWAYS own (collection runtime val args for push/put/set/
# insert/send) bypass this helper and pass CkCallArgOwning directly.
# Sites whose callee signature is genuinely unknown (closure/__callable_N
# dispatch, user-op-overload fallback) pass CkCallArgBorrow directly —
# borrow is the safe default per the docs.
ConsumeKind classify_call_arg(GirModule &gmod, String fname, int arg_idx):
    if not gmod.fn_move_params.contains(fname):
        return CkCallArgBorrow()
    Vector[bool] mflags = gmod.fn_move_params.get(fname).unwrap()
    if arg_idx < 0 or arg_idx >= mflags.len():
        return CkCallArgBorrow()
    if mflags.get(arg_idx).unwrap():
        return CkCallArgOwning()
    return CkCallArgBorrow()

# Partition `ConsumeKind` into consume vs borrow positions. Single
# source of truth for which kinds transfer ownership — every other
# pass that asks "is this a consume site?" reads through here.
bool is_consume_kind(ConsumeKind k):
    match k:
        case CkAssign():
            return true
        case CkReturn():
            return true
        case CkCallArgOwning():
            return true
        case CkFieldWrite():
            return true
        case CkCallArgBorrow():
            return false
        case CkBinOpArg():
            return false
        case CkFormatArg():
            return false
        case CkMatchPtr():
            return false

Operand op_consume(LowerCtx &ctx, GirModule &gmod, int lid, ConsumeKind kind):
    if lid < 0 or lid >= ctx.locals.len():
        return OpCopy(lid)
    # Non-consume position: unconditional borrow. Liveness/ownership
    # state is irrelevant — the receiver just reads through the alias.
    if not is_consume_kind(kind):
        return OpBorrow(lid)
    GirLocal loc = ctx.locals.get(lid).unwrap()
    int tid = loc.type_id
    # Primitives and pointer-typed slots: byte-copy is sound. The
    # validator's `resolve_type_name` returns "" for these so they
    # never produce violations; keep OpCopy for honest GIR labelling.
    if tid < PRIM_COUNT:
        return OpCopy(lid)
    if tid >= gmod.type_table.len():
        return OpCopy(lid)
    GirType gt = gmod.type_table.get(tid).unwrap()
    String tname = ""
    match gt:
        case GtNamed(n):
            tname = n
        case GtPtr(inner_tid):
            # Phase 2.3: Ptr(T) at a consume position. When T is a
            # resource type, the source slot HOLDS A POINTER to the
            # resource (the value lives elsewhere); a byte-copy would
            # produce an aliased Ptr-to-resource — the same buffer
            # would be reachable through two slots. When the consumer
            # demands ownership (CkAssign / CkReturn / CkCallArgOwning
            # / CkFieldWrite), emit OpClone to materialise a fresh
            # owned T at the receiver via deref+clone-through. For
            # Ptr to non-resource (e.g. Ptr-to-int, Ptr-to-FnPtr, or
            # Ptr-to-aggregate-of-primitives) the byte-copy of the
            # pointer is sound — fall through to OpCopy via the
            # helper.
            return decide_ptr_consume(&gmod, lid, inner_tid)
        case GtMutPtr(inner_tid):
            # MutPtr(T) at a consume position. `&`-borrow AND `!`-move
            # resource params BOTH lower to MutPtr(T) (one slot kind,
            # `owning_param` distinguishes them only for the exit
            # drop — mirrors Rust `ir/mod.rs` Local + `functions.rs`
            # param setup). Neither owns the pointee at THIS call: a `&`
            # borrows it; a `!` owns it but is consumed here while still
            # live past the call (last-use move is a deferred opt). So,
            # exactly like the Ptr(T) arm and Rust's
            # `ensure_owned_at_consuming_arg` (borrow-state source →
            # clone, never shallow-alias — `context.rs:1953-1987`),
            # materialise a fresh owned T via deref+clone-through.
            # decide_ptr_consume keeps OpCopy for non-resource pointees
            # (MutPtr-to-int etc.), so this is inert there. Reaching here
            # at all implies a consume kind — non-consume kinds returned
            # OpBorrow at the top of this fn. Without this, a `!`-param
            # consumed into Box/push/field-init shallow-aliased the
            # pointee, and drop emission then freed it → dangle (bug #3).
            return decide_ptr_consume(&gmod, lid, inner_tid)
        else:
            # GtFnPtr / GtTuple / etc. — byte-copy of a pointer is just
            # a pointer copy, not a resource copy. Validator filters
            # these too.
            return OpCopy(lid)
    if not is_resource_type_name(tname, &gmod):
        # Move-axis follows drop-axis (drop keystone ③ alignment). A mono'd
        # Option/Result LOCAL whose payload owns a resource is NOT a resource
        # by `is_resource_type_name` (it's deliberately kept out of
        # optionlike_resource_types so the by-value ABI is unchanged) — yet
        # `is_droppable_type` registers it for whole-drop at scope exit. If we
        # byte-copied it out here (OpCopy) the consumer would own the SAME heap
        # the scope-exit whole-drop frees → UAF / double-free. So when the drop
        # axis owns this value, the move axis must too: route it exactly like
        # the resource path below (borrow/view → clone, owned → move). The
        # oracle drives move-vs-copy off `needs_drop` uniformly; this mirrors it.
        if is_droppable_type(tid, &gmod):
            match loc.ownership:
                case LoBorrowed():
                    return OpClone(lid)
                case LoView():
                    return OpClone(lid)
                else:
                    return OpMove(lid)
        return OpCopy(lid)
    # Resource source at a consume position: pick mode by ownership.
    # a-5 (clone-on-borrow) — WIRED. We only reach here for a genuine
    # consume kind (the non-consume kinds returned OpBorrow at the top
    # of this fn). A borrow/view does NOT own its data, so transferring
    # it to an owning destination (assign / return / field-init /
    # collection-put) MUST materialise an independent copy — otherwise
    # the destination shallow-aliases the borrow's buffer and both free
    # it (the meta_expand `result.push(borrowed_stmt)` →
    # `m.items.set(i, new_fn)` double-free). Mirrors Rust's
    # `ensure_owned_at_consuming_arg` borrowed/Ptr-source arm
    # (`src/ir/lowering/exprs/methods.rs:1862-1867`: "(a) Ptr(inner) args
    # — always clone; (b) non-last-use resource args — clone"). OpClone
    # materialises end-to-end at lir_lower.gg's OpClone handler
    # (value-struct slot → `T__clone`/`gorget_*_clone` via ISlotAddr;
    # ptr-to-struct slot → clone the pointee).
    match loc.ownership:
        case LoBorrowed():
            return OpClone(lid)
        case LoView():
            return OpClone(lid)
        else:
            return OpMove(lid)

# ── Consume-position materialization decision (Phase 2.1) ────────────
#
# Mirrors Rust's `ensure_owned_at_consuming_arg`
# (`src/ir/lowering/context.rs:1913`). Where Rust both DECIDES the
# operand mode AND emits the clone call inline, this self-host port
# splits the two concerns: this function returns the OperandMode label
# only; Phase 2c clone-emission (deferred — see `flush_drop_queue`
# docstring + `clone-emission-at-calls.md`) will produce the actual
# `GICall(<T>__clone, ...)` at the receiving sites. The function name
# is `decide_operand_at_consuming_arg` rather than Rust's
# `ensure_owned_*` to reflect that split: this layer decides the mode,
# downstream phases materialize the clone.
#
# **Status**: dead code in this commit. No caller exists. The
# wire-up across the 7 ad-hoc aliasing fixes (Classes 1-7 from the
# Phase 2c COMMIT 3 reverts) lands in Phases 2.3.a through 2.3.g; the
# last-use information consumed by the by-value-resource branch is
# threaded in Phase 2.2 (see the `is_last_use` param docstring).
#
# **Inputs**:
#   ctx          - LowerCtx (read-only here; future wiring may emit)
#   gmod         - GirModule (for resource-type classification)
#   src_lid      - source local id
#   src_ty       - source local's GirType (passed by caller; avoids
#                  re-fetching from `ctx.locals.get(src_lid)`)
#   reason       - String describing the consume position (e.g.
#                  "Box.new arg", "v.push arg", "field init") — kept
#                  for parity with Rust's `ImplicitCloneReason`; will
#                  feed diagnostics when Phase 2c wires `warn_implicit_
#                  clone` style reporting. Unused in 2.1.
#   is_last_use  - whether this read is the CFG-last use of `src_lid`.
#                  Threaded by callers via the Phase 2.2 last-use
#                  consult (the `last_use_of_op` decision map produced
#                  by `compute_liveness`). For Phase 2.1, no caller
#                  provides this — the parameter exists in the
#                  signature so Phase 2.3.a wire-ups don't reshape it.
#
# **Decision tree** (matches Rust + `clone-emission-at-calls.md`):
#   1. Primitive / non-resource source        → OpCopy (byte-copy sound)
#   2. Ptr(T) where T is a resource type      → OpClone (deref +
#                                                 materialize through the
#                                                 pointer — the source
#                                                 doesn't own the buffer)
#   3. By-value resource source:
#        - LoOwned + is_last_use = true       → OpMove (source dies;
#                                                 receiver takes the
#                                                 buffer; drop_elab
#                                                 elides the guard)
#        - everything else                    → OpClone
#            (LoBorrowed/LoView source aliases a borrow; LoParam is
#             the caller's responsibility; LoMaybeOwned is a
#             conservative join over branches; LoOwned-not-last-use
#             needs to stay valid past this read — all require a
#             materialised buffer at the receiver.)
#   4. Default                                → OpCopy
#
# Why the strict reading (LoOwned-only) on the move-eligible side. The
# old inline logic at `wire_one_operand` (see the rationale comment at
# lower.gg:1863-1869) dropped LoParam and LoMaybeOwned from the OpMove
# set: LoParam denotes slots whose ownership escapes the function's
# stack frame (the caller owns); LoMaybeOwned is a join over conflicting
# branches. Treating either as move-eligible would compile but
# spuriously drop someone else's data once Phase 2c flips emission. The
# strict reading matches Rust's `AssignMode::Move` discipline at
# consume sites.
#
# Ptr/MutPtr/FnPtr aliases at consume positions resolve as OpCopy: a
# pointer byte-copy is a pointer copy, not a resource copy. The
# validator filters these out separately.
Operand decide_operand_at_consuming_arg(LowerCtx &ctx, GirModule &gmod, int src_lid, GirType src_ty, String reason, bool is_last_use):
    # Touch `reason` so the unused-param warning doesn't fire while
    # this helper is dead code. Phase 2.3.a will route this into
    # `warn_implicit_clone` style diagnostics at the wire-up sites.
    int _reason_len = reason.len()
    if src_lid < 0 or src_lid >= ctx.locals.len():
        return OpCopy(src_lid)
    # Case 1: primitive / non-resource. Byte-copy is sound.
    match src_ty:
        case GtPtr(inner):
            # Case 2: Ptr(T). Clone-through if T is a resource;
            # otherwise plain pointer byte-copy.
            return decide_ptr_consume(&gmod, src_lid, inner)
        case GtMutPtr(inner):
            # Case 2b: MutPtr(T). `&`-borrow AND `!`-move resource params
            # both lower to MutPtr(T) (see op_consume's GtMutPtr arm).
            # At a consuming position neither may shallow-alias: a borrow
            # doesn't own the pointee, and a `!` consumed while live-past
            # this use must materialise (last-use move is a deferred opt).
            # Clone-through if T is a resource; otherwise plain pointer
            # byte-copy. Mirrors the Ptr(T) arm and Rust's
            # `ensure_owned_at_consuming_arg` (borrow-state → clone).
            return decide_ptr_consume(&gmod, src_lid, inner)
        case GtFnPtr(_, _):
            # Function pointer: not a resource. Byte-copy.
            return OpCopy(src_lid)
        case GtNamed(tname):
            if not is_resource_type_name(tname, &gmod):
                # Move-axis follows drop-axis (drop keystone ③ alignment),
                # mirroring op_consume's same-named branch. A mono'd
                # Option/Result LOCAL whose payload owns a resource is droppable
                # (registered for whole-drop at scope exit) but is NOT
                # resource-named (kept out of optionlike_resource_types to
                # preserve the by-value ABI). This post-pass RE-DECIDES the mode
                # for every OpMove/OpClone operand op_consume produced, so it
                # MUST recognise the same set — otherwise it demotes the
                # consume-position OpMove back to OpCopy (byte-copy out) while
                # the source stays whole-drop-registered → UAF / double-free.
                # Routing it as OpMove here also triggers the caller's
                # mark_local_moved + GIMoveZero, which is exactly the scope-exit
                # drop exclusion we need (so the var-decl/assign/push/field-write
                # positions get the same exclusion SReturn wires explicitly).
                GirLocal dloc = ctx.locals.get(src_lid).unwrap()
                if is_droppable_type(dloc.type_id, &gmod):
                    match dloc.ownership:
                        case LoOwned():
                            if is_last_use:
                                return OpMove(src_lid)
                            return OpClone(src_lid)
                        case LoBorrowed():
                            return OpClone(src_lid)
                        case LoView():
                            return OpClone(src_lid)
                        else:
                            return OpClone(src_lid)
                return OpCopy(src_lid)
            # Case 3: by-value resource. Branch on ownership.
            # LoOwned-strict: only true-owned slots are move-eligible
            # (and only at their CFG last use). LoParam (caller owns),
            # LoMaybeOwned (conservative join), LoBorrowed (alias),
            # LoView (cap=0 alias) all require OpClone — see the
            # rationale paragraph in the docstring above and the
            # archived inline comment at lower.gg:1863-1869.
            GirLocal loc = ctx.locals.get(src_lid).unwrap()
            match loc.ownership:
                case LoOwned():
                    if is_last_use:
                        return OpMove(src_lid)
                    return OpClone(src_lid)
                else:
                    return OpClone(src_lid)
        else:
            # GtBool / GtI* / GtU* / GtF* / GtUnit — primitives. Note
            # the early `tid < PRIM_COUNT` shortcut in op_consume's
            # mirror logic uses type-id; here we match on GirType
            # variants directly. Both reach the same OpCopy verdict.
            return OpCopy(src_lid)
    # Unreachable — match above is exhaustive over GirType. The default
    # OpCopy is the conservative fall-through if the enum gains a new
    # variant before this helper is updated.
    return OpCopy(src_lid)

# Helper for the Ptr(T) branch of `op_consume` (and the dead-code
# `decide_operand_at_consuming_arg`). Split out so the inner-type
# lookup + resource check stay readable inside the outer match.
# Mirrors Rust's `if let Some(inner) = self.pointee_type(arg_type)`
# arm at context.rs:1928.
#
# Phase 2.3 (2026-05-22): now WIRED into `op_consume`'s GtPtr branch.
# Returns OpClone(src_lid) for Ptr-to-resource at consume positions —
# the lir_lower OpClone handler then emits a deref+clone via the
# pointee type's `gorget_<T>__clone` / `<T>__clone` runtime symbol.
# For Ptr-to-non-resource (primitives, FnPtr, aggregate-of-primitives)
# falls through to OpCopy: byte-copy of a pointer is just a pointer
# copy.
Operand decide_ptr_consume(GirModule &gmod, int src_lid, int inner_tid):
    # Primitive pointee — byte-copy the pointer.
    if inner_tid < 0 or inner_tid < PRIM_COUNT:
        return OpCopy(src_lid)
    if inner_tid >= gmod.type_table.len():
        return OpCopy(src_lid)
    GirType inner_gt = gmod.type_table.get(inner_tid).unwrap()
    match inner_gt:
        case GtNamed(iname):
            if is_resource_type_name(iname, &gmod):
                # Ptr to a resource: deref + clone materializes a
                # fresh owned T at the receiver side. Phase 2.3
                # emission will lower this to a `<T>__clone(&src)`
                # call.
                return OpClone(src_lid)
            return OpCopy(src_lid)
        else:
            return OpCopy(src_lid)

# ── GIR backward-dataflow liveness (Phase 1 of GIR-liveness redesign) ──
#
# Computes, for every owned-local operand READ at position (block, inst,
# op_idx), whether that read is the **last use** of the source local —
# i.e. whether the local is NOT live anywhere downstream in the CFG.
# Result is recorded in `LivenessAnalysis.last_use_of_op`, keyed by an
# encoded (block, inst, op_idx) triple, value true = last use.
#
# This pass is the architectural successor to `tighten_owned_operand_modes`
# (the linear-order, loop-blind post-hoc demoter at line ~790). Where the
# old pass walks instructions in storage order and uses the highest-
# numbered read as "last", this pass operates on the explicit BB CFG with
# proper backward dataflow + fixpoint — correct for loops, branch merges,
# and exception paths.
#
# **Phase 1 status (2026-05-20): pass computes decisions but nothing
# consumes them yet.** `tighten_owned_operand_modes` still drives actual
# OpMove → OpClone demotion. Phase 2 will wire the consumer.
#
# Architectural reference. Rust's GIR-level liveness lives in
# `src/ir/liveness.rs` (~900 lines, used by Tier 2a consume-site
# validation in `validate_consume_sites`). This self-host port matches
# the Rust algorithm shape — backward dataflow, dense per-local bitset,
# worklist fixpoint — but in self-host's cost model. Key adaptation:
# the Rust impl uses a packed-word `LocalBitSet` for set ops; self-host
# uses `Vector[bool]` indexed by local_id. Local count per function is
# typically a few dozen to a few hundred, so the linear scan is
# manageable; switching to a packed-int bitset is a follow-up perf if
# fixpoint dominates.
#
# Why NOT a literal port of `src/ir/lowering/liveness.rs` (AST-level)?
# Two prior agent attempts (`ae77618e`, `ac3595ea`) hit a hard perf
# wall: Rust's AST liveness uses `FxHashSet<&'a str>` borrowed from AST
# `Expr::Identifier(name)`, so per-branch save/restore is a 16-byte
# slice-header copy. Self-host has no `&str` equivalent; the same code
# in Gorget allocates a new `Dict[String, bool]` and deep-clones every
# String key per branch-save. For ~50 live-identifiers × 20 branch
# points × 1500 functions = ~1.5M String allocations. `self_host_
# bootstrap` ran 6:50 with no progress, RSS climbed 870→948 MB. Killed.
#
# DONE.md line 109 (perf(ir/lowering) 2026-05-18) records that Rust
# *itself* hit this exact issue at the AST layer and fixed it via
# `FxHashSet<&'a str>` (internal) + `FxHashSet<Rc<str>>` with an interner
# (cross-function). Both fixes depend on language features self-host
# lacks. The GIR-level pass IS the right shape for self-host because:
#   • The CFG is explicit (basic blocks + terminators) — no walking
#     AST recursively, no branch-merge name juggling.
#   • Working set is per-function local count (~50-200), not per-
#     function identifier-string count (~500-2000 with shadowing).
#   • Keys are `int local_id`, so `Vector[bool] live_clone(...)` is a
#     plain memcpy with no String allocation.
#   • The pass naturally handles loops (back-edge fixpoint) where the
#     AST walker is correct-but-conservative.
#
# Algorithm (standard textbook backward liveness):
#   USE[B]  = locals read in B before being assigned in B
#   DEF[B]  = locals assigned anywhere in B
#   OUT[B]  = ∪ IN[S] for each successor S of B
#   IN[B]   = (OUT[B] - DEF[B]) ∪ USE[B]
# Iterate to fixpoint via worklist. Then for each instruction in each
# block, walk backward computing per-instruction `live_after`: a local
# read at position p is "last use" iff (a) the local is not in
# `live_after[p]` AND (b) it isn't read again at this same instruction
# at a later op_idx. The "same-instruction" guard handles `OpMove(x)
# OpMove(x)` correctly — the SECOND read is the last use; the first is
# NOT last (the local is still needed for the second read).
#
# Decision encoding. `last_use_of_op` keys are
# `(block << 20) | (inst << 4) | op_idx`. Block count per function rarely
# exceeds 2^12 (4096); inst count per block rarely exceeds 2^16 (64k);
# op_idx per inst is bounded by GICallExtern arg count (rare > 32). The
# 20/16/4 layout is comfortable.

# Encoded-key helpers. Keep MAX_INST_PER_BB / MAX_OPS_PER_INST as named
# constants; the bit layout shifts on these.
const int LIVE_MAX_INST_PER_BB = 65536      # 2^16
const int LIVE_MAX_OPS_PER_INST = 16        # 2^4

int liveness_encode_key(int block_idx, int inst_idx, int op_idx):
    return (block_idx * LIVE_MAX_INST_PER_BB + inst_idx) * LIVE_MAX_OPS_PER_INST + op_idx

# A per-function liveness result. The single typed field
# `last_use_of_op` is the contract consumed by Phase 2. Computation-
# internal state (per-block IN/OUT sets, predecessors) lives in locals
# of `compute_liveness` — not exposed.
struct LivenessAnalysis:
    Dict[int, bool] last_use_of_op

LivenessAnalysis empty_liveness():
    Dict[int, bool] m = {}
    return LivenessAnalysis(!m)

# Helper: clone a Vector[bool]. Preallocates via `Vector.fill(n, false)`
# then overwrites individual bits. Skips ~10 doubling reallocations.
# Hot path: called once per block in `liveness_fixpoint` initial seeding
# and once per block in `liveness_record_last_uses`.
Vector[bool] live_bitset_clone(Vector[bool] src):
    Vector[bool] out = []
    int n = src.len()
    out.fill(n, false)
    int i = 0
    while i < n:
        if src.get(i).unwrap():
            out.set(i, true)
        i += 1
    return out

# Helper: bitset equality. Returns true iff the two sets agree at every
# position (both sets are sized to nlocals, so a length check is
# defensive — should never fire).
bool live_bitset_eq(Vector[bool] a, Vector[bool] b):
    if a.len() != b.len():
        return false
    int i = 0
    int n = a.len()
    while i < n:
        if a.get(i).unwrap() != b.get(i).unwrap():
            return false
        i += 1
    return true

# Helper: in-place set union (a |= b). a is the destination; b is unchanged.
void live_bitset_union(Vector[bool] &a, Vector[bool] b):
    int i = 0
    int n = a.len()
    int m = b.len()
    int up_to = n
    if m < up_to:
        up_to = m
    while i < up_to:
        if b.get(i).unwrap():
            a.set(i, true)
        i += 1

# Helper: initialise an empty bitset sized for nlocals. Uses
# `Vector.fill(n, false)` which preallocates capacity and memcpys —
# avoids ~10 doubling reallocations during nlocals pushes. Hot path:
# `liveness_fixpoint` allocates 2 of these per worklist pop.
Vector[bool] live_bitset_empty(int nlocals):
    Vector[bool] out = []
    out.fill(nlocals, false)
    return out

# Note the local-IDs an Operand reads (marks them live for the backward
# dataflow). OpCopy/OpMove/OpClone AND OpBorrow all carry a source local that
# is READ here — a borrow reads its source, so the source must be live at the
# borrow point. Mirrors Rust's `compute_function_liveness`
# (`src/ir/lowering/liveness.rs:154`): every `Expr::Identifier` read — whatever
# it lowers to — marks the name live and feeds `is_last_use_at` at consuming
# positions; corroborated by `src/ir/liveness.rs:407-408`, which counts the
# borrow base. The `else: pass` drops only the OpConst*/OpSizeOf variants, which
# carry no source local.
#
# HISTORY — do not re-exclude OpBorrow: a 2026-05-21 "H1" change excluded it
# here to suppress what looked like spurious clones ("demotes every OpMove of a
# later-borrowed local to OpClone, defeating move-elision"). That WAS the bug,
# not an optimization — those demotions are correct clone-if-live. Excluding
# OpBorrow under-counted liveness, so a consuming position (push / struct-init /
# enum-init) followed by a later `&x` read was mis-flagged last-use → MOVE
# instead of clone → alias/leak (Rust gg clones there). Re-including OpBorrow
# restores parity; the differential touches only borrow-after-consume CoW sites,
# each moving toward Rust's clone count. Used to compute USE[B] /
# `live_in_after_inst` updates.
void liveness_operand_uses(Operand op, Vector[bool] &acc):
    match op:
        case OpCopy(lid):
            if lid >= 0 and lid < acc.len():
                acc.set(lid, true)
        case OpMove(lid):
            if lid >= 0 and lid < acc.len():
                acc.set(lid, true)
        case OpClone(lid):
            if lid >= 0 and lid < acc.len():
                acc.set(lid, true)
        case OpBorrow(lid):
            # Borrow reads its source — count it (see header note). Mirrors
            # `liveness_operand_local_id`, which already counts OpBorrow.
            if lid >= 0 and lid < acc.len():
                acc.set(lid, true)
        else:
            pass

# Note the local-ID an Instruction writes (defines). Returns -1 if the
# instruction doesn't write a local (GIDrop / GIDropIfAlive / GIMoveZero /
# GINop). For backward dataflow, "defined" means "killed in the live set
# at this instruction" — the local's earlier liveness is irrelevant past
# this point.
#
# Every Instruction variant in `gir.gg`'s enum is handled explicitly — no
# `_` catch-all, per CLAUDE.md Layering "no name matching" / instruction-
# variant exhaustiveness.
int liveness_inst_def(Instruction inst):
    match inst:
        case GIAssign(dst, _):
            return dst
        case GIBinOp(dst, _, _, _, _):
            return dst
        case GIUnOp(dst, _, _, _):
            return dst
        case GICmp(dst, _, _, _, _):
            return dst
        case GICall(dst, _, _):
            return dst
        case GICallExtern(dst, _, _):
            return dst
        case GIDeref(dst, _, _):
            return dst
        case GIDrop(_):
            return -1
        case GIDropIfAlive(_):
            return -1
        case GIMoveZero(_):
            return -1
        case GINop():
            return -1
        case GIFieldLoad(dst, _, _):
            # A.1 — typed field-load defines its dst local. Same shape as
            # GIDeref / GIAssign (dst is a fresh local id, base is read).
            return dst
        case GIDerefStore(_, _, _):
            # Store-through-pointer (`*ptr = value`) DEFINES no value local —
            # it writes the pointee. Same no-def shape as GIDrop / GIMoveZero.
            return -1
    return -1

# Walk all operand reads in an Instruction, adding each into `acc`.
# Mirrors the explicit-variant discipline of `liveness_inst_def`. Used
# to compute per-instruction operand-uses for both USE[B] construction
# and the backward per-inst walk that populates `last_use_of_op`.
#
# GIDeref reads a single src_local; GIDrop / GIDropIfAlive / GIMoveZero
# each read a single local id (the local being dropped / moved-zero'd).
# All explicit; no `_` catch-alls.
void liveness_inst_operand_uses(Instruction inst, Vector[bool] &acc):
    match inst:
        case GIAssign(_, op):
            liveness_operand_uses(op, &acc)
        case GIBinOp(_, _, _, lhs, rhs):
            liveness_operand_uses(lhs, &acc)
            liveness_operand_uses(rhs, &acc)
        case GIUnOp(_, _, _, src):
            liveness_operand_uses(src, &acc)
        case GICmp(_, _, _, lhs, rhs):
            liveness_operand_uses(lhs, &acc)
            liveness_operand_uses(rhs, &acc)
        case GICall(_, _, args):
            for a in args:
                liveness_operand_uses(a, &acc)
        case GICallExtern(_, _, args):
            for a in args:
                liveness_operand_uses(a, &acc)
        case GIDeref(_, src_lid, _):
            if src_lid >= 0 and src_lid < acc.len():
                acc.set(src_lid, true)
        # Drops / MoveZero are NOT reads — they're scope-exit side effects on the
        # OWNED local (drop) or definitions that zero the source (MoveZero).
        # Counting them as reads would extend the live range past the move and
        # demote the OpMove decision to OpClone. Mirror of Rust
        # src/ir/liveness.rs:431-432 (explicit exclusion). See its doc-comment
        # at :346-351 for the rationale.
        case GIDrop(_):
            pass
        case GIDropIfAlive(_):
            pass
        case GIMoveZero(_):
            pass
        case GINop():
            pass
        case GIFieldLoad(_, base_lid, _):
            # A.1 — typed field-load reads its base local (the struct/aggregate
            # being projected into). Same shape as GIDeref: a single raw local
            # id, not an Operand. Field index is a const, not a local read.
            if base_lid >= 0 and base_lid < acc.len():
                acc.set(base_lid, true)
        case GIDerefStore(ptr_lid, val_op, _):
            # Store-through-pointer reads BOTH: the pointer local (raw int,
            # like GIDeref's src) AND the value operand (like GIAssign's op).
            if ptr_lid >= 0 and ptr_lid < acc.len():
                acc.set(ptr_lid, true)
            liveness_operand_uses(val_op, &acc)

# Walk all operand reads in a Terminator, adding to `acc`. GTNone /
# GTJump have no operands. GTReturn reads its operand; GTBranch reads
# its condition. Explicit-variant discipline.
void liveness_term_operand_uses(Terminator term, Vector[bool] &acc):
    match term:
        case GTNone():
            pass
        case GTJump(_):
            pass
        case GTReturn(op):
            liveness_operand_uses(op, &acc)
        case GTBranch(op, _, _):
            liveness_operand_uses(op, &acc)

# Direct-lid extractor for a Terminator's single operand (0-1 source
# locals). Returns -1 if no operand or operand is a const. Used by
# `liveness_compute_use_def` to skip the bitset allocation in the
# common single-operand terminator case.
int liveness_term_operand_local_id(Terminator term):
    match term:
        case GTNone():
            return -1
        case GTJump(_):
            return -1
        case GTReturn(op):
            return liveness_operand_local_id(op)
        case GTBranch(op, _, _):
            return liveness_operand_local_id(op)

# Collect the successor block ids of a Terminator. GTNone / GTReturn
# have no successors (terminator absent or function exit). GTJump has
# one successor; GTBranch has two.
Vector[int] liveness_term_successors(Terminator term):
    Vector[int] out = []
    match term:
        case GTNone():
            pass
        case GTReturn(_):
            pass
        case GTJump(target):
            out.push(target)
        case GTBranch(_, t_bb, e_bb):
            out.push(t_bb)
            if e_bb != t_bb:
                out.push(e_bb)
    return out

# Compute USE[B] (locals read before any def in B) and DEF[B] (locals
# defined in B). Both are flat Vector[bool] sized to nlocals. For
# DEF[B], we set the bit at the index of every instruction's dst (and
# the terminator's dst, which is always -1 since terminators don't
# write). For USE[B], we walk B forward and for each instruction:
#   • record reads in `cur_use` (add to USE[B] only if NOT already in
#     DEF[B]'s "killed-so-far" view — but the textbook way is "USE only
#     counts the first read before a def in the same block").
#   • record this instruction's def in DEF[B].
# For the terminator, its operand reads count as USE (terminators have
# no def). Returns the pair via two out-Vectors.
void liveness_compute_use_def(Vector[Instruction] insts, Terminator term, int nlocals, Vector[bool] &use_set, Vector[bool] &def_set):
    int ii = 0
    int n = insts.len()
    while ii < n:
        Instruction inst = insts.get(ii).unwrap()
        # Reads: an operand read is in USE[B] iff the local hasn't been
        # killed (defined) earlier in this block.
        #
        # Iterate operand lids directly (typically 1-5 per inst) instead
        # of allocating a fresh nlocals-sized bitset and sweeping the
        # full range. Eliminates per-inst O(nlocals) overhead — Phase 1
        # perf hunt 2026-05-20.
        Vector[int] op_lids = liveness_inst_operand_local_ids(inst)
        int ok = 0
        while ok < op_lids.len():
            int lid_u = op_lids.get(ok).unwrap()
            if lid_u >= 0 and lid_u < nlocals and not def_set.get(lid_u).unwrap():
                use_set.set(lid_u, true)
            ok += 1
        # Def: kill in def_set after the reads. This way `x = x + 1`
        # correctly counts the RHS x as a USE (read happens before
        # def).
        int def_lid = liveness_inst_def(inst)
        if def_lid >= 0 and def_lid < nlocals:
            def_set.set(def_lid, true)
        ii += 1
    # Terminator reads are post-all-block-defs, so they're USE unless
    # killed by an earlier inst in this block. Direct-lid path mirrors
    # the per-inst optimisation above — terminators have 0-1 operand
    # so per-terminator allocation was wasted.
    int term_lid = liveness_term_operand_local_id(term)
    if term_lid >= 0 and term_lid < nlocals and not def_set.get(term_lid).unwrap():
        use_set.set(term_lid, true)

# Worklist backward-dataflow fixpoint.
#
# Computes per-block live_in / live_out. Worklist algorithm: seed every
# block in the queue; repeatedly pop a block, recompute its OUT (from
# successors' IN), recompute its IN (OUT - DEF ∪ USE), and if IN
# changed, push all its predecessors back into the queue. Terminates
# when the queue is empty.
#
# Successor relation is reconstructed from terminators (no precomputed
# successor table). Predecessor relation is computed once up-front.
#
# `block_live_in[b]` is the set of locals live at B's entry — the
# answer queried by the per-instruction backward walk below.
void liveness_fixpoint(Vector[Vector[Instruction]] block_insts, Vector[Terminator] block_terms, int nlocals, Vector[Vector[bool]] &block_live_in, Vector[Vector[bool]] &block_live_out):
    int n = block_insts.len()
    if n == 0:
        return
    # Precompute USE[B] / DEF[B] for each block.
    Vector[Vector[bool]] use_sets = []
    Vector[Vector[bool]] def_sets = []
    int bi = 0
    while bi < n:
        Vector[bool] us = live_bitset_empty(nlocals)
        Vector[bool] ds = live_bitset_empty(nlocals)
        liveness_compute_use_def(block_insts.get(bi).unwrap(), block_terms.get(bi).unwrap(), nlocals, &us, &ds)
        use_sets.push(!us)
        def_sets.push(!ds)
        bi += 1
    # Precompute predecessor map (Vector[Vector[int]] indexed by block).
    Vector[Vector[int]] preds = []
    int pi = 0
    while pi < n:
        Vector[int] empty_preds = []
        preds.push(!empty_preds)
        pi += 1
    int si = 0
    while si < n:
        Vector[int] succs = liveness_term_successors(block_terms.get(si).unwrap())
        for sb in succs:
            if sb >= 0 and sb < n:
                Vector[int] pv = preds.get(sb).unwrap()
                pv.push(si)
                preds.set(sb, !pv)
        si += 1
    # Initialise live_in[B] = USE[B], live_out[B] = ∅. (Standard seed —
    # the first iteration will populate live_out properly.)
    block_live_in.clear()
    block_live_out.clear()
    int ii = 0
    while ii < n:
        block_live_in.push(live_bitset_clone(use_sets.get(ii).unwrap()))
        block_live_out.push(live_bitset_empty(nlocals))
        ii += 1
    # Worklist: seed with every block (process in reverse-postorder
    # if we cared about iteration count; for self-host's small fns,
    # naive seeding converges in ~3-5 iterations).
    Vector[int] worklist = []
    int wi = n - 1
    while wi >= 0:
        worklist.push(wi)
        wi -= 1
    while worklist.len() > 0:
        int b = worklist.get(worklist.len() - 1).unwrap()
        worklist.pop()
        # OUT[b] = ∪ IN[s] for s in successors(b)
        Vector[bool] new_out = live_bitset_empty(nlocals)
        Vector[int] succs2 = liveness_term_successors(block_terms.get(b).unwrap())
        for s in succs2:
            if s >= 0 and s < n:
                live_bitset_union(&new_out, block_live_in.get(s).unwrap())
        # IN[b] = (OUT[b] - DEF[b]) ∪ USE[b]
        Vector[bool] new_in = live_bitset_empty(nlocals)
        Vector[bool] ds_b = def_sets.get(b).unwrap()
        int li2 = 0
        while li2 < nlocals:
            if new_out.get(li2).unwrap() and not ds_b.get(li2).unwrap():
                new_in.set(li2, true)
            li2 += 1
        live_bitset_union(&new_in, use_sets.get(b).unwrap())
        # Compare against the previous IN[b]; if changed, push all
        # predecessors back onto the worklist.
        Vector[bool] old_in = block_live_in.get(b).unwrap()
        if not live_bitset_eq(new_in, old_in):
            block_live_in.set(b, !new_in)
            block_live_out.set(b, !new_out)
            Vector[int] preds_b = preds.get(b).unwrap()
            for pb in preds_b:
                worklist.push(pb)
        else:
            # Keep new_out fresh anyway — OUT may have shifted even
            # when IN converged (rare, possible if a successor's IN
            # changed between worklist pops).
            block_live_out.set(b, !new_out)

# Walk each block backward computing per-instruction `live_after`
# (= live_in of the position immediately AFTER the instruction). For
# every operand read in the instruction, if the source local is NOT in
# `live_after` AND not used again at a later op_idx in the same
# instruction, this read is the local's last use across the whole CFG.
# Record into `last_use_of_op` keyed by `liveness_encode_key(b, i, op_idx)`.
#
# Same-instruction multi-read handling: walk operands LEFT-TO-RIGHT,
# track which locals have already been seen at later op_idx via the
# `seen_later` bitset accumulated by a right-to-left pre-walk over
# operands. A read at op_idx k is "last across CFG" iff (a) source not
# in `live_after_inst` AND (b) source not in `seen_later[k]`. This
# correctly handles `f(x, x)` — the SECOND x is the last use; the FIRST
# is not.
void liveness_record_last_uses(Vector[Vector[Instruction]] block_insts, Vector[Terminator] block_terms, int nlocals, Vector[Vector[bool]] block_live_out, Dict[int, bool] &last_use_of_op):
    int n = block_insts.len()
    if n == 0:
        return
    int b = 0
    while b < n:
        Vector[Instruction] insts = block_insts.get(b).unwrap()
        Terminator term = block_terms.get(b).unwrap()
        # live_after_term = block_live_out[b].
        # live_after_inst at inst i = live_in of position right after
        # inst i. Compute by walking backward from the terminator.
        # Terminator's "live_after" is block_live_out[b]; its uses get
        # added back in (and its def is -1, so no kill there).
        Vector[bool] live_now = live_bitset_clone(block_live_out.get(b).unwrap())
        # ─ Terminator phase. Walk its operand reads. For GTReturn(op)
        # and GTBranch(op, _, _), record their op_idx=0 last-use status
        # against `live_now` BEFORE adding the term's reads back in.
        liveness_record_term_last_uses(term, b, insts.len(), live_now, &last_use_of_op)
        liveness_term_operand_uses(term, &live_now)
        # ─ Instruction phase, walk backward.
        int i = insts.len() - 1
        while i >= 0:
            Instruction inst = insts.get(i).unwrap()
            # Apply the per-inst rules:
            #   1. Record each operand read's last-use status against
            #      `live_now` (= live AFTER this inst) AND a per-inst
            #      `seen_later` (= operands later in the same inst
            #      that read this local).
            liveness_record_inst_last_uses(inst, b, i, live_now, &last_use_of_op)
            #   2. Kill the inst's def (if any) — for ALL subsequent
            #      backward steps, the local is dead at this point.
            int def_lid = liveness_inst_def(inst)
            if def_lid >= 0 and def_lid < nlocals:
                live_now.set(def_lid, false)
            #   3. Add this inst's operand reads to `live_now` — the
            #      live set BEFORE this instruction.
            liveness_inst_operand_uses(inst, &live_now)
            i -= 1
        b += 1

# Per-instruction last-use recorder. Walks the operands left-to-right
# but uses a right-to-left precomputed `seen_later` to know which locals
# are read again at a later op_idx in this same instruction. The
# per-operand decision: last use iff (a) source not in `live_after`
# AND (b) source not in `seen_later`.
void liveness_record_inst_last_uses(Instruction inst, int b, int i, Vector[bool] live_after, Dict[int, bool] &last_use_of_op):
    # Collect (op_idx, src_local) pairs in left-to-right order. We
    # build a flat Vector[int] of source local IDs (or -1 for non-
    # source-bearing operand variants like consts); the index into
    # this Vector IS the op_idx.
    Vector[int] op_srcs = liveness_inst_operand_local_ids(inst)
    int nops = op_srcs.len()
    if nops == 0:
        return
    # Precompute `seen_later[k]` = whether any op_idx > k reads the
    # same local as op_srcs[k]. Right-to-left scan: maintain a set of
    # locals already seen; for each op from the right, if its local is
    # in `seen` we set seen_later[k] = true, then add its local to
    # `seen`. Linear in nops.
    Vector[bool] seen_later = []
    int sl = 0
    while sl < nops:
        seen_later.push(false)
        sl += 1
    # Build the `seen` set as a Dict[int, bool] — typical nops is 1-5,
    # so the alloc cost is fine.
    Dict[int, bool] seen = {}
    int k = nops - 1
    while k >= 0:
        int lid = op_srcs.get(k).unwrap()
        if lid >= 0:
            if seen.contains(lid):
                seen_later.set(k, true)
            seen.put(lid, true)
        k -= 1
    # Forward pass: emit last_use_of_op[encode(b, i, op_idx)] = true
    # for each op_idx where source is not in live_after AND not in
    # seen_later. Skip non-source operands (lid == -1).
    int op_idx = 0
    while op_idx < nops:
        int lid2 = op_srcs.get(op_idx).unwrap()
        if lid2 >= 0:
            bool is_last = true
            if lid2 < live_after.len() and live_after.get(lid2).unwrap():
                is_last = false
            if seen_later.get(op_idx).unwrap():
                is_last = false
            if is_last:
                int key = liveness_encode_key(b, i, op_idx)
                last_use_of_op.put(key, true)
        op_idx += 1

# Per-terminator last-use recorder. Same rules as the inst case but
# terminator op_idx layout: GTReturn → one operand at op_idx 0;
# GTBranch → one operand at op_idx 0. Inst index for terminators is
# the special value insts.len() (one past the last inst in the block);
# this keys distinguish them from the last real instruction.
void liveness_record_term_last_uses(Terminator term, int b, int insts_count, Vector[bool] live_after, Dict[int, bool] &last_use_of_op):
    match term:
        case GTReturn(op):
            int lid = liveness_operand_local_id(op)
            if lid >= 0:
                bool not_live = true
                if lid < live_after.len() and live_after.get(lid).unwrap():
                    not_live = false
                if not_live:
                    int key = liveness_encode_key(b, insts_count, 0)
                    last_use_of_op.put(key, true)
        case GTBranch(op, _, _):
            int lid = liveness_operand_local_id(op)
            if lid >= 0:
                bool not_live = true
                if lid < live_after.len() and live_after.get(lid).unwrap():
                    not_live = false
                if not_live:
                    int key = liveness_encode_key(b, insts_count, 0)
                    last_use_of_op.put(key, true)
        case GTNone():
            pass
        case GTJump(_):
            pass

# Extract the source local id from an operand. Returns -1 for const
# variants. Mirror of `liveness_operand_uses`'s single-source view.
int liveness_operand_local_id(Operand op):
    match op:
        case OpCopy(l):
            return l
        case OpMove(l):
            return l
        case OpClone(l):
            return l
        case OpBorrow(l):
            return l
        else:
            return -1

# Extract per-operand source local IDs from an Instruction in left-to-
# right order. Used by `liveness_record_inst_last_uses` to determine
# op_idx layout per inst variant. Returns -1 for non-source-bearing
# slots (consts, the implicit "this is a single-source" inst slot).
#
# Explicit-variant discipline — no `_` catch-all. Every Instruction
# variant maps to a deterministic operand-list shape. For multi-arg
# variants (GICall, GICallExtern), the args Vector's order IS the
# op_idx order.
Vector[int] liveness_inst_operand_local_ids(Instruction inst):
    Vector[int] out = []
    match inst:
        case GIAssign(_, op):
            out.push(liveness_operand_local_id(op))
        case GIBinOp(_, _, _, lhs, rhs):
            out.push(liveness_operand_local_id(lhs))
            out.push(liveness_operand_local_id(rhs))
        case GIUnOp(_, _, _, src):
            out.push(liveness_operand_local_id(src))
        case GICmp(_, _, _, lhs, rhs):
            out.push(liveness_operand_local_id(lhs))
            out.push(liveness_operand_local_id(rhs))
        case GICall(_, _, args):
            for a in args:
                out.push(liveness_operand_local_id(a))
        case GICallExtern(_, _, args):
            for a in args:
                out.push(liveness_operand_local_id(a))
        case GIDeref(_, src_lid, _):
            out.push(src_lid)
        case GIDrop(_):
            # Drops / MoveZero are NOT operand reads — they are scope-exit
            # side effects on the OWNED local (drop) or definitions that
            # zero the source (MoveZero). Counting them as USES (a) inflates
            # USE[B] in `liveness_fixpoint` so a local stays "live" across
            # the scope-exit GIDropIfAlive at a CF merge, which demotes the
            # consume-branch OpMove → OpClone (the `drop_loop_reinit`
            # conditional-consume double-drop), and (b) would suppress the
            # very last-use this pass exists to find. Push -1 (a non-source
            # placeholder, skipped by both the USE-set builder's `lid >= 0`
            # guard and the last-use recorder) so the op_idx LAYOUT stays
            # identical to the wire pass's `rewrite_inst_modes` — only the
            # source identity is dropped. Mirrors the sibling
            # `liveness_inst_operand_uses` (lower.gg:2099-2110) and Rust
            # `src/ir/liveness.rs:431-432`.
            out.push(-1)
        case GIDropIfAlive(_):
            out.push(-1)
        case GIMoveZero(_):
            out.push(-1)
        case GINop():
            pass
        case GIFieldLoad(_, base_lid, _):
            # A.1 — base local is the single operand-read; field index is a
            # const (not a local). Mirrors GIDeref's shape.
            out.push(base_lid)
        case GIDerefStore(ptr_lid, val_op, _):
            # Two operand reads in left-to-right order: the pointer local
            # (raw int, op_idx 0) then the value (Operand, op_idx 1). The
            # op_idx layout MUST match the wire order in `rewrite_inst_modes`
            # (the value is wired at op_idx 1 there).
            out.push(ptr_lid)
            out.push(liveness_operand_local_id(val_op))
    return out

# Top-level entry. Compute the full per-function liveness analysis,
# returning a `LivenessAnalysis` with `last_use_of_op` populated.
LivenessAnalysis compute_liveness(LowerCtx &ctx):
    int nlocals = ctx.locals.len()
    Dict[int, bool] last_use = {}
    LivenessAnalysis result = LivenessAnalysis(!last_use)
    if nlocals == 0:
        return result
    if ctx.block_insts.len() == 0:
        return result
    Vector[Vector[bool]] live_in_sets = []
    Vector[Vector[bool]] live_out_sets = []
    liveness_fixpoint(ctx.block_insts, ctx.block_terms, nlocals, &live_in_sets, &live_out_sets)
    liveness_record_last_uses(ctx.block_insts, ctx.block_terms, nlocals, live_out_sets, &result.last_use_of_op)
    return result

# ── Instrumentation diff: GIR-liveness vs tighten_owned_operand_modes ──
#
# Phase 1 validation. For each OpMove(lid) operand-read in the function,
# compare:
#   • Old pass (`tighten_owned_operand_modes`): keeps OpMove iff
#     `last_pos[lid] == this_pos`, i.e. this is the storage-LAST read.
#   • New pass (`compute_liveness`): keeps OpMove iff
#     `last_use_of_op[encode(b, i, op_idx)] == true`, i.e. this is
#     the CFG-LAST read across all paths.
#
# Discrepancies fall into:
#   (A) New pass says "not last", old pass says "last" — old pass
#       missed a downstream read because storage order disagrees with
#       CFG order. Caller is typically in a loop body, or before an
#       early-exit branch with a later use after the merge.
#   (B) New pass says "last", old pass says "not last" — old pass
#       found a later storage-position read that's NOT reachable in
#       the CFG. Rare; happens when a block becomes unreachable mid-
#       lowering and its instructions still sit in `block_insts`.
#
# Both shapes are "new pass more accurate." Phase 1 reports the count
# via a diag_warn so the parent run captures it in stage-0 stdout.
# After Phase 2 wires the consumer, the old pass is removed and this
# instrumentation goes too.

# Compute the discrepancy count. Defensive: bounded by total OpMove
# operand-reads in the function (typically dozens, never millions).
# We DO NOT mutate any state — purely an inspection pass.
int liveness_instrumentation_diff(LowerCtx &ctx, LivenessAnalysis &liveness):
    int n = ctx.block_insts.len()
    if n == 0:
        return 0
    # Re-derive the old pass's last_pos table (mirrors
    # `tighten_owned_operand_modes`'s Pass 1).
    int MAX_PER_BB = 1000000
    Dict[int, int] last_pos = {}
    int bi = 0
    while bi < n:
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        int ii = 0
        while ii < insts.len():
            int pos = bi * MAX_PER_BB + ii
            update_last_pos_for_inst(insts.get(ii).unwrap(), pos, &last_pos)
            ii += 1
        int term_pos = bi * MAX_PER_BB + (MAX_PER_BB - 1)
        update_last_pos_for_term(ctx.block_terms.get(bi).unwrap(), term_pos, &last_pos)
        bi += 1
    # Now walk each OpMove operand-read and compare verdicts.
    int diff_count = 0
    int bj = 0
    while bj < n:
        Vector[Instruction] insts2 = ctx.block_insts.get(bj).unwrap()
        int ij = 0
        while ij < insts2.len():
            int pos = bj * MAX_PER_BB + ij
            Instruction inst = insts2.get(ij).unwrap()
            Vector[int] op_srcs = liveness_inst_operand_local_ids(inst)
            int op_idx = 0
            while op_idx < op_srcs.len():
                int lid = op_srcs.get(op_idx).unwrap()
                if lid >= 0:
                    # Old pass verdict: lid is last-use here iff
                    # last_pos[lid] == pos. (Storage-last test.)
                    bool old_last = false
                    if last_pos.contains(lid):
                        old_last = (last_pos.get(lid).unwrap() == pos)
                    # New pass verdict: encoded key in last_use_of_op?
                    int key = liveness_encode_key(bj, ij, op_idx)
                    bool new_last = liveness.last_use_of_op.contains(key)
                    if old_last != new_last:
                        diff_count += 1
                op_idx += 1
            ij += 1
        bj += 1
    return diff_count

# ── CFG-aware operand-mode post-pass (Path A Phase 2a) ──────────
#
# Runs AFTER `compute_liveness` and consumes `LivenessAnalysis.
# last_use_of_op` — the per-operand "last-use across the CFG" verdict
# — to choose OpMove vs OpClone at every consuming operand read.
# Replaces the legacy `tighten_owned_operand_modes` (retired below),
# whose linear-storage-order criterion produced 52K disagreements
# against the CFG-accurate verdict (Phase 1 instrumentation diff).
#
# Scope. The pass is **pure label correctness**: every operand mode
# in {OpMove, OpClone} today lowers to the same `ISlotLoad`
# placeholder at LIR (lir_lower.gg:2362-2376). Rewriting OpMove ↔
# OpClone here does NOT change emission. The win is that the labels
# become CFG-accurate, so when Phase 2c (the bundled emission flip)
# lands, the labels already reflect the right move/clone decision —
# no double-frees from mislabelled loop bodies or branch merges.
#
# Decision per operand read at position (b, i, op_idx):
#   • OpMove(lid) or OpClone(lid) — the operand is "in a consuming
#     position" today. Decide:
#       - lookup `loc = ctx.locals.get(lid)`
#       - lookup `last_use_of_op[(b, i, op_idx)]` → bool last_use
#       - if `loc.ownership == LoOwned` AND last_use → OpMove(lid),
#         and call `mark_local_moved(&ctx.drop_elab, lid)` so the
#         eventual drop_elab (Phase 2c) skips dropping this slot.
#       - else → OpClone(lid). Source either doesn't own its data
#         (LoBorrowed / LoView / LoParam / LoMaybeOwned) or is read
#         again later on some CFG path — both cases require a clone
#         today, and Phase 2c will emit the runtime clone call here.
#   • OpCopy / OpBorrow / OpConst* — left untouched. These come from
#     positions that explicitly chose a non-consuming mode (e.g.
#     primitive operands of GIBinOp, pointer aliases at field-write
#     bases, scrutinee reads in match tests). Phase 2b refactors the
#     "what counts as consuming" boundary via a typed `ConsumeKind`
#     enum — Phase 2a defers that question by simply preserving the
#     mode chosen by the producer.
#
# Why we drop LoParam / LoMaybeOwned from the OpMove eligibility set.
# These ownership labels denote slots whose ownership escape the
# function's stack frame: LoParam is the caller's responsibility;
# LoMaybeOwned is a join over conflicting branches. Treating them as
# move-eligible would compile but spuriously drop someone else's
# data once Phase 2c flips emission. The strict reading (LoOwned only)
# matches Rust's `AssignMode::Move` discipline at consume sites.
#
# Idempotent: a second run sees the same operands and applies the
# same rule, producing identical output.

void wire_liveness_into_modes(LowerCtx &ctx, GirModule &gmod, LivenessAnalysis &liveness):
    int n = ctx.block_insts.len()
    if n == 0:
        return
    int bi = 0
    while bi < n:
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        Vector[Instruction] new_insts = []
        int ii = 0
        while ii < insts.len():
            # Side-channel: each call to `wire_one_operand` that
            # finalizes an OpMove(lid) decision pushes `lid` into
            # `moved_lids`. After we push the rewritten inst we emit
            # one `GIMoveZero(lid)` immediately after for each entry,
            # so the LIR `IMoveSlot` annotation lands at the actual
            # move site — exactly where Rust's drop_elab needs it to
            # mark the slot uninitialized. Clear after each inst so
            # zeros stay anchored to their producing instruction
            # (COMMIT 3 step 1).
            Vector[int] moved_lids = []
            Instruction rewritten = rewrite_inst_modes(&ctx, &gmod, insts.get(ii).unwrap(), bi, ii, &liveness, &moved_lids)
            new_insts.push(rewritten)
            int mi = 0
            while mi < moved_lids.len():
                new_insts.push(GIMoveZero(moved_lids.get(mi).unwrap()))
                mi += 1
            ii += 1
        # Terminators live at op_idx 0 with inst_idx = insts.len()
        # (matches `liveness_record_term_last_uses` keying — see the
        # liveness pass's per-block walker). A terminator-level OpMove
        # (return/branch operand) also gets a `GIMoveZero` emitted
        # — but it has to land BEFORE the terminator in the block
        # stream, so we append into `new_insts` first, then set the
        # rewritten terminator. The slot is dead after the block ends
        # anyway, but the annotation lets drop_elab's dataflow
        # propagate "uninitialized" into successor blocks correctly.
        int term_inst_idx = insts.len()
        Vector[int] term_moved_lids = []
        Terminator new_term = rewrite_term_modes(&ctx, &gmod, ctx.block_terms.get(bi).unwrap(), bi, term_inst_idx, &liveness, &term_moved_lids)
        int tmi = 0
        while tmi < term_moved_lids.len():
            new_insts.push(GIMoveZero(term_moved_lids.get(tmi).unwrap()))
            tmi += 1
        ctx.block_insts.set(bi, !new_insts)
        ctx.block_terms.set(bi, new_term)
        bi += 1

# Per-operand decision logic. `b` / `i` / `op_idx` form the
# liveness key; ctx supplies ownership state + the drop_elab
# the mark_local_moved call writes into. `moved_lids` is the
# side-channel into which we push every lid that this call
# finalizes as OpMove — the caller (`wire_liveness_into_modes`)
# walks it after the inst to emit `GIMoveZero(lid)` insts at
# the exact move site (COMMIT 3 step 1).
#
# Phase 2.2: this is now a thin shim around
# `decide_operand_at_consuming_arg`. The shim identifies
# consume-position reads (OpMove/OpClone), resolves the source
# local's GirType from `ctx.locals[lid].type_id` via
# `gmod.type_table`, consults `liveness.last_use_of_op`, and
# delegates the OpMove-vs-OpClone (vs OpCopy / clone-through-Ptr)
# verdict to the helper. The helper IS the decision tree; this
# function does the call-site bookkeeping (early-out, lid
# bounds-check, mark_local_moved on a finalised OpMove,
# moved_lids push for the GIMoveZero emitter).
#
# Behaviour-preservation note. The current callers only hand us
# OpMove/OpClone for by-value resource locals — initial lowering
# never emits OpMove/OpClone for Ptr(T) operands or primitives,
# so the helper's Ptr-clone-through and OpCopy-on-primitive
# branches are observationally unreachable from this entry point.
# They sit dormant for Phase 2.3.a wire-ups at other call sites.
Operand wire_one_operand(LowerCtx &ctx, GirModule &gmod, Operand op, int b, int i, int op_idx, LivenessAnalysis &liveness, Vector[int] &moved_lids):
    int lid = -1
    bool is_consuming_mode = false
    match op:
        case OpMove(l):
            lid = l
            is_consuming_mode = true
        case OpClone(l):
            lid = l
            is_consuming_mode = true
        else:
            return op
    if not is_consuming_mode:
        return op
    if lid < 0 or lid >= ctx.locals.len():
        # Defensive: malformed local ID — leave the operand untouched
        # rather than rewriting it to a bogus mode.
        return op
    # Resolve the source local's GirType from the type table. If the
    # type_id is out-of-range (shouldn't happen — locals are typed at
    # registration), fall back to OpClone: a clone is always sound,
    # whereas an unverified OpMove would be a use-after-free if the
    # local actually owns its data.
    GirLocal loc = ctx.locals.get(lid).unwrap()
    if loc.type_id < 0 or loc.type_id >= gmod.type_table.len():
        return OpClone(lid)
    GirType src_ty = gmod.type_table.get(loc.type_id).unwrap()
    int key = liveness_encode_key(b, i, op_idx)
    bool last_use = liveness.last_use_of_op.contains(key)
    Operand result = decide_operand_at_consuming_arg(&ctx, &gmod, lid, src_ty, "wire_pass: consuming operand", last_use)
    # On a finalised OpMove, the slot is logically dead from this
    # point on. Tell drop_elab (so the scope-drop emitter skips it)
    # and record the lid so `wire_liveness_into_modes` can emit a
    # `GIMoveZero(lid)` immediately after the producing instruction.
    match result:
        case OpMove(_):
            mark_local_moved(&ctx, lid)
            moved_lids.push(lid)
        else:
            pass
    return result

# Rewrite all consuming-mode operand reads in an instruction.
# `b` / `i` come from the caller's per-block / per-inst walk. The
# op_idx layout matches `liveness_inst_operand_local_ids` — the
# left-to-right order of operand reads in this instruction shape.
# `moved_lids` is the side-channel for per-inst GIMoveZero
# emission — see `wire_one_operand`.
Instruction rewrite_inst_modes(LowerCtx &ctx, GirModule &gmod, Instruction inst, int b, int i, LivenessAnalysis &liveness, Vector[int] &moved_lids):
    match inst:
        case GIAssign(dst, op):
            return GIAssign(dst, wire_one_operand(&ctx, &gmod, op, b, i, 0, &liveness, &moved_lids))
        case GIBinOp(dst, opc, ty, lhs, rhs):
            Operand new_lhs = wire_one_operand(&ctx, &gmod, lhs, b, i, 0, &liveness, &moved_lids)
            Operand new_rhs = wire_one_operand(&ctx, &gmod, rhs, b, i, 1, &liveness, &moved_lids)
            return GIBinOp(dst, opc, ty, new_lhs, new_rhs)
        case GIUnOp(dst, opc, ty, src):
            return GIUnOp(dst, opc, ty, wire_one_operand(&ctx, &gmod, src, b, i, 0, &liveness, &moved_lids))
        case GICmp(dst, opc, ty, lhs, rhs):
            Operand new_lhs = wire_one_operand(&ctx, &gmod, lhs, b, i, 0, &liveness, &moved_lids)
            Operand new_rhs = wire_one_operand(&ctx, &gmod, rhs, b, i, 1, &liveness, &moved_lids)
            return GICmp(dst, opc, ty, new_lhs, new_rhs)
        case GICall(dst, name, args):
            Vector[Operand] new_args = []
            int ai = 0
            while ai < args.len():
                new_args.push(wire_one_operand(&ctx, &gmod, args.get(ai).unwrap(), b, i, ai, &liveness, &moved_lids))
                ai += 1
            return GICall(dst, name, !new_args)
        case GICallExtern(dst, name, args):
            Vector[Operand] new_args = []
            int ai = 0
            while ai < args.len():
                new_args.push(wire_one_operand(&ctx, &gmod, args.get(ai).unwrap(), b, i, ai, &liveness, &moved_lids))
                ai += 1
            return GICallExtern(dst, name, !new_args)
        case GIDerefStore(ptr_lid, val_op, inner_ty):
            # Promote the VALUE operand's OpClone→OpMove at last-use, exactly
            # like the GIAssign arm. The ptr_local is a raw int (op_idx 0, not
            # a consuming Operand — nothing to rewrite); the value is op_idx 1,
            # matching `liveness_inst_operand_local_ids`' push order. For SCALAR
            # `&`-writes op_consume returns OpCopy (never promoted → no-op); for
            # RESOURCE `&`-writes (`String &s = s + "!"`) it returns OpClone,
            # which this promotes to OpMove at last-use so resource `&`-writes
            # move like Rust gg instead of leaving a stray clone.
            return GIDerefStore(ptr_lid, wire_one_operand(&ctx, &gmod, val_op, b, i, 1, &liveness, &moved_lids), inner_ty)
        else:
            # GIDeref / GIDrop / GIDropIfAlive / GIMoveZero / GINop —
            # operand-read shape is fixed (single lid / no operands).
            # Per the liveness encoder, the lid is already a known
            # local; these instructions are not consuming operand-mode
            # carriers (they take raw local IDs, not Operand variants),
            # so there's nothing to rewrite.
            return inst

Terminator rewrite_term_modes(LowerCtx &ctx, GirModule &gmod, Terminator term, int b, int i, LivenessAnalysis &liveness, Vector[int] &moved_lids):
    match term:
        case GTReturn(op):
            return GTReturn(wire_one_operand(&ctx, &gmod, op, b, i, 0, &liveness, &moved_lids))
        case GTBranch(op, t_bb, e_bb):
            return GTBranch(wire_one_operand(&ctx, &gmod, op, b, i, 0, &liveness, &moved_lids), t_bb, e_bb)
        else:
            return term

# ── Legacy linear-storage-order helpers (retained for instrumentation
# diff only) ──
#
# These three helpers used to back `tighten_owned_operand_modes`, the
# linear-storage-order pass retired in Phase 2a. They are kept solely
# so `liveness_instrumentation_diff` can reconstruct the OLD pass's
# `last_pos[lid]` view at runtime and compare it against the new
# CFG-accurate verdict. Once we've validated the diff stays at ~zero
# for a few release cycles, these helpers + the diff function retire
# together.

# Update `last_pos[lid]` for every operand-read in this instruction
# (positions are monotonic across the pass, so `.put` overwrites with
# the larger position automatically).
void update_last_pos_for_inst(Instruction inst, int pos, Dict[int, int] &last_pos):
    match inst:
        case GIAssign(_, op):
            note_operand_pos(op, pos, &last_pos)
        case GIBinOp(_, _, _, lhs, rhs):
            note_operand_pos(lhs, pos, &last_pos)
            note_operand_pos(rhs, pos, &last_pos)
        case GIUnOp(_, _, _, src):
            note_operand_pos(src, pos, &last_pos)
        case GICmp(_, _, _, lhs, rhs):
            note_operand_pos(lhs, pos, &last_pos)
            note_operand_pos(rhs, pos, &last_pos)
        case GICall(_, _, args):
            for a in args:
                note_operand_pos(a, pos, &last_pos)
        case GICallExtern(_, _, args):
            for a in args:
                note_operand_pos(a, pos, &last_pos)
        else:
            pass

void update_last_pos_for_term(Terminator term, int pos, Dict[int, int] &last_pos):
    match term:
        case GTReturn(op):
            note_operand_pos(op, pos, &last_pos)
        case GTBranch(op, _, _):
            note_operand_pos(op, pos, &last_pos)
        else:
            pass

# Legacy linear-order helper for `liveness_instrumentation_diff` regression
# net. Mirrors `liveness_operand_uses` — counts OpBorrow as a source read too
# (a borrow reads its source), so the two passes stay in agreement at OpBorrow
# positions. (The earlier H1 exclusion here mirrored that function's wrong
# exclusion; both now correctly count the borrow read — see the header note on
# `liveness_operand_uses`.) The `else: pass` drops only no-local-id variants.
void note_operand_pos(Operand op, int pos, Dict[int, int] &last_pos):
    match op:
        case OpCopy(l):
            last_pos.put(l, pos)
        case OpMove(l):
            last_pos.put(l, pos)
        case OpClone(l):
            last_pos.put(l, pos)
        case OpBorrow(l):
            last_pos.put(l, pos)
        else:
            pass

# ── Type mapping ─────────────────────────────────────────

int prim_name_to_type(String name):
    match name:
        case "int":
            return I64_TYPE
        case "float":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "void":
            return UNIT_TYPE
        case "int8":
            return I8_TYPE
        case "int16":
            return I16_TYPE
        case "int32":
            return I32_TYPE
        case "uint":
            return U64_TYPE
        case "uint8":
            return U8_TYPE
        case "byte":
            return U8_TYPE
        case "uint16":
            return U16_TYPE
        case "uint32":
            return U32_TYPE
        case "float32":
            return F32_TYPE
        else:
            return -1

# Resolve a SpannedType to a type name string (for drop analysis).
# Does NOT require GirModule — uses direct primitive and generic name resolution.
String spanned_type_to_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_name(ta)
            return result
        case TTuple(elems):
            if elems.len() == 0:
                return "void"
            String result = "Tuple"
            for te in elems:
                result = result + "__" + spanned_type_to_name(te)
            return result
        else:
            pass
    return "int64_t"

String mangle_type_name(String name, Vector[SpannedType] targs, GirModule &gmod):
    # Mangle generic type names: Vector[int] → Vector__int64_t
    if targs.len() == 0:
        if name == "String":
            return "GorgetString"
        return name
    String result = name
    for ta in targs:
        result = result + "__" + type_to_c_name(ta, &gmod)
    return result

String prim_to_c_name(String name):
    match name:
        case "int":
            return "int64_t"
        case "float":
            return "double"
        case "bool":
            return "bool"
        case "void":
            return "void"
        case "String":
            return "GorgetString"
        case "int8":
            return "int8_t"
        case "int16":
            return "int16_t"
        case "int32":
            return "int32_t"
        case "uint":
            return "uint64_t"
        case "uint8":
            return "uint8_t"
        case "byte":
            return "u8"
        case "uint16":
            return "uint16_t"
        case "uint32":
            return "uint32_t"
        case "float32":
            return "float"
        else:
            return name

String type_to_c_name(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return prim_to_c_name(name)
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return mangle_type_name(name, targs, &gmod)
        else:
            pass
    return "int64_t"

# ── ResolvedType → GIR translation (Gap #2 Phase 2) ─────
#
# The typechecker computes per-expression types into `types.expr_types`
# (a side-table keyed by `SpannedExpr.span.start`). Self-host's lowerer
# reads from there as typed metadata — single source of truth for
# expression types (Layering rule 3). These helpers translate the
# typechecker's `ResolvedType` representation into the GIR type-id
# space that the lowerer uses elsewhere.
#
# The two functions mirror `type_to_c_name` / `map_ast_type` but start
# from a `ResolvedType` id (an index into `types.types`) rather than
# an AST `SpannedType`. Substitutions in `gmod.type_subs` still apply
# at primitive leaves so generic-equip method bodies under active mono
# subs translate consistently.

String resolved_to_c_name(int rtid, TypeTable types, ScopeTable scopes, GirModule &gmod):
    if rtid < 0 or rtid >= types.types.len():
        return "int64_t"
    ResolvedType rt = types.types.get(rtid).unwrap()
    match rt:
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return type_id_to_name(gmod.type_subs.get(pname).unwrap(), &gmod)
            return prim_to_c_name(pname)
        case RTDefined(def_id):
            DefInfo di = scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            if name == "String":
                return "GorgetString"
            return name
        case RTGeneric(def_id, type_args):
            DefInfo di = scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, types, scopes, &gmod)
                mangled = mangled + "__" + arg_name
            return mangled
        case RTRef(inner_rtid):
            # option_ref_borrow Phase 1: a `Ref[T]` mangles to `Ref__<pointee>`
            # so an `Option[Ref[T]]` becomes `Option__Ref__T` (Rust parity,
            # matches driver.c's `__gg_Option__Ref__*`) — distinct from the
            # owned `Option__T` that pop/remove produce. The pointer-ness is
            # carried by the matching `GtPtr` in `resolved_to_gir_type`. We do
            # NOT strip the Ref here anymore: stripping collapsed the borrowed
            # and owned Option types onto one name and erased the payload's
            # pointer representation (the shallow-copy unsoundness).
            return "Ref__" + resolved_to_c_name(inner_rtid, types, scopes, &gmod)
        case RTTuple(elem_rtids):
            String tup_name = "Tuple"
            for et in elem_rtids:
                tup_name = tup_name + "__" + resolved_to_c_name(et, types, scopes, &gmod)
            return tup_name
        case RTArray(elem_rtid, _):
            return resolved_to_c_name(elem_rtid, types, scopes, &gmod)
        case RTSlice(elem_rtid):
            return resolved_to_c_name(elem_rtid, types, scopes, &gmod)
        else:
            return "int64_t"

int resolved_to_gir_type(int rtid, TypeTable types, ScopeTable scopes, GirModule &gmod):
    if rtid < 0 or rtid >= types.types.len():
        return I64_TYPE
    ResolvedType rt = types.types.get(rtid).unwrap()
    match rt:
        case RTVoid():
            return UNIT_TYPE
        case RTNever():
            return UNIT_TYPE
        case RTError():
            return I64_TYPE
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return gmod.type_subs.get(pname).unwrap()
            int prim_tid = prim_name_to_type(pname)
            if prim_tid >= 0:
                return prim_tid
            if pname == "String" or pname == "str":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, pname)
        case RTDefined(def_id):
            DefInfo di = scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            if name == "String":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, name)
        case RTGeneric(def_id, type_args):
            DefInfo di = scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, types, scopes, &gmod)
                mangled = mangled + "__" + arg_name
            int opt_tid = lookup_or_register_named(&gmod, mangled)
            # option_ref_borrow Phase 2b: when this is a borrowing-getter
            # result `Option[Ref[T]]` / `Result[Ref[T], _]`, thread the
            # payload `GtPtr(T)` id through the typed `option_ref_payload`
            # channel so unwrap / match-destructure mint a real pointer
            # without re-parsing the `Ref__` infix (CLAUDE.md "No name
            # matching"). The Option id is name-deduped, so this same id
            # appears at every read site.
            if (di.name == "Option" or di.name == "Result") and type_args.len() >= 1:
                int first_arg = get_int_at(type_args, 0)
                if first_arg >= 0 and first_arg < types.types.len():
                    ResolvedType arg_rt = types.types.get(first_arg).unwrap()
                    match arg_rt:
                        case RTRef(pointee_rtid):
                            int ptr_tid = register_ptr(&gmod, resolved_to_gir_type(pointee_rtid, types, scopes, &gmod))
                            record_option_ref_payload(&gmod, opt_tid, ptr_tid)
                        else:
                            pass
                # Typed enum-category channel: record the resolved payload
                # tids so unwrap / match / catch / rethrow / LIR field-shape
                # never re-parse the mangled name. The first type-arg is the
                # Some_0 / Ok_0 payload; the second (Result only) is Error_0.
                # The payload tids come straight from the typechecker's
                # `type_args` — the authoritative typed source (Layering rule
                # 4, resolve once / write through).
                int ec_ok = resolved_to_gir_type(get_int_at(type_args, 0), types, scopes, &gmod)
                if di.name == "Option":
                    record_enum_category(&gmod, opt_tid, ENUM_CAT_OPTION, ec_ok, -1)
                elif type_args.len() >= 2:
                    int ec_err = resolved_to_gir_type(get_int_at(type_args, 1), types, scopes, &gmod)
                    record_enum_category(&gmod, opt_tid, ENUM_CAT_RESULT, ec_ok, ec_err)
            return opt_tid
        case RTRef(inner_rtid):
            # option_ref_borrow Phase 1: a `Ref[T]` lowers to `GtPtr(T)` (Rust
            # parity — ResolvedType::Ref → GirType::Ptr). We no longer strip
            # the Ref to the bare pointee: stripping erased the pointer
            # representation that downstream deref / clone-at-owning relies on.
            # The borrow vs owned distinction is ALSO carried on the GIR
            # local's `ownership` (LoBorrowed); the type now carries it too
            # (Decision D2), and a standalone-Ref bind matches `GtPtr(inner)`
            # directly at the svardecl site.
            return register_ptr(&gmod, resolved_to_gir_type(inner_rtid, types, scopes, &gmod))
        case RTTuple(elem_rtids):
            # Mirror `mangle_type_name` for tuples — register the mangled
            # Tuple__T1__T2__... name and let downstream code register
            # the struct shape (existing tuple-literal lowering does this).
            String tup_name = "Tuple"
            for et in elem_rtids:
                tup_name = tup_name + "__" + resolved_to_c_name(et, types, scopes, &gmod)
            return lookup_or_register_named(&gmod, tup_name)
        case RTArray(elem_rtid, _):
            # Arrays map to GorgetArray (the C-level Vector backing); the
            # element type is metadata stored elsewhere (type_infos).
            return lookup_or_register_named(&gmod, "GorgetArray")
        case RTSlice(elem_rtid):
            return lookup_or_register_named(&gmod, "GorgetArray")
        else:
            return I64_TYPE

# Convenience: query the typechecker's per-expression type for a given
# SpannedExpr (by span.start) and translate to GIR. Returns -1 if no
# entry is recorded; callers should fall back to their existing path.
# Reads the typechecker side-tables stashed on `gmod` at lower_module
# entry (single accessor — typed-metadata write-through, Layering rule 2).
int lookup_expr_gir_type(SpannedExpr sexpr, GirModule &gmod):
    int span_start = sexpr.span.start
    if not gmod.tc_types.expr_types.contains(span_start):
        return -1
    int rtid = gmod.tc_types.expr_types.get(span_start).unwrap()
    return resolved_to_gir_type(rtid, gmod.tc_types, gmod.tc_scopes, &gmod)

int map_ast_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            match name:
                case "int":
                    return I64_TYPE
                case "float":
                    return F64_TYPE
                case "bool":
                    return BOOL_TYPE
                case "void":
                    return UNIT_TYPE
                case "String":
                    return lookup_or_register_named(&gmod, "GorgetString")
                else:
                    pass
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            # Resolve type aliases (meta type = ...)
            if targs.len() == 0 and gmod.meta_aliases.contains(name):
                String alias_target = gmod.meta_aliases.get(name).unwrap()
                int at = prim_name_to_type(alias_target)
                if at >= 0:
                    return at
                return lookup_or_register_named(&gmod, alias_target)
            int t = prim_name_to_type(name)
            if t >= 0:
                return t
            # Callable types: Callable[T(int)] → FnPtr([int], T) for type inference.
            # The actual ABI is Ptr (void*), but we record the function type
            # so callable dispatch can infer return types.
            if name == "Callable" or name == "MutCallable" or name == "ConsumeCallable":
                if targs.len() == 1:
                    # Single type arg is a function type: T(int, int)
                    SpannedType fn_arg = targs.get(0).unwrap()
                    match fn_arg.ty:
                        case TFunction(ret_box, fn_params, _):
                            Vector[int] param_tids = []
                            for fp in fn_params:
                                param_tids.push(map_ast_type(fp, &gmod))
                            int ret_tid = map_ast_type(*ret_box, &gmod)
                            int fn_tid = register_type(&gmod, GtFnPtr(param_tids, ret_tid))
                            return register_ptr(&gmod, fn_tid)
                        else:
                            pass
                return UNIT_TYPE
            # Named type with possible generic args
            String mangled = mangle_type_name(name, targs, &gmod)
            int mat_tid = lookup_or_register_named(&gmod, mangled)
            # Typed enum-category channel (AST path — mirrors the
            # ResolvedType RTGeneric arm). Record the payload tids resolved
            # from the AST type-args so downstream never re-parses `mangled`.
            if name == "Option" and targs.len() >= 1:
                int mat_ok = map_ast_type(targs.get(0).unwrap(), &gmod)
                record_enum_category(&gmod, mat_tid, ENUM_CAT_OPTION, mat_ok, -1)
            elif name == "Result" and targs.len() >= 2:
                int mat_rok = map_ast_type(targs.get(0).unwrap(), &gmod)
                int mat_rerr = map_ast_type(targs.get(1).unwrap(), &gmod)
                record_enum_category(&gmod, mat_tid, ENUM_CAT_RESULT, mat_rok, mat_rerr)
            return mat_tid
        case TFunction(ret_box, fn_params_f, _):
            # Function types as params/fields → Ptr(FnPtr). The C-level ABI for
            # bare closure params is void* (GorgetClosure* effectively); encode
            # as Ptr(FnPtr(...)) so lir_lower sees a pointer type.
            # Function types as return types are handled by map_fn_return_type.
            Vector[int] fpf_params = []
            for fpf in fn_params_f:
                fpf_params.push(map_ast_type(fpf, &gmod))
            int fpf_ret = map_ast_type(*ret_box, &gmod)
            int fpf_tid = register_type(&gmod, GtFnPtr(fpf_params, fpf_ret))
            return register_ptr(&gmod, fpf_tid)
        case TInferred():
            return I64_TYPE
        case TTuple(elems):
            # Mangle tuple: Tuple__T1__T2__...
            String tuple_name = "Tuple"
            for elem in elems:
                tuple_name = tuple_name + "__" + type_to_c_name(elem, &gmod)
            return lookup_or_register_named(&gmod, tuple_name)
        else:
            pass
    return I64_TYPE

# Map return type — same as map_ast_type but TFunction produces GtFnPtr
int map_fn_return_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TFunction(ret_type_box, fn_param_types, _):
            Vector[int] fn_params = []
            for fp in fn_param_types:
                fn_params.push(map_ast_type(fp, &gmod))
            int fn_ret = map_ast_type(*ret_type_box, &gmod)
            return register_type(&gmod, GtFnPtr(fn_params, fn_ret))
        else:
            return map_ast_type(stype, &gmod)

# ── Type ID to name ──────────────────────────────────────

String type_id_to_name(int tid, GirModule &gmod):
    match tid:
        case 0:
            return "bool"
        case 4:
            return "int64_t"
        case 10:
            return "double"
        case 11:
            return "unit"
        else:
            pass
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(inner):
                return type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                return type_id_to_name(inner, &gmod)
            else:
                pass
    return "int64_t"

# ── Resource type detection ──────────────────────────────

# Get parameter type IDs for a function from the GIR module.
Vector[int] get_fn_param_types(String name, GirModule &gmod):
    Vector[int] types = []
    int i = 0
    while i < gmod.functions.len():
        if gmod.functions.get(i).unwrap().name == name:
            for pt in gmod.functions.get(i).unwrap().param_types:
                types.push(pt)
            return types
        i += 1
    return types

# Check if a call name is a type constructor (produces a named type).
# Map binary operator strings to their trait-method names (for operator
# overload dispatch on user structs).
String binop_method_name(String op):
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "/":
        return "div"
    if op == "%":
        return "rem"
    return ""

# Returns the parent enum name if `name` is a variant of a known enum,
# or "" if not a variant. Used to route bare variant constructors
# (IntCol, Red, Ok, ...) to their enclosing enum's named type.
String enum_variant_parent(String name, GirModule &gmod):
    # O(1) lookup into the flat variant→enum index (built FIRST-WRITE-WINS
    # at lower_module construction, mirroring this scan's old insertion-order
    # first-match). Replaces an O(types) scan that deep-cloned a
    # `GirTypeInfo` per type (the #1 array_clone site).
    if gmod.enum_variant_parent_idx.contains(name):
        return gmod.enum_variant_parent_idx.get(name).unwrap()
    return ""

bool is_type_constructor(String name, GirModule &gmod):
    # Phase A typed read: parameterised resource families with the
    # `T(args)` user-code constructor shape (Vector__T, Dict__K__V,
    # Mutex__T, …) carry `is_typed_constructor=true` in their
    # metadata. Built-in singletons / factory-shape opaques /
    # Box / Heap / Atomic / etc. carry `false`.
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            if rmeta.is_typed_constructor:
                return true
            return false
        case None:
            pass
    # Primitive type-constructor calls (String("x"), Int(1)) and other
    # bare names — coercions or runtime-helper construction, not
    # user struct instantiation. build_resource_metadata returns None
    # for the user-struct-name case, so we drop here.
    if name == "String" or name == "Int" or name == "Float" or name == "Bool":
        return false
    if name == "Char":
        return false
    if name == "Rc" or name == "Arc":
        return false
    if name == "Channel" or name == "Deque" or name == "Vector":
        return false
    if name == "Dict" or name == "HashMap" or name == "Set" or name == "HashSet":
        return false
    if name == "Option" or name == "Result":
        return false
    # User-defined struct names (capitalised, no __ suffix). The
    # metadata path returned None for these, so they fall through here.
    if name.len() > 0:
        String first = name.slice(0, 1)
        if first >= "A" and first <= "Z" and not name.contains("__"):
            return true
    return false

# R9 FIDELITY — scoped-allocator constructor → runtime `gorget_<kind>_new`.
# Mirrors Rust gg's allocator-constructor special-cases in
# `src/ir/lowering/exprs/calls.rs:708-744`. Returns the runtime symbol for
# the 6 stdlib allocator constructors, "" for anything else. Name-matching
# these 6 builtin allocator types is the Rust-blessed exception (the
# constructor name IS the contract with the runtime — there is no
# corresponding `T(args)` user code, the allocator structs are opaque
# handles). Kept FLAT with explicit literals (no concat) per the layering
# discipline + R9 MINOR-1 (a nested/concat shape tripped a spurious driver
# C error in prototyping).
String allocator_constructor_runtime_name(String name):
    if name == "Arena":
        return "gorget_arena_new"
    if name == "TrackingAllocator":
        return "gorget_tracking_new"
    if name == "PoolAllocator":
        return "gorget_pool_new"
    if name == "TlsfAllocator":
        return "gorget_tlsf_new"
    if name == "FixedBufferAllocator":
        return "gorget_fba_new"
    if name == "FallbackAllocator":
        return "gorget_fallback_new"
    return ""

# SYNC FIDELITY — non-generic sync-primitive constructor → runtime
# `gorget_<kind>_new`. Mirrors the R9 allocator special-case above and Rust
# gg's hardcoded sync constructors (`src/ir/lowering/exprs/calls.rs:851` /
# `exprs/mod.rs:1652`). These structs are opaque handles (the runtime returns
# a `GorgetAtomicInt*` etc.); there is no user `T(args)` body, so the default
# struct-constructor path would build a zero-field struct + store into a
# nameless field (cc-rejected `-> = `). Name-matching these builtin sync types
# is the same Rust-blessed exception as the allocator map (the constructor name
# IS the contract with the runtime). RWLock/ReadGuard/WriteGuard are GENERIC
# (`RWLock__T`) and construct via the existing method_prefix path — NOT listed
# here. Kept FLAT with explicit literals (no concat) per R9.
String sync_constructor_runtime_name(String name):
    if name == "AtomicInt":
        return "gorget_atomic_int_new"
    if name == "AtomicBool":
        return "gorget_atomic_bool_new"
    if name == "Barrier":
        return "gorget_barrier_new"
    if name == "CondVar":
        return "gorget_condvar_new"
    if name == "Semaphore":
        return "gorget_semaphore_new"
    if name == "WaitGroup":
        return "gorget_waitgroup_new"
    if name == "OnceFlag":
        return "gorget_onceflag_new"
    return ""

# R9 FIDELITY — allocator TYPE-name → runtime `gorget_<kind>_destroy`.
# Mirrors Rust gg's `lower_with` destroy dispatch
# (`src/ir/lowering/stmts/mod.rs:2835-2841`). Keys are the FULL allocator
# type-names (mirrors Rust `type_name_for_id`). Returns "" for non-allocator
# types. Same Rust-blessed-name-match exception as the `_new` map above.
String allocator_type_destroy_name(String type_name):
    if type_name == "Arena":
        return "gorget_arena_destroy"
    if type_name == "TrackingAllocator":
        return "gorget_tracking_destroy"
    if type_name == "PoolAllocator":
        return "gorget_pool_destroy"
    if type_name == "TlsfAllocator":
        return "gorget_tlsf_destroy"
    if type_name == "FixedBufferAllocator":
        return "gorget_fba_destroy"
    if type_name == "FallbackAllocator":
        return "gorget_fallback_destroy"
    return ""

# Get the type name for a GIR local (e.g., "Vector__int64_t", "GorgetString").
String local_type_name(int local_id, LowerCtx &ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return "int64_t"
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return type_id_to_base_name(tid, &gmod)

# Unwrap Ptr/MutPtr to reach the underlying named type (for method dispatch
# on borrow/move params).
String type_id_to_base_name(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return "int64_t"
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name
        case GtPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        case GtMutPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        else:
            pass
    return "int64_t"

# Infer the return type of a method call.
# Resolve a field type name from GirFieldInfo to a GIR type ID.
int resolve_field_gir_type(String type_name, GirModule &gmod):
    match type_name:
        case "int" | "int64_t":
            return I64_TYPE
        case "float" | "double":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "String" | "GorgetString" | "Str":
            return lookup_or_register_named(&gmod, "GorgetString")
        case "int32_t" | "i32":
            return I32_TYPE
        case "int8_t" | "i8" | "byte" | "uint8_t":
            return I8_TYPE
        else:
            # BRIDGE (option_ref_borrow): a `Ref__<pointee>` field name is a
            # borrow-payload (Option[Ref[T]].Some_0) — resolve it to a real
            # GtPtr(pointee). This is the ONE name-matching site (mirrors Rust
            # methods.rs:612-615 strip_prefix("Ref__")→Ptr), reached only by a
            # heuristic that derives the payload type from a NAME before any
            # registered Option id exists. The typed path (option_ref_payload,
            # Phase 2b) covers unwrap + match-destructure directly; delete this
            # bridge once every name-deriving caller is on the typed channel.
            if type_name.starts_with("Ref__"):
                String pointee = type_name.slice(5, type_name.len())
                return register_ptr(&gmod, resolve_field_gir_type(pointee, &gmod))
            # Named type (user struct, collection, etc.)
            int rft_tid = lookup_or_register_named(&gmod, type_name)
            # Typed enum-category recording for a mono'd Option/Result that
            # arrives as a struct/enum FIELD type NAME (e.g. `R.outcome:
            # Result[int, String]`). These don't flow through a typed mint —
            # the typechecker's RTGeneric was lost when the field type was
            # stored as a name in `GirTypeInfo`, and `gmod` doesn't exist yet
            # at struct-registration time — so this lazy resolver is the
            # earliest point with `gmod` in hand. Record ONCE here (write
            # site) so the match-destructure / LIR field-shape readers stay
            # name-free (Layering rule 4). Idempotent (record_enum_category
            # is first-write-wins).
            record_field_enum_category(type_name, rft_tid, &gmod)
            return rft_tid

# Record the typed `enum_category` payloads for a mono'd `Option__`/
# `Result__` field-type NAME (the one residual name-derivation site — a
# field type stored as a name in `GirTypeInfo`, with no surviving typed
# RTGeneric). The Option payload is unambiguous (`Option__<rest>`). The
# Result split (`Result__<Ok>__<Err>`, Ok possibly compound) probes each
# `__` boundary and accepts the first where the Err half resolves to a
# registered/primitive type — recorded into the typed channel so EVERY
# READER reads tids, not names. (`Option__Ref__` is left to the
# option_ref_payload channel.)
void record_field_enum_category(String type_name, int enum_tid, GirModule &gmod):
    if has_enum_category(&gmod, enum_tid):
        return
    if type_name.starts_with("Option__") and not type_name.starts_with("Option__Ref__"):
        String inner = type_name.slice(8, type_name.len())
        record_enum_category(&gmod, enum_tid, ENUM_CAT_OPTION, resolve_field_gir_type(inner, &gmod), -1)
    elif type_name.starts_with("Result__"):
        String rest = type_name.slice(8, type_name.len())
        String ok_name = ""
        String err_name = ""
        int si = 0
        while si + 1 < rest.byte_len():
            if rest.byte_at(si) == 0x5F and rest.byte_at(si + 1) == 0x5F:
                String e_try = rest.slice(si + 2, rest.len())
                # Accept the boundary whose Err half is a known concrete type
                # (registered user type / mono'd collection / primitive). The
                # Ok half is then whatever precedes it — possibly compound.
                if is_known_field_type_name(e_try, &gmod):
                    ok_name = rest.slice(0, si)
                    err_name = e_try
                    break
            si += 1
        if ok_name == "":
            # Fall back to the leftmost split.
            int split = rest.index_of("__").unwrap_or(-1)
            if split > 0:
                ok_name = rest.slice(0, split)
                err_name = rest.slice(split + 2, rest.len())
        if ok_name != "":
            record_enum_category(&gmod, enum_tid, ENUM_CAT_RESULT, resolve_field_gir_type(ok_name, &gmod), resolve_field_gir_type(err_name, &gmod))

# True when `name` is a CONCRETE field-type name: a primitive, a
# registered user struct/enum, or a mono'd collection prefix. Used only by
# `record_field_enum_category` to pick the Result Ok/Err `__` boundary.
bool is_known_field_type_name(String name, GirModule &gmod):
    if name == "int" or name == "int64_t" or name == "float" or name == "double" or name == "bool":
        return true
    if name == "String" or name == "GorgetString" or name == "Str":
        return true
    if name == "int32_t" or name == "i32" or name == "int8_t" or name == "i8" or name == "byte" or name == "uint8_t":
        return true
    if name == "int16_t" or name == "uint16_t" or name == "uint32_t" or name == "uint64_t":
        return true
    if gmod.type_infos.contains(name):
        return true
    if name.starts_with("Vector__") or name.starts_with("Deque__") or name.starts_with("Heap__"):
        return true
    if name.starts_with("Set__") or name.starts_with("HashSet__") or name.starts_with("Dict__"):
        return true
    if name.starts_with("HashMap__") or name.starts_with("GorgetMap__") or name.starts_with("Box__"):
        return true
    return false

# Constant-fold a top-level `const int` initializer. Supports int
# literals, references to other const_decls, and the binary/unary ops
# the self-host's parser.gg actually uses in KW_* / PREC_* decls.
# Returns None for unsupported shapes — the const is dropped silently
# and the identifier reference later falls back to OpConstI64(0).
# Float-constant evaluator. Mirrors `eval_const_int_expr` but for
# `float EPSILON = 0.000001` etc. — module-level float consts that
# the int-evaluator can't represent. Used by the IConstDecl /
# IStaticDecl handlers to populate `gmod.float_const_decls`, which
# `EIdentifier` then consults before the [bug] fallback.
# Helper extracted from `lower_expr`'s EIdentifier arm — keeps that
# function's already-massive stack frame from growing further.
# Returns the new local id on hit (>= 0); -1 on miss.
int lower_float_const_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not gmod.float_const_decls.contains(name):
        return -1
    int fdst = add_local(&ctx, F64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(fdst, OpConstF64(gmod.float_const_decls.get(name).unwrap())))
    return fdst

# Function-as-value: `filter(is_even)` / `map(double)` etc. — a bare
# function name passed where a Callable is expected. Mirrors Rust
# gg's `Constant::FuncRef(name)` operand. Emit a synthetic
# `__fn_addr__<name>` GICallExtern; `lir_lower` intercepts that
# prefix and lowers to `IFuncAddr(fid)`, which the C codegen turns
# into the `static void*[] = {(void*)__adapt_<name>, NULL}` shape
# `gorget_array_filter` / etc. expect. Returns the new local id on
# hit (>= 0); -1 on miss.
#
# Only fires for non-generic functions registered in `fn_sigs` — a
# generic template wouldn't have a single mono'd target to point at.
# The helper is in its own function (not inlined) for the same
# stack-frame reason as `lower_float_const_ident`.
int lower_fn_addr_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not gmod.fn_sigs.contains(name):
        return -1
    int gs_tid = lookup_or_register_named(&gmod, "GorgetClosure")
    int adst = add_local(&ctx, gs_tid, NO_NAME)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(adst, "__fn_addr__" + name, no_args))
    return adst

# Module-level static reference: `stdout` / `stderr` / `stdin` etc.
# Emits a synthetic `__global_ref__<name>` GICallExtern which
# `lir_lower` rewrites to `IGlobalAddr(dst, gid)`. Mirrors Rust gg's
# `Operand::Constant(Constant::GlobalRef(name))`
# (`src/ir/lowering/exprs/mod.rs:128-130`). Returns the new local id
# on hit (>= 0); -1 on miss. Out-of-line for the same stack-frame
# reason as `lower_float_const_ident` / `lower_fn_addr_ident`.
int lower_static_ref_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not static_contains(&gmod, name):
        return -1
    int sty = static_lookup_type(&gmod, name)
    int sdst = add_local(&ctx, sty, NO_NAME)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(sdst, "__global_ref__" + name, no_args))
    return sdst

# Bare nullary enum-variant used as a value: `IDropGuardClose` brought
# into scope via `from lir import IDropGuardClose` and referenced WITHOUT
# parens (lir_lower.gg:3296 `dia_blk.insts.push(IDropGuardClose)`).
# docs/language-reference.md:677/719 permit bare nullary variants
# (`LogLevel lvl = Info`); Rust gg accepts them (kept as an identifier
# through parse/resolve, resolved in the lowerer — src/ir/lowering/exprs/
# mod.rs:176-180). The with-parens form `IDropGuardClose()` already works,
# so we delegate the bare form to the identical `lower_call(name, [], [])`
# path: lower_call types the dst as the parent enum via is_type_constructor
# + enum_variant_parent (lower.gg:5432-5436), emits `GICall(dst, name, [])`,
# which lir_lower passes through as an ICallExtern and the C backend renders
# as a full-size `(Inst){.tag = N}` compound literal (lir_codegen.gg:4043,
# 4106-4132). (NOT via try_lower_prelude_variant/IEnumInit — that path is
# Some/None/Ok/Error only.) Without this, the bare form falls through to the
# EIdentifier [bug] fallback and emits an 8-byte OpConstI64(0); a later
# `vec.push(...)` then memcpy's it as a full-size Inst (208 B) → stack-
# buffer-overflow at runtime. Out-of-line for the same stack-frame reason
# as lower_fn_addr_ident / lower_static_ref_ident (lower_expr's frame is
# ~148 KB and overflows on deep recursion). Returns the new local id
# (>= 0) on hit, -1 on miss.
int lower_nullary_variant_ident(LowerCtx &ctx, GirModule &gmod, String name):
    String parent = enum_variant_parent(name, &gmod)
    if parent == "":
        return -1
    Vector[SpannedExpr] no_args = []
    Vector[SpannedType] no_targs = []
    return lower_call(&ctx, &name, &no_args, &no_targs, &gmod)

# Meta-op token (`meta +`, `meta /`, …): the parser encodes these
# as `EIdentifier("__metaop__add")` / `__metaop__div` / etc. and
# passes them as args to generic functions like
# `tensor_elemwise[T](a, b, meta op)` (`lib/xtd/tensor.gg:307`).
# These tokens are *compile-time only* — Rust gg filters them out
# of the call arg list at GIR lowering
# (`src/ir/lowering/exprs/calls.rs:882-893`) and uses them only to
# build the mangled callee name (`tensor_elemwise__add` etc.) via
# what `extract_meta_op_suffix` mirrors here. They have no runtime
# representation; if `lower_expr` walks one as a real value
# identifier (because the call's arg-lowering didn't filter it),
# the existing `[bug] EIdentifier` fallback triggers.
#
# Emit a harmless zero-int placeholder when the EIdentifier arm
# encounters one. The mangled call name was already computed by
# `extract_meta_op_suffix` during transitive-generic discovery, so
# the runtime call dispatches to e.g. `tensor_elemwise__add`,
# which doesn't take a meta-op param. Whatever extra arg gets
# emitted from this placeholder is dead at the C level — but the
# cascade closes (24 EIdentifier `[bug]` markers across the
# `xtd__tensor` family in the fixture sweep go to zero). Out-of-line
# for the same stack-frame reason as the other ident helpers above.
int lower_metaop_ident(LowerCtx &ctx, String name):
    if not name.starts_with("__metaop__"):
        return -1
    int mdst = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(mdst, OpConstI64(0)))
    return mdst

# Module-level static with a runtime-call init: `public static File
# stdout = _stdout_handle()` etc. (lib/std/io.gg). Mirrors Rust gg's
# `LoweringContext::global_names` + `module.globals: Vec<Global>`
# (`src/ir/lowering/mod.rs:1074-1111`). Recognises the zero-arg
# `_<sym>()` shape and registers it under `gmod.static_keys` so the
# `EIdentifier` arm can resolve to a `__global_ref__<name>` synthetic
# intrinsic which `lir_lower` rewrites to `IGlobalAddr`.
#
# Only the `_<sym>` → `gorget_<sym>` underscore-prefix mapping is
# wired (sufficient for `_stdin_handle` / `_stdout_handle` /
# `_stderr_handle`). Other init shapes return false; the caller
# falls through to the existing ENoneLiteral / [bug] cascade.
#
# Helper lives in its own fn for the same stack-frame reason as
# `lower_float_const_ident` / `lower_fn_addr_ident` — keeping the
# IStaticDecl-arm dispatch site small.
bool try_register_static_runtime_call(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, _):
            if args.len() != 0:
                return false
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fn_name):
                    if not fn_name.starts_with("_"):
                        return false
                    String runtime_call = "gorget_" + fn_name.slice(1, fn_name.len()) + "()"
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put(&gmod, sd_name, runtime_call, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Module-level static with a CONSTRUCTIVE (non-compile-time-constant)
# initializer. Mirrors Rust gg's TWO-PATH static lowering
# (`src/ir/lowering/mod.rs`), and stays faithful to it so the
# `c_emit_comparison` user-fn count matches:
#
#  (1) ARRAY/DICT LITERAL (`static Vector[T] X = [..]` / `= {..}`) →
#      a synthesized zero-arg `__gg_static_init_<name>()` fn whose body
#      materializes the RHS (Rust's `initializer_needs_synthetic_fn`
#      `:2381` + `synthesize_static_init_fn` `:2397`). The static's
#      init_expr is the call `__gg_static_init_<name>()`.
#
#  (2) COLLECTION CONSTRUCTOR (`static Vector[int] N = Vector[int]()` /
#      `Dict[String,int]()`) → a DIRECT runtime allocator init_expr
#      (`gorget_array_new(sizeof(T))` / `gorget_dict_new[_str](...)`),
#      NO synth fn (Rust's `eval_static_init` arms `:2580-2620`). Rust
#      emits ZERO user fns for these, so a synth fn here would over-count.
#
# Both register the static with its declared `Vector__T`/`Dict__K__V`
# type so an `EIdentifier` reference resolves to a properly-typed
# `__global_ref__<name>` → `IGlobalAddr`, and the loop / `.get()` route
# to `lower_for_vector` / the typed collection methods. The
# `GINIT_RUNTIME_CALL` global is assigned in the `main` prologue
# (`lir_codegen.gg:4504-4513`) — for (1) it calls the synth fn, for (2)
# it runs the allocator C-expr directly.

# True for an array/dict literal RHS → synth-fn path (case 1 above).
bool static_is_literal_init(SpannedExpr sd_val):
    match sd_val.expr:
        case EArrayLiteral(_):
            return true
        case EDictLiteral(_, _):
            return true
        else:
            return false

# True for a SCALAR-literal RHS (int / float / bool), including a leading
# unary `-` / `+` thereof (`static int x = -1`). Scalar statics are
# MUTABLE module-level globals (a `static` is not a `const`), so they are
# registered under `gmod.statics` with a runtime-init synth fn rather than
# const-folded — see the IStaticDecl pre-pass.
bool static_is_scalar_literal_init(SpannedExpr sd_val):
    match sd_val.expr:
        case EIntLiteral(_):
            return true
        case EFloatLiteral(_):
            return true
        case EBoolLiteral(_):
            return true
        case EUnaryOp(op, inner_box):
            if op == "-" or op == "+":
                return static_is_scalar_literal_init(*inner_box)
            return false
        else:
            return false

String static_init_fn_name(String sd_name):
    return "__gg_static_init_" + sd_name

# Render a SCALAR-literal static RHS as a const C initializer expression
# (the `init_expr` of a GGSTATIC_BYTES global): int → `<n>LL`, float →
# `float_to_str(v)`, bool → `1`/`0`, recursing through a leading unary
# `-` / `+`. Mirrors Rust encoding the literal as `GlobalInit::Bytes`
# then the C backend rendering those bytes back to a literal
# (`src/backend/c_lir/emit_types.rs:630-655`: int = `<n>LL`, float = the
# decimal value, bool = the byte). Returns "" if not a recognised scalar
# literal (caller falls through to the runtime synth-fn path).
String scalar_static_c_literal(SpannedExpr sd_val):
    match sd_val.expr:
        case EIntLiteral(n):
            return int_to_str(n) + "LL"
        case EFloatLiteral(v):
            return float_to_str(v)
        case EBoolLiteral(b):
            if b:
                return "1"
            return "0"
        case EUnaryOp(op, inner_box):
            if op == "-" or op == "+":
                String inner = scalar_static_c_literal(*inner_box)
                if inner == "":
                    return ""
                return op + inner
            return ""
        else:
            return ""

# Register a SCALAR-literal static (`static int x = 0`) as a const-bytes
# global: render the RHS to a C literal and store it as the global's
# `init_expr` under GGSTATIC_BYTES. NO synth init fn, NO main-prologue
# call — the C backend emits `<type> <name> = <literal>;` at the
# declaration. Mirrors Rust's every-StaticDecl-is-a-mutable-Global rule
# emitting a scalar literal via `GlobalInit::Bytes`
# (`src/ir/lowering/mod.rs:2459-2461`, `is_const:false`). The static stays
# MUTABLE (write-backs via SAssign work as before).
void register_scalar_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    int ty_id = map_ast_type(sd_ty, &gmod)
    String lit = scalar_static_c_literal(sd_val)
    static_put_bytes(&gmod, sd_name, lit, ty_id)

# Build the `gorget_array_new(...)` / `gorget_dict_new[_str](...)` C init
# expr for a collection-CONSTRUCTOR static (case 2). The element C-type
# names come from the DECLARED type's args (Rust's `generic_elem_c_type`
# reads `ty`, not the call). Returns "" if the declared type isn't a
# recognised collection — the caller then falls through (a non-collection
# constructor static is not handled by this path).
String collection_ctor_init_expr(SpannedType sd_ty, GirModule &gmod):
    match sd_ty.ty:
        case TNamed(tn, targs):
            if (tn == "Vector" or tn == "Array" or tn == "Deque" or tn == "Heap" or tn == "Set" or tn == "HashSet" or tn == "OrderedSet") and targs.len() >= 1:
                String elem_c = type_to_c_name(targs.get(0).unwrap(), &gmod)
                return "gorget_array_new(sizeof(" + elem_c + "))"
            if (tn == "Dict" or tn == "HashMap" or tn == "Map" or tn == "OrderedDict") and targs.len() >= 2:
                String key_c = type_to_c_name(targs.get(0).unwrap(), &gmod)
                String val_c = type_to_c_name(targs.get(1).unwrap(), &gmod)
                if key_c == "GorgetString":
                    return "gorget_dict_new_str(sizeof(" + val_c + "))"
                return "gorget_dict_new(sizeof(" + key_c + "), sizeof(" + val_c + "))"
            return ""
        else:
            return ""

# Detect + register a collection-constructor static (case 2). The init
# RHS must be a zero-arg `ECall` whose callee is an EIdentifier matching
# the declared collection type (`Vector[int]()` parses as
# `ECall(EIdentifier("Vector"), [], [int])`). Returns true on hit
# (registered with a direct allocator init_expr, NO synth fn); false to
# fall through to the literal / None cascade.
bool try_register_collection_ctor_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, _):
            if args.len() != 0:
                return false
            match (*callee_box).expr:
                case EIdentifier(_):
                    String init_expr = collection_ctor_init_expr(sd_ty, &gmod)
                    if init_expr == "":
                        return false
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put(&gmod, sd_name, init_expr, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Detect + register a USER-STRUCT-constructor static (case 3): a
# `static Counter c = Counter(0)` whose RHS is `ECall(EIdentifier(cname),
# [literal, ...], [])` with the declared type bare `TNamed(cname, [])`,
# `cname` a NON-enum user struct (in `gmod.type_infos`), NOT a sync/atomic
# constructor, and EVERY arg a recognised scalar literal. Builds the
# positional C compound literal in arg order (`Counter(0)` → `{0LL}`) and
# registers it as a GGSTATIC_BYTES const init — the C backend emits
# `<struct> __lir_gN = {0LL};` at the declaration, no synth fn. Mirrors
# Rust's `GlobalInit::Struct` (`src/ir/lowering/mod.rs:2630-2659`): all-args-
# literal struct ctor → typed compile-time initializer, both backends render
# it to `{f0, f1, …}`. Returns true on hit; false (any guard fails) to fall
# through to the literal / None cascade with NO regression.
bool try_register_struct_ctor_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, targs):
            if targs.len() != 0:
                return false
            if args.len() == 0:
                return false
            match (*callee_box).expr:
                case EIdentifier(cname):
                    # Declared type must be bare `TNamed(cname, [])` (no
                    # generic args; the call's name must match the type).
                    match sd_ty.ty:
                        case TNamed(tn, ty_targs):
                            if tn != cname:
                                return false
                            if ty_targs.len() != 0:
                                return false
                        else:
                            return false
                    # `cname` must be a registered NON-enum user struct, and
                    # NOT a sync/atomic constructor (those route through
                    # `sync_constructor_runtime_name` at the runtime path).
                    if not gmod.type_infos.contains(cname):
                        return false
                    GirTypeInfo sct_ti = gmod.type_infos.get(cname).unwrap()
                    if sct_ti.is_enum:
                        return false
                    if sync_constructor_runtime_name(cname) != "":
                        return false
                    # Every arg must render as a scalar C literal; build the
                    # positional compound literal in arg order.
                    String lit = "{"
                    int ai = 0
                    while ai < args.len():
                        String al = scalar_static_c_literal(args.get(ai).unwrap())
                        if al == "":
                            return false
                        if ai > 0:
                            lit = lit + ", "
                        lit = lit + al
                        ai += 1
                    lit = lit + "}"
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put_bytes(&gmod, sd_name, lit, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Register a LITERAL-init static (case 1) under `gmod.statics`; the
# matching `FunctionDef` is built by `build_static_init_fn` and lowered in
# the main function loop. Mirrors Rust pushing a `Global { init:
# Extern { name: synth_name, args: [] } }`.
void register_literal_static(GirModule &gmod, SpannedType sd_ty, String sd_name):
    int ty_id = map_ast_type(sd_ty, &gmod)
    String init_call = static_init_fn_name(sd_name) + "()"
    static_put(&gmod, sd_name, init_call, ty_id)

# Build the synthetic `<T> __gg_static_init_<name>(): T __r = RHS; return __r`
# FunctionDef. The body MUST be the VarDecl-with-declared-type then
# `return __r` shape (NOT `return RHS`): the VarDecl init lowering reads
# the declared type to size collection-literal buffers + propagate the
# element type (`lower_stmt`'s SVarDecl arm sets `pending_vec_elem_tyname`
# / `pending_dict_*`). Mirrors Rust's `synthesize_static_init_fn`
# (`src/ir/lowering/mod.rs:2386-2441`) — same anti-"simplify-to-return-RHS"
# warning applies.
FunctionDef build_static_init_fn(SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    # ownership=0 (OWN_BORROW), shared=0, name_span=-1 — matching the
    # self-host parser's local-VarDecl construction (parser.gg:3208).
    Stmt vd = SVarDecl(sd_ty, "__r", sd_val, 0, 0, -1)
    SpannedExpr ret_id = SpannedExpr(EIdentifier("__r"), sd_val.span)
    Stmt rs = SReturn(Some(ret_id))
    Vector[Stmt] body = [vd, rs]
    Vector[Param] no_params = []
    Vector[String] no_tparams = []
    return FunctionDef(static_init_fn_name(sd_name), no_params, sd_ty, no_tparams, body, false, None)

Option[float] eval_const_float_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EFloatLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.float_const_decls.contains(name):
                return Some(gmod.float_const_decls.get(name).unwrap())
            return None
        case EUnaryOp(op, inner_box):
            Option[float] iv = eval_const_float_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0.0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

Option[int] eval_const_int_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EIntLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.const_decls.contains(name):
                return Some(gmod.const_decls.get(name).unwrap())
            return None
        case EBinaryOp(lhs_box, op, rhs_box):
            Option[int] lv = eval_const_int_expr(*lhs_box, &gmod)
            Option[int] rv = eval_const_int_expr(*rhs_box, &gmod)
            match lv:
                case Some(la):
                    match rv:
                        case Some(ra):
                            if op == "+":
                                return Some(la + ra)
                            if op == "-":
                                return Some(la - ra)
                            if op == "*":
                                return Some(la * ra)
                            if op == "/" and ra != 0:
                                return Some(la / ra)
                            if op == "%" and ra != 0:
                                return Some(la - (la / ra) * ra)
                            return None
                        case None:
                            return None
                case None:
                    return None
        case EUnaryOp(op, inner_box):
            Option[int] iv = eval_const_int_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

# Get and increment the module-level closure ID counter. Stored in
# `gmod.named_types` under the synthetic key `__closure_counter` so it
# tags along with the same Dict that holds named-type registrations.
int gmod_next_closure_id(GirModule &gmod):
    int cid = 0
    if gmod.named_types.contains("__closure_counter"):
        cid = gmod.named_types.get("__closure_counter").unwrap()
    gmod.named_types.put("__closure_counter", cid + 1)
    return cid

int infer_method_return_type(String method, int recv, LowerCtx &ctx, GirModule &gmod):
    # Void-returning methods. `Vector[T].remove(idx)` was previously
    # treated as void, but actually returns `Option[T]` — the void
    # classification left bindings in `T x = v.remove(i).unwrap()`
    # typed unit, cascading every `x.field` into
    # `EFieldAccess: unknown field on base type 'unit'`. Vector.remove
    # is now routed through the receiver-aware path (~line 752).
    # Dict/Set.remove stay here because the underlying runtime
    # (`gorget_map_remove` / `gorget_set_remove`) returns bool — the
    # surface API spec says `Option[V]` / bool but no caller in the
    # self-host codebase binds the result, so void is the safe gate.
    if method == "push" or method == "set" or method == "put":
        return UNIT_TYPE
    # `Vector[T].fill(n, val)` — preallocates capacity + memcpys n
    # copies of val into the buffer. Void return; runtime symbol
    # `gorget_array_fill`. Phase 1 cheap-win (`5e6b3bef`) introduced
    # the call site without wiring this entry, which left the call
    # typed as I64 → stage-1 cc errored "void value not ignored".
    if method == "fill":
        return UNIT_TYPE
    # `remove` is dispatched receiver-aware below for Vector/Deque,
    # but stays void for Dict/Set (their runtime returns bool — the
    # call sites in self-host all discard the result).
    if method == "remove":
        String recv_n = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_t = ctx.locals.get(recv).unwrap().type_id
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_t).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_t = inner
                    case GtMutPtr(inner):
                        recv_t = inner
                    else:
                        pass
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_t).unwrap()
                match gt:
                    case GtNamed(rname):
                        recv_n = rname
                    else:
                        pass
        # Phase A typed read: Dict/Set `.remove(k)` returns bool at the
        # runtime, but every self-host caller discards the result; so
        # we type the binding as void.
        match resource_meta_for(&gmod, recv_n):
            case Some(rmeta):
                match rmeta.collection_kind:
                    case CkDict():
                        return UNIT_TYPE
                    case CkSet():
                        return UNIT_TYPE
                    else:
                        pass
            case None:
                pass
        # Vector/Deque/etc. — fall through to receiver-aware path below.
    if method == "clear" or method == "insert" or method == "extend" or method == "reverse":
        return UNIT_TYPE
    if method == "sort" or method == "swap":
        return UNIT_TYPE
    # Int-returning methods
    if method == "len" or method == "capacity" or method == "find_index":
        return I64_TYPE
    if method == "find":
        return I64_TYPE
    # Bool-returning methods
    if method == "contains" or method == "is_empty" or method == "any" or method == "all":
        return BOOL_TYPE
    if method == "starts_with" or method == "ends_with":
        return BOOL_TYPE
    if method == "is_some" or method == "is_none" or method == "is_ok" or method == "is_error":
        return BOOL_TYPE
    if method == "is_alpha" or method == "is_digit" or method == "is_alphanumeric" or method == "is_whitespace" or method == "is_upper" or method == "is_lower" or method == "is_ascii" or method == "is_hex_digit":
        return BOOL_TYPE
    # String-returning methods — declared in STRING_BUILTIN_METHODS
    # (compiler/data/resources.gg) with `ret_kind == BrkString`. NOTE the
    # ordering contract: `reverse` is classified UNIT by the earlier arm
    # above (first-match wins) and is deliberately ABSENT from the table's
    # BrkString set, so consulting the table here cannot reclassify it.
    # The view column (`returns_view`) is INDEPENDENT — view-only methods
    # (str/as_str/trim_left/trim_right) carry BrkInfer and correctly fall
    # through to the receiver/I64 path, exactly as the old name list did.
    match string_builtin_method(method):
        case Some(sdecl):
            match sdecl.ret_kind:
                case BrkString():
                    return lookup_or_register_named(&gmod, "GorgetString")
                else:
                    pass
        case None:
            pass
    if method == "byte_at":
        return U8_TYPE
    # Collection-returning methods
    if method == "split" or method == "lines" or method == "chars" or method == "bytes":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "sorted" or method == "reversed" or method == "unique":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "enumerate" or method == "take" or method == "skip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "keys" or method == "values" or method == "items":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "chunks" or method == "zip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "filter_by" or method == "filter":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # HOFs that return collections (preserve receiver type heuristically).
    if method == "map" or method == "flat_map" or method == "flatten":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "concat":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # Float-returning methods
    if method == "sum" or method == "avg" or method == "min" or method == "max":
        return I64_TYPE  # could be float, but I64 is safe default
    if method == "abs" or method == "sqrt" or method == "ceil" or method == "floor":
        return F64_TYPE
    if method == "round":
        return F64_TYPE
    # Hash/count
    if method == "hash" or method == "count" or method == "index_of":
        return I64_TYPE
    # unwrap on Option__V receiver: return inner V.
    if method == "unwrap":
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            # option_ref_borrow Phase 3 (typed path): if the receiver Option is
            # a borrowing-getter result `Option[Ref[V]]`, unwrap yields the
            # typed `GtPtr(V)` payload recorded on the channel — `auto x =
            # coll.get(i).unwrap()` infers a pointer, not the name-derived V.
            int unwrap_ref_payload = option_ref_payload_of(&gmod, recv_tid)
            if unwrap_ref_payload >= 0:
                # option_ref_borrow Phase 6 (R1, refinement — site #2): gate on
                # the POINTEE so type-inference consumers (`auto x =
                # …unwrap()` via fallback) agree with the SSA that site #1
                # produces. Resource pointee → keep the `GtPtr` borrow;
                # primitive pointee → the deref'd VALUE pointee type. (The
                # plain-unwrap LOWERING doesn't read this — it returns the
                # local directly — so this is refinement, not the load-bearing
                # fix; keep it consistent anyway.)
                if unwrap_ref_payload >= 0 and unwrap_ref_payload < gmod.type_table.len():
                    GirType urp_gt = gmod.type_table.get(unwrap_ref_payload).unwrap()
                    match urp_gt:
                        case GtPtr(urp_inner):
                            if is_resource_type_name(type_id_to_name(urp_inner, &gmod), &gmod):
                                return unwrap_ref_payload
                            else:
                                return urp_inner
                        else:
                            pass
                return unwrap_ref_payload
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
            # Typed enum-category channel (value-payload Option/Result):
            # `.unwrap()` yields the Some_0 / Ok_0 payload recorded at the
            # mint site — no mangled-name re-parse. (`Option__Ref__` results
            # already returned above via `option_ref_payload`.) The name
            # arms below remain as a fallback for any path the channel
            # hasn't recorded yet.
            EnumCategory uec = enum_category_of(&gmod, recv_tid)
            if uec.category == ENUM_CAT_OPTION or uec.category == ENUM_CAT_RESULT:
                return uec.ok_type
        if recv_name.starts_with("Option__"):
            String inner = recv_name.slice(8, recv_name.len())
            int prim = prim_name_to_type(inner)
            if prim >= 0:
                return prim
            if inner == "int64_t":
                return I64_TYPE
            if inner == "double":
                return F64_TYPE
            if inner == "GorgetString" or inner == "Str":
                return lookup_or_register_named(&gmod, "GorgetString")
            # BRIDGE (option_ref_borrow Phase 5): an `Option__Ref__T` whose
            # payload escaped the typed `option_ref_payload` channel (the
            # channel lookup at the top of this arm catches the common case)
            # must still mint a real `GtPtr(T)`, NOT a `GtNamed("Ref__T")`.
            # `resolve_field_gir_type` strip-prefixes `Ref__`→GtPtr (the one
            # name-matching site; mirrors Rust methods.rs:612-615). Delete
            # once every getter is on the typed channel.
            if inner.starts_with("Ref__"):
                return resolve_field_gir_type(inner, &gmod)
            return lookup_or_register_named(&gmod, inner)
        if recv_name.starts_with("Result__"):
            String rest = recv_name.slice(8, recv_name.len())
            int split = rest.index_of("__").unwrap_or(-1)
            if split > 0:
                String ok = rest.slice(0, split)
                int prim_ok = prim_name_to_type(ok)
                if prim_ok >= 0:
                    return prim_ok
                if ok == "int64_t":
                    return I64_TYPE
                if ok == "double":
                    return F64_TYPE
                if ok == "GorgetString" or ok == "Str":
                    return lookup_or_register_named(&gmod, "GorgetString")
                return lookup_or_register_named(&gmod, ok)
        # Fallback: pass through receiver type for non-Option/Result
        # receivers — keeps legacy behaviour for already-typed values.
        if recv_name != "":
            if recv >= 0 and recv < ctx.locals.len():
                return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # get/pop/last/first/remove/safe_get on a collection: return Option[V].
    # option_ref_borrow Phase 3 (R1 — SPLIT, don't flip): the borrowing
    # getters (get/first/last/safe_get) return Option[Ref[V]] — a borrow into
    # the collection; the consuming getters (pop/remove) transfer ownership
    # OUT and keep the owned Option[V] (a wholesale flip would alias→double-
    # free them). This is the heuristic FALLBACK for getters the typechecker
    # didn't type as RTRef (first/last/safe_get have no infer arm); the
    # typed-path (.get()) already produced Option__Ref__T upstream so it never
    # reaches here. Kept for parity/robustness.
    if method == "get" or method == "first" or method == "last" or method == "safe_get" or method == "pop" or method == "remove":
        bool borrowing_getter = method == "get" or method == "first" or method == "last" or method == "safe_get"
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
        String elem = collection_element_type(recv_name)
        if elem == "":
            if recv_name.starts_with("Dict__GorgetString__"):
                elem = recv_name.slice(20, recv_name.len())
            elif recv_name.starts_with("Dict__int64_t__"):
                elem = recv_name.slice(15, recv_name.len())
            elif recv_name.starts_with("HashMap__GorgetString__"):
                elem = recv_name.slice(23, recv_name.len())
            elif recv_name.starts_with("HashMap__int64_t__"):
                elem = recv_name.slice(18, recv_name.len())
        if elem == "":
            return I64_TYPE
        String elem_norm = elem
        if elem == "Str":
            elem_norm = "GorgetString"
        if borrowing_getter:
            # Borrowing getter (heuristic fallback): result is Option[Ref[V]].
            # Mint the typed GtPtr(V) payload and record it on the
            # option_ref_payload channel so unwrap/match-destructure mint a
            # real pointer (same as the typed .get() path) — no Ref__ parsing
            # downstream.
            String ref_opt_name = "Option__Ref__" + elem_norm
            int ref_opt_tid = lookup_or_register_named(&gmod, ref_opt_name)
            int elem_gir = resolve_field_gir_type(elem_norm, &gmod)
            int ref_ptr_tid = register_ptr(&gmod, elem_gir)
            record_option_ref_payload(&gmod, ref_opt_tid, ref_ptr_tid)
            record_enum_category(&gmod, ref_opt_tid, ENUM_CAT_OPTION, ref_ptr_tid, -1)
            return ref_opt_tid
        String opt_name = "Option__" + elem_norm
        int opt_pop_tid = lookup_or_register_named(&gmod, opt_name)
        record_enum_category(&gmod, opt_pop_tid, ENUM_CAT_OPTION, resolve_field_gir_type(elem_norm, &gmod), -1)
        return opt_pop_tid
    # clone: return receiver type
    if method == "clone":
        if recv >= 0 and recv < ctx.locals.len():
            return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # Default to I64 for unknown methods
    return I64_TYPE

# Return type inference for builtin free-standing calls (args, read_file, etc.)
# Returns -1 if not a builtin.
int builtin_call_return_type(String fname, GirModule &gmod):
    if fname == "args":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if fname == "read_file" or fname == "read_line" or fname == "stdin" or fname == "env" or fname == "getenv":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "int_to_str" or fname == "float_to_str" or fname == "bool_to_str":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "chr":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "parse_int" or fname == "str_to_int":
        return I64_TYPE
    if fname == "parse_float" or fname == "str_to_float":
        return F64_TYPE
    if fname == "time_now" or fname == "monotonic_ns":
        return I64_TYPE
    return -1

# Extract element type from a collection name: Vector__int64_t → int64_t
String collection_element_type(String name):
    if name.starts_with("Vector__"):
        return name.slice(8, name.len())
    if name.starts_with("Deque__"):
        return name.slice(7, name.len())
    if name.starts_with("Set__"):
        return name.slice(5, name.len())
    if name.starts_with("HashSet__"):
        return name.slice(9, name.len())
    # For Option__T, extract T
    if name.starts_with("Option__"):
        return name.slice(8, name.len())
    # For Result__T, extract T (ok type)
    if name.starts_with("Result__"):
        return name.slice(8, name.len())
    return ""

# Return true when the init expression is a call to a known
# `cstr`-returning runtime/extern function. Used at SVarDecl to
# insert a `gorget_str_from_cstr` coercion before storing into a
# Str-typed slot, matching the Rust backend's
# `extern_cstr_return_vals` handling. Conservative allow-list
# covering the std.conv / std.fs / env extern surface —
# adding a new cstr-returning extern here is the same shape of
# change as the Rust-side `fn_return_abis` registration.
bool is_cstr_returning_call(SpannedExpr init_expr, GirModule &gmod):
    match init_expr.expr:
        case ECall(callee_box, _, _):
            match (*callee_box).expr:
                case EIdentifier(fname):
                    # Resolve through call_redirects so both the Gorget
                    # source name (`_parse_last_error`) and the C symbol
                    # (`gorget_parse_last_error`) match.
                    String resolved = fname
                    if gmod.call_redirects.contains(fname):
                        resolved = gmod.call_redirects.get(fname).unwrap()
                    # Current allow-list is narrow: only externs that
                    # return raw `const char*` via their C signature.
                    # `gorget_int_to_str` / `_float_to_str` / `_bool_to_str`
                    # / `_char_chr` all return `Str` (by-value struct), not
                    # cstr — do NOT include them here.
                    if resolved == "gorget_parse_last_error":
                        return true
                    return false
                else:
                    return false
        else:
            return false
    return false

# Check if a GIR local holds a string type.
bool is_string_local(int local_id, LowerCtx &ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return false
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return is_string_type_id(tid, &gmod)

bool is_string_type_id(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name == "GorgetString" or name == "String" or name == "Str"
        case GtPtr(inner):
            return is_string_type_id(inner, &gmod)
        case GtMutPtr(inner):
            return is_string_type_id(inner, &gmod)
        else:
            return false
    return false

# True only for a POINTER to a string (`GtPtr`/`GtMutPtr` whose inner is a
# string) — a BORROWED String, as `EFieldAccess` produces for a resource
# String field (lower.gg:~5520-5524). A value String (bare `GorgetString`,
# even under a `"String"`/`"Str"` alias id) returns false, so the
# print/f-string deref-before-format step never mis-derefs a value as a ptr.
bool is_ptr_to_string_type_id(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtPtr(inner):
            return is_string_type_id(inner, &gmod)
        case GtMutPtr(inner):
            return is_string_type_id(inner, &gmod)
        else:
            return false
    return false

bool is_resource_field_type(SpannedType stype, Dict[String, bool] resource_types):
    match stype.ty:
        case TPrimitive(name):
            match name:
                case "String":
                    return true
                else:
                    return false
        case TNamed(name, targs):
            match name:
                case "Vector" | "Dict" | "Set" | "Box" | "Rc" | "Arc":
                    return true
                case "Option" | "Result":
                    # Resource if any type argument is a resource
                    for ota in targs:
                        if is_resource_field_type(ota, resource_types):
                            return true
                    return false
                else:
                    if resource_types.contains(name):
                        return true
                    return false
        else:
            return false

# Register the mangled names of mono'd Option__X / Result__X__E instances
# whose payload is a resource into `resource_types`, recursing through
# nested Option/Result payloads. ONLY Option/Result: Vector/Dict/Set/Box
# are already classified by lir_lower's `build_resource_metadata`, and
# their mangled names (`Dict__GorgetString__GirTypeInfo`) have no C
# typedef — registering THOSE flips field emission to a non-existent type
# (832 cc errors). Option/Result instances DO emit a typedef, so keying
# `is_resource_type_name` on them is safe. See the call site in
# lower_module for why this gap exists (mono'd prelude generics aren't
# user `m.items` defs).
void register_optionlike_resource(SpannedType stype, Dict[String, bool] resource_types, Dict[String, bool] &optionlike):
    match stype.ty:
        case TNamed(name, targs):
            if name == "Option" or name == "Result":
                bool payload_resource = false
                for ta in targs:
                    if is_resource_field_type(ta, resource_types):
                        payload_resource = true
                if payload_resource:
                    optionlike.put(spanned_type_to_name(stype), true)
                # Nested Option[Option[Resource]] / Result[Option[..]] etc.
                for ta in targs:
                    register_optionlike_resource(ta, resource_types, &optionlike)
        else:
            pass

bool is_resource_type_name(String name, GirModule &gmod):
    # Delegate to `resource_meta_for` (lazy accessor over the
    # `build_resource_metadata` cascade in lir_lower.gg — the single
    # source of truth for the runtime-resource classification, covering
    # GorgetString / Array / Map / Set / Closure, parameterised Vector__/
    # Dict__/Set__/Box__, opaque handles Mutex__/Channel__/Shared__/
    # Weak__/AtomicInt__/Semaphore__/OnceFlag__/WaitGroup__/etc.).
    # Layering rule 3: one source of truth per axis.
    match resource_meta_for(&gmod, name):
        case Some(_):
            return true
        case None:
            pass
    # User struct/enum types registered as resource by lower_module's
    # type-registration pass (Phase D step 1 didn't extend
    # build_resource_metadata to cover user types, so this fallback
    # remains until that consolidation lands).
    if gmod.resource_types.contains(name):
        return true
    # Mono'd Option__X / Result__X__E whose payload owns a resource: a
    # by-value struct that must still be CLONED (not byte-copied) at a
    # consume position. Kept OUT of resource_types so C emission keeps the
    # by-value ABI; see GirModule.optionlike_resource_types.
    if gmod.optionlike_resource_types.contains(name):
        return true
    return false

# ── Binary operator mapping ──────────────────────────────

int map_binop(String op):
    match op:
        case "+":
            return OP_ADD
        case "-":
            return OP_SUB
        case "*":
            return OP_MUL
        case "/":
            return OP_DIV
        case "%":
            return OP_REM
        case "+%":
            return OP_ADD_WRAP
        case "-%":
            return OP_SUB_WRAP
        case "*%":
            return OP_MUL_WRAP
        case "&":
            return OP_BITAND
        case "|":
            return OP_BITOR
        case "^":
            return OP_BITXOR
        case "<<":
            return OP_SHL
        case ">>":
            return OP_SHR
        else:
            # HARD BUG: returning OP_ADD for an unrecognised operator
            # silently mis-compiles it as addition. Emit a diagnostic
            # so the mis-compile is visible.
            diag_bug("map_binop", "unknown operator '" + op + "' — defaulting to OP_ADD (WRONG)")
            return OP_ADD

# Map the compound-assignment operator spelling (`+=`, `-=`, `*=`, `/=`,
# `%=`) to the matching GIR binop. Stage-1 was compiling every `last_us
# -= 1` as `last_us += 1` because the parser stored the full compound-op
# spelling ("-=") in SCompoundAssign's op field, but `map_binop` only
# recognised the arithmetic spelling ("-") and fell through to the
# OP_ADD default for any compound form — producing infinite loops in
# lower_type_defs's field-name scanner.
int map_compound_binop(String op):
    match op:
        case "+=":
            return OP_ADD
        case "-=":
            return OP_SUB
        case "*=":
            return OP_MUL
        case "/=":
            return OP_DIV
        case "%=":
            return OP_REM
        case "+%=":
            return OP_ADD_WRAP
        case "-%=":
            return OP_SUB_WRAP
        case "*%=":
            return OP_MUL_WRAP
        case "&=":
            return OP_BITAND
        case "|=":
            return OP_BITOR
        case "^=":
            return OP_BITXOR
        case "<<=":
            return OP_SHL
        case ">>=":
            return OP_SHR
        else:
            # Defensive: the parser should always emit the compound
            # spelling for SCompoundAssign. Falling back to the bare-op
            # mapping mostly works but emits a diagnostic — an unmapped
            # compound op here is almost certainly a parser/lowerer
            # mismatch worth noticing.
            diag_warn("map_compound_binop", "unknown compound operator '" + op + "' — routing through map_binop")
            return map_binop(op)

# Emit a compound-assign arithmetic step (`x = x <op> y`). For `+=` with a
# String operand, route to `gorget_str_cat(lhs, rhs)` (allocates a new
# String, reads both operands → both borrow) — same form as the EBinaryOp
# `+` String-concat path (lower.gg:~4781-4789). Without this, String `+=`
# becomes a raw C `+` on `Str` and the emitted program fails to compile.
# Every other op (and `+=` on non-String operands) is byte-identical to the
# original `GIBinOp(dst, map_compound_binop(op), result_ty, …)` call.
void emit_compound_arith(LowerCtx &ctx, String op, int dst, int lhs_val, int rhs_val, int result_ty, GirModule &gmod):
    if op == "+=" and (is_string_local(lhs_val, &ctx, &gmod) or is_string_local(rhs_val, &ctx, &gmod)):
        Vector[Operand] cat_args = []
        cat_args.push(op_consume(&ctx, &gmod, lhs_val, CkCallArgBorrow()))
        cat_args.push(op_consume(&ctx, &gmod, rhs_val, CkCallArgBorrow()))
        emit(&ctx, GICallExtern(dst, "gorget_str_cat", cat_args))
    else:
        emit(&ctx, GIBinOp(dst, map_compound_binop(op), result_ty, op_consume(&ctx, &gmod, lhs_val, CkBinOpArg()), op_consume(&ctx, &gmod, rhs_val, CkBinOpArg())))

bool is_comparison(String op):
    match op:
        case "==" | "!=" | "<" | "<=" | ">" | ">=":
            return true
        else:
            return false

int map_cmpop(String op):
    match op:
        case "==":
            return CMP_EQ
        case "!=":
            return CMP_NE
        case "<":
            return CMP_LT
        case "<=":
            return CMP_LE
        case ">":
            return CMP_GT
        case ">=":
            return CMP_GE
        else:
            return CMP_EQ

# ── Block-as-expression / tail-value lowering ───────────
#
# These three helpers implement the block-as-value path that any
# `if`/`elif`/`else` (or, in follow-up rounds, `match` / `do:` block)
# used in expression position needs. Mirrors Rust gg's
# `lower_block_expr` (`src/ir/lowering/exprs/mod.rs:3203`),
# `lower_stmt_as_tail_value` (`:3236`), and `build_if_chain_expr`
# (`:3414`).

# Return true iff the current block already has a real terminator
# (return / break / jump / branch). Used to suppress the
# assign-result + jump-to-merge when a branch body already diverged
# (e.g. ended in `return`). Mirrors Rust's `!builder.is_terminated()`.
bool block_terminated(LowerCtx &ctx):
    Terminator cur = ctx.block_terms.get(ctx.current_block).unwrap()
    match cur:
        case GTNone():
            return false
        else:
            return true

# Lower a block of statements as an EXPRESSION, returning the local id
# of its tail value. Mirrors Rust `lower_block_expr` (`:3203`):
#   • empty block → a fresh Unit local (Rust returns Constant::Unit;
#     the `is_empty()` guard avoids a `len()-1` underflow);
#   • otherwise lower all-but-last as statements, then the LAST stmt as
#     a tail value via `lower_stmt_as_tail_value`. A -1 (no tail value —
#     the SMatch/else deferral) becomes a Unit local so the caller still
#     has a valid local to read.
int lower_block_expr(LowerCtx &ctx, Vector[Stmt] block_stmts, GirModule &gmod):
    if block_stmts.len() == 0:
        int unit_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
        emit(&ctx, GIAssign(unit_dst, OpConstUnit()))
        return unit_dst
    int last_idx = block_stmts.len() - 1
    int si = 0
    while si < last_idx:
        lower_stmt(&ctx, block_stmts.get(si).unwrap(), &gmod, false)
        si = si + 1
    int tail = lower_stmt_as_tail_value(&ctx, block_stmts.get(last_idx).unwrap(), &gmod)
    if tail < 0:
        int unit_dst2 = add_local(&ctx, UNIT_TYPE, NO_NAME)
        emit(&ctx, GIAssign(unit_dst2, OpConstUnit()))
        return unit_dst2
    return tail

# Lower the LAST statement of a block as a tail value. Mirrors Rust
# `lower_stmt_as_tail_value` (`:3236`): recognises the tail-value
# shapes and returns the producing local; for any other statement form
# lowers it as a regular statement and returns -1 ("no tail value").
#
# This round handles `SExpr` (bare trailing expression), `SIf`
# (if-chain used as a value, sharing `lower_if_chain_expr` with the
# EIf-in-`lower_expr` case), and `SMatch` (match used as a value,
# sharing `lower_match_expr` with the EMatch-in-`lower_expr` case —
# mirrors Rust `lower_stmt_as_tail_value` `exprs/mod.rs:3246-3248`).
int lower_stmt_as_tail_value(LowerCtx &ctx, Stmt last_stmt, GirModule &gmod):
    match last_stmt:
        case SExpr(e):
            return lower_expr(&ctx, e, &gmod)
        case SIf(cond_expr, then_body, elif_branches):
            return lower_if_chain_expr(&ctx, cond_expr, then_body, elif_branches, &gmod)
        case SMatch(scrutinee, arms):
            return lower_match_expr(&ctx, scrutinee, arms, &gmod)
        else:
            lower_stmt(&ctx, last_stmt, &gmod, false)
            return -1

# Lower an `if`/`elif`/`else` chain in EXPRESSION position, producing a
# single `result` local that every reaching branch assigns. Mirrors Rust
# `build_if_chain_expr` (`src/ir/lowering/exprs/mod.rs:3414-3500`).
#
# Shape: the self-host AST folds elif + else into one `Vector[ElseBranch]`
# (`ElseBranch.condition` = Some(cond) → elif, None → explicit else).
# We materialise `result` up front (so the merge sees a single def — SSA
# inserts the phi), lower cond → GTBranch(then, else), then in the then
# block lift `then_body` via `lower_block_expr`, assign it into `result`
# via `op_consume(CkAssign)` (clone-or-move per ownership — resource
# branches need the clone), and jump to merge. Each elif spins a fresh
# branch (cond → elif_then / next_else); the explicit else lifts its
# block + assigns. If NO explicit-else (None-condition) branch exists,
# the terminal else block assigns the typed default (`OpConstI64(0)`,
# mirroring Rust `:3494`) so `result` is assigned on EVERY path to merge.
# Every assign+jump is guarded on `not block_terminated` — a branch that
# ended in `return`/`break` must not also jump to merge.
#
# Result-type refinement: start from `ctx.expected_type` (set by the
# enclosing SVarDecl/SAssign/SReturn writer) when valid; otherwise refine
# from the FIRST non-Unit branch value's type (mirrors Rust's
# `infer_operand_type_full` + the `result_type_refined` latch).
int lower_if_chain_expr(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] then_body, Vector[ElseBranch] else_branches, GirModule &gmod):
    # The condition is bool-typed, NOT the if-expression's result type —
    # clear the enclosing `expected_type` (the if-RESULT's) around the cond so
    # the centralized auto-prop hook's capture-form check doesn't suppress a
    # throws-call condition's peel; restore it before the result_type seeding.
    int saved_expected_ifc = ctx.expected_type
    ctx.expected_type = -1
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    ctx.expected_type = saved_expected_ifc
    # Auto-propagate a `throws` call used as the if-expression condition.
    cond = maybe_auto_propagate(&ctx, cond, &gmod)
    # Seed result type from expected_type when the writer set a concrete
    # one; else I64 (refined below from the first non-Unit branch).
    int result_type_init = I64_TYPE
    bool result_type_refined = false
    if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
        result_type_init = ctx.expected_type
        result_type_refined = true
    int result = add_local(&ctx, result_type_init, NO_NAME)
    int merge_bb = new_block(&ctx)
    int then_bb = new_block(&ctx)
    int else_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
    # Then branch.
    switch_to(&ctx, then_bb)
    int then_val = lower_block_expr(&ctx, then_body, &gmod)
    if not block_terminated(&ctx):
        if not result_type_refined:
            int tty = ctx.locals.get(then_val).unwrap().type_id
            if tty != UNIT_TYPE:
                refine_local_type(&ctx, result, tty)
                result_type_refined = true
        emit(&ctx, GIAssign(result, op_consume(&ctx, &gmod, then_val, CkAssign())))
        set_terminator(&ctx, GTJump(merge_bb))
    # Elif chain + explicit else, walking the folded ElseBranch vector.
    int current_else_bb = else_bb
    bool saw_else = false
    int ebi = 0
    while ebi < else_branches.len():
        ElseBranch eb = else_branches.get(ebi).unwrap()
        match eb.condition:
            case Some(elif_cond):
                switch_to(&ctx, current_else_bb)
                int elif_cond_val = lower_expr(&ctx, elif_cond, &gmod)
                int elif_then_bb = new_block(&ctx)
                int next_else_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(elif_cond_val), elif_then_bb, next_else_bb))
                switch_to(&ctx, elif_then_bb)
                int elif_val = lower_block_expr(&ctx, eb.body, &gmod)
                if not block_terminated(&ctx):
                    if not result_type_refined:
                        int ety = ctx.locals.get(elif_val).unwrap().type_id
                        if ety != UNIT_TYPE:
                            refine_local_type(&ctx, result, ety)
                            result_type_refined = true
                    emit(&ctx, GIAssign(result, op_consume(&ctx, &gmod, elif_val, CkAssign())))
                    set_terminator(&ctx, GTJump(merge_bb))
                current_else_bb = next_else_bb
            case None:
                # Explicit else — terminal branch.
                saw_else = true
                switch_to(&ctx, current_else_bb)
                int else_val = lower_block_expr(&ctx, eb.body, &gmod)
                if not block_terminated(&ctx):
                    if not result_type_refined:
                        int sty = ctx.locals.get(else_val).unwrap().type_id
                        if sty != UNIT_TYPE:
                            refine_local_type(&ctx, result, sty)
                            result_type_refined = true
                    emit(&ctx, GIAssign(result, op_consume(&ctx, &gmod, else_val, CkAssign())))
                    set_terminator(&ctx, GTJump(merge_bb))
        ebi = ebi + 1
    # No explicit else → the all-conditions-false path lands in the
    # terminal else block with `result` unassigned. Assign the typed
    # default (I64(0), mirroring Rust `:3494`) so EVERY path to merge
    # writes `result`.
    if not saw_else:
        switch_to(&ctx, current_else_bb)
        if not block_terminated(&ctx):
            emit(&ctx, GIAssign(result, OpConstI64(0)))
            set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)
    return result

# Overwrite a local's recorded type_id in place (used by the if-chain
# result-type refinement: the result slot is allocated with a seed type,
# then narrowed to the first non-Unit branch value's type). Mirrors Rust's
# `builder.locals[result_id.0].type_id = ty` — in-place field mutation.
void refine_local_type(LowerCtx &ctx, int lid, int new_type):
    ctx.locals.get(lid).unwrap().type_id = new_type

# ── Expression lowering ─────────────────────────────────

# Centralized producer-side Result→T auto-propagation hook (mirrors Rust
# gg's `lower_expr` wrapper, `src/ir/lowering/exprs/mod.rs:73-86`, landed at
# `90d09414`). When the expression is a `Call` or `MethodCall` — the only
# expression shapes that PRODUCE a `throws`-fn's `Result[T,E]` via the
# throws-sugar — apply `maybe_auto_propagate` at the tail: in a propagating
# context (enclosing fn is `throws` / returns `Result`) and where the
# surrounding destination doesn't itself want a `Result`, peel `Result→T`
# (forwarding the `Error` branch to the function's Result return slot).
#
# This subsumes the former CONSUMER-targeted design (N explicit call sites)
# with ONE producer-side decision, mirroring the now-canonical Rust shape —
# and closes the same per-position gaps Rust closed: binop operands, method
# args, aggregate-literal elements, if-expr / match-expr arm tails, and
# inline match scrutinees whose arms discriminate USER variants (snag48).
# The decision is purely typed (operand IR type + enclosing-fn return type),
# no name-matching beyond the `Result__` mangled-name prefix already used by
# `maybe_auto_propagate`.
#
# Sites that need the RAW `Result` even at a Call/MethodCall position set
# `ctx.suppress_auto_prop = true` before calling `lower_expr`: match
# scrutinees whose arms match `Ok`/`Error`/`Some`/`None` (so the user can
# discriminate the Result), `catch` inner, and `rethrow` inner (which
# extract the Ok/Error payloads themselves). The flag is a ONE-SHOT —
# consumed (reset to false) at entry — so nested sub-expressions still
# auto-prop normally.
int lower_expr(LowerCtx &ctx, SpannedExpr sexpr, GirModule &gmod):
    # Consume the one-shot suppress flag for THIS expression.
    bool suppress = ctx.suppress_auto_prop
    ctx.suppress_auto_prop = false
    # Only Call / MethodCall produce a throws-Result via the throws sugar.
    bool is_producer = false
    match sexpr.expr:
        case ECall(_, _, _):
            is_producer = true
        case EMethodCall(_, _, _, _):
            is_producer = true
        else:
            pass
    int v = lower_expr_inner(&ctx, sexpr, &gmod)
    if suppress or not is_producer:
        return v
    return maybe_auto_propagate(&ctx, v, &gmod)

int lower_expr_inner(LowerCtx &ctx, SpannedExpr sexpr, GirModule &gmod):
    match sexpr.expr:
        case EIntLiteral(v):
            int dst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstI64(v)))
            return dst
        case EFloatLiteral(v):
            int dst = add_local(&ctx, F64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstF64(v)))
            return dst
        case EBoolLiteral(v):
            int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstBool(v)))
            return dst
        case EStringLiteral(s, _):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstStr(s)))
            return dst
        case EFString(s, fexprs):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            if fexprs.len() == 0:
                # No interpolation — just a string literal
                int dst = add_local(&ctx, gs_tid, NO_NAME)
                emit(&ctx, GIAssign(dst, OpConstStr(s)))
                return dst
            # Walk template, replacing each "{}" placeholder with the printf
            # specifier for the corresponding fexprs[i]'s type, and build the
            # arg list in parallel. Emit `gorget_string_format(fmt, ...args)`
            # which returns a fresh, null-terminated GorgetString. Mirrors
            # Rust gg's `lower_string_interpolation` at
            # `src/ir/lowering/exprs/mod.rs:3505`.
            #
            # Without this fix, EFString emitted only the raw template
            # (with literal `{}` placeholders), so `print(f"{x}")` printed
            # "{}" — the dominant OutputMismatch cluster in self_host_e2e
            # (46 fixtures at baseline 94/995). [filed: 2026-05-19]
            Vector[Operand] gsf_args = []
            gsf_args.push(OpConstStr(""))  # placeholder for fmt at index 0; overwritten below
            String fmt = ""
            int fi = 0
            int byte_i = 0
            int byte_n = s.byte_len()
            while byte_i < byte_n:
                # `{}` placeholder bytes are 0x7B 0x7D.
                bool is_placeholder = false
                if byte_i + 1 < byte_n:
                    if s.byte_at(byte_i) == 0x7B and s.byte_at(byte_i + 1) == 0x7D:
                        is_placeholder = true
                if is_placeholder:
                    if fi >= fexprs.len():
                        # Mismatched placeholder count — emit literal `{}`
                        fmt = fmt + "{}"
                    else:
                        SpannedExpr farg = fexprs.get(fi).unwrap()
                        int aloc = lower_expr(&ctx, farg, &gmod)
                        int aty = I64_TYPE
                        if aloc >= 0 and aloc < ctx.locals.len():
                            aty = ctx.locals.get(aloc).unwrap().type_id
                        # Borrowed string (`Ptr(GorgetString)` from a struct
                        # String-field read / match-payload binding) — deref to
                        # a NON-OWNING value GorgetString so the `%s` branch
                        # below fires (the `aty == gs_tid` check misses the Ptr,
                        # else the f-string prints the pointer via `%lld`).
                        if is_ptr_to_string_type_id(aty, &gmod):
                            int saloc = add_local_with(&ctx, gs_tid, NO_NAME, LoBorrowed(), BoNone())
                            emit(&ctx, GIDeref(saloc, aloc, gs_tid))
                            aloc = saloc
                            aty = gs_tid
                        if aty == F64_TYPE or aty == F32_TYPE:
                            fmt = fmt + "%f"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc, CkFormatArg()))
                        elif aty == gs_tid:
                            # String → %.*s with (int)len,data (the printf-style
                            # emitter for gorget_string_format decomposes a
                            # GorgetString value arg into `(int)len, data`).
                            # %.*s bounds the read to len bytes — required for
                            # non-NUL-terminated cap=0 views (trim/strip/slice).
                            fmt = fmt + "%.*s"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc, CkFormatArg()))
                        elif aty == BOOL_TYPE:
                            # Bool → "true"/"false" via gorget_bool_to_str.
                            int bstr = add_local(&ctx, gs_tid, NO_NAME)
                            Vector[Operand] bargs = [OpCopy(aloc)]
                            emit(&ctx, GICallExtern(bstr, "gorget_bool_to_str", bargs))
                            # FRESH-OWNED-TEMP drop registration (#7-style):
                            # gorget_bool_to_str allocates a fresh `GorgetString`
                            # (LoOwned) that is only BORROWED by the surrounding
                            # gorget_string_format below (CkFormatArg → OpBorrow),
                            # so it is orphaned and leaks. Register at creation so
                            # the scope-exit GIDropIfAlive frees it once. Borrow-
                            # only consume ⇒ never moved ⇒ no double-free.
                            register_local_for_drop(&ctx, bstr, gs_tid, &gmod)
                            fmt = fmt + "%.*s"
                            gsf_args.push(op_consume(&ctx, &gmod, bstr, CkFormatArg()))
                        else:
                            # Default: int64_t printf via %lld. Narrow ints
                            # are auto-promoted by C's variadic ABI to
                            # `int` (4 bytes) — but vsnprintf with `%lld`
                            # reads 8 bytes. Acceptable for I64; narrow
                            # ints may render incorrectly until a typed
                            # specifier table is added.
                            fmt = fmt + "%lld"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc, CkFormatArg()))
                        fi += 1
                    byte_i += 2
                else:
                    # Copy literal byte
                    fmt = fmt + s.slice(byte_i, byte_i + 1)
                    byte_i += 1
            # Overwrite fmt placeholder at position 0 with the built format string.
            gsf_args.set(0, OpConstStr(fmt))
            int gsdst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GICallExtern(gsdst, "gorget_string_format", gsf_args))
            # FRESH-OWNED-TEMP drop registration (#7-style): gorget_string_format
            # allocates a fresh `GorgetString` (LoOwned). When this f-string
            # EXPRESSION flows into a print/format arg it is BORROWED only
            # (CkFormatArg → is_consume_kind=false → OpBorrow), so the assembled
            # buffer is orphaned and leaks (O(1) end-of-program residue per
            # f-string). Registering at creation makes the scope-exit
            # GIDropIfAlive free it exactly once. SAFE-BY-CONSTRUCTION: when the
            # result is instead MOVED into a binding (`String s = f"…"`) or
            # RETURNED, op_consume/wire-liveness emits OpMove → GIMoveZero →
            # drop_elab marks the slot uninitialized and statically deletes the
            # guard, so no double-free. GorgetString is a runtime resource
            # (LoOwned, droppable) → register_local_for_drop's
            # LoView/LoBorrowed/non-droppable gates pass it through.
            register_local_for_drop(&ctx, gsdst, gs_tid, &gmod)
            return gsdst
        case EIdentifier(name):
            if nl_contains(&ctx, name):
                int eid_lid = nl_get(&ctx, name)
                # `&`/`!`-param value READ. A `GtMutPtr(inner)`-typed slot
                # holds a `T*`; a bare read returns the POINTER bits, so a
                # later `x + 10` does arithmetic on the pointer instead of
                # `*ptr`. Deref-load the pointee into a fresh value temp and
                # return THAT — mirrors Rust gg's Deref projection into a
                # `pointee_type` temp (src/ir/lowering/exprs/mod.rs:140-164).
                #
                # Gate ONLY on NON-resource inner: resource slots ARE pointer-
                # valued by ABI and their consumers already deref, so a deref
                # here would double-deref the working `&String` read path. This
                # is the exact precedent shipped at lower.gg (the
                # Option[Ref[T]] getter): resource inner → return the local
                # unchanged; primitive inner → GIDeref into a value temp.
                int eid_tid = ctx.locals.get(eid_lid).unwrap().type_id
                if eid_tid >= PRIM_COUNT and eid_tid < gmod.type_table.len():
                    match gmod.type_table.get(eid_tid).unwrap():
                        case GtMutPtr(eid_inner):
                            if not is_resource_type_name(type_id_to_name(eid_inner, &gmod), &gmod):
                                int eid_value_local = add_local(&ctx, eid_inner, NO_NAME)
                                emit(&ctx, GIDeref(eid_value_local, eid_lid, eid_inner))
                                return eid_value_local
                        else:
                            pass
                return eid_lid
            # Module-level `const int` — inline the evaluated value.
            # Without this, the self-compiled parser's KW_* / PREC_*
            # constants all become 0 and check_kw(0, 0) hangs.
            if gmod.const_decls.contains(name):
                int cv = gmod.const_decls.get(name).unwrap()
                int cdst = add_local(&ctx, I64_TYPE, NO_NAME)
                emit(&ctx, GIAssign(cdst, OpConstI64(cv)))
                return cdst
            # Module-level float constants — `float EPSILON = 0.000001`
            # in lib/xtd/math3d.gg etc. Mirrors Rust's unified
            # `module_constants` table where float consts inline as
            # `Operand::Constant(Constant::F64(value))` rather than
            # falling through to the unknown-identifier `[bug]`. The
            # check / emission lives in a helper to avoid growing
            # `lower_expr`'s stack frame — that frame is already
            # ~148 KB (see assembly), and recursion through deeply
            # nested expressions hits ~50 levels on `driver.gg`,
            # putting us right at the 8 MB stack limit. Adding even
            # a couple of locals to `lower_expr` overflows.
            int fdst_or_neg = lower_float_const_ident(&ctx, &gmod, name)
            if fdst_or_neg >= 0:
                return fdst_or_neg
            # Function-as-value: `filter(is_even)` / `.map(double)` etc.
            # — bare fn name passed where a Callable is expected. Helper
            # lives in its own function to keep `lower_expr`'s already-
            # massive stack frame from growing.
            int adst_or_neg = lower_fn_addr_ident(&ctx, &gmod, name)
            if adst_or_neg >= 0:
                return adst_or_neg
            # Module-level static with runtime-call init — `stdout` /
            # `stderr` / `stdin` from lib/std/io.gg etc. Mirrors Rust
            # gg's `Operand::Constant(Constant::GlobalRef(name))`
            # (`src/ir/lowering/exprs/mod.rs:128-130`). Helper emits a
            # `__global_ref__<name>` synthetic GICallExtern that
            # `lir_lower` rewrites to `IGlobalAddr`. Same out-of-line
            # rationale as the float-const / fn-addr helpers above.
            int sdst_or_neg = lower_static_ref_ident(&ctx, &gmod, name)
            if sdst_or_neg >= 0:
                return sdst_or_neg
            # Meta-op token (`meta +`, `meta /`, …) encoded as
            # `EIdentifier("__metaop__add")` etc. — compile-time only;
            # never has a runtime value. Mirrors Rust gg's
            # `MetaOpToken` filtering at call-arg lowering
            # (`src/ir/lowering/exprs/calls.rs:882`). Helper is
            # out-of-line for stack-frame reasons.
            int mdst_or_neg = lower_metaop_ident(&ctx, name)
            if mdst_or_neg >= 0:
                return mdst_or_neg
            # Module-level `Option[T] X = None` (e.g. NO_NAME) — emit a
            # properly-TYPED `None`: a local typed as the const's concrete
            # Option struct, filled by the prelude-variant `None` ctor. That
            # routes through lir_lower's `try_lower_prelude_variant` →
            # `IEnumInit(slot, struct_id, tag=1, [])`, giving a full-size
            # (e.g. 40-byte Option__GorgetString) value. The former
            # `OpConstUnit()` produced an 8-byte I32-0 slot, which add_local's
            # drop-emission clone over-read as a 40-byte Option (tag 0 == Some
            # → bogus Str payload → stack-buffer-overflow). Mirrors Rust gg's
            # `__lir_g1 = {0}` NO_NAME global: what matters is the 40-byte
            # SIZE, not the tag (cloning an empty/None Option copies nothing).
            if gmod.none_decls.contains(name):
                int opt_tid = gmod.none_decls.get(name).unwrap()
                int ndst = add_local(&ctx, opt_tid, NO_NAME)
                Vector[Operand] none_args = []
                emit(&ctx, GICallExtern(ndst, "None", none_args))
                return ndst
            # Bare nullary enum-variant used as a value (see
            # lower_nullary_variant_ident). Runs after all the resolution
            # categories above and immediately before the [bug] fallback —
            # a variant name can't legitimately collide with any of them.
            # Cures the `push(IDropGuardClose)` 208-vs-8-byte overflow.
            int evdst_or_neg = lower_nullary_variant_ident(&ctx, &gmod, name)
            if evdst_or_neg >= 0:
                return evdst_or_neg
            # HARD BUG: silently returning `OpConstI64(0)` for an unknown
            # identifier lies about both value and type — every downstream
            # use thinks it's holding an int64 with value 0. Stage-1 has
            # been running with `gmod`, `self`, and similar getting this
            # fallback and cascading into PConstructor failures. Emit a
            # diagnostic so each miss is visible.
            diag_bug("EIdentifier", "in fn '" + ctx.current_fn_name + "': unknown identifier '" + name + "' — returning OpConstI64(0) placeholder (WRONG)")
            int unk = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(unk, OpConstI64(0)))
            return unk
        case EBinaryOp(lhs_box, op, rhs_box):
            # Short-circuit `and` / `or` — `a and b` is NOT `a + b`. Lower
            # to a branch-and-merge so the rhs isn't evaluated when the
            # lhs already determines the result. Previously fell through
            # to map_binop("and") = OP_ADD, and both sides always ran —
            # crashed in the self-host lexer on guards like
            # `self.lex_pos < byte_len and self.lex_peek() == b'\n'`
            # when lex_pos was at/past end.
            if op == "and" or op == "or":
                int lhs_sc = lower_expr(&ctx, *lhs_box, &gmod)
                int result_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
                # Initialize result to short-circuit constant so the
                # early-exit path lands on the right value.
                if op == "and":
                    emit(&ctx, GIAssign(result_local, OpConstBool(false)))
                else:
                    emit(&ctx, GIAssign(result_local, OpConstBool(true)))
                int rhs_bb = new_block(&ctx)
                int merge_bb = new_block(&ctx)
                # `and`: if lhs: jump to rhs else merge. `or`: opposite.
                if op == "and":
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), rhs_bb, merge_bb))
                else:
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), merge_bb, rhs_bb))
                switch_to(&ctx, rhs_bb)
                int rhs_sc = lower_expr(&ctx, *rhs_box, &gmod)
                emit(&ctx, GIAssign(result_local, OpCopy(rhs_sc)))
                set_terminator(&ctx, GTJump(merge_bb))
                switch_to(&ctx, merge_bb)
                return result_local
            # `x in collection` membership operator → `collection.contains(x)`.
            # Lower as a Type__contains call on the rhs (the collection)
            # rather than letting it fall through to `map_binop("in")`
            # which would silently mis-compile as `x + collection`.
            # Handles Vector / Set / Dict / String — all expose `contains`
            # in the runtime via collection_runtime_name → gorget_*_contains.
            if op == "in":
                int in_lhs = lower_expr(&ctx, *lhs_box, &gmod)
                int in_rhs = lower_expr(&ctx, *rhs_box, &gmod)
                String coll_tname = local_type_name(in_rhs, &ctx, &gmod)
                String contains_method = coll_tname + "__contains"
                # `x in coll` → coll.contains(x): collection is the receiver
                # (OpMove first arg), x is just read by contains — borrow.
                Vector[Operand] in_args = [OpMove(in_rhs), op_consume(&ctx, &gmod, in_lhs, CkCallArgBorrow())]
                int in_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICallExtern(in_dst, contains_method, in_args))
                return in_dst
            # A binop's OPERANDS are scalar/string-typed by the operator, not
            # by the binop's destination. Clear the enclosing `expected_type`
            # so a Result-typed surrounding context (e.g. `return to_n(x) + 5`
            # from a `throws` fn, where SReturn set expected_type to the
            # function's `Result[T,E]` slot) doesn't make the centralized
            # auto-prop hook's capture-form check SUPPRESS the peel on a
            # throws-call operand — leaving a `Result + int` mismatch at C.
            # Mirrors Rust gg's `operators.rs:46-60`.
            int prev_expected_binop = ctx.expected_type
            ctx.expected_type = -1
            int lhs = lower_expr(&ctx, *lhs_box, &gmod)
            int rhs = lower_expr(&ctx, *rhs_box, &gmod)
            ctx.expected_type = prev_expected_binop
            if is_comparison(op):
                # Comparable operator overload: `a < b` etc. on user types →
                # TypeName__compare(&a, b) OP 0.
                String lhs_cmp_name = local_type_name(lhs, &ctx, &gmod)
                if gmod.type_infos.contains(lhs_cmp_name) and (op == "<" or op == "<=" or op == ">" or op == ">="):
                    String cmp_method = lhs_cmp_name + "__compare"
                    if gmod.fn_sigs.contains(cmp_method):
                        # `a < b` → Type__compare(a, b): comparison reads only.
                        Vector[Operand] cmp_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs, CkCallArgBorrow())]
                        int cmp_val = add_local(&ctx, I64_TYPE, NO_NAME)
                        emit(&ctx, GICallExtern(cmp_val, cmp_method, cmp_args))
                        int zero = add_local(&ctx, I64_TYPE, NO_NAME)
                        emit(&ctx, GIAssign(zero, OpConstI64(0)))
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICmp(cmp_dst, map_cmpop(op), I64_TYPE, OpCopy(cmp_val), OpCopy(zero)))
                        return cmp_dst
                # Equatable operator overload for ==/!=: `a == b` → a.eq(b) / !a.eq(b).
                if (op == "==" or op == "!=") and gmod.type_infos.contains(lhs_cmp_name):
                    String eq_method = lhs_cmp_name + "__eq"
                    if gmod.fn_sigs.contains(eq_method):
                        # `a == b` → Type__eq(a, b): equality reads only.
                        Vector[Operand] eq_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs, CkCallArgBorrow())]
                        int eq_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICallExtern(eq_dst, eq_method, eq_args))
                        if op == "==":
                            return eq_dst
                        int neq_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GIUnOp(neq_dst, UNOP_NOT, BOOL_TYPE, OpCopy(eq_dst)))
                        return neq_dst
                # String ==/!=: content equality via gorget_str_eq(Str, Str).
                # Mirrors Rust src/ir/lowering/exprs/operators.rs:87-95. Without
                # this, String ==/!= falls to the GICmp(I64_TYPE) below — a raw
                # pointer/int compare that breaks for two distinct String
                # instances (and for GtPtr(String) operands from .get().unwrap()).
                # is_string_local unwraps GtPtr/GtMutPtr, so a Ref[String]
                # operand is detected; gorget_str_eq takes operands by pointer
                # and compares CONTENT, so borrow operands are correct whether
                # the operand is a value String or a GtPtr(String).
                if (op == "==" or op == "!=") and (is_string_local(lhs, &ctx, &gmod) or is_string_local(rhs, &ctx, &gmod)):
                    int eqd = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    Vector[Operand] str_eq_args = [op_consume(&ctx, &gmod, lhs, CkCallArgBorrow()), op_consume(&ctx, &gmod, rhs, CkCallArgBorrow())]
                    emit(&ctx, GICallExtern(eqd, "gorget_str_eq", str_eq_args))
                    if op == "==":
                        return eqd
                    int nd = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    emit(&ctx, GIUnOp(nd, UNOP_NOT, BOOL_TYPE, OpCopy(eqd)))
                    return nd
                int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICmp(dst, map_cmpop(op), I64_TYPE, op_consume(&ctx, &gmod, lhs, CkBinOpArg()), op_consume(&ctx, &gmod, rhs, CkBinOpArg())))
                return dst
            # String concatenation: + on string operands → gorget_str_cat(Str, Str)
            if op == "+" and (is_string_local(lhs, &ctx, &gmod) or is_string_local(rhs, &ctx, &gmod)):
                int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
                int dst = add_local(&ctx, gs_tid, NO_NAME)
                Vector[Operand] concat_args = []
                # `a + b` (string) → gorget_str_cat(a, b): allocates new
                # String, reads both operands — borrow.
                concat_args.push(op_consume(&ctx, &gmod, lhs, CkCallArgBorrow()))
                concat_args.push(op_consume(&ctx, &gmod, rhs, CkCallArgBorrow()))
                emit(&ctx, GICallExtern(dst, "gorget_str_cat", concat_args))
                # FRESH-OWNED-TEMP drop registration (#7): `gorget_str_cat`
                # allocates a fresh `GorgetString` (LoOwned). In a NESTED
                # concat `a + b + c`, the inner `a + b` result is borrowed by
                # the outer `+` (CkCallArgBorrow) and orphaned — its heap
                # leaks (ASan: 1400 bytes / 200 str_cat allocs over a 200-iter
                # loop). Registering it at creation makes the scope-exit
                # GIDropIfAlive free it exactly once. SAFE-BY-CONSTRUCTION:
                # when the result is instead MOVED into a named binding
                # (`String s = a + b`), op_consume emits OpMove → GIMoveZero →
                # drop_elab marks the slot IS_UNINITIALIZED and statically
                # deletes the guard, so no double-free; a GorgetString is a
                # runtime resource (LoOwned, droppable), so register_local_for_
                # drop's LoView/LoBorrowed/non-droppable gates pass it through.
                # NOTE (#7 scope): the SISTER leak — a fresh STRUCT/ENUM
                # constructor temp passed to a bare param (`take(Node([1,2,3]))`)
                # — is NOT registered here. That class is entangled with the
                # named-binding move/clone path whose correct (move) resolution
                # unmasks the pre-existing `!`-param-no-drop gap; see TODO.md.
                register_local_for_drop(&ctx, dst, gs_tid, &gmod)
                return dst
            # Operator overload on user types: if lhs is a user struct/enum,
            # route `a + b` → a.add(b), `a - b` → a.sub(b), etc.
            String op_method = binop_method_name(op)
            if op_method != "":
                String lhs_tname = local_type_name(lhs, &ctx, &gmod)
                bool lhs_is_user = gmod.type_infos.contains(lhs_tname)
                # Also consider monomorphized names (Wrapper__int64_t has
                # template Wrapper in type_infos).
                if not lhs_is_user and lhs_tname.contains("__"):
                    int dd = lhs_tname.index_of("__").unwrap()
                    if dd > 0:
                        String tp = lhs_tname.slice(0, dd)
                        if gmod.type_infos.contains(tp):
                            lhs_is_user = true
                if lhs_is_user:
                    String method_full = lhs_tname + "__" + op_method
                    # User op overload `a OP b` → Type__OP(a, b): consult
                    # callee signature for the rhs (lhs is the receiver,
                    # always OpMove). bare `T` → borrow; `!T` → owning.
                    Vector[Operand] op_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs, classify_call_arg(&gmod, method_full, 1))]
                    int op_ret = I64_TYPE
                    if gmod.fn_sigs.contains(method_full):
                        op_ret = gmod.fn_sigs.get(method_full).unwrap()
                    else:
                        # Assume op returns lhs type (common for Add/Sub/Mul/Div).
                        int lhs_tid = ctx.locals.get(lhs).unwrap().type_id
                        if lhs_tid != I64_TYPE:
                            op_ret = lhs_tid
                    int op_dst = add_local(&ctx, op_ret, NO_NAME)
                    emit(&ctx, GICallExtern(op_dst, method_full, op_args))
                    return op_dst
            # Result type of + - * / follows the operand type, not hardcoded
            # I64. Mirrors Rust infer_operand_type_full + bin_op
            # (src/ir/lowering/exprs/operators.rs:54,288). Without this, float
            # arithmetic lowered as I64 → wrong C type, the print-format pick
            # below, and the integer IDiv path (div-by-zero guard) for floats.
            int op_ty = ctx.locals.get(lhs).unwrap().type_id
            int dst = add_local(&ctx, op_ty, NO_NAME)
            emit(&ctx, GIBinOp(dst, map_binop(op), op_ty, op_consume(&ctx, &gmod, lhs, CkBinOpArg()), op_consume(&ctx, &gmod, rhs, CkBinOpArg())))
            return dst
        case EUnaryOp(op, inner_box):
            int inner = lower_expr(&ctx, *inner_box, &gmod)
            int inner_type = ctx.locals.get(inner).unwrap().type_id
            match op:
                case "-":
                    # Operator overload: -user_struct → user_struct.neg()
                    String inner_tname = local_type_name(inner, &ctx, &gmod)
                    if gmod.type_infos.contains(inner_tname):
                        String neg_method = inner_tname + "__neg"
                        Vector[Operand] neg_args = [OpMove(inner)]
                        int neg_ret = inner_type
                        if gmod.fn_sigs.contains(neg_method):
                            neg_ret = gmod.fn_sigs.get(neg_method).unwrap()
                        int neg_dst = add_local(&ctx, neg_ret, NO_NAME)
                        emit(&ctx, GICallExtern(neg_dst, neg_method, neg_args))
                        return neg_dst
                    int dst = add_local(&ctx, inner_type, NO_NAME)
                    emit(&ctx, GIUnOp(dst, UNOP_NEG, inner_type, OpCopy(inner)))
                    return dst
                case "not":
                    int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    emit(&ctx, GIUnOp(dst, UNOP_NOT, BOOL_TYPE, OpCopy(inner)))
                    return dst
                case "~":
                    # Bitwise NOT — result keeps the operand's integer type
                    # (mirrors Rust src/ir/lowering/exprs/operators.rs:407,410
                    # where BitNot's result_type == operand_type). Without this
                    # case the `~` was silently dropped (fell through to
                    # `return inner`), corrupting e.g. `cur & ~(mask)` masks.
                    int dst = add_local(&ctx, inner_type, NO_NAME)
                    emit(&ctx, GIUnOp(dst, UNOP_BITNOT, inner_type, OpCopy(inner)))
                    return dst
                else:
                    pass
            return inner
        case ECall(callee_box, args, targs):
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fname):
                    # Check if fname is a local variable (callable parameter or closure).
                    # If so, dispatch through closure protocol instead of direct call.
                    # Skip if fname is a known function (fn_sigs) or redirect target.
                    if nl_contains(&ctx, fname) and not gmod.fn_sigs.contains(fname) and not gmod.call_redirects.contains(fname):
                        int callable_local = nl_get(&ctx, fname)
                        # Lower args
                        Vector[Operand] cl_args = []
                        # Closure/__callable_N dispatch: the callable
                        # itself is a Ptr (op_consume returns OpCopy
                        # regardless of kind for Ptr slots). Args go
                        # through dynamic dispatch — callee signature
                        # isn't available here, so default to borrow
                        # per CLAUDE.md "Ownership at Consuming Positions".
                        cl_args.push(op_consume(&ctx, &gmod, callable_local, CkCallArgBorrow()))  # closure/callable as first arg
                        for carg in args:
                            int cval = lower_expr(&ctx, carg, &gmod)
                            cl_args.push(op_consume(&ctx, &gmod, cval, CkCallArgBorrow()))
                        # Emit as __callable_N (codegen handles this as void*[2] dispatch)
                        int arity = args.len()
                        String cl_call = "__callable_" + int_to_str(arity)
                        # Infer return type from the callable's type (function pointer return type)
                        int cl_ret_type = I64_TYPE
                        int callable_tid = ctx.locals.get(callable_local).unwrap().type_id
                        if callable_tid >= 0 and callable_tid < gmod.type_table.len():
                            GirType ct = gmod.type_table.get(callable_tid).unwrap()
                            match ct:
                                case GtFnPtr(_, ret_tid):
                                    cl_ret_type = ret_tid
                                case GtPtr(inner_tid):
                                    # Callable params are Ptr(FnPtr(...)) — unwrap
                                    if inner_tid >= 0 and inner_tid < gmod.type_table.len():
                                        GirType inner_ct = gmod.type_table.get(inner_tid).unwrap()
                                        match inner_ct:
                                            case GtFnPtr(_, ret_tid2):
                                                cl_ret_type = ret_tid2
                                            else:
                                                pass
                                case GtMutPtr(inner_tid):
                                    if inner_tid >= 0 and inner_tid < gmod.type_table.len():
                                        GirType inner_ct = gmod.type_table.get(inner_tid).unwrap()
                                        match inner_ct:
                                            case GtFnPtr(_, ret_tid2):
                                                cl_ret_type = ret_tid2
                                            else:
                                                pass
                                else:
                                    pass
                        int cl_dst = add_local(&ctx, cl_ret_type, NO_NAME)
                        emit(&ctx, GICallExtern(cl_dst, cl_call, cl_args))
                        return cl_dst
                    return lower_call(&ctx, &fname, &args, &targs, &gmod)
                case EFieldAccess(_, method_name):
                    # Method-style call: obj.method(args) parsed as ECall(EFieldAccess(...))
                    # Lower args but return unit (method calls are complex)
                    for marg in args:
                        lower_expr(&ctx, marg, &gmod)
                    int mdst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                    emit(&ctx, GIAssign(mdst, OpConstUnit()))
                    return mdst
                case EClosure(_, _):
                    # closure Phase 2 Step A: an immediately-invoked closure
                    # `((p…): body)(args)` (IIFE). Route the callee through
                    # lower_expr so the make-site EClosure arm RECORDS the
                    # closure (the post-pass then pushes its __Closure_N__call).
                    # The old scan reached this via ECall→callee recursion; the
                    # make-site ECall arm dropped non-ident/non-field callees,
                    # so this case restores closure-recording parity. Lower the
                    # args for side effects; return UNIT (matching the old IIFE
                    # value behavior — real IIFE call wiring is Phase 1.5).
                    lower_expr(&ctx, callee, &gmod)
                    for iife_arg in args:
                        lower_expr(&ctx, iife_arg, &gmod)
                    int iife_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                    emit(&ctx, GIAssign(iife_dst, OpConstUnit()))
                    return iife_dst
                case ENoneLiteral():
                    # `None()` call form (e.g. `Dict[String,Option[int]] d = {"b":None()}`).
                    # Route through lower_call as the bare-`None` ctor: lower_call's
                    # fname=="None" + expected_type starts_with "Option__" branch
                    # adopts Option__T and emits IEnumInit(tag=1). Without this the
                    # call fell to `else: pass` → add_local(UNIT_TYPE), ignoring
                    # expected_type and yielding a unit value at an Option boundary.
                    String none_name = "None"
                    return lower_call(&ctx, &none_name, &args, &targs, &gmod)
                else:
                    pass
            return add_local(&ctx, UNIT_TYPE, NO_NAME)
        case EMethodCall(recv_box, mname, margs, _):
            # Static method call: receiver is a TYPE name (e.g. Point.default()
            # or int.parse(s)). Route to TypeName__method with no self argument.
            #
            # Parameterised-type receiver: `Heap[int].new()` /
            # `SparseSet[int].new()` parse as EMethodCall on EIndex, NOT
            # EIdentifier. Detect that pattern and rewrite the receiver
            # as if it were `Heap__int64_t.new()` — the static-method
            # path below will then dispatch to `Heap__int64_t__new()`.
            # Without this, the lowerer would walk into EIndex and
            # lower `Heap` as a bare value identifier, emitting [bug].
            SpannedExpr recv_for_match = *recv_box
            match (*recv_box).expr:
                case EIndex(eix_base_box, eix_idx_box):
                    String eix_base_name = ""
                    String eix_idx_name = ""
                    match (*eix_base_box).expr:
                        case EIdentifier(b):
                            eix_base_name = b
                        else:
                            pass
                    match (*eix_idx_box).expr:
                        case EIdentifier(i):
                            eix_idx_name = i
                        else:
                            pass
                    if eix_base_name.len() > 0 and eix_idx_name.len() > 0:
                        # Substitute through `gmod.type_subs` (T → int64_t).
                        if gmod.type_subs.contains(eix_idx_name):
                            int sub_tid = gmod.type_subs.get(eix_idx_name).unwrap()
                            String sub_name = type_id_to_name(sub_tid, &gmod)
                            if sub_name.len() > 0:
                                eix_idx_name = sub_name
                        # Map surface type names to their C-level form
                        # so the mangled mono name matches what's
                        # registered in `type_infos`.
                        if eix_idx_name == "int":
                            eix_idx_name = "int64_t"
                        elif eix_idx_name == "float":
                            eix_idx_name = "double"
                        elif eix_idx_name == "String":
                            eix_idx_name = "GorgetString"
                        String mono_name = eix_base_name + "__" + eix_idx_name
                        # Synthesise an EIdentifier-shaped receiver so
                        # the existing static-method path picks it up.
                        recv_for_match = SpannedExpr(EIdentifier(mono_name), (*recv_box).span)
                else:
                    pass
            match recv_for_match.expr:
                case EIdentifier(ident_name_raw):
                    # Generic type-param substitution. In monomorphized
                    # bodies like `equip [T] SetIter[T] with Iterator[T]:
                    # Option[T] next(...): T out = T.default()`, the `T`
                    # of `T.default()` is a type-parameter name. After
                    # `setup_type_subs(T → int)`, look it up before the
                    # is_type check so `T.default()` dispatches to
                    # `int64_t__default()` rather than falling through to
                    # the EIdentifier-on-`T` value path (which has no
                    # binding and emits a [bug] placeholder).
                    String ident_name = ident_name_raw
                    if gmod.type_subs.contains(ident_name):
                        int sub_tid = gmod.type_subs.get(ident_name).unwrap()
                        String sub_name = type_id_to_name(sub_tid, &gmod)
                        if sub_name.len() > 0:
                            ident_name = sub_name
                    # Named locals shadow type names. Without this guard,
                    # a synth local whose name happens to contain `__`
                    # (e.g. `__for_coll_N` from a desugared SFor) gets
                    # picked up by the `__`-infix fallback below and
                    # misrouted to static-method dispatch
                    # (`__for_coll_N.get(i)` → `__for_coll_N__get(i)`,
                    # undefined symbol). The named-local check is also
                    # the safe answer in general: if a binding exists in
                    # scope, it's a value, regardless of name shape.
                    # (Self-host snag #5, 2026-05-14.)
                    bool is_local = nl_contains(&ctx, ident_name_raw)
                    bool is_type = false
                    if not is_local:
                        is_type = gmod.type_infos.contains(ident_name)
                    # Also treat primitive type names as types.
                    if not is_type and not is_local:
                        if ident_name == "int" or ident_name == "float" or ident_name == "bool":
                            is_type = true
                        elif ident_name == "String" or ident_name == "byte" or ident_name == "char":
                            is_type = true
                        elif ident_name == "int8" or ident_name == "int16" or ident_name == "int32" or ident_name == "int64":
                            is_type = true
                        elif ident_name == "uint8" or ident_name == "uint16" or ident_name == "uint32" or ident_name == "uint64":
                            is_type = true
                        elif ident_name == "float32" or ident_name == "float64":
                            is_type = true
                        # C-level primitive names — these arrive after
                        # `gmod.type_subs` substitution where `T → int64_t`
                        # (the C type name, not the Gorget surface `int`).
                        elif ident_name == "int64_t" or ident_name == "int32_t" or ident_name == "int16_t" or ident_name == "int8_t":
                            is_type = true
                        elif ident_name == "uint64_t" or ident_name == "uint32_t" or ident_name == "uint16_t" or ident_name == "uint8_t":
                            is_type = true
                        elif ident_name == "double" or ident_name == "GorgetString":
                            is_type = true
                        # Generic prelude types — `Box.new(x)` /
                        # `Heap.new()` etc. show up as static-method
                        # calls in surface syntax. The unparameterised
                        # name isn't in `type_infos` (only mono'd
                        # `Box__T` is), so it'd fall through to the
                        # bare-EIdentifier path and emit `[bug]`.
                        elif ident_name == "Box" or ident_name == "Heap":
                            is_type = true
                        elif ident_name == "Vector" or ident_name == "Deque":
                            is_type = true
                        elif ident_name == "Dict" or ident_name == "HashMap":
                            is_type = true
                        elif ident_name == "Set" or ident_name == "HashSet":
                            is_type = true
                        elif ident_name == "Channel" or ident_name == "Shared" or ident_name == "Weak":
                            is_type = true
                        elif ident_name == "Option" or ident_name == "Result":
                            is_type = true
                        # Monomorphized generic types — `Container__Foo`,
                        # `Heap__int64_t`, `SparseSet__int64_t`, etc. arrive
                        # here after the EIndex rewrite above. They may not
                        # be in `type_infos` yet (registration happens lazily
                        # during lowering, sometimes after the call site),
                        # but a `__` separator in an identifier is reliable
                        # signal it's a mangled type — Gorget's surface
                        # syntax doesn't allow identifiers to contain `__`.
                        elif ident_name.contains("__"):
                            is_type = true
                    if is_type:
                        # Static method / variant ctor: dispatch via
                        # classify_call_arg against the mangled callee
                        # name. Built early enough that the callee name
                        # may not yet be in fn_move_params (lazy
                        # registration); classify_call_arg defaults to
                        # CkCallArgBorrow when the lookup misses — correct
                        # per the docs.
                        Vector[Operand] static_args = []
                        # Compute the mangled callee name once for
                        # classify_call_arg lookups. Mirrors the post-loop
                        # `static_name` build below.
                        String _static_call = ident_name
                        if ident_name == "int":
                            _static_call = "int64_t"
                        elif ident_name == "float":
                            _static_call = "double"
                        elif ident_name == "String":
                            _static_call = "GorgetString"
                        _static_call = _static_call + "__" + mname
                        int _sai = 0
                        for sma in margs:
                            int sma_val = lower_expr(&ctx, sma, &gmod)
                            static_args.push(op_consume(&ctx, &gmod, sma_val, classify_call_arg(&gmod, _static_call, _sai)))
                            _sai += 1
                        # Primitive method names need C-runtime mangling.
                        String type_prefix = ident_name
                        if ident_name == "int":
                            type_prefix = "int64_t"
                        elif ident_name == "float":
                            type_prefix = "double"
                        elif ident_name == "String":
                            type_prefix = "GorgetString"
                        String static_name = type_prefix + "__" + mname
                        int static_ret = I64_TYPE
                        # Qualified enum variant constructor: `EnumName.Variant(args)`
                        # is parsed as EMethodCall(EIdentifier(EnumName), "Variant",
                        # args). The static-method path mangles to
                        # `EnumName__Variant` — for variants this is a constructor,
                        # not a real method, so the return type is the enum struct
                        # itself. Without this, `static_ret` falls through to
                        # I64_TYPE and the destination local lands at int64_t —
                        # the C codegen then tries to assign a 100+ byte enum
                        # struct literal into a scalar slot and barfs with
                        # "incompatible types when assigning to type 'int64_t'
                        # from type '__gg_Foo'". Mirrors Rust gg's enum-variant
                        # branch in `src/ir/lowering/exprs/methods.rs` (snag #51).
                        bool is_variant_ctor = false
                        if gmod.type_infos.contains(ident_name):
                            GirTypeInfo enum_info = gmod.type_infos.get(ident_name).unwrap()
                            if enum_info.is_enum:
                                for evv in enum_info.variants:
                                    if evv.name == mname:
                                        is_variant_ctor = true
                                        break
                        if is_variant_ctor:
                            static_ret = lookup_or_register_named(&gmod, ident_name)
                        elif gmod.fn_sigs.contains(static_name):
                            static_ret = gmod.fn_sigs.get(static_name).unwrap()
                        elif mname == "default":
                            if gmod.type_infos.contains(ident_name):
                                static_ret = lookup_or_register_named(&gmod, ident_name)
                            else:
                                # int.default() → int, float.default() → double, etc.
                                int pt = prim_name_to_type(ident_name)
                                if pt >= 0:
                                    static_ret = pt
                        elif mname == "parse":
                            # int.parse(s) returns Option[int]
                            int pt = prim_name_to_type(ident_name)
                            if pt >= 0:
                                String opt_name = "Option__" + type_id_to_name(pt, &gmod)
                                static_ret = lookup_or_register_named(&gmod, opt_name)
                                record_enum_category(&gmod, static_ret, ENUM_CAT_OPTION, pt, -1)
                        else:
                            int binfer = builtin_call_return_type(static_name, &gmod)
                            if binfer >= 0:
                                static_ret = binfer
                        int sdst = add_local(&ctx, static_ret, NO_NAME)
                        emit(&ctx, GICallExtern(sdst, static_name, static_args))
                        return sdst
                else:
                    pass
            # unwrap() / unwrap_or() — extract the payload field from the
            # Option/Result receiver. Previously a no-op GIAssign copy with
            # a re-typed target, which silently mishandled aggregate receivers:
            # `.unwrap_or(0)` on a `Result[int, ParseError]` emits "0" via
            # emit_variant_arg's aggregate-arg/scalar-expected fallback,
            # losing the actual Ok_0 value. Now emits a real field read
            # through the `__field_read_<enum>_<Variant>_0` helper, same as
            # PConstructor destructure.
            #
            # Place base — a method receiver is passed as `self` BY POINTER,
            # so a `&`/`!`-param (`GtMutPtr`) receiver must stay the pointer
            # (else the method mutates a discarded dereffed copy, not the
            # caller's value). `lower_place_base` bypasses Edit-1's value-read
            # deref for a bare identifier; non-identifier receivers (chained
            # calls etc.) fall back to `lower_expr` unchanged.
            int recv = lower_place_base(&ctx, *recv_box, &gmod)
            if mname == "unwrap" or mname == "unwrap_or":
                # Lower the default value first (for unwrap_or) and
                # capture its local id — needed if we synthesize a
                # tag check below. unwrap (no args) leaves this at -1.
                int default_local = -1
                int uoi = 0
                while uoi < margs.len():
                    int lo = lower_expr(&ctx, margs.get(uoi).unwrap(), &gmod)
                    if uoi == 0:
                        default_local = lo
                    uoi += 1
                # Determine the wrapper type, inner type name, and variant.
                String recv_tn = local_type_name(recv, &ctx, &gmod)
                String variant_name = ""
                String inner_name_str = ""
                # option_ref_borrow Phase 3 (typed path, no name-matching):
                # for a borrowing-getter result `Option[Ref[T]]`, the payload
                # is a real `GtPtr(T)` recorded at registration. Read it from
                # the typed `option_ref_payload` channel keyed on the receiver
                # Option's GIR id — the unwrap then mints the pointer directly,
                # never slicing the `Ref__` infix out of recv_tn. The
                # downstream emit_payload_read GtPtr guard returns the pointer
                # (no clone); field-access auto-derefs; op_consume clones the
                # pointee only at owning positions (§2 table).
                int recv_type_id = ctx.locals.get(recv).unwrap().type_id
                int ref_payload_tid = option_ref_payload_of(&gmod, recv_type_id)
                if recv_tn.starts_with("Option__"):
                    variant_name = "Some"
                    inner_name_str = recv_tn.slice(8, recv_tn.len())
                elif recv_tn.starts_with("Result__"):
                    variant_name = "Ok"
                    # Ok type: longest-prefix scan for first `__` splits
                    # Result__<OkT>__<ErrT>.
                    String rest = recv_tn.slice(8, recv_tn.len())
                    int split = rest.index_of("__").unwrap_or(-1)
                    if split > 0:
                        inner_name_str = rest.slice(0, split)
                int inner_tid = -1
                if inner_name_str != "":
                    int prim_t = prim_name_to_type(inner_name_str)
                    if prim_t >= 0:
                        inner_tid = prim_t
                    elif inner_name_str == "int64_t":
                        inner_tid = I64_TYPE
                    elif inner_name_str == "int32_t":
                        inner_tid = I32_TYPE
                    elif inner_name_str == "int16_t":
                        inner_tid = I16_TYPE
                    elif inner_name_str == "int8_t":
                        inner_tid = I8_TYPE
                    elif inner_name_str == "uint64_t":
                        inner_tid = U64_TYPE
                    elif inner_name_str == "uint32_t":
                        inner_tid = U32_TYPE
                    elif inner_name_str == "uint16_t":
                        inner_tid = U16_TYPE
                    elif inner_name_str == "uint8_t":
                        inner_tid = U8_TYPE
                    elif inner_name_str == "double":
                        inner_tid = F64_TYPE
                    elif inner_name_str == "float":
                        inner_tid = F32_TYPE
                    elif inner_name_str == "Str":
                        inner_tid = lookup_or_register_named(&gmod, "GorgetString")
                    elif inner_name_str.starts_with("Ref__"):
                        # option_ref_borrow: an `Option__Ref__T` payload name
                        # `Ref__T` must resolve to a real `GtPtr(T)` via the
                        # bridge — NOT `lookup_or_register_named` (which would
                        # register a `GtNamed("Ref__T")` → empty C struct that
                        # poisons resolve_field_lir_type's LT_PTR fallback,
                        # making Some_0 a value struct → shallow-copy/memcpy
                        # type-error). Mirrors the guard at the infer site
                        # (~3461) + the resolve_field_gir_type bridge (~3070).
                        # The typed override below sets the same GtPtr; this
                        # just avoids the GtNamed registration SIDE EFFECT.
                        inner_tid = resolve_field_gir_type(inner_name_str, &gmod)
                    else:
                        inner_tid = lookup_or_register_named(&gmod, inner_name_str)
                # option_ref_borrow Phase 3: override with the typed GtPtr
                # payload when this is an Option[Ref[T]] — the name-slice above
                # produced a GtNamed("Ref__T"); we want the real GtPtr(T).
                if ref_payload_tid >= 0:
                    inner_tid = ref_payload_tid
                if inner_tid >= 0 and variant_name != "":
                    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, recv)
                    # `.unwrap_or(default)`: emit a real tag check so
                    # None/Error returns the default instead of dereffing
                    # a NULL pointer (closes showcase blocker #4 — the
                    # `sr_lookup` workaround in lir_lower.gg:35 can now
                    # inline as `sr.get(name).unwrap_or(-1)`).
                    if mname == "unwrap_or" and default_local >= 0:
                        # option_ref_borrow Phase 6 (R1, site #4 — extended
                        # 2026-05-28 for NEXT BLOCKER #4): the result SLOT
                        # (`uo_dst`) needs a SEPARATE type from `inner_tid`.
                        # ⚠ `inner_tid` MUST stay `GtPtr` — it is reused at
                        # the `emit_payload_read` field reads (Some-arm ~below
                        # AND the plain-unwrap path) where the site-#1 guard
                        # fires and emits the GIDeref. The two slot types are
                        # ALREADY decoupled here; the `uo_slot_tid` override
                        # only changes the result-slot, not the field-read dst.
                        #
                        # For BOTH primitive and resource pointees, the slot
                        # type is the VALUE pointee — the Some-arm clones the
                        # GtPtr payload (`op_consume(payload, CkAssign)` →
                        # OpClone → `<T>__clone(ptr)` → fresh value) and stores
                        # the value; the None-arm moves the value-typed default
                        # into the same value slot. The caller's
                        # `op_consume(uo_dst, CkReturn)` then sees a value-typed
                        # owned local — OpMove → direct return.
                        #
                        # Pre-2026-05-28: this gated the override on
                        # `not is_resource_type_name(...)` so resource pointees
                        # kept `uo_slot_tid = inner_tid` (GtPtr). The Some-arm
                        # then hit lir_codegen's "Ptr-slot ← aggregate-value →
                        # NULL" give-up branch (`__s33 = NULL`), and the merge's
                        # downstream `clone_to_owned` SIGSEGV'd. The resource
                        # case wants the SAME value-typed slot as primitives;
                        # the GtPtr requirement was only about `inner_tid`, not
                        # `uo_slot_tid`.
                        int uo_slot_tid = inner_tid
                        if ref_payload_tid >= 0 and ref_payload_tid < gmod.type_table.len():
                            GirType rp_gt = gmod.type_table.get(ref_payload_tid).unwrap()
                            match rp_gt:
                                case GtPtr(rp_inner):
                                    uo_slot_tid = rp_inner
                                else:
                                    pass
                        # Materialise the result slot up front; both arms
                        # store into it so the merge block sees a single
                        # def (SSA construction inserts the phi).
                        int uo_dst = add_local(&ctx, uo_slot_tid, NO_NAME)
                        int tag = emit_tag_read(&ctx, scr_ptr, recv_tn, &gmod)
                        # tag == 0 → Some / Ok arm.
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICmp(cmp_dst, CMP_EQ, I64_TYPE, OpCopy(tag), OpConstI64(0)))
                        int some_bb = new_block(&ctx)
                        int none_bb = new_block(&ctx)
                        int uo_merge_bb = new_block(&ctx)
                        set_terminator(&ctx, GTBranch(OpCopy(cmp_dst), some_bb, none_bb))
                        # Some arm: read payload, store to uo_dst.
                        switch_to(&ctx, some_bb)
                        int payload = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                        emit(&ctx, GIAssign(uo_dst, op_consume(&ctx, &gmod, payload, CkAssign())))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        # None arm: store the default.
                        switch_to(&ctx, none_bb)
                        emit(&ctx, GIAssign(uo_dst, op_consume(&ctx, &gmod, default_local, CkAssign())))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        switch_to(&ctx, uo_merge_bb)
                        return uo_dst
                    # Plain unwrap: emit a real field read through the
                    # scrutinee-ptr helper, matching PConstructor destructure.
                    int field_val = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                    # Prereq B-extension (2026-05-21): when the receiver
                    # was a borrow (e.g., `coll.get(i).unwrap()` where
                    # `.get()` returned LoBorrowed/BoCollectionElement,
                    # or a SVarDecl-bound borrow propagated via Prereq
                    # B), demote `field_val` to LoBorrowed so the
                    # COMMIT 3 drop emission doesn't double-free the
                    # underlying aggregate data. emit_payload_read tags
                    # `dst` LoBorrowed/BoField when no clone fn is
                    # available (the common case for user enums whose
                    # payload types aren't runtime resources); the
                    # inherit shim leaves LoOwned dst's alone (those
                    # were explicitly cloned and need their own drop).
                    inherit_borrow_from(&ctx, field_val, recv)
                    return field_val
                # Fall back to re-cast if we couldn't identify the variant.
                # Phase 3 (Class 8): inherit recv's borrow tag onto ud so a
                # chained `coll.get(i).unwrap()` doesn't byte-copy the alias
                # into a fresh LoOwned slot.
                if inner_tid >= 0:
                    int ud = add_local_inheriting(&ctx, inner_tid, NO_NAME, recv)
                    emit(&ctx, GIAssign(ud, op_consume(&ctx, &gmod, recv, CkAssign())))
                    return ud
                return recv
            # clone() — return a copy of the receiver
            if mname == "clone":
                # Phase D step 3: explicit `.clone()` produces an owned
                # copy of the receiver. Emit OpClone so downstream layers
                # (LIR codegen, Phase C validators) know this read is a
                # deliberate refcount bump / deep copy, not an alias.
                #
                # Phase 2.3.5 (2026-05-22) — the dst's type is the
                # POINTEE when recv is Ptr(T)/MutPtr(T): clone produces
                # an owned T value, not a pointer. Without this unwrap,
                # the clone_dst slot is typed as Ptr(T); the lir_lower
                # OpClone handler treats the slot as a Ptr-to-resource
                # at every later consume position, emitting an EXTRA
                # `gorget_<T>__clone_to_owned` that takes the prior
                # clone's Str RESULT as a pointer — type-mismatch at
                # cc (`Str` arg vs `const GorgetString*` expected) and
                # a guaranteed crash if it ever ran. Writer-site fix:
                # unwrap the Ptr/MutPtr so clone_dst's GIR type matches
                # the actual runtime value being stored.
                int recv_tid = ctx.locals.get(recv).unwrap().type_id
                if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                    GirType recv_gt = gmod.type_table.get(recv_tid).unwrap()
                    match recv_gt:
                        case GtPtr(inner_tid):
                            recv_tid = inner_tid
                        case GtMutPtr(inner_tid):
                            recv_tid = inner_tid
                        else:
                            pass
                int clone_dst = add_local(&ctx, recv_tid, NO_NAME)
                emit(&ctx, GIAssign(clone_dst, OpClone(recv)))
                return clone_dst
            # Detect mutating-method-on-field-access pattern *before*
            # lowering args, so we capture wb_base / wb_field while the
            # recv_box AST is still in scope. `self.field.push(x)` and
            # similar mutators are lowered as:
            #   copy = __field_read_(base, idx)
            #   method(&copy, args)
            # …the mutation lives on `copy`; without a follow-up write-back,
            # the original field never sees the change. Writing back after
            # the call persists the mutation. Classic symptom: lex_emit's
            # `self.lex_tokens.push(...)` silently drops every token and the
            # self-compiled lexer returns 0 tokens.
            bool is_mutating = mname == "push" or mname == "put" or mname == "set" or mname == "pop" or mname == "remove" or mname == "clear"
            # Detect whether the field-read receiver is Ptr-typed (A.2,
            # 2026-05-22: GIFieldLoad emits Ptr-typed locals for resource
            # field reads). If so, the mutating call goes through the
            # field POINTER directly and mutates the field in place — no
            # writeback needed. Pre-A.2 the field-read produced a by-value
            # copy and writeback was the only way to persist mutations.
            # Today the writeback is not just redundant: emit_field_write_
            # from_local routes the value through CkFieldWrite → OpClone,
            # triggering an O(N) gorget_array_clone of the WHOLE collection
            # after every push. That's O(N²) overall — pathological on
            # parser.gg's ~25k-token lexing run (5min+ per file).
            bool recv_is_ptr_borrow = false
            GirLocal recv_loc_for_check = ctx.locals.get(recv).unwrap()
            match recv_loc_for_check.ownership:
                case LoBorrowed():
                    recv_is_ptr_borrow = is_ptr_type(recv_loc_for_check.type_id, &gmod)
                else:
                    pass
            bool need_writeback = false
            SpannedExpr wb_base = (*recv_box)
            String wb_field = ""
            # option_ref_borrow Phase 4b: the `coll.get(i).unwrap()
            # .mut_method(args)` chain needs NO writeback. `.get()` now
            # returns `Option[Ref[T]]`, so the unwrapped receiver is a
            # `GtPtr(T)` borrow whose pointer IS the collection element's
            # address — the mutating call goes THROUGH the pointer and
            # mutates the real element in place. The old `coll.set(idx,
            # !recv)` chain-writeback (retired here) would store a pointer
            # into the collection's own element slot → corruption. This
            # also retires the `feedback_nested_vector_get_set` workaround.
            if is_mutating:
                match (*recv_box).expr:
                    case EFieldAccess(wb_base_box, wb_f):
                        # Skip writeback when recv is a Ptr-borrow (A.2 path):
                        # the push goes through the field pointer directly,
                        # so the field is already mutated in place. The
                        # writeback would trigger a spurious whole-field
                        # clone (CkFieldWrite → OpClone).
                        if not recv_is_ptr_borrow:
                            need_writeback = true
                            wb_base = *wb_base_box
                            wb_field = wb_f
                    else:
                        pass
            # Method call: lower receiver as first arg (&self), then args.
            # Most collection/object methods take self by pointer.
            #
            # Phase C step 5b + Path A receiver-dispatch (2026-05-21):
            # pick operand mode by consulting the callee's signature for
            # param 0 (the implicit self slot):
            #   • `!self` (OWN_MOVE) → CkCallArgOwning → OpMove
            #   • `&self` / bare `self` → CkCallArgBorrow → OpBorrow
            # A LoBorrowed receiver (most commonly a field-loaded local
            # — `self.columns.get(...)`) must always be OpBorrow — moving
            # a borrow is a use-after-free shape, irrespective of the
            # callee's declared ownership. For LoOwned / LoParam sources
            # we let the callee signature drive the decision rather than
            # hardcoding OpMove: that hardcode is the dominant source of
            # over-consumption (Phase 2c COMMIT 2 blocker, scout
            # `a38eb352`). Methods not pre-registered in fn_move_params
            # default to CkCallArgBorrow — correct per CLAUDE.md
            # "Ownership at Consuming Positions" (bare-T propagates the
            # Ptr alias at zero cost). At the LIR layer OpBorrow lowers
            # identically to OpMove for pass-by-ptr method args (commit
            # `af687f3d`); validators downstream get the typed signal.
            #
            # Build the mangled method name once — used both for the
            # receiver dispatch and the per-arg classify_call_arg.
            String recv_type_name = local_type_name(recv, &ctx, &gmod)
            String full_name = recv_type_name + "__" + mname
            String sig_lookup_name = full_name.clone()   # R10: pre-redirect mangled name for fn_sigs
            # Extern-method redirect: an `extern int _m(...) = "gorget_sym"`
            # method inside an equip block (e.g. File's `_write_bytes_buf`)
            # is registered by the loader as a call_redirect keyed on the
            # mangled `<Target>__<method>` name. Resolve it here so the call
            # emits the C runtime symbol DIRECTLY (mirroring Rust gg inlining
            # `self._m(args)` → `gorget_sym(self, args)`), rather than calling
            # a degenerate stub body. Only extern-equip methods land in
            # call_redirects under this Type__method shape, so this never
            # perturbs ordinary user-method dispatch.
            if gmod.call_redirects.contains(full_name):
                full_name = gmod.call_redirects.get(full_name).unwrap()
            Vector[Operand] call_args = []
            GirLocal recv_loc = ctx.locals.get(recv).unwrap()
            match recv_loc.ownership:
                case LoBorrowed():
                    # A LoBorrowed receiver (field-loaded local, or the
                    # `GtPtr(T)` unwrap of an `Option[Ref[T]]` from
                    # `coll.get(i).unwrap()`) is always OpBorrow: the call
                    # passes the pointer, mutating the real element in place.
                    call_args.push(OpBorrow(recv))
                else:
                    # Receiver is param index 0 in the callee's
                    # signature. Dispatch via classify_call_arg:
                    # `!self` → OpMove, otherwise OpBorrow.
                    call_args.push(op_consume(&ctx, &gmod, recv, classify_call_arg(&gmod, full_name, 0)))
            # STEP 1 / Option C — collection mutators (push/set/insert on
            # Vector, put/set on Dict, add/insert on Set) take OWNERSHIP of
            # the value they store (and, for Dict, the key). classify_call_arg
            # defaults these to CkCallArgBorrow (the mangled method name isn't
            # in fn_move_params), which makes op_consume return OpBorrow
            # unconditionally → neither a paired GIMoveZero nor a clone fires,
            # so the stored value shallow-aliases the source local and both
            # free the same heap at scope exit (the meta_expand_for_match
            # double-free). Promote the owning value/key arg to CkCallArgOwning
            # so op_consume emits OpMove (owned last-use source) or OpClone
            # (Ptr-to-resource source via decide_ptr_consume; LoBorrowed
            # sources await a-5's clone-on-borrow arm). The runtime ABI ALREADY
            # address-takes these args via lir_lower's needs_ptr_arg keyed on
            # the mapped runtime name, so an OpMove operand is passed by pointer
            # cleanly — NO lir_lower change is needed (the original "wrong ABI"
            # diagnosis was inverted; see docs/plans/drop_emission.md).
            CollectionKind _recv_ck = collection_kind_of(&gmod, recv_type_name)
            int _ma_idx = 0
            for ma in margs:
                # closure Phase 2 Step A: a method-call arg that CONTAINS a
                # raw `it` (e.g. `.map(it*2)`, where the self-host parser does
                # NOT always wrap it in EImplicitClosure) is an implicit-it
                # closure body — record it (the OLD scan did the same via
                # expr_has_it → emit_it_closure). Otherwise lower normally.
                int ma_val = -1
                if expr_has_it(ma):
                    ma_val = record_implicit_it_closure(&ctx, ma, &gmod)
                else:
                    # Clear the enclosing `expected_type` around the arg so a
                    # Result-typed surrounding context (e.g. `return a.add(to_n(sel))`
                    # from a `throws` fn) doesn't make the centralized auto-prop
                    # hook's capture-form check suppress the peel on a throws-call
                    # arg — leaving a `Result` where the param wants `T`. (The
                    # method-arg path never set a per-arg expected_type, so -1 is
                    # the prior behaviour for non-throws args.) Mirrors the
                    # free-call arg loop and Rust gg's per-arg expected_type clear.
                    int prev_expected_ma = ctx.expected_type
                    ctx.expected_type = -1
                    ma_val = lower_expr(&ctx, ma, &gmod)
                    ctx.expected_type = prev_expected_ma
                ConsumeKind ma_kind = classify_call_arg(&gmod, full_name, _ma_idx + 1)
                # Owning-mutator promotion: a collection mutator takes
                # ownership of the value (and, for Dict, the key) at the
                # `owning_arg_positions` indices carried by its typed decl
                # (COLLECTION_BUILTIN_METHODS, keyed by the RESOLVED kind).
                # None (non-collection receiver or non-mutator method) → no
                # promotion, exactly as the old `is_owning_mutator_arg` false.
                match collection_builtin_method(_recv_ck, mname):
                    case Some(cdecl):
                        if int_vec_contains(cdecl.owning_arg_positions, _ma_idx):
                            ma_kind = CkCallArgOwning()
                    case None:
                        pass
                call_args.push(op_consume(&ctx, &gmod, ma_val, ma_kind))
                _ma_idx += 1
            # Return-type resolution priority — single source of truth
            # at each step (Layering rule 3):
            #
            #   1. fn_sigs (the lowerer's own registrations: Option B
            #      pre-pass for mono'd generic-equip methods + the
            #      non-generic-equip pre-pass at line ~6201). Fast,
            #      authoritative for the cases it covers.
            #   2. Typechecker side-table (`tc_types.expr_types`) —
            #      covers method-generic call sites (`v.iter().
            #      take_while[P](pred)`, `.map[U,F](f)`, full iterator
            #      chains, etc.) where the typechecker already resolved
            #      the mono'd return type. The architectural single
            #      source of truth for "what type does this expression
            #      have?" (Phase 1 + 2 of Gap #2). Returns a fully-
            #      mangled GIR type id via `resolved_to_gir_type`.
            #   3. Name-based heuristic (`infer_method_return_type`) —
            #      last resort for built-in collection runtime methods
            #      the typechecker doesn't model (raw runtime symbols
            #      like `gorget_array_get`); returns I64 when truly
            #      unknown.
            int ret_tid = I64_TYPE
            if gmod.fn_sigs.contains(sig_lookup_name):
                # R10: fn_sigs is keyed by the Gorget-level mangled method name
                # (Target__method, see lower.gg:~10190). For a call_redirect'd
                # extern method, full_name was rewritten to the C symbol above,
                # which is never a fn_sigs key — so the void extern-method return
                # type (registered under the mangled name by loader.gg) is found here.
                ret_tid = gmod.fn_sigs.get(sig_lookup_name).unwrap()
            elif gmod.fn_sigs.contains(full_name):
                ret_tid = gmod.fn_sigs.get(full_name).unwrap()
            else:
                int tc_ret = lookup_expr_gir_type(sexpr, &gmod)
                if tc_ret >= 0:
                    ret_tid = tc_ret
                else:
                    ret_tid = infer_method_return_type(mname, recv, &ctx, &gmod)
            if ret_tid == UNIT_TYPE:
                # Void-returning method — no destination
                emit(&ctx, GICallExtern(-1, full_name, call_args))
                if need_writeback:
                    emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
                int void_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                emit(&ctx, GIAssign(void_dst, OpConstUnit()))
                return void_dst
            # Phase D step 2: borrowing collection getters (.get / .first /
            # .last / .safe_get) return `Option[Ref[V]]` whose payload is a
            # borrow into the collection element, not an owned copy. Tag the
            # destination LoBorrowed/BoCollectionElement so validators
            # downstream can distinguish "owned wrapper around a borrow" from
            # "wrapper around an owned value." Detection is by RETURN-TYPE
            # SHAPE (typed) — `option_ref_payload_of(&gmod, ret_tid) >= 0`
            # iff `ret_tid` is the `Option__Ref__T` shape recorded on the
            # `option_ref_payload` channel; mirrors Rust's
            # `ret_option_ref_or_val_elem` discriminator at
            # `src/ir/lowering/builtins.rs:172-185`. Consuming getters
            # (`pop`/`remove`) return `Option[T]` (owned, ownership transfers
            # OUT) and correctly fall through to the default `add_local`
            # (LoOwned) path. Receiver-type gate still avoids false positives
            # when the user shadows these names on a non-collection type.
            int mdst = -1
            bool recv_is_string = recv_type_name == "String" or recv_type_name == "GorgetString" or recv_type_name == "Str"
            # Does this String method return a non-owning VIEW into the
            # receiver's buffer? Read the typed `returns_view` column off the
            # String builtin table (STRING_BUILTIN_METHODS) instead of the
            # old `is_string_view_method` name match. None (not a String
            # builtin) → false, same as the old list's fall-through.
            bool mname_is_view = false
            match string_builtin_method(mname):
                case Some(sdecl):
                    mname_is_view = sdecl.returns_view
                case None:
                    pass
            if option_ref_payload_of(&gmod, ret_tid) >= 0:
                bool recv_is_collection = false
                match resource_meta_for(&gmod, recv_type_name):
                    case Some(rmeta):
                        match rmeta.collection_kind:
                            case CkNotCollection():
                                recv_is_collection = false
                            else:
                                recv_is_collection = true
                    case None:
                        recv_is_collection = false
                if recv_is_collection:
                    mdst = add_local_with(&ctx, ret_tid, NO_NAME, LoBorrowed(), BoCollectionElement(-1))
                else:
                    mdst = add_local(&ctx, ret_tid, NO_NAME)
            elif recv_is_string and mname_is_view:
                # View-returning String method: result aliases the receiver's
                # buffer (cap==0). Tag LoView so op_consume materializes it
                # (OpClone) at any owning consume position — otherwise the
                # view is moved-by-value into owned storage and dangles.
                mdst = add_local_with(&ctx, ret_tid, NO_NAME, LoView(), BoNone())
            else:
                mdst = add_local(&ctx, ret_tid, NO_NAME)
            # FRESH-OWNED-TEMP drop registration (#19, sibling of #17 at the
            # lower_call return-temp site lower.gg:~7405): an owning String
            # method (`.upper()`/`.lower()`/`.replace()`/`.repeat()`/`.trim()`/
            # `.strip()`/`.reverse()`/`.center()`/`.ljust()`/`.rjust()`/
            # `.zfill()`/`.removeprefix()`/`.removesuffix()`) materializes a
            # fresh OWNED GorgetString in the default `add_local` (LoOwned)
            # branch above. When this CALL EXPRESSION flows directly into a
            # non-consuming position (`print(s.upper())`, `f"{s.replace("a","b")}"`)
            # it is BORROWED only (CkFormatArg/CkCallArgBorrow → is_consume_kind=
            # false → OpBorrow), so the result is orphaned and leaks (O(1) per
            # occurrence). Registering at creation makes the scope-exit
            # GIDropIfAlive free it exactly once.
            #
            # SCOPE — NARROW (owning-String methods only), NOT the general "any
            # owned method result". The general one-liner (register every
            # `mdst`) RED'd `self_host_runtime` (stdlib_iter_drain): it woke a
            # PRE-EXISTING LATENT ownership bug — `equip [T] Vector[T] with
            # Drainable[T]: VectorDrain[T] drain(!self)` is a GENERIC-equip
            # `!self`-consuming method, so `Vector__int64_t__drain` is NEVER put
            # in `fn_move_params` (the generic-equip `!`-param gap documented at
            # lower.gg:~12934). classify_call_arg therefore returns
            # CkCallArgBorrow → op_consume does NOT move-zero the receiver, so
            # the SOURCE Vector buffer is logically owned by BOTH the `drain()`
            # result (which now drops it, post-registration) AND the source
            # local / `!`-param `g` (whose own exit-drop also frees it) →
            # double-free (ASan: __gorget_dtor_VectorDrain frees the array, then
            # gorget_array_free on the same region from the `!`-param drop). The
            # leak this registration was masking was the SAFE side of that latent
            # bug. The CORRECT general fix is to close the generic-equip
            # `fn_move_params` gap (separate, larger — logged in TODO); until
            # then we register ONLY owning-String-method results, which all take
            # `&self` (a borrow, never `!self`) so there is no receiver-move to
            # mis-track. View-returning String methods are excluded by
            # `not mname_is_view` (and would self-skip via register_local_for_drop's
            # LoView gate anyway).
            #
            # SELF-GATING beyond the String gate: primitive/non-droppable returns
            # are skipped by register_local_for_drop's is_droppable_type gate
            # (lower.gg:1230); LoView results self-skip (lower.gg:1244).
            # SAFE-BY-CONSTRUCTION when MOVED instead (`String s = obj.upper()`,
            # `return s.trim()`, pushed/field-init'd): op_consume/wire-liveness
            # emits OpMove → GIMoveZero zeros the moved-out slot, so the
            # unconditional memcmp-guarded scope-exit GIDropIfAlive finds a zeroed
            # slot and suppresses the drop (drop_elab further elides statically);
            # the SReturn path separately move-zeros + excludes the returned local.
            # Placed BEFORE the emit so the `need_writeback` path is covered too.
            # Mirrors Rust's call_extern_tracked `needs_drop` registration.
            # #19-GENERAL (prototype, separable from the generic-equip fix):
            # register EVERY owned, droppable method-call result for drop, not
            # just owning-String methods. `register_local_for_drop` self-gates:
            # is_droppable_type skips primitives/non-resource returns, and the
            # LoView/LoBorrowed tag self-skips view/element-borrow results. This
            # was previously gated to `recv_is_string` because the general form
            # woke the generic-equip `!self` double-free (drain) — now that the
            # generic-equip `fn_move_params` pre-pass move-zeroes the drain
            # SOURCE, registering the drain RESULT here drops the buffer exactly
            # once. Mirrors Rust's `call_extern_tracked` `needs_drop`.
            if not mname_is_view:
                register_local_for_drop(&ctx, mdst, ret_tid, &gmod)
            emit(&ctx, GICallExtern(mdst, full_name, call_args))
            if need_writeback:
                emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
            return mdst
        case EFieldAccess(base_box, field_name):
            # Place base — keep a `&`/`!`-param (`GtMutPtr`) or bare-resource
            # param (`GtPtr`) base as the POINTER (the field codegen wants
            # `((T*)base)->field`). `lower_place_base` bypasses Edit-1's
            # value-read deref for a bare identifier; nested bases fall back
            # to `lower_expr`.
            int base = lower_place_base(&ctx, *base_box, &gmod)
            # Resolve the base's struct type to find the field
            int base_tid = ctx.locals.get(base).unwrap().type_id
            String base_type_name = type_id_to_name(base_tid, &gmod)
            # Unwrap Ptr/MutPtr to get the inner type name
            int inner_tid = base_tid
            if base_tid >= 0 and base_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(base_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    case GtMutPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    else:
                        pass
            # Box auto-deref: `box.field` is sugar for `(*box).field` — peel
            # the Box wrapper so the field lookup hits the inner struct's
            # fields, not Box's (which has no user fields). Without this,
            # `expr.span` where `expr` is `Box[SpannedExpr]` (auto-boxed
            # parameter, etc.) silently fell into the [bug] OpConstI64(0)
            # placeholder. The inner-name extraction mirrors `case EDeref`'s
            # prefix-slice.
            # Phase A — typed-metadata classification (BkRegularBox) via
            # resource_meta_for; the inner name is the post-`Box__` suffix
            # (rmeta doesn't carry parsed inner names, so slice the prefix).
            bool base_is_regular_box = false
            match resource_meta_for(&gmod, base_type_name):
                case Some(rmeta):
                    match rmeta.box_kind:
                        case BkRegularBox():
                            base_is_regular_box = true
                        else:
                            pass
                case None:
                    pass
            if base_is_regular_box:
                String inner_name = base_type_name.slice(5, base_type_name.len())
                int box_inner_tid = resolve_field_gir_type(inner_name, &gmod)
                # Phase 3 (Class 8): the box-deref's inner local aliases
                # into the box's heap allocation — when `base` itself was
                # already a borrow (chained field access on a borrowed
                # aggregate), the derefed inner inherits that borrow tag.
                # For an LoOwned box, dropping the box still frees the
                # inner heap, but the inner deref still aliases into it
                # for the duration of base's scope — leaving derefed as
                # LoOwned would risk a double-free when COMMIT 3 drops
                # both base and derefed on the same heap. Inheritance is
                # the safe default.
                int derefed = add_local_inheriting(&ctx, box_inner_tid, NO_NAME, base)
                emit(&ctx, GIDeref(derefed, base, box_inner_tid))
                base = derefed
                base_tid = box_inner_tid
                base_type_name = inner_name
                inner_tid = box_inner_tid
            # Special case: GorgetString.data — return the GorgetString
            # itself (identity). GorgetString has no registered `data` field
            # in type_infos (it's an opaque runtime struct), so the field
            # lookup below would fall through to the [bug] I64(0) placeholder.
            # Accessing `.data` is valid for printf (`%.*s` handles it). For a
            # value receiver `base` is already a value GorgetString; for a
            # `&String`/`!String` borrow it is a Ptr(GorgetString) — both are
            # returned AS-IS (the borrowed-String formatter deref handles the
            # Ptr at the format site). Mirrors Rust
            # `src/ir/lowering/exprs/mod.rs:2108` (`return obj;`).
            if base_type_name == "GorgetString" and field_name == "data":
                return base
            # Look up field info from type_infos. Resolve to
            # (field_name, field_type_name, field_index) tuples without
            # cloning the whole GirTypeInfo — the Vector clone path
            # double-frees nested heap data on the self-host.
            int found_fi = -1
            String found_type_name = ""
            if gmod.type_infos.contains(base_type_name):
                GirTypeInfo info = gmod.type_infos.get(base_type_name).unwrap()
                int fi = 0
                while fi < info.fields.len():
                    GirFieldInfo finfo = info.fields.get(fi).unwrap()
                    if finfo.name == field_name:
                        found_fi = fi
                        found_type_name = finfo.type_name.clone()
                        break
                    fi += 1
            if found_fi >= 0:
                int field_type = resolve_field_gir_type(found_type_name, &gmod)
                # A.2 (2026-05-22) — emit GIFieldLoad with Ptr-typed dst
                # for resource fields; value-typed dst for non-resource
                # fields. Mirrors Rust `Instruction::FieldLoad` lowering
                # at `src/lir/lower/insts.rs:800-869`. The Ptr-typed-dst
                # variant lets the LIR dispatch pick the POINTER-ALIAS
                # path (no byte-copy) for collection-/string-/struct-
                # holding fields — eliminating the silent
                # `field.push(...)` writeback class of bugs that motivated
                # the EMethodCall writeback hack at line ~4154.
                #
                # For non-resource fields (int, bool, simple structs)
                # the dst stays value-typed and the LIR emits a byte-copy
                # ILoad — observationally identical to the previous
                # `__field_read_*` GICallExtern path.
                #
                # `set_field_borrow(&ctx, fdst, base, found_fi)` writes
                # the BoField(base, field_idx) origin payload that C.1
                # provisioned but no caller wired. E.1 reads it back
                # in the return-path validator; Phase C validators read
                # it to flag escaping borrows. Replaces the
                # `BoField(-1, -1)` sentinel from Phase D step 2.
                bool field_is_resource = is_resource_type_name(found_type_name, &gmod)
                int dst_type_id = field_type
                if field_is_resource:
                    dst_type_id = register_ptr(&gmod, field_type)
                int fdst = add_local_with(&ctx, dst_type_id, NO_NAME, LoBorrowed(), BoNone())
                set_field_borrow(&ctx, fdst, base, found_fi)
                emit(&ctx, GIFieldLoad(fdst, base, found_fi))
                return fdst
            # HARD BUG: unknown field access fell through to I64/0
            # placeholder, losing both the struct identity and the field
            # type. Every downstream read of the "field value" sees 0 and
            # is typed int64 — responsible for the cascade of PConstructor
            # failures in stage-1 output. Report each miss with the base
            # type name and field name so the root cause is visible.
            diag_bug("EFieldAccess", "in fn '" + ctx.current_fn_name + "': unknown field '" + field_name + "' on base type '" + base_type_name + "' — returning I64(0) placeholder (WRONG)")
            int fdst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(fdst, OpConstI64(0)))
            return fdst
        case EIndex(base_box, idx_box):
            # `base[idx]` value-READ → collection getter call. Mirrors
            # `lower_index_assign` (the LHS-write twin, ~:7662): dispatch
            # the getter on the base's collection_kind, NOT a name match.
            # Vector/Deque → gorget_array_get, Dict → gorget_map_get.
            # The base (a collection) + index (int/key) are independently
            # typed, NOT the EIndex's destination — clear the enclosing
            # `expected_type` so a Result-typed surrounding context (e.g.
            # `return v[pick()]` from a `throws` fn) doesn't make the
            # centralized auto-prop hook's capture-form check suppress the peel
            # on a throws-call index (snag49c). Mirrors the binop-operand clear.
            int prev_expected_eix = ctx.expected_type
            ctx.expected_type = -1
            int eix_base = lower_expr(&ctx, *base_box, &gmod)
            int eix_idx = lower_expr(&ctx, *idx_box, &gmod)
            ctx.expected_type = prev_expected_eix
            eix_idx = maybe_auto_propagate(&ctx, eix_idx, &gmod)
            # Base type name, unwrapping a Ptr/MutPtr param/static base.
            int eix_base_tid = ctx.locals.get(eix_base).unwrap().type_id
            String eix_base_name = type_id_to_name(eix_base_tid, &gmod)
            if eix_base_tid >= 0 and eix_base_tid < gmod.type_table.len():
                GirType eix_bt = gmod.type_table.get(eix_base_tid).unwrap()
                match eix_bt:
                    case GtPtr(eix_inner):
                        eix_base_name = type_id_to_name(eix_inner, &gmod)
                    case GtMutPtr(eix_inner2):
                        eix_base_name = type_id_to_name(eix_inner2, &gmod)
                    else:
                        pass
            String eix_getter = ""
            match resource_meta_for(&gmod, eix_base_name):
                case Some(eix_rmeta):
                    match eix_rmeta.collection_kind:
                        case CkVector():
                            eix_getter = "gorget_array_get"
                        case CkDeque():
                            eix_getter = "gorget_array_get"
                        case CkDict():
                            eix_getter = "gorget_map_get"
                        else:
                            pass
                case None:
                    pass
            if eix_getter == "":
                # Unsupported base (Set has no index-read, unknown type):
                # keep the legacy I64/0 placeholder rather than crash.
                int idst = add_local(&ctx, I64_TYPE, NO_NAME)
                emit(&ctx, GIAssign(idst, OpConstI64(0)))
                return idst
            # Element type NAME — Vector/Deque via collection_element_type,
            # Dict via the value-type suffix (mirrors infer_method_return_type
            # ~:4063-4072). Empty → fall back to the I64/0 placeholder.
            String eix_elem_name = collection_element_type(eix_base_name)
            if eix_elem_name == "":
                if eix_base_name.starts_with("Dict__GorgetString__"):
                    eix_elem_name = eix_base_name.slice(20, eix_base_name.len())
                elif eix_base_name.starts_with("Dict__int64_t__"):
                    eix_elem_name = eix_base_name.slice(15, eix_base_name.len())
                elif eix_base_name.starts_with("HashMap__GorgetString__"):
                    eix_elem_name = eix_base_name.slice(23, eix_base_name.len())
                elif eix_base_name.starts_with("HashMap__int64_t__"):
                    eix_elem_name = eix_base_name.slice(18, eix_base_name.len())
            if eix_elem_name == "":
                int idst = add_local(&ctx, I64_TYPE, NO_NAME)
                emit(&ctx, GIAssign(idst, OpConstI64(0)))
                return idst
            String eix_elem_norm = eix_elem_name
            if eix_elem_name == "Str":
                eix_elem_norm = "GorgetString"
            int eix_elem_tid = resolve_field_gir_type(eix_elem_norm, &gmod)
            # MANDATORY 3-way dst split (a 2-way split regresses
            # leak_game_loop):
            #   (a) scalar elem (< PRIM_COUNT): BARE element type — the
            #       lir_lower scalar-deref ILoad derefs the void*.
            #   (b) runtime-RESOURCE elem (String/Array/Map/…): GtPtr(elem)
            #       LoBorrowed — op_consume clones at owning boundaries.
            #   (c) NON-resource non-scalar elem (a plain struct): BARE
            #       element type BY VALUE — lir_lower emits an aggregate
            #       `*(StructT*)(void*)` copy-out for the raw
            #       gorget_array_get/gorget_map_get getter.
            #   (d) truly-UNREGISTERED elem (< 0): FALL BACK to the I64/0
            #       stub.
            int idst = -1
            if eix_elem_tid < PRIM_COUNT:
                idst = add_local(&ctx, eix_elem_tid, NO_NAME)
            elif is_resource_type_name(eix_elem_norm, &gmod):
                int eix_ptr_tid = register_ptr(&gmod, eix_elem_tid)
                idst = add_local_with(&ctx, eix_ptr_tid, NO_NAME, LoBorrowed(), BoNone())
            elif eix_elem_tid >= 0:
                idst = add_local(&ctx, eix_elem_tid, NO_NAME)
            else:
                idst = add_local(&ctx, I64_TYPE, NO_NAME)
                emit(&ctx, GIAssign(idst, OpConstI64(0)))
                return idst
            # index/key MUST be OpBorrow (NOT OpCopy — OpCopy on a String
            # dict key trips validate_resource_moves → lowerer crashes).
            Vector[Operand] eix_args = [OpBorrow(eix_base), OpBorrow(eix_idx)]
            emit(&ctx, GICallExtern(idst, eix_getter, eix_args))
            return idst
        case EIf(cond_box, then_body, else_branches):
            # If-as-EXPRESSION (`int x = if c: a else: b`). Mirrors Rust
            # `build_if_chain_expr` via the shared helper: lower each
            # branch's block as a tail value and assign it into a single
            # `result` local at the merge. The same helper backs the
            # SIf-as-tail-value case in `lower_stmt_as_tail_value`, so a
            # nested `if` ending a branch body becomes a value too.
            return lower_if_chain_expr(&ctx, *cond_box, then_body, else_branches, &gmod)
        case ENoneLiteral():
            # Bare `None` literal — when expected_type is a typed
            # `Option__T`, emit a properly-TYPED `None` ctor call
            # that routes through `try_lower_prelude_variant`'s
            # canonical `IEnumInit(slot, struct_id, tag=1, [])` at
            # LIR. Mirrors Rust gg's
            # `materialise_none_for_expected_type` at
            # `src/ir/lowering/exprs/mod.rs:2504-2529`. Without
            # expected_type set, fall back to the legacy
            # UNIT/OpConstUnit shape — `Constant::Null` in Rust —
            # which the SVarDecl/SAssign Assign handler may rewrite
            # downstream if it sees a typed dst slot.
            if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
                String et_name_nl = type_id_to_name(ctx.expected_type, &gmod)
                if et_name_nl.starts_with("Option__") and not et_name_nl.starts_with("Option__Ref__"):
                    int ndst_nl = add_local(&ctx, ctx.expected_type, NO_NAME)
                    Vector[Operand] none_args_nl = []
                    emit(&ctx, GICallExtern(ndst_nl, "None", none_args_nl))
                    return ndst_nl
            int dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstUnit()))
            return dst
        case ECharLiteral(ch):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstStr(ch)))
            return dst
        case EArrayLiteral(elems):
            # Consume element-type hint set by SVarDecl (`Vector[T] x = []`).
            # An empty hint means the declared type was not a concrete
            # Vector[T] — fall back to pointer size, which is correct for
            # scalar-element Vectors used as temporaries.
            String vec_tyname = ctx.pending_vec_elem_tyname
            ctx.pending_vec_elem_tyname = ""
            # ADD-only fallback: when no pending hint was set, try
            # deriving elem type from `ctx.expected_type` (Rust counterpart
            # `src/ir/lowering/exprs/collections.rs:27,46-49,62` — the
            # empty-array branch reads expected_type to size the array
            # buffer). This closes empty-array literals at writer sites
            # that already set expected_type but didn't set the
            # `pending_vec_elem_tyname` side-channel (e.g. EStructLiteral's
            # field-init port above; the call-arg loop's per-arg expected
            # type). NOT a replacement for the pending-name protocol —
            # that wins when set; this is the fallback for when it isn't.
            if vec_tyname == "" and ctx.expected_type >= 0:
                String eali_outer_name = type_id_to_name(ctx.expected_type, &gmod)
                String eali_elem_name = collection_element_type(eali_outer_name)
                if eali_elem_name != "":
                    vec_tyname = eali_elem_name
            # Lower each element — we'll push them in order after the
            # array is constructed. Need to keep the value locals around
            # so we can reference them in the subsequent push calls.
            # Per-element expected_type propagation (Rust counterpart
            # `src/ir/lowering/exprs/collections.rs:49-63`): when the
            # outer is a collection (Vector/Deque/Set/HashSet — same
            # wider gate as STEP 2.4 elem-size fallback above; type-
            # checker rejects non-array shapes upstream), propagate the
            # element type INTO each element's lower_expr via
            # ctx.expected_type. This resolves e.g.
            # `Vector[Option[int]] v = [None(), Some(1)]` per-element
            # None() to Option__int instead of bare Constant::Null.
            # Restored unconditionally after the loop. Same I64/UNIT
            # guard as SVarDecl / SAssign / SReturn / call-arg sites.
            int prev_eali_et = ctx.expected_type
            String eali_outer_name2 = ""
            String eali_elem_name2 = ""
            if ctx.expected_type >= 0:
                eali_outer_name2 = type_id_to_name(ctx.expected_type, &gmod)
                eali_elem_name2 = collection_element_type(eali_outer_name2)
            if elems.len() > 0 and eali_elem_name2 != "":
                int eali_et_new = lookup_or_register_named(&gmod, eali_elem_name2)
                if eali_et_new != I64_TYPE and eali_et_new != UNIT_TYPE:
                    ctx.expected_type = eali_et_new
            Vector[int] elem_locals = []
            for elem in elems:
                int elem_val = lower_expr(&ctx, elem, &gmod)
                elem_locals.push(elem_val)
            ctx.expected_type = prev_eali_et
            # Call gorget_array_new(elem_size) so the resulting array has a
            # valid `alloc` pointer from __gorget_current_alloc. Without
            # this, subsequent `.push()` on a zero-init'd GorgetArray
            # segfaults dereferencing arr->alloc->realloc(...).
            # With a type hint we emit a magic call `__gorget_array_new_sized_<T>()`
            # which the C codegen expands to `gorget_array_new(sizeof(T))` —
            # that's the only way for the size to track the real aggregate
            # footprint (e.g. 128 bytes for LirStructDef). Without the hint
            # we fall back to 8, which still works for pointer-/int-sized
            # element types (the common case for local temporaries).
            int adst = add_local(&ctx, lookup_or_register_named(&gmod, "GorgetArray"), NO_NAME)
            if vec_tyname != "":
                String magic_name = "__gorget_array_new_sized_" + vec_tyname
                Vector[Operand] an_args_typed = []
                emit(&ctx, GICallExtern(adst, magic_name, an_args_typed))
            else:
                Vector[Operand] an_args = [OpConstI64(8)]
                emit(&ctx, GICallExtern(adst, "gorget_array_new", an_args))
            # Push each element into the just-created Vector. Without
            # this, `[!init_insts]` and similar "array literal with
            # explicit elements" produced an EMPTY array, and any
            # subsequent `.get(0)` returned NULL.
            # `gorget_array_push` mutates the array in place THROUGH a
            # pointer — the receiver is a borrow, NOT a consumed value. It
            # must use OpBorrow(adst): `adst` is live past every push (the
            # next iteration pushes again, and `return adst` hands the
            # filled array out). Passing OpMove(adst) tripped drop-emission's
            # "owned but live-past → clone before call" rule, so each push
            # mutated a throwaway CLONE while the original `adst` stayed
            # empty — `[!init_insts]` then returned a 0-length array and the
            # first `emit()` paniced (index 0, length 0). Follows the
            # gorget_array_push pass-self-by-pointer (OpBorrow) convention.
            # The element keeps OpMove — it IS consumed into the array.
            for el in elem_locals:
                Vector[Operand] push_args = [OpBorrow(adst), OpMove(el)]
                emit(&ctx, GICallExtern(-1, "gorget_array_push", push_args))
            return adst
        case ETupleLiteral(elems):
            for te in elems:
                lower_expr(&ctx, te, &gmod)
            int tdst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(tdst, OpConstI64(0)))
            return tdst
        case EStructLiteral(sname, fnames, fvals):
            # Expected-type propagation per field (Rust counterpart
            # `src/ir/lowering/exprs/mod.rs:1867-1890`). For each positional
            # field-init expr, set `ctx.expected_type` to that field's
            # declared type via `gmod.type_infos` BEFORE lowering — so reader
            # sites (bare prelude-variant ctors, bare `None`, empty array
            # literals consuming elem-size from expected_type, EIdentifier)
            # resolve to the field's declared shape instead of an
            # 8-byte default. Mirrors `apply_container_hint_for_ctor_arg`'s
            # GirTypeInfo lookup at `lower.gg:~5432-5441`. Restored
            # unconditionally after each lower_expr. Same I64/UNIT guard as
            # SVarDecl / SAssign / SReturn / call-arg sites.
            # CoW for-element BORROW scan (no SpannedExpr__clone): sv is only
            # read by lower_expr's immutable-borrow param; enumerate() preserves
            # the positional index sli_i used for the field-type pairing.
            for (sli_i, sv) in fvals.enumerate():
                int prev_expected_sli = ctx.expected_type
                if gmod.type_infos.contains(sname):
                    GirTypeInfo sli_ti = gmod.type_infos.get(sname).unwrap()
                    if not sli_ti.is_enum and sli_i < sli_ti.fields.len():
                        String sli_fty_name = sli_ti.fields.get(sli_i).unwrap().type_name.clone()
                        if sli_fty_name != "":
                            int sli_fty = lookup_or_register_named(&gmod, sli_fty_name)
                            if sli_fty != I64_TYPE and sli_fty != UNIT_TYPE:
                                ctx.expected_type = sli_fty
                lower_expr(&ctx, sv, &gmod)
                ctx.expected_type = prev_expected_sli
            int sdst = add_local(&ctx, lookup_or_register_named(&gmod, sname), NO_NAME)
            emit(&ctx, GIAssign(sdst, OpConstI64(0)))
            return sdst
        case EClosure(cparams, cbody):
            # closure Phase 2 Step A/B: the make-site is the SOLE closure-id
            # source + recorder. Take the cid from gmod_next_closure_id, build
            # the GorgetClosure value, AND push a LiftedClosure record. The
            # post-pass (sole pusher of __Closure_N__call) drains
            # lifted_closures after the lower_function loop.
            int cid = gmod_next_closure_id(&gmod)
            String closure_name = "__Closure_" + int_to_str(cid)
            # The closure value at the GIR level is a GorgetClosure struct
            # (not __Closure_N which is the captured-vars env struct).
            int closure_tid = lookup_or_register_named(&gmod, "GorgetClosure")
            ClosureSig cl_sig = compute_closure_sig(cid, cparams, cbody, &gmod)
            # ── Step B (§4a/§4b): collect + classify ByValue captures. ──
            # The collector mirrors the Phase-1 detector's walk EXACTLY (same
            # capture-shaped criterion, scoping, nested-skip); `unliftable` is
            # the safety net (a capture-shaped var that is NOT a genuine outer
            # local → STUB, as Phase 1 would). This is now the SOLE lowering-
            # decision input for the EClosure make-site; the Phase-1 inverted
            # `closure_body_captures` is no longer consulted HERE (still used
            # at the inline-spawn make-site, so it stays defined).
            CaptureCollector cl_cc = collect_closure_captures(&ctx, cparams, cbody, &gmod)
            # Bind the collector result into owned locals so the `!cl_caps`
            # move at the LiftedClosure push below doesn't invalidate `cl_cc`
            # mid-use (a field move is a whole-value move at the BC layer).
            bool cl_unliftable = cl_cc.unliftable
            Vector[ClosureCapture] cl_caps = cl_cc.caps.clone()
            # 2a guard (§4b): lift ONLY IF — (a) no UNLIFTABLE capture-shaped
            # var; AND (b) every capture's type_id ∈ {BOOL,I64,F64} (the
            # type_id_to_name-faithful primitive subset) OR a byte-copyable
            # COPY struct OR a RESOURCE (Phase 2b: String/Vector/resource-
            # struct — env owns an independent snapshot via op_consume's
            # clone-or-move, body reads through a Ptr-alias field-load);
            # AND (c) no captured local is mutated in the body; AND (d) no
            # nested closure.
            bool cl_caps_ok = not cl_unliftable
            int cl_ci = 0
            while cl_ci < cl_caps.len():
                int cl_ctid = cl_caps.get(cl_ci).unwrap().type_id
                if cl_ctid != BOOL_TYPE and cl_ctid != I64_TYPE and cl_ctid != F64_TYPE:
                    # 2b-1: accept a byte-copyable COPY struct — a
                    # registered non-resource non-enum struct (e.g.
                    # `Config{int,int}`). The env-field build + IStructInit /
                    # GIFieldLoad byte-copy paths already handle it (no
                    # clone/drop machinery).
                    # 2b-2 (Phase 2b): ALSO accept a RESOURCE capture
                    # (String/Vector/resource-struct — is_resource_type_name).
                    # The make-site env-ctor arg routes through
                    # op_consume(CkFieldWrite) so a LIVE owned source CLONES
                    # and a DEAD owned source MOVES — the env owns an
                    # INDEPENDENT snapshot. The body field-loads it as a
                    # Ptr-alias (see lower_closure_body §4e) so it borrows
                    # the env's storage and auto-clones at owning boundaries
                    # (no body-side double-free). A NON-resource enum (a plain
                    # user enum, or a primitive-payload optionlike like
                    # `Option[int]`) still STUBs (no enum clone-through wired at
                    # the ctor arg yet); a RESOURCE-payload optionlike
                    # (`Option[String]`, droppable per optionlike_resource_types)
                    # IS admitted here via `cl_is_resource` and handled by the
                    # resource clone path above.
                    String cl_tname = type_id_to_name(cl_ctid, &gmod)
                    bool cl_is_resource = is_resource_type_name(cl_tname, &gmod)
                    bool cl_is_copy_struct = gmod.type_infos.contains(cl_tname) and not cl_is_resource and not gmod.type_infos.get(cl_tname).unwrap().is_enum
                    if not (cl_is_resource or cl_is_copy_struct):
                        cl_caps_ok = false
                cl_ci += 1
            # (c) mutation check — build the capture-name set, then scan.
            if cl_caps_ok and cl_caps.len() > 0:
                Dict[String, bool] cl_cap_names = {}
                int cl_cni = 0
                while cl_cni < cl_caps.len():
                    cl_cap_names.put(cl_caps.get(cl_cni).unwrap().name.clone(), true)
                    cl_cni += 1
                if stmts_mutate_any(cbody, cl_cap_names):
                    cl_caps_ok = false
            # (d) nested-closure guard (retain the Phase-1 guard).
            bool cl_nested = stmts_have_nested_closure(cbody)
            bool cl_lowerable = cl_caps_ok and not cl_nested
            bool cl_has_caps = cl_caps.len() > 0
            int cdst = add_local(&ctx, closure_tid, NO_NAME)
            if cl_lowerable and cl_has_caps:
                # ── §4c: register __Closure_N's FIELDS at the MAKE-SITE. ──
                # type_id_to_name is FAITHFUL for the §4b-restricted set
                # (bool/int64_t/double); the guard above guarantees no capture
                # reaches a width it would mis-name as int64_t. LIR Pass-2
                # then fills LirStructDef.fields → codegen stops emitting the
                # `char __pad` placeholder. (NOT in compute_closure_sig, which
                # also runs for stub closures.)
                Vector[GirFieldInfo] cl_env_fields = []
                int cl_fi = 0
                while cl_fi < cl_caps.len():
                    ClosureCapture cl_cap = cl_caps.get(cl_fi).unwrap()
                    # §4c-2 (Phase 2b): the env field OWNS the pointee T, never
                    # a Ptr. If a ByValue capture's type_id is a Ptr(T)/MutPtr(T)
                    # CoW-alias (mirrors Rust closures.rs:128-130 "Resolve
                    # Ptr(T) → T for CoW aliases"), name the field by the OWNED
                    # pointee T — op_consume's clone-through (decide_ptr_consume)
                    # materialises the owned value into it. Value-typed
                    # resource/COPY captures keep their own name. (Self-host's
                    # SVarDecl Branch-C-pre already keeps most CoW aliases
                    # value-typed, so this is mostly defensive parity; it makes
                    # the field-owns-pointee invariant explicit at the source.)
                    int cl_field_tid = cl_cap.type_id
                    if cl_field_tid >= 0 and cl_field_tid < gmod.type_table.len():
                        match gmod.type_table.get(cl_field_tid).unwrap():
                            case GtPtr(cl_pointee):
                                cl_field_tid = cl_pointee
                            case GtMutPtr(cl_pointee2):
                                cl_field_tid = cl_pointee2
                            else:
                                pass
                    cl_env_fields.push(GirFieldInfo(cl_cap.name.clone(), type_id_to_name(cl_field_tid, &gmod)))
                    cl_fi += 1
                # ② closure ENV-FIELD leak fix — compute "does the heap env own
                # >=1 RESOURCE field" BEFORE the `!cl_env_fields` move below.
                # `cl_env_fields[i].type_name` is the OWNED pointee name
                # (Ptr->pointee already resolved at §4c-2), so a resource check
                # on it is the exact "this field needs freeing on drop" signal.
                bool cl_env_owns_resource = false
                int cl_ri = 0
                while cl_ri < cl_env_fields.len():
                    if is_resource_type_name(cl_env_fields.get(cl_ri).unwrap().type_name, &gmod):
                        cl_env_owns_resource = true
                    cl_ri += 1
                Vector[GirEnumVariantInfo] cl_no_variants = []
                gmod.type_infos.put(closure_name.clone(), GirTypeInfo(closure_name.clone(), !cl_env_fields, !cl_no_variants, false))
                # ── §4d: build a struct-ctor of __Closure_N (capture sources
                # as field args) → the user-struct-ctor intercept turns it
                # into an IStructInit (a STACK env). Use GICall (NOT
                # GICallExtern) so try_lower_user_struct_ctor fires. Then
                # assign that __Closure_N value into the GorgetClosure slot —
                # the step-5 LIR closure-pack promotion packs it onto the heap.
                int cl_env_tmp = add_local(&ctx, lookup_or_register_named(&gmod, closure_name), NO_NAME)
                Vector[Operand] cl_ctor_args = []
                int cl_ai = 0
                while cl_ai < cl_caps.len():
                    # §4d-2 (Phase 2b): route the capture source through
                    # op_consume at an OWNING (CkFieldWrite) position — the
                    # env field OWNS its data. A LIVE owned resource → OpClone
                    # (the wire pass keeps it for live sources; e.g.
                    # `String s` printed after the make-site MUST clone, not
                    # move); a DEAD owned resource → OpMove (refined by the
                    # liveness wire pass); a Ptr/borrow-alias → OpClone through
                    # the pointer (decide_ptr_consume). Primitives / COPY
                    # structs fall to OpCopy inside op_consume, identical to
                    # the prior raw OpCopy. So the env always holds an
                    # INDEPENDENT snapshot, never a shared alias.
                    cl_ctor_args.push(op_consume(&ctx, &gmod, cl_caps.get(cl_ai).unwrap().local_id, CkFieldWrite()))
                    cl_ai += 1
                emit(&ctx, GICall(cl_env_tmp, closure_name.clone(), cl_ctor_args))
                emit(&ctx, GIAssign(cdst, OpCopy(cl_env_tmp)))
                # ② closure ENV-FIELD leak fix — record the GorgetClosure value's
                # `cdst` local -> `__Closure_N` ONLY when the heap env owns >=1
                # RESOURCE field (a droppable SNAPSHOT — flag computed above,
                # before `cl_env_fields` was moved). A pure-primitive / COPY-
                # struct env has no `__Closure_N__drop` generated, so recording
                # it would be a harmless no-op — but we gate to keep the
                # channel's invariant tight (an entry => a real per-field dtor
                # exists). The SVarDecl MoveDirect arm copies this onto the fresh
                # dropped `var_local`; the read site at the GorgetClosure
                # GIDropIfAlive routes through `__Closure_N__drop`.
                if cl_env_owns_resource:
                    gmod.closure_env_type.put(ctx.current_fn_name + "\0" + int_to_str(cdst), closure_name.clone())
            else:
                # lowerable+no-captures OR stubbed → keep the Step-A
                # __make_closure_N NULL-env path. (Stubbed stays WRONG as
                # today; 2b/2c fix.)
                String make_fn = "__make_closure_" + int_to_str(cid)
                Vector[Operand] make_args = []
                gmod.fn_sigs.put(make_fn, closure_tid)
                emit(&ctx, GICallExtern(cdst, make_fn, make_args))
            # Record the closure for the post-pass, carrying the captures so
            # the post-pass field-loads them before lowering the body.
            gmod.lifted_closures.push(LiftedClosure(cid, closure_name + "__call", cl_sig.self_ptr, cl_sig.abi_param_types, cl_sig.body_param_types, cl_sig.body_param_names, cl_sig.return_type, cbody, false, cl_lowerable, !cl_caps))
            return cdst
        case EAs(inner_box, _):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EMove(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EMutableBorrow(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDeref(inner_box):
            # `*box` — actually load the inner value. The inner AST is
            # lowered to a local of type `Box[T]` (void* at C level). We
            # need to emit a load so downstream code that passes the
            # result to a function expecting `T` works.
            int dsrc = lower_expr(&ctx, *inner_box, &gmod)
            int dsrc_tid = ctx.locals.get(dsrc).unwrap().type_id
            String dsrc_tname = type_id_to_name(dsrc_tid, &gmod)
            # Phase A typed read: BkRegularBox identifies parameterised
            # Box[T]; the bare trait Box's no-suffix name doesn't reach
            # an EDeref site (a trait box deref goes through vtable
            # dispatch, not raw pointer load).
            bool dsrc_is_box = false
            match resource_meta_for(&gmod, dsrc_tname):
                case Some(rmeta):
                    match rmeta.box_kind:
                        case BkRegularBox():
                            dsrc_is_box = true
                        else:
                            pass
                case None:
                    pass
            if dsrc_is_box:
                # The inner name is the post-`Box__` suffix of the mangled
                # name (e.g. "Box__SpannedExpr" -> "SpannedExpr").
                String d_inner_name = dsrc_tname.slice(5, dsrc_tname.len())
                int d_inner_tid = resolve_field_gir_type(d_inner_name, &gmod)
                # Phase 3 (Class 8): see EFieldAccess box-deref site
                # at line ~4246 for the architectural rationale —
                # the deref-inner aliases the box's heap, inherit
                # source's borrow tag rather than freshly LoOwn.
                int ddst = add_local_inheriting(&ctx, d_inner_tid, NO_NAME, dsrc)
                emit(&ctx, GIDeref(ddst, dsrc, d_inner_tid))
                return ddst
            return dsrc
        case ETry(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDotShorthand(variant, sargs):
            for da in sargs:
                lower_expr(&ctx, da, &gmod)
            int ddst = add_local(&ctx, I64_TYPE, NO_NAME)
            return ddst
        case EBlock(block_stmts):
            # Block in value position — lower via `lower_block_expr` and return
            # its tail value (was dropping it into a fresh UNIT local). Mirrors
            # Rust `lower_expr` Block dispatch (`exprs/mod.rs` → lower_block_expr
            # `:3203`), sibling of the EMatch/EIf value-position cases.
            return lower_block_expr(&ctx, block_stmts, &gmod)
        case EDo(do_stmts):
            # `do:` block in value position — same as EBlock: lower the block
            # and return its tail value (was falling to the UNIT `else`). Also
            # covers multi-line `catch` recovery bodies (parser.gg:1700-1713).
            return lower_block_expr(&ctx, do_stmts, &gmod)
        case ESelfExpr():
            if nl_contains(&ctx, "self"):
                return nl_get(&ctx, "self")
            int sdst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            return sdst
        case EDefaultOp(lhs_box, rhs_box):
            lower_expr(&ctx, *lhs_box, &gmod)
            return lower_expr(&ctx, *rhs_box, &gmod)
        case EIs(inner_box, negated, pattern):
            # `x is Pattern` — test the scrutinee against the pattern and
            # bind any sub-pattern names into the function-scope named
            # locals. Mirrors Rust gg's `Expr::Is` lowering (src/ir/lowering/
            # exprs/mod.rs:649) + `emit_is_bindings` (stmts/mod.rs:2643)
            # collapsed into one site — `lower_pattern_match` does both
            # the tag-test and the field-extract, and `nl_put` is
            # function-scoped so the bindings remain visible in the
            # then-branch of any enclosing `if x is Some(k):`.
            int scrutinee = lower_expr(&ctx, *inner_box, &gmod)
            int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
            String type_name = type_id_to_name(scr_tid, &gmod)
            # Unwrap Ptr/MutPtr — borrowed scrutinees show up as Ptr(T).
            if scr_tid >= 0 and scr_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(scr_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    case GtMutPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    else:
                        pass
            String enum_name = match_enum_type(type_name, &gmod)
            int match_bb = new_block(&ctx)
            int no_match_bb = new_block(&ctx)
            int merge_bb = new_block(&ctx)
            int isdst = add_local(&ctx, BOOL_TYPE, NO_NAME)
            lower_pattern_match(&ctx, scrutinee, *pattern, enum_name, match_bb, no_match_bb, &gmod)
            # Match path: scrutinee matched the pattern. Bindings already
            # emitted in lower_pattern_match's bind_bb upstream.
            switch_to(&ctx, match_bb)
            bool match_val = true
            if negated:
                match_val = false
            emit(&ctx, GIAssign(isdst, OpConstBool(match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            # No-match path.
            switch_to(&ctx, no_match_bb)
            bool no_match_val = false
            if negated:
                no_match_val = true
            emit(&ctx, GIAssign(isdst, OpConstBool(no_match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            switch_to(&ctx, merge_bb)
            return isdst
        case EAwait(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case ESpawn(inner_box):
            # closure Phase 2 Step A: inline-spawn `spawn ((): body)(args)`.
            # The ECall make-site arm only handles EIdentifier/EFieldAccess
            # callees, so an EClosure callee would otherwise be DROPPED. Peek
            # for the inline-closure shape: if found, take the cid, push the
            # `__spawn_wrap___Closure_N` stub (the exact stub the old scan
            # pushed), record a LiftedClosure (so the post-pass pushes its
            # `__Closure_N__call`), lower the args (so capturing-closure args
            # aren't silently dropped), and return a value local. Else fall
            # back to the bare passthrough. (Real spawn/await wiring is out of
            # scope — fn-count parity is the gate.)
            match (*inner_box).expr:
                case ECall(spawn_callee_box, spawn_args, _):
                    match (*spawn_callee_box).expr:
                        case EClosure(sp_params, sp_body):
                            int sp_cid = gmod_next_closure_id(&gmod)
                            String sp_closure_name = "__Closure_" + int_to_str(sp_cid)
                            # Push the inline-spawn wrapper stub (unconditional,
                            # matching the old scan's inline-spawn wrapper push).
                            String sp_wrap_name = "__spawn_wrap_" + sp_closure_name
                            Vector[int] sp_wp = []
                            Vector[GirLocal] sp_wl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone(), false)]
                            Vector[BasicBlock] sp_wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                            gmod.functions.push(GirFunction(sp_wrap_name, !sp_wp, UNIT_TYPE, !sp_wl, !sp_wb))
                            # Record the closure (lowerable guard identical to
                            # the EClosure arm) so the post-pass pushes its
                            # __Closure_N__call.
                            ClosureSig sp_sig = compute_closure_sig(sp_cid, sp_params, sp_body, &gmod)
                            bool sp_lowerable = not (closure_body_captures(sp_params, sp_body, &gmod) or stmts_have_nested_closure(sp_body))
                            # inline-SPAWN closures: capture support is DEFERRED
                            # (stay stubbed-if-capturing). Pass empty captures.
                            Vector[ClosureCapture] sp_no_caps = []
                            gmod.lifted_closures.push(LiftedClosure(sp_cid, sp_closure_name + "__call", sp_sig.self_ptr, sp_sig.abi_param_types, sp_sig.body_param_types, sp_sig.body_param_names, sp_sig.return_type, sp_body, false, sp_lowerable, !sp_no_caps))
                            # Lower the spawn-call args for side effects (don't
                            # drop them, as the old ECall else:pass did).
                            for sp_arg in spawn_args:
                                lower_expr(&ctx, sp_arg, &gmod)
                            int sp_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                            emit(&ctx, GIAssign(sp_dst, OpConstUnit()))
                            return sp_dst
                        else:
                            return lower_expr(&ctx, *inner_box, &gmod)
                else:
                    return lower_expr(&ctx, *inner_box, &gmod)
        case ESpawnBlocking(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDictLiteral(dkeys, dvals):
            # `{}` / `{k: v, …}` — lower each key/value for side effects,
            # then call the appropriate constructor to produce a map with
            # valid `alloc`. Dict[K,V] → insertion-order-preserving
            # (gorget_dict_new*); HashMap[K,V] → unordered (gorget_map_new*).
            # Without a hint from SVarDecl the sizes fall back to 8
            # (pointer/int); with the hint we emit a magic sentinel name
            # `__gorget_{dict,map}_new_sized_K__<K>__V__<V>` which the
            # codegen expands to `gorget_{dict,map}_new(sizeof(K), sizeof(V))`
            # — required whenever K or V is an aggregate (LirStructDef et al.).
            String dict_kname = ctx.pending_dict_key_tyname
            String dict_vname = ctx.pending_dict_val_tyname
            bool dict_ordered = ctx.pending_dict_ordered
            ctx.pending_dict_key_tyname = ""
            ctx.pending_dict_val_tyname = ""
            ctx.pending_dict_ordered = false
            # Lower each (key, value) pair into fresh locals so we can
            # `gorget_map_put` them into the constructed map below. The
            # previous code lowered keys/values for side effects ONLY and
            # DISCARDED the locals, so a `static Dict[K,V] M={"a":1}`
            # produced an EMPTY map (the entries were never inserted).
            # Mirrors Rust `lower_dict_literal` (src/ir/lowering/exprs/
            # collections.rs:338-388): lower the KEY first (keys are not
            # value-typed), then set the value-override expected_type from
            # the declared V before lowering the VALUE, then restore.
            # Single paired loop — a separate value loop would double-lower
            # (double side effects + double owning temps).
            Vector[int] dict_key_locals = []
            Vector[int] dict_val_locals = []
            int dict_pair_n = dkeys.len()
            int dict_pi = 0
            int prev_dict_et = ctx.expected_type
            while dict_pi < dict_pair_n:
                # Keys + values are independently typed, NOT the dict's
                # destination type — clear the enclosing `expected_type` so a
                # Result-typed surrounding context (e.g. `return {"a": to_n(sel)}`
                # from a `throws` fn, where SReturn set expected_type to the
                # function's `Result[Dict..,E]` slot) doesn't make the
                # centralized auto-prop hook's capture-form check suppress the
                # peel on a throws-call value — leaving a raw `Result` memcpy'd
                # into the int slot (zero-init garbage). Mirrors the tuple/dict
                # per-element expected_type override+clear documented on the
                # throws_autoprop_dict_value fixture.
                ctx.expected_type = -1
                # Key first: keys can be any type, not V — lower BEFORE the
                # value-override (Rust collections.rs:338-340).
                int dict_key_local = lower_expr(&ctx, dkeys.get(dict_pi).unwrap(), &gmod)
                # Value-override from `dict_vname` when known (else -1 — let the
                # value type itself, e.g. the auto-prop'd Ok payload, decide).
                if dict_vname != "":
                    int dict_v_et = lookup_or_register_named(&gmod, dict_vname)
                    if dict_v_et != I64_TYPE and dict_v_et != UNIT_TYPE:
                        ctx.expected_type = dict_v_et
                int dict_val_local = lower_expr(&ctx, dvals.get(dict_pi).unwrap(), &gmod)
                dict_key_locals.push(dict_key_local)
                dict_val_locals.push(dict_val_local)
                dict_pi = dict_pi + 1
            ctx.expected_type = prev_dict_et
            int ddst = add_local(&ctx, lookup_or_register_named(&gmod, "GorgetMap"), NO_NAME)
            if dict_kname != "" and dict_vname != "":
                # Sentinel `__GGSEP__` separates K and V type names — zero
                # collision risk with real type names (no "GGSEP" pattern
                # appears in any monomorphized Gorget type).
                String magic_prefix = "__gorget_map_new_sized_"
                if dict_ordered:
                    magic_prefix = "__gorget_dict_new_sized_"
                String magic_dict = magic_prefix + dict_kname + "__GGSEP__" + dict_vname
                Vector[Operand] dn_args_typed = []
                emit(&ctx, GICallExtern(ddst, magic_dict, dn_args_typed))
            else:
                if dict_ordered:
                    Vector[Operand] dn_args_ord = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_dict_new", dn_args_ord))
                else:
                    Vector[Operand] dn_args = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_map_new", dn_args))
            # Insert each lowered (key, value) pair into the freshly-built
            # map. Mirrors `lower_index_assign:7392` and Rust `insert_pair`
            # (collections.rs:380-388/398-417). Both Dict (ordered) and
            # HashMap (unordered) use the SAME runtime mutator
            # `gorget_map_put` — no ordered/unordered split here.
            # `OpBorrow(ddst)` is REQUIRED: `ddst` is owned, live past every
            # put (the next iteration puts again) AND returned, so OpMove
            # would trip drop-emission's "owned but live-past → clone before
            # call" rule and each put would mutate a throwaway clone while
            # `ddst` stayed empty (same hazard the array arm documents at
            # :5804-5814). Both key AND value → CkCallArgOwning: gorget_map_put
            # is the NO-CLONE ownership-transfer variant — the map TAKES
            # ownership of both at this consuming position. Passing the key as
            # CkCallArgBorrow double-freed an owned String key (the put-loop
            # never zeroed the source, so drop-emission dropped it AND the map
            # later dropped its stored copy).
            int dict_put_i = 0
            while dict_put_i < dict_pair_n:
                Vector[Operand] put_args = [OpBorrow(ddst), op_consume(&ctx, &gmod, dict_key_locals.get(dict_put_i).unwrap(), CkCallArgOwning()), op_consume(&ctx, &gmod, dict_val_locals.get(dict_put_i).unwrap(), CkCallArgOwning())]
                emit(&ctx, GICallExtern(-1, "gorget_map_put", put_args))
                dict_put_i = dict_put_i + 1
            return ddst
        case ECatch(inner_box, error_binding, recovery_box):
            return lower_catch_expr(&ctx, *inner_box, error_binding, *recovery_box, &gmod)
        case ERethrow(inner_box, error_binding, _err_ty, transform_box):
            return lower_rethrow_expr(&ctx, *inner_box, error_binding, *transform_box, &gmod)
        case EMatch(scrut_box, arms):
            # `match` in value position — lower into one result local that
            # every reaching arm assigns. Mirrors Rust `lower_expr` EMatch
            # dispatch (`exprs/mod.rs:391`).
            return lower_match_expr(&ctx, *scrut_box, arms, &gmod)
        case EImplicitClosure(ic_body_box):
            # closure Phase 2 Step A: implicit `it` closure (`.map(it*2)`).
            # Make-site = sole id source + recorder, exactly like EClosure.
            # Subsumes the deleted emit_it_closure via the shared helper.
            return record_implicit_it_closure(&ctx, *ic_body_box, &gmod)
        case EIt():
            # closure Phase 2 Step A: `it` is a VALUE (the live implicit
            # param), NOT a closure. Mirror Rust exprs/mod.rs:417 — resolve
            # `it` to the in-scope param when present, else a UNIT local.
            # No cid bump, no record. When an implicit-it body is lowered in
            # the post-pass, "it" is registered as a named local so this
            # resolves to the param.
            if nl_contains(&ctx, "it"):
                return nl_get(&ctx, "it")
            int it_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            emit(&ctx, GIAssign(it_dst, OpConstUnit()))
            return it_dst
        else:
            # Remaining: ESetComp, EDictComp, EListComp, ERange
            int fallback = add_local(&ctx, UNIT_TYPE, NO_NAME)
            emit(&ctx, GIAssign(fallback, OpConstUnit()))
            return fallback

# ── Call lowering ────────────────────────────────────────

# Set ctx.pending_*_tyname hints for a container-literal arg at a struct
# constructor call site. Early-exits when arg is NOT an empty container
# literal — the normal-case fast path — so per-arg overhead stays O(1)
# in the common case. Only when we've identified a container literal do
# we pay for the `gmod.type_infos.get(ctor_name)` lookup (a Dict probe +
# GirTypeInfo copy).
void apply_container_hint_for_ctor_arg(LowerCtx &ctx, String ctor_name, int ai, SpannedExpr arg, GirModule &gmod):
    # Fast reject for non-container-literal args (the common case).
    bool is_arr_lit = false
    bool is_dict_lit = false
    match arg.expr:
        case EArrayLiteral(_):
            is_arr_lit = true
        case EDictLiteral(_, _):
            is_dict_lit = true
        else:
            return
    # Look up the ctor's field type. Avoid value-copying GirTypeInfo
    # (its nested Vectors don't survive a shallow clone in stage-1).
    String fty_name = ""
    if gmod.type_infos.contains(ctor_name):
        GirTypeInfo cti_info = gmod.type_infos.get(ctor_name).unwrap()
        if cti_info.is_enum:
            return
        if ai >= cti_info.fields.len():
            return
        fty_name = cti_info.fields.get(ai).unwrap().type_name.clone()
    if fty_name == "":
        return
    if is_arr_lit:
        if fty_name.starts_with("Vector__"):
            # `.slice(...)` returns a view (cap=0) into fty_name's buffer;
            # fty_name is dropped at function exit and the view becomes
            # dangling. Materialize to an owned String before storing on
            # the LowerCtx field — the downstream magic-name concat would
            # otherwise read stale bytes and emit garbage like
            # `sizeof(��0XA./)` in stage-1's C.
            String elem_slice = fty_name.slice(8, fty_name.len())
            ctx.pending_vec_elem_tyname = elem_slice.clone()
    elif is_dict_lit:
        # Dict__<K>__<V> / HashMap__<K>__<V>. Simple first-split only;
        # nested generics (Dict__Vector__int64_t__int64_t) stay unhinted
        # and fall back to size 8.
        int d_prefix_len = -1
        bool d_ordered = false
        if fty_name.starts_with("Dict__"):
            d_prefix_len = 6
            d_ordered = true
        elif fty_name.starts_with("HashMap__"):
            d_prefix_len = 9
        elif fty_name.starts_with("Map__"):
            d_prefix_len = 5
        elif fty_name.starts_with("OrderedDict__"):
            d_prefix_len = 13
            d_ordered = true
        if d_prefix_len > 0:
            String d_rest = fty_name.slice(d_prefix_len, fty_name.len())
            int d_sep = d_rest.index_of("__").unwrap_or(-1)
            if d_sep > 0:
                String k_only = d_rest.slice(0, d_sep)
                String v_only = d_rest.slice(d_sep + 2, d_rest.len())
                if not k_only.contains("__") and not v_only.contains("__"):
                    # Same view-lifetime concern as the Vector case —
                    # clone to owned before storing.
                    ctx.pending_dict_key_tyname = k_only.clone()
                    ctx.pending_dict_val_tyname = v_only.clone()
                    ctx.pending_dict_ordered = d_ordered

int lower_call(LowerCtx &ctx, String &fname, Vector[SpannedExpr] &args, Vector[SpannedType] &targs, GirModule &gmod):
    int result = -1
    bool is_print = fname == "print"
    if is_print:
        # print() → printf
        if args.len() > 0:
            SpannedExpr parg = args.get(0).unwrap()
            int val = lower_expr(&ctx, parg, &gmod)
            int val_type = I64_TYPE
            if val >= 0 and val < ctx.locals.len():
                val_type = ctx.locals.get(val).unwrap().type_id
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            # Borrowed string (`Ptr(GorgetString)` from a struct String-field
            # read or a match/`is` enum-payload binding) — deref to a NON-OWNING
            # value GorgetString so the `%s`/`.data` path fires. The exact
            # `val_type == gs_tid` check below otherwise misses the Ptr and
            # falls through to `%lld`, printing the pointer as an int. The deref
            # local is LoBorrowed so drop-elab won't free the aliased buffer.
            if is_ptr_to_string_type_id(val_type, &gmod):
                int sval = add_local_with(&ctx, gs_tid, NO_NAME, LoBorrowed(), BoNone())
                emit(&ctx, GIDeref(sval, val, gs_tid))
                val = sval
                val_type = gs_tid
            String fmt = "%lld\n"
            if val_type == F64_TYPE:
                fmt = "%f\n"
            elif val_type == BOOL_TYPE:
                # bool → gorget_bool_to_str → GorgetString, print as "%s\n".
                # Mirrors Rust format_for_printf BOOL_TYPE→"%s"
                # (src/ir/lowering/exprs/calls.rs:1915) + bool→gorget_bool_to_str
                # (src/lir/lower/calls.rs:50-53). Without this, print(true)
                # emits printf("%lld\n", true) → "1".
                int bdst = add_local(&ctx, gs_tid, NO_NAME)
                emit(&ctx, GICallExtern(bdst, "gorget_bool_to_str", [op_consume(&ctx, &gmod, val, CkFormatArg())]))
                # FRESH-OWNED-TEMP drop registration (#7-style):
                # gorget_bool_to_str allocates a fresh `GorgetString` (LoOwned)
                # that is only BORROWED by the printf below (CkFormatArg →
                # OpBorrow), so it is orphaned and leaks. Register at creation
                # so the scope-exit GIDropIfAlive frees it once. Borrow-only
                # consume ⇒ never moved ⇒ no double-free.
                register_local_for_drop(&ctx, bdst, gs_tid, &gmod)
                val = bdst
                val_type = gs_tid
                fmt = "%.*s\n"
            if val_type == gs_tid:
                # %.*s + (int)len,data so a non-NUL-terminated cap=0 view
                # (trim/strip/slice) prints exactly len bytes, not over-reading.
                # The printf emitter decomposes the Str value arg (ai != 0).
                fmt = "%.*s\n"
            Vector[Operand] printf_args = [OpConstStr(fmt), op_consume(&ctx, &gmod, val, CkFormatArg())]
            int pdst = add_local(&ctx, I32_TYPE, NO_NAME)
            emit(&ctx, GICallExtern(pdst, "printf", printf_args))
            result = pdst
    elif (fname == "Str" or fname == "String" or fname == "GorgetString") and args.len() == 1:
        # Identity coercion: Str(x) / String(x) returns x (already a string).
        # Lower the inner arg and pass its type through.
        SpannedExpr inner = args.get(0).unwrap()
        result = lower_expr(&ctx, inner, &gmod)
    elif allocator_constructor_runtime_name(fname) != "":
        # R9 FIDELITY — scoped-allocator constructor (`Arena(8192)`,
        # `PoolAllocator(sz, n)`, `TrackingAllocator()`, …). These are NOT
        # user-struct instantiations: the runtime returns an opaque handle
        # pointer (`GorgetArena*` etc.), so emit a runtime `gorget_<kind>_new`
        # CallExtern instead of routing through the user-struct constructor
        # path (which would build `Arena{_handle=...}` and deref garbage).
        # Mirrors Rust gg `src/ir/lowering/exprs/calls.rs:708-744`.
        #
        # ⚠ The dst MUST be a POINTER-to-named slot, NOT a bare named type:
        # the runtime fn returns a `GorgetArena*`, and a bare `Arena` slot
        # (C `struct __gg_Arena`) can't hold it (C type error). Rust
        # pre-registers allocators as `MutPtr(Named(...))`; the self-host has
        # no such pre-registration, so we register the Ptr explicitly here.
        # `type_id_to_base_name` unwraps `GtPtr`→"Arena" so later method
        # dispatch (`pool.bytes_used()`) still resolves on the type name.
        String alloc_new_fn = allocator_constructor_runtime_name(fname)
        Vector[Operand] alloc_args = []
        # CoW for-element BORROW scan (no SpannedExpr__clone): aarg is only read
        # by lower_expr's immutable-borrow param.
        for aarg in args:
            int aval = lower_expr(&ctx, aarg, &gmod)
            # Allocator constructor args are plain scalars (capacity/count);
            # pass by value (CkCallArgBorrow yields OpCopy for a primitive).
            alloc_args.push(op_consume(&ctx, &gmod, aval, CkCallArgBorrow()))
        int alloc_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, fname))
        int alloc_dst = add_local(&ctx, alloc_ptr_ty, NO_NAME)
        emit(&ctx, GICallExtern(alloc_dst, alloc_new_fn, alloc_args))
        result = alloc_dst
    elif sync_constructor_runtime_name(fname) != "":
        # SYNC FIDELITY — non-generic sync-primitive constructor
        # (`AtomicInt(0)`, `OnceFlag()`, `Semaphore(n)`, …). Same shape as the
        # allocator branch above: the runtime returns an opaque handle pointer
        # (`GorgetAtomicInt*` etc.), so emit `gorget_<kind>_new` and register
        # the dst as a POINTER-to-named slot (a bare value slot can't hold the
        # `GorgetAtomicInt*`). Mirrors Rust gg calls.rs:851 / exprs/mod.rs:1652.
        String sync_new_fn = sync_constructor_runtime_name(fname)
        Vector[Operand] sync_args = []
        # CoW for-element BORROW scan (no SpannedExpr__clone): sarg is only read
        # by lower_expr's immutable-borrow param.
        for sarg in args:
            int sval = lower_expr(&ctx, sarg, &gmod)
            sync_args.push(op_consume(&ctx, &gmod, sval, CkCallArgBorrow()))
        int sync_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, fname))
        int sync_dst = add_local(&ctx, sync_ptr_ty, NO_NAME)
        emit(&ctx, GICallExtern(sync_dst, sync_new_fn, sync_args))
        result = sync_dst
    else:
        # Compute mangled name for generic calls
        String call_name = fname
        if targs.len() > 0:
            for ta in targs:
                call_name = call_name + "__" + type_to_c_name(ta, &gmod)
        # Resolve call redirects (bare → module-prefixed name).
        if gmod.call_redirects.contains(call_name):
            call_name = gmod.call_redirects.get(call_name).unwrap()
        # User function call
        Vector[Operand] gir_args = []
        # Look up borrow params from pre-scanned ownership info
        Vector[bool] borrow_flags = []
        if gmod.fn_borrow_params.contains(call_name):
            borrow_flags = gmod.fn_borrow_params.get(call_name).unwrap()
        # Resolve callee param types ONCE for the call-arg expected_type
        # propagation. Mirrors Rust gg's call-arg path at
        # `src/ir/lowering/exprs/calls.rs:1228-1255` — set
        # `ctx.expected_type = param_types[i]` BEFORE recursing into
        # `lower_expr` for each arg, then restore. Reader sites
        # (bare prelude-variant ctors, bare `None`, EIdentifier) thus
        # type their result to the parameter's declared shape rather
        # than to the bare variant name — fixes the NULL-give-up class
        # for `f(Ok(x))` / `f(None)` / etc. at non-return user-level
        # consume positions.
        Vector[int] callee_param_types = get_fn_param_types(call_name, &gmod)
        # Prelude-variant ctor arg expected-type, off the typed enum-category
        # channel. `Ok`/`Error`/`Some` aren't real fns (no `callee_param_types`),
        # so a nested ctor arg like `Ok(None())` / `Some(Box(x))` would lower
        # its inner with no expected type and mis-slot it (`None()` typed
        # `int64_t` instead of `Option__int64_t`). When the ENCLOSING
        # `expected_type` is a recorded `Result__`/`Option__`, the arg's
        # expected type IS that enum's Ok/Error/Some payload — read it from the
        # channel (CLAUDE.md "No name matching"; the same typed fact the field
        # shape and match-destructure read). -1 when not a variant ctor / no
        # record / no enclosing expectation.
        int variant_arg_expected = -1
        if fname == "Ok" or fname == "Error" or fname == "Some":
            EnumCategory pvec = enum_category_of(&gmod, ctx.expected_type)
            if pvec.category == ENUM_CAT_RESULT:
                if fname == "Ok":
                    variant_arg_expected = pvec.ok_type
                elif fname == "Error":
                    variant_arg_expected = pvec.err_type
            elif pvec.category == ENUM_CAT_OPTION and fname == "Some":
                variant_arg_expected = pvec.ok_type
        int first_arg_type = -1
        # CoW for-element BORROW scan (no SpannedExpr__clone): arg is only read
        # (apply_container_hint/lower_expr/match arg.expr — all immutable-borrow
        # uses); enumerate() preserves the positional arg index ai.
        for (ai, arg) in args.enumerate():
            # For struct-constructor calls, hint the container-literal
            # element size for each positional arg using the target field's
            # declared type. Look up type_infos inline (per-arg) — keeping
            # the GirTypeInfo as a local across iterations tripped a
            # field-move issue in the self-host compiler; querying anew
            # each time sidesteps it. Without this, `LowerCtx([], ..., {},
            # ...)` keeps scalar-sized allocators for the Vector/Dict
            # fields and later pushes corrupt adjacent slots.
            apply_container_hint_for_ctor_arg(&ctx, call_name, ai, arg, &gmod)
            # Expected-type propagation per arg (Rust calls.rs:1239-1255).
            # The arg's destination is the PARAM type, NOT the surrounding
            # context — so START by clearing any leaked `expected_type` (e.g. a
            # `Result[T,E]` from an enclosing `throws` return, `return f(g(x))`).
            # Otherwise the centralized auto-prop hook's capture-form check
            # would see that leaked Result and wrongly suppress the peel on a
            # throws-call arg passed to a NON-Result (e.g. `int`) param — the
            # case (3) `double_it(might(x))` regression. Then set the param type
            # for non-primitive params (so bare None/Ok reader sites resolve).
            int prev_expected_arg = ctx.expected_type
            ctx.expected_type = -1
            if ai < callee_param_types.len():
                int pt = callee_param_types.get(ai).unwrap()
                if pt != I64_TYPE and pt != UNIT_TYPE:
                    ctx.expected_type = pt
            # Prelude-variant ctor (Ok/Error/Some): no callee_param_types, so
            # use the channel-derived payload type as the arg's expectation
            # (the `ai == 0` payload position). This is what makes a nested
            # `Ok(None())` type its inner `None()` to the Ok payload.
            elif ai == 0 and variant_arg_expected >= 0:
                ctx.expected_type = variant_arg_expected
            int arg_local = lower_expr(&ctx, arg, &gmod)
            ctx.expected_type = prev_expected_arg
            # Auto-propagate a `throws` call passed as an argument
            # (`f(might())` unwraps; `f(r)` where the param is Result keeps the
            # raw Result). Skip when the callee's param IS a Result__ — don't
            # unwrap into a parameter that wants the Result. Ctor args flow
            # through this same loop, so struct/enum-field ctors are covered.
            bool arg_param_is_result = false
            if ai < callee_param_types.len():
                String arg_pt_name = type_id_to_name(callee_param_types.get(ai).unwrap(), &gmod)
                arg_param_is_result = arg_pt_name.starts_with("Result__")
            if not arg_param_is_result:
                arg_local = maybe_auto_propagate(&ctx, arg_local, &gmod)
            if ai == 0 and arg_local >= 0 and arg_local < ctx.locals.len():
                first_arg_type = ctx.locals.get(arg_local).unwrap().type_id
            # Detect &arg (borrow) or pre-scanned borrow param
            bool is_borrow = false
            match arg.expr:
                case EMutableBorrow(_):
                    is_borrow = true
                else:
                    pass
            if not is_borrow and ai < borrow_flags.len():
                is_borrow = borrow_flags.get(ai).unwrap()
            if is_borrow:
                # Phase C step 5b + Path A receiver-dispatch (2026-05-21):
                # the callee declared this param as `&T` (OWN_MUTABLE)
                # OR the caller wrote `&x` syntactically. Either way it
                # is a borrow position: the local stays alive past the
                # call. A LoBorrowed source must propagate as OpBorrow
                # (moving a borrow is a use-after-free); for owned
                # sources, route through classify_call_arg — for a
                # borrow-declared param this naturally returns
                # CkCallArgBorrow → OpBorrow, never OpMove. The previous
                # hardcoded OpMove for owned sources was a Path A bug
                # (over-consumption: turned alias reads into moves at
                # call boundaries).
                GirLocal arg_loc = ctx.locals.get(arg_local).unwrap()
                match arg_loc.ownership:
                    case LoBorrowed():
                        gir_args.push(OpBorrow(arg_local))
                    else:
                        gir_args.push(op_consume(&ctx, &gmod, arg_local, classify_call_arg(&gmod, call_name, ai)))
            else:
                # Phase C step 5c + Path A bugfix (2026-05-21): pick the
                # ConsumeKind from the callee's param ownership. bare `T`
                # → CkCallArgBorrow (Ptr alias propagation, no clone);
                # `!T` → CkCallArgOwning (drives OpMove/OpClone). The
                # outer `is_borrow` branch already handled `&T` params.
                gir_args.push(op_consume(&ctx, &gmod, arg_local, classify_call_arg(&gmod, call_name, ai)))
        # Look up return type from module's fn_sigs, or from function definitions
        int ret_type = I64_TYPE
        # Expected-type read for bare prelude-variant ctors (Rust gg's
        # `resolve_option_result_variant` at `src/ir/lowering/exprs/mod.rs:1452-1551`).
        # When the caller (SVarDecl / SAssign / SReturn / call-arg / struct-field-init)
        # has set `ctx.expected_type` to a typed `Option__T` / `Result__T__E` enum,
        # adopt it as ret_type. This makes the dst slot struct-typed upstream so
        # `try_lower_prelude_variant` fires at LIR (emits canonical `IEnumInit`).
        # Subsumes the Some-with-non-primitive-inner hack at the end of this
        # block at non-return user-level consume positions (the SReturn site
        # used to retype after-the-fact; that path remains as a defensive
        # backstop, see `case SReturn:`).
        if (fname == "Ok" or fname == "Error" or fname == "Some" or fname == "None") and ctx.expected_type >= 0:
            int et = ctx.expected_type
            if et < gmod.type_table.len():
                String et_name = type_id_to_name(et, &gmod)
                bool et_is_option = et_name.starts_with("Option__") and not et_name.starts_with("Option__Ref__")
                bool et_is_result = et_name.starts_with("Result__")
                bool variant_matches_option = (fname == "Some" or fname == "None") and et_is_option
                bool variant_matches_result = (fname == "Ok" or fname == "Error") and et_is_result
                if variant_matches_option or variant_matches_result:
                    ret_type = et
        if ret_type == I64_TYPE and gmod.fn_sigs.contains(call_name):
            ret_type = gmod.fn_sigs.get(call_name).unwrap()
        # Also check call_redirects for the original name.
        if ret_type == I64_TYPE and gmod.call_redirects.contains(fname):
            String redir = gmod.call_redirects.get(fname).unwrap()
            if gmod.fn_sigs.contains(redir):
                ret_type = gmod.fn_sigs.get(redir).unwrap()
        # Check function definitions for return type
        if ret_type == I64_TYPE:
            int i = 0
            while i < gmod.functions.len():
                if gmod.functions.get(i).unwrap().name == call_name:
                    ret_type = gmod.functions.get(i).unwrap().return_type
                    break
                i += 1
        # Collection/struct constructors: return the named type
        if ret_type == I64_TYPE and is_type_constructor(call_name, &gmod):
            # If call_name is an enum variant, route to the parent enum type.
            String parent = enum_variant_parent(call_name, &gmod)
            if parent != "":
                ret_type = lookup_or_register_named(&gmod, parent)
            else:
                ret_type = lookup_or_register_named(&gmod, call_name)
        # Monomorphized user-struct constructors (e.g. Wrapper__int64_t) —
        # detect via type_infos lookup even if name contains "__".
        if ret_type == I64_TYPE and gmod.type_infos.contains(call_name):
            ret_type = lookup_or_register_named(&gmod, call_name)
        # Template-name constructor: Wrapper__int64_t has template Wrapper
        # in type_infos. Route to the monomorphized named type.
        if ret_type == I64_TYPE:
            if call_name.contains("__"):
                int dunder = call_name.index_of("__").unwrap()
                if dunder > 0:
                    String tmpl_name = call_name.slice(0, dunder)
                    if gmod.type_infos.contains(tmpl_name):
                        ret_type = lookup_or_register_named(&gmod, call_name)
        # Builtin calls (args, read_file, int_to_str, ...)
        if ret_type == I64_TYPE:
            int builtin_ret = builtin_call_return_type(fname, &gmod)
            if builtin_ret >= 0:
                ret_type = builtin_ret
        # Prelude variant constructor `Some(x)` → `Option__<inner>`. The
        # block above can't route it (Option is a prelude enum, absent from
        # gmod.type_infos → enum_variant_parent "" → typed by the BARE
        # variant name `Some`), which resolves to an LT_PTR MIS-SLOT at LIR
        # (8 bytes for a 16-byte Option) — wrong-sized AND defeats
        # by-pointer-param address-taking (blocks the reference-grade
        # by-pointer Option ABI). The inner type is taken from the LOWERED
        # ARGUMENT's local type — reliable, unlike guess_return_type (which
        # collapses Box/struct inners to I64 → Option__int64_t ≠ the actual
        # Option__Box__SpannedExpr) and unlike the typechecker side-table
        # (which misses arg-position calls here). Unwrap any Ptr: a borrowed
        # arg is typed `*T`, but the Option OWNS its payload (value type).
        # Gate on a NON-PRIMITIVE inner: a resource/struct payload (String,
        # user structs) is what needs the precise Option__T slot for the
        # by-pointer ABI. Primitive-typed inners (incl. a `Box.new(...)` arg
        # currently mistyped as I64 — a separate pre-existing gap) keep the
        # legacy bare-`Some` typing, which coerces fine into int-typed fields
        # (e.g. ERange); retyping them to Option__int64_t would MISMATCH
        # those fields. This is the minimal correct scope to unblock A
        # without depending on the orthogonal Box-typing fix.
        if (fname == "Some") and first_arg_type >= PRIM_COUNT:
            int some_inner = first_arg_type
            if some_inner >= 0 and some_inner < gmod.type_table.len():
                match gmod.type_table.get(some_inner).unwrap():
                    case GtPtr(p_inner):
                        some_inner = p_inner
                    case GtMutPtr(p_inner):
                        some_inner = p_inner
                    else:
                        pass
            ret_type = lookup_or_register_named(&gmod, "Option__" + type_id_to_name(some_inner, &gmod))
            record_enum_category(&gmod, ret_type, ENUM_CAT_OPTION, some_inner, -1)
        int dst = add_local(&ctx, ret_type, NO_NAME)
        emit(&ctx, GICall(dst, call_name, gir_args))
        # FRESH-OWNED-TEMP drop registration (#7-style): a resource/String-
        # returning free-fn/builtin/user call (`int_to_str`/`chr`/`read_file`/
        # `getenv`/`args`/user `String f()`) yields a fresh OWNED value (LoOwned).
        # When this CALL EXPRESSION flows directly into a non-consuming position
        # (`print(int_to_str(x))`, `f"{int_to_str(x)}"`) it is BORROWED only
        # (CkFormatArg/CkCallArgBorrow → is_consume_kind=false → OpBorrow), so the
        # result is orphaned and leaks (O(1) per occurrence). Registering at
        # creation makes the scope-exit GIDropIfAlive free it exactly once.
        # SAFE-BY-CONSTRUCTION: when the result is instead MOVED into a binding
        # (`String s = int_to_str(x)`), RETURNED, or pushed/field-init'd,
        # op_consume/wire-liveness emits OpMove → GIMoveZero zeros the moved-out
        # slot, so the unconditional scope-exit GIDropIfAlive — which lowers to a
        # memcmp-guarded drop — finds a zeroed slot and SUPPRESSES the drop at
        # runtime (and the LIR drop_elab pass further elides the guard statically
        # when init is provable). SReturn separately excludes the moved local from
        # early-exit drops. Either way the value is dropped exactly once; no
        # double-free.
        # register_local_for_drop's is_droppable_type gate makes this a no-op for
        # primitive returns (int/bool/F64) and its LoView/LoBorrowed gates pass
        # only genuine fresh owners; `dst` is LoOwned here. Mirrors Rust's
        # call_tracked/call_extern_tracked `needs_drop` registration (context.rs).
        register_local_for_drop(&ctx, dst, ret_type, &gmod)
        result = dst
    return result

# ── Statement lowering ───────────────────────────────────

void lower_stmt(LowerCtx &ctx, Stmt stmt, GirModule &gmod, bool is_main):
    match stmt:
        case SVarDecl(stype, name, init_expr, _, _, _):
            # Element-type hint for container literals: `Vector[T] x = []`
            # needs `gorget_array_new(sizeof(T))`, not the hardcoded 8.
            # Lift T from stype and park it on ctx; the EArrayLiteral /
            # EDictLiteral handlers consume and clear it. Without this hint
            # every aggregate Vector got elem_size=8, so pushes of 128-byte
            # LirStructDef structs corrupted adjacent elements — stage-1
            # crashed in lower_type_defs's `safe_get(i)` memcpy.
            match init_expr.expr:
                case EArrayLiteral(_):
                    match stype.ty:
                        case TNamed(tn_v, targs_v):
                            if (tn_v == "Vector" or tn_v == "Array" or tn_v == "Set" or tn_v == "HashSet" or tn_v == "OrderedSet") and targs_v.len() >= 1:
                                SpannedType elem_st = targs_v.get(0).unwrap()
                                # type_to_c_name may return a view (literal or
                                # borrowed slice); clone so the String outlives
                                # the temporary.
                                String vec_tc = type_to_c_name(elem_st, &gmod)
                                ctx.pending_vec_elem_tyname = vec_tc.clone()
                        else:
                            pass
                case EDictLiteral(_, _):
                    match stype.ty:
                        case TNamed(tn_d, targs_d):
                            if (tn_d == "Dict" or tn_d == "HashMap" or tn_d == "Map" or tn_d == "OrderedDict") and targs_d.len() >= 2:
                                SpannedType key_st = targs_d.get(0).unwrap()
                                SpannedType val_st = targs_d.get(1).unwrap()
                                String key_tc = type_to_c_name(key_st, &gmod)
                                String val_tc = type_to_c_name(val_st, &gmod)
                                ctx.pending_dict_key_tyname = key_tc.clone()
                                ctx.pending_dict_val_tyname = val_tc.clone()
                                ctx.pending_dict_ordered = (tn_d == "Dict" or tn_d == "OrderedDict")
                        else:
                            pass
                else:
                    pass
            # Expected-type propagation: mirrors Rust gg's `lower_var_decl`
            # at `src/ir/lowering/stmts/mod.rs:477-487`. Setting
            # `ctx.expected_type` to the declared local type BEFORE
            # lowering the init expression lets reader sites
            # (bare `Ok`/`Error`/`Some`/`None` ctors, bare `None`
            # literal, EIdentifier) resolve a context-dependent type
            # the local expression shape cannot determine alone — so
            # the init's dst slot is typed to the declared shape
            # upstream, never round-tripped through a wrong slot type.
            int prev_expected_vd = ctx.expected_type
            int declared_ty_pre = map_ast_type(stype, &gmod)
            if declared_ty_pre != I64_TYPE and declared_ty_pre != UNIT_TYPE:
                ctx.expected_type = declared_ty_pre
            int val = lower_expr(&ctx, init_expr, &gmod)
            ctx.expected_type = prev_expected_vd
            # Auto-propagate a `throws` call captured into a non-Result local
            # (`int v = might()` unwraps; `Result[int,E] r = might()` keeps the
            # raw Result so the user can match/destructure it). Skip when the
            # declared destination type IS a Result__ (don't unwrap into it).
            String decl_pre_name = type_id_to_name(declared_ty_pre, &gmod)
            if not decl_pre_name.starts_with("Result__"):
                val = maybe_auto_propagate(&ctx, val, &gmod)
            # closure Phase 2 Step A: record `<fn>\0<varname>` →
            # `__Closure_<cid>` when the init is a closure, so the re-pointed
            # named-spawn pass can wire `spawn varname()`'s wrapper to the
            # closure's make-site cid. The just-pushed record is the last
            # entry in lifted_closures. Keyed by current fn name + NUL +
            # varname so two functions' `auto f = …` don't collide.
            match init_expr.expr:
                case EClosure(_, _):
                    int cvc_n = gmod.lifted_closures.len()
                    if cvc_n > 0:
                        int cvc_cid = gmod.lifted_closures.get(cvc_n - 1).unwrap().cid
                        gmod.closure_var_cids.put(ctx.current_fn_name + "\0" + name, "__Closure_" + int_to_str(cvc_cid))
                case EImplicitClosure(_):
                    int icvc_n = gmod.lifted_closures.len()
                    if icvc_n > 0:
                        int icvc_cid = gmod.lifted_closures.get(icvc_n - 1).unwrap().cid
                        gmod.closure_var_cids.put(ctx.current_fn_name + "\0" + name, "__Closure_" + int_to_str(icvc_cid))
                else:
                    pass
            int var_type = ctx.locals.get(val).unwrap().type_id
            # Prefer the declared type when it carries more info than the
            # init expression's inferred type. This recovers the Vector[T]
            # parametrization from e.g. `Vector[String] cmd_args = args()`
            # — the init would otherwise type the local as the runtime's
            # bare GorgetArray, losing the element type.
            int declared_ty = map_ast_type(stype, &gmod)
            if declared_ty != I64_TYPE and declared_ty != UNIT_TYPE and declared_ty != var_type:
                # Accept the declared type if it's a more specific monomorphized
                # collection (e.g. Vector__GorgetString vs GorgetArray).
                String declared_name = type_id_to_name(declared_ty, &gmod)
                String inferred_name = type_id_to_name(var_type, &gmod)
                if declared_name.contains("__") and not inferred_name.contains("__"):
                    var_type = declared_ty
            # cstr → String coercion at the boundary: `String err =
            # _parse_last_error()` where the extern returns `cstr`. Without
            # this, the cstr pointer gets stored into a Str slot and
            # subsequent `err.len()` calls treat the 8-byte pointer as a
            # 40-byte Str struct — the `len` field read aliases adjacent
            # stack and zeroes unrelated locals. Mirrors Rust's
            # `extern_cstr_return_vals` handling in
            # `src/backend/c_lir/mod.rs` which wraps the value with
            # `gorget_str_from_cstr` when the slot is Str-typed and the
            # source is a cstr-returning extern call.
            int gs_tid_decl = lookup_or_register_named(&gmod, "GorgetString")
            if declared_ty == gs_tid_decl and is_cstr_returning_call(init_expr, &gmod):
                int coerced = add_local(&ctx, gs_tid_decl, NO_NAME)
                # gorget_str_from_cstr reads the cstr pointer to build a
                # new GorgetString — borrow.
                Vector[Operand] cstr_args = [op_consume(&ctx, &gmod, val, CkCallArgBorrow())]
                emit(&ctx, GICallExtern(coerced, "gorget_str_from_cstr", cstr_args))
                val = coerced
                var_type = gs_tid_decl
            # Phase B.1 (2026-05-22): 7-branch SVarDecl assign-mode
            # decision tree. Mirrors Rust's `lower_var_decl_assign_mode`
            # at `src/ir/lowering/stmts/mod.rs:1055-1273`. Three emission
            # strategies (BorrowAlias / CloneAndMove / MoveDirect) chosen
            # from the cross-product of source ownership, source type,
            # declared type, and (pragma'd) liveness + CoW-safety. See
            # `decide_svardecl_emission` (line ~660) for the full branch
            # logic and pragma rationale.
            #
            # Supersedes the Prereq B carve-out: that older 3-case
            # inheritance (LoBorrowed/LoView → inherit, else → LoOwned)
            # is now a subset of Branch C (the BorrowAlias strategy
            # also fires for live Owned resource sources, the
            # `String b = a` shape per CoW-default-borrow). The Phase 3
            # `add_local_inheriting` helper stays — it handles
            # intermediate-temp bindings (match scrutinee, PBinding,
            # PCtor field) that don't go through this user-level
            # SVarDecl path.
            GirLocal val_loc = ctx.locals.get(val).unwrap()
            SVarDeclEmission plan = decide_svardecl_emission(&ctx, &gmod, val, var_type)
            int var_local = 0
            match plan:
                case BorrowAlias():
                    # Branch A / C / (transitive A/C) — mark dst as a
                    # borrow alias of val. Ownership: inherit val's
                    # LoBorrowed/LoView if val is already a borrow
                    # (preserves the chain); otherwise tag dst as
                    # LoBorrowed/BoAlias(val) — a fresh alias of an
                    # owned source.
                    #
                    # Drop discipline. Two scenarios:
                    #   (a) val is itself a borrow (transitive alias):
                    #       neither val nor var_local registers for drop;
                    #       the root aggregate up the chain owns the
                    #       heap. This is the Prereq B carve-out shape.
                    #   (b) val is LoOwned (fresh Branch A/C): val IS
                    #       the owner. var_local must NOT register for
                    #       drop (would double-free). val keeps its
                    #       drop registration if it had one; otherwise
                    #       the heap leaks once the function returns
                    #       — caller's responsibility (the typical case
                    #       is val is an unnamed coerced temp from
                    #       `gorget_str_from_cstr` which we deliberately
                    #       don't drop because the alias keeps its
                    #       bytes alive across the function body).
                    LocalOwnership new_own = LoBorrowed()
                    BorrowOrigin new_origin = BoAlias(val)
                    bool inherited_chain = false
                    match val_loc.ownership:
                        case LoBorrowed():
                            new_own = val_loc.ownership
                            new_origin = val_loc.borrow_origin
                            inherited_chain = true
                        case LoView():
                            new_own = val_loc.ownership
                            new_origin = val_loc.borrow_origin
                            inherited_chain = true
                        else:
                            pass
                    # D.1 (2026-05-22) — Branch C retype to Ptr(T). B.1
                    # left the dst slot value-typed because the LIR's
                    # `GIAssign(dst, OpBorrow(src))` shape would byte-copy
                    # an aggregate value into a Ptr-typed slot (silent
                    # corruption). D.1 ships the LIR fix at
                    # `lir_lower.gg:GIAssign` (OpBorrow + Ptr-typed-dst +
                    # value-typed-src → ISlotAddr instead of ISlotLoad),
                    # so the slot can now genuinely be `Ptr(T)`.
                    #
                    # The retype unifies Branch C with Rust's `set_ref`:
                    # downstream Ptr-typed-slot consumers (GIFieldLoad
                    # auto-deref, GICall pass-by-ptr, GICallExtern
                    # pass-by-ptr, OpClone short-circuit) all handle the
                    # Ptr-typed shape — borrow propagation now works at
                    # the LIR layer, not just at the GIR ownership tag.
                    int dst_type_id = register_ptr(&gmod, var_type)
                    var_local = add_local_with(&ctx, dst_type_id, Some(name), new_own, new_origin)
                    # Explicit OpBorrow — bypass op_consume because val
                    # may be LoOwned (which op_consume would resolve to
                    # OpMove, but for the alias shape we want a pointer-
                    # like copy, not a move-out). With D.1's Branch C
                    # retype, the LIR's GIAssign handler dispatches:
                    #   • val_loc value-typed (e.g. fresh coerced cstr →
                    #     GorgetString) → ISlotAddr(src) + ISlotStore(dst)
                    #   • val_loc Ptr-typed (e.g. inherited from another
                    #     Branch C / from GIFieldLoad) → ISlotLoad(src) +
                    #     ISlotStore(dst) = pointer copy = alias chain.
                    emit(&ctx, GIAssign(var_local, OpBorrow(val)))
                    # cow_register_alias overwrites BorrowOrigin with
                    # BoAlias(val). Only call when we DIDN'T inherit a
                    # specific origin from val — otherwise we'd lose the
                    # transitive chain's information (BoField/BoCollectionElement/etc.).
                    if not inherited_chain:
                        cow_register_alias(&ctx, var_local, val)
                    nl_put(&ctx, name, var_local)
                    # Borrow alias: don't register for drop. Drop discipline
                    # is preserved because val (or the root aggregate it
                    # aliases) covers the underlying heap.
                case CloneAndMove(clone_fn_name):
                    # Branch B / D / E + Branch C-pre — emit `<T>__clone(&val)`
                    # (or the runtime equivalent like gorget_string_clone_to_owned),
                    # then bind dst LoOwned to the clone result. Register
                    # for drop because dst genuinely owns a fresh allocation.
                    #
                    # OWNED-RESULT TYPE (option_ref_borrow Phase 4a): for the
                    # Branch C-pre shape `T x = coll.get(i).unwrap()`, the
                    # source `val` is a `GtPtr(inner)` (the element's address)
                    # and the clone fn DEREFERENCES it, returning an OWNED
                    # `inner` value — NOT a pointer. `var_type` here is the
                    # source's slot type, which is the `GtPtr(inner)` (the
                    # declared-type heuristic at ~5523 can't override it
                    # because `type_id_to_name` collapses `GtPtr(inner)`→inner,
                    # so declared and inferred names match). Typing `cloned` /
                    # `var_local` as that Ptr would (1) mislabel an owned value
                    # as a pointer and (2) make the subsequent
                    # `op_consume(cloned, CkAssign)` re-enter the GtPtr arm and
                    # emit a SECOND `OpClone` (the triple-clone / value-where-
                    # pointer bug). When the source is a `GtPtr(inner)`, bind
                    # the owned locals at the pointee type `inner` so the clone
                    # result is value-typed and op_consume picks OpMove.
                    int owned_type = var_type
                    bool source_was_ptr = false
                    GirLocal cam_src = ctx.locals.get(val).unwrap()
                    if cam_src.type_id >= 0 and cam_src.type_id < gmod.type_table.len():
                        GirType cam_src_gt = gmod.type_table.get(cam_src.type_id).unwrap()
                        match cam_src_gt:
                            case GtPtr(cam_inner):
                                owned_type = cam_inner
                                source_was_ptr = true
                            case GtMutPtr(cam_inner):
                                # Symmetric with GtPtr above. `&T`/`!T` params
                                # lower to `GtMutPtr(T)` (resolve_param_type at
                                # context.rs:1613). A `T x = &param` clone
                                # produces an owned value `T`, so the dst slot
                                # must be value-typed at `T`, not `MutPtr(T)`.
                                # Without this unwrap the dst slot stayed
                                # `MutPtr(T)` and lir_codegen.gg:2809-2810's
                                # "pointer slot receiving aggregate value →
                                # NULL" coercion fired (self_host_bootstrap_
                                # fixed_point lower_call SIGSEGV).
                                owned_type = cam_inner
                                source_was_ptr = true
                            else:
                                pass
                    int cloned = add_local(&ctx, owned_type, NO_NAME)
                    Vector[Operand] clone_args = []
                    clone_args.push(OpBorrow(val))
                    emit(&ctx, GICallExtern(cloned, clone_fn_name, clone_args))
                    var_local = add_local(&ctx, owned_type, Some(name))
                    emit(&ctx, GIAssign(var_local, op_consume(&ctx, &gmod, cloned, CkAssign())))
                    nl_put(&ctx, name, var_local)
                    # When the source was a GtPtr/GtMutPtr (the Branch C-pre
                    # `coll.get(i).unwrap()` deref-clone), do NOT register the
                    # owned local for drop. The clone fn makes a DEEP independent
                    # heap copy (resolve_payload_clone_fn → <T>__clone, :7983-8013),
                    # so dropping it is NOT a double-free — it's a memory-SAFE
                    # EXTRA drop. But the ORACLE borrows the element and never
                    # drops it, so that extra drop DOUBLE-PRINTS (e.g.
                    # drop_struct_collection_fields). Suppressing it matches the
                    # oracle's borrow-no-drop stdout, AT THE COST OF LEAKING the
                    # deref-clone's heap (invisible to fixtures, which have no
                    # mem_live() check). Removable once Branch C-pre BORROWS
                    # instead of clones (see TODO). Value-owned clones
                    # (source not a Ptr) still register normally.
                    if not source_was_ptr:
                        register_local_for_drop(&ctx, var_local, owned_type, &gmod)
                    else:
                        # ③(d)-RSS: a RUNTIME-resource deref-clone (String/Array/
                        # Vector/Dict/Set/Box/…) has no observable drop, so
                        # registering it frees its fresh independent heap invisibly
                        # (the self-compile RSS leak — string_free 2.6M vs Rust 93.8M,
                        # stage-1 peak 9.96→6.28 GB). The blanket-skip above left
                        # EVERY `T x = coll.get(i).unwrap()` deref-clone leaking.
                        # A USER struct/enum ptr-clone's drop may printf → registering
                        # it double-PRINTS (it stays on the leak-but-stdout-correct
                        # path until Branch C-pre BORROWS — the root-cause fix, TODO).
                        String owned_tname = type_id_to_name(owned_type, &gmod)
                        bool is_runtime_resource = false
                        match resource_meta_for(&gmod, owned_tname):
                            case Some(_):
                                is_runtime_resource = true
                            case None:
                                pass
                        if is_runtime_resource:
                            register_local_for_drop(&ctx, var_local, owned_type, &gmod)
                case MoveDirect():
                    # Branch F / G — direct Move. Primitives, FnPtr,
                    # non-resource user types. op_consume picks
                    # OpCopy/OpMove as appropriate.
                    var_local = add_local(&ctx, var_type, Some(name))
                    emit(&ctx, GIAssign(var_local, op_consume(&ctx, &gmod, val, CkAssign())))
                    nl_put(&ctx, name, var_local)
                    register_local_for_drop(&ctx, var_local, var_type, &gmod)
                    # ② closure ENV-FIELD leak fix — a resource/CoW-capturing
                    # closure value (`GorgetClosure`, fresh-Owned resource) lands
                    # in MoveDirect, which mints a FRESH `var_local` != the make-
                    # site's `cdst`. The dropped local is `var_local`, so copy
                    # the make-site's `<fn>\0<cdst> -> __Closure_N` channel entry
                    # onto `<fn>\0<var_local>`. The GorgetClosure GIDropIfAlive
                    # lowering reads it to route the env-field drop through
                    # `__Closure_N__drop`. (The OpMove zeroes `cdst`, so its own
                    # stale key never drops — no double-free.)
                    String cevt_src_key = ctx.current_fn_name + "\0" + int_to_str(val)
                    if gmod.closure_env_type.contains(cevt_src_key):
                        gmod.closure_env_type.put(ctx.current_fn_name + "\0" + int_to_str(var_local), gmod.closure_env_type.get(cevt_src_key).unwrap())
        case SReturn(opt_expr):
            # Phase 2: emit cleanup drops for every scope back to the
            # function frame BEFORE assigning the return value /
            # closing the block with GTReturn. Exclude _0 (the return
            # place) since its value is being moved out as the return
            # value; dropping it would double-free.
            match opt_expr:
                case Some(ret_expr):
                    # Expected-type-at-return (mirrors Rust gg's
                    # `lower_return` setting `func_state.expected_type =
                    # locals[0].type_id` at `stmts/mod.rs:1523-1526`).
                    # Set BEFORE lowering — the reader sites (bare
                    # prelude-variant ctors in `lower_call`, bare `None`,
                    # EIdentifier) pick up the return place's full
                    # monomorphised type and type their dst slot
                    # accordingly. This is the proper expected_type port
                    # (mirrors Rust gg's `lower_return` in
                    # `src/ir/lowering/stmts.rs`).
                    int prev_expected_ret = ctx.expected_type
                    int ret_place_ty_pre = ctx.locals.get(0).unwrap().type_id
                    if ret_place_ty_pre != I64_TYPE and ret_place_ty_pre != UNIT_TYPE:
                        ctx.expected_type = ret_place_ty_pre
                    int val = lower_expr(&ctx, ret_expr, &gmod)
                    ctx.expected_type = prev_expected_ret
                    # Throws-function Result.Ok wrapping (mirrors Rust gg's
                    # `lower_return` at `stmts/mod.rs:1585-1658`): when the
                    # return place is a `Result__T__E` (the fn is `throws`)
                    # and the returned expression produced a PLAIN value (not
                    # already a Result — e.g. a bare `Ok(x)`/`Error(x)` ctor,
                    # a throws-call result, or another Result value), wrap it
                    # in `Result.Ok(val)`. Without this, `return 42` in a
                    # throws-fn zero-inits the Result (tag=0=Ok, Ok_0=0) and
                    # silently drops the value. The bare `Ok` variant name
                    # routes through the LIR `try_lower_prelude_variant`
                    # rewrite (same substrate as `lower_throw_stmt`'s Error).
                    String ret_place_tn = type_id_to_name(ret_place_ty_pre, &gmod)
                    String ret_val_tn = type_id_to_name(ctx.locals.get(val).unwrap().type_id, &gmod)
                    if ret_place_tn.starts_with("Result__") and not ret_val_tn.starts_with("Result__"):
                        int ok_dst = add_local(&ctx, ret_place_ty_pre, NO_NAME)
                        Vector[Operand] ok_args = [op_consume(&ctx, &gmod, val, CkCallArgOwning())]
                        emit(&ctx, GICallExtern(ok_dst, "Ok", ok_args))
                        val = ok_dst
                    # Option[Ref[T]] → Option[T] lift (mirrors Rust gg's
                    # `try_lift_option_ref` call at the return site,
                    # `stmts/mod.rs:1755-1767`). `peek()`-style fns
                    # `return coll.get(i)` where `.get()` produced an
                    # `Option[Ref[T]]` but the fn returns `Option[T]` by
                    # value: deref the Ref + rebuild an OWNED Option, else
                    # the C backend hardcodes None at the type mismatch and
                    # the value leaks. Gate (mirrors Rust `:1755`): the
                    # return place (local 0) is `Option__T` (non-Ref) AND
                    # `val`'s type is a RECORDED `Option__Ref__T` (the typed
                    # `option_ref_payload` channel). No-op fallback (returns
                    # -1) otherwise — leaves `val` untouched so `return
                    # Some(x)` / `return x` / `return coll.pop()` (owned
                    # Option) / nested-Option returns are unaffected.
                    int ret_place_ty = ctx.locals.get(0).unwrap().type_id
                    String ret_place_lift_tn = type_id_to_name(ret_place_ty, &gmod)
                    int val_ty_lift = ctx.locals.get(val).unwrap().type_id
                    if ret_place_lift_tn.starts_with("Option__") and not ret_place_lift_tn.starts_with("Option__Ref__") and option_ref_payload_of(&gmod, val_ty_lift) >= 0:
                        int lifted = try_lift_option_ref(&ctx, val, ret_place_ty, &gmod)
                        if lifted >= 0:
                            val = lifted
                    Operand ret_op = op_consume(&ctx, &gmod, val, CkReturn())
                    # a-6 (concern #5, the keystone): when the value is MOVED
                    # out of a bare owned local, that local now aliases _0 and
                    # the caller's return value. Move-zero it and exclude it
                    # from the scope-exit drops — otherwise the exit
                    # drop_if_alive frees it and the caller double-frees the
                    # same heap (the canonical return-corruption double-free).
                    int excl = 0
                    match ret_op:
                        case OpMove(src):
                            excl = src
                        else:
                            pass
                    emit(&ctx, GIAssign(0, ret_op))
                    if excl != 0:
                        emit(&ctx, GIMoveZero(excl))
                    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(excl))
                    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
                case None:
                    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
                    set_terminator(&ctx, GTReturn(OpConstUnit()))
        case SExpr(sexpr):
            lower_expr(&ctx, sexpr, &gmod)
        case SIf(cond_expr, then_body, elif_branches):
            lower_if(&ctx, cond_expr, then_body, elif_branches, &gmod, is_main)
        case SWhile(cond_expr, body):
            lower_while(&ctx, cond_expr, body, &gmod, is_main)
        case SAssign(target_expr, value_expr):
            match target_expr.expr:
                case EIdentifier(name):
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        # `&`/`!`-param whole-value WRITE detection. A
                        # `GtMutPtr(inner)`-typed slot holds a `T*`; a plain
                        # GIAssign would clobber the POINTER slot instead of
                        # writing the pointee. Emit GIDerefStore (`*ptr = v`)
                        # for ANY inner — scalar `&`-writes are the primary
                        # bug, but resource `&`-writes (`String &s = s + "!"`)
                        # were ALSO dropped. Mirrors Rust gg's assign into a
                        # `Place{local,[Deref]}` (assigns.rs:231-243).
                        int asn_inner_ty = -1
                        int asn_lhs_full_ty = ctx.locals.get(lid).unwrap().type_id
                        if asn_lhs_full_ty >= PRIM_COUNT and asn_lhs_full_ty < gmod.type_table.len():
                            match gmod.type_table.get(asn_lhs_full_ty).unwrap():
                                case GtMutPtr(asn_inner):
                                    asn_inner_ty = asn_inner
                                else:
                                    pass
                        # Expected-type propagation: mirrors Rust gg's
                        # `lower_assign` at `src/ir/lowering/stmts/assigns.rs:108-117`.
                        # Setting `ctx.expected_type` to the LHS local's type
                        # BEFORE lowering the RHS lets reader sites resolve
                        # bare prelude-variant ctors / bare `None` to the
                        # destination's shape, instead of typing them by
                        # the bare variant name (which collapses to an
                        # 8-byte Ptr slot for a multi-word aggregate). For a
                        # `&`-write the destination is the POINTEE, so use the
                        # inner type, not the `GtMutPtr` wrapper.
                        int prev_expected_asn = ctx.expected_type
                        int lhs_ty = asn_lhs_full_ty
                        if asn_inner_ty >= 0:
                            lhs_ty = asn_inner_ty
                        if lhs_ty != I64_TYPE and lhs_ty != UNIT_TYPE:
                            ctx.expected_type = lhs_ty
                        int val = lower_expr(&ctx, value_expr, &gmod)
                        ctx.expected_type = prev_expected_asn
                        if asn_inner_ty >= 0:
                            emit(&ctx, GIDerefStore(lid, op_consume(&ctx, &gmod, val, CkAssign()), asn_inner_ty))
                        else:
                            Operand rhs_op = op_consume(&ctx, &gmod, val, CkAssign())
                            # ③(a) drop-on-overwrite (mirror Rust gg assigns.rs:197-231):
                            # drop `lid`'s PRIOR value AFTER computing the RHS, BEFORE the
                            # assign overwrites the slot. Gate on (1) the slot type being
                            # droppable AND (2) `lid` currently OWNING its value. A
                            # LoBorrowed/LoView alias does NOT own the old value — dropping
                            # it would free another local's heap (protects
                            # cow_param_alias_reassign: `alias = alias + " world"` where
                            # `alias` is a CoW borrow of a param). Same ownership gate as
                            # register_local_for_drop's a-1 rule.
                            bool drop_old = false
                            if is_droppable_type(asn_lhs_full_ty, &gmod):
                                match ctx.locals.get(lid).unwrap().ownership:
                                    case LoBorrowed():
                                        pass
                                    case LoView():
                                        pass
                                    else:
                                        drop_old = true
                            # Self-assign guard: `s = s` lowers to rhs source == lid;
                            # dropping then re-moving the same slot is a UAF. Skip the drop
                            # (degenerate no-op). Extract the rhs source local id.
                            int rhs_src = -1
                            match rhs_op:
                                case OpMove(s0):
                                    rhs_src = s0
                                case OpClone(s0):
                                    rhs_src = s0
                                case OpCopy(s0):
                                    rhs_src = s0
                                case OpBorrow(s0):
                                    rhs_src = s0
                                else:
                                    pass
                            if rhs_src == lid:
                                drop_old = false
                            if drop_old:
                                # Self-referential VIEW guard (mirror assigns.rs:178-196):
                                # when rhs_op is an OpClone of a borrow/view, the source may
                                # alias `lid`'s buffer (`s = s.trim()` / `s = s.slice(..)`).
                                # Materialise the clone into a fresh OWNED temp FIRST, so the
                                # clone reads the OLD buffer while it is still alive; only
                                # THEN free the old value and Move the temp in. (OpMove/OpCopy
                                # sources are independent of lid — concat/ctor results, owned
                                # locals — and the self-assign guard above already excluded
                                # rhs_src == lid, so they need no pre-materialisation.)
                                match rhs_op:
                                    case OpClone(_):
                                        int mat = add_local(&ctx, asn_lhs_full_ty, NO_NAME)
                                        emit(&ctx, GIAssign(mat, rhs_op))
                                        rhs_op = OpMove(mat)
                                    else:
                                        pass
                                # GIDropIfAlive (memcmp-gated), NOT GIDrop: a slot already
                                # moved-out earlier in this fn (drop_reassign_after_move:
                                # `tokens.push(current)` zeroes current's slot via the
                                # post-pass GIMoveZero, then `current = ""`) is then a
                                # runtime no-op. Mirrors Rust's is_moved -> drop_if_alive.
                                emit(&ctx, GIDropIfAlive(lid))
                            emit(&ctx, GIAssign(lid, rhs_op))
                    elif static_contains(&gmod, name):
                        # Module-level mutable-static WRITE (`STATIC = value`).
                        # A `static` is mutable storage; the destination is the
                        # global itself. `lower_place_base` returns a
                        # `GtMutPtr(sty)` slot holding the global's address
                        # (`__global_ref__<name>` → IGlobalAddr), so we
                        # deref-store the RHS through it. Without this the write
                        # was silently dropped (statics fell through every local
                        # arm). Mirrors Rust gg's assign into a static
                        # `Place{global,[Deref]}` (assigns.rs:389-392).
                        int sty = static_lookup_type(&gmod, name)
                        int prev_expected_st = ctx.expected_type
                        if sty != I64_TYPE and sty != UNIT_TYPE:
                            ctx.expected_type = sty
                        int sval = lower_expr(&ctx, value_expr, &gmod)
                        ctx.expected_type = prev_expected_st
                        int sptr = lower_place_base(&ctx, target_expr, &gmod)
                        emit(&ctx, GIDerefStore(sptr, op_consume(&ctx, &gmod, sval, CkAssign()), sty))
                case EFieldAccess(base_box, field_name):
                    # self.field = value
                    # Lower as: __field_write_TYPE_FIELD(&base, value).
                    # The codegen expands this to `((T*)base)->field = value;`.
                    # Previously silently dropped — `self.lex_pos += 1` didn't
                    # increment, leaving the lexer loop spinning.
                    lower_field_write(&ctx, *base_box, field_name, value_expr, &gmod)
                case EIndex(base_box, idx_box):
                    # v[i] = x — Vector/Dict/Set index assignment. Dispatch
                    # to the collection's runtime setter based on the base
                    # type name. The self-host uses this for Dict[K,V] put
                    # (int_consts[name] = val) and Vector[T] set patterns.
                    lower_index_assign(&ctx, *base_box, *idx_box, value_expr, &gmod)
                else:
                    lower_fail("SAssign target is neither EIdentifier, EFieldAccess, nor EIndex (got: " + expr_kind(target_expr.expr) + ")")
        case SBreak(_):
            # Jump to the innermost loop's break target. Silently dropped
            # before, which caused while-loops in the self-host lexer to
            # never exit on their closing-quote checks.
            # Phase 2: emit cleanup drops up to (and including) the
            # innermost Loop scope before the jump.
            if ctx.loop_break_stack.len() > 0:
                int tgt = ctx.loop_break_stack.get(ctx.loop_break_stack.len() - 1).unwrap()
                emit_drops_for_early_exit(&ctx, DSK_LOOP, None)
                set_terminator(&ctx, GTJump(tgt))
        case SContinue:
            if ctx.loop_continue_stack.len() > 0:
                int tgt = ctx.loop_continue_stack.get(ctx.loop_continue_stack.len() - 1).unwrap()
                emit_drops_for_early_exit(&ctx, DSK_LOOP, None)
                set_terminator(&ctx, GTJump(tgt))
        case SPass:
            # `pass` is a literal no-op statement. Explicit case silences
            # the lower_fail diagnostic; behaviour is unchanged.
            pass
        case SMeta:
            # Standalone `meta` marker — compile-time sentinel, no runtime.
            pass
        case SMetaFor(_):
            # `meta for` — compile-time loop already expanded earlier in
            # the pipeline; any remaining SMetaFor is a residual marker.
            pass
        case SMetaIf(_, _):
            # `meta if` — compile-time conditional, already resolved.
            pass
        case SMatch(scrutinee, arms):
            # Real SMatch lowering — delegates to lower_match_stmt for
            # the per-arm ctor / binding / guard scaffolding. Payload
            # binds of type Box[T] are consumed via EDeref → GIDeref
            # which emits a proper load.
            lower_match_stmt(&ctx, scrutinee, arms, &gmod, is_main)
        case SLoop(body):
            # Unconditional loop — `loop: body`, exit via break. Same
            # shape as `while true:`, but the body's default back-edge
            # jumps to the body itself rather than a condition header.
            int loop_bb = new_block(&ctx)
            int loop_exit_bb = new_block(&ctx)
            set_terminator(&ctx, GTJump(loop_bb))
            ctx.loop_continue_stack.push(loop_bb)
            ctx.loop_break_stack.push(loop_exit_bb)
            # Phase 2: open a Loop drop scope around the body. Locals
            # declared inside the body get cleaned up before the
            # back-edge / break-edge jumps fire.
            push_drop_scope(&ctx.drop_elab, DSK_LOOP)
            switch_to(&ctx, loop_bb)
            lower_stmts(&ctx, body, &gmod, is_main)
            Terminator loop_body_term = ctx.block_terms.get(ctx.current_block).unwrap()
            match loop_body_term:
                case GTNone():
                    # Natural body fall-off — emit Loop-scope drops
                    # before the back-edge jump.
                    pop_drop_scope(&ctx)
                    set_terminator(&ctx, GTJump(loop_bb))
                else:
                    # Body already broke / continued / returned. Those
                    # paths emitted their own drops; just pop the scope
                    # bookkeeping without re-emitting.
                    pop_drop_scope_no_emit(&ctx)
            ctx.loop_continue_stack.pop()
            ctx.loop_break_stack.pop()
            switch_to(&ctx, loop_exit_bb)
        case SCompoundAssign(target_expr, op, value_expr):
            # x <op>= y  →  x = x <op> y. Lower per target shape: local
            # identifier goes through GIAssign, field access goes through
            # __field_read + binop + __field_write.
            match target_expr.expr:
                case EIdentifier(name):
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        int lhs_full_type = ctx.locals.get(lid).unwrap().type_id
                        # `&`/`!`-param compound-assign (`x += 1` on `int &x`)
                        # is broken on BOTH legs: the slot holds a `T*`, so a
                        # bare read of `lid` consumes the POINTER bits (the
                        # binop would do arithmetic on the pointer) AND the
                        # GIAssign write-back clobbers the pointer slot. Detect
                        # `GtMutPtr(inner)`: deref-load the current value before
                        # the binop, run the binop at the INNER type, and store
                        # the result back THROUGH the pointer via GIDerefStore.
                        int cmp_inner_ty = -1
                        if lhs_full_type >= PRIM_COUNT and lhs_full_type < gmod.type_table.len():
                            match gmod.type_table.get(lhs_full_type).unwrap():
                                case GtMutPtr(cmp_inner):
                                    cmp_inner_ty = cmp_inner
                                else:
                                    pass
                        if cmp_inner_ty >= 0:
                            # `&`-param path: read `*lid` into a value temp.
                            int cmp_cur = add_local(&ctx, cmp_inner_ty, NO_NAME)
                            emit(&ctx, GIDeref(cmp_cur, lid, cmp_inner_ty))
                            int cmp_rhs = lower_expr(&ctx, value_expr, &gmod)
                            int cmp_dst = add_local(&ctx, cmp_inner_ty, NO_NAME)
                            emit_compound_arith(&ctx, op, cmp_dst, cmp_cur, cmp_rhs, cmp_inner_ty, &gmod)
                            emit(&ctx, GIDerefStore(lid, op_consume(&ctx, &gmod, cmp_dst, CkAssign()), cmp_inner_ty))
                        else:
                            int lhs_type = lhs_full_type
                            int lhs_val = add_local(&ctx, lhs_type, NO_NAME)
                            emit(&ctx, GIAssign(lhs_val, op_consume(&ctx, &gmod, lid, CkAssign())))
                            int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                            int op_dst = add_local(&ctx, lhs_type, NO_NAME)
                            emit_compound_arith(&ctx, op, op_dst, lhs_val, rhs_val, lhs_type, &gmod)
                            emit(&ctx, GIAssign(lid, op_consume(&ctx, &gmod, op_dst, CkAssign())))
                    elif static_contains(&gmod, name):
                        # Module-level mutable-static COMPOUND-assign
                        # (`STATIC += y` → `STATIC = STATIC <op> y`). Read the
                        # current value via `lower_expr` (routes through
                        # `lower_static_ref_ident` → `__global_ref__` load), run
                        # the binop at the static's type, then store the result
                        # back THROUGH the global-address pointer that
                        # `lower_place_base` yields. Mirrors Rust gg's compound
                        # assign into a static (assigns.rs:1120-1146).
                        int csty = static_lookup_type(&gmod, name)
                        int clhs_val = lower_expr(&ctx, target_expr, &gmod)
                        int crhs_val = lower_expr(&ctx, value_expr, &gmod)
                        int cop_dst = add_local(&ctx, csty, NO_NAME)
                        emit_compound_arith(&ctx, op, cop_dst, clhs_val, crhs_val, csty, &gmod)
                        int csptr = lower_place_base(&ctx, target_expr, &gmod)
                        emit(&ctx, GIDerefStore(csptr, op_consume(&ctx, &gmod, cop_dst, CkAssign()), csty))
                case EFieldAccess(base_box, field_name):
                    # self.field <op>= value
                    # Lower as: self.field = self.field <op> value.
                    # Read via lower_expr on the original field-access
                    # expression (reuses __field_read), binop, field write.
                    int lhs_val = lower_expr(&ctx, target_expr, &gmod)
                    int lhs_type = ctx.locals.get(lhs_val).unwrap().type_id
                    int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                    int op_dst = add_local(&ctx, lhs_type, NO_NAME)
                    emit_compound_arith(&ctx, op, op_dst, lhs_val, rhs_val, lhs_type, &gmod)
                    # Wrap op_dst in a synthetic SpannedExpr to feed the
                    # same field-write path used above.
                    emit_field_write_from_local(&ctx, *base_box, field_name, op_dst, &gmod)
                else:
                    lower_fail("SCompoundAssign target is neither EIdentifier nor EFieldAccess")
        case SFor(pat, iter_expr, body, _own, else_body):
            lower_for(&ctx, pat, iter_expr, body, else_body, &gmod, is_main)
        case SThrow(throw_expr):
            lower_throw_stmt(&ctx, throw_expr, &gmod)
        case SOnError(cleanup_body):
            # Register the cleanup block — emitted on error-exit paths
            # (throw / rethrow error return). Mirrors Rust's
            # `Stmt::OnError` push at `stmts/mod.rs:342`.
            ctx.on_error_blocks.push(cleanup_body)
        case SWith(with_resource, with_name, with_body):
            # R9 FIDELITY — `with <allocator>: as name:`-block lowering.
            # Mirrors Rust gg's `lower_with` (`src/ir/lowering/stmts/mod.rs:
            # 2732-2849`), single-binding. Before this, SWith hit the `else`
            # fall-through → lower_fail → the whole body was silently DROPPED.
            #
            # The `with` block is linear control flow (no new basic blocks):
            # construct the resource, push it as the active thread-local
            # allocator, run the body inside a fresh block drop-scope, then
            # pop the scope (dropping body locals while the allocator is still
            # alive — avoids UAF), pop the allocator, and destroy it.
            #
            # SCOPED to allocator `with`-blocks whose body uses VALUE methods.
            # Detection of the allocator-constructor shape mirrors Rust's
            # `is_allocator_constructor` (`stmts/mod.rs:2609`) via the
            # runtime-name map.
            #
            # Step 1 — lower the resource expr (routes through Root A's
            # allocator-constructor interception → `gorget_<kind>_new`,
            # yielding a `GtPtr(Named(kind))` local). Bind the with-name.
            String with_alloc_kind = ""
            match with_resource.expr:
                case ECall(with_callee_box, _, _):
                    SpannedExpr with_callee = *with_callee_box
                    match with_callee.expr:
                        case EIdentifier(with_ctor_name):
                            if allocator_constructor_runtime_name(with_ctor_name) != "":
                                with_alloc_kind = with_ctor_name
                        else:
                            pass
                else:
                    pass
            int with_val = lower_expr(&ctx, with_resource, &gmod)
            int with_ty = ctx.locals.get(with_val).unwrap().type_id
            int with_local = add_local(&ctx, with_ty, Some(with_name))
            # ⚠ MUST nl_put to bind the identifier: add_local only appends to
            # ctx.locals, it does NOT bind the name. Body refs (`pool.…`)
            # resolve via nl_get; SVarDecl binds the same way. Without this
            # the body method calls resolve to `…__bytes_used(0)`.
            emit(&ctx, GIAssign(with_local, op_consume(&ctx, &gmod, with_val, CkAssign())))
            nl_put(&ctx, with_name, with_local)
            # Allocator local is `GtPtr(Named(kind))` — is_droppable_type
            # returns false for Ptr slots, so register_local_for_drop skips
            # it (no double-free; the manual destroy below is sole cleanup).
            register_local_for_drop(&ctx, with_local, with_ty, &gmod)
            # Step 2 — push as the active thread-local allocator.
            if with_alloc_kind != "":
                Vector[Operand] with_push_args = []
                with_push_args.push(OpCopy(with_local))
                emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", with_push_args))
            # Step 3 — lower the body inside a fresh block drop-scope so locals
            # declared in the body are cleaned up at block exit (canonical
            # block pattern, mirrors lower_if's then-branch).
            push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
            lower_stmts(&ctx, with_body, &gmod, is_main)
            # Step 4 — body locals drop FIRST (while the allocator is alive),
            # then pop + destroy the allocator (mirrors lower_with:2826-2847).
            pop_drop_scope(&ctx)
            # Step 5 — pop the active allocator + destroy the handle.
            if with_alloc_kind != "":
                emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
                String with_destroy_fn = allocator_type_destroy_name(with_alloc_kind)
                if with_destroy_fn != "":
                    Vector[Operand] with_destroy_args = []
                    with_destroy_args.push(OpCopy(with_local))
                    emit(&ctx, GICallExtern(-1, with_destroy_fn, with_destroy_args))
        case SAssert(assert_cond, assert_msg_opt):
            # R11: lower an assert to a conditional panic — mirrors Rust's
            # lower_assert simple path (src/ir/lowering/stmts/mod.rs:2358-2385).
            # Without this, SAssert hit `else: lower_fail` and was SILENTLY
            # DROPPED (the assert + a [lower_fail] comment; the body continued).
            #
            # `directive strip-asserts` makes asserts no-ops — emit NOTHING
            # (no blocks, no branch), mirroring Rust's early-return
            # (stmts/mod.rs:2293-2296). Guarding the WHOLE body (not just the
            # condition eval) is required: otherwise `assert false` under
            # strip-asserts would still panic (regresses use_strip_asserts),
            # and a stripped condition would leave assert_cv unbound.
            if not gmod.strip_asserts:
                int assert_cv = lower_expr(&ctx, assert_cond, &gmod)
                int assert_pass_bb = new_block(&ctx)
                int assert_fail_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(assert_cv), assert_pass_bb, assert_fail_bb))
                switch_to(&ctx, assert_fail_bb)
                String assert_msg = "assertion failed"
                match assert_msg_opt:
                    case Some(am):
                        assert_msg = am
                    case None:
                        pass
                emit(&ctx, GICallExtern(-1, "gorget_panic", [OpConstStr(assert_msg)]))
                # gorget_panic is noreturn; this jump is a DEAD edge that keeps
                # the CFG well-formed (Terminator has no GTUnreachable — Rust
                # uses unreachable(); GTJump(pass_bb) is the faithful self-host
                # equivalent, mirroring the merge-jump idiom at lower.gg:4285).
                set_terminator(&ctx, GTJump(assert_pass_bb))
                switch_to(&ctx, assert_pass_bb)
        else:
            lower_fail("unhandled in lower_stmt: " + stmt_kind(stmt))

# Lower the BASE of a place projection (field access, index, method
# receiver) to its local id WITHOUT the value-read auto-deref. A bare
# `EIdentifier` naming a local resolves directly to its slot — for a
# `&`/`!` param (`GtMutPtr`) or bare-resource param (`GtPtr`) that slot
# holds the POINTER, which is exactly what the field/index/method
# codegen needs (`((T*)base)->field`). Going through `lower_expr` here
# would trip Edit-1's value-read deref and hand back a dereffed VALUE
# copy, so a field write would update a discarded temp. Mirrors Rust gg,
# where place lowering (assigns.rs) keeps the base local + a Deref
# projection and never routes through the value-operand deref
# (exprs/mod.rs:140). Non-identifier bases (nested field access, calls,
# etc.) fall back to `lower_expr` unchanged.
int lower_place_base(LowerCtx &ctx, SpannedExpr base_expr, GirModule &gmod):
    match base_expr.expr:
        case EIdentifier(name):
            if nl_contains(&ctx, name):
                return nl_get(&ctx, name)
            # static-as-place — emit a Ptr alias to the global so a method
            # receiver / field-write / index base mutates the REAL static,
            # not a value copy. A GtMutPtr slot makes lir_lower store the
            # global's address directly (no load/copy).
            if static_contains(&gmod, name):
                int sty = static_lookup_type(&gmod, name)
                int pty = register_type(&gmod, GtMutPtr(sty))
                int pdst = add_local(&ctx, pty, NO_NAME)
                Vector[Operand] no_args = []
                emit(&ctx, GICallExtern(pdst, "__global_ref__" + name, no_args))
                return pdst
        else:
            pass
    return lower_expr(&ctx, base_expr, &gmod)

# Lower `base.field = value_expr`. Emits GICallExtern for the codegen-side
# __field_write_TYPE_FIELD helper which expands to `((T*)base)->field = value`.
void lower_field_write(LowerCtx &ctx, SpannedExpr base_expr, String field_name, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    # Unwrap Ptr/MutPtr to get the inner type name.
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    # Expected-type propagation for the RHS, mirroring the EStructLiteral
    # field-init site (lower.gg:~5915-5924). Without it a bare `None`
    # field-store (`fm.desc = None`) lowers to an 8-byte `void*` default
    # slot — the field-write then `memcpy`s from a NULL/garbage source into
    # the Option slot → SEGV. Look the dest field's declared type up via
    # `gmod.type_infos` matched by field NAME (`base_type_name` is already
    # Ptr/MutPtr-unwrapped here), set `ctx.expected_type` under the same
    # I64/UNIT guard as the EStructLiteral site, lower, then RESTORE.
    int prev_expected_fw = ctx.expected_type
    if gmod.type_infos.contains(base_type_name):
        GirTypeInfo fw_ti = gmod.type_infos.get(base_type_name).unwrap()
        int fw_fi = 0
        while fw_fi < fw_ti.fields.len():
            GirFieldInfo fw_field = fw_ti.fields.get(fw_fi).unwrap()
            if fw_field.name == field_name:
                String fw_fty_name = fw_field.type_name.clone()
                if fw_fty_name != "":
                    int fw_fty = lookup_or_register_named(&gmod, fw_fty_name)
                    if fw_fty != I64_TYPE and fw_fty != UNIT_TYPE:
                        ctx.expected_type = fw_fty
            fw_fi += 1
    int val = lower_expr(&ctx, value_expr, &gmod)
    ctx.expected_type = prev_expected_fw
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # A field-store never consumes its base; it mutates in place via the
        # base's address. Borrowed base → OpBorrow; owned (LoOwned) base → also
        # OpBorrow (its slot address), NOT OpMove — an OpMove gets rewritten to
        # OpClone by the liveness pass when the base is live past the store,
        # which would clone-and-discard the base and never mutate the original.
        GirLocal fw_base_loc = ctx.locals.get(base).unwrap()
        match fw_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpBorrow(base))
    write_args.push(op_consume(&ctx, &gmod, val, CkFieldWrite()))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# Variant of lower_field_write that takes a pre-lowered local id for the
# value rather than re-lowering an expression.
void emit_field_write_from_local(LowerCtx &ctx, SpannedExpr base_expr, String field_name, int value_local, GirModule &gmod):
    int base = lower_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # A field-store never consumes its base; it mutates in place via the
        # base's address. Borrowed base → OpBorrow; owned (LoOwned) base → also
        # OpBorrow (its slot address), NOT OpMove — an OpMove gets rewritten to
        # OpClone by the liveness pass when the base is live past the store,
        # which would clone-and-discard the base and never mutate the original.
        GirLocal fwf_base_loc = ctx.locals.get(base).unwrap()
        match fwf_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpBorrow(base))
    write_args.push(op_consume(&ctx, &gmod, value_local, CkFieldWrite()))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# ── Control flow lowering ────────────────────────────────

void lower_stmts(LowerCtx &ctx, Vector[Stmt] stmts, GirModule &gmod, bool is_main):
    for stmt in stmts:
        lower_stmt(&ctx, stmt, &gmod, is_main)

void lower_if(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] then_body, Vector[ElseBranch] elif_branches, GirModule &gmod, bool is_main):
    # The condition is bool-typed and independent of any enclosing
    # destination — clear `expected_type` around it so a leaked Result-typed
    # expectation doesn't make the centralized auto-prop hook's capture-form
    # check suppress a throws-call condition's peel (`if might():`).
    int saved_expected_if = ctx.expected_type
    ctx.expected_type = -1
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    ctx.expected_type = saved_expected_if
    # Auto-propagate a `throws` call used as the condition (`if might():`).
    cond = maybe_auto_propagate(&ctx, cond, &gmod)
    int then_bb = new_block(&ctx)
    int else_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
    # Then branch — Phase 2: open a Block drop scope per branch so
    # locals declared inside the branch get cleaned up at the merge
    # edge. Use pop_drop_scope_no_emit on early-exit branches (return/
    # break/continue already emitted their drops).
    switch_to(&ctx, then_bb)
    push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
    lower_stmts(&ctx, then_body, &gmod, is_main)
    # Only jump to merge if not already terminated (no return/break)
    Terminator then_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match then_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    # Else branch
    switch_to(&ctx, else_bb)
    push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
    if elif_branches.len() > 0:
        ElseBranch eb = elif_branches.get(0).unwrap()
        match eb.condition:
            case Some(elif_cond):
                # elif branch — recurse
                Vector[ElseBranch] remaining = []
                int ebi = 1
                while ebi < elif_branches.len():
                    remaining.push(elif_branches.get(ebi).unwrap())
                    ebi = ebi + 1
                lower_if(&ctx, elif_cond, eb.body, remaining, &gmod, is_main)
            case None:
                # else branch
                lower_stmts(&ctx, eb.body, &gmod, is_main)
    Terminator else_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match else_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    switch_to(&ctx, merge_bb)


# Lower `base[idx] = value` as a collection-typed setter call. Vector
# routes to gorget_array_set; Dict / HashMap route to gorget_map_put;
# Set has no meaningful index-assign so falls through to lower_fail.
void lower_index_assign(LowerCtx &ctx, SpannedExpr base_expr, SpannedExpr idx_expr, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_tname = type_id_to_name(base_tid, &gmod)
    # idx (int/key) + val (element) are independently typed, not the
    # surrounding context — clear any leaked `expected_type` so a Result-typed
    # expectation doesn't make the centralized auto-prop hook's capture-form
    # check suppress a throws-call idx/value's peel (`v[pick()] = might()`).
    int saved_expected_ia = ctx.expected_type
    ctx.expected_type = -1
    int idx = lower_expr(&ctx, idx_expr, &gmod)
    int val = lower_expr(&ctx, value_expr, &gmod)
    ctx.expected_type = saved_expected_ia
    idx = maybe_auto_propagate(&ctx, idx, &gmod)
    val = maybe_auto_propagate(&ctx, val, &gmod)
    String setter = ""
    # Phase A typed read: dispatch on the receiver's collection_kind.
    # CkSet / CkHeap have no meaningful index-assign — fall through to lower_fail.
    match resource_meta_for(&gmod, base_tname):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkVector():
                    setter = "gorget_array_set"
                case CkDeque():
                    setter = "gorget_array_set"
                case CkDict():
                    setter = "gorget_map_put"
                else:
                    pass
        case None:
            pass
    if setter == "":
        lower_fail("lower_index_assign: unsupported base type " + base_tname)
        return
    # gorget_array_set / gorget_map_put take self by pointer (&base),
    # key/index by value, and value by pointer-or-value depending on
    # element type. An index-assign NEVER consumes its base — it mutates
    # in place via the base's address. Mirror lower_field_write's documented
    # fix (~:7394): Ptr/static base → OpCopy (the local already holds the
    # address); owned OR borrowed base → OpBorrow (its slot address), NOT
    # OpMove. An OpMove gets rewritten to OpClone by the liveness pass when
    # the base is live past the store (it always is — `d[k]=v` keeps `d`
    # live), which clones-and-discards the base and never mutates the
    # original (the d[k]=v clone-bomb: every assign mutated a throwaway).
    Operand base_op = OpBorrow(base)
    if is_ptr_type(base_tid, &gmod):
        base_op = OpCopy(base)
    # `base[idx] = val` → setter(base, idx, val): the collection takes
    # ownership of BOTH key/idx AND val (consuming position per CLAUDE.md).
    # gorget_map_put is the NO-CLONE ownership-transfer variant — it does
    # NOT hash/clone the key internally; the map TAKES the key. So key →
    # CkCallArgOwning (an owned String key would otherwise double-free).
    # For Vector int index this is inert (by-value scalar, no drop). val →
    # CkCallArgOwning (unchanged).
    Vector[Operand] set_args = [base_op, op_consume(&ctx, &gmod, idx, CkCallArgOwning()), op_consume(&ctx, &gmod, val, CkCallArgOwning())]
    emit(&ctx, GICallExtern(-1, setter, set_args))

# Look up the parent enum name for a type. If `type_name` itself is an
# enum (GirTypeInfo.is_enum), returns it. Otherwise returns "".
String match_enum_type(String type_name, GirModule &gmod):
    # Check the enum registry first (populated from EnumDef pass).
    if gmod.enum_registry.contains(type_name):
        return type_name
    if gmod.type_infos.contains(type_name):
        GirTypeInfo ti = gmod.type_infos.get(type_name).unwrap()
        if ti.is_enum:
            return type_name
    # Prelude mono'd enums (Option__X / Result__X__Y) aren't in
    # type_infos — they're synthesized in lir_lower's Pass 3. But
    # `match opt: case Some(x): ...` needs a real enum name here or
    # lower_ctor_pattern falls through to an always-match `GTJump`, so
    # every arm body runs unconditionally (which is why stage-1 tokenized
    # "main" as TkKeyword — the `else:` branch of the Option match was
    # never reached). Return the type_name itself for these; paired with
    # match_variant_index's hardcoded Some/None/Ok/Error indices below.
    if type_name.starts_with("Option__") or type_name.starts_with("Result__"):
        return type_name
    return ""

# Find the variant's index in its enum's variant list. Returns -1 if
# the enum or variant isn't registered.
int match_variant_index(String enum_name, String variant_name, GirModule &gmod):
    # Prelude enums: hardcode variant indices that match lir_lower's
    # VariantInfo table (prelude_variant_info) and Pass 3's field layout.
    # Match both the mono'd form (`Option__T`) AND the bare prelude name
    # (`Option`) — the latter is the synthetic name used by
    # `lower_ctor_pattern`'s last-resort fallback when the scrutinee's
    # type couldn't be recovered.
    if enum_name == "Option" or enum_name.starts_with("Option__"):
        if variant_name == "Some":
            return 0
        if variant_name == "None":
            return 1
        return -1
    if enum_name == "Result" or enum_name.starts_with("Result__"):
        if variant_name == "Ok":
            return 0
        if variant_name == "Error":
            return 1
        return -1
    # Check the enum registry first; fall back to type_infos.
    int reg_idx = enum_variant_index(&gmod, enum_name, variant_name)
    if reg_idx >= 0:
        return reg_idx
    if not gmod.type_infos.contains(enum_name):
        return -1
    GirTypeInfo ti = gmod.type_infos.get(enum_name).unwrap()
    int i = 0
    while i < ti.variants.len():
        GirEnumVariantInfo v = ti.variants.get(i).unwrap()
        if v.name == variant_name:
            return i
        i += 1
    return -1

# Convert `Option[Ref[T]] → Option[T]` by tag-branching and cloning /
# dereffing the Some payload. Mirrors Rust gg's `try_lift_option_ref`
# (`src/ir/lowering/stmts/mod.rs:2934-3065`).
#
# `val` is a local holding an `Option__Ref__T` value (a borrow-Option
# produced by a borrowing getter like `coll.get(i)`); `dst_type` is the
# `Option__T` (non-Ref) return-place / binding type. Returns the local id
# of a freshly-filled merge holding the owned `Option[T]`, or -1 if the
# shapes don't match (caller passes `val` through untouched — the no-op
# fallback that preserves `return Some(x)` / `return x` / `return
# coll.pop()` / nested-Option).
#
# The shape gate is the TYPED `option_ref_payload` channel — `ptr_tid =
# option_ref_payload_of(&gmod, src_type) >= 0` iff this Option tid was
# RECORDED by a borrowing-getter lowering (`record_option_ref_payload`).
# That recorded-ness (not a structural `Ref__`-name re-parse) is what
# makes the gate sound: a hand-built `Option__Ref__T` that bypassed a
# getter has no channel entry and is left alone (CLAUDE.md "No name
# matching"). The dst must be `Option__` (NOT `Option__Ref__`) — mirrors
# Rust `:2966-2968`.
#
# Structured on the `unwrap_or` template (`:4894-4912`): tag-read +
# GICmp + GTBranch into a Some / None / merge BB trio. The Some arm reads
# the GtPtr payload via `emit_payload_read` (whose own `GtPtr` guard,
# `:6965-6968`, returns the bare ptr for a resource pointee and `GIDeref`s
# a primitive pointee), then lets `op_consume(CkCallArgOwning)` pick
# clone-vs-copy — `GtPtr(resource)` → OpClone (deep clone), primitive
# value → OpCopy (`decide_ptr_consume`, `:1634`). The SAME `is_resource`
# decision `emit_payload_read` used, so there is no second predicate to
# keep in sync. Each arm stores its built Option into `merge` via
# `op_consume(CkAssign)` — AUTO-Move for an owned resource Option
# (mirrors Rust `assign_mode(Move) when is_resource_type(dst)`,
# `:3038-3046`); a plain `GIAssign(merge, OpCopy(res))` would shallow-alias
# the freshly-built resource Option → double-free.
int try_lift_option_ref(LowerCtx &ctx, int val, int dst_type, GirModule &gmod):
    if val < 0 or val >= ctx.locals.len():
        return -1
    int src_type = ctx.locals.get(val).unwrap().type_id
    # Shape gate (typed channel): src must be a RECORDED Option[Ref[T]],
    # and the recorded payload is the GtPtr(inner) tid we read the Some
    # field through.
    int ptr_tid = option_ref_payload_of(&gmod, src_type)
    if ptr_tid < 0:
        return -1
    # dst must be `Option__T` (non-Ref).
    String dst_name = type_id_to_name(dst_type, &gmod)
    if not dst_name.starts_with("Option__"):
        return -1
    if dst_name.starts_with("Option__Ref__"):
        return -1
    String src_name = type_id_to_name(src_type, &gmod)
    # Materialise the result slot up front; both arms store into it so the
    # merge block sees a single def (SSA construction inserts the phi).
    int merge = add_local(&ctx, dst_type, NO_NAME)
    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, val)
    int tag = emit_tag_read(&ctx, scr_ptr, src_name, &gmod)
    # tag == 0 → Some arm.
    int cmp_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cmp_dst, CMP_EQ, I64_TYPE, OpCopy(tag), OpConstI64(0)))
    int some_bb = new_block(&ctx)
    int none_bb = new_block(&ctx)
    int lift_merge_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cmp_dst), some_bb, none_bb))
    # Some arm: read the GtPtr payload (emit_payload_read's GtPtr guard
    # returns the bare ptr for a resource pointee, GIDerefs a primitive),
    # build Some(owned), let op_consume clone-or-copy.
    switch_to(&ctx, some_bb)
    int payload = emit_payload_read(&ctx, scr_ptr, src_name, "Some", 0, ptr_tid, &gmod)
    int some_res = add_local(&ctx, dst_type, NO_NAME)
    Vector[Operand] some_args = [op_consume(&ctx, &gmod, payload, CkCallArgOwning())]
    emit(&ctx, GICallExtern(some_res, "Some", some_args))
    emit(&ctx, GIAssign(merge, op_consume(&ctx, &gmod, some_res, CkAssign())))
    set_terminator(&ctx, GTJump(lift_merge_bb))
    # None arm: build None directly.
    switch_to(&ctx, none_bb)
    int none_res = add_local(&ctx, dst_type, NO_NAME)
    Vector[Operand] none_args = []
    emit(&ctx, GICallExtern(none_res, "None", none_args))
    emit(&ctx, GIAssign(merge, op_consume(&ctx, &gmod, none_res, CkAssign())))
    set_terminator(&ctx, GTJump(lift_merge_bb))
    switch_to(&ctx, lift_merge_bb)
    return merge

# Emit a tag-read against the scrutinee. Returns the local id holding
# the int32 tag value. The enum_name must be a plain identifier (no
# `__` separator); Option/Result variants aren't yet supported by this
# routing because the name-based __field_read_ parser splits on the
# first `_` and confuses `Option__int64_t` with the `Option` type.
int emit_tag_read(LowerCtx &ctx, int scrutinee_ptr, String enum_name, GirModule &gmod):
    String read_fn = "__field_read_" + enum_name + "_tag"
    Vector[Operand] args = [op_consume(&ctx, &gmod, scrutinee_ptr, CkMatchPtr()), OpConstI64(0)]
    int tag = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GICallExtern(tag, read_fn, args))
    return tag

# Resolve the runtime clone function for a payload type, or "" if no
# safe clone is available at this site. Routes through
# `build_resource_metadata` for builtin runtime types
# (GorgetString/Array/Map/Set/Closure and their parameterised forms);
# user-defined resource structs/enums would use `T__clone` but the
# C codegen emits that symbol only for types in
# `recursive_drop_structs`/`recursive_drop_enums`, populated later
# in the LIR-lower pass. Emitting `T__clone` here for a type that
# never gets registered produces a stage-1 link error; until the
# user-type clone emission is wired through `gmod.resource_types`
# unconditionally, restrict the clone path to builtins.
#
# `gorget_string_clone_to_owned` and `gorget_closure_clone_to_owned`
# override `build_resource_metadata`'s `clone_fn` because their
# `_to_owned` variants are what `infer_runtime_return_type` registers
# as returning the struct type by value (vs the in-place variants
# that return void).
# True iff `clone_fn` is a DEEP (recursive, subtree-copying) clone — a user
# `T__clone` or a collection `gorget_{array,map,set}_clone`. These are the
# clone-bomb types whose per-descent invocation compounds O(tree^2) in the
# recursive AST walkers, so they are the ones the CoW borrow-elision skips.
# String/Closure clones (`gorget_string_clone_to_owned` /
# `gorget_closure_clone_to_owned`) are single-level + have a value-slot
# consume ABI that the borrow path can't satisfy — they keep eager cloning.
bool is_deep_clone_fn(String clone_fn):
    if clone_fn == "":
        return false
    if clone_fn == "gorget_array_clone" or clone_fn == "gorget_map_clone" or clone_fn == "gorget_set_clone":
        return true
    if clone_fn == "gorget_string_clone_to_owned" or clone_fn == "gorget_closure_clone_to_owned":
        return false
    # Any other resolved clone fn is a user-type `T__clone` (deep).
    return clone_fn.ends_with("__clone")

String resolve_payload_clone_fn(String tname, GirModule &gmod):
    if tname == "":
        return ""
    match resource_meta_for(&gmod, tname):
        case Some(rmeta):
            match rmeta.clone_fn:
                case Some(fn):
                    if rmeta.runtime_name == "GorgetString":
                        return "gorget_string_clone_to_owned"
                    if rmeta.runtime_name == "GorgetClosure":
                        return "gorget_closure_clone_to_owned"
                    return fn
                case None:
                    pass
        case None:
            pass
    # §7 row 1 (2026-05-13; de-gated 2026-05-27): user-type fallback.
    # `T__clone` is emitted by `populate_drop_metadata` in `lir_lower.gg`
    # for EVERY type registered as a resource — the `__imported_type__`
    # skip there was REMOVED in cluster (a) 2026-05-24 (lir_lower.gg:3562),
    # because whole-program compilation emits all user types in one C file
    # and double-definition is guarded by `fn_exists()`, not by suppression.
    # We mirror that here: return `T__clone` for any registered resource
    # user type, imported or not — the LIR layer always defines it. The
    # old imported-type gate left Branch C-pre (lower.gg:805-814) skipping
    # the deref+clone for imported types, so `Item item = m.items.get(i)
    # .unwrap()` bound a BorrowAlias into m.items[i] → the meta-expansion
    # recursive get-mutate-set aliased the slot → stage-2 double-free.
    if gmod.resource_types.contains(tname) and gmod.type_infos.contains(tname):
        return tname + "__clone"
    return ""

# Emit a variant-payload read. `variant_name` + `field_idx` determines
# which struct field to read; result binds into `dst_type`.
# `borrow_only` (CoW for-element default): when true, return the
# LoBorrowed/BoField field-read alias WITHOUT materialising a clone.
# Used by the for-loop element extract (`for x in coll`), where the
# element is a borrow into the collection per the CoW default
# (CLAUDE.md "Ownership at Consuming Positions": collection element
# reads propagate Ptr aliases at zero cost). A read-only loop body
# then costs zero clones; a body that CONSUMES/MUTATES the element
# clones on demand via op_consume's a-5 LoBorrowed arm at that
# consume site. Match-arm payload binds pass false → keep the eager
# clone (their binding semantics own the payload).
int emit_payload_read(LowerCtx &ctx, int scrutinee_ptr, String enum_name, String variant_name, int field_idx, int dst_type, GirModule &gmod):
    return emit_payload_read_mode_full(&ctx, scrutinee_ptr, enum_name, variant_name, field_idx, dst_type, &gmod, false, false)

int emit_payload_read_mode(LowerCtx &ctx, int scrutinee_ptr, String enum_name, String variant_name, int field_idx, int dst_type, GirModule &gmod, bool borrow_only):
    return emit_payload_read_mode_full(&ctx, scrutinee_ptr, enum_name, variant_name, field_idx, dst_type, &gmod, borrow_only, false)

# `borrow_all` (owned-whole-dropped scrutinee): when true, elide the clone for
# EVERY payload type — String/Closure included — not just the DEEP-clone
# aggregates the `borrow_only` path covers. The scrutinee OWNS the payload and
# is registered for a whole-scrutinee `Result__/Option____drop` (is_droppable_
# type via the structural decompose), which frees the payload exactly once at
# scope exit. Binding `dst` (the LoBorrowed field-read alias) avoids a second
# heap (no leak) and the second drop (no double-free). The arm's consume sites
# clone on demand (op_consume LoBorrowed → OpClone), so a consuming arm stays
# sound: the consumer gets a fresh independent copy, the whole-drop frees the
# original. Mirrors Rust EnumFieldLoadMode::Borrow (devbook ch.13).
int emit_payload_read_mode_full(LowerCtx &ctx, int scrutinee_ptr, String enum_name, String variant_name, int field_idx, int dst_type, GirModule &gmod, bool borrow_only, bool borrow_all):
    String field = variant_name + "_" + int_to_str(field_idx)
    String read_fn = "__field_read_" + enum_name + "_" + field
    Vector[Operand] args = [op_consume(&ctx, &gmod, scrutinee_ptr, CkMatchPtr()), OpConstI64(field_idx)]
    # The field read produces a byte-copy of the variant's payload
    # bytes — for resource payloads (Vector, Dict, String, user enums
    # with resource sub-fields), those bytes alias the scrutinee's
    # interior. Returning that alias directly means downstream
    # value-passing (e.g., `type_check_item(item, ...)`) byte-copies the
    # alias into the callee's frame; the callee destructures, mutates
    # state, and the alias's storage invalidates → SIGSEGV (showcase
    # blocker #2). Fix: when the payload type has a clone fn, emit a
    # real clone so the extracted value is independently owned.
    #
    # Borrow-mode arg + slot-addr at the call boundary handles the
    # signature (`T T__clone(T*)` / `T gorget_string_clone_to_owned(T*)`)
    # — Phase D step 3's OpBorrow lowering at lir_lower.gg already
    # threads SlotAddr for pass-by-ptr args.
    int dst = add_local_with(&ctx, dst_type, NO_NAME, LoBorrowed(), BoField(-1, -1))
    emit(&ctx, GICallExtern(dst, read_fn, args))
    # option_ref_borrow Phase 3 (RES-2 guard): a `GtPtr(T)` payload (the
    # Some_0 of an `Option__Ref__T` borrowing-getter result) IS the element
    # pointer — never clone-extract it. dst_tname collapses GtPtr(T)→"T", so
    # without this guard resolve_payload_clone_fn("T") would find T__clone and
    # the direct `match coll.get(i)` case (owned Option temp, borrow_only
    # false) would clone-extract a POINTER (corruption). The guard is ADDITIVE
    # — it precedes BOTH the borrow_only elision (still needed for the
    # value-payload for-element path, D5) and the clone arm. Read the typed
    # GIR type, not the name (the name collapsed).
    if dst_type >= 0 and dst_type < gmod.type_table.len():
        GirType dst_gt = gmod.type_table.get(dst_type).unwrap()
        match dst_gt:
            case GtPtr(inner):
                # option_ref_borrow Phase 6 (R1 fix): gate on the POINTEE.
                # A `GtPtr(inner)` extracted from an `Option[Ref[inner]]` is,
                # at a value-consuming position, EITHER a borrow we keep
                # (resource pointee — field-access auto-derefs, consume
                # clones the pointee: Phase 3/4 behavior, NO CHANGE) OR a
                # primitive borrow that is semantically pointless (Copy types
                # copy — book ch11) and must be DEREF-LOADED. Without this,
                # `int key = vec.get(i).unwrap()` OpCopy's the 8-byte POINTER
                # into the int slot → `key` holds the element's address.
                if is_resource_type_name(type_id_to_name(inner, &gmod), &gmod):
                    return dst
                else:
                    # Primitive pointee: deref `*dst` into a fresh
                    # value-typed local of the pointee type. GIDeref lowers
                    # to a sized load (gir.gg:117).
                    int value_local = add_local(&ctx, inner, NO_NAME)
                    emit(&ctx, GIDeref(value_local, dst, inner))
                    return value_local
            else:
                pass
    String dst_tname = type_id_to_name(dst_type, &gmod)
    String clone_fn = resolve_payload_clone_fn(dst_tname, &gmod)
    # CoW borrow-elision (for-element + nonowning-scrutinee match-destructure):
    # return the borrow alias WITHOUT cloning — but ONLY for DEEP-clone
    # payloads (user structs / Vectors / Dicts whose `__clone`/`gorget_*_clone`
    # recursively copies a subtree). Those are the O(tree^2) clone-bomb types.
    # String/Closure payloads keep their eager single-clone path: their clone
    # is cheap (not the bomb) AND the borrow→clone-on-consume ABI for a
    # value-typed `Str` slot mismatches `gorget_string_clone_to_owned(const
    # GorgetString*)` at the consume site (cc "incompatible type" in
    # derive___format_type_inner). Scoping the elision to aggregate payloads
    # kills the bomb without disturbing the String/Closure consume path.
    if borrow_only and is_deep_clone_fn(clone_fn):
        return dst
    # Owned-whole-dropped scrutinee: elide the clone for ALL payload types,
    # String/Closure included. `dst` is the LoBorrowed field-read alias into
    # the scrutinee's payload — the whole-scrutinee drop frees it exactly once.
    if borrow_all:
        return dst
    if clone_fn != "":
        int cloned = add_local(&ctx, dst_type, NO_NAME)
        Vector[Operand] clone_args = [OpBorrow(dst)]
        emit(&ctx, GICallExtern(cloned, clone_fn, clone_args))
        return cloned
    return dst

# Take the address of scrutinee's local so we can pass a pointer to the
# field_read helpers (arg 0 is Ptr-typed by needs_ptr_arg convention).
#
# Phase 3 (2026-05-22, Class 8 keystone): when `scrutinee` is itself a
# borrow (LoBorrowed/LoView) — e.g. the scrutinee is an EFieldAccess
# (`match ty.ty:`) whose result is LoBorrowed/BoField — the temp local
# we allocate to take the address of MUST inherit that borrow tag.
# Without inheritance, `tmp = add_local + GIAssign(tmp, OpCopy(scrutinee))`
# binds tmp as LoOwned, and downstream sites (drop emission, clone
# emission at consume sites) treat tmp as a real owner whose bytes alias
# into the borrowed source — double-free or use-after-free.
#
# This is the chain `__s2 = __v3 = (*p0).ty` in stage1.c's
# `loader___type_mentions_iter`: the field read tags __v3 LoBorrowed,
# match_scrutinee_ptr rebinds it into __s2, and pre-Phase 3 __s2 was
# LoOwned. Phase 3 propagates the LoBorrowed tag through.
int match_scrutinee_ptr(LowerCtx &ctx, GirModule &gmod, int scrutinee):
    # Move the value into a temp local so we can take its address —
    # scrutinee may already be an identifier with a stable slot, but
    # this extra copy keeps the address path uniform.
    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
    int tmp = add_local_inheriting(&ctx, scr_tid, NO_NAME, scrutinee)
    # a-7: a match does NOT consume its scrutinee — it borrows (the tag/field
    # reads take the scrutinee's ADDRESS). CkMatchPtr is a borrow kind, so
    # op_consume yields OpBorrow (Ptr alias), not OpClone. CkAssign here forced
    # a clone for resource enums, and the clone result is a value — the
    # downstream tag-read `((Enum*)tmp)->tag` then can't cast it to a pointer.
    emit(&ctx, GIAssign(tmp, op_consume(&ctx, &gmod, scrutinee, CkMatchPtr())))
    return tmp

# Lower a single match arm's pattern-match test. Emits branches to
# either `match_bb` (pattern matched, possibly with bindings) or
# `no_match_bb` (pattern didn't match, try next arm).
void lower_pattern_match(LowerCtx &ctx, int scrutinee, SpannedPattern spat, String enum_name, int match_bb, int no_match_bb, GirModule &gmod):
    match spat.pat:
        case PWildcard:
            set_terminator(&ctx, GTJump(match_bb))
        case PBinding(name):
            # The parser produces PBinding for any bare identifier — both
            # real variable bindings (`case x:`) AND unit enum variants
            # (`case KwInt:`). If `name` is a known variant of the current
            # enum, treat it as a zero-arg PConstructor so we emit a proper
            # tag check instead of an always-true catch-all.
            if enum_name != "" and match_variant_index(enum_name, name, &gmod) >= 0:
                Vector[SpannedPattern] no_sub_pats = []
                lower_ctor_pattern(&ctx, scrutinee, name, no_sub_pats, enum_name, match_bb, no_match_bb, &gmod)
            else:
                # Real binding: always match; bind scrutinee into a fresh
                # local under `name`.
                int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
                # Phase 3 (Class 8): inherit scrutinee's borrow tag onto
                # the binding local. When scrutinee is LoBorrowed/LoView
                # (e.g. arrived via .get().unwrap() chain or field-read),
                # the named binding must alias rather than byte-copy into
                # a fresh owner that COMMIT 3 would later double-free.
                Option[String] name_opt = Some(name)
                int bound = add_local_inheriting(&ctx, scr_tid, name_opt, scrutinee)
                emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, scrutinee, CkAssign())))
                nl_put(&ctx, name, bound)
                set_terminator(&ctx, GTJump(match_bb))
        case PConstructor(variant_name, sub_pats):
            lower_ctor_pattern(&ctx, scrutinee, variant_name, sub_pats, enum_name, match_bb, no_match_bb, &gmod)
        case PDotShorthand(variant_name, sub_pats):
            # `.VariantName(pats)` — same semantics as PConstructor with
            # enum name inferred from the scrutinee's type.
            lower_ctor_pattern(&ctx, scrutinee, variant_name, sub_pats, enum_name, match_bb, no_match_bb, &gmod)
        case PLiteral(lit_expr):
            # `case N:` / `case "x":` / `case true:` — emit an equality
            # check against the literal value. Without this every literal
            # pattern fell through to the unconditional `GTJump(match_bb)`
            # below, making `match tid: case 0: ...; case 4: ...` always
            # take the first arm (every call to `type_id_to_name` returned
            # "bool" regardless of tid).
            #
            # `case None:` is parsed as `PLiteral(ENoneLiteral)` by the
            # parser (not PConstructor), so route None patterns through the
            # ctor-pattern path — None is a variant constructor, not a
            # comparable value, and Option types don't support `==` at the
            # GIR level.
            match lit_expr.expr:
                case ENoneLiteral():
                    Vector[SpannedPattern] no_sub_pats = []
                    lower_ctor_pattern(&ctx, scrutinee, "None", no_sub_pats, enum_name, match_bb, no_match_bb, &gmod)
                else:
                    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
                    int lit_val = lower_expr(&ctx, lit_expr, &gmod)
                    int cmp_tid = I64_TYPE
                    if scr_tid == BOOL_TYPE:
                        cmp_tid = BOOL_TYPE
                    int is_match = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    emit(&ctx, GICmp(is_match, CMP_EQ, cmp_tid, op_consume(&ctx, &gmod, scrutinee, CkBinOpArg()), op_consume(&ctx, &gmod, lit_val, CkBinOpArg())))
                    set_terminator(&ctx, GTBranch(OpCopy(is_match), match_bb, no_match_bb))
        case POr(alts):
            # `case A | B | C:` — match if any alternative matches. Each
            # alternative tries to match, branches to match_bb on success
            # or to the next alternative's attempt block on failure. The
            # last alternative's no-match goes to no_match_bb.
            #
            # Previously fell through to the unconditional `GTJump(match_bb)`
            # below — every POr arm unconditionally matched regardless of
            # the scrutinee, which broke the 32 uses of `a | b` patterns
            # in the self-host sources.
            if alts.len() == 0:
                set_terminator(&ctx, GTJump(no_match_bb))
            else:
                int ai = 0
                while ai < alts.len():
                    SpannedPattern alt = alts.get(ai).unwrap()
                    int next_alt_bb = no_match_bb
                    if ai + 1 < alts.len():
                        next_alt_bb = new_block(&ctx)
                    lower_pattern_match(&ctx, scrutinee, alt, enum_name, match_bb, next_alt_bb, &gmod)
                    if ai + 1 < alts.len():
                        switch_to(&ctx, next_alt_bb)
                    ai += 1
        else:
            # Unsupported pattern shape (PTuple, PRest) — fall through
            # with a permissive match rather than silently dropping the arm
            # body. Future fixes: add proper patterns.
            lower_fail("unsupported pattern variant in match arm")
            set_terminator(&ctx, GTJump(match_bb))

void lower_ctor_pattern(LowerCtx &ctx, int scrutinee, String variant_name, Vector[SpannedPattern] sub_pats, String enum_name, int match_bb, int no_match_bb, GirModule &gmod):
    # Mirrors Rust's `patterns.rs:388-397`: prefer enum_name from the
    # scrutinee's type, but fall back to the pattern's qualified name,
    # and finally scan all registered enums for a variant with this name.
    # `case ParseError.Empty()` arrives as variant_name="ParseError.Empty"
    # — even without scrutinee type info, we recover the enum from the
    # pattern's qualifier. Bare variants like `case EBinaryOp(...)` don't
    # carry enum info, so we scan for a unique enum that declares this
    # variant.
    String effective_enum = enum_name
    String effective_variant = variant_name
    if variant_name.contains("."):
        int dot_pos = variant_name.index_of(".").unwrap()
        String qual_enum = variant_name.slice(0, dot_pos)
        String bare_variant = variant_name.slice(dot_pos + 1, variant_name.len())
        if effective_enum == "":
            effective_enum = qual_enum
        effective_variant = bare_variant
    # If still unresolved, scan the enum registry for a matching variant.
    # This mirrors Rust's `ctx.resolve_enum_variant(...)` fallback.
    if effective_enum == "":
        String guessed = find_enum_by_variant(&gmod, effective_variant)
        if guessed.len() > 0:
            effective_enum = guessed
    # Scrutinee-type fallback: when `match_enum_type` returned empty
    # (e.g. `auto`-inferred scrutinee with prelude variants), recover
    # the enum directly from the scrutinee's local type. The `__`
    # mangling keeps `Option__T` / `Result__T__E` distinguishable, and
    # the existing `match_variant_index` / `__field_read_<enum>_<field>`
    # machinery already handles those prefixes (see line 2667-2678 +
    # `lir_codegen.gg:3445` longest-prefix split). Required for
    # `case Ok(v):` / `case Some(v):` cascades — without this, `v` was
    # never bound as a local.
    if effective_enum == "":
        int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
        if scr_tid >= 0 and scr_tid < gmod.type_table.len():
            int peeled_tid = scr_tid
            GirType bt = gmod.type_table.get(scr_tid).unwrap()
            match bt:
                case GtPtr(inner):
                    peeled_tid = inner
                case GtMutPtr(inner):
                    peeled_tid = inner
                else:
                    pass
            String scr_type_name = type_id_to_name(peeled_tid, &gmod)
            if scr_type_name.starts_with("Option__") or scr_type_name.starts_with("Result__"):
                effective_enum = scr_type_name
    # Last-resort prelude fallback: when the scrutinee's type was lost
    # entirely (`auto` binding mis-typed to I64, generic-context T not
    # yet substituted), the variant name itself disambiguates Result vs
    # Option. We can't reconstruct the mangled `Option__T` name here
    # without the scrutinee type, but emitting a synthetic enum name
    # `Option` / `Result` is enough to register the binding(s) in the
    # match arm — `match_variant_index` and `emit_tag_read` learn to
    # accept the bare prelude names below. Without this, every
    # mis-typed match arm fell through to the unconditional `GTJump`
    # path and bound nothing — every Ok/Error/Some bare-name use
    # cascaded into a `[bug] EIdentifier` placeholder, then 0-typed.
    if effective_enum == "":
        if effective_variant == "Ok" or effective_variant == "Error":
            effective_enum = "Result"
        elif effective_variant == "Some" or effective_variant == "None":
            effective_enum = "Option"
    if effective_enum == "":
        # Truly nothing we can do. Hits on monomorphized Option / Result
        # which use `__` separators the __field_read_ parser can't split
        # cleanly, or on variants we never registered.
        lower_fail("PConstructor on non-enum scrutinee — enum_name empty (variant='" + variant_name + "')")
        set_terminator(&ctx, GTJump(match_bb))
        return
    int expected_tag = match_variant_index(effective_enum, effective_variant, &gmod)
    if expected_tag < 0:
        lower_fail("PConstructor variant not in enum: enum='" + effective_enum + "' variant='" + effective_variant + "'")
        set_terminator(&ctx, GTJump(match_bb))
        return
    int scrutinee_ptr = match_scrutinee_ptr(&ctx, &gmod, scrutinee)
    int tag = emit_tag_read(&ctx, scrutinee_ptr, effective_enum, &gmod)
    int expected = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(expected, OpConstI64(expected_tag)))
    int is_match = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(is_match, CMP_EQ, I64_TYPE, OpCopy(tag), OpCopy(expected)))
    # Unit variants (no sub_pats): skip the intermediate bind_bb — branch
    # straight to match_bb on success. Saves 1 block per arm, which matters
    # for matches on big imported enums (Keyword has ~60 variants; without
    # this the GIR block count explodes and stage-0 OOMs during self-host
    # compile).
    if sub_pats.len() == 0:
        set_terminator(&ctx, GTBranch(OpCopy(is_match), match_bb, no_match_bb))
        return
    int bind_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(is_match), bind_bb, no_match_bb))
    switch_to(&ctx, bind_bb)
    # Bind payload sub-patterns. For each sub_pat, emit a payload read
    # then match that sub-pattern. If a sub-pat doesn't match the whole
    # arm fails — but we simplify: PBinding/PWildcard sub-pats always
    # match, so just bind linearly here.
    int fi = 0
    while fi < sub_pats.len():
        SpannedPattern sp = sub_pats.get(fi).unwrap()
        match sp.pat:
            case PWildcard:
                pass
            case PBinding(bname):
                # Look up field type from the enum's variant's field info.
                int fty = lookup_ctor_field_type(effective_enum, effective_variant, fi, &gmod)
                # option_ref_borrow Phase 3 (typed path): if the scrutinee is a
                # borrowing-getter result `Option[Ref[T]]` (e.g. `match
                # coll.get(i): case Some(p):`), bind `p` as the real `GtPtr(T)`
                # payload recorded in the typed option_ref_payload channel —
                # NOT the name-derived type. Keyed on the scrutinee Option's
                # GIR id; zero `Ref__` string inspection. The downstream
                # emit_payload_read_mode GtPtr guard returns the pointer.
                int scr_opt_tid = ctx.locals.get(scrutinee).unwrap().type_id
                int scr_ref_payload = option_ref_payload_of(&gmod, scr_opt_tid)
                if scr_ref_payload >= 0 and fi == 0 and effective_variant == "Some":
                    fty = scr_ref_payload
                # CoW match-destructure: when the SCRUTINEE is a borrow alias
                # (a by-value param / borrowed local being matched read-only —
                # e.g. the generic-discovery walkers `match sexpr.expr: case
                # ECall(callee_box, args, targs):`), bind the payload as a
                # borrow alias into the scrutinee WITHOUT deep-cloning it. The
                # arm body reads it as a borrow; any consume/mutation clones on
                # demand (op_consume a-5). This kills the second clone bomb:
                # cloning `args`/`targs` Vectors at every ECall match-bind
                # compounded O(tree^2) through the recursive walkers. When the
                # scrutinee OWNS its data, keep the eager clone (independent
                # owner — matches the original Class-8 double-free fix).
                bool scrut_borrow = scrutinee_nonowning(&ctx, &gmod, scrutinee)
                # Owned-whole-dropped scrutinee (Result/Option local whose own
                # whole-drop frees the payload once): borrow the payload instead
                # of deep-cloning it — for ALL payload types incl. String. This
                # is the oracle's EnumFieldLoadMode::Borrow (devbook ch.13): no
                # second heap (Prototype A's leak), no second drop (Prototype B's
                # double-free). The bound alias is read-only here; a consuming arm
                # clones on demand via op_consume LoBorrowed→OpClone.
                bool scrut_owned_dropped = scrutinee_owned_whole_dropped(&ctx, &gmod, scrutinee)
                int field_val = emit_payload_read_mode_full(&ctx, scrutinee_ptr, effective_enum, effective_variant, fi, fty, &gmod, scrut_borrow, scrut_owned_dropped)
                Option[String] bname_opt = Some(bname)
                # option_ref_borrow Phase 6 (R1, site #3): KEEP `fty`(=GtPtr for
                # an Option[Ref[T]] scrutinee) as the `dst_type` arg above so the
                # site-#1 guard fires and derefs primitive pointees. But type the
                # BOUND local from the RETURNED `field_val`'s ACTUAL type — site
                # #1 returns a value-typed local for a primitive pointee (the
                # deref result) and the GtPtr for a resource pointee. Binding to
                # `fty` would force a pointer slot for a primitive (the bug). No
                # primitive-pointee `match coll.get(i): case Some(p):` site exists
                # in the current self-host (all chain `.unwrap()` first), so the
                # primitive case is unexercised by the bootstrap — but it's now
                # sound; the exercised resource-match case keeps `bound: GtPtr`.
                int bound = add_local_inheriting(&ctx, ctx.locals.get(field_val).unwrap().type_id, bname_opt, field_val)
                ConsumeKind bk = CkAssign()
                # Borrow-bind (alias, no clone) when the field-read returned a
                # LoBorrowed alias — both the nonowning-scrutinee path AND the
                # owned-whole-dropped path (Prototype C). CkCallArgBorrow is a
                # NON-consume kind, so op_consume yields OpBorrow (pure alias);
                # CkAssign would route LoBorrowed→OpClone and re-clone the very
                # payload we just elided.
                if (scrut_borrow or scrut_owned_dropped) and local_is_borrow_alias(&ctx, field_val):
                    bk = CkCallArgBorrow()
                emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, field_val, bk)))
                nl_put(&ctx, bname, bound)
            case PLiteral(lit_expr):
                # Literal sub-pattern: read the payload field, compare against
                # the literal, branch to no_match_bb on mismatch. Used by
                # `case Ok(0):` / `case Some(true):` shapes — without this,
                # the arm match'd on tag alone and the literal check was
                # silently dropped (broken behaviour: `case Ok(0)` matched
                # ALL Ok values). Only primitives (int / bool / char / float)
                # are wired here; string literal sub-patterns would need a
                # `gorget_str_eq` call and aren't exercised today.
                int lit_fty = lookup_ctor_field_type(effective_enum, effective_variant, fi, &gmod)
                # option_ref_borrow Phase 6 (R1, site #5): gate the GICmp operand
                # type on the pointee. For an `Option[Ref[T]]` scrutinee with a
                # literal sub-pattern (`case Some(0):` on a getter result),
                # `lit_fty` resolves through the `Ref__` bridge to `GtPtr(T)`.
                # emit_payload_read routes through site #1, which for a PRIMITIVE
                # pointee derefs `*ptr` and returns a VALUE-typed `lit_field_val`
                # — so the GICmp must compare against the VALUE pointee type, not
                # the `GtPtr`. (Resource pointee keeps `GtPtr` for both. No
                # primitive-pointee literal-match on a getter exists today — all
                # chain `.unwrap()` first — so this is unexercised, but gated for
                # completeness rather than shipping a silently-wrong instruction.)
                int lit_cmp_ty = lit_fty
                if lit_fty >= 0 and lit_fty < gmod.type_table.len():
                    GirType lit_gt = gmod.type_table.get(lit_fty).unwrap()
                    match lit_gt:
                        case GtPtr(lit_inner):
                            if not is_resource_type_name(type_id_to_name(lit_inner, &gmod), &gmod):
                                lit_cmp_ty = lit_inner
                        else:
                            pass
                int lit_field_val = emit_payload_read(&ctx, scrutinee_ptr, effective_enum, effective_variant, fi, lit_fty, &gmod)
                int lit_val = lower_expr(&ctx, lit_expr, &gmod)
                int lit_eq = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICmp(lit_eq, CMP_EQ, lit_cmp_ty, OpCopy(lit_field_val), OpCopy(lit_val)))
                int lit_continue_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(lit_eq), lit_continue_bb, no_match_bb))
                switch_to(&ctx, lit_continue_bb)
            else:
                lower_fail("nested non-binding pattern in PConstructor — using wildcard fallback (got: " + pat_kind(sp.pat) + ")")
        fi += 1
    set_terminator(&ctx, GTJump(match_bb))

int lookup_ctor_field_type(String enum_name, String variant_name, int field_idx, GirModule &gmod):
    # Prelude mono'd enum payload type — read off the typed `enum_category`
    # channel (recorded at the MINT site), not re-parsed from the mangled
    # name. `Option__T.Some(0)` → T; `Result__T__E.Ok(0)` → T / `.Error(0)`
    # → E. The enum's GIR id is the name-deduped `named_types` entry, so it
    # matches the id recorded at mint time. This RETIRES the old leftmost-/
    # smart-`__` split (mis-split on nested-generic payloads) — CLAUDE.md
    # "No name matching".
    if enum_name.starts_with("Option__") or enum_name.starts_with("Result__"):
        int enum_tid = gmod.named_types.get(enum_name).unwrap_or(-1)
        EnumCategory ec = enum_category_of(&gmod, enum_tid)
        if ec.category == ENUM_CAT_OPTION:
            if variant_name == "Some" and field_idx == 0:
                return ec.ok_type
            return I64_TYPE
        if ec.category == ENUM_CAT_RESULT:
            if variant_name == "Ok" and field_idx == 0:
                return ec.ok_type
            if variant_name == "Error" and field_idx == 0:
                return ec.err_type
            return I64_TYPE
        # Channel MISS on an `Option__`/`Result__`-named enum: its mint site
        # failed to `record_enum_category` (a completeness bug — the payload
        # is now mistyped as I64). Surface it loudly via the idiomatic
        # non-fatal `diag_bug` (a `/* [bug] … */` in the emitted C), not a
        # silent sentinel. The fix is to record at the new mint — never to
        # re-introduce a name-split here (CLAUDE.md "No name matching"). This
        # rides the existing semantic `starts_with` gate above, so it fires
        # ONLY on a genuine miss. (`option_result_field_store` was one such
        # miss, caught during development.)
        diag_bug("lookup_ctor_field_type", "Option__/Result__ channel miss for '" + enum_name + "' — mint missed record_enum_category; payload mistyped as I64 (WRONG)")
        return I64_TYPE
    String found_field_type = ""
    if gmod.type_infos.contains(enum_name):
        GirTypeInfo ti = gmod.type_infos.get(enum_name).unwrap()
        for v in ti.variants:
            if v.name == variant_name:
                if field_idx < v.fields.len():
                    GirFieldInfo f = v.fields.get(field_idx).unwrap()
                    found_field_type = f.type_name.clone()
                break
    if found_field_type != "":
        return resolve_field_gir_type(found_field_type, &gmod)
    return I64_TYPE

# ── Error-handling lowering (SThrow / SOnError / ECatch / ERethrow) ──
#
# Mirrors Rust gg's `lower_throw` (`src/ir/lowering/stmts/mod.rs:2244`),
# `lower_catch_expr` (`src/ir/lowering/exprs/mod.rs:3056`),
# `lower_rethrow_expr` (`exprs/mod.rs:2918`), and the `Stmt::OnError`
# registration (`stmts/mod.rs:339`). The self-host re-expresses these
# with the local block/branch/tag-read/payload-read vocabulary.

# Read the Ok and Error payload GIR type ids of a monomorphized
# `Result__<OkT>__<ErrT>` enum off the typed `enum_category` channel
# (recorded at the MINT site — `record_enum_category` — where the typed
# payload tids were in hand). Mirrors Rust's `extract_result_field_types`
# (`exprs/mod.rs:2845`), which reads the Ok/Error variant field types off
# the enum's TypeDef; the self-host's mono'd `Result__T__E` is not in
# `type_infos`, so we carry the same typed fact on `enum_category` instead.
# This RETIRES the former L→R `__`-boundary "smart split" of the mangled
# name (genuinely ambiguous on nested generics like
# `Result__Option__int64_t__GorgetString`) — CLAUDE.md "No name matching",
# Layering rule 3. `result_tid` is the GIR id of the Result enum (the
# scrutinee/inner-expr lowered local type, with `GtPtr` already peeled by
# the caller's `type_id_to_name`-style lookup). Returns (ok_tid, err_tid);
# both default to `I64_TYPE` if `result_tid` carries no recorded category.
ResultPayloadTypes result_payload_types(int result_tid, GirModule &gmod):
    # Peel a leading GtPtr/GtMutPtr (a borrowed call result's local type)
    # to the underlying Result enum id — the channel is keyed by the enum
    # id, exactly as `type_id_to_name` peels the pointer to the enum name.
    int enum_tid = result_tid
    if enum_tid >= 0 and enum_tid < gmod.type_table.len():
        match gmod.type_table.get(enum_tid).unwrap():
            case GtPtr(inner):
                enum_tid = inner
            case GtMutPtr(inner):
                enum_tid = inner
            else:
                pass
    EnumCategory ec = enum_category_of(&gmod, enum_tid)
    if ec.category == ENUM_CAT_RESULT:
        return ResultPayloadTypes(ec.ok_type, ec.err_type)
    # Channel MISS. A non-Result tid here is a legitimate no-op (catch /
    # rethrow are semantically Result-only, but the self-host's own
    # inference can still hand us a placeholder tid). A `Result__`-named
    # enum reaching here, though, means its mint missed
    # `record_enum_category` — Ok/Error payloads silently mistyped as I64.
    # Surface THAT loudly; the name test gates only the diagnostic, never
    # the (I64,I64) result (so it stays a diagnostic, not a semantic
    # name-match).
    if type_id_to_name(enum_tid, &gmod).starts_with("Result__"):
        diag_bug("result_payload_types", "Result__ channel miss — mint missed record_enum_category; Ok/Error payloads mistyped as I64 (WRONG)")
    return ResultPayloadTypes(I64_TYPE, I64_TYPE)

# Emit the registered `on error:` cleanup blocks, LIFO, into the current
# block. Mirrors Rust's `emit_on_error_cleanups` (`stmts/mod.rs:357`),
# called from the throw / rethrow error-return paths BEFORE drop
# elaboration. No-op when nothing is registered.
void emit_on_error_cleanups(LowerCtx &ctx, GirModule &gmod):
    int bi = ctx.on_error_blocks.len() - 1
    while bi >= 0:
        Vector[Stmt] body = ctx.on_error_blocks.get(bi).unwrap()
        lower_stmts(&ctx, body, &gmod, false)
        bi -= 1

# Lower `throw expr` inside a throws function: wrap `expr` in the
# enclosing function's `Result.Error(expr)`, run on-error cleanups, emit
# the function-scope drop set (excluding the return place), and return.
# Mirrors Rust's `lower_throw` (`stmts/mod.rs:2244`) — the throws-fn
# branch only (the non-throws `gorget_throw` branch is a parser/semantic
# error in valid programs, so the self-host omits it and lower_fails).
void lower_throw_stmt(LowerCtx &ctx, SpannedExpr expr, GirModule &gmod):
    # The enclosing function's Result__T__E return type lives at local 0
    # (the return place), exactly as SReturn reads it (`:6018`).
    int result_type = ctx.locals.get(0).unwrap().type_id
    String result_tn = type_id_to_name(result_type, &gmod)
    if not result_tn.starts_with("Result__"):
        lower_fail("throw in non-throws function (ret type not Result__): " + result_tn)
        return
    # Expected-type so the bare `Error` ctor below types its dst to the
    # full mono'd Result enum (mirrors the SReturn expected_type set).
    int prev_expected = ctx.expected_type
    ctx.expected_type = result_type
    int val = lower_expr(&ctx, expr, &gmod)
    ctx.expected_type = prev_expected
    # Build `Result.Error(val)` with the BARE variant name (so the LIR
    # rewrite `try_lower_prelude_variant` recognizes it) and the dst slot
    # typed to the concrete Result enum (so the same rewrite's
    # `slot_ty >= LT_STRUCT_BASE` gate passes). A fully-mangled name
    # would fall through to a raw extern call → stage-1 link error.
    int err_dst = add_local(&ctx, result_type, NO_NAME)
    Vector[Operand] err_args = [op_consume(&ctx, &gmod, val, CkCallArgOwning())]
    emit(&ctx, GICallExtern(err_dst, "Error", err_args))
    # Assign into the return place, run cleanups + drops, then return.
    emit(&ctx, GIAssign(0, op_consume(&ctx, &gmod, err_dst, CkReturn())))
    emit_on_error_cleanups(&ctx, &gmod)
    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
    # Dead block for any statements after the throw.
    int dead_bb = new_block(&ctx)
    switch_to(&ctx, dead_bb)

# Lower `inner catch (name): recovery` — always succeeds. On Ok, the
# value is the unwrapped Ok payload; on Error, bind `name` to the Error
# payload, evaluate `recovery`, use that. Mirrors Rust's
# `lower_catch_expr` (`exprs/mod.rs:3056`). Returns the local holding
# the merged (Ok-typed) result.
int lower_catch_expr(LowerCtx &ctx, SpannedExpr inner, String error_binding, SpannedExpr recovery, GirModule &gmod):
    # Suppress the centralized auto-prop hook — catch operates on the RAW
    # `Result[T, E]` (it extracts the Ok/Error payloads itself).
    ctx.suppress_auto_prop = true
    int val = lower_expr(&ctx, inner, &gmod)
    int val_tid = ctx.locals.get(val).unwrap().type_id
    # The inner expr's type is the Result; peel any GtPtr (borrowed call
    # result) to get the mono'd Result__T__E name for the tag/payload
    # reads (mirrors the scrutinee-fallback peel at `:6730-6744`).
    String result_tn = type_id_to_name(val_tid, &gmod)
    ResultPayloadTypes pt = result_payload_types(val_tid, &gmod)
    int ok_tid = pt.ok_type
    int err_tid = pt.err_type
    # Read the Result tag (0=Ok, 1=Error) via the monomorphized enum
    # name — `lir_codegen`'s longest-prefix split handles `Result__T__E`
    # (`:6722-6727`), so the stale "Result not supported" comment on
    # emit_tag_read (`:6408`) does not apply to the mangled name.
    int scrutinee_ptr = match_scrutinee_ptr(&ctx, &gmod, val)
    int tag = emit_tag_read(&ctx, scrutinee_ptr, result_tn, &gmod)
    int zero = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(zero, OpConstI64(0)))
    int is_ok = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(is_ok, CMP_EQ, I64_TYPE, OpCopy(tag), OpCopy(zero)))
    int ok_bb = new_block(&ctx)
    int err_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    # The merged result local is Ok-typed.
    int result_local = add_local(&ctx, ok_tid, NO_NAME)
    set_terminator(&ctx, GTBranch(OpCopy(is_ok), ok_bb, err_bb))
    # Ok path: extract Ok payload (clone-extract via emit_payload_read_mode),
    # store into result.
    switch_to(&ctx, ok_bb)
    int ok_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Ok", 0, ok_tid, &gmod, false)
    emit(&ctx, GIAssign(result_local, op_consume(&ctx, &gmod, ok_val, CkAssign())))
    set_terminator(&ctx, GTJump(merge_bb))
    # Error path: bind error to `error_binding`, evaluate recovery, store.
    switch_to(&ctx, err_bb)
    int err_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Error", 0, err_tid, &gmod, false)
    Option[String] errn_opt = Some(error_binding)
    int err_local = add_local_inheriting(&ctx, ctx.locals.get(err_val).unwrap().type_id, errn_opt, err_val)
    emit(&ctx, GIAssign(err_local, op_consume(&ctx, &gmod, err_val, CkAssign())))
    nl_put(&ctx, error_binding, err_local)
    int recovery_val = lower_expr(&ctx, recovery, &gmod)
    emit(&ctx, GIAssign(result_local, op_consume(&ctx, &gmod, recovery_val, CkAssign())))
    set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)
    return result_local

# Lower `inner rethrow [(Type name)]: transform` — like auto-propagation,
# but the error path evaluates `transform` and throws THAT from the
# enclosing throws-fn. On Ok, continue with the unwrapped Ok value.
# Mirrors Rust's `lower_rethrow_expr` (`exprs/mod.rs:2918`). Returns the
# local holding the unwrapped Ok value.
int lower_rethrow_expr(LowerCtx &ctx, SpannedExpr inner, Option[String] error_binding, SpannedExpr transform, GirModule &gmod):
    # Suppress the centralized auto-prop hook — rethrow operates on the RAW
    # `Result[T, E]` (it extracts the Ok/Error payloads itself).
    ctx.suppress_auto_prop = true
    int val = lower_expr(&ctx, inner, &gmod)
    int val_tid = ctx.locals.get(val).unwrap().type_id
    String result_tn = type_id_to_name(val_tid, &gmod)
    ResultPayloadTypes pt = result_payload_types(val_tid, &gmod)
    int ok_tid = pt.ok_type
    int err_tid = pt.err_type
    # The enclosing function's Result__T__E return type (local 0).
    int fn_result_type = ctx.locals.get(0).unwrap().type_id
    int scrutinee_ptr = match_scrutinee_ptr(&ctx, &gmod, val)
    int tag = emit_tag_read(&ctx, scrutinee_ptr, result_tn, &gmod)
    int zero = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(zero, OpConstI64(0)))
    int is_ok = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(is_ok, CMP_EQ, I64_TYPE, OpCopy(tag), OpCopy(zero)))
    int ok_bb = new_block(&ctx)
    int err_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    # Ok-typed result for the unwrapped value.
    int ok_result = add_local(&ctx, ok_tid, NO_NAME)
    set_terminator(&ctx, GTBranch(OpCopy(is_ok), ok_bb, err_bb))
    # Ok path: extract Ok payload, continue.
    switch_to(&ctx, ok_bb)
    int ok_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Ok", 0, ok_tid, &gmod, false)
    emit(&ctx, GIAssign(ok_result, op_consume(&ctx, &gmod, ok_val, CkAssign())))
    set_terminator(&ctx, GTJump(merge_bb))
    # Error path: optionally bind the error, evaluate transform, wrap that
    # in the enclosing fn's Result.Error and return.
    switch_to(&ctx, err_bb)
    match error_binding:
        case Some(err_name):
            int err_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Error", 0, err_tid, &gmod, false)
            Option[String] errn_opt = Some(err_name)
            int err_local = add_local_inheriting(&ctx, ctx.locals.get(err_val).unwrap().type_id, errn_opt, err_val)
            emit(&ctx, GIAssign(err_local, op_consume(&ctx, &gmod, err_val, CkAssign())))
            nl_put(&ctx, err_name, err_local)
        case None:
            pass
    int prev_expected_rt = ctx.expected_type
    ctx.expected_type = fn_result_type
    int new_err = lower_expr(&ctx, transform, &gmod)
    ctx.expected_type = prev_expected_rt
    int err_dst = add_local(&ctx, fn_result_type, NO_NAME)
    Vector[Operand] err_args = [op_consume(&ctx, &gmod, new_err, CkCallArgOwning())]
    emit(&ctx, GICallExtern(err_dst, "Error", err_args))
    emit(&ctx, GIAssign(0, op_consume(&ctx, &gmod, err_dst, CkReturn())))
    emit_on_error_cleanups(&ctx, &gmod)
    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
    switch_to(&ctx, merge_bb)
    return ok_result

# Result→T auto-propagation. Given a local `val` that may hold a
# `throws`-call's `Result__<ok>__E`, unwrap it the way Rust's
# `maybe_auto_propagate` (`exprs/mod.rs:73-86`) does: on Ok → continue with
# the Ok payload; on Error → forward the RAW error payload re-wrapped in the
# enclosing fn's `Result.Error` and early-return (with on-error cleanups +
# drops). This is `lower_rethrow_expr` MINUS the user `transform` — the
# error is forwarded unchanged.
#
# CENTRALIZED producer-side hook (mirrors Rust gg's `90d09414`): invoked
# from `lower_expr`'s tail for `Call`/`MethodCall` producers (see the
# `lower_expr` wrapper docstring). The earlier consumer-targeted design
# (N explicit call sites) had the SAME per-position gaps the Rust side fixed
# (binop operands, method args, aggregate-literal elements, inline match
# scrutinees) — the central hook closes the class at the producer. Raw-Result
# sites set `ctx.suppress_auto_prop` (match scrutinee with Ok/Error/Some/None
# arms, catch inner, rethrow inner); dest-is-Result is suppressed here via
# the `ctx.expected_type` check.
#
# Idempotent no-op (returns `val` unchanged) unless BOTH gates hold:
#  1. `val`'s type name (GtPtr-peeled by type_id_to_name) starts_with
#     "Result__" — it actually IS a Result.
#  2. The enclosing fn can propagate: local-0 (the return place, which
#     the `throws` lowering types to the mono'd Result) starts_with
#     "Result__" — subsumes Rust's should_auto_propagate/expected_type.
# A non-throws caller (gate 2 fails) keeps the raw Result unchanged.
int maybe_auto_propagate(LowerCtx &ctx, int val, GirModule &gmod):
    if val < 0 or val >= ctx.locals.len():
        return val
    # Capture-form suppress (mirrors Rust gg's `maybe_auto_propagate`
    # expected-type check, `exprs/mod.rs:2937-2943`): when the surrounding
    # destination expects a `Result` (e.g. `Result[int,E] r = risky()`, a
    # `throws`-fn return forwarding the raw Result, a Result-typed param /
    # field), keep the raw Result — don't unwrap into a slot that wants it.
    # The writer sites set `ctx.expected_type` to the destination type
    # immediately before recursing into `lower_expr`, so the centralized hook
    # observes it here. Per-site callers that already cleared expected_type
    # rely on gate 1/2 below (this check is a no-op when expected_type is -1
    # or non-Result).
    if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
        String et_name = type_id_to_name(ctx.expected_type, &gmod)
        if et_name.starts_with("Result__"):
            return val
    int val_tid = ctx.locals.get(val).unwrap().type_id
    String result_tn = type_id_to_name(val_tid, &gmod)
    # Gate 1: val must be a Result.
    if not result_tn.starts_with("Result__"):
        return val
    # Gate 2: the enclosing fn must itself be `throws` (local 0 = Result).
    int fn_result_type = ctx.locals.get(0).unwrap().type_id
    String fn_result_tn = type_id_to_name(fn_result_type, &gmod)
    if not fn_result_tn.starts_with("Result__"):
        return val
    # Split the consumed Result's payload types.
    ResultPayloadTypes pt = result_payload_types(val_tid, &gmod)
    int ok_tid = pt.ok_type
    int err_tid = pt.err_type
    int scrutinee_ptr = match_scrutinee_ptr(&ctx, &gmod, val)
    int tag = emit_tag_read(&ctx, scrutinee_ptr, result_tn, &gmod)
    int zero = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(zero, OpConstI64(0)))
    int is_ok = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(is_ok, CMP_EQ, I64_TYPE, OpCopy(tag), OpCopy(zero)))
    int ok_bb = new_block(&ctx)
    int err_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    # Ok-typed result for the unwrapped value.
    int ok_result = add_local(&ctx, ok_tid, NO_NAME)
    set_terminator(&ctx, GTBranch(OpCopy(is_ok), ok_bb, err_bb))
    # Ok path: extract Ok payload (clone-extract), continue.
    switch_to(&ctx, ok_bb)
    int ok_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Ok", 0, ok_tid, &gmod, false)
    emit(&ctx, GIAssign(ok_result, op_consume(&ctx, &gmod, ok_val, CkAssign())))
    set_terminator(&ctx, GTJump(merge_bb))
    # Error path: forward the RAW error payload re-wrapped in the
    # enclosing fn's Result.Error and early-return (no user transform).
    switch_to(&ctx, err_bb)
    int err_val = emit_payload_read_mode(&ctx, scrutinee_ptr, result_tn, "Error", 0, err_tid, &gmod, false)
    int err_dst = add_local(&ctx, fn_result_type, NO_NAME)
    Vector[Operand] err_args = [op_consume(&ctx, &gmod, err_val, CkCallArgOwning())]
    emit(&ctx, GICallExtern(err_dst, "Error", err_args))
    emit(&ctx, GIAssign(0, op_consume(&ctx, &gmod, err_dst, CkReturn())))
    emit_on_error_cleanups(&ctx, &gmod)
    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
    switch_to(&ctx, merge_bb)
    return ok_result

# True iff any arm pattern discriminates a `Result`/`Option` variant —
# `Ok`/`Error`/`Some`/`None`, or their qualified `Result.Ok` / `Option.Some`
# forms. Mirrors Rust gg's `arms_match_result_or_option_item`
# (`src/ir/lowering/stmts/patterns.rs:155-172`). When true, the match
# scrutinee must stay a RAW `Result`/`Option` so the arms can discriminate
# it — the centralized auto-prop hook is suppressed for the scrutinee. When
# false (arms match USER variants like `Tagged.StringV`, e.g. snag48), the
# scrutinee SHOULD auto-prop so a `throws`-call scrutinee peels to its
# payload before the user-variant match.
bool arms_match_result_or_option(Vector[MatchArm] arms):
    for arm in arms:
        match arm.pattern.pat:
            case PConstructor(variant_name, _):
                if pattern_head_is_result_or_option(variant_name):
                    return true
            case PDotShorthand(variant_name, _):
                if pattern_head_is_result_or_option(variant_name):
                    return true
            case PLiteral(lit_expr):
                # The parser renders bare `case None:` as PLiteral(ENoneLiteral).
                match lit_expr.expr:
                    case ENoneLiteral():
                        return true
                    else:
                        pass
            else:
                pass
    return false

bool pattern_head_is_result_or_option(String variant_name):
    # Bare prelude variant (`Ok` / `Error` / `Some` / `None`) or its
    # qualified `Result.Ok` / `Option.Some` form (the head before the dot).
    String head = variant_name
    if variant_name.contains("."):
        int dot_pos = variant_name.index_of(".").unwrap()
        String qual = variant_name.slice(0, dot_pos)
        # `Result.Ok` / `Option.None` — the qualifier names the wrapper.
        if qual == "Result" or qual == "Option":
            return true
        head = qual
    if head == "Ok" or head == "Error":
        return true
    if head == "Some" or head == "None":
        return true
    return false

void lower_match_stmt(LowerCtx &ctx, SpannedExpr scrutinee_expr, Vector[MatchArm] arms, GirModule &gmod, bool is_main):
    # Suppress the centralized auto-prop on the scrutinee when the arms
    # discriminate a Result/Option (keep it raw); otherwise let a throws-call
    # scrutinee peel to its payload (snag48). Take expected_type so a
    # Result-typed surrounding context (the match's destination) doesn't make
    # the hook's capture-form check suppress the scrutinee peel — the
    # scrutinee's expectation is independent of the match result's.
    int saved_expected_ms = ctx.expected_type
    ctx.expected_type = -1
    ctx.suppress_auto_prop = arms_match_result_or_option(arms)
    int scrutinee = lower_expr(&ctx, scrutinee_expr, &gmod)
    ctx.expected_type = saved_expected_ms
    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
    String type_name = type_id_to_name(scr_tid, &gmod)
    # Unwrap Ptr if the scrutinee came through a borrow.
    if scr_tid >= 0 and scr_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(scr_tid).unwrap()
        match bt:
            case GtPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    String enum_name = match_enum_type(type_name, &gmod)
    int merge_bb = new_block(&ctx)
    for arm in arms:
        int arm_body_bb = new_block(&ctx)
        int next_arm_bb = new_block(&ctx)
        lower_pattern_match(&ctx, scrutinee, arm.pattern, enum_name, arm_body_bb, next_arm_bb, &gmod)
        # Arm body lowering in the match-bound block.
        # Phase 2: per-arm Block scope so payload bindings + arm-local
        # SVarDecls get cleaned up at the merge edge.
        switch_to(&ctx, arm_body_bb)
        push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
        lower_stmts(&ctx, arm.body, &gmod, is_main)
        Terminator arm_term = ctx.block_terms.get(ctx.current_block).unwrap()
        match arm_term:
            case GTNone():
                pop_drop_scope(&ctx)
                set_terminator(&ctx, GTJump(merge_bb))
            else:
                pop_drop_scope_no_emit(&ctx)
        switch_to(&ctx, next_arm_bb)
    # No arm matched — jump to merge (unreachable in practice when the
    # match is exhaustive; the self-host's typechecker doesn't enforce
    # exhaustiveness yet so we keep a safe fall-through).
    set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)

# Lower a `match` in EXPRESSION position, producing a single `result`
# local that every reaching (non-diverging) arm assigns. Mirrors Rust
# `lower_match_expr` (`src/ir/lowering/exprs/mod.rs:2569`, dispatched
# from `lower_expr` at `:391`; same merge algorithm as
# `lower_match_stmt_as_expr` `:3257`).
#
# Structure = `lower_match_stmt` (`:7822`, scrutinee staging + per-arm
# branching via `lower_pattern_match`) fused with `lower_if_chain_expr`
# (`:4167`, the value-merge skeleton): each arm body is lowered to a
# value via `lower_block_expr` and — ONLY when the arm did not diverge
# (`not block_terminated`) — assigned into one result local and jumped to
# `merge_bb`. A diverging arm (body ends in `return` / `exit()` / noreturn)
# keeps its own terminator and contributes no merge edge — the gate is
# LOAD-BEARING (Rust documents the same gated-jump as its Snag #33,
# `mod.rs:3384-3395`).
#
# Result type: seed from `ctx.expected_type` when the enclosing writer set
# a concrete one, else `I64_TYPE`; otherwise refine in place from the FIRST
# non-Unit arm value (same latch as `lower_if_chain_expr`).
#
# No-else / fall-through: emit ONLY `GTJump(merge_bb)` after the last arm —
# NO result-default assignment (unlike `lower_if_chain_expr`'s inlined
# `OpConstI64(0)` no-else default at `:4234-4238`). For an exhaustive match
# (e.g. `Ok`/`Error` returning a struct with no `else:`) the unmatched
# fall-through is dynamically unreachable, so `result` legitimately stays
# unassigned there; a default `GIAssign(result, OpConstI64(0))` into a
# struct/String slot would be a C `incompatible types` error (dead code is
# still C-typechecked). Mirrors Rust `lower_match_expr` (no default) and
# the self-host `lower_match_stmt` fall-through (`:7856-7859`).
#
# Guards (`MatchArm.guard`) are NOT handled — matches `lower_match_stmt`'s
# existing (no-guard) behavior; logged as a follow-up. Per-arm name-map
# snapshot/restore (Rust Snag #50) is likewise omitted, matching
# `lower_match_stmt`'s per-arm drop-scope behavior (logged follow-up).
int lower_match_expr(LowerCtx &ctx, SpannedExpr scrutinee_expr, Vector[MatchArm] arms, GirModule &gmod):
    # Same scrutinee discipline as lower_match_stmt: suppress the centralized
    # auto-prop when the arms discriminate a Result/Option (keep it raw);
    # otherwise let a throws-call scrutinee peel to its payload. Take
    # expected_type (the match RESULT's expected type) around the SCRUTINEE
    # lowering only — it must not leak into the scrutinee's auto-prop
    # capture-form check — then restore it so the result_type seeding below
    # still sees it.
    int saved_expected_me = ctx.expected_type
    ctx.expected_type = -1
    ctx.suppress_auto_prop = arms_match_result_or_option(arms)
    int scrutinee = lower_expr(&ctx, scrutinee_expr, &gmod)
    ctx.expected_type = saved_expected_me
    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
    String type_name = type_id_to_name(scr_tid, &gmod)
    # Unwrap Ptr if the scrutinee came through a borrow.
    if scr_tid >= 0 and scr_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(scr_tid).unwrap()
        match bt:
            case GtPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    String enum_name = match_enum_type(type_name, &gmod)
    # Seed result type from expected_type when the writer set a concrete
    # one; else I64 (refined below from the first non-Unit arm value).
    int result_type_init = I64_TYPE
    bool result_type_refined = false
    if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
        result_type_init = ctx.expected_type
        result_type_refined = true
    int result = add_local(&ctx, result_type_init, NO_NAME)
    int merge_bb = new_block(&ctx)
    for arm in arms:
        int arm_body_bb = new_block(&ctx)
        int next_arm_bb = new_block(&ctx)
        lower_pattern_match(&ctx, scrutinee, arm.pattern, enum_name, arm_body_bb, next_arm_bb, &gmod)
        # Arm body lowering in the match-bound block. Per-arm Block scope so
        # payload bindings + arm-local SVarDecls get cleaned up at the merge
        # edge (same as lower_match_stmt; lower_pattern_match already emitted
        # the pattern bindings into this block).
        switch_to(&ctx, arm_body_bb)
        push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
        int arm_val = lower_block_expr(&ctx, arm.body, &gmod)
        if not block_terminated(&ctx):
            if not result_type_refined:
                int aty = ctx.locals.get(arm_val).unwrap().type_id
                if aty != UNIT_TYPE:
                    refine_local_type(&ctx, result, aty)
                    result_type_refined = true
            emit(&ctx, GIAssign(result, op_consume(&ctx, &gmod, arm_val, CkAssign())))
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            # Diverging arm (body ended in return / exit / noreturn): its
            # terminator stands — no assign, no merge jump.
            pop_drop_scope_no_emit(&ctx)
        switch_to(&ctx, next_arm_bb)
    # No arm matched (dynamically unreachable for an exhaustive match) —
    # jump to merge with NO result default. See the header note.
    set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)
    return result

# Lower `for pat in iter_expr: body` over Vector / Deque collections.
#
# Architecturally: ONE arm in `lower_stmt`, ONE scaffold here, parameterised
# by collection type only at the element-extract step. This is intentionally
# unified — the Rust frontend currently has SEVEN separate `lower_for_*`
# functions (one each for array, dict, set, string, iterable, enumerate,
# range) that duplicate ~80% scaffold; self-host's reference-grade answer
# is the single-scaffold + per-type extractor split documented below.
# See TODO `lower_for: iterator-protocol fallback for non-Vector iterables`
# for the path to extending this beyond Vector/Deque.
#
# Desugar shape (matches the manual idiom users write today):
#
#   for x in coll:                       int idx = 0
#       <body>                           int len = coll.len()
#                                  →     while idx < len:
#                                            auto x = coll.get(idx).unwrap()
#                                            <body>
#                                            idx = idx + 1
#
#   for (i, x) in coll.enumerate():      <same scaffold, additionally>
#       <body>                       →   bind `i` to a fresh copy of idx
#                                        per iteration (immutable snapshot)
#
# Element extract: routed through the canonical `coll.get(idx).unwrap()`
# chain via `emit_payload_read` (the resource auto-clone makes the binding
# independent of the collection — same semantics as the manual idiom). No
# AST synthesis, no recursive `lower_stmt` round-trip.
#
# Drop discipline: `coll_local` is owned by the caller (we don't consume
# it); `OpBorrow(coll_local)` is passed to `__len` and `__get`. The element
# binding owns its cloned copy; standard scope-exit drops handle release.
#
# Continue/break: continue jumps to `incr_bb` (so idx advances); break to
# `exit_bb`. Stacks pushed/popped around `lower_stmts(body, ...)`.
#
# for-else (else_body): rare in self-host; emits a `lower_fail` diagnostic
# rather than silently dropping. Wire the Python-semantics version (runs
# only when the loop completes without break) when a self-host site
# actually needs it.
void lower_for(LowerCtx &ctx, SpannedPattern pat, SpannedExpr iter_expr, Vector[Stmt] body, Vector[Stmt] else_body, GirModule &gmod, bool is_main):
    if else_body.len() > 0:
        lower_fail("SFor with else-body not yet implemented")
        return
    # Range fast path — `for i in start..end` over a literal `ERange`.
    # Mirrors Rust's `lower_for` first branch (src/ir/lowering/stmts/
    # for_loops.rs:118-128 → lower_for_range :1003): when the pattern is a
    # bare binding AND the iterable is a both-bounded range, emit a counter
    # loop directly instead of routing through the iterator protocol (the
    # iterator path would `lower_fail` — `int64_t` has no iter()/next() chain
    # — silently dropping the whole loop body). The self-host `ERange` AST
    # (ast.gg:66) carries only `start`/`end` (no `inclusive` field) and the
    # parser only produces exclusive `..`, so the comparison is always `<`.
    match pat.pat:
        case PBinding(loop_name):
            match iter_expr.expr:
                case ERange(start_opt, end_opt):
                    match start_opt:
                        case Some(start_box):
                            match end_opt:
                                case Some(end_box):
                                    SpannedExpr start_e = *start_box
                                    SpannedExpr end_e = *end_box
                                    lower_for_range(&ctx, loop_name, start_e, end_e, body, &gmod, is_main)
                                    return
                                case None:
                                    pass
                        case None:
                            pass
                else:
                    pass
        else:
            pass
    # Detect `.enumerate()` and strip it for the Vector/Deque fast path —
    # if `recv` turns out to be Vector/Deque, the idx-based scaffold can
    # bind both the index and the element directly. For non-Vector
    # receivers we DON'T strip (the strip would be wrong: on user-defined
    # iterables `coll.enumerate()` is just a regular method call returning
    # a wrapper iterator). The probe is purely speculative; we commit to
    # the strip only after type-checking `recv`.
    SpannedExpr probe_coll = iter_expr
    bool probe_is_enumerate = false
    match iter_expr.expr:
        case EMethodCall(recv_box, mname, margs, _):
            if mname == "enumerate" and margs.len() == 0:
                probe_coll = SpannedExpr((*recv_box).expr, (*recv_box).span)
                probe_is_enumerate = true
        else:
            pass
    # Lower the probe receiver once. If it's Vector/Deque, the
    # `probe_is_enumerate` strip was correct and we take the fast path.
    # Otherwise the strip was wrong, but for non-Vector enumeration
    # self-host has no in-tree use case today — fail loudly with a
    # diagnostic and let the iterator-protocol path handle the
    # non-enumerate variant.
    # The iterable is collection-typed, not the surrounding context — clear
    # any leaked `expected_type` so a Result-typed expectation doesn't make
    # the centralized auto-prop hook's capture-form check suppress a
    # throws-call iterable's peel (`for x in might():`).
    int saved_expected_for = ctx.expected_type
    ctx.expected_type = -1
    int coll_local = lower_expr(&ctx, probe_coll, &gmod)
    ctx.expected_type = saved_expected_for
    # Auto-propagate a `throws` call used as the iterable (`for x in might()`).
    coll_local = maybe_auto_propagate(&ctx, coll_local, &gmod)
    String coll_tn = local_type_name(coll_local, &ctx, &gmod)
    # Phase A — typed-metadata classification (CkVector/CkDeque) via
    # the lazy `resource_meta_for` accessor; retires the legacy
    # `starts_with("Vector__")` cascade per
    # docs/devbook/18-runtime-abi.md (the resource table) and
    # docs/devbook/26-self-host-frontend.md §3.
    bool coll_is_vec_like = false
    bool coll_is_dict = false
    match resource_meta_for(&gmod, coll_tn):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkVector():
                    coll_is_vec_like = true
                case CkDeque():
                    coll_is_vec_like = true
                case CkDict():
                    coll_is_dict = true
                else:
                    pass
        case None:
            pass
    if coll_is_vec_like:
        lower_for_vector(&ctx, pat, coll_local, coll_tn, probe_is_enumerate, body, &gmod, is_main)
        return
    # Dict/HashMap fast path: `for (k, v) in <Dict>` (entry pairs) or
    # `for k in <Dict>` (keys only). The iterator-protocol fallback below
    # would `lower_fail` — a mono'd `Dict__K__V` has no `__iter`/`__next`
    # chain — silently dropping the whole loop body. Mirrors Rust's
    # `lower_for_dict` (src/ir/lowering/stmts/for_loops.rs:574). The
    # `.enumerate()` strip never applies to a Dict (no Vector/Deque kind),
    # so `probe_is_enumerate` is false here.
    if coll_is_dict:
        lower_for_dict(&ctx, pat, coll_local, coll_tn, body, &gmod, is_main)
        return
    # String fast path: `for c in <String>` iterates UTF-8 CODEPOINTS. The
    # iterator-protocol fallback below would `lower_fail` (GorgetString has no
    # __iter/__next), silently dropping the body. `coll_tn == "GorgetString"`
    # also covers a Ptr-to-String param — type_id_to_name(GtPtr(GorgetString))
    # collapses to "GorgetString" (lower.gg:877-879).
    if coll_tn == "GorgetString":
        lower_for_string(&ctx, pat, coll_local, body, &gmod, is_main)
        return
    if probe_is_enumerate:
        # Non-Vector `.enumerate()` — would need either (a) an iterator-
        # protocol path that also threads an index counter, or (b) a
        # surface-language rewrite to `coll.iter().enumerate()`. Neither
        # is exercised in self-host today; fail with a precise message.
        lower_fail("SFor enumerate over non-Vector/Deque iterable not yet implemented (coll type: " + coll_tn + ")")
        return
    # Iterator-protocol fallback — universal path for Dict/Set/String/
    # Range/user-iterables. Calls `coll.iter()` (or treats `coll` as the
    # iterator if no iter() exists) and loops on `next() → Option[T]`
    # until None.
    lower_for_iterator(&ctx, pat, coll_local, coll_tn, body, &gmod, is_main)

# Vector/Deque fast path: idx-based scaffold matching the manual idiom
# users write today (`int i = 0; while i < x.len(): T v = x.get(i).unwrap();
# ...; i += 1`). Direct GIR emission, no recursive lower_stmt round-trip.
void lower_for_vector(LowerCtx &ctx, SpannedPattern pat, int coll_local, String coll_tn, bool is_enumerate, Vector[Stmt] body, GirModule &gmod, bool is_main):
    String elem_name = collection_element_type(coll_tn)
    if elem_name == "":
        lower_fail("SFor: could not resolve element type for " + coll_tn)
        return
    int elem_tid = resolve_elem_type_id(elem_name, &gmod)
    # ── Iteration state ──────────────────────────────────────
    int idx_local = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(idx_local, OpConstI64(0)))
    int len_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] len_args = [OpBorrow(coll_local)]
    emit(&ctx, GICallExtern(len_local, coll_tn + "__len", len_args))
    # ── Block layout ─────────────────────────────────────────
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int incr_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: `idx < len ? body : exit`
    switch_to(&ctx, header_bb)
    int cond_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cond_local, CMP_LT, I64_TYPE, OpCopy(idx_local), OpCopy(len_local)))
    set_terminator(&ctx, GTBranch(OpCopy(cond_local), body_bb, exit_bb))
    # Body: extract element via `coll.get(idx).unwrap()`, bind pattern.
    ctx.loop_continue_stack.push(incr_bb)
    ctx.loop_break_stack.push(exit_bb)
    # Phase 2: Loop drop scope around the body (per-iteration locals
    # like the element binding need to be cleaned up before each
    # back-edge / break).
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    String opt_name = "Option__" + elem_name
    int opt_tid = lookup_or_register_named(&gmod, opt_name)
    record_enum_category(&gmod, opt_tid, ENUM_CAT_OPTION, elem_tid, -1)
    # CoW for-element: tag the get-result with the SOURCE collection local
    # (BoCollectionElement(coll_local), a non-negative id) — distinct from
    # the general `.get()` path (BoCollectionElement(-1)). The non-negative
    # origin signals lir_lower's void*→Option lift to shallow-alias the
    # element instead of deep-cloning it (the for-element clone bomb). The
    # for-loop fully controls the element's lifecycle: the body reads it as
    # a borrow and any consume/mutation clones on demand (a-5), so the alias
    # is safe. The general `.get()` keeps the eager clone because its result
    # may be bound to a user local and mutated in place (get-mutate-set).
    int got_local = add_local_with(&ctx, opt_tid, NO_NAME, LoBorrowed(), BoCollectionElement(coll_local))
    Vector[Operand] get_args = [OpBorrow(coll_local), OpCopy(idx_local)]
    emit(&ctx, GICallExtern(got_local, coll_tn + "__get", get_args))
    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, got_local)
    # CoW for-element: bind the element as a borrow alias into the
    # collection (no clone). Body consume/mutation sites clone on demand.
    int elem_local = emit_payload_read_mode(&ctx, scr_ptr, opt_name, "Some", 0, elem_tid, &gmod, true)
    if is_enumerate:
        match pat.pat:
            case PTuple(parts):
                if parts.len() == 2:
                    bind_for_local(&ctx, parts.get(0).unwrap(), idx_local, I64_TYPE, &gmod)
                    bind_for_local(&ctx, parts.get(1).unwrap(), elem_local, elem_tid, &gmod)
                else:
                    lower_fail("SFor enumerate: expected 2-tuple pattern, got " + int_to_str(parts.len()) + " parts")
            else:
                lower_fail("SFor enumerate: expected tuple pattern")
    else:
        bind_for_local(&ctx, pat, elem_local, elem_tid, &gmod)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(incr_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    # Incr: `idx = idx + 1; goto header`.
    switch_to(&ctx, incr_bb)
    int new_idx = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIBinOp(new_idx, OP_ADD, I64_TYPE, OpCopy(idx_local), OpConstI64(1)))
    emit(&ctx, GIAssign(idx_local, OpCopy(new_idx)))
    set_terminator(&ctx, GTJump(header_bb))
    switch_to(&ctx, exit_bb)

# String fast path: `for c in <String>` iterates UTF-8 CODEPOINTS (one owned
# String per iteration), mirroring Rust's `lower_for_string`
# (src/ir/lowering/stmts/for_loops.rs:237). Same header/body/incr/exit block
# scaffold as `lower_for_vector`, but the iteration state is a `byte_pos`
# counter (NOT a logical index) bounded by the BYTE length — per iteration the
# stride is `gorget_utf8_codepoint_len_at(coll, byte_pos)`, NOT 1, so a
# multibyte codepoint (e.g. `é`) is consumed whole rather than split into bytes.
#
# The loop var `ch` is a cap=0 VIEW into the source string
# (`gorget_str_codepoint_at` → `gorget_str_view_region`, free is a no-op), so
# it is bound LoBorrowed with BoCollectionElement(coll_local) like the
# vector for-element — NO owned-drop registration. (The Rust oracle's
# drop-register at :347-354 is STALE: its comment predates the runtime
# returning a view.)
#
# `coll` operand: passed as `OpBorrow(coll_local)` like the vector __len/__get
# calls. `gorget_str_byte_len` / `gorget_str_codepoint_at` /
# `gorget_utf8_codepoint_len_at` all take `Str` BY VALUE; a Ptr-source `coll`
# (bare String param's void* ABI) is auto-deref'd `*(Str*)` at C-emit via the
# `runtime_takes_str_by_value` + `runtime_arg_is_str` registrations
# (lir_codegen.gg).
void lower_for_string(LowerCtx &ctx, SpannedPattern pat, int coll_local, Vector[Stmt] body, GirModule &gmod, bool is_main):
    int gstr_tid = lookup_or_register_named(&gmod, "GorgetString")
    # ── Iteration state ──────────────────────────────────────
    # byte_pos counter (seeded 0) + the BYTE-length bound (NOT codepoint count).
    int bytepos_local = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(bytepos_local, OpConstI64(0)))
    int len_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] len_args = [OpBorrow(coll_local)]
    emit(&ctx, GICallExtern(len_local, "gorget_str_byte_len", len_args))
    # ── Block layout ─────────────────────────────────────────
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int incr_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: `byte_pos < len ? body : exit`
    switch_to(&ctx, header_bb)
    int cond_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cond_local, CMP_LT, I64_TYPE, OpCopy(bytepos_local), OpCopy(len_local)))
    set_terminator(&ctx, GTBranch(OpCopy(cond_local), body_bb, exit_bb))
    # Body: `ch = gorget_str_codepoint_at(coll, byte_pos)` — a cap=0 view into
    # the source string; bind as a borrow alias (no clone, no owned drop).
    ctx.loop_continue_stack.push(incr_bb)
    ctx.loop_break_stack.push(exit_bb)
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    int ch_local = add_local_with(&ctx, gstr_tid, NO_NAME, LoBorrowed(), BoCollectionElement(coll_local))
    Vector[Operand] cp_args = [OpBorrow(coll_local), OpCopy(bytepos_local)]
    emit(&ctx, GICallExtern(ch_local, "gorget_str_codepoint_at", cp_args))
    bind_for_local(&ctx, pat, ch_local, gstr_tid, &gmod)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(incr_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    # Incr: `cplen = gorget_utf8_codepoint_len_at(coll, byte_pos)` (byte_pos is
    # unchanged from the body, so the same codepoint is measured); advance
    # `byte_pos += cplen` — stride by cplen, NOT 1. Computed HERE (not in the
    # body) to avoid threading `cplen` across the body/incr block boundary.
    switch_to(&ctx, incr_bb)
    int cplen_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] cplen_args = [OpBorrow(coll_local), OpCopy(bytepos_local)]
    emit(&ctx, GICallExtern(cplen_local, "gorget_utf8_codepoint_len_at", cplen_args))
    int new_pos = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIBinOp(new_pos, OP_ADD, I64_TYPE, OpCopy(bytepos_local), OpCopy(cplen_local)))
    emit(&ctx, GIAssign(bytepos_local, OpCopy(new_pos)))
    set_terminator(&ctx, GTJump(header_bb))
    switch_to(&ctx, exit_bb)

# Split a mono'd Dict/HashMap type name into its KEY and VALUE GIR type
# names. Mirrors Rust's `parse_dict_kv_types` + `find_kv_split`
# (src/ir/lowering/stmts/for_loops.rs:949/979). The naive "first `__`
# after the prefix" split (used by the dict-literal element-hint path at
# :6883) mis-splits when the KEY is itself a mangled generic (e.g.
# `Dict__Vector__int64_t__int64_t` → key `Vector`, not `Vector__int64_t`),
# so we try known one-segment primitive prefixes (`int64_t`, …,
# `GorgetString`) FIRST and only fall back to the first interior `__`.
# Returns ("int64_t", "int64_t") when no split is found (the same scalar
# default Rust uses).
DictKvNames parse_dict_kv_types(String type_name):
    int prefix_len = -1
    if type_name.starts_with("Dict__"):
        prefix_len = 6
    elif type_name.starts_with("HashMap__"):
        prefix_len = 9
    elif type_name.starts_with("GorgetDict__"):
        prefix_len = 12
    elif type_name.starts_with("GorgetMap__"):
        prefix_len = 11
    if prefix_len < 0:
        return DictKvNames("int64_t", "int64_t")
    String rest = type_name.slice(prefix_len, type_name.len())
    # Known single-segment primitive key prefixes — split right after one
    # when `rest` begins with it followed by `__` (so the value is whatever
    # trails, however mangled). Order is longest-safe-first; each is checked
    # for the trailing `__` boundary.
    Vector[String] prims = ["int64_t", "int32_t", "int16_t", "int8_t", "uint64_t", "uint32_t", "uint16_t", "uint8_t", "double", "float", "bool", "GorgetString"]
    int pi = 0
    while pi < prims.len():
        String prim = prims.get(pi).unwrap()
        if rest.starts_with(prim):
            String after = rest.slice(prim.len(), rest.len())
            if after.starts_with("__"):
                String v_only = after.slice(2, after.len())
                return DictKvNames(prim, v_only)
        pi += 1
    # Fallback: first interior `__` with a non-empty key AND value.
    int sep = rest.index_of("__").unwrap_or(-1)
    if sep > 0 and sep + 2 < rest.len():
        String k_only = rest.slice(0, sep)
        String v_only = rest.slice(sep + 2, rest.len())
        return DictKvNames(k_only, v_only)
    return DictKvNames("int64_t", "int64_t")

# Extract the binding name from a for-loop sub-pattern, defaulting to
# `fallback` for non-`PBinding` shapes (wildcard / nested). Mirrors the
# k_name/v_name extraction in Rust's `lower_for_dict` (:636-637).
String for_pat_binding_name(SpannedPattern p, String fallback):
    match p.pat:
        case PBinding(name):
            return name
        else:
            return fallback

# Dict/HashMap fast path: `for (k, v) in <Dict>` (entry pairs) or
# `for k in <Dict>` (keys only). Mirrors Rust's `lower_for_dict`
# (src/ir/lowering/stmts/for_loops.rs:574). Iterates the map's slot array
# directly — `oi` walks `[0, cap)`, a per-slot `state == USED(1)` filter
# (`emit_state_filter`) skips empty/tombstone slots, and `gorget_map_iter_key`
# / `gorget_map_iter_value` write OWNED copies of the key/value into freshly
# bound locals via void out-param calls.
#
# OWNERSHIP (differs from `lower_for_vector`): the runtime accessors CLONE
# resource-typed keys/values (`key_clone`/`val_clone` in runtime_map.c) into
# the out slot, so each bound K/V is a fresh OWNER — bound LoOwned (via
# `add_local`) and `register_local_for_drop`'d so the per-iteration DSK_LOOP
# scope frees it (no leak — the snag_6 canary). For `int64_t` keys/values
# `register_local_for_drop` is a no-op (non-droppable). The vector path binds
# a LoBorrowed view with NO drop reg because its `__get` returns an alias, not
# a clone; mixing the two models would either leak (no drop on a clone) or
# double-free (drop on a view).
#
# Block scaffold (header/body/incr/exit, loop stacks, per-iteration drop
# scope) is the same shape as `lower_for_vector` — see the duplication note at
# `lower_for_iterator`. The differences are: the bound is `gorget_map_iter_cap`
# (slot capacity, not logical len, because we walk raw slots); the body opens
# with the state filter; and the binds are owned-clone out-params.
void lower_for_dict(LowerCtx &ctx, SpannedPattern pat, int coll_local, String coll_tn, Vector[Stmt] body, GirModule &gmod, bool is_main):
    DictKvNames kv = parse_dict_kv_types(coll_tn)
    String key_name = kv.key_name
    String val_name = kv.val_name
    int key_tid = resolve_elem_type_id(key_name, &gmod)
    int val_tid = resolve_elem_type_id(val_name, &gmod)
    # ── Iteration state ──────────────────────────────────────
    # oi walks [0, cap); cap is the SLOT capacity (not logical len) — empty
    # and tombstone slots are skipped per-iteration by the state filter.
    int oi_local = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(oi_local, OpConstI64(0)))
    int cap_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] cap_args = [OpBorrow(coll_local)]
    emit(&ctx, GICallExtern(cap_local, "gorget_map_iter_cap", cap_args))
    # ── Block layout ─────────────────────────────────────────
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int incr_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: `oi < cap ? body : exit`
    switch_to(&ctx, header_bb)
    int cond_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cond_local, CMP_LT, I64_TYPE, OpCopy(oi_local), OpCopy(cap_local)))
    set_terminator(&ctx, GTBranch(OpCopy(cond_local), body_bb, exit_bb))
    # Body: filter empty/tombstone slots, bind k/v, lower body.
    ctx.loop_continue_stack.push(incr_bb)
    ctx.loop_break_stack.push(exit_bb)
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    # State filter: `state = gorget_map_iter_state(&coll, oi)`; skip to incr
    # (next slot) unless USED(1). On a hit, fall into a fresh `elem_bb`.
    int state_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] state_args = [OpBorrow(coll_local), OpCopy(oi_local)]
    emit(&ctx, GICallExtern(state_local, "gorget_map_iter_state", state_args))
    int state_ok = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(state_ok, CMP_EQ, I64_TYPE, OpCopy(state_local), OpConstI64(1)))
    int elem_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(state_ok), elem_bb, incr_bb))
    switch_to(&ctx, elem_bb)
    # Bind the key (and value for a tuple pattern). The accessors write OWNED
    # copies into the bound slots via the void* out-param (arg 2), so each
    # local is a fresh owner — bound LoOwned (add_local) + registered for the
    # per-iteration drop. `OpBorrow(<local>)` at arg 2 becomes a SlotAddr
    # (pointer to the local's slot) at C-emit via `needs_ptr_arg`.
    match pat.pat:
        case PTuple(parts):
            if parts.len() == 2:
                String kname = for_pat_binding_name(parts.get(0).unwrap(), "__k")
                String vname = for_pat_binding_name(parts.get(1).unwrap(), "__v")
                int k_local = add_local(&ctx, key_tid, Some(kname))
                Vector[Operand] k_args = [OpBorrow(coll_local), OpCopy(oi_local), OpBorrow(k_local)]
                emit(&ctx, GICallExtern(-1, "gorget_map_iter_key", k_args))
                nl_put(&ctx, kname, k_local)
                register_local_for_drop(&ctx, k_local, key_tid, &gmod)
                int v_local = add_local(&ctx, val_tid, Some(vname))
                Vector[Operand] v_args = [OpBorrow(coll_local), OpCopy(oi_local), OpBorrow(v_local)]
                emit(&ctx, GICallExtern(-1, "gorget_map_iter_value", v_args))
                nl_put(&ctx, vname, v_local)
                register_local_for_drop(&ctx, v_local, val_tid, &gmod)
            else:
                lower_fail("SFor over Dict: expected 2-tuple pattern, got " + int_to_str(parts.len()) + " parts")
        case PBinding(kname):
            # Key-only iteration: `for k in <Dict>`.
            int k_local = add_local(&ctx, key_tid, Some(kname))
            Vector[Operand] k_args = [OpBorrow(coll_local), OpCopy(oi_local), OpBorrow(k_local)]
            emit(&ctx, GICallExtern(-1, "gorget_map_iter_key", k_args))
            nl_put(&ctx, kname, k_local)
            register_local_for_drop(&ctx, k_local, key_tid, &gmod)
        else:
            lower_fail("SFor over Dict: only (k, v) tuple or bare key binding supported")
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(incr_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    # Incr: `oi = oi + 1; goto header`.
    switch_to(&ctx, incr_bb)
    int new_oi = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIBinOp(new_oi, OP_ADD, I64_TYPE, OpCopy(oi_local), OpConstI64(1)))
    emit(&ctx, GIAssign(oi_local, OpCopy(new_oi)))
    set_terminator(&ctx, GTJump(header_bb))
    switch_to(&ctx, exit_bb)

# Range fast path: `for i in start..end` → an i64 counter loop, matching
# Rust's `lower_for_range` (src/ir/lowering/stmts/for_loops.rs:1003). The
# loop var is a freshly-OWNED i64 (not an Option-extracted borrow alias, so
# `add_local`/`nl_put` — NOT `bind_for_local`). Same block scaffold as
# `lower_for_vector` (header/body/incr/exit, loop stacks, per-iteration drop
# scope); the only differences are the counter is seeded from the lowered
# `start` (instead of 0) and the bound is the lowered `end` (instead of
# `coll.len()`). Exclusive `<` only — the self-host `ERange` has no inclusive
# form. Continue → incr_bb (advance the counter); break → exit_bb.
void lower_for_range(LowerCtx &ctx, String loop_name, SpannedExpr start_e, SpannedExpr end_e, Vector[Stmt] body, GirModule &gmod, bool is_main):
    # ── Iteration state ──────────────────────────────────────
    # Loop var: a fresh OWNED i64 seeded from `start`. `nl_put` reads
    # `loop_name` again below, so it is LIVE here — the bare `Some(loop_name)`
    # name-hint clones-if-live (CoW), no explicit `.clone()` needed.
    int loop_var = add_local(&ctx, I64_TYPE, Some(loop_name))
    int start_local = lower_expr(&ctx, start_e, &gmod)
    emit(&ctx, GIAssign(loop_var, OpCopy(start_local)))
    nl_put(&ctx, loop_name, loop_var)
    # End bound, lowered once (the cond re-reads this fixed value each iter).
    int end_local = lower_expr(&ctx, end_e, &gmod)
    # ── Block layout ─────────────────────────────────────────
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int incr_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: `loop_var < end ? body : exit`
    switch_to(&ctx, header_bb)
    int cond_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cond_local, CMP_LT, I64_TYPE, OpCopy(loop_var), OpCopy(end_local)))
    set_terminator(&ctx, GTBranch(OpCopy(cond_local), body_bb, exit_bb))
    # Body: lower the loop body in a fresh loop/drop scope. Continue jumps
    # to incr (advance the counter); break jumps to exit.
    ctx.loop_continue_stack.push(incr_bb)
    ctx.loop_break_stack.push(exit_bb)
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(incr_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    # Incr: `loop_var = loop_var + 1; goto header`.
    switch_to(&ctx, incr_bb)
    int new_var = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIBinOp(new_var, OP_ADD, I64_TYPE, OpCopy(loop_var), OpConstI64(1)))
    emit(&ctx, GIAssign(loop_var, OpCopy(new_var)))
    set_terminator(&ctx, GTJump(header_bb))
    switch_to(&ctx, exit_bb)

# Iterator-protocol fallback — universal path for any type with the
# `iter()` / `next() → Option[T]` chain. Covers Dict, Set, String, Range,
# and user-defined iterables (anything that equips `Iterator[T]` per
# `lib/std/iter.gg`).
#
# Architectural choice: this is one helper, not seven (Rust frontend has
# `lower_for_string` / `lower_for_dict` / `lower_for_set` / `lower_for_range`
# / `lower_for_iterable` etc., each duplicating ~80% scaffold). Self-host's
# single-scaffold-plus-extractor design works because we let the user-
# defined `Iterator[T]` trait protocol carry the per-type knowledge — the
# loop just calls `iter()` and `next()` by name and reads `Option[T]`.
# Whatever T is, however .next() decides when to yield None, the scaffold
# is identical.
#
# Lowered shape:
#   auto __iter = coll.iter()       # or `__iter = coll` if coll IS already
#                                   # an iterator (next() but no iter())
#   while true:
#       Option[T] step = __iter.next()
#       <if step is Some(x):
#           <pattern binding>
#           <body>
#           continue → header>
#       <if step is None:
#           break → exit>
#
# Continue jumps to the header (re-call next()); break to exit.
void lower_for_iterator(LowerCtx &ctx, SpannedPattern pat, int coll_local, String coll_tn, Vector[Stmt] body, GirModule &gmod, bool is_main):
    # Locate iter() and next() in fn_sigs. If coll has `iter()`, we call it
    # and loop on the returned iterator. If coll has `next()` but no
    # `iter()`, it IS an iterator — skip the iter() call.
    String iter_fn = coll_tn + "__iter"
    bool has_iter = gmod.fn_sigs.contains(iter_fn)
    int iter_type_tid = -1
    String iter_type_name = ""
    if has_iter:
        iter_type_tid = gmod.fn_sigs.get(iter_fn).unwrap()
        iter_type_name = type_id_to_name(iter_type_tid, &gmod)
    else:
        iter_type_tid = ctx.locals.get(coll_local).unwrap().type_id
        iter_type_name = coll_tn
    String next_fn = iter_type_name + "__next"
    if not gmod.fn_sigs.contains(next_fn):
        lower_fail("SFor: no iter()/next() chain on type " + coll_tn + " (looked for " + iter_fn + " or " + next_fn + ")")
        return
    int opt_ret_tid = gmod.fn_sigs.get(next_fn).unwrap()
    String opt_type_name = type_id_to_name(opt_ret_tid, &gmod)
    if not opt_type_name.starts_with("Option__"):
        lower_fail("SFor: " + next_fn + " return type isn't Option__T (got " + opt_type_name + ")")
        return
    String elem_name = opt_type_name.slice(8, opt_type_name.len())
    int elem_tid = resolve_elem_type_id(elem_name, &gmod)
    # Materialise the iterator. For `has_iter`, call coll.iter() once; the
    # returned iterator is what every subsequent next() reads from. For
    # the self-iterator case (`coll` IS an iterator), reuse coll_local.
    int iter_local = coll_local
    if has_iter:
        iter_local = add_local(&ctx, iter_type_tid, NO_NAME)
        Vector[Operand] iter_args = [OpBorrow(coll_local)]
        emit(&ctx, GICallExtern(iter_local, iter_fn, iter_args))
    # ── Block layout ────────────────────────────────────────
    # No incr_bb — `.next()` advances internally, so continue goes back
    # to the header (which re-calls next()).
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: step = iter.next(); branch on Some/None tag.
    switch_to(&ctx, header_bb)
    int step_local = add_local(&ctx, opt_ret_tid, NO_NAME)
    Vector[Operand] next_args = [OpBorrow(iter_local)]
    emit(&ctx, GICallExtern(step_local, next_fn, next_args))
    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, step_local)
    int tag_local = emit_tag_read(&ctx, scr_ptr, opt_type_name, &gmod)
    int cmp_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    # Option tag layout: 0 = Some, 1 = None (matches emit_tag_read's contract,
    # mirroring the unwrap_or path at lines ~2055-2076).
    emit(&ctx, GICmp(cmp_local, CMP_EQ, I64_TYPE, OpCopy(tag_local), OpConstI64(0)))
    set_terminator(&ctx, GTBranch(OpCopy(cmp_local), body_bb, exit_bb))
    # Body: extract payload, bind pattern, lower body, jump back to header.
    ctx.loop_continue_stack.push(header_bb)
    ctx.loop_break_stack.push(exit_bb)
    # Phase 2: Loop drop scope around the body.
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    # CoW for-element: borrow alias (see lower_for_vector).
    int elem_local = emit_payload_read_mode(&ctx, scr_ptr, opt_type_name, "Some", 0, elem_tid, &gmod, true)
    bind_for_local(&ctx, pat, elem_local, elem_tid, &gmod)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(header_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    switch_to(&ctx, exit_bb)

# Bind a for-loop pattern part to a GIR local. The element binding is a
# BORROW ALIAS into the collection per the CoW default (CLAUDE.md
# "Ownership at Consuming Positions": collection element reads propagate
# Ptr aliases at zero cost; clones happen only at ownership boundaries).
# When `src_local` is a LoBorrowed/LoView element (from the for-element
# extract, see lower_for_vector / lower_for_iterator), inherit that tag
# onto the bound local and assign with a NON-consume operand (OpBorrow,
# via CkCallArgBorrow) so no clone is emitted. A loop body that consumes
# or mutates the element materialises a fresh copy at THAT site via
# op_consume's a-5 LoBorrowed→OpClone arm. Owned/primitive elements
# (LoOwned) keep the original move/copy binding shape.
void bind_for_local(LowerCtx &ctx, SpannedPattern pat, int src_local, int tid, GirModule &gmod):
    match pat.pat:
        case PBinding(name):
            int bound = add_local_inheriting(&ctx, tid, Some(name), src_local)
            # If the element is a borrow alias, bind it as a borrow (no
            # clone). add_local_inheriting tagged `bound` LoBorrowed/LoView
            # iff src is; in that case CkCallArgBorrow keeps op_consume at
            # OpBorrow. Otherwise (LoOwned/primitive) CkAssign moves/copies.
            ConsumeKind bind_kind = CkAssign()
            if local_is_borrow_alias(&ctx, bound):
                bind_kind = CkCallArgBorrow()
            emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, src_local, bind_kind)))
            nl_put(&ctx, name, bound)
        case PWildcard:
            pass
        else:
            lower_fail("SFor: only PBinding / PWildcard supported in for-loop pattern (got nested pattern)")

# True iff `lid`'s ownership tag is a borrow alias (LoBorrowed/LoView).
bool local_is_borrow_alias(LowerCtx &ctx, int lid):
    if lid < 0 or lid >= ctx.locals.len():
        return false
    match ctx.locals.get(lid).unwrap().ownership:
        case LoBorrowed():
            return true
        case LoView():
            return true
        else:
            return false

# True iff `lid` does NOT own its data — a match scrutinee we may destructure
# into BORROW-aliased payload binds (CoW match-destructure, no deep clone).
# Covers (a) explicit borrow aliases (LoBorrowed/LoView) and (b) bare
# by-value resource PARAMS, which lower to GtPtr(T)/LoParam: the caller owns,
# the callee borrows (CLAUDE.md CoW default — bare params are borrows). A
# `&`/`!` param is GtMutPtr (excluded here): `!` the callee owns, `&` is a
# mutable borrow whose payload binds keep their existing clone-on-consume
# path. Owned locals (LoOwned) return false → eager clone, preserving the
# Class-8 double-free fix for genuinely-owned scrutinees written back into a
# collection. Used by lower_ctor_pattern's PBinding payload bind.
bool scrutinee_nonowning(LowerCtx &ctx, GirModule &gmod, int lid):
    if lid < 0 or lid >= ctx.locals.len():
        return false
    GirLocal loc = ctx.locals.get(lid).unwrap()
    match loc.ownership:
        case LoBorrowed():
            return true
        case LoView():
            return true
        case LoParam():
            # Bare by-value resource param == GtPtr(T) slot (caller owns,
            # callee borrows). `&`/`!` params are GtMutPtr → not borrow here.
            if loc.type_id < 0 or loc.type_id >= gmod.type_table.len():
                return false
            match gmod.type_table.get(loc.type_id).unwrap():
                case GtPtr(_):
                    return true
                else:
                    return false
        else:
            return false

# True iff `lid` is an OWNED match scrutinee whose own type is whole-droppable
# (registered for drop by register_local_for_drop). For such a scrutinee the
# whole-scrutinee `Result__/Option____drop` (discriminant switch) frees the
# payload exactly once at scope exit — so a payload BIND must NOT deep-clone
# (would leak the clone, since the bind is block-scoped) and must NOT register
# the bind for its own drop (would double-free the SAME heap the whole drop
# frees). Instead bind the payload as a LoBorrowed alias into the scrutinee.
# Mirrors Rust's EnumFieldLoadMode::Borrow on a read-only / owner-retained
# extraction (devbook ch.13). Pure TYPED ownership + droppability test — no
# name matching. LoOwned and LoMaybeOwned both reach the owned whole-drop path
# (a merged-arm scrutinee is treated as an owner here, conservatively binding
# a borrow — sound because the whole-scrutinee drop still owns the free).
bool scrutinee_owned_whole_dropped(LowerCtx &ctx, GirModule &gmod, int lid):
    if lid < 0 or lid >= ctx.locals.len():
        return false
    GirLocal loc = ctx.locals.get(lid).unwrap()
    match loc.ownership:
        case LoOwned():
            pass
        case LoMaybeOwned():
            pass
        else:
            return false
    # Peel a Ptr/MutPtr wrapper (a borrowed-but-owned-pointee case is excluded
    # above by the ownership gate; this peel only matters for the rare LoOwned
    # value held behind a pointer slot) and test the underlying type.
    int tid = loc.type_id
    if tid >= 0 and tid < gmod.type_table.len():
        match gmod.type_table.get(tid).unwrap():
            case GtPtr(_):
                return false
            case GtMutPtr(_):
                return false
            else:
                pass
    return is_droppable_type(tid, &gmod)

# Map a collection element type name (as produced by collection_element_type)
# to a GIR type id. Mirrors the resolution chain in the EMethodCall unwrap
# path (lines ~2014-2042) — primitive C-level names first, named-type fallback
# second.
int resolve_elem_type_id(String elem_name, GirModule &gmod):
    int prim = prim_name_to_type(elem_name)
    if prim >= 0:
        return prim
    if elem_name == "int64_t":
        return I64_TYPE
    if elem_name == "int32_t":
        return I32_TYPE
    if elem_name == "int16_t":
        return I16_TYPE
    if elem_name == "int8_t":
        return I8_TYPE
    if elem_name == "uint64_t":
        return U64_TYPE
    if elem_name == "uint32_t":
        return U32_TYPE
    if elem_name == "uint16_t":
        return U16_TYPE
    if elem_name == "uint8_t":
        return U8_TYPE
    if elem_name == "double":
        return F64_TYPE
    if elem_name == "float":
        return F32_TYPE
    if elem_name == "Str":
        return lookup_or_register_named(&gmod, "GorgetString")
    return lookup_or_register_named(&gmod, elem_name)

void lower_while(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] body, GirModule &gmod, bool is_main):
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: evaluate condition
    switch_to(&ctx, header_bb)
    # The condition is bool-typed and independent of any enclosing
    # destination — clear `expected_type` around it so a leaked Result-typed
    # expectation doesn't make the centralized auto-prop hook's capture-form
    # check suppress a throws-call condition's peel (`while might():`).
    int saved_expected_wh = ctx.expected_type
    ctx.expected_type = -1
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    ctx.expected_type = saved_expected_wh
    # Auto-propagate a `throws` call used as the condition (`while might():`).
    cond = maybe_auto_propagate(&ctx, cond, &gmod)
    set_terminator(&ctx, GTBranch(OpCopy(cond), body_bb, exit_bb))
    # Body. Push loop targets so SBreak/SContinue know where to jump.
    ctx.loop_continue_stack.push(header_bb)
    ctx.loop_break_stack.push(exit_bb)
    # Phase 2: open a Loop drop scope around the body.
    push_drop_scope(&ctx.drop_elab, DSK_LOOP)
    switch_to(&ctx, body_bb)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(header_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    # Pop — targets only apply to this loop's direct body.
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    switch_to(&ctx, exit_bb)

# ── Function lowering ────────────────────────────────────

# Shared body-finalization core, factored out of `lower_function` (and
# reused verbatim by the closure-call synthesis in `lower_closure_body`,
# mirroring why Rust gg shares its single body path
# across normal functions and `emit_closure_call_function`). The boundary
# is: pop the function-scope drop frame → compute_liveness +
# liveness_instrumentation_diff/diag_warn → wire_liveness_into_modes →
# flush_drop_queue → assemble `ctx.block_insts`/`block_terms` into
# `Vector[BasicBlock]`. RETURNS the assembled blocks ONLY — the caller
# owns naming + constructing + pushing/returning its own GirFunction, and
# any caller-specific implicit-return synthesis (main's `return 0`, the
# closure's tail-value→_0 funnel) runs BEFORE this call. Skipping these
# post-passes leaves every consuming operand read at its DEFAULT mode →
# a SILENT MISCOMPILE (UAF / double-free) for any body that touches a
# resource, which is why this is mandatory shared reuse and not an inline
# partial copy. `fn_name` is threaded purely for the gir_liveness_diff
# diagnostic attribution (callers pass fdef.name / call_name / ic_call).
Vector[BasicBlock] finalize_body_blocks(LowerCtx &ctx, GirModule &gmod, String fn_name):
    # Pop the function-scope drop frame. If the natural exit was a
    # fall-through with no implicit-return synthesis, emit drops.
    # Otherwise the explicit return / break / continue / implicit-return
    # paths have already emitted theirs.
    pop_drop_scope(&ctx)

    # GIR-liveness — backward-dataflow liveness on the BB CFG, then the
    # CFG-aware operand-mode post-pass `wire_liveness_into_modes` which
    # decides OpMove vs OpClone at every consuming operand read. The
    # instrumentation diff vs the legacy linear pass is a regression net.
    LivenessAnalysis liveness = compute_liveness(&ctx)
    int diff = liveness_instrumentation_diff(&ctx, &liveness)
    if diff > 0:
        diag_warn("gir_liveness_diff", fn_name + ": " + int_to_str(diff) + " sites")
    wire_liveness_into_modes(&ctx, &gmod, &liveness)

    # Flush the deferred drop queue — `maybe_moved` is now populated by
    # `wire_liveness_into_modes`, so pending `GIDropIfAlive` records gate
    # correctly.
    flush_drop_queue(&ctx)

    # Assemble BasicBlocks from separate instruction and terminator vectors.
    Vector[BasicBlock] blocks = []
    int bi = 0
    while bi < ctx.block_insts.len():
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        Terminator term = ctx.block_terms.get(bi).unwrap()
        blocks.push(BasicBlock(insts, term))
        bi += 1
    return blocks

GirFunction lower_function(FunctionDef fdef, GirModule &gmod):
    bool is_main = fdef.name == "main"
    int ret_type = I64_TYPE
    if is_main:
        # Check if main has throws — if so, return Result__void__T
        match fdef.throws_type:
            case Some(throws_ty):
                int err_type = map_ast_type(throws_ty, &gmod)
                String err_c = type_id_to_name(err_type, &gmod)
                String result_name = "Result__void__" + err_c
                ret_type = lookup_or_register_named(&gmod, result_name)
                record_enum_category(&gmod, ret_type, ENUM_CAT_RESULT, UNIT_TYPE, err_type)
            case None:
                ret_type = I32_TYPE
    else:
        ret_type = map_fn_return_type(fdef.return_type, &gmod)
        # Wrap return type in Result[T, E] for throws functions
        match fdef.throws_type:
            case Some(throws_ty):
                int ok_payload = ret_type
                int err_type = map_ast_type(throws_ty, &gmod)
                String ret_c = type_id_to_name(ret_type, &gmod)
                String err_c = type_id_to_name(err_type, &gmod)
                String result_name = "Result__" + ret_c + "__" + err_c
                ret_type = lookup_or_register_named(&gmod, result_name)
                record_enum_category(&gmod, ret_type, ENUM_CAT_RESULT, ok_payload, err_type)
            case None:
                pass

    Vector[Instruction] init_insts = []
    Vector[Vector[Instruction]] block_insts = [!init_insts]
    Vector[Terminator] block_terms = [GTNone()]
    Vector[int] _lc_stk = []
    Vector[int] _lb_stk = []
    Dict[String, int] _named_locals = {}
    Vector[DropScope] _de_scopes = []
    Vector[DropEmission] _de_queue = []
    Vector[Vector[Stmt]] _on_err_blocks = []
    LowerCtx ctx = LowerCtx([], !block_insts, !block_terms, 0, !_named_locals, !_lc_stk, !_lb_stk, "", "", "", false, fdef.name.clone(), DropElaborator(!_de_scopes), !_de_queue, -1, !_on_err_blocks, false)

    # Push the function-scope drop frame. Pop emits GIDropIfAlive for
    # every owned resource local registered during lowering (param or
    # SVarDecl), unless the natural exit was an explicit GTReturn (in
    # which case SReturn's emit_drops_for_early_exit already emitted
    # them). See the DropElaborator section docstring.
    push_drop_scope(&ctx.drop_elab, DSK_FUNCTION)

    # _0 = return place
    add_local(&ctx, ret_type, NO_NAME)

    # _1.._N = params — non-primitive bare params become Ptr(T)
    Vector[int] param_types = []
    for p in fdef.params:
        int pt = map_ast_type(p.param_type, &gmod)
        # Bare params of resource types (strings, collections, structs with resource fields) → Ptr
        # Small types (enums, simple structs) are passed by value
        if p.ownership == 0 and pt >= PRIM_COUNT:
            String type_c_name = type_to_c_name(p.param_type, &gmod)
            if is_resource_type_name(type_c_name, &gmod):
                pt = register_ptr(&gmod, pt)
        # Mutable borrow (&) and move (!) params → MutPtr
        # OWN_MUTABLE=1, OWN_MOVE=2 in self-host parser
        if p.ownership == 1 or p.ownership == 2:
            pt = register_type(&gmod, GtMutPtr(pt))
        param_types.push(pt)
        int plid = add_local_with(&ctx, pt, Some(p.param_name.clone()), LoParam(), BoParam(-1))
        nl_put(&ctx, p.param_name, plid)
        # Phase 2 param drop registration: only bare-by-value resource
        # params (ownership==0 with the Ptr wrapping applied above) and
        # the inner Ptr() do NOT own the pointee — the caller does. So
        # we register the local for drop only when ownership==0 AND
        # the original (pre-Ptr-wrap) type is a resource. The wrapper
        # type is GtPtr(inner) — is_droppable_type returns false on
        # GtPtr — so we'd otherwise miss this. Pass the inner type to
        # register_local_for_drop instead.
        # FIXME: by-value owning params have ABI-controlled lifetime;
        # whether the callee drops vs. the caller drops depends on
        # the param ownership rules (`!` = callee, `&` = neither, bare
        # = caller for the boxed alias). For Phase 2 we keep the
        # registration conservative: only `!arg` (ownership==2) params
        # — the canonical "callee owns and must drop" shape — are
        # registered. `&arg` (ownership==1) and bare params are owned
        # by the caller.
        if p.ownership == 2:
            # `!arg` — callee owns the pointee. The slot here is a
            # MutPtr(T); register via the DEDICATED owning-param path
            # (Tier E §8.1): it derefs the GtMutPtr wrapper to gate on the
            # inner T's dropability AND sets owning_param=true so the
            # consume-mode (D) + GIDropIfAlive emission (C) treat the slot
            # as holding a `T*`. (`register_local_for_drop(pt)` was a silent
            # no-op — is_droppable_type rejects GtMutPtr — the original leak.)
            register_owning_param(&ctx, plid, pt, &gmod)



    # Lower body statements
    for stmt in fdef.body:
        lower_stmt(&ctx, stmt, &gmod, is_main)

    # If main and no explicit return, add return 0. The drop frame's
    # natural-exit emission needs to run BEFORE this: emit drops at
    # the natural fall-through point, then synthesise the implicit
    # `return 0`. Otherwise the GTReturn would close the block before
    # we get a chance to emit the drops.
    if is_main:
        Terminator last_term = ctx.block_terms.get(ctx.current_block).unwrap()
        match last_term:
            case GTNone():
                # Emit drops for the function scope FIRST (exclude _0
                # since the return value is being moved out).
                emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
                emit(&ctx, GIAssign(0, OpConstI32(0)))
                set_terminator(&ctx, GTReturn(OpConstI32(0)))
            else:
                pass

    # Finalize: pop the function-scope drop frame, run the GIR-liveness
    # + operand-mode post-pass + drop-queue flush, and assemble the
    # BasicBlocks. Shared verbatim with the closure-call synthesis — see
    # `finalize_body_blocks`. These post-passes are MANDATORY (they set
    # OpMove/OpClone modes + emit drops); skipping them is a silent
    # miscompile for any resource-touching body.
    Vector[BasicBlock] blocks = finalize_body_blocks(&ctx, &gmod, fdef.name)
    return GirFunction(fdef.name, param_types, ret_type, ctx.locals, !blocks)

# ── Trait name mangling ──────────────────────────────────

String mangle_prim_type(String name):
    match name:
        case "int":
            return "int64_t"
        case "float":
            return "double"
        case "bool":
            return "bool"
        case "String":
            return "GorgetString"
        else:
            return name

String mangle_trait_name(String raw):
    # Parse "TraitName[Type1, Type2]" → "TraitName__type1__type2"
    # Note: use contains() guard because find() returns 0 (not -1) when not found
    # due to sentinel-to-Option unwrap bug in the compiler.
    if not raw.contains("["):
        return raw
    int bracket = raw.index_of("[").unwrap()
    String base = raw.slice(0, bracket)
    String args_str = raw.slice(bracket + 1, raw.len() - 1)
    # Split args by ", " and mangle each
    String result = base
    int pos = 0
    String current = ""
    while pos < args_str.len():
        String ch = args_str.slice(pos, pos + 1)
        if ch == "," and pos + 1 < args_str.len():
            result = result + "__" + mangle_prim_type(current)
            current = ""
            pos = pos + 2
        else:
            current = current + ch
            pos = pos + 1
    if current.len() > 0:
        result = result + "__" + mangle_prim_type(current)
    return result

# ── Equip block lowering ─────────────────────────────────

# Predicate: is this trait name a built-in derive-generated trait?
# These traits use the short mangled form (Type__method) rather than the
# explicit form (Trait_for_Type__method). Centralises the check so adding
# a new built-in trait touches ONE place, not the 5 callsites that had
# identical inline boolean chains before this helper was extracted.
bool is_builtin_trait(String tname):
    if tname == "Equatable" or tname == "Displayable" or tname == "Cloneable":
        return true
    if tname == "Hashable" or tname == "Serializable" or tname == "Deserializable":
        return true
    if tname == "Ordinal" or tname == "Drop":
        return true
    if tname == "Add" or tname == "Sub" or tname == "Mul" or tname == "Div":
        return true
    if tname.starts_with("Iterator") or tname.starts_with("Iterable"):
        return true
    if tname.starts_with("Add[") or tname.starts_with("Sub["):
        return true
    if tname.starts_with("Mul[") or tname.starts_with("Div["):
        return true
    return false

# Predicate: is this an instance method (first param's TYPE is `TSelf()`)?
# FIDELITY Phase 4 — vtable globals carry one FuncAddr slot per INSTANCE
# trait method; static methods are not vtable slots. Mirrors Rust gg's
# `register_trait_types` has_self check (`src/ir/lowering/traits.rs:88-93`)
# and the inline pattern at lower_equip_block (`lower.gg:7603-7607`).
# Matches on the TYPE being `TSelf()`, NOT on `param_name == "self"`.
bool method_has_self(FunctionDef mdef):
    if mdef.params.len() == 0:
        return false
    Param first_p = mdef.params.get(0).unwrap()
    match first_p.param_type.ty:
        case TSelf():
            return true
        else:
            return false

void lower_equip_block(EquipBlock eqblk, GirModule &gmod):
    # Get the target type name
    String target_name = type_to_c_name(eqblk.target, &gmod)
    int target_tid = lookup_or_register_named(&gmod, target_name)
    int self_ptr_tid = register_ptr(&gmod, target_tid)

    for mdef in eqblk.methods:
        # Mangled name: Type__method or Trait_for_Type__method
        String mangled = target_name + "__" + mdef.name
        match eqblk.trait_name:
            case Some(tname):
                # Derive-generated traits use short form (Type__method)
                # Explicit trait impls use prefix (Trait_for_Type__method)
                bool is_derive = is_builtin_trait(tname)
                if not is_derive:
                    String mangled_trait = mangle_trait_name(tname)
                    mangled = mangled_trait + "_for_" + target_name + "__" + mdef.name
            case None:
                pass

        bool is_main = false
        int ret_type = map_fn_return_type(mdef.return_type, &gmod)

        Vector[int] _lc_stk2 = []
        Vector[int] _lb_stk2 = []
        Dict[String, int] _named_locals2 = {}
        Vector[DropScope] _de_scopes2 = []
        Vector[DropEmission] _de_queue2 = []
        Vector[Vector[Stmt]] _on_err_blocks2 = []
        LowerCtx ctx = LowerCtx([], [], [], 0, !_named_locals2, !_lc_stk2, !_lb_stk2, "", "", "", false, mangled.clone(), DropElaborator(!_de_scopes2), !_de_queue2, -1, !_on_err_blocks2, false)
        # bb0
        Vector[Instruction] init_insts = []
        ctx.block_insts.push(!init_insts)
        ctx.block_terms.push(GTNone())

        # Phase 2: open the function-scope drop frame.
        push_drop_scope(&ctx.drop_elab, DSK_FUNCTION)

        # _0 = return place
        add_local(&ctx, ret_type, NO_NAME)

        # Check if method has a self parameter
        bool has_self = false
        if mdef.params.len() > 0:
            Param first_p = mdef.params.get(0).unwrap()
            match first_p.param_type.ty:
                case TSelf():
                    has_self = true
                else:
                    pass

        # Check if this is an explicit (non-derive) trait impl
        bool is_explicit_trait = false
        match eqblk.trait_name:
            case Some(tname):
                bool is_derive_trait = is_builtin_trait(tname)
                if not is_derive_trait:
                    is_explicit_trait = true
            case None:
                pass

        Vector[int] param_types = []
        # For explicit trait impls (`equip X with T:`) the param type is
        # `*unit` (Rust vtable convention). Field access on `self`
        # then fails because `unit` has no fields — we recover the
        # concrete pointer type via a copy-aliased local. Defer the
        # alias addition until after the rest of the params so the
        # `local_to_slot[pci+1]` param→slot mapping in lir_lower
        # stays correct (params at locals 1..N).
        bool needs_concrete_self_alias = false
        int concrete_self_tid_saved = UNIT_TYPE
        int self_lid_saved = -1
        if has_self:
            # _1 = self — determine pointer type from ownership
            # self (bare) → *T, &self → *mut T, !self → *mut T
            int self_tid = self_ptr_tid
            int self_ownership = 0
            Param sp = mdef.params.get(0).unwrap()
            self_ownership = sp.ownership
            # OWN_MUTABLE=1 (&self), OWN_MOVE=2 (!self) → *mut T
            if self_ownership == 1 or self_ownership == 2:
                self_tid = register_type(&gmod, GtMutPtr(target_tid))
            # Explicit trait impls use *unit self (Rust convention)
            int concrete_self_tid = self_tid
            if is_explicit_trait:
                if self_ownership == 1 or self_ownership == 2:
                    self_tid = register_type(&gmod, GtMutPtr(UNIT_TYPE))
                else:
                    self_tid = register_ptr(&gmod, UNIT_TYPE)
            param_types.push(self_tid)
            int self_lid = add_local(&ctx, self_tid, Some("self_void"))
            if is_explicit_trait:
                # Defer alias creation; bind `self` to the alias once
                # all params have been added.
                needs_concrete_self_alias = true
                concrete_self_tid_saved = concrete_self_tid
                self_lid_saved = self_lid
            else:
                nl_put(&ctx, "self", self_lid)

        # _2.._N = explicit params (skip self — already added above)
        for p in mdef.params:
            # Skip self parameter
            match p.param_type.ty:
                case TSelf():
                    continue
                else:
                    pass
            int pt = map_ast_type(p.param_type, &gmod)
            # Bare params of resource types → Ptr
            if p.ownership == 0 and pt >= PRIM_COUNT:
                String type_c_name = type_to_c_name(p.param_type, &gmod)
                if is_resource_type_name(type_c_name, &gmod):
                    pt = register_ptr(&gmod, pt)
            if p.ownership == 1 or p.ownership == 2:
                pt = register_type(&gmod, GtMutPtr(pt))
            param_types.push(pt)
            int plid = add_local_with(&ctx, pt, Some(p.param_name.clone()), LoParam(), BoParam(-1))
            nl_put(&ctx, p.param_name, plid)
            # Phase 2: only !-sigil resource params are callee-owned
            # and must be dropped at function exit. Same rationale as
            # lower_function above — use the dedicated owning-param path
            # (Tier E §8.1) so the GtMutPtr wrapper is deref'd, the inner
            # T's dropability gates registration, and owning_param=true.
            if p.ownership == 2:
                register_owning_param(&ctx, plid, pt, &gmod)

        # Add the explicit-trait `self` concrete-cast alias here, AFTER
        # all params, so locals 1..N are pure params (lir_lower's
        # `local_to_slot[pci+1]` param→slot mapping requires this).
        # The alias's GIAssign goes into the entry block before any
        # body statements, so `self.field` accesses in the body see
        # the cast pointer.
        if needs_concrete_self_alias:
            int concrete_self_lid = add_local(&ctx, concrete_self_tid_saved, Some("self"))
            emit(&ctx, GIAssign(concrete_self_lid, OpCopy(self_lid_saved)))
            nl_put(&ctx, "self", concrete_self_lid)

        # Lower body
        lower_stmts(&ctx, mdef.body, &gmod, is_main)

        # Phase 2: pop function-scope drop frame. If body fell through
        # without an explicit return, this emits cleanup drops.
        pop_drop_scope(&ctx)

        # GIR-liveness Phase 2a (Path A part 1). Same wiring as
        # `lower_function` above — see `wire_liveness_into_modes`
        # docstring for the rewriter contract.
        LivenessAnalysis liveness2 = compute_liveness(&ctx)
        int diff2 = liveness_instrumentation_diff(&ctx, &liveness2)
        if diff2 > 0:
            diag_warn("gir_liveness_diff", mangled + ": " + int_to_str(diff2) + " sites")
        wire_liveness_into_modes(&ctx, &gmod, &liveness2)

        # Phase 2c COMMIT 3 Prereq C — flush the deferred drop
        # queue. See the matching call site in `lower_function`
        # for the architectural contract.
        flush_drop_queue(&ctx)

        # Assemble blocks
        Vector[BasicBlock] blocks = []
        int bi = 0
        while bi < ctx.block_insts.len():
            Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
            Terminator term = ctx.block_terms.get(bi).unwrap()
            blocks.push(BasicBlock(insts, term))
            bi += 1

        gmod.functions.push(GirFunction(mangled, !param_types, ret_type, ctx.locals, !blocks))

# ── Simple expression type inference ─────────────────────

int STRING_MARKER = -2

int guess_return_type(SpannedExpr sexpr, GirModule &gmod):
    match sexpr.expr:
        case EIntLiteral(_):
            return I64_TYPE
        case EFloatLiteral(_):
            return F64_TYPE
        case EBoolLiteral(_):
            return BOOL_TYPE
        case EStringLiteral(_, _):
            return STRING_MARKER
        case EFString(_, _):
            return STRING_MARKER
        case EBinaryOp(lhs_box, op, rhs_box):
            match op:
                case "==" | "!=" | "<" | "<=" | ">" | ">=" | "and" | "or":
                    return BOOL_TYPE
                else:
                    # Check for string concatenation or float arithmetic
                    # by inspecting the immediate operand expressions
                    match (*lhs_box).expr:
                        case EStringLiteral(_, _):
                            return STRING_MARKER
                        case EFloatLiteral(_):
                            return F64_TYPE
                        else:
                            pass
                    match (*rhs_box).expr:
                        case EStringLiteral(_, _):
                            return STRING_MARKER
                        case EFloatLiteral(_):
                            return F64_TYPE
                        else:
                            pass
                    return I64_TYPE
        case EUnaryOp(op, _):
            match op:
                case "not":
                    return BOOL_TYPE
                else:
                    return I64_TYPE
        case ENoneLiteral():
            return UNIT_TYPE
        case ECall(callee_box, args, targs):
            match (*callee_box).expr:
                case EIdentifier(fname):
                    if fname == "print" or fname == "pass":
                        return UNIT_TYPE
                    # Enum variant constructors: Some(x) → Option__T, Ok(x)/Error(x) → Result
                    if fname == "Some" and args.len() == 1:
                        SpannedExpr inner_arg = args.get(0).unwrap()
                        int inner_t = guess_return_type(inner_arg, &gmod)
                        if inner_t == STRING_MARKER:
                            inner_t = lookup_or_register_named(&gmod, "GorgetString")
                        String inner_name = type_id_to_name(inner_t, &gmod)
                        int gss_opt = lookup_or_register_named(&gmod, "Option__" + inner_name)
                        record_enum_category(&gmod, gss_opt, ENUM_CAT_OPTION, inner_t, -1)
                        return gss_opt
                    if fname == "None":
                        return UNIT_TYPE
                    if fname == "Ok" or fname == "Error":
                        # Result constructor — look at argument type to infer Result__T__E
                        if args.len() > 0:
                            SpannedExpr r_arg = args.get(0).unwrap()
                            int r_t = guess_return_type(r_arg, &gmod)
                            if r_t == STRING_MARKER:
                                r_t = lookup_or_register_named(&gmod, "GorgetString")
                            String r_name = type_id_to_name(r_t, &gmod)
                            # Can't fully infer Result__T__E from one variant,
                            # but return int64_t as a safe default
                            return I64_TYPE
                    # Look up return type from fn_sigs (also check call_redirects)
                    String call_name = fname
                    if targs.len() > 0:
                        call_name = compute_mangled_name(targs, fname)
                    if gmod.call_redirects.contains(call_name):
                        call_name = gmod.call_redirects.get(call_name).unwrap()
                    if gmod.fn_sigs.contains(call_name):
                        return gmod.fn_sigs.get(call_name).unwrap()
                else:
                    pass
        case EMethodCall(recv, mname, margs, _):
            # Known void methods
            if mname == "push" or mname == "set" or mname == "put" or mname == "clear" or mname == "pop" or mname == "sort" or mname == "append" or mname == "insert" or mname == "remove":
                return UNIT_TYPE
            # Known string-returning methods
            if mname == "upper" or mname == "lower" or mname == "trim" or mname == "strip" or mname == "replace" or mname == "slice" or mname == "join" or mname == "repeat" or mname == "to_string" or mname == "reverse" or mname == "format" or mname == "as_str" or mname == "display" or mname == "describe" or mname == "to_lower" or mname == "to_upper" or mname == "removeprefix" or mname == "removesuffix" or mname == "center" or mname == "ljust" or mname == "rjust" or mname == "zfill":
                return STRING_MARKER
            # Known int-returning methods
            if mname == "len" or mname == "find" or mname == "count" or mname == "hash" or mname == "index_of":
                return I64_TYPE
            # Known float-returning methods
            if mname == "measure" or mname == "abs" or mname == "sqrt":
                return F64_TYPE
            # Known bool-returning methods
            if mname == "contains" or mname == "starts_with" or mname == "ends_with" or mname == "is_empty" or mname == "has" or mname == "eq":
                return BOOL_TYPE
            # unwrap/unwrap_or: return type matches the receiver's inner type
            if mname == "unwrap" or mname == "unwrap_or":
                int recv_t = guess_return_type(*recv, &gmod)
                return recv_t
        case EIdentifier(name):
            # Look up from fn_sigs (could be a variable holding a closure)
            if gmod.fn_sigs.contains(name):
                return gmod.fn_sigs.get(name).unwrap()
        case EIf(_, then_body, _):
            # Use return type of last statement in then body
            if then_body.len() > 0:
                Stmt last = then_body.get(then_body.len() - 1).unwrap()
                match last:
                    case SExpr(inner_expr):
                        return guess_return_type(inner_expr, &gmod)
                    case SReturn(opt_ret):
                        match opt_ret:
                            case Some(ret_expr):
                                return guess_return_type(ret_expr, &gmod)
                            case None:
                                return UNIT_TYPE
                    else:
                        pass
        else:
            pass
    return I64_TYPE

# ── Closure scanning ─────────────────────────────────────

# Check if an expression tree contains the implicit `it` parameter.
# Unlike the parser's expr_contains_it (which only checks top-level to
# avoid borrow issues), this traverses owned values — safe to recurse.
bool expr_has_it(SpannedExpr sexpr):
    match sexpr.expr:
        case EIt():
            return true
        case EIdentifier(name):
            return name == "it"
        case EBinaryOp(lhs, _, rhs):
            return expr_has_it(*lhs) or expr_has_it(*rhs)
        case EUnaryOp(_, inner):
            return expr_has_it(*inner)
        case ECall(callee, args, _):
            if expr_has_it(*callee):
                return true
            for a in args:
                if expr_has_it(a):
                    return true
            return false
        case EMethodCall(obj, _, args, _):
            if expr_has_it(*obj):
                return true
            for a in args:
                if expr_has_it(a):
                    return true
            return false
        case EIf(cond, _, _):
            return expr_has_it(*cond)
        case EFString(_, fexprs):
            for fx in fexprs:
                if expr_has_it(fx):
                    return true
            return false
        else:
            return false

# ── Phase 1 closure-body lowering: free-var (capture) guard ──
#
# The closure post-pass (the `lifted_closures` drain in `lower_module`)
# synthesizes each `__Closure_N__call` function from the MODULE level — it
# has `&gmod` but NO enclosing-function local scope. So we CANNOT mirror
# Rust's POSITIVE free-var test (`collect_free_vars` consults
# `ctx.lookup_local`,
# `closures.rs:636` — "resolves to an OUTER local"; that outer scope does
# not exist here). The guard is therefore INVERTED: walk the closure body
# tracking the set of in-scope NON-capture names; a bare `EIdentifier`
# name is a CAPTURE iff it is NONE of:
#   1. a closure param (or the implicit `"it"`);
#   2. a body-local declared earlier in the body via SVarDecl / for-loop
#      pattern / match-arm pattern (tracked as we walk — mirrors Rust
#      `local_names.insert` on VarDecl, `closures.rs:730-744`; we also
#      track for/match pattern bindings, a strict superset, since those
#      ARE legitimately in scope inside the body and flagging them would
#      wrongly stub a Phase-1-valid closure);
#   3. module-resolvable via `&gmod` — ALL the categories `lower_expr`'s
#      EIdentifier chain resolves before the [bug] fallback:
#      const_decls, float_const_decls, fn_sigs, statics, none_decls,
#      and nullary enum variants.
# A body with ANY capture → Phase 1 leaves the STUB (Phase 2 handles
# captures/env). Phase 1 lowers ONLY non-capturing closure bodies. The
# walk does NOT descend into a NESTED closure's body (mirror Rust which
# skips `Expr::Closure` in the collector, `closures.rs:722-725`) — else
# an outer closure would see the inner closure's params as "captures".
#
# Scoping: sub-blocks (if/match/for/while bodies, match arms) recurse
# with a CLONED in-scope set so a binding introduced in one sub-block
# does NOT leak to a sibling (which could mask a real capture there).
# Within a linear statement sequence, SVarDecl bindings accumulate.

# True iff `name` resolves to a module-level entity (any category the
# EIdentifier arm of `lower_expr` handles before the [bug] fallback).
bool closure_ident_module_resolvable(String name, GirModule &gmod):
    if gmod.const_decls.contains(name):
        return true
    if gmod.float_const_decls.contains(name):
        return true
    if gmod.fn_sigs.contains(name):
        return true
    if static_contains(&gmod, name):
        return true
    if gmod.none_decls.contains(name):
        return true
    if enum_variant_parent(name, &gmod) != "":
        return true
    return false

# Collect the binding names introduced by a pattern (PBinding /
# PConstructor / PDotShorthand / PTuple / POr sub-patterns) into the
# in-scope set. PWildcard / PLiteral / PRest bind nothing.
void closure_collect_pattern_bindings(SpannedPattern sp, Dict[String, bool] &in_scope):
    match sp.pat:
        case PBinding(bname):
            in_scope.put(bname.clone(), true)
        case PConstructor(_, subs):
            for s in subs:
                closure_collect_pattern_bindings(s, &in_scope)
        case PDotShorthand(_, subs):
            for s in subs:
                closure_collect_pattern_bindings(s, &in_scope)
        case PTuple(subs):
            for s in subs:
                closure_collect_pattern_bindings(s, &in_scope)
        case POr(subs):
            for s in subs:
                closure_collect_pattern_bindings(s, &in_scope)
        else:
            pass

# Walk an expression; return true if it references any free variable
# (a capture) given the current in-scope name set. Does NOT descend into
# nested closures.
bool closure_expr_has_capture(SpannedExpr sexpr, Dict[String, bool] in_scope, GirModule &gmod):
    match sexpr.expr:
        case EIdentifier(name):
            if in_scope.contains(name):
                return false
            if closure_ident_module_resolvable(name, &gmod):
                return false
            return true
        case EBinaryOp(lhs, _, rhs):
            if closure_expr_has_capture(*lhs, in_scope, &gmod):
                return true
            return closure_expr_has_capture(*rhs, in_scope, &gmod)
        case EUnaryOp(_, inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case ECall(callee, args, _):
            if closure_expr_has_capture(*callee, in_scope, &gmod):
                return true
            for a in args:
                if closure_expr_has_capture(a, in_scope, &gmod):
                    return true
            return false
        case EMethodCall(obj, _, args, _):
            if closure_expr_has_capture(*obj, in_scope, &gmod):
                return true
            for a in args:
                if closure_expr_has_capture(a, in_scope, &gmod):
                    return true
            return false
        case EFieldAccess(obj, _):
            return closure_expr_has_capture(*obj, in_scope, &gmod)
        case EIndex(obj, idx):
            if closure_expr_has_capture(*obj, in_scope, &gmod):
                return true
            return closure_expr_has_capture(*idx, in_scope, &gmod)
        case ERange(lo_opt, hi_opt):
            match lo_opt:
                case Some(lo):
                    if closure_expr_has_capture(*lo, in_scope, &gmod):
                        return true
                case None:
                    pass
            match hi_opt:
                case Some(hi):
                    return closure_expr_has_capture(*hi, in_scope, &gmod)
                case None:
                    return false
        case EIf(cond, then_body, branches):
            if closure_expr_has_capture(*cond, in_scope, &gmod):
                return true
            if closure_stmts_have_capture(then_body, in_scope, &gmod):
                return true
            for eb in branches:
                match eb.condition:
                    case Some(ec):
                        if closure_expr_has_capture(ec, in_scope, &gmod):
                            return true
                    case None:
                        pass
                if closure_stmts_have_capture(eb.body, in_scope, &gmod):
                    return true
            return false
        case EMatch(scrut, arms):
            if closure_expr_has_capture(*scrut, in_scope, &gmod):
                return true
            for arm in arms:
                # Arm pattern bindings are in scope ONLY in that arm — clone
                # the set so they don't leak to a sibling arm.
                Dict[String, bool] arm_scope = in_scope.clone()
                closure_collect_pattern_bindings(arm.pattern, &arm_scope)
                match arm.guard:
                    case Some(g):
                        if closure_expr_has_capture(g, arm_scope, &gmod):
                            return true
                    case None:
                        pass
                if closure_stmts_have_capture(arm.body, arm_scope, &gmod):
                    return true
            return false
        case EArrayLiteral(elems):
            for e in elems:
                if closure_expr_has_capture(e, in_scope, &gmod):
                    return true
            return false
        case ETupleLiteral(elems):
            for e in elems:
                if closure_expr_has_capture(e, in_scope, &gmod):
                    return true
            return false
        case EDictLiteral(keys, vals):
            for k in keys:
                if closure_expr_has_capture(k, in_scope, &gmod):
                    return true
            for v in vals:
                if closure_expr_has_capture(v, in_scope, &gmod):
                    return true
            return false
        case EStructLiteral(_, _, field_vals):
            for fv in field_vals:
                if closure_expr_has_capture(fv, in_scope, &gmod):
                    return true
            return false
        case EDotShorthand(_, args):
            for a in args:
                if closure_expr_has_capture(a, in_scope, &gmod):
                    return true
            return false
        case ETry(inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EMove(inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EMutableBorrow(inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EDeref(inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EAs(inner, _):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EDefaultOp(lhs, rhs):
            if closure_expr_has_capture(*lhs, in_scope, &gmod):
                return true
            return closure_expr_has_capture(*rhs, in_scope, &gmod)
        case EAwait(inner):
            return closure_expr_has_capture(*inner, in_scope, &gmod)
        case EBlock(stmts):
            return closure_stmts_have_capture(stmts, in_scope, &gmod)
        case EDo(stmts):
            return closure_stmts_have_capture(stmts, in_scope, &gmod)
        case EFString(_, fexprs):
            for fx in fexprs:
                if closure_expr_has_capture(fx, in_scope, &gmod):
                    return true
            return false
        case ESelfExpr():
            # `self` is neither a param nor module-resolvable → a capture
            # (Phase 2 / env). Stub it.
            return true
        case EClosure(_, _):
            # Do NOT descend into a nested closure's body — it has its own
            # capture analysis. Conservatively treat the presence of a
            # nested closure as non-capturing here (the nested closure's
            # own make-site entry guards it); over-stubbing the OUTER one on
            # account of the inner's params would be wrong.
            return false
        case EImplicitClosure(_):
            return false
        else:
            # Literals (int/float/bool/string/char/none), EIt, comprehensions,
            # spawn, catch/rethrow, etc. — no bare free-var identifier to
            # capture at THIS node; conservative non-recursion is fine for
            # the literals, and the recursive forms above cover the shapes
            # the candidate fixtures use. Any unhandled compound shape errs
            # toward "no capture" → the body lowers; if it secretly held a
            # capture the EIdentifier [bug] fallback still fires loudly (no
            # silent collapse beyond the documented Phase-1 hazard, which
            # this guard is the primary defense against for the COMMON
            # shapes). Extend as new fixtures demand.
            return false

# Walk a statement; return true if it references any capture against the
# given in-scope set. Read-only on `in_scope` (the SVarDecl-binding
# accumulation across sequential statements lives in
# `closure_stmts_have_capture`). Nested scoped blocks (for/match/if/while
# bodies) recurse via `closure_stmts_have_capture`, which clones the set
# so their internal bindings don't leak to siblings; for/match additionally
# fold their pattern bindings into a cloned set before recursing.
bool closure_stmt_has_capture(Stmt stmt, Dict[String, bool] in_scope, GirModule &gmod):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            # The init is evaluated BEFORE the binding exists, so it is
            # checked against the current scope. (The binding is added to
            # the running scope by `closure_stmts_have_capture` for the
            # SUBSEQUENT sibling statements.)
            return closure_expr_has_capture(init, in_scope, &gmod)
        case SAssign(target, value):
            if closure_expr_has_capture(target, in_scope, &gmod):
                return true
            return closure_expr_has_capture(value, in_scope, &gmod)
        case SCompoundAssign(target, _, value):
            if closure_expr_has_capture(target, in_scope, &gmod):
                return true
            return closure_expr_has_capture(value, in_scope, &gmod)
        case SExpr(e):
            return closure_expr_has_capture(e, in_scope, &gmod)
        case SReturn(opt_e):
            match opt_e:
                case Some(e):
                    return closure_expr_has_capture(e, in_scope, &gmod)
                case None:
                    return false
        case SThrow(e):
            return closure_expr_has_capture(e, in_scope, &gmod)
        case SBreak(opt_e):
            match opt_e:
                case Some(e):
                    return closure_expr_has_capture(e, in_scope, &gmod)
                case None:
                    return false
        case SIf(cond, then_body, branches):
            if closure_expr_has_capture(cond, in_scope, &gmod):
                return true
            if closure_stmts_have_capture(then_body, in_scope, &gmod):
                return true
            for eb in branches:
                match eb.condition:
                    case Some(ec):
                        if closure_expr_has_capture(ec, in_scope, &gmod):
                            return true
                    case None:
                        pass
                if closure_stmts_have_capture(eb.body, in_scope, &gmod):
                    return true
            return false
        case SWhile(cond, body):
            if closure_expr_has_capture(cond, in_scope, &gmod):
                return true
            return closure_stmts_have_capture(body, in_scope, &gmod)
        case SLoop(body):
            return closure_stmts_have_capture(body, in_scope, &gmod)
        case SFor(pat, iter_expr, body, _, _):
            if closure_expr_has_capture(iter_expr, in_scope, &gmod):
                return true
            # Loop-pattern binding is in scope ONLY within the body — clone.
            Dict[String, bool] body_scope = in_scope.clone()
            closure_collect_pattern_bindings(pat, &body_scope)
            return closure_stmts_have_capture(body, body_scope, &gmod)
        case SMatch(scrut, arms):
            if closure_expr_has_capture(scrut, in_scope, &gmod):
                return true
            for arm in arms:
                Dict[String, bool] arm_scope = in_scope.clone()
                closure_collect_pattern_bindings(arm.pattern, &arm_scope)
                match arm.guard:
                    case Some(g):
                        if closure_expr_has_capture(g, arm_scope, &gmod):
                            return true
                    case None:
                        pass
                if closure_stmts_have_capture(arm.body, arm_scope, &gmod):
                    return true
            return false
        case SAssert(e, _):
            return closure_expr_has_capture(e, in_scope, &gmod)
        case SAssertReturn(e, _):
            return closure_expr_has_capture(e, in_scope, &gmod)
        else:
            # SPass / SContinue / meta forms / SItem / etc. — no free-var
            # identifier at this statement. (The candidate fixtures don't
            # use these inside a closure body.)
            return false

# Walk a statement list, threading a CLONED in-scope set (so bindings
# from this block don't leak to the caller's sibling scopes) seeded from
# `in_scope`, accumulating SVarDecl bindings left-to-right so later
# statements see earlier body-locals.
bool closure_stmts_have_capture(Vector[Stmt] stmts, Dict[String, bool] in_scope, GirModule &gmod):
    Dict[String, bool] scope = in_scope.clone()
    for stmt in stmts:
        if closure_stmt_has_capture(stmt, scope, &gmod):
            return true
        # Accumulate an SVarDecl binding into the running scope for the
        # SUBSEQUENT statements in THIS block.
        match stmt:
            case SVarDecl(_, vname, _, _, _, _):
                scope.put(vname.clone(), true)
            else:
                pass
    return false

# Phase-1 entry guard for the `Vector[Stmt]` (EClosure) body shape: build
# the param-name in-scope set, then check whether the body captures.
bool closure_body_captures(Vector[Param] params, Vector[Stmt] body, GirModule &gmod):
    Dict[String, bool] in_scope = {}
    for p in params:
        in_scope.put(p.param_name.clone(), true)
    return closure_stmts_have_capture(body, in_scope, &gmod)

# Phase-1 entry guard for the implicit-`it` (EImplicitClosure) body shape:
# the single implicit param is `"it"`.
bool implicit_closure_body_captures(SpannedExpr body, GirModule &gmod):
    Dict[String, bool] in_scope = {}
    in_scope.put("it", true)
    return closure_expr_has_capture(body, in_scope, &gmod)

# ── closure Phase 2 Step B: capture COLLECTOR + CLASSIFIER ───────────
#
# Built on the EXACT structure of the Phase-1 DETECTOR
# (`closure_*_has_capture`): the SAME capture-shaped criterion (a bare
# `EIdentifier` that is NOT a closure param / body-local / module-
# resolvable), the SAME lexical-scope discipline (cloned sub-block sets,
# SVarDecl/for-pattern/match-arm-pattern bindings, EIf-branch coverage),
# the SAME nested-closure skip. The ONLY difference is the leaf: instead
# of returning bool at a capture-shaped var, it CLASSIFIES it:
#   • a genuine outer LOCAL (`nl_contains`) → record a ClosureCapture
#     (deduped via `seen`), in walk order;
#   • capture-shaped but NOT an outer local (unresolvable / `self`) →
#     mark UNLIFTABLE (the safety net — Phase 1 would STUB here, 2a too).
# The accumulated `caps` vector ORDER is the single source of truth:
# env-field == struct-ctor-arg == body GIFieldLoad-index order.

# True iff `callee` is a bare-identifier FUNCTION reference (a builtin or
# top-level fn name), NOT a value capture. The discriminator: a bare
# `EIdentifier` that is neither in the closure's lexical `in_scope` set NOR
# an outer LOCAL (`nl_contains`) names something in the FUNCTION namespace
# (`print`, a top-level helper, an enum-variant ctor) — calling it captures
# nothing. A callee that IS an outer local (a captured closure value, `f()`)
# returns false here so the walk records it as a genuine capture.
bool cc_callee_is_free_fn(LowerCtx &ctx, SpannedExpr callee, Dict[String, bool] in_scope, GirModule &gmod):
    match callee.expr:
        case EIdentifier(name):
            if in_scope.contains(name):
                return false
            if nl_contains(&ctx, name):
                return false
            return true
        else:
            return false

# Classify a single capture-shaped free var (the EIdentifier leaf).
void cc_classify_ident(LowerCtx &ctx, String name, GirModule &gmod, CaptureCollector &cc):
    if nl_contains(&ctx, name):
        # A genuine outer LOCAL → record it (deduped). Walk order is
        # the single source of truth.
        if not cc.seen.contains(name):
            cc.seen.put(name.clone(), true)
            int cap_lid = nl_get(&ctx, name)
            int cap_tid = ctx.locals.get(cap_lid).unwrap().type_id
            cc.caps.push(ClosureCapture(name.clone(), cap_tid, cap_lid, CAP_BY_VALUE))
    else:
        # Capture-shaped but NOT an outer local (unresolvable) → STUB.
        cc.unliftable = true

# Walk an expression, recording captures against `in_scope`. Mirrors
# `closure_expr_has_capture` (does NOT descend into nested closures).
void cc_collect_expr(LowerCtx &ctx, SpannedExpr sexpr, Dict[String, bool] in_scope, GirModule &gmod, CaptureCollector &cc):
    match sexpr.expr:
        case EIdentifier(name):
            if in_scope.contains(name):
                return
            if closure_ident_module_resolvable(name, &gmod):
                return
            cc_classify_ident(&ctx, name, &gmod, &cc)
        case EBinaryOp(lhs, _, rhs):
            cc_collect_expr(&ctx, *lhs, in_scope, &gmod, &cc)
            cc_collect_expr(&ctx, *rhs, in_scope, &gmod, &cc)
        case EUnaryOp(_, inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case ECall(callee, args, _):
            # A bare-identifier CALLEE is a FUNCTION reference, not a value
            # capture — `print(s)` / `helper(x)` name a builtin/top-level fn
            # in the function namespace, NOT an outer local. Recursing into
            # it would mis-classify `print` (absent from fn_sigs/const/etc.)
            # as an UNLIFTABLE capture and STUB the whole closure. Only a
            # callee that IS an outer LOCAL is a genuine capture (calling a
            # captured closure value, `f()`); route THAT through the walk so
            # it's recorded. Mirrors Rust `collect_free_vars`, which resolves
            # call targets in the function namespace and never captures them.
            if not cc_callee_is_free_fn(&ctx, *callee, in_scope, &gmod):
                cc_collect_expr(&ctx, *callee, in_scope, &gmod, &cc)
            for a in args:
                cc_collect_expr(&ctx, a, in_scope, &gmod, &cc)
        case EMethodCall(obj, _, args, _):
            cc_collect_expr(&ctx, *obj, in_scope, &gmod, &cc)
            for a in args:
                cc_collect_expr(&ctx, a, in_scope, &gmod, &cc)
        case EFieldAccess(obj, _):
            cc_collect_expr(&ctx, *obj, in_scope, &gmod, &cc)
        case EIndex(obj, idx):
            cc_collect_expr(&ctx, *obj, in_scope, &gmod, &cc)
            cc_collect_expr(&ctx, *idx, in_scope, &gmod, &cc)
        case ERange(lo_opt, hi_opt):
            match lo_opt:
                case Some(lo):
                    cc_collect_expr(&ctx, *lo, in_scope, &gmod, &cc)
                case None:
                    pass
            match hi_opt:
                case Some(hi):
                    cc_collect_expr(&ctx, *hi, in_scope, &gmod, &cc)
                case None:
                    pass
        case EIf(cond, then_body, branches):
            cc_collect_expr(&ctx, *cond, in_scope, &gmod, &cc)
            cc_collect_stmts(&ctx, then_body, in_scope, &gmod, &cc)
            for eb in branches:
                match eb.condition:
                    case Some(ec):
                        cc_collect_expr(&ctx, ec, in_scope, &gmod, &cc)
                    case None:
                        pass
                cc_collect_stmts(&ctx, eb.body, in_scope, &gmod, &cc)
        case EMatch(scrut, arms):
            cc_collect_expr(&ctx, *scrut, in_scope, &gmod, &cc)
            for arm in arms:
                Dict[String, bool] arm_scope = in_scope.clone()
                closure_collect_pattern_bindings(arm.pattern, &arm_scope)
                match arm.guard:
                    case Some(g):
                        cc_collect_expr(&ctx, g, arm_scope, &gmod, &cc)
                    case None:
                        pass
                cc_collect_stmts(&ctx, arm.body, arm_scope, &gmod, &cc)
        case EArrayLiteral(elems):
            for e in elems:
                cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        case ETupleLiteral(elems):
            for e in elems:
                cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        case EDictLiteral(keys, vals):
            for k in keys:
                cc_collect_expr(&ctx, k, in_scope, &gmod, &cc)
            for vv in vals:
                cc_collect_expr(&ctx, vv, in_scope, &gmod, &cc)
        case EStructLiteral(_, _, field_vals):
            for fv in field_vals:
                cc_collect_expr(&ctx, fv, in_scope, &gmod, &cc)
        case EDotShorthand(_, args):
            for a in args:
                cc_collect_expr(&ctx, a, in_scope, &gmod, &cc)
        case ETry(inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EMove(inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EMutableBorrow(inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EDeref(inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EAs(inner, _):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EDefaultOp(lhs, rhs):
            cc_collect_expr(&ctx, *lhs, in_scope, &gmod, &cc)
            cc_collect_expr(&ctx, *rhs, in_scope, &gmod, &cc)
        case EAwait(inner):
            cc_collect_expr(&ctx, *inner, in_scope, &gmod, &cc)
        case EBlock(stmts):
            cc_collect_stmts(&ctx, stmts, in_scope, &gmod, &cc)
        case EDo(stmts):
            cc_collect_stmts(&ctx, stmts, in_scope, &gmod, &cc)
        case EFString(_, fexprs):
            for fx in fexprs:
                cc_collect_expr(&ctx, fx, in_scope, &gmod, &cc)
        case ESelfExpr():
            # `self` is capture-shaped but not an outer local → UNLIFTABLE
            # (2a targets don't capture self).
            cc.unliftable = true
        case EClosure(_, _):
            # Do NOT descend into a nested closure (mirror the detector +
            # Rust collector). The nested-closure guard (b/d) keeps the
            # whole outer closure stubbed anyway.
            pass
        case EImplicitClosure(_):
            pass
        else:
            pass

# Walk a statement, recording captures against `in_scope`. Mirrors
# `closure_stmt_has_capture`.
void cc_collect_stmt(LowerCtx &ctx, Stmt stmt, Dict[String, bool] in_scope, GirModule &gmod, CaptureCollector &cc):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            cc_collect_expr(&ctx, init, in_scope, &gmod, &cc)
        case SAssign(target, value):
            cc_collect_expr(&ctx, target, in_scope, &gmod, &cc)
            cc_collect_expr(&ctx, value, in_scope, &gmod, &cc)
        case SCompoundAssign(target, _, value):
            cc_collect_expr(&ctx, target, in_scope, &gmod, &cc)
            cc_collect_expr(&ctx, value, in_scope, &gmod, &cc)
        case SExpr(e):
            cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        case SReturn(opt_e):
            match opt_e:
                case Some(e):
                    cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
                case None:
                    pass
        case SThrow(e):
            cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        case SBreak(opt_e):
            match opt_e:
                case Some(e):
                    cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            cc_collect_expr(&ctx, cond, in_scope, &gmod, &cc)
            cc_collect_stmts(&ctx, then_body, in_scope, &gmod, &cc)
            for eb in branches:
                match eb.condition:
                    case Some(ec):
                        cc_collect_expr(&ctx, ec, in_scope, &gmod, &cc)
                    case None:
                        pass
                cc_collect_stmts(&ctx, eb.body, in_scope, &gmod, &cc)
        case SWhile(cond, body):
            cc_collect_expr(&ctx, cond, in_scope, &gmod, &cc)
            cc_collect_stmts(&ctx, body, in_scope, &gmod, &cc)
        case SLoop(body):
            cc_collect_stmts(&ctx, body, in_scope, &gmod, &cc)
        case SFor(pat, iter_expr, body, _, _):
            cc_collect_expr(&ctx, iter_expr, in_scope, &gmod, &cc)
            Dict[String, bool] body_scope = in_scope.clone()
            closure_collect_pattern_bindings(pat, &body_scope)
            cc_collect_stmts(&ctx, body, body_scope, &gmod, &cc)
        case SMatch(scrut, arms):
            cc_collect_expr(&ctx, scrut, in_scope, &gmod, &cc)
            for arm in arms:
                Dict[String, bool] arm_scope = in_scope.clone()
                closure_collect_pattern_bindings(arm.pattern, &arm_scope)
                match arm.guard:
                    case Some(g):
                        cc_collect_expr(&ctx, g, arm_scope, &gmod, &cc)
                    case None:
                        pass
                cc_collect_stmts(&ctx, arm.body, arm_scope, &gmod, &cc)
        case SAssert(e, _):
            cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        case SAssertReturn(e, _):
            cc_collect_expr(&ctx, e, in_scope, &gmod, &cc)
        else:
            pass

# Walk a statement list, threading a CLONED in-scope set and accumulating
# SVarDecl bindings left-to-right. Mirrors `closure_stmts_have_capture`.
void cc_collect_stmts(LowerCtx &ctx, Vector[Stmt] stmts, Dict[String, bool] in_scope, GirModule &gmod, CaptureCollector &cc):
    Dict[String, bool] scope = in_scope.clone()
    for stmt in stmts:
        cc_collect_stmt(&ctx, stmt, scope, &gmod, &cc)
        match stmt:
            case SVarDecl(_, vname, _, _, _, _):
                scope.put(vname.clone(), true)
            else:
                pass

# Entry point: collect the EClosure body's ByValue captures. Builds the
# param-name in-scope set, then walks. Returns the CaptureCollector (an
# ordered deduped capture list + the `unliftable` safety flag).
CaptureCollector collect_closure_captures(LowerCtx &ctx, Vector[Param] params, Vector[Stmt] body, GirModule &gmod):
    Dict[String, bool] in_scope = {}
    for p in params:
        in_scope.put(p.param_name.clone(), true)
    Vector[ClosureCapture] caps0 = []
    Dict[String, bool] seen0 = {}
    CaptureCollector cc = CaptureCollector(!caps0, !seen0, false)
    cc_collect_stmts(&ctx, body, in_scope, &gmod, &cc)
    return cc

# closure Phase 2 Step B: a closure body MUTATES a capture if it
# assigns / compound-assigns to a captured name. Block-bodies only
# (mirror Rust `detect_mutations`). Captures that are mutated → 2c, so
# the 2a guard keeps them STUBBED. Conservative: any assign whose target
# is a bare `EIdentifier` matching a capture name counts.
bool stmts_mutate_any(Vector[Stmt] stmts, Dict[String, bool] cap_names):
    for stmt in stmts:
        if stmt_mutates_any(stmt, cap_names):
            return true
    return false

bool expr_target_mutates_any(SpannedExpr target, Dict[String, bool] cap_names):
    match target.expr:
        case EIdentifier(name):
            return cap_names.contains(name)
        else:
            return false

bool stmt_mutates_any(Stmt stmt, Dict[String, bool] cap_names):
    match stmt:
        case SAssign(target, _):
            return expr_target_mutates_any(target, cap_names)
        case SCompoundAssign(target, _, _):
            return expr_target_mutates_any(target, cap_names)
        case SIf(_, then_body, branches):
            if stmts_mutate_any(then_body, cap_names):
                return true
            for eb in branches:
                if stmts_mutate_any(eb.body, cap_names):
                    return true
            return false
        case SWhile(_, body):
            return stmts_mutate_any(body, cap_names)
        case SLoop(body):
            return stmts_mutate_any(body, cap_names)
        case SFor(_, _, body, _, _):
            return stmts_mutate_any(body, cap_names)
        case SMatch(_, arms):
            for arm in arms:
                if stmts_mutate_any(arm.body, cap_names):
                    return true
            return false
        else:
            return false

# Phase-1 SAFETY guard, distinct from capture detection: a closure body
# that CONTAINS a nested `EClosure` keeps the STUB rather than being lowered.
# Nested closures are a Phase-2 concern (proper capture/env re-architecture).
# Note: under the Step-A make-site design the make-site is the SOLE closure-id
# source (`gmod_next_closure_id`), so lowering a nested closure during the
# post-pass drain does NOT desync ids — the nested closure takes a fresh cid
# and is appended to `lifted_closures` (drain-until-empty picks it up). The
# guard is retained because (a) Step B (captures/env) isn't landed, and (b) a
# nested closure inside a STUBBED outer (whose body is never lowered) would
# otherwise be lost (§5a′ in the Step-A brief). No current candidate fixture
# nests closures inside a stubbed outer, so this stays belt-and-braces.
bool expr_has_nested_closure(SpannedExpr sexpr):
    match sexpr.expr:
        case EClosure(_, _):
            return true
        case EBinaryOp(lhs, _, rhs):
            return expr_has_nested_closure(*lhs) or expr_has_nested_closure(*rhs)
        case EUnaryOp(_, inner):
            return expr_has_nested_closure(*inner)
        case ECall(callee, args, _):
            if expr_has_nested_closure(*callee):
                return true
            for a in args:
                if expr_has_nested_closure(a):
                    return true
            return false
        case EMethodCall(obj, _, args, _):
            if expr_has_nested_closure(*obj):
                return true
            for a in args:
                if expr_has_nested_closure(a):
                    return true
            return false
        case EFieldAccess(obj, _):
            return expr_has_nested_closure(*obj)
        case EIndex(obj, idx):
            return expr_has_nested_closure(*obj) or expr_has_nested_closure(*idx)
        case ERange(lo_opt, hi_opt):
            match lo_opt:
                case Some(lo):
                    if expr_has_nested_closure(*lo):
                        return true
                case None:
                    pass
            match hi_opt:
                case Some(hi):
                    return expr_has_nested_closure(*hi)
                case None:
                    return false
        case EIf(cond, then_body, branches):
            if expr_has_nested_closure(*cond):
                return true
            if stmts_have_nested_closure(then_body):
                return true
            for eb in branches:
                if stmts_have_nested_closure(eb.body):
                    return true
            return false
        case EMatch(scrut, arms):
            if expr_has_nested_closure(*scrut):
                return true
            for arm in arms:
                if stmts_have_nested_closure(arm.body):
                    return true
            return false
        case EArrayLiteral(elems):
            for e in elems:
                if expr_has_nested_closure(e):
                    return true
            return false
        case ETupleLiteral(elems):
            for e in elems:
                if expr_has_nested_closure(e):
                    return true
            return false
        case EDictLiteral(keys, vals):
            for k in keys:
                if expr_has_nested_closure(k):
                    return true
            for v in vals:
                if expr_has_nested_closure(v):
                    return true
            return false
        case EStructLiteral(_, _, field_vals):
            for fv in field_vals:
                if expr_has_nested_closure(fv):
                    return true
            return false
        case EDotShorthand(_, args):
            for a in args:
                if expr_has_nested_closure(a):
                    return true
            return false
        case ETry(inner):
            return expr_has_nested_closure(*inner)
        case EMove(inner):
            return expr_has_nested_closure(*inner)
        case EMutableBorrow(inner):
            return expr_has_nested_closure(*inner)
        case EDeref(inner):
            return expr_has_nested_closure(*inner)
        case EAs(inner, _):
            return expr_has_nested_closure(*inner)
        case EDefaultOp(lhs, rhs):
            return expr_has_nested_closure(*lhs) or expr_has_nested_closure(*rhs)
        case EAwait(inner):
            return expr_has_nested_closure(*inner)
        case EBlock(stmts):
            return stmts_have_nested_closure(stmts)
        case EDo(stmts):
            return stmts_have_nested_closure(stmts)
        case EFString(_, fexprs):
            for fx in fexprs:
                if expr_has_nested_closure(fx):
                    return true
            return false
        else:
            return false

bool stmt_has_nested_closure(Stmt stmt):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            return expr_has_nested_closure(init)
        case SAssign(target, value):
            return expr_has_nested_closure(target) or expr_has_nested_closure(value)
        case SCompoundAssign(target, _, value):
            return expr_has_nested_closure(target) or expr_has_nested_closure(value)
        case SExpr(e):
            return expr_has_nested_closure(e)
        case SReturn(opt_e):
            match opt_e:
                case Some(e):
                    return expr_has_nested_closure(e)
                case None:
                    return false
        case SThrow(e):
            return expr_has_nested_closure(e)
        case SBreak(opt_e):
            match opt_e:
                case Some(e):
                    return expr_has_nested_closure(e)
                case None:
                    return false
        case SIf(cond, then_body, branches):
            if expr_has_nested_closure(cond):
                return true
            if stmts_have_nested_closure(then_body):
                return true
            for eb in branches:
                if stmts_have_nested_closure(eb.body):
                    return true
            return false
        case SWhile(cond, body):
            return expr_has_nested_closure(cond) or stmts_have_nested_closure(body)
        case SLoop(body):
            return stmts_have_nested_closure(body)
        case SFor(_, iter_expr, body, _, _):
            return expr_has_nested_closure(iter_expr) or stmts_have_nested_closure(body)
        case SMatch(scrut, arms):
            if expr_has_nested_closure(scrut):
                return true
            for arm in arms:
                if stmts_have_nested_closure(arm.body):
                    return true
            return false
        case SAssert(e, _):
            return expr_has_nested_closure(e)
        case SAssertReturn(e, _):
            return expr_has_nested_closure(e)
        else:
            return false

bool stmts_have_nested_closure(Vector[Stmt] stmts):
    for stmt in stmts:
        if stmt_has_nested_closure(stmt):
            return true
    return false

# ── closure Phase 2 Step A: make-site signature computation ──
#
# Compute the full closure signature for an EXPLICIT closure (`(p…): body`),
# lifting the EXACT logic the deleted `scan_expr_for_closures` EClosure arm
# used (env-type+self_ptr, param-type mapping, return-type inference incl.
# the float-param + multi-stmt-void heuristics + STRING_MARKER resolve).
# Takes `cid` because `self_ptr` is derived from the env type `__Closure_<cid>`.
# The make-site and the post-pass both store/read these via a LiftedClosure
# record, so the recorded sig == what `lower_closure_body` expects.
ClosureSig compute_closure_sig(int cid, Vector[Param] params, Vector[Stmt] body, GirModule &gmod):
    String closure_name = "__Closure_" + int_to_str(cid)
    int closure_tid = lookup_or_register_named(&gmod, closure_name)
    int self_ptr = register_ptr(&gmod, closure_tid)

    # Build ABI param types: *__Closure_N + explicit params; and the
    # closure's OWN param types/names in parallel.
    Vector[int] abi_param_types = [self_ptr]
    Vector[int] body_param_types = []
    Vector[String] body_param_names = []
    for p in params:
        int pt = map_ast_type(p.param_type, &gmod)
        abi_param_types.push(pt)
        body_param_types.push(pt)
        body_param_names.push(p.param_name.clone())

    # Infer return type from body (verbatim from the old scan).
    int ret_type = I64_TYPE
    if body.len() > 0:
        Stmt last_stmt = body.get(body.len() - 1).unwrap()
        match last_stmt:
            case SReturn(opt_expr):
                match opt_expr:
                    case Some(rexpr):
                        ret_type = guess_return_type(rexpr, &gmod)
                    case None:
                        ret_type = UNIT_TYPE
            case SExpr(expr):
                ret_type = guess_return_type(expr, &gmod)
            else:
                ret_type = UNIT_TYPE
    # Single-param float-only closure → float return.
    if ret_type == I64_TYPE and abi_param_types.len() == 2:
        int only_pt = abi_param_types.get(1).unwrap()
        if only_pt == F64_TYPE:
            ret_type = F64_TYPE
    # Multi-statement body with non-expr/non-return last stmt → void.
    if body.len() > 1 and ret_type == I64_TYPE:
        Stmt last = body.get(body.len() - 1).unwrap()
        match last:
            case SExpr(_):
                pass
            case SReturn(_):
                pass
            else:
                ret_type = UNIT_TYPE
    if ret_type == STRING_MARKER:
        ret_type = lookup_or_register_named(&gmod, "GorgetString")

    return ClosureSig(!abi_param_types, self_ptr, !body_param_types, !body_param_names, ret_type)

# closure Phase 2 Step A: signature for an IMPLICIT `it` closure
# (`EImplicitClosure` / `.map(it*2)`), lifting the `emit_it_closure` shape:
# a single implicit `it` param typed I64, return inferred by guess_return_type.
ClosureSig compute_implicit_closure_sig(int cid, SpannedExpr body, GirModule &gmod):
    String closure_name = "__Closure_" + int_to_str(cid)
    int closure_tid = lookup_or_register_named(&gmod, closure_name)
    int self_ptr = register_ptr(&gmod, closure_tid)
    Vector[int] abi_param_types = [self_ptr, I64_TYPE]
    Vector[int] body_param_types = [I64_TYPE]
    Vector[String] body_param_names = ["it"]
    int ret_type = guess_return_type(body, &gmod)
    if ret_type == STRING_MARKER:
        ret_type = lookup_or_register_named(&gmod, "GorgetString")
    return ClosureSig(!abi_param_types, self_ptr, !body_param_types, !body_param_names, ret_type)

# closure Phase 2 Step A: record an implicit `it` closure whose BODY is
# `ic_body` (a raw arg expression containing `it`, e.g. `it*2` in
# `.map(it*2)`), emit its GorgetClosure value, and return the value local.
# Shared by lower_expr's EImplicitClosure arm AND the call/method-call arg
# loops (which detect a raw `it` via expr_has_it — the OLD scan handled both
# the same way via emit_it_closure). The post-pass pushes its
# __Closure_<cid>__call by draining the record.
int record_implicit_it_closure(LowerCtx &ctx, SpannedExpr ic_body, GirModule &gmod):
    int ic_cid = gmod_next_closure_id(&gmod)
    String ic_closure_name = "__Closure_" + int_to_str(ic_cid)
    int ic_gc_tid = lookup_or_register_named(&gmod, "GorgetClosure")
    String ic_make_fn = "__make_closure_" + int_to_str(ic_cid)
    int ic_cdst = add_local(&ctx, ic_gc_tid, NO_NAME)
    Vector[Operand] ic_make_args = []
    gmod.fn_sigs.put(ic_make_fn, ic_gc_tid)
    emit(&ctx, GICallExtern(ic_cdst, ic_make_fn, ic_make_args))
    ClosureSig ic_sig = compute_implicit_closure_sig(ic_cid, ic_body, &gmod)
    # Lowerable guard byte-identical to the old scan's implicit-it guard:
    # non-capturing AND nests no closure.
    bool ic_lowerable = not (implicit_closure_body_captures(ic_body, &gmod) or expr_has_nested_closure(ic_body))
    Vector[Stmt] ic_body_stmts = [SExpr(ic_body)]
    # implicit-it closures: capture support is DEFERRED (stay stubbed-if-
    # capturing). Pass empty captures.
    Vector[ClosureCapture] ic_no_caps = []
    gmod.lifted_closures.push(LiftedClosure(ic_cid, ic_closure_name + "__call", ic_sig.self_ptr, ic_sig.abi_param_types, ic_sig.body_param_types, ic_sig.body_param_names, ic_sig.return_type, ic_body_stmts, true, ic_lowerable, !ic_no_caps))
    return ic_cdst

# ── Phase 1 closure-body lowering: fresh-ctx body lowering ──
#
# Lower a NON-CAPTURING closure body into a real `Vector[BasicBlock]` for
# the synthesized `__Closure_N__call` function, then CONSTRUCT and PUSH
# the `GirFunction`. Mirrors Rust gg's `emit_closure_call_function`
# (`closures.rs:349`): a fresh LowerCtx, local 0 = return place, local 1 =
# env `void*`/`*__Closure_N` ptr (present for the `__callable_N` ABI,
# UNUSED in Phase 1 — no captures), locals 2..N+1 = the closure's declared
# params by name, `expected_type` = the closure's return type, lower the
# body, funnel the tail value into `_0`, then run the SHARED
# `finalize_body_blocks` post-passes and emit `GirFunction(call_name,
# abi_param_types, ret_type, cctx.locals, blocks)`.
#
# The GirFunction's locals MUST be `cctx.locals` (which includes _0, the
# env ptr, the named params, AND every body temp the lowering allocated) —
# building a separate hand-rolled locals vector would omit the body temps
# and the blocks would reference undefined locals. So this helper owns the
# construction (the locals only exist inside `cctx`).
#
# `abi_param_types` is the FULL param-type list (env ptr first, then the
# closure params), matching the registered `__Closure_N__call` signature.
# `param_types_in` / `param_names_in` are the closure's OWN params (NOT
# including the env ptr — this fn registers the env ptr as local _1 itself).
# `body_stmts` is the body as a Vector[Stmt] (an expr-body closure passes a
# single `[SExpr(expr)]`). `self_ptr` is the registered `*__Closure_N` type.
void lower_closure_body(String call_name, Vector[int] !abi_param_types, int self_ptr, Vector[int] param_types_in, Vector[String] param_names_in, int ret_type, Vector[Stmt] body_stmts, Vector[ClosureCapture] captures, GirModule &gmod):
    Vector[Instruction] cinit = []
    Vector[Vector[Instruction]] cblock_insts = [!cinit]
    Vector[Terminator] cblock_terms = [GTNone()]
    Vector[int] _clc = []
    Vector[int] _clb = []
    Dict[String, int] _cnamed = {}
    Vector[DropScope] _cde_scopes = []
    Vector[DropEmission] _cde_queue = []
    Vector[Vector[Stmt]] _con_err = []
    LowerCtx cctx = LowerCtx([], !cblock_insts, !cblock_terms, 0, !_cnamed, !_clc, !_clb, "", "", "", false, call_name.clone(), DropElaborator(!_cde_scopes), !_cde_queue, ret_type, !_con_err, false)

    push_drop_scope(&cctx.drop_elab, DSK_FUNCTION)

    # _0 = return place
    add_local(&cctx, ret_type, NO_NAME)
    # _1 = env ptr (the `*__Closure_N` self/env pointer) — the env-field
    # base for Step-B capture loads (GIFieldLoad(fdst, _1, idx)).
    add_local_with(&cctx, self_ptr, NO_NAME, LoParam(), BoParam(-1))
    # _2.._N+1 = the closure's declared params, by name.
    int pi = 0
    while pi < param_types_in.len():
        int pt = param_types_in.get(pi).unwrap()
        String pname = param_names_in.get(pi).unwrap()
        int plid = add_local_with(&cctx, pt, Some(pname.clone()), LoParam(), BoParam(-1))
        nl_put(&cctx, pname, plid)
        pi = pi + 1

    # ── Step B (§4e): field-load each ByValue capture from the env BEFORE
    # lowering the body, binding cap.name → the loaded value local so a bare
    # EIdentifier(cap.name) in the body resolves to the load (NOT the [bug]
    # EIdentifier fallback). Capture vector ORDER == env-field / GIFieldLoad
    # index order (the single source of truth, set at the make-site). The
    # env base is local _1. 2a captures are value-typed primitives →
    # GIFieldLoad's byte-copy path. Mirrors Rust `emit_closure_call_function`.
    int ci = 0
    while ci < captures.len():
        ClosureCapture cap = captures.get(ci).unwrap()
        # §4e-2 (Phase 2b): RESOURCE captures (String/Vector/resource-struct)
        # load as a Ptr-ALIAS into the env's storage, NOT a value byte-copy.
        # Mirrors Rust `emit_closure_call_function` (closures.rs:395-411) and
        # the EFieldAccess resource-field path (lower.gg:~6119-6125): the env
        # OWNS the snapshot across calls; the body reads THROUGH a borrow, and
        # op_consume auto-clones at any owning boundary (call args / returns /
        # field-init). A VALUE field-load here would byte-copy the owned
        # String/Vector struct out of the env — the loaded local would then
        # alias the env's heap buffer and a double-free follows if either side
        # frees it. The Ptr-alias + LoBorrowed + set_field_borrow shape is the
        # same one EFieldAccess uses for owned-base struct fields. Primitive /
        # COPY-struct captures keep the value byte-copy (sound, no heap).
        String cap_tname = type_id_to_name(cap.type_id, &gmod)
        int fdst = -1
        if is_resource_type_name(cap_tname, &gmod):
            # Deref a Ptr-typed CoW-alias capture to its OWNED pointee T —
            # matching Site-3's env-field type — BEFORE register_ptr, so the
            # body-load dst is `Ptr(T)`, NOT `Ptr(Ptr(T))`. SVarDecl Branch C
            # retypes a CoW alias (`Vector[int] snap = nums`) to `Ptr(T)`;
            # without this deref `register_ptr(Ptr(T))=Ptr(Ptr(T))`, and an
            # OWNING body consume of the capture would hit decide_ptr_consume's
            # OpCopy-of-pointer arm (alias / dormant double-free) instead of
            # OpClone. Value-typed captures (fresh literal / `.clone()`) are
            # unaffected (no GtPtr → cap_value_tid == cap.type_id). Keeps
            # Site-3 (field=T) and Site-4 (body-load=Ptr(T)) consistent.
            int cap_value_tid = cap.type_id
            if cap_value_tid >= 0 and cap_value_tid < gmod.type_table.len():
                match gmod.type_table.get(cap_value_tid).unwrap():
                    case GtPtr(cap_pointee):
                        cap_value_tid = cap_pointee
                    case GtMutPtr(cap_pointee2):
                        cap_value_tid = cap_pointee2
                    else:
                        pass
            int cap_ptr_tid = register_ptr(&gmod, cap_value_tid)
            fdst = add_local_with(&cctx, cap_ptr_tid, Some(cap.name.clone()), LoBorrowed(), BoNone())
            set_field_borrow(&cctx, fdst, 1, ci)
        else:
            fdst = add_local(&cctx, cap.type_id, Some(cap.name.clone()))
        emit(&cctx, GIFieldLoad(fdst, 1, ci))
        nl_put(&cctx, cap.name, fdst)
        ci = ci + 1

    # Lower the body as an expression block; funnel its tail value into the
    # return place `_0`, then terminate with `return _0` — mirrors how
    # `lower_function` finalizes a normal function's return value.
    int tail = lower_block_expr(&cctx, body_stmts, &gmod)
    if not block_terminated(&cctx):
        emit(&cctx, GIAssign(0, op_consume(&cctx, &gmod, tail, CkReturn())))
        set_terminator(&cctx, GTReturn(op_consume(&cctx, &gmod, 0, CkReturn())))

    Vector[BasicBlock] cblocks = finalize_body_blocks(&cctx, &gmod, call_name)
    gmod.functions.push(GirFunction(call_name, !abi_param_types, ret_type, cctx.locals, !cblocks))

# ── Generic monomorphization ─────────────────────────────

struct GenericInstance:
    String base_name
    Vector[SpannedType] type_args
    String mangled_name

# Expand generic calls inside meta for bodies to the 4 standard types.
# meta for T in type_variants(...): generates code for int, float, String, bool.
void expand_meta_for_generics(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    # Standard column types that type_variants typically expands to.
    # Deliberately excludes 'bool' — variant_payloads() expands to enum payload
    # types (typically int/float/String), not bool.  Adding bool causes spurious
    # monomorphizations for fixtures like meta_variant_payloads.
    Vector[SpannedType] std_types = []
    std_types.push(SpannedType(TPrimitive("int"), -1))
    std_types.push(SpannedType(TPrimitive("float"), -1))
    std_types.push(SpannedType(TPrimitive("String"), -1))
    # Scan for generic calls with type variable args
    for stmt in stmts:
        expand_meta_for_stmt(stmt, &seen, &instances, std_types)

void expand_meta_for_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            expand_meta_for_expr(init, &seen, &instances, std_types)
        case SExpr(expr):
            expand_meta_for_expr(expr, &seen, &instances, std_types)
        case SReturn(opt):
            match opt:
                case Some(expr):
                    expand_meta_for_expr(expr, &seen, &instances, std_types)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            expand_meta_for_expr(cond, &seen, &instances, std_types)
            for ts in then_body:
                expand_meta_for_stmt(ts, &seen, &instances, std_types)
            for eb in branches:
                for ebs in eb.body:
                    expand_meta_for_stmt(ebs, &seen, &instances, std_types)
        case SMatch(scrutinee, arms):
            expand_meta_for_expr(scrutinee, &seen, &instances, std_types)
            for arm in arms:
                for abs in arm.body:
                    expand_meta_for_stmt(abs, &seen, &instances, std_types)
        else:
            pass

void expand_meta_for_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types):
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and has_type_variable(targs):
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        # Expand each type variable to the 4 standard types
                        int ti = 0
                        while ti < std_types.len():
                            SpannedType concrete = std_types.get(ti).unwrap()
                            Vector[SpannedType] expanded = []
                            int tai = 0
                            while tai < targs.len():
                                SpannedType ta = targs.get(tai).unwrap()
                                bool is_var = false
                                match ta.ty:
                                    case TNamed(n, inner):
                                        if inner.len() == 0 and n.len() <= 2:
                                            is_var = true
                                    else:
                                        pass
                                if is_var:
                                    expanded.push(concrete.clone())
                                else:
                                    expanded.push(ta)
                                tai += 1
                            String mangled = compute_mangled_name(expanded, fname)
                            if not seen.contains(mangled):
                                seen.put(mangled.clone(), true)
                                instances.push(GenericInstance(fname.clone(), !expanded, mangled))
                            ti += 1
                    else:
                        pass
            for arg in args:
                expand_meta_for_expr(arg, &seen, &instances, std_types)
        case EMethodCall(obj, _, margs, _):
            expand_meta_for_expr(*obj, &seen, &instances, std_types)
            for ma in margs:
                expand_meta_for_expr(ma, &seen, &instances, std_types)
        else:
            pass

# Discover generic call sites in an expression
void discover_generic_calls_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and not has_type_variable(targs):
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        String mangled = compute_mangled_name(targs, fname)
                        if not seen.contains(mangled):
                            seen.put(mangled.clone(), true)
                            GenericInstance gi = GenericInstance(fname, targs, mangled)
                            instances.push(!gi)
                    else:
                        pass
            # Recurse into call args
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances)
            discover_generic_calls_expr(*callee_box, &seen, &instances)
        case EMethodCall(obj, _, args, _):
            discover_generic_calls_expr(*obj, &seen, &instances)
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances)
        case EBinaryOp(lhs, _, rhs):
            discover_generic_calls_expr(*lhs, &seen, &instances)
            discover_generic_calls_expr(*rhs, &seen, &instances)
        case EUnaryOp(_, inner):
            discover_generic_calls_expr(*inner, &seen, &instances)
        case EIf(cond, then_body, branches):
            discover_generic_calls_expr(*cond, &seen, &instances)
            discover_generic_calls_stmts(then_body, &seen, &instances)
        case EFieldAccess(obj, _):
            discover_generic_calls_expr(*obj, &seen, &instances)
        case EIndex(obj, idx):
            discover_generic_calls_expr(*obj, &seen, &instances)
            discover_generic_calls_expr(*idx, &seen, &instances)
        case EClosure(_, body):
            discover_generic_calls_stmts(body, &seen, &instances)
        case EFString(_, fexprs):
            for fx in fexprs:
                discover_generic_calls_expr(fx, &seen, &instances)
        else:
            pass

void discover_generic_calls_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    match stmt:
        case SVarDecl(stype, _, init, _, _, _):
            # Also discover type instances from type annotations (e.g., Stack[int] s = ...)
            match stype.ty:
                case TNamed(tname, targs):
                    if targs.len() > 0 and not has_type_variable(targs):
                        String mangled = compute_mangled_name(targs, tname)
                        if not seen.contains(mangled):
                            seen.put(mangled.clone(), true)
                            GenericInstance gi = GenericInstance(tname, targs, mangled)
                            instances.push(!gi)
                else:
                    pass
            discover_generic_calls_expr(init, &seen, &instances)
        case SAssign(target, value):
            discover_generic_calls_expr(target, &seen, &instances)
            discover_generic_calls_expr(value, &seen, &instances)
        case SExpr(expr):
            discover_generic_calls_expr(expr, &seen, &instances)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    discover_generic_calls_expr(expr, &seen, &instances)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            discover_generic_calls_expr(cond, &seen, &instances)
            discover_generic_calls_stmts(then_body, &seen, &instances)
            for eb in branches:
                match eb.condition:
                    case Some(elif_cond):
                        discover_generic_calls_expr(elif_cond, &seen, &instances)
                    case None:
                        pass
                discover_generic_calls_stmts(eb.body, &seen, &instances)
        case SWhile(cond, body):
            discover_generic_calls_expr(cond, &seen, &instances)
            discover_generic_calls_stmts(body, &seen, &instances)
        case SFor(_, iter_expr, body, _, _):
            discover_generic_calls_expr(iter_expr, &seen, &instances)
            discover_generic_calls_stmts(body, &seen, &instances)
        case SMatch(scrutinee, arms):
            discover_generic_calls_expr(scrutinee, &seen, &instances)
            for arm in arms:
                discover_generic_calls_stmts(arm.body, &seen, &instances)
        case SMetaFor(meta_body):
            # Meta for type_variants: expand type-variable generic calls
            # to the 4 standard column types (int, float, String, bool).
            # The meta for header is lost, so we heuristically expand
            # any generic call with a type variable arg.
            expand_meta_for_generics(meta_body, &seen, &instances)
        else:
            pass

void discover_generic_calls_stmts(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    for stmt in stmts:
        discover_generic_calls_stmt(stmt, &seen, &instances)

# Lightweight type-to-C-name without GirModule (used during discovery before gmod exists)
String spanned_type_to_c_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            int pt = prim_name_to_type(name)
            if pt >= 0:
                return spanned_type_to_c_name(SpannedType(TPrimitive(name), -1))
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_c_name(ta)
            return result
        else:
            pass
    return "int64_t"

# Check if any type arg is an unresolved type variable (e.g., T, A, B)
# rather than a concrete type (e.g., int, String, Vector[int])
bool has_type_variable(Vector[SpannedType] targs):
    for ta in targs:
        match ta.ty:
            case TNamed(name, inner_targs):
                if inner_targs.len() == 0:
                    # Single name with no type args — could be a type variable
                    # Known concrete types: int, float, bool, void, String
                    int pt = prim_name_to_type(name)
                    if pt < 0 and name != "String":
                        # Not a primitive — check if it looks like a type var
                        # Type vars are typically short uppercase names
                        if name.len() <= 2:
                            return true
                else:
                    # Recurse into type args
                    if has_type_variable(inner_targs):
                        return true
            case TPrimitive(name):
                # Primitives are always concrete
                pass
            else:
                pass
    return false

String compute_mangled_name(Vector[SpannedType] targs, String base_name):
    String mangled = base_name
    for ta in targs:
        mangled = mangled + "__" + spanned_type_to_c_name(ta)
    return mangled

# Set up type substitutions for a generic instance.
void setup_type_subs(GirModule &gmod, Vector[String] type_params, Vector[SpannedType] type_args):
    gmod.type_subs = {}
    int i = 0
    while i < type_params.len() and i < type_args.len():
        String param_name = type_params.get(i).unwrap()
        SpannedType arg_type = type_args.get(i).unwrap()
        int tid = map_ast_type(arg_type, &gmod)
        gmod.type_subs.put(param_name, tid)
        i += 1

void clear_type_subs(GirModule &gmod):
    gmod.type_subs = {}

# Lower a monomorphized instance of a generic function
void lower_generic_function(FunctionDef fdef, String mangled_name, Vector[String] type_params, Vector[SpannedType] type_args, GirModule &gmod):
    setup_type_subs(&gmod, type_params, type_args)
    GirFunction gfn = lower_function(fdef, &gmod)

    # Detect bare Move-type params that are directly returned.
    # If return type is resource AND body is `return param_name` or just `param_name`,
    # upgrade that param from Ptr to MutPtr (matches Rust lowerer behavior).
    int ret_tid = gfn.return_type
    String ret_name = type_id_to_name(ret_tid, &gmod)
    if is_resource_type_name(ret_name, &gmod):
        # Check if body is a single return of a param identifier
        String returned_param = ""
        if fdef.is_expr_body and fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SExpr(sexpr):
                    match sexpr.expr:
                        case EIdentifier(name):
                            returned_param = name
                        else:
                            pass
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        elif fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        # Upgrade matching param from Ptr to MutPtr
        if returned_param.len() > 0:
            int pi = 0
            while pi < fdef.params.len():
                Param p = fdef.params.get(pi).unwrap()
                if p.param_name == returned_param and p.ownership == 0:
                    # Param local is at index pi+1 (local 0 is return place)
                    int local_idx = pi + 1
                    if local_idx < gfn.locals.len():
                        GirLocal loc = gfn.locals.get(local_idx).unwrap()
                        int old_tid = loc.type_id
                        # Check if it's currently Ptr(T) — upgrade to MutPtr(T)
                        if old_tid >= PRIM_COUNT:
                            GirType gt = gmod.type_table.get(old_tid).unwrap()
                            match gt:
                                case GtPtr(inner):
                                    int new_tid = register_type(&gmod, GtMutPtr(inner))
                                    gfn.locals.set(local_idx, GirLocal(new_tid, loc.name_hint, loc.ownership, loc.borrow_origin, loc.owning_param))
                                    gfn.param_types.set(pi, new_tid)
                                else:
                                    pass
                pi += 1

    # Override the function name with the mangled name
    gmod.functions.push(GirFunction(mangled_name, gfn.param_types, gfn.return_type, gfn.locals, gfn.blocks))
    clear_type_subs(&gmod)

# Extract type parameter names from equip target's generic args
# e.g., Stack[T] → ["T"], Pair[A, B] → ["A", "B"]
Vector[String] extract_equip_type_params(EquipBlock eqblk):
    # First try explicit type_params
    if eqblk.type_params.len() > 0:
        return eqblk.type_params
    # Otherwise extract from target type args
    Vector[String] params = []
    match eqblk.target.ty:
        case TNamed(_, targs):
            for ta in targs:
                match ta.ty:
                    case TNamed(tname, _):
                        params.push(tname)
                    case TPrimitive(tname):
                        params.push(tname)
                    else:
                        pass
        else:
            pass
    return params

# Lower monomorphized instances of generic equip methods
void lower_generic_equip(EquipBlock eqblk, Vector[SpannedType] type_args, GirModule &gmod):
    Vector[String] type_params = extract_equip_type_params(eqblk)
    setup_type_subs(&gmod, type_params, type_args)
    # For generic equip, Rust uses Type__method naming (no trait prefix) and concrete self types.
    # Strip the trait_name so lower_equip_block uses plain Type__method naming.
    Option[String] no_trait = None
    EquipBlock plain_eqblk = EquipBlock(eqblk.target, eqblk.type_params, no_trait, eqblk.methods, eqblk.via_field, eqblk.trait_generic_args)
    lower_equip_block(plain_eqblk, &gmod)
    clear_type_subs(&gmod)

# ── Spawn wrapper scanning ───────────────────────────────

# Extract the base type name from a SpannedType (e.g. TNamed("Worker",[]) → "Worker").
String spawn_type_base_name(SpannedType ty):
    match ty.ty:
        case TNamed(n, _):
            return n
        case TPrimitive(n):
            return n
        else:
            return ""

# Collect shared variable names from a list of statements
void collect_shared_vars(Vector[Stmt] stmts, Dict[String, bool] &shared_vars):
    for s in stmts:
        match s:
            case SVarDecl(_, name, _, _, sk, _):
                # Only auto-mutex (sk=1) gets __shared_token_ wrappers.
                # Atomic (sk=3) and rwlock (sk=2) use different patterns.
                if sk == 1:
                    shared_vars.put(name, true)
            else:
                pass

# Scan for ESpawn expressions and emit wrapper function stubs
# borrow_params: names of &-qualified params of the enclosing function;
# passing them to a spawn implies shared-derived ownership (inner shared spawn).
void scan_spawn_wrappers(Vector[Stmt] stmts, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    for s in stmts:
        match s:
            case SVarDecl(ty, name, init, _, sk, _):
                if sk == 1:
                    shared_vars.put(name, true)
                # Track variable types for method-spawn wrapper generation
                String tname = spawn_type_base_name(ty)
                if tname != "":
                    var_types.put(name, tname)
                scan_expr_for_spawn(init, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SExpr(expr):
                scan_expr_for_spawn(expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SAssign(_, val):
                scan_expr_for_spawn(val, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SWhile(cond, body):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SIf(cond, then_body, branches):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(then_body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                for eb in branches:
                    scan_spawn_wrappers(eb.body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SFor(_, iter_expr, body, _, _):
                scan_expr_for_spawn(iter_expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SReturn(opt):
                match opt:
                    case Some(rexpr):
                        scan_expr_for_spawn(rexpr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                    case None:
                        pass
            else:
                pass

void scan_expr_for_spawn(SpannedExpr sexpr, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, args, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            # Check if any arg is:
                            # (a) a directly shared variable (shared_vars), or
                            # (b) a &-param of the enclosing function (borrow_params) —
                            #     skip_ownership_markers strips '&' in call args so
                            #     &counter arrives as EIdentifier("counter"), not EMutableBorrow.
                            bool has_shared = false
                            for arg in args:
                                match arg.expr:
                                    case EIdentifier(aname):
                                        if shared_vars.contains(aname) or borrow_params.contains(aname):
                                            has_shared = true
                                    case EMutableBorrow(inner):
                                        # Safety net: if &-prefix somehow survives into arg
                                        has_shared = true
                                    else:
                                        pass
                            if has_shared and not emitted.contains(callee_name):
                                # Determine prefix: __shared_async_ for async, __shared_token_ otherwise
                                String prefix = "__shared_token_"
                                if async_fns.contains(callee_name):
                                    prefix = "__shared_async_"
                                String wrapper_name = prefix + callee_name
                                # Emit a stub function
                                Vector[int] wp = [I64_TYPE]
                                Vector[GirLocal] wl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone(), false), GirLocal(I64_TYPE, NO_NAME, LoParam(), BoParam(-1), false)]
                                Vector[BasicBlock] wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                gmod.functions.push(GirFunction(wrapper_name, !wp, UNIT_TYPE, !wl, !wb))
                                emitted.put(callee_name, true)
                        else:
                            pass
                case EMethodCall(obj_box, method_name, _, _):
                    # spawn obj.method() → emit __spawn_method_wrap_TypeName__method_name
                    match (*obj_box).expr:
                        case EIdentifier(var_name):
                            Option[String] opt_type = var_types.get(var_name)
                            match opt_type:
                                case Some(type_name):
                                    String wrapper_name = "__spawn_method_wrap_" + type_name + "__" + method_name
                                    if not emitted.contains(wrapper_name):
                                        emitted.put(wrapper_name.clone(), true)
                                        Vector[int] wp = [I64_TYPE]
                                        Vector[GirLocal] wl = [GirLocal(I64_TYPE, NO_NAME, LoOwned(), BoNone(), false), GirLocal(I64_TYPE, NO_NAME, LoParam(), BoParam(-1), false)]
                                        Vector[BasicBlock] wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                        gmod.functions.push(GirFunction(wrapper_name, !wp, UNIT_TYPE, !wl, !wb))
                                case None:
                                    pass
                        else:
                            pass
                else:
                    pass
        case EAwait(inner):
            scan_expr_for_spawn(*inner, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case EMethodCall(obj, _, margs, _):
            scan_expr_for_spawn(*obj, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ma in margs:
                scan_expr_for_spawn(ma, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case ECall(callee, cargs, _):
            scan_expr_for_spawn(*callee, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ca in cargs:
                scan_expr_for_spawn(ca, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        else:
            pass

# ── Named-closure spawn wrapper emission ─────────────────
# Emits __spawn_wrap___Closure_N stubs for `spawn var()` where var holds a closure.

# closure Phase 2 Step A: `fn_name` keys into gmod.closure_var_cids
# (`<fn_name>\0<varname>` → `__Closure_<cid>`), recorded at the make-site
# (SVarDecl lowering). A `spawn varname()` whose varname holds a closure in
# THIS function emits the `__spawn_wrap___Closure_<cid>` stub.
void emit_named_closure_spawn_expr(SpannedExpr sexpr, String fn_name, Dict[String, bool] &emitted, GirModule &gmod):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, _, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            String cvc_key = fn_name + "\0" + callee_name
                            if gmod.closure_var_cids.contains(cvc_key):
                                String ctype = gmod.closure_var_cids.get(cvc_key).unwrap()
                                String wrap = "__spawn_wrap_" + ctype
                                if not emitted.contains(wrap):
                                    emitted.put(wrap.clone(), true)
                                    Vector[int] ncwp = []
                                    Vector[GirLocal] ncwl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone(), false)]
                                    Vector[BasicBlock] ncwb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                    gmod.functions.push(GirFunction(wrap, !ncwp, UNIT_TYPE, !ncwl, !ncwb))
                        else:
                            pass
                else:
                    pass
            emit_named_closure_spawn_expr(*inner_box, fn_name, &emitted, &gmod)
        case ECall(callee, args, _):
            emit_named_closure_spawn_expr(*callee, fn_name, &emitted, &gmod)
            for arg in args:
                emit_named_closure_spawn_expr(arg, fn_name, &emitted, &gmod)
        case EMethodCall(obj, _, margs, _):
            emit_named_closure_spawn_expr(*obj, fn_name, &emitted, &gmod)
            for ma in margs:
                emit_named_closure_spawn_expr(ma, fn_name, &emitted, &gmod)
        else:
            pass

void emit_named_closure_spawn_stmts(Vector[Stmt] stmts, String fn_name, Dict[String, bool] &emitted, GirModule &gmod):
    for ncs in stmts:
        match ncs:
            case SVarDecl(_, _, init, _, _, _):
                emit_named_closure_spawn_expr(init, fn_name, &emitted, &gmod)
            case SExpr(expr):
                emit_named_closure_spawn_expr(expr, fn_name, &emitted, &gmod)
            case SReturn(opt):
                match opt:
                    case Some(re):
                        emit_named_closure_spawn_expr(re, fn_name, &emitted, &gmod)
                    case None:
                        pass
            case SIf(cond, then_body, branches):
                emit_named_closure_spawn_expr(cond, fn_name, &emitted, &gmod)
                emit_named_closure_spawn_stmts(then_body, fn_name, &emitted, &gmod)
                for nceb in branches:
                    emit_named_closure_spawn_stmts(nceb.body, fn_name, &emitted, &gmod)
            case SWhile(_, body):
                emit_named_closure_spawn_stmts(body, fn_name, &emitted, &gmod)
            case SFor(_, iter_expr, body, _, _):
                emit_named_closure_spawn_expr(iter_expr, fn_name, &emitted, &gmod)
                emit_named_closure_spawn_stmts(body, fn_name, &emitted, &gmod)
            else:
                pass

# ── Transitive generic discovery ─────────────────────────
# Substitute type variables in a SpannedType using a name→type map.

SpannedType substitute_type(SpannedType stype, Dict[String, SpannedType] &type_sub_map):
    match stype.ty:
        case TNamed(name, inner_targs):
            if inner_targs.len() == 0:
                if type_sub_map.contains(name):
                    return type_sub_map.get(name).unwrap()
            if inner_targs.len() > 0:
                Vector[SpannedType] new_inner = []
                for ita in inner_targs:
                    SpannedType sub = substitute_type(ita, &type_sub_map)
                    new_inner.push(sub)
                return SpannedType(TNamed(name, new_inner), stype.span)
            return stype
        else:
            return stype

# Extract meta-op suffix from a call argument list.
# Looks for EIdentifier("__metaop__<op>") produced by the parser's meta-op handling.
String extract_meta_op_suffix(Vector[SpannedExpr] args):
    for arg in args:
        match arg.expr:
            case EIdentifier(aname):
                if aname == "__metaop__add":
                    return "__add"
                elif aname == "__metaop__sub":
                    return "__sub"
                elif aname == "__metaop__mul":
                    return "__mul"
                elif aname == "__metaop__div":
                    return "__div"
                elif aname == "__metaop__mod":
                    return "__mod"
                elif aname == "__metaop__eq":
                    return "__eq"
                elif aname == "__metaop__ne":
                    return "__ne"
                elif aname == "__metaop__lt":
                    return "__lt"
                elif aname == "__metaop__gt":
                    return "__gt"
                elif aname == "__metaop__le":
                    return "__le"
                elif aname == "__metaop__ge":
                    return "__ge"
                else:
                    pass
            else:
                pass
    return ""

int discover_transitive_expr(SpannedExpr sexpr, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and has_type_variable(targs):
                Vector[SpannedType] resolved = []
                for ta in targs:
                    resolved.push(substitute_type(ta, &type_sub_map))
                if not has_type_variable(resolved):
                    String meta_suffix = extract_meta_op_suffix(args)
                    match (*callee_box).expr:
                        case EIdentifier(fname):
                            String mangled = compute_mangled_name(resolved, fname) + meta_suffix
                            if not seen.contains(mangled):
                                seen.put(mangled.clone(), true)
                                instances.push(GenericInstance(fname, resolved, mangled))
                                added += 1
                        else:
                            pass
            for arg in args:
                added += discover_transitive_expr(arg, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*callee_box, &type_sub_map, &seen, &instances)
        case EMethodCall(obj, _, margs, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            for ma in margs:
                added += discover_transitive_expr(ma, &type_sub_map, &seen, &instances)
        case EBinaryOp(lhs, _, rhs):
            added += discover_transitive_expr(*lhs, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*rhs, &type_sub_map, &seen, &instances)
        case EUnaryOp(_, inner):
            added += discover_transitive_expr(*inner, &type_sub_map, &seen, &instances)
        case EIf(cond, then_body, branches):
            added += discover_transitive_expr(*cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case EFieldAccess(obj, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
        case EIndex(obj, idx):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*idx, &type_sub_map, &seen, &instances)
        case EClosure(_, body):
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case EFString(_, fexprs):
            for fx in fexprs:
                added += discover_transitive_expr(fx, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmt(Stmt stmt, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            added += discover_transitive_expr(init, &type_sub_map, &seen, &instances)
        case SAssign(_, value):
            added += discover_transitive_expr(value, &type_sub_map, &seen, &instances)
        case SExpr(expr):
            added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case SWhile(cond, body):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SFor(_, iter_expr, body, _, _):
            added += discover_transitive_expr(iter_expr, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SMatch(scrutinee, arms):
            added += discover_transitive_expr(scrutinee, &type_sub_map, &seen, &instances)
            for arm in arms:
                added += discover_transitive_stmts(arm.body, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmts(Vector[Stmt] stmts, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    for stmt in stmts:
        added += discover_transitive_stmt(stmt, &type_sub_map, &seen, &instances)
    return added

# ── Module lowering ──────────────────────────────────────

GirModule lower_module(Module m, ScopeTable scopes, TypeTable types, Dict[String, String] call_redirects, Dict[String, bool] imported_fns):
    Vector[GirType] type_table = init_type_table()

    # Pre-scan: detect if module has a main() function.
    # Test blocks are skipped when main exists (normal build mode),
    # emitted when no main (test-only file).
    bool has_main = false
    for hm_item in m.items:
        match hm_item:
            case IFunction(fdef):
                if fdef.name == "main":
                    has_main = true
            else:
                pass

    # Pre-scan function signatures for call resolution.
    Dict[String, int] fn_sigs = {}
    for item in m.items:
        match item:
            case IFunction(fdef):
                int rt = I64_TYPE
                if fdef.name == "main":
                    rt = I32_TYPE
                else:
                    # Pre-scan: use primitive types AND best-effort named type detection.
                    match fdef.return_type.ty:
                        case TPrimitive(name):
                            int pt = prim_name_to_type(name)
                            if pt >= 0:
                                rt = pt
                            elif name == "String":
                                # Pre-register GorgetString so fn_sigs resolves correctly.
                                # Types table will be extended on-demand; here we use a
                                # sentinel that lower_call handles via fn definition lookup.
                                pass
                        case TNamed(name, _):
                            # Collection/named return types — record a hint so downstream
                            # call_return type inference can recover them during function
                            # definition lookup. Full resolution happens when the function
                            # body is lowered (see lower_function).
                            pass
                        else:
                            pass
                fn_sigs.put(fdef.name, rt)
            else:
                pass

    # Pre-scan function param ownership for borrow detection
    Dict[String, Vector[bool]] fn_borrow_params = {}
    # Parallel scan for `!`-move params (OWN_MOVE == 2). Drives
    # CkCallArgOwning vs CkCallArgBorrow at call-arg lowering sites via
    # `classify_call_arg`. See enum ConsumeKind / op_consume docstring.
    Dict[String, Vector[bool]] fn_move_params = {}
    for bp_item in m.items:
        match bp_item:
            case IFunction(fdef):
                Vector[bool] borrows = []
                Vector[bool] moves = []
                for p in fdef.params:
                    borrows.push(p.ownership == 1)  # 1 = OWN_MUTABLE (&)
                    moves.push(p.ownership == 2)    # 2 = OWN_MOVE (!)
                fn_borrow_params.put(fdef.name.clone(), borrows)
                fn_move_params.put(fdef.name, moves)
            case IEquip(bp_eqblk):
                # Equip-method `!`-params must register too, otherwise a
                # `self.m(!arg)`-shaped call (a bare local passed to a `!T`
                # method param) classifies as CkCallArgBorrow → op_consume
                # returns OpBorrow → no caller-side GIMoveZero → the caller
                # drops its local at scope exit WHILE the callee's `!`-param
                # exit-drop ALSO frees it → double-free. The call site keys
                # `classify_call_arg` on `recv_type_name + "__" + mname` (the
                # SHORT form, `lower.gg:5933`), never the `Trait_for_…` form,
                # so we register under the same short `Target__method` key.
                # Param indices include `self` at 0 — aligned with the call
                # site's `classify_call_arg(full_name, 0)` receiver dispatch
                # and `classify_call_arg(full_name, _ma_idx + 1)` for args.
                # Only non-generic equips on a concrete named/primitive target
                # (the call site resolves `recv_type_name` to that name).
                # GENERIC-equip mono'd instances (`equip [T] Vector[T] with
                # Drainable[T]: VectorDrain[T] drain(!self)`) are registered
                # SEPARATELY, in the `fn_sigs` generic-instances pre-pass (search
                # "GENERIC-EQUIP `!`-PARAM MOVE CONTRACT" in `lower_module`), which
                # runs over the mono'd instances BEFORE function bodies and so
                # reaches the call sites — `lower_generic_equip` itself runs too
                # late. Both paths put under the same `Target__method` key with the
                # same `ownership==1/==2` flags; this `type_params.len()==0` arm is
                # the NON-generic case only.
                if bp_eqblk.type_params.len() == 0:
                    String bpe_target = ""
                    match bp_eqblk.target.ty:
                        case TNamed(bpe_tn, bpe_targs):
                            if bpe_targs.len() == 0:
                                bpe_target = bpe_tn
                        case TPrimitive(bpe_tn):
                            bpe_target = bpe_tn
                        else:
                            pass
                    if bpe_target != "":
                        for bpe_m in bp_eqblk.methods:
                            Vector[bool] em_borrows = []
                            Vector[bool] em_moves = []
                            for ep in bpe_m.params:
                                em_borrows.push(ep.ownership == 1)
                                em_moves.push(ep.ownership == 2)
                            String bpe_full = bpe_target + "__" + bpe_m.name
                            fn_borrow_params.put(bpe_full.clone(), em_borrows)
                            fn_move_params.put(bpe_full, em_moves)
            else:
                pass

    Dict[String, int] named_types = {}
    # Scan struct/enum defs to determine which types have resource fields.
    #
    # Run to fixpoint: a single pass misses forward references (struct A
    # contains struct B defined later → B isn't yet marked as resource
    # when A is checked). The brief calls this `is_transitively_resource`;
    # the same effect is achieved by closing the existing
    # `is_resource_field_type` walk under iteration. Each iteration may
    # mark more structs/enums as resource (because their already-checked
    # nested types were just marked in the prior pass); iteration
    # terminates when no new entries are added.
    #
    # Concrete bug this closes: `SpannedType { Type ty; Span span }` where
    # Type ∋ TNamed(String, Vector[SpannedType]) — Type was forward-
    # referenced relative to SpannedType in ast.gg, so SpannedType was NOT
    # marked → `loader___type_mentions_iter(SpannedType ty)` got the bare
    # byte-copy ABI rather than Ptr-wrap, aliasing caller's heap and
    # SIGSEGV'ing at `gorget_string_clone_to_owned(&__s7)`. Fix C of the
    # 2026-05-22 fourth-attempt review.
    Dict[String, bool] resource_types = {}
    resource_types.put("String", true)
    resource_types.put("GorgetString", true)
    bool rt_changed = true
    while rt_changed:
        rt_changed = false
        for ritem in m.items:
            match ritem:
                case IStruct(sdef):
                    if resource_types.contains(sdef.name):
                        continue
                    bool has_resource = false
                    for fld in sdef.fields:
                        if is_resource_field_type(fld.param_type, resource_types):
                            has_resource = true
                    if has_resource:
                        resource_types.put(sdef.name, true)
                        rt_changed = true
                case IEnum(edef):
                    if resource_types.contains(edef.name):
                        continue
                    bool has_resource = false
                    for var in edef.variants:
                        for vft in var.fields:
                            if is_resource_field_type(vft, resource_types):
                                has_resource = true
                    if has_resource:
                        resource_types.put(edef.name, true)
                        rt_changed = true
                else:
                    pass

    # Register the MANGLED names of mono'd Option__X / Result__X__E
    # instances (whose payload is a resource) that appear as struct/enum
    # fields, so the string-keyed `is_resource_type_name` (op_consume's
    # clone-vs-copy gate) and the ctor-flag registration recognise them.
    # The fixpoint above marks the CONTAINING user type as a resource but
    # never the mono'd Option/Result instance itself — it isn't a user
    # `m.items` def, so its mangled name (`Option__SpannedExpr`) is absent
    # from resource_types. Without this, op_consume byte-copies (OpCopy →
    # shallow alias) an `Option[Resource]` field at a consuming position:
    # the MatchArm `guard` / ElseBranch `condition` double-free.
    # `register_optionlike_resource` deliberately handles ONLY Option/
    # Result (Vector/Dict/Set/Box are already classified by
    # build_resource_metadata; registering their mangled names breaks C
    # type emission). lir_lower drops/clones these via recursive_drop_enums
    # (`Option__SpannedExpr__clone`).
    # TODO(layering): is_resource_field_type (structured) and
    # is_resource_type_name (string) are two classifiers for one axis;
    # unify long-term (layering rule 3).
    Dict[String, bool] optionlike_resource_types = {}
    for mn_item in m.items:
        match mn_item:
            case IStruct(mn_sdef):
                for mn_fld in mn_sdef.fields:
                    register_optionlike_resource(mn_fld.param_type, resource_types, &optionlike_resource_types)
            case IEnum(mn_edef):
                for mn_var in mn_edef.variants:
                    for mn_vft in mn_var.fields:
                        register_optionlike_resource(mn_vft, resource_types, &optionlike_resource_types)
            else:
                pass

    Dict[String, int] type_subs = {}
    Dict[String, String] meta_aliases = types.meta_aliases
    # Also collect plain type aliases (ITypeAlias) into meta_aliases
    for ta_item in m.items:
        match ta_item:
            case ITypeAlias(ta_name, ta_tparams, ta_target):
                if ta_tparams.len() == 0:
                    # Store the raw type name for alias resolution
                    match ta_target.ty:
                        case TPrimitive(pname):
                            meta_aliases.put(ta_name, pname)
                        case TNamed(tname, _):
                            meta_aliases.put(ta_name, tname)
                        case TFunction(_, _, _):
                            # Function type aliases are opaque in GIR → void
                            meta_aliases.put(ta_name, "void")
                        else:
                            pass
            else:
                pass
    # Build type field info for LIR drop analysis.
    Dict[String, GirTypeInfo] type_infos = {}
    Dict[String, Vector[String]] enum_registry = {}
    # Flat variant→enum index, built FIRST-WRITE-WINS in the IEnum arm below
    # (mirrors the insertion-order first-match of the old `enum_variant_parent`
    # scan). Threaded into GirModule so the lookup is O(1).
    Dict[String, String] enum_variant_parent_idx = {}
    for tfi_item in m.items:
        match tfi_item:
            case IStruct(sdef):
                Vector[GirFieldInfo] fields = []
                for fld in sdef.fields:
                    String ftype_name = spanned_type_to_name(fld.param_type)
                    fields.push(GirFieldInfo(fld.param_name, ftype_name))
                Vector[GirEnumVariantInfo] no_variants = []
                type_infos.put(sdef.name, GirTypeInfo(sdef.name, fields, no_variants, false))
            case IEnum(edef):
                Vector[GirFieldInfo] no_fields = []
                Vector[GirEnumVariantInfo] variants = []
                Vector[String] variant_names_only = []
                for var in edef.variants:
                    Vector[GirFieldInfo] vfields = []
                    int evfi = 0
                    while evfi < var.fields.len():
                        SpannedType vft = var.fields.get(evfi).unwrap()
                        String vftype_name = spanned_type_to_name(vft)
                        vfields.push(GirFieldInfo("_" + int_to_str(evfi), vftype_name))
                        evfi += 1
                    variants.push(GirEnumVariantInfo(var.name, vfields))
                    variant_names_only.push(var.name.clone())
                    # FIRST-WRITE-WINS: keep the first enum (insertion order)
                    # whose variant matches, identical to the old
                    # `enum_variant_parent` scan. A plain (last-wins) `.put`
                    # would silently flip the result on a variant-name
                    # collision across enums.
                    if not enum_variant_parent_idx.contains(var.name):
                        enum_variant_parent_idx.put(var.name.clone(), edef.name.clone())
                type_infos.put(edef.name, GirTypeInfo(edef.name, no_fields, variants, true))
                enum_registry.put(edef.name.clone(), !variant_names_only)
            else:
                pass
    # Fix D (2026-05-22) — register struct constructors in fn_move_params
    # with per-field resource flags. Per CLAUDE.md "Ownership at Consuming
    # Positions": struct field-init is a consume position. Without this,
    # `classify_call_arg("Lexer", 2)` returned CkCallArgBorrow (default for
    # unregistered callees), `op_consume` returned `OpBorrow`, and the
    # constructor inline field-init byte-aliased the caller's resource
    # source into the struct field — leading to double-free at scope exit.
    #
    # With this entry, resource-field positions are classified
    # CkCallArgOwning → OpMove (last-use) or OpClone (live past call).
    # OpMove triggers `wire_liveness_into_modes` to emit `GIMoveZero` on
    # the source slot post-call; the source's scope-exit `GIDropIfAlive`
    # then sees a zeroed slot and the memcmp gate suppresses the free.
    #
    # Field type_name is the resolved C name ("GorgetString",
    # "Vector__int64_t", etc.); resource detection routes through
    # `build_resource_metadata` (pattern-based, gmod-independent) and the
    # local `resource_types` dict for user structs/enums. `build_resource_metadata`
    # lives in lir_lower.gg; calling it here keeps the registration self-
    # contained at module-build time.
    for fd_item in m.items:
        match fd_item:
            case IStruct(fd_sdef):
                Vector[bool] fd_moves = []
                for fd_fld in fd_sdef.fields:
                    # Use the structured, recursive `is_resource_field_type`
                    # (the same predicate that builds resource_types) rather
                    # than the string-keyed build_resource_metadata +
                    # resource_types.contains: the string path can't see INTO
                    # an `Option[Resource]` / `Result[Resource,_]` field, so
                    # such fields were flagged non-owning → CkCallArgBorrow →
                    # the MatchArm `guard` / ElseBranch `condition` aliased and
                    # double-freed. Structured detection flags them owning →
                    # CkCallArgOwning → op_consume clones the borrow.
                    bool fd_is_resource = is_resource_field_type(fd_fld.param_type, resource_types)
                    fd_moves.push(fd_is_resource)
                fn_move_params.put(fd_sdef.name, fd_moves)
            case IEnum(fd_edef):
                # Enum-variant constructors are ALSO consume positions — the
                # constructed node OWNS its payload fields. Without this, a
                # resource arg (e.g. a `Vector[Stmt]` moved into an `SIf` node)
                # classified CkCallArgBorrow → OpBorrow → byte-aliased into the
                # variant field, then the source local was dropped at scope exit
                # AND the node owned the same heap → double-free (the
                # parse_if_stmt → gorget_array_free → Stmt__drop backtrace,
                # 2026-05-24). classify_call_arg keys on the BARE variant name
                # for `SIf(...)` and on `Enum__Variant` for `Enum.Variant(...)`;
                # register both.
                for fd_var in fd_edef.variants:
                    Vector[bool] fd_vmoves = []
                    for fd_vfld in fd_var.fields:
                        # Structured detection (see the IStruct branch) —
                        # catches Option/Result-of-resource variant payloads.
                        bool fd_v_is_resource = is_resource_field_type(fd_vfld, resource_types)
                        fd_vmoves.push(fd_v_is_resource)
                    fn_move_params.put(fd_var.name.clone(), fd_vmoves.clone())
                    fn_move_params.put(fd_edef.name + "__" + fd_var.name, !fd_vmoves)
            else:
                pass
    # Prelude enum variant constructors (Option.Some, Result.Ok/Error) own
    # their single payload — they are NOT in `m.items`, so the Fix-D loop
    # above never registers them. Without this, `Some(x)` / `Ok(x)` /
    # `Error(x)` classify the payload `CkCallArgBorrow` → op_consume returns
    # OpBorrow (a non-consume early-out, so a-5's clone-on-borrow arm never
    # fires) → the variant shallow-ALIASES the source, which is then dropped
    # at scope exit while the constructed Option/Result (often returned or
    # stored) still references it → use-after-free. ASan-confirmed via the
    # `parse_equip_item` EquipBlock.trait_name UAF (`Some(tn)` aliasing a
    # freed `tn`), 2026-05-24. Mirrors Rust treating variant payloads as
    # owning consume positions. `None` has no payload. Registered on the
    # bare variant name (the GIR emits `call @Some(...)`); op_consume still
    # yields OpCopy for primitive payloads, so flagging owning is universally
    # safe.
    # Typed locals (NOT a bare `[true]` arg) so the `Vector[bool]` gets
    # elem_size 1 from the declaration's container-size hint. A bare
    # `[true]` literal passed straight to `.put()` has no type context →
    # defaults to elem_size 8 → pushing the 1-byte bool reads 8 bytes →
    # stack-buffer-overflow + array corruption (an "index 0, length 0"
    # panic later in lower_module).
    Vector[bool] some_mv = [true]
    fn_move_params.put("Some", !some_mv)
    Vector[bool] ok_mv = [true]
    fn_move_params.put("Ok", !ok_mv)
    Vector[bool] error_mv = [true]
    fn_move_params.put("Error", !error_mv)
    # `Box(x)` is the sibling prelude ctor: `Box[T]` is a SINGLE-OWNER
    # heap allocation (language-reference.md §"Box[T]") — it OWNS its
    # payload, exactly like Some/Ok/Error own theirs. Without this,
    # `Box(x)` classifies the payload CkCallArgBorrow → op_consume's
    # non-consume early-out returns OpBorrow → IBoxAlloc shallow-memcpy's
    # the payload, aliasing the source's interior `Box`/`String` ptrs;
    # drop emission then frees the source while the box still references
    # it → dangle (bug #3, the `Box(lhs)` cycle in parse_expr_bp_with_lhs).
    # Rust treats `Box(x)`/`Box.new(x)` as an owning consume position too
    # (`ir/lowering/exprs/calls.rs` Box ctor + `methods.rs` Box.new, both
    # run `ensure_owned_at_consuming_arg`). Flagging owning routes the arg
    # through op_consume → move (owned last-use) or clone (borrow/`!`-param
    # live-past, via the MutPtr/Ptr clone-through arms). Typed local, not a
    # bare `[true]` (elem_size trap — see above).
    Vector[bool] box_mv = [true]
    fn_move_params.put("Box", !box_mv)
    Dict[String, int] const_decls = {}
    Dict[String, int] none_decls = {}
    Dict[String, float] float_const_decls = {}
    # Module-level statics with runtime-call init (`stdout` / `stderr` /
    # `stdin` from lib/std/io.gg etc.). Populated below in the
    # IStaticDecl handler when int/float eval miss and the init shape is
    # a zero-arg call.
    Dict[String, GirStaticInfo] statics = {}
    Dict[String, ResourceMetadata] resource_metadata = {}
    Dict[int, int] option_ref_payload = {}
    GirModule gmod = GirModule([], [GirExtern("printf", true, I32_TYPE)], type_table, !fn_sigs, !named_types, !resource_types, !type_subs, !meta_aliases, !call_redirects, !imported_fns, !type_infos, !fn_borrow_params, !fn_move_params, !const_decls, !none_decls, !enum_registry, !float_const_decls, !statics, !resource_metadata, types, scopes, !optionlike_resource_types, !option_ref_payload, [], !enum_variant_parent_idx, false, [], {}, {}, {})

    # R11: extract the `strip-asserts` directive so the SAssert case in
    # lower_stmt can emit a no-op instead of a conditional panic. Mirrors
    # Rust gg's directive scan (`src/ir/lowering/mod.rs:486-489`).
    for dir_item in m.items:
        match dir_item:
            case IDirective(dir_name, _):
                if dir_name == "strip-asserts":
                    gmod.strip_asserts = true
            else:
                pass

    # Refine fn_sigs for functions with named/generic return types. The
    # pre-scan above defaulted those to `I64_TYPE` because `map_ast_type`
    # needs the real `gmod` to resolve generic names. Left uncorrected, a
    # caller of `parse_int(s) -> Result[int, ParseError]` would think the
    # return is int64 and allocate an 8-byte slot — the actual 48-byte
    # Result wouldn't fit, and field reads past the slot read zero. This
    # is the EIntLiteral-zero bug that made stage-1 produce `print(0)`
    # for `print(42)`, because `parse_int(clean).unwrap_or(0)` always
    # returned 0.
    for rs_item in m.items:
        match rs_item:
            case IFunction(rs_fdef):
                if rs_fdef.name != "main":
                    match rs_fdef.return_type.ty:
                        case TNamed(_, _):
                            int rs_rt = map_ast_type(rs_fdef.return_type, &gmod)
                            # Honour throws_type for Result[T, E] wrapping.
                            match rs_fdef.throws_type:
                                case Some(rs_throws):
                                    int rs_ok = rs_rt
                                    int rs_err = map_ast_type(rs_throws, &gmod)
                                    String rs_ret_c = type_id_to_name(rs_rt, &gmod)
                                    String rs_err_c = type_id_to_name(rs_err, &gmod)
                                    rs_rt = lookup_or_register_named(&gmod, "Result__" + rs_ret_c + "__" + rs_err_c)
                                    record_enum_category(&gmod, rs_rt, ENUM_CAT_RESULT, rs_ok, rs_err)
                                case None:
                                    pass
                            gmod.fn_sigs.put(rs_fdef.name, rs_rt)
                        case TPrimitive(rs_prim_name):
                            # `String` is a TPrimitive in the AST but resolves to
                            # the aggregate GorgetString — the fn_sigs pre-scan
                            # left it at the I64 default (it `pass`es on String
                            # because map_ast_type needs the real gmod). Resolve
                            # it now. Single-line externs like
                            # `extern "C" String __bytes_to_str_raw(...)` parse as
                            # IFunction (parser.gg:3808-3809) with a String return;
                            # without this, `String x = __bytes_to_str_raw(...)`
                            # types `x` as i64, the i64 slot mismatches the Str
                            # call result, and the C-emit ISlotStore give-up
                            # (lir_codegen:2886 aggregate-into-scalar) zeroes the
                            # store whenever SSA does not promote the dead slot —
                            # the io.gg Writer-for-String self-instability (bug #4).
                            int rs_prim_rt = map_ast_type(rs_fdef.return_type, &gmod)
                            if rs_prim_rt != I64_TYPE:
                                gmod.fn_sigs.put(rs_fdef.name, rs_prim_rt)
                        else:
                            pass
            else:
                pass

    # Pre-scan: evaluate IConstDecl AND IStaticDecl init exprs and register
    # values in gmod.const_decls. Without this, references to module-level
    # consts (e.g. `const int KW_IF = 5` in parser.gg) default to 0 at
    # EIdentifier lowering, which confuses the self-compiled parser's
    # keyword dispatch and deadlocks in check_kw(kw=0, pos=0).
    #
    # IStaticDecl covers the *non-const* spelling at module scope, e.g.
    # `int STRING_MARKER = -2` in lower.gg. The parser routes those
    # through `IStaticDecl(ty, name, val)` (parser.gg:3517-3519), but
    # before this loop was extended, the lowerer ignored them entirely
    # — every reference to `STRING_MARKER` got the EIdentifier
    # unknown-fallback (OpConstI64(0)).
    for cd_item in m.items:
        match cd_item:
            case IConstDecl(_, cd_name, cd_val):
                Option[int] cd_eval = eval_const_int_expr(cd_val, &gmod)
                match cd_eval:
                    case Some(cv):
                        gmod.const_decls.put(cd_name.clone(), cv)
                    case None:
                        # Float fallback: `const float EPSILON = 0.000001`
                        # lands here when int eval fails.
                        Option[float] cd_feval = eval_const_float_expr(cd_val, &gmod)
                        match cd_feval:
                            case Some(cfv):
                                gmod.float_const_decls.put(cd_name.clone(), cfv)
                            case None:
                                pass
            case IStaticDecl(sd_ty, sd_name, sd_val):
                # A `static` is MUTABLE module-level storage, NOT a `const`.
                # A scalar-literal init (`static int x = 0`, `static float
                # y = -1.5`, `static bool b = true`) is a mutable GLOBAL —
                # register it under `gmod.statics` as a const-bytes init
                # (GGSTATIC_BYTES) so the C backend emits a const initializer
                # at the declaration (`int64_t __lir_gN = 0LL;`), NOT a
                # runtime synth fn. An SAssign / SCompoundAssign still writes
                # back (the global is mutable). This is preferable to
                # const-folding into `const_decls` (which would silently drop
                # the write). Mirrors Rust's every-StaticDecl-is-a-mutable-
                # Global rule emitting a scalar literal via `GlobalInit::Bytes`
                # (`src/ir/lowering/mod.rs:1224-1232`, `:2459-2461`). Only
                # `const`s (the IConstDecl arm above) fold to compile-time
                # values.
                bool sd_is_scalar = static_is_scalar_literal_init(sd_val)
                if sd_is_scalar:
                    register_scalar_static(&gmod, sd_ty, sd_name, sd_val)
                else:
                    Option[int] sd_eval = eval_const_int_expr(sd_val, &gmod)
                    match sd_eval:
                        case Some(sv):
                            gmod.const_decls.put(sd_name.clone(), sv)
                        case None:
                            # Float fallback: `float EPSILON = 0.000001`
                            # at module scope (e.g., lib/xtd/math3d.gg).
                            Option[float] sd_feval = eval_const_float_expr(sd_val, &gmod)
                            match sd_feval:
                                case Some(sfv):
                                    gmod.float_const_decls.put(sd_name.clone(), sfv)
                                case None:
                                    # Runtime-call fallback: `public static File
                                    # stdout = _stdout_handle()` etc. Mirrors Rust
                                    # gg's `LoweringContext::global_names`. Helper
                                    # extracts the C runtime symbol; helper lives
                                    # in its own fn so this dispatch site stays
                                    # tight (the int/float cascade already lives
                                    # in lower_expr-adjacent stack frames).
                                    bool sd_handled = try_register_static_runtime_call(&gmod, sd_ty, sd_name, sd_val)
                                    if not sd_handled:
                                        # Recognise `Option[T] X = None` and record the
                                        # const's concrete Option type_id, so an EIdentifier
                                        # reference emits a properly-typed `None` (IEnumInit,
                                        # tag 1) rather than an 8-byte OpConstUnit() that
                                        # add_local's drop-emission clone over-reads.
                                        match sd_val.expr:
                                            case ENoneLiteral():
                                                int opt_tid = map_ast_type(sd_ty, &gmod)
                                                gmod.none_decls.put(sd_name.clone(), opt_tid)
                                            else:
                                                # Composite-init static. Two Rust-faithful
                                                # paths (see the helper docstrings):
                                                #  (2) collection CONSTRUCTOR (`Vector[int]()`
                                                #      / `Dict()`) → direct allocator init_expr,
                                                #      no synth fn (tried first).
                                                #  (1) array/dict LITERAL (`= [..]` / `= {..}`)
                                                #      → register a synth-fn call; the matching
                                                #      `__gg_static_init_<name>()` FunctionDef is
                                                #      synthesized + lowered in the non-generic
                                                #      function loop below (full registry ready).
                                                bool sd_ctor = try_register_collection_ctor_static(&gmod, sd_ty, sd_name, sd_val)
                                                if not sd_ctor:
                                                    #  (3) user-struct CONSTRUCTOR (`Counter(0)`)
                                                    #      with all-literal args → direct
                                                    #      GINIT_BYTES struct compound literal,
                                                    #      no synth fn (mirror Rust
                                                    #      GlobalInit::Struct).
                                                    sd_ctor = try_register_struct_ctor_static(&gmod, sd_ty, sd_name, sd_val)
                                                if not sd_ctor and static_is_literal_init(sd_val):
                                                    register_literal_static(&gmod, sd_ty, sd_name)
            else:
                pass

    # Collect generic templates and discover instances. Restored to
    # Dict-backed storage once the underlying Dict[String, _] codegen
    # bug was fixed (see DONE.md 2026-05-01).
    Dict[String, FunctionDef] fn_templates = {}
    Vector[EquipBlock] equip_templates = []
    Dict[String, bool] equip_generic_names = {}
    Dict[String, bool] seen_instances = {}
    Vector[GenericInstance] generic_instances = []

    for gitem in m.items:
        match gitem:
            case IFunction(fdef):
                if fdef.type_params.len() > 0:
                    fn_templates.put(fdef.name.clone(), fdef)
            case IEquip(eqblk):
                # Check if equip is generic: either type_params set OR target has type args
                bool is_generic_equip = eqblk.type_params.len() > 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        if eq_targs.len() > 0:
                            is_generic_equip = true
                        if is_generic_equip:
                            equip_templates.push(eqblk)
                            if not equip_generic_names.contains(tname):
                                equip_generic_names.put(tname.clone(), true)
                    else:
                        pass
            else:
                pass

    # Collect generic struct templates for resource type detection
    Dict[String, StructDef] struct_templates = {}
    for st_item in m.items:
        match st_item:
            case IStruct(sdef):
                if sdef.type_params.len() > 0:
                    struct_templates.put(sdef.name.clone(), sdef)
            else:
                pass

    # Discover generic call sites and type instances from all function/equip bodies
    for ditem in m.items:
        match ditem:
            case IFunction(fdef):
                discover_generic_calls_stmts(fdef.body, &seen_instances, &generic_instances)
            case IEquip(eqblk):
                for mdef in eqblk.methods:
                    discover_generic_calls_stmts(mdef.body, &seen_instances, &generic_instances)
            else:
                pass

    # Transitive generic discovery: fixpoint loop to find instances needed
    # inside already-discovered generic function bodies (e.g. tensor_zeros[T]
    # inside tensor_sum_axis[float], meta-op calls like tensor_scalar_op[T](t, val, meta /)).
    # Also walks generic-equip method return types + bodies so the
    # iterator chain `Vector[int]` → `VectorIter[int]` → `next()` returns
    # `Option[int]` cascade is discovered without explicit annotations
    # at every call site.
    bool transitive_changed = true
    while transitive_changed:
        transitive_changed = false
        int tfix_i = 0
        int tfix_end = generic_instances.len()
        while tfix_i < tfix_end:
            GenericInstance tinst = generic_instances.get(tfix_i).unwrap()
            String tfix_key = tinst.base_name.clone()
            if not fn_templates.contains(tfix_key) and gmod.call_redirects.contains(tinst.base_name):
                tfix_key = gmod.call_redirects.get(tinst.base_name).unwrap()
            if fn_templates.contains(tfix_key):
                FunctionDef tfix_tmpl = fn_templates.get(tfix_key).unwrap()
                if tfix_tmpl.type_params.len() > 0:
                    Dict[String, SpannedType] type_sub_map = {}
                    int tpi = 0
                    while tpi < tfix_tmpl.type_params.len() and tpi < tinst.type_args.len():
                        String tpname = tfix_tmpl.type_params.get(tpi).unwrap()
                        SpannedType tpta = tinst.type_args.get(tpi).unwrap()
                        type_sub_map.put(tpname, tpta)
                        tpi += 1
                    int prev_count = generic_instances.len()
                    discover_transitive_stmts(tfix_tmpl.body, &type_sub_map, &seen_instances, &generic_instances)
                    if generic_instances.len() > prev_count:
                        transitive_changed = true
            # Generic-equip transitive walk: for each instance whose target
            # has equip blocks, harvest the method return types (with subs)
            # AND walk method bodies for further generic call sites. This
            # lets `Vector[int]` discover `VectorIter[int]`, `VectorDrain[int]`,
            # … which in turn unlock their own `next()`/`iter()` cascades.
            if equip_generic_names.contains(tinst.base_name):
                for eqf_tmpl in equip_templates:
                    String eqf_target = ""
                    match eqf_tmpl.target.ty:
                        case TNamed(etn, _):
                            eqf_target = etn
                        else:
                            pass
                    if eqf_target == tinst.base_name:
                        Vector[String] eqf_tparams = extract_equip_type_params(eqf_tmpl)
                        Dict[String, SpannedType] eqf_sub_map = {}
                        int etpi = 0
                        while etpi < eqf_tparams.len() and etpi < tinst.type_args.len():
                            String etpname = eqf_tparams.get(etpi).unwrap()
                            SpannedType etpta = tinst.type_args.get(etpi).unwrap()
                            eqf_sub_map.put(etpname, etpta)
                            etpi += 1
                        int eqf_prev = generic_instances.len()
                        for eqf_meth in eqf_tmpl.methods:
                            # Method return type — substitute and register as
                            # a generic instance if it names a generic type
                            # (e.g. `VectorIter[T]` → `VectorIter[int]`).
                            SpannedType ret_sub = substitute_type(eqf_meth.return_type, &eqf_sub_map)
                            match ret_sub.ty:
                                case TNamed(rtname, rtargs):
                                    if rtargs.len() > 0 and not has_type_variable(rtargs):
                                        String rt_mangled = compute_mangled_name(rtargs, rtname)
                                        if not seen_instances.contains(rt_mangled):
                                            seen_instances.put(rt_mangled.clone(), true)
                                            generic_instances.push(GenericInstance(rtname, rtargs, rt_mangled))
                                else:
                                    pass
                            # Method body — walk for ECall sites with type
                            # args (e.g. `return VectorIter[T](self, 0)`
                            # discovers `VectorIter[int]` via the constructor
                            # call). Skip method-level generics; those need
                            # per-call-site mono and aren't reached here.
                            if eqf_meth.type_params.len() == 0:
                                discover_transitive_stmts(eqf_meth.body, &eqf_sub_map, &seen_instances, &generic_instances)
                        if generic_instances.len() > eqf_prev:
                            transitive_changed = true
            tfix_i += 1

    # Register monomorphized struct types as resource types if any substituted
    # field is a resource type (e.g., Pair[int, String] has a String field)
    for mrinst in generic_instances:
        if struct_templates.contains(mrinst.base_name):
            StructDef sdef = struct_templates.get(mrinst.base_name).unwrap()
            # Build substitution map
            setup_type_subs(&gmod, sdef.type_params, mrinst.type_args)
            # Register the mono'd struct's field info in `type_infos` so
            # later `EFieldAccess` lookups find `TypedColumn__int64_t.data`
            # / `Tensor__double.shape` etc. without falling through to
            # the `[bug]` placeholder. Field types are template-fields
            # substituted via `gmod.type_subs` (T → int64_t etc.).
            # Mirrors Rust gg's `monomorphize_struct()` step
            # (`src/ir/lowering/generics/mod.rs:2249-2304`).
            Vector[GirFieldInfo] mono_fields = []
            bool has_resource = false
            for fld in sdef.fields:
                int ft = map_ast_type(fld.param_type, &gmod)
                String ft_name = type_id_to_name(ft, &gmod)
                mono_fields.push(GirFieldInfo(fld.param_name.clone(), ft_name.clone()))
                if is_resource_type_name(ft_name, &gmod):
                    has_resource = true
            # Register only when the mono'd name isn't already there
            # (avoids duplicate clones when `generic_instances` lists
            # the same mono more than once across import cycles).
            if not gmod.type_infos.contains(mrinst.mangled_name):
                Vector[GirEnumVariantInfo] mono_no_variants = []
                gmod.type_infos.put(mrinst.mangled_name.clone(), GirTypeInfo(mrinst.mangled_name.clone(), mono_fields, mono_no_variants, false))
            clear_type_subs(&gmod)
            if has_resource:
                gmod.resource_types.put(mrinst.mangled_name.clone(), true)

    # Populate fn_sigs for non-generic functions using map_ast_type now that
    # gmod.type_table is accessible. Pre-scan only handled TPrimitive return
    # types; this pass captures TNamed (String, Vector[T], …).
    for fs_item in m.items:
        match fs_item:
            case IFunction(fsdef):
                if fsdef.type_params.len() == 0 and fsdef.name != "main":
                    int ret_tid = map_fn_return_type(fsdef.return_type, &gmod)
                    # Honour throws_type for Result[T, E] wrapping. This is the
                    # AUTHORITATIVE fn_sigs pass (it runs after the pre-scan and
                    # the named-return refine pass, overwriting both), so the
                    # throws-wrap MUST live here too — otherwise a
                    # `T f(...) throws E` records the UNWRAPPED `T` and a
                    # `catch`/`match` on the call sees a `T` scrutinee where the
                    # actual call returns `Result__T__E` (slot type-mismatch →
                    # zero-init). Mirrors the function-build wrap at `:7472`.
                    match fsdef.throws_type:
                        case Some(fs_throws):
                            int fs_ok = ret_tid
                            int fs_err = map_ast_type(fs_throws, &gmod)
                            if ret_tid >= 0 and fs_err >= 0:
                                String fs_ret_c = type_id_to_name(ret_tid, &gmod)
                                String fs_err_c = type_id_to_name(fs_err, &gmod)
                                ret_tid = lookup_or_register_named(&gmod, "Result__" + fs_ret_c + "__" + fs_err_c)
                                record_enum_category(&gmod, ret_tid, ENUM_CAT_RESULT, fs_ok, fs_err)
                        case None:
                            pass
                    if ret_tid >= 0:
                        gmod.fn_sigs.put(fsdef.name.clone(), ret_tid)
            case IEquip(ieqblk):
                # Register equip-block methods as TypeName__method in fn_sigs.
                # Only for non-generic equip blocks on concrete types.
                if ieqblk.type_params.len() == 0:
                    String target_name = ""
                    match ieqblk.target.ty:
                        case TNamed(tn, targs):
                            if targs.len() == 0:
                                target_name = tn
                        case TPrimitive(tn):
                            target_name = tn
                        else:
                            pass
                    if target_name != "":
                        for em in ieqblk.methods:
                            if em.type_params.len() == 0:
                                int em_ret = map_fn_return_type(em.return_type, &gmod)
                                if em_ret >= 0:
                                    String em_full = target_name + "__" + em.name
                                    gmod.fn_sigs.put(em_full, em_ret)
            else:
                pass

    # Register fn_sigs for monomorphized instances
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name
        String tmpl_key = inst.base_name.clone()
        if not fn_templates.contains(tmpl_key) and gmod.call_redirects.contains(inst.base_name):
            tmpl_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(tmpl_key):
            FunctionDef tmpl = fn_templates.get(tmpl_key).unwrap()
            # Compute return type with substitutions active
            setup_type_subs(&gmod, tmpl.type_params, inst.type_args)
            int rt = map_ast_type(tmpl.return_type, &gmod)
            clear_type_subs(&gmod)
            # Monomorphized generics use bare names (no module prefix)
            gmod.fn_sigs.put(inst.mangled_name.clone(), rt)

    # Register fn_sigs for monomorphized generic-equip methods. Mirrors the
    # function-template pre-pass above: fn_sigs entries must exist *before*
    # function bodies are lowered (line ~6155+) so call-site return-type
    # lookups (e.g. `v.iter()` in lower_for_iterator) resolve. The actual
    # equip-method bodies are emitted later at line ~6481 by
    # `lower_generic_equip` which strips trait_name and routes through
    # lower_equip_block — produces `Target__method` naming with type subs
    # applied. We mirror that naming here.
    for eqsi_inst in generic_instances:
        if equip_generic_names.contains(eqsi_inst.base_name):
            for eqs_tmpl in equip_templates:
                String eqs_target_name = ""
                match eqs_tmpl.target.ty:
                    case TNamed(etn, _):
                        eqs_target_name = etn
                    else:
                        pass
                if eqs_target_name == eqsi_inst.base_name:
                    Vector[String] eqs_type_params = extract_equip_type_params(eqs_tmpl)
                    setup_type_subs(&gmod, eqs_type_params, eqsi_inst.type_args)
                    # `type_to_c_name(target, …)` substitutes type vars from
                    # active subs — `Vector[T]` with T → int → `Vector__int64_t`.
                    String eqs_mono_target = type_to_c_name(eqs_tmpl.target, &gmod)
                    for eqs_mdef in eqs_tmpl.methods:
                        # Method-level generics (`fold[A, F]` etc.) skip this
                        # pre-pass; they need per-call-site mono of their own.
                        if eqs_mdef.type_params.len() == 0:
                            int eqs_ret = map_fn_return_type(eqs_mdef.return_type, &gmod)
                            if eqs_ret >= 0:
                                String eqs_mangled = eqs_mono_target + "__" + eqs_mdef.name
                                gmod.fn_sigs.put(eqs_mangled, eqs_ret)
                            # GENERIC-EQUIP `!`-PARAM MOVE CONTRACT (#14 class).
                            # Register the mono'd method's `!`/`&`-params in
                            # fn_move_params / fn_borrow_params under the SHORT
                            # `Target__method` key — the exact form
                            # `classify_call_arg` looks up at the call site
                            # (`recv_type_name + "__" + mname`, lower.gg:~5947).
                            # The `lower_module` pre-scan (IEquip case,
                            # lower.gg:~12972) does this only for NON-GENERIC
                            # equips; a generic-equip mono instance like
                            # `equip [T] Vector[T] with Drainable[T]:
                            # VectorDrain[T] drain(!self)` reaches the lowerer
                            # via `lower_generic_equip` AFTER function bodies are
                            # lowered, so its `Vector__int64_t__drain` was NEVER
                            # registered → classify_call_arg returned
                            # CkCallArgBorrow → the `!self` receiver was NOT
                            # move-zeroed → the drain SOURCE and the drain RESULT
                            # both owned the same buffer (a masked leak today; a
                            # double-free the instant owned-method-result
                            # registration goes general — lower.gg:~6138). This
                            # MUST run BEFORE function bodies are lowered
                            # (line ~13746+) so the call-site lookup resolves,
                            # exactly like the fn_sigs pre-pass it lives in.
                            # `eqs_mono_target` is the mono'd C name (type_subs
                            # active), so the key matches the call site. Param 0
                            # is `self`, aligned with classify_call_arg(_, 0).
                            Vector[bool] eqs_borrows = []
                            Vector[bool] eqs_moves = []
                            for eqs_p in eqs_mdef.params:
                                eqs_borrows.push(eqs_p.ownership == 1)
                                eqs_moves.push(eqs_p.ownership == 2)
                            String eqs_mv_key = eqs_mono_target + "__" + eqs_mdef.name
                            gmod.fn_borrow_params.put(eqs_mv_key.clone(), eqs_borrows)
                            gmod.fn_move_params.put(eqs_mv_key, eqs_moves)
                    clear_type_subs(&gmod)

    # Build trait lookup map for default method generation
    Dict[String, TraitDef] trait_defs = {}
    Dict[String, bool] local_struct_names = {}
    for td_item in m.items:
        match td_item:
            case ITrait(tdef):
                trait_defs.put(tdef.name.clone(), tdef)
            case IStruct(sdef):
                local_struct_names.put(sdef.name.clone(), true)
            case IEnum(edef):
                local_struct_names.put(edef.name.clone(), true)
            else:
                pass

    # FIDELITY Phase 4(a) — `_VTable` struct typedef pre-pass.
    # For each non-generic, non-derive trait with ≥1 INSTANCE method,
    # register a `<MangledTrait>_VTable` struct type so the vtable global's
    # `type_id` resolves to a real LIR struct (→ `struct __gg_<Trait>_VTable`).
    # Mirrors Rust gg's `register_trait_types` VTable struct creation
    # (`src/ir/lowering/traits.rs:174-199`), including its method-less skip
    # (`traits.rs:174: if methods.is_empty(): continue`).
    #
    # Each slot field carries an OPAQUE, NON-resource, NON-keyword
    # `type_name` (`"__vtslot"`) so `resolve_field_lir_type` falls through
    # to `LT_PTR` → `void*` in C (the precise fn-ptr field spellings are a
    # deferred byte-parity concern — see the design's §7e). The opaque name
    # is non-resource so `populate_drop_metadata` emits no spurious slot
    # drop (`drop_fn_for_type` returns "" for it). Field types don't affect
    # the `user_fn_count` metric — only the slot fns' reachability does.
    for vt_item in m.items:
        match vt_item:
            case ITrait(vt_tdef):
                if vt_tdef.type_params.len() == 0 and not is_builtin_trait(vt_tdef.name):
                    Vector[GirFieldInfo] vt_ti_fields = []
                    int vt_slot_idx = 0
                    for vt_slot in vt_tdef.methods:
                        if method_has_self(vt_slot):
                            vt_ti_fields.push(GirFieldInfo("slot" + int_to_str(vt_slot_idx), "__vtslot"))
                            vt_slot_idx += 1
                    # Method-less skip (Fold 2): only register when ≥1 instance slot.
                    if vt_ti_fields.len() > 0:
                        String vt_ti_name = mangle_trait_name(vt_tdef.name) + "_VTable"
                        # (a) GtNamed entry so the struct gets a type id /
                        # `__gg_<Trait>_VTable` c-name; (b) GirTypeInfo so
                        # `lower_type_defs` Pass-1b/Pass-2 register + fill it.
                        int _vt_tid_reg = lookup_or_register_named(&gmod, vt_ti_name)
                        Vector[GirEnumVariantInfo] vt_no_variants = []
                        gmod.type_infos.put(vt_ti_name.clone(), GirTypeInfo(vt_ti_name.clone(), vt_ti_fields, vt_no_variants, false))
            else:
                pass

    # Lower each non-generic function, equip method, and test block
    int test_idx = 0
    for item in m.items:
        match item:
            case IFunction(fdef):
                # Skip generic templates — they'll be monomorphized below
                if fdef.type_params.len() == 0:
                    # Skip extern/forward declarations: the parser loses
                    # the `extern` keyword and `= "symbol"` binding, producing
                    # a function with 0 body statements. The Rust compiler
                    # emits these as `declare extern`, not as `fn @`.
                    if fdef.body.len() > 0:
                        gmod.functions.push(lower_function(fdef, &gmod))
            case IStaticDecl(si_ty, si_name, si_val):
                # Array/dict LITERAL static (`static Vector[T] X = [..]` /
                # `= {..}`): the static was registered in the pre-pass;
                # synthesize + lower its `__gg_static_init_<name>()` init fn
                # HERE, where the full type/fn registry is committed
                # (struct-element sizing for collection literals reads
                # gmod.type_infos). Guarded by `static_is_literal_init` so it
                # stays in lockstep with the pre-pass's literal branch (one
                # synth fn iff an array/dict-literal static was registered).
                # SCALAR-literal statics (`static int x = 0`) take NO synth fn
                # — they registered as a const-bytes global (GGSTATIC_BYTES)
                # whose init_expr is emitted as a const C initializer at the
                # declaration, matching Rust's `GlobalInit::Bytes`
                # (`src/ir/lowering/mod.rs:2459-2461`). The collection-
                # CONSTRUCTOR path (case 2) likewise emits NO synth fn — its
                # init is a direct allocator C-expr.
                if static_is_literal_init(si_val):
                    FunctionDef si_fn = build_static_init_fn(si_ty, si_name, si_val)
                    gmod.functions.push(lower_function(si_fn, &gmod))
            case ITest(tname, decorators, tags, test_body):
                # Skip test blocks when main() exists (normal build mode).
                # Emit __test_N for test-only files (no main).
                if not has_main:
                    # Check for @skip — parser sets "__skip__" sentinel in tags
                    bool is_skipped = false
                    for tag_val in tags:
                        if tag_val == "__skip__":
                            is_skipped = true
                    if not is_skipped:
                        String test_fn_name = "__test_" + int_to_str(test_idx)
                        Vector[int] _lc_stk3 = []
                        Vector[int] _lb_stk3 = []
                        Dict[String, int] _named_locals3 = {}
                        Vector[DropScope] _de_scopes3 = []
                        Vector[DropEmission] _de_queue3 = []
                        Vector[Vector[Stmt]] _on_err_blocks3 = []
                        LowerCtx tctx = LowerCtx([], [], [], 0, !_named_locals3, !_lc_stk3, !_lb_stk3, "", "", "", false, test_fn_name.clone(), DropElaborator(!_de_scopes3), !_de_queue3, -1, !_on_err_blocks3, false)
                        Vector[Instruction] tinit = []
                        tctx.block_insts.push(!tinit)
                        tctx.block_terms.push(GTNone())
                        # Phase 2: function-scope drop frame for test bodies.
                        push_drop_scope(&tctx.drop_elab, DSK_FUNCTION)
                        add_local(&tctx, UNIT_TYPE, NO_NAME)
                        lower_stmts(&tctx, test_body, &gmod, false)
                        Terminator tterm = tctx.block_terms.get(tctx.current_block).unwrap()
                        match tterm:
                            case GTNone():
                                emit_drops_for_early_exit(&tctx, DSK_FUNCTION, Some(0))
                                set_terminator(&tctx, GTReturn(OpConstUnit()))
                            else:
                                pass
                        pop_drop_scope(&tctx)
                        Vector[BasicBlock] tblocks = []
                        int tbi = 0
                        while tbi < tctx.block_insts.len():
                            Vector[Instruction] tinsts = tctx.block_insts.get(tbi).unwrap()
                            Terminator tt = tctx.block_terms.get(tbi).unwrap()
                            tblocks.push(BasicBlock(tinsts, tt))
                            tbi += 1
                        Vector[int] tparams = []
                        gmod.functions.push(GirFunction(test_fn_name, !tparams, UNIT_TYPE, tctx.locals, !tblocks))
                test_idx += 1
            case ISuiteSetup(setup_body):
                if not has_main:
                    Vector[int] sp = []
                    Vector[GirLocal] sl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone(), false)]
                    Vector[BasicBlock] sb = [BasicBlock([], GTReturn(OpConstUnit()))]
                    gmod.functions.push(GirFunction("__suite_setup", !sp, UNIT_TYPE, !sl, !sb))
                    test_idx += 1
            case ISuiteTeardown(teardown_body):
                if not has_main:
                    Vector[int] tp = []
                    Vector[GirLocal] tl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone(), false)]
                    Vector[BasicBlock] tb = [BasicBlock([], GTReturn(OpConstUnit()))]
                    gmod.functions.push(GirFunction("__suite_teardown", !tp, UNIT_TYPE, !tl, !tb))
                    test_idx += 1
            case IEquip(eqblk):
                # Generic equip blocks: emit template for imported types
                # (Rust emits Heap__T__push for imported Heap but not local Stack).
                bool is_generic_equip = false
                String eq_type_name = ""
                int eq_targs_count = 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        eq_type_name = tname
                        eq_targs_count = eq_targs.len()
                        if eq_targs.len() > 0 or eqblk.type_params.len() > 0:
                            is_generic_equip = true
                    else:
                        pass
                if is_generic_equip and eq_type_name.len() > 0 and not local_struct_names.contains(eq_type_name):
                    # Imported generic type: SKIP template emission. Rust gg
                    # elides un-monomorphized generic templates entirely
                    # (mod.rs:525, 1130 — `continue; // Generic functions
                    # handled via monomorphization`); only mono'd instances
                    # reach the lowerer. Templates lowered with bare-T
                    # bodies produce `[bug] EIdentifier: unknown identifier
                    # 'T'` (and same for K/V) — ~58 occurrences across
                    # SetIter/DictIter/etc. The mono'd-equip emission below
                    # (line ~5285) handles the actual call sites.
                    pass
                if is_generic_equip and eq_type_name.len() > 0 and local_struct_names.contains(eq_type_name):
                    # Local generic equip: Rust emits templates ONLY when:
                    #   (a) single type param, no explicit (non-derive) trait, AND
                    #   (b) the type is used in a generic function's params (e.g. unwrap_box[T](Box2[T] b))
                    #       OR has an instantiation with a non-primitive/non-String type arg
                    #       (e.g. Container[Container[int]])
                    # This avoids spurious templates for Stack[T] / Pair[T] which are
                    # only ever used with primitive args and never in generic functions.
                    bool has_explicit_trait = false
                    match eqblk.trait_name:
                        case Some(tn):
                            bool is_derive2 = is_builtin_trait(tn)
                            if not is_derive2:
                                has_explicit_trait = true
                        case None:
                            pass
                    # Check total type param count: target type args + explicit type_params
                    int total_type_params = eq_targs_count + eqblk.type_params.len()
                    if total_type_params == 1 and not has_explicit_trait:
                        # Check if template is needed:
                        # (1) type appears in any generic function's param types
                        bool needs_template = false
                        for gf_item in m.items:
                            match gf_item:
                                case IFunction(fdef):
                                    if fdef.type_params.len() > 0 and not needs_template:
                                        for gfp in fdef.params:
                                            match gfp.param_type.ty:
                                                case TNamed(n, _):
                                                    if n == eq_type_name:
                                                        needs_template = true
                                                else:
                                                    pass
                                else:
                                    pass
                        # (2) any discovered instance has a non-primitive/non-String type arg
                        if not needs_template:
                            for ginst in generic_instances:
                                if ginst.base_name == eq_type_name:
                                    for gta in ginst.type_args:
                                        bool is_simple_arg = false
                                        match gta.ty:
                                            case TPrimitive(_):
                                                is_simple_arg = true
                                            case TNamed(gn, _):
                                                if gn == "String" or gn == "GorgetString" or gn == "bool":
                                                    is_simple_arg = true
                                            else:
                                                pass
                                        if not is_simple_arg:
                                            needs_template = true
                        if needs_template:
                            lower_equip_block(eqblk, &gmod)
                if not is_generic_equip:
                    # For explicit non-derive trait equip: split methods by whether
                    # they're in the trait's OWN vtable vs inherited from a parent.
                    # Inherited overrides use Type__method naming; own use Trait_for_Type__method.
                    bool did_split = false
                    match eqblk.trait_name:
                        case Some(tname):
                            bool is_derive_sp = is_builtin_trait(tname)
                            if not is_derive_sp and trait_defs.contains(tname):
                                did_split = true
                                TraitDef tdef = trait_defs.get(tname).unwrap()
                                # Build set of method names in the trait's OWN vtable
                                Dict[String, bool] own_vtable = {}
                                for tvmeth in tdef.methods:
                                    own_vtable.put(tvmeth.name.clone(), true)
                                # Split equip methods: own vtable vs inherited overrides
                                Vector[FunctionDef] own_methods = []
                                Vector[FunctionDef] inherited_methods = []
                                int smi = 0
                                while smi < eqblk.methods.len():
                                    FunctionDef sm = eqblk.methods.get(smi).unwrap()
                                    if own_vtable.contains(sm.name):
                                        own_methods.push(sm)
                                    else:
                                        inherited_methods.push(sm)
                                    smi += 1
                                # Emit own-vtable methods with Trait_for_Type naming
                                if own_methods.len() > 0:
                                    EquipBlock own_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, own_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    lower_equip_block(own_eqblk, &gmod)
                                # Emit inherited overrides with Type__ naming (no trait prefix)
                                if inherited_methods.len() > 0:
                                    Option[String] inh_no_trait = None
                                    EquipBlock inh_eqblk = EquipBlock(eqblk.target, eqblk.type_params, inh_no_trait, inherited_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    lower_equip_block(inh_eqblk, &gmod)
                                # Collect all overridden method names
                                Dict[String, bool] overridden = {}
                                for om in eqblk.methods:
                                    overridden.put(om.name.clone(), true)
                                String eq_target_sp = type_to_c_name(eqblk.target, &gmod)
                                # Emit own-trait default methods (Trait_for_Type naming)
                                for tmeth2 in tdef.methods:
                                    if tmeth2.body.len() > 0 and not overridden.contains(tmeth2.name):
                                        String dm_trait2 = mangle_trait_name(tname)
                                        String dm_mangled2 = dm_trait2 + "_for_" + eq_target_sp + "__" + tmeth2.name
                                        gmod.functions.push(lower_function(tmeth2, &gmod))
                                        int last_idx2 = gmod.functions.len() - 1
                                        GirFunction last_fn2 = gmod.functions.get(last_idx2).unwrap()
                                        gmod.functions.set(last_idx2, GirFunction(dm_mangled2, last_fn2.param_types, last_fn2.return_type, last_fn2.locals, last_fn2.blocks))
                                # Emit parent trait default methods (Type__ naming, no prefix)
                                for pt_name in tdef.parent_traits:
                                    if trait_defs.contains(pt_name):
                                        TraitDef pt_def = trait_defs.get(pt_name).unwrap()
                                        for pt_meth in pt_def.methods:
                                            if pt_meth.body.len() > 0 and not overridden.contains(pt_meth.name):
                                                String pt_mangled = eq_target_sp + "__" + pt_meth.name
                                                gmod.functions.push(lower_function(pt_meth, &gmod))
                                                int pt_last = gmod.functions.len() - 1
                                                GirFunction pt_last_fn = gmod.functions.get(pt_last).unwrap()
                                                gmod.functions.set(pt_last, GirFunction(pt_mangled, pt_last_fn.param_types, pt_last_fn.return_type, pt_last_fn.locals, pt_last_fn.blocks))
                                                overridden.put(pt_meth.name.clone(), true)
                                # FIDELITY Phase 4(b) — emit the vtable global
                                # for this non-derive trait impl, ONCE per equip.
                                # A struct-of-FuncAddr global whose slots are
                                # `(void*)&<MangledTrait>_for_<target>__<slot>`,
                                # one per INSTANCE trait method. Mirrors Rust gg's
                                # `emit_vtable_globals` (`traits.rs:1015-1037`):
                                # unconditional per-impl, regardless of any
                                # use-site. The FnRef mangling is byte-identical
                                # to the body mangling above (`mangle_trait_name`
                                # + "_for_" + `eq_target_sp` + "__" + slot.name —
                                # same `eq_target_sp` the bodies use), so every
                                # slot resolves to a real emitted fn. Phase 5's
                                # DCE then keeps those bodies live.
                                String vt_struct_name = mangle_trait_name(tname) + "_VTable"
                                int vt_tid = lookup_or_register_named(&gmod, vt_struct_name)
                                Vector[GirGlobalField] vt_fields = []
                                for tslot in tdef.methods:
                                    if method_has_self(tslot):
                                        String impl_fn = mangle_trait_name(tname) + "_for_" + eq_target_sp + "__" + tslot.name
                                        vt_fields.push(GirGlobalField(GGINIT_FN_REF, impl_fn))
                                if vt_fields.len() > 0:
                                    String vt_global_name = mangle_trait_name(tname) + "_for_" + eq_target_sp + "_vtable"
                                    int _vt_gid = gir_mod_add_global(&gmod, GirGlobal(vt_global_name, vt_tid, GGINIT_STRUCT, vt_fields, false))
                        case None:
                            pass
                    if not did_split:
                        lower_equip_block(eqblk, &gmod)
                        # Generate default trait methods not overridden by the equip
                        match eqblk.trait_name:
                            case Some(tname):
                                if trait_defs.contains(tname):
                                    TraitDef tdef = trait_defs.get(tname).unwrap()
                                    # Collect overridden method names
                                    Dict[String, bool] overridden = {}
                                    for om in eqblk.methods:
                                        overridden.put(om.name.clone(), true)
                                    # Emit defaults for trait methods with bodies not in equip
                                    for tmeth in tdef.methods:
                                        if tmeth.body.len() > 0 and not overridden.contains(tmeth.name):
                                            String eq_target = type_to_c_name(eqblk.target, &gmod)
                                            String dm_trait = mangle_trait_name(tname)
                                            String dm_mangled = dm_trait + "_for_" + eq_target + "__" + tmeth.name
                                            gmod.functions.push(lower_function(tmeth, &gmod))
                                            int last_idx = gmod.functions.len() - 1
                                            GirFunction last_fn = gmod.functions.get(last_idx).unwrap()
                                            gmod.functions.set(last_idx, GirFunction(dm_mangled, last_fn.param_types, last_fn.return_type, last_fn.locals, last_fn.blocks))
                            case None:
                                pass
                    # Via delegation: emit stubs for trait methods not explicitly overridden
                    match eqblk.via_field:
                        case Some(_):
                            match eqblk.trait_name:
                                case Some(via_tname):
                                    if trait_defs.contains(via_tname):
                                        TraitDef via_tdef = trait_defs.get(via_tname).unwrap()
                                        Dict[String, bool] via_done = {}
                                        for vom in eqblk.methods:
                                            via_done.put(vom.name.clone(), true)
                                        for via_meth in via_tdef.methods:
                                            if not via_done.contains(via_meth.name):
                                                Vector[FunctionDef] stub_meths = []
                                                stub_meths.push(via_meth)
                                                Option[String] stub_via = None
                                                EquipBlock stub_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, stub_meths, stub_via, eqblk.trait_generic_args)
                                                lower_equip_block(stub_eqblk, &gmod)
                                                via_done.put(via_meth.name.clone(), true)
                                case None:
                                    pass
                        case None:
                            pass
            else:
                pass

    # Emit monomorphized generic functions
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name.
        String fn_key = inst.base_name.clone()
        if not fn_templates.contains(fn_key) and gmod.call_redirects.contains(inst.base_name):
            fn_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(fn_key):
            FunctionDef tmpl = fn_templates.get(fn_key).unwrap()
            # Monomorphized generics use bare names (no module prefix)
            lower_generic_function(tmpl, inst.mangled_name, tmpl.type_params, inst.type_args, &gmod)

    # Emit monomorphized generic equip blocks for discovered type instances
    for einst in generic_instances:
        if equip_generic_names.contains(einst.base_name):
            # Find all equip templates matching this type name
            for equip_tmpl in equip_templates:
                String eq_target_name = ""
                match equip_tmpl.target.ty:
                    case TNamed(tn, _):
                        eq_target_name = tn
                    else:
                        pass
                if eq_target_name == einst.base_name:
                    lower_generic_equip(equip_tmpl, einst.type_args, &gmod)
                    # For generic equip with explicit traits, also emit default trait methods.
                    # These use Type__method naming (no trait prefix).
                    match equip_tmpl.trait_name:
                        case Some(tname):
                            bool is_derive_g = is_builtin_trait(tname)
                            if not is_derive_g and trait_defs.contains(tname):
                                TraitDef gtdef = trait_defs.get(tname).unwrap()
                                # Build set of explicitly implemented methods
                                Dict[String, bool] g_overridden = {}
                                for gom in equip_tmpl.methods:
                                    g_overridden.put(gom.name.clone(), true)
                                # Compute the monomorphized type name for this instance
                                # e.g. Container + [int] -> Container__int64_t
                                String g_mono_name = compute_mangled_name(einst.type_args, einst.base_name)
                                # Emit each unoverridden default method
                                for gtmeth in gtdef.methods:
                                    if gtmeth.body.len() > 0 and not g_overridden.contains(gtmeth.name):
                                        String g_dm_mangled = g_mono_name + "__" + gtmeth.name
                                        gmod.functions.push(lower_function(gtmeth, &gmod))
                                        int g_last = gmod.functions.len() - 1
                                        GirFunction g_last_fn = gmod.functions.get(g_last).unwrap()
                                        gmod.functions.set(g_last, GirFunction(g_dm_mangled, g_last_fn.param_types, g_last_fn.return_type, g_last_fn.locals, g_last_fn.blocks))
                        case None:
                            pass

    # closure Phase 2 Step A: the post-pass — SOLE pusher of
    # __Closure_N__call. Drain gmod.lifted_closures (recorded at the
    # make-site during the lower_function loop). Re-read .len() each
    # iteration (drain-until-empty): lowering a lowerable body re-enters
    # lower_expr, which may APPEND a new record past the current len (e.g.
    # an implicit-it `.map(it*2)` inside a lowerable body — the nested-
    # closure guard doesn't see EImplicitClosure, so such a body IS lowered
    # and its implicit closure is appended mid-drain). The while picks it up.
    # Termination: each record is lowered exactly once and lowering appends
    # only strictly-new records with fresh cids, so `di` advances monotonically.
    int di = 0
    while di < gmod.lifted_closures.len():
        LiftedClosure lc = gmod.lifted_closures.get(di).unwrap()
        # Bind fields to owned locals so the `!abi_param_types` move below
        # doesn't invalidate the rest of `lc` (a field move is a whole-value
        # move at the borrow-check layer).
        String d_call_name = lc.call_name.clone()
        Vector[int] d_abi = lc.abi_param_types.clone()
        int d_self_ptr = lc.self_ptr
        Vector[int] d_body_pt = lc.body_param_types.clone()
        Vector[String] d_body_pn = lc.body_param_names.clone()
        int d_ret = lc.return_type
        Vector[Stmt] d_body = lc.body.clone()
        bool d_lowerable = lc.lowerable
        Vector[ClosureCapture] d_caps = lc.captures.clone()
        if d_lowerable:
            # lower_closure_body pushes the GirFunction itself; lowering its
            # body may append further records (drain-until-empty). Step B:
            # `d_caps` carries the ByValue captures (field-loaded before the
            # body, in env-field/GIFieldLoad-index order).
            lower_closure_body(d_call_name, !d_abi, d_self_ptr, d_body_pt, d_body_pn, d_ret, d_body, d_caps, &gmod)
        else:
            # Phase-1 stub: _0 = return place, _1 = env ptr, then one local
            # per closure param (implicit-it: a single `it` local). Shape is
            # byte-identical to the old scan's stub (explicit + implicit-it).
            Vector[GirLocal] stub_locals = [GirLocal(d_ret, NO_NAME, LoOwned(), BoNone(), false), GirLocal(d_self_ptr, NO_NAME, LoParam(), BoParam(-1), false)]
            int spi = 0
            while spi < d_body_pt.len():
                int spt = d_body_pt.get(spi).unwrap()
                String spn = d_body_pn.get(spi).unwrap()
                stub_locals.push(GirLocal(spt, Some(spn.clone()), LoParam(), BoParam(-1), false))
                spi = spi + 1
            Vector[BasicBlock] stub_blocks = [BasicBlock([], GTReturn(OpCopy(0)))]
            gmod.functions.push(GirFunction(d_call_name, !d_abi, d_ret, !stub_locals, !stub_blocks))
        di = di + 1

    # Scan for spawn wrappers: shared-token and closure/method spawn
    # Two-pass approach:
    # Pass 1: collect ALL shared variable names from ALL functions (so inner
    #         spawns inside nested_driver can see shared vars from main).
    # Pass 2: scan every function body for ESpawn calls.
    Dict[String, bool] shared_vars = {}
    Dict[String, bool] async_fns = {}
    Dict[String, bool] emitted_wrappers = {}
    for sw_item1 in m.items:
        match sw_item1:
            case IFunction(fdef):
                collect_shared_vars(fdef.body, &shared_vars)
            else:
                pass
    for sw_item in m.items:
        match sw_item:
            case IFunction(fdef):
                # Per-function var_types map: variable name → declared type name
                # Used to resolve receiver type for method spawn wrappers.
                Dict[String, String] var_types = {}
                # Collect &-qualified params (OWN_MUTABLE == 1) of this function.
                # These are shared-derived refs; if passed to a spawn, the callee
                # needs a shared-token wrapper (inner shared spawn pattern).
                Dict[String, bool] borrow_params = {}
                for bp in fdef.params:
                    if bp.ownership == 1:
                        borrow_params.put(bp.param_name, true)
                scan_spawn_wrappers(fdef.body, &shared_vars, &async_fns, &emitted_wrappers, &gmod, &var_types, &borrow_params)
            else:
                pass

    # Emit __spawn_wrap___Closure_N stubs for named closure variable spawns.
    # closure Phase 2 Step A: re-pointed to the make-site-recorded cids. The
    # make-site (SVarDecl lowering) recorded `<fn>\0<varname>` →
    # `__Closure_<cid>` into gmod.closure_var_cids, so a `spawn varname()`'s
    # wrapper wires to the closure's make-site cid (matching the post-pass-
    # pushed __Closure_<cid>__call). Replaces the deleted collect_closure_vars_*
    # / ncv_id replay, which re-derived cids in source order — NOT consistent
    # with the make-site cids once test/generic/equip closures precede a
    # named-spawn (the make-site assigns cids in monomorphization order over a
    # SUPERSET of the scan's IFunction/IEquip walk).
    for ncv_item in m.items:
        match ncv_item:
            case IFunction(fdef):
                emit_named_closure_spawn_stmts(fdef.body, fdef.name, &emitted_wrappers, &gmod)
            else:
                pass

    return gmod
