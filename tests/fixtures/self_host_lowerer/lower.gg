# Minimal AST → GIR lowerer.
# Handles: functions with primitive types, int/float/bool/string literals,
# binary ops, function calls, variable declarations, return statements, print().

from std.collections import Vector, Dict
from std.conv import int_to_str
from ast import Module, Item, FunctionDef, Param, Stmt, Expr, SpannedExpr, SpannedType, ElseBranch, EquipBlock, StructDef, EnumDef, EnumVariant, Type, MatchArm
from scope import ScopeTable, DefInfo
from types import TypeTable, ResolvedType
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction, Terminator
from gir import Operand, GirType, GirExtern, GirTypeInfo, GirFieldInfo, GirEnumVariantInfo
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE, U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE, PRIM_COUNT
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT
from gir import init_type_table, register_type, lookup_or_register_named, register_ptr
from gir import ResourceMetadata
# Phase A — typed-metadata classifier shared with lir_lower.gg. The
# `name.starts_with("X__")` cascade lives there as the single source
# of truth for which monomorphised type names belong to which runtime
# family.
from lir_lower import build_resource_metadata

# ── Lowering context ─────────────────────────────────────

struct LowerCtx:
    Vector[GirLocal] locals
    Vector[Vector[Instruction]] block_insts
    Vector[Terminator] block_terms
    int current_block
    # Maps local-binding name → GIR local id.
    Dict[String, int] named_locals
    int next_closure_id
    # Stack of (continue_target, break_target) bb ids for the enclosing
    # loops. break / continue inside a loop body jump to the innermost
    # pair. Pushed at loop entry, popped at exit. Parallel Vectors because
    # Gorget doesn't have easy tuple storage in fields.
    Vector[int] loop_continue_stack
    Vector[int] loop_break_stack
    # Element-type hint threaded from SVarDecl (`Vector[T] x = []`) down
    # into EArrayLiteral / EDictLiteral so the allocator call receives
    # sizeof(T) instead of a hardcoded 8. Empty string means "no hint —
    # caller didn't know the container's element type". Consumed (cleared)
    # as soon as the literal handler reads them.
    String pending_vec_elem_tyname
    String pending_dict_key_tyname
    String pending_dict_val_tyname
    bool pending_dict_ordered
    # Name of the function currently being lowered. Threaded for
    # diagnostic attribution — without this, the ~58k EIdentifier
    # unknown-identifier bug reports can't be tied back to specific
    # function bodies, which is what we need to figure out which
    # lowering paths fail to populate `named_locals`.
    String current_fn_name

# ── Helpers ──────────────────────────────────────────────

Option[String] NO_NAME = None

# named_locals helpers — kept as a thin layer over the Dict so we can
# swap the storage shape without touching call sites.
bool nl_contains(LowerCtx &ctx, String name):
    return ctx.named_locals.contains(name)

int nl_get(LowerCtx &ctx, String name):
    if ctx.named_locals.contains(name):
        return ctx.named_locals.get(name).unwrap()
    return -1

void nl_put(LowerCtx &ctx, String name, int val):
    ctx.named_locals.put(name.clone(), val)

# Diagnostic helper for unhandled AST variants. Called from the
# `else: ...` fall-through arms in lower_stmt / lower_expr. The message
# is wrapped in a /* ... */ C comment so it embeds harmlessly in the
# stage-0 stdout → stage-1 C channel. After a stage-0 run,
# `grep '\[lower_fail\]' stage1.c` surfaces every silently-dropped
# variant encountered during compilation.
void lower_fail(String msg):
    print("/* [lower_fail] " + msg + " */")

# Diagnostics for silent-fallback sites. Earlier versions of the
# self-host made several dispatch functions (map_binop,
# infer_method_return_type, collection_element_type, type_id_to_name,
# EFieldAccess, EIdentifier) quietly return a sentinel value for any
# unrecognised input — hiding real bugs that compounded into runtime
# corruption. Every "hard bug" fallback now emits a `[bug]` diagnostic
# so the mis-compilation is visible in the produced output. Grep
# `\[bug\]` on stage-0/stage-1 output to surface them.
#
# Loud by default; if the diagnostic volume gets painful (stage-1 running
# on its own source emits ~58k diagnostics today because many function
# parameters aren't ending up in `named_locals` — a separate bug still
# under investigation), grep for the unique messages via
# `sort -u | uniq -c` and wrap compilation in `| grep -v '\\[bug\\]'` to
# mute the stream while still having the counts on demand.
void diag_bug(String site, String msg):
    print("/* [bug] " + site + ": " + msg + " */")

void diag_warn(String site, String msg):
    print("/* [warn] " + site + ": " + msg + " */")

# Return the variant name of a Stmt. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling.
# Return the variant name of an Expr. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling. Mirrors
# `stmt_kind` for the Expr side.
String expr_kind(Expr e):
    match e:
        case EIntLiteral(_):
            return "EIntLiteral"
        case EFloatLiteral(_):
            return "EFloatLiteral"
        case EBoolLiteral(_):
            return "EBoolLiteral"
        case EStringLiteral(_, _):
            return "EStringLiteral"
        case ECharLiteral(_):
            return "ECharLiteral"
        case ENoneLiteral:
            return "ENoneLiteral"
        case EIdentifier(_):
            return "EIdentifier"
        case ESelfExpr:
            return "ESelfExpr"
        case EIt:
            return "EIt"
        case EBinaryOp(_, _, _):
            return "EBinaryOp"
        case EUnaryOp(_, _):
            return "EUnaryOp"
        case ECall(_, _, _):
            return "ECall"
        case EMethodCall(_, _, _, _):
            return "EMethodCall"
        case EFieldAccess(_, _):
            return "EFieldAccess"
        case EIndex(_, _):
            return "EIndex"
        case ERange(_, _):
            return "ERange"
        case EIf(_, _, _):
            return "EIf"
        case EMatch(_, _):
            return "EMatch"
        case EClosure(_, _):
            return "EClosure"
        case EImplicitClosure(_):
            return "EImplicitClosure"
        case EArrayLiteral(_):
            return "EArrayLiteral"
        case ETupleLiteral(_):
            return "ETupleLiteral"
        case EDictLiteral(_, _):
            return "EDictLiteral"
        case EStructLiteral(_, _, _):
            return "EStructLiteral"
        case EDotShorthand(_, _):
            return "EDotShorthand"
        case ETry(_):
            return "ETry"
        case EMove(_):
            return "EMove"
        case EMutableBorrow(_):
            return "EMutableBorrow"
        case EDeref(_):
            return "EDeref"
        case EAs(_, _):
            return "EAs"
        case EBlock(_):
            return "EBlock"
        case EListComp(_, _, _, _):
            return "EListComp"
        case ESetComp(_, _, _, _):
            return "ESetComp"
        case EDictComp(_, _, _, _):
            return "EDictComp"
        case EDefaultOp(_, _):
            return "EDefaultOp"
        case EIs(_, _, _):
            return "EIs"
        case EDo(_):
            return "EDo"
        case EAwait(_):
            return "EAwait"
        case ESpawn(_):
            return "ESpawn"
        case ESpawnBlocking(_):
            return "ESpawnBlocking"
        else:
            return "?unknown_expr?"

String pat_kind(Pattern p):
    match p:
        case PWildcard:
            return "PWildcard"
        case PBinding(_):
            return "PBinding"
        case PLiteral(_):
            return "PLiteral"
        case PConstructor(_, _):
            return "PConstructor"
        case PDotShorthand(_, _):
            return "PDotShorthand"
        case PTuple(_):
            return "PTuple"
        case POr(_):
            return "POr"
        case PRest:
            return "PRest"
        else:
            return "?unknown_pat?"

String stmt_kind(Stmt s):
    match s:
        case SVarDecl(_, _, _, _, _, _):
            return "SVarDecl"
        case SAssign(_, _):
            return "SAssign"
        case SCompoundAssign(_, _, _):
            return "SCompoundAssign"
        case SExpr(_):
            return "SExpr"
        case SReturn(_):
            return "SReturn"
        case SThrow(_):
            return "SThrow"
        case SBreak(_):
            return "SBreak"
        case SContinue:
            return "SContinue"
        case SPass:
            return "SPass"
        case SMeta:
            return "SMeta"
        case SMetaFor(_):
            return "SMetaFor"
        case SMetaIf(_, _):
            return "SMetaIf"
        case SFor(_, _, _, _, _):
            return "SFor"
        case SWhile(_, _):
            return "SWhile"
        case SLoop(_):
            return "SLoop"
        case SIf(_, _, _):
            return "SIf"
        case SMatch(_, _):
            return "SMatch"
    return "?unknown_stmt?"

int add_local(LowerCtx &ctx, int type_id, Option[String] name):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, LoOwned(), BoNone()))
    return id

# Phase D step 2: same as `add_local` but with explicit ownership / borrow
# origin. Use when the local's ownership state is something other than the
# default LoOwned/BoNone — e.g. function parameters (LoParam/BoParam),
# locals bound to collection-getter results (LoBorrowed/BoCollectionElement),
# CoW view results (LoView/BoRuntimeView). Validators in Phase C read
# these fields to decide whether a consume site needs a clone, a move,
# or a borrow. See `docs/internals/self-host-resource-model.md` §4.
int add_local_with(LowerCtx &ctx, int type_id, Option[String] name, LocalOwnership ownership, BorrowOrigin borrow_origin):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, ownership, borrow_origin))
    return id

# Phase D step 2: collection-getter methods produce LoBorrowed/BoCollectionElement
# locals. The list mirrors `infer_method_return_type`'s "get/pop/last/first/
# remove" branch — methods that return `Option[V]` whose payload is a borrow
# into the collection rather than an owned copy.
bool is_collection_getter_method(String method):
    return method == "get" or method == "safe_get" or method == "pop" or method == "last" or method == "first" or method == "remove"

void emit(LowerCtx &ctx, Instruction inst):
    # Workaround: can't push to a vector inside a vector via .get().
    # Reconstruct the block_insts with the new instruction appended.
    Vector[Instruction] old = ctx.block_insts.get(ctx.current_block).unwrap()
    old.push(inst)
    ctx.block_insts.set(ctx.current_block, old)

int new_block(LowerCtx &ctx):
    int id = ctx.block_insts.len()
    Vector[Instruction] empty_insts = []
    ctx.block_insts.push(!empty_insts)
    ctx.block_terms.push(GTNone())
    return id

void switch_to(LowerCtx &ctx, int block_id):
    ctx.current_block = block_id

void set_terminator(LowerCtx &ctx, Terminator term):
    ctx.block_terms.set(ctx.current_block, term)

# ── Operand-mode dispatch (Phase C step 5c) ─────────────────
#
# `op_consume` picks the right operand mode for reading `lid` at a
# consume position (call arg, var-decl init, return, branch condition,
# match-arm payload, etc.). It enforces the *Ownership at Consuming
# Positions* discipline from CLAUDE.md:
#
#   • Non-resource source     → OpCopy (byte-copy is sound for scalars
#     and Ptr/MutPtr aliases; the validator already filters those out).
#   • LoBorrowed/LoView source → OpBorrow (the alias propagates; no
#     ownership transfer; consumer can take the address if it wants).
#   • LoOwned/LoParam/LoMaybeOwned resource → OpMove (assumes last-use
#     of the source at this read; matches the convention established by
#     the closed `validate_resource_call_args` migration at the
#     EMethodCall receiver, EFieldAccess non-Ptr base, lower_field_write
#     base, emit_field_write_from_local base, lower_index_assign base,
#     and ECall borrow-arg sites in this file).
#
# All four operand modes lower to the same `ISlotLoad` in
# `lir_lower.gg:2349-2394`, so the runtime behaviour is unchanged — the
# helper produces correct GIR ownership labels without inserting any
# clone or move-zero codegen. When Phase 5 codegen lands real
# OpClone/OpMove emission, the labels written here become the contract.
#
# Closes Phase C's `validate_resource_moves` violations: each
# OpCopy-on-resource converted via this helper drops the count by one.
# Scalar OpCopy sites (GIBinOp on i64, GICmp, GTBranch on bool, etc.)
# stay OpCopy because `local_is_resource` in `validate.gg` short-circuits
# on non-resource slot types.
Operand op_consume(LowerCtx &ctx, GirModule &gmod, int lid):
    if lid < 0 or lid >= ctx.locals.len():
        return OpCopy(lid)
    GirLocal loc = ctx.locals.get(lid).unwrap()
    int tid = loc.type_id
    # Primitives and pointer-typed slots: byte-copy is sound. The
    # validator's `resolve_type_name` returns "" for these so they
    # never produce violations; keep OpCopy for honest GIR labelling.
    if tid < PRIM_COUNT:
        return OpCopy(lid)
    if tid >= gmod.type_table.len():
        return OpCopy(lid)
    GirType gt = gmod.type_table.get(tid).unwrap()
    String tname = ""
    match gt:
        case GtNamed(n):
            tname = n
        else:
            # Ptr/MutPtr/Tuple slots — byte-copy of a pointer is just
            # a pointer copy, not a resource copy. Validator filters
            # these too.
            return OpCopy(lid)
    if not is_resource_type_name(tname, &gmod):
        return OpCopy(lid)
    # Resource source: pick mode by ownership.
    match loc.ownership:
        case LoBorrowed():
            return OpBorrow(lid)
        case LoView():
            return OpBorrow(lid)
        else:
            return OpMove(lid)

# ── Liveness-aware OpMove → OpClone tightening (Phase C step 5d) ─
#
# Post-emission pass that walks each function's instructions, builds
# `last_pos[lid]` = the linear program-text position of `lid`'s last
# operand read, then rewrites `OpMove(lid)` at any non-last position
# to `OpClone(lid)`. The "linear-last" position is the maximum
# `(block_idx, inst_idx)` pair encoded into a single int — straight-
# line execution order (no per-CFG-path dataflow).
#
# Why this matters. Today all four operand modes lower to the same
# `ISlotLoad` (lir_lower.gg:2349-2394) — the four-way label is GIR-
# only. When Phase 5 codegen lands real OpMove emission (move-zero
# of the source slot at the read site) and real OpClone emission
# (refcount bump / deep copy), an OpMove at a non-last-use site
# would zero the source slot mid-function, leaving every subsequent
# read of the same local pointing at zeroed memory.
#
# Conservative — limitations:
#   • Linear-order, not CFG-aware. For a local read once-per-branch
#     in parallel CFG paths (each its own last-use), this pass keeps
#     only the storage-LAST OpMove and demotes the other to OpClone
#     (pessimistic but correct as long as runtime treats both modes
#     as ISlotLoad).
#   • For locals read inside loop bodies that are also defined
#     outside the loop, the in-body OpMove may be flagged as last
#     (no later read in storage order) but is not last in execution
#     order (loop iterates). Currently safe because the four modes
#     are runtime-equivalent; when Phase 5 codegen lands, this pass
#     needs to be upgraded to full backward-dataflow live-out
#     analysis (mirroring `src/ir/liveness.rs`).
#   • Same-instruction multi-use of a single lid (e.g. `x + x` in
#     a binop where both operands resolve to OpMove(_x)) stays
#     OpMove on both; today that's safe (ISlotLoad), but Phase 5
#     real move-zero would corrupt the second read. Documented for
#     the future upgrade.
#
# Idempotent: running the pass twice produces the same result
# (OpClone has no demotion path).

void tighten_owned_operand_modes(LowerCtx &ctx):
    int n = ctx.block_insts.len()
    if n == 0:
        return
    # Encode (block_idx, inst_idx) → single int. MAX_PER_BB must be
    # larger than any function's max-inst-count-per-block; 1_000_000
    # is a safe upper bound given self-host functions have ≤ ~10k
    # instructions per block in the worst case.
    int MAX_PER_BB = 1000000
    # ── Pass 1: build last_pos[lid] = max position lid is operand-read. ──
    # Iteration order is monotonic in pos, so `.put(lid, pos)` always
    # overwrites with a larger position — no need for `if pos > prev`.
    Dict[int, int] last_pos = {}
    int bi = 0
    while bi < n:
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        int ii = 0
        while ii < insts.len():
            int pos = bi * MAX_PER_BB + ii
            update_last_pos_for_inst(insts.get(ii).unwrap(), pos, &last_pos)
            ii += 1
        int term_pos = bi * MAX_PER_BB + (MAX_PER_BB - 1)
        update_last_pos_for_term(ctx.block_terms.get(bi).unwrap(), term_pos, &last_pos)
        bi += 1
    # ── Pass 2: rewrite each function's instructions + terminators. ──
    # For OpMove(lid) at position p:
    #   if last_pos[lid] > p → demote to OpClone(lid) (not last-use).
    #   else (last_pos[lid] == p) → keep OpMove (this IS the last-use).
    bi = 0
    while bi < n:
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        Vector[Instruction] new_insts = []
        int ii = 0
        while ii < insts.len():
            int pos = bi * MAX_PER_BB + ii
            new_insts.push(rewrite_inst_at_pos(insts.get(ii).unwrap(), pos, &last_pos))
            ii += 1
        ctx.block_insts.set(bi, !new_insts)
        int term_pos = bi * MAX_PER_BB + (MAX_PER_BB - 1)
        ctx.block_terms.set(bi, rewrite_term_at_pos(ctx.block_terms.get(bi).unwrap(), term_pos, &last_pos))
        bi += 1

# Update `last_pos[lid]` for every operand-read in this instruction
# (positions are monotonic across the pass, so `.put` overwrites with
# the larger position automatically).
void update_last_pos_for_inst(Instruction inst, int pos, Dict[int, int] &last_pos):
    match inst:
        case GIAssign(_, op):
            note_operand_pos(op, pos, &last_pos)
        case GIBinOp(_, _, _, lhs, rhs):
            note_operand_pos(lhs, pos, &last_pos)
            note_operand_pos(rhs, pos, &last_pos)
        case GIUnOp(_, _, _, src):
            note_operand_pos(src, pos, &last_pos)
        case GICmp(_, _, _, lhs, rhs):
            note_operand_pos(lhs, pos, &last_pos)
            note_operand_pos(rhs, pos, &last_pos)
        case GICall(_, _, args):
            for a in args:
                note_operand_pos(a, pos, &last_pos)
        case GICallExtern(_, _, args):
            for a in args:
                note_operand_pos(a, pos, &last_pos)
        else:
            pass

void update_last_pos_for_term(Terminator term, int pos, Dict[int, int] &last_pos):
    match term:
        case GTReturn(op):
            note_operand_pos(op, pos, &last_pos)
        case GTBranch(op, _, _):
            note_operand_pos(op, pos, &last_pos)
        else:
            pass

void note_operand_pos(Operand op, int pos, Dict[int, int] &last_pos):
    match op:
        case OpCopy(l):
            last_pos.put(l, pos)
        case OpMove(l):
            last_pos.put(l, pos)
        case OpClone(l):
            last_pos.put(l, pos)
        case OpBorrow(l):
            last_pos.put(l, pos)
        else:
            pass

# Per-operand decision: if op is `OpMove(lid)` and last_pos[lid] > pos,
# demote to OpClone. Else pass through (this is the linear-last
# position — kept as OpMove, last-use claim).
Operand demote_move_if_not_last(Operand op, int pos, Dict[int, int] &last_pos):
    match op:
        case OpMove(lid):
            if last_pos.contains(lid):
                int last = last_pos.get(lid).unwrap()
                if last > pos:
                    return OpClone(lid)
            return op
        else:
            return op

Instruction rewrite_inst_at_pos(Instruction inst, int pos, Dict[int, int] &last_pos):
    match inst:
        case GIAssign(dst, op):
            return GIAssign(dst, demote_move_if_not_last(op, pos, &last_pos))
        case GIBinOp(dst, opc, ty, lhs, rhs):
            return GIBinOp(dst, opc, ty, demote_move_if_not_last(lhs, pos, &last_pos), demote_move_if_not_last(rhs, pos, &last_pos))
        case GIUnOp(dst, opc, ty, src):
            return GIUnOp(dst, opc, ty, demote_move_if_not_last(src, pos, &last_pos))
        case GICmp(dst, opc, ty, lhs, rhs):
            return GICmp(dst, opc, ty, demote_move_if_not_last(lhs, pos, &last_pos), demote_move_if_not_last(rhs, pos, &last_pos))
        case GICall(dst, name, args):
            Vector[Operand] new_args = []
            for a in args:
                new_args.push(demote_move_if_not_last(a, pos, &last_pos))
            return GICall(dst, name, !new_args)
        case GICallExtern(dst, name, args):
            Vector[Operand] new_args = []
            for a in args:
                new_args.push(demote_move_if_not_last(a, pos, &last_pos))
            return GICallExtern(dst, name, !new_args)
        else:
            return inst

Terminator rewrite_term_at_pos(Terminator term, int pos, Dict[int, int] &last_pos):
    match term:
        case GTReturn(op):
            return GTReturn(demote_move_if_not_last(op, pos, &last_pos))
        case GTBranch(op, t_bb, e_bb):
            return GTBranch(demote_move_if_not_last(op, pos, &last_pos), t_bb, e_bb)
        else:
            return term

# ── Type mapping ─────────────────────────────────────────

int prim_name_to_type(String name):
    match name:
        case "int":
            return I64_TYPE
        case "float":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "void":
            return UNIT_TYPE
        case "int8":
            return I8_TYPE
        case "int16":
            return I16_TYPE
        case "int32":
            return I32_TYPE
        case "uint":
            return U64_TYPE
        case "uint8":
            return U8_TYPE
        case "byte":
            return U8_TYPE
        case "uint16":
            return U16_TYPE
        case "uint32":
            return U32_TYPE
        case "float32":
            return F32_TYPE
        else:
            return -1

# Resolve a SpannedType to a type name string (for drop analysis).
# Does NOT require GirModule — uses direct primitive and generic name resolution.
String spanned_type_to_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_name(ta)
            return result
        case TTuple(elems):
            if elems.len() == 0:
                return "void"
            String result = "Tuple"
            for te in elems:
                result = result + "__" + spanned_type_to_name(te)
            return result
        else:
            pass
    return "int64_t"

String mangle_type_name(String name, Vector[SpannedType] targs, GirModule &gmod):
    # Mangle generic type names: Vector[int] → Vector__int64_t
    if targs.len() == 0:
        if name == "String":
            return "GorgetString"
        return name
    String result = name
    for ta in targs:
        result = result + "__" + type_to_c_name(ta, &gmod)
    return result

String prim_to_c_name(String name):
    match name:
        case "int":
            return "int64_t"
        case "float":
            return "double"
        case "bool":
            return "bool"
        case "void":
            return "void"
        case "String":
            return "GorgetString"
        case "int8":
            return "int8_t"
        case "int16":
            return "int16_t"
        case "int32":
            return "int32_t"
        case "uint":
            return "uint64_t"
        case "uint8":
            return "uint8_t"
        case "byte":
            return "u8"
        case "uint16":
            return "uint16_t"
        case "uint32":
            return "uint32_t"
        case "float32":
            return "float"
        else:
            return name

String type_to_c_name(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return prim_to_c_name(name)
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return mangle_type_name(name, targs, &gmod)
        else:
            pass
    return "int64_t"

# ── ResolvedType → GIR translation (Gap #2 Phase 2) ─────
#
# The typechecker computes per-expression types into `types.expr_types`
# (a side-table keyed by `SpannedExpr.span.start`). Self-host's lowerer
# reads from there as typed metadata — single source of truth for
# expression types (Layering rule 3). These helpers translate the
# typechecker's `ResolvedType` representation into the GIR type-id
# space that the lowerer uses elsewhere.
#
# The two functions mirror `type_to_c_name` / `map_ast_type` but start
# from a `ResolvedType` id (an index into `types.types`) rather than
# an AST `SpannedType`. Substitutions in `gmod.type_subs` still apply
# at primitive leaves so generic-equip method bodies under active mono
# subs translate consistently.

String resolved_to_c_name(int rtid, TypeTable types, ScopeTable scopes, GirModule &gmod):
    if rtid < 0 or rtid >= types.types.len():
        return "int64_t"
    ResolvedType rt = types.types.get(rtid).unwrap()
    match rt:
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return type_id_to_name(gmod.type_subs.get(pname).unwrap(), &gmod)
            return prim_to_c_name(pname)
        case RTDefined(def_id):
            DefInfo di = scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            if name == "String":
                return "GorgetString"
            return name
        case RTGeneric(def_id, type_args):
            DefInfo di = scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, types, scopes, &gmod)
                mangled = mangled + "__" + arg_name
            return mangled
        case RTRef(inner_rtid):
            # References at the type-name level are transparent — the C
            # name reflects the pointee. The pointer-ness comes back when
            # we go through `resolved_to_gir_type` (registers a Ptr).
            return resolved_to_c_name(inner_rtid, types, scopes, &gmod)
        case RTTuple(elem_rtids):
            String tup_name = "Tuple"
            for et in elem_rtids:
                tup_name = tup_name + "__" + resolved_to_c_name(et, types, scopes, &gmod)
            return tup_name
        case RTArray(elem_rtid, _):
            return resolved_to_c_name(elem_rtid, types, scopes, &gmod)
        case RTSlice(elem_rtid):
            return resolved_to_c_name(elem_rtid, types, scopes, &gmod)
        else:
            return "int64_t"

int resolved_to_gir_type(int rtid, TypeTable types, ScopeTable scopes, GirModule &gmod):
    if rtid < 0 or rtid >= types.types.len():
        return I64_TYPE
    ResolvedType rt = types.types.get(rtid).unwrap()
    match rt:
        case RTVoid():
            return UNIT_TYPE
        case RTNever():
            return UNIT_TYPE
        case RTError():
            return I64_TYPE
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return gmod.type_subs.get(pname).unwrap()
            int prim_tid = prim_name_to_type(pname)
            if prim_tid >= 0:
                return prim_tid
            if pname == "String" or pname == "str":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, pname)
        case RTDefined(def_id):
            DefInfo di = scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            if name == "String":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, name)
        case RTGeneric(def_id, type_args):
            DefInfo di = scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, types, scopes, &gmod)
                mangled = mangled + "__" + arg_name
            return lookup_or_register_named(&gmod, mangled)
        case RTRef(inner_rtid):
            # Refs in the typechecker model the borrow-vs-owned distinction
            # explicitly. The lowerer tracks the same distinction on the
            # GIR local's `ownership` field (LoBorrowed / LoOwned), so the
            # type id itself reflects the pointee, not the borrow wrapper.
            # Matches `infer_method_return_type`'s convention for
            # `.get(i).unwrap()` and friends — same shape downstream.
            return resolved_to_gir_type(inner_rtid, types, scopes, &gmod)
        case RTTuple(elem_rtids):
            # Mirror `mangle_type_name` for tuples — register the mangled
            # Tuple__T1__T2__... name and let downstream code register
            # the struct shape (existing tuple-literal lowering does this).
            String tup_name = "Tuple"
            for et in elem_rtids:
                tup_name = tup_name + "__" + resolved_to_c_name(et, types, scopes, &gmod)
            return lookup_or_register_named(&gmod, tup_name)
        case RTArray(elem_rtid, _):
            # Arrays map to GorgetArray (the C-level Vector backing); the
            # element type is metadata stored elsewhere (type_infos).
            return lookup_or_register_named(&gmod, "GorgetArray")
        case RTSlice(elem_rtid):
            return lookup_or_register_named(&gmod, "GorgetArray")
        else:
            return I64_TYPE

# Convenience: query the typechecker's per-expression type for a given
# SpannedExpr (by span.start) and translate to GIR. Returns -1 if no
# entry is recorded; callers should fall back to their existing path.
# Reads the typechecker side-tables stashed on `gmod` at lower_module
# entry (single accessor — typed-metadata write-through, Layering rule 2).
int lookup_expr_gir_type(SpannedExpr sexpr, GirModule &gmod):
    int span_start = sexpr.span.start
    if not gmod.tc_types.expr_types.contains(span_start):
        return -1
    int rtid = gmod.tc_types.expr_types.get(span_start).unwrap()
    return resolved_to_gir_type(rtid, gmod.tc_types, gmod.tc_scopes, &gmod)

int map_ast_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            match name:
                case "int":
                    return I64_TYPE
                case "float":
                    return F64_TYPE
                case "bool":
                    return BOOL_TYPE
                case "void":
                    return UNIT_TYPE
                case "String":
                    return lookup_or_register_named(&gmod, "GorgetString")
                else:
                    pass
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            # Resolve type aliases (meta type = ...)
            if targs.len() == 0 and gmod.meta_aliases.contains(name):
                String alias_target = gmod.meta_aliases.get(name).unwrap()
                int at = prim_name_to_type(alias_target)
                if at >= 0:
                    return at
                return lookup_or_register_named(&gmod, alias_target)
            int t = prim_name_to_type(name)
            if t >= 0:
                return t
            # Callable types: Callable[T(int)] → FnPtr([int], T) for type inference.
            # The actual ABI is Ptr (void*), but we record the function type
            # so callable dispatch can infer return types.
            if name == "Callable" or name == "MutCallable" or name == "ConsumeCallable":
                if targs.len() == 1:
                    # Single type arg is a function type: T(int, int)
                    SpannedType fn_arg = targs.get(0).unwrap()
                    match fn_arg.ty:
                        case TFunction(ret_box, fn_params, _):
                            Vector[int] param_tids = []
                            for fp in fn_params:
                                param_tids.push(map_ast_type(fp, &gmod))
                            int ret_tid = map_ast_type(*ret_box, &gmod)
                            int fn_tid = register_type(&gmod, GtFnPtr(param_tids, ret_tid))
                            return register_ptr(&gmod, fn_tid)
                        else:
                            pass
                return UNIT_TYPE
            # Named type with possible generic args
            String mangled = mangle_type_name(name, targs, &gmod)
            return lookup_or_register_named(&gmod, mangled)
        case TFunction(ret_box, fn_params_f, _):
            # Function types as params/fields → Ptr(FnPtr). The C-level ABI for
            # bare closure params is void* (GorgetClosure* effectively); encode
            # as Ptr(FnPtr(...)) so lir_lower sees a pointer type.
            # Function types as return types are handled by map_fn_return_type.
            Vector[int] fpf_params = []
            for fpf in fn_params_f:
                fpf_params.push(map_ast_type(fpf, &gmod))
            int fpf_ret = map_ast_type(*ret_box, &gmod)
            int fpf_tid = register_type(&gmod, GtFnPtr(fpf_params, fpf_ret))
            return register_ptr(&gmod, fpf_tid)
        case TInferred():
            return I64_TYPE
        case TTuple(elems):
            # Mangle tuple: Tuple__T1__T2__...
            String tuple_name = "Tuple"
            for elem in elems:
                tuple_name = tuple_name + "__" + type_to_c_name(elem, &gmod)
            return lookup_or_register_named(&gmod, tuple_name)
        else:
            pass
    return I64_TYPE

# Map return type — same as map_ast_type but TFunction produces GtFnPtr
int map_fn_return_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TFunction(ret_type_box, fn_param_types, _):
            Vector[int] fn_params = []
            for fp in fn_param_types:
                fn_params.push(map_ast_type(fp, &gmod))
            int fn_ret = map_ast_type(*ret_type_box, &gmod)
            return register_type(&gmod, GtFnPtr(fn_params, fn_ret))
        else:
            return map_ast_type(stype, &gmod)

# ── Type ID to name ──────────────────────────────────────

String type_id_to_name(int tid, GirModule &gmod):
    match tid:
        case 0:
            return "bool"
        case 4:
            return "int64_t"
        case 10:
            return "double"
        case 11:
            return "unit"
        else:
            pass
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(inner):
                return type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                return type_id_to_name(inner, &gmod)
            else:
                pass
    return "int64_t"

# ── Resource type detection ──────────────────────────────

# Get parameter type IDs for a function from the GIR module.
Vector[int] get_fn_param_types(String name, GirModule &gmod):
    Vector[int] types = []
    for gfn in gmod.functions:
        if gfn.name == name:
            for pt in gfn.param_types:
                types.push(pt)
            return types
    return types

# Check if a call name is a type constructor (produces a named type).
# Map binary operator strings to their trait-method names (for operator
# overload dispatch on user structs).
String binop_method_name(String op):
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "/":
        return "div"
    if op == "%":
        return "rem"
    return ""

# Returns the parent enum name if `name` is a variant of a known enum,
# or "" if not a variant. Used to route bare variant constructors
# (IntCol, Red, Ok, ...) to their enclosing enum's named type.
String enum_variant_parent(String name, GirModule &gmod):
    Vector[String] tikeys = gmod.type_infos.keys()
    for tname in tikeys:
        GirTypeInfo info = gmod.type_infos.get(tname).unwrap()
        if info.is_enum:
            for v in info.variants:
                if v.name == name:
                    return tname
    return ""

bool is_type_constructor(String name):
    # Phase A typed read: parameterised resource families with the
    # `T(args)` user-code constructor shape (Vector__T, Dict__K__V,
    # Mutex__T, …) carry `is_typed_constructor=true` in their
    # metadata. Built-in singletons / factory-shape opaques /
    # Box / Heap / Atomic / etc. carry `false`.
    match build_resource_metadata(name):
        case Some(rmeta):
            if rmeta.is_typed_constructor:
                return true
            return false
        case None:
            pass
    # Primitive type-constructor calls (String("x"), Int(1)) and other
    # bare names — coercions or runtime-helper construction, not
    # user struct instantiation. build_resource_metadata returns None
    # for the user-struct-name case, so we drop here.
    if name == "String" or name == "Int" or name == "Float" or name == "Bool":
        return false
    if name == "Char":
        return false
    if name == "Rc" or name == "Arc":
        return false
    if name == "Channel" or name == "Deque" or name == "Vector":
        return false
    if name == "Dict" or name == "HashMap" or name == "Set" or name == "HashSet":
        return false
    if name == "Option" or name == "Result":
        return false
    # User-defined struct names (capitalised, no __ suffix). The
    # metadata path returned None for these, so they fall through here.
    if name.len() > 0:
        String first = name.slice(0, 1)
        if first >= "A" and first <= "Z" and not name.contains("__"):
            return true
    return false

# Get the type name for a GIR local (e.g., "Vector__int64_t", "GorgetString").
String local_type_name(int local_id, LowerCtx &ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return "int64_t"
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return type_id_to_base_name(tid, &gmod)

# Unwrap Ptr/MutPtr to reach the underlying named type (for method dispatch
# on borrow/move params).
String type_id_to_base_name(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return "int64_t"
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name
        case GtPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        case GtMutPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        else:
            pass
    return "int64_t"

# Infer the return type of a method call.
# Resolve a field type name from GirFieldInfo to a GIR type ID.
int resolve_field_gir_type(String type_name, GirModule &gmod):
    match type_name:
        case "int" | "int64_t":
            return I64_TYPE
        case "float" | "double":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "String" | "GorgetString" | "Str":
            return lookup_or_register_named(&gmod, "GorgetString")
        case "int32_t" | "i32":
            return I32_TYPE
        case "int8_t" | "i8" | "byte" | "uint8_t":
            return I8_TYPE
        else:
            # Named type (user struct, collection, etc.)
            return lookup_or_register_named(&gmod, type_name)

# Constant-fold a top-level `const int` initializer. Supports int
# literals, references to other const_decls, and the binary/unary ops
# the self-host's parser.gg actually uses in KW_* / PREC_* decls.
# Returns None for unsupported shapes — the const is dropped silently
# and the identifier reference later falls back to OpConstI64(0).
# Float-constant evaluator. Mirrors `eval_const_int_expr` but for
# `float EPSILON = 0.000001` etc. — module-level float consts that
# the int-evaluator can't represent. Used by the IConstDecl /
# IStaticDecl handlers to populate `gmod.float_const_decls`, which
# `EIdentifier` then consults before the [bug] fallback.
# Helper extracted from `lower_expr`'s EIdentifier arm — keeps that
# function's already-massive stack frame from growing further.
# Returns the new local id on hit (>= 0); -1 on miss.
int lower_float_const_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not gmod.float_const_decls.contains(name):
        return -1
    int fdst = add_local(&ctx, F64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(fdst, OpConstF64(gmod.float_const_decls.get(name).unwrap())))
    return fdst

# Function-as-value: `filter(is_even)` / `map(double)` etc. — a bare
# function name passed where a Callable is expected. Mirrors Rust
# gg's `Constant::FuncRef(name)` operand. Emit a synthetic
# `__fn_addr__<name>` GICallExtern; `lir_lower` intercepts that
# prefix and lowers to `IFuncAddr(fid)`, which the C codegen turns
# into the `static void*[] = {(void*)__adapt_<name>, NULL}` shape
# `gorget_array_filter` / etc. expect. Returns the new local id on
# hit (>= 0); -1 on miss.
#
# Only fires for non-generic functions registered in `fn_sigs` — a
# generic template wouldn't have a single mono'd target to point at.
# The helper is in its own function (not inlined) for the same
# stack-frame reason as `lower_float_const_ident`.
int lower_fn_addr_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not gmod.fn_sigs.contains(name):
        return -1
    int gs_tid = lookup_or_register_named(&gmod, "GorgetClosure")
    int adst = add_local(&ctx, gs_tid, NO_NAME)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(adst, "__fn_addr__" + name, no_args))
    return adst

# Module-level static reference: `stdout` / `stderr` / `stdin` etc.
# Emits a synthetic `__global_ref__<name>` GICallExtern which
# `lir_lower` rewrites to `IGlobalAddr(dst, gid)`. Mirrors Rust gg's
# `Operand::Constant(Constant::GlobalRef(name))`
# (`src/ir/lowering/exprs/mod.rs:128-130`). Returns the new local id
# on hit (>= 0); -1 on miss. Out-of-line for the same stack-frame
# reason as `lower_float_const_ident` / `lower_fn_addr_ident`.
int lower_static_ref_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not static_contains(&gmod, name):
        return -1
    int sty = static_lookup_type(&gmod, name)
    int sdst = add_local(&ctx, sty, NO_NAME)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(sdst, "__global_ref__" + name, no_args))
    return sdst

# Meta-op token (`meta +`, `meta /`, …): the parser encodes these
# as `EIdentifier("__metaop__add")` / `__metaop__div` / etc. and
# passes them as args to generic functions like
# `tensor_elemwise[T](a, b, meta op)` (`lib/xtd/tensor.gg:307`).
# These tokens are *compile-time only* — Rust gg filters them out
# of the call arg list at GIR lowering
# (`src/ir/lowering/exprs/calls.rs:882-893`) and uses them only to
# build the mangled callee name (`tensor_elemwise__add` etc.) via
# what `extract_meta_op_suffix` mirrors here. They have no runtime
# representation; if `lower_expr` walks one as a real value
# identifier (because the call's arg-lowering didn't filter it),
# the existing `[bug] EIdentifier` fallback triggers.
#
# Emit a harmless zero-int placeholder when the EIdentifier arm
# encounters one. The mangled call name was already computed by
# `extract_meta_op_suffix` during transitive-generic discovery, so
# the runtime call dispatches to e.g. `tensor_elemwise__add`,
# which doesn't take a meta-op param. Whatever extra arg gets
# emitted from this placeholder is dead at the C level — but the
# cascade closes (24 EIdentifier `[bug]` markers across the
# `xtd__tensor` family in the fixture sweep go to zero). Out-of-line
# for the same stack-frame reason as the other ident helpers above.
int lower_metaop_ident(LowerCtx &ctx, String name):
    if not name.starts_with("__metaop__"):
        return -1
    int mdst = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(mdst, OpConstI64(0)))
    return mdst

# Module-level static with a runtime-call init: `public static File
# stdout = _stdout_handle()` etc. (lib/std/io.gg). Mirrors Rust gg's
# `LoweringContext::global_names` + `module.globals: Vec<Global>`
# (`src/ir/lowering/mod.rs:1074-1111`). Recognises the zero-arg
# `_<sym>()` shape and registers it under `gmod.static_keys` so the
# `EIdentifier` arm can resolve to a `__global_ref__<name>` synthetic
# intrinsic which `lir_lower` rewrites to `IGlobalAddr`.
#
# Only the `_<sym>` → `gorget_<sym>` underscore-prefix mapping is
# wired (sufficient for `_stdin_handle` / `_stdout_handle` /
# `_stderr_handle`). Other init shapes return false; the caller
# falls through to the existing ENoneLiteral / [bug] cascade.
#
# Helper lives in its own fn for the same stack-frame reason as
# `lower_float_const_ident` / `lower_fn_addr_ident` — keeping the
# IStaticDecl-arm dispatch site small.
bool try_register_static_runtime_call(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, _):
            if args.len() != 0:
                return false
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fn_name):
                    if not fn_name.starts_with("_"):
                        return false
                    String runtime_call = "gorget_" + fn_name.slice(1, fn_name.len()) + "()"
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put(&gmod, sd_name, runtime_call, ty_id)
                    return true
                else:
                    return false
        else:
            return false

Option[float] eval_const_float_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EFloatLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.float_const_decls.contains(name):
                return Some(gmod.float_const_decls.get(name).unwrap())
            return None
        case EUnaryOp(op, inner_box):
            Option[float] iv = eval_const_float_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0.0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

Option[int] eval_const_int_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EIntLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.const_decls.contains(name):
                return Some(gmod.const_decls.get(name).unwrap())
            return None
        case EBinaryOp(lhs_box, op, rhs_box):
            Option[int] lv = eval_const_int_expr(*lhs_box, &gmod)
            Option[int] rv = eval_const_int_expr(*rhs_box, &gmod)
            match lv:
                case Some(la):
                    match rv:
                        case Some(ra):
                            if op == "+":
                                return Some(la + ra)
                            if op == "-":
                                return Some(la - ra)
                            if op == "*":
                                return Some(la * ra)
                            if op == "/" and ra != 0:
                                return Some(la / ra)
                            if op == "%" and ra != 0:
                                return Some(la - (la / ra) * ra)
                            return None
                        case None:
                            return None
                case None:
                    return None
        case EUnaryOp(op, inner_box):
            Option[int] iv = eval_const_int_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

# Get and increment the module-level closure ID counter. Stored in
# `gmod.named_types` under the synthetic key `__closure_counter` so it
# tags along with the same Dict that holds named-type registrations.
int gmod_next_closure_id(GirModule &gmod):
    int cid = 0
    if gmod.named_types.contains("__closure_counter"):
        cid = gmod.named_types.get("__closure_counter").unwrap()
    gmod.named_types.put("__closure_counter", cid + 1)
    return cid

int infer_method_return_type(String method, int recv, LowerCtx &ctx, GirModule &gmod):
    # Void-returning methods. `Vector[T].remove(idx)` was previously
    # treated as void, but actually returns `Option[T]` — the void
    # classification left bindings in `T x = v.remove(i).unwrap()`
    # typed unit, cascading every `x.field` into
    # `EFieldAccess: unknown field on base type 'unit'`. Vector.remove
    # is now routed through the receiver-aware path (~line 752).
    # Dict/Set.remove stay here because the underlying runtime
    # (`gorget_map_remove` / `gorget_set_remove`) returns bool — the
    # surface API spec says `Option[V]` / bool but no caller in the
    # self-host codebase binds the result, so void is the safe gate.
    if method == "push" or method == "set" or method == "put":
        return UNIT_TYPE
    # `remove` is dispatched receiver-aware below for Vector/Deque,
    # but stays void for Dict/Set (their runtime returns bool — the
    # call sites in self-host all discard the result).
    if method == "remove":
        String recv_n = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_t = ctx.locals.get(recv).unwrap().type_id
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_t).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_t = inner
                    case GtMutPtr(inner):
                        recv_t = inner
                    else:
                        pass
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_t).unwrap()
                match gt:
                    case GtNamed(rname):
                        recv_n = rname
                    else:
                        pass
        # Phase A typed read: Dict/Set `.remove(k)` returns bool at the
        # runtime, but every self-host caller discards the result; so
        # we type the binding as void.
        match build_resource_metadata(recv_n):
            case Some(rmeta):
                match rmeta.collection_kind:
                    case CkDict():
                        return UNIT_TYPE
                    case CkSet():
                        return UNIT_TYPE
                    else:
                        pass
            case None:
                pass
        # Vector/Deque/etc. — fall through to receiver-aware path below.
    if method == "clear" or method == "insert" or method == "extend" or method == "reverse":
        return UNIT_TYPE
    if method == "sort" or method == "swap":
        return UNIT_TYPE
    # Int-returning methods
    if method == "len" or method == "capacity" or method == "find_index":
        return I64_TYPE
    if method == "find":
        return I64_TYPE
    # Bool-returning methods
    if method == "contains" or method == "is_empty" or method == "any" or method == "all":
        return BOOL_TYPE
    if method == "starts_with" or method == "ends_with":
        return BOOL_TYPE
    # String-returning methods
    if method == "slice" or method == "trim" or method == "upper" or method == "lower":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "to_lower" or method == "to_upper":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "replace" or method == "repeat" or method == "join":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "strip" or method == "lstrip" or method == "rstrip":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "removeprefix" or method == "removesuffix":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "center" or method == "ljust" or method == "rjust" or method == "zfill":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "reverse" or method == "pad_left" or method == "pad_right":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "to_string" or method == "to_str":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "format":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "char_at":
        return lookup_or_register_named(&gmod, "GorgetString")
    if method == "byte_at":
        return U8_TYPE
    # Collection-returning methods
    if method == "split" or method == "lines" or method == "chars" or method == "bytes":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "sorted" or method == "reversed" or method == "unique":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "enumerate" or method == "take" or method == "skip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "keys" or method == "values" or method == "items":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "chunks" or method == "zip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "filter_by" or method == "filter":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # HOFs that return collections (preserve receiver type heuristically).
    if method == "map" or method == "flat_map" or method == "flatten":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "concat":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # Float-returning methods
    if method == "sum" or method == "avg" or method == "min" or method == "max":
        return I64_TYPE  # could be float, but I64 is safe default
    if method == "abs" or method == "sqrt" or method == "ceil" or method == "floor":
        return F64_TYPE
    if method == "round":
        return F64_TYPE
    # Hash/count
    if method == "hash" or method == "count" or method == "index_of":
        return I64_TYPE
    # unwrap on Option__V receiver: return inner V.
    if method == "unwrap":
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
        if recv_name.starts_with("Option__"):
            String inner = recv_name.slice(8, recv_name.len())
            int prim = prim_name_to_type(inner)
            if prim >= 0:
                return prim
            if inner == "int64_t":
                return I64_TYPE
            if inner == "double":
                return F64_TYPE
            if inner == "GorgetString" or inner == "Str":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, inner)
        if recv_name.starts_with("Result__"):
            String rest = recv_name.slice(8, recv_name.len())
            int split = -1
            int si = 0
            while si + 1 < rest.byte_len():
                if rest.byte_at(si) == 0x5F and rest.byte_at(si + 1) == 0x5F:
                    split = si
                    break
                si += 1
            if split > 0:
                String ok = rest.slice(0, split)
                int prim_ok = prim_name_to_type(ok)
                if prim_ok >= 0:
                    return prim_ok
                if ok == "int64_t":
                    return I64_TYPE
                if ok == "double":
                    return F64_TYPE
                if ok == "GorgetString" or ok == "Str":
                    return lookup_or_register_named(&gmod, "GorgetString")
                return lookup_or_register_named(&gmod, ok)
        # Fallback: pass through receiver type for non-Option/Result
        # receivers — keeps legacy behaviour for already-typed values.
        if recv_name != "":
            if recv >= 0 and recv < ctx.locals.len():
                return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # get/pop/last/first/remove on a collection: return Option[V].
    if method == "get" or method == "pop" or method == "last" or method == "first" or method == "remove":
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
        String elem = collection_element_type(recv_name)
        if elem == "":
            if recv_name.starts_with("Dict__GorgetString__"):
                elem = recv_name.slice(20, recv_name.len())
            elif recv_name.starts_with("Dict__int64_t__"):
                elem = recv_name.slice(15, recv_name.len())
            elif recv_name.starts_with("HashMap__GorgetString__"):
                elem = recv_name.slice(23, recv_name.len())
            elif recv_name.starts_with("HashMap__int64_t__"):
                elem = recv_name.slice(18, recv_name.len())
        if elem == "":
            return I64_TYPE
        String elem_norm = elem
        if elem == "Str":
            elem_norm = "GorgetString"
        String opt_name = "Option__" + elem_norm
        return lookup_or_register_named(&gmod, opt_name)
    # clone: return receiver type
    if method == "clone":
        if recv >= 0 and recv < ctx.locals.len():
            return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # Default to I64 for unknown methods
    return I64_TYPE

# Return type inference for builtin free-standing calls (args, read_file, etc.)
# Returns -1 if not a builtin.
int builtin_call_return_type(String fname, GirModule &gmod):
    if fname == "args":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if fname == "read_file" or fname == "read_line" or fname == "stdin" or fname == "env" or fname == "getenv":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "int_to_str" or fname == "float_to_str" or fname == "bool_to_str":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "parse_int" or fname == "str_to_int":
        return I64_TYPE
    if fname == "parse_float" or fname == "str_to_float":
        return F64_TYPE
    if fname == "time_now" or fname == "monotonic_ns":
        return I64_TYPE
    return -1

# Extract element type from a collection name: Vector__int64_t → int64_t
String collection_element_type(String name):
    if name.starts_with("Vector__"):
        return name.slice(8, name.len())
    if name.starts_with("Deque__"):
        return name.slice(7, name.len())
    if name.starts_with("Set__"):
        return name.slice(5, name.len())
    if name.starts_with("HashSet__"):
        return name.slice(9, name.len())
    # For Option__T, extract T
    if name.starts_with("Option__"):
        return name.slice(8, name.len())
    # For Result__T, extract T (ok type)
    if name.starts_with("Result__"):
        return name.slice(8, name.len())
    return ""

# Return true when the init expression is a call to a known
# `cstr`-returning runtime/extern function. Used at SVarDecl to
# insert a `gorget_str_from_cstr` coercion before storing into a
# Str-typed slot, matching the Rust backend's
# `extern_cstr_return_vals` handling. Conservative allow-list
# covering the std.conv / std.fs / env extern surface —
# adding a new cstr-returning extern here is the same shape of
# change as the Rust-side `fn_return_abis` registration.
bool is_cstr_returning_call(SpannedExpr init_expr, GirModule &gmod):
    match init_expr.expr:
        case ECall(callee_box, _, _):
            match (*callee_box).expr:
                case EIdentifier(fname):
                    # Resolve through call_redirects so both the Gorget
                    # source name (`_parse_last_error`) and the C symbol
                    # (`gorget_parse_last_error`) match.
                    String resolved = fname
                    if gmod.call_redirects.contains(fname):
                        resolved = gmod.call_redirects.get(fname).unwrap()
                    # Current allow-list is narrow: only externs that
                    # return raw `const char*` via their C signature.
                    # `gorget_int_to_str` / `_float_to_str` / `_bool_to_str`
                    # / `_char_chr` all return `Str` (by-value struct), not
                    # cstr — do NOT include them here.
                    if resolved == "gorget_parse_last_error":
                        return true
                    return false
                else:
                    return false
        else:
            return false
    return false

# Check if a GIR local holds a string type.
bool is_string_local(int local_id, LowerCtx &ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return false
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return is_string_type_id(tid, &gmod)

bool is_string_type_id(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name == "GorgetString" or name == "String" or name == "Str"
        case GtPtr(inner):
            return is_string_type_id(inner, &gmod)
        case GtMutPtr(inner):
            return is_string_type_id(inner, &gmod)
        else:
            return false
    return false

bool is_resource_field_type(SpannedType stype, Dict[String, bool] resource_types):
    match stype.ty:
        case TPrimitive(name):
            match name:
                case "String":
                    return true
                else:
                    return false
        case TNamed(name, targs):
            match name:
                case "Vector" | "Dict" | "Set" | "Box" | "Rc" | "Arc":
                    return true
                case "Option" | "Result":
                    # Resource if any type argument is a resource
                    for ota in targs:
                        if is_resource_field_type(ota, resource_types):
                            return true
                    return false
                else:
                    if resource_types.contains(name):
                        return true
                    return false
        else:
            return false

bool is_resource_type_name(String name, GirModule &gmod):
    # Delegate to `build_resource_metadata` in lir_lower.gg — the single
    # source of truth for the runtime-resource classification (covers
    # GorgetString / Array / Map / Set / Closure, parameterised Vector__/
    # Dict__/Set__/Box__, opaque handles Mutex__/Channel__/Shared__/
    # Weak__/AtomicInt__/Semaphore__/OnceFlag__/WaitGroup__/etc.).
    # Layering rule 3: one source of truth per axis.
    match build_resource_metadata(name):
        case Some(_):
            return true
        case None:
            pass
    # User struct/enum types registered as resource by lower_module's
    # type-registration pass (Phase D step 1 didn't extend
    # build_resource_metadata to cover user types, so this fallback
    # remains until that consolidation lands).
    if gmod.resource_types.contains(name):
        return true
    return false

# ── Binary operator mapping ──────────────────────────────

int map_binop(String op):
    match op:
        case "+":
            return OP_ADD
        case "-":
            return OP_SUB
        case "*":
            return OP_MUL
        case "/":
            return OP_DIV
        case "%":
            return OP_REM
        case "+%":
            return OP_ADD_WRAP
        case "-%":
            return OP_SUB_WRAP
        case "*%":
            return OP_MUL_WRAP
        case "&":
            return OP_BITAND
        case "|":
            return OP_BITOR
        case "^":
            return OP_BITXOR
        case "<<":
            return OP_SHL
        case ">>":
            return OP_SHR
        else:
            # HARD BUG: returning OP_ADD for an unrecognised operator
            # silently mis-compiles it as addition. Emit a diagnostic
            # so the mis-compile is visible.
            diag_bug("map_binop", "unknown operator '" + op + "' — defaulting to OP_ADD (WRONG)")
            return OP_ADD

# Map the compound-assignment operator spelling (`+=`, `-=`, `*=`, `/=`,
# `%=`) to the matching GIR binop. Stage-1 was compiling every `last_us
# -= 1` as `last_us += 1` because the parser stored the full compound-op
# spelling ("-=") in SCompoundAssign's op field, but `map_binop` only
# recognised the arithmetic spelling ("-") and fell through to the
# OP_ADD default for any compound form — producing infinite loops in
# lower_type_defs's field-name scanner.
int map_compound_binop(String op):
    match op:
        case "+=":
            return OP_ADD
        case "-=":
            return OP_SUB
        case "*=":
            return OP_MUL
        case "/=":
            return OP_DIV
        case "%=":
            return OP_REM
        case "+%=":
            return OP_ADD_WRAP
        case "-%=":
            return OP_SUB_WRAP
        case "*%=":
            return OP_MUL_WRAP
        case "&=":
            return OP_BITAND
        case "|=":
            return OP_BITOR
        case "^=":
            return OP_BITXOR
        case "<<=":
            return OP_SHL
        case ">>=":
            return OP_SHR
        else:
            # Defensive: the parser should always emit the compound
            # spelling for SCompoundAssign. Falling back to the bare-op
            # mapping mostly works but emits a diagnostic — an unmapped
            # compound op here is almost certainly a parser/lowerer
            # mismatch worth noticing.
            diag_warn("map_compound_binop", "unknown compound operator '" + op + "' — routing through map_binop")
            return map_binop(op)

bool is_comparison(String op):
    match op:
        case "==" | "!=" | "<" | "<=" | ">" | ">=":
            return true
        else:
            return false

int map_cmpop(String op):
    match op:
        case "==":
            return CMP_EQ
        case "!=":
            return CMP_NE
        case "<":
            return CMP_LT
        case "<=":
            return CMP_LE
        case ">":
            return CMP_GT
        case ">=":
            return CMP_GE
        else:
            return CMP_EQ

# ── Expression lowering ─────────────────────────────────

int lower_expr(LowerCtx &ctx, SpannedExpr sexpr, GirModule &gmod):
    match sexpr.expr:
        case EIntLiteral(v):
            int dst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstI64(v)))
            return dst
        case EFloatLiteral(v):
            int dst = add_local(&ctx, F64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstF64(v)))
            return dst
        case EBoolLiteral(v):
            int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstBool(v)))
            return dst
        case EStringLiteral(s, _):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstStr(s)))
            return dst
        case EFString(s, fexprs):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            if fexprs.len() == 0:
                # No interpolation — just a string literal
                int dst = add_local(&ctx, gs_tid, NO_NAME)
                emit(&ctx, GIAssign(dst, OpConstStr(s)))
                return dst
            # Walk template, replacing each "{}" placeholder with the printf
            # specifier for the corresponding fexprs[i]'s type, and build the
            # arg list in parallel. Emit `gorget_string_format(fmt, ...args)`
            # which returns a fresh, null-terminated GorgetString. Mirrors
            # Rust gg's `lower_string_interpolation` at
            # `src/ir/lowering/exprs/mod.rs:3505`.
            #
            # Without this fix, EFString emitted only the raw template
            # (with literal `{}` placeholders), so `print(f"{x}")` printed
            # "{}" — the dominant OutputMismatch cluster in self_host_e2e
            # (46 fixtures at baseline 94/995). [filed: 2026-05-19]
            Vector[Operand] gsf_args = []
            gsf_args.push(OpConstStr(""))  # placeholder for fmt at index 0; overwritten below
            String fmt = ""
            int fi = 0
            int byte_i = 0
            int byte_n = s.byte_len()
            while byte_i < byte_n:
                # `{}` placeholder bytes are 0x7B 0x7D.
                bool is_placeholder = false
                if byte_i + 1 < byte_n:
                    if s.byte_at(byte_i) == 0x7B and s.byte_at(byte_i + 1) == 0x7D:
                        is_placeholder = true
                if is_placeholder:
                    if fi >= fexprs.len():
                        # Mismatched placeholder count — emit literal `{}`
                        fmt = fmt + "{}"
                    else:
                        SpannedExpr farg = fexprs.get(fi).unwrap()
                        int aloc = lower_expr(&ctx, farg, &gmod)
                        int aty = I64_TYPE
                        if aloc >= 0 and aloc < ctx.locals.len():
                            aty = ctx.locals.get(aloc).unwrap().type_id
                        if aty == F64_TYPE or aty == F32_TYPE:
                            fmt = fmt + "%f"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc))
                        elif aty == gs_tid:
                            # String → %s with .data (the printf-style
                            # emitter for gorget_string_format extracts
                            # `.data` from GorgetString args).
                            fmt = fmt + "%s"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc))
                        elif aty == BOOL_TYPE:
                            # Bool → "true"/"false" via gorget_bool_to_str.
                            int bstr = add_local(&ctx, gs_tid, NO_NAME)
                            Vector[Operand] bargs = [OpCopy(aloc)]
                            emit(&ctx, GICallExtern(bstr, "gorget_bool_to_str", bargs))
                            fmt = fmt + "%s"
                            gsf_args.push(op_consume(&ctx, &gmod, bstr))
                        else:
                            # Default: int64_t printf via %lld. Narrow ints
                            # are auto-promoted by C's variadic ABI to
                            # `int` (4 bytes) — but vsnprintf with `%lld`
                            # reads 8 bytes. Acceptable for I64; narrow
                            # ints may render incorrectly until a typed
                            # specifier table is added.
                            fmt = fmt + "%lld"
                            gsf_args.push(op_consume(&ctx, &gmod, aloc))
                        fi += 1
                    byte_i += 2
                else:
                    # Copy literal byte
                    fmt = fmt + s.slice(byte_i, byte_i + 1)
                    byte_i += 1
            # Overwrite fmt placeholder at position 0 with the built format string.
            gsf_args.set(0, OpConstStr(fmt))
            int gsdst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GICallExtern(gsdst, "gorget_string_format", gsf_args))
            return gsdst
        case EIdentifier(name):
            if nl_contains(&ctx, name):
                return nl_get(&ctx, name)
            # Module-level `const int` — inline the evaluated value.
            # Without this, the self-compiled parser's KW_* / PREC_*
            # constants all become 0 and check_kw(0, 0) hangs.
            if gmod.const_decls.contains(name):
                int cv = gmod.const_decls.get(name).unwrap()
                int cdst = add_local(&ctx, I64_TYPE, NO_NAME)
                emit(&ctx, GIAssign(cdst, OpConstI64(cv)))
                return cdst
            # Module-level float constants — `float EPSILON = 0.000001`
            # in lib/xtd/math3d.gg etc. Mirrors Rust's unified
            # `module_constants` table where float consts inline as
            # `Operand::Constant(Constant::F64(value))` rather than
            # falling through to the unknown-identifier `[bug]`. The
            # check / emission lives in a helper to avoid growing
            # `lower_expr`'s stack frame — that frame is already
            # ~148 KB (see assembly), and recursion through deeply
            # nested expressions hits ~50 levels on `driver.gg`,
            # putting us right at the 8 MB stack limit. Adding even
            # a couple of locals to `lower_expr` overflows.
            int fdst_or_neg = lower_float_const_ident(&ctx, &gmod, name)
            if fdst_or_neg >= 0:
                return fdst_or_neg
            # Function-as-value: `filter(is_even)` / `.map(double)` etc.
            # — bare fn name passed where a Callable is expected. Helper
            # lives in its own function to keep `lower_expr`'s already-
            # massive stack frame from growing.
            int adst_or_neg = lower_fn_addr_ident(&ctx, &gmod, name)
            if adst_or_neg >= 0:
                return adst_or_neg
            # Module-level static with runtime-call init — `stdout` /
            # `stderr` / `stdin` from lib/std/io.gg etc. Mirrors Rust
            # gg's `Operand::Constant(Constant::GlobalRef(name))`
            # (`src/ir/lowering/exprs/mod.rs:128-130`). Helper emits a
            # `__global_ref__<name>` synthetic GICallExtern that
            # `lir_lower` rewrites to `IGlobalAddr`. Same out-of-line
            # rationale as the float-const / fn-addr helpers above.
            int sdst_or_neg = lower_static_ref_ident(&ctx, &gmod, name)
            if sdst_or_neg >= 0:
                return sdst_or_neg
            # Meta-op token (`meta +`, `meta /`, …) encoded as
            # `EIdentifier("__metaop__add")` etc. — compile-time only;
            # never has a runtime value. Mirrors Rust gg's
            # `MetaOpToken` filtering at call-arg lowering
            # (`src/ir/lowering/exprs/calls.rs:882`). Helper is
            # out-of-line for stack-frame reasons.
            int mdst_or_neg = lower_metaop_ident(&ctx, name)
            if mdst_or_neg >= 0:
                return mdst_or_neg
            # Module-level `Option[T] X = None` — emit a Unit (None) value
            # rather than the int-0 EIdentifier fallback. Used in
            # `add_local(&ctx, type, NO_NAME)` and similar callsites.
            if gmod.none_decls.contains(name):
                int ndst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                emit(&ctx, GIAssign(ndst, OpConstUnit()))
                return ndst
            # HARD BUG: silently returning `OpConstI64(0)` for an unknown
            # identifier lies about both value and type — every downstream
            # use thinks it's holding an int64 with value 0. Stage-1 has
            # been running with `gmod`, `self`, and similar getting this
            # fallback and cascading into PConstructor failures. Emit a
            # diagnostic so each miss is visible.
            diag_bug("EIdentifier", "in fn '" + ctx.current_fn_name + "': unknown identifier '" + name + "' — returning OpConstI64(0) placeholder (WRONG)")
            int unk = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(unk, OpConstI64(0)))
            return unk
        case EBinaryOp(lhs_box, op, rhs_box):
            # Short-circuit `and` / `or` — `a and b` is NOT `a + b`. Lower
            # to a branch-and-merge so the rhs isn't evaluated when the
            # lhs already determines the result. Previously fell through
            # to map_binop("and") = OP_ADD, and both sides always ran —
            # crashed in the self-host lexer on guards like
            # `self.lex_pos < byte_len and self.lex_peek() == b'\n'`
            # when lex_pos was at/past end.
            if op == "and" or op == "or":
                int lhs_sc = lower_expr(&ctx, *lhs_box, &gmod)
                int result_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
                # Initialize result to short-circuit constant so the
                # early-exit path lands on the right value.
                if op == "and":
                    emit(&ctx, GIAssign(result_local, OpConstBool(false)))
                else:
                    emit(&ctx, GIAssign(result_local, OpConstBool(true)))
                int rhs_bb = new_block(&ctx)
                int merge_bb = new_block(&ctx)
                # `and`: if lhs: jump to rhs else merge. `or`: opposite.
                if op == "and":
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), rhs_bb, merge_bb))
                else:
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), merge_bb, rhs_bb))
                switch_to(&ctx, rhs_bb)
                int rhs_sc = lower_expr(&ctx, *rhs_box, &gmod)
                emit(&ctx, GIAssign(result_local, OpCopy(rhs_sc)))
                set_terminator(&ctx, GTJump(merge_bb))
                switch_to(&ctx, merge_bb)
                return result_local
            # `x in collection` membership operator → `collection.contains(x)`.
            # Lower as a Type__contains call on the rhs (the collection)
            # rather than letting it fall through to `map_binop("in")`
            # which would silently mis-compile as `x + collection`.
            # Handles Vector / Set / Dict / String — all expose `contains`
            # in the runtime via collection_runtime_name → gorget_*_contains.
            if op == "in":
                int in_lhs = lower_expr(&ctx, *lhs_box, &gmod)
                int in_rhs = lower_expr(&ctx, *rhs_box, &gmod)
                String coll_tname = local_type_name(in_rhs, &ctx, &gmod)
                String contains_method = coll_tname + "__contains"
                Vector[Operand] in_args = [OpMove(in_rhs), op_consume(&ctx, &gmod, in_lhs)]
                int in_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICallExtern(in_dst, contains_method, in_args))
                return in_dst
            int lhs = lower_expr(&ctx, *lhs_box, &gmod)
            int rhs = lower_expr(&ctx, *rhs_box, &gmod)
            if is_comparison(op):
                # Comparable operator overload: `a < b` etc. on user types →
                # TypeName__compare(&a, b) OP 0.
                String lhs_cmp_name = local_type_name(lhs, &ctx, &gmod)
                if gmod.type_infos.contains(lhs_cmp_name) and (op == "<" or op == "<=" or op == ">" or op == ">="):
                    String cmp_method = lhs_cmp_name + "__compare"
                    if gmod.fn_sigs.contains(cmp_method):
                        Vector[Operand] cmp_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs)]
                        int cmp_val = add_local(&ctx, I64_TYPE, NO_NAME)
                        emit(&ctx, GICallExtern(cmp_val, cmp_method, cmp_args))
                        int zero = add_local(&ctx, I64_TYPE, NO_NAME)
                        emit(&ctx, GIAssign(zero, OpConstI64(0)))
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICmp(cmp_dst, map_cmpop(op), I64_TYPE, OpCopy(cmp_val), OpCopy(zero)))
                        return cmp_dst
                # Equatable operator overload for ==/!=: `a == b` → a.eq(b) / !a.eq(b).
                if (op == "==" or op == "!=") and gmod.type_infos.contains(lhs_cmp_name):
                    String eq_method = lhs_cmp_name + "__eq"
                    if gmod.fn_sigs.contains(eq_method):
                        Vector[Operand] eq_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs)]
                        int eq_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICallExtern(eq_dst, eq_method, eq_args))
                        if op == "==":
                            return eq_dst
                        int neq_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GIUnOp(neq_dst, UNOP_NOT, BOOL_TYPE, OpCopy(eq_dst)))
                        return neq_dst
                int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICmp(dst, map_cmpop(op), I64_TYPE, op_consume(&ctx, &gmod, lhs), op_consume(&ctx, &gmod, rhs)))
                return dst
            # String concatenation: + on string operands → gorget_str_cat(Str, Str)
            if op == "+" and (is_string_local(lhs, &ctx, &gmod) or is_string_local(rhs, &ctx, &gmod)):
                int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
                int dst = add_local(&ctx, gs_tid, NO_NAME)
                Vector[Operand] concat_args = []
                concat_args.push(op_consume(&ctx, &gmod, lhs))
                concat_args.push(op_consume(&ctx, &gmod, rhs))
                emit(&ctx, GICallExtern(dst, "gorget_str_cat", concat_args))
                return dst
            # Operator overload on user types: if lhs is a user struct/enum,
            # route `a + b` → a.add(b), `a - b` → a.sub(b), etc.
            String op_method = binop_method_name(op)
            if op_method != "":
                String lhs_tname = local_type_name(lhs, &ctx, &gmod)
                bool lhs_is_user = gmod.type_infos.contains(lhs_tname)
                # Also consider monomorphized names (Wrapper__int64_t has
                # template Wrapper in type_infos).
                if not lhs_is_user and lhs_tname.contains("__"):
                    int dd = lhs_tname.index_of("__").unwrap()
                    if dd > 0:
                        String tp = lhs_tname.slice(0, dd)
                        if gmod.type_infos.contains(tp):
                            lhs_is_user = true
                if lhs_is_user:
                    String method_full = lhs_tname + "__" + op_method
                    Vector[Operand] op_args = [OpMove(lhs), op_consume(&ctx, &gmod, rhs)]
                    int op_ret = I64_TYPE
                    if gmod.fn_sigs.contains(method_full):
                        op_ret = gmod.fn_sigs.get(method_full).unwrap()
                    else:
                        # Assume op returns lhs type (common for Add/Sub/Mul/Div).
                        int lhs_tid = ctx.locals.get(lhs).unwrap().type_id
                        if lhs_tid != I64_TYPE:
                            op_ret = lhs_tid
                    int op_dst = add_local(&ctx, op_ret, NO_NAME)
                    emit(&ctx, GICallExtern(op_dst, method_full, op_args))
                    return op_dst
            int dst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIBinOp(dst, map_binop(op), I64_TYPE, op_consume(&ctx, &gmod, lhs), op_consume(&ctx, &gmod, rhs)))
            return dst
        case EUnaryOp(op, inner_box):
            int inner = lower_expr(&ctx, *inner_box, &gmod)
            int inner_type = ctx.locals.get(inner).unwrap().type_id
            match op:
                case "-":
                    # Operator overload: -user_struct → user_struct.neg()
                    String inner_tname = local_type_name(inner, &ctx, &gmod)
                    if gmod.type_infos.contains(inner_tname):
                        String neg_method = inner_tname + "__neg"
                        Vector[Operand] neg_args = [OpMove(inner)]
                        int neg_ret = inner_type
                        if gmod.fn_sigs.contains(neg_method):
                            neg_ret = gmod.fn_sigs.get(neg_method).unwrap()
                        int neg_dst = add_local(&ctx, neg_ret, NO_NAME)
                        emit(&ctx, GICallExtern(neg_dst, neg_method, neg_args))
                        return neg_dst
                    int dst = add_local(&ctx, inner_type, NO_NAME)
                    emit(&ctx, GIUnOp(dst, UNOP_NEG, inner_type, OpCopy(inner)))
                    return dst
                case "not":
                    int dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    emit(&ctx, GIUnOp(dst, UNOP_NOT, BOOL_TYPE, OpCopy(inner)))
                    return dst
                else:
                    pass
            return inner
        case ECall(callee_box, args, targs):
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fname):
                    # Check if fname is a local variable (callable parameter or closure).
                    # If so, dispatch through closure protocol instead of direct call.
                    # Skip if fname is a known function (fn_sigs) or redirect target.
                    if nl_contains(&ctx, fname) and not gmod.fn_sigs.contains(fname) and not gmod.call_redirects.contains(fname):
                        int callable_local = nl_get(&ctx, fname)
                        # Lower args
                        Vector[Operand] cl_args = []
                        cl_args.push(op_consume(&ctx, &gmod, callable_local))  # closure/callable as first arg
                        for carg in args:
                            int cval = lower_expr(&ctx, carg, &gmod)
                            cl_args.push(op_consume(&ctx, &gmod, cval))
                        # Emit as __callable_N (codegen handles this as void*[2] dispatch)
                        int arity = args.len()
                        String cl_call = "__callable_" + int_to_str(arity)
                        # Infer return type from the callable's type (function pointer return type)
                        int cl_ret_type = I64_TYPE
                        int callable_tid = ctx.locals.get(callable_local).unwrap().type_id
                        if callable_tid >= 0 and callable_tid < gmod.type_table.len():
                            GirType ct = gmod.type_table.get(callable_tid).unwrap()
                            match ct:
                                case GtFnPtr(_, ret_tid):
                                    cl_ret_type = ret_tid
                                case GtPtr(inner_tid):
                                    # Callable params are Ptr(FnPtr(...)) — unwrap
                                    if inner_tid >= 0 and inner_tid < gmod.type_table.len():
                                        GirType inner_ct = gmod.type_table.get(inner_tid).unwrap()
                                        match inner_ct:
                                            case GtFnPtr(_, ret_tid2):
                                                cl_ret_type = ret_tid2
                                            else:
                                                pass
                                case GtMutPtr(inner_tid):
                                    if inner_tid >= 0 and inner_tid < gmod.type_table.len():
                                        GirType inner_ct = gmod.type_table.get(inner_tid).unwrap()
                                        match inner_ct:
                                            case GtFnPtr(_, ret_tid2):
                                                cl_ret_type = ret_tid2
                                            else:
                                                pass
                                else:
                                    pass
                        int cl_dst = add_local(&ctx, cl_ret_type, NO_NAME)
                        emit(&ctx, GICallExtern(cl_dst, cl_call, cl_args))
                        return cl_dst
                    return lower_call(&ctx, &fname, &args, &targs, &gmod)
                case EFieldAccess(_, method_name):
                    # Method-style call: obj.method(args) parsed as ECall(EFieldAccess(...))
                    # Lower args but return unit (method calls are complex)
                    for marg in args:
                        lower_expr(&ctx, marg, &gmod)
                    int mdst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                    emit(&ctx, GIAssign(mdst, OpConstUnit()))
                    return mdst
                else:
                    pass
            return add_local(&ctx, UNIT_TYPE, NO_NAME)
        case EMethodCall(recv_box, mname, margs, _):
            # Static method call: receiver is a TYPE name (e.g. Point.default()
            # or int.parse(s)). Route to TypeName__method with no self argument.
            #
            # Parameterised-type receiver: `Heap[int].new()` /
            # `SparseSet[int].new()` parse as EMethodCall on EIndex, NOT
            # EIdentifier. Detect that pattern and rewrite the receiver
            # as if it were `Heap__int64_t.new()` — the static-method
            # path below will then dispatch to `Heap__int64_t__new()`.
            # Without this, the lowerer would walk into EIndex and
            # lower `Heap` as a bare value identifier, emitting [bug].
            SpannedExpr recv_for_match = *recv_box
            match (*recv_box).expr:
                case EIndex(eix_base_box, eix_idx_box):
                    String eix_base_name = ""
                    String eix_idx_name = ""
                    match (*eix_base_box).expr:
                        case EIdentifier(b):
                            eix_base_name = b
                        else:
                            pass
                    match (*eix_idx_box).expr:
                        case EIdentifier(i):
                            eix_idx_name = i
                        else:
                            pass
                    if eix_base_name.len() > 0 and eix_idx_name.len() > 0:
                        # Substitute through `gmod.type_subs` (T → int64_t).
                        if gmod.type_subs.contains(eix_idx_name):
                            int sub_tid = gmod.type_subs.get(eix_idx_name).unwrap()
                            String sub_name = type_id_to_name(sub_tid, &gmod)
                            if sub_name.len() > 0:
                                eix_idx_name = sub_name
                        # Map surface type names to their C-level form
                        # so the mangled mono name matches what's
                        # registered in `type_infos`.
                        if eix_idx_name == "int":
                            eix_idx_name = "int64_t"
                        elif eix_idx_name == "float":
                            eix_idx_name = "double"
                        elif eix_idx_name == "String":
                            eix_idx_name = "GorgetString"
                        String mono_name = eix_base_name + "__" + eix_idx_name
                        # Synthesise an EIdentifier-shaped receiver so
                        # the existing static-method path picks it up.
                        recv_for_match = SpannedExpr(EIdentifier(mono_name), (*recv_box).span)
                else:
                    pass
            match recv_for_match.expr:
                case EIdentifier(ident_name_raw):
                    # Generic type-param substitution. In monomorphized
                    # bodies like `equip [T] SetIter[T] with Iterator[T]:
                    # Option[T] next(...): T out = T.default()`, the `T`
                    # of `T.default()` is a type-parameter name. After
                    # `setup_type_subs(T → int)`, look it up before the
                    # is_type check so `T.default()` dispatches to
                    # `int64_t__default()` rather than falling through to
                    # the EIdentifier-on-`T` value path (which has no
                    # binding and emits a [bug] placeholder).
                    String ident_name = ident_name_raw
                    if gmod.type_subs.contains(ident_name):
                        int sub_tid = gmod.type_subs.get(ident_name).unwrap()
                        String sub_name = type_id_to_name(sub_tid, &gmod)
                        if sub_name.len() > 0:
                            ident_name = sub_name
                    # Named locals shadow type names. Without this guard,
                    # a synth local whose name happens to contain `__`
                    # (e.g. `__for_coll_N` from a desugared SFor) gets
                    # picked up by the `__`-infix fallback below and
                    # misrouted to static-method dispatch
                    # (`__for_coll_N.get(i)` → `__for_coll_N__get(i)`,
                    # undefined symbol). The named-local check is also
                    # the safe answer in general: if a binding exists in
                    # scope, it's a value, regardless of name shape.
                    # (Self-host snag #5, 2026-05-14.)
                    bool is_local = nl_contains(&ctx, ident_name_raw)
                    bool is_type = false
                    if not is_local:
                        is_type = gmod.type_infos.contains(ident_name)
                    # Also treat primitive type names as types.
                    if not is_type and not is_local:
                        if ident_name == "int" or ident_name == "float" or ident_name == "bool":
                            is_type = true
                        elif ident_name == "String" or ident_name == "byte" or ident_name == "char":
                            is_type = true
                        elif ident_name == "int8" or ident_name == "int16" or ident_name == "int32" or ident_name == "int64":
                            is_type = true
                        elif ident_name == "uint8" or ident_name == "uint16" or ident_name == "uint32" or ident_name == "uint64":
                            is_type = true
                        elif ident_name == "float32" or ident_name == "float64":
                            is_type = true
                        # C-level primitive names — these arrive after
                        # `gmod.type_subs` substitution where `T → int64_t`
                        # (the C type name, not the Gorget surface `int`).
                        elif ident_name == "int64_t" or ident_name == "int32_t" or ident_name == "int16_t" or ident_name == "int8_t":
                            is_type = true
                        elif ident_name == "uint64_t" or ident_name == "uint32_t" or ident_name == "uint16_t" or ident_name == "uint8_t":
                            is_type = true
                        elif ident_name == "double" or ident_name == "GorgetString":
                            is_type = true
                        # Generic prelude types — `Box.new(x)` /
                        # `Heap.new()` etc. show up as static-method
                        # calls in surface syntax. The unparameterised
                        # name isn't in `type_infos` (only mono'd
                        # `Box__T` is), so it'd fall through to the
                        # bare-EIdentifier path and emit `[bug]`.
                        elif ident_name == "Box" or ident_name == "Heap":
                            is_type = true
                        elif ident_name == "Vector" or ident_name == "Deque":
                            is_type = true
                        elif ident_name == "Dict" or ident_name == "HashMap":
                            is_type = true
                        elif ident_name == "Set" or ident_name == "HashSet":
                            is_type = true
                        elif ident_name == "Channel" or ident_name == "Shared" or ident_name == "Weak":
                            is_type = true
                        elif ident_name == "Option" or ident_name == "Result":
                            is_type = true
                        # Monomorphized generic types — `Container__Foo`,
                        # `Heap__int64_t`, `SparseSet__int64_t`, etc. arrive
                        # here after the EIndex rewrite above. They may not
                        # be in `type_infos` yet (registration happens lazily
                        # during lowering, sometimes after the call site),
                        # but a `__` separator in an identifier is reliable
                        # signal it's a mangled type — Gorget's surface
                        # syntax doesn't allow identifiers to contain `__`.
                        elif ident_name.contains("__"):
                            is_type = true
                    if is_type:
                        Vector[Operand] static_args = []
                        for sma in margs:
                            int sma_val = lower_expr(&ctx, sma, &gmod)
                            static_args.push(op_consume(&ctx, &gmod, sma_val))
                        # Primitive method names need C-runtime mangling.
                        String type_prefix = ident_name
                        if ident_name == "int":
                            type_prefix = "int64_t"
                        elif ident_name == "float":
                            type_prefix = "double"
                        elif ident_name == "String":
                            type_prefix = "GorgetString"
                        String static_name = type_prefix + "__" + mname
                        int static_ret = I64_TYPE
                        # Qualified enum variant constructor: `EnumName.Variant(args)`
                        # is parsed as EMethodCall(EIdentifier(EnumName), "Variant",
                        # args). The static-method path mangles to
                        # `EnumName__Variant` — for variants this is a constructor,
                        # not a real method, so the return type is the enum struct
                        # itself. Without this, `static_ret` falls through to
                        # I64_TYPE and the destination local lands at int64_t —
                        # the C codegen then tries to assign a 100+ byte enum
                        # struct literal into a scalar slot and barfs with
                        # "incompatible types when assigning to type 'int64_t'
                        # from type '__gg_Foo'". Mirrors Rust gg's enum-variant
                        # branch in `src/ir/lowering/exprs/methods.rs` (snag #51).
                        bool is_variant_ctor = false
                        if gmod.type_infos.contains(ident_name):
                            GirTypeInfo enum_info = gmod.type_infos.get(ident_name).unwrap()
                            if enum_info.is_enum:
                                for evv in enum_info.variants:
                                    if evv.name == mname:
                                        is_variant_ctor = true
                                        break
                        if is_variant_ctor:
                            static_ret = lookup_or_register_named(&gmod, ident_name)
                        elif gmod.fn_sigs.contains(static_name):
                            static_ret = gmod.fn_sigs.get(static_name).unwrap()
                        elif mname == "default":
                            if gmod.type_infos.contains(ident_name):
                                static_ret = lookup_or_register_named(&gmod, ident_name)
                            else:
                                # int.default() → int, float.default() → double, etc.
                                int pt = prim_name_to_type(ident_name)
                                if pt >= 0:
                                    static_ret = pt
                        elif mname == "parse":
                            # int.parse(s) returns Option[int]
                            int pt = prim_name_to_type(ident_name)
                            if pt >= 0:
                                String opt_name = "Option__" + type_id_to_name(pt, &gmod)
                                static_ret = lookup_or_register_named(&gmod, opt_name)
                        else:
                            int binfer = builtin_call_return_type(static_name, &gmod)
                            if binfer >= 0:
                                static_ret = binfer
                        int sdst = add_local(&ctx, static_ret, NO_NAME)
                        emit(&ctx, GICallExtern(sdst, static_name, static_args))
                        return sdst
                else:
                    pass
            # unwrap() / unwrap_or() — extract the payload field from the
            # Option/Result receiver. Previously a no-op GIAssign copy with
            # a re-typed target, which silently mishandled aggregate receivers:
            # `.unwrap_or(0)` on a `Result[int, ParseError]` emits "0" via
            # emit_variant_arg's aggregate-arg/scalar-expected fallback,
            # losing the actual Ok_0 value. Now emits a real field read
            # through the `__field_read_<enum>_<Variant>_0` helper, same as
            # PConstructor destructure.
            int recv = lower_expr(&ctx, *recv_box, &gmod)
            if mname == "unwrap" or mname == "unwrap_or":
                # Lower the default value first (for unwrap_or) and
                # capture its local id — needed if we synthesize a
                # tag check below. unwrap (no args) leaves this at -1.
                int default_local = -1
                int uoi = 0
                while uoi < margs.len():
                    int lo = lower_expr(&ctx, margs.get(uoi).unwrap(), &gmod)
                    if uoi == 0:
                        default_local = lo
                    uoi += 1
                # Determine the wrapper type, inner type name, and variant.
                String recv_tn = local_type_name(recv, &ctx, &gmod)
                String variant_name = ""
                String inner_name_str = ""
                if recv_tn.starts_with("Option__"):
                    variant_name = "Some"
                    inner_name_str = recv_tn.slice(8, recv_tn.len())
                elif recv_tn.starts_with("Result__"):
                    variant_name = "Ok"
                    # Ok type: longest-prefix scan for first `__` splits
                    # Result__<OkT>__<ErrT>.
                    String rest = recv_tn.slice(8, recv_tn.len())
                    int split = -1
                    int si = 0
                    while si + 1 < rest.byte_len():
                        if rest.byte_at(si) == 0x5F and rest.byte_at(si + 1) == 0x5F:
                            split = si
                            break
                        si += 1
                    if split > 0:
                        inner_name_str = rest.slice(0, split)
                int inner_tid = -1
                if inner_name_str != "":
                    int prim_t = prim_name_to_type(inner_name_str)
                    if prim_t >= 0:
                        inner_tid = prim_t
                    elif inner_name_str == "int64_t":
                        inner_tid = I64_TYPE
                    elif inner_name_str == "int32_t":
                        inner_tid = I32_TYPE
                    elif inner_name_str == "int16_t":
                        inner_tid = I16_TYPE
                    elif inner_name_str == "int8_t":
                        inner_tid = I8_TYPE
                    elif inner_name_str == "uint64_t":
                        inner_tid = U64_TYPE
                    elif inner_name_str == "uint32_t":
                        inner_tid = U32_TYPE
                    elif inner_name_str == "uint16_t":
                        inner_tid = U16_TYPE
                    elif inner_name_str == "uint8_t":
                        inner_tid = U8_TYPE
                    elif inner_name_str == "double":
                        inner_tid = F64_TYPE
                    elif inner_name_str == "float":
                        inner_tid = F32_TYPE
                    elif inner_name_str == "Str":
                        inner_tid = lookup_or_register_named(&gmod, "GorgetString")
                    else:
                        inner_tid = lookup_or_register_named(&gmod, inner_name_str)
                if inner_tid >= 0 and variant_name != "":
                    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, recv)
                    # `.unwrap_or(default)`: emit a real tag check so
                    # None/Error returns the default instead of dereffing
                    # a NULL pointer (closes showcase blocker #4 — the
                    # `sr_lookup` workaround in lir_lower.gg:35 can now
                    # inline as `sr.get(name).unwrap_or(-1)`).
                    if mname == "unwrap_or" and default_local >= 0:
                        # Materialise the result slot up front; both arms
                        # store into it so the merge block sees a single
                        # def (SSA construction inserts the phi).
                        int uo_dst = add_local(&ctx, inner_tid, NO_NAME)
                        int tag = emit_tag_read(&ctx, scr_ptr, recv_tn, &gmod)
                        # tag == 0 → Some / Ok arm.
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, NO_NAME)
                        emit(&ctx, GICmp(cmp_dst, CMP_EQ, I64_TYPE, OpCopy(tag), OpConstI64(0)))
                        int some_bb = new_block(&ctx)
                        int none_bb = new_block(&ctx)
                        int uo_merge_bb = new_block(&ctx)
                        set_terminator(&ctx, GTBranch(OpCopy(cmp_dst), some_bb, none_bb))
                        # Some arm: read payload, store to uo_dst.
                        switch_to(&ctx, some_bb)
                        int payload = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                        emit(&ctx, GIAssign(uo_dst, op_consume(&ctx, &gmod, payload)))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        # None arm: store the default.
                        switch_to(&ctx, none_bb)
                        emit(&ctx, GIAssign(uo_dst, op_consume(&ctx, &gmod, default_local)))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        switch_to(&ctx, uo_merge_bb)
                        return uo_dst
                    # Plain unwrap: emit a real field read through the
                    # scrutinee-ptr helper, matching PConstructor destructure.
                    int field_val = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                    return field_val
                # Fall back to re-cast if we couldn't identify the variant.
                if inner_tid >= 0:
                    int ud = add_local(&ctx, inner_tid, NO_NAME)
                    emit(&ctx, GIAssign(ud, op_consume(&ctx, &gmod, recv)))
                    return ud
                return recv
            # clone() — return a copy of the receiver
            if mname == "clone":
                # Phase D step 3: explicit `.clone()` produces an owned
                # copy of the receiver. Emit OpClone so downstream layers
                # (LIR codegen, Phase C validators) know this read is a
                # deliberate refcount bump / deep copy, not an alias.
                int clone_dst = add_local(&ctx, ctx.locals.get(recv).unwrap().type_id, NO_NAME)
                emit(&ctx, GIAssign(clone_dst, OpClone(recv)))
                return clone_dst
            # Detect mutating-method-on-field-access pattern *before*
            # lowering args, so we capture wb_base / wb_field while the
            # recv_box AST is still in scope. `self.field.push(x)` and
            # similar mutators are lowered as:
            #   copy = __field_read_(base, idx)
            #   method(&copy, args)
            # …the mutation lives on `copy`; without a follow-up write-back,
            # the original field never sees the change. Writing back after
            # the call persists the mutation. Classic symptom: lex_emit's
            # `self.lex_tokens.push(...)` silently drops every token and the
            # self-compiled lexer returns 0 tokens.
            bool is_mutating = mname == "push" or mname == "put" or mname == "set" or mname == "pop" or mname == "remove" or mname == "clear"
            bool need_writeback = false
            SpannedExpr wb_base = (*recv_box)
            String wb_field = ""
            # Showcase blocker #1 (self-host side): the
            # `coll.get(i).unwrap().mut_method(args)` chain ALSO needs a
            # writeback. `emit_payload_read` clones the inner element for
            # resource payloads (line 3243), so `recv` ends up holding an
            # independently-allocated copy of `coll[i]`. Without a setback,
            # the mutation lives on that clone and the original collection
            # element stays unchanged — classic symptom: `preds.get(succ)
            # .unwrap().push(bi)` on `Vector[Vector[int]]` leaves the inner
            # Vector empty, corrupting SSA's `compute_preds` output and
            # surfacing as cc errors in unrelated downstream functions.
            #
            # Pattern: `EMethodCall(EMethodCall(EMethodCall(coll, getter,
            # [idx]), "unwrap"), mut_method, args)` where getter is
            # "get"/"safe_get". Emit `coll.set(idx, !recv)` after the
            # mutating call, mirroring the existing EFieldAccess writeback.
            bool need_chain_writeback = false
            SpannedExpr chain_coll = (*recv_box)
            SpannedExpr chain_idx = SpannedExpr(EIntLiteral(0), Span(0, 0))
            if is_mutating:
                match (*recv_box).expr:
                    case EFieldAccess(wb_base_box, wb_f):
                        need_writeback = true
                        wb_base = *wb_base_box
                        wb_field = wb_f
                    case EMethodCall(unwrap_recv_box, unwrap_mname, _uargs, _utargs):
                        if unwrap_mname == "unwrap":
                            match (*unwrap_recv_box).expr:
                                case EMethodCall(coll_box, gname, gargs, _gtargs):
                                    if (gname == "get" or gname == "safe_get") and gargs.len() == 1:
                                        need_chain_writeback = true
                                        chain_coll = *coll_box
                                        chain_idx = gargs.get(0).unwrap()
                                else:
                                    pass
                    else:
                        pass
            # Method call: lower receiver as first arg (&self), then args.
            # Most collection/object methods take self by pointer.
            #
            # Phase C step 5b: pick operand mode from the receiver's
            # ownership tag. A LoBorrowed receiver (most commonly a
            # field-loaded local — `self.columns.get(...)`) must be
            # passed as OpBorrow, not OpMove — moving a borrow is a
            # use-after-free shape. OpMove stays for LoOwned and
            # LoParam (the caller already owns the slot in both
            # cases; the method call may consume or alias as it
            # likes). At the LIR layer OpBorrow lowers identically
            # to OpMove for the pass-by-ptr method-arg shape (commit
            # `af687f3d`); validators downstream get the typed signal.
            Vector[Operand] call_args = []
            GirLocal recv_loc = ctx.locals.get(recv).unwrap()
            if need_chain_writeback:
                # Chain writeback needs `recv` alive after the mut call so
                # we can move it into the subsequent `coll.set(idx, !recv)`.
                # OpBorrow keeps the local valid; the runtime push/set/etc.
                # take self via pointer regardless of operand kind, so this
                # is semantically a no-op for the mutating call itself.
                call_args.push(OpBorrow(recv))
            else:
                match recv_loc.ownership:
                    case LoBorrowed():
                        call_args.push(OpBorrow(recv))
                    else:
                        call_args.push(OpMove(recv))
            for ma in margs:
                int ma_val = lower_expr(&ctx, ma, &gmod)
                call_args.push(op_consume(&ctx, &gmod, ma_val))
            # Build the mangled method name: TypeName__method
            # Resolve receiver type name from the GIR local's type
            String recv_type_name = local_type_name(recv, &ctx, &gmod)
            String full_name = recv_type_name + "__" + mname
            # Return-type resolution priority — single source of truth
            # at each step (Layering rule 3):
            #
            #   1. fn_sigs (the lowerer's own registrations: Option B
            #      pre-pass for mono'd generic-equip methods + the
            #      non-generic-equip pre-pass at line ~6201). Fast,
            #      authoritative for the cases it covers.
            #   2. Typechecker side-table (`tc_types.expr_types`) —
            #      covers method-generic call sites (`v.iter().
            #      take_while[P](pred)`, `.map[U,F](f)`, full iterator
            #      chains, etc.) where the typechecker already resolved
            #      the mono'd return type. The architectural single
            #      source of truth for "what type does this expression
            #      have?" (Phase 1 + 2 of Gap #2). Returns a fully-
            #      mangled GIR type id via `resolved_to_gir_type`.
            #   3. Name-based heuristic (`infer_method_return_type`) —
            #      last resort for built-in collection runtime methods
            #      the typechecker doesn't model (raw runtime symbols
            #      like `gorget_array_get`); returns I64 when truly
            #      unknown.
            int ret_tid = I64_TYPE
            if gmod.fn_sigs.contains(full_name):
                ret_tid = gmod.fn_sigs.get(full_name).unwrap()
            else:
                int tc_ret = lookup_expr_gir_type(sexpr, &gmod)
                if tc_ret >= 0:
                    ret_tid = tc_ret
                else:
                    ret_tid = infer_method_return_type(mname, recv, &ctx, &gmod)
            if ret_tid == UNIT_TYPE:
                # Void-returning method — no destination
                emit(&ctx, GICallExtern(-1, full_name, call_args))
                if need_writeback:
                    emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
                if need_chain_writeback:
                    emit_chain_writeback(&ctx, chain_coll, chain_idx, recv, &gmod)
                int void_dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
                emit(&ctx, GIAssign(void_dst, OpConstUnit()))
                return void_dst
            # Phase D step 2: collection-getter methods (.get / .pop /
            # .first / .last / .remove / .safe_get) return `Option[V]` whose
            # payload is a borrow into the collection element, not an owned
            # copy. Tag the destination LoBorrowed/BoCollectionElement so
            # validators downstream can distinguish "owned wrapper around a
            # borrow" from "wrapper around an owned value." Receiver-type
            # gate avoids false positives when the user shadows these names
            # on a non-collection type (e.g. an `equip` block on a struct).
            int mdst = -1
            if is_collection_getter_method(mname):
                bool recv_is_collection = false
                match build_resource_metadata(recv_type_name):
                    case Some(rmeta):
                        match rmeta.collection_kind:
                            case CkNotCollection():
                                recv_is_collection = false
                            else:
                                recv_is_collection = true
                    case None:
                        recv_is_collection = false
                if recv_is_collection:
                    mdst = add_local_with(&ctx, ret_tid, NO_NAME, LoBorrowed(), BoCollectionElement())
                else:
                    mdst = add_local(&ctx, ret_tid, NO_NAME)
            else:
                mdst = add_local(&ctx, ret_tid, NO_NAME)
            emit(&ctx, GICallExtern(mdst, full_name, call_args))
            if need_writeback:
                emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
            if need_chain_writeback:
                emit_chain_writeback(&ctx, chain_coll, chain_idx, recv, &gmod)
            return mdst
        case EFieldAccess(base_box, field_name):
            int base = lower_expr(&ctx, *base_box, &gmod)
            # Resolve the base's struct type to find the field
            int base_tid = ctx.locals.get(base).unwrap().type_id
            String base_type_name = type_id_to_name(base_tid, &gmod)
            # Unwrap Ptr/MutPtr to get the inner type name
            int inner_tid = base_tid
            if base_tid >= 0 and base_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(base_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    case GtMutPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    else:
                        pass
            # Box auto-deref: `box.field` is sugar for `(*box).field` — peel
            # the Box wrapper so the field lookup hits the inner struct's
            # fields, not Box's (which has no user fields). Without this,
            # `expr.span` where `expr` is `Box[SpannedExpr]` (auto-boxed
            # parameter, etc.) silently fell into the [bug] OpConstI64(0)
            # placeholder. The inner-name extraction mirrors `case EDeref`'s
            # byte-by-byte loop — stage-1 self-host's `.slice(5, len)` on
            # a Box-prefixed type name returns empty for view-aliasing
            # reasons (see EDeref comment at line ~2549), so we walk bytes.
            if base_type_name.starts_with("Box__"):
                int blen = base_type_name.byte_len()
                String inner_name = ""
                int bi = 5
                while bi < blen:
                    inner_name = inner_name + chr(base_type_name.byte_at(bi))
                    bi += 1
                int box_inner_tid = resolve_field_gir_type(inner_name, &gmod)
                int derefed = add_local(&ctx, box_inner_tid, NO_NAME)
                emit(&ctx, GIDeref(derefed, base, box_inner_tid))
                base = derefed
                base_tid = box_inner_tid
                base_type_name = inner_name
                inner_tid = box_inner_tid
            # Look up field info from type_infos. Resolve to
            # (field_name, field_type_name, field_index) tuples without
            # cloning the whole GirTypeInfo — the Vector clone path
            # double-frees nested heap data on the self-host.
            int found_fi = -1
            String found_type_name = ""
            if gmod.type_infos.contains(base_type_name):
                GirTypeInfo info = gmod.type_infos.get(base_type_name).unwrap()
                int fi = 0
                while fi < info.fields.len():
                    GirFieldInfo finfo = info.fields.get(fi).unwrap()
                    if finfo.name == field_name:
                        found_fi = fi
                        found_type_name = finfo.type_name.clone()
                        break
                    fi += 1
            if found_fi >= 0:
                int field_type = resolve_field_gir_type(found_type_name, &gmod)
                # Phase D step 2: a field load aliases into the base struct's
                # storage. The local that receives it is a borrow into the
                # aggregate, not an owned value — validators (Phase C) need
                # this to flag Copy-of-resource-field-load violations.
                int fdst = add_local_with(&ctx, field_type, NO_NAME, LoBorrowed(), BoField())
                String field_fn = "__field_read_" + base_type_name + "_" + field_name
                bool base_is_ptr = is_ptr_type(base_tid, &gmod)
                Vector[Operand] field_args = []
                if base_is_ptr:
                    field_args.push(OpCopy(base))
                else:
                    # Phase C step 5b: chained field access (a.b.c.d)
                    # produces a LoBorrowed `base` for the inner reads.
                    # OpMove on a borrow is a use-after-free; emit
                    # OpBorrow to pass the alias through.
                    GirLocal base_loc = ctx.locals.get(base).unwrap()
                    match base_loc.ownership:
                        case LoBorrowed():
                            field_args.push(OpBorrow(base))
                        else:
                            field_args.push(OpMove(base))
                field_args.push(OpConstI64(found_fi))
                gmod.fn_sigs.put(field_fn, field_type)
                emit(&ctx, GICallExtern(fdst, field_fn, field_args))
                return fdst
            # HARD BUG: unknown field access fell through to I64/0
            # placeholder, losing both the struct identity and the field
            # type. Every downstream read of the "field value" sees 0 and
            # is typed int64 — responsible for the cascade of PConstructor
            # failures in stage-1 output. Report each miss with the base
            # type name and field name so the root cause is visible.
            diag_bug("EFieldAccess", "in fn '" + ctx.current_fn_name + "': unknown field '" + field_name + "' on base type '" + base_type_name + "' — returning I64(0) placeholder (WRONG)")
            int fdst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(fdst, OpConstI64(0)))
            return fdst
        case EIndex(base_box, idx_box):
            lower_expr(&ctx, *base_box, &gmod)
            lower_expr(&ctx, *idx_box, &gmod)
            int idst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(idst, OpConstI64(0)))
            return idst
        case EIf(cond_box, then_body, else_branches):
            int cond = lower_expr(&ctx, *cond_box, &gmod)
            int then_bb = new_block(&ctx)
            int else_bb = new_block(&ctx)
            int merge_bb = new_block(&ctx)
            set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
            switch_to(&ctx, then_bb)
            lower_stmts(&ctx, then_body, &gmod, false)
            set_terminator(&ctx, GTJump(merge_bb))
            switch_to(&ctx, else_bb)
            set_terminator(&ctx, GTJump(merge_bb))
            switch_to(&ctx, merge_bb)
            int ifdst = add_local(&ctx, I64_TYPE, NO_NAME)
            return ifdst
        case ENoneLiteral():
            int dst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstUnit()))
            return dst
        case ECharLiteral(ch):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, NO_NAME)
            emit(&ctx, GIAssign(dst, OpConstStr(ch)))
            return dst
        case EArrayLiteral(elems):
            # Consume element-type hint set by SVarDecl (`Vector[T] x = []`).
            # An empty hint means the declared type was not a concrete
            # Vector[T] — fall back to pointer size, which is correct for
            # scalar-element Vectors used as temporaries.
            String vec_tyname = ctx.pending_vec_elem_tyname
            ctx.pending_vec_elem_tyname = ""
            # Lower each element — we'll push them in order after the
            # array is constructed. Need to keep the value locals around
            # so we can reference them in the subsequent push calls.
            Vector[int] elem_locals = []
            for elem in elems:
                int elem_val = lower_expr(&ctx, elem, &gmod)
                elem_locals.push(elem_val)
            # Call gorget_array_new(elem_size) so the resulting array has a
            # valid `alloc` pointer from __gorget_current_alloc. Without
            # this, subsequent `.push()` on a zero-init'd GorgetArray
            # segfaults dereferencing arr->alloc->realloc(...).
            # With a type hint we emit a magic call `__gorget_array_new_sized_<T>()`
            # which the C codegen expands to `gorget_array_new(sizeof(T))` —
            # that's the only way for the size to track the real aggregate
            # footprint (e.g. 128 bytes for LirStructDef). Without the hint
            # we fall back to 8, which still works for pointer-/int-sized
            # element types (the common case for local temporaries).
            int adst = add_local(&ctx, lookup_or_register_named(&gmod, "GorgetArray"), NO_NAME)
            if vec_tyname != "":
                String magic_name = "__gorget_array_new_sized_" + vec_tyname
                Vector[Operand] an_args_typed = []
                emit(&ctx, GICallExtern(adst, magic_name, an_args_typed))
            else:
                Vector[Operand] an_args = [OpConstI64(8)]
                emit(&ctx, GICallExtern(adst, "gorget_array_new", an_args))
            # Push each element into the just-created Vector. Without
            # this, `[!init_insts]` and similar "array literal with
            # explicit elements" produced an EMPTY array, and any
            # subsequent `.get(0)` returned NULL.
            for el in elem_locals:
                Vector[Operand] push_args = [OpMove(adst), OpMove(el)]
                emit(&ctx, GICallExtern(-1, "gorget_array_push", push_args))
            return adst
        case ETupleLiteral(elems):
            for te in elems:
                lower_expr(&ctx, te, &gmod)
            int tdst = add_local(&ctx, I64_TYPE, NO_NAME)
            emit(&ctx, GIAssign(tdst, OpConstI64(0)))
            return tdst
        case EStructLiteral(sname, fnames, fvals):
            for sv in fvals:
                lower_expr(&ctx, sv, &gmod)
            int sdst = add_local(&ctx, lookup_or_register_named(&gmod, sname), NO_NAME)
            emit(&ctx, GIAssign(sdst, OpConstI64(0)))
            return sdst
        case EClosure(cparams, cbody):
            # Create closure value. __Closure_N was registered by scan phase.
            # Find the matching __Closure_N__call in gmod.functions by searching
            # from the current module_closure_id.
            int cid = gmod_next_closure_id(&gmod)
            String closure_name = "__Closure_" + int_to_str(cid)
            # The closure value at the GIR level is a GorgetClosure struct
            # (not __Closure_N which is the captured-vars struct).
            int closure_tid = lookup_or_register_named(&gmod, "GorgetClosure")
            # Emit __make_closure_N() — codegen expands to GorgetClosure init
            String make_fn = "__make_closure_" + int_to_str(cid)
            int cdst = add_local(&ctx, closure_tid, NO_NAME)
            Vector[Operand] make_args = []
            gmod.fn_sigs.put(make_fn, closure_tid)
            emit(&ctx, GICallExtern(cdst, make_fn, make_args))
            return cdst
        case EAs(inner_box, _):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EMove(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EMutableBorrow(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDeref(inner_box):
            # `*box` — actually load the inner value. The inner AST is
            # lowered to a local of type `Box[T]` (void* at C level). We
            # need to emit a load so downstream code that passes the
            # result to a function expecting `T` works.
            int dsrc = lower_expr(&ctx, *inner_box, &gmod)
            int dsrc_tid = ctx.locals.get(dsrc).unwrap().type_id
            String dsrc_tname = type_id_to_name(dsrc_tid, &gmod)
            # Phase A typed read: BkRegularBox identifies parameterised
            # Box[T]; the bare trait Box's no-suffix name doesn't reach
            # an EDeref site (a trait box deref goes through vtable
            # dispatch, not raw pointer load).
            bool dsrc_is_box = false
            match build_resource_metadata(dsrc_tname):
                case Some(rmeta):
                    match rmeta.box_kind:
                        case BkRegularBox():
                            dsrc_is_box = true
                        else:
                            pass
                case None:
                    pass
            if dsrc_is_box:
                # Build the inner name byte-by-byte instead of using
                # `.substring()` / `.byte_slice()`. Stage-1 self-host's
                # runtime returns empty for `dsrc_tname.substring(5,
                # dsrc_tname.len())` even though dsrc_tname is the
                # full "Box__SpannedExpr" string and `.starts_with`
                # returned true on it. Likely a view-aliasing
                # interaction with the slice helpers. The byte loop
                # is reliable and only runs once per EDeref.
                int d_blen = dsrc_tname.byte_len()
                String d_inner_name = ""
                int dni_i = 5
                while dni_i < d_blen:
                    int b_dni = dsrc_tname.byte_at(dni_i)
                    d_inner_name = d_inner_name + chr(b_dni)
                    dni_i += 1
                int d_inner_tid = resolve_field_gir_type(d_inner_name, &gmod)
                int ddst = add_local(&ctx, d_inner_tid, NO_NAME)
                emit(&ctx, GIDeref(ddst, dsrc, d_inner_tid))
                return ddst
            return dsrc
        case ETry(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDotShorthand(variant, sargs):
            for da in sargs:
                lower_expr(&ctx, da, &gmod)
            int ddst = add_local(&ctx, I64_TYPE, NO_NAME)
            return ddst
        case EBlock(block_stmts):
            lower_stmts(&ctx, block_stmts, &gmod, false)
            int bdst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            return bdst
        case ESelfExpr():
            if nl_contains(&ctx, "self"):
                return nl_get(&ctx, "self")
            int sdst = add_local(&ctx, UNIT_TYPE, NO_NAME)
            return sdst
        case EDefaultOp(lhs_box, rhs_box):
            lower_expr(&ctx, *lhs_box, &gmod)
            return lower_expr(&ctx, *rhs_box, &gmod)
        case EIs(inner_box, negated, pattern):
            # `x is Pattern` — test the scrutinee against the pattern and
            # bind any sub-pattern names into the function-scope named
            # locals. Mirrors Rust gg's `Expr::Is` lowering (src/ir/lowering/
            # exprs/mod.rs:649) + `emit_is_bindings` (stmts/mod.rs:2643)
            # collapsed into one site — `lower_pattern_match` does both
            # the tag-test and the field-extract, and `nl_put` is
            # function-scoped so the bindings remain visible in the
            # then-branch of any enclosing `if x is Some(k):`.
            int scrutinee = lower_expr(&ctx, *inner_box, &gmod)
            int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
            String type_name = type_id_to_name(scr_tid, &gmod)
            # Unwrap Ptr/MutPtr — borrowed scrutinees show up as Ptr(T).
            if scr_tid >= 0 and scr_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(scr_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    case GtMutPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    else:
                        pass
            String enum_name = match_enum_type(type_name, &gmod)
            int match_bb = new_block(&ctx)
            int no_match_bb = new_block(&ctx)
            int merge_bb = new_block(&ctx)
            int isdst = add_local(&ctx, BOOL_TYPE, NO_NAME)
            lower_pattern_match(&ctx, scrutinee, *pattern, enum_name, match_bb, no_match_bb, &gmod)
            # Match path: scrutinee matched the pattern. Bindings already
            # emitted in lower_pattern_match's bind_bb upstream.
            switch_to(&ctx, match_bb)
            bool match_val = true
            if negated:
                match_val = false
            emit(&ctx, GIAssign(isdst, OpConstBool(match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            # No-match path.
            switch_to(&ctx, no_match_bb)
            bool no_match_val = false
            if negated:
                no_match_val = true
            emit(&ctx, GIAssign(isdst, OpConstBool(no_match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            switch_to(&ctx, merge_bb)
            return isdst
        case EAwait(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case ESpawn(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case ESpawnBlocking(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDictLiteral(dkeys, dvals):
            # `{}` / `{k: v, …}` — lower each key/value for side effects,
            # then call the appropriate constructor to produce a map with
            # valid `alloc`. Dict[K,V] → insertion-order-preserving
            # (gorget_dict_new*); HashMap[K,V] → unordered (gorget_map_new*).
            # Without a hint from SVarDecl the sizes fall back to 8
            # (pointer/int); with the hint we emit a magic sentinel name
            # `__gorget_{dict,map}_new_sized_K__<K>__V__<V>` which the
            # codegen expands to `gorget_{dict,map}_new(sizeof(K), sizeof(V))`
            # — required whenever K or V is an aggregate (LirStructDef et al.).
            String dict_kname = ctx.pending_dict_key_tyname
            String dict_vname = ctx.pending_dict_val_tyname
            bool dict_ordered = ctx.pending_dict_ordered
            ctx.pending_dict_key_tyname = ""
            ctx.pending_dict_val_tyname = ""
            ctx.pending_dict_ordered = false
            for dk in dkeys:
                lower_expr(&ctx, dk, &gmod)
            for dv in dvals:
                lower_expr(&ctx, dv, &gmod)
            int ddst = add_local(&ctx, lookup_or_register_named(&gmod, "GorgetMap"), NO_NAME)
            if dict_kname != "" and dict_vname != "":
                # Sentinel `__GGSEP__` separates K and V type names — zero
                # collision risk with real type names (no "GGSEP" pattern
                # appears in any monomorphized Gorget type).
                String magic_prefix = "__gorget_map_new_sized_"
                if dict_ordered:
                    magic_prefix = "__gorget_dict_new_sized_"
                String magic_dict = magic_prefix + dict_kname + "__GGSEP__" + dict_vname
                Vector[Operand] dn_args_typed = []
                emit(&ctx, GICallExtern(ddst, magic_dict, dn_args_typed))
            else:
                if dict_ordered:
                    Vector[Operand] dn_args_ord = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_dict_new", dn_args_ord))
                else:
                    Vector[Operand] dn_args = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_map_new", dn_args))
            return ddst
        else:
            # Remaining: EIt, EImplicitClosure, ESetComp,
            # EDictComp, EListComp, ERethrow, ECatch, EDo, ERange
            int fallback = add_local(&ctx, UNIT_TYPE, NO_NAME)
            emit(&ctx, GIAssign(fallback, OpConstUnit()))
            return fallback

# ── Call lowering ────────────────────────────────────────

# Set ctx.pending_*_tyname hints for a container-literal arg at a struct
# constructor call site. Early-exits when arg is NOT an empty container
# literal — the normal-case fast path — so per-arg overhead stays O(1)
# in the common case. Only when we've identified a container literal do
# we pay for the `gmod.type_infos.get(ctor_name)` lookup (a Dict probe +
# GirTypeInfo copy).
void apply_container_hint_for_ctor_arg(LowerCtx &ctx, String ctor_name, int ai, SpannedExpr arg, GirModule &gmod):
    # Fast reject for non-container-literal args (the common case).
    bool is_arr_lit = false
    bool is_dict_lit = false
    match arg.expr:
        case EArrayLiteral(_):
            is_arr_lit = true
        case EDictLiteral(_, _):
            is_dict_lit = true
        else:
            return
    # Look up the ctor's field type. Avoid value-copying GirTypeInfo
    # (its nested Vectors don't survive a shallow clone in stage-1).
    String fty_name = ""
    if gmod.type_infos.contains(ctor_name):
        GirTypeInfo cti_info = gmod.type_infos.get(ctor_name).unwrap()
        if cti_info.is_enum:
            return
        if ai >= cti_info.fields.len():
            return
        fty_name = cti_info.fields.get(ai).unwrap().type_name.clone()
    if fty_name == "":
        return
    if is_arr_lit:
        if fty_name.starts_with("Vector__"):
            # `.slice(...)` returns a view (cap=0) into fty_name's buffer;
            # fty_name is dropped at function exit and the view becomes
            # dangling. Materialize to an owned String before storing on
            # the LowerCtx field — the downstream magic-name concat would
            # otherwise read stale bytes and emit garbage like
            # `sizeof(��0XA./)` in stage-1's C.
            String elem_slice = fty_name.slice(8, fty_name.len())
            ctx.pending_vec_elem_tyname = elem_slice.clone()
    elif is_dict_lit:
        # Dict__<K>__<V> / HashMap__<K>__<V>. Simple first-split only;
        # nested generics (Dict__Vector__int64_t__int64_t) stay unhinted
        # and fall back to size 8.
        int d_prefix_len = -1
        bool d_ordered = false
        if fty_name.starts_with("Dict__"):
            d_prefix_len = 6
            d_ordered = true
        elif fty_name.starts_with("HashMap__"):
            d_prefix_len = 9
        elif fty_name.starts_with("Map__"):
            d_prefix_len = 5
        elif fty_name.starts_with("OrderedDict__"):
            d_prefix_len = 13
            d_ordered = true
        if d_prefix_len > 0:
            String d_rest = fty_name.slice(d_prefix_len, fty_name.len())
            int d_sep = -1
            int d_i = 0
            while d_i + 1 < d_rest.byte_len():
                if d_rest.byte_at(d_i) == 0x5F and d_rest.byte_at(d_i + 1) == 0x5F:
                    d_sep = d_i
                    break
                d_i += 1
            if d_sep > 0:
                String k_only = d_rest.slice(0, d_sep)
                String v_only = d_rest.slice(d_sep + 2, d_rest.len())
                if not k_only.contains("__") and not v_only.contains("__"):
                    # Same view-lifetime concern as the Vector case —
                    # clone to owned before storing.
                    ctx.pending_dict_key_tyname = k_only.clone()
                    ctx.pending_dict_val_tyname = v_only.clone()
                    ctx.pending_dict_ordered = d_ordered

int lower_call(LowerCtx &ctx, String &fname, Vector[SpannedExpr] &args, Vector[SpannedType] &targs, GirModule &gmod):
    int result = -1
    bool is_print = fname == "print"
    if is_print:
        # print() → printf
        if args.len() > 0:
            SpannedExpr parg = args.get(0).unwrap()
            int val = lower_expr(&ctx, parg, &gmod)
            int val_type = I64_TYPE
            if val >= 0 and val < ctx.locals.len():
                val_type = ctx.locals.get(val).unwrap().type_id
            String fmt = "%lld\n"
            if val_type == F64_TYPE:
                fmt = "%f\n"
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            if val_type == gs_tid:
                fmt = "%s\n"
            Vector[Operand] printf_args = [OpConstStr(fmt), op_consume(&ctx, &gmod, val)]
            int pdst = add_local(&ctx, I32_TYPE, NO_NAME)
            emit(&ctx, GICallExtern(pdst, "printf", printf_args))
            result = pdst
    elif (fname == "Str" or fname == "String" or fname == "GorgetString") and args.len() == 1:
        # Identity coercion: Str(x) / String(x) returns x (already a string).
        # Lower the inner arg and pass its type through.
        SpannedExpr inner = args.get(0).unwrap()
        result = lower_expr(&ctx, inner, &gmod)
    else:
        # Compute mangled name for generic calls
        String call_name = fname
        if targs.len() > 0:
            for ta in targs:
                call_name = call_name + "__" + type_to_c_name(ta, &gmod)
        # Resolve call redirects (bare → module-prefixed name).
        if gmod.call_redirects.contains(call_name):
            call_name = gmod.call_redirects.get(call_name).unwrap()
        # User function call
        Vector[Operand] gir_args = []
        # Look up borrow params from pre-scanned ownership info
        Vector[bool] borrow_flags = []
        if gmod.fn_borrow_params.contains(call_name):
            borrow_flags = gmod.fn_borrow_params.get(call_name).unwrap()
        int ai = 0
        while ai < args.len():
            SpannedExpr arg = args.get(ai).unwrap()
            # For struct-constructor calls, hint the container-literal
            # element size for each positional arg using the target field's
            # declared type. Look up type_infos inline (per-arg) — keeping
            # the GirTypeInfo as a local across iterations tripped a
            # field-move issue in the self-host compiler; querying anew
            # each time sidesteps it. Without this, `LowerCtx([], ..., {},
            # ...)` keeps scalar-sized allocators for the Vector/Dict
            # fields and later pushes corrupt adjacent slots.
            apply_container_hint_for_ctor_arg(&ctx, call_name, ai, arg, &gmod)
            int arg_local = lower_expr(&ctx, arg, &gmod)
            # Detect &arg (borrow) or pre-scanned borrow param
            bool is_borrow = false
            match arg.expr:
                case EMutableBorrow(_):
                    is_borrow = true
                else:
                    pass
            if not is_borrow and ai < borrow_flags.len():
                is_borrow = borrow_flags.get(ai).unwrap()
            if is_borrow:
                # Phase C step 5b: when the source is already a borrow,
                # propagate as OpBorrow. When the source is owned, the
                # caller's borrow is constructed by-move and the local
                # stays alive past the call — OpMove preserves the
                # existing shape for owned sources.
                GirLocal arg_loc = ctx.locals.get(arg_local).unwrap()
                match arg_loc.ownership:
                    case LoBorrowed():
                        gir_args.push(OpBorrow(arg_local))
                    else:
                        gir_args.push(OpMove(arg_local))
            else:
                # Phase C step 5c: pick OpMove/OpBorrow/OpCopy based on
                # source ownership and resource-typedness via the
                # `op_consume` dispatcher. Non-resource sources keep
                # OpCopy semantics.
                gir_args.push(op_consume(&ctx, &gmod, arg_local))
            ai = ai + 1
        # Look up return type from module's fn_sigs, or from function definitions
        int ret_type = I64_TYPE
        if gmod.fn_sigs.contains(call_name):
            ret_type = gmod.fn_sigs.get(call_name).unwrap()
        # Also check call_redirects for the original name.
        if ret_type == I64_TYPE and gmod.call_redirects.contains(fname):
            String redir = gmod.call_redirects.get(fname).unwrap()
            if gmod.fn_sigs.contains(redir):
                ret_type = gmod.fn_sigs.get(redir).unwrap()
        # Check function definitions for return type
        if ret_type == I64_TYPE:
            for gfn in gmod.functions:
                if gfn.name == call_name:
                    ret_type = gfn.return_type
                    break
        # Collection/struct constructors: return the named type
        if ret_type == I64_TYPE and is_type_constructor(call_name):
            # If call_name is an enum variant, route to the parent enum type.
            String parent = enum_variant_parent(call_name, &gmod)
            if parent != "":
                ret_type = lookup_or_register_named(&gmod, parent)
            else:
                ret_type = lookup_or_register_named(&gmod, call_name)
        # Monomorphized user-struct constructors (e.g. Wrapper__int64_t) —
        # detect via type_infos lookup even if name contains "__".
        if ret_type == I64_TYPE and gmod.type_infos.contains(call_name):
            ret_type = lookup_or_register_named(&gmod, call_name)
        # Template-name constructor: Wrapper__int64_t has template Wrapper
        # in type_infos. Route to the monomorphized named type.
        if ret_type == I64_TYPE:
            if call_name.contains("__"):
                int dunder = call_name.index_of("__").unwrap()
                if dunder > 0:
                    String tmpl_name = call_name.slice(0, dunder)
                    if gmod.type_infos.contains(tmpl_name):
                        ret_type = lookup_or_register_named(&gmod, call_name)
        # Builtin calls (args, read_file, int_to_str, ...)
        if ret_type == I64_TYPE:
            int builtin_ret = builtin_call_return_type(fname, &gmod)
            if builtin_ret >= 0:
                ret_type = builtin_ret
        int dst = add_local(&ctx, ret_type, NO_NAME)
        emit(&ctx, GICall(dst, call_name, gir_args))
        result = dst
    return result

# ── Statement lowering ───────────────────────────────────

void lower_stmt(LowerCtx &ctx, Stmt stmt, GirModule &gmod, bool is_main):
    match stmt:
        case SVarDecl(stype, name, init_expr, _, _, _):
            # Element-type hint for container literals: `Vector[T] x = []`
            # needs `gorget_array_new(sizeof(T))`, not the hardcoded 8.
            # Lift T from stype and park it on ctx; the EArrayLiteral /
            # EDictLiteral handlers consume and clear it. Without this hint
            # every aggregate Vector got elem_size=8, so pushes of 128-byte
            # LirStructDef structs corrupted adjacent elements — stage-1
            # crashed in lower_type_defs's `safe_get(i)` memcpy.
            match init_expr.expr:
                case EArrayLiteral(_):
                    match stype.ty:
                        case TNamed(tn_v, targs_v):
                            if (tn_v == "Vector" or tn_v == "Array" or tn_v == "Set" or tn_v == "HashSet" or tn_v == "OrderedSet") and targs_v.len() >= 1:
                                SpannedType elem_st = targs_v.get(0).unwrap()
                                # type_to_c_name may return a view (literal or
                                # borrowed slice); clone so the String outlives
                                # the temporary.
                                String vec_tc = type_to_c_name(elem_st, &gmod)
                                ctx.pending_vec_elem_tyname = vec_tc.clone()
                        else:
                            pass
                case EDictLiteral(_, _):
                    match stype.ty:
                        case TNamed(tn_d, targs_d):
                            if (tn_d == "Dict" or tn_d == "HashMap" or tn_d == "Map" or tn_d == "OrderedDict") and targs_d.len() >= 2:
                                SpannedType key_st = targs_d.get(0).unwrap()
                                SpannedType val_st = targs_d.get(1).unwrap()
                                String key_tc = type_to_c_name(key_st, &gmod)
                                String val_tc = type_to_c_name(val_st, &gmod)
                                ctx.pending_dict_key_tyname = key_tc.clone()
                                ctx.pending_dict_val_tyname = val_tc.clone()
                                ctx.pending_dict_ordered = (tn_d == "Dict" or tn_d == "OrderedDict")
                        else:
                            pass
                else:
                    pass
            int val = lower_expr(&ctx, init_expr, &gmod)
            int var_type = ctx.locals.get(val).unwrap().type_id
            # Prefer the declared type when it carries more info than the
            # init expression's inferred type. This recovers the Vector[T]
            # parametrization from e.g. `Vector[String] cmd_args = args()`
            # — the init would otherwise type the local as the runtime's
            # bare GorgetArray, losing the element type.
            int declared_ty = map_ast_type(stype, &gmod)
            if declared_ty != I64_TYPE and declared_ty != UNIT_TYPE and declared_ty != var_type:
                # Accept the declared type if it's a more specific monomorphized
                # collection (e.g. Vector__GorgetString vs GorgetArray).
                String declared_name = type_id_to_name(declared_ty, &gmod)
                String inferred_name = type_id_to_name(var_type, &gmod)
                if declared_name.contains("__") and not inferred_name.contains("__"):
                    var_type = declared_ty
            # cstr → String coercion at the boundary: `String err =
            # _parse_last_error()` where the extern returns `cstr`. Without
            # this, the cstr pointer gets stored into a Str slot and
            # subsequent `err.len()` calls treat the 8-byte pointer as a
            # 40-byte Str struct — the `len` field read aliases adjacent
            # stack and zeroes unrelated locals. Mirrors Rust's
            # `extern_cstr_return_vals` handling in
            # `src/backend/c_lir/mod.rs` which wraps the value with
            # `gorget_str_from_cstr` when the slot is Str-typed and the
            # source is a cstr-returning extern call.
            int gs_tid_decl = lookup_or_register_named(&gmod, "GorgetString")
            if declared_ty == gs_tid_decl and is_cstr_returning_call(init_expr, &gmod):
                int coerced = add_local(&ctx, gs_tid_decl, NO_NAME)
                Vector[Operand] cstr_args = [op_consume(&ctx, &gmod, val)]
                emit(&ctx, GICallExtern(coerced, "gorget_str_from_cstr", cstr_args))
                val = coerced
                var_type = gs_tid_decl
            int var_local = add_local(&ctx, var_type, Some(name.clone()))
            emit(&ctx, GIAssign(var_local, op_consume(&ctx, &gmod, val)))
            nl_put(&ctx, name, var_local)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(ret_expr):
                    int val = lower_expr(&ctx, ret_expr, &gmod)
                    emit(&ctx, GIAssign(0, op_consume(&ctx, &gmod, val)))
                    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0)))
                case None:
                    set_terminator(&ctx, GTReturn(OpConstUnit()))
        case SExpr(sexpr):
            lower_expr(&ctx, sexpr, &gmod)
        case SIf(cond_expr, then_body, elif_branches):
            lower_if(&ctx, cond_expr, then_body, elif_branches, &gmod, is_main)
        case SWhile(cond_expr, body):
            lower_while(&ctx, cond_expr, body, &gmod, is_main)
        case SAssign(target_expr, value_expr):
            match target_expr.expr:
                case EIdentifier(name):
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        int val = lower_expr(&ctx, value_expr, &gmod)
                        emit(&ctx, GIAssign(lid, op_consume(&ctx, &gmod, val)))
                case EFieldAccess(base_box, field_name):
                    # self.field = value
                    # Lower as: __field_write_TYPE_FIELD(&base, value).
                    # The codegen expands this to `((T*)base)->field = value;`.
                    # Previously silently dropped — `self.lex_pos += 1` didn't
                    # increment, leaving the lexer loop spinning.
                    lower_field_write(&ctx, *base_box, field_name, value_expr, &gmod)
                case EIndex(base_box, idx_box):
                    # v[i] = x — Vector/Dict/Set index assignment. Dispatch
                    # to the collection's runtime setter based on the base
                    # type name. The self-host uses this for Dict[K,V] put
                    # (int_consts[name] = val) and Vector[T] set patterns.
                    lower_index_assign(&ctx, *base_box, *idx_box, value_expr, &gmod)
                else:
                    lower_fail("SAssign target is neither EIdentifier, EFieldAccess, nor EIndex (got: " + expr_kind(target_expr.expr) + ")")
        case SBreak(_):
            # Jump to the innermost loop's break target. Silently dropped
            # before, which caused while-loops in the self-host lexer to
            # never exit on their closing-quote checks.
            if ctx.loop_break_stack.len() > 0:
                int tgt = ctx.loop_break_stack.get(ctx.loop_break_stack.len() - 1).unwrap()
                set_terminator(&ctx, GTJump(tgt))
        case SContinue:
            if ctx.loop_continue_stack.len() > 0:
                int tgt = ctx.loop_continue_stack.get(ctx.loop_continue_stack.len() - 1).unwrap()
                set_terminator(&ctx, GTJump(tgt))
        case SPass:
            # `pass` is a literal no-op statement. Explicit case silences
            # the lower_fail diagnostic; behaviour is unchanged.
            pass
        case SMeta:
            # Standalone `meta` marker — compile-time sentinel, no runtime.
            pass
        case SMetaFor(_):
            # `meta for` — compile-time loop already expanded earlier in
            # the pipeline; any remaining SMetaFor is a residual marker.
            pass
        case SMetaIf(_, _):
            # `meta if` — compile-time conditional, already resolved.
            pass
        case SMatch(scrutinee, arms):
            # Real SMatch lowering — delegates to lower_match_stmt for
            # the per-arm ctor / binding / guard scaffolding. Payload
            # binds of type Box[T] are consumed via EDeref → GIDeref
            # which emits a proper load.
            lower_match_stmt(&ctx, scrutinee, arms, &gmod, is_main)
        case SLoop(body):
            # Unconditional loop — `loop: body`, exit via break. Same
            # shape as `while true:`, but the body's default back-edge
            # jumps to the body itself rather than a condition header.
            int loop_bb = new_block(&ctx)
            int loop_exit_bb = new_block(&ctx)
            set_terminator(&ctx, GTJump(loop_bb))
            ctx.loop_continue_stack.push(loop_bb)
            ctx.loop_break_stack.push(loop_exit_bb)
            switch_to(&ctx, loop_bb)
            lower_stmts(&ctx, body, &gmod, is_main)
            Terminator loop_body_term = ctx.block_terms.get(ctx.current_block).unwrap()
            match loop_body_term:
                case GTNone():
                    set_terminator(&ctx, GTJump(loop_bb))
                else:
                    pass
            ctx.loop_continue_stack.pop()
            ctx.loop_break_stack.pop()
            switch_to(&ctx, loop_exit_bb)
        case SCompoundAssign(target_expr, op, value_expr):
            # x <op>= y  →  x = x <op> y. Lower per target shape: local
            # identifier goes through GIAssign, field access goes through
            # __field_read + binop + __field_write.
            match target_expr.expr:
                case EIdentifier(name):
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        int lhs_type = ctx.locals.get(lid).unwrap().type_id
                        int lhs_val = add_local(&ctx, lhs_type, NO_NAME)
                        emit(&ctx, GIAssign(lhs_val, op_consume(&ctx, &gmod, lid)))
                        int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                        int op_dst = add_local(&ctx, lhs_type, NO_NAME)
                        emit(&ctx, GIBinOp(op_dst, map_compound_binop(op), lhs_type, op_consume(&ctx, &gmod, lhs_val), op_consume(&ctx, &gmod, rhs_val)))
                        emit(&ctx, GIAssign(lid, op_consume(&ctx, &gmod, op_dst)))
                case EFieldAccess(base_box, field_name):
                    # self.field <op>= value
                    # Lower as: self.field = self.field <op> value.
                    # Read via lower_expr on the original field-access
                    # expression (reuses __field_read), binop, field write.
                    int lhs_val = lower_expr(&ctx, target_expr, &gmod)
                    int lhs_type = ctx.locals.get(lhs_val).unwrap().type_id
                    int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                    int op_dst = add_local(&ctx, lhs_type, NO_NAME)
                    emit(&ctx, GIBinOp(op_dst, map_compound_binop(op), lhs_type, op_consume(&ctx, &gmod, lhs_val), op_consume(&ctx, &gmod, rhs_val)))
                    # Wrap op_dst in a synthetic SpannedExpr to feed the
                    # same field-write path used above.
                    emit_field_write_from_local(&ctx, *base_box, field_name, op_dst, &gmod)
                else:
                    lower_fail("SCompoundAssign target is neither EIdentifier nor EFieldAccess")
        case SFor(pat, iter_expr, body, _own, else_body):
            lower_for(&ctx, pat, iter_expr, body, else_body, &gmod, is_main)
        else:
            lower_fail("unhandled in lower_stmt: " + stmt_kind(stmt))

# Lower `base.field = value_expr`. Emits GICallExtern for the codegen-side
# __field_write_TYPE_FIELD helper which expands to `((T*)base)->field = value`.
void lower_field_write(LowerCtx &ctx, SpannedExpr base_expr, String field_name, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_expr(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    # Unwrap Ptr/MutPtr to get the inner type name.
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    int val = lower_expr(&ctx, value_expr, &gmod)
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # Phase C step 5b: borrowed base → OpBorrow, owned → OpMove.
        GirLocal fw_base_loc = ctx.locals.get(base).unwrap()
        match fw_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpMove(base))
    write_args.push(op_consume(&ctx, &gmod, val))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# Variant of lower_field_write that takes a pre-lowered local id for the
# value rather than re-lowering an expression.
void emit_field_write_from_local(LowerCtx &ctx, SpannedExpr base_expr, String field_name, int value_local, GirModule &gmod):
    int base = lower_expr(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # Phase C step 5b: borrowed base → OpBorrow, owned → OpMove.
        GirLocal fwf_base_loc = ctx.locals.get(base).unwrap()
        match fwf_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpMove(base))
    write_args.push(op_consume(&ctx, &gmod, value_local))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# Showcase blocker #1 writeback: emit `coll.set(idx, !value_local)` after
# a mutating method on `coll.get(idx).unwrap()`. The mutated value local
# (independently cloned by emit_payload_read) is written back into the
# collection element at idx so the mutation survives the chain.
#
# Coll + idx are re-lowered here from their AST forms — same trade-off
# as `emit_field_write_from_local` re-lowering `base_expr`. For typical
# self-host uses (named locals / params) this is side-effect-free; if a
# user threads a complex side-effecting expression in either position
# they get the same caveat as the field-writeback path.
void emit_chain_writeback(LowerCtx &ctx, SpannedExpr coll_expr, SpannedExpr idx_expr, int value_local, GirModule &gmod):
    int coll = lower_expr(&ctx, coll_expr, &gmod)
    int idx = lower_expr(&ctx, idx_expr, &gmod)
    int coll_tid = ctx.locals.get(coll).unwrap().type_id
    String coll_tn = type_id_to_name(coll_tid, &gmod)
    # Unwrap Ptr/MutPtr to get the inner collection type name.
    if coll_tid >= 0 and coll_tid < gmod.type_table.len():
        GirType ct = gmod.type_table.get(coll_tid).unwrap()
        match ct:
            case GtPtr(inner):
                coll_tn = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                coll_tn = type_id_to_name(inner, &gmod)
            else:
                pass
    # Vector/Deque → coll_tn + "__set"  (maps to gorget_array_set at LIR)
    # Dict/HashMap → coll_tn + "__set"  (maps to gorget_map_put at LIR; "set"
    #                                    is an alias for "put" — see
    #                                    lir_lower.gg::map_dict_method)
    # Other receivers fall through silently — better to lose the writeback
    # than emit a bogus call.
    bool is_vector = coll_tn.starts_with("Vector__") or coll_tn.starts_with("Deque__")
    bool is_dict = coll_tn.starts_with("Dict__") or coll_tn.starts_with("HashMap__")
    if not (is_vector or is_dict):
        return
    String set_fn = coll_tn + "__set"
    Vector[Operand] set_args = []
    # gorget_array_set takes the array by pointer — OpBorrow keeps the
    # collection live for any subsequent reads in the same block.
    GirLocal coll_loc = ctx.locals.get(coll).unwrap()
    match coll_loc.ownership:
        case LoBorrowed():
            set_args.push(OpBorrow(coll))
        else:
            set_args.push(OpBorrow(coll))
    set_args.push(op_consume(&ctx, &gmod, idx))
    set_args.push(OpMove(value_local))
    emit(&ctx, GICallExtern(-1, set_fn, set_args))

# ── Control flow lowering ────────────────────────────────

void lower_stmts(LowerCtx &ctx, Vector[Stmt] stmts, GirModule &gmod, bool is_main):
    for stmt in stmts:
        lower_stmt(&ctx, stmt, &gmod, is_main)

void lower_if(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] then_body, Vector[ElseBranch] elif_branches, GirModule &gmod, bool is_main):
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    int then_bb = new_block(&ctx)
    int else_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
    # Then branch
    switch_to(&ctx, then_bb)
    lower_stmts(&ctx, then_body, &gmod, is_main)
    # Only jump to merge if not already terminated (no return/break)
    Terminator then_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match then_term:
        case GTNone():
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pass
    # Else branch
    switch_to(&ctx, else_bb)
    if elif_branches.len() > 0:
        ElseBranch eb = elif_branches.get(0).unwrap()
        match eb.condition:
            case Some(elif_cond):
                # elif branch — recurse
                Vector[ElseBranch] remaining = []
                int ebi = 1
                while ebi < elif_branches.len():
                    remaining.push(elif_branches.get(ebi).unwrap())
                    ebi = ebi + 1
                lower_if(&ctx, elif_cond, eb.body, remaining, &gmod, is_main)
            case None:
                # else branch
                lower_stmts(&ctx, eb.body, &gmod, is_main)
    Terminator else_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match else_term:
        case GTNone():
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pass
    switch_to(&ctx, merge_bb)


# Lower `base[idx] = value` as a collection-typed setter call. Vector
# routes to gorget_array_set; Dict / HashMap route to gorget_map_put;
# Set has no meaningful index-assign so falls through to lower_fail.
void lower_index_assign(LowerCtx &ctx, SpannedExpr base_expr, SpannedExpr idx_expr, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_expr(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_tname = type_id_to_name(base_tid, &gmod)
    int idx = lower_expr(&ctx, idx_expr, &gmod)
    int val = lower_expr(&ctx, value_expr, &gmod)
    String setter = ""
    # Phase A typed read: dispatch on the receiver's collection_kind.
    # CkSet / CkHeap have no meaningful index-assign — fall through to lower_fail.
    match build_resource_metadata(base_tname):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkVector():
                    setter = "gorget_array_set"
                case CkDeque():
                    setter = "gorget_array_set"
                case CkDict():
                    setter = "gorget_map_put"
                else:
                    pass
        case None:
            pass
    if setter == "":
        lower_fail("lower_index_assign: unsupported base type " + base_tname)
        return
    # gorget_array_set / gorget_map_put take self by pointer (&base),
    # key/index by value, and value by pointer-or-value depending on
    # element type. Use OpMove / OpBorrow so needs_ptr_arg emits
    # SlotAddr for the collection pointer (Phase C step 5b: borrowed
    # base → OpBorrow, owned → OpMove).
    Operand base_op = OpMove(base)
    GirLocal idx_base_loc = ctx.locals.get(base).unwrap()
    match idx_base_loc.ownership:
        case LoBorrowed():
            base_op = OpBorrow(base)
        else:
            pass
    Vector[Operand] set_args = [base_op, op_consume(&ctx, &gmod, idx), op_consume(&ctx, &gmod, val)]
    emit(&ctx, GICallExtern(-1, setter, set_args))

# Look up the parent enum name for a type. If `type_name` itself is an
# enum (GirTypeInfo.is_enum), returns it. Otherwise returns "".
String match_enum_type(String type_name, GirModule &gmod):
    # Check the enum registry first (populated from EnumDef pass).
    if gmod.enum_registry.contains(type_name):
        return type_name
    if gmod.type_infos.contains(type_name):
        GirTypeInfo ti = gmod.type_infos.get(type_name).unwrap()
        if ti.is_enum:
            return type_name
    # Prelude mono'd enums (Option__X / Result__X__Y) aren't in
    # type_infos — they're synthesized in lir_lower's Pass 3. But
    # `match opt: case Some(x): ...` needs a real enum name here or
    # lower_ctor_pattern falls through to an always-match `GTJump`, so
    # every arm body runs unconditionally (which is why stage-1 tokenized
    # "main" as TkKeyword — the `else:` branch of the Option match was
    # never reached). Return the type_name itself for these; paired with
    # match_variant_index's hardcoded Some/None/Ok/Error indices below.
    if type_name.starts_with("Option__") or type_name.starts_with("Result__"):
        return type_name
    return ""

# Find the variant's index in its enum's variant list. Returns -1 if
# the enum or variant isn't registered.
int match_variant_index(String enum_name, String variant_name, GirModule &gmod):
    # Prelude enums: hardcode variant indices that match lir_lower's
    # VariantInfo table (prelude_variant_info) and Pass 3's field layout.
    # Match both the mono'd form (`Option__T`) AND the bare prelude name
    # (`Option`) — the latter is the synthetic name used by
    # `lower_ctor_pattern`'s last-resort fallback when the scrutinee's
    # type couldn't be recovered.
    if enum_name == "Option" or enum_name.starts_with("Option__"):
        if variant_name == "Some":
            return 0
        if variant_name == "None":
            return 1
        return -1
    if enum_name == "Result" or enum_name.starts_with("Result__"):
        if variant_name == "Ok":
            return 0
        if variant_name == "Error":
            return 1
        return -1
    # Check the enum registry first; fall back to type_infos.
    int reg_idx = enum_variant_index(&gmod, enum_name, variant_name)
    if reg_idx >= 0:
        return reg_idx
    if not gmod.type_infos.contains(enum_name):
        return -1
    GirTypeInfo ti = gmod.type_infos.get(enum_name).unwrap()
    int i = 0
    while i < ti.variants.len():
        GirEnumVariantInfo v = ti.variants.get(i).unwrap()
        if v.name == variant_name:
            return i
        i += 1
    return -1

# Emit a tag-read against the scrutinee. Returns the local id holding
# the int32 tag value. The enum_name must be a plain identifier (no
# `__` separator); Option/Result variants aren't yet supported by this
# routing because the name-based __field_read_ parser splits on the
# first `_` and confuses `Option__int64_t` with the `Option` type.
int emit_tag_read(LowerCtx &ctx, int scrutinee_ptr, String enum_name, GirModule &gmod):
    String read_fn = "__field_read_" + enum_name + "_tag"
    Vector[Operand] args = [op_consume(&ctx, &gmod, scrutinee_ptr), OpConstI64(0)]
    int tag = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GICallExtern(tag, read_fn, args))
    return tag

# Resolve the runtime clone function for a payload type, or "" if no
# safe clone is available at this site. Routes through
# `build_resource_metadata` for builtin runtime types
# (GorgetString/Array/Map/Set/Closure and their parameterised forms);
# user-defined resource structs/enums would use `T__clone` but the
# C codegen emits that symbol only for types in
# `recursive_drop_structs`/`recursive_drop_enums`, populated later
# in the LIR-lower pass. Emitting `T__clone` here for a type that
# never gets registered produces a stage-1 link error; until the
# user-type clone emission is wired through `gmod.resource_types`
# unconditionally, restrict the clone path to builtins.
#
# `gorget_string_clone_to_owned` and `gorget_closure_clone_to_owned`
# override `build_resource_metadata`'s `clone_fn` because their
# `_to_owned` variants are what `infer_runtime_return_type` registers
# as returning the struct type by value (vs the in-place variants
# that return void).
String resolve_payload_clone_fn(String tname, GirModule &gmod):
    if tname == "":
        return ""
    match build_resource_metadata(tname):
        case Some(rmeta):
            match rmeta.clone_fn:
                case Some(fn):
                    if rmeta.runtime_name == "GorgetString":
                        return "gorget_string_clone_to_owned"
                    if rmeta.runtime_name == "GorgetClosure":
                        return "gorget_closure_clone_to_owned"
                    return fn
                case None:
                    pass
        case None:
            pass
    # §7 row 1 (2026-05-13): user-type fallback. `T__clone` is emitted
    # by `populate_drop_metadata` in `lir_lower.gg` for every type
    # registered as a resource AND not imported from another module
    # (the imported-type skip there avoids duplicate definitions).
    # We mirror that filter here so we never emit a call to a clone
    # symbol that the lir_codegen pass would skip.
    if gmod.resource_types.contains(tname) and gmod.type_infos.contains(tname):
        if not gmod.imported_fns.contains("__imported_type__" + tname):
            return tname + "__clone"
    return ""

# Emit a variant-payload read. `variant_name` + `field_idx` determines
# which struct field to read; result binds into `dst_type`.
int emit_payload_read(LowerCtx &ctx, int scrutinee_ptr, String enum_name, String variant_name, int field_idx, int dst_type, GirModule &gmod):
    String field = variant_name + "_" + int_to_str(field_idx)
    String read_fn = "__field_read_" + enum_name + "_" + field
    Vector[Operand] args = [op_consume(&ctx, &gmod, scrutinee_ptr), OpConstI64(field_idx)]
    # The field read produces a byte-copy of the variant's payload
    # bytes — for resource payloads (Vector, Dict, String, user enums
    # with resource sub-fields), those bytes alias the scrutinee's
    # interior. Returning that alias directly means downstream
    # value-passing (e.g., `type_check_item(item, ...)`) byte-copies the
    # alias into the callee's frame; the callee destructures, mutates
    # state, and the alias's storage invalidates → SIGSEGV (showcase
    # blocker #2). Fix: when the payload type has a clone fn, emit a
    # real clone so the extracted value is independently owned.
    #
    # Borrow-mode arg + slot-addr at the call boundary handles the
    # signature (`T T__clone(T*)` / `T gorget_string_clone_to_owned(T*)`)
    # — Phase D step 3's OpBorrow lowering at lir_lower.gg already
    # threads SlotAddr for pass-by-ptr args.
    int dst = add_local_with(&ctx, dst_type, NO_NAME, LoBorrowed(), BoField())
    emit(&ctx, GICallExtern(dst, read_fn, args))
    String dst_tname = type_id_to_name(dst_type, &gmod)
    String clone_fn = resolve_payload_clone_fn(dst_tname, &gmod)
    if clone_fn != "":
        int cloned = add_local(&ctx, dst_type, NO_NAME)
        Vector[Operand] clone_args = [OpBorrow(dst)]
        emit(&ctx, GICallExtern(cloned, clone_fn, clone_args))
        return cloned
    return dst

# Take the address of scrutinee's local so we can pass a pointer to the
# field_read helpers (arg 0 is Ptr-typed by needs_ptr_arg convention).
int match_scrutinee_ptr(LowerCtx &ctx, GirModule &gmod, int scrutinee):
    # Move the value into a temp local so we can take its address —
    # scrutinee may already be an identifier with a stable slot, but
    # this extra copy keeps the address path uniform.
    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
    int tmp = add_local(&ctx, scr_tid, NO_NAME)
    emit(&ctx, GIAssign(tmp, op_consume(&ctx, &gmod, scrutinee)))
    return tmp

# Lower a single match arm's pattern-match test. Emits branches to
# either `match_bb` (pattern matched, possibly with bindings) or
# `no_match_bb` (pattern didn't match, try next arm).
void lower_pattern_match(LowerCtx &ctx, int scrutinee, SpannedPattern spat, String enum_name, int match_bb, int no_match_bb, GirModule &gmod):
    match spat.pat:
        case PWildcard:
            set_terminator(&ctx, GTJump(match_bb))
        case PBinding(name):
            # The parser produces PBinding for any bare identifier — both
            # real variable bindings (`case x:`) AND unit enum variants
            # (`case KwInt:`). If `name` is a known variant of the current
            # enum, treat it as a zero-arg PConstructor so we emit a proper
            # tag check instead of an always-true catch-all.
            if enum_name != "" and match_variant_index(enum_name, name, &gmod) >= 0:
                Vector[SpannedPattern] no_sub_pats = []
                lower_ctor_pattern(&ctx, scrutinee, name, no_sub_pats, enum_name, match_bb, no_match_bb, &gmod)
            else:
                # Real binding: always match; bind scrutinee into a fresh
                # local under `name`.
                int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
                Option[String] name_opt = Some(name.clone())
                int bound = add_local(&ctx, scr_tid, name_opt)
                emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, scrutinee)))
                nl_put(&ctx, name, bound)
                set_terminator(&ctx, GTJump(match_bb))
        case PConstructor(variant_name, sub_pats):
            lower_ctor_pattern(&ctx, scrutinee, variant_name, sub_pats, enum_name, match_bb, no_match_bb, &gmod)
        case PDotShorthand(variant_name, sub_pats):
            # `.VariantName(pats)` — same semantics as PConstructor with
            # enum name inferred from the scrutinee's type.
            lower_ctor_pattern(&ctx, scrutinee, variant_name, sub_pats, enum_name, match_bb, no_match_bb, &gmod)
        case PLiteral(lit_expr):
            # `case N:` / `case "x":` / `case true:` — emit an equality
            # check against the literal value. Without this every literal
            # pattern fell through to the unconditional `GTJump(match_bb)`
            # below, making `match tid: case 0: ...; case 4: ...` always
            # take the first arm (every call to `type_id_to_name` returned
            # "bool" regardless of tid).
            #
            # `case None:` is parsed as `PLiteral(ENoneLiteral)` by the
            # parser (not PConstructor), so route None patterns through the
            # ctor-pattern path — None is a variant constructor, not a
            # comparable value, and Option types don't support `==` at the
            # GIR level.
            match lit_expr.expr:
                case ENoneLiteral():
                    Vector[SpannedPattern] no_sub_pats = []
                    lower_ctor_pattern(&ctx, scrutinee, "None", no_sub_pats, enum_name, match_bb, no_match_bb, &gmod)
                else:
                    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
                    int lit_val = lower_expr(&ctx, lit_expr, &gmod)
                    int cmp_tid = I64_TYPE
                    if scr_tid == BOOL_TYPE:
                        cmp_tid = BOOL_TYPE
                    int is_match = add_local(&ctx, BOOL_TYPE, NO_NAME)
                    emit(&ctx, GICmp(is_match, CMP_EQ, cmp_tid, op_consume(&ctx, &gmod, scrutinee), op_consume(&ctx, &gmod, lit_val)))
                    set_terminator(&ctx, GTBranch(OpCopy(is_match), match_bb, no_match_bb))
        case POr(alts):
            # `case A | B | C:` — match if any alternative matches. Each
            # alternative tries to match, branches to match_bb on success
            # or to the next alternative's attempt block on failure. The
            # last alternative's no-match goes to no_match_bb.
            #
            # Previously fell through to the unconditional `GTJump(match_bb)`
            # below — every POr arm unconditionally matched regardless of
            # the scrutinee, which broke the 32 uses of `a | b` patterns
            # in the self-host sources.
            if alts.len() == 0:
                set_terminator(&ctx, GTJump(no_match_bb))
            else:
                int ai = 0
                while ai < alts.len():
                    SpannedPattern alt = alts.get(ai).unwrap()
                    int next_alt_bb = no_match_bb
                    if ai + 1 < alts.len():
                        next_alt_bb = new_block(&ctx)
                    lower_pattern_match(&ctx, scrutinee, alt, enum_name, match_bb, next_alt_bb, &gmod)
                    if ai + 1 < alts.len():
                        switch_to(&ctx, next_alt_bb)
                    ai += 1
        else:
            # Unsupported pattern shape (PTuple, PRest) — fall through
            # with a permissive match rather than silently dropping the arm
            # body. Future fixes: add proper patterns.
            lower_fail("unsupported pattern variant in match arm")
            set_terminator(&ctx, GTJump(match_bb))

void lower_ctor_pattern(LowerCtx &ctx, int scrutinee, String variant_name, Vector[SpannedPattern] sub_pats, String enum_name, int match_bb, int no_match_bb, GirModule &gmod):
    # Mirrors Rust's `patterns.rs:388-397`: prefer enum_name from the
    # scrutinee's type, but fall back to the pattern's qualified name,
    # and finally scan all registered enums for a variant with this name.
    # `case ParseError.Empty()` arrives as variant_name="ParseError.Empty"
    # — even without scrutinee type info, we recover the enum from the
    # pattern's qualifier. Bare variants like `case EBinaryOp(...)` don't
    # carry enum info, so we scan for a unique enum that declares this
    # variant.
    String effective_enum = enum_name
    String effective_variant = variant_name
    if variant_name.contains("."):
        int dot_pos = variant_name.index_of(".").unwrap()
        String qual_enum = variant_name.slice(0, dot_pos)
        String bare_variant = variant_name.slice(dot_pos + 1, variant_name.len())
        if effective_enum == "":
            effective_enum = qual_enum
        effective_variant = bare_variant
    # If still unresolved, scan the enum registry for a matching variant.
    # This mirrors Rust's `ctx.resolve_enum_variant(...)` fallback.
    if effective_enum == "":
        String guessed = find_enum_by_variant(&gmod, effective_variant)
        if guessed.len() > 0:
            effective_enum = guessed
    # Scrutinee-type fallback: when `match_enum_type` returned empty
    # (e.g. `auto`-inferred scrutinee with prelude variants), recover
    # the enum directly from the scrutinee's local type. The `__`
    # mangling keeps `Option__T` / `Result__T__E` distinguishable, and
    # the existing `match_variant_index` / `__field_read_<enum>_<field>`
    # machinery already handles those prefixes (see line 2667-2678 +
    # `lir_codegen.gg:3445` longest-prefix split). Required for
    # `case Ok(v):` / `case Some(v):` cascades — without this, `v` was
    # never bound as a local.
    if effective_enum == "":
        int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
        if scr_tid >= 0 and scr_tid < gmod.type_table.len():
            int peeled_tid = scr_tid
            GirType bt = gmod.type_table.get(scr_tid).unwrap()
            match bt:
                case GtPtr(inner):
                    peeled_tid = inner
                case GtMutPtr(inner):
                    peeled_tid = inner
                else:
                    pass
            String scr_type_name = type_id_to_name(peeled_tid, &gmod)
            if scr_type_name.starts_with("Option__") or scr_type_name.starts_with("Result__"):
                effective_enum = scr_type_name
    # Last-resort prelude fallback: when the scrutinee's type was lost
    # entirely (`auto` binding mis-typed to I64, generic-context T not
    # yet substituted), the variant name itself disambiguates Result vs
    # Option. We can't reconstruct the mangled `Option__T` name here
    # without the scrutinee type, but emitting a synthetic enum name
    # `Option` / `Result` is enough to register the binding(s) in the
    # match arm — `match_variant_index` and `emit_tag_read` learn to
    # accept the bare prelude names below. Without this, every
    # mis-typed match arm fell through to the unconditional `GTJump`
    # path and bound nothing — every Ok/Error/Some bare-name use
    # cascaded into a `[bug] EIdentifier` placeholder, then 0-typed.
    if effective_enum == "":
        if effective_variant == "Ok" or effective_variant == "Error":
            effective_enum = "Result"
        elif effective_variant == "Some" or effective_variant == "None":
            effective_enum = "Option"
    if effective_enum == "":
        # Truly nothing we can do. Hits on monomorphized Option / Result
        # which use `__` separators the __field_read_ parser can't split
        # cleanly, or on variants we never registered.
        lower_fail("PConstructor on non-enum scrutinee — enum_name empty (variant='" + variant_name + "')")
        set_terminator(&ctx, GTJump(match_bb))
        return
    int expected_tag = match_variant_index(effective_enum, effective_variant, &gmod)
    if expected_tag < 0:
        lower_fail("PConstructor variant not in enum: enum='" + effective_enum + "' variant='" + effective_variant + "'")
        set_terminator(&ctx, GTJump(match_bb))
        return
    int scrutinee_ptr = match_scrutinee_ptr(&ctx, &gmod, scrutinee)
    int tag = emit_tag_read(&ctx, scrutinee_ptr, effective_enum, &gmod)
    int expected = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(expected, OpConstI64(expected_tag)))
    int is_match = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(is_match, CMP_EQ, I64_TYPE, OpCopy(tag), OpCopy(expected)))
    # Unit variants (no sub_pats): skip the intermediate bind_bb — branch
    # straight to match_bb on success. Saves 1 block per arm, which matters
    # for matches on big imported enums (Keyword has ~60 variants; without
    # this the GIR block count explodes and stage-0 OOMs during self-host
    # compile).
    if sub_pats.len() == 0:
        set_terminator(&ctx, GTBranch(OpCopy(is_match), match_bb, no_match_bb))
        return
    int bind_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(is_match), bind_bb, no_match_bb))
    switch_to(&ctx, bind_bb)
    # Bind payload sub-patterns. For each sub_pat, emit a payload read
    # then match that sub-pattern. If a sub-pat doesn't match the whole
    # arm fails — but we simplify: PBinding/PWildcard sub-pats always
    # match, so just bind linearly here.
    int fi = 0
    while fi < sub_pats.len():
        SpannedPattern sp = sub_pats.get(fi).unwrap()
        match sp.pat:
            case PWildcard:
                pass
            case PBinding(bname):
                # Look up field type from the enum's variant's field info.
                int fty = lookup_ctor_field_type(effective_enum, effective_variant, fi, &gmod)
                int field_val = emit_payload_read(&ctx, scrutinee_ptr, effective_enum, effective_variant, fi, fty, &gmod)
                Option[String] bname_opt = Some(bname.clone())
                int bound = add_local(&ctx, fty, bname_opt)
                emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, field_val)))
                nl_put(&ctx, bname, bound)
            case PLiteral(lit_expr):
                # Literal sub-pattern: read the payload field, compare against
                # the literal, branch to no_match_bb on mismatch. Used by
                # `case Ok(0):` / `case Some(true):` shapes — without this,
                # the arm match'd on tag alone and the literal check was
                # silently dropped (broken behaviour: `case Ok(0)` matched
                # ALL Ok values). Only primitives (int / bool / char / float)
                # are wired here; string literal sub-patterns would need a
                # `gorget_str_eq` call and aren't exercised today.
                int lit_fty = lookup_ctor_field_type(effective_enum, effective_variant, fi, &gmod)
                int lit_field_val = emit_payload_read(&ctx, scrutinee_ptr, effective_enum, effective_variant, fi, lit_fty, &gmod)
                int lit_val = lower_expr(&ctx, lit_expr, &gmod)
                int lit_eq = add_local(&ctx, BOOL_TYPE, NO_NAME)
                emit(&ctx, GICmp(lit_eq, CMP_EQ, lit_fty, OpCopy(lit_field_val), OpCopy(lit_val)))
                int lit_continue_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(lit_eq), lit_continue_bb, no_match_bb))
                switch_to(&ctx, lit_continue_bb)
            else:
                lower_fail("nested non-binding pattern in PConstructor — using wildcard fallback (got: " + pat_kind(sp.pat) + ")")
        fi += 1
    set_terminator(&ctx, GTJump(match_bb))

int lookup_ctor_field_type(String enum_name, String variant_name, int field_idx, GirModule &gmod):
    # Prelude mono'd enum payload type: extract T from the mangled name.
    # Option__T.Some(T) → T.  Result__T__E.Ok(T) / Error(E) → T or E.
    if enum_name.starts_with("Option__"):
        if variant_name == "Some" and field_idx == 0:
            String inner = enum_name.slice(8, enum_name.len())
            return resolve_field_gir_type(inner, &gmod)
        return I64_TYPE
    if enum_name.starts_with("Result__"):
        # Skip this fix for Result — naive leftmost-`__` split fails on
        # nested generics like `Result__Vector__byte__IoError` where Ok
        # would incorrectly become `Vector` and Err `byte__IoError`.
        # Use the pre-existing I64 fallback until we can mirror Pass 3's
        # try-each-split approach here.
        return I64_TYPE
    String found_field_type = ""
    if gmod.type_infos.contains(enum_name):
        GirTypeInfo ti = gmod.type_infos.get(enum_name).unwrap()
        for v in ti.variants:
            if v.name == variant_name:
                if field_idx < v.fields.len():
                    GirFieldInfo f = v.fields.get(field_idx).unwrap()
                    found_field_type = f.type_name.clone()
                break
    if found_field_type != "":
        return resolve_field_gir_type(found_field_type, &gmod)
    return I64_TYPE

void lower_match_stmt(LowerCtx &ctx, SpannedExpr scrutinee_expr, Vector[MatchArm] arms, GirModule &gmod, bool is_main):
    int scrutinee = lower_expr(&ctx, scrutinee_expr, &gmod)
    int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
    String type_name = type_id_to_name(scr_tid, &gmod)
    # Unwrap Ptr if the scrutinee came through a borrow.
    if scr_tid >= 0 and scr_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(scr_tid).unwrap()
        match bt:
            case GtPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    String enum_name = match_enum_type(type_name, &gmod)
    int merge_bb = new_block(&ctx)
    for arm in arms:
        int arm_body_bb = new_block(&ctx)
        int next_arm_bb = new_block(&ctx)
        lower_pattern_match(&ctx, scrutinee, arm.pattern, enum_name, arm_body_bb, next_arm_bb, &gmod)
        # Arm body lowering in the match-bound block.
        switch_to(&ctx, arm_body_bb)
        lower_stmts(&ctx, arm.body, &gmod, is_main)
        Terminator arm_term = ctx.block_terms.get(ctx.current_block).unwrap()
        match arm_term:
            case GTNone():
                set_terminator(&ctx, GTJump(merge_bb))
            else:
                pass
        switch_to(&ctx, next_arm_bb)
    # No arm matched — jump to merge (unreachable in practice when the
    # match is exhaustive; the self-host's typechecker doesn't enforce
    # exhaustiveness yet so we keep a safe fall-through).
    set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)

# Lower `for pat in iter_expr: body` over Vector / Deque collections.
#
# Architecturally: ONE arm in `lower_stmt`, ONE scaffold here, parameterised
# by collection type only at the element-extract step. This is intentionally
# unified — the Rust frontend currently has SEVEN separate `lower_for_*`
# functions (one each for array, dict, set, string, iterable, enumerate,
# range) that duplicate ~80% scaffold; self-host's reference-grade answer
# is the single-scaffold + per-type extractor split documented below.
# See TODO `lower_for: iterator-protocol fallback for non-Vector iterables`
# for the path to extending this beyond Vector/Deque.
#
# Desugar shape (matches the manual idiom users write today):
#
#   for x in coll:                       int idx = 0
#       <body>                           int len = coll.len()
#                                  →     while idx < len:
#                                            auto x = coll.get(idx).unwrap()
#                                            <body>
#                                            idx = idx + 1
#
#   for (i, x) in coll.enumerate():      <same scaffold, additionally>
#       <body>                       →   bind `i` to a fresh copy of idx
#                                        per iteration (immutable snapshot)
#
# Element extract: routed through the canonical `coll.get(idx).unwrap()`
# chain via `emit_payload_read` (the resource auto-clone makes the binding
# independent of the collection — same semantics as the manual idiom). No
# AST synthesis, no recursive `lower_stmt` round-trip.
#
# Drop discipline: `coll_local` is owned by the caller (we don't consume
# it); `OpBorrow(coll_local)` is passed to `__len` and `__get`. The element
# binding owns its cloned copy; standard scope-exit drops handle release.
#
# Continue/break: continue jumps to `incr_bb` (so idx advances); break to
# `exit_bb`. Stacks pushed/popped around `lower_stmts(body, ...)`.
#
# for-else (else_body): rare in self-host; emits a `lower_fail` diagnostic
# rather than silently dropping. Wire the Python-semantics version (runs
# only when the loop completes without break) when a self-host site
# actually needs it.
void lower_for(LowerCtx &ctx, SpannedPattern pat, SpannedExpr iter_expr, Vector[Stmt] body, Vector[Stmt] else_body, GirModule &gmod, bool is_main):
    if else_body.len() > 0:
        lower_fail("SFor with else-body not yet implemented")
        return
    # Detect `.enumerate()` and strip it for the Vector/Deque fast path —
    # if `recv` turns out to be Vector/Deque, the idx-based scaffold can
    # bind both the index and the element directly. For non-Vector
    # receivers we DON'T strip (the strip would be wrong: on user-defined
    # iterables `coll.enumerate()` is just a regular method call returning
    # a wrapper iterator). The probe is purely speculative; we commit to
    # the strip only after type-checking `recv`.
    SpannedExpr probe_coll = iter_expr
    bool probe_is_enumerate = false
    match iter_expr.expr:
        case EMethodCall(recv_box, mname, margs, _):
            if mname == "enumerate" and margs.len() == 0:
                probe_coll = SpannedExpr((*recv_box).expr, (*recv_box).span)
                probe_is_enumerate = true
        else:
            pass
    # Lower the probe receiver once. If it's Vector/Deque, the
    # `probe_is_enumerate` strip was correct and we take the fast path.
    # Otherwise the strip was wrong, but for non-Vector enumeration
    # self-host has no in-tree use case today — fail loudly with a
    # diagnostic and let the iterator-protocol path handle the
    # non-enumerate variant.
    int coll_local = lower_expr(&ctx, probe_coll, &gmod)
    String coll_tn = local_type_name(coll_local, &ctx, &gmod)
    if coll_tn.starts_with("Vector__") or coll_tn.starts_with("Deque__"):
        lower_for_vector(&ctx, pat, coll_local, coll_tn, probe_is_enumerate, body, &gmod, is_main)
        return
    if probe_is_enumerate:
        # Non-Vector `.enumerate()` — would need either (a) an iterator-
        # protocol path that also threads an index counter, or (b) a
        # surface-language rewrite to `coll.iter().enumerate()`. Neither
        # is exercised in self-host today; fail with a precise message.
        lower_fail("SFor enumerate over non-Vector/Deque iterable not yet implemented (coll type: " + coll_tn + ")")
        return
    # Iterator-protocol fallback — universal path for Dict/Set/String/
    # Range/user-iterables. Calls `coll.iter()` (or treats `coll` as the
    # iterator if no iter() exists) and loops on `next() → Option[T]`
    # until None.
    lower_for_iterator(&ctx, pat, coll_local, coll_tn, body, &gmod, is_main)

# Vector/Deque fast path: idx-based scaffold matching the manual idiom
# users write today (`int i = 0; while i < x.len(): T v = x.get(i).unwrap();
# ...; i += 1`). Direct GIR emission, no recursive lower_stmt round-trip.
void lower_for_vector(LowerCtx &ctx, SpannedPattern pat, int coll_local, String coll_tn, bool is_enumerate, Vector[Stmt] body, GirModule &gmod, bool is_main):
    String elem_name = collection_element_type(coll_tn)
    if elem_name == "":
        lower_fail("SFor: could not resolve element type for " + coll_tn)
        return
    int elem_tid = resolve_elem_type_id(elem_name, &gmod)
    # ── Iteration state ──────────────────────────────────────
    int idx_local = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIAssign(idx_local, OpConstI64(0)))
    int len_local = add_local(&ctx, I64_TYPE, NO_NAME)
    Vector[Operand] len_args = [OpBorrow(coll_local)]
    emit(&ctx, GICallExtern(len_local, coll_tn + "__len", len_args))
    # ── Block layout ─────────────────────────────────────────
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int incr_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: `idx < len ? body : exit`
    switch_to(&ctx, header_bb)
    int cond_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    emit(&ctx, GICmp(cond_local, CMP_LT, I64_TYPE, OpCopy(idx_local), OpCopy(len_local)))
    set_terminator(&ctx, GTBranch(OpCopy(cond_local), body_bb, exit_bb))
    # Body: extract element via `coll.get(idx).unwrap()`, bind pattern.
    ctx.loop_continue_stack.push(incr_bb)
    ctx.loop_break_stack.push(exit_bb)
    switch_to(&ctx, body_bb)
    String opt_name = "Option__" + elem_name
    int opt_tid = lookup_or_register_named(&gmod, opt_name)
    int got_local = add_local_with(&ctx, opt_tid, NO_NAME, LoBorrowed(), BoCollectionElement())
    Vector[Operand] get_args = [OpBorrow(coll_local), OpCopy(idx_local)]
    emit(&ctx, GICallExtern(got_local, coll_tn + "__get", get_args))
    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, got_local)
    int elem_local = emit_payload_read(&ctx, scr_ptr, opt_name, "Some", 0, elem_tid, &gmod)
    if is_enumerate:
        match pat.pat:
            case PTuple(parts):
                if parts.len() == 2:
                    bind_for_local(&ctx, parts.get(0).unwrap(), idx_local, I64_TYPE, &gmod)
                    bind_for_local(&ctx, parts.get(1).unwrap(), elem_local, elem_tid, &gmod)
                else:
                    lower_fail("SFor enumerate: expected 2-tuple pattern, got " + int_to_str(parts.len()) + " parts")
            else:
                lower_fail("SFor enumerate: expected tuple pattern")
    else:
        bind_for_local(&ctx, pat, elem_local, elem_tid, &gmod)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            set_terminator(&ctx, GTJump(incr_bb))
        else:
            pass
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    # Incr: `idx = idx + 1; goto header`.
    switch_to(&ctx, incr_bb)
    int new_idx = add_local(&ctx, I64_TYPE, NO_NAME)
    emit(&ctx, GIBinOp(new_idx, OP_ADD, I64_TYPE, OpCopy(idx_local), OpConstI64(1)))
    emit(&ctx, GIAssign(idx_local, OpCopy(new_idx)))
    set_terminator(&ctx, GTJump(header_bb))
    switch_to(&ctx, exit_bb)

# Iterator-protocol fallback — universal path for any type with the
# `iter()` / `next() → Option[T]` chain. Covers Dict, Set, String, Range,
# and user-defined iterables (anything that equips `Iterator[T]` per
# `lib/std/iter.gg`).
#
# Architectural choice: this is one helper, not seven (Rust frontend has
# `lower_for_string` / `lower_for_dict` / `lower_for_set` / `lower_for_range`
# / `lower_for_iterable` etc., each duplicating ~80% scaffold). Self-host's
# single-scaffold-plus-extractor design works because we let the user-
# defined `Iterator[T]` trait protocol carry the per-type knowledge — the
# loop just calls `iter()` and `next()` by name and reads `Option[T]`.
# Whatever T is, however .next() decides when to yield None, the scaffold
# is identical.
#
# Lowered shape:
#   auto __iter = coll.iter()       # or `__iter = coll` if coll IS already
#                                   # an iterator (next() but no iter())
#   while true:
#       Option[T] step = __iter.next()
#       <if step is Some(x):
#           <pattern binding>
#           <body>
#           continue → header>
#       <if step is None:
#           break → exit>
#
# Continue jumps to the header (re-call next()); break to exit.
void lower_for_iterator(LowerCtx &ctx, SpannedPattern pat, int coll_local, String coll_tn, Vector[Stmt] body, GirModule &gmod, bool is_main):
    # Locate iter() and next() in fn_sigs. If coll has `iter()`, we call it
    # and loop on the returned iterator. If coll has `next()` but no
    # `iter()`, it IS an iterator — skip the iter() call.
    String iter_fn = coll_tn + "__iter"
    bool has_iter = gmod.fn_sigs.contains(iter_fn)
    int iter_type_tid = -1
    String iter_type_name = ""
    if has_iter:
        iter_type_tid = gmod.fn_sigs.get(iter_fn).unwrap()
        iter_type_name = type_id_to_name(iter_type_tid, &gmod)
    else:
        iter_type_tid = ctx.locals.get(coll_local).unwrap().type_id
        iter_type_name = coll_tn
    String next_fn = iter_type_name + "__next"
    if not gmod.fn_sigs.contains(next_fn):
        lower_fail("SFor: no iter()/next() chain on type " + coll_tn + " (looked for " + iter_fn + " or " + next_fn + ")")
        return
    int opt_ret_tid = gmod.fn_sigs.get(next_fn).unwrap()
    String opt_type_name = type_id_to_name(opt_ret_tid, &gmod)
    if not opt_type_name.starts_with("Option__"):
        lower_fail("SFor: " + next_fn + " return type isn't Option__T (got " + opt_type_name + ")")
        return
    String elem_name = opt_type_name.slice(8, opt_type_name.len())
    int elem_tid = resolve_elem_type_id(elem_name, &gmod)
    # Materialise the iterator. For `has_iter`, call coll.iter() once; the
    # returned iterator is what every subsequent next() reads from. For
    # the self-iterator case (`coll` IS an iterator), reuse coll_local.
    int iter_local = coll_local
    if has_iter:
        iter_local = add_local(&ctx, iter_type_tid, NO_NAME)
        Vector[Operand] iter_args = [OpBorrow(coll_local)]
        emit(&ctx, GICallExtern(iter_local, iter_fn, iter_args))
    # ── Block layout ────────────────────────────────────────
    # No incr_bb — `.next()` advances internally, so continue goes back
    # to the header (which re-calls next()).
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: step = iter.next(); branch on Some/None tag.
    switch_to(&ctx, header_bb)
    int step_local = add_local(&ctx, opt_ret_tid, NO_NAME)
    Vector[Operand] next_args = [OpBorrow(iter_local)]
    emit(&ctx, GICallExtern(step_local, next_fn, next_args))
    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, step_local)
    int tag_local = emit_tag_read(&ctx, scr_ptr, opt_type_name, &gmod)
    int cmp_local = add_local(&ctx, BOOL_TYPE, NO_NAME)
    # Option tag layout: 0 = Some, 1 = None (matches emit_tag_read's contract,
    # mirroring the unwrap_or path at lines ~2055-2076).
    emit(&ctx, GICmp(cmp_local, CMP_EQ, I64_TYPE, OpCopy(tag_local), OpConstI64(0)))
    set_terminator(&ctx, GTBranch(OpCopy(cmp_local), body_bb, exit_bb))
    # Body: extract payload, bind pattern, lower body, jump back to header.
    ctx.loop_continue_stack.push(header_bb)
    ctx.loop_break_stack.push(exit_bb)
    switch_to(&ctx, body_bb)
    int elem_local = emit_payload_read(&ctx, scr_ptr, opt_type_name, "Some", 0, elem_tid, &gmod)
    bind_for_local(&ctx, pat, elem_local, elem_tid, &gmod)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            set_terminator(&ctx, GTJump(header_bb))
        else:
            pass
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    switch_to(&ctx, exit_bb)

# Bind a for-loop pattern part to a GIR local. Allocates a fresh named
# local + emits the assignment (op_consume picks Move for owned resources,
# Copy for primitives), mirroring SVarDecl's binding shape.
void bind_for_local(LowerCtx &ctx, SpannedPattern pat, int src_local, int tid, GirModule &gmod):
    match pat.pat:
        case PBinding(name):
            int bound = add_local(&ctx, tid, Some(name.clone()))
            emit(&ctx, GIAssign(bound, op_consume(&ctx, &gmod, src_local)))
            nl_put(&ctx, name, bound)
        case PWildcard:
            pass
        else:
            lower_fail("SFor: only PBinding / PWildcard supported in for-loop pattern (got nested pattern)")

# Map a collection element type name (as produced by collection_element_type)
# to a GIR type id. Mirrors the resolution chain in the EMethodCall unwrap
# path (lines ~2014-2042) — primitive C-level names first, named-type fallback
# second.
int resolve_elem_type_id(String elem_name, GirModule &gmod):
    int prim = prim_name_to_type(elem_name)
    if prim >= 0:
        return prim
    if elem_name == "int64_t":
        return I64_TYPE
    if elem_name == "int32_t":
        return I32_TYPE
    if elem_name == "int16_t":
        return I16_TYPE
    if elem_name == "int8_t":
        return I8_TYPE
    if elem_name == "uint64_t":
        return U64_TYPE
    if elem_name == "uint32_t":
        return U32_TYPE
    if elem_name == "uint16_t":
        return U16_TYPE
    if elem_name == "uint8_t":
        return U8_TYPE
    if elem_name == "double":
        return F64_TYPE
    if elem_name == "float":
        return F32_TYPE
    if elem_name == "Str":
        return lookup_or_register_named(&gmod, "GorgetString")
    return lookup_or_register_named(&gmod, elem_name)

void lower_while(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] body, GirModule &gmod, bool is_main):
    int header_bb = new_block(&ctx)
    int body_bb = new_block(&ctx)
    int exit_bb = new_block(&ctx)
    set_terminator(&ctx, GTJump(header_bb))
    # Header: evaluate condition
    switch_to(&ctx, header_bb)
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    set_terminator(&ctx, GTBranch(OpCopy(cond), body_bb, exit_bb))
    # Body. Push loop targets so SBreak/SContinue know where to jump.
    ctx.loop_continue_stack.push(header_bb)
    ctx.loop_break_stack.push(exit_bb)
    switch_to(&ctx, body_bb)
    lower_stmts(&ctx, body, &gmod, is_main)
    Terminator body_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match body_term:
        case GTNone():
            set_terminator(&ctx, GTJump(header_bb))
        else:
            pass
    # Pop — targets only apply to this loop's direct body.
    ctx.loop_continue_stack.pop()
    ctx.loop_break_stack.pop()
    switch_to(&ctx, exit_bb)

# ── Function lowering ────────────────────────────────────

GirFunction lower_function(FunctionDef fdef, GirModule &gmod):
    bool is_main = fdef.name == "main"
    int ret_type = I64_TYPE
    if is_main:
        # Check if main has throws — if so, return Result__void__T
        match fdef.throws_type:
            case Some(throws_ty):
                int err_type = map_ast_type(throws_ty, &gmod)
                String err_c = type_id_to_name(err_type, &gmod)
                String result_name = "Result__void__" + err_c
                ret_type = lookup_or_register_named(&gmod, result_name)
            case None:
                ret_type = I32_TYPE
    else:
        ret_type = map_fn_return_type(fdef.return_type, &gmod)
        # Wrap return type in Result[T, E] for throws functions
        match fdef.throws_type:
            case Some(throws_ty):
                int err_type = map_ast_type(throws_ty, &gmod)
                String ret_c = type_id_to_name(ret_type, &gmod)
                String err_c = type_id_to_name(err_type, &gmod)
                String result_name = "Result__" + ret_c + "__" + err_c
                ret_type = lookup_or_register_named(&gmod, result_name)
            case None:
                pass

    Vector[Instruction] init_insts = []
    Vector[Vector[Instruction]] block_insts = [!init_insts]
    Vector[Terminator] block_terms = [GTNone()]
    Vector[int] _lc_stk = []
    Vector[int] _lb_stk = []
    Dict[String, int] _named_locals = {}
    LowerCtx ctx = LowerCtx([], !block_insts, !block_terms, 0, !_named_locals, 0, !_lc_stk, !_lb_stk, "", "", "", false, fdef.name.clone())

    # _0 = return place
    add_local(&ctx, ret_type, NO_NAME)

    # _1.._N = params — non-primitive bare params become Ptr(T)
    Vector[int] param_types = []
    for p in fdef.params:
        int pt = map_ast_type(p.param_type, &gmod)
        # Bare params of resource types (strings, collections, structs with resource fields) → Ptr
        # Small types (enums, simple structs) are passed by value
        if p.ownership == 0 and pt >= PRIM_COUNT:
            String type_c_name = type_to_c_name(p.param_type, &gmod)
            if is_resource_type_name(type_c_name, &gmod):
                pt = register_ptr(&gmod, pt)
        # Mutable borrow (&) and move (!) params → MutPtr
        # OWN_MUTABLE=1, OWN_MOVE=2 in self-host parser
        if p.ownership == 1 or p.ownership == 2:
            pt = register_type(&gmod, GtMutPtr(pt))
        param_types.push(pt)
        int plid = add_local_with(&ctx, pt, Some(p.param_name.clone()), LoParam(), BoParam())
        nl_put(&ctx, p.param_name, plid)



    # Lower body statements
    for stmt in fdef.body:
        lower_stmt(&ctx, stmt, &gmod, is_main)

    # If main and no explicit return, add return 0
    if is_main:
        Terminator last_term = ctx.block_terms.get(ctx.current_block).unwrap()
        match last_term:
            case GTNone():
                emit(&ctx, GIAssign(0, OpConstI32(0)))
                set_terminator(&ctx, GTReturn(OpConstI32(0)))
            else:
                pass

    # Phase C step 5d: liveness-aware OpMove → OpClone tightening.
    # Walks the emitted blocks, counts per-local operand uses, demotes
    # `OpMove(lid)` → `OpClone(lid)` at any site where `lid` is read
    # more than once anywhere in the function. See the helper's docstring
    # for the rationale (Phase 5 codegen correctness).
    tighten_owned_operand_modes(&ctx)

    # Assemble BasicBlocks from separate instruction and terminator vectors
    Vector[BasicBlock] blocks = []
    int bi = 0
    while bi < ctx.block_insts.len():
        Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
        Terminator term = ctx.block_terms.get(bi).unwrap()
        blocks.push(BasicBlock(insts, term))
        bi += 1
    return GirFunction(fdef.name, param_types, ret_type, ctx.locals, !blocks)

# ── Trait name mangling ──────────────────────────────────

String mangle_prim_type(String name):
    match name:
        case "int":
            return "int64_t"
        case "float":
            return "double"
        case "bool":
            return "bool"
        case "String":
            return "GorgetString"
        else:
            return name

String mangle_trait_name(String raw):
    # Parse "TraitName[Type1, Type2]" → "TraitName__type1__type2"
    # Note: use contains() guard because find() returns 0 (not -1) when not found
    # due to sentinel-to-Option unwrap bug in the compiler.
    if not raw.contains("["):
        return raw
    int bracket = raw.index_of("[").unwrap()
    String base = raw.slice(0, bracket)
    String args_str = raw.slice(bracket + 1, raw.len() - 1)
    # Split args by ", " and mangle each
    String result = base
    int pos = 0
    String current = ""
    while pos < args_str.len():
        String ch = args_str.slice(pos, pos + 1)
        if ch == "," and pos + 1 < args_str.len():
            result = result + "__" + mangle_prim_type(current)
            current = ""
            pos = pos + 2
        else:
            current = current + ch
            pos = pos + 1
    if current.len() > 0:
        result = result + "__" + mangle_prim_type(current)
    return result

# ── Equip block lowering ─────────────────────────────────

# Predicate: is this trait name a built-in derive-generated trait?
# These traits use the short mangled form (Type__method) rather than the
# explicit form (Trait_for_Type__method). Centralises the check so adding
# a new built-in trait touches ONE place, not the 5 callsites that had
# identical inline boolean chains before this helper was extracted.
bool is_builtin_trait(String tname):
    if tname == "Equatable" or tname == "Displayable" or tname == "Cloneable":
        return true
    if tname == "Hashable" or tname == "Serializable" or tname == "Deserializable":
        return true
    if tname == "Ordinal" or tname == "Drop":
        return true
    if tname == "Add" or tname == "Sub" or tname == "Mul" or tname == "Div":
        return true
    if tname.starts_with("Iterator") or tname.starts_with("Iterable"):
        return true
    if tname.starts_with("Add[") or tname.starts_with("Sub["):
        return true
    if tname.starts_with("Mul[") or tname.starts_with("Div["):
        return true
    return false

void lower_equip_block(EquipBlock eqblk, GirModule &gmod):
    # Get the target type name
    String target_name = type_to_c_name(eqblk.target, &gmod)
    int target_tid = lookup_or_register_named(&gmod, target_name)
    int self_ptr_tid = register_ptr(&gmod, target_tid)

    for mdef in eqblk.methods:
        # Mangled name: Type__method or Trait_for_Type__method
        String mangled = target_name + "__" + mdef.name
        match eqblk.trait_name:
            case Some(tname):
                # Derive-generated traits use short form (Type__method)
                # Explicit trait impls use prefix (Trait_for_Type__method)
                bool is_derive = is_builtin_trait(tname)
                if not is_derive:
                    String mangled_trait = mangle_trait_name(tname)
                    mangled = mangled_trait + "_for_" + target_name + "__" + mdef.name
            case None:
                pass

        bool is_main = false
        int ret_type = map_fn_return_type(mdef.return_type, &gmod)

        Vector[int] _lc_stk2 = []
        Vector[int] _lb_stk2 = []
        Dict[String, int] _named_locals2 = {}
        LowerCtx ctx = LowerCtx([], [], [], 0, !_named_locals2, 0, !_lc_stk2, !_lb_stk2, "", "", "", false, mangled.clone())
        # bb0
        Vector[Instruction] init_insts = []
        ctx.block_insts.push(!init_insts)
        ctx.block_terms.push(GTNone())

        # _0 = return place
        add_local(&ctx, ret_type, NO_NAME)

        # Check if method has a self parameter
        bool has_self = false
        if mdef.params.len() > 0:
            Param first_p = mdef.params.get(0).unwrap()
            match first_p.param_type.ty:
                case TSelf():
                    has_self = true
                else:
                    pass

        # Check if this is an explicit (non-derive) trait impl
        bool is_explicit_trait = false
        match eqblk.trait_name:
            case Some(tname):
                bool is_derive_trait = is_builtin_trait(tname)
                if not is_derive_trait:
                    is_explicit_trait = true
            case None:
                pass

        Vector[int] param_types = []
        # For explicit trait impls (`equip X with T:`) the param type is
        # `*unit` (Rust vtable convention). Field access on `self`
        # then fails because `unit` has no fields — we recover the
        # concrete pointer type via a copy-aliased local. Defer the
        # alias addition until after the rest of the params so the
        # `local_to_slot[pci+1]` param→slot mapping in lir_lower
        # stays correct (params at locals 1..N).
        bool needs_concrete_self_alias = false
        int concrete_self_tid_saved = UNIT_TYPE
        int self_lid_saved = -1
        if has_self:
            # _1 = self — determine pointer type from ownership
            # self (bare) → *T, &self → *mut T, !self → *mut T
            int self_tid = self_ptr_tid
            int self_ownership = 0
            Param sp = mdef.params.get(0).unwrap()
            self_ownership = sp.ownership
            # OWN_MUTABLE=1 (&self), OWN_MOVE=2 (!self) → *mut T
            if self_ownership == 1 or self_ownership == 2:
                self_tid = register_type(&gmod, GtMutPtr(target_tid))
            # Explicit trait impls use *unit self (Rust convention)
            int concrete_self_tid = self_tid
            if is_explicit_trait:
                if self_ownership == 1 or self_ownership == 2:
                    self_tid = register_type(&gmod, GtMutPtr(UNIT_TYPE))
                else:
                    self_tid = register_ptr(&gmod, UNIT_TYPE)
            param_types.push(self_tid)
            int self_lid = add_local(&ctx, self_tid, Some("self_void"))
            if is_explicit_trait:
                # Defer alias creation; bind `self` to the alias once
                # all params have been added.
                needs_concrete_self_alias = true
                concrete_self_tid_saved = concrete_self_tid
                self_lid_saved = self_lid
            else:
                nl_put(&ctx, "self", self_lid)

        # _2.._N = explicit params (skip self — already added above)
        for p in mdef.params:
            # Skip self parameter
            match p.param_type.ty:
                case TSelf():
                    continue
                else:
                    pass
            int pt = map_ast_type(p.param_type, &gmod)
            # Bare params of resource types → Ptr
            if p.ownership == 0 and pt >= PRIM_COUNT:
                String type_c_name = type_to_c_name(p.param_type, &gmod)
                if is_resource_type_name(type_c_name, &gmod):
                    pt = register_ptr(&gmod, pt)
            if p.ownership == 1 or p.ownership == 2:
                pt = register_type(&gmod, GtMutPtr(pt))
            param_types.push(pt)
            int plid = add_local_with(&ctx, pt, Some(p.param_name.clone()), LoParam(), BoParam())
            nl_put(&ctx, p.param_name, plid)

        # Add the explicit-trait `self` concrete-cast alias here, AFTER
        # all params, so locals 1..N are pure params (lir_lower's
        # `local_to_slot[pci+1]` param→slot mapping requires this).
        # The alias's GIAssign goes into the entry block before any
        # body statements, so `self.field` accesses in the body see
        # the cast pointer.
        if needs_concrete_self_alias:
            int concrete_self_lid = add_local(&ctx, concrete_self_tid_saved, Some("self"))
            emit(&ctx, GIAssign(concrete_self_lid, OpCopy(self_lid_saved)))
            nl_put(&ctx, "self", concrete_self_lid)

        # Lower body
        lower_stmts(&ctx, mdef.body, &gmod, is_main)

        # Phase C step 5d: liveness-aware OpMove → OpClone tightening.
        # Same post-pass as lower_function; see the helper's docstring.
        tighten_owned_operand_modes(&ctx)

        # Assemble blocks
        Vector[BasicBlock] blocks = []
        int bi = 0
        while bi < ctx.block_insts.len():
            Vector[Instruction] insts = ctx.block_insts.get(bi).unwrap()
            Terminator term = ctx.block_terms.get(bi).unwrap()
            blocks.push(BasicBlock(insts, term))
            bi += 1

        gmod.functions.push(GirFunction(mangled, !param_types, ret_type, ctx.locals, !blocks))

# ── Simple expression type inference ─────────────────────

int STRING_MARKER = -2

int guess_return_type(SpannedExpr sexpr, GirModule &gmod):
    match sexpr.expr:
        case EIntLiteral(_):
            return I64_TYPE
        case EFloatLiteral(_):
            return F64_TYPE
        case EBoolLiteral(_):
            return BOOL_TYPE
        case EStringLiteral(_, _):
            return STRING_MARKER
        case EFString(_, _):
            return STRING_MARKER
        case EBinaryOp(lhs_box, op, rhs_box):
            match op:
                case "==" | "!=" | "<" | "<=" | ">" | ">=" | "and" | "or":
                    return BOOL_TYPE
                else:
                    # Check for string concatenation or float arithmetic
                    # by inspecting the immediate operand expressions
                    match (*lhs_box).expr:
                        case EStringLiteral(_, _):
                            return STRING_MARKER
                        case EFloatLiteral(_):
                            return F64_TYPE
                        else:
                            pass
                    match (*rhs_box).expr:
                        case EStringLiteral(_, _):
                            return STRING_MARKER
                        case EFloatLiteral(_):
                            return F64_TYPE
                        else:
                            pass
                    return I64_TYPE
        case EUnaryOp(op, _):
            match op:
                case "not":
                    return BOOL_TYPE
                else:
                    return I64_TYPE
        case ENoneLiteral():
            return UNIT_TYPE
        case ECall(callee_box, args, targs):
            match (*callee_box).expr:
                case EIdentifier(fname):
                    if fname == "print" or fname == "pass":
                        return UNIT_TYPE
                    # Enum variant constructors: Some(x) → Option__T, Ok(x)/Error(x) → Result
                    if fname == "Some" and args.len() == 1:
                        SpannedExpr inner_arg = args.get(0).unwrap()
                        int inner_t = guess_return_type(inner_arg, &gmod)
                        if inner_t == STRING_MARKER:
                            inner_t = lookup_or_register_named(&gmod, "GorgetString")
                        String inner_name = type_id_to_name(inner_t, &gmod)
                        return lookup_or_register_named(&gmod, "Option__" + inner_name)
                    if fname == "None":
                        return UNIT_TYPE
                    if fname == "Ok" or fname == "Error":
                        # Result constructor — look at argument type to infer Result__T__E
                        if args.len() > 0:
                            SpannedExpr r_arg = args.get(0).unwrap()
                            int r_t = guess_return_type(r_arg, &gmod)
                            if r_t == STRING_MARKER:
                                r_t = lookup_or_register_named(&gmod, "GorgetString")
                            String r_name = type_id_to_name(r_t, &gmod)
                            # Can't fully infer Result__T__E from one variant,
                            # but return int64_t as a safe default
                            return I64_TYPE
                    # Look up return type from fn_sigs (also check call_redirects)
                    String call_name = fname
                    if targs.len() > 0:
                        call_name = compute_mangled_name(targs, fname)
                    if gmod.call_redirects.contains(call_name):
                        call_name = gmod.call_redirects.get(call_name).unwrap()
                    if gmod.fn_sigs.contains(call_name):
                        return gmod.fn_sigs.get(call_name).unwrap()
                else:
                    pass
        case EMethodCall(recv, mname, margs, _):
            # Known void methods
            if mname == "push" or mname == "set" or mname == "put" or mname == "clear" or mname == "pop" or mname == "sort" or mname == "append" or mname == "insert" or mname == "remove":
                return UNIT_TYPE
            # Known string-returning methods
            if mname == "upper" or mname == "lower" or mname == "trim" or mname == "strip" or mname == "replace" or mname == "slice" or mname == "join" or mname == "repeat" or mname == "to_string" or mname == "reverse" or mname == "format" or mname == "as_str" or mname == "display" or mname == "describe" or mname == "to_lower" or mname == "to_upper" or mname == "removeprefix" or mname == "removesuffix" or mname == "center" or mname == "ljust" or mname == "rjust" or mname == "zfill":
                return STRING_MARKER
            # Known int-returning methods
            if mname == "len" or mname == "find" or mname == "count" or mname == "hash" or mname == "index_of":
                return I64_TYPE
            # Known float-returning methods
            if mname == "measure" or mname == "abs" or mname == "sqrt":
                return F64_TYPE
            # Known bool-returning methods
            if mname == "contains" or mname == "starts_with" or mname == "ends_with" or mname == "is_empty" or mname == "has" or mname == "eq":
                return BOOL_TYPE
            # unwrap/unwrap_or: return type matches the receiver's inner type
            if mname == "unwrap" or mname == "unwrap_or":
                int recv_t = guess_return_type(*recv, &gmod)
                return recv_t
        case EIdentifier(name):
            # Look up from fn_sigs (could be a variable holding a closure)
            if gmod.fn_sigs.contains(name):
                return gmod.fn_sigs.get(name).unwrap()
        case EIf(_, then_body, _):
            # Use return type of last statement in then body
            if then_body.len() > 0:
                Stmt last = then_body.get(then_body.len() - 1).unwrap()
                match last:
                    case SExpr(inner_expr):
                        return guess_return_type(inner_expr, &gmod)
                    case SReturn(opt_ret):
                        match opt_ret:
                            case Some(ret_expr):
                                return guess_return_type(ret_expr, &gmod)
                            case None:
                                return UNIT_TYPE
                    else:
                        pass
        else:
            pass
    return I64_TYPE

# ── Closure scanning ─────────────────────────────────────

# Check if an expression tree contains the implicit `it` parameter.
# Unlike the parser's expr_contains_it (which only checks top-level to
# avoid borrow issues), this traverses owned values — safe to recurse.
bool expr_has_it(SpannedExpr sexpr):
    match sexpr.expr:
        case EIt():
            return true
        case EIdentifier(name):
            return name == "it"
        case EBinaryOp(lhs, _, rhs):
            return expr_has_it(*lhs) or expr_has_it(*rhs)
        case EUnaryOp(_, inner):
            return expr_has_it(*inner)
        case ECall(callee, args, _):
            if expr_has_it(*callee):
                return true
            for a in args:
                if expr_has_it(a):
                    return true
            return false
        case EMethodCall(obj, _, args, _):
            if expr_has_it(*obj):
                return true
            for a in args:
                if expr_has_it(a):
                    return true
            return false
        case EIf(cond, _, _):
            return expr_has_it(*cond)
        case EFString(_, fexprs):
            for fx in fexprs:
                if expr_has_it(fx):
                    return true
            return false
        else:
            return false

# Emit a __Closure_N__call function for an implicit `it` closure.
int emit_it_closure(int next_id, GirModule &gmod):
    String ic_name = "__Closure_" + int_to_str(next_id)
    String ic_call = ic_name + "__call"
    int ic_tid = lookup_or_register_named(&gmod, ic_name)
    int ic_self_ptr = register_ptr(&gmod, ic_tid)
    Vector[int] ic_params = [ic_self_ptr, I64_TYPE]
    int ic_ret = I64_TYPE
    Vector[GirLocal] ic_locals = [GirLocal(ic_ret, NO_NAME, LoOwned(), BoNone()), GirLocal(ic_self_ptr, NO_NAME, LoParam(), BoParam()), GirLocal(I64_TYPE, Some("it"), LoParam(), BoParam())]
    Vector[BasicBlock] ic_blocks = [BasicBlock([], GTReturn(OpCopy(0)))]
    gmod.functions.push(GirFunction(ic_call, !ic_params, ic_ret, !ic_locals, !ic_blocks))
    return next_id + 1

int scan_expr_for_closures(SpannedExpr sexpr, int next_id, GirModule &gmod):
    match sexpr.expr:
        case EClosure(params, body):
            # Emit __Closure_N__call function
            String closure_name = "__Closure_" + int_to_str(next_id)
            String call_name = closure_name + "__call"
            int closure_tid = lookup_or_register_named(&gmod, closure_name)
            int self_ptr = register_ptr(&gmod, closure_tid)

            # Build param types: *__Closure_N + explicit params
            Vector[int] param_types = [self_ptr]
            for p in params:
                int pt = map_ast_type(p.param_type, &gmod)
                param_types.push(pt)

            # Infer return type from body
            int ret_type = I64_TYPE
            if body.len() > 0:
                Stmt last_stmt = body.get(body.len() - 1).unwrap()
                match last_stmt:
                    case SReturn(opt_expr):
                        match opt_expr:
                            case Some(rexpr):
                                ret_type = guess_return_type(rexpr, &gmod)
                            case None:
                                ret_type = UNIT_TYPE
                    case SExpr(expr):
                        ret_type = guess_return_type(expr, &gmod)
                    else:
                        # Non-expression last statement (if, while, etc.) → void
                        ret_type = UNIT_TYPE
            # If return type is still I64 (default) and this is a SINGLE-param
            # closure with only a float param, use float return type.
            # (String param heuristic removed — too aggressive for multi-param
            # closures like dict.fold that take String but return int.)
            if ret_type == I64_TYPE and param_types.len() == 2:
                int only_pt = param_types.get(1).unwrap()
                if only_pt == F64_TYPE:
                    ret_type = F64_TYPE
            # Also check: if the body has multiple statements and no explicit
            # return, it's likely a void closure
            if body.len() > 1 and ret_type == I64_TYPE:
                Stmt first = body.get(0).unwrap()
                Stmt last = body.get(body.len() - 1).unwrap()
                match last:
                    case SExpr(_):
                        pass
                    case SReturn(_):
                        pass
                    else:
                        ret_type = UNIT_TYPE
            # Resolve special markers
            if ret_type == STRING_MARKER:
                ret_type = lookup_or_register_named(&gmod, "GorgetString")

            # Create minimal function with empty body
            Vector[GirLocal] locals = [GirLocal(ret_type, NO_NAME, LoOwned(), BoNone()), GirLocal(self_ptr, NO_NAME, LoParam(), BoParam())]
            for lp in params:
                int lpt = map_ast_type(lp.param_type, &gmod)
                locals.push(GirLocal(lpt, Some(lp.param_name), LoParam(), BoParam()))
            Vector[BasicBlock] blocks = [BasicBlock([], GTReturn(OpCopy(0)))]
            gmod.functions.push(GirFunction(call_name, !param_types, ret_type, !locals, !blocks))
            next_id = next_id + 1

            # Scan closure body for nested closures
            next_id = scan_stmts_for_closures(body, next_id, &gmod)
        case EImplicitClosure(body_box):
            # Implicit `it` closure: single implicit parameter, expression body
            String ic_name = "__Closure_" + int_to_str(next_id)
            String ic_call = ic_name + "__call"
            int ic_tid = lookup_or_register_named(&gmod, ic_name)
            int ic_self_ptr = register_ptr(&gmod, ic_tid)
            # Implicit param type defaults to I64 (type checker infers the real type)
            Vector[int] ic_params = [ic_self_ptr, I64_TYPE]
            int ic_ret = guess_return_type(*body_box, &gmod)
            if ic_ret == STRING_MARKER:
                ic_ret = lookup_or_register_named(&gmod, "GorgetString")
            Vector[GirLocal] ic_locals = [GirLocal(ic_ret, NO_NAME, LoOwned(), BoNone()), GirLocal(ic_self_ptr, NO_NAME, LoParam(), BoParam()), GirLocal(I64_TYPE, Some("it"), LoParam(), BoParam())]
            Vector[BasicBlock] ic_blocks = [BasicBlock([], GTReturn(OpCopy(0)))]
            gmod.functions.push(GirFunction(ic_call, !ic_params, ic_ret, !ic_locals, !ic_blocks))
            next_id = next_id + 1
            # Scan body for nested closures
            next_id = scan_expr_for_closures(*body_box, next_id, &gmod)
        case EBinaryOp(lhs, _, rhs):
            next_id = scan_expr_for_closures(*lhs, next_id, &gmod)
            next_id = scan_expr_for_closures(*rhs, next_id, &gmod)
        case EUnaryOp(_, inner):
            next_id = scan_expr_for_closures(*inner, next_id, &gmod)
        case ECall(callee, args, _):
            next_id = scan_expr_for_closures(*callee, next_id, &gmod)
            for arg in args:
                if expr_has_it(arg):
                    # Implicit `it` closure — generate __Closure_N__call(self, it)
                    next_id = emit_it_closure(next_id, &gmod)
                else:
                    next_id = scan_expr_for_closures(arg, next_id, &gmod)
        case EMethodCall(obj, _, args, _):
            next_id = scan_expr_for_closures(*obj, next_id, &gmod)
            for arg in args:
                if expr_has_it(arg):
                    next_id = emit_it_closure(next_id, &gmod)
                else:
                    next_id = scan_expr_for_closures(arg, next_id, &gmod)
        case EIf(cond, then_body, branches):
            next_id = scan_expr_for_closures(*cond, next_id, &gmod)
            next_id = scan_stmts_for_closures(then_body, next_id, &gmod)
        case EFieldAccess(obj, _):
            next_id = scan_expr_for_closures(*obj, next_id, &gmod)
        case EIndex(obj, idx):
            next_id = scan_expr_for_closures(*obj, next_id, &gmod)
            next_id = scan_expr_for_closures(*idx, next_id, &gmod)
        case EFString(_, interp_exprs):
            for fexpr in interp_exprs:
                next_id = scan_expr_for_closures(fexpr, next_id, &gmod)
        case ESpawn(inner_box):
            # Check if this is spawn (inline_closure)(args) — emit wrapper before recursing
            bool is_inline_closure = false
            match (*inner_box).expr:
                case ECall(callee_box, _, _):
                    match (*callee_box).expr:
                        case EClosure(_, _):
                            is_inline_closure = true
                        else:
                            pass
                else:
                    pass
            if is_inline_closure:
                String cl_name = "__Closure_" + int_to_str(next_id)
                String wrap_name = "__spawn_wrap_" + cl_name
                Vector[int] sw_wp = []
                Vector[GirLocal] sw_wl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone())]
                Vector[BasicBlock] sw_wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                gmod.functions.push(GirFunction(wrap_name, !sw_wp, UNIT_TYPE, !sw_wl, !sw_wb))
            next_id = scan_expr_for_closures(*inner_box, next_id, &gmod)
        case ESpawnBlocking(inner_box):
            next_id = scan_expr_for_closures(*inner_box, next_id, &gmod)
        else:
            pass
    return next_id

int scan_stmt_for_closures(Stmt stmt, int next_id, GirModule &gmod):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            next_id = scan_expr_for_closures(init, next_id, &gmod)
        case SAssign(target, value):
            next_id = scan_expr_for_closures(target, next_id, &gmod)
            next_id = scan_expr_for_closures(value, next_id, &gmod)
        case SExpr(expr):
            next_id = scan_expr_for_closures(expr, next_id, &gmod)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    next_id = scan_expr_for_closures(expr, next_id, &gmod)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            next_id = scan_expr_for_closures(cond, next_id, &gmod)
            next_id = scan_stmts_for_closures(then_body, next_id, &gmod)
            for eb in branches:
                match eb.condition:
                    case Some(elif_cond):
                        next_id = scan_expr_for_closures(elif_cond, next_id, &gmod)
                    case None:
                        pass
                next_id = scan_stmts_for_closures(eb.body, next_id, &gmod)
        case SWhile(cond, body):
            next_id = scan_expr_for_closures(cond, next_id, &gmod)
            next_id = scan_stmts_for_closures(body, next_id, &gmod)
        case SFor(_, iter_expr, body, _, _):
            next_id = scan_expr_for_closures(iter_expr, next_id, &gmod)
            next_id = scan_stmts_for_closures(body, next_id, &gmod)
        case SMatch(scrutinee, arms):
            next_id = scan_expr_for_closures(scrutinee, next_id, &gmod)
        else:
            pass
    return next_id

int scan_stmts_for_closures(Vector[Stmt] stmts, int next_id, GirModule &gmod):
    for stmt in stmts:
        next_id = scan_stmt_for_closures(stmt, next_id, &gmod)
    return next_id

# ── Closure variable name collection ────────────────────
# Tracks which variables hold closures (for spawn wrapper generation).
# Must visit closures in the SAME ORDER as scan_stmts_for_closures.

int collect_closure_vars_expr(SpannedExpr sexpr, int next_id, Dict[String, String] &cmap):
    match sexpr.expr:
        case EClosure(params, body):
            next_id = next_id + 1
            next_id = collect_closure_vars_stmts(body, next_id, &cmap)
        case EImplicitClosure(_):
            next_id = next_id + 1
        case ECall(callee, args, _):
            next_id = collect_closure_vars_expr(*callee, next_id, &cmap)
            for carg in args:
                if expr_has_it(carg):
                    next_id = next_id + 1
                else:
                    next_id = collect_closure_vars_expr(carg, next_id, &cmap)
        case ESpawn(inner_box):
            next_id = collect_closure_vars_expr(*inner_box, next_id, &cmap)
        case ESpawnBlocking(inner_box):
            next_id = collect_closure_vars_expr(*inner_box, next_id, &cmap)
        case EMethodCall(obj, _, margs, _):
            next_id = collect_closure_vars_expr(*obj, next_id, &cmap)
            for ma in margs:
                next_id = collect_closure_vars_expr(ma, next_id, &cmap)
        else:
            pass
    return next_id

int collect_closure_vars_stmt(Stmt s, int next_id, Dict[String, String] &cmap):
    match s:
        case SVarDecl(_, name, init, _, _, _):
            match init.expr:
                case EClosure(params, body):
                    String cname = "__Closure_" + int_to_str(next_id)
                    cmap.put(name, cname)
                    next_id = next_id + 1
                    next_id = collect_closure_vars_stmts(body, next_id, &cmap)
                case EImplicitClosure(_):
                    next_id = next_id + 1
                else:
                    next_id = collect_closure_vars_expr(init, next_id, &cmap)
        case SExpr(expr):
            next_id = collect_closure_vars_expr(expr, next_id, &cmap)
        case SReturn(opt):
            match opt:
                case Some(re):
                    next_id = collect_closure_vars_expr(re, next_id, &cmap)
                case None:
                    pass
        case SIf(_, then_body, branches):
            next_id = collect_closure_vars_stmts(then_body, next_id, &cmap)
            for eb in branches:
                next_id = collect_closure_vars_stmts(eb.body, next_id, &cmap)
        case SWhile(_, body):
            next_id = collect_closure_vars_stmts(body, next_id, &cmap)
        case SFor(_, _, body, _, _):
            next_id = collect_closure_vars_stmts(body, next_id, &cmap)
        else:
            pass
    return next_id

int collect_closure_vars_stmts(Vector[Stmt] stmts, int next_id, Dict[String, String] &cmap):
    for stmt in stmts:
        next_id = collect_closure_vars_stmt(stmt, next_id, &cmap)
    return next_id

# ── Generic monomorphization ─────────────────────────────

struct GenericInstance:
    String base_name
    Vector[SpannedType] type_args
    String mangled_name

# Expand generic calls inside meta for bodies to the 4 standard types.
# meta for T in type_variants(...): generates code for int, float, String, bool.
void expand_meta_for_generics(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    # Standard column types that type_variants typically expands to.
    # Deliberately excludes 'bool' — variant_payloads() expands to enum payload
    # types (typically int/float/String), not bool.  Adding bool causes spurious
    # monomorphizations for fixtures like meta_variant_payloads.
    Vector[SpannedType] std_types = []
    std_types.push(SpannedType(TPrimitive("int"), -1))
    std_types.push(SpannedType(TPrimitive("float"), -1))
    std_types.push(SpannedType(TPrimitive("String"), -1))
    # Scan for generic calls with type variable args
    for stmt in stmts:
        expand_meta_for_stmt(stmt, &seen, &instances, std_types)

void expand_meta_for_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            expand_meta_for_expr(init, &seen, &instances, std_types)
        case SExpr(expr):
            expand_meta_for_expr(expr, &seen, &instances, std_types)
        case SReturn(opt):
            match opt:
                case Some(expr):
                    expand_meta_for_expr(expr, &seen, &instances, std_types)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            expand_meta_for_expr(cond, &seen, &instances, std_types)
            for ts in then_body:
                expand_meta_for_stmt(ts, &seen, &instances, std_types)
            for eb in branches:
                for ebs in eb.body:
                    expand_meta_for_stmt(ebs, &seen, &instances, std_types)
        case SMatch(scrutinee, arms):
            expand_meta_for_expr(scrutinee, &seen, &instances, std_types)
            for arm in arms:
                for abs in arm.body:
                    expand_meta_for_stmt(abs, &seen, &instances, std_types)
        else:
            pass

void expand_meta_for_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types):
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and has_type_variable(targs):
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        # Expand each type variable to the 4 standard types
                        int ti = 0
                        while ti < std_types.len():
                            SpannedType concrete = std_types.get(ti).unwrap()
                            Vector[SpannedType] expanded = []
                            int tai = 0
                            while tai < targs.len():
                                SpannedType ta = targs.get(tai).unwrap()
                                bool is_var = false
                                match ta.ty:
                                    case TNamed(n, inner):
                                        if inner.len() == 0 and n.len() <= 2:
                                            is_var = true
                                    else:
                                        pass
                                if is_var:
                                    expanded.push(concrete.clone())
                                else:
                                    expanded.push(ta)
                                tai += 1
                            String mangled = compute_mangled_name(expanded, fname)
                            if not seen.contains(mangled):
                                seen.put(mangled.clone(), true)
                                instances.push(GenericInstance(fname.clone(), !expanded, mangled))
                            ti += 1
                    else:
                        pass
            for arg in args:
                expand_meta_for_expr(arg, &seen, &instances, std_types)
        case EMethodCall(obj, _, margs, _):
            expand_meta_for_expr(*obj, &seen, &instances, std_types)
            for ma in margs:
                expand_meta_for_expr(ma, &seen, &instances, std_types)
        else:
            pass

# Discover generic call sites in an expression
void discover_generic_calls_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and not has_type_variable(targs):
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        String mangled = compute_mangled_name(targs, fname)
                        if not seen.contains(mangled):
                            seen.put(mangled.clone(), true)
                            GenericInstance gi = GenericInstance(fname, targs, mangled)
                            instances.push(!gi)
                    else:
                        pass
            # Recurse into call args
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances)
            discover_generic_calls_expr(*callee_box, &seen, &instances)
        case EMethodCall(obj, _, args, _):
            discover_generic_calls_expr(*obj, &seen, &instances)
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances)
        case EBinaryOp(lhs, _, rhs):
            discover_generic_calls_expr(*lhs, &seen, &instances)
            discover_generic_calls_expr(*rhs, &seen, &instances)
        case EUnaryOp(_, inner):
            discover_generic_calls_expr(*inner, &seen, &instances)
        case EIf(cond, then_body, branches):
            discover_generic_calls_expr(*cond, &seen, &instances)
            discover_generic_calls_stmts(then_body, &seen, &instances)
        case EFieldAccess(obj, _):
            discover_generic_calls_expr(*obj, &seen, &instances)
        case EIndex(obj, idx):
            discover_generic_calls_expr(*obj, &seen, &instances)
            discover_generic_calls_expr(*idx, &seen, &instances)
        case EClosure(_, body):
            discover_generic_calls_stmts(body, &seen, &instances)
        case EFString(_, fexprs):
            for fx in fexprs:
                discover_generic_calls_expr(fx, &seen, &instances)
        else:
            pass

void discover_generic_calls_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    match stmt:
        case SVarDecl(stype, _, init, _, _, _):
            # Also discover type instances from type annotations (e.g., Stack[int] s = ...)
            match stype.ty:
                case TNamed(tname, targs):
                    if targs.len() > 0 and not has_type_variable(targs):
                        String mangled = compute_mangled_name(targs, tname)
                        if not seen.contains(mangled):
                            seen.put(mangled.clone(), true)
                            GenericInstance gi = GenericInstance(tname, targs, mangled)
                            instances.push(!gi)
                else:
                    pass
            discover_generic_calls_expr(init, &seen, &instances)
        case SAssign(target, value):
            discover_generic_calls_expr(target, &seen, &instances)
            discover_generic_calls_expr(value, &seen, &instances)
        case SExpr(expr):
            discover_generic_calls_expr(expr, &seen, &instances)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    discover_generic_calls_expr(expr, &seen, &instances)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            discover_generic_calls_expr(cond, &seen, &instances)
            discover_generic_calls_stmts(then_body, &seen, &instances)
            for eb in branches:
                match eb.condition:
                    case Some(elif_cond):
                        discover_generic_calls_expr(elif_cond, &seen, &instances)
                    case None:
                        pass
                discover_generic_calls_stmts(eb.body, &seen, &instances)
        case SWhile(cond, body):
            discover_generic_calls_expr(cond, &seen, &instances)
            discover_generic_calls_stmts(body, &seen, &instances)
        case SFor(_, iter_expr, body, _, _):
            discover_generic_calls_expr(iter_expr, &seen, &instances)
            discover_generic_calls_stmts(body, &seen, &instances)
        case SMatch(scrutinee, arms):
            discover_generic_calls_expr(scrutinee, &seen, &instances)
            for arm in arms:
                discover_generic_calls_stmts(arm.body, &seen, &instances)
        case SMetaFor(meta_body):
            # Meta for type_variants: expand type-variable generic calls
            # to the 4 standard column types (int, float, String, bool).
            # The meta for header is lost, so we heuristically expand
            # any generic call with a type variable arg.
            expand_meta_for_generics(meta_body, &seen, &instances)
        else:
            pass

void discover_generic_calls_stmts(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    for stmt in stmts:
        discover_generic_calls_stmt(stmt, &seen, &instances)

# Lightweight type-to-C-name without GirModule (used during discovery before gmod exists)
String spanned_type_to_c_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            int pt = prim_name_to_type(name)
            if pt >= 0:
                return spanned_type_to_c_name(SpannedType(TPrimitive(name), -1))
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_c_name(ta)
            return result
        else:
            pass
    return "int64_t"

# Check if any type arg is an unresolved type variable (e.g., T, A, B)
# rather than a concrete type (e.g., int, String, Vector[int])
bool has_type_variable(Vector[SpannedType] targs):
    for ta in targs:
        match ta.ty:
            case TNamed(name, inner_targs):
                if inner_targs.len() == 0:
                    # Single name with no type args — could be a type variable
                    # Known concrete types: int, float, bool, void, String
                    int pt = prim_name_to_type(name)
                    if pt < 0 and name != "String":
                        # Not a primitive — check if it looks like a type var
                        # Type vars are typically short uppercase names
                        if name.len() <= 2:
                            return true
                else:
                    # Recurse into type args
                    if has_type_variable(inner_targs):
                        return true
            case TPrimitive(name):
                # Primitives are always concrete
                pass
            else:
                pass
    return false

String compute_mangled_name(Vector[SpannedType] targs, String base_name):
    String mangled = base_name
    for ta in targs:
        mangled = mangled + "__" + spanned_type_to_c_name(ta)
    return mangled

# Set up type substitutions for a generic instance.
void setup_type_subs(GirModule &gmod, Vector[String] type_params, Vector[SpannedType] type_args):
    gmod.type_subs = {}
    int i = 0
    while i < type_params.len() and i < type_args.len():
        String param_name = type_params.get(i).unwrap()
        SpannedType arg_type = type_args.get(i).unwrap()
        int tid = map_ast_type(arg_type, &gmod)
        gmod.type_subs.put(param_name, tid)
        i += 1

void clear_type_subs(GirModule &gmod):
    gmod.type_subs = {}

# Lower a monomorphized instance of a generic function
void lower_generic_function(FunctionDef fdef, String mangled_name, Vector[String] type_params, Vector[SpannedType] type_args, GirModule &gmod):
    setup_type_subs(&gmod, type_params, type_args)
    GirFunction gfn = lower_function(fdef, &gmod)

    # Detect bare Move-type params that are directly returned.
    # If return type is resource AND body is `return param_name` or just `param_name`,
    # upgrade that param from Ptr to MutPtr (matches Rust lowerer behavior).
    int ret_tid = gfn.return_type
    String ret_name = type_id_to_name(ret_tid, &gmod)
    if is_resource_type_name(ret_name, &gmod):
        # Check if body is a single return of a param identifier
        String returned_param = ""
        if fdef.is_expr_body and fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SExpr(sexpr):
                    match sexpr.expr:
                        case EIdentifier(name):
                            returned_param = name
                        else:
                            pass
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        elif fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        # Upgrade matching param from Ptr to MutPtr
        if returned_param.len() > 0:
            int pi = 0
            while pi < fdef.params.len():
                Param p = fdef.params.get(pi).unwrap()
                if p.param_name == returned_param and p.ownership == 0:
                    # Param local is at index pi+1 (local 0 is return place)
                    int local_idx = pi + 1
                    if local_idx < gfn.locals.len():
                        GirLocal loc = gfn.locals.get(local_idx).unwrap()
                        int old_tid = loc.type_id
                        # Check if it's currently Ptr(T) — upgrade to MutPtr(T)
                        if old_tid >= PRIM_COUNT:
                            GirType gt = gmod.type_table.get(old_tid).unwrap()
                            match gt:
                                case GtPtr(inner):
                                    int new_tid = register_type(&gmod, GtMutPtr(inner))
                                    gfn.locals.set(local_idx, GirLocal(new_tid, loc.name_hint, loc.ownership, loc.borrow_origin))
                                    gfn.param_types.set(pi, new_tid)
                                else:
                                    pass
                pi += 1

    # Override the function name with the mangled name
    gmod.functions.push(GirFunction(mangled_name, gfn.param_types, gfn.return_type, gfn.locals, gfn.blocks))
    clear_type_subs(&gmod)

# Extract type parameter names from equip target's generic args
# e.g., Stack[T] → ["T"], Pair[A, B] → ["A", "B"]
Vector[String] extract_equip_type_params(EquipBlock eqblk):
    # First try explicit type_params
    if eqblk.type_params.len() > 0:
        return eqblk.type_params
    # Otherwise extract from target type args
    Vector[String] params = []
    match eqblk.target.ty:
        case TNamed(_, targs):
            for ta in targs:
                match ta.ty:
                    case TNamed(tname, _):
                        params.push(tname)
                    case TPrimitive(tname):
                        params.push(tname)
                    else:
                        pass
        else:
            pass
    return params

# Lower monomorphized instances of generic equip methods
void lower_generic_equip(EquipBlock eqblk, Vector[SpannedType] type_args, GirModule &gmod):
    Vector[String] type_params = extract_equip_type_params(eqblk)
    setup_type_subs(&gmod, type_params, type_args)
    # For generic equip, Rust uses Type__method naming (no trait prefix) and concrete self types.
    # Strip the trait_name so lower_equip_block uses plain Type__method naming.
    Option[String] no_trait = None
    EquipBlock plain_eqblk = EquipBlock(eqblk.target, eqblk.type_params, no_trait, eqblk.methods, eqblk.via_field, eqblk.trait_generic_args)
    lower_equip_block(plain_eqblk, &gmod)
    clear_type_subs(&gmod)

# ── Spawn wrapper scanning ───────────────────────────────

# Extract the base type name from a SpannedType (e.g. TNamed("Worker",[]) → "Worker").
String spawn_type_base_name(SpannedType ty):
    match ty.ty:
        case TNamed(n, _):
            return n
        case TPrimitive(n):
            return n
        else:
            return ""

# Collect shared variable names from a list of statements
void collect_shared_vars(Vector[Stmt] stmts, Dict[String, bool] &shared_vars):
    for s in stmts:
        match s:
            case SVarDecl(_, name, _, _, sk, _):
                # Only auto-mutex (sk=1) gets __shared_token_ wrappers.
                # Atomic (sk=3) and rwlock (sk=2) use different patterns.
                if sk == 1:
                    shared_vars.put(name, true)
            else:
                pass

# Scan for ESpawn expressions and emit wrapper function stubs
# borrow_params: names of &-qualified params of the enclosing function;
# passing them to a spawn implies shared-derived ownership (inner shared spawn).
void scan_spawn_wrappers(Vector[Stmt] stmts, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    for s in stmts:
        match s:
            case SVarDecl(ty, name, init, _, sk, _):
                if sk == 1:
                    shared_vars.put(name, true)
                # Track variable types for method-spawn wrapper generation
                String tname = spawn_type_base_name(ty)
                if tname != "":
                    var_types.put(name, tname)
                scan_expr_for_spawn(init, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SExpr(expr):
                scan_expr_for_spawn(expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SAssign(_, val):
                scan_expr_for_spawn(val, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SWhile(cond, body):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SIf(cond, then_body, branches):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(then_body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                for eb in branches:
                    scan_spawn_wrappers(eb.body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SFor(_, iter_expr, body, _, _):
                scan_expr_for_spawn(iter_expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SReturn(opt):
                match opt:
                    case Some(rexpr):
                        scan_expr_for_spawn(rexpr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                    case None:
                        pass
            else:
                pass

void scan_expr_for_spawn(SpannedExpr sexpr, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, args, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            # Check if any arg is:
                            # (a) a directly shared variable (shared_vars), or
                            # (b) a &-param of the enclosing function (borrow_params) —
                            #     skip_ownership_markers strips '&' in call args so
                            #     &counter arrives as EIdentifier("counter"), not EMutableBorrow.
                            bool has_shared = false
                            for arg in args:
                                match arg.expr:
                                    case EIdentifier(aname):
                                        if shared_vars.contains(aname) or borrow_params.contains(aname):
                                            has_shared = true
                                    case EMutableBorrow(inner):
                                        # Safety net: if &-prefix somehow survives into arg
                                        has_shared = true
                                    else:
                                        pass
                            if has_shared and not emitted.contains(callee_name):
                                # Determine prefix: __shared_async_ for async, __shared_token_ otherwise
                                String prefix = "__shared_token_"
                                if async_fns.contains(callee_name):
                                    prefix = "__shared_async_"
                                String wrapper_name = prefix + callee_name
                                # Emit a stub function
                                Vector[int] wp = [I64_TYPE]
                                Vector[GirLocal] wl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone()), GirLocal(I64_TYPE, NO_NAME, LoParam(), BoParam())]
                                Vector[BasicBlock] wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                gmod.functions.push(GirFunction(wrapper_name, !wp, UNIT_TYPE, !wl, !wb))
                                emitted.put(callee_name, true)
                        else:
                            pass
                case EMethodCall(obj_box, method_name, _, _):
                    # spawn obj.method() → emit __spawn_method_wrap_TypeName__method_name
                    match (*obj_box).expr:
                        case EIdentifier(var_name):
                            Option[String] opt_type = var_types.get(var_name)
                            match opt_type:
                                case Some(type_name):
                                    String wrapper_name = "__spawn_method_wrap_" + type_name + "__" + method_name
                                    if not emitted.contains(wrapper_name):
                                        emitted.put(wrapper_name.clone(), true)
                                        Vector[int] wp = [I64_TYPE]
                                        Vector[GirLocal] wl = [GirLocal(I64_TYPE, NO_NAME, LoOwned(), BoNone()), GirLocal(I64_TYPE, NO_NAME, LoParam(), BoParam())]
                                        Vector[BasicBlock] wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                        gmod.functions.push(GirFunction(wrapper_name, !wp, UNIT_TYPE, !wl, !wb))
                                case None:
                                    pass
                        else:
                            pass
                else:
                    pass
        case EAwait(inner):
            scan_expr_for_spawn(*inner, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case EMethodCall(obj, _, margs, _):
            scan_expr_for_spawn(*obj, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ma in margs:
                scan_expr_for_spawn(ma, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case ECall(callee, cargs, _):
            scan_expr_for_spawn(*callee, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ca in cargs:
                scan_expr_for_spawn(ca, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        else:
            pass

# ── Named-closure spawn wrapper emission ─────────────────
# Emits __spawn_wrap___Closure_N stubs for `spawn var()` where var holds a closure.

void emit_named_closure_spawn_expr(SpannedExpr sexpr, Dict[String, String] &closure_vars, Dict[String, bool] &emitted, GirModule &gmod):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, _, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            if closure_vars.contains(callee_name):
                                String ctype = closure_vars.get(callee_name).unwrap()
                                String wrap = "__spawn_wrap_" + ctype
                                if not emitted.contains(wrap):
                                    emitted.put(wrap.clone(), true)
                                    Vector[int] ncwp = []
                                    Vector[GirLocal] ncwl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone())]
                                    Vector[BasicBlock] ncwb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                    gmod.functions.push(GirFunction(wrap, !ncwp, UNIT_TYPE, !ncwl, !ncwb))
                        else:
                            pass
                else:
                    pass
            emit_named_closure_spawn_expr(*inner_box, &closure_vars, &emitted, &gmod)
        case ECall(callee, args, _):
            emit_named_closure_spawn_expr(*callee, &closure_vars, &emitted, &gmod)
            for arg in args:
                emit_named_closure_spawn_expr(arg, &closure_vars, &emitted, &gmod)
        case EMethodCall(obj, _, margs, _):
            emit_named_closure_spawn_expr(*obj, &closure_vars, &emitted, &gmod)
            for ma in margs:
                emit_named_closure_spawn_expr(ma, &closure_vars, &emitted, &gmod)
        else:
            pass

void emit_named_closure_spawn_stmts(Vector[Stmt] stmts, Dict[String, String] &closure_vars, Dict[String, bool] &emitted, GirModule &gmod):
    for ncs in stmts:
        match ncs:
            case SVarDecl(_, _, init, _, _, _):
                emit_named_closure_spawn_expr(init, &closure_vars, &emitted, &gmod)
            case SExpr(expr):
                emit_named_closure_spawn_expr(expr, &closure_vars, &emitted, &gmod)
            case SReturn(opt):
                match opt:
                    case Some(re):
                        emit_named_closure_spawn_expr(re, &closure_vars, &emitted, &gmod)
                    case None:
                        pass
            case SIf(cond, then_body, branches):
                emit_named_closure_spawn_expr(cond, &closure_vars, &emitted, &gmod)
                emit_named_closure_spawn_stmts(then_body, &closure_vars, &emitted, &gmod)
                for nceb in branches:
                    emit_named_closure_spawn_stmts(nceb.body, &closure_vars, &emitted, &gmod)
            case SWhile(_, body):
                emit_named_closure_spawn_stmts(body, &closure_vars, &emitted, &gmod)
            case SFor(_, iter_expr, body, _, _):
                emit_named_closure_spawn_expr(iter_expr, &closure_vars, &emitted, &gmod)
                emit_named_closure_spawn_stmts(body, &closure_vars, &emitted, &gmod)
            else:
                pass

# ── Transitive generic discovery ─────────────────────────
# Substitute type variables in a SpannedType using a name→type map.

SpannedType substitute_type(SpannedType stype, Dict[String, SpannedType] &type_sub_map):
    match stype.ty:
        case TNamed(name, inner_targs):
            if inner_targs.len() == 0:
                if type_sub_map.contains(name):
                    return type_sub_map.get(name).unwrap()
            if inner_targs.len() > 0:
                Vector[SpannedType] new_inner = []
                for ita in inner_targs:
                    SpannedType sub = substitute_type(ita, &type_sub_map)
                    new_inner.push(sub)
                return SpannedType(TNamed(name, new_inner), stype.span)
            return stype
        else:
            return stype

# Extract meta-op suffix from a call argument list.
# Looks for EIdentifier("__metaop__<op>") produced by the parser's meta-op handling.
String extract_meta_op_suffix(Vector[SpannedExpr] args):
    for arg in args:
        match arg.expr:
            case EIdentifier(aname):
                if aname == "__metaop__add":
                    return "__add"
                elif aname == "__metaop__sub":
                    return "__sub"
                elif aname == "__metaop__mul":
                    return "__mul"
                elif aname == "__metaop__div":
                    return "__div"
                elif aname == "__metaop__mod":
                    return "__mod"
                elif aname == "__metaop__eq":
                    return "__eq"
                elif aname == "__metaop__ne":
                    return "__ne"
                elif aname == "__metaop__lt":
                    return "__lt"
                elif aname == "__metaop__gt":
                    return "__gt"
                elif aname == "__metaop__le":
                    return "__le"
                elif aname == "__metaop__ge":
                    return "__ge"
                else:
                    pass
            else:
                pass
    return ""

int discover_transitive_expr(SpannedExpr sexpr, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match sexpr.expr:
        case ECall(callee_box, args, targs):
            if targs.len() > 0 and has_type_variable(targs):
                Vector[SpannedType] resolved = []
                for ta in targs:
                    resolved.push(substitute_type(ta, &type_sub_map))
                if not has_type_variable(resolved):
                    String meta_suffix = extract_meta_op_suffix(args)
                    match (*callee_box).expr:
                        case EIdentifier(fname):
                            String mangled = compute_mangled_name(resolved, fname) + meta_suffix
                            if not seen.contains(mangled):
                                seen.put(mangled.clone(), true)
                                instances.push(GenericInstance(fname, resolved, mangled))
                                added += 1
                        else:
                            pass
            for arg in args:
                added += discover_transitive_expr(arg, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*callee_box, &type_sub_map, &seen, &instances)
        case EMethodCall(obj, _, margs, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            for ma in margs:
                added += discover_transitive_expr(ma, &type_sub_map, &seen, &instances)
        case EBinaryOp(lhs, _, rhs):
            added += discover_transitive_expr(*lhs, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*rhs, &type_sub_map, &seen, &instances)
        case EUnaryOp(_, inner):
            added += discover_transitive_expr(*inner, &type_sub_map, &seen, &instances)
        case EIf(cond, then_body, branches):
            added += discover_transitive_expr(*cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case EFieldAccess(obj, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
        case EIndex(obj, idx):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*idx, &type_sub_map, &seen, &instances)
        case EClosure(_, body):
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case EFString(_, fexprs):
            for fx in fexprs:
                added += discover_transitive_expr(fx, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmt(Stmt stmt, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            added += discover_transitive_expr(init, &type_sub_map, &seen, &instances)
        case SAssign(_, value):
            added += discover_transitive_expr(value, &type_sub_map, &seen, &instances)
        case SExpr(expr):
            added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case SWhile(cond, body):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SFor(_, iter_expr, body, _, _):
            added += discover_transitive_expr(iter_expr, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SMatch(scrutinee, arms):
            added += discover_transitive_expr(scrutinee, &type_sub_map, &seen, &instances)
            for arm in arms:
                added += discover_transitive_stmts(arm.body, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmts(Vector[Stmt] stmts, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    for stmt in stmts:
        added += discover_transitive_stmt(stmt, &type_sub_map, &seen, &instances)
    return added

# ── Module lowering ──────────────────────────────────────

GirModule lower_module(Module m, ScopeTable scopes, TypeTable types, Dict[String, String] call_redirects, Dict[String, bool] imported_fns):
    Vector[GirType] type_table = init_type_table()

    # Pre-scan: detect if module has a main() function.
    # Test blocks are skipped when main exists (normal build mode),
    # emitted when no main (test-only file).
    bool has_main = false
    for hm_item in m.items:
        match hm_item:
            case IFunction(fdef):
                if fdef.name == "main":
                    has_main = true
            else:
                pass

    # Pre-scan function signatures for call resolution.
    Dict[String, int] fn_sigs = {}
    for item in m.items:
        match item:
            case IFunction(fdef):
                int rt = I64_TYPE
                if fdef.name == "main":
                    rt = I32_TYPE
                else:
                    # Pre-scan: use primitive types AND best-effort named type detection.
                    match fdef.return_type.ty:
                        case TPrimitive(name):
                            int pt = prim_name_to_type(name)
                            if pt >= 0:
                                rt = pt
                            elif name == "String":
                                # Pre-register GorgetString so fn_sigs resolves correctly.
                                # Types table will be extended on-demand; here we use a
                                # sentinel that lower_call handles via fn definition lookup.
                                pass
                        case TNamed(name, _):
                            # Collection/named return types — record a hint so downstream
                            # call_return type inference can recover them during function
                            # definition lookup. Full resolution happens when the function
                            # body is lowered (see lower_function).
                            pass
                        else:
                            pass
                fn_sigs.put(fdef.name, rt)
            else:
                pass

    # Pre-scan function param ownership for borrow detection
    Dict[String, Vector[bool]] fn_borrow_params = {}
    for bp_item in m.items:
        match bp_item:
            case IFunction(fdef):
                Vector[bool] borrows = []
                for p in fdef.params:
                    borrows.push(p.ownership == 1)  # 1 = OWN_MUTABLE (&)
                fn_borrow_params.put(fdef.name, borrows)
            else:
                pass

    Dict[String, int] named_types = {}
    # Scan struct/enum defs to determine which types have resource fields
    Dict[String, bool] resource_types = {}
    resource_types.put("String", true)
    resource_types.put("GorgetString", true)
    for ritem in m.items:
        match ritem:
            case IStruct(sdef):
                bool has_resource = false
                for fld in sdef.fields:
                    if is_resource_field_type(fld.param_type, resource_types):
                        has_resource = true
                if has_resource:
                    resource_types.put(sdef.name, true)
            case IEnum(edef):
                bool has_resource = false
                for var in edef.variants:
                    for vft in var.fields:
                        if is_resource_field_type(vft, resource_types):
                            has_resource = true
                if has_resource:
                    resource_types.put(edef.name, true)
            else:
                pass

    Dict[String, int] type_subs = {}
    Dict[String, String] meta_aliases = types.meta_aliases
    # Also collect plain type aliases (ITypeAlias) into meta_aliases
    for ta_item in m.items:
        match ta_item:
            case ITypeAlias(ta_name, ta_tparams, ta_target):
                if ta_tparams.len() == 0:
                    # Store the raw type name for alias resolution
                    match ta_target.ty:
                        case TPrimitive(pname):
                            meta_aliases.put(ta_name, pname)
                        case TNamed(tname, _):
                            meta_aliases.put(ta_name, tname)
                        case TFunction(_, _, _):
                            # Function type aliases are opaque in GIR → void
                            meta_aliases.put(ta_name, "void")
                        else:
                            pass
            else:
                pass
    # Build type field info for LIR drop analysis.
    Dict[String, GirTypeInfo] type_infos = {}
    Dict[String, Vector[String]] enum_registry = {}
    for tfi_item in m.items:
        match tfi_item:
            case IStruct(sdef):
                Vector[GirFieldInfo] fields = []
                for fld in sdef.fields:
                    String ftype_name = spanned_type_to_name(fld.param_type)
                    fields.push(GirFieldInfo(fld.param_name, ftype_name))
                Vector[GirEnumVariantInfo] no_variants = []
                type_infos.put(sdef.name, GirTypeInfo(sdef.name, fields, no_variants, false))
            case IEnum(edef):
                Vector[GirFieldInfo] no_fields = []
                Vector[GirEnumVariantInfo] variants = []
                Vector[String] variant_names_only = []
                for var in edef.variants:
                    Vector[GirFieldInfo] vfields = []
                    int evfi = 0
                    while evfi < var.fields.len():
                        SpannedType vft = var.fields.get(evfi).unwrap()
                        String vftype_name = spanned_type_to_name(vft)
                        vfields.push(GirFieldInfo("_" + int_to_str(evfi), vftype_name))
                        evfi += 1
                    variants.push(GirEnumVariantInfo(var.name, vfields))
                    variant_names_only.push(var.name.clone())
                type_infos.put(edef.name, GirTypeInfo(edef.name, no_fields, variants, true))
                enum_registry.put(edef.name.clone(), !variant_names_only)
            else:
                pass
    Dict[String, int] const_decls = {}
    Dict[String, bool] none_decls = {}
    Dict[String, float] float_const_decls = {}
    # Module-level statics with runtime-call init (`stdout` / `stderr` /
    # `stdin` from lib/std/io.gg etc.). Populated below in the
    # IStaticDecl handler when int/float eval miss and the init shape is
    # a zero-arg call.
    Dict[String, GirStaticInfo] statics = {}
    Dict[String, ResourceMetadata] resource_metadata = {}
    GirModule gmod = GirModule([], [GirExtern("printf", true, I32_TYPE)], type_table, !fn_sigs, !named_types, !resource_types, !type_subs, !meta_aliases, !call_redirects, !imported_fns, !type_infos, !fn_borrow_params, !const_decls, !none_decls, !enum_registry, !float_const_decls, !statics, !resource_metadata, types, scopes)

    # Refine fn_sigs for functions with named/generic return types. The
    # pre-scan above defaulted those to `I64_TYPE` because `map_ast_type`
    # needs the real `gmod` to resolve generic names. Left uncorrected, a
    # caller of `parse_int(s) -> Result[int, ParseError]` would think the
    # return is int64 and allocate an 8-byte slot — the actual 48-byte
    # Result wouldn't fit, and field reads past the slot read zero. This
    # is the EIntLiteral-zero bug that made stage-1 produce `print(0)`
    # for `print(42)`, because `parse_int(clean).unwrap_or(0)` always
    # returned 0.
    for rs_item in m.items:
        match rs_item:
            case IFunction(rs_fdef):
                if rs_fdef.name != "main":
                    match rs_fdef.return_type.ty:
                        case TNamed(_, _):
                            int rs_rt = map_ast_type(rs_fdef.return_type, &gmod)
                            # Honour throws_type for Result[T, E] wrapping.
                            match rs_fdef.throws_type:
                                case Some(rs_throws):
                                    int rs_err = map_ast_type(rs_throws, &gmod)
                                    String rs_ret_c = type_id_to_name(rs_rt, &gmod)
                                    String rs_err_c = type_id_to_name(rs_err, &gmod)
                                    rs_rt = lookup_or_register_named(&gmod, "Result__" + rs_ret_c + "__" + rs_err_c)
                                case None:
                                    pass
                            gmod.fn_sigs.put(rs_fdef.name, rs_rt)
                        else:
                            pass
            else:
                pass

    # Pre-scan: evaluate IConstDecl AND IStaticDecl init exprs and register
    # values in gmod.const_decls. Without this, references to module-level
    # consts (e.g. `const int KW_IF = 5` in parser.gg) default to 0 at
    # EIdentifier lowering, which confuses the self-compiled parser's
    # keyword dispatch and deadlocks in check_kw(kw=0, pos=0).
    #
    # IStaticDecl covers the *non-const* spelling at module scope, e.g.
    # `int STRING_MARKER = -2` in lower.gg. The parser routes those
    # through `IStaticDecl(ty, name, val)` (parser.gg:3517-3519), but
    # before this loop was extended, the lowerer ignored them entirely
    # — every reference to `STRING_MARKER` got the EIdentifier
    # unknown-fallback (OpConstI64(0)).
    for cd_item in m.items:
        match cd_item:
            case IConstDecl(_, cd_name, cd_val):
                Option[int] cd_eval = eval_const_int_expr(cd_val, &gmod)
                match cd_eval:
                    case Some(cv):
                        gmod.const_decls.put(cd_name.clone(), cv)
                    case None:
                        # Float fallback: `const float EPSILON = 0.000001`
                        # lands here when int eval fails.
                        Option[float] cd_feval = eval_const_float_expr(cd_val, &gmod)
                        match cd_feval:
                            case Some(cfv):
                                gmod.float_const_decls.put(cd_name.clone(), cfv)
                            case None:
                                pass
            case IStaticDecl(sd_ty, sd_name, sd_val):
                Option[int] sd_eval = eval_const_int_expr(sd_val, &gmod)
                match sd_eval:
                    case Some(sv):
                        gmod.const_decls.put(sd_name.clone(), sv)
                    case None:
                        # Float fallback: `float EPSILON = 0.000001`
                        # at module scope (e.g., lib/xtd/math3d.gg).
                        Option[float] sd_feval = eval_const_float_expr(sd_val, &gmod)
                        match sd_feval:
                            case Some(sfv):
                                gmod.float_const_decls.put(sd_name.clone(), sfv)
                            case None:
                                # Runtime-call fallback: `public static File
                                # stdout = _stdout_handle()` etc. Mirrors Rust
                                # gg's `LoweringContext::global_names`. Helper
                                # extracts the C runtime symbol; helper lives
                                # in its own fn so this dispatch site stays
                                # tight (the int/float cascade already lives
                                # in lower_expr-adjacent stack frames).
                                bool sd_handled = try_register_static_runtime_call(&gmod, sd_ty, sd_name, sd_val)
                                if not sd_handled:
                                    # Recognise `Option[T] X = None` so EIdentifier can
                                    # emit OpConstUnit() instead of the int-0 fallback.
                                    match sd_val.expr:
                                        case ENoneLiteral():
                                            gmod.none_decls.put(sd_name.clone(), true)
                                        else:
                                            pass
            else:
                pass

    # Collect generic templates and discover instances. Restored to
    # Dict-backed storage once the underlying Dict[String, _] codegen
    # bug was fixed (see DONE.md 2026-05-01).
    Dict[String, FunctionDef] fn_templates = {}
    Vector[EquipBlock] equip_templates = []
    Dict[String, bool] equip_generic_names = {}
    Dict[String, bool] seen_instances = {}
    Vector[GenericInstance] generic_instances = []

    for gitem in m.items:
        match gitem:
            case IFunction(fdef):
                if fdef.type_params.len() > 0:
                    fn_templates.put(fdef.name.clone(), fdef)
            case IEquip(eqblk):
                # Check if equip is generic: either type_params set OR target has type args
                bool is_generic_equip = eqblk.type_params.len() > 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        if eq_targs.len() > 0:
                            is_generic_equip = true
                        if is_generic_equip:
                            equip_templates.push(eqblk)
                            if not equip_generic_names.contains(tname):
                                equip_generic_names.put(tname.clone(), true)
                    else:
                        pass
            else:
                pass

    # Collect generic struct templates for resource type detection
    Dict[String, StructDef] struct_templates = {}
    for st_item in m.items:
        match st_item:
            case IStruct(sdef):
                if sdef.type_params.len() > 0:
                    struct_templates.put(sdef.name.clone(), sdef)
            else:
                pass

    # Discover generic call sites and type instances from all function/equip bodies
    for ditem in m.items:
        match ditem:
            case IFunction(fdef):
                discover_generic_calls_stmts(fdef.body, &seen_instances, &generic_instances)
            case IEquip(eqblk):
                for mdef in eqblk.methods:
                    discover_generic_calls_stmts(mdef.body, &seen_instances, &generic_instances)
            else:
                pass

    # Transitive generic discovery: fixpoint loop to find instances needed
    # inside already-discovered generic function bodies (e.g. tensor_zeros[T]
    # inside tensor_sum_axis[float], meta-op calls like tensor_scalar_op[T](t, val, meta /)).
    # Also walks generic-equip method return types + bodies so the
    # iterator chain `Vector[int]` → `VectorIter[int]` → `next()` returns
    # `Option[int]` cascade is discovered without explicit annotations
    # at every call site.
    bool transitive_changed = true
    while transitive_changed:
        transitive_changed = false
        int tfix_i = 0
        int tfix_end = generic_instances.len()
        while tfix_i < tfix_end:
            GenericInstance tinst = generic_instances.get(tfix_i).unwrap()
            String tfix_key = tinst.base_name.clone()
            if not fn_templates.contains(tfix_key) and gmod.call_redirects.contains(tinst.base_name):
                tfix_key = gmod.call_redirects.get(tinst.base_name).unwrap()
            if fn_templates.contains(tfix_key):
                FunctionDef tfix_tmpl = fn_templates.get(tfix_key).unwrap()
                if tfix_tmpl.type_params.len() > 0:
                    Dict[String, SpannedType] type_sub_map = {}
                    int tpi = 0
                    while tpi < tfix_tmpl.type_params.len() and tpi < tinst.type_args.len():
                        String tpname = tfix_tmpl.type_params.get(tpi).unwrap()
                        SpannedType tpta = tinst.type_args.get(tpi).unwrap()
                        type_sub_map.put(tpname, tpta)
                        tpi += 1
                    int prev_count = generic_instances.len()
                    discover_transitive_stmts(tfix_tmpl.body, &type_sub_map, &seen_instances, &generic_instances)
                    if generic_instances.len() > prev_count:
                        transitive_changed = true
            # Generic-equip transitive walk: for each instance whose target
            # has equip blocks, harvest the method return types (with subs)
            # AND walk method bodies for further generic call sites. This
            # lets `Vector[int]` discover `VectorIter[int]`, `VectorDrain[int]`,
            # … which in turn unlock their own `next()`/`iter()` cascades.
            if equip_generic_names.contains(tinst.base_name):
                for eqf_tmpl in equip_templates:
                    String eqf_target = ""
                    match eqf_tmpl.target.ty:
                        case TNamed(etn, _):
                            eqf_target = etn
                        else:
                            pass
                    if eqf_target == tinst.base_name:
                        Vector[String] eqf_tparams = extract_equip_type_params(eqf_tmpl)
                        Dict[String, SpannedType] eqf_sub_map = {}
                        int etpi = 0
                        while etpi < eqf_tparams.len() and etpi < tinst.type_args.len():
                            String etpname = eqf_tparams.get(etpi).unwrap()
                            SpannedType etpta = tinst.type_args.get(etpi).unwrap()
                            eqf_sub_map.put(etpname, etpta)
                            etpi += 1
                        int eqf_prev = generic_instances.len()
                        for eqf_meth in eqf_tmpl.methods:
                            # Method return type — substitute and register as
                            # a generic instance if it names a generic type
                            # (e.g. `VectorIter[T]` → `VectorIter[int]`).
                            SpannedType ret_sub = substitute_type(eqf_meth.return_type, &eqf_sub_map)
                            match ret_sub.ty:
                                case TNamed(rtname, rtargs):
                                    if rtargs.len() > 0 and not has_type_variable(rtargs):
                                        String rt_mangled = compute_mangled_name(rtargs, rtname)
                                        if not seen_instances.contains(rt_mangled):
                                            seen_instances.put(rt_mangled.clone(), true)
                                            generic_instances.push(GenericInstance(rtname, rtargs, rt_mangled))
                                else:
                                    pass
                            # Method body — walk for ECall sites with type
                            # args (e.g. `return VectorIter[T](self, 0)`
                            # discovers `VectorIter[int]` via the constructor
                            # call). Skip method-level generics; those need
                            # per-call-site mono and aren't reached here.
                            if eqf_meth.type_params.len() == 0:
                                discover_transitive_stmts(eqf_meth.body, &eqf_sub_map, &seen_instances, &generic_instances)
                        if generic_instances.len() > eqf_prev:
                            transitive_changed = true
            tfix_i += 1

    # Register monomorphized struct types as resource types if any substituted
    # field is a resource type (e.g., Pair[int, String] has a String field)
    for mrinst in generic_instances:
        if struct_templates.contains(mrinst.base_name):
            StructDef sdef = struct_templates.get(mrinst.base_name).unwrap()
            # Build substitution map
            setup_type_subs(&gmod, sdef.type_params, mrinst.type_args)
            # Register the mono'd struct's field info in `type_infos` so
            # later `EFieldAccess` lookups find `TypedColumn__int64_t.data`
            # / `Tensor__double.shape` etc. without falling through to
            # the `[bug]` placeholder. Field types are template-fields
            # substituted via `gmod.type_subs` (T → int64_t etc.).
            # Mirrors Rust gg's `monomorphize_struct()` step
            # (`src/ir/lowering/generics/mod.rs:2249-2304`).
            Vector[GirFieldInfo] mono_fields = []
            bool has_resource = false
            for fld in sdef.fields:
                int ft = map_ast_type(fld.param_type, &gmod)
                String ft_name = type_id_to_name(ft, &gmod)
                mono_fields.push(GirFieldInfo(fld.param_name.clone(), ft_name.clone()))
                if is_resource_type_name(ft_name, &gmod):
                    has_resource = true
            # Register only when the mono'd name isn't already there
            # (avoids duplicate clones when `generic_instances` lists
            # the same mono more than once across import cycles).
            if not gmod.type_infos.contains(mrinst.mangled_name):
                Vector[GirEnumVariantInfo] mono_no_variants = []
                gmod.type_infos.put(mrinst.mangled_name.clone(), GirTypeInfo(mrinst.mangled_name.clone(), mono_fields, mono_no_variants, false))
            clear_type_subs(&gmod)
            if has_resource:
                gmod.resource_types.put(mrinst.mangled_name.clone(), true)

    # Populate fn_sigs for non-generic functions using map_ast_type now that
    # gmod.type_table is accessible. Pre-scan only handled TPrimitive return
    # types; this pass captures TNamed (String, Vector[T], …).
    for fs_item in m.items:
        match fs_item:
            case IFunction(fsdef):
                if fsdef.type_params.len() == 0 and fsdef.name != "main":
                    int ret_tid = map_fn_return_type(fsdef.return_type, &gmod)
                    if ret_tid >= 0:
                        gmod.fn_sigs.put(fsdef.name.clone(), ret_tid)
            case IEquip(ieqblk):
                # Register equip-block methods as TypeName__method in fn_sigs.
                # Only for non-generic equip blocks on concrete types.
                if ieqblk.type_params.len() == 0:
                    String target_name = ""
                    match ieqblk.target.ty:
                        case TNamed(tn, targs):
                            if targs.len() == 0:
                                target_name = tn
                        case TPrimitive(tn):
                            target_name = tn
                        else:
                            pass
                    if target_name != "":
                        for em in ieqblk.methods:
                            if em.type_params.len() == 0:
                                int em_ret = map_fn_return_type(em.return_type, &gmod)
                                if em_ret >= 0:
                                    String em_full = target_name + "__" + em.name
                                    gmod.fn_sigs.put(em_full, em_ret)
            else:
                pass

    # Register fn_sigs for monomorphized instances
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name
        String tmpl_key = inst.base_name.clone()
        if not fn_templates.contains(tmpl_key) and gmod.call_redirects.contains(inst.base_name):
            tmpl_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(tmpl_key):
            FunctionDef tmpl = fn_templates.get(tmpl_key).unwrap()
            # Compute return type with substitutions active
            setup_type_subs(&gmod, tmpl.type_params, inst.type_args)
            int rt = map_ast_type(tmpl.return_type, &gmod)
            clear_type_subs(&gmod)
            # Monomorphized generics use bare names (no module prefix)
            gmod.fn_sigs.put(inst.mangled_name.clone(), rt)

    # Register fn_sigs for monomorphized generic-equip methods. Mirrors the
    # function-template pre-pass above: fn_sigs entries must exist *before*
    # function bodies are lowered (line ~6155+) so call-site return-type
    # lookups (e.g. `v.iter()` in lower_for_iterator) resolve. The actual
    # equip-method bodies are emitted later at line ~6481 by
    # `lower_generic_equip` which strips trait_name and routes through
    # lower_equip_block — produces `Target__method` naming with type subs
    # applied. We mirror that naming here.
    for eqsi_inst in generic_instances:
        if equip_generic_names.contains(eqsi_inst.base_name):
            for eqs_tmpl in equip_templates:
                String eqs_target_name = ""
                match eqs_tmpl.target.ty:
                    case TNamed(etn, _):
                        eqs_target_name = etn
                    else:
                        pass
                if eqs_target_name == eqsi_inst.base_name:
                    Vector[String] eqs_type_params = extract_equip_type_params(eqs_tmpl)
                    setup_type_subs(&gmod, eqs_type_params, eqsi_inst.type_args)
                    # `type_to_c_name(target, …)` substitutes type vars from
                    # active subs — `Vector[T]` with T → int → `Vector__int64_t`.
                    String eqs_mono_target = type_to_c_name(eqs_tmpl.target, &gmod)
                    for eqs_mdef in eqs_tmpl.methods:
                        # Method-level generics (`fold[A, F]` etc.) skip this
                        # pre-pass; they need per-call-site mono of their own.
                        if eqs_mdef.type_params.len() == 0:
                            int eqs_ret = map_fn_return_type(eqs_mdef.return_type, &gmod)
                            if eqs_ret >= 0:
                                String eqs_mangled = eqs_mono_target + "__" + eqs_mdef.name
                                gmod.fn_sigs.put(eqs_mangled, eqs_ret)
                    clear_type_subs(&gmod)

    # Build trait lookup map for default method generation
    Dict[String, TraitDef] trait_defs = {}
    Dict[String, bool] local_struct_names = {}
    for td_item in m.items:
        match td_item:
            case ITrait(tdef):
                trait_defs.put(tdef.name.clone(), tdef)
            case IStruct(sdef):
                local_struct_names.put(sdef.name.clone(), true)
            case IEnum(edef):
                local_struct_names.put(edef.name.clone(), true)
            else:
                pass

    # Lower each non-generic function, equip method, and test block
    int test_idx = 0
    for item in m.items:
        match item:
            case IFunction(fdef):
                # Skip generic templates — they'll be monomorphized below
                if fdef.type_params.len() == 0:
                    # Skip extern/forward declarations: the parser loses
                    # the `extern` keyword and `= "symbol"` binding, producing
                    # a function with 0 body statements. The Rust compiler
                    # emits these as `declare extern`, not as `fn @`.
                    if fdef.body.len() > 0:
                        gmod.functions.push(lower_function(fdef, &gmod))
            case ITest(tname, decorators, tags, test_body):
                # Skip test blocks when main() exists (normal build mode).
                # Emit __test_N for test-only files (no main).
                if not has_main:
                    # Check for @skip — parser sets "__skip__" sentinel in tags
                    bool is_skipped = false
                    for tag_val in tags:
                        if tag_val == "__skip__":
                            is_skipped = true
                    if not is_skipped:
                        String test_fn_name = "__test_" + int_to_str(test_idx)
                        Vector[int] _lc_stk3 = []
                        Vector[int] _lb_stk3 = []
                        Dict[String, int] _named_locals3 = {}
                        LowerCtx tctx = LowerCtx([], [], [], 0, !_named_locals3, 0, !_lc_stk3, !_lb_stk3, "", "", "", false, test_fn_name.clone())
                        Vector[Instruction] tinit = []
                        tctx.block_insts.push(!tinit)
                        tctx.block_terms.push(GTNone())
                        add_local(&tctx, UNIT_TYPE, NO_NAME)
                        lower_stmts(&tctx, test_body, &gmod, false)
                        Terminator tterm = tctx.block_terms.get(tctx.current_block).unwrap()
                        match tterm:
                            case GTNone():
                                set_terminator(&tctx, GTReturn(OpConstUnit()))
                            else:
                                pass
                        Vector[BasicBlock] tblocks = []
                        int tbi = 0
                        while tbi < tctx.block_insts.len():
                            Vector[Instruction] tinsts = tctx.block_insts.get(tbi).unwrap()
                            Terminator tt = tctx.block_terms.get(tbi).unwrap()
                            tblocks.push(BasicBlock(tinsts, tt))
                            tbi += 1
                        Vector[int] tparams = []
                        gmod.functions.push(GirFunction(test_fn_name, !tparams, UNIT_TYPE, tctx.locals, !tblocks))
                test_idx += 1
            case ISuiteSetup(setup_body):
                if not has_main:
                    Vector[int] sp = []
                    Vector[GirLocal] sl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone())]
                    Vector[BasicBlock] sb = [BasicBlock([], GTReturn(OpConstUnit()))]
                    gmod.functions.push(GirFunction("__suite_setup", !sp, UNIT_TYPE, !sl, !sb))
                    test_idx += 1
            case ISuiteTeardown(teardown_body):
                if not has_main:
                    Vector[int] tp = []
                    Vector[GirLocal] tl = [GirLocal(UNIT_TYPE, NO_NAME, LoOwned(), BoNone())]
                    Vector[BasicBlock] tb = [BasicBlock([], GTReturn(OpConstUnit()))]
                    gmod.functions.push(GirFunction("__suite_teardown", !tp, UNIT_TYPE, !tl, !tb))
                    test_idx += 1
            case IEquip(eqblk):
                # Generic equip blocks: emit template for imported types
                # (Rust emits Heap__T__push for imported Heap but not local Stack).
                bool is_generic_equip = false
                String eq_type_name = ""
                int eq_targs_count = 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        eq_type_name = tname
                        eq_targs_count = eq_targs.len()
                        if eq_targs.len() > 0 or eqblk.type_params.len() > 0:
                            is_generic_equip = true
                    else:
                        pass
                if is_generic_equip and eq_type_name.len() > 0 and not local_struct_names.contains(eq_type_name):
                    # Imported generic type: SKIP template emission. Rust gg
                    # elides un-monomorphized generic templates entirely
                    # (mod.rs:525, 1130 — `continue; // Generic functions
                    # handled via monomorphization`); only mono'd instances
                    # reach the lowerer. Templates lowered with bare-T
                    # bodies produce `[bug] EIdentifier: unknown identifier
                    # 'T'` (and same for K/V) — ~58 occurrences across
                    # SetIter/DictIter/etc. The mono'd-equip emission below
                    # (line ~5285) handles the actual call sites.
                    pass
                if is_generic_equip and eq_type_name.len() > 0 and local_struct_names.contains(eq_type_name):
                    # Local generic equip: Rust emits templates ONLY when:
                    #   (a) single type param, no explicit (non-derive) trait, AND
                    #   (b) the type is used in a generic function's params (e.g. unwrap_box[T](Box2[T] b))
                    #       OR has an instantiation with a non-primitive/non-String type arg
                    #       (e.g. Container[Container[int]])
                    # This avoids spurious templates for Stack[T] / Pair[T] which are
                    # only ever used with primitive args and never in generic functions.
                    bool has_explicit_trait = false
                    match eqblk.trait_name:
                        case Some(tn):
                            bool is_derive2 = is_builtin_trait(tn)
                            if not is_derive2:
                                has_explicit_trait = true
                        case None:
                            pass
                    # Check total type param count: target type args + explicit type_params
                    int total_type_params = eq_targs_count + eqblk.type_params.len()
                    if total_type_params == 1 and not has_explicit_trait:
                        # Check if template is needed:
                        # (1) type appears in any generic function's param types
                        bool needs_template = false
                        for gf_item in m.items:
                            match gf_item:
                                case IFunction(fdef):
                                    if fdef.type_params.len() > 0 and not needs_template:
                                        for gfp in fdef.params:
                                            match gfp.param_type.ty:
                                                case TNamed(n, _):
                                                    if n == eq_type_name:
                                                        needs_template = true
                                                else:
                                                    pass
                                else:
                                    pass
                        # (2) any discovered instance has a non-primitive/non-String type arg
                        if not needs_template:
                            for ginst in generic_instances:
                                if ginst.base_name == eq_type_name:
                                    for gta in ginst.type_args:
                                        bool is_simple_arg = false
                                        match gta.ty:
                                            case TPrimitive(_):
                                                is_simple_arg = true
                                            case TNamed(gn, _):
                                                if gn == "String" or gn == "GorgetString" or gn == "bool":
                                                    is_simple_arg = true
                                            else:
                                                pass
                                        if not is_simple_arg:
                                            needs_template = true
                        if needs_template:
                            lower_equip_block(eqblk, &gmod)
                if not is_generic_equip:
                    # For explicit non-derive trait equip: split methods by whether
                    # they're in the trait's OWN vtable vs inherited from a parent.
                    # Inherited overrides use Type__method naming; own use Trait_for_Type__method.
                    bool did_split = false
                    match eqblk.trait_name:
                        case Some(tname):
                            bool is_derive_sp = is_builtin_trait(tname)
                            if not is_derive_sp and trait_defs.contains(tname):
                                did_split = true
                                TraitDef tdef = trait_defs.get(tname).unwrap()
                                # Build set of method names in the trait's OWN vtable
                                Dict[String, bool] own_vtable = {}
                                for tvmeth in tdef.methods:
                                    own_vtable.put(tvmeth.name.clone(), true)
                                # Split equip methods: own vtable vs inherited overrides
                                Vector[FunctionDef] own_methods = []
                                Vector[FunctionDef] inherited_methods = []
                                int smi = 0
                                while smi < eqblk.methods.len():
                                    FunctionDef sm = eqblk.methods.get(smi).unwrap()
                                    if own_vtable.contains(sm.name):
                                        own_methods.push(sm)
                                    else:
                                        inherited_methods.push(sm)
                                    smi += 1
                                # Emit own-vtable methods with Trait_for_Type naming
                                if own_methods.len() > 0:
                                    EquipBlock own_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, own_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    lower_equip_block(own_eqblk, &gmod)
                                # Emit inherited overrides with Type__ naming (no trait prefix)
                                if inherited_methods.len() > 0:
                                    Option[String] inh_no_trait = None
                                    EquipBlock inh_eqblk = EquipBlock(eqblk.target, eqblk.type_params, inh_no_trait, inherited_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    lower_equip_block(inh_eqblk, &gmod)
                                # Collect all overridden method names
                                Dict[String, bool] overridden = {}
                                for om in eqblk.methods:
                                    overridden.put(om.name.clone(), true)
                                String eq_target_sp = type_to_c_name(eqblk.target, &gmod)
                                # Emit own-trait default methods (Trait_for_Type naming)
                                for tmeth2 in tdef.methods:
                                    if tmeth2.body.len() > 0 and not overridden.contains(tmeth2.name):
                                        String dm_trait2 = mangle_trait_name(tname)
                                        String dm_mangled2 = dm_trait2 + "_for_" + eq_target_sp + "__" + tmeth2.name
                                        gmod.functions.push(lower_function(tmeth2, &gmod))
                                        int last_idx2 = gmod.functions.len() - 1
                                        GirFunction last_fn2 = gmod.functions.get(last_idx2).unwrap()
                                        gmod.functions.set(last_idx2, GirFunction(dm_mangled2, last_fn2.param_types, last_fn2.return_type, last_fn2.locals, last_fn2.blocks))
                                # Emit parent trait default methods (Type__ naming, no prefix)
                                for pt_name in tdef.parent_traits:
                                    if trait_defs.contains(pt_name):
                                        TraitDef pt_def = trait_defs.get(pt_name).unwrap()
                                        for pt_meth in pt_def.methods:
                                            if pt_meth.body.len() > 0 and not overridden.contains(pt_meth.name):
                                                String pt_mangled = eq_target_sp + "__" + pt_meth.name
                                                gmod.functions.push(lower_function(pt_meth, &gmod))
                                                int pt_last = gmod.functions.len() - 1
                                                GirFunction pt_last_fn = gmod.functions.get(pt_last).unwrap()
                                                gmod.functions.set(pt_last, GirFunction(pt_mangled, pt_last_fn.param_types, pt_last_fn.return_type, pt_last_fn.locals, pt_last_fn.blocks))
                                                overridden.put(pt_meth.name.clone(), true)
                        case None:
                            pass
                    if not did_split:
                        lower_equip_block(eqblk, &gmod)
                        # Generate default trait methods not overridden by the equip
                        match eqblk.trait_name:
                            case Some(tname):
                                if trait_defs.contains(tname):
                                    TraitDef tdef = trait_defs.get(tname).unwrap()
                                    # Collect overridden method names
                                    Dict[String, bool] overridden = {}
                                    for om in eqblk.methods:
                                        overridden.put(om.name.clone(), true)
                                    # Emit defaults for trait methods with bodies not in equip
                                    for tmeth in tdef.methods:
                                        if tmeth.body.len() > 0 and not overridden.contains(tmeth.name):
                                            String eq_target = type_to_c_name(eqblk.target, &gmod)
                                            String dm_trait = mangle_trait_name(tname)
                                            String dm_mangled = dm_trait + "_for_" + eq_target + "__" + tmeth.name
                                            gmod.functions.push(lower_function(tmeth, &gmod))
                                            int last_idx = gmod.functions.len() - 1
                                            GirFunction last_fn = gmod.functions.get(last_idx).unwrap()
                                            gmod.functions.set(last_idx, GirFunction(dm_mangled, last_fn.param_types, last_fn.return_type, last_fn.locals, last_fn.blocks))
                            case None:
                                pass
                    # Via delegation: emit stubs for trait methods not explicitly overridden
                    match eqblk.via_field:
                        case Some(_):
                            match eqblk.trait_name:
                                case Some(via_tname):
                                    if trait_defs.contains(via_tname):
                                        TraitDef via_tdef = trait_defs.get(via_tname).unwrap()
                                        Dict[String, bool] via_done = {}
                                        for vom in eqblk.methods:
                                            via_done.put(vom.name.clone(), true)
                                        for via_meth in via_tdef.methods:
                                            if not via_done.contains(via_meth.name):
                                                Vector[FunctionDef] stub_meths = []
                                                stub_meths.push(via_meth)
                                                Option[String] stub_via = None
                                                EquipBlock stub_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, stub_meths, stub_via, eqblk.trait_generic_args)
                                                lower_equip_block(stub_eqblk, &gmod)
                                                via_done.put(via_meth.name.clone(), true)
                                case None:
                                    pass
                        case None:
                            pass
            else:
                pass

    # Emit monomorphized generic functions
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name.
        String fn_key = inst.base_name.clone()
        if not fn_templates.contains(fn_key) and gmod.call_redirects.contains(inst.base_name):
            fn_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(fn_key):
            FunctionDef tmpl = fn_templates.get(fn_key).unwrap()
            # Monomorphized generics use bare names (no module prefix)
            lower_generic_function(tmpl, inst.mangled_name, tmpl.type_params, inst.type_args, &gmod)

    # Emit monomorphized generic equip blocks for discovered type instances
    for einst in generic_instances:
        if equip_generic_names.contains(einst.base_name):
            # Find all equip templates matching this type name
            for equip_tmpl in equip_templates:
                String eq_target_name = ""
                match equip_tmpl.target.ty:
                    case TNamed(tn, _):
                        eq_target_name = tn
                    else:
                        pass
                if eq_target_name == einst.base_name:
                    lower_generic_equip(equip_tmpl, einst.type_args, &gmod)
                    # For generic equip with explicit traits, also emit default trait methods.
                    # These use Type__method naming (no trait prefix).
                    match equip_tmpl.trait_name:
                        case Some(tname):
                            bool is_derive_g = is_builtin_trait(tname)
                            if not is_derive_g and trait_defs.contains(tname):
                                TraitDef gtdef = trait_defs.get(tname).unwrap()
                                # Build set of explicitly implemented methods
                                Dict[String, bool] g_overridden = {}
                                for gom in equip_tmpl.methods:
                                    g_overridden.put(gom.name.clone(), true)
                                # Compute the monomorphized type name for this instance
                                # e.g. Container + [int] -> Container__int64_t
                                String g_mono_name = compute_mangled_name(einst.type_args, einst.base_name)
                                # Emit each unoverridden default method
                                for gtmeth in gtdef.methods:
                                    if gtmeth.body.len() > 0 and not g_overridden.contains(gtmeth.name):
                                        String g_dm_mangled = g_mono_name + "__" + gtmeth.name
                                        gmod.functions.push(lower_function(gtmeth, &gmod))
                                        int g_last = gmod.functions.len() - 1
                                        GirFunction g_last_fn = gmod.functions.get(g_last).unwrap()
                                        gmod.functions.set(g_last, GirFunction(g_dm_mangled, g_last_fn.param_types, g_last_fn.return_type, g_last_fn.locals, g_last_fn.blocks))
                        case None:
                            pass

    # Scan all items for closures and emit __Closure_N__call functions
    int closure_id = 0
    for citem in m.items:
        match citem:
            case IFunction(fdef):
                closure_id = scan_stmts_for_closures(fdef.body, closure_id, &gmod)
            case IEquip(eqblk):
                for emdef in eqblk.methods:
                    closure_id = scan_stmts_for_closures(emdef.body, closure_id, &gmod)
            else:
                pass

    # Scan for spawn wrappers: shared-token and closure/method spawn
    # Two-pass approach:
    # Pass 1: collect ALL shared variable names from ALL functions (so inner
    #         spawns inside nested_driver can see shared vars from main).
    # Pass 2: scan every function body for ESpawn calls.
    Dict[String, bool] shared_vars = {}
    Dict[String, bool] async_fns = {}
    Dict[String, bool] emitted_wrappers = {}
    for sw_item1 in m.items:
        match sw_item1:
            case IFunction(fdef):
                collect_shared_vars(fdef.body, &shared_vars)
            else:
                pass
    for sw_item in m.items:
        match sw_item:
            case IFunction(fdef):
                # Per-function var_types map: variable name → declared type name
                # Used to resolve receiver type for method spawn wrappers.
                Dict[String, String] var_types = {}
                # Collect &-qualified params (OWN_MUTABLE == 1) of this function.
                # These are shared-derived refs; if passed to a spawn, the callee
                # needs a shared-token wrapper (inner shared spawn pattern).
                Dict[String, bool] borrow_params = {}
                for bp in fdef.params:
                    if bp.ownership == 1:
                        borrow_params.put(bp.param_name, true)
                scan_spawn_wrappers(fdef.body, &shared_vars, &async_fns, &emitted_wrappers, &gmod, &var_types, &borrow_params)
            else:
                pass

    # Emit __spawn_wrap___Closure_N stubs for named closure variable spawns.
    # Collect closure variable names per function (using same closure ID ordering),
    # then scan for spawn calls to those variables.
    int ncv_id = 0
    for ncv_item in m.items:
        match ncv_item:
            case IFunction(fdef):
                Dict[String, String] fn_closure_vars = {}
                ncv_id = collect_closure_vars_stmts(fdef.body, ncv_id, &fn_closure_vars)
                if fn_closure_vars.len() > 0:
                    emit_named_closure_spawn_stmts(fdef.body, &fn_closure_vars, &emitted_wrappers, &gmod)
            else:
                pass

    return gmod
