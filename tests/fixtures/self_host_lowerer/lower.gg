# Typed builtin-method declaration tables — the single source of truth
# for the String-view / collection-owning-arg / String-return facts the
# lowerer used to recognise via raw name-match lists (CLAUDE.md "No name
# matching"). Read via `string_builtin_method` / `collection_builtin_method`
# (mirror lir_lower.gg's `build_resource_metadata` reading RESOURCES).
from compiler.data.resources import STRING_BUILTIN_METHODS, COLLECTION_BUILTIN_METHODS, BUILTIN_METHOD_MUTATES
from compiler.data.schema import BuiltinMethodDecl, BuiltinMethodEntry
from compiler.data.schema import BuiltinRetKind, BrkString, BrkInfer

# ── Lowering context ─────────────────────────────────────

# DropScope kind tags. Mirrors Rust's `DropScopeKind` enum in
# `src/ir/lowering/drops.rs` — kept as int constants because the
# self-host's typed-metadata story is GIR-level, not enum-shaped (the
# Rust copy of the enum maps onto these ints 1:1 via match).
const int DSK_FUNCTION = 0
const int DSK_LOOP = 1
const int DSK_BLOCK = 2

# One entry per local that needs to be dropped when its enclosing scope
# exits. Fields mirror Rust's `DropEntry` in `src/ir/lowering/drops.rs`:
#   • local_id: GIR local slot to drop
#   • type_id: GIR type id, used by Phase 2/3 emission to call
#     `drop_fn_for_type` via gir_local_type_name. Stored on the entry
#     rather than re-looked-up so any later type updates don't drift
#     from the registration intent.
#   • maybe_moved: set by `mark_local_moved` at consume sites that
#     transfer ownership out of the local. Today the emission path
#     always emits `GIDropIfAlive` (defensive — mirrors Rust's post-
#     Snag #30 unconditional shape, where the LIR `drop_elab` pass
#     statically elides the runtime memcmp when init is provably
#     unconditional). The flag is recorded for future invariant
#     audits and for downstream consumers (e.g. the
#     `tighten_owned_operand_modes` post-pass) that need to know
#     which locals had ownership transferred away.
struct DropEntry:
    int local_id
    int type_id
    bool maybe_moved

# A drop scope corresponds to a language construct that owns locals.
# `kind` is one of DSK_*; `entries` lists locals registered in this
# scope in declaration order (drops are emitted in reverse / LIFO).
struct DropScope:
    int kind
    Vector[DropEntry] entries

# Tracks owned locals and emits drop instructions at scope boundaries.
# Mirrors Rust's `DropElaborator` (`src/ir/lowering/drops.rs`). Scope
# discipline: pushed at function entry / loop entry / each if-branch /
# match-arm entry, popped (with drop emission) at the corresponding
# exit. Early exits (return / break / continue) call
# `emit_drops_for_early_exit` to walk the scope stack innermost-out
# down to (and including) the target scope kind, emitting drops along
# the way without popping.
struct DropElaborator:
    Vector[DropScope] scopes

# Phase 2c COMMIT 3 Prereq C — deferred drop-emission record.
#
# Background: `emit_scope_drops` / `emit_drops_for_early_exit` are
# called INLINE during `lower_stmt`. The `maybe_moved` gate they
# would consult is set by `mark_local_moved` inside
# `wire_one_operand` (the post-pass `wire_liveness_into_modes`).
# That post-pass runs AFTER all inline emit calls have returned, so
# at inline emit time `maybe_moved` is universally false — the gate
# is a no-op.
#
# The fix: convert inline emission to a queue (append a
# `DropEmission` entry for every drop a scope-pop / early-exit
# would have emitted). After `wire_liveness_into_modes` populates
# `maybe_moved`, walk the queue and emit each pending drop, gated
# on `not entry.maybe_moved`.
#
# Fields:
#   • local_id: GIR local slot the deferred drop targets. Mirrors
#     the LIFO walk's `entry.local_id` at the inline emit site.
#   • target_block: index into `ctx.block_insts` where the drop
#     should be inserted. Recorded at the time the inline emit
#     site is reached (= `ctx.current_block`).
#   • insert_at_inst_idx: position within `target_block`'s
#     instruction vector where the drop should land. For natural-
#     scope-exit drops, this is `block_insts.get(target_block).len()`
#     at the inline call site (end of block, where the drop would
#     have been pushed). For early-exit drops (SReturn/SBreak/
#     SContinue), the drop lands BEFORE the terminator — the same
#     end-of-block position, because the early-exit emits drops
#     into the current block before setting its terminator.
#   • dse_scope_idx + entry_idx: pair of indices to read the
#     `maybe_moved` flag from at flush time. `dse_scope_idx` is the
#     index into `ctx.drop_elab.scopes` AT THE TIME OF RECORD; the
#     scope may have been popped by flush time, so we hold the
#     index into a captured snapshot, not a live pointer.
#
# **For Prereq C, the queue is recorded but `flush_drop_queue` is
# a no-op** — actual `GIDropIfAlive` emission lands in COMMIT 3.
# This commit ships only the structural plumbing: the struct,
# the field on `LowerCtx`, the constructors initialising it, and
# the flush hook wired in at the post-wire_liveness sites.
struct DropEmission:
    int local_id
    int target_block
    int insert_at_inst_idx
    int dse_scope_idx
    int entry_idx

# Ok/Error payload GIR type ids extracted from a monomorphized
# `Result__<OkT>__<ErrT>` name. Mirrors the (TypeId, TypeId) tuple Rust
# returns from `extract_result_field_types` (`exprs/mod.rs:2845`).
struct ResultPayloadTypes:
    int ok_type
    int err_type

# Key/value GIR type NAMES split out of a monomorphized `Dict__K__V`
# name. Mirrors the (String, String) tuple Rust's `parse_dict_kv_types`
# returns (`stmts/for_loops.rs:949`). Same multi-value-return-as-struct
# idiom as `ResultPayloadTypes` above.
struct DictKvNames:
    String key_name
    String val_name

# closure Phase 2 Step A: the metadata `compute_closure_sig` derives for a
# closure make-site, packaged so the make-site and the post-pass compute
# identical signatures (a struct return rather than a 5-tuple, mirroring
# the `ResultPayloadTypes` idiom above). Stored verbatim into a
# `LiftedClosure` record; the post-pass passes these straight to
# `lower_closure_body` so it never re-derives the signature.
struct ClosureSig:
    Vector[int] abi_param_types      # full ABI vector [self_ptr, p0, p1, …]
    int self_ptr                     # env-ptr type id (*__Closure_<cid>)
    Vector[int] body_param_types     # the closure's OWN param types [p0, p1, …]
    Vector[String] body_param_names  # the closure's param names (implicit-it: ["it"])
    int return_type

# closure Phase 2 Step B: result of the make-site capture COLLECTOR+
# CLASSIFIER. `caps` is the ordered, deduped capture list (env-field /
# struct-ctor-arg / GIFieldLoad-index order). `unliftable` is the SAFETY
# net: set true if ANY capture-shaped free var is NOT a genuine outer
# local (unresolvable, or `self`) — the closure then STAYS STUBBED
# (exactly as Phase 1 would). `seen` dedups per-name records so a body
# referencing a capture twice (`base + base`) pushes `base` ONCE.
struct CaptureCollector:
    Vector[ClosureCapture] caps
    Dict[String, bool] seen
    bool unliftable

# ── #37 Phase 2 (lazy CoW, provenance-direct) ───────────────────────
#
# One lazy CoW family member: a String VALUE slot holding a cap=0
# `gorget_string_borrow_view` of a collection element, plus its
# materialized-flag bool slot. `root` is the source-collection root
# identifier name the family is keyed by (the flat named_locals name
# the mutation hooks re-find). `clone_fn` is the typed clone fn for the
# flag-guarded in-place materialize — the resource registry's DEEP-COPY
# `clone_to_owned` (resolve_payload_clone_fn), never `copy_cow` (which
# passes cap=0 views through unchanged) and never the registry's
# `materialize_fn` (whose PRESENCE is the eligibility discriminator
# only). `slot_type` is the owned value type. `stmt_scoped` marks a
# derivation-join TEMP (a view-returning method result that joined the
# family): it retires at the end of the enclosing statement
# (cow_lazy_retire_stmt_temps) so later mutation sites don't emit
# guards for a dead slot; named binds persist for the whole function.
struct LazyMember:
    String root
    int slot
    int flag
    int slot_type
    String clone_fn
    bool stmt_scoped

struct LowerCtx:
    Vector[GirLocal] locals
    Vector[Vector[Instruction]] block_insts
    Vector[Terminator] block_terms
    int current_block
    # Maps local-binding name → GIR local id.
    Dict[String, int] named_locals
    # Stack of (continue_target, break_target) bb ids for the enclosing
    # loops. break / continue inside a loop body jump to the innermost
    # pair. Pushed at loop entry, popped at exit. Parallel Vectors because
    # Gorget doesn't have easy tuple storage in fields.
    Vector[int] loop_continue_stack
    Vector[int] loop_break_stack
    # Element-type hint threaded from SVarDecl (`Vector[T] x = []`) down
    # into EArrayLiteral / EDictLiteral so the allocator call receives
    # sizeof(T) instead of a hardcoded 8. Empty string means "no hint —
    # caller didn't know the container's element type". Consumed (cleared)
    # as soon as the literal handler reads them.
    String pending_vec_elem_tyname
    String pending_dict_key_tyname
    String pending_dict_val_tyname
    bool pending_dict_ordered
    # Name of the function currently being lowered. Threaded for
    # diagnostic attribution — without this, the ~58k EIdentifier
    # unknown-identifier bug reports can't be tied back to specific
    # function bodies, which is what we need to figure out which
    # lowering paths fail to populate `named_locals`.
    String current_fn_name
    # Drop elaboration state: scope stack + per-scope drop entries.
    # Lifecycle: pushed at function entry (DSK_FUNCTION), per-loop
    # (DSK_LOOP) and per-branch (DSK_BLOCK); popped at corresponding
    # exits. Early-exit terminators (SReturn/SBreak/SContinue) walk
    # the stack innermost-out and emit drops along the way. See the
    # DropElaborator docstring for the architectural contract.
    DropElaborator drop_elab
    # Phase 2c COMMIT 3 Prereq C — deferred drop-emission queue.
    # `emit_scope_drops` / `emit_drops_for_early_exit` append a
    # `DropEmission` entry per pending drop instead of emitting
    # inline. After `wire_liveness_into_modes` populates
    # `maybe_moved`, `flush_drop_queue` walks the queue and emits
    # `GIDropIfAlive` for each entry gated on `not maybe_moved`.
    # See DropEmission docstring. For Prereq C, queue recording
    # ships but flush is a no-op; COMMIT 3 flips flush to real
    # emission.
    Vector[DropEmission] drop_queue
    # Expected-type propagation (mirrors Rust gg's
    # `LoweringContext.func_state.expected_type`). Set by writer sites
    # (SVarDecl, SAssign, SReturn, call-arg loop, struct field-init)
    # to the destination's declared type immediately BEFORE recursing
    # into `lower_expr`; restored to the saved value (`prev`) on
    # return. Reader sites — bare `Ok`/`Error`/`Some`/`None` constructor
    # calls in `lower_call`, the bare `None` literal in `lower_expr`,
    # `EIdentifier(name)` resolution — consult this field to resolve a
    # context-dependent type that the local expression shape cannot
    # determine alone (the variant name does not carry the parent enum's
    # full monomorphised name, etc.). `-1` is the sentinel for "no
    # expectation set". See `docs/plans/self_host_ssa_cleanup.md` §7.
    int expected_type
    # `on error:` cleanup blocks registered in the current function, in
    # source order. Mirrors Rust gg's
    # `LoweringContext.func_state.on_error_blocks`
    # (`src/ir/lowering/stmts/mod.rs:342`). `SOnError(body)` pushes the
    # body here; the error-exit paths (SThrow's Result.Error return, and
    # ERethrow's Error return) drain them in LIFO order via
    # `emit_on_error_cleanups` (mirrors Rust's `emit_on_error_cleanups`
    # at `stmts/mod.rs:357`, called from `lower_throw`/`lower_rethrow_expr`).
    # A bare push with no consumer would be dead code, so the consumer is
    # wired at both error-return sites.
    Vector[Vector[Stmt]] on_error_blocks
    # One-shot suppress flag for the centralized Result→T auto-propagation
    # hook (mirrors Rust gg's `func_state.suppress_auto_prop`,
    # `src/ir/lowering/context.rs:249` + `exprs/mod.rs:78`). Sites that need
    # the RAW `Result` operand even at a Call/MethodCall position — match
    # scrutinees whose arms discriminate `Ok`/`Error`/`Some`/`None`, `catch`
    # inner, `rethrow` inner — set this true immediately before calling
    # `lower_expr`. `lower_expr` consumes it (resets to false) at entry, so
    # nested sub-expressions still auto-prop normally. Default false.
    bool suppress_auto_prop
    # ── CoW resource-bind forward-scan (substrate ii) ────────────────
    # Coarse whole-function mutation set, computed once per function body
    # by `compute_cow_scan` BEFORE the statement-lowering loop runs. Maps
    # an identifier NAME → true iff that name is ever mutated anywhere in
    # the function body (reassigned via `=`/compound-assign, receiver of a
    # mutating method `push`/`set`/`insert`/…, target of `name[i] = x`, or
    # taken by `&`/`!`). Consumed by `decide_svardecl_emission`'s Branch
    # C-pre resource-bind flip: a `T x = coll.get(i).unwrap()` /
    # `T x = coll[i]` bind borrow-flips to a non-owning Ptr alias ONLY when
    # NEITHER the bound name x NOR the source-collection identifier coll
    # appears here. If either is mutated, the bind keeps the eager
    # deref+clone (CloneAndMove) — the sound default that makes the LOOP
    # case (cow_borrow_outlives_push) and the mutate-forward case
    # (index_ref_auto_clone) correct: the clone is hoisted to the bind site,
    # BEFORE any mutation. This is intentionally conservative (whole-fn, not
    # flow-sensitive position-aware): it over-clones (a mutation that only
    # happens BEFORE the bind still suppresses the flip) but NEVER
    # under-clones, so it can only be over-cautious, never unsound. Mirrors
    # the predicate behind Rust's `is_cow_unsafe_at`/`is_source_mut_unsafe_at`
    # (`src/ir/lowering/context.rs:1099`/`:1116`) collapsed to a whole-fn
    # set. Default: empty (computed per function in `lower_function` /
    # owning-param `lower_function` analog before the body loop).
    Dict[String, bool] cow_mutated_names
    # ── CoW tier-2 L1: position-aware mutation tracking ──────────────
    # For each mutated NAME, the LATEST (max over all mutation sites)
    # textual `span.start` at which it is mutated. Populated in the SAME
    # `compute_cow_scan` pass as `cow_mutated_names` (via the `cow_mark_*`
    # helpers, threading the mutating expression's `span.start`). The
    # `max` is LOAD-BEARING — an inner-loop mutation textually AFTER the
    # bind, or a back-edge mutation, must keep the name non-pristine; a
    # `min`/per-occurrence model would be unsound. Consumed by
    # `cow_pristine_after(name, bind_pos)`: a name is pristine-at-pos iff
    # it is never mutated OR its LAST mutation `span.start` is strictly
    # before `bind_pos`. This lets the Branch C-pre flip fire for the
    # read-then-dead / mut-before-bind cases (mutation only OUTSIDE the
    # alias's live window) while still refusing the mutate-while-live
    # case (tier-1's eager clone). See docs/devbook/11-copy-on-write.md
    # (the liveness gate) and `decide_svardecl_emission`.
    Dict[String, int] cow_mut_max_span
    # Property (d) — closure-deferred mutation (the soundness anchor). A
    # name mutated inside a closure BODY has a textual span that bears NO
    # relation to WHEN the closure runs (it can be invoked AFTER the
    # bind, reallocating the source while a flipped alias is still live →
    # UAF). So a closure-captured-mutated name is treated as NEVER
    # pristine: `cow_pristine_after` consults this set FIRST and returns
    # false. Populated in the `EClosure`/`EImplicitClosure` scan arms
    # (any mutation seen while scanning a closure body routes here, not
    # into the position-aware map). This keeps the closure case
    # position-AGNOSTIC, matching tier-1's whole-fn refusal — straight-
    # line / loop sources stay position-aware.
    Dict[String, bool] cow_closure_mutated
    # Scan-time DECLARED-type side channel: binding name → declared type
    # name, written by the CoW scan's SVarDecl walk + the param loop in
    # compute_cow_scan. The typechecker side table (tc_types.expr_types)
    # does NOT key bare-ident method receivers, so scan-time signature
    # resolution (`h.poke_vec(&v)` → the `Holder__poke_vec` borrow
    # flags) reads the declared type from here. A miss only UNDER-marks
    # (the flip gate sees fewer mutations) — the same pre-existing
    # scan-time blindness the parser typed-arg-ownership TODO retires.
    Dict[String, String] cow_decl_types
    # #37 Phase 2: the lazy CoW family — every live (slot, flag) pair
    # keyed by source-collection root name. Written by the SVarDecl
    # LazyViewBind arm and the returns_view derivation join; read by
    # the mutation-site hooks via cow_lazy_materialize_family. The
    # mutation-route class table lives at cow_lazy_emit_guard.
    Vector[LazyMember] cow_lazy_members
    # #37 Phase 2: source names consumed by an EMove (`!name`) at a
    # NON-call expression position (decl-init / assign-RHS / return /
    # literal element / match scrutinee — call args strip the sigil in
    # the parser). The EMove class executes at MULTIPLE lowering
    # positions with NO choke point (lower_expr's EMove arm is a
    # passthrough), so it is covered by ELIGIBILITY EXCLUSION rather
    # than a hook: a bind whose source collection is in this set is
    # never lazy-eligible (falls back to the eager clone). Whole-fn,
    # per-source-NAME granularity: one `!v` anywhere — even on a
    # never-taken branch — makes every bind from `v` in the fn eager.
    # Acceptable: the borrow checker independently rejects
    # conditional-move-then-use, so the practical loss window is
    # narrow (trade documented in devbook/11 §Phase 2).
    Dict[String, bool] cow_moved_names
    # ── Fault-catch scope (error-model.md §11) ───────────────────────
    # The active fault-catch handler blocks for the wrapped subtree of a
    # `(...) catch Fault.X:` expression. `Some(bb)` routes that fault
    # category to handler block `bb`; `None` = not caught (the op stays
    # panic-by-default). Pushed (save/restore) around ONLY the inner
    # subtree by `lower_fault_catch_expr`; a faultable arithmetic op in
    # `lower_expr`'s EBinaryOp gate consults the ACTIVE scope at its own
    # site. Fresh `None` at function entry — a callee's faults stay deep
    # (a separate `lower_function` pass = fresh ctx). Mirrors Rust gg's
    # `FunctionState.fault_scope` (`src/ir/lowering/context.rs`).
    Option[int] fault_overflow_handler
    Option[int] fault_divzero_handler
    # `Some(bb)` routes an out-of-bounds ARRAY index read (`xs[i]`) to handler
    # block `bb` (error-model.md §11 Increment 2 (A)); `None` = not caught (the
    # index read stays panic-by-default via `gorget_array_get`). Saved/restored
    # around ONLY the inner subtree by `lower_fault_catch_expr`, same as the two
    # arithmetic handlers above. The EIndex arm in `lower_expr` consults this to
    # route through the non-panicking `gorget_array_safe_get` + a NULL-branch.
    Option[int] fault_bounds_handler
    # True iff the function currently being lowered is a `throws` fn (its
    # declared `throws_type` is `Some`), so the return slot `_0` is the
    # SYNTHESIZED `Result[T, E]` one layer wider than the user's declared
    # success type `T`. Set at the two throws-computing LowerCtx sites
    # (`lower_function` / `lower_equip_block` in lower_closures.gg) when the
    # def's `throws_type` is `Some`; false at every other construction site
    # (closure-body, suite-body, test-body). Read by the SReturn arm's
    # Defect-B expected-type seeding: when `T` is itself a Result/Option, an
    # explicit `Ok(...)` / `Some(...)` tail builds the INNER `T`, so the
    # reader sites must resolve against `ok_type` (the inner T), NOT the full
    # outer slot. The gate is LOAD-BEARING: a plain (non-throws)
    # `Result[Option[int], String]` fn whose `return Ok(Some(42))` correctly
    # builds the FULL Result is structurally identical at the return site —
    # only this flag distinguishes the synthesized-slot reinterpretation from
    # the genuine outer-Result build (else `option_result_nested` regresses).
    # Mirrors Rust gg's `func_state.current_throws_result_type` being `Some`
    # (`src/ir/lowering/stmts/mod.rs:1641` `declared_t_is_enum_wrapper`).
    bool fn_is_throws
    # ── Async spawn/await dispatch (Inc-1) ───────────────────────────
    # Task BINDING local id → spawned producer fn name. Keyed by the
    # SVarDecl binding local (`var_local`), NOT the spawn dst: `Task[int] t
    # = spawn f()` mints a FRESH `var_local` for `t` in the MoveDirect arm,
    # and `t.await()` reads THAT local. Deposited at the SVarDecl site (the
    # MoveDirect arm consumes `pending_spawn_fn`), read by the EAwait arm to
    # resolve `__gorget_await_<fn>`. Mirrors Rust gg's
    # `ctx.spawn.result_locals` (`src/ir/lowering/context.rs`, deposited at
    # `stmts/mod.rs:502-505`, read at `exprs/mod.rs:1045`).
    Dict[int, String] result_locals
    # Task TYPE name (e.g. "Task__int64_t") → DISTINCT producer fn names.
    # The type-based await fallback for tasks not directly bound to a
    # binding local. A `len()==1` gate at await resolution makes it fire
    # ONLY when exactly one producer exists for that Task type — when two
    # fns produce the same Task[int] (coroutine_dict_set / option_result),
    # the gate correctly DOESN'T fire and the `result_locals` direct path
    # resolves each. Deduped at the write site. Mirrors Rust gg's
    # `ctx.spawn.task_type_fns: FxHashMap<TypeId, Vec<String>>` +
    # `register_task_type_fn` (`src/ir/lowering/context.rs:124,132-143`,
    # read at `exprs/mod.rs:1050-1057`).
    Dict[String, Vector[String]] task_type_fns
    # One-shot deposit marker: the producer fn name of the spawn currently
    # being lowered. Set by the `ESpawn` arm immediately before returning the
    # spawn dst; consumed (cleared) by the next SVarDecl that binds it. "" =
    # no pending spawn. Mirrors Rust gg's `ctx.spawn.pending_fn: Option<String>`
    # (set at `exprs/mod.rs:1391`, taken at `stmts/mod.rs:503`).
    String pending_spawn_fn
    # ── Shared-variable carrier table (round-16 Phase 1) ─────────────
    # NAME → SharedLocalInfo for every `shared int x = …` (shared_kind==1)
    # in the current function. Populated by the SVarDecl shared-var arm;
    # read by the EIdentifier read facade, the SAssign write facade, the
    # `with x:` arm, and the spawn-of-`&shared` deferral. Mirrors Rust gg's
    # `ctx.shared.locals` (`src/ir/lowering/context.rs:153`), keyed by name
    # here (the self-host's name-based resolution) rather than by LocalId.
    # Fresh empty per function (a separate lower_function = fresh ctx).
    Dict[String, SharedLocalInfo] shared_locals
    # One-shot "pass the raw carrier" flag (mirrors Rust gg's
    # `ctx.shared.pass_raw`, `context.rs`). The spawn-of-`&shared` site sets
    # this true around lowering the spawn args so a transparent shared-var
    # read resolves to the CARRIER handle (`OpCopy(hidden_local)`) instead of
    # the locked value — the worker must receive the carrier, not a snapshot.
    # Reset false immediately after the args are lowered.
    bool shared_pass_raw
    # Monotonic source-order counter for shared-var decl_order assignment.
    # Incremented per shared SVarDecl; the value is the SharedLocalInfo's
    # `decl_order` (ascending lock order in the spawn token wrapper).
    int shared_decl_counter
    # ── round-16 Phase-2 (async splice) accumulators ─────────────────
    # FLATTENED (binding_local, param_local) pairs recorded when a `with <&param>:`
    # binds a value read from a mutable-borrow param of THIS function. The
    # post-pass that builds `__shared_async_<f>` re-reads each binding from the
    # freshly-derived facade after every lock-reacquire (the freshness refresh).
    # Copied into the GirFunction at lower_function exit. Mirrors Rust gg's
    # `BuilderState.with_refresh_pairs` (`src/ir/builder.rs:17`).
    Vector[int] with_refresh_pairs
    # `spawn inner(&param)` calls inside this fn whose `&param` is a mutable-borrow
    # param (traces back to a shared carrier). Recorded by the inner-shared-spawn
    # arm of `lower_shared_spawn`; the post-pass rewrites them to the inner token
    # wrapper + forwards the carrier. Mirrors Rust gg's
    # `BuilderState.inner_shared_spawns` (`src/ir/builder.rs:19`).
    Vector[InnerSharedSpawn] inner_shared_spawns

# ── Helpers ──────────────────────────────────────────────

# named_locals helpers — kept as a thin layer over the Dict so we can
# swap the storage shape without touching call sites.
bool nl_contains(LowerCtx &ctx, String name):
    return ctx.named_locals.contains(name)

int nl_get(LowerCtx &ctx, String name):
    if ctx.named_locals.contains(name):
        return ctx.named_locals.get(name).unwrap()
    return -1

void nl_put(LowerCtx &ctx, String name, int val):
    ctx.named_locals.put(name.clone(), val)

# Snapshot / restore the name→local map. Mirrors Rust's
# `save_locals`/`restore_locals` (`context.rs:1481`/`:1518`): match arms are
# mutually-exclusive scopes, so a `case x:` binding (and a guarded arm's
# binding) must NOT leak into the next arm or the `else`. Without the restore,
# `match cmd: case "q": …; case cmd: …` rebinds `cmd` to a fresh by-value local
# that then shadows the parameter in the `else`/later arms — corrupting reads.
Dict[String, int] nl_snapshot(LowerCtx &ctx):
    return ctx.named_locals.clone()

void nl_restore(LowerCtx &ctx, Dict[String, int] snap):
    ctx.named_locals = snap.clone()

# Diagnostic helper for unhandled AST variants. Called from the
# `else: ...` fall-through arms in lower_stmt / lower_expr. The message
# is wrapped in a /* ... */ C comment so it embeds harmlessly in the
# stage-0 stdout → stage-1 C channel. After a stage-0 run,
# `grep '\[lower_fail\]' stage1.c` surfaces every silently-dropped
# variant encountered during compilation.
void lower_fail(String msg):
    print("/* [lower_fail] " + msg + " */")

# Diagnostics for silent-fallback sites. Earlier versions of the
# self-host made several dispatch functions (map_binop,
# infer_method_return_type, collection_element_type, type_id_to_name,
# EFieldAccess, EIdentifier) quietly return a sentinel value for any
# unrecognised input — hiding real bugs that compounded into runtime
# corruption. Every "hard bug" fallback now emits a `[bug]` diagnostic
# so the mis-compilation is visible in the produced output. Grep
# `\[bug\]` on stage-0/stage-1 output to surface them.
#
# Loud by default; if the diagnostic volume gets painful (stage-1 running
# on its own source emits ~58k diagnostics today because many function
# parameters aren't ending up in `named_locals` — a separate bug still
# under investigation), grep for the unique messages via
# `sort -u | uniq -c` and wrap compilation in `| grep -v '\\[bug\\]'` to
# mute the stream while still having the counts on demand.
void diag_bug(String site, String msg):
    print("/* [bug] " + site + ": " + msg + " */")

void diag_warn(String site, String msg):
    print("/* [warn] " + site + ": " + msg + " */")

# Return the variant name of a Stmt. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling.
# Return the variant name of an Expr. Used by lower_fail diagnostics to
# pinpoint which AST variant the self-host isn't handling. Mirrors
# `stmt_kind` for the Expr side.
String expr_kind(Expr e):
    match e:
        case EIntLiteral(_):
            return "EIntLiteral"
        case EFloatLiteral(_):
            return "EFloatLiteral"
        case EBoolLiteral(_):
            return "EBoolLiteral"
        case EStringLiteral(_, _):
            return "EStringLiteral"
        case ECharLiteral(_):
            return "ECharLiteral"
        case ENoneLiteral:
            return "ENoneLiteral"
        case EIdentifier(_):
            return "EIdentifier"
        case ESelfExpr:
            return "ESelfExpr"
        case EIt:
            return "EIt"
        case EBinaryOp(_, _, _):
            return "EBinaryOp"
        case EUnaryOp(_, _):
            return "EUnaryOp"
        case ECall(_, _, _, _):
            return "ECall"
        case EMethodCall(_, _, _, _, _):
            return "EMethodCall"
        case EFieldAccess(_, _):
            return "EFieldAccess"
        case EIndex(_, _):
            return "EIndex"
        case ERange(_, _, _):
            return "ERange"
        case EIf(_, _, _):
            return "EIf"
        case EMatch(_, _):
            return "EMatch"
        case EClosure(_, _):
            return "EClosure"
        case EImplicitClosure(_):
            return "EImplicitClosure"
        case EArrayLiteral(_):
            return "EArrayLiteral"
        case ETupleLiteral(_):
            return "ETupleLiteral"
        case EDictLiteral(_, _):
            return "EDictLiteral"
        case EStructLiteral(_, _, _):
            return "EStructLiteral"
        case EDotShorthand(_, _):
            return "EDotShorthand"
        case ETry(_):
            return "ETry"
        case EMove(_):
            return "EMove"
        case EMutableBorrow(_):
            return "EMutableBorrow"
        case EDeref(_):
            return "EDeref"
        case EAs(_, _):
            return "EAs"
        case EBlock(_):
            return "EBlock"
        case EListComp(_, _, _, _):
            return "EListComp"
        case ESetComp(_, _, _, _):
            return "ESetComp"
        case EDictComp(_, _, _, _, _):
            return "EDictComp"
        case EDefaultOp(_, _):
            return "EDefaultOp"
        case EIs(_, _, _):
            return "EIs"
        case EDo(_):
            return "EDo"
        case EAwait(_):
            return "EAwait"
        case ESpawn(_):
            return "ESpawn"
        case ESpawnBlocking(_):
            return "ESpawnBlocking"
        case EFaultCatch(_, _, _):
            return "EFaultCatch"
        else:
            return "?unknown_expr?"

String pat_kind(Pattern p):
    match p:
        case PWildcard:
            return "PWildcard"
        case PBinding(_):
            return "PBinding"
        case PLiteral(_):
            return "PLiteral"
        case PConstructor(_, _):
            return "PConstructor"
        case PDotShorthand(_, _):
            return "PDotShorthand"
        case PTuple(_):
            return "PTuple"
        case POr(_):
            return "POr"
        case PRest:
            return "PRest"
        else:
            return "?unknown_pat?"

String stmt_kind(Stmt s):
    match s:
        case SVarDecl(_, _, _, _, _, _):
            return "SVarDecl"
        case SAssign(_, _):
            return "SAssign"
        case SCompoundAssign(_, _, _):
            return "SCompoundAssign"
        case SExpr(_):
            return "SExpr"
        case SReturn(_):
            return "SReturn"
        case SThrow(_):
            return "SThrow"
        case SBreak(_):
            return "SBreak"
        case SContinue:
            return "SContinue"
        case SPass:
            return "SPass"
        case SMeta:
            return "SMeta"
        case SMetaConst(_, _):
            return "SMetaConst"
        case SMetaFor(_, _, _):
            return "SMetaFor"
        case SMetaIf(_, _, _):
            return "SMetaIf"
        case SFor(_, _, _, _, _):
            return "SFor"
        case SWhile(_, _, _):
            return "SWhile"
        case SLoop(_):
            return "SLoop"
        case SIf(_, _, _):
            return "SIf"
        case SMatch(_, _):
            return "SMatch"
        case SMetaForMatch(_, _, _):
            return "SMetaForMatch"
        case SMetaMatch(_, _, _):
            return "SMetaMatch"
        case SMetaWhile(_, _):
            return "SMetaWhile"
        case SWith(_, _, _):
            return "SWith"
        case SAssert(_, _):
            return "SAssert"
        case SAssertReturn(_, _):
            return "SAssertReturn"
        case SNamedScope(_, _):
            return "SNamedScope"
        case SSelect(_):
            return "SSelect"
        case SOnError(_):
            return "SOnError"
        case SItem(_):
            return "SItem"
        case SSnapshot(_, _, _):
            return "SSnapshot"
    return "?unknown_stmt?"

int add_local(LowerCtx &ctx, int type_id, Option[String] name):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, LoOwned(), BoNone(), false))
    return id

# Phase D step 2: same as `add_local` but with explicit ownership / borrow
# origin. Use when the local's ownership state is something other than the
# default LoOwned/BoNone — e.g. function parameters (LoParam/BoParam),
# locals bound to collection-getter results (LoBorrowed/BoCollectionElement),
# CoW view results (LoView/BoRuntimeView). Validators in Phase C read
# these fields to decide whether a consume site needs a clone, a move,
# or a borrow. See `docs/devbook/26-self-host-frontend.md` §4.
int add_local_with(LowerCtx &ctx, int type_id, Option[String] name, LocalOwnership ownership, BorrowOrigin borrow_origin):
    int id = ctx.locals.len()
    ctx.locals.push(GirLocal(type_id, name, ownership, borrow_origin, false))
    return id

# round-16 Phase-2: is `local` a mutable-borrow PARAMETER (`int &counter` →
# LoParam + GtMutPtr)? Typed predicate (Layering rule 2) — reads the local's
# ownership tag + GIR type, never a name. Used by the SWith with-refresh
# recorder to detect a `with <&param>:` block.
bool is_mut_borrow_param_local(LowerCtx &ctx, GirModule &gmod, int local):
    if local < 0 or local >= ctx.locals.len():
        return false
    GirLocal gl = ctx.locals.get(local).unwrap()
    bool is_param = false
    match gl.ownership:
        case LoParam():
            is_param = true
        else:
            pass
    if not is_param:
        return false
    match gmod.type_table.get(gl.type_id).unwrap():
        case GtMutPtr(_):
            return true
        else:
            return false

# ── R36-B: CoW G1/G1a decide-at-root materialize for a PROJECTED mutation
# whose root is a bare (immutable-in-context) by-value param. Clones the whole
# root collection/struct into a fresh owned local and rebinds the name so the
# projected mutation (`v[i]=x`, `v[i].f=x`, `o.inner.f=x`, `s.field.push()`)
# lands on the private copy — the caller's buffer is untouched. A `&`/`!`
# mut-borrow root (GtMutPtr, caught by is_mut_borrow_param_local) or an owned
# local root (LoOwned != LoParam) is SKIPPED (writes through, unchanged).
# Mirrors Rust cow_before_mutation on the projection root (assigns.rs:601 /
# methods.rs:1851). Returns true if it materialized. After the rebind, the
# root local is LoOwned, so a second call in the same statement finds a
# non-param and returns false (no double-clone) — idempotent per root.
bool cow_materialize_projected_root(LowerCtx &ctx, GirModule &gmod, SpannedExpr target):
    String root = cow_source_root_name(target)
    if root == "":
        return false
    if not nl_contains(&ctx, root):
        return false
    int root_local = nl_get(&ctx, root)
    bool is_param = false
    match ctx.locals.get(root_local).unwrap().ownership:
        case LoParam():
            is_param = true
        else:
            pass
    if not is_param:
        return false
    if is_mut_borrow_param_local(&ctx, &gmod, root_local):
        return false
    int root_tid = ctx.locals.get(root_local).unwrap().type_id
    int struct_tid = peel_ptr_tid(&gmod, root_tid)
    String tname = type_id_to_name(struct_tid, &gmod)
    String clone_fn = resolve_payload_clone_fn(tname, &gmod)
    if clone_fn == "":
        return false
    int mat = add_local(&ctx, struct_tid, None)
    Vector[Operand] cargs = [OpBorrow(root_local)]
    emit(&ctx, GICallExtern(mat, clone_fn, cargs))
    nl_put(&ctx, root, mat)
    register_local_for_drop(&ctx, mat, struct_tid, &gmod)
    return true

# Phase 3 (2026-05-22) — Class 8 keystone fix.
#
# Allocate a fresh local that BINDS to an existing source local: if `src`
# is itself a borrow (LoBorrowed) or a view (LoView) into someone else's
# heap, the fresh dst MUST inherit that ownership tag — otherwise the
# downstream `GIAssign(dst, op_consume(src, ...))` byte-copies the alias
# into an LoOwned slot, which COMMIT 3 / Phase 2.3 then treats as a real
# owner and either double-frees (drop-at-scope-exit) or clones a borrowed-
# interior pointer (crash inside the clone).
#
# Mirrors the SVarDecl Prereq B carve-out at line ~4842 — single source of
# truth at the writer site. Every intermediate-temp binding that the
# lowerer emits as `add_local + GIAssign(dst, op_consume(src, kind))`
# routes through here so the LoBorrowed/LoView tag propagates through the
# chain. Sites that consciously want a FRESH-OWNED binding (e.g., an
# explicit `.clone()`) keep using `add_local` and don't go through this
# helper — the inheritance only fires when the source itself is a borrow.
#
# Caller contract: the returned local is meant to be assigned via
# `GIAssign(dst, op_consume(src, kind))` (or an equivalent) immediately
# after the call. Consumers that later mutate the dst (e.g., a SVarDecl
# rebinding the local on later reassignment) are responsible for the
# usual ownership updates — the helper only sets the INITIAL tag.
#
# See `docs/devbook/11-copy-on-write.md` (materialisation points) and
# `CLAUDE.md` "Layering discipline — debugging heuristic":
# the bug at every chain link was missing inheritance at the WRITER
# site; fixing it at the reader (op_consume) requires per-call
# heuristics, while fixing it at the writer is a one-liner.
int add_local_inheriting(LowerCtx &ctx, int type_id, Option[String] name, int src):
    GirLocal src_loc = ctx.locals.get(src).unwrap()
    match src_loc.ownership:
        case LoBorrowed():
            return add_local_with(&ctx, type_id, name, LoBorrowed(), src_loc.borrow_origin)
        case LoView():
            return add_local_with(&ctx, type_id, name, LoView(), src_loc.borrow_origin)
        else:
            return add_local(&ctx, type_id, name)

# String methods that return a non-owning VIEW (cap==0) aliasing the
# receiver's buffer are now declared in STRING_BUILTIN_METHODS
# (compiler/data/resources.gg) via the `returns_view` column, mirroring
# Rust's `returns_view: true` builtins (`src/ir/lowering/builtins.rs`
# GorgetString block). The runtime helpers (`gorget_str_slice`/`_trim`/
# `_strip`/...) all return `gorget_str_view_region` into `self.data`, so
# the result local MUST be tagged LoView at the consume site (below) — see
# the LoView tagging comment there for the dangling-alias corruption this
# prevents. Read via `string_builtin_method(mname).returns_view`.

# Collection kind of a (possibly mangled) receiver type name, or
# CkNotCollection if `tname` isn't a known resource collection.
# Thin wrapper over `resource_meta_for` so callers can read the kind
# without each re-matching the Option (single source of truth: the
# lazy cascade in lir_lower.gg).
CollectionKind collection_kind_of(GirModule &gmod, String tname):
    match resource_meta_for(&gmod, tname):
        case Some(rm):
            return rm.collection_kind
        case None:
            return CkNotCollection()

# Per CLAUDE.md "Ownership at Consuming Positions": a collection mutator
# takes OWNERSHIP of the value it stores (and, for Dict, the key). The
# per-(kind, method, index) owning-arg truth that used to live in a
# `is_owning_mutator_arg` name+index match is now DATA in
# COLLECTION_BUILTIN_METHODS (compiler/data/resources.gg), keyed by the
# RESOLVED CollectionKind and read at the consume site via
# `collection_builtin_method(kind, mname).owning_arg_positions`.
#
# Reference: Rust's `consuming_positions`
# (`src/ir/lowering/exprs/methods.rs:1850`) is name-keyed (push/add/… →
# [0]; put/set/insert → [0,1]) and gated only by excluding GorgetString
# string-builders — Rust can be name-only because it consumes BOTH
# put/set/insert positions and the index arg is a primitive (so
# `ensure_owned_at_consuming_arg` is a no-op there). The self-host stays
# KIND-AWARE because the kind disambiguates `set` = (idx,value) on a
# Vector vs (key,value) on a Dict, and `insert` = (idx,value) on a Vector
# vs (value) on a Set; the resolved kind is also the safety boundary
# against hijacking a user method that happens to share a name. Aligns
# with the runtime by-pointer-into-storage args in lir_lower.gg's
# `needs_ptr_arg` (gorget_array_push@1, _set@2, _insert@2,
# gorget_map_put@1&2, gorget_set_add@1).

# Typed-table accessors over STRING_BUILTIN_METHODS / COLLECTION_BUILTIN_METHODS
# (compiler.data.resources) — mirror lir_lower.gg's `lookup_resource_table`
# reading RESOURCES. They replace the three raw name-match lists with a
# single typed source of truth; consumers read the typed columns
# (returns_view / owning_arg_positions / ret_kind) off the returned decl.

# Variant-to-variant CollectionKind equality (no derived `==`; pure match
# over two real enums — never an int code). Used to key the collection
# builtin table by the RESOLVED receiver kind.
bool collection_kind_eq(CollectionKind a, CollectionKind b):
    match a:
        case CkVector():
            match b:
                case CkVector():
                    return true
                else:
                    return false
        case CkDeque():
            match b:
                case CkDeque():
                    return true
                else:
                    return false
        case CkHeap():
            match b:
                case CkHeap():
                    return true
                else:
                    return false
        case CkDict():
            match b:
                case CkDict():
                    return true
                else:
                    return false
        case CkOrderedSet():
            match b:
                case CkOrderedSet():
                    return true
                else:
                    return false
        case CkHashSet():
            match b:
                case CkHashSet():
                    return true
                else:
                    return false
        case CkNotCollection():
            match b:
                case CkNotCollection():
                    return true
                else:
                    return false

# True iff `x` is a member of `v`. Explicit loop (not the `in` operator)
# so the self-host lowerer's own bootstrap doesn't depend on `in`-membership
# lowering for a Vector[int].
bool int_vec_contains(Vector[int] v, int x):
    for e in v:
        if e == x:
            return true
    return false

# Look up a String builtin method by name. Returns the typed decl (carrying
# the independent returns_view + ret_kind columns) or None for non-String
# builtins. Consult under the existing String-receiver gate at the call site.
Option[BuiltinMethodDecl] string_builtin_method(String mname):
    for d in STRING_BUILTIN_METHODS:
        if d.name == mname:
            return Some(d.clone())
    return None

# Look up a collection mutator declaration by RESOLVED CollectionKind +
# method name. Returns the typed decl (carrying owning_arg_positions) or
# None. The kind must come from the resource table (collection_kind_of),
# never from a re-listed receiver type-name alias.
Option[BuiltinMethodDecl] collection_builtin_method(CollectionKind kind, String mname):
    for entry in COLLECTION_BUILTIN_METHODS:
        if collection_kind_eq(entry.collection_kind, kind):
            for d in entry.methods:
                if d.name == mname:
                    return Some(d.clone())
    return None

# Look up a builtin method's `is_mutating` truth in the flat
# BUILTIN_METHOD_MUTATES table. Returns the typed decl (its `is_mutating`
# column is the answer) or None when the name is NOT a known builtin —
# the caller treats a None as "not a classified builtin" and routes to
# the user-method path (or the conservative mutating default). This is
# the typed replacement for the proto's `cow_is_mutating_method` /
# `cow_is_readonly_method` hand name-lists (CLAUDE.md "No name matching").
Option[BuiltinMethodDecl] builtin_method_mutates(String mname):
    for d in BUILTIN_METHOD_MUTATES:
        if d.name == mname:
            return Some(d.clone())
    return None

# ── method_mutates_receiver — the ONE typed mutation accessor ────────
#
# Does the call `recv.mname(...)` mutate its receiver in place? Drives
# the CoW resource-bind forward-scan (cow_scan_expr). TYPED, never a
# name list:
#   1. USER methods — a method mutates its receiver iff the callee takes
#      `self` by `&self` (ownership==1, mutable borrow) or `!self`
#      (ownership==2, move). That truth lives in `fn_borrow_params` /
#      `fn_move_params` (gir.gg:423/432), populated from `p.ownership`
#      in the module pre-pass (lower.gg:13844). Resolve the receiver TYPE
#      via the typecheck side-table (`lookup_expr_gir_type` →
#      `type_id_to_name`), form the equip-method key `Type__mname` (the
#      SAME short key the populate pass writes, lower.gg:13889), and read
#      param index 0 (self). ANY `&self`/`!self` ⇒ may mutate (a
#      read-only `&self` over-clones but is SAFE).
#   2. BUILTIN methods — read the typed `is_mutating` column from
#      BUILTIN_METHOD_MUTATES (mirrors Rust's `is_mutating`,
#      src/ir/lowering/builtins.rs).
#   3. CONSERVATIVE DEFAULT — a name that is NEITHER a registered user
#      method on the resolved receiver type NOR in the builtin table is
#      treated as MUTATING. Over-clones (suppresses the borrow-flip),
#      never UAFs. (The `fill` bug direction — absent⇒read-only — is the
#      unsound one and is NOT used.)
#
# The user path is tried FIRST: a user type may legitimately name a
# method `get`/`map`/… that takes `&self` and mutates; its typed
# self-convention is authoritative over the builtin name table.
bool method_mutates_receiver(SpannedExpr recv, String mname, GirModule &gmod):
    # (1) USER method: resolve receiver type → equip-method key.
    int recv_tid = lookup_expr_gir_type(recv, &gmod)
    if recv_tid >= 0:
        String recv_tname = type_id_to_name(recv_tid, &gmod)
        if recv_tname.len() > 0:
            String mkey = recv_tname + "__" + mname
            if gmod.fn_borrow_params.contains(mkey):
                Vector[bool] bflags = gmod.fn_borrow_params.get(mkey).unwrap()
                Vector[bool] mflags_u = []
                if gmod.fn_move_params.contains(mkey):
                    mflags_u = gmod.fn_move_params.get(mkey).unwrap()
                bool self_mut = false
                if bflags.len() > 0 and bflags.get(0).unwrap():
                    self_mut = true
                if mflags_u.len() > 0 and mflags_u.get(0).unwrap():
                    self_mut = true
                return self_mut
    # (2) BUILTIN method: typed is_mutating column.
    match builtin_method_mutates(mname):
        case Some(bdecl):
            return bdecl.is_mutating
        case None:
            pass
    # (3) CONSERVATIVE DEFAULT: unknown ⇒ assume mutating (safe over-clone).
    return true

# ══ R38 — `&self` MUTATION-INFERENCE pass ════════════════════════════
#
# Classify each equip method (keyed `Type__mname`) as READ-ONLY vs
# actually-WRITES-self, so the named-receiver CoW-materialize gate fires
# ONLY for genuine mutators (a full `&self`⇒mutating over-approx is a
# ~12GB clone bomb — read-only getters/`.clone()` flood the hot loops).
#
# direct_mut(m) = body has (a) an assign/compound whose target ROOT is
#   `self`, OR (b) self / a self-projection passed to a `&`/`!` callee
#   param, OR (c) a mutating BUILTIN method called on self / a
#   self-projection, OR (d) an unknown user method on an UNRESOLVABLE
#   self-projection (conservative leaf). self-calls to KNOWN user methods
#   are collected as callee EDGES and resolved by the fixpoint.
# mutates_self(m) = direct_mut(m) OR any(mutates_self(c) for c in callees).
# Fixpoint grows monotonically (mirror of the resource_types loop) → sound.

# Is `key` (Type__mname) a user method that takes `&self`/`!self` at
# param 0? (Only such methods can mutate the caller's receiver.) Reads the
# self-convention from the typed fn_borrow_params / fn_move_params maps.
bool mutinf_takes_mut_self(GirModule &gmod, String key):
    if gmod.fn_borrow_params.contains(key):
        Vector[bool] bf = gmod.fn_borrow_params.get(key).unwrap()
        if bf.len() > 0 and bf.get(0).unwrap():
            return true
    if gmod.fn_move_params.contains(key):
        Vector[bool] mf = gmod.fn_move_params.get(key).unwrap()
        if mf.len() > 0 and mf.get(0).unwrap():
            return true
    return false

# Does callee `Type__mname` let its `arg_idx`-th (self-excluded) arg be
# mutated (declared `&`/`!`)? Ctx-free sibling of method_arg_lets_callee_mutate.
bool mutinf_method_arg_mut(GirModule &gmod, String mkey, int arg_idx):
    return call_arg_lets_callee_mutate(&gmod, mkey, arg_idx + 1)

# Is `e` a projection path rooted at the method's `self` receiver
# (`self`, `self.f`, `self.f[i]`, `*self`, `self.m()`)? `self` is the
# distinct `ESelfExpr` AST node (NOT `EIdentifier("self")`), so
# cow_source_root_name — which only knows EIdentifier roots — returns ""
# for it; this walker recognises ESelfExpr as the root.
bool mutinf_expr_is_self_rooted(SpannedExpr e):
    match e.expr:
        case ESelfExpr():
            return true
        case EFieldAccess(base, _):
            return mutinf_expr_is_self_rooted(*base)
        case EIndex(base, _):
            return mutinf_expr_is_self_rooted(*base)
        case EDeref(inner):
            return mutinf_expr_is_self_rooted(*inner)
        case EMethodCall(recv, _, _, _, _):
            return mutinf_expr_is_self_rooted(*recv)
        case ETry(inner):
            return mutinf_expr_is_self_rooted(*inner)
        case EIdentifier(idn):
            return idn == "self"
        else:
            return false

# Recursive expression scan. Returns true if a DIRECT self-mutation is
# found in `e`; appends KNOWN user self-method callees to `callees`.
bool mutinf_scan_expr(SpannedExpr e, String target, GirModule &gmod, Vector[String] &callees):
    bool m = false
    match e.expr:
        case EMethodCall(recv_box, mname, margs, _, _):
            if mutinf_expr_is_self_rooted(*recv_box):
                # Receiver is self or a self-projection. Classify in the
                # user→builtin→leaf order that MIRRORS method_mutates_receiver
                # (lower.gg:~1003): a known non-generic USER method wins FIRST
                # (this closes the name-collision shape when the receiver type
                # resolves — a user `&self`-mutator named like a read-only
                # builtin is found here before the builtin table), the
                # name-based BUILTIN table is NEXT (reachable even when the type
                # is UNRESOLVED — the hot read-only-getter `self.items.len()`
                # case), and a conservative `true` leaf is LAST.
                #
                # STEP 1: known non-generic USER method — resolve receiver type.
                String rtn = ""
                match (*recv_box).expr:
                    case ESelfExpr():
                        rtn = target
                    else:
                        int rtid = lookup_expr_gir_type(*recv_box, &gmod)
                        if rtid >= 0:
                            rtn = type_id_to_name(rtid, &gmod)
                bool classified = false
                if rtn.len() > 0:
                    String ckey = rtn + "__" + mname
                    if gmod.fn_borrow_params.contains(ckey):
                        # CALLEE EDGE — let the fixpoint resolve &self mutation
                        # transitively. UNCONDITIONAL .contains→edge push: a
                        # bare-self user method never enters method_mutates_self's
                        # mutating set, so its edge is INERT (a copy can't write
                        # through) → correctly read-only. Do NOT read
                        # method_mutates_self here (it is being computed —
                        # reading it collapses transitivity).
                        callees.push(ckey)
                        classified = true
                # STEP 2: known BUILTIN — name-based, TYPE-INDEPENDENT, so it
                # is reachable when the receiver type is UNRESOLVED (the hot
                # read-only getter `int size(&self): return self.items.len()`
                # has `self.items`→-1 at scan time; step 1 fails; this yields
                # `len → is_mutating=false` → NOT mutating; an "unresolved ⇒
                # true" leaf here would re-bomb every `x.size()`).
                if not classified:
                    match builtin_method_mutates(mname):
                        case Some(bd):
                            if bd.is_mutating:
                                m = true
                            classified = true
                        case None:
                            pass
                # STEP 3: conservative leaf — neither a resolved-type user
                # method in fn_borrow_params NOR any builtin ⇒ assume mutating
                # (a generic-equip instance, or an unknown user method on an
                # unresolvable self-projection). Read-only builtins were caught
                # by step 2, so this does NOT re-bomb the hot getters.
                if not classified:
                    m = true
            # self / self-projection passed to a `&`/`!` method arg.
            String rtn2 = ""
            match (*recv_box).expr:
                case ESelfExpr():
                    rtn2 = target
                else:
                    int rtid2 = lookup_expr_gir_type(*recv_box, &gmod)
                    if rtid2 >= 0:
                        rtn2 = type_id_to_name(rtid2, &gmod)
            int mai = 0
            for ma in margs:
                if mutinf_expr_is_self_rooted(ma):
                    if rtn2.len() > 0 and mutinf_method_arg_mut(&gmod, rtn2 + "__" + mname, mai):
                        m = true
                if mutinf_scan_expr(ma, target, &gmod, &callees):
                    m = true
                mai += 1
            if mutinf_scan_expr(*recv_box, target, &gmod, &callees):
                m = true
        case ECall(callee_box, cargs, _, _):
            String fname = ""
            match (*callee_box).expr:
                case EIdentifier(fid):
                    fname = fid
                    if gmod.call_redirects.contains(fname):
                        fname = gmod.call_redirects.get(fname).unwrap()
                else:
                    pass
            int cai = 0
            for ca in cargs:
                if fname.len() > 0 and mutinf_expr_is_self_rooted(ca):
                    if call_arg_lets_callee_mutate(&gmod, fname, cai):
                        m = true
                if mutinf_scan_expr(ca, target, &gmod, &callees):
                    m = true
                cai += 1
            if mutinf_scan_expr(*callee_box, target, &gmod, &callees):
                m = true
        case EMutableBorrow(inner_box):
            # `&self` / `&self.field` formed for a mutating position.
            if mutinf_expr_is_self_rooted(*inner_box):
                m = true
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees):
                m = true
        case EMove(inner_box):
            if mutinf_expr_is_self_rooted(*inner_box):
                m = true
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees):
                m = true
        case EBinaryOp(lhs_box, _, rhs_box):
            if mutinf_scan_expr(*lhs_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*rhs_box, target, &gmod, &callees): m = true
        case EUnaryOp(_, inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case EFieldAccess(base_box, _):
            if mutinf_scan_expr(*base_box, target, &gmod, &callees): m = true
        case EIndex(base_box, idx_box):
            if mutinf_scan_expr(*base_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*idx_box, target, &gmod, &callees): m = true
        case EDeref(inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case EAs(inner_box, _):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case ETry(inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case EAwait(inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case ESpawn(inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case ESpawnBlocking(inner_box):
            if mutinf_scan_expr(*inner_box, target, &gmod, &callees): m = true
        case EArrayLiteral(elems):
            for el in elems:
                if mutinf_scan_expr(el, target, &gmod, &callees): m = true
        case ETupleLiteral(elems_t):
            for elt in elems_t:
                if mutinf_scan_expr(elt, target, &gmod, &callees): m = true
        case EDictLiteral(keys_d, vals_d):
            for kd in keys_d:
                if mutinf_scan_expr(kd, target, &gmod, &callees): m = true
            for vd in vals_d:
                if mutinf_scan_expr(vd, target, &gmod, &callees): m = true
        case EStructLiteral(_, _, fields_s):
            for fs in fields_s:
                if mutinf_scan_expr(fs, target, &gmod, &callees): m = true
        case EFString(_, parts_f, _):
            for pf in parts_f:
                if mutinf_scan_expr(pf, target, &gmod, &callees): m = true
        case EIf(cond_box, then_b, elses):
            if mutinf_scan_expr(*cond_box, target, &gmod, &callees): m = true
            if mutinf_scan_stmts(then_b, target, &gmod, &callees): m = true
            for eb in elses:
                if mutinf_scan_stmts(eb.body, target, &gmod, &callees): m = true
        case EMatch(scrut_box, arms):
            if mutinf_scan_expr(*scrut_box, target, &gmod, &callees): m = true
            for arm in arms:
                match arm.guard:
                    case Some(ge):
                        if mutinf_scan_expr(ge, target, &gmod, &callees): m = true
                    case None:
                        pass
                if mutinf_scan_stmts(arm.body, target, &gmod, &callees): m = true
        case EBlock(blk_stmts):
            if mutinf_scan_stmts(blk_stmts, target, &gmod, &callees): m = true
        case EDo(do_stmts):
            if mutinf_scan_stmts(do_stmts, target, &gmod, &callees): m = true
        case EClosure(_, clo_body):
            # A closure body that writes self also mutates self (deferred).
            if mutinf_scan_stmts(clo_body, target, &gmod, &callees): m = true
        case EImplicitClosure(ic_box):
            if mutinf_scan_expr(*ic_box, target, &gmod, &callees): m = true
        case EDefaultOp(lhs_box, rhs_box):
            if mutinf_scan_expr(*lhs_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*rhs_box, target, &gmod, &callees): m = true
        case EListComp(elem_box, _, iter_box, opt_filt):
            if mutinf_scan_expr(*elem_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*iter_box, target, &gmod, &callees): m = true
            match opt_filt:
                case Some(fb):
                    if mutinf_scan_expr(*fb, target, &gmod, &callees): m = true
                case None:
                    pass
        case ESetComp(selem_box, _, siter_box, sfilt_opt):
            if mutinf_scan_expr(*selem_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*siter_box, target, &gmod, &callees): m = true
            match sfilt_opt:
                case Some(sfb):
                    if mutinf_scan_expr(*sfb, target, &gmod, &callees): m = true
                case None:
                    pass
        case EDictComp(dk_box, dv_box, _, diter_box, dfilt_opt):
            if mutinf_scan_expr(*dk_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*dv_box, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*diter_box, target, &gmod, &callees): m = true
            match dfilt_opt:
                case Some(dfb):
                    if mutinf_scan_expr(*dfb, target, &gmod, &callees): m = true
                case None:
                    pass
        case ERethrow(re_inner, _, _, re_handler):
            if mutinf_scan_expr(*re_inner, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*re_handler, target, &gmod, &callees): m = true
        case ECatch(ce_inner, _, ce_handler):
            if mutinf_scan_expr(*ce_inner, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*ce_handler, target, &gmod, &callees): m = true
        case EFaultCatch(fc_inner, _, fc_handler):
            if mutinf_scan_expr(*fc_inner, target, &gmod, &callees): m = true
            if mutinf_scan_expr(*fc_handler, target, &gmod, &callees): m = true
        case ERange(rlo_opt, rhi_opt, _):
            match rlo_opt:
                case Some(rlo):
                    if mutinf_scan_expr(*rlo, target, &gmod, &callees): m = true
                case None:
                    pass
            match rhi_opt:
                case Some(rhi):
                    if mutinf_scan_expr(*rhi, target, &gmod, &callees): m = true
                case None:
                    pass
        case EIs(is_inner, _, _):
            if mutinf_scan_expr(*is_inner, target, &gmod, &callees): m = true
        case EDotShorthand(_, ds_args):
            for da in ds_args:
                if mutinf_scan_expr(da, target, &gmod, &callees): m = true
        else:
            pass
    return m

# Statement-list scan (mirrors cow_scan_stmts control-flow coverage).
bool mutinf_scan_stmts(Vector[Stmt] stmts, String target, GirModule &gmod, Vector[String] &callees):
    bool m = false
    for st in stmts:
        match st:
            case SVarDecl(_, _, init_e, _, _, _):
                if mutinf_scan_expr(init_e, target, &gmod, &callees): m = true
            case SAssign(lhs_e, rhs_e):
                if mutinf_expr_is_self_rooted(lhs_e):
                    m = true
                if mutinf_scan_expr(lhs_e, target, &gmod, &callees): m = true
                if mutinf_scan_expr(rhs_e, target, &gmod, &callees): m = true
            case SCompoundAssign(lhs_e, _, rhs_e):
                if mutinf_expr_is_self_rooted(lhs_e):
                    m = true
                if mutinf_scan_expr(lhs_e, target, &gmod, &callees): m = true
                if mutinf_scan_expr(rhs_e, target, &gmod, &callees): m = true
            case SExpr(ex):
                if mutinf_scan_expr(ex, target, &gmod, &callees): m = true
            case SReturn(opt_e):
                match opt_e:
                    case Some(re):
                        if mutinf_scan_expr(re, target, &gmod, &callees): m = true
                    case None:
                        pass
            case SThrow(te):
                if mutinf_scan_expr(te, target, &gmod, &callees): m = true
            case SBreak(opt_be):
                match opt_be:
                    case Some(be):
                        if mutinf_scan_expr(be, target, &gmod, &callees): m = true
                    case None:
                        pass
            case SWhile(cond_e, body_w, else_w):
                if mutinf_scan_expr(cond_e, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(body_w, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(else_w, target, &gmod, &callees): m = true
            case SLoop(body_l):
                if mutinf_scan_stmts(body_l, target, &gmod, &callees): m = true
            case SFor(_, iter_e, body_f, _, else_f):
                if mutinf_scan_expr(iter_e, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(body_f, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(else_f, target, &gmod, &callees): m = true
            case SIf(cond_if, then_if, elses_if):
                if mutinf_scan_expr(cond_if, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(then_if, target, &gmod, &callees): m = true
                for eb_if in elses_if:
                    if mutinf_scan_stmts(eb_if.body, target, &gmod, &callees): m = true
            case SMatch(scrut_if, arms_if):
                if mutinf_scan_expr(scrut_if, target, &gmod, &callees): m = true
                for arm_if in arms_if:
                    match arm_if.guard:
                        case Some(gif):
                            if mutinf_scan_expr(gif, target, &gmod, &callees): m = true
                        case None:
                            pass
                    if mutinf_scan_stmts(arm_if.body, target, &gmod, &callees): m = true
            case SWith(with_e, _, body_with):
                if mutinf_scan_expr(with_e, target, &gmod, &callees): m = true
                if mutinf_scan_stmts(body_with, target, &gmod, &callees): m = true
            case SNamedScope(_, body_ns):
                if mutinf_scan_stmts(body_ns, target, &gmod, &callees): m = true
            case SOnError(body_oe):
                if mutinf_scan_stmts(body_oe, target, &gmod, &callees): m = true
            case SAssert(ae, _):
                if mutinf_scan_expr(ae, target, &gmod, &callees): m = true
            case SAssertReturn(are, _):
                if mutinf_scan_expr(are, target, &gmod, &callees): m = true
            case SSnapshot(_, _, se):
                if mutinf_scan_expr(se, target, &gmod, &callees): m = true
            case SSelect(sel_arms):
                for sel_arm in sel_arms:
                    match sel_arm.op:
                        case SORecv(_, _, recv_e):
                            if mutinf_scan_expr(recv_e, target, &gmod, &callees): m = true
                        case SOSend(send_ch, send_v):
                            if mutinf_scan_expr(send_ch, target, &gmod, &callees): m = true
                            if mutinf_scan_expr(send_v, target, &gmod, &callees): m = true
                    if mutinf_scan_stmts(sel_arm.body, target, &gmod, &callees): m = true
            else:
                pass
    return m

# Driver: populate gmod.method_mutates_self with a fixpoint over the module.
void compute_method_mutates_self(GirModule &gmod, Module m):
    # Per-method direct-mutation seed + self-callee edges.
    Dict[String, bool] direct = {}
    Dict[String, Vector[String]] edges = {}
    Vector[String] keys = []
    for mi_item in m.items:
        match mi_item:
            case IEquip(mi_eq):
                if mi_eq.type_params.len() == 0:
                    String mi_tn = ""
                    match mi_eq.target.ty:
                        case TNamed(mi_n, mi_targs):
                            if mi_targs.len() == 0:
                                mi_tn = mi_n
                        case TPrimitive(mi_n):
                            mi_tn = mi_n
                        else:
                            pass
                    if mi_tn != "":
                        for mi_meth in mi_eq.methods:
                            # Only &self/!self methods can mutate the caller's
                            # value. Read the self-convention from the typed
                            # fn_borrow_params/fn_move_params maps (populated by
                            # the earlier pre-pass) — NOT mi_meth.params, whose
                            # `self` ownership is reset to bare by the
                            # apply_collect_target_rewrites reconstruction.
                            String mkey = mi_tn + "__" + mi_meth.name
                            bool takes_mut = mutinf_takes_mut_self(&gmod, mkey)
                            if takes_mut:
                                Vector[String] ces = []
                                bool dm = mutinf_scan_stmts(mi_meth.body, mi_tn, &gmod, &ces)
                                direct.put(mkey, dm)
                                edges.put(mkey, ces)
                                keys.push(mkey)
            else:
                pass
    # Seed the result with the direct-mutation flags.
    for sk in keys:
        gmod.method_mutates_self.put(sk, direct.get(sk).unwrap())
    # Fixpoint: propagate mutation through self-method-call edges.
    bool changed = true
    while changed:
        changed = false
        for fk in keys:
            if not gmod.method_mutates_self.get(fk).unwrap():
                for ce in edges.get(fk).unwrap():
                    if gmod.method_mutates_self.contains(ce) and gmod.method_mutates_self.get(ce).unwrap():
                        gmod.method_mutates_self.put(fk, true)
                        changed = true

# Gate accessor: does the NAMED-receiver user method `recv_name.mname(...)`
# actually WRITE its receiver? Resolves the receiver local's declared type
# (via ctx.locals — a bare EIdentifier receiver has NO typechecker
# expr-type entry, so lookup_expr_gir_type returns -1) and reads the
# classification map. A method not in the map either takes bare `self`
# (a copy — no write-through) or is a generic-equip instance (not yet
# classified) → treat as read-only (the BASE gate already did not
# materialize named receivers, so this is no regression — degrade-to-BASE).
bool mutinf_named_recv_writes_self(LowerCtx &ctx, GirModule &gmod, String recv_name, String mname):
    if not nl_contains(&ctx, recv_name):
        return false
    int rlocal = nl_get(&ctx, recv_name)
    if rlocal < 0:
        return false
    int rtid = ctx.locals.get(rlocal).unwrap().type_id
    int struct_tid = peel_ptr_tid(&gmod, rtid)
    String rtn = type_id_to_name(struct_tid, &gmod)
    if rtn.len() == 0:
        return false
    String key = rtn + "__" + mname
    if gmod.method_mutates_self.contains(key):
        return gmod.method_mutates_self.get(key).unwrap()
    return false

# Type NAME of struct field `fname` on struct type `tname` (from the typed
# GirTypeInfo field table), "" if unknown. Used by the projected-receiver
# resolver below to walk `s.v` field projections.
String mutinf_field_type_name(GirModule &gmod, String tname, String fname):
    if gmod.type_infos.contains(tname):
        GirTypeInfo mfti = gmod.type_infos.get(tname).unwrap()
        for mfti_f in mfti.fields:
            if mfti_f.name == fname:
                return mfti_f.type_name
    return ""

# Resolve the TYPE NAME of a (possibly PROJECTED) receiver expr, walking the
# projection path from a NAMED root. Returns "" when unresolvable (→
# degrade-to-BASE). Companion to `mutinf_named_recv_writes_self` for the
# PROJECTED gate case: the typechecker side table (`lookup_expr_gir_type`)
# does NOT key a projected receiver like `v[0]` / `s.v[0]` at lowering time,
# so this walks the projection from the root local's TYPED slot:
#   • EIdentifier    → the local's declared type name (via ctx.locals);
#   • EIndex(base)   → `index_value_type_name` of base's type (Vector/Deque/
#                      Set element, Dict/HashMap value);
#   • EFieldAccess(base, f) → the field's typed `GirFieldInfo.type_name`;
#   • EDeref(inner)  → transparent.
String mutinf_recv_type_name(LowerCtx &ctx, GirModule &gmod, SpannedExpr e):
    match e.expr:
        case EIdentifier(mrt_idn):
            if not nl_contains(&ctx, mrt_idn):
                return ""
            int mrt_lid = nl_get(&ctx, mrt_idn)
            if mrt_lid < 0:
                return ""
            int mrt_tid = peel_ptr_tid(&gmod, ctx.locals.get(mrt_lid).unwrap().type_id)
            return type_id_to_name(mrt_tid, &gmod)
        case EIndex(mrt_base, _):
            String mrt_bt = mutinf_recv_type_name(&ctx, &gmod, *mrt_base)
            if mrt_bt.len() > 0:
                return index_value_type_name(mrt_bt)
            return ""
        case EFieldAccess(mrt_fbase, mrt_fname):
            String mrt_ft = mutinf_recv_type_name(&ctx, &gmod, *mrt_fbase)
            if mrt_ft.len() > 0:
                return mutinf_field_type_name(&gmod, mrt_ft, mrt_fname)
            return ""
        case EDeref(mrt_inner):
            return mutinf_recv_type_name(&ctx, &gmod, *mrt_inner)
        else:
            return ""

# Gate accessor for a PROJECTED receiver (`v[0].m()` / `s.v[0].m()` /
# `o.inner.m()`): does the user method `mname` on the receiver's resolved
# (element/field) type actually WRITE self? Resolves the projected type via
# `mutinf_recv_type_name` and reads `method_mutates_self`. PRECISE + bomb-safe
# by construction: `method_mutates_self` holds ONLY genuine user `&self`/`!self`
# mutators, so a builtin-colliding name on a projected receiver (`v[0].len()`,
# `s.items[0].len()`) resolves to `Elem__len`, absent from the map → false →
# NO clone. Only a genuine user mutator named like a builtin (`v[0].get()` where
# `get` mutates) → true → materialize. Unresolvable projection → "" → false
# (degrade-to-BASE, filed). This is the projected SIBLING of
# `mutinf_named_recv_writes_self` (Core #4 — one fix, all siblings).
bool mutinf_projected_recv_writes_self(LowerCtx &ctx, GirModule &gmod, SpannedExpr recv, String mname):
    String prtn = mutinf_recv_type_name(&ctx, &gmod, recv)
    if prtn.len() == 0:
        return false
    String pkey = prtn + "__" + mname
    if gmod.method_mutates_self.contains(pkey):
        return gmod.method_mutates_self.get(pkey).unwrap()
    return false

# ── call_arg_lets_callee_mutate — typed `&`/`!`-arg signature read ───
#
# Does the `arg_idx`-th parameter of callee `fname` let the callee
# MUTATE (or consume/drop) the caller's argument? True iff the param is
# declared `&T` (fn_borrow_params) or `!T` (fn_move_params). The parser
# DISCARDS `&`/`!` sigils on call arguments (parser.gg
# skip_ownership_markers in parse_call_args) — the AST carries no
# EMutableBorrow/EMove wrapper at a call-arg position — so the callee's
# TYPED signature maps are the only sound source of this invariant.
# Mirrors Rust's prescan `&`-arg / `!`-move handling
# (src/ir/lowering/functions.rs, compute_cow_reassigned_after).
#
# `fname` must already be redirect-resolved: the self-host loader
# MANGLES imported fn names (loader.gg, mod_prefix + name), keying the
# signature maps by the mangled name while the AST callee is bare —
# callers mirror lower_call's resolution order (redirects first).
bool call_arg_lets_callee_mutate(GirModule &gmod, String fname, int arg_idx):
    if gmod.fn_borrow_params.contains(fname):
        Vector[bool] cab_flags = gmod.fn_borrow_params.get(fname).unwrap()
        if arg_idx >= 0 and arg_idx < cab_flags.len() and cab_flags.get(arg_idx).unwrap():
            return true
    if gmod.fn_move_params.contains(fname):
        Vector[bool] cam_flags = gmod.fn_move_params.get(fname).unwrap()
        if arg_idx >= 0 and arg_idx < cam_flags.len() and cam_flags.get(arg_idx).unwrap():
            return true
    return false

# Sibling of `method_mutates_receiver` for NON-receiver method args:
# does the `arg_idx`-th (0-based, self excluded) argument of
# `recv.mname(...)` reach a `&T`/`!T` callee param? Resolves the
# receiver type to the same short `Type__mname` key the populate
# pre-pass writes (lower.gg, the fn_borrow_params section) and reads
# param index `arg_idx + 1` (index 0 is self). Builtin collection
# methods never appear under this key — their owning val args CLONE
# from (never mutate) the argument, so a miss is the correct `false`.
#
# Receiver-type resolution at SCAN time: the typechecker side table
# (lookup_expr_gir_type) does NOT key bare-ident receivers (RUN-proven
# tid<0 for every `h.m(...)` receiver during the pre-lowering scan), so
# the primary source is the scan's own declared-type side channel
# (`ctx.cow_decl_types`), with the side table as the secondary read.
bool method_arg_lets_callee_mutate(LowerCtx &ctx, SpannedExpr recv, String mname, int arg_idx, GirModule &gmod):
    String marg_recv_tname = ""
    match recv.expr:
        case EIdentifier(marg_recv_idn):
            if ctx.cow_decl_types.contains(marg_recv_idn):
                marg_recv_tname = ctx.cow_decl_types.get(marg_recv_idn).unwrap()
        else:
            pass
    if marg_recv_tname.len() == 0:
        int marg_recv_tid = lookup_expr_gir_type(recv, &gmod)
        if marg_recv_tid >= 0:
            marg_recv_tname = type_id_to_name(marg_recv_tid, &gmod)
    if marg_recv_tname.len() == 0:
        return false
    return call_arg_lets_callee_mutate(&gmod, marg_recv_tname + "__" + mname, arg_idx + 1)

void emit(LowerCtx &ctx, Instruction inst):
    ctx.block_insts.get(ctx.current_block).unwrap().push(inst)

int new_block(LowerCtx &ctx):
    int id = ctx.block_insts.len()
    Vector[Instruction] empty_insts = []
    ctx.block_insts.push(!empty_insts)
    ctx.block_terms.push(GTNone())
    return id

void switch_to(LowerCtx &ctx, int block_id):
    ctx.current_block = block_id

void set_terminator(LowerCtx &ctx, Terminator term):
    ctx.block_terms.set(ctx.current_block, term)

# Phase 2c COMMIT 3 Prereq B-extension (2026-05-21) — propagate a
# LoBorrowed/LoView ownership tag from `src` onto `dst` when `dst`
# is a method-chain result that byte-aliases `src`'s data. Without
# this, `.unwrap()` of a borrowed Option / Result produces an
# LoOwned local that double-frees the alias when COMMIT 3 drops it
# at scope exit.
#
# Caller contract:
#   • `dst` was just allocated by `emit_payload_read` (or a similar
#     method-chain handler). Its current ownership tag is whatever
#     `emit_payload_read` set — typically LoBorrowed/BoField if no
#     clone fired, LoOwned if the payload was materialised via
#     `<Type>__clone`.
#   • `src` is the receiver whose ownership we want to inherit.
#
# Demotion rule (mirrors Rust's `materialise_via_clone` post-pass
# in `src/ir/lowering/method_call.rs:412`): only demote when dst
# is currently a borrow alias. If dst is LoOwned, the upstream
# already cloned and dst genuinely owns its data — demoting would
# skip the drop at scope exit and leak.
#
# Result-side rule:
#   • src LoBorrowed → dst LoBorrowed (inherit src's borrow_origin)
#   • src LoView     → dst LoView (inherit src's borrow_origin)
#   • src LoOwned/LoParam/LoMaybeOwned → no change (dst keeps its
#     own ownership; the chain produced a fresh owner whose drop
#     is independent).
void inherit_borrow_from(LowerCtx &ctx, int dst, int src):
    GirLocal dst_loc = ctx.locals.get(dst).unwrap()
    GirLocal src_loc = ctx.locals.get(src).unwrap()
    # Only demote if dst is currently a borrow alias (no clone fired).
    bool dst_is_alias = false
    match dst_loc.ownership:
        case LoBorrowed():
            dst_is_alias = true
        case LoView():
            dst_is_alias = true
        else:
            pass
    if not dst_is_alias:
        return
    # Inherit ownership + borrow_origin from src when src is itself
    # a borrow. Owned src → no propagation (the alias bridges across
    # ownership transfer, which is fine — the dst still aliases
    # heap that src owns, but src's scope-exit drop covers the
    # heap regardless of which local is registered).
    LocalOwnership new_own = dst_loc.ownership
    BorrowOrigin new_origin = dst_loc.borrow_origin
    bool propagate = false
    match src_loc.ownership:
        case LoBorrowed():
            new_own = LoBorrowed()
            new_origin = src_loc.borrow_origin
            propagate = true
        case LoView():
            new_own = LoView()
            new_origin = src_loc.borrow_origin
            propagate = true
        else:
            pass
    if not propagate:
        return
    GirLocal updated = GirLocal(dst_loc.type_id, dst_loc.name_hint, new_own, new_origin, dst_loc.owning_param)
    ctx.locals.set(dst, updated)

# ── BorrowOrigin tracking helpers (C.1, 2026-05-22) ─────────
#
# Dead-code scaffolding to mirror Rust's borrow/return-corruption
# machinery (`src/ir/lowering/context.rs:2255-2410`). Subsequent
# commits wire callers:
#   • A.2: `EFieldAccess` writes `set_field_borrow` at GIFieldLoad
#     emission so the dst local carries its parent struct's identity.
#   • B.1: bare-identifier rebinds in SVarDecl call `cow_register_alias`
#     so the dst inherits the source's origin transitively.
#   • E.1: return-path validator reads back via `field_borrow_origin`
#     to flag "returning a borrow into a local stack frame".
#
# C.1 itself adds the enum payloads + these helpers but no caller is
# wired — validation gate is build/lib/lowerer_comparison stays green
# precisely because nothing reads/writes the new state.

# Small helper struct for `field_borrow_origin` return — Gorget doesn't
# have a generic `Pair` and inlining the two ints into separate Option
# returns would change the helper's shape from Rust's
# `Option<(LocalId, u32)>`. Keeping the struct local to this module
# preserves the Rust-side signature 1:1 at the call sites that A.2
# / B.1 will introduce.
struct FieldBorrowPair:
    int base
    int field

# Result of a Guard[T] field-access auto-deref (lower_expr
# `guard_field_deref_base`): the inner-data pointer local + the guarded
# type name. Both read (lower_expr EFieldAccess) and write
# (lower_stmt lower_field_write / emit_field_write_from_local) paths
# re-point `base`/`base_type_name` to these before the field projection.
struct FieldDerefResult:
    int inner_ptr_local
    String inner_name

# Write `BoField(base, field)` as `dst`'s borrow_origin. Mirrors Rust's
# `set_field_borrow` (`src/ir/lowering/context.rs:2255`).
#
# Caller contract (A.2): called immediately after `add_local_with` /
# emit_payload_read materialises a `dst` local that carries a struct-
# field borrow. `base` is the parent aggregate local; `field` is the
# 0-based index into the struct/variant payload.
#
# Dead code at C.1: no caller wired. A.2 wires the EFieldAccess path.
void set_field_borrow(LowerCtx &ctx, int dst, int base, int field):
    if dst < 0 or dst >= ctx.locals.len():
        return
    GirLocal loc = ctx.locals.get(dst).unwrap()
    GirLocal updated = GirLocal(loc.type_id, loc.name_hint, loc.ownership, BoField(base, field), loc.owning_param)
    ctx.locals.set(dst, updated)

# Read back the `(base, field)` pair from a local's borrow_origin.
# Returns None when the local isn't a BoField borrow. Mirrors Rust's
# `field_borrow_origin` (`src/ir/lowering/context.rs:2268`).
#
# Dead code at C.1: no caller reads. E.1 wires the return-path
# validator that pattern-matches on this.
Option[FieldBorrowPair] field_borrow_origin(LowerCtx &ctx, int local):
    if local < 0 or local >= ctx.locals.len():
        return None
    GirLocal loc = ctx.locals.get(local).unwrap()
    match loc.borrow_origin:
        case BoField(base, field):
            return Some(FieldBorrowPair(base, field))
        else:
            return None

# Register `alias` as a transitive borrow of `source`. Writes
# `BoAlias(source)` into the alias's borrow_origin so downstream
# resolvers can chase the chain to the root. Mirrors Rust's
# `cow_register_alias` (`src/ir/lowering/context.rs:2532`).
#
# Note: Rust's version eagerly resolves the chain at write time
# (`cow_resolve_root`) and stores the ROOT, not the immediate source.
# The self-host helper stores the immediate source — chain-walk is
# the reader's job, mirroring how `add_local_inheriting` propagates
# origins one step at a time. The two strategies are observationally
# equivalent as long as the reader walks; B.1 will pick the strategy
# (probably chase-on-write, matching Rust) when it wires callers.
#
# Dead code at C.1: no caller wired. B.1 wires the bare-rebind path
# in SVarDecl / decide_operand_at_consuming_arg.
void cow_register_alias(LowerCtx &ctx, int alias, int source):
    if alias < 0 or alias >= ctx.locals.len():
        return
    GirLocal alias_loc = ctx.locals.get(alias).unwrap()
    GirLocal updated = GirLocal(alias_loc.type_id, alias_loc.name_hint, alias_loc.ownership, BoAlias(source), alias_loc.owning_param)
    ctx.locals.set(alias, updated)

# ── SVarDecl assign-mode decision tree (B.1, 2026-05-22) ────
#
# Mirrors Rust's `lower_var_decl_assign_mode`
# (`src/ir/lowering/stmts/mod.rs:1055-1273`). Seven branches A-G,
# each predicated on the cross-product of (source ownership,
# source type, declared type, liveness, CoW-safety). The branches
# collapse to one of three emission strategies, returned via the
# `SVarDeclEmission` enum below.
#
# Pragmas in this self-host port:
#   • `declared_is_live = true` everywhere. Self-host's
#     `compute_liveness` runs AFTER lowering, so at SVarDecl
#     emission time there's no last-use info to consult. The
#     wire pass refines OpMove vs OpClone downstream; Branch F's
#     "dead source" case isn't reachable from initial lowering
#     with this conservative assumption — that's OK.
#   • CoW-safe = true. Rust's `is_cow_unsafe_at` checks the
#     `@mut:path` set from `cow_after_block`; self-host doesn't
#     track this yet. Conservative direction: allow Branch C to
#     fire (alias instead of clone). If correctness issues surface
#     we can defer to Branch D's clone fallback.
#   • Branch C DOES retype dst's slot to Ptr(T) — shipped D.1
#     (2026-05-22, see the emission code ~100 lines down at the
#     BorrowAlias arm `:8608`): `register_ptr(var_type)` retypes the
#     dst slot, and the per-assign SlotAddr dispatch is wired in
#     `lir_lower.gg` GIAssign (`:2876` — OpBorrow + Ptr-typed-dst +
#     value-typed-src → ISlotAddr, not ISlotLoad). This is the Rust
#     `set_ref` analogue; downstream Ptr-slot consumers (GIFieldLoad
#     auto-deref, GICall/GICallExtern pass-by-ptr, OpClone short-
#     circuit) handle the Ptr shape. ⚠ HISTORICAL (pre-D.1, B.1):
#     this used to stay value-typed (OpBorrow → ISlotLoad would load
#     the 32-byte resource VALUE into an 8-byte LT_PTR slot). That is
#     NO LONGER TRUE — do not reintroduce the value-typed-slot
#     framing (it mis-scoped a 2026-06-09 borrow-ABI brief + mis-led
#     the CoW tier-2 scout; the real tier-2 blocker is the GAP-B1
#     VALUE-POSITION consume val_size mismatch, NOT the slot-retype).
#
# Why `add_local_inheriting` stays. Phase 3's intermediate-temp
# binding helper (lower.gg:~435) is for sites that bind FROM a
# single source local at IR construction time (match scrutinee,
# PBinding, PCtor field, etc.) — those sites do not go through the
# 7-branch tree. Only user-level SVarDecl declarations with a
# declared type take this path.

enum SVarDeclEmission:
    BorrowAlias()                  # mark dst LoBorrowed/BoAlias, no drop register
    CloneAndMove(String)           # emit `<clone_fn>(&src)` then Move into dst
    MoveDirect()                   # existing path — direct Move via op_consume
    # #37 Phase 2 — lazy loop-carried element borrow: value slot = cap=0
    # borrow_view + pre-set materialized flag; the carried String is the
    # typed deep-copy clone fn for the flag-guarded in-place materialize.
    LazyViewBind(String)
    # round-40 (none_assign_to_option_slot) — EAGER whole-aggregate deref-clone
    # of a `GtPtr(agg)` source into a VALUE-typed owned local. Used by Branch
    # A-agg when the source (an `Option`/`Result`/droppable-aggregate borrow
    # with `resolve_payload_clone_fn == ""`) is mutated AFTER the bind, so a
    # BorrowAlias would observe the clobbered value at the owning consume. The
    # emission unwraps the source's pointee type so the dst slot is value-typed
    # (avoids the GtPtr→OpClone re-entry double-clone MoveDirect would hit) and
    # uses `OpClone` (the LIR `resource_clone_fn` deref-clone path the return-
    # escape already uses — CloneAndMove's GICallExtern mis-routes an
    # `Option__*__clone` name to the `__option_clone` combinator).
    EagerAggClone()

# Decide which of the three emission strategies SVarDecl should use
# for `var_type x = val`. Returns an `SVarDeclEmission` variant; the
# caller emits the corresponding IR. Pragmas: declared_is_live=true.
#
# `bound_name` is the SVarDecl's variable name and `source_root` is the
# source-collection root identifier of the init expression (e.g. `v` for
# `v.get(0).unwrap()`, `matrix` for `matrix[1]`; "" when the init has no
# aliasable collection root). Both feed the substrate-(ii) resource-bind
# borrow-flip in Branch C-pre. `bind_pos` is the init expression's
# textual `span.start` — the position the alias is born at. CoW tier-2 L1
# makes the flip POSITION-AWARE: it fires when neither the bound name nor
# the source root is mutated *while the alias is live* — i.e. each is
# `cow_pristine_after(bind_pos)` (never mutated, or last-mutated strictly
# before the bind, and not closure-deferred). See `compute_cow_scan` /
# `cow_pristine_after`.
SVarDeclEmission decide_svardecl_emission(LowerCtx &ctx, GirModule &gmod, int val, int var_type, String bound_name, String source_root, int bind_pos, bool source_is_static_global):
    if val < 0 or val >= ctx.locals.len():
        return MoveDirect()
    GirLocal val_loc = ctx.locals.get(val).unwrap()
    int source_type = val_loc.type_id
    String source_tname = type_id_to_name(source_type, &gmod)
    String var_tname = type_id_to_name(var_type, &gmod)
    bool source_is_resource = is_resource_type_name(source_tname, &gmod)
    # A GtPtr/GtMutPtr SOURCE (e.g. the `GtPtr(GorgetString)` borrow that
    # `coll.get(i).unwrap()` yields from an Option[Ref] payload) must NOT take
    # the value-alias Branch A — it has to fall through to Branch C-pre's
    # deref+clone. Mirrors Rust `lower_var_decl_assign_mode`
    # (src/ir/lowering/stmts/mod.rs:1140-1141), whose `same_type_string` test
    # compares the SOURCE's type id to the value GorgetString id — a Ptr source
    # fails it. The self-host's `var_tname == "GorgetString"` is a name-collapse
    # (`type_id_to_name(GtPtr(GorgetString))` → "GorgetString") and `var_type`
    # stays `GtPtr(GorgetString)` because the declared-type override (~line 5577)
    # only fires for "__" names — so without this typed guard, Branch A
    # BorrowAlias pre-empts Branch C-pre and the owned bind aliases the
    # collection element → use-after-free (populate_drop_metadata's
    # `recursive_drop_structs.put(tname, …)` dangling String key, lir_lower.gg
    # :3589). Typed check, not a name match.
    bool source_is_ptr_type = false
    if source_type >= 0 and source_type < gmod.type_table.len():
        match gmod.type_table.get(source_type).unwrap():
            case GtPtr(_):
                source_is_ptr_type = true
            case GtMutPtr(_):
                source_is_ptr_type = true
            else:
                pass
    bool is_string_same_type = (source_type == var_type) and (var_tname == "GorgetString") and (not source_is_ptr_type)
    String clone_fn = resolve_payload_clone_fn(var_tname, &gmod)

    # T-C (round-40): `T x = STATIC_RESOURCE` — a bare read of a resource-typed
    # module-level `static` yields a SHALLOW struct copy that ALIASES the
    # global's heap buffer (the `__global_ref__` load memcpy's the header, then
    # the collection's data pointer is shared). Binding it as owned (MoveDirect,
    # the fall-through below) then (a) frees the static's heap at scope exit and
    # (b) lets the bind observe a later `STATIC[i]=x` write THROUGH the shared
    # buffer (static_vector_index_alias: `alias[0]` read 99, must stay 10;
    # compound sibling read 15, must stay 10). DEEP-CLONE at the boundary so the
    # bind owns an independent allocation — the exact analog of Rust gg's
    # `clone_resource_global_ref` (src/ir/lowering/stmts/mod.rs:36), which clones
    # resource `GlobalRef`s at every var-decl init / assign / return. The
    # existing CloneAndMove branch (lower_stmt.gg) emits `<clone_fn>(&val)` then
    # moves the fresh owner into the bind and registers it for drop. Value-typed
    # resource source only (a Ptr/element read is a different shape, not the
    # whole-collection alias); the caller gates on init being a BARE identifier
    # naming a static that is NOT shadowed by a local (`static_contains` and
    # `not nl_contains`).
    if source_is_static_global and source_is_resource and (not source_is_ptr_type) and clone_fn != "":
        return CloneAndMove(clone_fn)

    bool source_is_borrow_alias = false
    match val_loc.ownership:
        case LoBorrowed():
            source_is_borrow_alias = true
        case LoView():
            source_is_borrow_alias = true
        else:
            pass

    # Branch A — (live) GorgetString same-type, source IS a borrow alias.
    # Value-aliasing `String b = a` shape where `a` is itself a borrow
    # into another aggregate. Inherit the chain so the root owner's drop
    # covers both. (Rust additionally fires Branch A for fresh-Owned
    # sources via `set_shared_heap`; the self-host pragma defers that
    # because there's no SharedHeap ownership state nor drop tracker
    # that consults it — fresh-Owned String sources continue through
    # MoveDirect, which transfers ownership cleanly.)
    if source_is_borrow_alias and is_string_same_type:
        return BorrowAlias()

    # Branch B — Owned + (live) non-resource source, cross-type clone_fn
    # available (e.g. Str → GorgetString). Self-host doesn't have a
    # distinct non-resource cloneable type, so this branch is effectively
    # dead — kept for parity / future evolution. The cstr→GorgetString
    # coercion at the SVarDecl handler entry handles the analogous
    # path before this tree fires.
    match val_loc.ownership:
        case LoOwned():
            if (not source_is_resource) and (source_type != var_type) and (clone_fn != ""):
                return CloneAndMove(clone_fn)
        else:
            pass

    # Branch A-agg (Leak 1, #8-residual) — borrow-flip a `T back =
    # coll.get(i).unwrap()` read bind of a DROPPABLE USER AGGREGATE
    # (`Option[String]`/`Result[_,_]`/resource-struct). The source is a
    # `GtPtr(T)` borrow (`LoBorrowed`) into the collection element (kept as a
    # borrow by the widened `emit_payload_read` gate). Unlike a runtime
    # resource (which Branch C-pre DEEP-CLONES via `resolve_payload_clone_fn`),
    # a user aggregate has NO payload clone fn registered → Branch C-pre falls
    # through to MoveDirect, which byte-copies the 40-byte payload, SHALLOW-
    # ALIASING the element's inner heap. A scope-exit whole-drop of that alias
    # then double-frees against the array-free `elem_drop` (Leak-1's wiring in
    # `lir_codegen.gg`). The fix is to make `back` a NON-OWNING Ptr alias: the
    # array owns + frees the element exactly once; `back` borrows it (read via
    # the Ptr — match auto-derefs, field-access auto-derefs, op_consume clones
    # the pointee only at an OWNING consume). This is the borrow-flip half of
    # the Leak-1 pairing (the elem_drop half is the `lir_codegen.gg` gate
    # widen). Typed `is_droppable_type(inner)` discriminator, not a name match.
    #
    # SCOPE GUARD: only a `GtPtr`/`GtMutPtr` borrow-alias source whose pointee
    # is a droppable user aggregate. Runtime-resource pointees keep Branch
    # C-pre's deep-clone (they have a clone fn + their own drop discipline).
    # Recursive-Box AST aggregates are NEVER reached here — their `.get()`
    # path clone-extracts (the permanent NO-GO exclusion).
    #
    # PRISTINE GATE (round-40, none_assign_to_option_slot): the borrow-flip is
    # only sound when the alias observes the SAME value at its owning consume
    # that it did at the bind. Branch C-pre already gates its resource borrow-
    # flip on `cow_pristine_after` for exactly this reason; Branch A-agg
    # OMITTED it, so `Option[String] t = r.pending; r.pending = None; return t`
    # aliased `t` into `r.pending`, the in-place field write clobbered the
    # field, and the deferred materialize (op_consume's OpClone at `return t`)
    # deref-cloned the now-`None` field — returning None instead of the
    # original Some. The designed read-only element-borrow shape (`back =
    # coll.get(i).unwrap()` where `coll` is never mutated) stays pristine ⇒
    # still aliases. When the bound name OR the source root is mutated after
    # the bind, fall to EagerAggClone: it deref-clones the pointee into a
    # VALUE-typed owned local via `OpClone` (the LIR `resource_clone_fn` path
    # that lowers to the correct `<Aggregate>__clone`), materialising an
    # INDEPENDENT owner at the bind BEFORE the mutation runs. (MoveDirect would
    # keep the dst `GtPtr(agg)`-typed → the return re-enters op_consume's
    # GtPtr→OpClone arm and double-clones a value as a pointer; CloneAndMove's
    # `GICallExtern` mis-routes an `Option__*__clone` name to the
    # `__option_clone` combinator — EagerAggClone sidesteps both.) An
    # unidentifiable source (source_root == "", a temp/call-result) keeps the
    # pre-existing BorrowAlias — the escape funnel materialises it on escape —
    # minimising blast radius.
    if source_is_ptr_type and source_is_borrow_alias:
        match gmod.type_table.get(source_type).unwrap():
            case GtPtr(agg_inner):
                if is_droppable_type(agg_inner, &gmod):
                    String agg_pointee = type_id_to_name(agg_inner, &gmod)
                    if resolve_payload_clone_fn(agg_pointee, &gmod) == "":
                        if source_root != "" and not (cow_pristine_after(&ctx, bound_name, bind_pos) and cow_pristine_after(&ctx, source_root, bind_pos)):
                            return EagerAggClone()
                        return BorrowAlias()
            case GtMutPtr(agg_inner_m):
                if is_droppable_type(agg_inner_m, &gmod):
                    String agg_pointee_m = type_id_to_name(agg_inner_m, &gmod)
                    if resolve_payload_clone_fn(agg_pointee_m, &gmod) == "":
                        if source_root != "" and not (cow_pristine_after(&ctx, bound_name, bind_pos) and cow_pristine_after(&ctx, source_root, bind_pos)):
                            return EagerAggClone()
                        return BorrowAlias()
            else:
                pass

    # Branch C-pre (option_ref_borrow Phase 4a) — GtPtr-to-resource source
    # bound to an OWNED local. This is the `T x = coll.get(i).unwrap()` shape:
    # `.get()` now returns `Option[Ref[T]]`, so the unwrapped payload is a
    # `GtPtr(T)` borrow (`LoBorrowed`) whose pointer is the element's address
    # in the collection. Aliasing it into an "owned" `x` (Branch C →
    # BorrowAlias) would make `x` share the collection's heap → double-free
    # when both drop. The owned bind must instead DEREF+CLONE the pointee:
    # `T__clone(OpBorrow(val))` materializes a fresh, independent owner.
    #
    # Match on the GIR TYPE, not the name: `type_id_to_name(GtPtr(T))`
    # collapses to "T" (lower.gg:~2884), so `source_tname` already reads as
    # the resource pointee name — indistinguishable from a value-typed `T`
    # source by name alone. The typed `GtPtr(inner)` shape is the only sound
    # discriminator. This branch MUST precede Branch C (whose name-based
    # `source_is_resource and source_is_borrow_alias` would otherwise fire
    # BorrowAlias for this exact shape).
    #
    # `GtMutPtr(inner)` is handled symmetrically. `&T` (MutableBorrow) and
    # `!T` (Move) params both lower to `GtMutPtr(T)` (resolve_param_type at
    # context.rs:1613; mirrored at lower.gg:~7255). The `String call_name =
    # fname` shape — bare-binding a `&String` param into a value-typed
    # local — has exactly the same dangling-alias risk as `GtPtr` if not
    # cloned: the dst slot would point into the caller's storage, and a
    # `gmod.call_redirects.contains(call_name)` Dict-key hash later would
    # dereference a slot that wasn't owned by this frame (NULL after
    # frame-exit zeroing). Concretely this was the lower_call SIGSEGV in
    # self_host_bootstrap_fixed_point: the s1bin emitted `__s77 = NULL;`
    # because the dst slot type stayed `GtMutPtr(String)` while the
    # OpClone result was a value `Str` — lir_codegen.gg:2809-2810's
    # "pointer slot receiving aggregate value → assign NULL" give-up
    # branch fired. The structural fix is here at the writer: clone+move
    # at the var-decl site so the dst is value-typed and the slot store
    # is a clean value-into-value copy.
    #
    # `OpBorrow(val)` on a `GtPtr`/`GtMutPtr`/`LT_PTR` slot passes the
    # POINTER value (the `const T*` the clone fn wants), not the slot
    # address — verified at lir_lower.gg:~2830-2843 (GICallExtern
    # OpBorrow arm, `slot_ty == LT_PTR` → pass loaded value directly).
    # So `CloneAndMove`'s `GICallExtern(cloned, clone_fn, [OpBorrow(val)])`
    # (lower.gg:~5586) deref-clones correctly for both.
    if source_type >= 0 and source_type < gmod.type_table.len():
        GirType src_gt = gmod.type_table.get(source_type).unwrap()
        match src_gt:
            case GtPtr(inner_tid):
                String pointee_tname = type_id_to_name(inner_tid, &gmod)
                String pointee_clone_fn = resolve_payload_clone_fn(pointee_tname, &gmod)
                if pointee_clone_fn != "":
                    # ── substrate (ii) resource-bind borrow-flip ───────────
                    # `T x = coll.get(i).unwrap()` / `T x = coll[i]` on a
                    # runtime resource (String/Vector/Dict/Set). The default
                    # is the eager deref+clone (CloneAndMove) — an independent
                    # owner. FLIP to a non-owning Ptr borrow alias (BorrowAlias)
                    # ONLY when the whole-fn forward-scan proves it sound:
                    #   • the bound name x is never reassigned / mutated
                    #     (`x.push(…)` / `x = …`) anywhere — else the alias
                    #     would mutate the collection element (Direction A,
                    #     index_ref_auto_clone), AND
                    #   • the source collection coll is never mutated anywhere
                    #     (`coll.push(…)`) — else a realloc would dangle the
                    #     alias (Direction B, cow_borrow_outlives_push), AND
                    #   • we COULD identify the source root (source_root != "")
                    #     — an unidentifiable source (call result, temp) has no
                    #     tracked collection to prove pristine, so we must not
                    #     alias into it.
                    # If x ESCAPES (push/return/ctor/field-store), op_consume's
                    # GtPtr arm (decide_ptr_consume → OpClone for a resource
                    # pointee, lower.gg:1872) materialises an independent copy
                    # at the owning consume — so a read-only borrow is the only
                    # shape this flip ever leaves un-cloned. Mirrors Rust's
                    # CoW-default-borrow at a same-string-type bind.
                    # CoW tier-2 L1: position-aware. The flip fires when
                    # the bound name AND the source root are BOTH pristine
                    # at the bind position — never mutated, or last-mutated
                    # strictly before the bind (mut-before-bind / read-then-
                    # dead), and never closure-deferred (property (d)). A
                    # mutation while the alias is live (`max_span >= bind_pos`)
                    # keeps tier-1's eager deref+clone.
                    if source_root != "" and cow_pristine_after(&ctx, bound_name, bind_pos) and cow_pristine_after(&ctx, source_root, bind_pos):
                        return BorrowAlias()
                    # #37 Phase 2 — LAZY loop-carried bind (the ViewOf
                    # provenance design, docs/language-design.md "compile-
                    # time ViewOf(source) provenance tracking"). The source
                    # collection IS mutated at/after the bind (the pristine
                    # flip above declined), so the legacy default was the
                    # eager deref+clone — paying the clone even when the
                    # mutating branch never runs. Instead the bind becomes
                    # a cap=0 borrow_view slot + materialized-flag,
                    # materialized in place at every mutation site of the
                    # source (cow_lazy_materialize_family). Eligibility:
                    #   • the BOUND NAME is pristine — never written, so no
                    #     write-site tag clearing is needed (the pristine-
                    #     gate trade, devbook/11 §Phase 2);
                    #   • the source's mutations are not CLOSURE-deferred
                    #     (a closure body cannot host the enclosing fn's
                    #     materialize guard);
                    #   • the source is never EMove-consumed at a non-call
                    #     position (cow_moved_names): the EMove class has
                    #     no lowering choke point, so it is EXCLUDED from
                    #     laziness rather than hooked;
                    #   • the element type carries the typed view
                    #     discriminator — ResourceMetadata.materialize_fn
                    #     present (Some for exactly GorgetString, the only
                    #     resource whose free is view-aware; a cap=0
                    #     collection view would double-drop its elements).
                    #     The materialize itself still calls the typed
                    #     deep-copy clone fn (pointee_clone_fn →
                    #     clone_to_owned); presence is the eligibility
                    #     axis only.
                    if source_root != "" and cow_pristine_after(&ctx, bound_name, bind_pos) and (not ctx.cow_closure_mutated.contains(source_root)) and (not ctx.cow_moved_names.contains(source_root)):
                        match resource_meta_for(&gmod, pointee_tname):
                            case Some(lv_meta):
                                match lv_meta.materialize_fn:
                                    case Some(_):
                                        return LazyViewBind(pointee_clone_fn)
                                    case None:
                                        pass
                            case None:
                                pass
                    return CloneAndMove(pointee_clone_fn)
            case GtMutPtr(inner_tid):
                # `&`/`!`-param-derived MutPtr sources are NOT flipped: a bare
                # bind of a `&String` param aliases the CALLER's storage, which
                # frame-exit zeroing turns into a NULL deref (the lower_call
                # SIGSEGV documented above). Always eager-clone.
                String pointee_tname_m = type_id_to_name(inner_tid, &gmod)
                String pointee_clone_fn_m = resolve_payload_clone_fn(pointee_tname_m, &gmod)
                if pointee_clone_fn_m != "":
                    return CloneAndMove(pointee_clone_fn_m)
            else:
                pass

    # Branch C — live resource SOURCE that's a borrow alias (transitive
    # chain). Mirrors Rust's `is_resource_type(rhs_type)` predicate where
    # `rhs_type` is the SOURCE's type. Self-host pragma: fire only for
    # already-borrow sources (LoBorrowed/LoView). Fresh-Owned resource
    # sources flow through MoveDirect; without `set_shared_heap` /
    # alias-tracked drop, MoveDirect's ownership transfer is the safe
    # default — the dst becomes the sole owner and registers for drop.
    # This collapses Rust's "Branch C for Owned + Branch C for borrowed"
    # asymmetry into the borrowed half only; the Owned half is handled
    # by MoveDirect. Functionally observable difference: zero — Rust's
    # Owned-Branch-C path is the `set_shared_heap` shape whose self-host
    # equivalent isn't built yet.
    if source_is_resource and source_is_borrow_alias:
        return BorrowAlias()

    # Branch D — live resource source, CoW-unsafe + non-Borrowed source.
    # Self-host's CoW-safe pragma never triggers this branch from C
    # falling through directly; kept as a defensive defer for any future
    # `is_cow_unsafe_at` wire-up. Borrowed sources skip — cloning a borrow
    # chain would compound the alias issue, not resolve it.
    if source_is_resource and (not source_is_borrow_alias) and (clone_fn != ""):
        # No CoW-unsafe trigger today, so don't preemptively clone.
        # Leave for future is_cow_unsafe_at wire-up. The fresh-Owned
        # resource path falls through to MoveDirect below.
        pass

    # Branch E — View source, same-type. Rust emits a clone-to-owned
    # so the alias materializes into an independent owner (captures the
    # CoW-view's `auto x = s.slice(...)` shape where x must outlive the
    # underlying buffer's mutation point). Self-host's CoW-safe pragma
    # routes LoView sources through Branch C above (BorrowAlias) — the
    # CoW-default-borrow design intent is to alias, not materialize.
    # If a `cow_after_block` / `is_cow_unsafe_at` wire-up lands later
    # and flips Branch C off for a specific (local, position) pair,
    # this branch becomes reachable; for now it's dead.

    # Branch F + G — fall through to direct Move. Primitives, FnPtr,
    # non-resource user types, AND fresh-Owned resource sources (per
    # the self-host's Owned-Branch-A/C pragma) all land here. Move is
    # identity-by-bytes for primitives; for resources, op_consume
    # returns OpMove and the wire pass refines based on liveness.
    return MoveDirect()

# ── #37 Phase 2: the lazy-CoW mutation-site materialize ─────────────
#
# THE MUTATION-ROUTE CLASS TABLE (scan arm × lowering position). Every
# `cow_mark_*`-producing scan arm needs a 1:1 lowering hook OR an
# eligibility exclusion per lowering position it can execute at — a
# per-arm view alone is insufficient because one arm (EMove) lowers at
# many positions with no choke point. One fixture per row; the prose
# version lives in devbook/11 §Phase 2.
#
#  scan arm                      lowering position(s)       coverage / fixture
#  1 EMethodCall mut-receiver    EMethodCall arm            hook 1 (lower_expr)
#                                                           witness_* / cow_lazy_multisite
#  2 ECall sig-args (&/!)        lower_call arg loop        hook 2 (lower_expr)
#                                                           mutarg_probe / cow_lazy_move_consume
#  3 EMethodCall sig-args (&/!)  EMethodCall marg loop      hook 3 (lower_expr)
#                                                           cow_lazy_method_arg
#  4 SAssign target root         lower_stmt SAssign         hook 4 (lower_stmt)
#                                                           cow_lazy_reassign_source
#  5 SCompoundAssign target      lower_stmt SCompound       hook 5 (lower_stmt; collection-root
#                                                           compound (`v[i] += x`) is lower_fail
#                                                           today, so the hook is class-rule
#                                                           completeness; `s += x` on the MEMBER
#                                                           is excluded by the bound-name-
#                                                           pristine gate) cow_lazy_compound
#  6 EMove (non-call `!name`)    decl-init / assign-RHS /   ELIGIBILITY EXCLUSION
#                                return / literal element / (cow_moved_names; no choke point)
#                                match scrutinee            cow_lazy_move_bind /
#                                                           cow_lazy_move_reassign
#  – EMutableBorrow (`&name`)    call args strip the sigil  rows 2/3 carry the sig-driven
#                                (parser); survivors lower  routes; `&s` on the MEMBER itself
#                                as passthroughs            is excluded by the bound-name-
#                                                           pristine gate
#                                                           cow_lazy_mut_borrow_write
#  – SWith / spawn / compreh.    no distinct route — they only recurse; their
#                                lowerings route through the hooked paths above.
#                                (Known PRE-EXISTING mode-independent gaps, both
#                                in TODO: inline-closure-spawn-arg; bare
#                                collection alias `w = v` then mutate.)
#
#  derivation JOINS (reads that re-derive a view from a member):
#  a returns_view results        lower_expr LoView choke    JOIN with own flag
#                                point (the ONE String-view  cow_lazy_w3b_*
#                                tag site)
#  b for-string source           lower_for_string entry     materialize-at-entry
#                                                           cow_lazy_w3d_for_string
#  c same-type alias `x = s`     Branch A slot alias        NO CODE — the alias derefs the
#                                                           SLOT at read time (provenance by
#                                                           slot-aliasing)
#                                                           cow_lazy_d1_alias*
#  d index/slice `s[i]`/`s[a..b]` DEFERRED behind F2 (string index/slice
#                                miscompiles before CoW matters; cow_lazy_w3c_*
#                                stay expected-wrong until F2)
#
# Flag-guarded in-place materialize of ONE lazy family member, emitted
# BEFORE the mutation executes: `if not flag: slot = <clone_fn>(&slot);
# flag = true` — clone at most once, from the still-valid cap=0 view,
# written back into the SAME slot (no fresh local, no name rebind — the
# flat named_locals binding stays pointed at the slot, and LIR-SSA phis
# slot+flag across loop back-edges because both are defined before the
# loop header; `lir_ssa.gg` needs ZERO changes). Multiple static sites
# each emit their own guard; dominance makes all but the first
# dynamically dead — clone-once at runtime. Mirrors Rust's
# `cow_materialize_view_lazy_in_place` (devbook/11 §lazy-materialize).
void cow_lazy_emit_guard(LowerCtx &ctx, LazyMember lzm):
    int lz_mat_bb = new_block(&ctx)
    int lz_join_bb = new_block(&ctx)
    # flag true → already materialized → skip to join.
    set_terminator(&ctx, GTBranch(OpCopy(lzm.flag), lz_join_bb, lz_mat_bb))
    switch_to(&ctx, lz_mat_bb)
    int lz_tmp = add_local(&ctx, lzm.slot_type, None)
    Vector[Operand] lz_args = [OpBorrow(lzm.slot)]
    emit(&ctx, GICallExtern(lz_tmp, lzm.clone_fn, lz_args))
    emit(&ctx, GIAssign(lzm.slot, OpMove(lz_tmp)))
    emit(&ctx, GIAssign(lzm.flag, OpConstBool(true)))
    set_terminator(&ctx, GTJump(lz_join_bb))
    switch_to(&ctx, lz_join_bb)

# Materialize every live lazy member keyed by `root` (the mutated
# collection's root identifier name) — the family-wide form every
# mutation hook calls. "" (unidentifiable root) is a no-op: families
# are only ever keyed by plain identifiers (cow_source_root_name).
void cow_lazy_materialize_family(LowerCtx &ctx, String root):
    if root == "":
        return
    int lzf_i = 0
    while lzf_i < ctx.cow_lazy_members.len():
        LazyMember lzf_m = ctx.cow_lazy_members.get(lzf_i).unwrap()
        if lzf_m.root == root:
            cow_lazy_emit_guard(&ctx, lzf_m)
        lzf_i = lzf_i + 1

# Materialize the ONE member whose value slot is `slot` (the for-string
# derivation join: the loop's per-iteration codepoint views alias the
# source slot's buffer, so a lazy source materializes AT LOOP ENTRY).
void cow_lazy_materialize_slot(LowerCtx &ctx, int slot):
    int lzs_i = 0
    while lzs_i < ctx.cow_lazy_members.len():
        LazyMember lzs_m = ctx.cow_lazy_members.get(lzs_i).unwrap()
        if lzs_m.slot == slot:
            cow_lazy_emit_guard(&ctx, lzs_m)
        lzs_i = lzs_i + 1

# Derivation join (a) — the returns_view choke point's bookkeeping. A
# view RESULT whose receiver slot is a lazy family member aliases the
# same not-yet-materialized element buffer the member does, so it JOINS
# the family with its OWN flag (seeded false here, at the result's
# birth): a later mutation of the family root materializes the member
# AND every view derived from it in place. The joined temp is
# STATEMENT-scoped (stmt_scoped=true) — it retires after the enclosing
# statement (cow_lazy_retire_stmt_temps below). Chained view methods
# join transitively (the first temp becomes a member, so the next
# receiver check finds it). Returns true iff the receiver was a member,
# so the call site can apply the typed drop override
# (register_lazy_slot_for_drop) to the joined slot.
#
# Lives HERE as a standalone helper, not inline at the lower_expr.gg
# tag site: lower_expr_inner is the CLIFF-CRITICAL frame of the
# bootstrap's deepest recursion (lower_expr <-> lower_expr_inner on long
# concat chains), and at -O0 every function-scope C local costs frame
# bytes — inlining this loop's locals there once pushed the frame over
# the stack cliff and crashed stage-1. That crash was originally
# misdiagnosed as a block-param-threading MISCOMPILE; the Chain-E scout
# REFUTED that (0 bp-edge mismatches; output byte-identical under a
# raised ulimit — a pure stack-capacity cliff, since closed by dead-decl
# elision [Fix A] + the 64MB pthread main [Fix B]). Out-of-line remains
# the right shape: it keeps the hot frame small.
bool cow_lazy_join_view_result(LowerCtx &ctx, int recv_slot, int result_slot, int result_type):
    int lzj_i = 0
    int lzj_n = ctx.cow_lazy_members.len()
    while lzj_i < lzj_n:
        LazyMember lzj_m = ctx.cow_lazy_members.get(lzj_i).unwrap()
        if lzj_m.slot == recv_slot:
            int lzj_flag = add_local(&ctx, BOOL_TYPE, None)
            emit(&ctx, GIAssign(lzj_flag, OpConstBool(false)))
            ctx.cow_lazy_members.push(LazyMember(lzj_m.root.clone(), result_slot, lzj_flag, result_type, lzj_m.clone_fn.clone(), true))
            return true
        lzj_i = lzj_i + 1
    return false

# Retire statement-scoped family TEMPS (derivation-join view temps die
# with their statement; a later guard for a dead slot is dead weight).
# Called from lower_stmts after each statement.
void cow_lazy_retire_stmt_temps(LowerCtx &ctx):
    int lzr_i = 0
    while lzr_i < ctx.cow_lazy_members.len():
        if ctx.cow_lazy_members.get(lzr_i).unwrap().stmt_scoped:
            ctx.cow_lazy_members.remove(lzr_i)
        else:
            lzr_i = lzr_i + 1

# ── Operand-mode dispatch (Phase C step 5c + Path A Phase 2b) ───
#
# `op_consume` picks the right operand mode for reading `lid` at a
# position whose semantics are described by the typed `ConsumeKind`
# argument. It enforces the *Ownership at Consuming Positions*
# discipline from CLAUDE.md:
#
#   • Non-consume position (CkCallArgBorrow / CkBinOpArg / CkFormatArg /
#     CkMatchPtr) — receiver just reads the value; source stays live.
#     Always returns `OpBorrow(lid)` regardless of source ownership.
#     Phase 2c emission will treat this as a pointer alias. The
#     CkCallArgBorrow inclusion implements the doc model directly: per
#     CLAUDE.md "Ownership at Consuming Positions", bare-call-arg sites
#     propagate Ptr aliases at zero cost; clones only fire at the
#     CkCallArgOwning sites (collection runtime val args + `!T` declared
#     params).
#   • Consume position (CkAssign / CkReturn / CkCallArgOwning /
#     CkFieldWrite) — receiver takes ownership. Dispatch by source:
#       - Non-resource source     → OpCopy (byte-copy is sound for
#         scalars and Ptr/MutPtr aliases; the validator already filters
#         these out).
#       - LoBorrowed/LoView source → OpBorrow (the alias propagates; no
#         ownership transfer at this layer. Phase 2c will flip this to
#         OpClone — the receiver must materialise its own copy).
#       - LoOwned/LoParam/LoMaybeOwned resource → OpMove (the post-pass
#         `wire_liveness_into_modes` may demote to OpClone if not the
#         CFG-last use of `lid`).
#
# Phase 2b — `ConsumeKind` enum (typed metadata) replaces the
# implicit "every op_consume caller is consuming" boolean sidecar.
# Per CLAUDE.md "No name matching" + layering rule 2: each call site
# explicitly names its kind; ambiguous shapes (nested method calls
# whose mutating-status depends on the callee) STOP and file as TODO
# rather than defaulting to consume-with-conservative-clone.
#
# OpClone now emits a real runtime clone call (`lir_lower.gg:2453-2521`);
# OpMove/OpBorrow/OpCopy still lower to `ISlotLoad`. The ownership labels
# written here are the contract that drives clone vs load vs addr selection
# in `lir_lower.gg:2349-2521`.

# Callee-signature-driven classifier for regular call args.
# Returns CkCallArgOwning iff `fname` is in fn_move_params AND the
# `arg_idx`-th param is declared `!T` (OWN_MOVE / ownership==2).
# Otherwise returns CkCallArgBorrow — per CLAUDE.md "Ownership at
# Consuming Positions", bare-`T` callee params propagate the caller's
# Ptr alias at zero cost. Mirrors Rust's `lower_call_arg` switching on
# `param.ownership` (`src/ir/lowering/exprs/calls.rs:187-194`).
#
# Sites that ALWAYS own (collection runtime val args for push/put/set/
# insert/send) bypass this helper and pass CkCallArgOwning directly.
# Sites whose callee signature is genuinely unknown (closure/__callable_N
# dispatch, user-op-overload fallback) pass CkCallArgBorrow directly —
# borrow is the safe default per the docs.
ConsumeKind classify_call_arg(GirModule &gmod, String fname, int arg_idx):
    if not gmod.fn_move_params.contains(fname):
        return CkCallArgBorrow()
    Vector[bool] mflags = gmod.fn_move_params.get(fname).unwrap()
    if arg_idx < 0 or arg_idx >= mflags.len():
        return CkCallArgBorrow()
    if mflags.get(arg_idx).unwrap():
        return CkCallArgOwning()
    return CkCallArgBorrow()

# Partition `ConsumeKind` into consume vs borrow positions. Single
# source of truth for which kinds transfer ownership — every other
# pass that asks "is this a consume site?" reads through here.
bool is_consume_kind(ConsumeKind k):
    match k:
        case CkAssign():
            return true
        case CkReturn():
            return true
        case CkCallArgOwning():
            return true
        case CkFieldWrite():
            return true
        case CkCallArgBorrow():
            return false
        case CkBinOpArg():
            return false
        case CkFormatArg():
            return false
        case CkMatchPtr():
            return false

Operand op_consume(LowerCtx &ctx, GirModule &gmod, int lid, ConsumeKind kind):
    if lid < 0 or lid >= ctx.locals.len():
        return OpCopy(lid)
    # Non-consume position: unconditional borrow. Liveness/ownership
    # state is irrelevant — the receiver just reads through the alias.
    if not is_consume_kind(kind):
        return OpBorrow(lid)
    GirLocal loc = ctx.locals.get(lid).unwrap()
    int tid = loc.type_id
    # Primitives and pointer-typed slots: byte-copy is sound. The
    # validator's `resolve_type_name` returns "" for these so they
    # never produce violations; keep OpCopy for honest GIR labelling.
    if tid < PRIM_COUNT:
        return OpCopy(lid)
    if tid >= gmod.type_table.len():
        return OpCopy(lid)
    GirType gt = gmod.type_table.get(tid).unwrap()
    String tname = ""
    match gt:
        case GtNamed(n):
            tname = n
        case GtPtr(inner_tid):
            # Phase 2.3: Ptr(T) at a consume position. When T is a
            # resource type, the source slot HOLDS A POINTER to the
            # resource (the value lives elsewhere); a byte-copy would
            # produce an aliased Ptr-to-resource — the same buffer
            # would be reachable through two slots. When the consumer
            # demands ownership (CkAssign / CkReturn / CkCallArgOwning
            # / CkFieldWrite), emit OpClone to materialise a fresh
            # owned T at the receiver via deref+clone-through. For
            # Ptr to non-resource (e.g. Ptr-to-int, Ptr-to-FnPtr, or
            # Ptr-to-aggregate-of-primitives) the byte-copy of the
            # pointer is sound — fall through to OpCopy via the
            # helper.
            return decide_ptr_consume(&gmod, lid, inner_tid)
        case GtMutPtr(inner_tid):
            # MutPtr(T) at a consume position. `&`-borrow AND `!`-move
            # resource params BOTH lower to MutPtr(T) (one slot kind,
            # `owning_param` distinguishes them — mirrors Rust `ir/mod.rs`
            # Local + `functions.rs` param setup). At INITIAL lowering we
            # have no liveness, so we conservatively clone-through here:
            # like the Ptr(T) arm and Rust's `ensure_owned_at_consuming_arg`
            # (borrow-state source → clone, never shallow-alias —
            # `context.rs:1953-1987`), materialise a fresh owned T via
            # deref+clone-through. The CFG-aware wire pass
            # (`decide_operand_at_consuming_arg`'s GtMutPtr arm) then
            # RE-DECIDES with liveness in hand and PROMOTES an owning
            # `!`-param at its LAST USE to OpMove (forwarding the pointer +
            # suppressing the exit drop) — so the last-use move is realised
            # there, not deferred. decide_ptr_consume keeps OpCopy for
            # non-resource pointees (MutPtr-to-int etc.), so this is inert
            # there. Reaching here at all implies a consume kind —
            # non-consume kinds returned OpBorrow at the top of this fn.
            # Without the clone fallback (for `&`-borrows and non-last-use
            # `!`-consumes), a `!`-param consumed into Box/push/field-init
            # shallow-aliased the pointee, and drop emission then freed it →
            # dangle (bug #3).
            return decide_ptr_consume(&gmod, lid, inner_tid)
        else:
            # GtFnPtr / GtTuple / etc. — byte-copy of a pointer is just
            # a pointer copy, not a resource copy. Validator filters
            # these too.
            return OpCopy(lid)
    if not is_resource_type_name(tname, &gmod):
        # Move-axis follows drop-axis (drop keystone ③ alignment). A mono'd
        # Option/Result LOCAL whose payload owns a resource is NOT a resource
        # by `is_resource_type_name` (it's deliberately kept out of
        # optionlike_resource_types so the by-value ABI is unchanged) — yet
        # `is_droppable_type` registers it for whole-drop at scope exit. If we
        # byte-copied it out here (OpCopy) the consumer would own the SAME heap
        # the scope-exit whole-drop frees → UAF / double-free. So when the drop
        # axis owns this value, the move axis must too: route it exactly like
        # the resource path below (borrow/view → clone, owned → move). The
        # oracle drives move-vs-copy off `needs_drop` uniformly; this mirrors it.
        if is_droppable_type(tid, &gmod):
            match loc.ownership:
                case LoBorrowed():
                    return OpClone(lid)
                case LoView():
                    return OpClone(lid)
                else:
                    return OpMove(lid)
        return OpCopy(lid)
    # Resource source at a consume position: pick mode by ownership.
    # a-5 (clone-on-borrow) — WIRED. We only reach here for a genuine
    # consume kind (the non-consume kinds returned OpBorrow at the top
    # of this fn). A borrow/view does NOT own its data, so transferring
    # it to an owning destination (assign / return / field-init /
    # collection-put) MUST materialise an independent copy — otherwise
    # the destination shallow-aliases the borrow's buffer and both free
    # it (the meta_expand `result.push(borrowed_stmt)` →
    # `m.items.set(i, new_fn)` double-free). Mirrors Rust's
    # `ensure_owned_at_consuming_arg` borrowed/Ptr-source arm
    # (`src/ir/lowering/exprs/methods.rs:1862-1867`: "(a) Ptr(inner) args
    # — always clone; (b) non-last-use resource args — clone"). OpClone
    # materialises end-to-end at lir_lower.gg's OpClone handler
    # (value-struct slot → `T__clone`/`gorget_*_clone` via ISlotAddr;
    # ptr-to-struct slot → clone the pointee).
    match loc.ownership:
        case LoBorrowed():
            return OpClone(lid)
        case LoView():
            return OpClone(lid)
        else:
            return OpMove(lid)

# ── Consume-position materialization decision (Phase 2.1) ────────────
#
# Mirrors Rust's `ensure_owned_at_consuming_arg`
# (`src/ir/lowering/context.rs:1913`). Where Rust both DECIDES the
# operand mode AND emits the clone call inline, this self-host port
# splits the two concerns: this function returns the OperandMode label
# only; Phase 2c clone-emission (deferred — see `flush_drop_queue`
# docstring + `clone-emission-at-calls.md`) will produce the actual
# `GICall(<T>__clone, ...)` at the receiving sites. The function name
# is `decide_operand_at_consuming_arg` rather than Rust's
# `ensure_owned_*` to reflect that split: this layer decides the mode,
# downstream phases materialize the clone.
#
# **Status**: dead code in this commit. No caller exists. The
# wire-up across the 7 ad-hoc aliasing fixes (Classes 1-7 from the
# Phase 2c COMMIT 3 reverts) lands in Phases 2.3.a through 2.3.g; the
# last-use information consumed by the by-value-resource branch is
# threaded in Phase 2.2 (see the `is_last_use` param docstring).
#
# **Inputs**:
#   ctx          - LowerCtx (read-only here; future wiring may emit)
#   gmod         - GirModule (for resource-type classification)
#   src_lid      - source local id
#   src_ty       - source local's GirType (passed by caller; avoids
#                  re-fetching from `ctx.locals.get(src_lid)`)
#   reason       - String describing the consume position (e.g.
#                  "Box.new arg", "v.push arg", "field init") — kept
#                  for parity with Rust's `ImplicitCloneReason`; will
#                  feed diagnostics when Phase 2c wires `warn_implicit_
#                  clone` style reporting. Unused in 2.1.
#   is_last_use  - whether this read is the CFG-last use of `src_lid`.
#                  Threaded by callers via the Phase 2.2 last-use
#                  consult (the `last_use_of_op` decision map produced
#                  by `compute_liveness`). For Phase 2.1, no caller
#                  provides this — the parameter exists in the
#                  signature so Phase 2.3.a wire-ups don't reshape it.
#
# **Decision tree** (matches Rust + `clone-emission-at-calls.md`):
#   1. Primitive / non-resource source        → OpCopy (byte-copy sound)
#   2. Ptr(T) where T is a resource type      → OpClone (deref +
#                                                 materialize through the
#                                                 pointer — the source
#                                                 doesn't own the buffer)
#   3. By-value resource source:
#        - LoOwned + is_last_use = true       → OpMove (source dies;
#                                                 receiver takes the
#                                                 buffer; drop_elab
#                                                 elides the guard)
#        - everything else                    → OpClone
#            (LoBorrowed/LoView source aliases a borrow; LoParam is
#             the caller's responsibility; LoMaybeOwned is a
#             conservative join over branches; LoOwned-not-last-use
#             needs to stay valid past this read — all require a
#             materialised buffer at the receiver.)
#   4. Default                                → OpCopy
#
# Why the strict reading (LoOwned-only) on the move-eligible side. The
# old inline logic at `wire_one_operand` (see the rationale comment at
# lower.gg:1863-1869) dropped LoParam and LoMaybeOwned from the OpMove
# set: LoParam denotes slots whose ownership escapes the function's
# stack frame (the caller owns); LoMaybeOwned is a join over conflicting
# branches. Treating either as move-eligible would compile but
# spuriously drop someone else's data once Phase 2c flips emission. The
# strict reading matches Rust's `AssignMode::Move` discipline at
# consume sites.
#
# Ptr/MutPtr/FnPtr aliases at consume positions resolve as OpCopy: a
# pointer byte-copy is a pointer copy, not a resource copy. The
# validator filters these out separately.
Operand decide_operand_at_consuming_arg(LowerCtx &ctx, GirModule &gmod, int src_lid, GirType src_ty, String reason, bool is_last_use):
    # Touch `reason` so the unused-param warning doesn't fire while
    # this helper is dead code. Phase 2.3.a will route this into
    # `warn_implicit_clone` style diagnostics at the wire-up sites.
    int _reason_len = reason.len()
    if src_lid < 0 or src_lid >= ctx.locals.len():
        return OpCopy(src_lid)
    # Case 1: primitive / non-resource. Byte-copy is sound.
    match src_ty:
        case GtPtr(inner):
            # Case 2: Ptr(T). Clone-through if T is a resource;
            # otherwise plain pointer byte-copy.
            return decide_ptr_consume(&gmod, src_lid, inner)
        case GtMutPtr(inner):
            # Case 2b: MutPtr(T). `&`-borrow AND `!`-move resource params
            # both lower to MutPtr(T) — the typed `owning_param` bit
            # (`GirLocal.owning_param`, set by `register_owning_param`)
            # is the SOLE discriminator between them (see op_consume's
            # GtMutPtr arm + the field docstring at gir.gg:273-287, which
            # names THIS site as reader (D)).
            #
            # An owning `!`-param at its CFG LAST USE that is transferred
            # ONWARD (passed `!` to another consuming call) must MOVE, not
            # clone: the slot already holds a `T*`; OpMove forwards that
            # pointer and triggers the caller's `mark_local_moved` +
            # `GIMoveZero`→`IMoveSlot`, flipping the param slot's drop flag
            # to dead so the function-exit drop is suppressed. Cloning here
            # instead would materialise a fresh `T` for the callee (which
            # the callee drops) AND leave the param slot live for the exit
            # drop → the resource is DOUBLE-DROPPED (the callee's drop + the
            # caller's exit drop). Mirrors Rust's `is_owning_param`
            # onward-move fast-path (`lower_call_arg`, calls.rs:90-105:
            # forward the pointer, schedule a post-call MoveZero, return
            # `copy(local_id)` — never clone). The existing drop-flag
            # dataflow in drop_elab does the rest; no re-architecture needed.
            #
            # Everything else stays clone-through: a `&`-borrow doesn't own
            # the pointee (cloning is the only sound transfer to an owning
            # destination), and a `!`-param consumed while LIVE PAST this
            # use must materialise. A non-droppable pointee (primitive /
            # non-resource) has no drop to double, so it byte-copies via
            # `decide_ptr_consume`.
            GirLocal mloc = ctx.locals.get(src_lid).unwrap()
            if mloc.owning_param and is_last_use and is_droppable_type(inner, &gmod):
                return OpMove(src_lid)
            return decide_ptr_consume(&gmod, src_lid, inner)
        case GtFnPtr(_, _):
            # Function pointer: not a resource. Byte-copy.
            return OpCopy(src_lid)
        case GtNamed(tname):
            if not is_resource_type_name(tname, &gmod):
                # Move-axis follows drop-axis (drop keystone ③ alignment),
                # mirroring op_consume's same-named branch. A mono'd
                # Option/Result LOCAL whose payload owns a resource is droppable
                # (registered for whole-drop at scope exit) but is NOT
                # resource-named (kept out of optionlike_resource_types to
                # preserve the by-value ABI). This post-pass RE-DECIDES the mode
                # for every OpMove/OpClone operand op_consume produced, so it
                # MUST recognise the same set — otherwise it demotes the
                # consume-position OpMove back to OpCopy (byte-copy out) while
                # the source stays whole-drop-registered → UAF / double-free.
                # Routing it as OpMove here also triggers the caller's
                # mark_local_moved + GIMoveZero, which is exactly the scope-exit
                # drop exclusion we need (so the var-decl/assign/push/field-write
                # positions get the same exclusion SReturn wires explicitly).
                GirLocal dloc = ctx.locals.get(src_lid).unwrap()
                if is_droppable_type(dloc.type_id, &gmod):
                    match dloc.ownership:
                        case LoOwned():
                            if is_last_use:
                                return OpMove(src_lid)
                            return OpClone(src_lid)
                        case LoBorrowed():
                            return OpClone(src_lid)
                        case LoView():
                            return OpClone(src_lid)
                        else:
                            return OpClone(src_lid)
                return OpCopy(src_lid)
            # Case 3: by-value resource. Branch on ownership.
            # LoOwned-strict: only true-owned slots are move-eligible
            # (and only at their CFG last use). LoParam (caller owns),
            # LoMaybeOwned (conservative join), LoBorrowed (alias),
            # LoView (cap=0 alias) all require OpClone — see the
            # rationale paragraph in the docstring above and the
            # archived inline comment at lower.gg:1863-1869.
            GirLocal loc = ctx.locals.get(src_lid).unwrap()
            match loc.ownership:
                case LoOwned():
                    if is_last_use:
                        return OpMove(src_lid)
                    return OpClone(src_lid)
                else:
                    return OpClone(src_lid)
        else:
            # GtBool / GtI* / GtU* / GtF* / GtUnit — primitives. Note
            # the early `tid < PRIM_COUNT` shortcut in op_consume's
            # mirror logic uses type-id; here we match on GirType
            # variants directly. Both reach the same OpCopy verdict.
            return OpCopy(src_lid)
    # Unreachable — match above is exhaustive over GirType. The default
    # OpCopy is the conservative fall-through if the enum gains a new
    # variant before this helper is updated.
    return OpCopy(src_lid)

# Helper for the Ptr(T) branch of `op_consume` (and the dead-code
# `decide_operand_at_consuming_arg`). Split out so the inner-type
# lookup + resource check stay readable inside the outer match.
# Mirrors Rust's `if let Some(inner) = self.pointee_type(arg_type)`
# arm at context.rs:1928.
#
# Phase 2.3 (2026-05-22): now WIRED into `op_consume`'s GtPtr branch.
# Returns OpClone(src_lid) for Ptr-to-resource at consume positions —
# the lir_lower OpClone handler then emits a deref+clone via the
# pointee type's `gorget_<T>__clone` / `<T>__clone` runtime symbol.
# For Ptr-to-non-resource (primitives, FnPtr, aggregate-of-primitives)
# falls through to OpCopy: byte-copy of a pointer is just a pointer
# copy.
Operand decide_ptr_consume(GirModule &gmod, int src_lid, int inner_tid):
    # Primitive pointee — byte-copy the pointer.
    if inner_tid < 0 or inner_tid < PRIM_COUNT:
        return OpCopy(src_lid)
    if inner_tid >= gmod.type_table.len():
        return OpCopy(src_lid)
    GirType inner_gt = gmod.type_table.get(inner_tid).unwrap()
    match inner_gt:
        case GtNamed(iname):
            if is_resource_type_name(iname, &gmod):
                # Ptr to a resource: deref + clone materializes a
                # fresh owned T at the receiver side. Phase 2.3
                # emission will lower this to a `<T>__clone(&src)`
                # call.
                return OpClone(src_lid)
            # Leak 1 (#8-residual): a Ptr to a DROPPABLE USER AGGREGATE
            # (`Option[String]`/`Result[_,_]`/resource-struct — droppable
            # but NOT a runtime resource, so `is_resource_type_name` is
            # false) at an OWNING consume must ALSO deref+clone: the source
            # is a borrow alias into a collection element (the Branch A-agg
            # borrow-flip), and transferring it to an owning destination
            # (push/return/ctor/field-store) shallow-aliases the element's
            # heap → the array-free elem_drop + the consumer's drop both
            # free it (RUN-proven heap-use-after-free when a borrow-flipped
            # `back` ESCAPES). OpClone deref-clones the pointee via the LIR
            # `resource_clone_fn` (`recursive_drop_structs/enums` →
            # `T__clone`, lir_lower.gg:2243) → the consumer owns an
            # independent copy. Mirrors `op_consume`'s `is_droppable_type`
            # non-resource arm (:1667). Typed droppability test, not a name
            # match. (A read-only borrow-flipped bind never reaches a
            # consume kind here — op_consume returns OpBorrow at non-consume
            # positions — so this only fires on a genuine escape.)
            if is_droppable_type(inner_tid, &gmod):
                return OpClone(src_lid)
            return OpCopy(src_lid)
        else:
            return OpCopy(src_lid)

# Lower a `suite setup` / `suite teardown` block body into a void GIR
# function (`__suite_setup` / `__suite_teardown`). Mirrors the test-body
# lowering path (the `ITest` case): same LowerCtx setup, function-scope drop
# frame, CoW scan, statement lowering, and unit-return finalization. The
# previous stub emitted an EMPTY body, so a `suite setup: print("SETUP")`
# never ran. Mirrors Rust gg's suite-setup/teardown lowering
# (`src/ir/lowering/mod.rs:3030`/`:3055`).
GirFunction lower_suite_body(String fn_name, Vector[Stmt] body, GirModule &gmod):
    Vector[int] _sb_lc_stk = []
    Vector[int] _sb_lb_stk = []
    Dict[String, int] _sb_named_locals = {}
    Vector[DropScope] _sb_de_scopes = []
    Vector[DropEmission] _sb_de_queue = []
    Vector[Vector[Stmt]] _sb_on_err_blocks = []
    Dict[String, bool] _sb_cow_mut = {}
    Dict[String, int] _sb_cow_span = {}
    Dict[String, bool] _sb_cow_clo = {}
    # suite setup/teardown bodies are void, non-throws → fn_is_throws=false.
    LowerCtx sctx = LowerCtx([], [], [], 0, !_sb_named_locals, !_sb_lc_stk, !_sb_lb_stk, "", "", "", false, fn_name.clone(), DropElaborator(!_sb_de_scopes), !_sb_de_queue, -1, !_sb_on_err_blocks, false, !_sb_cow_mut, !_sb_cow_span, !_sb_cow_clo, {}, [], {}, None, None, None, false, {}, {}, "", {}, false, 0, [], [])
    Vector[Instruction] sinit = []
    sctx.block_insts.push(!sinit)
    sctx.block_terms.push(GTNone())
    push_drop_scope(&sctx.drop_elab, DSK_FUNCTION)
    add_local(&sctx, UNIT_TYPE, None)
    Vector[Param] _sb_no_params = []
    compute_cow_scan(&sctx, &gmod, _sb_no_params, body)
    lower_stmts(&sctx, body, &gmod, false)
    Terminator sterm = sctx.block_terms.get(sctx.current_block).unwrap()
    match sterm:
        case GTNone():
            emit_drops_for_early_exit(&sctx, DSK_FUNCTION, Some(0))
            set_terminator(&sctx, GTReturn(OpConstUnit()))
        else:
            pass
    # Route through the shared function-body finalizer (pop drop frame →
    # compute_liveness → wire_liveness_into_modes → flush_drop_queue →
    # assemble). A suite setup/teardown body is a full function and MUST run
    # the same liveness finalization so last-use consumes become MOVES (source
    # zeroed) — the previous inline pop+assembly OMITTED wire_liveness_into_modes,
    # leaving moved-from sources registered → over-drop (same class as the
    # test-body path). SINGLE source of truth for the block-assembly idiom.
    Vector[BasicBlock] sblocks = finalize_body_blocks(&sctx, &gmod, fn_name)
    Vector[int] sparams = []
    return GirFunction(fn_name.clone(), !sparams, UNIT_TYPE, sctx.locals, !sblocks, [], [])

# ── Module lowering ──────────────────────────────────────

# ── Pass 2.6: LHS-type-driven `.collect()` target selection ───────────
#
# Mirrors Rust gg's `apply_collect_target_rewrites`
# (src/semantic/typecheck.rs:6496, wired at src/semantic/mod.rs:283 as
# "Pass 2.6", after resolve, before lowering). A pure-AST rewrite: when a
# VarDecl's declared type is `Set[T]` (or `HashSet[T]`) and its RHS is a
# `.collect()` method call, the method name is swapped to `to_set` so IR
# lowering dispatches the Set-targeted `Iterator[T]::to_set(&self)` trait
# default (lib/std/iter.gg:115) instead of the Vector-targeted
# `collect(&self)`. The `Dict[K, V]` / `HashMap[K, V]` case swaps to
# `to_dict` and lifts K,V from the LHS onto the call's generic args
# (lib/std/iter.gg:131). The decision reads the declared type off the
# AST directly (TYPED metadata, no name-matching of the receiver) — no
# resolved TypeId needed, so this runs before typecheck.
#
# Self-host runs this at the top of lower_module (the only consumer of
# the rewritten AST). The Rust ordering (rewrite → typecheck → lower) is
# preserved in effect: the self-host typecheck takes `Module` by value
# and does not feed its (un-rewritten) copy forward, so rewriting before
# the GIR lowering that lower_module performs is equivalent.
void apply_collect_target_rewrites(Module &m):
    # One source of truth for the rewrite's expected-type knowledge: build a
    # free-function signature map (fn name → param SpannedTypes) so the
    # call-argument position can recover the param's declared type without a
    # resolver query. The Set/Dict generic args travel intact as SpannedTypes
    # (the very thing the swap needs), so the SAME `collect_rewrite_expr_expected`
    # decision serves EVERY position — VarDecl RHS, return, assignment, and
    # call-arg — instead of the VarDecl-only rewrite Rust's AST-walk performs.
    Dict[String, Vector[SpannedType]] fn_param_types = {}
    int fi = 0
    while fi < m.items.len():
        match m.items.get(fi).unwrap():
            case IFunction(sigdef):
                Vector[SpannedType] ptys = Vector[SpannedType]()
                for p in sigdef.params:
                    ptys.push(p.param_type)
                fn_param_types.put(sigdef.name.clone(), ptys)
            else:
                pass
        fi = fi + 1
    int i = 0
    while i < m.items.len():
        match m.items.get(i).unwrap():
            case IFunction(fdef):
                Vector[Stmt] nb = collect_rewrite_stmts(fdef.body, fdef.return_type, &fn_param_types)
                m.items.set(i, IFunction(FunctionDef(fdef.name, fdef.params, fdef.return_type, fdef.type_params, nb, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub)))
            case IEquip(eqblk):
                Vector[FunctionDef] nm = Vector[FunctionDef]()
                int mi = 0
                while mi < eqblk.methods.len():
                    FunctionDef method = eqblk.methods.get(mi).unwrap()
                    Vector[Stmt] mnb = collect_rewrite_stmts(method.body, method.return_type, &fn_param_types)
                    nm.push(FunctionDef(method.name, method.params, method.return_type, method.type_params, mnb, method.is_expr_body, method.throws_type, method.is_extern_stub))
                    mi = mi + 1
                m.items.set(i, IEquip(EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, nm, eqblk.via_field, eqblk.trait_generic_args)))
            case ITrait(tdef):
                Vector[FunctionDef] tnm = Vector[FunctionDef]()
                int ti = 0
                while ti < tdef.methods.len():
                    FunctionDef tmethod = tdef.methods.get(ti).unwrap()
                    Vector[Stmt] tnb = collect_rewrite_stmts(tmethod.body, tmethod.return_type, &fn_param_types)
                    tnm.push(FunctionDef(tmethod.name, tmethod.params, tmethod.return_type, tmethod.type_params, tnb, tmethod.is_expr_body, tmethod.throws_type, tmethod.is_extern_stub))
                    ti = ti + 1
                m.items.set(i, ITrait(TraitDef(tdef.name, tdef.type_params, tnm, tdef.parent_traits)))
            else:
                pass
        i = i + 1

# Rewrite a single value-position expression against its EXPECTED type. The
# ONE decision the whole rewrite turns on: when the expression is a top-level
# `.collect()` whose enclosing context demands a Set/Dict, swap the method —
# `Set[T]` / `HashSet[T]` (one arg) → `to_set`; `Dict[K, V]` / `HashMap[K, V]`
# (two args) → `to_dict[K, V]` with K,V lifted from the expected type. Reading
# the expected type's generic args directly (TYPED metadata, no name-matching
# of the receiver) is why this one function serves ALL positions — VarDecl RHS,
# return, assignment, and call-arg. Then descend into the statement-bearing
# sub-forms so nested VarDecls / returns are reached.
SpannedExpr collect_rewrite_expr_expected(SpannedExpr sexpr, SpannedType expected, Dict[String, Vector[SpannedType]] &fn_param_types):
    Span ispan = sexpr.span
    match sexpr.expr:
        case EMethodCall(recv, mname, margs, marg_names, mtargs):
            String new_name = mname
            Vector[SpannedType] new_targs = mtargs
            if mname == "collect":
                match expected.ty:
                    case TNamed(tn, targs):
                        if (tn == "Set" or tn == "HashSet") and targs.len() == 1:
                            new_name = "to_set"
                        elif (tn == "Dict" or tn == "HashMap") and targs.len() == 2:
                            new_name = "to_dict"
                            new_targs = targs
                        else:
                            pass
                    else:
                        pass
            # Rebox the receiver via deref (`*recv`) — the ownership-decided
            # reconstruction idiom (cf. meta.gg `subst_expr`:481). Moving the
            # Box binding directly (`!recv`) reads as an untracked source at the
            # EnumInit consume site.
            return SpannedExpr(EMethodCall(Box(*recv), new_name, margs, marg_names, new_targs), ispan)
        else:
            return SpannedExpr(collect_rewrite_expr(sexpr.expr, &fn_param_types), ispan)

# Recursively rebuild a statement list. `ret_ty` is the enclosing function's
# declared return type (the expected type for an `SReturn`); `locals` tracks
# declared types of in-scope `SVarDecl`s so an `SAssign` to a typed local
# recovers its expected type. Descends into nested control-flow bodies
# (mirrors Rust `walk_stmt`/`walk_block`) — but unlike Rust, the rewrite fires
# in EVERY value position, not only VarDecl RHS.
Vector[Stmt] collect_rewrite_stmts(Vector[Stmt] stmts, SpannedType ret_ty, Dict[String, Vector[SpannedType]] &fn_param_types):
    Vector[Stmt] result = Vector[Stmt]()
    Dict[String, SpannedType] locals = {}
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        match s:
            case SVarDecl(stype, name, init_expr, a, b, c):
                SpannedExpr new_init = collect_rewrite_expr_expected(init_expr, stype, &fn_param_types)
                locals.put(name.clone(), stype)
                result.push(SVarDecl(stype, name, new_init, a, b, c))
            case SReturn(opt):
                match opt:
                    case Some(re):
                        result.push(SReturn(Some(collect_rewrite_expr_expected(re, ret_ty, &fn_param_types))))
                    case None:
                        result.push(s)
            case SAssign(tgt, val):
                # Assignment to a bare local whose declared type we tracked is
                # the local's type; otherwise no expectation (descend only).
                bool asn_done = false
                match tgt.expr:
                    case EIdentifier(tname):
                        if locals.contains(tname):
                            result.push(SAssign(tgt, collect_rewrite_expr_expected(val, locals.get(tname).unwrap(), &fn_param_types)))
                            asn_done = true
                    else:
                        pass
                if not asn_done:
                    result.push(SAssign(tgt, SpannedExpr(collect_rewrite_expr(val.expr, &fn_param_types), val.span)))
            case SExpr(e):
                result.push(SExpr(SpannedExpr(collect_rewrite_expr(e.expr, &fn_param_types), e.span)))
            case SIf(cond, then_b, else_branches):
                Vector[Stmt] nt = collect_rewrite_stmts(then_b, ret_ty, &fn_param_types)
                Vector[ElseBranch] nbr = Vector[ElseBranch]()
                int ei = 0
                while ei < else_branches.len():
                    ElseBranch eb = else_branches.get(ei).unwrap()
                    nbr.push(ElseBranch(eb.condition, collect_rewrite_stmts(eb.body, ret_ty, &fn_param_types)))
                    ei = ei + 1
                result.push(SIf(cond, nt, nbr))
            case SWhile(cond, body, else_b):
                result.push(SWhile(cond, collect_rewrite_stmts(body, ret_ty, &fn_param_types), collect_rewrite_stmts(else_b, ret_ty, &fn_param_types)))
            case SLoop(body):
                result.push(SLoop(collect_rewrite_stmts(body, ret_ty, &fn_param_types)))
            case SFor(pat, iter_expr, body, own, else_b):
                result.push(SFor(pat, iter_expr, collect_rewrite_stmts(body, ret_ty, &fn_param_types), own, collect_rewrite_stmts(else_b, ret_ty, &fn_param_types)))
            case SMatch(scrut, arms):
                Vector[MatchArm] narms = Vector[MatchArm]()
                int ai = 0
                while ai < arms.len():
                    MatchArm arm = arms.get(ai).unwrap()
                    narms.push(MatchArm(arm.pattern, arm.guard, collect_rewrite_stmts(arm.body, ret_ty, &fn_param_types)))
                    ai = ai + 1
                result.push(SMatch(scrut, narms))
            case SWith(wexpr, wname, body):
                result.push(SWith(wexpr, wname, collect_rewrite_stmts(body, ret_ty, &fn_param_types)))
            case SNamedScope(sname, body):
                result.push(SNamedScope(sname, collect_rewrite_stmts(body, ret_ty, &fn_param_types)))
            else:
                result.push(s)
        i = i + 1
    return result

# Recurse into expression sub-trees, applying the call-argument rewrite (each
# arg expected against the callee's resolved param type) and descending through
# every statement-bearing form (closures / blocks / do / if-expr / match-expr).
# No expected type is in scope here, so a `.collect()` is only rewritten where a
# nested position re-establishes one (a call arg, or a statement-list arm).
Expr collect_rewrite_expr(Expr e, Dict[String, Vector[SpannedType]] &fn_param_types):
    match e:
        case ECall(callee_box, cargs, carg_names, ctargs):
            # Free-call args: rewrite each against the callee's declared param
            # type when the callee is a known free function.
            String callee_name = ""
            match (*callee_box).expr:
                case EIdentifier(cn):
                    callee_name = cn
                else:
                    pass
            Vector[SpannedExpr] nargs = Vector[SpannedExpr]()
            int ci = 0
            while ci < cargs.len():
                SpannedExpr arg = cargs.get(ci).unwrap()
                bool arg_done = false
                if callee_name != "" and fn_param_types.contains(callee_name):
                    Vector[SpannedType] ptys = fn_param_types.get(callee_name).unwrap()
                    if ci < ptys.len():
                        nargs.push(collect_rewrite_expr_expected(arg, ptys.get(ci).unwrap(), &fn_param_types))
                        arg_done = true
                if not arg_done:
                    nargs.push(SpannedExpr(collect_rewrite_expr(arg.expr, &fn_param_types), arg.span))
                ci = ci + 1
            return ECall(Box(*callee_box), nargs, carg_names, ctargs)
        case EClosure(params, body):
            return EClosure(params, collect_rewrite_stmts(body, no_type(), &fn_param_types))
        case EBlock(body):
            return EBlock(collect_rewrite_stmts(body, no_type(), &fn_param_types))
        case EDo(body):
            return EDo(collect_rewrite_stmts(body, no_type(), &fn_param_types))
        case EIf(cond, then_b, else_branches):
            Vector[ElseBranch] nbr = Vector[ElseBranch]()
            int ei = 0
            while ei < else_branches.len():
                ElseBranch eb = else_branches.get(ei).unwrap()
                nbr.push(ElseBranch(eb.condition, collect_rewrite_stmts(eb.body, no_type(), &fn_param_types)))
                ei = ei + 1
            return EIf(Box(*cond), collect_rewrite_stmts(then_b, no_type(), &fn_param_types), nbr)
        case EMatch(scrut, arms):
            Vector[MatchArm] narms = Vector[MatchArm]()
            int ai = 0
            while ai < arms.len():
                MatchArm arm = arms.get(ai).unwrap()
                narms.push(MatchArm(arm.pattern, arm.guard, collect_rewrite_stmts(arm.body, no_type(), &fn_param_types)))
                ai = ai + 1
            return EMatch(Box(*scrut), narms)
        else:
            return e

# A sentinel "no expectation" SpannedType for sub-expression walks where no
# enclosing target type applies. `TInferred` never matches the Set/Dict arms in
# `collect_rewrite_expr_expected`, so it is a safe no-op expectation.
SpannedType no_type():
    return SpannedType(TInferred(), Span(0, 0))

# The builtin generic collection base names. These are declared as empty-body
# stubs in lib/std/collections.gg (`struct Vector[T]: pass`) so that
# `Vector[T]` resolves as a name carrying equip-method blocks, but they are
# NOT user structs — at the LIR layer their monos (`Vector__bool` etc.) ARE the
# runtime GorgetArray/GorgetMap/GorgetSet, routed via `resource_meta_for`.
# Mirrors the Rust dispatcher's `"Vector" | "Dict" | "HashMap" | "Set" |
# "HashSet" | "Box" =>` special-case (src/ir/lowering/types.rs:699), which
# routes them to `register_collection_alias` instead of monomorphizing the
# user template. `Box` is intentionally EXCLUDED here: the self-host registers
# `Box__<inner>` via lir_lower's BkRegularBox arm, not the mono-record loop.
# This is the ONE source of truth for the collection-base subset — the
# `is_type_constructor` "not-a-user-struct-ctor" set (lower_types.gg) delegates
# here for that subset. See tests/lints.rs `collection_base_names_single_source`.
bool is_builtin_collection_base(String name):
    if name == "Vector" or name == "Deque" or name == "Channel":
        return true
    if name == "Dict" or name == "HashMap":
        return true
    if name == "Set" or name == "HashSet":
        return true
    return false

GirModule lower_module(Module &m, ScopeTable scopes, TypeTable types, Dict[String, String] call_redirects, Dict[String, bool] imported_fns):
    Vector[GirType] type_table = init_type_table()

    # Inject the compiler-internal `Fault` enum (error-model.md §11) as a
    # synthetic non-generic user enum so it flows through EVERY registration
    # pass below identically to a user-declared enum: `type_infos`,
    # `enum_variant_parent_idx`, `enum_registry`, the C struct synthesis, and
    # the nullary-variant constructor path (`Fault.Overflow()` →
    # `lower_nullary_variant_ident` → `(Fault){.tag = N}`). Variant order is
    # the tag order (Overflow=0, DivByZero=1, Bounds=2). Mirrors Rust gg's
    # eager concrete-TypeDef injection (c7dd0816). Guarded so a user program
    # that legitimately declares its own `enum Fault` is not duplicated.
    bool fault_already = false
    for fm_item in m.items:
        match fm_item:
            case IEnum(fm_edef):
                if fm_edef.name == "Fault":
                    fault_already = true
            else:
                pass
    if not fault_already:
        Vector[SpannedType] fault_no_fields = []
        Vector[EnumVariant] fault_variants = [EnumVariant("Overflow", fault_no_fields), EnumVariant("DivByZero", []), EnumVariant("Bounds", [])]
        Vector[String] fault_no_tp = []
        Vector[String] fault_no_der = []
        m.items.push(IEnum(EnumDef("Fault", fault_variants, fault_no_tp, fault_no_der)))

    # Pre-scan: detect if module has a main() function.
    # Test blocks are skipped when main exists (normal build mode),
    # emitted when no main (test-only file).
    bool has_main = false
    for hm_item in m.items:
        match hm_item:
            case IFunction(fdef):
                if fdef.name == "main":
                    has_main = true
            else:
                pass

    # Pre-scan function signatures for call resolution.
    Dict[String, int] fn_sigs = {}
    for item in m.items:
        match item:
            case IFunction(fdef):
                int rt = I64_TYPE
                if fdef.name == "main":
                    rt = I32_TYPE
                else:
                    # Pre-scan: use primitive types AND best-effort named type detection.
                    match fdef.return_type.ty:
                        case TPrimitive(name):
                            int pt = prim_name_to_type(name)
                            if pt >= 0:
                                rt = pt
                            elif name == "String":
                                # Pre-register GorgetString so fn_sigs resolves correctly.
                                # Types table will be extended on-demand; here we use a
                                # sentinel that lower_call handles via fn definition lookup.
                                pass
                        case TNamed(name, _):
                            # Collection/named return types — record a hint so downstream
                            # call_return type inference can recover them during function
                            # definition lookup. Full resolution happens when the function
                            # body is lowered (see lower_function).
                            pass
                        else:
                            pass
                fn_sigs.put(fdef.name, rt)
            else:
                pass

    # Pre-scan function param ownership for borrow detection
    Dict[String, Vector[bool]] fn_borrow_params = {}
    # Parallel scan for `!`-move params (OWN_MOVE == 2). Drives
    # CkCallArgOwning vs CkCallArgBorrow at call-arg lowering sites via
    # `classify_call_arg`. See enum ConsumeKind / op_consume docstring.
    Dict[String, Vector[bool]] fn_move_params = {}
    # P0 default-arg fill: parallel to the two scans above — per-fn vector of
    # the parsed default expr for each param (None if none). Keyed identically;
    # registered at EVERY `.put` sibling so the three Dicts stay in lockstep.
    Dict[String, Vector[Option[SpannedExpr]]] fn_defaults = {}
    # round-16 Phase-2: per-fn await-ness, computed from the AST BEFORE any
    # function body is lowered, so `lower_shared_spawn` (which runs DURING
    # lowering) can query it to pick `__shared_async_` vs `__shared_token_`.
    # Mirrors Rust gg's per-callee `callee_has_awaits` gate at the spawn site
    # (`exprs/mod.rs:1247-1250, 1298-1307`). Threaded into `gmod.async_fns`.
    Dict[String, bool] async_fns_pre = {}
    for bp_item in m.items:
        match bp_item:
            case IFunction(fdef):
                Vector[bool] borrows = []
                Vector[bool] moves = []
                Vector[Option[SpannedExpr]] defaults = []
                for p in fdef.params:
                    borrows.push(p.ownership == 1)  # 1 = OWN_MUTABLE (&)
                    moves.push(p.ownership == 2)    # 2 = OWN_MOVE (!)
                    defaults.push(p.default_value)
                fn_borrow_params.put(fdef.name.clone(), borrows)
                fn_move_params.put(fdef.name.clone(), moves)
                fn_defaults.put(fdef.name.clone(), defaults)
                if stmts_have_await(fdef.body):
                    async_fns_pre.put(fdef.name.clone(), true)
            case IEquip(bp_eqblk):
                # Equip-method `!`-params must register too, otherwise a
                # `self.m(!arg)`-shaped call (a bare local passed to a `!T`
                # method param) classifies as CkCallArgBorrow → op_consume
                # returns OpBorrow → no caller-side GIMoveZero → the caller
                # drops its local at scope exit WHILE the callee's `!`-param
                # exit-drop ALSO frees it → double-free. The call site keys
                # `classify_call_arg` on `recv_type_name + "__" + mname` (the
                # SHORT form, `lower.gg:5933`), never the `Trait_for_…` form,
                # so we register under the same short `Target__method` key.
                # Param indices include `self` at 0 — aligned with the call
                # site's `classify_call_arg(full_name, 0)` receiver dispatch
                # and `classify_call_arg(full_name, _ma_idx + 1)` for args.
                # Only non-generic equips on a concrete named/primitive target
                # (the call site resolves `recv_type_name` to that name).
                # GENERIC-equip mono'd instances (`equip [T] Vector[T] with
                # Drainable[T]: VectorDrain[T] drain(!self)`) are registered
                # SEPARATELY, in the `fn_sigs` generic-instances pre-pass (search
                # "GENERIC-EQUIP `!`-PARAM MOVE CONTRACT" in `lower_module`), which
                # runs over the mono'd instances BEFORE function bodies and so
                # reaches the call sites — `lower_generic_equip` itself runs too
                # late. Both paths put under the same `Target__method` key with the
                # same `ownership==1/==2` flags; this `type_params.len()==0` arm is
                # the NON-generic case only.
                if bp_eqblk.type_params.len() == 0:
                    String bpe_target = ""
                    match bp_eqblk.target.ty:
                        case TNamed(bpe_tn, bpe_targs):
                            if bpe_targs.len() == 0:
                                bpe_target = bpe_tn
                        case TPrimitive(bpe_tn):
                            bpe_target = bpe_tn
                        else:
                            pass
                    if bpe_target != "":
                        for bpe_m in bp_eqblk.methods:
                            Vector[bool] em_borrows = []
                            Vector[bool] em_moves = []
                            Vector[Option[SpannedExpr]] em_defaults = []
                            for ep in bpe_m.params:
                                em_borrows.push(ep.ownership == 1)
                                em_moves.push(ep.ownership == 2)
                                em_defaults.push(ep.default_value)
                            String bpe_full = bpe_target + "__" + bpe_m.name
                            fn_borrow_params.put(bpe_full.clone(), em_borrows)
                            fn_move_params.put(bpe_full.clone(), em_moves)
                            fn_defaults.put(bpe_full, em_defaults)
            else:
                pass

    Dict[String, int] named_types = {}
    # Scan struct/enum defs to determine which types have resource fields.
    #
    # Run to fixpoint: a single pass misses forward references (struct A
    # contains struct B defined later → B isn't yet marked as resource
    # when A is checked). The brief calls this `is_transitively_resource`;
    # the same effect is achieved by closing the existing
    # `is_resource_field_type` walk under iteration. Each iteration may
    # mark more structs/enums as resource (because their already-checked
    # nested types were just marked in the prior pass); iteration
    # terminates when no new entries are added.
    #
    # Concrete bug this closes: `SpannedType { Type ty; Span span }` where
    # Type ∋ TNamed(String, Vector[SpannedType]) — Type was forward-
    # referenced relative to SpannedType in ast.gg, so SpannedType was NOT
    # marked → `loader___type_mentions_iter(SpannedType ty)` got the bare
    # byte-copy ABI rather than Ptr-wrap, aliasing caller's heap and
    # SIGSEGV'ing at `gorget_string_clone_to_owned(&__s7)`. Fix C of the
    # 2026-05-22 fourth-attempt review.
    Dict[String, bool] resource_types = {}
    resource_types.put("String", true)
    resource_types.put("GorgetString", true)
    bool rt_changed = true
    while rt_changed:
        rt_changed = false
        for ritem in m.items:
            match ritem:
                case IStruct(sdef):
                    if resource_types.contains(sdef.name):
                        continue
                    bool has_resource = false
                    for fld in sdef.fields:
                        if is_resource_field_type(fld.param_type, resource_types):
                            has_resource = true
                    if has_resource:
                        resource_types.put(sdef.name, true)
                        rt_changed = true
                case IEnum(edef):
                    if resource_types.contains(edef.name):
                        continue
                    bool has_resource = false
                    for var in edef.variants:
                        for vft in var.fields:
                            if is_resource_field_type(vft, resource_types):
                                has_resource = true
                    if has_resource:
                        resource_types.put(edef.name, true)
                        rt_changed = true
                else:
                    pass

    # Register the MANGLED names of mono'd Option__X / Result__X__E
    # instances (whose payload is a resource) that appear as struct/enum
    # fields, so the string-keyed `is_resource_type_name` (op_consume's
    # clone-vs-copy gate) and the ctor-flag registration recognise them.
    # The fixpoint above marks the CONTAINING user type as a resource but
    # never the mono'd Option/Result instance itself — it isn't a user
    # `m.items` def, so its mangled name (`Option__SpannedExpr`) is absent
    # from resource_types. Without this, op_consume byte-copies (OpCopy →
    # shallow alias) an `Option[Resource]` field at a consuming position:
    # the MatchArm `guard` / ElseBranch `condition` double-free.
    # `register_optionlike_resource` deliberately handles ONLY Option/
    # Result (Vector/Dict/Set/Box are already classified by
    # build_resource_metadata; registering their mangled names breaks C
    # type emission). lir_lower drops/clones these via recursive_drop_enums
    # (`Option__SpannedExpr__clone`).
    # TODO(layering): is_resource_field_type (structured) and
    # is_resource_type_name (string) are two classifiers for one axis;
    # unify long-term (layering rule 3).
    Dict[String, bool] optionlike_resource_types = {}
    for mn_item in m.items:
        match mn_item:
            case IStruct(mn_sdef):
                for mn_fld in mn_sdef.fields:
                    register_optionlike_resource(mn_fld.param_type, resource_types, &optionlike_resource_types)
            case IEnum(mn_edef):
                for mn_var in mn_edef.variants:
                    for mn_vft in mn_var.fields:
                        register_optionlike_resource(mn_vft, resource_types, &optionlike_resource_types)
            else:
                pass

    Dict[String, int] type_subs = {}
    Dict[String, String] meta_aliases = types.meta_aliases
    # Also collect plain type aliases (ITypeAlias) into meta_aliases
    for ta_item in m.items:
        match ta_item:
            case ITypeAlias(ta_name, ta_tparams, ta_target):
                if ta_tparams.len() == 0:
                    # Store the raw type name for alias resolution
                    match ta_target.ty:
                        case TPrimitive(pname):
                            meta_aliases.put(ta_name, pname)
                        case TNamed(tname, _):
                            meta_aliases.put(ta_name, tname)
                        case TFunction(_, _, _):
                            # Function type aliases are opaque in GIR → void
                            meta_aliases.put(ta_name, "void")
                        else:
                            pass
            else:
                pass
    # Build type field info for LIR drop analysis.
    Dict[String, GirTypeInfo] type_infos = {}
    Dict[String, Vector[String]] enum_registry = {}
    # Flat variant→enum index, built FIRST-WRITE-WINS in the IEnum arm below
    # (mirrors the insertion-order first-match of the old `enum_variant_parent`
    # scan). Threaded into GirModule so the lookup is O(1).
    Dict[String, String] enum_variant_parent_idx = {}
    for tfi_item in m.items:
        match tfi_item:
            case IStruct(sdef):
                # Generic struct TEMPLATES (`struct Vector[T]: pass`,
                # `struct Pair[A,B]`, ...) are NOT concrete types — they are
                # monomorphized into per-instantiation records (the
                # `generic_instances` loop below). Registering the bare template
                # name here gives `type_infos["Vector"]` the stub's single
                # empty-named `void` field → emit_structs emits the invalid C
                # `struct __gg_Vector { uint8_t ; };`. Mirror Rust gg, whose
                # `register_struct_type` early-returns on `generic_params.is_some()`
                # (src/ir/lowering/types.rs:579).
                if sdef.type_params.len() == 0:
                    Vector[GirFieldInfo] fields = []
                    for fld in sdef.fields:
                        String ftype_name = spanned_type_to_name(fld.param_type)
                        fields.push(GirFieldInfo(fld.param_name, ftype_name))
                    Vector[GirEnumVariantInfo] no_variants = []
                    type_infos.put(sdef.name, GirTypeInfo(sdef.name, fields, no_variants, false))
            case IEnum(edef):
                Vector[GirFieldInfo] no_fields = []
                Vector[GirEnumVariantInfo] variants = []
                Vector[String] variant_names_only = []
                for var in edef.variants:
                    Vector[GirFieldInfo] vfields = []
                    int evfi = 0
                    while evfi < var.fields.len():
                        SpannedType vft = var.fields.get(evfi).unwrap()
                        String vftype_name = spanned_type_to_name(vft)
                        vfields.push(GirFieldInfo("_" + int_to_str(evfi), vftype_name))
                        evfi += 1
                    variants.push(GirEnumVariantInfo(var.name, vfields))
                    variant_names_only.push(var.name.clone())
                    # FIRST-WRITE-WINS: keep the first enum (insertion order)
                    # whose variant matches, identical to the old
                    # `enum_variant_parent` scan. A plain (last-wins) `.put`
                    # would silently flip the result on a variant-name
                    # collision across enums.
                    if not enum_variant_parent_idx.contains(var.name):
                        enum_variant_parent_idx.put(var.name.clone(), edef.name.clone())
                type_infos.put(edef.name, GirTypeInfo(edef.name, no_fields, variants, true))
                enum_registry.put(edef.name.clone(), !variant_names_only)
            case INewtype(nt_name, nt_inner):
                # A newtype `newtype Meters(float)` is a single-field wrapper
                # struct with field `_0` of the inner type. Mirrors Rust gg's
                # `register_newtype` (src/ir/lowering/types.rs:653-656). Without
                # this arm the newtype's type_info is missing → emit_structs
                # emits an empty `char __pad` struct, the constructor
                # `Meters(3.14)` drops its arg into `{ }`, and `dist.0`
                # (normalized to `_0`) falls through to the [bug] I64(0)
                # placeholder.
                Vector[GirFieldInfo] nt_fields = []
                String nt_inner_name = spanned_type_to_name(nt_inner)
                nt_fields.push(GirFieldInfo("_0", nt_inner_name))
                Vector[GirEnumVariantInfo] nt_no_variants = []
                type_infos.put(nt_name, GirTypeInfo(nt_name, nt_fields, nt_no_variants, false))
            else:
                pass
    # Fix D (2026-05-22) — register struct constructors in fn_move_params
    # with per-field resource flags. Per CLAUDE.md "Ownership at Consuming
    # Positions": struct field-init is a consume position. Without this,
    # `classify_call_arg("Lexer", 2)` returned CkCallArgBorrow (default for
    # unregistered callees), `op_consume` returned `OpBorrow`, and the
    # constructor inline field-init byte-aliased the caller's resource
    # source into the struct field — leading to double-free at scope exit.
    #
    # With this entry, resource-field positions are classified
    # CkCallArgOwning → OpMove (last-use) or OpClone (live past call).
    # OpMove triggers `wire_liveness_into_modes` to emit `GIMoveZero` on
    # the source slot post-call; the source's scope-exit `GIDropIfAlive`
    # then sees a zeroed slot and the memcmp gate suppresses the free.
    #
    # Field type_name is the resolved C name ("GorgetString",
    # "Vector__int64_t", etc.); resource detection routes through
    # `build_resource_metadata` (pattern-based, gmod-independent) and the
    # local `resource_types` dict for user structs/enums. `build_resource_metadata`
    # lives in lir_lower.gg; calling it here keeps the registration self-
    # contained at module-build time.
    for fd_item in m.items:
        match fd_item:
            case IStruct(fd_sdef):
                Vector[bool] fd_moves = []
                # Struct ctors are synthetic consume positions with no user
                # default args — register an all-None defaults vector so the
                # three parallel param Dicts stay in lockstep (the call-site
                # fill never finds a Some here, which is correct).
                Vector[Option[SpannedExpr]] fd_defaults = []
                for fd_fld in fd_sdef.fields:
                    # Use the structured, recursive `is_resource_field_type`
                    # (the same predicate that builds resource_types) rather
                    # than the string-keyed build_resource_metadata +
                    # resource_types.contains: the string path can't see INTO
                    # an `Option[Resource]` / `Result[Resource,_]` field, so
                    # such fields were flagged non-owning → CkCallArgBorrow →
                    # the MatchArm `guard` / ElseBranch `condition` aliased and
                    # double-freed. Structured detection flags them owning →
                    # CkCallArgOwning → op_consume clones the borrow.
                    bool fd_is_resource = is_resource_field_type(fd_fld.param_type, resource_types)
                    fd_moves.push(fd_is_resource)
                    fd_defaults.push(None)
                fn_move_params.put(fd_sdef.name.clone(), fd_moves)
                fn_defaults.put(fd_sdef.name, fd_defaults)
            case IEnum(fd_edef):
                # Enum-variant constructors are ALSO consume positions — the
                # constructed node OWNS its payload fields. Without this, a
                # resource arg (e.g. a `Vector[Stmt]` moved into an `SIf` node)
                # classified CkCallArgBorrow → OpBorrow → byte-aliased into the
                # variant field, then the source local was dropped at scope exit
                # AND the node owned the same heap → double-free (the
                # parse_if_stmt → gorget_array_free → Stmt__drop backtrace,
                # 2026-05-24). classify_call_arg keys on the BARE variant name
                # for `SIf(...)` and on `Enum__Variant` for `Enum.Variant(...)`;
                # register both.
                for fd_var in fd_edef.variants:
                    Vector[bool] fd_vmoves = []
                    # Synthetic variant ctor — no user defaults; all-None to
                    # keep the parallel param Dicts in lockstep.
                    Vector[Option[SpannedExpr]] fd_vdefaults = []
                    for fd_vfld in fd_var.fields:
                        # Structured detection (see the IStruct branch) —
                        # catches Option/Result-of-resource variant payloads.
                        bool fd_v_is_resource = is_resource_field_type(fd_vfld, resource_types)
                        fd_vmoves.push(fd_v_is_resource)
                        fd_vdefaults.push(None)
                    fn_move_params.put(fd_var.name.clone(), fd_vmoves.clone())
                    fn_move_params.put(fd_edef.name + "__" + fd_var.name, !fd_vmoves)
                    fn_defaults.put(fd_var.name.clone(), fd_vdefaults.clone())
                    fn_defaults.put(fd_edef.name + "__" + fd_var.name, !fd_vdefaults)
            else:
                pass
    # Prelude enum variant constructors (Option.Some, Result.Ok/Error) own
    # their single payload — they are NOT in `m.items`, so the Fix-D loop
    # above never registers them. Without this, `Some(x)` / `Ok(x)` /
    # `Error(x)` classify the payload `CkCallArgBorrow` → op_consume returns
    # OpBorrow (a non-consume early-out, so a-5's clone-on-borrow arm never
    # fires) → the variant shallow-ALIASES the source, which is then dropped
    # at scope exit while the constructed Option/Result (often returned or
    # stored) still references it → use-after-free. ASan-confirmed via the
    # `parse_equip_item` EquipBlock.trait_name UAF (`Some(tn)` aliasing a
    # freed `tn`), 2026-05-24. Mirrors Rust treating variant payloads as
    # owning consume positions. `None` has no payload. Registered on the
    # bare variant name (the GIR emits `call @Some(...)`); op_consume still
    # yields OpCopy for primitive payloads, so flagging owning is universally
    # safe.
    # Typed locals (NOT a bare `[true]` arg) so the `Vector[bool]` gets
    # elem_size 1 from the declaration's container-size hint. A bare
    # `[true]` literal passed straight to `.put()` has no type context →
    # defaults to elem_size 8 → pushing the 1-byte bool reads 8 bytes →
    # stack-buffer-overflow + array corruption (an "index 0, length 0"
    # panic later in lower_module).
    Vector[bool] some_mv = [true]
    fn_move_params.put("Some", !some_mv)
    Vector[bool] ok_mv = [true]
    fn_move_params.put("Ok", !ok_mv)
    Vector[bool] error_mv = [true]
    fn_move_params.put("Error", !error_mv)
    # Parallel all-None defaults for the prelude ctors (no user defaults).
    # Typed local so the Vector gets the right elem_size (see the bool note).
    Vector[Option[SpannedExpr]] some_df = [None]
    fn_defaults.put("Some", !some_df)
    Vector[Option[SpannedExpr]] ok_df = [None]
    fn_defaults.put("Ok", !ok_df)
    Vector[Option[SpannedExpr]] error_df = [None]
    fn_defaults.put("Error", !error_df)
    # `Box(x)` is the sibling prelude ctor: `Box[T]` is a SINGLE-OWNER
    # heap allocation (language-reference.md §"Box[T]") — it OWNS its
    # payload, exactly like Some/Ok/Error own theirs. Without this,
    # `Box(x)` classifies the payload CkCallArgBorrow → op_consume's
    # non-consume early-out returns OpBorrow → IBoxAlloc shallow-memcpy's
    # the payload, aliasing the source's interior `Box`/`String` ptrs;
    # drop emission then frees the source while the box still references
    # it → dangle (bug #3, the `Box(lhs)` cycle in parse_expr_bp_with_lhs).
    # Rust treats `Box(x)`/`Box.new(x)` as an owning consume position too
    # (`ir/lowering/exprs/calls.rs` Box ctor + `methods.rs` Box.new, both
    # run `ensure_owned_at_consuming_arg`). Flagging owning routes the arg
    # through op_consume → move (owned last-use) or clone (borrow/`!`-param
    # live-past, via the MutPtr/Ptr clone-through arms). Typed local, not a
    # bare `[true]` (elem_size trap — see above).
    Vector[bool] box_mv = [true]
    fn_move_params.put("Box", !box_mv)
    Vector[Option[SpannedExpr]] box_df = [None]
    fn_defaults.put("Box", !box_df)
    Dict[String, int] const_decls = {}
    Dict[String, bool] bool_const_decls = {}
    Dict[String, String] string_const_decls = {}
    Dict[String, int] none_decls = {}
    Dict[String, float] float_const_decls = {}
    # Module-level statics with runtime-call init (`stdout` / `stderr` /
    # `stdin` from lib/std/io.gg etc.). Populated below in the
    # IStaticDecl handler when int/float eval miss and the init shape is
    # a zero-arg call.
    Dict[String, GirStaticInfo] statics = {}
    Dict[String, ResourceMetadata] resource_metadata = {}
    Dict[int, int] option_ref_payload = {}
    GirModule gmod = GirModule([], [GirExtern("printf", true, I32_TYPE)], type_table, !fn_sigs, !named_types, !resource_types, !type_subs, !meta_aliases, !call_redirects, !imported_fns, !type_infos, !fn_borrow_params, !fn_move_params, {}, !const_decls, !bool_const_decls, !string_const_decls, !none_decls, !enum_registry, !float_const_decls, !statics, !resource_metadata, types, scopes, !optionlike_resource_types, !option_ref_payload, [], !enum_variant_parent_idx, false, [], {}, {}, {}, {}, {}, !fn_defaults, [], [], {}, {}, {}, {}, [], SCHED_POOL, [], !async_fns_pre, {}, {}, {})

    # R38: mutation-inference — classify each &self/!self equip method
    # read-only vs writes-self (fixpoint), so the named-receiver CoW gate
    # materializes ONLY for genuine mutators (no clone bomb).
    compute_method_mutates_self(&gmod, m)

    # R11: extract the `strip-asserts` directive so the SAssert case in
    # lower_stmt can emit a no-op instead of a conditional panic. Mirrors
    # Rust gg's directive scan (`src/ir/lowering/mod.rs:486-489`).
    for dir_item in m.items:
        match dir_item:
            case IDirective(dir_name, dir_value):
                if dir_name == "strip-asserts":
                    gmod.strip_asserts = true
                # `directive scheduler=<mode>` selects the async scheduler
                # runtime. The 8 `shared_stale_*` fixtures declare
                # `directive scheduler=single`, which the parser captures as
                # IDirective("scheduler", "single"). Without SCHED_SINGLE the
                # spawned worker may race the producer under the default pool
                # scheduler. Mirrors Rust gg's scheduler-directive scan.
                elif dir_name == "scheduler":
                    if dir_value == "single":
                        gmod.scheduler_mode = SCHED_SINGLE
                    elif dir_value == "thread":
                        gmod.scheduler_mode = SCHED_THREAD
                    elif dir_value == "inline":
                        gmod.scheduler_mode = SCHED_INLINE
            else:
                pass

    # Cross-frame fault propagation (error-model.md §11, Inc-2.1a/2.1c/2.1d):
    # compute the participating-FREE-FUNCTION set over the AST. Runs HERE —
    # before any function body is lowered — so `lower_function` (signature +
    # callee fault-return arm) and `lower_call` (call-site tag-dispatch gate)
    # can query `participates_in_fault`. Empty for the existing suite +
    # self-host source (no arith/bounds `catch Fault.X` over a user CALL) →
    # byte-identical → bootstrap unaffected. Mirrors Rust gg's pre-pass
    # `compute_participating_fault_fns` (`src/ir/lowering/mod.rs`, after the
    # fn_sigs prescan, before body lowering).
    compute_participating_fault_fns(&m, &gmod)

    # Pre-scan equip blocks to build the trait-impl registry for the
    # compile-time `implements(T, "Trait")` meta-predicate. Runs HERE — before
    # any function body is lowered — so the signal is populated when a generic
    # `check[T]()` mono or a non-generic `main()` reaches the meta-eval splice.
    # `expand_derives` already ran (driver.gg:389), so `@derive(Eq, ..)` appears
    # as real `equip X with Eq` items alongside user-written equips. We read the
    # SOURCE-level type name (TNamed.tname) to match what
    # `resolve_meta_tparam`/`meta_typename` yields at the query site. Mirrors
    # Rust's TraitRegistry impl-table (`src/semantic/traits.rs:331`).
    #
    # The per-type list is rebuilt-then-put (get → local → push → put), NOT
    # mutated in place via `gmod.trait_impls_by_type.get(k).unwrap().push(v)`:
    # the in-place idiom mis-compiles to a faulting stage-1 binary in this
    # pre-pass context (a latent self-host codegen bug; see TODO.md), so we go
    # through an owned local and write it back.
    for ti_item in m.items:
        match ti_item:
            case IEquip(ti_eqblk):
                String ti_tname = ""
                match ti_eqblk.target.ty:
                    case TNamed(tn, _):
                        ti_tname = tn
                    else:
                        pass
                String ti_trait = ""
                match ti_eqblk.trait_name:
                    case Some(tr):
                        ti_trait = tr
                    case None:
                        pass
                if ti_tname != "" and ti_trait != "":
                    Vector[String] ti_existing = []
                    if gmod.trait_impls_by_type.contains(ti_tname):
                        ti_existing = gmod.trait_impls_by_type.get(ti_tname).unwrap()
                    ti_existing.push(ti_trait)
                    gmod.trait_impls_by_type.put(ti_tname, !ti_existing)
            else:
                pass

    # P0 Bug A: pre-scan equip blocks for a USER-DEFINED `drop` method, so
    # the `CloneAndMove` SVarDecl arm knows whether dropping a Branch C-pre
    # ptr-clone would run observable side effects (a `print` in the user
    # drop, double-printing vs the borrow-no-drop oracle). Runs HERE — before
    # any function body is lowered — so the signal is populated when `main`
    # reaches `decide_svardecl_emission` regardless of `gmod.functions` push
    # order. A `drop` method appears either via `equip <T> with Drop:`
    # (trait_name == "Drop") or as an inherent/derived method literally named
    # `drop`; we match on the method name (the sole criterion that produces an
    # observable `<Type>__drop` user fn body).
    #
    # The set is TRANSITIVE over fields: a type with no direct drop but a
    # field whose type has an observable drop (e.g. `struct Wrapper:
    # Container inner` where `Container` has a user drop) ALSO double-prints
    # when its implicit field-drop recurses into the field's `<T>__drop`. So
    # after seeding the direct-drop types we run a fixpoint over `type_infos`,
    # joining any struct/enum one of whose (variant-)field `type_name`s is
    # already observable, until no change. Mirrors the recursive-drop
    # discovery `populate_drop_metadata` runs at the LIR layer; done here at
    # the GIR layer because `decide_svardecl_emission` runs before LIR.
    for udrop_item in m.items:
        match udrop_item:
            case IEquip(udrop_eqblk):
                bool udrop_has = false
                for udrop_m in udrop_eqblk.methods:
                    if udrop_m.name == "drop":
                        udrop_has = true
                if udrop_has:
                    String udrop_target = type_to_c_name(udrop_eqblk.target, &gmod)
                    gmod.types_with_user_drop.put(udrop_target, true)
            else:
                pass
    # Transitive field-propagation fixpoint.
    bool udrop_changed = true
    while udrop_changed:
        udrop_changed = false
        for udrop_tname in gmod.type_infos.keys():
            if not gmod.types_with_user_drop.contains(udrop_tname):
                GirTypeInfo udrop_ti = gmod.type_infos.get(udrop_tname).unwrap()
                bool udrop_field_obs = false
                for udrop_fi in udrop_ti.fields:
                    if gmod.types_with_user_drop.contains(udrop_fi.type_name):
                        udrop_field_obs = true
                for udrop_vi in udrop_ti.variants:
                    for udrop_vfi in udrop_vi.fields:
                        if gmod.types_with_user_drop.contains(udrop_vfi.type_name):
                            udrop_field_obs = true
                if udrop_field_obs:
                    gmod.types_with_user_drop.put(udrop_tname, true)
                    udrop_changed = true

    # Fold every user-Drop type into `resource_types`, mirroring Rust's
    # single `copy_semantics=Resource` + `drop_strategy=Custom("T__drop")`
    # axis (`src/ir/lowering/mod.rs:260-280`): scanning `equip T with Drop:`
    # UNCONDITIONALLY marks the type a resource, never inspecting fields. The
    # self-host previously keyed droppability only on the resource-FIELD axis
    # (the fixpoint above + runtime resources), so a FIELDLESS Drop-bearing
    # struct local (`R a = R(100)` with `equip R with Drop`) was never
    # registered for drop — `R__drop` was DCE'd and the destructor silently
    # never ran (a RAII violation). Folding here makes all three consumers
    # fire consistently: `is_droppable_type` (lower_drops.gg) registers the
    # local, `drop_fn_for_type` (lir_lower.gg) resolves `R__drop`, and
    # `populate_drop_metadata`'s `is_resource_struct` guard emits+wires the
    # call. It also flips these to the resource clone/Ptr ABI — exactly Rust's
    # `copy_semantics=Resource` (a custom-drop type isn't freely bit-copyable;
    # two byte-copies would each run `drop`). Done at the PRODUCER, after the
    # transitive fixpoint converges, so the signal is consistent everywhere.
    for udrop_res_name in gmod.types_with_user_drop.keys():
        if not gmod.resource_types.contains(udrop_res_name):
            gmod.resource_types.put(udrop_res_name, true)

    # Refine fn_sigs for functions with named/generic return types. The
    # pre-scan above defaulted those to `I64_TYPE` because `map_ast_type`
    # needs the real `gmod` to resolve generic names. Left uncorrected, a
    # caller of `parse_int(s) -> Result[int, ParseError]` would think the
    # return is int64 and allocate an 8-byte slot — the actual 48-byte
    # Result wouldn't fit, and field reads past the slot read zero. This
    # is the EIntLiteral-zero bug that made stage-1 produce `print(0)`
    # for `print(42)`, because `parse_int(clean).unwrap_or(0)` always
    # returned 0.
    for rs_item in m.items:
        match rs_item:
            case IFunction(rs_fdef):
                if rs_fdef.name != "main":
                    match rs_fdef.return_type.ty:
                        case TNamed(_, _):
                            int rs_rt = map_ast_type(rs_fdef.return_type, &gmod)
                            # Honour throws_type for Result[T, E] wrapping.
                            match rs_fdef.throws_type:
                                case Some(rs_throws):
                                    int rs_ok = rs_rt
                                    int rs_err = map_ast_type(rs_throws, &gmod)
                                    String rs_ret_c = type_id_to_name(rs_rt, &gmod)
                                    String rs_err_c = type_id_to_name(rs_err, &gmod)
                                    rs_rt = lookup_or_register_named(&gmod, "Result__" + rs_ret_c + "__" + rs_err_c)
                                    record_enum_category(&gmod, rs_rt, ENUM_CAT_RESULT, rs_ok, rs_err)
                                case None:
                                    pass
                            gmod.fn_sigs.put(rs_fdef.name, rs_rt)
                        case TPrimitive(rs_prim_name):
                            # `String` is a TPrimitive in the AST but resolves to
                            # the aggregate GorgetString — the fn_sigs pre-scan
                            # left it at the I64 default (it `pass`es on String
                            # because map_ast_type needs the real gmod). Resolve
                            # it now. Single-line externs like
                            # `extern "C" String __bytes_to_str_raw(...)` parse as
                            # IFunction (parser.gg:3808-3809) with a String return;
                            # without this, `String x = __bytes_to_str_raw(...)`
                            # types `x` as i64, the i64 slot mismatches the Str
                            # call result, and the C-emit ISlotStore give-up
                            # (lir_codegen:2886 aggregate-into-scalar) zeroes the
                            # store whenever SSA does not promote the dead slot —
                            # the io.gg Writer-for-String self-instability (bug #4).
                            int rs_prim_rt = map_ast_type(rs_fdef.return_type, &gmod)
                            if rs_prim_rt != I64_TYPE:
                                gmod.fn_sigs.put(rs_fdef.name, rs_prim_rt)
                        else:
                            pass
            case IExternBlock(rs_ext_fns):
                # Register the ENTRY-module `extern "C":` block's externs in
                # fn_sigs, mirroring Rust gg's imported/inline-extern path
                # (src/ir/lowering/mod.rs:801-810: for each block fn,
                # `ctx.fn_sigs.insert(name, (param_types, ret_type))`). Without
                # this, a `String`-returning extern (e.g. `extern borrowed String
                # _test_borrowed_empty() = "gorget_str_empty"`) leaves its result
                # slot at the I64 fn_sigs default → the ISlotStore types `Str`
                # into an `int64_t` slot → cc errors "incompatible types when
                # assigning to type 'int64_t' from type 'Str'".
                #
                # Register under BOTH the Gorget name AND the redirected C symbol
                # (the `= "sym"` body), exactly as Rust registers both the
                # mangled and bare names (mod.rs:776/810). The call site resolves
                # the redirect FIRST (call_name = call_redirects[fname], lower_
                # expr.gg:4542) and then looks up the return type under the
                # already-redirected `call_name` (lower_expr.gg:4910) — so the
                # C-symbol key is the one that fires; the Gorget-name key is the
                # belt-and-suspenders for any lookup that runs before the redirect.
                # Keyed by the extern's return type via map_ast_type (resolves
                # String → GorgetString); I64-default returns are left untouched.
                for rs_ext_fd in rs_ext_fns:
                    int rs_ext_rt = map_ast_type(rs_ext_fd.return_type, &gmod)
                    # PROTOTYPE: a `cstr`-returning extern types to a bare `cstr`
                    # named type via map_ast_type; register it as GorgetString
                    # instead so the EMIT-side cstr wrap (is_cstr_returning_fn,
                    # lir_codegen.gg — fires only when the dst slot is GorgetString)
                    # materialises the Str at the call. The SVarDecl LOWERING
                    # coercion is then skipped by its `var_type != gs_tid_decl`
                    # guard, so exactly one wrap fires. Mirrors getenv.
                    bool rs_ext_is_cstr = false
                    match rs_ext_fd.return_type.ty:
                        case TPrimitive(rs_cstr_n):
                            if rs_cstr_n == "cstr":
                                rs_ext_is_cstr = true
                        case TNamed(rs_cstr_n2, _):
                            if rs_cstr_n2 == "cstr":
                                rs_ext_is_cstr = true
                        else:
                            pass
                    if rs_ext_is_cstr:
                        rs_ext_rt = lookup_or_register_named(&gmod, "GorgetString")
                    if rs_ext_rt != I64_TYPE:
                        gmod.fn_sigs.put(rs_ext_fd.name.clone(), rs_ext_rt)
                        # Extract the `= "symbol"` C name from the stub body and
                        # register the sig under it too (the redirect-resolved key).
                        if rs_ext_fd.body.len() == 1:
                            match rs_ext_fd.body.get(0).unwrap():
                                case SReturn(rs_ext_ret_opt):
                                    match rs_ext_ret_opt:
                                        case Some(rs_ext_ret):
                                            match rs_ext_ret.expr:
                                                case EStringLiteral(rs_ext_sym, _):
                                                    gmod.fn_sigs.put(rs_ext_sym.clone(), rs_ext_rt)
                                                else:
                                                    pass
                                        case None:
                                            pass
                                case SExpr(rs_ext_sx):
                                    match rs_ext_sx.expr:
                                        case EStringLiteral(rs_ext_sym2, _):
                                            gmod.fn_sigs.put(rs_ext_sym2.clone(), rs_ext_rt)
                                        else:
                                            pass
                                else:
                                    pass
            else:
                pass

    # Pre-scan: evaluate IConstDecl AND IStaticDecl init exprs and register
    # values in gmod.const_decls. Without this, references to module-level
    # consts (e.g. `const int KW_IF = 5` in parser.gg) default to 0 at
    # EIdentifier lowering, which confuses the self-compiled parser's
    # keyword dispatch and deadlocks in check_kw(kw=0, pos=0).
    #
    # IStaticDecl covers the *non-const* spelling at module scope, e.g.
    # `int STRING_MARKER = -2` in lower.gg. The parser routes those
    # through `IStaticDecl(ty, name, val)` (parser.gg:3517-3519), but
    # before this loop was extended, the lowerer ignored them entirely
    # — every reference to `STRING_MARKER` got the EIdentifier
    # unknown-fallback (OpConstI64(0)).
    for cd_item in m.items:
        match cd_item:
            case IConstDecl(_, cd_name, cd_val):
                Option[int] cd_eval = eval_const_int_expr(cd_val, &gmod)
                match cd_eval:
                    case Some(cv):
                        gmod.const_decls.put(cd_name.clone(), cv)
                    case None:
                        # Float fallback: `const float EPSILON = 0.000001`
                        # lands here when int eval fails.
                        Option[float] cd_feval = eval_const_float_expr(cd_val, &gmod)
                        match cd_feval:
                            case Some(cfv):
                                gmod.float_const_decls.put(cd_name.clone(), cfv)
                            case None:
                                # Bool fallback: `const bool ENABLED = true`.
                                Option[bool] cd_beval = eval_const_bool_expr(cd_val, &gmod)
                                match cd_beval:
                                    case Some(cbv):
                                        gmod.bool_const_decls.put(cd_name.clone(), cbv)
                                    case None:
                                        # String fallback: `const String G = "hi"`.
                                        Option[String] cd_seval = eval_const_string_expr(cd_val, &gmod)
                                        match cd_seval:
                                            case Some(csv):
                                                gmod.string_const_decls.put(cd_name.clone(), csv)
                                            case None:
                                                pass
            case IStaticDecl(sd_ty, sd_name, sd_val):
                # A `static` is MUTABLE module-level storage, NOT a `const`.
                # A scalar-literal init (`static int x = 0`, `static float
                # y = -1.5`, `static bool b = true`) is a mutable GLOBAL —
                # register it under `gmod.statics` as a const-bytes init
                # (GGSTATIC_BYTES) so the C backend emits a const initializer
                # at the declaration (`int64_t __lir_gN = 0LL;`), NOT a
                # runtime synth fn. An SAssign / SCompoundAssign still writes
                # back (the global is mutable). This is preferable to
                # const-folding into `const_decls` (which would silently drop
                # the write). Mirrors Rust's every-StaticDecl-is-a-mutable-
                # Global rule emitting a scalar literal via `GlobalInit::Bytes`
                # (`src/ir/lowering/mod.rs:1224-1232`, `:2459-2461`). Only
                # `const`s (the IConstDecl arm above) fold to compile-time
                # values.
                bool sd_is_scalar = static_is_scalar_literal_init(sd_val)
                if sd_is_scalar:
                    register_scalar_static(&gmod, sd_ty, sd_name, sd_val)
                else:
                    Option[int] sd_eval = eval_const_int_expr(sd_val, &gmod)
                    match sd_eval:
                        case Some(sv):
                            gmod.const_decls.put(sd_name.clone(), sv)
                        case None:
                            # Float fallback: `float EPSILON = 0.000001`
                            # at module scope (e.g., lib/xtd/math3d.gg).
                            Option[float] sd_feval = eval_const_float_expr(sd_val, &gmod)
                            match sd_feval:
                                case Some(sfv):
                                    gmod.float_const_decls.put(sd_name.clone(), sfv)
                                case None:
                                    # Runtime-call fallback: `public static File
                                    # stdout = _stdout_handle()` etc. Mirrors Rust
                                    # gg's `LoweringContext::global_names`. Helper
                                    # extracts the C runtime symbol; helper lives
                                    # in its own fn so this dispatch site stays
                                    # tight (the int/float cascade already lives
                                    # in lower_expr-adjacent stack frames).
                                    bool sd_handled = try_register_static_runtime_call(&gmod, sd_ty, sd_name, sd_val)
                                    if not sd_handled:
                                        # Recognise `Option[T] X = None` and record the
                                        # const's concrete Option type_id, so an EIdentifier
                                        # reference emits a properly-typed `None` (IEnumInit,
                                        # tag 1) rather than an 8-byte OpConstUnit() that
                                        # add_local's drop-emission clone over-reads.
                                        match sd_val.expr:
                                            case ENoneLiteral():
                                                int opt_tid = map_ast_type(sd_ty, &gmod)
                                                gmod.none_decls.put(sd_name.clone(), opt_tid)
                                            else:
                                                # Composite-init static. Two Rust-faithful
                                                # paths (see the helper docstrings):
                                                #  (2) collection CONSTRUCTOR (`Vector[int]()`
                                                #      / `Dict()`) → direct allocator init_expr,
                                                #      no synth fn (tried first).
                                                #  (1) array/dict LITERAL (`= [..]` / `= {..}`)
                                                #      → register a synth-fn call; the matching
                                                #      `__gg_static_init_<name>()` FunctionDef is
                                                #      synthesized + lowered in the non-generic
                                                #      function loop below (full registry ready).
                                                #  (4) SYNC-PRIMITIVE CONSTRUCTOR
                                                #      (`AtomicInt(0)` / `Barrier(2)` /
                                                #      `CondVar()`) → a GINIT_RUNTIME_CALL
                                                #      `gorget_<kind>_new(args)` static typed
                                                #      `Ptr(Named(cname))`. Tried FIRST so a
                                                #      module-level sync global registers as a
                                                #      runtime-allocated handle (NOT a struct
                                                #      compound literal / placeholder). Mirrors
                                                #      Rust GlobalInit::Extern (mod.rs:2650).
                                                bool sd_ctor = try_register_sync_ctor_static(&gmod, sd_ty, sd_name, sd_val)
                                                if not sd_ctor:
                                                    sd_ctor = try_register_collection_ctor_static(&gmod, sd_ty, sd_name, sd_val)
                                                if not sd_ctor:
                                                    #  (3) user-struct CONSTRUCTOR (`Counter(0)`)
                                                    #      with all-literal args → direct
                                                    #      GINIT_BYTES struct compound literal,
                                                    #      no synth fn (mirror Rust
                                                    #      GlobalInit::Struct).
                                                    sd_ctor = try_register_struct_ctor_static(&gmod, sd_ty, sd_name, sd_val)
                                                if not sd_ctor and static_is_literal_init(sd_val):
                                                    register_literal_static(&gmod, sd_ty, sd_name)
            else:
                pass

    # Collect generic templates and discover instances. Restored to
    # Dict-backed storage once the underlying Dict[String, _] codegen
    # bug was fixed (see DONE.md 2026-05-01).
    Dict[String, FunctionDef] fn_templates = {}
    Vector[EquipBlock] equip_templates = []
    Dict[String, bool] equip_generic_names = {}
    Dict[String, bool] seen_instances = {}
    Vector[GenericInstance] generic_instances = []
    # method instances discovered inside MONOMORPHIZED generic-fn
    # bodies (e.g. `Key__hash__FxHasher` from `hash_of[Key]`'s
    # `v.hash[FxHasher]`). Collected in the transitive-fixpoint loop where the
    # mono substitution is known; merged into proto_minsts before body emit.
    Vector[ProtoMethInst] mono_method_insts = []
    Dict[String, bool] mono_method_seen = {}
    # ALL equip blocks (incl. non-generic ones like `equip Key with
    # Hashable`), used to find the body of an equip-overridden method-level-
    # generic for a concrete non-generic receiver. The `equip_templates`
    # vector above only holds GENERIC equip blocks, so it misses these.
    Vector[EquipBlock] all_equip_blocks = []
    for aeq_item in m.items:
        match aeq_item:
            case IEquip(aeq_blk):
                all_equip_blocks.push(aeq_blk)
            else:
                pass

    for gitem in m.items:
        match gitem:
            case IFunction(fdef):
                if fdef.type_params.len() > 0:
                    fn_templates.put(fdef.name.clone(), fdef)
                # Register a MAIN-MODULE inline extern's `= "symbol"` redirect
                # (`extern int f(...) = "sym"`). load_imports only scans IMPORTED
                # modules, so the main module's own externs never reach
                # call_redirects otherwise → the bare name is emitted unresolved
                # (undefined reference). Done in this PRE-PASS (not the body loop)
                # so an extern declared AFTER main() is already registered when
                # main's body is lowered — registration here is order-robust;
                # in-loop registration is not. Use gmod.call_redirects (the bare
                # param was moved into gmod at :2713).
                if fdef.is_extern_stub and fdef.body.len() == 1:
                    Stmt ext_s = fdef.body.get(0).unwrap()
                    match ext_s:
                        case SReturn(ext_ret_opt):
                            match ext_ret_opt:
                                case Some(ext_ret_expr):
                                    match ext_ret_expr.expr:
                                        case EStringLiteral(ext_sym, _):
                                            gmod.call_redirects.put(fdef.name.clone(), ext_sym.clone())
                                        else:
                                            pass
                                case None:
                                    pass
                        case SExpr(ext_sx):
                            match ext_sx.expr:
                                case EStringLiteral(ext_sym2, _):
                                    gmod.call_redirects.put(fdef.name.clone(), ext_sym2.clone())
                                else:
                                    pass
                        else:
                            pass
            case IEquip(eqblk):
                # Check if equip is generic: either type_params set OR target has type args
                bool is_generic_equip = eqblk.type_params.len() > 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        if eq_targs.len() > 0:
                            is_generic_equip = true
                        if is_generic_equip:
                            equip_templates.push(eqblk)
                            if not equip_generic_names.contains(tname):
                                equip_generic_names.put(tname.clone(), true)
                    else:
                        pass
            else:
                pass

    # Collect generic struct templates for resource type detection
    Dict[String, StructDef] struct_templates = {}
    for st_item in m.items:
        match st_item:
            case IStruct(sdef):
                if sdef.type_params.len() > 0:
                    struct_templates.put(sdef.name.clone(), sdef)
            else:
                pass

    # Collect generic ENUM templates so a mono'd `Wrapper[int]` can be
    # registered as a REAL enum (substituted variant payloads) below, mirroring
    # struct_templates. USER generic enums only — the prelude Option/Result path
    # is synthesized separately (lir_lower Pass 3) and MUST NOT be touched here.
    Dict[String, EnumDef] enum_templates = {}
    for et_item in m.items:
        match et_item:
            case IEnum(edef):
                if edef.type_params.len() > 0:
                    enum_templates.put(edef.name.clone(), edef)
            else:
                pass

    # Discover generic call sites and type instances from all function/equip bodies.
    # Each body walks with its ENCLOSING declared type params as the type-variable
    # context (Rust-mirroring: generics/mod.rs current_generic_params) — a targ is
    # a type variable iff it names an in-scope param, NEVER by name-shape guess.
    for ditem in m.items:
        match ditem:
            case IFunction(fdef):
                Dict[String, bool] dgc_tparams = {}
                for dgc_tp in fdef.type_params:
                    dgc_tparams.put(dgc_tp.clone(), true)
                discover_generic_calls_stmts(fdef.body, &seen_instances, &generic_instances, &dgc_tparams)
            case IEquip(eqblk):
                for mdef in eqblk.methods:
                    Dict[String, bool] dgc_eq_tparams = {}
                    for dgc_etp in eqblk.type_params:
                        dgc_eq_tparams.put(dgc_etp.clone(), true)
                    # An equip can be generic via bare target args alone
                    # (`equip Dict[K, V]:` with empty type_params) — those
                    # bare arg names bind as params for the method bodies.
                    # Rust-mirror gate (generics/mod.rs:258): bare target args
                    # are implicit params ONLY when the equip declares no
                    # explicit `[X]` list — `equip [X] Foo[ConcreteBare]:`
                    # keeps ConcreteBare concrete.
                    if eqblk.type_params.len() == 0:
                        match eqblk.target.ty:
                            case TNamed(_, dgc_eq_targs):
                                for dgc_eqa in dgc_eq_targs:
                                    match dgc_eqa.ty:
                                        case TNamed(dgc_eqa_name, dgc_eqa_inner):
                                            if dgc_eqa_inner.len() == 0:
                                                dgc_eq_tparams.put(dgc_eqa_name.clone(), true)
                                        else:
                                            pass
                            else:
                                pass
                    for dgc_mtp in mdef.type_params:
                        dgc_eq_tparams.put(dgc_mtp.clone(), true)
                    discover_generic_calls_stmts(mdef.body, &seen_instances, &generic_instances, &dgc_eq_tparams)
            else:
                pass

    # Lazy-iterator transitive adapter-instance discovery: register the RESULT
    # type of each adapter chain link (e.g. `TakeIter[VectorIter[int], int]`,
    # `FilterIter[TakeIter[…], int, F]`) so the generic-equip + method-mono
    # emission loops below monomorphize the adapter struct + its methods. The
    # up-front `discover_generic_calls_*` walk above only sees explicit
    # annotations + turbofish constructors; the inner adapter results of an
    # `auto`/chained expression are produced inside default-method bodies and
    # would otherwise stay undiscovered (CALLED-but-never-DEFINED → CC-fail).
    # Reads the typechecker's per-link `expr_link_types` (the chain-link oracle)
    # — the self-host analog of Rust's `try_register_default_return_type`.
    for aitem in m.items:
        match aitem:
            case IFunction(afdef):
                discover_adapter_chain_stmts(afdef.body, &gmod, equip_generic_names, &seen_instances, &generic_instances)
            case IEquip(aeqblk):
                for amdef in aeqblk.methods:
                    discover_adapter_chain_stmts(amdef.body, &gmod, equip_generic_names, &seen_instances, &generic_instances)
            else:
                pass

    # Transitive generic discovery: fixpoint loop to find instances needed
    # inside already-discovered generic function bodies (e.g. tensor_zeros[T]
    # inside tensor_sum_axis[float], meta-op calls like tensor_scalar_op[T](t, val, meta /)).
    # Also walks generic-equip method return types + bodies so the
    # iterator chain `Vector[int]` → `VectorIter[int]` → `next()` returns
    # `Option[int]` cascade is discovered without explicit annotations
    # at every call site.
    bool transitive_changed = true
    while transitive_changed:
        transitive_changed = false
        int tfix_i = 0
        int tfix_end = generic_instances.len()
        while tfix_i < tfix_end:
            GenericInstance tinst = generic_instances.get(tfix_i).unwrap()
            String tfix_key = tinst.base_name.clone()
            if not fn_templates.contains(tfix_key) and gmod.call_redirects.contains(tinst.base_name):
                tfix_key = gmod.call_redirects.get(tinst.base_name).unwrap()
            if fn_templates.contains(tfix_key):
                FunctionDef tfix_tmpl = fn_templates.get(tfix_key).unwrap()
                if tfix_tmpl.type_params.len() > 0:
                    Dict[String, SpannedType] type_sub_map = {}
                    int tpi = 0
                    while tpi < tfix_tmpl.type_params.len() and tpi < tinst.type_args.len():
                        String tpname = tfix_tmpl.type_params.get(tpi).unwrap()
                        SpannedType tpta = tinst.type_args.get(tpi).unwrap()
                        type_sub_map.put(tpname, tpta)
                        tpi += 1
                    int prev_count = generic_instances.len()
                    discover_transitive_stmts(tfix_tmpl.body, &type_sub_map, &seen_instances, &generic_instances)
                    if generic_instances.len() > prev_count:
                        transitive_changed = true
                    # method-instance discovery in this mono'd body.
                    # Build a param-name -> declared-type map for receiver
                    # resolution, then walk for turbofish method calls.
                    Dict[String, SpannedType] tfix_params = {}
                    for tfp in tfix_tmpl.params:
                        tfix_params.put(tfp.param_name.clone(), tfp.param_type)
                    discover_mono_method_insts(tfix_tmpl.body, tfix_params, &type_sub_map, &gmod, &mono_method_insts, &mono_method_seen)
            # Generic-equip transitive walk: for each instance whose target
            # has equip blocks, harvest the method return types (with subs)
            # AND walk method bodies for further generic call sites. This
            # lets `Vector[int]` discover `VectorIter[int]`, `VectorDrain[int]`,
            # … which in turn unlock their own `next()`/`iter()` cascades.
            if equip_generic_names.contains(tinst.base_name):
                for eqf_tmpl in equip_templates:
                    String eqf_target = ""
                    match eqf_tmpl.target.ty:
                        case TNamed(etn, _):
                            eqf_target = etn
                        else:
                            pass
                    if eqf_target == tinst.base_name:
                        Vector[String] eqf_tparams = extract_equip_type_params(eqf_tmpl)
                        Dict[String, SpannedType] eqf_sub_map = {}
                        int etpi = 0
                        while etpi < eqf_tparams.len() and etpi < tinst.type_args.len():
                            String etpname = eqf_tparams.get(etpi).unwrap()
                            SpannedType etpta = tinst.type_args.get(etpi).unwrap()
                            eqf_sub_map.put(etpname, etpta)
                            etpi += 1
                        int eqf_prev = generic_instances.len()
                        for eqf_meth in eqf_tmpl.methods:
                            # Method return type — substitute and register as
                            # a generic instance if it names a generic type
                            # (e.g. `VectorIter[T]` → `VectorIter[int]`).
                            # Type-variable ctx = the equip's DECLARED params
                            # ∪ the method's own params (Rust mirror:
                            # generics/mod.rs:380-390) — NOT eqf_sub_map.keys(),
                            # which is eqf_tparams truncated to the instance's
                            # arity and would let an unsubstituted equip param
                            # slip past on arity mismatch. The method-params
                            # term keeps method-level generics (`drain[U]` →
                            # `VectorDrain[U]`) from registering phantom
                            # instances like `VectorDrain__U`.
                            Dict[String, bool] eqf_ctx = {}
                            for eqf_ctx_tp in eqf_tparams:
                                eqf_ctx.put(eqf_ctx_tp.clone(), true)
                            for eqf_ctx_mtp in eqf_meth.type_params:
                                eqf_ctx.put(eqf_ctx_mtp.clone(), true)
                            SpannedType ret_sub = substitute_type(eqf_meth.return_type, &eqf_sub_map)
                            match ret_sub.ty:
                                case TNamed(rtname, rtargs):
                                    if rtargs.len() > 0 and not has_type_variable_ctx(rtargs, &eqf_ctx):
                                        String rt_mangled = compute_mangled_name(rtargs, rtname)
                                        if not seen_instances.contains(rt_mangled):
                                            seen_instances.put(rt_mangled.clone(), true)
                                            generic_instances.push(GenericInstance(rtname, rtargs, rt_mangled))
                                else:
                                    pass
                            # Method body — walk for ECall sites with type
                            # args (e.g. `return VectorIter[T](self, 0)`
                            # discovers `VectorIter[int]` via the constructor
                            # call). Skip method-level generics; those need
                            # per-call-site mono and aren't reached here.
                            if eqf_meth.type_params.len() == 0:
                                discover_transitive_stmts(eqf_meth.body, &eqf_sub_map, &seen_instances, &generic_instances)
                        if generic_instances.len() > eqf_prev:
                            transitive_changed = true
            tfix_i += 1

    # Register monomorphized struct types as resource types if any substituted
    # field is a resource type (e.g., Pair[int, String] has a String field)
    for mrinst in generic_instances:
        # Builtin collection base names (`Vector[T]`/`Dict[K,V]`/`Set[T]`/...)
        # are declared as empty-body stubs in lib/std/collections.gg
        # (`struct Vector[T]: pass`). Their monos (`Vector__bool`) are runtime
        # GorgetArray/GorgetMap/GorgetSet aliases, NOT user structs — they are
        # routed to the runtime type by lir_lower's `resource_meta_for`. Building
        # a user mono record here registers `Vector__bool` in type_infos with the
        # stub's single empty-named field → emit_structs emits the invalid C
        # `struct __gg_Vector__bool { void* ; };`. Mirror Rust gg, which
        # intercepts these base names BEFORE the generic-template path and routes
        # them to `register_collection_alias` (src/ir/lowering/types.rs:699).
        if is_builtin_collection_base(mrinst.base_name):
            continue
        # Box (the `struct Box[T]: pass` stub in lib/std/collections.gg) is a
        # runtime box-alloc type, NOT a user struct: its monos (`Box__SpannedType`)
        # are `typedef void* Box__<inner>` allocated via `__gorget_box_alloc_<inner>`
        # and routed by lir_lower's `resource_meta_for` BkRegularBox arm — NEVER an
        # inline struct with a `_0` field. Mirror Rust gg, which intercepts `"Box"`
        # alongside the collection bases in the SAME match arm BEFORE the
        # generic-template monomorphize path (src/ir/lowering/types.rs:699:
        # `"Vector" | "Dict" | ... | "Box" => { register_collection_alias(..); return }`).
        # Box is INTENTIONALLY excluded from `is_builtin_collection_base` (that helper
        # is the GorgetArray/Map/Set-backed set, enforced by tests/lints.rs
        # `collection_base_names_single_source`), so the skip is a SEPARATE typed read
        # of the `box_kind` channel here — the same `BkRegularBox`/`BkTraitBox`
        # discriminator the build_resource_metadata arms (lir_lower.gg:311/416)
        # populate and lir_lower.gg:636 reads, NOT a `Box`-name string match.
        # Without this skip, de-keywording `Box` (so `struct Box[T]: pass` registers
        # as a template) lets `Box[SpannedType]` reach this loop → `Box__SpannedType`
        # is registered in `type_infos` as a struct → its ctor's dst slot types as the
        # struct → `try_lower_user_struct_ctor` emits `((Box__SpannedType*)x)->_0 = ..`
        # against the `typedef void*` → stage-1 cc fails (`request for member '_0' in
        # something not a structure or union`).
        bool mrinst_is_box = false
        match resource_meta_for(&gmod, mrinst.base_name):
            case Some(mrinst_rm):
                match mrinst_rm.box_kind:
                    case BkRegularBox():
                        mrinst_is_box = true
                    case BkTraitBox():
                        mrinst_is_box = true
                    case BkNotBox():
                        pass
            case None:
                pass
        if mrinst_is_box:
            continue
        if struct_templates.contains(mrinst.base_name):
            StructDef sdef = struct_templates.get(mrinst.base_name).unwrap()
            # Build substitution map
            setup_type_subs(&gmod, sdef.type_params, mrinst.type_args)
            # Register the mono'd struct's field info in `type_infos` so
            # later `EFieldAccess` lookups find `TypedColumn__int64_t.data`
            # / `Tensor__double.shape` etc. without falling through to
            # the `[bug]` placeholder. Field types are template-fields
            # substituted via `gmod.type_subs` (T → int64_t etc.).
            # Mirrors Rust gg's `monomorphize_struct()` step
            # (`src/ir/lowering/generics/mod.rs:2249-2304`).
            Vector[GirFieldInfo] mono_fields = []
            bool has_resource = false
            # Per-field move flags for the MONO'd struct constructor (see
            # below). A field is "owning" (CkCallArgOwning → clone-or-move
            # at the ctor arg) iff its SUBSTITUTED type is a resource.
            Vector[bool] mono_ctor_moves = []
            # Parallel all-None defaults for the mono'd ctor (synthetic — no
            # user defaults). Keeps fn_defaults in lockstep with fn_move_params.
            Vector[Option[SpannedExpr]] mono_ctor_defaults = []
            for fld in sdef.fields:
                int ft = map_ast_type(fld.param_type, &gmod)
                String ft_name = type_id_to_name(ft, &gmod)
                # PROTO phase-1b: a struct field whose template type is a
                # type-param bound to a FUNCTION type (e.g. MapIter's `F f`
                # where F=int(int)) must lay out as a GorgetClosure value
                # (16 bytes: fn-ptr + env), not a truncated int64_t pointer.
                # Mirrors Rust gg laying out `GorgetClosure f`.
                match fld.param_type.ty:
                    case TNamed(p_fname, _):
                        int p_fpi = 0
                        while p_fpi < sdef.type_params.len():
                            if sdef.type_params.get(p_fpi).unwrap() == p_fname and p_fpi < mrinst.type_args.len():
                                match mrinst.type_args.get(p_fpi).unwrap().ty:
                                    case TFunction(_, _, _):
                                        ft_name = "GorgetClosure"
                                    else:
                                        pass
                            p_fpi += 1
                    else:
                        pass
                mono_fields.push(GirFieldInfo(fld.param_name.clone(), ft_name.clone()))
                bool fld_is_res = is_resource_type_name(ft_name, &gmod)
                mono_ctor_moves.push(fld_is_res)
                mono_ctor_defaults.push(None)
                if fld_is_res:
                    has_resource = true
            # Register only when the mono'd name isn't already there
            # (avoids duplicate clones when `generic_instances` lists
            # the same mono more than once across import cycles).
            if not gmod.type_infos.contains(mrinst.mangled_name):
                Vector[GirEnumVariantInfo] mono_no_variants = []
                gmod.type_infos.put(mrinst.mangled_name.clone(), GirTypeInfo(mrinst.mangled_name.clone(), mono_fields, mono_no_variants, false))
            # Register the MONO'd ctor in fn_move_params, keyed by the mangled
            # name. Fix D (lower.gg:~13860) registers struct ctors ONLY under
            # the TEMPLATE name (`VectorIter`); a call to the MONO'd ctor
            # `VectorIter__int64_t(src, 0)` looks up `classify_call_arg(
            # "VectorIter__int64_t", 0)` → MISS → CkCallArgBorrow → the
            # borrowed-`&self` source is byte-aliased (shallow memcpy, no
            # clone) into the field → the source AND the field both free the
            # same buffer at scope exit → double-free. This is the lazy-
            # iterator double-free (`iter(&self)` returns `VectorIter[T](self,
            # 0)`): the mono'd `Vector__int64_t__iter`'s ctor arg must CLONE
            # the borrowed source, exactly as the non-generic ctor does. Mirror
            # Fix D's per-field resource flags for the mono'd instance. (Same
            # mono-vs-template registration gap as the fn_sigs / Gap-B class.)
            if not gmod.fn_move_params.contains(mrinst.mangled_name):
                gmod.fn_move_params.put(mrinst.mangled_name.clone(), mono_ctor_moves)
                gmod.fn_defaults.put(mrinst.mangled_name.clone(), mono_ctor_defaults)
            clear_type_subs(&gmod)
            if has_resource:
                gmod.resource_types.put(mrinst.mangled_name.clone(), true)

    # Register monomorphized USER generic ENUM types with substituted
    # variant payloads, mirroring the struct arm above + Rust gg's
    # `monomorphize_enum` (src/ir/lowering/generics/mod.rs:2422). Without this a
    # mono'd `Wrapper[int]` falls through to a degenerate `struct { char __pad }`
    # with no variants → the derived `hash` body's `case Value(a0): a0.hash(&h)`
    # can't resolve `a0`'s payload type to int64_t → it dispatches the generic
    # `T__hash` (undefined symbol → CC-fail). Registering the mono'd enum in
    # `type_infos` (is_enum, subbed variant payloads), `enum_registry`, and
    # `enum_variant_parent_idx` lets `lookup_ctor_field_type` /
    # `match_enum_type` / `match_variant_index` resolve the bind as int64_t,
    # so `.hash(&h)` lowers to the primitive `FxHasher__write_int`.
    # USER enums ONLY — Option/Result are synthesized in lir_lower Pass 3 and
    # are NOT in `enum_templates`, so this loop never touches the prelude path.
    for meinst in generic_instances:
        if enum_templates.contains(meinst.base_name):
            EnumDef edef = enum_templates.get(meinst.base_name).unwrap()
            setup_type_subs(&gmod, edef.type_params, meinst.type_args)
            Vector[GirEnumVariantInfo] mono_variants = []
            Vector[String] mono_variant_names = []
            bool enum_has_resource = false
            for evar in edef.variants:
                Vector[GirFieldInfo] vfields = []
                int vfi = 0
                while vfi < evar.fields.len():
                    SpannedType vft = evar.fields.get(vfi).unwrap()
                    int vft_tid = map_ast_type(vft, &gmod)
                    String vft_name = type_id_to_name(vft_tid, &gmod)
                    vfields.push(GirFieldInfo("_" + int_to_str(vfi), vft_name.clone()))
                    if is_resource_type_name(vft_name, &gmod):
                        enum_has_resource = true
                    vfi += 1
                mono_variants.push(GirEnumVariantInfo(evar.name.clone(), vfields))
                mono_variant_names.push(evar.name.clone())
            clear_type_subs(&gmod)
            if not gmod.type_infos.contains(meinst.mangled_name):
                Vector[GirFieldInfo] mono_enum_no_fields = []
                gmod.type_infos.put(meinst.mangled_name.clone(), GirTypeInfo(meinst.mangled_name.clone(), mono_enum_no_fields, mono_variants, true))
            if not gmod.enum_registry.contains(meinst.mangled_name):
                gmod.enum_registry.put(meinst.mangled_name.clone(), mono_variant_names.clone())
            for mevn in mono_variant_names:
                if not gmod.enum_variant_parent_idx.contains(mevn):
                    gmod.enum_variant_parent_idx.put(mevn.clone(), meinst.mangled_name.clone())
            if enum_has_resource:
                gmod.resource_types.put(meinst.mangled_name.clone(), true)

    # Snag #11 / Root #1: a registered (bodied) trait keeps its equip-symbol
    # prefix BARE (Rust's vtable route); an UNREGISTERED trait (From/operators)
    # carries the generic suffix. The authoritative `trait_defs` map is built
    # later (~:2964), after this fn_sigs pre-pass, so scan the trait DEFS up
    # front here. `registered_trait_names` drives the bare-vs-suffixed prefix
    # choice; `pre_trait_defs` additionally yields each trait's OWN-vtable
    # method set (`tdef.methods`) so the IEquip registration can DROP the
    # spurious bare `Type__method` for own-vtable methods (their bodies are
    # emitted under `Trait_for_Type__method`). Both maps are built from the same
    # `m.items` ITrait entries as `trait_defs` (:2964), so the own-vtable gate
    # here matches the body-emit `did_split` gate exactly.
    Dict[String, bool] registered_trait_names = {}
    Dict[String, TraitDef] pre_trait_defs = {}
    for rtn_item in m.items:
        match rtn_item:
            case ITrait(rtn_tdef):
                registered_trait_names.put(rtn_tdef.name.clone(), true)
                pre_trait_defs.put(rtn_tdef.name.clone(), rtn_tdef)
            else:
                pass

    # Populate fn_sigs for non-generic functions using map_ast_type now that
    # gmod.type_table is accessible. Pre-scan only handled TPrimitive return
    # types; this pass captures TNamed (String, Vector[T], …).
    for fs_item in m.items:
        match fs_item:
            case IFunction(fsdef):
                if fsdef.type_params.len() == 0 and fsdef.name != "main":
                    # Order-independent param-type registration (Rust gg
                    # `src/ir/lowering/mod.rs:656`): record each param's DECLARED
                    # VALUE-type id under the fn name, so a forward-ref callee
                    # (absent from `gmod.functions` at the caller's lower time)
                    # still yields its param types. Read ONLY as a FALLBACK in
                    # `get_fn_param_types` (lower_types.gg) — the lowered
                    # `gmod.functions` scan stays primary because it carries the
                    # ABI-WRAPPED (Ptr/MutPtr) tids the by-ptr arg detection
                    # needs; this fills the forward-ref MISS with the unwrapped
                    # value types (peeled as a no-op downstream).
                    #
                    # SKIP extern stubs (`is_extern_stub`): a stub has no lowered
                    # body, so it can never be the forward-ref-callee-with-a-bare-
                    # `None`-arg case this pre-pass exists to type (an extern's
                    # by-pointer param goes through the `&`/`!` sigil + borrow_flags
                    # path, not the value-None expected-type path). Crucially,
                    # `map_ast_type` has a REGISTRATION SIDE EFFECT
                    # (`lookup_or_register_named` at lower_types.gg:645) — eagerly
                    # mapping a stub's param like `wait(Guard[bool])`
                    # (lib/std/sync.gg) would register `Guard__bool` as a named
                    # type that NOTHING else uses, emitting a dangling
                    # `typedef gorget_guard_t Guard__bool;` (unknown runtime type)
                    # → CC-FAIL on the sync/thread fixtures. The existing fn_sigs
                    # ret-type registration below never tripped this because a
                    # `void`/primitive return maps without registration. Gate it
                    # out at the source.
                    if not fsdef.is_extern_stub:
                        Vector[int] fps_param_tids = []
                        # Ordered param NAMES for named-arg REORDERING in
                        # lower_call (a named arg skipping a middle defaulted
                        # param must land in its by-name slot). Same source loop
                        # as the param-type sigs; mirrors Rust gg's
                        # `ctx.fn_param_names` pre-pass.
                        Vector[String] fps_param_names = []
                        for fps_p in fsdef.params:
                            fps_param_tids.push(map_ast_type(fps_p.param_type, &gmod))
                            fps_param_names.push(fps_p.param_name.clone())
                        gmod.fn_param_sigs.put(fsdef.name.clone(), !fps_param_tids)
                        gmod.fn_param_names.put(fsdef.name.clone(), !fps_param_names)
                    int ret_tid = map_fn_return_type(fsdef.return_type, &gmod)
                    # Honour throws_type for Result[T, E] wrapping. This is the
                    # AUTHORITATIVE fn_sigs pass (it runs after the pre-scan and
                    # the named-return refine pass, overwriting both), so the
                    # throws-wrap MUST live here too — otherwise a
                    # `T f(...) throws E` records the UNWRAPPED `T` and a
                    # `catch`/`match` on the call sees a `T` scrutinee where the
                    # actual call returns `Result__T__E` (slot type-mismatch →
                    # zero-init). Mirrors the function-build wrap at `:7472`.
                    match fsdef.throws_type:
                        case Some(fs_throws):
                            int fs_ok = ret_tid
                            int fs_err = map_ast_type(fs_throws, &gmod)
                            if ret_tid >= 0 and fs_err >= 0:
                                String fs_ret_c = type_id_to_name(ret_tid, &gmod)
                                String fs_err_c = type_id_to_name(fs_err, &gmod)
                                ret_tid = lookup_or_register_named(&gmod, "Result__" + fs_ret_c + "__" + fs_err_c)
                                record_enum_category(&gmod, ret_tid, ENUM_CAT_RESULT, fs_ok, fs_err)
                        case None:
                            pass
                    if ret_tid >= 0:
                        gmod.fn_sigs.put(fsdef.name.clone(), ret_tid)
            case IEquip(ieqblk):
                # Register equip-block methods as TypeName__method in fn_sigs.
                # Only for non-generic equip blocks on concrete types.
                if ieqblk.type_params.len() == 0:
                    String target_name = ""
                    match ieqblk.target.ty:
                        case TNamed(tn, targs):
                            if targs.len() == 0:
                                # Root #1 spelling fix: the equip target must be
                                # spelled with the SAME C-normalized name the
                                # body-emit uses (lower.gg `eq_target_sp =
                                # type_to_c_name(eqblk.target)`) and the call-site
                                # trait-redirect searches (lower_expr.gg
                                # `_for_<recv_type_name>__<m>`, recv normalized to
                                # e.g. GorgetString). Using the raw surface name
                                # `tn` registered `Writer_for_String__write` while
                                # the body defined `Writer_for_GorgetString__write`
                                # — the redirect missed, and a `String.write()`
                                # (equip String with Writer) fell through to the
                                # builtin `gorget_str_write` (undefined). One source
                                # of truth: type_to_c_name (Layering rule 3).
                                target_name = type_to_c_name(ieqblk.target, &gmod)
                        case TPrimitive(tn):
                            target_name = type_to_c_name(ieqblk.target, &gmod)
                        else:
                            pass
                    if target_name != "":
                        # Root #1 — own-vtable vs inherited registration split,
                        # mirroring the body-emit split (lower.gg lower_module
                        # `did_split` path) and Rust gg's `register_trait_equip_sigs`
                        # (`src/ir/lowering/traits.rs:269-344`). The body of an
                        # own-vtable trait method is emitted under the trait-prefixed
                        # symbol `Trait_for_Type__method`; the bare `Type__method`
                        # has NO definition, so registering it (the old
                        # unconditional `gmod.fn_sigs.put(em_full, ...)`) was a
                        # layering rule-2/4 violation: it let the call site spell a
                        # CALLED-but-undefined symbol (→ C implicit-int /
                        # undefined-reference). We DROP the bare entry for own-vtable
                        # methods on the registered (non-derive) route; the call site
                        # then suffix-redirects to the trait-prefixed symbol.
                        #
                        # `is_own_vtable` mirrors the body's gate EXACTLY:
                        # non-derive (not builtin/iterator-protocol) AND a bodied
                        # TraitDef is in scope (`pre_trait_defs` is built from the
                        # same `m.items` ITrait entries as `trait_defs` at :2964).
                        # Method membership = the trait's OWN vtable (`tdef.methods`),
                        # the same set the body builds at :3283-3285.
                        Dict[String, bool] _own_vtable_methods = {}
                        bool _is_registered_trait = false
                        match ieqblk.trait_name:
                            case Some(otn):
                                bool _ot_derive = is_builtin_trait(otn) or is_iterator_protocol_trait(otn)
                                if not _ot_derive and pre_trait_defs.contains(otn):
                                    _is_registered_trait = true
                                    TraitDef _otdef = pre_trait_defs.get(otn).unwrap()
                                    for _ovm in _otdef.methods:
                                        _own_vtable_methods.put(_ovm.name.clone(), true)
                            case None:
                                pass
                        for em in ieqblk.methods:
                            if em.type_params.len() == 0:
                                int em_ret = map_fn_return_type(em.return_type, &gmod)
                                # Honour throws_type for Result[T, E] wrapping,
                                # mirroring the IFunction arm above (`:2854`) and
                                # the body-build wrap in lower_equip_block. A
                                # `T m(...) throws E` equip method returns
                                # `Result__T__E`; registering the bare `T` here
                                # mis-types every catch/match call site.
                                match em.throws_type:
                                    case Some(em_throws):
                                        int em_ok = em_ret
                                        int em_err = map_ast_type(em_throws, &gmod)
                                        if em_ret >= 0 and em_err >= 0:
                                            String em_ret_c = type_id_to_name(em_ret, &gmod)
                                            String em_err_c = type_id_to_name(em_err, &gmod)
                                            em_ret = lookup_or_register_named(&gmod, "Result__" + em_ret_c + "__" + em_err_c)
                                            record_enum_category(&gmod, em_ret, ENUM_CAT_RESULT, em_ok, em_err)
                                    case None:
                                        pass
                                if em_ret >= 0:
                                    String em_full = target_name + "__" + em.name
                                    # Register ordered param NAMES for equip methods
                                    # (named-arg REORDERING + default-fill in
                                    # lower_expr's method/static paths), keyed by the
                                    # bare `Type__method` mangling — surface-indexed
                                    # with `self` at idx 0 for instance methods, no
                                    # self for static methods. Mirrors the IFunction
                                    # `fn_param_names` registration above and Rust gg's
                                    # equip-method `fn_param_names` pre-pass
                                    # (`src/ir/lowering/mod.rs`). Without it the
                                    # reorder block can't resolve named method args by
                                    # slot (silent positional miscompile vs Rust).
                                    Vector[String] em_param_names = []
                                    for em_p in em.params:
                                        em_param_names.push(em_p.param_name.clone())
                                    gmod.fn_param_names.put(em_full.clone(), em_param_names)
                                    # Own-vtable method on the registered route: its
                                    # body is `Trait_for_Type__method`, so register
                                    # ONLY that and DROP the spurious bare entry
                                    # (Rust `traits.rs:277-292`). Inherited overrides,
                                    # derive/iterator methods, and unregistered-trait
                                    # instance methods keep the bare entry (body uses
                                    # `Type__method` there — Rust `traits.rs:293-324`
                                    # + `register_unregistered_trait_equip_sigs`
                                    # `:1125-1133`).
                                    bool _em_own_vtable = _is_registered_trait and _own_vtable_methods.contains(em.name)
                                    if not _em_own_vtable:
                                        gmod.fn_sigs.put(em_full, em_ret)
                                    # Snag #11: a non-derive explicit trait equip
                                    # (`equip BigErr with From[String]:`) emits its
                                    # method body under the PREFIXED symbol (see
                                    # lower_equip_block). Register that spelling too
                                    # — BARE `Trait_for_Type__m` on the REGISTERED/
                                    # vtable route, suffixed `Trait__<A>_for_Type__m`
                                    # on the UNREGISTERED route (From/operators) —
                                    # so the auto-prop From-conversion lookup
                                    # (lower_match.gg maybe_emit_from_conversion)
                                    # finds it. Mirrors the body mangling EXACTLY.
                                    match ieqblk.trait_name:
                                        case Some(etn):
                                            bool em_is_derive = is_builtin_trait(etn) or is_iterator_protocol_trait(etn)
                                            if not em_is_derive:
                                                String em_trait = mangle_trait_name(etn)
                                                if not registered_trait_names.contains(etn):
                                                    em_trait = mangle_trait_equip_name(etn, ieqblk.trait_generic_args)
                                                String em_pref = em_trait + "_for_" + target_name + "__" + em.name
                                                gmod.fn_sigs.put(em_pref, em_ret)
                                        case None:
                                            pass
                        # Register fn_sigs for trait DEFAULT methods the equip block
                        # does NOT override. Their bodies are emitted under
                        # `Trait_for_Type__method` (lower.gg lower_module default
                        # arm) but the call site has no fn_sigs entry to redirect to.
                        # Mirrors Rust gg's default-method sig registration
                        # (`src/ir/lowering/traits.rs:328-344`).
                        match ieqblk.trait_name:
                            case Some(dtn):
                                bool d_is_derive = is_builtin_trait(dtn) or is_iterator_protocol_trait(dtn)
                                if not d_is_derive and pre_trait_defs.contains(dtn):
                                    TraitDef _dtdef = pre_trait_defs.get(dtn).unwrap()
                                    Dict[String, bool] _overridden = {}
                                    for _om in ieqblk.methods:
                                        _overridden.put(_om.name.clone(), true)
                                    String _d_trait = mangle_trait_name(dtn)
                                    for _dm in _dtdef.methods:
                                        if _dm.body.len() > 0 and not _overridden.contains(_dm.name) and _dm.type_params.len() == 0:
                                            int _dm_ret = map_fn_return_type(_dm.return_type, &gmod)
                                            if _dm_ret >= 0:
                                                String _dm_pref = _d_trait + "_for_" + target_name + "__" + _dm.name
                                                gmod.fn_sigs.put(_dm_pref, _dm_ret)
                            case None:
                                pass
            else:
                pass

    # Register fn_sigs for monomorphized instances
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name
        String tmpl_key = inst.base_name.clone()
        if not fn_templates.contains(tmpl_key) and gmod.call_redirects.contains(inst.base_name):
            tmpl_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(tmpl_key):
            FunctionDef tmpl = fn_templates.get(tmpl_key).unwrap()
            # Compute return type with substitutions active
            setup_type_subs(&gmod, tmpl.type_params, inst.type_args)
            int rt = map_ast_type(tmpl.return_type, &gmod)
            clear_type_subs(&gmod)
            # Monomorphized generics use bare names (no module prefix)
            gmod.fn_sigs.put(inst.mangled_name.clone(), rt)

    # Register fn_sigs for monomorphized generic-equip methods. Mirrors the
    # function-template pre-pass above: fn_sigs entries must exist *before*
    # function bodies are lowered (line ~6155+) so call-site return-type
    # lookups (e.g. `v.iter()` in lower_for_iterator) resolve. The actual
    # equip-method bodies are emitted later at line ~6481 by
    # `lower_generic_equip` which strips trait_name and routes through
    # lower_equip_block — produces `Target__method` naming with type subs
    # applied. We mirror that naming here.
    for eqsi_inst in generic_instances:
        if equip_generic_names.contains(eqsi_inst.base_name):
            for eqs_tmpl in equip_templates:
                String eqs_target_name = ""
                match eqs_tmpl.target.ty:
                    case TNamed(etn, _):
                        eqs_target_name = etn
                    else:
                        pass
                if eqs_target_name == eqsi_inst.base_name:
                    Vector[String] eqs_type_params = extract_equip_type_params(eqs_tmpl)
                    setup_type_subs(&gmod, eqs_type_params, eqsi_inst.type_args)
                    # `type_to_c_name(target, …)` substitutes type vars from
                    # active subs — `Vector[T]` with T → int → `Vector__int64_t`.
                    String eqs_mono_target = type_to_c_name(eqs_tmpl.target, &gmod)
                    for eqs_mdef in eqs_tmpl.methods:
                        # Method-level generics (`fold[A, F]` etc.) skip this
                        # pre-pass; they need per-call-site mono of their own.
                        if eqs_mdef.type_params.len() == 0:
                            int eqs_ret = map_fn_return_type(eqs_mdef.return_type, &gmod)
                            if eqs_ret >= 0:
                                String eqs_mangled = eqs_mono_target + "__" + eqs_mdef.name
                                gmod.fn_sigs.put(eqs_mangled, eqs_ret)
                            # GENERIC-EQUIP `!`-PARAM MOVE CONTRACT (#14 class).
                            # Register the mono'd method's `!`/`&`-params in
                            # fn_move_params / fn_borrow_params under the SHORT
                            # `Target__method` key — the exact form
                            # `classify_call_arg` looks up at the call site
                            # (`recv_type_name + "__" + mname`, lower.gg:~5947).
                            # The `lower_module` pre-scan (IEquip case,
                            # lower.gg:~12972) does this only for NON-GENERIC
                            # equips; a generic-equip mono instance like
                            # `equip [T] Vector[T] with Drainable[T]:
                            # VectorDrain[T] drain(!self)` reaches the lowerer
                            # via `lower_generic_equip` AFTER function bodies are
                            # lowered, so its `Vector__int64_t__drain` was NEVER
                            # registered → classify_call_arg returned
                            # CkCallArgBorrow → the `!self` receiver was NOT
                            # move-zeroed → the drain SOURCE and the drain RESULT
                            # both owned the same buffer (a masked leak today; a
                            # double-free the instant owned-method-result
                            # registration goes general — lower.gg:~6138). This
                            # MUST run BEFORE function bodies are lowered
                            # (line ~13746+) so the call-site lookup resolves,
                            # exactly like the fn_sigs pre-pass it lives in.
                            # `eqs_mono_target` is the mono'd C name (type_subs
                            # active), so the key matches the call site. Param 0
                            # is `self`, aligned with classify_call_arg(_, 0).
                            Vector[bool] eqs_borrows = []
                            Vector[bool] eqs_moves = []
                            Vector[Option[SpannedExpr]] eqs_defaults = []
                            for eqs_p in eqs_mdef.params:
                                eqs_borrows.push(eqs_p.ownership == 1)
                                eqs_moves.push(eqs_p.ownership == 2)
                                eqs_defaults.push(eqs_p.default_value)
                            String eqs_mv_key = eqs_mono_target + "__" + eqs_mdef.name
                            gmod.fn_borrow_params.put(eqs_mv_key.clone(), eqs_borrows)
                            gmod.fn_move_params.put(eqs_mv_key.clone(), eqs_moves)
                            gmod.fn_defaults.put(eqs_mv_key, eqs_defaults)
                    clear_type_subs(&gmod)

    # Build trait lookup map for default method generation
    Dict[String, TraitDef] trait_defs = {}
    Dict[String, bool] local_struct_names = {}
    for td_item in m.items:
        match td_item:
            case ITrait(tdef):
                trait_defs.put(tdef.name.clone(), tdef)
            case IStruct(sdef):
                local_struct_names.put(sdef.name.clone(), true)
            case IEnum(edef):
                local_struct_names.put(edef.name.clone(), true)
            else:
                pass

    # Lazy-iterator Phase 1a — fn_sigs PRE-PASS for generic-equip TRAIT
    # DEFAULTS. The equip-method pre-pass above only registered fn_sigs for
    # the EXPLICIT equip methods (`eqs_tmpl.methods` → `next`); the trait
    # DEFAULTS (`take`/`skip`/`count`/…) live in the trait def, not the
    # equip. Their bodies are emitted later (A2 site, ~14730), but
    # CALL-SITE return-type lookups (`v.iter().take(3)`'s EMethodCall, in
    # `main` which is lowered BEFORE the A2 emit) read `fn_sigs` — so the
    # signature MUST be registered HERE, before any function body lowers,
    # exactly like the equip-method pre-pass. Without it, the call site
    # types the binding via `infer_method_return_type` (a name heuristic
    # that doesn't know `take`) → the local is mis-typed as the receiver
    # (`VectorIter__int64_t`) → `incompatible types ... from
    # __gg_TakeIter...`. Same naming + Self/T binding + method-generic
    # skip + demand-gate as the A2 emit (kept in lockstep). `trait_defs`
    # must already be built (above).
    for dsi_inst in generic_instances:
        if equip_generic_names.contains(dsi_inst.base_name):
            for dsi_tmpl in equip_templates:
                String dsi_target_name = ""
                match dsi_tmpl.target.ty:
                    case TNamed(dtn, _):
                        dsi_target_name = dtn
                    else:
                        pass
                if dsi_target_name == dsi_inst.base_name:
                    match dsi_tmpl.trait_name:
                        case Some(dsi_tname):
                            if not is_builtin_trait(dsi_tname) and trait_defs.contains(dsi_tname):
                                TraitDef dsi_tdef = trait_defs.get(dsi_tname).unwrap()
                                Dict[String, bool] dsi_overridden = {}
                                for dsi_om in dsi_tmpl.methods:
                                    dsi_overridden.put(dsi_om.name.clone(), true)
                                String dsi_mono = compute_mangled_name(dsi_inst.type_args, dsi_inst.base_name)
                                Vector[String] dsi_tparams = extract_equip_type_params(dsi_tmpl)
                                setup_type_subs(&gmod, dsi_tparams, dsi_inst.type_args)
                                int dsi_self_tid = lookup_or_register_named(&gmod, dsi_mono)
                                gmod.type_subs.put("Self", dsi_self_tid)
                                for dsi_meth in dsi_tdef.methods:
                                    if dsi_meth.body.len() > 0 and not dsi_overridden.contains(dsi_meth.name):
                                        if dsi_meth.type_params.len() == 0:
                                            if all_return_nominals_registered(dsi_meth.return_type, &gmod):
                                                int dsi_ret = map_fn_return_type(dsi_meth.return_type, &gmod)
                                                if dsi_ret >= 0:
                                                    String dsi_key = dsi_mono + "__" + dsi_meth.name
                                                    gmod.fn_sigs.put(dsi_key, dsi_ret)
                                clear_type_subs(&gmod)
                        case None:
                            pass

    # FIDELITY Phase 4(a) — `_VTable` struct typedef pre-pass.
    # For each non-generic, non-derive trait with ≥1 INSTANCE method,
    # register a `<MangledTrait>_VTable` struct type so the vtable global's
    # `type_id` resolves to a real LIR struct (→ `struct __gg_<Trait>_VTable`).
    # Mirrors Rust gg's `register_trait_types` VTable struct creation
    # (`src/ir/lowering/traits.rs:174-199`), including its method-less skip
    # (`traits.rs:174: if methods.is_empty(): continue`).
    #
    # Each slot field carries an OPAQUE, NON-resource, NON-keyword
    # `type_name` (`"__vtslot"`) so `resolve_field_lir_type` falls through
    # to `LT_PTR` → `void*` in C (the precise fn-ptr field spellings are a
    # deferred byte-parity concern — see the design's §7e). The opaque name
    # is non-resource so `populate_drop_metadata` emits no spurious slot
    # drop (`drop_fn_for_type` returns "" for it). Field types don't affect
    # the `user_fn_count` metric — only the slot fns' reachability does.
    for vt_item in m.items:
        match vt_item:
            case ITrait(vt_tdef):
                if vt_tdef.type_params.len() == 0 and not is_builtin_trait(vt_tdef.name):
                    Vector[GirFieldInfo] vt_ti_fields = []
                    int vt_slot_idx = 0
                    String vt_mtrait = mangle_trait_name(vt_tdef.name)
                    for vt_slot in vt_tdef.methods:
                        if method_has_self(vt_slot):
                            vt_ti_fields.push(GirFieldInfo("slot" + int_to_str(vt_slot_idx), "__vtslot"))
                            # Record method→slot (single source of truth for the
                            # slot ordering; read by the trait-dispatch intercept).
                            gmod.trait_method_slot.put(vt_mtrait + "__" + vt_slot.name, vt_slot_idx)
                            # Record the `Box__<Trait>__<method>` dispatch-thunk's
                            # RETURN TYPE off the trait method decl (single source
                            # of truth, the self-host analogue of Rust reading
                            # `fn_ret` from the VTable FnPtr field, insts.rs:2550).
                            # This is BOTH: (1) the call-site return-type channel —
                            # `obj.method()` on a Box[Trait] resolves `ret_tid` via
                            # this fn_sig (lower_expr.gg:3836), so the dst local +
                            # print format are typed correctly (a String return
                            # prints `%.*s`, not `%lld`); AND (2) read back at LIR
                            # dispatch (try_record_trait_dispatch) to type the thunk
                            # signature + fn-ptr cast. A `void` method registers
                            # UNIT_TYPE → the call site emits no dst (ret_tid ==
                            # UNIT_TYPE, lower_expr.gg:3893) and the thunk emits
                            # `void …`. Keyed by the SAME `Box__<Trait>__<method>`
                            # mangling the call site reconstructs from the receiver.
                            gmod.fn_sigs.put("Box__" + vt_mtrait + "__" + vt_slot.name, map_fn_return_type(vt_slot.return_type, &gmod))
                            # Record the dispatch-thunk's PARAM TYPES off the trait
                            # method decl (increment 3 — user params), the sibling
                            # of the RETURN-type registration above. This is the
                            # single source of truth for `Box__<Trait>__<method>`'s
                            # argument ABI, read by BOTH:
                            #   (1) the call site — `get_fn_param_types` falls back
                            #       to `fn_param_sigs` (lower_types.gg:765) for this
                            #       non-lowered symbol, and the GICall/GICallExtern
                            #       arg loop (lir_lower.gg:3888/4216) passes an arg
                            #       BY POINTER when its param tid `is_ptr_type` →
                            #       so an aggregate arg (String/Vector/struct) is
                            #       auto-address-taken (`&__s7`) exactly as Rust's
                            #       per-arg AddressOf marshalling (insts.rs:2560);
                            #   (2) the thunk emit — `try_record_trait_dispatch`
                            #       reads these back to type the thunk signature +
                            #       fn-ptr cast (lir_lower.gg / lir_codegen.gg).
                            # Arg 0 is the fat trait-box RECEIVER, registered as a
                            # `*unit` (void*) Ptr so the call site passes the box
                            # BY POINTER — mirrors Rust's `void* __p0` trait-obj
                            # receiver (synth.rs:1265) and lets ONE thunk shape
                            # serve both a LOCAL fat-struct receiver (address-taken
                            # → `&box`) and a `Box[Trait]`-param receiver (already a
                            # `void*`, passed straight through). The Ptr-wrapping of
                            # the user params MIRRORS lower_equip_block's impl-body
                            # param loop (lower_closures.gg:583-598) — the SAME rule
                            # the vtable-slot impl fn was emitted with, so the thunk
                            # sig, the impl sig, and the call site all agree.
                            Vector[int] vt_pt_sig = []
                            Vector[String] vt_pt_names = []
                            vt_pt_sig.push(register_ptr(&gmod, UNIT_TYPE))
                            vt_pt_names.push("self")
                            for vt_p in vt_slot.params:
                                match vt_p.param_type.ty:
                                    case TSelf():
                                        continue
                                    else:
                                        pass
                                int vt_pt = map_ast_type(vt_p.param_type, &gmod)
                                # Bare aggregate/resource param → Ptr (by-pointer
                                # ABI, e.g. `String name` → `void*`), matching the
                                # impl fn's own param lowering.
                                if vt_p.ownership == 0 and vt_pt >= PRIM_COUNT:
                                    String vt_ptc = type_to_c_name(vt_p.param_type, &gmod)
                                    if is_resource_type_name(vt_ptc, &gmod):
                                        vt_pt = register_ptr(&gmod, vt_pt)
                                # `&`/`!`-sigil param → MutPtr (by-pointer).
                                if vt_p.ownership == 1 or vt_p.ownership == 2:
                                    vt_pt = register_type(&gmod, GtMutPtr(vt_pt))
                                vt_pt_sig.push(vt_pt)
                                vt_pt_names.push(vt_p.param_name.clone())
                            gmod.fn_param_sigs.put("Box__" + vt_mtrait + "__" + vt_slot.name, !vt_pt_sig)
                            gmod.fn_param_names.put("Box__" + vt_mtrait + "__" + vt_slot.name, !vt_pt_names)
                            vt_slot_idx += 1
                    # Method-less skip (Fold 2): only register when ≥1 instance slot.
                    if vt_ti_fields.len() > 0:
                        # Drop-glue slot: `void (*__drop)(void* data_slot)` —
                        # points at the concrete impl's `Box__<Concrete>__drop`
                        # wrapper (payload drop + free + slot null). APPENDED
                        # LAST so the positional method slots (the typed
                        # `trait_method_slot` channel above) stay stable; the
                        # same opaque non-resource "__vtslot" type as the
                        # method slots (→ LT_PTR / `void*` in C). Populated
                        # per-impl by the vtable-global emitter (Phase 4(b));
                        # consumed by the fat trait-box GIDropIfAlive branch
                        # in lir_lower.gg. Mirrors Rust gg's VTABLE_DROP_FIELD
                        # append (`src/ir/lowering/traits.rs`).
                        vt_ti_fields.push(GirFieldInfo("__drop", "__vtslot"))
                        String vt_ti_name = mangle_trait_name(vt_tdef.name) + "_VTable"
                        # (a) GtNamed entry so the struct gets a type id /
                        # `__gg_<Trait>_VTable` c-name; (b) GirTypeInfo so
                        # `lower_type_defs` Pass-1b/Pass-2 register + fill it.
                        int _vt_tid_reg = lookup_or_register_named(&gmod, vt_ti_name)
                        Vector[GirEnumVariantInfo] vt_no_variants = []
                        gmod.type_infos.put(vt_ti_name.clone(), GirTypeInfo(vt_ti_name.clone(), vt_ti_fields, vt_no_variants, false))
            else:
                pass

    # PROTO phase-1b PRE-PASS: register method-generic instance return types
    # in fn_sigs BEFORE the user-function loop (so the call-site ret_tid
    # lookup resolves to the adapter struct, not the I64 fallback). The
    # bodies are emitted later (after the adapter structs are registered).
    Vector[ProtoMethInst] proto_minsts = []
    Dict[String, bool] proto_seen = {}
    for pmi_item in m.items:
        match pmi_item:
            case IFunction(pfdef):
                proto_walk_stmts(pfdef.body, &gmod, &proto_minsts, &proto_seen)
            case IEquip(peqblk):
                for pmdef in peqblk.methods:
                    proto_walk_stmts(pmdef.body, &gmod, &proto_minsts, &proto_seen)
            else:
                pass
    # merge method instances discovered in mono'd generic-fn bodies
    # (e.g. Key__hash__FxHasher from hash_of[Key]) into the per-call-site set.
    for mmi in mono_method_insts:
        if not proto_seen.contains(mmi.mangled_symbol):
            proto_seen.put(mmi.mangled_symbol.clone(), true)
            proto_minsts.push(mmi)
    for pmi0 in proto_minsts:
        String p0_base = ""
        Vector[SpannedType] p0_eq_targs = []
        for pgi0 in generic_instances:
            if pgi0.mangled_name == pmi0.recv_instance:
                p0_base = pgi0.base_name
                p0_eq_targs = pgi0.type_args
        # non-generic receiver (e.g. `Key`) has no GenericInstance
        # entry — the instance name IS the base, with no equip type args.
        if p0_base.len() == 0:
            p0_base = pmi0.recv_instance
        if p0_base.len() == 0:
            continue
        for p0_eqtmpl in equip_templates:
            String p0_eqtarget = ""
            match p0_eqtmpl.target.ty:
                case TNamed(p0tn, _):
                    p0_eqtarget = p0tn
                else:
                    pass
            if p0_eqtarget != p0_base:
                continue
            match p0_eqtmpl.trait_name:
                case Some(p0_tname):
                    if not is_builtin_trait(p0_tname) and trait_defs.contains(p0_tname):
                        TraitDef p0_tdef = trait_defs.get(p0_tname).unwrap()
                        bool p0_overridden = false
                        for p0_om in p0_eqtmpl.methods:
                            if p0_om.name == pmi0.method_name:
                                p0_overridden = true
                        if not p0_overridden:
                            for p0_tmeth in p0_tdef.methods:
                                if p0_tmeth.name == pmi0.method_name and p0_tmeth.body.len() > 0 and p0_tmeth.type_params.len() == proto_inst_targ_count(pmi0) and p0_tmeth.type_params.len() > 0:
                                    Vector[String] p0_eqparams = extract_equip_type_params(p0_eqtmpl)
                                    setup_type_subs(&gmod, p0_eqparams, p0_eq_targs)
                                    int p0_self_tid = lookup_or_register_named(&gmod, pmi0.recv_instance)
                                    gmod.type_subs.put("Self", p0_self_tid)
                                    int p0_tpi = 0
                                    while p0_tpi < p0_tdef.type_params.len() and p0_tpi < p0_eqtmpl.trait_generic_args.len():
                                        gmod.type_subs.put(p0_tdef.type_params.get(p0_tpi).unwrap(), map_ast_type(p0_eqtmpl.trait_generic_args.get(p0_tpi).unwrap(), &gmod))
                                        p0_tpi += 1
                                    int p0_mpi = 0
                                    while p0_mpi < p0_tmeth.type_params.len() and p0_mpi < proto_inst_targ_count(pmi0):
                                        int p0_mta_tid = proto_inst_targ_tid(pmi0, p0_mpi, &gmod)
                                        gmod.type_subs.put(p0_tmeth.type_params.get(p0_mpi).unwrap(), p0_mta_tid)
                                        p0_mpi += 1
                                    int p0_ret_tid = map_ast_type(p0_tmeth.return_type, &gmod)
                                    gmod.fn_sigs.put(pmi0.mangled_symbol.clone(), p0_ret_tid)
                                    clear_type_subs(&gmod)
                case None:
                    # INHERENT equip (no trait): pre-register the return type of
                    # a method-level-generic method defined directly in the equip
                    # block (`zip[U]` in `equip [T] VectorIter[T]:`), so the
                    # call-site ret_tid lookup resolves to the adapter struct
                    # instead of the I64 fallback. Body emitted below.
                    for p0_im in p0_eqtmpl.methods:
                        if p0_im.name == pmi0.method_name and p0_im.body.len() > 0 and p0_im.type_params.len() == proto_inst_targ_count(pmi0) and p0_im.type_params.len() > 0:
                            Vector[String] p0_ieqparams = extract_equip_type_params(p0_eqtmpl)
                            setup_type_subs(&gmod, p0_ieqparams, p0_eq_targs)
                            int p0_iself_tid = lookup_or_register_named(&gmod, pmi0.recv_instance)
                            gmod.type_subs.put("Self", p0_iself_tid)
                            int p0_impi = 0
                            while p0_impi < p0_im.type_params.len() and p0_impi < proto_inst_targ_count(pmi0):
                                int p0_imta_tid = proto_inst_targ_tid(pmi0, p0_impi, &gmod)
                                gmod.type_subs.put(p0_im.type_params.get(p0_impi).unwrap(), p0_imta_tid)
                                p0_impi += 1
                            int p0_iret_tid = map_ast_type(p0_im.return_type, &gmod)
                            gmod.fn_sigs.put(pmi0.mangled_symbol.clone(), p0_iret_tid)
                            clear_type_subs(&gmod)

    # Lower each non-generic function, equip method, and test block
    int test_idx = 0
    for item in m.items:
        match item:
            case IFunction(fdef):
                # Skip generic templates — they'll be monomorphized below
                if fdef.type_params.len() == 0:
                    # Skip extern declarations. A main-module inline extern now
                    # KEEPS its `= "symbol"` alias body (so the pre-pass can
                    # register its redirect), so the old `body.len() > 0` gate
                    # alone would lower it as a garbage real fn (return "sym"
                    # for a non-String return type — the Core-#8 regression).
                    # The typed is_extern_stub flag is the source of truth: a
                    # stub emits no `fn @`, only the declare/redirect.
                    if not fdef.is_extern_stub and fdef.body.len() > 0:
                        # Statement-level `meta if`/`meta for`/`meta const` in a
                        # NON-generic fn body (e.g. `main()`) must be evaluated
                        # and spliced BEFORE lowering — otherwise the meta-stmt
                        # falls through lower_stmt's "non-generic context, drop"
                        # arm and vanishes inert. Generic bodies already run this
                        # inside lower_generic_function with type substitutions;
                        # here the env is EMPTY (no type params). Mirrors Rust
                        # functions.rs:1027 (gated by block_has_delayed_meta with
                        # empty subs/env). GATED so non-meta fns — the vast
                        # majority — skip the splice walk and lower byte-unchanged.
                        FunctionDef ng_fdef = fdef
                        if block_has_delayed_meta(fdef.body):
                            Dict[String, String] ng_tn_env = {}
                            Dict[String, int] ng_int_env = {}
                            Vector[Stmt] ng_body = evaluate_delayed_meta_stmts(fdef.body, &ng_tn_env, &ng_int_env, &gmod)
                            ng_fdef = FunctionDef(fdef.name, fdef.params, fdef.return_type, fdef.type_params, ng_body, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub)
                        gmod.functions.push(lower_function(ng_fdef, &gmod))
            case IStaticDecl(si_ty, si_name, si_val):
                # Array/dict LITERAL static (`static Vector[T] X = [..]` /
                # `= {..}`): the static was registered in the pre-pass;
                # synthesize + lower its `__gg_static_init_<name>()` init fn
                # HERE, where the full type/fn registry is committed
                # (struct-element sizing for collection literals reads
                # gmod.type_infos). Guarded by `static_is_literal_init` so it
                # stays in lockstep with the pre-pass's literal branch (one
                # synth fn iff an array/dict-literal static was registered).
                # SCALAR-literal statics (`static int x = 0`) take NO synth fn
                # — they registered as a const-bytes global (GGSTATIC_BYTES)
                # whose init_expr is emitted as a const C initializer at the
                # declaration, matching Rust's `GlobalInit::Bytes`
                # (`src/ir/lowering/mod.rs:2459-2461`). The collection-
                # CONSTRUCTOR path (case 2) likewise emits NO synth fn — its
                # init is a direct allocator C-expr.
                if static_is_literal_init(si_val):
                    FunctionDef si_fn = build_static_init_fn(si_ty, si_name, si_val)
                    gmod.functions.push(lower_function(si_fn, &gmod))
            case ITest(tname, decorators, tags, test_body):
                # Skip test blocks when main() exists (normal build mode).
                # Emit __test_N for test-only files (no main).
                if not has_main:
                    # Decode the test-attribute sentinels the parser threaded
                    # through `tags` (`with_names`): "__skip__",
                    # "__skip_reason__=<r>", "__should_panic__",
                    # "__should_panic_msg__=<m>".
                    bool is_skipped = false
                    String t_skip_reason = ""
                    bool t_should_panic = false
                    String t_panic_msg = ""
                    for tag_val in tags:
                        if tag_val == "__skip__":
                            is_skipped = true
                        elif tag_val.starts_with("__skip_reason__="):
                            t_skip_reason = tag_val.slice(16, tag_val.len())
                        elif tag_val == "__should_panic__":
                            t_should_panic = true
                        elif tag_val.starts_with("__should_panic_msg__="):
                            t_panic_msg = tag_val.slice(21, tag_val.len())
                    if is_skipped:
                        # Skipped tests have NO `__test_N` body — register the
                        # entry (fn_name "") so the runner reports SKIP in source
                        # order. Mirrors Rust gg (`src/ir/lowering/mod.rs:3120`).
                        gmod.test_fns.push(GirTestFn("", tname.clone(), t_should_panic, t_panic_msg.clone(), true, t_skip_reason.clone()))
                    if not is_skipped:
                        String test_fn_name = "__test_" + int_to_str(test_idx)
                        Vector[int] _lc_stk3 = []
                        Vector[int] _lb_stk3 = []
                        Dict[String, int] _named_locals3 = {}
                        Vector[DropScope] _de_scopes3 = []
                        Vector[DropEmission] _de_queue3 = []
                        Vector[Vector[Stmt]] _on_err_blocks3 = []
                        Dict[String, bool] _cow_mut3 = {}
                        Dict[String, int] _cow_span3 = {}
                        Dict[String, bool] _cow_clo3 = {}
                        # Test bodies are void, non-throws → fn_is_throws=false.
                        LowerCtx tctx = LowerCtx([], [], [], 0, !_named_locals3, !_lc_stk3, !_lb_stk3, "", "", "", false, test_fn_name.clone(), DropElaborator(!_de_scopes3), !_de_queue3, -1, !_on_err_blocks3, false, !_cow_mut3, !_cow_span3, !_cow_clo3, {}, [], {}, None, None, None, false, {}, {}, "", {}, false, 0, [], [])
                        Vector[Instruction] tinit = []
                        tctx.block_insts.push(!tinit)
                        tctx.block_terms.push(GTNone())
                        # Phase 2: function-scope drop frame for test bodies.
                        push_drop_scope(&tctx.drop_elab, DSK_FUNCTION)
                        add_local(&tctx, UNIT_TYPE, None)
                        Vector[Param] _cs_no_params_t = []
                        compute_cow_scan(&tctx, &gmod, _cs_no_params_t, test_body)
                        lower_stmts(&tctx, test_body, &gmod, false)
                        Terminator tterm = tctx.block_terms.get(tctx.current_block).unwrap()
                        match tterm:
                            case GTNone():
                                emit_drops_for_early_exit(&tctx, DSK_FUNCTION, Some(0))
                                set_terminator(&tctx, GTReturn(OpConstUnit()))
                            else:
                                pass
                        # Route through the shared function-body finalizer — a
                        # test body is a full function and MUST run the same
                        # liveness finalization (pop → compute_liveness →
                        # wire_liveness_into_modes → flush_drop_queue → assemble).
                        # Without wire_liveness_into_modes the last-use ctor-arg
                        # consumes stay OpCopy (never OpMove), so the moved-from
                        # source slots (`v`→`Some(v)`→`Wrapper`→`w`) are never
                        # IMoveSlot-zeroed and drop_elab keeps their
                        # GIDropIfAlive → over-drop / double-free
                        # (test_option_resource_field).
                        Vector[BasicBlock] tblocks = finalize_body_blocks(&tctx, &gmod, test_fn_name)
                        Vector[int] tparams = []
                        gmod.functions.push(GirFunction(test_fn_name, !tparams, UNIT_TYPE, tctx.locals, !tblocks, [], []))
                        # Register the full test metadata for the runner-main
                        # synthesis (mirrors Rust `module.runtime.test_fns`).
                        gmod.test_fns.push(GirTestFn(test_fn_name.clone(), tname.clone(), t_should_panic, t_panic_msg.clone(), false, ""))
                test_idx += 1
            case ISuiteSetup(setup_body):
                if not has_main:
                    # Lower the suite-setup body as a void fn (mirrors the test
                    # body path; was a STUB that dropped the body → the `SETUP`
                    # print never ran). Mirrors Rust gg's suite-setup lowering
                    # (`src/ir/lowering/mod.rs:3040`). The runner-main synthesis
                    # calls `__suite_setup()` when present.
                    gmod.functions.push(lower_suite_body("__suite_setup", setup_body, &gmod))
                    test_idx += 1
            case ISuiteTeardown(teardown_body):
                if not has_main:
                    gmod.functions.push(lower_suite_body("__suite_teardown", teardown_body, &gmod))
                    test_idx += 1
            case IEquip(eqblk):
                # Generic equip blocks: emit template for imported types
                # (Rust emits Heap__T__push for imported Heap but not local Stack).
                bool is_generic_equip = false
                String eq_type_name = ""
                int eq_targs_count = 0
                match eqblk.target.ty:
                    case TNamed(tname, eq_targs):
                        eq_type_name = tname
                        eq_targs_count = eq_targs.len()
                        if eq_targs.len() > 0 or eqblk.type_params.len() > 0:
                            is_generic_equip = true
                    else:
                        pass
                if is_generic_equip and eq_type_name.len() > 0 and not local_struct_names.contains(eq_type_name):
                    # Imported generic type: SKIP template emission. Rust gg
                    # elides un-monomorphized generic templates entirely
                    # (mod.rs:525, 1130 — `continue; // Generic functions
                    # handled via monomorphization`); only mono'd instances
                    # reach the lowerer. Templates lowered with bare-T
                    # bodies produce `[bug] EIdentifier: unknown identifier
                    # 'T'` (and same for K/V) — ~58 occurrences across
                    # SetIter/DictIter/etc. The mono'd-equip emission below
                    # (line ~5285) handles the actual call sites.
                    pass
                if is_generic_equip and eq_type_name.len() > 0 and local_struct_names.contains(eq_type_name):
                    # Local generic equip: Rust emits templates ONLY when:
                    #   (a) single type param, no explicit (non-derive) trait, AND
                    #   (b) the type is used in a generic function's params (e.g. unwrap_box[T](Box2[T] b))
                    #       OR has an instantiation with a non-primitive/non-String type arg
                    #       (e.g. Container[Container[int]])
                    # This avoids spurious templates for Stack[T] / Pair[T] which are
                    # only ever used with primitive args and never in generic functions.
                    bool has_explicit_trait = false
                    match eqblk.trait_name:
                        case Some(tn):
                            bool is_derive2 = is_builtin_trait(tn)
                            if not is_derive2:
                                has_explicit_trait = true
                        case None:
                            pass
                    # Check total type param count: target type args + explicit type_params
                    int total_type_params = eq_targs_count + eqblk.type_params.len()
                    if total_type_params == 1 and not has_explicit_trait:
                        # Check if template is needed:
                        # (1) type appears in any generic function's param types
                        bool needs_template = false
                        for gf_item in m.items:
                            match gf_item:
                                case IFunction(fdef):
                                    if fdef.type_params.len() > 0 and not needs_template:
                                        for gfp in fdef.params:
                                            match gfp.param_type.ty:
                                                case TNamed(n, _):
                                                    if n == eq_type_name:
                                                        needs_template = true
                                                else:
                                                    pass
                                else:
                                    pass
                        # (2) any discovered instance has a non-primitive/non-String type arg
                        if not needs_template:
                            for ginst in generic_instances:
                                if ginst.base_name == eq_type_name:
                                    for gta in ginst.type_args:
                                        bool is_simple_arg = false
                                        match gta.ty:
                                            case TPrimitive(_):
                                                is_simple_arg = true
                                            case TNamed(gn, _):
                                                if gn == "String" or gn == "GorgetString" or gn == "bool":
                                                    is_simple_arg = true
                                            else:
                                                pass
                                        if not is_simple_arg:
                                            needs_template = true
                        if needs_template:
                            # Reached only under `not has_explicit_trait` (above) →
                            # trait_name is None or a derive trait, never a bodied
                            # registered TraitDef → unregistered route (Snag #11).
                            lower_equip_block(eqblk, &gmod, false)
                if not is_generic_equip:
                    # For explicit non-derive trait equip: split methods by whether
                    # they're in the trait's OWN vtable vs inherited from a parent.
                    # Inherited overrides use Type__method naming; own use Trait_for_Type__method.
                    bool did_split = false
                    match eqblk.trait_name:
                        case Some(tname):
                            bool is_derive_sp = is_builtin_trait(tname)
                            if not is_derive_sp and trait_defs.contains(tname):
                                did_split = true
                                TraitDef tdef = trait_defs.get(tname).unwrap()
                                # Build set of method names in the trait's OWN vtable
                                Dict[String, bool] own_vtable = {}
                                for tvmeth in tdef.methods:
                                    own_vtable.put(tvmeth.name.clone(), true)
                                # Split equip methods: own vtable vs inherited overrides
                                Vector[FunctionDef] own_methods = []
                                Vector[FunctionDef] inherited_methods = []
                                int smi = 0
                                while smi < eqblk.methods.len():
                                    FunctionDef sm = eqblk.methods.get(smi).unwrap()
                                    if own_vtable.contains(sm.name):
                                        own_methods.push(sm)
                                    else:
                                        inherited_methods.push(sm)
                                    smi += 1
                                # Emit own-vtable methods with Trait_for_Type naming
                                if own_methods.len() > 0:
                                    EquipBlock own_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, own_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    # did_split (`trait_defs.contains(tname)` true above)
                                    # = Rust's REGISTERED/vtable route → BARE trait
                                    # prefix, NO generic suffix (Snag #11).
                                    lower_equip_block(own_eqblk, &gmod, true)
                                # Emit inherited overrides with Type__ naming (no trait prefix)
                                if inherited_methods.len() > 0:
                                    Option[String] inh_no_trait = None
                                    EquipBlock inh_eqblk = EquipBlock(eqblk.target, eqblk.type_params, inh_no_trait, inherited_methods, eqblk.via_field, eqblk.trait_generic_args)
                                    # trait_name stripped to None → suffix branch
                                    # unreachable; flag is moot (Snag #11).
                                    lower_equip_block(inh_eqblk, &gmod, false)
                                # Collect all overridden method names
                                Dict[String, bool] overridden = {}
                                for om in eqblk.methods:
                                    overridden.put(om.name.clone(), true)
                                String eq_target_sp = type_to_c_name(eqblk.target, &gmod)
                                # Gate ONLY iterator-protocol traits (see the main
                                # concrete site for why non-iterator traits stay
                                # unconditional — the Writer.flush −85 regression).
                                # Bind Self+T ONLY for those (Required after A1/A3
                                # routed `equip X with Iterator[int]:` here); non-
                                # iterator traits keep pristine no-subs behaviour.
                                bool tc_gate_sp = is_iterator_protocol_trait(tname)
                                if tc_gate_sp:
                                    setup_concrete_trait_subs(&gmod, eqblk.target, tdef.type_params, eqblk.trait_generic_args)
                                # Emit own-trait default methods (Trait_for_Type naming)
                                for tmeth2 in tdef.methods:
                                    if tmeth2.body.len() > 0 and not overridden.contains(tmeth2.name):
                                        bool emit_dm2 = true
                                        if tc_gate_sp:
                                            emit_dm2 = tmeth2.type_params.len() == 0 and all_return_nominals_registered(tmeth2.return_type, &gmod)
                                        if emit_dm2:
                                            String dm_trait2 = mangle_trait_name(tname)
                                            String dm_mangled2 = dm_trait2 + "_for_" + eq_target_sp + "__" + tmeth2.name
                                            # Root A (R43): iterator-protocol trait defaults are
                                            # dispatched by SHORT name at the call site (mirroring
                                            # the explicit `next` short-naming — is_iterator_
                                            # protocol_trait). Emit the inherited defaults short too,
                                            # or `c.iter().sum()` → `CounterIter__sum` dangles.
                                            if tc_gate_sp:
                                                dm_mangled2 = eq_target_sp + "__" + tmeth2.name
                                            # Root #2: bind `Self` → *Target so `lower_function`'s
                                            # param loop types the default body's `self` param as
                                            # the concrete struct pointer (map_ast_type(TSelf())
                                            # resolves through type_subs["Self"]), not the I64
                                            # default. The body sees `Target*` directly (no *unit
                                            # cast needed) and the call site address-takes the
                                            # receiver (lir_lower is_ptr_type → pass_by_ptr).
                                            # Mirrors Rust gg lower_trait_method_body's concrete
                                            # self-ptr binding (traits.rs:860). Save/restore so
                                            # the binding doesn't leak to sibling defaults.
                                            if not tc_gate_sp:
                                                int _dm2_self_target = lookup_or_register_named(&gmod, eq_target_sp)
                                                int _dm2_self_ptr = register_ptr(&gmod, _dm2_self_target)
                                                gmod.type_subs.put("Self", _dm2_self_ptr)
                                            gmod.functions.push(lower_function(tmeth2, &gmod))
                                            int last_idx2 = gmod.functions.len() - 1
                                            GirFunction last_fn2 = gmod.functions.get(last_idx2).unwrap()
                                            gmod.functions.set(last_idx2, GirFunction(dm_mangled2, last_fn2.param_types, last_fn2.return_type, last_fn2.locals, last_fn2.blocks, last_fn2.with_refresh_pairs, last_fn2.inner_shared_spawns))
                                # Emit parent trait default methods (Type__ naming, no prefix)
                                for pt_name in tdef.parent_traits:
                                    if trait_defs.contains(pt_name):
                                        TraitDef pt_def = trait_defs.get(pt_name).unwrap()
                                        for pt_meth in pt_def.methods:
                                            if pt_meth.body.len() > 0 and not overridden.contains(pt_meth.name):
                                                bool emit_pt = true
                                                if tc_gate_sp:
                                                    emit_pt = pt_meth.type_params.len() == 0 and all_return_nominals_registered(pt_meth.return_type, &gmod)
                                                if emit_pt:
                                                    String pt_mangled = eq_target_sp + "__" + pt_meth.name
                                                    # Root #2: same concrete-self-ptr binding as the
                                                    # own-trait default loop above (parent-trait
                                                    # defaults have the identical I64-self bug).
                                                    if not tc_gate_sp:
                                                        int _pt_self_target = lookup_or_register_named(&gmod, eq_target_sp)
                                                        int _pt_self_ptr = register_ptr(&gmod, _pt_self_target)
                                                        gmod.type_subs.put("Self", _pt_self_ptr)
                                                    gmod.functions.push(lower_function(pt_meth, &gmod))
                                                    int pt_last = gmod.functions.len() - 1
                                                    GirFunction pt_last_fn = gmod.functions.get(pt_last).unwrap()
                                                    gmod.functions.set(pt_last, GirFunction(pt_mangled, pt_last_fn.param_types, pt_last_fn.return_type, pt_last_fn.locals, pt_last_fn.blocks, pt_last_fn.with_refresh_pairs, pt_last_fn.inner_shared_spawns))
                                                    overridden.put(pt_meth.name.clone(), true)
                                clear_type_subs(&gmod)
                                # FIDELITY Phase 4(b) — emit the vtable global
                                # for this non-derive trait impl, ONCE per equip.
                                # A struct-of-FuncAddr global whose slots are
                                # `(void*)&<MangledTrait>_for_<target>__<slot>`,
                                # one per INSTANCE trait method. Mirrors Rust gg's
                                # `emit_vtable_globals` (`traits.rs:1015-1037`):
                                # unconditional per-impl, regardless of any
                                # use-site. The FnRef mangling is byte-identical
                                # to the body mangling above (`mangle_trait_name`
                                # + "_for_" + `eq_target_sp` + "__" + slot.name —
                                # same `eq_target_sp` the bodies use), so every
                                # slot resolves to a real emitted fn. Phase 5's
                                # DCE then keeps those bodies live.
                                # Skip the vtable global for iterator-protocol
                                # traits: they're dispatched DIRECTLY by short name
                                # (the for-loop calls `Type__next`), never as trait
                                # objects, AND `Iterator[T]` is generic so its
                                # `_VTable` struct is never registered (the pre-pass
                                # at :14512 skips generic traits) — emitting a global
                                # of an unresolved struct type + FnRefs to the now-
                                # SHORT-named `next` would dangle ("initializer not
                                # computable"). Mirrors Rust gg (no vtable for the
                                # for-loop protocol impls).
                                if not is_iterator_protocol_trait(tname):
                                    String vt_struct_name = mangle_trait_name(tname) + "_VTable"
                                    int vt_tid = lookup_or_register_named(&gmod, vt_struct_name)
                                    Vector[GirGlobalField] vt_fields = []
                                    for tslot in tdef.methods:
                                        if method_has_self(tslot):
                                            String impl_fn = mangle_trait_name(tname) + "_for_" + eq_target_sp + "__" + tslot.name
                                            vt_fields.push(GirGlobalField(GGINIT_FN_REF, impl_fn))
                                    if vt_fields.len() > 0:
                                        # Drop-glue slot (appended LAST, mirroring
                                        # the `_VTable` TypeDef pre-pass): the
                                        # concrete impl's `Box__<Concrete>__drop`
                                        # wrapper, carried as the TYPED concrete
                                        # name (GGINIT_BOX_DROP_REF) — the C
                                        # backend spells the symbol and emits the
                                        # wrapper from this field. A concrete NOT
                                        # registered as a user struct/enum (e.g.
                                        # `equip int with Trait` — no `Box__int`
                                        # box exists; primitive-equip dispatch is
                                        # broken today in BOTH compilers, filed
                                        # for typecheck-reject) degrades to a
                                        # NULL slot (GGINIT_ZEROED), mirroring
                                        # Rust gg's lookup_named miss branch in
                                        # `emit_vtable_globals` (traits.rs).
                                        if gmod.type_infos.contains(eq_target_sp):
                                            vt_fields.push(GirGlobalField(GGINIT_BOX_DROP_REF, eq_target_sp.clone()))
                                        else:
                                            vt_fields.push(GirGlobalField(GGINIT_ZEROED, ""))
                                        String vt_global_name = mangle_trait_name(tname) + "_for_" + eq_target_sp + "_vtable"
                                        int _vt_gid = gir_mod_add_global(&gmod, GirGlobal(vt_global_name, vt_tid, GGINIT_STRUCT, vt_fields, false))
                        case None:
                            pass
                    if not did_split:
                        # `not did_split` = NOT(non-derive registered TraitDef) →
                        # the trait is derive (no suffix branch) or UNREGISTERED
                        # (From/operators → carries the generic suffix). Either way
                        # this is the unregistered route (Snag #11).
                        lower_equip_block(eqblk, &gmod, false)
                        # Generate default trait methods not overridden by the equip
                        match eqblk.trait_name:
                            case Some(tname):
                                if trait_defs.contains(tname):
                                    TraitDef tdef = trait_defs.get(tname).unwrap()
                                    # Collect overridden method names
                                    Dict[String, bool] overridden = {}
                                    for om in eqblk.methods:
                                        overridden.put(om.name.clone(), true)
                                    # The (m) method-generic skip + (b) demand-gate
                                    # + the Self/T bind are needed ONLY for iterator-
                                    # protocol traits (whose defaults return UN-
                                    # registered adapters `TakeIter[Self,T]` / take
                                    # method-generics). For OTHER concrete traits
                                    # (Writer/Reader/Serializer) the pre-existing emit
                                    # was UNCONDITIONAL + no-subs and correct — gating
                                    # them with the demand-gate wrongly skips e.g.
                                    # `Writer.flush`→`Result[int, IoError]` (the
                                    # prelude-enum mono isn't a type_infos instance) →
                                    # −85 c_emit regression. Keep their pristine path.
                                    bool tc_gate = is_iterator_protocol_trait(tname)
                                    if tc_gate:
                                        setup_concrete_trait_subs(&gmod, eqblk.target, tdef.type_params, eqblk.trait_generic_args)
                                    # Emit defaults for trait methods with bodies not in equip
                                    for tmeth in tdef.methods:
                                        if tmeth.body.len() > 0 and not overridden.contains(tmeth.name):
                                            bool emit_dm = true
                                            if tc_gate:
                                                emit_dm = tmeth.type_params.len() == 0 and all_return_nominals_registered(tmeth.return_type, &gmod)
                                            if emit_dm:
                                                String eq_target = type_to_c_name(eqblk.target, &gmod)
                                                String dm_trait = mangle_trait_name(tname)
                                                String dm_mangled = dm_trait + "_for_" + eq_target + "__" + tmeth.name
                                                # Root A (R43): iterator-protocol defaults short-named
                                                # (see the did_split sibling above).
                                                if tc_gate:
                                                    dm_mangled = eq_target + "__" + tmeth.name
                                                # Root #2: concrete-self-ptr binding (non-split
                                                # unregistered route — same I64-self bug).
                                                if not tc_gate:
                                                    int _dm_self_target = lookup_or_register_named(&gmod, eq_target)
                                                    int _dm_self_ptr = register_ptr(&gmod, _dm_self_target)
                                                    gmod.type_subs.put("Self", _dm_self_ptr)
                                                gmod.functions.push(lower_function(tmeth, &gmod))
                                                int last_idx = gmod.functions.len() - 1
                                                GirFunction last_fn = gmod.functions.get(last_idx).unwrap()
                                                gmod.functions.set(last_idx, GirFunction(dm_mangled, last_fn.param_types, last_fn.return_type, last_fn.locals, last_fn.blocks, last_fn.with_refresh_pairs, last_fn.inner_shared_spawns))
                                    clear_type_subs(&gmod)
                            case None:
                                pass
                    # Via delegation: emit stubs for trait methods not explicitly overridden
                    match eqblk.via_field:
                        case Some(_):
                            match eqblk.trait_name:
                                case Some(via_tname):
                                    if trait_defs.contains(via_tname):
                                        TraitDef via_tdef = trait_defs.get(via_tname).unwrap()
                                        Dict[String, bool] via_done = {}
                                        for vom in eqblk.methods:
                                            via_done.put(vom.name.clone(), true)
                                        for via_meth in via_tdef.methods:
                                            if not via_done.contains(via_meth.name):
                                                Vector[FunctionDef] stub_meths = []
                                                stub_meths.push(via_meth)
                                                Option[String] stub_via = None
                                                EquipBlock stub_eqblk = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, stub_meths, stub_via, eqblk.trait_generic_args)
                                                # via-delegation stub for a registered
                                                # trait (`trait_defs.contains(via_tname)`
                                                # true above) = REGISTERED route → BARE
                                                # prefix, no suffix (Snag #11).
                                                lower_equip_block(stub_eqblk, &gmod, true)
                                                via_done.put(via_meth.name.clone(), true)
                                case None:
                                    pass
                        case None:
                            pass
            else:
                pass

    # Emit monomorphized generic functions
    for inst in generic_instances:
        # Look up template by base name, or by call-redirected (mangled) name.
        String fn_key = inst.base_name.clone()
        if not fn_templates.contains(fn_key) and gmod.call_redirects.contains(inst.base_name):
            fn_key = gmod.call_redirects.get(inst.base_name).unwrap()
        if fn_templates.contains(fn_key):
            FunctionDef tmpl = fn_templates.get(fn_key).unwrap()
            # Monomorphized generics use bare names (no module prefix)
            lower_generic_function(tmpl, inst.mangled_name, tmpl.type_params, inst.type_args, &gmod)
        elif gmod.call_redirects.contains(inst.base_name):
            # Generic extern alias: `extern int __set_iter_order_len[T](...) = "gorget_map_iter_order_len"`.
            # The redirect maps base-name → C-symbol; propagate that mapping to the MANGLED call
            # name so lir_lower/map_runtime_name can translate it at the call site.
            # Mirrors Rust gg's extern_bindings propagation (src/ir/lowering/mod.rs:925-948):
            # every monomorphized instance of a generic extern fn maps mangled→c_symbol.
            String c_sym = gmod.call_redirects.get(inst.base_name).unwrap()
            gmod.call_redirects.put(inst.mangled_name.clone(), c_sym.clone())

    # Emit monomorphized generic equip blocks for discovered type instances
    for einst in generic_instances:
        if equip_generic_names.contains(einst.base_name):
            # Find all equip templates matching this type name
            for equip_tmpl in equip_templates:
                String eq_target_name = ""
                match equip_tmpl.target.ty:
                    case TNamed(tn, _):
                        eq_target_name = tn
                    else:
                        pass
                if eq_target_name == einst.base_name:
                    lower_generic_equip(equip_tmpl, einst.type_args, &gmod)
                    # For generic equip with explicit traits, also emit default trait methods.
                    # These use Type__method naming (no trait prefix).
                    match equip_tmpl.trait_name:
                        case Some(tname):
                            bool is_derive_g = is_builtin_trait(tname)
                            if not is_derive_g and trait_defs.contains(tname):
                                TraitDef gtdef = trait_defs.get(tname).unwrap()
                                # Build set of explicitly implemented methods
                                Dict[String, bool] g_overridden = {}
                                for gom in equip_tmpl.methods:
                                    g_overridden.put(gom.name.clone(), true)
                                # Compute the monomorphized type name for this instance
                                # e.g. Container + [int] -> Container__int64_t
                                String g_mono_name = compute_mangled_name(einst.type_args, einst.base_name)
                                # Lazy-iterator Phase 1a — (a) BIND the trait-default
                                # substitution before lowering each default body.
                                # `lower_generic_equip` above set up + CLEARED its
                                # own type_subs, so re-establish the equip
                                # `[T]`→`[int]` mapping AND add `"Self"` →
                                # g_mono_name's type-id. Mirrors Rust's
                                # `lower_generic_equip_methods_with_defaults`
                                # default_subs = [Self→type, equip-subs]. The
                                # `case TSelf()` arms in `type_to_c_name` /
                                # `map_ast_type` read this so `Self` inside a
                                # default sig/body (`TakeIter[Self, T]`) resolves
                                # to the concrete instance.
                                Vector[String] g_eq_tparams = extract_equip_type_params(equip_tmpl)
                                setup_type_subs(&gmod, g_eq_tparams, einst.type_args)
                                int g_self_tid = lookup_or_register_named(&gmod, g_mono_name)
                                gmod.type_subs.put("Self", g_self_tid)
                                # Emit each unoverridden default method
                                for gtmeth in gtdef.methods:
                                    if gtmeth.body.len() > 0 and not g_overridden.contains(gtmeth.name):
                                        # (m) METHOD-GENERIC SKIP GUARD — defaults
                                        # with method-level type params (`any[F]`,
                                        # `map[U, F]`, `fold[A, F]`, …) ride the
                                        # per-call-site method-mono path, NOT this
                                        # bulk emit. Lowering them here with an
                                        # UNBOUND `F`/`U` produces dead, broken
                                        # bodies (the demand-gate alone does NOT
                                        # catch the ones whose return omits the
                                        # method-generic, e.g. `any[F]`→bool). Rust
                                        # keeps the same skip (functions.rs:1518).
                                        # phase 1b: method-generic defaults skipped
                                        # here; emitted per-call-site by method-mono.
                                        if gtmeth.type_params.len() == 0:
                                            # (b) THE DEMAND-GATE — emit a default
                                            # ONLY if its SUBSTITUTED return type's
                                            # nominals are all registered instances
                                            # (mangled via the type_subs-aware
                                            # `type_to_c_name`, so `TakeIter[Self,T]`
                                            # → `TakeIter__VectorIter__int64_t__int64_t`).
                                            # Prevents emitting adapter constructors
                                            # (`take`/`skip`/…) for instances whose
                                            # adapter struct was never demanded by a
                                            # user call site (Rust functions.rs:1571).
                                            if all_return_nominals_registered(gtmeth.return_type, &gmod):
                                                String g_dm_mangled = g_mono_name + "__" + gtmeth.name
                                                gmod.functions.push(lower_function(gtmeth, &gmod))
                                                int g_last = gmod.functions.len() - 1
                                                GirFunction g_last_fn = gmod.functions.get(g_last).unwrap()
                                                gmod.functions.set(g_last, GirFunction(g_dm_mangled, g_last_fn.param_types, g_last_fn.return_type, g_last_fn.locals, g_last_fn.blocks, g_last_fn.with_refresh_pairs, g_last_fn.inner_shared_spawns))
                                clear_type_subs(&gmod)
                        case None:
                            pass

    # equip-OVERRIDDEN method-level-generic body emit for the
    # mono'd-body discovered instances on CONCRETE non-generic receivers
    # (e.g. `equip Key with Hashable: void hash[Hasher H]`, discovered from
    # `hash_of[Key]`'s `v.hash[FxHasher]`). The body lives in a NON-GENERIC
    # equip block (so it's in `all_equip_blocks`, not `equip_templates`).
    # Derive/builtin traits use SHORT-form naming (`Key__hash__FxHasher`),
    # which is exactly `pmi.mangled_symbol`. Mirrors Rust's
    # `try_register_method_instance` (equip-override arm) + `lower_method_instance`.
    for mm_pmi in mono_method_insts:
        for mm_eqblk in all_equip_blocks:
            String mm_eqtarget = ""
            match mm_eqblk.target.ty:
                case TNamed(mmtn, mm_targs):
                    if mm_targs.len() == 0:
                        mm_eqtarget = mmtn
                else:
                    pass
            if mm_eqtarget != mm_pmi.recv_instance:
                continue
            for mm_em in mm_eqblk.methods:
                if mm_em.name == mm_pmi.method_name and mm_em.body.len() > 0 and mm_em.type_params.len() == proto_inst_targ_count(mm_pmi) and mm_em.type_params.len() > 0:
                    gmod.type_subs = {}
                    int mm_self_tid = lookup_or_register_named(&gmod, mm_pmi.recv_instance)
                    gmod.type_subs.put("Self", mm_self_tid)
                    int mm_mpi = 0
                    while mm_mpi < mm_em.type_params.len() and mm_mpi < proto_inst_targ_count(mm_pmi):
                        int mm_mta_tid = proto_inst_targ_tid(mm_pmi, mm_mpi, &gmod)
                        gmod.type_subs.put(mm_em.type_params.get(mm_mpi).unwrap(), mm_mta_tid)
                        mm_mpi += 1
                    gmod.functions.push(lower_function(mm_em, &gmod))
                    int mm_li = gmod.functions.len() - 1
                    GirFunction mm_lf = gmod.functions.get(mm_li).unwrap()
                    gmod.functions.set(mm_li, GirFunction(mm_pmi.mangled_symbol, mm_lf.param_types, mm_lf.return_type, mm_lf.locals, mm_lf.blocks, mm_lf.with_refresh_pairs, mm_lf.inner_shared_spawns))
                    gmod.fn_sigs.put(mm_pmi.mangled_symbol.clone(), mm_lf.return_type)
                    clear_type_subs(&gmod)

    # R1(b): equip-OVERRIDDEN method-level-generic body emit for the mono'd-body
    # discovered instances on GENERIC receivers (e.g. derived
    # `equip [T] Wrapper[T] with Hashable: void hash[Hasher H]`, discovered from
    # `hash_of[Wrapper[int]]`'s `v.hash[FxHasher]`). Unlike the `mm` loop above,
    # the body lives in a GENERIC equip TEMPLATE (`equip_templates`, target args
    # > 0), so it needs the equip-level `[T->int]` subs bound (recovered from
    # `generic_instances`) on top of Self + method-level `[H->FxHasher]`. The
    # `proto_minsts` trait-default loop below can't cover this: it's guarded by
    # `not is_builtin_trait(...)`, and Hashable IS a builtin trait — plus the
    # body is an OVERRIDE, not a trait-default. Mirrors Rust's
    # `lower_method_instance` (equip-override arm) with equip + Self + trait-T +
    # method-level subs merged.
    for gm_pmi in mono_method_insts:
        # The recv_instance is the mangled generic instance (`Wrapper__int64_t`);
        # recover the equip base + SpannedType targs from generic_instances.
        String gm_base = ""
        Vector[SpannedType] gm_eq_targs = []
        for gm_gi in generic_instances:
            if gm_gi.mangled_name == gm_pmi.recv_instance:
                gm_base = gm_gi.base_name
                gm_eq_targs = gm_gi.type_args
        # No generic-instance entry → this is the non-generic-receiver case
        # already handled by the `mm` loop above; skip.
        if gm_base.len() == 0:
            continue
        for gm_eqtmpl in equip_templates:
            String gm_eqtarget = ""
            match gm_eqtmpl.target.ty:
                case TNamed(gmtn, _):
                    gm_eqtarget = gmtn
                else:
                    pass
            if gm_eqtarget != gm_base:
                continue
            match gm_eqtmpl.trait_name:
                case Some(gm_tname):
                    # Only emit when the method is OVERRIDDEN in the equip block
                    # (the derived `hash` body lives here). Trait-DEFAULT bodies
                    # are emitted by the `proto_minsts` loop below.
                    for gm_em in gm_eqtmpl.methods:
                        if gm_em.name == gm_pmi.method_name and gm_em.body.len() > 0 and gm_em.type_params.len() == proto_inst_targ_count(gm_pmi) and gm_em.type_params.len() > 0:
                            Vector[String] gm_eqparams = extract_equip_type_params(gm_eqtmpl)
                            setup_type_subs(&gmod, gm_eqparams, gm_eq_targs)
                            int gm_self_tid = lookup_or_register_named(&gmod, gm_pmi.recv_instance)
                            gmod.type_subs.put("Self", gm_self_tid)
                            # Bind the trait's own generic params (T) to the trait args.
                            if trait_defs.contains(gm_tname):
                                TraitDef gm_tdef = trait_defs.get(gm_tname).unwrap()
                                int gm_tpi = 0
                                while gm_tpi < gm_tdef.type_params.len() and gm_tpi < gm_eqtmpl.trait_generic_args.len():
                                    String gm_tp = gm_tdef.type_params.get(gm_tpi).unwrap()
                                    SpannedType gm_ta = gm_eqtmpl.trait_generic_args.get(gm_tpi).unwrap()
                                    int gm_ta_tid = map_ast_type(gm_ta, &gmod)
                                    gmod.type_subs.put(gm_tp, gm_ta_tid)
                                    gm_tpi += 1
                            # Method-level subs ([H->FxHasher]).
                            int gm_mpi = 0
                            while gm_mpi < gm_em.type_params.len() and gm_mpi < proto_inst_targ_count(gm_pmi):
                                int gm_mta_tid = proto_inst_targ_tid(gm_pmi, gm_mpi, &gmod)
                                gmod.type_subs.put(gm_em.type_params.get(gm_mpi).unwrap(), gm_mta_tid)
                                gm_mpi += 1
                            gmod.functions.push(lower_function(gm_em, &gmod))
                            int gm_li = gmod.functions.len() - 1
                            GirFunction gm_lf = gmod.functions.get(gm_li).unwrap()
                            gmod.functions.set(gm_li, GirFunction(gm_pmi.mangled_symbol, gm_lf.param_types, gm_lf.return_type, gm_lf.locals, gm_lf.blocks, gm_lf.with_refresh_pairs, gm_lf.inner_shared_spawns))
                            gmod.fn_sigs.put(gm_pmi.mangled_symbol.clone(), gm_lf.return_type)
                            clear_type_subs(&gmod)
                case None:
                    pass
                    # gm-inherent-generic-equip DEFERRED — method-generic body on a generic
                    # receiver; needs a fn_sigs.contains dedup guard (avoids double-emit with
                    # the proto_minsts None arm) + a repro fixture before fixing. See TODO.md.

    # PROTO phase-1b: per-call-site method-level-generic body emit.
    # Re-uses proto_minsts discovered in the pre-pass above; emits the
    # method-generic trait-default body with equip + Self + method-level
    # subs merged. Mirrors Rust's lower_method_instance.
    for pmi in proto_minsts:
        # Recover the equip base + SpannedType targs from generic_instances.
        String p_base = ""
        Vector[SpannedType] p_eq_targs = []
        for pgi in generic_instances:
            if pgi.mangled_name == pmi.recv_instance:
                p_base = pgi.base_name
                p_eq_targs = pgi.type_args
        # non-generic receiver (`Key`) — instance IS the base.
        if p_base.len() == 0:
            p_base = pmi.recv_instance
        if p_base.len() == 0:
            continue
        # Find the equip template for this base.
        for p_eqtmpl in equip_templates:
            String p_eqtarget = ""
            match p_eqtmpl.target.ty:
                case TNamed(ptn, _):
                    p_eqtarget = ptn
                else:
                    pass
            if p_eqtarget != p_base:
                continue
            match p_eqtmpl.trait_name:
                case Some(p_tname):
                    if not is_builtin_trait(p_tname) and trait_defs.contains(p_tname):
                        TraitDef p_tdef = trait_defs.get(p_tname).unwrap()
                        # Is the method overridden in the equip block?
                        bool p_overridden = false
                        for p_om in p_eqtmpl.methods:
                            if p_om.name == pmi.method_name:
                                p_overridden = true
                        if not p_overridden:
                            # Find the trait-default method with matching name + arity.
                            for p_tmeth in p_tdef.methods:
                                if p_tmeth.name == pmi.method_name and p_tmeth.body.len() > 0 and p_tmeth.type_params.len() == proto_inst_targ_count(pmi) and p_tmeth.type_params.len() > 0:
                                    # Set up merged subs: equip [T->...] + Self + method [U->...,F->...].
                                    Vector[String] p_eqparams = extract_equip_type_params(p_eqtmpl)
                                    setup_type_subs(&gmod, p_eqparams, p_eq_targs)
                                    int p_self_tid = lookup_or_register_named(&gmod, pmi.recv_instance)
                                    gmod.type_subs.put("Self", p_self_tid)
                                    # Bind the trait's own generic params (T) to the trait args.
                                    int p_tpi = 0
                                    while p_tpi < p_tdef.type_params.len() and p_tpi < p_eqtmpl.trait_generic_args.len():
                                        String p_tp = p_tdef.type_params.get(p_tpi).unwrap()
                                        SpannedType p_ta = p_eqtmpl.trait_generic_args.get(p_tpi).unwrap()
                                        int p_ta_tid = map_ast_type(p_ta, &gmod)
                                        gmod.type_subs.put(p_tp, p_ta_tid)
                                        p_tpi += 1
                                    # Method-level subs (turbofish or inferred bare form).
                                    int p_mpi = 0
                                    while p_mpi < p_tmeth.type_params.len() and p_mpi < proto_inst_targ_count(pmi):
                                        String p_mp = p_tmeth.type_params.get(p_mpi).unwrap()
                                        int p_mta_tid = proto_inst_targ_tid(pmi, p_mpi, &gmod)
                                        gmod.type_subs.put(p_mp, p_mta_tid)
                                        p_mpi += 1
                                    gmod.functions.push(lower_function(p_tmeth, &gmod))
                                    int p_li = gmod.functions.len() - 1
                                    GirFunction p_lf = gmod.functions.get(p_li).unwrap()
                                    gmod.functions.set(p_li, GirFunction(pmi.mangled_symbol, p_lf.param_types, p_lf.return_type, p_lf.locals, p_lf.blocks, p_lf.with_refresh_pairs, p_lf.inner_shared_spawns))
                                    # Register the return type under the mangled symbol so
                                    # the call-site ret_tid lookup (fn_sigs) resolves to the
                                    # adapter struct, not the I64 fallback.
                                    gmod.fn_sigs.put(pmi.mangled_symbol.clone(), p_lf.return_type)
                                    clear_type_subs(&gmod)
                case None:
                    # INHERENT equip (no trait): the method-level-generic body
                    # lives directly in the equip block (e.g. `zip[U]` in
                    # `equip [T] VectorIter[T]:`). Match the method by name +
                    # method-targ arity in the equip block itself, bind
                    # equip-[T->...] + Self + method-[U->...] subs, emit the body
                    # under the mangled symbol. Mirrors Rust's
                    # lower_method_instance equip-block-match arm (no trait_).
                    for p_im in p_eqtmpl.methods:
                        if p_im.name == pmi.method_name and p_im.body.len() > 0 and p_im.type_params.len() == proto_inst_targ_count(pmi) and p_im.type_params.len() > 0:
                            Vector[String] p_ieqparams = extract_equip_type_params(p_eqtmpl)
                            setup_type_subs(&gmod, p_ieqparams, p_eq_targs)
                            int p_iself_tid = lookup_or_register_named(&gmod, pmi.recv_instance)
                            gmod.type_subs.put("Self", p_iself_tid)
                            int p_impi = 0
                            while p_impi < p_im.type_params.len() and p_impi < proto_inst_targ_count(pmi):
                                String p_imp = p_im.type_params.get(p_impi).unwrap()
                                int p_imta_tid = proto_inst_targ_tid(pmi, p_impi, &gmod)
                                gmod.type_subs.put(p_imp, p_imta_tid)
                                p_impi += 1
                            gmod.functions.push(lower_function(p_im, &gmod))
                            int p_ili = gmod.functions.len() - 1
                            GirFunction p_ilf = gmod.functions.get(p_ili).unwrap()
                            gmod.functions.set(p_ili, GirFunction(pmi.mangled_symbol, p_ilf.param_types, p_ilf.return_type, p_ilf.locals, p_ilf.blocks, p_ilf.with_refresh_pairs, p_ilf.inner_shared_spawns))
                            gmod.fn_sigs.put(pmi.mangled_symbol.clone(), p_ilf.return_type)
                            clear_type_subs(&gmod)

    # closure Phase 2 Step A: the post-pass — SOLE pusher of
    # __Closure_N__call. Drain gmod.lifted_closures (recorded at the
    # make-site during the lower_function loop). Re-read .len() each
    # iteration (drain-until-empty): lowering a lowerable body re-enters
    # lower_expr, which may APPEND a new record past the current len (e.g.
    # an implicit-it `.map(it*2)` inside a lowerable body — the nested-
    # closure guard doesn't see EImplicitClosure, so such a body IS lowered
    # and its implicit closure is appended mid-drain). The while picks it up.
    # Termination: each record is lowered exactly once and lowering appends
    # only strictly-new records with fresh cids, so `di` advances monotonically.
    int di = 0
    while di < gmod.lifted_closures.len():
        LiftedClosure lc = gmod.lifted_closures.get(di).unwrap()
        # Bind fields to owned locals so the `!abi_param_types` move below
        # doesn't invalidate the rest of `lc` (a field move is a whole-value
        # move at the borrow-check layer).
        String d_call_name = lc.call_name.clone()
        Vector[int] d_abi = lc.abi_param_types.clone()
        int d_self_ptr = lc.self_ptr
        Vector[int] d_body_pt = lc.body_param_types.clone()
        Vector[String] d_body_pn = lc.body_param_names.clone()
        int d_ret = lc.return_type
        Vector[Stmt] d_body = lc.body.clone()
        bool d_lowerable = lc.lowerable
        Vector[ClosureCapture] d_caps = lc.captures.clone()
        if d_lowerable:
            # lower_closure_body pushes the GirFunction itself; lowering its
            # body may append further records (drain-until-empty). Step B:
            # `d_caps` carries the ByValue captures (field-loaded before the
            # body, in env-field/GIFieldLoad-index order).
            lower_closure_body(d_call_name, !d_abi, d_self_ptr, d_body_pt, d_body_pn, d_ret, d_body, d_caps, &gmod)
        else:
            # Phase-1 stub: _0 = return place, _1 = env ptr, then one local
            # per closure param (implicit-it: a single `it` local). Shape is
            # byte-identical to the old scan's stub (explicit + implicit-it).
            Vector[GirLocal] stub_locals = [GirLocal(d_ret, None, LoOwned(), BoNone(), false), GirLocal(d_self_ptr, None, LoParam(), BoParam(-1), false)]
            int spi = 0
            while spi < d_body_pt.len():
                int spt = d_body_pt.get(spi).unwrap()
                String spn = d_body_pn.get(spi).unwrap()
                stub_locals.push(GirLocal(spt, Some(spn.clone()), LoParam(), BoParam(-1), false))
                spi = spi + 1
            Vector[BasicBlock] stub_blocks = [BasicBlock([], GTReturn(OpCopy(0)))]
            gmod.functions.push(GirFunction(d_call_name, !d_abi, d_ret, !stub_locals, !stub_blocks, [], []))
        di = di + 1

    # Scan for spawn wrappers: shared-token and closure/method spawn
    # Two-pass approach:
    # Pass 1: collect ALL shared variable names from ALL functions (so inner
    #         spawns inside nested_driver can see shared vars from main).
    # Pass 2: scan every function body for ESpawn calls.
    Dict[String, bool] shared_vars = {}
    Dict[String, bool] async_fns = {}
    Dict[String, bool] emitted_wrappers = {}
    # `async_fns` (the per-callee await-ness map) is populated in `gmod.async_fns`
    # by the pre-pass at the TOP of `lower_module` (BEFORE function bodies are
    # lowered), so `lower_shared_spawn` can query it DURING lowering. This scan
    # loop runs AFTER lowering, so its own `async_fns` local would be too late —
    # the routing decision is already made. It stays empty + the (now no-op)
    # shared-spawn arm of `scan_expr_for_spawn` no longer reads it.
    for sw_item1 in m.items:
        match sw_item1:
            case IFunction(fdef):
                collect_shared_vars(fdef.body, &shared_vars)
            else:
                pass
    for sw_item in m.items:
        match sw_item:
            case IFunction(fdef):
                # Per-function var_types map: variable name → declared type name
                # Used to resolve receiver type for method spawn wrappers.
                Dict[String, String] var_types = {}
                # Collect &-qualified params (OWN_MUTABLE == 1) of this function.
                # These are shared-derived refs; if passed to a spawn, the callee
                # needs a shared-token wrapper (inner shared spawn pattern).
                Dict[String, bool] borrow_params = {}
                for bp in fdef.params:
                    if bp.ownership == 1:
                        borrow_params.put(bp.param_name, true)
                scan_spawn_wrappers(fdef.body, &shared_vars, &async_fns, &emitted_wrappers, &gmod, &var_types, &borrow_params)
            else:
                pass

    # Emit __spawn_wrap___Closure_N stubs for named closure variable spawns.
    # closure Phase 2 Step A: re-pointed to the make-site-recorded cids. The
    # make-site (SVarDecl lowering) recorded `<fn>\0<varname>` →
    # `__Closure_<cid>` into gmod.closure_var_cids, so a `spawn varname()`'s
    # wrapper wires to the closure's make-site cid (matching the post-pass-
    # pushed __Closure_<cid>__call). Replaces the deleted collect_closure_vars_*
    # / ncv_id replay, which re-derived cids in source order — NOT consistent
    # with the make-site cids once test/generic/equip closures precede a
    # named-spawn (the make-site assigns cids in monomorphization order over a
    # SUPERSET of the scan's IFunction/IEquip walk).
    for ncv_item in m.items:
        match ncv_item:
            case IFunction(fdef):
                emit_named_closure_spawn_stmts(fdef.body, fdef.name, &emitted_wrappers, &gmod)
            else:
                pass

    # round-16 Phase-2: the GIR→GIR async-splice post-pass. Runs AFTER every
    # function is lowered (so each shared-async SOURCE function's GIR is present)
    # and synthesizes the `__shared_async_<callee>` variants (release/reacquire
    # spliced around suspensions) + their inner `__shared_token_<inner>` wrappers.
    # Mirrors Rust gg's driver (`src/ir/lowering/mod.rs:1547-1620` over
    # `pending_shared_variants`).
    process_pending_shared_async(&gmod)

    return gmod
