# LIR → C codegen.
#
# Thin 1:1 translation from LIR to C source code. No semantic decisions —
# all type coercions, drop calls, vtable dispatch, closures, etc. are already
# explicit in LIR instructions.
#
# Phase 4 of the self-host LIR backend.

from lir import LirModule, LirFunction, LirBlock, LirInst, LirTerm, LirSlot
from lir import LirStructDef, LirExtern, LirGlobal, LirGlobalField, LirSpawnedFn, LirTestFn, LirBenchFn
from lir import StructField, BlockParam, SwitchCase, FieldDrop, EnumVariantDrop, TypeDropInfo, FieldInit
from lir import LT_I8, LT_I16, LT_I32, LT_I64, LT_U8, LT_U16, LT_U32, LT_U64
from lir import LT_F32, LT_F64, LT_BOOL, LT_PTR, LT_VOID
from lir import LT_PTR_TO_BASE, LT_STRUCT_BASE
from lir import lir_is_scalar, lir_is_aggregate, lir_is_ptr, lir_is_integer, lir_is_float
from lir import lir_struct_id
from lir import OVF_TRAP, OVF_WRAP
from lir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from lir import EK_NOT_ENUM, EK_OPTION, EK_RESULT, EK_GENERAL
from lir import GINIT_ZEROED, GINIT_FUNC_ADDR, GINIT_RUNTIME_CALL, GINIT_STRUCT, GINIT_BYTES
from lir import SCHED_POOL, SCHED_THREAD, SCHED_INLINE, SCHED_SINGLE
from std.collections import Vector, Dict
from std.conv import int_to_str
# Chain 2: the full-program preamble reads the shared runtime .c files at
# `src/backend/c/runtime/` and fails loud (exit 1) on a missing/empty read —
# read_file returns "" silently on a bad path.
from std.fs import read_file
from std.os import exit
from std.io import stderr

# ── String builder ──────────────────────────────────────────
#
# Mirrors Rust's `out: &mut String` pattern from src/backend/c_lir/mod.rs:
# every emit_* helper takes a single growing buffer by mutable reference
# and appends to it via `sb_push(&buf, ...)`. The naive
# `out = out + emit_function(...)` over 600+ functions is O(N²) — it
# OOM-kills stage-1 just before output (RSS goes 103MB → 10GB in 4s).
#
# Wrapping String in a struct is the workaround for the Gorget compiler
# never passing String params by pointer in extern decls (even with `&`,
# String params get the AbiKind::Auto by-value treatment). With the struct
# wrapper, `&buf` IS passed as `StrBuf*` which aliases `Str*` at offset 0,
# and the runtime helper dereferences it.
#
# Returns int (always 0) instead of void: the self-host's call lowering
# binds `__vN = call(...)` for extern calls and chokes on void return.
struct StrBuf:
    String s

extern "C":
    extern int gorget_string_append_buf(StrBuf &buf, String data, int n) = "gorget_string_append_buf"

void sb_push(StrBuf &buf, String rhs):
    # `byte_len()` not `len()` — len() returns codepoint count which
    # truncates strings containing multi-byte UTF-8 (box-drawing chars
    # like `──` are 3 bytes each but 1 codepoint each).
    int unused = gorget_string_append_buf(&buf, rhs, rhs.byte_len())

StrBuf sb_new():
    return StrBuf("")

# ── C type mapping ─────────────────────────────────────────

# Find substring, returns -1 if not found. Avoids Option[int] return type issue.
int find_substr(String haystack, String needle):
    int hi = 0
    int nlen = needle.len()
    while hi <= haystack.len() - nlen:
        if haystack.slice(hi, hi + nlen) == needle:
            return hi
        hi += 1
    return -1

String c_type_name(int ty, Vector[String] &sn):
    if ty == LT_I8:
        return "int8_t"
    elif ty == LT_I16:
        return "int16_t"
    elif ty == LT_I32:
        return "int32_t"
    elif ty == LT_I64:
        return "int64_t"
    elif ty == LT_U8:
        return "uint8_t"
    elif ty == LT_U16:
        return "uint16_t"
    elif ty == LT_U32:
        return "uint32_t"
    elif ty == LT_U64:
        return "uint64_t"
    elif ty == LT_F32:
        return "float"
    elif ty == LT_F64:
        return "double"
    elif ty == LT_BOOL:
        return "bool"
    elif ty == LT_PTR:
        return "void*"
    elif ty == LT_VOID:
        return "void"
    elif ty >= LT_STRUCT_BASE:
        int sid = ty - LT_STRUCT_BASE
        if sid >= 0 and sid < sn.len():
            return sn.get(sid).unwrap()
        return "__lir_s" + int_to_str(sid)
    elif ty >= LT_PTR_TO_BASE:
        return "void*"
    return "void*"

# ── Name helpers ───────────────────────────────────────────

# Runtime struct names that should NOT be re-defined by codegen.
bool is_runtime_struct(String name):
    if name == "Str" or name == "GorgetString" or name == "GorgetArray":
        return true
    if name == "GorgetClosure" or name == "TraitObj":
        return true
    if name == "GorgetMap" or name == "GorgetSet":
        return true
    return false

# Structs defined by LIR that preserve their original name.
bool is_lir_named_struct(String name):
    if name == "TaskHandle" or name == "GorgetRange" or name == "ExecResult":
        return true
    if name == "GorgetCipherContext" or name == "GorgetX25519KeyPair":
        return true
    if name == "GorgetArena" or name == "GorgetArenaCheckpoint":
        return true
    if name == "GorgetPoolAllocator" or name == "GorgetTlsfAllocator":
        return true
    if name == "GorgetFixedBufferAllocator" or name == "GorgetFallbackAllocator":
        return true
    if name == "GorgetFile" or name == "GorgetError":
        return true
    return false

# Runtime-defined named structs (skip emission).
bool is_runtime_defined_named(String name):
    if name == "TaskHandle" or name == "GorgetRange":
        return true
    if name == "ExecResult" or name == "GorgetCipherContext":
        return true
    if name == "GorgetX25519KeyPair" or name == "GorgetArena":
        return true
    if name == "GorgetArenaCheckpoint" or name == "GorgetPoolAllocator":
        return true
    if name == "GorgetTlsfAllocator" or name == "GorgetFixedBufferAllocator":
        return true
    if name == "GorgetFallbackAllocator" or name == "GorgetFile" or name == "GorgetError":
        return true
    if name == "GorgetSemaphore" or name == "GorgetWaitGroup" or name == "GorgetOnceFlag":
        return true
    if name == "GorgetUdpAddr" or name == "GorgetUdpPacket":
        return true
    if name == "GorgetSocket" or name == "GorgetServerSocket":
        return true
    if name == "GorgetTlsSocket" or name == "GorgetTlsServerSocket":
        return true
    if name == "GorgetUdpSocket" or name == "GorgetBigNum":
        return true
    if name == "GorgetRSAKey" or name == "GorgetEd25519KeyPair":
        return true
    if name == "GorgetRegex" or name == "GorgetRegexMatch":
        return true
    return false

# Map LIR struct names to their runtime C names when they differ.
String lir_to_runtime_name(String name):
    if name == "GorgetString":
        return "Str"
    elif name == "ArenaCheckpoint":
        return "GorgetArenaCheckpoint"
    elif name == "Socket":
        return "GorgetSocket"
    elif name == "ServerSocket":
        return "GorgetServerSocket"
    elif name == "TlsSocket":
        return "GorgetTlsSocket"
    elif name == "TlsServerSocket":
        return "GorgetTlsServerSocket"
    elif name == "UdpSocket":
        return "GorgetUdpSocket"
    elif name == "UdpAddr":
        return "GorgetUdpAddr"
    elif name == "UdpPacket":
        return "GorgetUdpPacket"
    elif name == "Semaphore":
        return "GorgetSemaphore"
    elif name == "WaitGroup":
        return "GorgetWaitGroup"
    elif name == "OnceFlag":
        return "GorgetOnceFlag"
    elif name == "CipherContext":
        return "GorgetCipherContext"
    elif name == "BigNum":
        return "GorgetBigNum"
    elif name == "RSAKey":
        return "GorgetRSAKey"
    elif name == "Ed25519KeyPair":
        return "GorgetEd25519KeyPair"
    elif name == "X25519KeyPair":
        return "GorgetX25519KeyPair"
    elif name == "Regex":
        return "GorgetRegex"
    elif name == "RegexMatch" or name == "Match":
        return "GorgetRegexMatch"
    elif name == "File":
        return "GorgetFile"
    elif name == "Barrier":
        return "GorgetBarrier"
    elif name == "CondVar":
        return "GorgetCondVar"
    elif name == "AtomicInt":
        return "GorgetAtomicInt"
    elif name == "AtomicBool":
        return "GorgetAtomicBool"
    elif name == "Process":
        return "GorgetProcess"
    elif name == "SDLWindow":
        return "GorgetSDLWindow"
    elif name == "SDLRenderer":
        return "GorgetSDLRenderer"
    elif name == "SDLTexture":
        return "GorgetSDLTexture"
    elif name == "SDLFont":
        return "GorgetSDLFont"
    elif name == "SDLEvent":
        return "GorgetSDLEvent"
    elif name == "AudioChunk":
        return "GorgetAudioChunk"
    elif name == "AudioMusic":
        return "GorgetAudioMusic"
    elif name == "GLContext":
        return "GorgetGLContext"
    return ""

# Build a mapping from struct index → C type name. Vector indexed by
# sid is O(1) lookup by construction; no Dict needed (the key would
# be an int).
Vector[String] build_struct_names(LirModule &m):
    Vector[String] map = []
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        String rt = lir_to_runtime_name(sdef.name)
        if rt != "":
            map.push(rt)
        elif is_runtime_struct(sdef.name) or is_lir_named_struct(sdef.name):
            map.push(sdef.name.clone())
        elif m.type_runtime_map.contains(sdef.name):
            map.push(sdef.name.clone())
        else:
            # Sanitize: replace non-alphanumeric chars with underscores.
            String sanitized = sanitize_c_name(sdef.name)
            map.push("__gg_" + sanitized)
        i += 1
    return map

String sanitize_c_name(String name):
    String out = ""
    int i = 0
    while i < name.len():
        String ch = name.slice(i, i + 1)
        if ch == "_":
            out = out + ch
        elif ch >= "a" and ch <= "z":
            out = out + ch
        elif ch >= "A" and ch <= "Z":
            out = out + ch
        elif ch >= "0" and ch <= "9":
            out = out + ch
        else:
            out = out + "_"
        i += 1
    return out

# Should this struct be skipped during emission?
bool should_skip_struct(LirStructDef &sdef, LirModule &m):
    if is_runtime_struct(sdef.name):
        return true
    if is_runtime_defined_named(sdef.name):
        return true
    # Only skip types whose runtime category has a concrete C alias (collection
    # aliases, Box/Guard/Task/Ptr, string aliases). Categories without a C alias
    # (Option, Result) need their own struct definitions and must NOT be skipped.
    if m.type_runtime_map.contains(sdef.name):
        String cat = m.type_runtime_map.get(sdef.name).unwrap_or("")
        if runtime_category_to_c_type(cat) != "":
            return true
    if lir_to_runtime_name(sdef.name) != "":
        return true
    # Imported type — only skip if the runtime preamble already defines it.
    # User-defined imports (ast.gg / parser.gg / etc.) must still be emitted
    # so the output is self-contained when bootstrapping.
    if m.imported_type_names.contains(sdef.name) and is_runtime_defined_named(sdef.name):
        return true
    return false

# Escape a function name that clashes with C keywords.
String c_func_name(String name):
    if is_c_keyword(name):
        return "__gg_" + name
    return name

bool is_c_keyword(String name):
    if name == "auto" or name == "break" or name == "case" or name == "char":
        return true
    if name == "const" or name == "continue" or name == "default" or name == "do":
        return true
    if name == "double" or name == "else" or name == "enum" or name == "extern":
        return true
    if name == "float" or name == "for" or name == "goto" or name == "if":
        return true
    if name == "int" or name == "long" or name == "register" or name == "return":
        return true
    if name == "short" or name == "signed" or name == "sizeof" or name == "static":
        return true
    if name == "struct" or name == "switch" or name == "typedef" or name == "union":
        return true
    if name == "unsigned" or name == "void" or name == "volatile" or name == "while":
        return true
    if name == "inline" or name == "restrict" or name == "bool":
        return true
    if name == "true" or name == "false":
        return true
    return false

# Sanitize a field name for C.
String c_field_name(String name):
    return name.replace(".", "_").replace("-", "_")

# Escape a string for a C string literal. The naive char-by-char concat
# is O(N²) — for a 1MB string literal, that's 1 trillion byte-copies and
# OOM-kills stage-1 compiling functions with embedded large strings (e.g.
# typecheck.gg's pattern-type tables). sb_push amortizes O(1) per byte.
String escape_c_string(String s):
    StrBuf buf = sb_new()
    int i = 0
    while i < s.len():
        String ch = s.slice(i, i + 1)
        if ch == "\"":
            sb_push(&buf, "\\\"")
        elif ch == "\\":
            sb_push(&buf, "\\\\")
        elif ch == "\n":
            sb_push(&buf, "\\n")
        elif ch == "\r":
            sb_push(&buf, "\\r")
        elif ch == "\t":
            sb_push(&buf, "\\t")
        else:
            # For non-ASCII bytes we'd need hex escaping, but the self-host
            # only handles ASCII fixtures. Pass through as-is.
            sb_push(&buf, ch)
        i += 1
    return buf.s

# ── Comparison operator to C string ────────────────────────

String cmp_op_str(int op):
    if op == CMP_EQ:
        return "=="
    elif op == CMP_NE:
        return "!="
    elif op == CMP_LT:
        return "<"
    elif op == CMP_LE:
        return "<="
    elif op == CMP_GT:
        return ">"
    elif op == CMP_GE:
        return ">="
    return "=="

# ── Topological sort (Kahn's algorithm) ───────────────────

Vector[int] topo_sort_structs(LirModule &m):
    int n = m.structs.len()
    # Build dependency graph: deps[i] = list of j where struct i embeds struct j.
    Vector[Vector[int]] deps = []
    Vector[Vector[int]] dependents = []
    Vector[int] in_degree = []
    int i = 0
    while i < n:
        Vector[int] empty1 = []
        Vector[int] empty2 = []
        deps.push(empty1)
        dependents.push(empty2)
        in_degree.push(0)
        i += 1

    i = 0
    while i < n:
        LirStructDef sdef = m.structs.get(i).unwrap()
        int fi = 0
        while fi < sdef.fields.len():
            StructField field = sdef.fields.get(fi).unwrap()
            if field.ty >= LT_STRUCT_BASE:
                int j = field.ty - LT_STRUCT_BASE
                if j != i and j < n:
                    deps.get(i).unwrap().push(j)
                    dependents.get(j).unwrap().push(i)
                    int cur = in_degree.get(i).unwrap()
                    in_degree.set(i, cur + 1)
            fi += 1
        i += 1

    # BFS: emit structs with no deps first.
    Vector[int] queue = []
    i = 0
    while i < n:
        if in_degree.get(i).unwrap() == 0:
            queue.push(i)
        i += 1

    Vector[int] order = []
    int qi = 0
    while qi < queue.len():
        int k = queue.get(qi).unwrap()
        order.push(k)
        # Read inner vec by-value so iteration is over a stable snapshot
        # — Vector.get() returning a shared ref + concurrent mutation
        # has been a stage-1 footgun before.
        Vector[int] dep_list = dependents.get(k).unwrap()
        int di = 0
        while di < dep_list.len():
            int dep = dep_list.get(di).unwrap()
            int deg = in_degree.get(dep).unwrap() - 1
            in_degree.set(dep, deg)
            if deg == 0:
                queue.push(dep)
            di += 1
        qi += 1

    # Remaining (cycles) — append in original order.
    if order.len() < n:
        Dict[int, bool] in_order = {}
        int oi = 0
        while oi < order.len():
            in_order.put(order.get(oi).unwrap(), true)
            oi += 1
        i = 0
        while i < n:
            if not in_order.contains(i):
                order.push(i)
            i += 1

    return order

# ── Struct emission ────────────────────────────────────────

String emit_structs(LirModule &m, Vector[String] &sn):
    StrBuf buf = sb_new()
    Vector[int] order = topo_sort_structs(&m)

    # Forward declarations
    int oi = 0
    while oi < order.len():
        int idx = order.get(oi).unwrap()
        LirStructDef sdef = m.structs.get(idx).unwrap()
        if should_skip_struct(&sdef, &m):
            oi += 1
            continue
        if sdef.name == "":
            oi += 1
            continue
        String cname = c_type_name(LT_STRUCT_BASE + idx, &sn)
        sb_push(&buf, "typedef struct ")
        sb_push(&buf, cname)
        sb_push(&buf, " ")
        sb_push(&buf, cname)
        sb_push(&buf, ";\n")
        oi += 1
    sb_push(&buf, "\n")

    # Struct definitions
    oi = 0
    while oi < order.len():
        int idx = order.get(oi).unwrap()
        LirStructDef sdef = m.structs.get(idx).unwrap()
        if should_skip_struct(&sdef, &m):
            oi += 1
            continue
        if sdef.name == "":
            oi += 1
            continue
        String cname = c_type_name(LT_STRUCT_BASE + idx, &sn)
        sb_push(&buf, "// ")
        sb_push(&buf, sdef.name)
        sb_push(&buf, "\n")
        sb_push(&buf, "struct ")
        sb_push(&buf, cname)
        sb_push(&buf, " {\n")
        if sdef.fields.len() == 0:
            sb_push(&buf, "    char __pad;\n")
        elif sdef.is_union_layout and sdef.fields.len() > 1:
            # Enum type: tag + union of variant structs.
            StructField tag_field = sdef.fields.get(0).unwrap()
            String tag_ty = c_type_name(tag_field.ty, &sn)
            sb_push(&buf, "    ")
            sb_push(&buf, tag_ty)
            sb_push(&buf, " ")
            sb_push(&buf, c_field_name(tag_field.name))
            sb_push(&buf, ";\n")
            sb_push(&buf, "    union {\n")
            # Group remaining fields by variant prefix using flat
            # parallel vectors: `variant_starts[i]` is the start index
            # in `variant_indices` for variant i; the count is
            # `variant_starts[i+1] - variant_starts[i]` (with sentinel
            # = total length appended at the end). Avoids nested
            # Vector[Vector[int]] allocation per variant.
            Vector[String] variant_names = []
            Vector[int] variant_starts = []
            Vector[int] variant_indices = []
            int fi = 1
            while fi < sdef.fields.len():
                StructField f = sdef.fields.get(fi).unwrap()
                String vname = field_variant_prefix(f.name)
                bool new_group = false
                if variant_names.len() == 0:
                    new_group = true
                else:
                    String prev = variant_names.get(variant_names.len() - 1).unwrap()
                    if prev != vname:
                        new_group = true
                if new_group:
                    variant_names.push(vname)
                    variant_starts.push(variant_indices.len())
                variant_indices.push(fi)
                fi += 1
            variant_starts.push(variant_indices.len())

            int vi = 0
            while vi < variant_names.len():
                String vname = variant_names.get(vi).unwrap()
                int start = variant_starts.get(vi).unwrap()
                int end = variant_starts.get(vi + 1).unwrap()
                int icount = end - start
                if icount == 1:
                    int fidx = variant_indices.get(start).unwrap()
                    StructField f = sdef.fields.get(fidx).unwrap()
                    String fty = field_type_str(f.ty, &sn)
                    sb_push(&buf, "        ")
                    sb_push(&buf, fty)
                    sb_push(&buf, " ")
                    sb_push(&buf, c_field_name(f.name))
                    sb_push(&buf, ";  // ")
                    sb_push(&buf, vname)
                    sb_push(&buf, "\n")
                else:
                    sb_push(&buf, "        struct {  // ")
                    sb_push(&buf, vname)
                    sb_push(&buf, "\n")
                    int ii = start
                    while ii < end:
                        int fidx = variant_indices.get(ii).unwrap()
                        StructField f = sdef.fields.get(fidx).unwrap()
                        String fty = field_type_str(f.ty, &sn)
                        sb_push(&buf, "            ")
                        sb_push(&buf, fty)
                        sb_push(&buf, " ")
                        sb_push(&buf, c_field_name(f.name))
                        sb_push(&buf, ";\n")
                        ii += 1
                    sb_push(&buf, "        } ")
                    sb_push(&buf, c_field_name(vname))
                    sb_push(&buf, ";\n")
                vi += 1
            sb_push(&buf, "    } data;\n")
        else:
            int fi = 0
            while fi < sdef.fields.len():
                StructField f = sdef.fields.get(fi).unwrap()
                String fty = field_type_str(f.ty, &sn)
                sb_push(&buf, "    ")
                sb_push(&buf, fty)
                sb_push(&buf, " ")
                sb_push(&buf, c_field_name(f.name))
                sb_push(&buf, ";\n")
                fi += 1
        sb_push(&buf, "};\n\n")
        oi += 1
    return buf.s

# Extract variant name prefix from "VariantName_N" → "VariantName"
String field_variant_prefix(String fname):
    int i = fname.len() - 1
    while i >= 0:
        String ch = fname.slice(i, i + 1)
        if ch == "_":
            return fname.slice(0, i)
        i -= 1
    return fname

# Type string for a struct field (Void → uint8_t placeholder).
String field_type_str(int ty, Vector[String] &sn):
    if ty == LT_VOID:
        return "uint8_t"
    return c_type_name(ty, &sn)

# ── Extern declarations ────────────────────────────────────

String emit_externs(LirModule &m, Vector[String] &sn):
    String out = ""
    int i = 0
    while i < m.externs.len():
        LirExtern ext = m.externs.get(i).unwrap()
        # Skip runtime-provided functions (they're in the included runtime).
        if is_runtime_fn(ext.name) or is_std_header_fn(ext.name):
            i += 1
            continue
        # Skip C keyword casts.
        if ext.name == "float" or ext.name == "int" or ext.name == "bool":
            i += 1
            continue
        # Skip monomorphized wrapper methods.
        if is_mono_wrapper_method(ext.name, &m):
            i += 1
            continue
        # Skip variadic externs with no params.
        if ext.is_variadic and ext.params.len() == 0:
            i += 1
            continue
        String ret = c_type_name(ext.return_type, &sn)
        out = out + ret + " " + ext.name + "("
        if ext.params.len() == 0 and not ext.is_variadic:
            out = out + "void"
        else:
            int pi = 0
            while pi < ext.params.len():
                if pi > 0:
                    out = out + ", "
                int pty = ext.params.get(pi).unwrap()
                if pty == LT_VOID:
                    out = out + "void*"
                else:
                    out = out + c_type_name(pty, &sn)
                pi += 1
            if ext.is_variadic:
                if ext.params.len() > 0:
                    out = out + ", "
                out = out + "..."
        out = out + ");\n"
        i += 1
    if m.externs.len() > 0:
        out = out + "\n"
    return out

bool is_mono_wrapper_method(String name, LirModule &m):
    # Phase A — use type_runtime_map: scan __ split points; any prefix registered as
    # "Ptr" or "Guard" means this is a monomorphized wrapper method to skip.
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.type_runtime_map.contains(prefix):
                String cat = m.type_runtime_map.get(prefix).unwrap_or("")
                if cat == "Ptr" or cat == "Box" or cat == "Guard":
                    return true
        i += 1
    return false

# Simple check for common runtime functions (they're already in the C runtime).
bool is_runtime_fn(String name):
    if name.starts_with("gorget_") or name.starts_with("__gorget_"):
        return true
    if name == "printf" or name == "fprintf" or name == "snprintf":
        return true
    if name == "malloc" or name == "calloc" or name == "realloc" or name == "free":
        return true
    if name == "memcpy" or name == "memset" or name == "memmove" or name == "memcmp":
        return true
    if name == "strlen" or name == "strcmp" or name == "strncmp":
        return true
    if name == "abort" or name == "exit":
        return true
    return false

bool is_std_header_fn(String name):
    if name == "fopen" or name == "fclose" or name == "fread" or name == "fwrite":
        return true
    if name == "fgets" or name == "fputs" or name == "fflush":
        return true
    if name == "fseek" or name == "ftell" or name == "rewind":
        return true
    if name == "getenv" or name == "system" or name == "atoi" or name == "atof":
        return true
    if name == "clock" or name == "time" or name == "sleep" or name == "usleep":
        return true
    return false

# ── Box allocator helpers ──────────────────────────────────
# LIR-based scanner for box allocators. Walks every ICallExtern and
# ICall instruction across all functions, collecting unique Box__*
# constructor names. The codegen rewrites `Box__T(x)` →
# `__gorget_box_alloc_T(x)`, so we scan for the pre-rewrite name.
# Robust against the body-string scan failing under stage-1's String
# slicing on large inputs.
# If `ftn` is a `Box__<inner>` field type (typed via type_runtime_map),
# emit the `__gorget_box_alloc_<inner>` allocator (deduped via `seen`) — the
# deep-clone codegen (`field_clone_c`) references it, but the ICall scan
# below only finds box types from explicit `Box.new` sites, so a box field
# whose value never arose from a `Box__inner(...)` call (e.g. parsed
# Box[SpannedPattern]) would otherwise link-fail.
# True iff the LIR type-id names a `Box__<inner>` struct. Box types are
# registered as structs (>= LT_STRUCT_BASE) so `Some(Box(x))` resolves to
# `Option__Box__T` and the deep-clone codegen finds the inner allocator —
# but in C they are `typedef void* Box__<inner>`, i.e. pointer-represented.
# `lir_is_aggregate` (>= LT_STRUCT_BASE) therefore mis-classifies a Box VALUE
# as an inline aggregate; this predicate (reading the typed `type_runtime_map`
# registry, not a name match) lets the store/coercion paths treat a Box value
# as the pointer it actually is. Without it, IBoxAlloc's `Box__T`-typed result
# stored into an `LT_PTR` slot hit the "aggregate-into-pointer → NULL" give-up
# branch, NULLing the box (the parse_dot_expr `EFieldAccess(Box(lhs), ...)`
# crash: the boxed base came out NULL → deref SIGSEGV in `Expr__clone`).
bool lir_type_is_box(int ty, LirModule &m):
    if ty < LT_STRUCT_BASE:
        return false
    int sid = ty - LT_STRUCT_BASE
    if sid < 0 or sid >= m.structs.len():
        return false
    String nm = m.structs.get(sid).unwrap().name
    if not m.type_runtime_map.contains(nm):
        return false
    return m.type_runtime_map.get(nm).unwrap_or("") == "Box"

String box_alloc_for_field_type(String ftn, Vector[String] &seen, String emit_prefix, LirModule &m):
    bool is_box = false
    if m.type_runtime_map.contains(ftn):
        if m.type_runtime_map.get(ftn).unwrap_or("") == "Box":
            is_box = true
    if not is_box or ftn.len() <= 5 or ftn.slice(0, 5) != "Box__":
        return ""
    String inner = ftn.slice(5, ftn.len())
    int si = 0
    while si < seen.len():
        if seen.get(si).unwrap() == inner:
            return ""
        si += 1
    seen.push(inner.clone())
    String c_ty = box_alloc_c_type(inner)
    return "static inline void* " + emit_prefix + inner + "(" + c_ty + " val) { " + c_ty + "* p = (" + c_ty + "*)GORGET_ALLOC(sizeof(" + c_ty + ")); *p = val; return (void*)p; }\n"

String emit_box_allocators_from_lir(LirModule &m):
    Vector[String] seen = []
    String out = ""
    String emit_prefix = "__gorget_box_alloc_"
    String box_prefix = "Box__"
    int box_plen = box_prefix.len()
    int fi = 0
    while fi < m.functions.len():
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                String inst_name = ""
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case ICallExtern(_, name, _, _, _):
                        inst_name = name
                    case ICall(_, fid, _):
                        if fid >= 0 and fid < m.functions.len():
                            inst_name = m.functions.get(fid).unwrap().name
                    else:
                        pass
                String suffix = ""
                if inst_name.starts_with(box_prefix) and inst_name.len() > box_plen:
                    suffix = inst_name.slice(box_plen, inst_name.len())
                elif inst_name.starts_with(emit_prefix) and inst_name.len() > emit_prefix.len():
                    suffix = inst_name.slice(emit_prefix.len(), inst_name.len())
                if suffix.len() > 0:
                    bool already = false
                    int si = 0
                    while si < seen.len():
                        if seen.get(si).unwrap() == suffix:
                            already = true
                            break
                        si += 1
                    if not already:
                        seen.push(suffix.clone())
                        String c_ty = box_alloc_c_type(suffix)
                        out = out + "static inline void* " + emit_prefix + suffix + "(" + c_ty + " val) { " + c_ty + "* p = (" + c_ty + "*)GORGET_ALLOC(sizeof(" + c_ty + ")); *p = val; return (void*)p; }\n"
                ii += 1
            bi += 1
        fi += 1
    # Box-inner allocators referenced by deep-clone field codegen
    # (field_clone_c) — scan the recursive drop/clone field metadata for
    # `Box__<inner>` field/variant-payload types the ICall scan missed.
    Vector[String] rds_keys = m.recursive_drop_structs.keys()
    int rk = 0
    while rk < rds_keys.len():
        Vector[FieldDrop] fds = m.recursive_drop_structs.get(rds_keys.get(rk).unwrap()).unwrap()
        int fk = 0
        while fk < fds.len():
            out = out + box_alloc_for_field_type(fds.get(fk).unwrap().field_type_name, &seen, emit_prefix, &m)
            fk += 1
        rk += 1
    Vector[String] rde_keys = m.recursive_drop_enums.keys()
    int ek = 0
    while ek < rde_keys.len():
        Vector[EnumVariantDrop] evds = m.recursive_drop_enums.get(rde_keys.get(ek).unwrap()).unwrap()
        int vk = 0
        while vk < evds.len():
            out = out + box_alloc_for_field_type(evds.get(vk).unwrap().field_type_name, &seen, emit_prefix, &m)
            vk += 1
        ek += 1
    if out != "":
        out = out + "\n"
    return out

String box_alloc_c_type(String suffix):
    if suffix == "Str" or suffix == "GorgetString":
        return "Str"
    if suffix == "int64_t" or suffix == "int32_t" or suffix == "int16_t" or suffix == "int8_t":
        return suffix
    if suffix == "uint64_t" or suffix == "uint32_t" or suffix == "uint16_t" or suffix == "uint8_t":
        return suffix
    if suffix == "double" or suffix == "float" or suffix == "bool":
        return suffix
    # Struct name — reference as typedef
    return "__gg_" + suffix

# ── Globals ────────────────────────────────────────────────

String emit_globals(LirModule &m, Vector[String] &sn):
    String out = ""
    int i = 0
    while i < m.globals.len():
        LirGlobal g = m.globals.get(i).unwrap()
        # FuncAddr-bearing globals (GINIT_STRUCT vtables + any scalar
        # GINIT_FUNC_ADDR) reference functions, so they must be DEFERRED
        # past the function forward-declarations. emit_deferred_globals
        # emits them after emit_func_forward_decls. Mirrors Rust gg's
        # `has_func_addrs` skip in `src/backend/c_lir/mod.rs:759-768`.
        if g.init_kind == GINIT_STRUCT or g.init_kind == GINIT_FUNC_ADDR:
            i += 1
            continue
        String kw = ""
        if g.is_const:
            kw = "const "
        String ty = c_type_name(g.ty, &sn)
        out = out + kw + ty + " __lir_g" + int_to_str(i)
        if g.init_kind == GINIT_ZEROED:
            if lir_is_scalar(g.ty):
                out = out + " = 0"
            else:
                out = out + " = {0}"
        elif g.init_kind == GINIT_RUNTIME_CALL:
            out = out + " = {0}"
        elif g.init_kind == GINIT_BYTES:
            # Scalar-literal static: emit the const C literal directly at the
            # declaration (`int64_t __lir_gN = 0LL;`). No runtime synth fn,
            # no main-prologue call. NOT `const`-qualified — the global is
            # MUTABLE (`kw` is driven by g.is_const, which is false here).
            # Mirrors Rust's `GlobalInit::Bytes` emit (`c_lir/mod.rs:764-767`,
            # `is_const:false`).
            out = out + " = " + g.init_expr
        out = out + "; // " + g.name + "\n"
        i += 1
    if m.globals.len() > 0:
        out = out + "\n"
    return out

# Deferred globals: GINIT_STRUCT (trait-impl `_VTable` vtables, a struct of
# FuncAddr slots) — and any scalar GINIT_FUNC_ADDR — are emitted AFTER the
# function forward-declarations so the `(void*)&fn` casts reference
# already-declared functions. Mirrors Rust gg's deferred-global emission in
# `src/backend/c_lir/mod.rs:857-864` + the field rendering in
# `src/backend/c_lir/emit_types.rs:656-658`.
#
# CRITICAL: each FuncAddr field renders as the BARE `(void*)&<c_func_name>`
# form — NOT the `__adapt_<fn>` closure-wrapper protocol that IFuncAddr
# *instructions* use (lir_codegen.gg IFuncAddr arm). Rust emits the plain
# cast (`emit_types.rs:656-658`), and a vtable slot is a direct fn pointer,
# not a closure. Routing through the adapter would diverge from Rust AND
# perturb the adapter-function path.
String emit_deferred_globals(LirModule &m, Vector[String] &sn):
    String out = ""
    int i = 0
    while i < m.globals.len():
        LirGlobal g = m.globals.get(i).unwrap()
        if g.init_kind == GINIT_STRUCT:
            String kw = ""
            if g.is_const:
                kw = "const "
            String ty = c_type_name(g.ty, &sn)
            out = out + kw + ty + " __lir_g" + int_to_str(i) + " = {"
            int fi = 0
            while fi < g.struct_fields.len():
                if fi > 0:
                    out = out + ", "
                LirGlobalField fld = g.struct_fields.get(fi).unwrap()
                if fld.kind == GINIT_FUNC_ADDR and fld.func_id >= 0:
                    # Bare (void*)&fn — see header note (NOT __adapt_).
                    String fname = c_func_name(m.functions.get(fld.func_id).unwrap().name)
                    out = out + "(void*)&" + fname
                else:
                    out = out + "NULL"
                fi += 1
            out = out + "}; // " + g.name + "\n"
        i += 1
    return out

# ── String literal pooling ─────────────────────────────────

struct StringLitEntry:
    String value
    int index

Vector[StringLitEntry] collect_string_lits(LirModule &m):
    Dict[String, int] seen = {}
    Vector[StringLitEntry] entries = []
    int fi = 0
    while fi < m.functions.len():
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case IStrLit(_, value):
                        if not seen.contains(value):
                            int idx = entries.len()
                            String k = value
                            String v2 = value
                            seen.put(k, idx)
                            entries.push(StringLitEntry(v2, idx))
                    else:
                        pass
                ii += 1
            bi += 1
        fi += 1
    return entries

Dict[String, int] build_string_lit_map(Vector[StringLitEntry] &entries):
    Dict[String, int] map = {}
    int i = 0
    while i < entries.len():
        StringLitEntry e = entries.get(i).unwrap()
        map.put(e.value, e.index)
        i += 1
    return map

String emit_string_lits(Vector[StringLitEntry] &entries):
    if entries.len() == 0:
        return ""
    String out = "// ── Static string literals (views into .rodata, cap=0) ──\n"
    int i = 0
    while i < entries.len():
        StringLitEntry e = entries.get(i).unwrap()
        String escaped = escape_c_string(e.value)
        # Str.len in the runtime is byte length, not char count — use
        # byte_len() so Unicode literals (e.g. "── …" with 3-byte `─`)
        # don't get their Str struct's .len truncated to the char count
        # and downstream `gorget_str_cat` lose the trailing UTF-8 tail.
        String slen = int_to_str(e.value.byte_len())
        String line = "static const Str __slit_" + int_to_str(e.index)
        line = line + " = { .data = (char*)\"" + escaped + "\", .cap = 0, .len = " + slen + ", .alloc = NULL };\n"
        out = out + line
        i += 1
    out = out + "\n"
    return out

# ── Function forward declarations ──────────────────────────

# ── Reachability / DCE ─────────────────────────────────────
#
# Skip emitting functions unreachable from main / closure roots /
# drop fns. Mirrors `src/lir/optimize.rs::eliminate_dead_functions`'s
# root set; runs at emit time so the LIR module is left untouched
# (call-site fids stay stable). Without this, the self-host emits
# every imported function whether or not it's called — `closure_float_ret.gg`
# pulls in 155 fns from `xtd.dataframe` even when the user only needs
# Vector[float], inflating the C output by ~120 fns vs Rust gg.

# Compute reachable function set. Returns Vector[bool] indexed by fid.
# `reachable[fid] == true` iff fid is reachable from a root via ICall /
# ICallExtern (by name) / IClosurePack chains.
Vector[bool] compute_reachable_fns(LirModule &m):
    int n = m.functions.len()
    Vector[bool] reachable = []
    int ri = 0
    while ri < n:
        reachable.push(false)
        ri += 1
    if n == 0:
        return reachable

    # Build name → fid table for resolving ICallExtern targets that
    # land on user fns (the self-host emits Trait_for_T__method as a
    # CallExtern by name — they'd otherwise get DCE'd).
    Vector[String] name_keys = []
    Vector[int] name_fids = []
    int ni = 0
    while ni < n:
        name_keys.push(m.functions.get(ni).unwrap().name.clone())
        name_fids.push(ni)
        ni += 1

    Vector[int] worklist = []

    # Seed roots: main, test/bench/suite entry points, every fn whose
    # name contains "__call" (closure dispatch entry points referenced
    # only via fn pointers in GorgetClosure.fn_ptr).
    int fi = 0
    while fi < n:
        String name = m.functions.get(fi).unwrap().name
        bool is_root = false
        if name == "main":
            is_root = true
        elif name.starts_with("__test"):
            is_root = true
        elif name.starts_with("__bench_"):
            is_root = true
        elif name.starts_with("__suite_"):
            is_root = true
        elif name.contains("__call"):
            is_root = true
        if is_root:
            reachable.set(fi, true)
            worklist.push(fi)
        fi += 1

    # Hashable-key roots: Dict[UserStruct, V] / Set[UserStruct] uses a
    # runtime hash-bucket bridge (`__gorget_ktable_hash__T(void*)` /
    # `__gorget_ktable_eq__T`) that calls `T__hash` / `T__eq` via fn
    # pointer. The call isn't visible in the LIR call graph, so DCE
    # would strip the impl methods and the bridge would link-fail.
    # Mirror Rust's `find_hashable_key_types` from
    # `src/lir/optimize.rs:254` — scan ICallExtern for Dict / Set
    # constructors, extract the user-struct key type, and seed
    # `T__hash` / `T__eq` / `Hashable_for_T__hash` /
    # `Equatable_for_T__eq` as DCE roots.
    # Use the shared helper for ctor detection — gates by the post-mapped
    # runtime name (`gorget_dict_new` etc.) so we don't accidentally seed
    # roots from method calls (`Dict__K__V__put`) which share the
    # `Dict__` prefix.
    Vector[String] hashable_keys = collect_hashable_key_types(&m)
    int hk_i = 0
    while hk_i < hashable_keys.len():
        String key_ty = hashable_keys.get(hk_i).unwrap()
        # Match T__hash, T__eq, Hashable_for_T__hash, Equatable_for_T__eq.
        String h1 = key_ty + "__hash"
        String h2 = key_ty + "__eq"
        String h3 = "Hashable_for_" + key_ty + "__hash"
        String h4 = "Equatable_for_" + key_ty + "__eq"
        int hf = 0
        while hf < n:
            String fname_h = m.functions.get(hf).unwrap().name
            if (fname_h == h1 or fname_h == h2 or fname_h == h3 or fname_h == h4) and not reachable.get(hf).unwrap():
                reachable.set(hf, true)
                worklist.push(hf)
            hf += 1
        hk_i += 1

    # Type-drop user-fn references: emit_struct_drops walks
    # m.recursive_drop_structs and m.recursive_drop_enums and emits
    # the auto drop/clone helpers; those are called from generated
    # destructor sites that aren't visible in the LIR call graph, so the
    # helper is seeded as a reachability root here.
    #
    # The drop-fn name comes from the TYPED `type_drop_fns[key].drop_fn_name`
    # (so a drop-name COLLISION type seeds `__gorget_dtor_{T}`, NOT the
    # `{T}__drop` C symbol that belongs to the user `T.drop(...)` method).
    # Reconstructing `key + "__drop"` by name — the old shape — falsely
    # rooted the user 2-arg method, keeping it past DCE (the spurious +1
    # vs Rust) AND leaving the leak live. Reading the resolved name closes
    # that name-matching anti-pattern (docs/devbook/24-layering-discipline.md:
    # the collision was resolved once at lowering, written into
    # type_drop_fns, and is read through that accessor here).
    Vector[String] drop_keys = m.recursive_drop_structs.keys()
    int dk = 0
    while dk < drop_keys.len():
        String dkey = drop_keys.get(dk).unwrap()
        String dn = dkey + "__drop"
        String udn = ""        # ③(c): the user Drop fn called from __gorget_dtor_{T}
        if m.type_drop_fns.contains(dkey):
            dn = m.type_drop_fns.get(dkey).unwrap().drop_fn_name
            udn = m.type_drop_fns.get(dkey).unwrap().user_drop_fn
        String cn = dkey + "__clone"
        int dfi = 0
        while dfi < n:
            String fname_d = m.functions.get(dfi).unwrap().name
            # ③(c): also seed the user `{T}__drop` — after the fix it is called
            # ONLY from inside the generated `__gorget_dtor_{T}` glue via a C
            # string (emit_struct_drops' `udf + "(self);"`), invisible to the
            # LIR call graph, so DCE would prune it → undefined reference.
            # Mirror Rust src/lir/optimize.rs:228-241. Struct loop ONLY (no
            # user-Drop enum in the corpus — the enum seed is unchanged).
            if (fname_d == dn or fname_d == cn or (udn != "" and fname_d == udn)) and not reachable.get(dfi).unwrap():
                reachable.set(dfi, true)
                worklist.push(dfi)
            dfi += 1
        dk += 1
    Vector[String] drop_e_keys = m.recursive_drop_enums.keys()
    int dek = 0
    while dek < drop_e_keys.len():
        String ekey = drop_e_keys.get(dek).unwrap()
        String den = ekey + "__drop"
        if m.type_drop_fns.contains(ekey):
            den = m.type_drop_fns.get(ekey).unwrap().drop_fn_name
        String cen = ekey + "__clone"
        int dei = 0
        while dei < n:
            String fname_e = m.functions.get(dei).unwrap().name
            if (fname_e == den or fname_e == cen) and not reachable.get(dei).unwrap():
                reachable.set(dei, true)
                worklist.push(dei)
            dei += 1
        dek += 1

    # FIDELITY Phase 5, edge (i) — vtable-global FuncAddr roots.
    # A struct-of-FuncAddr global (a trait-impl `_VTable`) keeps its slot
    # functions live even when no IFuncAddr/ICall references them — Rust gg
    # seeds these as reachability roots unconditionally
    # (`src/lir/optimize.rs:268-275` + `collect_global_func_refs:364-374`),
    # matching its emit-vtable-for-every-impl rule. Without this seed the
    # entire trait-impl island (Serializer/Deserializer/Writer/Reader/...)
    # is pruned at C-emit DCE (json_parse: 67 → 28 user fns).
    int gvi = 0
    while gvi < m.globals.len():
        LirGlobal gv = m.globals.get(gvi).unwrap()
        if gv.init_kind == GINIT_STRUCT:
            int gfi = 0
            while gfi < gv.struct_fields.len():
                LirGlobalField gf = gv.struct_fields.get(gfi).unwrap()
                if gf.kind == GINIT_FUNC_ADDR and gf.func_id >= 0 and gf.func_id < n:
                    if not reachable.get(gf.func_id).unwrap():
                        reachable.set(gf.func_id, true)
                        worklist.push(gf.func_id)
                gfi += 1
        gvi += 1

    # Composite-static init-fn roots: a `GINIT_RUNTIME_CALL` global whose
    # init_expr is a synthesized `__gg_static_init_<name>()` call (the
    # collection-literal / runtime-ctor static path; see lower.gg's
    # build_static_init_fn) keeps that init fn live. The call is emitted
    # only as a C string in the `main` module-init prologue
    # (lir_codegen.gg:4504-4513), never as an IR ICall/ICallExtern, so DCE
    # can't see it via the call graph — seed it as a root by name. Mirrors
    # Rust gg seeding the synthetic static-init fn as a DCE root
    # (`src/lir/optimize.rs`). Strip the trailing "()" off the init_expr to
    # recover the function name. Runtime-symbol init exprs
    # (`gorget_stdout_handle()`) won't match a user fn name, so they're
    # harmlessly skipped.
    int rci = 0
    while rci < m.globals.len():
        LirGlobal rcg = m.globals.get(rci).unwrap()
        if rcg.init_kind == GINIT_RUNTIME_CALL:
            String ie = rcg.init_expr
            String ie_fn = ie
            if ie.ends_with("()"):
                ie_fn = ie.slice(0, ie.byte_len() - 2)
            int rcf = 0
            while rcf < n:
                if m.functions.get(rcf).unwrap().name == ie_fn and not reachable.get(rcf).unwrap():
                    reachable.set(rcf, true)
                    worklist.push(rcf)
                rcf += 1
        rci += 1

    # Transitive closure: walk reachable functions, follow ICall fids
    # and ICallExtern names.
    int wi = 0
    while wi < worklist.len():
        int cur = worklist.get(wi).unwrap()
        wi += 1
        if cur < 0 or cur >= n:
            continue
        # Read the function/block/inst through BORROWS — do NOT value-bind
        # `LirBlock blk = …` / `LirInst inst = …`, which deep-clone the whole
        # block (its insts vector, each inst's Strings) on every iteration of
        # this transitive-closure scan. This is a read-only walk (we only
        # inspect call targets), so the read must borrow, not copy (CoW
        # contract). The block-clone here was the next OOM consumer once the
        # lower_operand + drop_elab clones were removed (LirBlock__clone in
        # compute_reachable_fns, generate_c phase). Mirrors Rust DCE
        # (src/lir/optimize.rs) iterating `&func.blocks[..].insts[..]`.
        int bi = 0
        while bi < m.functions.get(cur).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(cur).unwrap().blocks.get(bi).unwrap().insts.len():
                int target_fid = -1
                String target_name = ""
                String target_orig = ""
                match m.functions.get(cur).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case ICall(_, callee_fid, _):
                        target_fid = callee_fid
                    case ICallExtern(_, callee_name, _, callee_orig, _):
                        target_name = callee_name
                        target_orig = callee_orig
                    case IClosurePack(_, _, cf, _):
                        target_fid = cf
                    case IFuncAddr(_, fa_fid):
                        # FIDELITY Phase 5, edge (ii) — `&fn` taken as a value
                        # keeps `fn` live. Mirrors Rust gg's
                        # `collect_inst_func_refs` (`src/lir/optimize.rs:358`,
                        # `Inst::FuncAddr { func } => cb(*func)`).
                        target_fid = fa_fid
                    else:
                        pass
                if target_fid >= 0 and target_fid < n:
                    if not reachable.get(target_fid).unwrap():
                        reachable.set(target_fid, true)
                        worklist.push(target_fid)
                # Look up both the post-mapping name and the original
                # GIR name — call_redirects / map_runtime_name route a
                # bare method name to the runtime form, so the LIR's
                # `name` may differ from the function-definition name
                # (Rust DCE applies the same dual-lookup; src/lir/optimize.rs).
                if target_name.len() > 0:
                    int nki = 0
                    while nki < name_keys.len():
                        String cand = name_keys.get(nki).unwrap()
                        bool is_match = cand == target_name
                        # Trait-dispatch routing: a call site `Type__method`
                        # may resolve at link time to `Trait_for_Type__method`.
                        # Self-host emits the bare form at LIR but the function
                        # is registered under the trait-prefixed form. Match
                        # any `*_for_Type__method` ending.
                        if not is_match and cand.contains("_for_") and cand.ends_with("_for_" + target_name):
                            is_match = true
                        if is_match:
                            int hit_fid = name_fids.get(nki).unwrap()
                            if not reachable.get(hit_fid).unwrap():
                                reachable.set(hit_fid, true)
                                worklist.push(hit_fid)
                        nki += 1
                if target_orig.len() > 0 and target_orig != target_name:
                    int nki2 = 0
                    while nki2 < name_keys.len():
                        String cand2 = name_keys.get(nki2).unwrap()
                        bool is_match2 = cand2 == target_orig
                        if not is_match2 and cand2.contains("_for_") and cand2.ends_with("_for_" + target_orig):
                            is_match2 = true
                        if is_match2:
                            int hit_fid2 = name_fids.get(nki2).unwrap()
                            if not reachable.get(hit_fid2).unwrap():
                                reachable.set(hit_fid2, true)
                                worklist.push(hit_fid2)
                        nki2 += 1
                ii += 1
            bi += 1

    return reachable

# ── Hashable-key bridges & dict-ctor wiring ─────────────────
#
# `Dict[UserStruct, V]` / `Set[UserStruct]` use a runtime hash-bucket
# protocol where the user's `T__hash` / `T__eq` are dispatched via
# function pointers stored on the GorgetMap struct (`hash_fn` / `eq_fn`).
# The runtime can't see them as ordinary calls, so the C backend
# generates two glue layers:
#
#   1. `static uint64_t __gorget_ktable_hash__T(const void* __kp)` and
#      `static bool __gorget_ktable_eq__T(const void*, const void*)` —
#      adapter shims with the runtime's expected ABI that internally
#      call the user's `T__hash` / `T__eq` (or the trait-prefixed
#      `Hashable_for_T__hash` / `Equatable_for_T__eq` form).
#   2. After every Dict/Set ctor call, append `dst.hash_fn = ...;`
#      `dst.eq_fn = ...;` (and `dst.key_drop = ...;` `dst.key_clone = ...;`
#      when the key type holds resource fields).
#
# Without these the runtime falls back to byte-FNV / memcmp, which is
# wrong whenever the user customised hash/eq (e.g. case-insensitive
# String key, semantic equality across pointer-equal payloads, etc.).
# Mirrors `src/backend/c_lir/mod.rs::emit_hashable_key_bridges` and the
# wiring block in `c_lir/emit_call_extern.rs`.

bool is_primitive_hashable_key(String key_ty):
    if key_ty == "int64_t" or key_ty == "int32_t" or key_ty == "int16_t" or key_ty == "int8_t":
        return true
    if key_ty == "uint64_t" or key_ty == "uint32_t" or key_ty == "uint16_t" or key_ty == "uint8_t":
        return true
    if key_ty == "double" or key_ty == "float" or key_ty == "bool":
        return true
    if key_ty == "GorgetString" or key_ty == "Str" or key_ty == "void":
        return true
    if key_ty == "T" or key_ty == "K" or key_ty == "V":
        return true
    if key_ty.contains("__"):
        return true
    return false

bool is_runtime_dict_or_set_ctor(String mapped_name):
    if mapped_name == "gorget_dict_new" or mapped_name == "gorget_dict_new_str":
        return true
    if mapped_name == "gorget_map_new" or mapped_name == "gorget_map_new_str":
        return true
    if mapped_name == "gorget_set_new" or mapped_name == "gorget_set_new_str":
        return true
    if mapped_name == "gorget_ordered_set_new" or mapped_name == "gorget_ordered_set_new_str":
        return true
    if mapped_name == "gorget_set_with_capacity":
        return true
    return false

# Extract the key type from a Dict/Set/HashMap/HashSet ctor's original
# name. Caller must have already verified `mapped_name` is a runtime
# constructor (via `is_runtime_dict_or_set_ctor`) — that gate is what
# distinguishes ctors from method calls (`Dict__K__V__put` etc.). The
# original name itself can be either bare (`Dict__K__V`) or method-
# suffixed (`Dict__K__V__new` / `Dict__K__V__with_capacity`); both are
# accepted because Gorget's surface syntax `Dict[K,V]()` lowers to the
# bare form while explicit `.new()` / `.with_capacity()` calls keep the
# suffix. Returns "" for primitive / monomorphized-scalar keys (those
# get the runtime's byte-FNV / memcmp fallback for free).
# Phase A — uses typed coll_key_type_map / coll_elem_type_map on LirModule.
String lc_coll_key_lookup(String name, LirModule &m):
    if m.coll_key_type_map.contains(name):
        return m.coll_key_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_key_type_map.contains(prefix):
                return m.coll_key_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String lc_coll_elem_lookup(String name, LirModule &m):
    if m.coll_elem_type_map.contains(name):
        return m.coll_elem_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_elem_type_map.contains(prefix):
                return m.coll_elem_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

String extract_user_hashable_key(String orig_name, LirModule &m):
    String key_ty = lc_coll_key_lookup(orig_name, &m)
    if key_ty != "":
        if is_primitive_hashable_key(key_ty):
            return ""
        return key_ty
    String elem_ty = lc_coll_elem_lookup(orig_name, &m)
    if elem_ty != "":
        if is_primitive_hashable_key(elem_ty):
            return ""
        return elem_ty
    return ""

# Resolve T__hash / T__eq fn names. Returns Vector with [hash, eq] when
# both are present in the module (either bare `T__method` form or
# trait-prefixed `Hashable_for_T__hash` / `Equatable_for_T__eq`), else
# empty.
Vector[String] hashable_key_fn_names(LirModule &m, String type_c):
    String hash_direct = type_c + "__hash"
    String eq_direct = type_c + "__eq"
    String hash_trait = "Hashable_for_" + type_c + "__hash"
    String eq_trait = "Equatable_for_" + type_c + "__eq"
    String hash_name = ""
    String eq_name = ""
    int fi = 0
    while fi < m.functions.len():
        String fname = m.functions.get(fi).unwrap().name
        if hash_name == "":
            if fname == hash_direct or fname == hash_trait:
                hash_name = fname.clone()
        if eq_name == "":
            if fname == eq_direct or fname == eq_trait:
                eq_name = fname.clone()
        if hash_name.len() > 0 and eq_name.len() > 0:
            break
        fi += 1
    Vector[String] result = []
    if hash_name.len() == 0 or eq_name.len() == 0:
        return result
    result.push(hash_name)
    result.push(eq_name)
    return result

# Walk LIR and collect every user-struct key used in a Dict/Set ctor.
Vector[String] collect_hashable_key_types(LirModule &m):
    Vector[String] keys = []
    int fi = 0
    while fi < m.functions.len():
        # Read-only scan for Dict/Set ctors — read blocks/insts through
        # BORROWS, not value-binds that deep-clone each block (its insts +
        # Strings) every iteration. Same CoW-borrow discipline as
        # compute_reachable_fns; the LirBlock clone here was the next OOM
        # consumer in generate_c once drop_elab + compute_reachable_fns were
        # fixed.
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                String mapped_name = ""
                String orig_name = ""
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case ICallExtern(_, mname, _, oname, _):
                        mapped_name = mname
                        orig_name = oname
                    else:
                        pass
                if is_runtime_dict_or_set_ctor(mapped_name) and orig_name.len() > 0:
                    String key_ty = extract_user_hashable_key(orig_name, &m)
                    if key_ty.len() > 0:
                        bool already = false
                        int hki = 0
                        while hki < keys.len():
                            if keys.get(hki).unwrap() == key_ty:
                                already = true
                                break
                            hki += 1
                        if not already:
                            keys.push(key_ty.clone())
                ii += 1
            bi += 1
        fi += 1
    return keys

# Emit the per-key static bridges. Only emits bridges for keys whose
# T__hash / T__eq are actually resolvable in the module — keys without
# a Hashable+Equatable impl get omitted (the runtime falls back to
# byte-FNV / memcmp for those, which is the only sensible default).
String emit_hashable_key_bridges(LirModule &m):
    Vector[String] keys = collect_hashable_key_types(&m)
    String out = ""
    int ki = 0
    while ki < keys.len():
        String ty = keys.get(ki).unwrap()
        Vector[String] names = hashable_key_fn_names(&m, ty)
        if names.len() == 2:
            String hn = names.get(0).unwrap()
            String en = names.get(1).unwrap()
            out = out + "static uint64_t __gorget_ktable_hash__" + ty + "(const void* __kp) { int64_t __h_state = 0; " + hn + "(__kp, &__h_state); return (uint64_t)__h_state; }\n"
            out = out + "static bool __gorget_ktable_eq__" + ty + "(const void* __a, const void* __b) { return " + en + "(__a, __b); }\n"
        ki += 1
    return out

# Emit the per-call wiring after a Dict/Set/HashMap/HashSet ctor. Both
# the post-mapped runtime name (`gorget_dict_new` etc.) and the pre-
# mapped original (`Dict__K__V`) are required: the mapped name gates
# whether this call is a constructor at all (vs. `__put` / `__contains`
# which share the `Dict__` prefix), and the original supplies the key
# type after `map_mono_to_runtime` collapsed it away.
String emit_dict_ctor_wiring(int dst, String mapped_name, String original_name, LirModule &m):
    if dst < 0 or original_name.len() == 0:
        return ""
    if not is_runtime_dict_or_set_ctor(mapped_name):
        return ""
    String key_ty = extract_user_hashable_key(original_name, &m)
    if key_ty.len() == 0:
        return ""
    Vector[String] names = hashable_key_fn_names(&m, key_ty)
    if names.len() < 2:
        return ""
    String dv = v(dst)
    String w = " " + dv + ".hash_fn = (__gorget_hash_fn)__gorget_ktable_hash__" + key_ty + ";"
    w = w + " " + dv + ".eq_fn = (__gorget_eq_fn)__gorget_ktable_eq__" + key_ty + ";"
    if m.recursive_drop_structs.contains(key_ty) or m.recursive_drop_enums.contains(key_ty):
        # A drop-name collision key type (a `Dict[T, _]` whose `T` has a
        # user `T.drop(...)` method) routes its key drop fn-ptr to the
        # mangled auto glue `__gorget_dtor_{T}`, matching the renamed
        # definition. Not exercised by current fixtures (no such Dict key),
        # but kept consistent so a future one can't mis-link to the user
        # 2-arg method. Typed `drop_collision_types` lookup.
        String key_drop_fn = key_ty + "__drop"
        if m.drop_collision_types.contains(key_ty):
            key_drop_fn = "__gorget_dtor_" + key_ty
        w = w + " " + dv + ".key_drop = (__gorget_drop_fn)" + key_drop_fn + ";"
        w = w + " " + dv + ".key_clone = (__gorget_drop_fn)" + key_ty + "__clone_inplace;"
    return w

# Look up a Dict/Map value type from its original ctor name. Mirrors
# `lc_coll_key_lookup` / `lc_coll_elem_lookup`, reading the typed
# `coll_val_type_map`. Tries the full name first, then `__`-prefixes
# (so `Dict__K__V__new` resolves via the bare `Dict__K__V` key).
String lc_coll_val_lookup(String name, LirModule &m):
    if m.coll_val_type_map.contains(name):
        return m.coll_val_type_map.get(name).unwrap_or("")
    int i = 0
    while i < name.len() - 1:
        if name.slice(i, i + 2) == "__":
            String prefix = name.slice(0, i)
            if m.coll_val_type_map.contains(prefix):
                return m.coll_val_type_map.get(prefix).unwrap_or("")
        i += 1
    return ""

# Resolve the drop fn symbol for a collection element/value type at the
# codegen layer (LirModule-only — no GirModule here). Mirrors
# `lir_lower.gg::drop_fn_for_type`, reading the typed `type_runtime_map`
# + `recursive_drop_structs/enums` already on the LirModule. Returns ""
# for trivially-droppable (primitive) elements.
String lc_collection_drop_fn(String type_name, LirModule &m):
    if type_name == "GorgetString" or type_name == "Str":
        return "gorget_string_free"
    if type_name == "GorgetArray":
        return "gorget_array_free"
    if type_name == "GorgetMap":
        return "gorget_map_free"
    if type_name == "GorgetSet":
        return "gorget_set_free"
    if type_name == "GorgetClosure":
        return "gorget_closure_free"
    String runtime = ""
    if m.type_runtime_map.contains(type_name):
        runtime = m.type_runtime_map.get(type_name).unwrap_or("")
    if runtime == "GorgetArray":
        return "gorget_array_free"
    elif runtime == "GorgetMap":
        return "gorget_map_free"
    elif runtime == "GorgetSet":
        return "gorget_set_free"
    elif runtime == "GorgetString":
        return "gorget_string_free"
    if m.recursive_drop_structs.contains(type_name) or m.recursive_drop_enums.contains(type_name):
        # Drop-name collision element type (a `Vector[T]` / `Dict[_, T]`
        # whose `T` has a user `T.drop(...)` method) routes element drops to
        # `__gorget_dtor_{T}`. Not exercised by current fixtures, but kept
        # consistent so a future collection-of-collision-type can't mis-link
        # to the user 2-arg method. Typed `drop_collision_types` lookup.
        if m.drop_collision_types.contains(type_name):
            return "__gorget_dtor_" + type_name
        return type_name + "__drop"
    return ""

# Companion to lc_collection_drop_fn: the matching in-place clone symbol.
# elem_drop and elem_clone MUST be wired as a pair — wiring drop without
# clone turns the prior leak into a clone-path double-free (a shallow-
# copied collection would drop the same element heap twice). When this
# returns "", the caller wires NEITHER, leaving the element a leak (never
# a crash) — e.g. Box/Ptr elements with no in-place clone fn.
String lc_collection_clone_fn(String type_name, LirModule &m):
    if type_name == "GorgetString" or type_name == "Str":
        return "gorget_string_clone_inplace"
    if type_name == "GorgetArray":
        return "gorget_array_clone_inplace"
    if type_name == "GorgetMap":
        return "gorget_map_clone_inplace"
    if type_name == "GorgetSet":
        return "gorget_set_clone_inplace"
    if type_name == "GorgetClosure":
        return "gorget_closure_clone_inplace"
    String runtime = ""
    if m.type_runtime_map.contains(type_name):
        runtime = m.type_runtime_map.get(type_name).unwrap_or("")
    if runtime == "GorgetArray":
        return "gorget_array_clone_inplace"
    elif runtime == "GorgetMap":
        return "gorget_map_clone_inplace"
    elif runtime == "GorgetSet":
        return "gorget_set_clone_inplace"
    elif runtime == "GorgetString":
        return "gorget_string_clone_inplace"
    if m.recursive_drop_structs.contains(type_name) or m.recursive_drop_enums.contains(type_name):
        return type_name + "__clone_inplace"
    return ""

bool is_runtime_array_ctor(String mapped_name):
    if mapped_name == "gorget_array_new":
        return true
    if mapped_name == "gorget_array_with_capacity":
        return true
    return false

# Emit per-call elem/val drop+clone fn-pointer wiring after a Vector /
# Deque / Heap (array-backed) or Dict / HashMap constructor, so the
# collection owns its resource-typed elements' drop + clone. Symmetric
# with the key wiring in `emit_dict_ctor_wiring` (which handles Dict/Set
# KEYS); this handles array ELEMENTS and dict VALUES. drop + clone are
# wired as a pair or not at all (see lc_collection_clone_fn). Closes the
# `elaborate_drops` leak: today the runtime's `if (arr->elem_drop)` guard
# sees NULL and never frees overwritten/freed resource elements — the
# ~13 GB driver.gg OOM on Vector[Vector[int]] / Vector[LirFunction]
# loop-reassignment.
String emit_collection_elem_wiring(int dst, String mapped_name, String original_name, LirModule &m):
    if dst < 0 or original_name.len() == 0:
        return ""
    String dv = v(dst)
    String w = ""
    if is_runtime_array_ctor(mapped_name):
        String elem_ty = lc_coll_elem_lookup(original_name, &m)
        if elem_ty.len() > 0:
            String df = lc_collection_drop_fn(elem_ty, &m)
            String cf = lc_collection_clone_fn(elem_ty, &m)
            if df.len() > 0 and cf.len() > 0:
                w = w + " " + dv + ".elem_drop = (__gorget_drop_fn)" + df + ";"
                w = w + " " + dv + ".elem_clone = (__gorget_drop_fn)" + cf + ";"
    if mapped_name == "gorget_map_new" or mapped_name == "gorget_map_new_str" or mapped_name == "gorget_dict_new" or mapped_name == "gorget_dict_new_str":
        String val_ty = lc_coll_val_lookup(original_name, &m)
        if val_ty.len() > 0:
            String vdf = lc_collection_drop_fn(val_ty, &m)
            String vcf = lc_collection_clone_fn(val_ty, &m)
            if vdf.len() > 0 and vcf.len() > 0:
                w = w + " " + dv + ".val_drop = (__gorget_drop_fn)" + vdf + ";"
                w = w + " " + dv + ".val_clone = (__gorget_drop_fn)" + vcf + ";"
    return w

String emit_func_forward_decls(LirModule &m, Vector[String] &sn):
    Vector[bool] reachable_fwd = compute_reachable_fns(&m)
    StrBuf buf = sb_new()
    int i = 0
    while i < m.functions.len():
        if not reachable_fwd.get(i).unwrap():
            i += 1
            continue
        if m.functions.get(i).unwrap().name == "main":
            sb_push(&buf, "int main(int argc, char** argv);\n")
            i += 1
            continue
        String ret = c_type_name(m.functions.get(i).unwrap().return_type, &sn)
        sb_push(&buf, ret)
        sb_push(&buf, " ")
        sb_push(&buf, c_func_name(m.functions.get(i).unwrap().name))
        sb_push(&buf, "(")
        if m.functions.get(i).unwrap().params.len() == 0:
            sb_push(&buf, "void")
        else:
            int pi = 0
            while pi < m.functions.get(i).unwrap().params.len():
                if pi > 0:
                    sb_push(&buf, ", ")
                int pty = m.functions.get(i).unwrap().params.get(pi).unwrap()
                String ty_str = ""
                if pty == LT_VOID:
                    ty_str = "void*"
                else:
                    ty_str = c_type_name(pty, &sn)
                # const params
                if pi < m.functions.get(i).unwrap().const_params.len():
                    bool is_const = m.functions.get(i).unwrap().const_params.get(pi).unwrap()
                    if is_const and lir_is_ptr(pty):
                        ty_str = "const " + ty_str
                sb_push(&buf, ty_str)
                sb_push(&buf, " __p")
                sb_push(&buf, int_to_str(pi))
                pi += 1
        sb_push(&buf, ");\n")
        i += 1
    sb_push(&buf, "\n")
    return buf.s

# ── Adapter functions ──────────────────────────────────────

# Collect FuncAddr targets for adapter generation.
Dict[int, bool] collect_func_addr_targets(LirModule &m):
    Dict[int, bool] targets = {}
    int fi = 0
    while fi < m.functions.len():
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case IFuncAddr(_, fid):
                        targets.put(fid, true)
                    else:
                        pass
                ii += 1
            bi += 1
        fi += 1
    return targets

String emit_adapter_functions(LirModule &m, Vector[String] &sn, Dict[int, bool] &targets):
    String out = ""
    int fi = 0
    while fi < m.functions.len():
        if not targets.contains(fi):
            fi += 1
            continue
        String ret_c = c_type_name(m.functions.get(fi).unwrap().return_type, &sn)
        String tname = c_func_name(m.functions.get(fi).unwrap().name)
        String adapt_name = "__adapt_" + tname
        out = out + ret_c + " " + adapt_name + "(void* __env"
        int pi = 0
        while pi < m.functions.get(fi).unwrap().params.len():
            int pty = m.functions.get(fi).unwrap().params.get(pi).unwrap()
            String ty_str = ""
            if pty == LT_VOID:
                ty_str = "void*"
            else:
                ty_str = c_type_name(pty, &sn)
            out = out + ", " + ty_str + " __p" + int_to_str(pi)
            pi += 1
        out = out + ") { "
        if m.functions.get(fi).unwrap().return_type != LT_VOID:
            out = out + "return "
        out = out + tname + "("
        pi = 0
        while pi < m.functions.get(fi).unwrap().params.len():
            if pi > 0:
                out = out + ", "
            out = out + "__p" + int_to_str(pi)
            pi += 1
        out = out + "); }\n"
        fi += 1
    if targets.len() > 0:
        out = out + "\n"
    return out

# ── Value type inference (simplified) ──────────────────────

# Map runtime function names to their return LIR types.
# Emit a single variant-payload argument, coercing if the arg's value type
# differs from the expected field type (e.g. Result aggregate at a scalar
# int field — lossy self-host lowering).
String emit_variant_arg(int arg_id, Vector[int] field_tys, int idx, Dict[int, int] &val_types, Vector[String] &sn, LirModule &m):
    int expected = -1
    if idx < field_tys.len():
        expected = field_tys.get(idx).unwrap()
    int arg_ty = LT_VOID
    if val_types.contains(arg_id):
        arg_ty = val_types.get(arg_id).unwrap()
    # Aggregate value at scalar field position — emit zero literal.
    if expected >= 0 and lir_is_aggregate(arg_ty) and not lir_is_aggregate(expected):
        if expected == LT_F32 or expected == LT_F64:
            return "0.0"
        return "0"
    # Ptr/void value at float field — the self-host often lowers float
    # locals as `void*` when compute_val_types can't pin down the type.
    # Cast through intptr_t so the initializer is accepted.
    bool arg_is_ptr = arg_ty == LT_PTR or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE) or arg_ty == LT_VOID
    if expected == LT_F64 and arg_is_ptr:
        return "(double)(intptr_t)" + v(arg_id)
    if expected == LT_F32 and arg_is_ptr:
        return "(float)(intptr_t)" + v(arg_id)
    # Aggregate expected, pointer arg — the self-host frequently lowers
    # the result of clone()/etc. as void* even though the value lives at
    # the pointee. Deref so the variant payload gets the actual cloned
    # String/etc., not a zero-initialised placeholder. Without this, the
    # GtNamed(name.clone()) constructor would store an empty Str — root
    # cause of the 12k+ "TABLE CORRUPT / base type ''" cascade on stage-2.
    # Restrict to LT_PTR / LT_PTR_TO_BASE — LT_VOID is too broad; it can
    # also mean "we have no info" and the value may be a scalar in
    # disguise, where dereferencing would segfault.
    bool arg_is_real_ptr = arg_ty == LT_PTR or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE)
    if expected >= 0 and lir_is_aggregate(expected) and arg_is_real_ptr:
        String exp_name_p = c_type_name(expected, &sn)
        return "*(" + exp_name_p + "*)" + v(arg_id)
    # Aggregate expected, scalar arg — cast via intptr_t then zero-init.
    if expected >= 0 and lir_is_aggregate(expected) and not lir_is_aggregate(arg_ty):
        String exp_name = c_type_name(expected, &sn)
        return "(" + exp_name + "){0}"
    return v(arg_id)

# Find a function by name in a LirModule. Returns its index, or -1.
int find_fn_by_name(LirModule &m, String name):
    int n = m.functions.len()
    int i = 0
    while i < n:
        String fname = m.functions.get(i).unwrap().name
        if fname == name:
            return i
        i = i + 1
    return -1

# Returns true if the given argument position of a runtime function is a Str
# parameter (by value). Non-Str positions (e.g. size args to str_slice) return
# false so we don't mistakenly wrap integer indices as Str.
bool runtime_arg_is_str(String name, int arg_idx):
    # Most str functions take Str at position 0.
    if arg_idx == 0:
        if name.starts_with("gorget_str_"):
            return true
        # The `gorget_str_` prefix misses `gorget_utf8_codepoint_len_at`, whose
        # arg 0 is also a `Str` (codepoint iteration over a Ptr-source coll).
        if name == "gorget_utf8_codepoint_len_at":
            return true
    # Binary: str_cat/str_eq/cmp take Str at positions 0 and 1.
    if arg_idx == 1:
        if name == "gorget_str_cat" or name == "gorget_str_concat":
            return true
        if name == "gorget_str_eq" or name == "gorget_str_ne" or name == "gorget_str_cmp":
            return true
        if name == "gorget_str_lt" or name == "gorget_str_le" or name == "gorget_str_gt" or name == "gorget_str_ge":
            return true
        if name == "gorget_str_contains" or name == "gorget_str_starts_with" or name == "gorget_str_ends_with":
            return true
        if name == "gorget_str_find" or name == "gorget_str_index_of" or name == "gorget_str_count":
            return true
        if name == "gorget_str_replace" or name == "gorget_str_removeprefix" or name == "gorget_str_removesuffix":
            return true
    if arg_idx == 2:
        if name == "gorget_str_replace":
            return true
    return false

# Returns true for runtime functions whose Str-typed parameters are declared
# by value (not Str*). Used to insert *(Str*) deref when the caller has a
# pointer-typed actual (e.g. bare String param's void* ABI).
# Returns true if the given argument position of a runtime function takes
# a C-style null-terminated `const char*`. Str args at these positions
# must be converted via gorget_str_to_cstr(&s).
# Hardcoded rule: position in the runtime signature that expects a
# pointer to an aggregate (struct). Used by emit_call_extern to wrap
# the caller's arg with `&` when the self-host lowered it by value.
bool runtime_arg_needs_addr(String name, int arg_idx):
    if name == "gorget_file_open_try" and arg_idx == 2:
        return true
    if name == "gorget_file_write_bytes_buf" and arg_idx == 1:
        return true
    if name == "gorget_file_read_bytes_buf" and arg_idx == 1:
        return true
    # File close/flush take GorgetFile* — self-host emits the file
    # value by-value, so wrap with `&` to recover the pointer.
    if name == "gorget_file_close" and arg_idx == 0:
        return true
    if name == "gorget_file_flush" and arg_idx == 0:
        return true
    # In-place String append — arg 0 is the buffer (StrBuf*) which the
    # runtime mutates. Self-host's caller often holds the local by value,
    # so wrap with `&` here.
    if name == "gorget_string_append_buf" and arg_idx == 0:
        return true
    return false

bool runtime_arg_is_cstr(String name, int arg_idx):
    if arg_idx == 0:
        if name == "gorget_read_file" or name == "gorget_read_line" or name == "gorget_read_file_bytes":
            return true
        if name == "gorget_write_file" or name == "gorget_write_file_bytes" or name == "gorget_append_file":
            return true
        if name == "gorget_file_exists" or name == "gorget_delete_file":
            return true
        if name == "gorget_getenv" or name == "gorget_setenv":
            return true
        # gorget_panic takes `const char*` (panic_normal.c:7); arg 0 = message.
        if name == "gorget_panic":
            return true
        if name == "gorget_mkdir" or name == "gorget_rmdir" or name == "gorget_remove":
            return true
        if name == "gorget_rename" or name == "gorget_copy_file":
            return true
        if name == "gorget_file_size" or name == "gorget_is_dir" or name == "gorget_readdir":
            return true
        if name == "gorget_parse_int" or name == "gorget_parse_float":
            return true
        if name == "gorget_path_join" or name == "gorget_path_parent" or name == "gorget_path_basename":
            return true
        if name == "gorget_path_extension" or name == "gorget_path_stem":
            return true
        if name == "gorget_path_normalize" or name == "gorget_path_absolute":
            return true
        if name == "gorget_exec" or name == "gorget_exec_output" or name == "gorget_process_spawn":
            return true
        if name == "gorget_input" or name == "gorget_file_open_try":
            return true
        if name == "gorget_format_time" or name == "gorget_parse_time":
            return true
        if name == "gorget_udp_bind" or name == "gorget_socket_connect":
            return true
    if arg_idx == 1:
        if name == "gorget_write_file" or name == "gorget_write_file_bytes" or name == "gorget_append_file":
            return true
        if name == "gorget_setenv":
            return true
        if name == "gorget_rename" or name == "gorget_copy_file":
            return true
        if name == "gorget_path_join":
            return true
        if name == "gorget_file_open_try" or name == "gorget_parse_time":
            return true
        # In-place String append — arg 1 is the rhs data passed as cstr+len
        # (extern "C" coerces String→cstr; the .len comes via arg 2).
        if name == "gorget_string_append_buf":
            return true
    return false

# Runtime functions whose C return type is `const char*` and whose caller-
# visible Gorget type is `Str`. The call site must wrap the result with
# `gorget_str_from_cstr(...)` to materialise a Str value. Mirrors Rust gg's
# CStr-return ABI handling (`src/lir/types.rs:823` ValueOrigin::CStr and
# `src/backend/c_lir/mod.rs:1808` SlotStore Ptr→Str wrap).
#
# Without this, self-host emits `Str __v3 = gorget_getenv(...)` — a direct
# assignment of `const char*` to a 32-byte Str struct slot, which fails
# C type-checking with `incompatible types when assigning to type 'Str'`.
bool is_cstr_returning_fn(String name):
    if name == "gorget_getenv" or name == "gorget_getcwd" or name == "gorget_platform":
        return true
    if name == "gorget_parse_last_error":
        return true
    if name == "gorget_path_join" or name == "gorget_path_parent" or name == "gorget_path_basename":
        return true
    if name == "gorget_path_extension" or name == "gorget_path_stem":
        return true
    if name == "gorget_path_normalize" or name == "gorget_path_absolute":
        return true
    if name == "gorget_input" or name == "gorget_readline":
        return true
    if name == "gorget_format_time":
        return true
    return false

bool runtime_takes_str_by_value(String name):
    if name == "gorget_str_char_at" or name == "gorget_str_byte_at":
        return true
    if name == "gorget_str_byte_len" or name == "gorget_str_byte_slice":
        return true
    # for-over-String codepoint iteration: both take `Str s` by value
    # (lir_codegen.gg:6249/6251); a Ptr-source coll needs the *(Str*) deref.
    if name == "gorget_str_codepoint_at" or name == "gorget_utf8_codepoint_len_at":
        return true
    if name == "gorget_str_cat" or name == "gorget_str_concat":
        return true
    if name == "gorget_str_eq" or name == "gorget_str_cmp":
        return true
    if name == "gorget_str_ne" or name == "gorget_str_lt" or name == "gorget_str_le":
        return true
    if name == "gorget_str_gt" or name == "gorget_str_ge":
        return true
    if name == "gorget_str_slice" or name == "gorget_str_trim":
        return true
    if name == "gorget_str_replace" or name == "gorget_str_upper" or name == "gorget_str_lower":
        return true
    if name == "gorget_str_to_upper" or name == "gorget_str_to_lower":
        return true
    if name == "gorget_str_repeat" or name == "gorget_str_join":
        return true
    if name == "gorget_str_strip" or name == "gorget_str_lstrip" or name == "gorget_str_rstrip":
        return true
    if name == "gorget_str_removeprefix" or name == "gorget_str_removesuffix":
        return true
    if name == "gorget_str_center" or name == "gorget_str_ljust" or name == "gorget_str_rjust":
        return true
    if name == "gorget_str_zfill" or name == "gorget_str_reverse":
        return true
    if name == "gorget_str_find" or name == "gorget_str_index_of" or name == "gorget_str_count":
        return true
    if name == "gorget_str_contains" or name == "gorget_str_starts_with" or name == "gorget_str_ends_with":
        return true
    if name == "gorget_str_hash" or name == "gorget_str_len" or name == "gorget_str_codepoint_count":
        return true
    if name == "gorget_str_split" or name == "gorget_str_split_n":
        return true
    if name == "gorget_str_lines" or name == "gorget_str_chars":
        return true
    if name == "gorget_str_bytes":
        return true
    return false

int runtime_fn_return_type(String name, LirModule &m):
    # Typed container allocators (`Vector[T] x = []`, `Dict[K,V] x = {}`)
    # expand at C emission to gorget_array_new(sizeof(T)) / gorget_map_new;
    # report the same return types so the caller's slot gets the right
    # ISlotStore shape.
    if name.starts_with("__gorget_array_new_sized_"):
        return find_struct_type("GorgetArray", &m)
    if name.starts_with("__gorget_dict_new_sized_"):
        return find_struct_type("GorgetMap", &m)
    if name.starts_with("__gorget_map_new_sized_"):
        return find_struct_type("GorgetMap", &m)
    # Array functions returning GorgetArray
    if name == "gorget_array_new" or name == "gorget_array_new_drop" or name == "gorget_array_with_capacity":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_clone" or name == "gorget_array_slice":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_sorted" or name == "gorget_array_reversed" or name == "gorget_array_unique":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_filter" or name == "gorget_array_map" or name == "gorget_array_zip":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_flat_map" or name == "gorget_array_flatten":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_enumerate" or name == "gorget_array_chunks":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_take" or name == "gorget_array_skip":
        return find_struct_type("GorgetArray", &m)
    # Map functions returning GorgetMap
    if name == "gorget_dict_new" or name == "gorget_map_new" or name == "gorget_dict_new_str" or name == "gorget_map_new_str":
        return find_struct_type("GorgetMap", &m)
    if name == "gorget_map_clone":
        return find_struct_type("GorgetMap", &m)
    # gorget_map_keys/values return GorgetArray (a Vector of keys/values)
    if name == "gorget_map_keys" or name == "gorget_map_values" or name == "gorget_map_items":
        return find_struct_type("GorgetArray", &m)
    # Set functions returning GorgetMap (Set is typedef to Map)
    if name == "gorget_ordered_set_new" or name == "gorget_set_new" or name == "gorget_ordered_set_new_str" or name == "gorget_set_new_str":
        return find_struct_type("GorgetSet", &m)
    if name == "gorget_set_clone":
        return find_struct_type("GorgetSet", &m)
    # String functions returning GorgetString (Str)
    if name == "gorget_str_concat" or name == "gorget_str_cat" or name == "gorget_string_from_str":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_from_cstr" or name == "gorget_string_adopt":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_string_clone_to_owned" or name == "gorget_string_copy_cow":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_slice" or name == "gorget_str_trim":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_replace" or name == "gorget_str_upper" or name == "gorget_str_lower":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_repeat" or name == "gorget_str_join":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_strip" or name == "gorget_str_lstrip" or name == "gorget_str_rstrip":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_removeprefix" or name == "gorget_str_removesuffix":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_center" or name == "gorget_str_ljust" or name == "gorget_str_rjust":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_zfill" or name == "gorget_str_reverse":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_pad_left" or name == "gorget_str_pad_right":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_string_new":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_from_literal" or name == "gorget_str_from_raw":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_string_debug" or name == "gorget_string_concat":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_string_format":
        return find_struct_type("GorgetString", &m)
    # String functions returning GorgetArray
    if name == "gorget_str_split" or name == "gorget_str_split_n":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_str_lines" or name == "gorget_str_chars":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_str_bytes":
        return find_struct_type("GorgetArray", &m)
    # Int/float to string: returns Str
    if name == "gorget_int_to_str" or name == "gorget_float_to_str" or name == "gorget_bool_to_str":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_char_to_str" or name == "gorget_uint8_to_str":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_char_chr" or name == "gorget_bytes_to_str":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_codepoint_to_utf8":
        return find_struct_type("GorgetString", &m)
    # Scalar returns
    if name == "gorget_array_len" or name == "gorget_map_len" or name == "gorget_set_len":
        return LT_I64
    # Dict for-loop iteration scalars (lower_for_dict): cap = slot capacity,
    # state = per-slot occupancy code. (key/value are void out-param writers,
    # registered in is_void_runtime_fn below.)
    if name == "gorget_map_iter_cap" or name == "gorget_map_iter_state":
        return LT_I64
    if name == "gorget_str_len" or name == "gorget_str_codepoint_count":
        return LT_I64
    if name == "gorget_str_find" or name == "gorget_str_index_of" or name == "gorget_str_count":
        return LT_I64
    if name == "gorget_str_hash" or name == "gorget_array_index_of":
        return LT_I64
    if name == "gorget_str_eq" or name == "gorget_str_ne":
        return LT_BOOL
    if name == "gorget_str_lt" or name == "gorget_str_le" or name == "gorget_str_gt" or name == "gorget_str_ge":
        return LT_BOOL
    if name == "gorget_str_cmp":
        return LT_I32
    if name == "gorget_str_contains" or name == "gorget_str_starts_with" or name == "gorget_str_ends_with":
        return LT_BOOL
    if name == "gorget_array_get" or name == "gorget_array_safe_get" or name == "gorget_map_get":
        return LT_PTR
    if name == "gorget_array_safe_last" or name == "gorget_array_safe_first" or name == "gorget_array_safe_pop":
        return LT_PTR
    if name == "gorget_map_remove" or name == "gorget_array_remove_opt":
        return LT_PTR
    if name == "gorget_array_contains" or name == "gorget_map_contains" or name == "gorget_set_contains":
        return LT_BOOL
    if name == "gorget_array_is_empty" or name == "gorget_map_is_empty":
        return LT_BOOL
    if name == "gorget_array_any" or name == "gorget_array_all":
        return LT_BOOL
    # Array reduce/fold returns I64 (generic)
    if name == "gorget_array_reduce" or name == "gorget_array_fold":
        return LT_I64
    # Parse functions
    if name == "gorget_parse_int":
        return LT_I64
    if name == "gorget_parse_float":
        return LT_F64
    # Time functions
    if name == "gorget_time_now" or name == "gorget_monotonic_ns":
        return LT_I64
    # Misc
    if name == "gorget_str_to_cstr":
        return LT_PTR
    if name == "gorget_hash_combine" or name == "gorget_hash_i64":
        return LT_I64
    if name == "gorget_array_pop":
        return LT_I64
    # Printf returns int32_t
    if name == "printf" or name == "fprintf":
        return LT_I32
    # malloc/calloc/realloc return ptr
    if name == "malloc" or name == "calloc" or name == "realloc":
        return LT_PTR
    # File/IO functions
    if name == "gorget_read_file" or name == "gorget_read_line":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_getenv":
        return find_struct_type("GorgetString", &m)
    # Process/CLI functions returning collections/strings
    if name == "gorget_args":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_env_vars":
        return find_struct_type("GorgetMap", &m)
    if name == "gorget_cwd" or name == "gorget_exe_path" or name == "gorget_hostname":
        return find_struct_type("GorgetString", &m)
    # String builder / misc Str returners
    if name == "gorget_str_to_upper" or name == "gorget_str_to_lower":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_format" or name == "gorget_str_sprintf":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_char_at":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_byte_at":
        return LT_U8
    if name == "gorget_str_codepoint" or name == "gorget_str_codepoint_at":
        return find_struct_type("GorgetString", &m)
    if name == "gorget_str_byte_slice" or name == "gorget_str_bytes_slice":
        return find_struct_type("GorgetString", &m)
    # Array transform
    if name == "gorget_array_concat":
        return find_struct_type("GorgetArray", &m)
    if name == "gorget_array_repeat":
        return find_struct_type("GorgetArray", &m)
    # User-type clone fns: `<Type>__clone(void*) -> <Type>` (returns by value).
    # Drive from typed metadata (recursive_drop_structs / recursive_drop_enums)
    # — CLAUDE.md "No name matching" exception: at the C-emit boundary the
    # NAME is the contract with the runtime, but the type registry IS the
    # source of truth for what type each `<X>__clone` returns. mirrors Rust
    # gg's call-extern type inference at src/lir/types.rs.
    if name.ends_with("__clone"):
        String type_name = name.slice(0, name.len() - 7)
        if m.recursive_drop_structs.contains(type_name) or m.recursive_drop_enums.contains(type_name):
            int sid = find_struct_type(type_name, &m)
            if sid >= 0:
                return sid
    return LT_VOID

# Known void-returning runtime functions (used to suppress assignment in emit).
bool is_void_runtime_fn(String name):
    if name == "gorget_array_push" or name == "gorget_array_set":
        return true
    if name == "gorget_array_sort" or name == "gorget_array_reverse":
        return true
    if name == "gorget_array_clear" or name == "gorget_array_free":
        return true
    if name == "gorget_array_insert" or name == "gorget_array_remove":
        return true
    if name == "gorget_array_extend":
        return true
    if name == "gorget_map_put" or name == "gorget_map_put_cloned":
        return true
    if name == "gorget_map_clear" or name == "gorget_map_free":
        return true
    # lower_for_dict key/value extraction: `void gorget_map_iter_key/value(
    # const void*, idx, void* out)` — writes through the out-param, returns
    # nothing, so suppress the dst assignment.
    if name == "gorget_map_iter_key" or name == "gorget_map_iter_value":
        return true
    if name == "gorget_set_add" or name == "gorget_set_remove":
        return true
    if name == "gorget_set_clear" or name == "gorget_set_free":
        return true
    if name == "gorget_string_free" or name == "gorget_string_materialize_inplace":
        return true
    if name == "gorget_string_clone_inplace":
        return true
    if name == "gorget_init_args" or name == "gorget_print_capture_flush":
        return true
    if name == "gorget_file_close" or name == "gorget_file_flush":
        return true
    if name == "gorget_channel_send" or name == "gorget_channel_close":
        return true
    if name == "gorget_task_group_join" or name == "gorget_task_group_free":
        return true
    if name == "gorget_shared_set" or name == "gorget_shared_free":
        return true
    if name == "gorget_mutex_lock" or name == "gorget_mutex_unlock" or name == "gorget_mutex_free":
        return true
    if name == "gorget_rwlock_read" or name == "gorget_rwlock_write" or name == "gorget_rwlock_free":
        return true
    if name == "gorget_guard_release":
        return true
    if name == "gorget_semaphore_acquire" or name == "gorget_semaphore_release":
        return true
    if name == "gorget_barrier_wait" or name == "gorget_wait_group_done":
        return true
    if name == "gorget_weak_free" or name == "gorget_channel_free":
        return true
    if name == "gorget_box_free":
        return true
    if name == "free" or name == "abort" or name == "exit":
        return true
    # Self-host emit gap closure (2026-05-10): runtime fns declared
    # `extern void Y(...)` whose Gorget-side return type is also void
    # need their dst-assignment suppressed. Without these, self-host
    # produces `__vN = gorget_write_file(...)` and C bails with
    # `void value not ignored as it ought to be`.
    if name == "gorget_write_file" or name == "gorget_write_file_bytes" or name == "gorget_append_file":
        return true
    if name == "gorget_setenv":
        return true
    if name == "gorget_exit":
        return true
    if name == "gorget_atomic_int_store" or name == "gorget_atomic_bool_store":
        return true
    if name == "gorget_atomic_int_free" or name == "gorget_atomic_bool_free":
        return true
    if name == "gorget_shared_drop" or name == "gorget_rc_drop" or name == "gorget_arc_drop":
        return true
    if name == "gorget_box_drop":
        return true
    if name.starts_with("gorget_array_each") or name.starts_with("gorget_map_each"):
        return true
    if name.ends_with("__drop") or name.ends_with("__clone_inplace"):
        return true
    # `__gorget_dtor_{T}` is the collision-renamed auto drop glue — also
    # `void`-returning, so suppress any dst-assignment at a call site.
    if name.starts_with("__gorget_dtor_"):
        return true
    return false

# Check if a call name is a struct constructor (not a runtime function).
bool is_struct_constructor(String name, LirModule &m):
    # Skip gorget_ runtime functions
    if name.starts_with("gorget_") or name.starts_with("__gorget_"):
        return false
    # Phase A — resource/collection wrapper types are in type_runtime_map;
    # they alias a runtime struct and are not user-defined struct constructors.
    if m.type_runtime_map.contains(name):
        return false
    # Non-parameterized built-in types not in type_runtime_map
    if name == "TaskGroup" or name == "printf" or name == "fprintf":
        return false
    # Check if there's a struct with this name in the module
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == name:
            return true
        i += 1
    return false

# Map a type_runtime_map category to the C sizeof type string.
# Phase A — single conversion point; no starts_with duplication.
String runtime_category_to_c_type(String runtime):
    if runtime == "GorgetArray":
        return "GorgetArray"
    elif runtime == "GorgetMap":
        return "GorgetMap"
    elif runtime == "GorgetSet":
        return "GorgetSet"
    elif runtime == "GorgetString":
        return "GorgetString"
    elif runtime == "Ptr" or runtime == "Box" or runtime == "Guard":
        return "void*"
    elif runtime == "Task":
        return "TaskHandle"
    return ""

# Resolve a Gorget type name to the C type name suitable for `sizeof(...)`.
# Used by the typed-literal allocator magic names (`__gorget_array_new_sized_T`
# / `__gorget_map_new_sized_K__GGSEP__V`). Handles the three resolution cases:
#   1. Collection aliases (Vector__* / Dict__* / etc.) → runtime struct name
#      (GorgetArray / GorgetMap / GorgetSet). These have no standalone C type —
#      they're all typedef'd to the generic runtime container.
#   2. Primitives / well-known C types (int64_t, double, bool, …) pass through.
#   3. User structs registered in m.structs → their emitted C name
#      (typically `__gg_<TypeName>`), via find_c_struct_name.
String resolve_sizeof_c_type(String tyname, LirModule &m, Vector[String] &sn):
    if tyname == "String":
        return "GorgetString"
    # Phase A — look up runtime category from type_runtime_map; convert to C type.
    # Guard contains before get: Dict.get() on missing key returns NULL in
    # self-host-compiled code (no Option wrapping) → memcpy crash.
    if m.type_runtime_map.contains(tyname):
        String runtime = m.type_runtime_map.get(tyname).unwrap_or("")
        String c_ty = runtime_category_to_c_type(runtime)
        if c_ty != "":
            return c_ty
    # Fall through to struct-registry lookup for user types and runtime aliases.
    return find_c_struct_name(tyname, &m, &sn)

String find_c_struct_name(String name, LirModule &m, Vector[String] &sn):
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == name:
            return c_type_name(LT_STRUCT_BASE + i, &sn)
        i += 1
    return name

Vector[String] get_struct_field_names(String name, LirModule &m):
    Vector[String] names = []
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == name:
            int fi = 0
            while fi < sdef.fields.len():
                StructField f = sdef.fields.get(fi).unwrap()
                names.push(f.name)
                fi += 1
            return names
        i += 1
    return names

int find_struct_type(String name, LirModule &m):
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == name:
            return LT_STRUCT_BASE + i
        i += 1
    return LT_PTR

# Infer the result type of an LIR instruction.
int infer_inst_type_with_ret(LirInst &inst, LirModule &m, Dict[int, int] &val_types, int func_ret_ty):
    match inst:
        case ISlotLoad(_, _, ty):
            return ty
        case ISlotAddr(_, _):
            return LT_PTR
        case IIConst(_, ty, _):
            return ty
        case IFConst(_, ty, _):
            return ty
        case IBoolConst(_, _):
            return LT_BOOL
        case INullPtr(_):
            return LT_PTR
        case IFuncAddr(_, _):
            return LT_PTR
        case IGlobalAddr(_, _):
            return LT_PTR
        case IStrLit(_, _):
            # StrLit produces a Str struct value. Find GorgetString struct ID.
            int si = 0
            while si < m.structs.len():
                LirStructDef sdef = m.structs.get(si).unwrap()
                if sdef.name == "GorgetString":
                    return LT_STRUCT_BASE + si
                si += 1
            return LT_PTR
        case IParamRef(_, _, ty):
            return ty
        case IAdd(_, ty, _, _, _):
            return ty
        case ISub(_, ty, _, _, _):
            return ty
        case IMul(_, ty, _, _, _):
            return ty
        case IDiv(_, ty, _, _):
            return ty
        case IRem(_, ty, _, _):
            return ty
        case IMod(_, ty, _, _):
            return ty
        case INeg(_, ty, _):
            return ty
        case IBitAnd(_, ty, _, _):
            return ty
        case IBitOr(_, ty, _, _):
            return ty
        case IBitXor(_, ty, _, _):
            return ty
        case IBitNot(_, ty, _):
            return ty
        case IShl(_, ty, _, _):
            return ty
        case IShr(_, ty, _, _):
            return ty
        case ICmp(_, _, _, _):
            return LT_BOOL
        case INot(_, _):
            return LT_BOOL
        case IIntCast(_, _, to_ty):
            return to_ty
        case IFloatCast(_, _, to_ty):
            return to_ty
        case IIntToFloat(_, _, to_ty):
            return to_ty
        case IFloatToInt(_, _, to_ty):
            return to_ty
        case IPtrCast(_, _):
            return LT_PTR
        case IBitcast(_, _, to_ty):
            return to_ty
        case ILoad(_, _, ty):
            return ty
        case IFieldPtr(_, _, _, _):
            return LT_PTR
        case IElemPtr(_, _, _, _):
            return LT_PTR
        case IBoxAlloc(_, inner_ty, _):
            # Prefer the registered Box__<inner_struct_name> so downstream
            # Some(Box(x)) resolves to Option__Box__T rather than falling
            # through to Option__GorgetString. If inner is scalar or the
            # Box struct isn't registered, fall back to a typed pointer
            # (LT_PTR_TO_BASE + inner_sid) or bare LT_PTR.
            if inner_ty >= LT_STRUCT_BASE:
                int inner_sid = inner_ty - LT_STRUCT_BASE
                if inner_sid < m.structs.len():
                    String inner_name = m.structs.get(inner_sid).unwrap().name
                    int box_sid = find_struct_type("Box__" + inner_name, &m)
                    if box_sid >= LT_STRUCT_BASE:
                        return box_sid
                return LT_PTR_TO_BASE + inner_sid
            return LT_PTR
        case IAddressOf(_, _, _):
            return LT_PTR
        case ICall(dst, fid, args):
            if dst >= 0 and fid >= 0 and fid < m.functions.len():
                # Prelude variants (Some/None/Ok/Error) / Box constructors —
                # m.functions.get(fid).unwrap().return_type is a generic placeholder. Compute the
                # actual parametrized type from the first argument's type.
                if args.len() > 0:
                    String cn = m.functions.get(fid).unwrap().name
                    if cn == "Some" or cn == "None" or cn == "Ok" or cn == "Error":
                        int arg0 = args.get(0).unwrap()
                        int arg_ty = LT_VOID
                        if val_types.contains(arg0):
                            arg_ty = val_types.get(arg0).unwrap()
                        String arg_tname = ""
                        if arg_ty >= LT_STRUCT_BASE:
                            arg_tname = m.structs.get(arg_ty - LT_STRUCT_BASE).unwrap().name
                        elif arg_ty == LT_I64:
                            arg_tname = "int64_t"
                        elif arg_ty == LT_F64:
                            arg_tname = "double"
                        elif arg_ty == LT_BOOL:
                            arg_tname = "bool"
                        elif arg_ty == LT_PTR or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE):
                            arg_tname = "GorgetString"
                        if arg_tname != "":
                            String parent_nm = ""
                            if cn == "Some" or cn == "None":
                                parent_nm = "Option__" + arg_tname
                            elif cn == "Ok":
                                parent_nm = "Result__" + arg_tname + "__GorgetString"
                            elif cn == "Error":
                                parent_nm = "Result__int64_t__" + arg_tname
                            if parent_nm != "":
                                int psid = find_struct_type(parent_nm, &m)
                                if psid >= LT_STRUCT_BASE:
                                    return psid
                return m.functions.get(fid).unwrap().return_type
            return LT_VOID
        case ICallExtern(dst, name, args_ce, _, _):
            if dst >= 0:
                # Enum variant constructor: returns parent enum struct.
                if m.enum_variant_parent.contains(name):
                    String parent = m.enum_variant_parent.get(name).unwrap()
                    int psid = find_struct_type(parent, &m)
                    if psid >= LT_STRUCT_BASE:
                        return psid
                # Qualified enum variant: EnumName__VariantName(x).
                if name.contains("__"):
                    int uix = name.index_of("__").unwrap()
                    String eparent = name.slice(0, uix)
                    String evariant = name.slice(uix + 2, name.len())
                    bool match_p = m.enum_variant_parent.contains(evariant) and m.enum_variant_parent.get(evariant).unwrap() == eparent
                    if match_p:
                        int psid_q = find_struct_type(eparent, &m)
                        if psid_q >= LT_STRUCT_BASE:
                            return psid_q
                # None() with no args: fall back to func_ret_ty if it's Option__X.
                if name == "None" and args_ce.len() == 0 and func_ret_ty >= LT_STRUCT_BASE:
                    int none_sid = func_ret_ty - LT_STRUCT_BASE
                    if none_sid < m.structs.len():
                        # Phase A — use enum_kind instead of starts_with
                        if m.structs.get(none_sid).unwrap().enum_kind == EK_OPTION:
                            return func_ret_ty
                # Prelude variants Some/None/Ok/Error — compute parametrized
                # Option/Result type from arg type.
                if (name == "Some" or name == "None" or name == "Ok" or name == "Error") and args_ce.len() > 0:
                    int arg_ce = args_ce.get(0).unwrap()
                    int arg_ty_ce = LT_VOID
                    if val_types.contains(arg_ce):
                        arg_ty_ce = val_types.get(arg_ce).unwrap()
                    String arg_tname_ce = ""
                    if arg_ty_ce >= LT_STRUCT_BASE:
                        arg_tname_ce = m.structs.get(arg_ty_ce - LT_STRUCT_BASE).unwrap().name
                    elif arg_ty_ce == LT_I64:
                        arg_tname_ce = "int64_t"
                    elif arg_ty_ce == LT_F64:
                        arg_tname_ce = "double"
                    elif arg_ty_ce == LT_BOOL:
                        arg_tname_ce = "bool"
                    elif arg_ty_ce == LT_PTR or (arg_ty_ce >= LT_PTR_TO_BASE and arg_ty_ce < LT_STRUCT_BASE):
                        arg_tname_ce = "GorgetString"
                    if arg_tname_ce != "":
                        String parent_name_ce = ""
                        if name == "Some" or name == "None":
                            parent_name_ce = "Option__" + arg_tname_ce
                        elif name == "Ok":
                            parent_name_ce = "Result__" + arg_tname_ce + "__GorgetString"
                        elif name == "Error":
                            parent_name_ce = "Result__int64_t__" + arg_tname_ce
                        if parent_name_ce != "":
                            int psid_ce = find_struct_type(parent_name_ce, &m)
                            if psid_ce >= LT_STRUCT_BASE:
                                return psid_ce
                    # Fallback: consult the enclosing function's return type.
                    # If it's Option__X / Result__X__Y, assume the variant is being returned.
                    # Phase A — use enum_kind instead of starts_with on struct names.
                    if func_ret_ty >= LT_STRUCT_BASE:
                        int frt_sid_inf = func_ret_ty - LT_STRUCT_BASE
                        if frt_sid_inf < m.structs.len():
                            int frt_ek = m.structs.get(frt_sid_inf).unwrap().enum_kind
                            if (name == "Some" or name == "None") and frt_ek == EK_OPTION:
                                return func_ret_ty
                            if (name == "Ok" or name == "Error") and frt_ek == EK_RESULT:
                                return func_ret_ty
                # Box(x) / Box__TYPE(x) — returns Box__TYPE. Prefer the
                # registered struct type so val_types carries enough info for
                # downstream Some(box_val) sites to resolve Option__Box__TYPE.
                if name == "Box" and args_ce.len() == 1:
                    int bx_arg = args_ce.get(0).unwrap()
                    int bx_arg_ty = LT_VOID
                    if val_types.contains(bx_arg):
                        bx_arg_ty = val_types.get(bx_arg).unwrap()
                    int bx_inner_sid = -1
                    if bx_arg_ty >= LT_STRUCT_BASE:
                        bx_inner_sid = bx_arg_ty - LT_STRUCT_BASE
                    elif bx_arg_ty >= LT_PTR_TO_BASE and bx_arg_ty < LT_STRUCT_BASE:
                        bx_inner_sid = bx_arg_ty - LT_PTR_TO_BASE
                    if bx_inner_sid >= 0 and bx_inner_sid < m.structs.len():
                        String arg_sname = m.structs.get(bx_inner_sid).unwrap().name
                        int bx_sid = find_struct_type("Box__" + arg_sname, &m)
                        if bx_sid >= LT_STRUCT_BASE:
                            return bx_sid
                    return LT_PTR
                if m.type_runtime_map.contains(name) and m.type_runtime_map.get(name).unwrap_or("") == "Box":
                    # Phase A — Box type detected via type_runtime_map "Box" category.
                    int box_sid = find_struct_type(name, &m)
                    if box_sid >= LT_STRUCT_BASE:
                        return box_sid
                    return LT_PTR
                # Similar for __gorget_box_alloc_TYPE — codegen rewrites
                # `Box__TYPE(x)` to this, but a direct call also may occur.
                if name.starts_with("__gorget_box_alloc_"):
                    String alloc_suffix = name.slice(19, name.len())
                    int bs2 = find_struct_type("Box__" + alloc_suffix, &m)
                    if bs2 >= LT_STRUCT_BASE:
                        return bs2
                    return LT_PTR
                # Closure construction: __make_closure_N → GorgetClosure struct type
                if name.starts_with("__make_closure_"):
                    return find_struct_type("GorgetClosure", &m)
                # Field reads: __field_read_TYPE_FIELD → look up field type
                # from struct def. Uses the longest-prefix split (same as
                # the emission sites above) to handle generic-mono'd enum
                # names like `Option__SpannedExpr_Some_0` whose plain
                # first-`_` split would pick "Option" (not registered) and
                # stamp the whole call's return type as I64 fallback.
                if name.starts_with("__field_read_"):
                    String rest = name.slice(13, name.len())
                    String struct_name = ""
                    String field = ""
                    int sid_inf = -1
                    int sep_inf = 0
                    while sep_inf < rest.byte_len():
                        if rest.byte_at(sep_inf) == 0x5F:
                            String try_struct_inf = rest.slice(0, sep_inf)
                            if sep_inf + 1 < rest.byte_len():
                                int try_sid_inf = find_struct_type(try_struct_inf, &m) - LT_STRUCT_BASE
                                if try_sid_inf >= 0 and try_sid_inf < m.structs.len():
                                    struct_name = try_struct_inf
                                    field = rest.slice(sep_inf + 1, rest.byte_len())
                                    sid_inf = try_sid_inf
                                    break
                        sep_inf += 1
                    if sid_inf >= 0:
                        LirStructDef sdef = m.structs.get(sid_inf).unwrap()
                        int fi = 0
                        while fi < sdef.fields.len():
                            StructField sf = sdef.fields.get(fi).unwrap()
                            if sf.name == field:
                                return sf.ty
                            fi += 1
                    return LT_I64
                # Builtin type casts.
                if name == "float":
                    return LT_F64
                if name == "int":
                    return LT_I64
                if name == "bool":
                    return LT_BOOL
                # Struct constructors: return the struct type.
                # Must come before extern/function lookup because constructors
                # may also appear as extern declarations with void return type.
                # Note: check name match only (not fields.len() > 0) because
                # enum variant structs like Some/Ok/Error have 0 fields.
                int si = 0
                while si < m.structs.len():
                    LirStructDef sdef = m.structs.get(si).unwrap()
                    if sdef.name == name:
                        return LT_STRUCT_BASE + si
                    si += 1
                # Check runtime function return types (both raw and
                # post-mapping — int64_t__char_at → gorget_str_char_at).
                int rt_ret = runtime_fn_return_type(name, &m)
                if rt_ret != LT_VOID:
                    return rt_ret
                String mapped_name = map_mono_to_runtime(name, &m)
                if mapped_name != name:
                    int rt_ret2 = runtime_fn_return_type(mapped_name, &m)
                    if rt_ret2 != LT_VOID:
                        return rt_ret2
                # Look up extern return type.
                int ei = 0
                while ei < m.externs.len():
                    LirExtern ext = m.externs.get(ei).unwrap()
                    if ext.name == name:
                        if ext.return_type != LT_VOID:
                            return ext.return_type
                        # Extern says void but dst >= 0: use I64 fallback.
                        return LT_I64
                    ei += 1
                # Check user functions (ICall redirected through CallExtern).
                int fi = 0
                while fi < m.functions.len():
                    if m.functions.get(fi).unwrap().name == name:
                        return m.functions.get(fi).unwrap().return_type
                    fi += 1
                # Default: I64 (matches Rust backend fallback).
                return LT_I64
            return LT_VOID
        case ICallPtr(dst, _, _):
            if dst >= 0:
                return LT_I64
            return LT_VOID
        case ICallClosure(dst2, _, _, _, _, ret_ty):
            if dst2 >= 0 and ret_ty != LT_VOID:
                return ret_ty
            if dst2 >= 0:
                return LT_I64
            return LT_VOID
        else:
            return LT_VOID

# Compute value types for all values in a function.
Dict[int, int] compute_val_types(LirFunction &func, LirModule &m):
    Dict[int, int] types = {}
    int bi = 0
    while bi < func.blocks.len():
        # Block params
        int pi = 0
        while pi < func.blocks.get(bi).unwrap().params.len():
            BlockParam bp = func.blocks.get(bi).unwrap().params.get(pi).unwrap()
            types.put(bp.value_id, bp.ty)
            pi += 1
        # Instructions — pass the function's return type so Some/Ok/Error
        # in `return VariantCtor(x)` positions can resolve the parent.
        int ii = 0
        while ii < func.blocks.get(bi).unwrap().insts.len():
            int dst = inst_dst(&func.blocks.get(bi).unwrap().insts.get(ii).unwrap())
            if dst >= 0:
                int ty = infer_inst_type_with_ret(&func.blocks.get(bi).unwrap().insts.get(ii).unwrap(), &m, &types, func.return_type)
                types.put(dst, ty)
            ii += 1
        bi += 1

    # CallExtern→SlotStore slot-type override.
    # Mirrors Rust gg's `apply_callextern_slotstore_override` in
    # `src/lir/types.rs` (layering rule 4 — resolve once, write through).
    # When an `ICallExtern` result is immediately stored into a slot whose
    # type is more specific than what `infer_inst_type_with_ret` could
    # derive from the extern name (e.g. extern is unknown so we fell
    # through to the I64 fallback, but the GIR-typed slot is a user
    # struct), prefer the slot type. The slot type comes from GIR via
    # SSA construction and is authoritative for STRUCT slots; the extern
    # name carries no type info on its own.
    apply_callextern_slotstore_override(&func, &m, &types)
    return types

# Find the GorgetString struct id (-1 if not registered).
int gorget_string_struct_id(LirModule &m):
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == "GorgetString":
            return i
        i += 1
    return -1

# Is `ty` the GorgetString struct or a Ptr-to-GorgetString? Used to
# preserve the literal-wrap convention at the ISlotStore consumer.
bool lir_ty_is_str_raw(int ty, int str_sid):
    if str_sid < 0:
        return false
    if ty == LT_STRUCT_BASE + str_sid:
        return true
    if ty == LT_PTR_TO_BASE + str_sid:
        return true
    return false

# CallExtern→SlotStore slot-type override.
# See compute_val_types comment for the rule.
#
# Self-host divergence from Rust gg: Rust overrides whenever slot_ty
# is more specific than Ptr/Void, trusting the GIR slot type as
# authoritative. The self-host's GIR can mistype some slots as I64
# when the source-level declaration was a struct (e.g. `String x =
# path.byte_slice(...)` — the byte_slice return-type inference falls
# through to I64 in the EFieldAccess-as-method path, var_type
# inherits the wrong I64). Forcing val_types[d] = I64 in that case
# would override the call's correct Str return inference, producing
# `int64_t __vN = gorget_str_byte_slice(...)` which cc rejects.
#
# Compromise: only override when the slot type is an AGGREGATE
# (struct). Aggregate slot types are reliable signals — the only
# way a slot ends up typed `__gg_Foo` is via a SVarDecl/parameter
# where the user explicitly named the struct, OR where the GIR
# correctly inferred a struct constructor return. Scalar slots may
# be wrong, so leave val_types intact and let the existing
# ISlotStore scalar-slot-receiving-aggregate-value path emit a
# zero-init fallback (pre-existing behaviour preserved).
void apply_callextern_slotstore_override(LirFunction &func, LirModule &m, Dict[int, int] &types):
    int str_sid = gorget_string_struct_id(&m)
    int bi = 0
    while bi < func.blocks.len():
        int ii = 0
        while ii + 1 < func.blocks.get(bi).unwrap().insts.len():
            LirInst next = func.blocks.get(bi).unwrap().insts.get(ii + 1).unwrap()
            match func.blocks.get(bi).unwrap().insts.get(ii).unwrap():
                case ICallExtern(d, _, _, _, _):
                    if d >= 0:
                        match next:
                            case ISlotStore(slot, value, _):
                                if value == d:
                                    int raw_slot_ty = func.slots.get(slot).unwrap().ty
                                    if lir_is_aggregate(raw_slot_ty):
                                        int current = LT_VOID
                                        if types.contains(d):
                                            current = types.get(d).unwrap()
                                        bool is_ptr_to_str = (current == LT_PTR) and lir_ty_is_str_raw(raw_slot_ty, str_sid)
                                        if not is_ptr_to_str and current != raw_slot_ty:
                                            types.put(d, raw_slot_ty)
                            else:
                                pass
                else:
                    pass
            ii += 1
        bi += 1

# Extract the destination value ID from an instruction (-1 if none).
int inst_dst(LirInst &inst):
    match inst:
        case ISlotStore(_, _, _):
            return -1
        case ISlotLoad(dst, _, _):
            return dst
        case ISlotAddr(dst, _):
            return dst
        case IIConst(dst, _, _):
            return dst
        case IFConst(dst, _, _):
            return dst
        case IBoolConst(dst, _):
            return dst
        case INullPtr(dst):
            return dst
        case IFuncAddr(dst, _):
            return dst
        case IGlobalAddr(dst, _):
            return dst
        case IStrLit(dst, _):
            return dst
        case IParamRef(dst, _, _):
            return dst
        case IAdd(dst, _, _, _, _):
            return dst
        case ISub(dst, _, _, _, _):
            return dst
        case IMul(dst, _, _, _, _):
            return dst
        case IDiv(dst, _, _, _):
            return dst
        case IRem(dst, _, _, _):
            return dst
        case IMod(dst, _, _, _):
            return dst
        case INeg(dst, _, _):
            return dst
        case IBitAnd(dst, _, _, _):
            return dst
        case IBitOr(dst, _, _, _):
            return dst
        case IBitXor(dst, _, _, _):
            return dst
        case IBitNot(dst, _, _):
            return dst
        case IShl(dst, _, _, _):
            return dst
        case IShr(dst, _, _, _):
            return dst
        case ICmp(dst, _, _, _):
            return dst
        case INot(dst, _):
            return dst
        case IIntCast(dst, _, _):
            return dst
        case IFloatCast(dst, _, _):
            return dst
        case IIntToFloat(dst, _, _):
            return dst
        case IFloatToInt(dst, _, _):
            return dst
        case IPtrCast(dst, _):
            return dst
        case IBitcast(dst, _, _):
            return dst
        case ILoad(dst, _, _):
            return dst
        case IFieldPtr(dst, _, _, _):
            return dst
        case IElemPtr(dst, _, _, _):
            return dst
        case ICall(dst, _, _):
            return dst
        case ICallExtern(dst, _, _, _, _):
            return dst
        case ICallPtr(dst, _, _):
            return dst
        case IMemset(_, _, _):
            return -1
        case IMemcpy(_, _, _):
            return -1
        case IStore(_, _):
            return -1
        case IBoxAlloc(dst, _, _):
            return dst
        case IAddressOf(dst, _, _):
            return dst
        case IStructInit(_, _, _):
            return -1
        case IEnumInit(_, _, _, _):
            return -1
        case IBoundsCheck(_, _):
            return -1
        case IDivCheck(_):
            return -1
        case ITrap(_):
            return -1
        case IPrintf(_, _):
            return -1
        case IFprintf(_, _, _):
            return -1
        case IInlineC(dst, _):
            return dst
        case IClosurePack(_, _, _, _):
            return -1
        case ICallClosure(dst, _, _, _, _, _):
            return dst
        case IDropGuardOpen(_, _):
            return -1
        case IDropGuardClose:
            return -1
        case IMoveSlot(_):
            return -1
        case INop:
            return -1

# ── Instruction emission ───────────────────────────────────

String v(int id): "__v" + int_to_str(id)
String s(int id): "__s" + int_to_str(id)

# Build the C lvalue expression for `base->field` given a struct id and
# field index. Mirrors IFieldPtr's address-of logic but returns the lvalue
# itself (no `&`), so composable into stores.
String field_access_lvalue(String base, int struct_id, int field, LirModule &m, Vector[String] &sn):
    if struct_id >= 0 and struct_id < m.structs.len():
        LirStructDef sdef = m.structs.get(struct_id).unwrap()
        String sname = c_type_name(LT_STRUCT_BASE + struct_id, &sn)
        if field < sdef.fields.len():
            StructField f = sdef.fields.get(field).unwrap()
            String fname = c_field_name(f.name)
            if sdef.is_union_layout and field > 0:
                String vprefix = field_variant_prefix(f.name)
                int vcount = 0
                int fi = 1
                while fi < sdef.fields.len():
                    StructField sf = sdef.fields.get(fi).unwrap()
                    if field_variant_prefix(sf.name) == vprefix:
                        vcount += 1
                    fi += 1
                if vcount > 1:
                    return "((" + sname + " *)(" + base + "))->data." + c_field_name(vprefix) + "." + fname
                return "((" + sname + " *)(" + base + "))->data." + fname
            return "((" + sname + " *)(" + base + "))->" + fname
    return "*((void**)((char*)(" + base + ") + " + int_to_str(field) + " * sizeof(void*)))"

# Emit a single field store: `lvalue = value;` or memcpy for aggregates.
# Used by IStructInit / IEnumInit expansion.
String emit_field_store(String target_v, int struct_id, int field, int value, LirModule &m, Vector[String] &sn, Dict[int, int] &val_types):
    String lval = field_access_lvalue(target_v, struct_id, field, &m, &sn)
    int vty = LT_VOID
    if val_types.contains(value):
        vty = val_types.get(value).unwrap()
    int field_ty = LT_I64
    if struct_id >= 0 and struct_id < m.structs.len():
        LirStructDef sdef = m.structs.get(struct_id).unwrap()
        if field < sdef.fields.len():
            field_ty = sdef.fields.get(field).unwrap().ty
    # Struct-typed field with an aggregate value → memcpy from &__vN.
    if lir_is_aggregate(field_ty) and lir_is_aggregate(vty):
        String ft_name = c_type_name(field_ty, &sn)
        return "memcpy(&" + lval + ", &" + v(value) + ", sizeof(" + ft_name + "));"
    # Struct-typed field with a pointer value → memcpy from the pointee.
    # This is the `SpannedToken(!tok, …)` case: tok is passed by pointer
    # at the C ABI but the struct's .lex_token field IS the Token struct.
    if lir_is_aggregate(field_ty) and (vty == LT_PTR or (vty >= LT_PTR_TO_BASE and vty < LT_STRUCT_BASE)):
        String ft_name = c_type_name(field_ty, &sn)
        return "memcpy(&" + lval + ", " + v(value) + ", sizeof(" + ft_name + "));"
    # Struct-typed field receiving a non-ptr-non-aggregate value — the value
    # is either a scalar placeholder (usually `(int32_t)0` for None / Unit)
    # or came through a `void*` slot whose type was lost. Neither case has a
    # real aggregate in memory to memcpy from: `memcpy(&field, 0/void*, …)`
    # crashes with NULL-deref. Emit inline zero / None-tag init instead.
    #
    # Option fields: emit `{.tag = 1}` (None tag); other aggregate
    # fields: zero-init. Catches stage-1's parse_if_stmt crash at
    # `ElseBranch(None, body)` where the None value flows through a
    # void* slot and arrives at emit_field_store as either LT_VOID (type
    # lost) or a scalar literal.
    bool vty_is_ptr = vty == LT_PTR or (vty >= LT_PTR_TO_BASE and vty < LT_STRUCT_BASE)
    if lir_is_aggregate(field_ty) and not lir_is_aggregate(vty) and not vty_is_ptr:
        String ft_name = c_type_name(field_ty, &sn)
        int field_sid_ms = field_ty - LT_STRUCT_BASE
        if field_sid_ms >= 0 and field_sid_ms < m.structs.len():
            LirStructDef field_sdef_ms = m.structs.get(field_sid_ms).unwrap()
            if field_sdef_ms.enum_kind == EK_OPTION:
                return lval + " = (" + ft_name + "){.tag = 1};"
        return lval + " = (" + ft_name + "){0};"
    # Struct-typed field with unknown value type — treat value as pointer
    # since by-pointer is the ABI convention for aggregate args; falls
    # back to memcpy-from-pointee. Matches rust's output.
    if lir_is_aggregate(field_ty):
        String ft_name = c_type_name(field_ty, &sn)
        return "memcpy(&" + lval + ", " + v(value) + ", sizeof(" + ft_name + "));"
    # Aggregate value but scalar/ptr field (rare — usually means the
    # self-host lost type info). Write zeros to keep cc happy.
    if lir_is_aggregate(vty):
        return "memcpy(&" + lval + ", &" + v(value) + ", sizeof(" + v(value) + "));"
    if lir_is_scalar(field_ty):
        String ft_name = c_type_name(field_ty, &sn)
        return lval + " = (" + ft_name + ")" + v(value) + ";"
    if field_ty == LT_PTR or (field_ty >= LT_PTR_TO_BASE and field_ty < LT_STRUCT_BASE):
        return lval + " = (void*)" + v(value) + ";"
    return lval + " = " + v(value) + ";"

String emit_inst(LirInst &inst, LirModule &m, LirFunction &func, Vector[String] &sn,
                 Dict[int, int] &val_types, Dict[String, int] &slit_map):
    match inst:
        # ── Slot access ──
        case ISlotStore(slot, value, is_move):
            # Skip store to slot 0 (return slot) in void-returning functions.
            if slot == 0 and func.return_type == LT_VOID:
                return "/* void store */;"
            int slot_ty = func.slots.get(slot).unwrap().ty
            int vty = LT_VOID
            if val_types.contains(value):
                vty = val_types.get(value).unwrap()
            if lir_is_aggregate(slot_ty):
                if vty == LT_PTR or (vty >= LT_PTR_TO_BASE and vty < LT_STRUCT_BASE):
                    String ty_name = c_type_name(slot_ty, &sn)
                    return "memcpy(&" + s(slot) + ", " + v(value) + ", sizeof(" + ty_name + "));"
                # Type mismatch coercion for aggregate slots. When the value
                # type differs from the slot type (either a scalar placeholder
                # or an aggregate that doesn't match), emit a zero-init —
                # EXCEPT for Option slots: `return None` lowers to a UNIT
                # placeholder value, lands here, and a plain `{0}` sets
                # `tag = 0` (Some — wrong!). None's tag is 1; emit that
                # explicitly so `keyword_from_str("main")`'s fallthrough
                # returns None instead of `Some(KwInt)`.
                if vty != slot_ty:
                    String ty_name = c_type_name(slot_ty, &sn)
                    int slot_sid_ms = slot_ty - LT_STRUCT_BASE
                    if slot_sid_ms >= 0 and slot_sid_ms < m.structs.len():
                        LirStructDef slot_sdef_ms = m.structs.get(slot_sid_ms).unwrap()
                        if slot_sdef_ms.enum_kind == EK_OPTION:
                            return s(slot) + " = (" + ty_name + "){.tag = 1};"
                    return s(slot) + " = (" + ty_name + "){0};"
                return s(slot) + " = " + v(value) + ";"
            # Box value (typedef void*) into a pointer slot: a Box is
            # pointer-represented even though its LIR type-id classifies as
            # aggregate (>= LT_STRUCT_BASE). This is a plain pointer copy, NOT
            # the lost-type give-up below — without this guard the IBoxAlloc
            # result (`Box__T`-typed) stored into the box-result `LT_PTR` slot
            # NULLed the box (parse_dot_expr's `EFieldAccess(Box(lhs), ...)`
            # crash). Mirrors the driver's SSA, which keeps the box value live
            # in a register and never round-trips it through a typed slot.
            if (slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)) and lir_type_is_box(vty, &m):
                return s(slot) + " = " + v(value) + ";"
            # Pointer slot (void* / Ptr) receiving an aggregate value — self-host
            # lost track of slot type (multi-branch SVarDecl took the first init
            # type and later branches store different types). Take the aggregate's
            # address so the pointer slot gets SOMETHING compatible; semantics
            # are undefined in this case but the compile succeeds.
            if (slot_ty == LT_PTR or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)) and lir_is_aggregate(vty):
                return s(slot) + " = NULL;"
            # Scalar slot (I64/I32/etc.) receiving an aggregate value — same
            # cause. Discard the aggregate, assign zero.
            if not lir_is_aggregate(slot_ty) and lir_is_aggregate(vty):
                return s(slot) + " = 0;"
            # Non-pointer scalar slot (I64/I32/bool/F64/…) receiving a
            # pointer value. The self-host's `infer_method_return_type`
            # flattens `.get()/.first()/.last()/.pop()` on
            # `Vector[scalar]` to return the element type directly (no
            # Option wrapper), but at LIR the call still goes through
            # `gorget_array_safe_get` et al. which return `void*` — a
            # pointer TO the element. A plain `slot = ptr` stores the
            # pointer address as the scalar value, which then gets
            # consumed downstream as if it were the element (the `bb =
            # &block_map[i]` bug that crashed stage-1 in lower_operand).
            # Dereference as the slot's scalar type so the scalar value
            # flows correctly. Excludes LT_PTR / LT_PTR_TO_BASE slots —
            # those are genuine pointer slots that should receive the
            # pointer value, not deref it.
            bool slot_is_ptr_kind = (slot_ty == LT_PTR) or (slot_ty >= LT_PTR_TO_BASE and slot_ty < LT_STRUCT_BASE)
            if lir_is_scalar(slot_ty) and not slot_is_ptr_kind and (vty == LT_PTR or (vty >= LT_PTR_TO_BASE and vty < LT_STRUCT_BASE)):
                String st_name = c_type_name(slot_ty, &sn)
                return s(slot) + " = *((" + st_name + "*)" + v(value) + ");"
            return s(slot) + " = " + v(value) + ";"

        case ISlotLoad(dst, slot, _):
            return v(dst) + " = " + s(slot) + ";"

        case ISlotAddr(dst, slot):
            return v(dst) + " = &" + s(slot) + ";"

        # ── Constants ──
        case IIConst(dst, ty, value):
            return v(dst) + " = (" + c_type_name(ty, &sn) + ")" + int_to_str(value) + "LL;"

        case IFConst(dst, ty, bits):
            # Float from bits — simplified: use direct value for common cases.
            return v(dst) + " = (" + c_type_name(ty, &sn) + ")0.0; memcpy(&" + v(dst) + ", &(int64_t){" + int_to_str(bits) + "LL}, sizeof(double));"

        case IBoolConst(dst, value):
            if value:
                return v(dst) + " = true;"
            return v(dst) + " = false;"

        case INullPtr(dst):
            return v(dst) + " = NULL;"

        case IFuncAddr(dst, fid):
            if fid >= 0 and fid < m.functions.len():
                String adapt = "__adapt_" + c_func_name(m.functions.get(fid).unwrap().name)
                return "{ static void* __fa_" + int_to_str(dst) + "[] = { (void*)" + adapt + ", NULL }; " + v(dst) + " = (void*)__fa_" + int_to_str(dst) + "; }"
            return v(dst) + " = NULL;"

        case IGlobalAddr(dst, gid):
            return v(dst) + " = &__lir_g" + int_to_str(gid) + ";"

        case IStrLit(dst, value):
            if slit_map.contains(value):
                int idx = slit_map.get(value).unwrap()
                return v(dst) + " = __slit_" + int_to_str(idx) + ";"
            String escaped = escape_c_string(value)
            return v(dst) + " = \"" + escaped + "\";"

        case IParamRef(dst, index, _):
            return v(dst) + " = __p" + int_to_str(index) + ";"

        # ── Arithmetic ──
        case IAdd(dst, ty, lhs, rhs, overflow):
            if overflow == OVF_TRAP and lir_is_integer(ty):
                String ct = c_type_name(ty, &sn)
                return "if (__builtin_add_overflow((" + ct + ")" + v(lhs) + ", (" + ct + ")" + v(rhs) + ", &" + v(dst) + ")) { fprintf(stderr, \"gorget: integer overflow\\n\"); exit(1); }"
            String ct = c_type_name(ty, &sn)
            return v(dst) + " = (" + ct + ")" + v(lhs) + " + (" + ct + ")" + v(rhs) + ";"

        case ISub(dst, ty, lhs, rhs, overflow):
            if overflow == OVF_TRAP and lir_is_integer(ty):
                String ct = c_type_name(ty, &sn)
                return "if (__builtin_sub_overflow((" + ct + ")" + v(lhs) + ", (" + ct + ")" + v(rhs) + ", &" + v(dst) + ")) { fprintf(stderr, \"gorget: integer overflow\\n\"); exit(1); }"
            String ct = c_type_name(ty, &sn)
            return v(dst) + " = (" + ct + ")" + v(lhs) + " - (" + ct + ")" + v(rhs) + ";"

        case IMul(dst, ty, lhs, rhs, overflow):
            if overflow == OVF_TRAP and lir_is_integer(ty):
                String ct = c_type_name(ty, &sn)
                return "if (__builtin_mul_overflow((" + ct + ")" + v(lhs) + ", (" + ct + ")" + v(rhs) + ", &" + v(dst) + ")) { fprintf(stderr, \"gorget: integer overflow\\n\"); exit(1); }"
            String ct = c_type_name(ty, &sn)
            return v(dst) + " = (" + ct + ")" + v(lhs) + " * (" + ct + ")" + v(rhs) + ";"

        case IDiv(dst, ty, lhs, rhs):
            if lir_is_integer(ty):
                String ct = c_type_name(ty, &sn)
                return "if ((" + ct + ")" + v(rhs) + " == 0) { fprintf(stderr, \"gorget: division by zero\\n\"); exit(1); } " + v(dst) + " = (" + ct + ")" + v(lhs) + " / (" + ct + ")" + v(rhs) + ";"
            return v(dst) + " = " + v(lhs) + " / " + v(rhs) + ";"

        case IRem(dst, ty, lhs, rhs):
            if lir_is_float(ty):
                return v(dst) + " = fmod(" + v(lhs) + ", " + v(rhs) + ");"
            String ct = c_type_name(ty, &sn)
            return v(dst) + " = (" + ct + ")" + v(lhs) + " % (" + ct + ")" + v(rhs) + ";"

        case IMod(dst, ty, lhs, rhs):
            if lir_is_float(ty):
                return "{ double __t = fmod(" + v(lhs) + ", " + v(rhs) + "); " + v(dst) + " = __t + (__t != 0.0 && ((__t < 0) != (" + v(rhs) + " < 0)) ? " + v(rhs) + " : 0.0); }"
            return "{ typeof(" + v(lhs) + ") __t = " + v(lhs) + " % " + v(rhs) + "; " + v(dst) + " = __t + (__t != 0 && (__t ^ " + v(rhs) + ") < 0 ? " + v(rhs) + " : 0); }"

        case INeg(dst, ty, operand):
            # Float negation must NOT route through the int64_t cast below —
            # that truncates the mantissa (`-1.5` → `-1`). Emit a plain
            # `-operand` for float types.
            if lir_is_float(ty):
                return v(dst) + " = -" + v(operand) + ";"
            # Cast the operand to int64_t: self-host type inference may
            # declare the operand as void* when it's actually an integer
            # carried through phi/merge points. The cast is a no-op for
            # proper int declarations.
            return v(dst) + " = -(int64_t)(intptr_t)" + v(operand) + ";"

        # ── Bitwise ──
        case IBitAnd(dst, _, lhs, rhs):
            return v(dst) + " = " + v(lhs) + " & " + v(rhs) + ";"

        case IBitOr(dst, _, lhs, rhs):
            return v(dst) + " = " + v(lhs) + " | " + v(rhs) + ";"

        case IBitXor(dst, _, lhs, rhs):
            return v(dst) + " = " + v(lhs) + " ^ " + v(rhs) + ";"

        case IBitNot(dst, _, operand):
            return v(dst) + " = ~" + v(operand) + ";"

        case IShl(dst, _, lhs, rhs):
            return v(dst) + " = " + v(lhs) + " << " + v(rhs) + ";"

        case IShr(dst, _, lhs, rhs):
            return v(dst) + " = " + v(lhs) + " >> " + v(rhs) + ";"

        # ── Comparison & Logic ──
        case ICmp(dst, op, lhs, rhs):
            # Defensive: if either operand is Str (aggregate), use gorget_str_eq/cmp.
            # The LIR lowerer should have lowered this to a CallExtern but the self-host
            # lowerer sometimes doesn't.
            int lty = LT_VOID
            int rty = LT_VOID
            if val_types.contains(lhs):
                lty = val_types.get(lhs).unwrap()
            if val_types.contains(rhs):
                rty = val_types.get(rhs).unwrap()
            int gs_sid = find_struct_type("GorgetString", &m)
            bool lhs_str = (lty == gs_sid)
            bool rhs_str = (rty == gs_sid)
            if lhs_str or rhs_str:
                # Coerce the other side based on its type:
                # - Str value: use as-is
                # - Pointer (void*, Str*): deref
                # - Scalar placeholder (self-host lost type info): substitute
                #   an empty Str so the compare is at least type-correct.
                String lstr = v(lhs)
                String rstr = v(rhs)
                if not lhs_str:
                    if lty == LT_PTR or (lty >= LT_PTR_TO_BASE and lty < LT_STRUCT_BASE):
                        lstr = "*(Str*)" + lstr
                    else:
                        lstr = "((Str){0})"
                if not rhs_str:
                    if rty == LT_PTR or (rty >= LT_PTR_TO_BASE and rty < LT_STRUCT_BASE):
                        rstr = "*(Str*)" + rstr
                    else:
                        rstr = "((Str){0})"
                # Aggregate comparison — use gorget_str_eq/cmp for known Str types.
                if op == CMP_EQ:
                    return v(dst) + " = gorget_str_eq(" + lstr + ", " + rstr + ");"
                elif op == CMP_NE:
                    return v(dst) + " = !gorget_str_eq(" + lstr + ", " + rstr + ");"
                elif op == CMP_LT:
                    return v(dst) + " = gorget_str_cmp(" + lstr + ", " + rstr + ") < 0;"
                elif op == CMP_LE:
                    return v(dst) + " = gorget_str_cmp(" + lstr + ", " + rstr + ") <= 0;"
                elif op == CMP_GT:
                    return v(dst) + " = gorget_str_cmp(" + lstr + ", " + rstr + ") > 0;"
                elif op == CMP_GE:
                    return v(dst) + " = gorget_str_cmp(" + lstr + ", " + rstr + ") >= 0;"
            # Non-string aggregate comparison — fall back to memcmp for ==/!=.
            # Other comparisons on aggregates are rare and unlikely to be correct.
            if lir_is_aggregate(lty) and lir_is_aggregate(rty) and lty == rty:
                String ty_name = c_type_name(lty, &sn)
                if op == CMP_EQ:
                    return v(dst) + " = memcmp(&" + v(lhs) + ", &" + v(rhs) + ", sizeof(" + ty_name + ")) == 0;"
                elif op == CMP_NE:
                    return v(dst) + " = memcmp(&" + v(lhs) + ", &" + v(rhs) + ", sizeof(" + ty_name + ")) != 0;"
            String cop = cmp_op_str(op)
            return v(dst) + " = " + v(lhs) + " " + cop + " " + v(rhs) + ";"

        case INot(dst, operand):
            return v(dst) + " = !" + v(operand) + ";"

        # ── Type conversions ──
        case IIntCast(dst, value, to_ty):
            return v(dst) + " = (" + c_type_name(to_ty, &sn) + ")(" + v(value) + ");"

        case IFloatCast(dst, value, to_ty):
            return v(dst) + " = (" + c_type_name(to_ty, &sn) + ")(" + v(value) + ");"

        case IIntToFloat(dst, value, to_ty):
            return v(dst) + " = (" + c_type_name(to_ty, &sn) + ")(" + v(value) + ");"

        case IFloatToInt(dst, value, to_ty):
            return v(dst) + " = (" + c_type_name(to_ty, &sn) + ")(" + v(value) + ");"

        case IPtrCast(dst, value):
            return v(dst) + " = (void*)(" + v(value) + ");"

        case IBitcast(dst, value, to_ty):
            return "memcpy(&" + v(dst) + ", &" + v(value) + ", sizeof(" + c_type_name(to_ty, &sn) + "));"

        # ── Memory ──
        case ILoad(dst, ptr, ty):
            return v(dst) + " = *(" + c_type_name(ty, &sn) + " *)(" + v(ptr) + ");"

        case IStore(ptr, value):
            int vty = -1
            if val_types.contains(value):
                vty = val_types.get(value).unwrap()
            if lir_is_aggregate(vty):
                return "memcpy(" + v(ptr) + ", &" + v(value) + ", sizeof(" + v(value) + "));"
            elif lir_is_scalar(vty):
                String ty_name = c_type_name(vty, &sn)
                return "*(" + ty_name + "*)(" + v(ptr) + ") = " + v(value) + ";"
            elif vty == LT_PTR:
                return "*(void**)(" + v(ptr) + ") = " + v(value) + ";"
            return "*(void**)(" + v(ptr) + ") = " + v(value) + ";"

        # Canonical box-alloc: heap-allocate sizeof(inner_ty), store value there.
        # Expands to the same scalar/aggregate dispatch IStore uses, with the
        # allocation + store fused into one statement. When `value` is already
        # a pointer (LT_PTR / LT_PTR_TO_BASE) — e.g. the SSA value holding a
        # consumed `!SpannedExpr` parameter threaded through block params —
        # use the pointer directly instead of its stack address.
        case IBoxAlloc(dst, inner_ty, value):
            String ty_name = c_type_name(inner_ty, &sn)
            int ba_vty = LT_VOID
            if val_types.contains(value):
                ba_vty = val_types.get(value).unwrap()
            bool ba_value_is_ptr = ba_vty == LT_PTR or (ba_vty >= LT_PTR_TO_BASE and ba_vty < LT_STRUCT_BASE)
            if lir_is_aggregate(inner_ty):
                if ba_value_is_ptr:
                    return v(dst) + " = GORGET_ALLOC(sizeof(" + ty_name + ")); memcpy(" + v(dst) + ", " + v(value) + ", sizeof(" + ty_name + "));"
                return v(dst) + " = GORGET_ALLOC(sizeof(" + ty_name + ")); memcpy(" + v(dst) + ", &" + v(value) + ", sizeof(" + ty_name + "));"
            return v(dst) + " = GORGET_ALLOC(sizeof(" + ty_name + ")); *(" + ty_name + "*)(" + v(dst) + ") = (" + ty_name + ")" + v(value) + ";"

        # Canonical address-of: copy value into the function-scope __at<dst>
        # temp declared in the prologue, then take its address. Same
        # pointer-aware twist as IBoxAlloc when the SSA value is already a
        # pointer.
        case IAddressOf(dst, value, ty):
            String at_name = "__at" + int_to_str(dst)
            String ty_name = c_type_name(ty, &sn)
            int ao_vty = LT_VOID
            if val_types.contains(value):
                ao_vty = val_types.get(value).unwrap()
            bool ao_value_is_ptr = ao_vty == LT_PTR or (ao_vty >= LT_PTR_TO_BASE and ao_vty < LT_STRUCT_BASE)
            if lir_is_aggregate(ty):
                if ao_value_is_ptr:
                    return "memcpy(&" + at_name + ", " + v(value) + ", sizeof(" + ty_name + ")); " + v(dst) + " = &" + at_name + ";"
                return "memcpy(&" + at_name + ", &" + v(value) + ", sizeof(" + ty_name + ")); " + v(dst) + " = &" + at_name + ";"
            return at_name + " = (" + ty_name + ")" + v(value) + "; " + v(dst) + " = &" + at_name + ";"

        # Canonical struct-init: write each (field_idx, value) into *target.
        # No dst; emits one field store per entry. Unlisted fields untouched.
        case IStructInit(target, struct_id, fields):
            String target_v = v(target)
            String out = ""
            int fi = 0
            while fi < fields.len():
                FieldInit finit = fields.get(fi).unwrap()
                if fi > 0:
                    out = out + " "
                out = out + emit_field_store(target_v, struct_id, finit.index, finit.value, &m, &sn, &val_types)
                fi += 1
            if out == "":
                out = "/* empty struct init */;"
            return out

        # Canonical enum-init: write tag at field 0, then each payload field.
        case IEnumInit(target, struct_id, variant_tag, fields):
            String target_v = v(target)
            String tag_lval = field_access_lvalue(target_v, struct_id, 0, &m, &sn)
            String out = tag_lval + " = (int32_t)" + int_to_str(variant_tag) + ";"
            int fi = 0
            while fi < fields.len():
                FieldInit finit = fields.get(fi).unwrap()
                out = out + " " + emit_field_store(target_v, struct_id, finit.index, finit.value, &m, &sn, &val_types)
                fi += 1
            return out

        case IFieldPtr(dst, base, struct_id, field):
            if struct_id >= 0 and struct_id < m.structs.len():
                LirStructDef sdef = m.structs.get(struct_id).unwrap()
                String sname = c_type_name(LT_STRUCT_BASE + struct_id, &sn)
                if field < sdef.fields.len():
                    StructField f = sdef.fields.get(field).unwrap()
                    String fname = c_field_name(f.name)
                    if sdef.is_union_layout and field > 0:
                        # Enum union layout: access through data.field_name
                        String vprefix = field_variant_prefix(f.name)
                        # Count fields in this variant
                        int vcount = 0
                        int fi = 1
                        while fi < sdef.fields.len():
                            StructField sf = sdef.fields.get(fi).unwrap()
                            if field_variant_prefix(sf.name) == vprefix:
                                vcount += 1
                            fi += 1
                        if vcount > 1:
                            return v(dst) + " = (void*)&((" + sname + " *)(" + v(base) + "))->data." + c_field_name(vprefix) + "." + fname + ";"
                        return v(dst) + " = (void*)&((" + sname + " *)(" + v(base) + "))->data." + fname + ";"
                    return v(dst) + " = (void*)&((" + sname + " *)(" + v(base) + "))->" + fname + ";"
                # Out of bounds — byte offset fallback.
                return v(dst) + " = (void*)((char*)(" + v(base) + ") + " + int_to_str(field) + " * sizeof(void*));"
            return v(dst) + " = (void*)((char*)(" + v(base) + ") + " + int_to_str(field) + " * sizeof(void*));"

        case IElemPtr(dst, base, index, elem_size):
            return v(dst) + " = (void*)((char*)(" + v(base) + ") + (int64_t)(" + v(index) + ") * " + int_to_str(elem_size) + ");"

        case IMemset(ptr, byte, size):
            return "memset(" + v(ptr) + ", (int)" + v(byte) + ", (size_t)" + v(size) + ");"

        case IMemcpy(dst_ptr, src_ptr, size):
            return "memcpy(" + v(dst_ptr) + ", " + v(src_ptr) + ", (size_t)" + v(size) + ");"

        # ── Calls ──
        case ICall(dst, fid, args):
            if fid >= 0 and fid < m.functions.len():
                # If this is actually an enum variant constructor, route
                # through emit_call_extern which handles inline struct init.
                if m.enum_variant_parent.contains(m.functions.get(fid).unwrap().name):
                    return emit_call_extern_with(dst, m.functions.get(fid).unwrap().name, &args, &sn, &val_types, &m, func.return_type)
                # Box(x) / Box__TYPE(x) also routes through emit_call_extern.
                # Phase A — Box type detected via type_runtime_map "Box" category.
                bool is_box_callee = m.functions.get(fid).unwrap().name == "Box"
                if not is_box_callee and m.type_runtime_map.contains(m.functions.get(fid).unwrap().name):
                    if m.type_runtime_map.get(m.functions.get(fid).unwrap().name).unwrap_or("") == "Box":
                        is_box_callee = true
                if is_box_callee:
                    return emit_call_extern_with(dst, m.functions.get(fid).unwrap().name, &args, &sn, &val_types, &m, func.return_type)
                # Prelude Option/Result variant constructors — pulled from
                # user-code even if unrecognized in type_infos. The codegen
                # uses dst type to resolve parametrization.
                if m.functions.get(fid).unwrap().name == "Some" or m.functions.get(fid).unwrap().name == "None" or m.functions.get(fid).unwrap().name == "Ok" or m.functions.get(fid).unwrap().name == "Error":
                    return emit_call_extern_with(dst, m.functions.get(fid).unwrap().name, &args, &sn, &val_types, &m, func.return_type)
                String fname = c_func_name(m.functions.get(fid).unwrap().name)
                int gs_ty = find_struct_type("GorgetString", &m)
                String out = ""
                if dst >= 0 and m.functions.get(fid).unwrap().return_type != LT_VOID:
                    out = v(dst) + " = "
                out = out + fname + "("
                int ai = 0
                while ai < args.len():
                    if ai > 0:
                        out = out + ", "
                    int arg_id = args.get(ai).unwrap()
                    int arg_ty = LT_VOID
                    if val_types.contains(arg_id):
                        arg_ty = val_types.get(arg_id).unwrap()
                    bool is_ptr = (arg_ty == LT_PTR) or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE)
                    # Scalar/ptr-to-aggregate coercion: self-host often loses
                    # type info and passes I64 placeholders or void* to
                    # aggregate-typed params. Emit cast so C compile succeeds.
                    if ai < m.functions.get(fid).unwrap().params.len():
                        int pty = m.functions.get(fid).unwrap().params.get(ai).unwrap()
                        if lir_is_aggregate(pty) and not lir_is_aggregate(arg_ty):
                            String pty_name = c_type_name(pty, &sn)
                            if is_ptr:
                                out = out + "*(" + pty_name + "*)" + v(arg_id)
                            else:
                                out = out + "(" + pty_name + "){0}"
                            ai += 1
                            continue
                        # Scalar param, pointer arg — deref the pointer. This
                        # is the `Vector[scalar].get(i).unwrap()` path: the
                        # runtime safe_get returns void* to the element, and
                        # self-host's unwrap is a passthrough. Without this
                        # deref, int params receive pointer-sized values.
                        bool pty_is_scalar = not lir_is_aggregate(pty) and pty != LT_PTR and (pty < LT_PTR_TO_BASE or pty >= LT_STRUCT_BASE) and pty != LT_VOID
                        if pty_is_scalar and is_ptr:
                            String pty_name_s = c_type_name(pty, &sn)
                            out = out + "*(" + pty_name_s + "*)" + v(arg_id)
                            ai += 1
                            continue
                    out = out + v(arg_id)
                    ai += 1
                out = out + ");"
                return out
            return "/* unknown call */;"

        case ICallExtern(dst, name, args, original_name, arg_abis):
            String ce_call = emit_call_extern_with(dst, name, &args, &sn, &val_types, &m, func.return_type)
            # Append per-call ctor wiring for `Dict[UserStruct, V]` /
            # `Set[UserStruct]` so user hash/eq are dispatched via the
            # bridge fn pointers rather than byte-FNV / memcmp. The
            # mapped `name` gates ctor-vs-method; `original_name` carries
            # the unmangled key type.
            String ce_wiring = emit_dict_ctor_wiring(dst, name, original_name, &m)
            # Vector/array element + Dict value drop+clone fn-ptr wiring
            # (closes the elaborate_drops collection-element leak).
            String ce_elem_wiring = emit_collection_elem_wiring(dst, name, original_name, &m)
            return ce_call + ce_wiring + ce_elem_wiring

        case ICallPtr(dst, callee, args):
            String out = ""
            if dst >= 0:
                out = v(dst) + " = "
            out = out + "((void*(*)(void*"
            int ai = 0
            while ai < args.len():
                if ai > 0:
                    out = out + ", void*"
                ai += 1
            out = out + "))(" + v(callee) + "))("
            ai = 0
            while ai < args.len():
                if ai > 0:
                    out = out + ", "
                out = out + "(void*)" + v(args.get(ai).unwrap())
                ai += 1
            out = out + ");"
            return out

        # ── Runtime checks ──
        case IBoundsCheck(index, len):
            return "if ((uint64_t)" + v(index) + " >= (uint64_t)" + v(len) + ") { fprintf(stderr, \"index out of bounds\\n\"); abort(); }"

        case IDivCheck(divisor):
            return "if (" + v(divisor) + " == 0) { fprintf(stderr, \"division by zero\\n\"); abort(); }"

        case ITrap(msg):
            return "fprintf(stderr, \"" + escape_c_string(msg) + "\"); abort();"

        # ── Printf ──
        case IPrintf(fmt, args):
            String out = "printf(\"" + escape_c_string(fmt) + "\""
            int ai = 0
            while ai < args.len():
                out = out + ", " + v(args.get(ai).unwrap())
                ai += 1
            return out + ");"

        case IFprintf(fd, fmt, args):
            String out = "fprintf((FILE*)" + v(fd) + ", \"" + escape_c_string(fmt) + "\""
            int ai = 0
            while ai < args.len():
                out = out + ", " + v(args.get(ai).unwrap())
                ai += 1
            return out + ");"

        # ── Inline C ──
        case IInlineC(dst, code):
            if dst >= 0:
                # Parse "_X = expr;" → "__vN = expr;"
                int eq_pos = find_substr(code, " = ")
                if eq_pos >= 0:
                    String expr = code.slice(eq_pos + 3, code.len())
                    if expr.ends_with(";"):
                        expr = expr.slice(0, expr.len() - 1)
                    return v(dst) + " = " + expr + ";"
                return "/* inline_c: " + code + " */;"
            return code

        case IClosurePack(slot, env_ptr, call_func, needs_adapter):
            String raw_name = m.functions.get(call_func).unwrap().name
            String fn_name = raw_name
            if needs_adapter:
                fn_name = "__adapt_" + raw_name
            return s(slot) + " = (GorgetClosure){.fn_ptr = (void*)" + fn_name + ", .env = (void*)" + v(env_ptr) + "};"

        case ICallClosure(dst2, kind, closure, cl_args, cl_abis, ret_ty):
            # Closure dispatch: fn_ptr(env, args...)
            String cv = v(closure)
            String fp = ""
            String ep = ""
            if kind == 0:
                # CallableParam: void*[2]
                fp = "((void**)" + cv + ")[0]"
                ep = "((void**)" + cv + ")[1]"
            else:
                # EscapedClosure: GorgetClosure struct
                fp = "((GorgetClosure*)" + cv + ")->fn_ptr"
                ep = "((GorgetClosure*)" + cv + ")->env"
            String out = ""
            if dst2 >= 0:
                out = v(dst2) + " = "
            out = out + "((" + "void*" + "(*)(void*"
            int ai = 0
            while ai < cl_args.len():
                out = out + ", void*"
                ai = ai + 1
            out = out + "))(" + fp + "))(" + ep
            ai = 0
            while ai < cl_args.len():
                out = out + ", " + v(cl_args.get(ai).unwrap())
                ai = ai + 1
            out = out + ");"
            return out

        case IDropGuardOpen(kind, value):
            if kind == 0:
                # Bool guard
                return "{ if (" + v(value) + ") {"
            else:
                # NonZero guard: kind-1 = byte size
                int byte_size = kind - 1
                return "{ char __dia_z[" + int_to_str(byte_size) + "] = {0}; if (memcmp(" + v(value) + ", __dia_z, " + int_to_str(byte_size) + ") != 0) {"

        case IDropGuardClose:
            return "} }"

        case IMoveSlot(_):
            return "/* move_slot */;"

        case INop:
            return "/* nop */;"

# ── CallExtern emission (simplified) ──────────────────────

# Map monomorphized Vector/Dict/Set method names to runtime function names.
# e.g. int64_t__push → gorget_array_push, GorgetString__len → gorget_array_len
# Only maps names that look like scalar_type__method patterns.
String map_mono_to_runtime(String name, LirModule &m):
    # Skip known non-Vector prefixes (struct constructors, closures, etc.)
    if name.starts_with("__gorget_") or name.starts_with("gorget_"):
        return name
    if name.starts_with("__Closure_") or name.starts_with("__adapt_"):
        return name
    # Check for T__method pattern where T is a scalar or collection element type
    int uscore = find_substr(name, "__")
    if uscore <= 0:
        return name
    String prefix = name.slice(0, uscore)
    String method = name.slice(uscore + 2, name.len())
    # Only map if prefix is a scalar type name, not a struct/enum name
    bool is_scalar_prefix = false
    if prefix == "int64_t" or prefix == "int32_t" or prefix == "int16_t" or prefix == "int8_t":
        is_scalar_prefix = true
    if prefix == "uint8_t" or prefix == "uint16_t" or prefix == "uint32_t" or prefix == "uint64_t":
        is_scalar_prefix = true
    if prefix == "double" or prefix == "float" or prefix == "bool":
        is_scalar_prefix = true
    if prefix == "GorgetString" or prefix == "Str":
        is_scalar_prefix = true
    if not is_scalar_prefix:
        return name
    # Check for double underscores in method (skip things like Channel__int64_t__close)
    if find_substr(method, "__") >= 0:
        return name
    # Map known Vector methods — conservative subset that matches arg counts.
    # The self-host LIR lowerer (lir_lower.gg) handles Vector__T__method mapping.
    # This codegen fallback catches cases where scalar-prefix names
    # (e.g. int64_t__push from GIR) slip through unhandled by the lowerer.
    if method == "push" or method == "len" or method == "pop":
        return "gorget_array_" + method
    if method == "is_empty" or method == "clear" or method == "free":
        return "gorget_array_" + method
    if method == "sort" or method == "reverse":
        return "gorget_array_" + method
    if method == "clone":
        return "gorget_array_clone"
    # String method fallbacks: when self-host lost the recv type and emitted
    # int64_t__byte_at etc., remap to gorget_str_* so linkage succeeds.
    # These don't preserve correct semantics (recv value is a placeholder),
    # but allow the binary to link.
    if prefix == "int64_t":
        if method == "byte_at" or method == "byte_len" or method == "byte_slice":
            return "gorget_str_" + method
        if method == "char_at" or method == "codepoint_count" or method == "slice":
            return "gorget_str_" + method
        if method == "starts_with" or method == "ends_with" or method == "contains":
            return "gorget_str_" + method
        if method == "trim" or method == "strip" or method == "split" or method == "lines":
            return "gorget_str_" + method
        if method == "replace" or method == "upper" or method == "lower":
            return "gorget_str_" + method
        if method == "find" or method == "index_of" or method == "count":
            return "gorget_str_" + method
        # Char predicate methods on byte.
        if method == "is_alpha" or method == "is_digit" or method == "is_alphanumeric":
            return "gorget_uint8_" + method
        if method == "is_hex_digit" or method == "is_space" or method == "is_upper" or method == "is_lower":
            return "gorget_uint8_" + method
        if method == "to_upper" or method == "to_lower":
            return "gorget_uint8_" + method
    return name

# ── Option/Result combinator inline expansion ──────────────
#
# Option layout: { int32_t tag; T Some_0; }  — tag==0 is Some, tag==1 is None
# Result layout: { int32_t tag; T Ok_0; E Error_0; }  — tag==0 is Ok, tag==1 is Error
#
# All combinators take a pointer to the Option/Result as first arg.
# HOF combinators (map, filter, and_then, or_else) take a closure ptr as second arg.

String emit_option_result_combinator(int dst, String name, Vector[int] &args,
                                      Vector[String] &sn, Dict[int, int] &val_types, LirModule &m):
    if args.len() == 0:
        return "/* bad option/result combinator */;"
    int src_id = args.get(0).unwrap()
    String src = v(src_id)
    # Combinators treat src as a pointer (`*(int32_t*)src` etc). If the caller
    # has an aggregate value, we must take its address first.
    int src_ty = LT_VOID
    if val_types.contains(src_id):
        src_ty = val_types.get(src_id).unwrap()
    if lir_is_aggregate(src_ty):
        src = "(&" + src + ")"

    # ── Tag checks: is_some, is_none, is_ok, is_error ──
    match name:
        case "__option_is_some" | "__result_is_ok":
            if dst >= 0:
                return v(dst) + " = (*(int32_t*)" + src + ") == 0;"
            return ";"
        case "__option_is_none" | "__result_is_error" | "__result_is_err":
            if dst >= 0:
                return v(dst) + " = (*(int32_t*)" + src + ") != 0;"
            return ";"
        else:
            pass

    # ── unwrap / expect: return payload (no tag check — panics at runtime if wrong) ──
    match name:
        case "__option_unwrap" | "__option_expect":
            if dst >= 0:
                # Payload is at offset sizeof(int32_t), aligned to 8.
                # Use generic memcpy from offset 8 (covers all payload types).
                return "memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + "));"
            return ";"
        case "__result_unwrap_error":
            if dst >= 0:
                # Error payload is the 3rd field. For simplicity, at offset 8 for tag=1.
                # This is approximate — works for simple scalar payloads.
                return "memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + "));"
            return ";"
        case "__result_expect":
            if dst >= 0:
                return "memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + "));"
            return ";"
        else:
            pass

    # ── HOF combinators: map, filter, and_then, or_else, or ──
    # All take (src_ptr, closure_ptr) and return the Option/Result by value.
    # The closure is dispatched via the void*[2] {fn_ptr, env} protocol.
    if args.len() < 2 and (name == "__option_map" or name == "__option_filter" or name == "__option_and_then" or name == "__option_or_else" or name == "__result_map" or name == "__result_and_then" or name == "__result_or_else" or name == "__result_map_err"):
        # No closure arg — skip
        if dst >= 0:
            return "memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); /* no closure */;"
        return ";"

    String closure = ""
    if args.len() > 1:
        closure = v(args.get(1).unwrap())

    match name:
        case "__option_map":
            # if tag==0: result = {0, fn(payload)}; else: result = {1}
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { *(int32_t*)&" + v(dst) + " = 0; void* __payload = (char*)" + src + " + 8; void* __mapped = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy((char*)&" + v(dst) + " + 8, &__mapped, sizeof(__mapped)); } else { memset(&" + v(dst) + ", 0, sizeof(" + v(dst) + ")); *(int32_t*)&" + v(dst) + " = 1; } }"
            return ";"
        case "__option_filter":
            # if tag==0 && predicate(payload): keep; else: None
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { void* __payload = (char*)" + src + " + 8; bool __keep = (bool)(int64_t)((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); if (__keep) { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } else { memset(&" + v(dst) + ", 0, sizeof(" + v(dst) + ")); *(int32_t*)&" + v(dst) + " = 1; } } else { memset(&" + v(dst) + ", 0, sizeof(" + v(dst) + ")); *(int32_t*)&" + v(dst) + " = 1; } }"
            return ";"
        case "__option_and_then":
            # if tag==0: result = fn(payload) (fn returns Option); else: None
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { void* __payload = (char*)" + src + " + 8; void* __res = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy(&" + v(dst) + ", &__res, sizeof(" + v(dst) + ")); } else { memset(&" + v(dst) + ", 0, sizeof(" + v(dst) + ")); *(int32_t*)&" + v(dst) + " = 1; } }"
            return ";"
        case "__option_or_else" | "__option_or":
            # if tag!=0: result = fn() or alt; else: keep
            if dst >= 0:
                if name == "__option_or" and args.len() > 1:
                    # __option_or(src, alt) — alt is a pointer to the alternative
                    String alt = v(args.get(1).unwrap())
                    return "{ if ((*(int32_t*)" + src + ") != 0) { memcpy(&" + v(dst) + ", " + alt + ", sizeof(" + v(dst) + ")); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
                return "{ if ((*(int32_t*)" + src + ") != 0) { void* __res = ((void*(*)(void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1]); memcpy(&" + v(dst) + ", &__res, sizeof(" + v(dst) + ")); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__option_flatten":
            # Unwrap nested Option: if tag==0, return inner Option; else None
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + ")); } else { memset(&" + v(dst) + ", 0, sizeof(" + v(dst) + ")); *(int32_t*)&" + v(dst) + " = 1; } }"
            return ";"
        case "__option_unwrap_or_else":
            # if tag==0: return payload; else: return fn()
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + ")); } else { " + v(dst) + " = (int64_t)((void*(*)(void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1]); } }"
            return ";"
        case "__result_map":
            # Same as option_map but for Result (tag==0 is Ok)
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { *(int32_t*)&" + v(dst) + " = 0; void* __payload = (char*)" + src + " + 8; void* __mapped = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy((char*)&" + v(dst) + " + 8, &__mapped, sizeof(__mapped)); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__result_map_err":
            # if tag!=0: result = {1, fn(error_payload)}; else: keep
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") != 0) { *(int32_t*)&" + v(dst) + " = 1; void* __payload = (char*)" + src + " + 8; void* __mapped = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy((char*)&" + v(dst) + " + 8, &__mapped, sizeof(__mapped)); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__result_and_then":
            # if tag==0: result = fn(ok_payload) (fn returns Result); else: keep error
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { void* __payload = (char*)" + src + " + 8; void* __res = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy(&" + v(dst) + ", &__res, sizeof(" + v(dst) + ")); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__result_or_else":
            # if tag!=0: result = fn(error_payload) (fn returns Result); else: keep ok
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") != 0) { void* __payload = (char*)" + src + " + 8; void* __res = ((void*(*)(void*, void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1], *((void**)__payload)); memcpy(&" + v(dst) + ", &__res, sizeof(" + v(dst) + ")); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__result_or":
            if dst >= 0 and args.len() > 1:
                String alt = v(args.get(1).unwrap())
                return "{ if ((*(int32_t*)" + src + ") != 0) { memcpy(&" + v(dst) + ", &" + alt + ", sizeof(" + v(dst) + ")); } else { memcpy(&" + v(dst) + ", " + src + ", sizeof(" + v(dst) + ")); } }"
            return ";"
        case "__result_unwrap_or_else":
            if dst >= 0:
                return "{ if ((*(int32_t*)" + src + ") == 0) { memcpy(&" + v(dst) + ", (char*)" + src + " + 8, sizeof(" + v(dst) + ")); } else { " + v(dst) + " = (int64_t)((void*(*)(void*))((void**)" + closure + ")[0])(((void**)" + closure + ")[1]); } }"
            return ";"
        else:
            pass

    # Fallback: unknown combinator, emit as regular call (will link-fail)
    return name + "(" + src + "); /* unknown combinator */"

String emit_call_extern_with(int dst, String raw_name, Vector[int] &args,
                             Vector[String] &sn, Dict[int, int] &val_types, LirModule &m,
                             int func_ret_ty):
    # Map monomorphized names to runtime names.
    String name = map_mono_to_runtime(raw_name, &m)

    # No-arg strip dispatch: .strip()/.lstrip()/.rstrip() (self-only, args.len()==1)
    # route to the whitespace-trim runtime variants. The 1-arg .strip(chars) form
    # (args.len()==2: self + chars) keeps gorget_str_strip etc. Mirrors Rust
    # emit_call_extern.rs:157-163.
    if args.len() == 1:
        if name == "gorget_str_strip":
            name = "gorget_str_trim"
        if name == "gorget_str_lstrip":
            name = "gorget_str_lstrip_ws"
        if name == "gorget_str_rstrip":
            name = "gorget_str_rstrip_ws"

    # Closure call dispatch.
    if name.starts_with("__gorget_closure_call_"):
        if args.len() > 0:
            int closure_val = args.get(0).unwrap()
            String cc_out = ""
            if dst >= 0:
                cc_out = v(dst) + " = "
            # Cast: ret_type(*)(void*, args...) applied to closure's fn_ptr
            cc_out = cc_out + "((void*(*)(void*"
            int ai = 1
            while ai < args.len():
                cc_out = cc_out + ", void*"
                ai += 1
            cc_out = cc_out + "))(" + v(closure_val) + ".fn_ptr))(" + v(closure_val) + ".env"
            ai = 1
            while ai < args.len():
                cc_out = cc_out + ", " + v(args.get(ai).unwrap())
                ai += 1
            return cc_out + ");"
        return "/* bad closure call */;"

    # Callable dispatch.
    if name.starts_with("__callable_"):
        if args.len() > 0:
            int closure_val = args.get(0).unwrap()
            String cb_out = ""
            if dst >= 0:
                cb_out = v(dst) + " = "
            cb_out = cb_out + "((void*(*)(void*"
            int ai = 1
            while ai < args.len():
                cb_out = cb_out + ", void*"
                ai += 1
            cb_out = cb_out + "))((void**)" + v(closure_val) + ")[0])(((void**)" + v(closure_val) + ")[1]"
            ai = 1
            while ai < args.len():
                cb_out = cb_out + ", " + v(args.get(ai).unwrap())
                ai += 1
            return cb_out + ");"
        return "/* bad callable */;"

    # ── Option/Result combinator inline expansion ──
    # These pseudo-functions operate on pointers to Option/Result structs.
    # Tag is int32_t at offset 0. Tag==0 means Some/Ok, tag!=0 means None/Error.
    # Payload follows at offset 4+ (accessed via struct field names).
    if name.starts_with("__option_") or name.starts_with("__result_"):
        return emit_option_result_combinator(dst, name, &args, &sn, &val_types, &m)

    # ── Closure construction: __make_closure_N() → (GorgetClosure){fn, NULL} ──
    if name.starts_with("__make_closure_"):
        if dst >= 0:
            String cid_str = name.slice(15, name.len())
            String call_fn = "__Closure_" + cid_str + "__call"
            # Use __call directly — its signature (void* self, ...) is compatible
            # with the callable dispatch protocol (fn_ptr(env, args...)).
            return v(dst) + " = (GorgetClosure){.fn_ptr = (void*)" + call_fn + ", .env = NULL};"
        return ";"

    # ── Field write: __field_write_TYPE_FIELD(base, value) ──
    # Paired with __field_read_. Expands to `((T*)base)->field = value;`
    # with scalar/aggregate/pointer dispatch matching emit_field_store.
    if name.starts_with("__field_write_"):
        if args.len() >= 2:
            int base_val = args.get(0).unwrap()
            int val_arg = args.get(1).unwrap()
            String rest_w = name.slice(14, name.len())
            # Find the longest-prefix split that matches a registered
            # struct (same fix as __field_read_ above — plain first-`_`
            # split miscompiles `__field_write_Option__Keyword_tag` into
            # `((Option*)base)->_Keyword_tag` which breaks type lookup).
            String struct_name_w = ""
            String field_w = ""
            int sid_w = -1
            int sep_iw = 0
            while sep_iw < rest_w.byte_len():
                if rest_w.byte_at(sep_iw) == 0x5F:
                    String try_struct_w = rest_w.slice(0, sep_iw)
                    if sep_iw + 1 < rest_w.byte_len():
                        int try_sid_w = find_struct_type(try_struct_w, &m) - LT_STRUCT_BASE
                        if try_sid_w >= 0 and try_sid_w < m.structs.len():
                            struct_name_w = try_struct_w
                            field_w = rest_w.slice(sep_iw + 1, rest_w.byte_len())
                            sid_w = try_sid_w
                            break
                sep_iw += 1
            if struct_name_w == "":
                # Fallback: first-underscore split.
                int sep_w = find_substr(rest_w, "_")
                if sep_w > 0:
                    struct_name_w = rest_w.slice(0, sep_w)
                    field_w = rest_w.slice(sep_w + 1, rest_w.len())
                    sid_w = find_struct_type(struct_name_w, &m) - LT_STRUCT_BASE
            if struct_name_w != "":
                String c_struct_w = find_c_struct_name(struct_name_w, &m, &sn)
                String c_field_w = c_field_name(field_w)
                String lval_w = "((" + c_struct_w + "*)" + v(base_val) + ")->" + c_field_w
                int val_ty_w = LT_VOID
                if val_types.contains(val_arg):
                    val_ty_w = val_types.get(val_arg).unwrap()
                # Look up field type to pick the right store shape.
                int field_ty_w = LT_I64
                if sid_w >= 0 and sid_w < m.structs.len():
                    LirStructDef sdef_w = m.structs.get(sid_w).unwrap()
                    int fi_w = 0
                    while fi_w < sdef_w.fields.len():
                        StructField sf_w = sdef_w.fields.get(fi_w).unwrap()
                        if c_field_name(sf_w.name) == c_field_w:
                            field_ty_w = sf_w.ty
                        fi_w += 1
                # Aggregate field + aggregate value → memcpy from &value.
                if lir_is_aggregate(field_ty_w) and lir_is_aggregate(val_ty_w):
                    return "memcpy(&" + lval_w + ", &" + v(val_arg) + ", sizeof(" + v(val_arg) + "));"
                # Aggregate field + pointer value → memcpy from *value.
                if lir_is_aggregate(field_ty_w) and (val_ty_w == LT_PTR or (val_ty_w >= LT_PTR_TO_BASE and val_ty_w < LT_STRUCT_BASE)):
                    String ft_name_w = c_type_name(field_ty_w, &sn)
                    return "memcpy(&" + lval_w + ", " + v(val_arg) + ", sizeof(" + ft_name_w + "));"
                # Aggregate field + unknown value → assume pointer (ABI
                # convention for aggregate args) and memcpy from pointee.
                if lir_is_aggregate(field_ty_w):
                    String ft_name_w = c_type_name(field_ty_w, &sn)
                    return "memcpy(&" + lval_w + ", " + v(val_arg) + ", sizeof(" + ft_name_w + "));"
                # Scalar/ptr field: direct assignment with cast.
                if val_ty_w == LT_PTR or (val_ty_w >= LT_PTR_TO_BASE and val_ty_w < LT_STRUCT_BASE):
                    return lval_w + " = (void*)" + v(val_arg) + ";"
                return lval_w + " = " + v(val_arg) + ";"
        return "/* bad field write */;"

    # ── Field read: __field_read_TYPE_FIELD(base, field_index) ──
    # Route through field_access_lvalue so union-layout enum payloads
    # get the `.data.<vprefix>.<fname>` dereference rather than a raw
    # `->Field` that misses the union. Find the struct's field index
    # by name so the helper can pick the right access shape.
    if name.starts_with("__field_read_"):
        if dst >= 0 and args.len() >= 2:
            int base_val = args.get(0).unwrap()
            String rest = name.slice(13, name.len())
            # Scan every `_` position from left to right. The first one
            # where the prefix resolves to a registered struct wins.
            # Plain-first-`_` split failed for generic-mono'd enums like
            # `Option__Keyword` because the `__` gap gave struct="Option"
            # (not registered) and field="_Keyword_tag" (garbage),
            # silently falling through to the raw-arrow fallback that
            # emitted `((Option*)base)->_Keyword_tag` — the C compiler
            # couldn't find `struct Option`, stage-1's tag read returned
            # zero, and every Option match dispatched to Some.
            String struct_name = ""
            String field = ""
            int split_sid = -1
            int sep_i = 0
            while sep_i < rest.byte_len():
                if rest.byte_at(sep_i) == 0x5F:
                    String try_struct = rest.slice(0, sep_i)
                    if sep_i + 1 < rest.byte_len():
                        int try_sid = find_struct_type(try_struct, &m) - LT_STRUCT_BASE
                        if try_sid >= 0 and try_sid < m.structs.len():
                            struct_name = try_struct
                            field = rest.slice(sep_i + 1, rest.byte_len())
                            split_sid = try_sid
                            break
                sep_i += 1
            if split_sid >= 0:
                LirStructDef sdef = m.structs.get(split_sid).unwrap()
                int fi = 0
                int found = -1
                while fi < sdef.fields.len():
                    StructField sf = sdef.fields.get(fi).unwrap()
                    if c_field_name(sf.name) == c_field_name(field):
                        found = fi
                    fi += 1
                if found >= 0:
                    String lval = field_access_lvalue(v(base_val), split_sid, found, &m, &sn)
                    return v(dst) + " = " + lval + ";"
                # Struct found but field name doesn't match — raw arrow.
                String c_struct = find_c_struct_name(struct_name, &m, &sn)
                String c_field = c_field_name(field)
                return v(dst) + " = ((" + c_struct + "*)" + v(base_val) + ")->" + c_field + ";"
            # No matching struct — best-effort first-underscore split
            # for the raw-arrow fallback (not ideal but matches the
            # legacy behaviour for non-generic structs).
            int sep = find_substr(rest, "_")
            if sep > 0:
                String fallback_struct = rest.slice(0, sep)
                String fallback_field = rest.slice(sep + 1, rest.len())
                String c_struct = find_c_struct_name(fallback_struct, &m, &sn)
                String c_field = c_field_name(fallback_field)
                return v(dst) + " = ((" + c_struct + "*)" + v(base_val) + ")->" + c_field + ";"
        return "/* bad field read */;"

    # ── Typed container allocators for literals (`Vector[T] x = []`, `Dict[K,V] x = {}`) ──
    # The GIR lowerer emits these magic names when it has an element-type
    # hint from the declaring SVarDecl. They expand to a runtime allocator
    # call with `sizeof(T)` drawn from the C type system — the only way
    # for the size to track aggregate layouts (e.g. 128 bytes for
    # LirStructDef). Without this pipe, every aggregate Vector defaulted
    # to elem_size=8 and pushes silently corrupted adjacent slots; stage-1
    # crashed on the very first memcpy past index 0.
    if name.starts_with("__gorget_array_new_sized_"):
        if dst >= 0:
            String arr_tyname = name.slice(25, name.len())
            String arr_c_tname = resolve_sizeof_c_type(arr_tyname, &m, &sn)
            String sized_out = v(dst) + " = gorget_array_new(sizeof(" + arr_c_tname + "));"
            # Wire element drop+clone ONLY when the element is itself a NESTED
            # COLLECTION (Vector/Dict/Set whose runtime is GorgetArray/Map/Set).
            # Typed-literal allocations (`Vector[Vector[int]] x = []`) lower to
            # this magic `__gorget_array_new_sized_T` name and otherwise leave
            # `elem_drop = NULL` — so a `.set()` that displaces an inner Vector,
            # and the outer Vector's own drop, LEAK the inner buffer. In
            # drop_elab's forward-dataflow worklist (re-sets `Vector[Vector
            # [int]]` state per fixpoint re-visit across ~600 functions) this
            # leaked to ~14 GB → OOM.
            #
            # SCOPE: nested-collection elements ONLY. We deliberately do NOT
            # wire String / user-struct elements here: the self-host lacks the
            # Rust frontend's `index_borrow_sources` clone-on-mutation
            # detection, so the get-mutate-set idiom (`t = coll.get(i);
            # t.field.push(x); coll.set(i,t)` in traits.gg) treats a String/
            # struct element binding as owned and re-sets it — wiring its
            # elem_drop turns that into a use-after-free / double-free
            # (verified: a global wiring crashed in compute_reachable_fns,
            # freeing a still-aliased LirInst String). Nested COLLECTIONS aren't
            # used in that mutate-in-place idiom (they're rebuilt-and-set as
            # whole vectors), so freeing the displaced inner collection is safe.
            String sized_runtime = ""
            if m.type_runtime_map.contains(arr_tyname):
                sized_runtime = m.type_runtime_map.get(arr_tyname).unwrap_or("")
            bool sized_is_nested_coll = (sized_runtime == "GorgetArray" or sized_runtime == "GorgetMap" or sized_runtime == "GorgetSet")
            if sized_is_nested_coll:
                String sized_df = lc_collection_drop_fn(arr_tyname, &m)
                String sized_cf = lc_collection_clone_fn(arr_tyname, &m)
                if sized_df.len() > 0 and sized_cf.len() > 0:
                    sized_out = sized_out + " " + v(dst) + ".elem_drop = (__gorget_drop_fn)" + sized_df + ";"
                    sized_out = sized_out + " " + v(dst) + ".elem_clone = (__gorget_drop_fn)" + sized_cf + ";"
            return sized_out
        return ";"
    if name.starts_with("__gorget_dict_new_sized_"):
        if dst >= 0:
            String rest_kv_d = name.slice(24, name.len())
            int sep_pos_d = find_substr(rest_kv_d, "__GGSEP__")
            if sep_pos_d > 0:
                String k_tyname_d = rest_kv_d.slice(0, sep_pos_d)
                String v_tyname_d = rest_kv_d.slice(sep_pos_d + 9, rest_kv_d.len())
                String k_c_tname_d = resolve_sizeof_c_type(k_tyname_d, &m, &sn)
                String v_c_tname_d = resolve_sizeof_c_type(v_tyname_d, &m, &sn)
                if k_c_tname_d == "Str" or k_c_tname_d == "GorgetString":
                    return v(dst) + " = gorget_dict_new_str(sizeof(" + v_c_tname_d + "));"
                return v(dst) + " = gorget_dict_new(sizeof(" + k_c_tname_d + "), sizeof(" + v_c_tname_d + "));"
        return ";"
    if name.starts_with("__gorget_map_new_sized_"):
        if dst >= 0:
            String rest_kv = name.slice(23, name.len())
            int sep_pos = find_substr(rest_kv, "__GGSEP__")
            if sep_pos > 0:
                String k_tyname = rest_kv.slice(0, sep_pos)
                String v_tyname = rest_kv.slice(sep_pos + 9, rest_kv.len())
                String k_c_tname = resolve_sizeof_c_type(k_tyname, &m, &sn)
                String v_c_tname = resolve_sizeof_c_type(v_tyname, &m, &sn)
                # String keys must route to `gorget_map_new_str` so the
                # runtime wires up `__gorget_str_key_hash` /
                # `__gorget_str_key_eq` / `key_materialize`. Without that,
                # hash_fn stays NULL and the map falls back to byte-FNV
                # on the 32-byte Str struct (data ptr + cap + len) —
                # different String instances of the same content hash
                # differently and `contains` lies after `put`. This was
                # the actual "Dict[String, _] state-loss" bug: empty
                # `{}` literals with a `Dict[String, _]` hint went
                # through this magic-name path that ignored key type.
                if k_c_tname == "Str" or k_c_tname == "GorgetString":
                    return v(dst) + " = gorget_map_new_str(sizeof(" + v_c_tname + "));"
                return v(dst) + " = gorget_map_new(sizeof(" + k_c_tname + "), sizeof(" + v_c_tname + "));"
        return ";"

    # DropIfAlive guard.
    if name.starts_with("__gorget_drop_if_alive_open__"):
        String size_str = name.slice(28, name.len())
        if args.len() > 0:
            return "{ char __dia_z[" + size_str + "] = {0}; if (memcmp(" + v(args.get(0).unwrap()) + ", __dia_z, " + size_str + ") != 0) {"
        return "/* dia open */;"
    if name == "__gorget_drop_if_alive_close":
        return "} }"

    # Drop flag guard (V3 drop elaboration).
    if name == "__gorget_drop_flag_open":
        if args.len() > 0:
            return "if (" + v(args.get(0).unwrap()) + ") {"
        return "/* drop flag open */;"
    if name == "__gorget_drop_flag_close":
        return "}"

    # Struct constructor: Name(args...) → (C_Type){ .field0 = arg0, .field1 = arg1, ... }
    if is_struct_constructor(name, &m):
        String cname = find_c_struct_name(name, &m, &sn)
        if dst >= 0:
            String sc_out = v(dst) + " = (" + cname + "){ "
            Vector[String] field_names = get_struct_field_names(name, &m)
            int ai = 0
            while ai < args.len() and ai < field_names.len():
                if ai > 0:
                    sc_out = sc_out + ", "
                sc_out = sc_out + "." + c_field_name(field_names.get(ai).unwrap()) + " = " + v(args.get(ai).unwrap())
                ai += 1
            return sc_out + " };"
        return ";"

    # Builtin type casts.
    if args.len() == 1:
        if name == "float":
            if dst >= 0:
                return v(dst) + " = (double)" + v(args.get(0).unwrap()) + ";"
            return ";"
        if name == "int":
            if dst >= 0:
                return v(dst) + " = (int64_t)" + v(args.get(0).unwrap()) + ";"
            return ";"
        if name == "bool":
            if dst >= 0:
                return v(dst) + " = (bool)" + v(args.get(0).unwrap()) + ";"
            return ";"

    # Printf/fprintf/gorget_string_format: variadic — Str args need .data
    # extraction for C's printf-style format. gorget_string_format takes
    # `const char* fmt, ...` and routes vsnprintf so the same rules apply.
    if name == "printf" or name == "fprintf" or name == "gorget_string_format":
        int gs_ty = find_struct_type("GorgetString", &m)
        String pf_out = ""
        if dst >= 0:
            pf_out = v(dst) + " = "
        pf_out = pf_out + name + "("
        int ai = 0
        while ai < args.len():
            if ai > 0:
                pf_out = pf_out + ", "
            int arg_id = args.get(ai).unwrap()
            int arg_ty = -1
            if val_types.contains(arg_id):
                arg_ty = val_types.get(arg_id).unwrap()
            # Only Str (GorgetString) has a .data field; other aggregates
            # like Result/Option/user structs must be passed by value.
            # Str VALUE args (ai != 0) decompose to `(int)len, data` so %.*s
            # prints exactly len bytes — required for non-NUL-terminated cap=0
            # views (trim/strip/slice/substring). The position-0 slot is the
            # format string itself and must stay `(const char*)data` — decomposing
            # it would misalign varargs and SIGSEGV. Mirrors Rust emit_printf.rs
            # :164 (i==0 fmt) + :212 (i>0 decompose).
            if arg_ty == gs_ty:
                if ai != 0:
                    pf_out = pf_out + "(int)" + v(arg_id) + ".len, " + v(arg_id) + ".data"
                else:
                    pf_out = pf_out + v(arg_id) + ".data"
            else:
                pf_out = pf_out + v(arg_id)
            ai += 1
        return pf_out + ");"

    # Generic extern call — pass all args directly.
    # Check if extern returns void to suppress assignment.
    bool returns_void = false
    if dst >= 0:
        # Check known void runtime functions first.
        if is_void_runtime_fn(name):
            returns_void = true
        if not returns_void:
            int ei = 0
            while ei < m.externs.len():
                LirExtern ext = m.externs.get(ei).unwrap()
                if ext.name == name:
                    if ext.return_type == LT_VOID:
                        returns_void = true
                    break
                ei += 1
        # Also check user functions (ICall masquerading as CallExtern via redirect)
        if not returns_void:
            int fi = 0
            while fi < m.functions.len():
                if m.functions.get(fi).unwrap().name == name:
                    if m.functions.get(fi).unwrap().return_type == LT_VOID:
                        returns_void = true
                    break
                fi += 1
    # Self-host emit gap closure (2026-05-10): cstr-returning runtime
    # fns need their result wrapped with gorget_str_from_cstr(...) when
    # the destination is a Str slot — self-host treats `cstr` in Gorget
    # source as LT_PTR, so dst's type discriminates: LT_STRUCT(gs) → wrap
    # to Str, LT_PTR → keep as raw cstr (extern caller wanted cstr).
    # Mirrors Rust gg's SlotStore Ptr→Str cstr wrapping
    # (`src/backend/c_lir/mod.rs:1808`) but at the call-emit site
    # instead of the slot-store site — self-host doesn't track
    # per-value cstr origin yet.
    bool cstr_ret = false
    if is_cstr_returning_fn(name) and dst >= 0 and not returns_void:
        int dst_ty_v = LT_VOID
        if val_types.contains(dst):
            dst_ty_v = val_types.get(dst).unwrap()
        int gs_ty_v = find_struct_type("GorgetString", &m)
        if dst_ty_v == gs_ty_v:
            cstr_ret = true
    String out = ""
    if dst >= 0 and not returns_void:
        out = v(dst) + " = "
    if cstr_ret:
        out = out + "gorget_str_from_cstr("
    out = out + name + "("
    # For runtime functions whose parameters take Str by value, coerce
    # pointer-typed actuals with an explicit *(Str*) deref so we don't fail
    # C type checking when the caller passed a bare String (which uses Ptr ABI).
    # For scalar placeholder args (self-host lost type info) at known Str
    # positions, substitute an empty Str so the compile succeeds.
    bool str_by_value_fn = runtime_takes_str_by_value(name)
    int gs_ty = find_struct_type("GorgetString", &m)
    # Arity padding: some runtime fns take an optional arg that Gorget allows
    # callers to omit (e.g. str_strip(s) vs str_strip(s, chars)). Pad with
    # empty Str to match the C declaration.
    bool pad_trailing_empty_str = false
    if args.len() == 1:
        if name == "gorget_str_strip" or name == "gorget_str_lstrip" or name == "gorget_str_rstrip":
            pad_trailing_empty_str = true
    # Look up callee's param types for scalar-to-aggregate coercion.
    int callee_idx = find_fn_by_name(&m, name)

    # Box__TYPE(x) constructor: Rust emits `__gorget_box_alloc_TYPE(x)`. The
    # raw name Box__TYPE arrives before map_mono_to_runtime mutation.
    # Phase A — Box type detected via type_runtime_map "Box" category.
    bool raw_is_box = m.type_runtime_map.contains(raw_name) and m.type_runtime_map.get(raw_name).unwrap_or("") == "Box"
    if raw_is_box and args.len() == 1:
        String box_type = raw_name.slice(5, raw_name.len())
        String box_out = ""
        if dst >= 0:
            box_out = v(dst) + " = "
        return box_out + "__gorget_box_alloc_" + box_type + "(" + v(args.get(0).unwrap()) + ");"

    # Box(x) constructor: Rust emits `__gorget_box_alloc_TYPE(x)` per type.
    # Look up the argument's value type to find the right alloc function.
    # If the type is unknown (self-host lost it via placeholder), fall back
    # to casting the arg as void* — Box is `typedef void*` at C level so
    # this preserves link correctness.
    if name == "Box" and args.len() == 1:
        int box_arg = args.get(0).unwrap()
        int box_arg_ty = LT_VOID
        if val_types.contains(box_arg):
            box_arg_ty = val_types.get(box_arg).unwrap()
        String type_suffix = ""
        if box_arg_ty >= LT_STRUCT_BASE:
            int tsid = box_arg_ty - LT_STRUCT_BASE
            if tsid < m.structs.len():
                type_suffix = m.structs.get(tsid).unwrap().name
        String box1_out = ""
        if dst >= 0:
            box1_out = v(dst) + " = "
        if type_suffix != "":
            return box1_out + "__gorget_box_alloc_" + type_suffix + "(" + v(box_arg) + ");"
        # Unknown struct type — degenerate cast (arg already a pointer or
        # will be coerced to one via NULL-on-scalar).
        return box1_out + "(void*)(uintptr_t)" + v(box_arg) + ";"

    # Prelude variants (Some/None/Ok/Error). Pick the parametrized
    # Option__X / Result__X__Y based on:
    # 1. The DST's value type, if it's already an aggregate (usual case).
    # 2. The ARG's value type — compute Option__<ArgType> or
    #    Result__<ArgType>__GorgetString / Result__int64_t__<ArgType>.
    if name == "Some" or name == "None" or name == "Ok" or name == "Error":
        if dst >= 0:
            int parent_sid_pv = -1
            int dst_ty_pv = LT_VOID
            if val_types.contains(dst):
                dst_ty_pv = val_types.get(dst).unwrap()
            if dst_ty_pv >= LT_STRUCT_BASE:
                parent_sid_pv = dst_ty_pv
            # Fallback: compute parent name from arg type.
            if parent_sid_pv < 0 and args.len() > 0:
                int arg_ty_pv = LT_VOID
                if val_types.contains(args.get(0).unwrap()):
                    arg_ty_pv = val_types.get(args.get(0).unwrap()).unwrap()
                String arg_tname = ""
                if arg_ty_pv >= LT_STRUCT_BASE:
                    arg_tname = m.structs.get(arg_ty_pv - LT_STRUCT_BASE).unwrap().name
                elif arg_ty_pv == LT_I64:
                    arg_tname = "int64_t"
                elif arg_ty_pv == LT_F64:
                    arg_tname = "double"
                elif arg_ty_pv == LT_BOOL:
                    arg_tname = "bool"
                elif arg_ty_pv == LT_PTR or (arg_ty_pv >= LT_PTR_TO_BASE and arg_ty_pv < LT_STRUCT_BASE):
                    arg_tname = "GorgetString"
                if arg_tname != "":
                    String parent_name_pv = ""
                    if name == "Some" or name == "None":
                        parent_name_pv = "Option__" + arg_tname
                    elif name == "Ok":
                        parent_name_pv = "Result__" + arg_tname + "__GorgetString"
                    elif name == "Error":
                        parent_name_pv = "Result__int64_t__" + arg_tname
                    if parent_name_pv != "":
                        parent_sid_pv = find_struct_type(parent_name_pv, &m)
            # Last-resort fallback: when the enclosing function's return type
            # is an Option/Result, assume this variant constructor is being
            # returned and use the function's return type as the parent. This
            # catches `return Ok(x)` / `return Error(x)` / `return Some(x)`
            # patterns where neither dst nor arg val_types helped.
            # `find_struct_type` returns LT_PTR on miss, so the <STRUCT_BASE
            # check — not < 0 — determines unresolved.
            if parent_sid_pv < LT_STRUCT_BASE and func_ret_ty >= LT_STRUCT_BASE:
                int frt_sid = func_ret_ty - LT_STRUCT_BASE
                if frt_sid < m.structs.len():
                    LirStructDef frt_sdef = m.structs.get(frt_sid).unwrap()
                    # Phase A — use enum_kind instead of starts_with on struct names.
                    bool accept = false
                    if (name == "Some" or name == "None") and frt_sdef.enum_kind == EK_OPTION:
                        accept = true
                    if (name == "Ok" or name == "Error") and frt_sdef.enum_kind == EK_RESULT:
                        accept = true
                    if accept:
                        parent_sid_pv = func_ret_ty
            # None with no args: pick any Option__X (first registered Option type).
            if parent_sid_pv < 0 and (name == "None"):
                int sdi_pv = 0
                while sdi_pv < m.structs.len():
                    LirStructDef sd_pv = m.structs.get(sdi_pv).unwrap()
                    if sd_pv.enum_kind == EK_OPTION:
                        parent_sid_pv = LT_STRUCT_BASE + sdi_pv
                        break
                    sdi_pv += 1
            if parent_sid_pv >= LT_STRUCT_BASE:
                String parent_c_dst = c_type_name(parent_sid_pv, &sn)
                int pv_tag = 0
                if name == "None" or name == "Error":
                    pv_tag = 1
                String out_pv = ""
                if dst >= 0:
                    out_pv = v(dst) + " = "
                out_pv = out_pv + "(" + parent_c_dst + "){.tag = " + int_to_str(pv_tag)
                if args.len() > 0:
                    # Collect the parent's payload field types to coerce args
                    # that the self-host lost type info on (e.g. void* local at
                    # an F64 field).
                    LirStructDef pv_pdef = m.structs.get(parent_sid_pv - LT_STRUCT_BASE).unwrap()
                    Vector[int] pv_field_tys = []
                    int pv_fi = 1
                    while pv_fi < pv_pdef.fields.len():
                        StructField pv_sf = pv_pdef.fields.get(pv_fi).unwrap()
                        if pv_sf.name.starts_with(name + "_"):
                            pv_field_tys.push(pv_sf.ty)
                        pv_fi += 1
                    int pva = 0
                    while pva < args.len():
                        out_pv = out_pv + ", ." + name + "_" + int_to_str(pva) + " = " + emit_variant_arg(args.get(pva).unwrap(), pv_field_tys, pva, &val_types, &sn, &m)
                        pva += 1
                out_pv = out_pv + "};"
                return out_pv

    # Qualified enum variant: `EnumName__VariantName(x)` (the resolved form
    # of `EnumName.VariantName(x)`). Split and recurse the lookup.
    String ev_name = name
    if name.contains("__"):
        # Parser/resolver emits EnumName__VariantName for qualified variants.
        # Check if the bare variant name is registered — recurse via it.
        int underscore_idx = name.index_of("__").unwrap()
        String maybe_parent = name.slice(0, underscore_idx)
        String maybe_variant = name.slice(underscore_idx + 2, name.len())
        if m.enum_variant_parent.contains(maybe_variant) and m.enum_variant_parent.get(maybe_variant).unwrap() == maybe_parent:
            ev_name = maybe_variant

    # Enum variant constructor: `VariantName(x)` → inline struct init for
    # the parent enum (no C function exists for variants). For 0-arg
    # variants, emits just the tag. For 1+-arg variants, initializes the
    # variant's payload fields.
    if m.enum_variant_parent.contains(ev_name):
        String parent_name = m.enum_variant_parent.get(ev_name).unwrap()
        int parent_sid = find_struct_type(parent_name, &m)
        if parent_sid >= LT_STRUCT_BASE:
            int parent_idx = parent_sid - LT_STRUCT_BASE
            LirStructDef pdef = m.structs.get(parent_idx).unwrap()
            # Use the pre-computed enum_variant_tag map populated by
            # lir_lower. That uses the variant's ordinal position in the
            # source enum declaration, which is the CORRECT runtime tag and
            # matches what `match`-pattern tests against. The old heuristic
            # (scan struct fields, collect distinct VariantName prefixes)
            # only saw variants-with-payload, so unit variants like TkEof
            # got tag = seen_variants.len() (6) instead of their real
            # ordinal (63) — and match-ing TkEof at runtime never hit.
            int variant_tag = -1
            if m.enum_variant_tag.contains(ev_name):
                variant_tag = m.enum_variant_tag.get(ev_name).unwrap()
            # Fallback: old heuristic for any variants the map missed.
            if variant_tag < 0:
                int vt_i = 1
                Vector[String] seen_variants = []
                while vt_i < pdef.fields.len():
                    StructField sf = pdef.fields.get(vt_i).unwrap()
                    int underscore = -1
                    int ci = 0
                    while ci < sf.name.byte_len():
                        if sf.name.byte_at(ci) == 0x5F:
                            underscore = ci
                        ci += 1
                    if underscore > 0:
                        String vname = sf.name.slice(0, underscore)
                        bool seen = false
                        int svi = 0
                        while svi < seen_variants.len():
                            if seen_variants.get(svi).unwrap() == vname:
                                seen = true
                                break
                            svi += 1
                        if not seen:
                            seen_variants.push(vname.clone())
                    vt_i += 1
                int sv_i = 0
                while sv_i < seen_variants.len():
                    if seen_variants.get(sv_i).unwrap() == ev_name:
                        variant_tag = sv_i
                        break
                    sv_i += 1
                if variant_tag < 0:
                    variant_tag = seen_variants.len()
            String parent_c = c_type_name(parent_sid, &sn)
            # Look up variant field types to coerce mismatched arg values.
            # Variant payload field names are "VariantName_N"; we pull the
            # field type to wrap scalar-mismatched aggregate args.
            Vector[int] variant_field_tys = []
            int vfi = 1
            while vfi < pdef.fields.len():
                StructField vsf = pdef.fields.get(vfi).unwrap()
                if vsf.name.starts_with(ev_name + "_"):
                    variant_field_tys.push(vsf.ty)
                vfi += 1
            String ev_out = ""
            if dst >= 0:
                ev_out = v(dst) + " = "
            ev_out = ev_out + "(" + parent_c + "){.tag = " + int_to_str(variant_tag)
            if args.len() > 0:
                if pdef.is_union_layout:
                    # Large enum: payload lives in a union named `data`.
                    ev_out = ev_out + ", .data = {"
                    if args.len() == 1:
                        # Single-field variant: direct union member.
                        ev_out = ev_out + "." + ev_name + "_0 = " + emit_variant_arg(args.get(0).unwrap(), variant_field_tys, 0, &val_types, &sn, &m)
                    else:
                        # Multi-field variant: nested struct named after variant.
                        ev_out = ev_out + "." + ev_name + " = {"
                        int va = 0
                        while va < args.len():
                            if va > 0:
                                ev_out = ev_out + ", "
                            ev_out = ev_out + "." + ev_name + "_" + int_to_str(va) + " = " + emit_variant_arg(args.get(va).unwrap(), variant_field_tys, va, &val_types, &sn, &m)
                            va += 1
                        ev_out = ev_out + "}"
                    ev_out = ev_out + "}"
                else:
                    # Flat layout: payload fields are direct struct members.
                    int va = 0
                    while va < args.len():
                        ev_out = ev_out + ", ." + ev_name + "_" + int_to_str(va) + " = " + emit_variant_arg(args.get(va).unwrap(), variant_field_tys, va, &val_types, &sn, &m)
                        va += 1
            ev_out = ev_out + "};"
            return ev_out
    int ai = 0
    while ai < args.len():
        if ai > 0:
            out = out + ", "
        int arg_id = args.get(ai).unwrap()
        int arg_ty = LT_VOID
        if val_types.contains(arg_id):
            arg_ty = val_types.get(arg_id).unwrap()
        bool is_ptr = (arg_ty == LT_PTR) or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE)
        bool is_str = (arg_ty == gs_ty)
        bool str_pos = str_by_value_fn and runtime_arg_is_str(name, ai)
        bool cstr_pos = runtime_arg_is_cstr(name, ai)
        bool addr_pos = runtime_arg_needs_addr(name, ai)
        if addr_pos and not is_ptr:
            # Runtime fn declares this arg as a pointer to an aggregate;
            # the self-host lowered it by value (lost `&` along the way).
            # Wrap with `&` to recover the pointer.
            out = out + "&" + v(arg_id)
        elif cstr_pos and is_str:
            # Runtime fn wants const char*, caller has Str — convert via
            # gorget_str_to_cstr(s) for null-terminated path (takes Str by value).
            out = out + "gorget_str_to_cstr(" + v(arg_id) + ")"
        elif cstr_pos and is_ptr:
            # Runtime fn wants const char*, caller has *Str (aggregate
            # passed by pointer — the self-host's default ABI for
            # resource-type bare params). Deref and convert. Without
            # this, `gorget_parse_int(&str_val)` passes the address of
            # the Str aggregate where a cstring is expected, and
            # `strtoll` reads the bytes of the Str.data POINTER as if
            # they were the string's digits — always returns 0 for
            # non-matching pointer bytes. This is the root cause of
            # stage-1 lexer's `parse_int("42")` returning 0.
            out = out + "gorget_str_to_cstr(*(Str*)" + v(arg_id) + ")"
        elif str_pos and not is_str:
            if is_ptr:
                out = out + "*(Str*)" + v(arg_id)
            else:
                # Scalar placeholder (lossy lowering) at Str position — substitute empty Str.
                out = out + "((Str){0})"
        elif callee_idx >= 0:
            if ai < m.functions.get(callee_idx).unwrap().params.len():
                int pty = m.functions.get(callee_idx).unwrap().params.get(ai).unwrap()
                if lir_is_aggregate(pty) and not lir_is_aggregate(arg_ty):
                    String pty_name = c_type_name(pty, &sn)
                    if is_ptr:
                        out = out + "*(" + pty_name + "*)" + v(arg_id)
                    else:
                        out = out + "(" + pty_name + "){0}"
                elif not lir_is_aggregate(pty) and lir_is_aggregate(arg_ty) and (pty == LT_PTR or (pty >= LT_PTR_TO_BASE and pty < LT_STRUCT_BASE)):
                    # Callee expects a pointer, caller has an aggregate by
                    # value — wrap with `&` to pass its address.
                    out = out + "&" + v(arg_id)
                elif is_ptr and not lir_is_aggregate(pty) and pty != LT_PTR and (pty < LT_PTR_TO_BASE or pty >= LT_STRUCT_BASE) and pty != LT_VOID:
                    # Scalar param, pointer arg — deref the pointer. The
                    # `Vector[scalar].get(i).unwrap()` path: runtime safe_get
                    # returns void* to the element and unwrap is a passthrough,
                    # so int params would otherwise receive pointer-sized
                    # values and segfault in typechecker / scope lookups.
                    String pty_name_deref = c_type_name(pty, &sn)
                    out = out + "*(" + pty_name_deref + "*)" + v(arg_id)
                else:
                    out = out + v(arg_id)
            else:
                out = out + v(arg_id)
        else:
            out = out + v(arg_id)
        ai += 1
    if pad_trailing_empty_str:
        if args.len() > 0:
            out = out + ", "
        out = out + "((Str){0})"
    if cstr_ret:
        return out + "));"
    return out + ");"

# ── Terminator emission ───────────────────────────────────

String emit_term(LirTerm &term, LirFunction &func, Vector[String] &sn, Dict[int, int] &val_types):
    match term:
        case TRet(value):
            # Void-returning functions: suppress the return value.
            if func.return_type == LT_VOID:
                return "return;"
            # If function returns aggregate but value is pointer, deref.
            if lir_is_aggregate(func.return_type):
                int vty = -1
                if val_types.contains(value):
                    vty = val_types.get(value).unwrap()
                if vty == LT_PTR:
                    String ty_name = c_type_name(func.return_type, &sn)
                    return "return *(" + ty_name + "*)" + v(value) + ";"
            return "return " + v(value) + ";"

        case TRetVoid:
            return "return;"

        case TJump(target, args):
            return emit_jump_args(target, &args, &func, &sn, &val_types) + "goto __bb" + int_to_str(target) + ";"

        case TBranch(cond, then_blk, then_args, else_blk, else_args):
            String out = "if (" + v(cond) + ") {\n"
            if then_args.len() > 0:
                out = out + "        " + emit_jump_args(then_blk, &then_args, &func, &sn, &val_types) + "\n"
            out = out + "        goto __bb" + int_to_str(then_blk) + ";\n"
            out = out + "    } else {\n"
            if else_args.len() > 0:
                out = out + "        " + emit_jump_args(else_blk, &else_args, &func, &sn, &val_types) + "\n"
            out = out + "        goto __bb" + int_to_str(else_blk) + ";\n"
            out = out + "    }"
            return out

        case TSwitch(value, cases, default_blk, default_args):
            String out = "switch ((int64_t)" + v(value) + ") {\n"
            int ci = 0
            while ci < cases.len():
                SwitchCase sc = cases.get(ci).unwrap()
                String ja = emit_jump_args(sc.target, &sc.args, &func, &sn, &val_types)
                out = out + "        case " + int_to_str(sc.value) + ": " + ja + "goto __bb" + int_to_str(sc.target) + ";\n"
                ci += 1
            String da = emit_jump_args(default_blk, &default_args, &func, &sn, &val_types)
            out = out + "        default: " + da + "goto __bb" + int_to_str(default_blk) + ";\n"
            out = out + "    }"
            return out

        case TUnreachable:
            return "__builtin_unreachable();"

# Emit parallel-copy assignments for block parameter passing. Applies the
# same scalar/aggregate coercion as ISlotStore when the block-param type
# (set from the slot type at phi creation) doesn't match the incoming
# value's inferred type — otherwise C refuses `void* = Str` etc.
String emit_jump_args(int target, Vector[int] &args, LirFunction &func, Vector[String] &sn, Dict[int, int] &val_types):
    if args.len() == 0:
        return ""
    LirBlock target_blk = func.blocks.get(target).unwrap()
    String out = ""
    int i = 0
    while i < args.len() and i < target_blk.params.len():
        BlockParam bp = target_blk.params.get(i).unwrap()
        int arg = args.get(i).unwrap()
        int bp_ty = bp.ty
        int arg_ty = LT_VOID
        if val_types.contains(arg):
            arg_ty = val_types.get(arg).unwrap()
        bool bp_agg = lir_is_aggregate(bp_ty)
        bool arg_agg = lir_is_aggregate(arg_ty)
        bool bp_ptr = (bp_ty == LT_PTR) or (bp_ty >= LT_PTR_TO_BASE and bp_ty < LT_STRUCT_BASE)
        bool arg_ptr = (arg_ty == LT_PTR) or (arg_ty >= LT_PTR_TO_BASE and arg_ty < LT_STRUCT_BASE)
        if bp_ptr and arg_agg:
            # Pointer bp receiving an aggregate value — take the address
            # of the aggregate stack temp. This happens for `!Aggregate`
            # consuming params, whose slot is LT_PTR (ABI is pointer-pass)
            # but the user assigns new aggregate values. Previously wrote
            # NULL — silently lost all mutations and segfaulted downstream
            # on the threaded pointer.
            out = out + "__bp" + int_to_str(bp.value_id) + " = &__v" + int_to_str(arg) + "; "
        elif bp_agg and not arg_agg:
            # Aggregate bp receiving a non-aggregate — zero-init matches
            # ISlotStore's coercion for lost-type-info arguments.
            out = out + "__bp" + int_to_str(bp.value_id) + " = (" + c_type_name(bp_ty, &sn) + "){0}; "
        elif bp_agg and arg_agg and bp_ty != arg_ty:
            # Different aggregate types — fall back to zero-init rather
            # than risking a struct-size memcpy mismatch.
            out = out + "__bp" + int_to_str(bp.value_id) + " = (" + c_type_name(bp_ty, &sn) + "){0}; "
        elif lir_is_scalar(bp_ty) and not bp_ptr and arg_ptr:
            # NON-POINTER scalar bp (I64/I32/bool/F64/...) receiving a
            # pointer arg — mirrors the ISlotStore fix for
            # `Vector[scalar].get(i)` et al. where the self-host flattens
            # the return type to the scalar element but the call actually
            # returns a pointer-to-element. Dereference as the bp's
            # scalar type so the scalar value flows into the next block.
            # Excluding `bp_ptr` is critical — pointer-to-pointer
            # transfers (`void* __bp = __v0` when both are pointers) must
            # stay as plain assignment, not an aliasing deref.
            String bp_ty_name = c_type_name(bp_ty, &sn)
            out = out + "__bp" + int_to_str(bp.value_id) + " = *((" + bp_ty_name + "*)__v" + int_to_str(arg) + "); "
        else:
            out = out + "__bp" + int_to_str(bp.value_id) + " = __v" + int_to_str(arg) + "; "
        i += 1
    return out

# ── Function emission ──────────────────────────────────────

String emit_function(LirFunction &func, LirModule &m, Vector[String] &sn, Dict[String, int] &slit_map):
    # Mirrors src/backend/c_lir/mod.rs:emit_function — accumulate into a
    # single growing buffer via in-place push instead of `out = out + ...`
    # quadratic concatenation. Each push amortizes O(1) per byte.
    StrBuf buf = sb_new()
    Dict[int, int] val_types = compute_val_types(&func, &m)

    # Function signature
    if func.name == "main":
        sb_push(&buf, "int main(int argc, char** argv) {\n")
        sb_push(&buf, "    gorget_init_args(argc, argv);\n")
        # Module-level statics with runtime-call init — `stdout` /
        # `stderr` / `stdin` from lib/std/io.gg etc. The global is
        # declared zero-initialized by `emit_globals`; the actual
        # call (e.g. `gorget_stdout_handle()`) runs once at program
        # entry. Mirrors Rust gg's
        # `src/backend/c_lir/mod.rs:1582-1593`.
        int gri = 0
        while gri < m.globals.len():
            LirGlobal gr_g = m.globals.get(gri).unwrap()
            if gr_g.init_kind == GINIT_RUNTIME_CALL:
                sb_push(&buf, "    __lir_g")
                sb_push(&buf, int_to_str(gri))
                sb_push(&buf, " = ")
                sb_push(&buf, gr_g.init_expr)
                sb_push(&buf, ";\n")
            gri += 1
    else:
        String ret = c_type_name(func.return_type, &sn)
        sb_push(&buf, ret)
        sb_push(&buf, " ")
        sb_push(&buf, c_func_name(func.name))
        sb_push(&buf, "(")
        if func.params.len() == 0:
            sb_push(&buf, "void")
        else:
            int pi = 0
            while pi < func.params.len():
                if pi > 0:
                    sb_push(&buf, ", ")
                int pty = func.params.get(pi).unwrap()
                String ty_str = ""
                if pty == LT_VOID:
                    ty_str = "void*"
                else:
                    ty_str = c_type_name(pty, &sn)
                if pi < func.const_params.len():
                    bool is_const = func.const_params.get(pi).unwrap()
                    if is_const and lir_is_ptr(pty):
                        ty_str = "const " + ty_str
                sb_push(&buf, ty_str)
                sb_push(&buf, " __p")
                sb_push(&buf, int_to_str(pi))
                pi += 1
        sb_push(&buf, ") {\n")

    # Slot declarations
    int si = 0
    while si < func.slots.len():
        LirSlot slot = func.slots.get(si).unwrap()
        String ty_str = c_type_name(slot.ty, &sn)
        if ty_str == "void":
            ty_str = "void*"
        sb_push(&buf, "    ")
        sb_push(&buf, ty_str)
        sb_push(&buf, " __s")
        sb_push(&buf, int_to_str(si))
        if lir_is_scalar(slot.ty):
            sb_push(&buf, " = 0")
        else:
            sb_push(&buf, " = {0}")
        sb_push(&buf, ";\n")
        si += 1

    # Value declarations — find max value id (scan block params, inst dsts, and func.next_value)
    int max_val = func.next_value
    int bi = 0
    while bi < func.blocks.len():
        int pi = 0
        while pi < func.blocks.get(bi).unwrap().params.len():
            BlockParam bp = func.blocks.get(bi).unwrap().params.get(pi).unwrap()
            if bp.value_id >= max_val:
                max_val = bp.value_id + 1
            pi += 1
        int ii = 0
        while ii < func.blocks.get(bi).unwrap().insts.len():
            int dst = inst_dst(&func.blocks.get(bi).unwrap().insts.get(ii).unwrap())
            if dst >= max_val:
                max_val = dst + 1
            ii += 1
        bi += 1

    int vi = 0
    while vi < max_val:
        String ty_str = "void*"
        if val_types.contains(vi):
            int vty = val_types.get(vi).unwrap()
            String ts = c_type_name(vty, &sn)
            if ts == "void":
                ty_str = "void*"
            else:
                ty_str = ts
        sb_push(&buf, "    ")
        sb_push(&buf, ty_str)
        sb_push(&buf, " __v")
        sb_push(&buf, int_to_str(vi))
        sb_push(&buf, ";\n")
        vi += 1

    # Block parameter move variables
    bi = 0
    while bi < func.blocks.len():
        int pi = 0
        while pi < func.blocks.get(bi).unwrap().params.len():
            BlockParam bp = func.blocks.get(bi).unwrap().params.get(pi).unwrap()
            String ty_str = c_type_name(bp.ty, &sn)
            sb_push(&buf, "    ")
            sb_push(&buf, ty_str)
            sb_push(&buf, " __bp")
            sb_push(&buf, int_to_str(bp.value_id))
            sb_push(&buf, ";\n")
            pi += 1
        bi += 1

    # IAddressOf spill temps — one function-scope typed storage per AddressOf
    # dst so the &__at<dst> address stays valid for the rest of the function.
    bi = 0
    while bi < func.blocks.len():
        int ii = 0
        while ii < func.blocks.get(bi).unwrap().insts.len():
            match func.blocks.get(bi).unwrap().insts.get(ii).unwrap():
                case IAddressOf(dst, _, ty):
                    String ty_str = c_type_name(ty, &sn)
                    if ty_str == "void":
                        ty_str = "void*"
                    sb_push(&buf, "    ")
                    sb_push(&buf, ty_str)
                    sb_push(&buf, " __at")
                    sb_push(&buf, int_to_str(dst))
                    if lir_is_scalar(ty):
                        sb_push(&buf, " = 0")
                    else:
                        sb_push(&buf, " = {0}")
                    sb_push(&buf, ";\n")
                else:
                    pass
            ii += 1
        bi += 1

    sb_push(&buf, "\n")

    # Blocks
    bi = 0
    while bi < func.blocks.len():
        # Read each block/param/inst/term through a BORROW — do NOT value-bind
        # `LirBlock blk = …` / `LirInst inst = …` / `BlockParam bp = …`, which
        # deep-clone the block (its whole insts vector + Strings) on every
        # block of every emitted function. This is the main per-block C
        # emitter (read-only — it only produces strings), so the reads must
        # borrow, not copy (CoW contract). These leaked LirBlock/LirInst
        # clones were the dominant generate_c OOM consumer; mirrors Rust
        # c_lir iterating `&func.blocks[..]` to emit.
        sb_push(&buf, "__bb")
        sb_push(&buf, int_to_str(func.blocks.get(bi).unwrap().id))
        sb_push(&buf, ":\n")

        # Move block params from temporaries
        int pi = 0
        while pi < func.blocks.get(bi).unwrap().params.len():
            sb_push(&buf, "    __v")
            sb_push(&buf, int_to_str(func.blocks.get(bi).unwrap().params.get(pi).unwrap().value_id))
            sb_push(&buf, " = __bp")
            sb_push(&buf, int_to_str(func.blocks.get(bi).unwrap().params.get(pi).unwrap().value_id))
            sb_push(&buf, ";\n")
            pi += 1

        # Instructions
        int ii = 0
        while ii < func.blocks.get(bi).unwrap().insts.len():
            String code = emit_inst(&func.blocks.get(bi).unwrap().insts.get(ii).unwrap(), &m, &func, &sn, &val_types, &slit_map)
            sb_push(&buf, "    ")
            sb_push(&buf, code)
            sb_push(&buf, "\n")
            ii += 1

        # Terminator
        String tcode = emit_term(&func.blocks.get(bi).unwrap().term, &func, &sn, &val_types)
        sb_push(&buf, "    ")
        sb_push(&buf, tcode)
        sb_push(&buf, "\n")
        bi += 1

    sb_push(&buf, "}\n")
    return buf.s

# ── Drop/Clone function emission ──────────────────────────

# Map a drop function name to the corresponding clone function name.
String drop_to_clone_fn(String drop_fn):
    if drop_fn == "gorget_string_free":
        return "gorget_string_clone_to_owned"
    elif drop_fn == "gorget_array_free":
        return "gorget_array_clone"
    elif drop_fn == "gorget_map_free":
        return "gorget_map_clone"
    elif drop_fn == "gorget_set_free":
        return "gorget_set_clone"
    elif drop_fn.ends_with("__drop"):
        return drop_fn.slice(0, drop_fn.len() - 4) + "clone"
    elif drop_fn.starts_with("__gorget_dtor_"):
        # Drop-name collision type: the field's drop fn is the mangled
        # `__gorget_dtor_{T}`, but its clone is still the plain `{T}__clone`
        # (only the DROP symbol collided with the user method, not clone).
        # Without this arm the field-clone path returns "" → a containing
        # struct/enum would DROP the collision-type field but never deep-
        # clone it → shallow-copy double-free. Mirrors Rust gg
        # `src/backend/c_lir/emit_types.rs:1529-1531`.
        return drop_fn.slice(14, drop_fn.len()) + "__clone"
    return ""

# Emit the C statement to DEEP-clone a struct/enum field of type
# `ftype_name` at lvalue `access`, or "" if no clone is needed.
#
# Box[T] fields are the critical case: `drop_fn_for_type("Box__T")` returns
# "free" (the box pointer), but `drop_to_clone_fn("free")` returns "" — so a
# Box field would be DROPPED (its box pointer freed) yet NOT CLONED, leaving
# the clone sharing the SAME boxed payload as the source. Both then free it
# → double-free (the meta_expand `Expr` with `Box[SpannedExpr]` operands).
# Mirror Rust's `Expr__clone`: realloc a fresh box copying the inner value,
# then deep-clone the inner in place. Box detection is via the typed
# `type_runtime_map` ("Box"), not a name guess; the `Box__` mangling is the
# established runtime-symbol contract for extracting the inner type.
String field_clone_c(String access, String ftype_name, String drop_fn_name, LirModule &m, Vector[String] &sn):
    bool is_box = false
    if m.type_runtime_map.contains(ftype_name):
        if m.type_runtime_map.get(ftype_name).unwrap_or("") == "Box":
            is_box = true
    if is_box and ftype_name.len() > 5 and ftype_name.slice(0, 5) == "Box__":
        String inner = ftype_name.slice(5, ftype_name.len())
        String inner_c = find_c_name(inner, &m, &sn)
        String s = access + " = __gorget_box_alloc_" + inner + "(*(" + inner_c + "*)" + access + ");"
        # Deep-clone the inner in place when it owns resources (recursive
        # struct/enum, String, collection). lc_collection_clone_fn returns
        # the matching `<T>__clone_inplace` / `gorget_*_clone_inplace`, or ""
        # for a trivially-copyable inner (where the box realloc alone is the
        # full clone).
        String inner_clone = lc_collection_clone_fn(inner, &m)
        if inner_clone != "":
            s = s + " " + inner_clone + "(" + access + ");"
        return s
    String cf = drop_to_clone_fn(drop_fn_name)
    if cf != "":
        return access + " = " + cf + "(&" + access + ");"
    return ""

# Find the C struct name for a Gorget type name.
String find_c_name(String type_name, LirModule &m, Vector[String] &sn):
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == type_name:
            return c_type_name(LT_STRUCT_BASE + i, &sn)
        i += 1
    return type_name

# Check if a function already exists in the module.
bool fn_exists(String name, LirModule &m):
    int i = 0
    while i < m.functions.len():
        # Read `.name` through a BORROW — `LirFunction f =
        # m.functions.get(i).unwrap()` value-binds and deep-clones the WHOLE
        # function (all blocks/insts/Strings) just to compare its name.
        # fn_exists runs per drop/clone forward-decl candidate × all
        # functions, so the clone was a generate_c OOM consumer.
        if m.functions.get(i).unwrap().name == name:
            return true
        i += 1
    return false

# Struct field access pattern — handles union layout for enum types.
String field_access(String sdef_name, String field_name, LirModule &m, Vector[String] &sn, bool use_arrow):
    # Find struct def to check union layout
    int i = 0
    while i < m.structs.len():
        LirStructDef sdef = m.structs.get(i).unwrap()
        if sdef.name == sdef_name:
            if sdef.is_union_layout:
                String accessor = ""
                if use_arrow:
                    accessor = "self->data."
                else:
                    accessor = "dst.data."
                # Check if this variant has multiple fields
                String vprefix = field_variant_prefix(field_name)
                int vcount = 0
                int fi = 1
                while fi < sdef.fields.len():
                    StructField sf = sdef.fields.get(fi).unwrap()
                    if field_variant_prefix(sf.name) == vprefix:
                        vcount += 1
                    fi += 1
                if vcount > 1:
                    return accessor + c_field_name(vprefix) + "." + c_field_name(field_name)
                return accessor + c_field_name(field_name)
            break
        i += 1
    # Regular struct
    if use_arrow:
        return "self->" + c_field_name(field_name)
    return "dst." + c_field_name(field_name)

# Sort a Vector[String] in place using simple insertion sort. Used
# to stabilize Dict.keys() iteration order — the self-host's Dict
# returns keys in hash-positional order, which differs across
# stage-N runs and breaks bootstrap fixed-point convergence.
void sort_strings_in_place(Vector[String] &v):
    int n = v.len()
    int i = 1
    while i < n:
        String key = v.get(i).unwrap().clone()
        int j = i - 1
        while j >= 0:
            String jv = v.get(j).unwrap()
            if jv > key:
                v.set(j + 1, jv.clone())
                j -= 1
            else:
                break
        v.set(j + 1, key)
        i += 1

# Emit struct drop functions from recursive_drop_structs metadata.
# Emit forward declarations for ALL drop + clone functions BEFORE any
# definitions. Resolves the cross-category cycle where struct clone fns
# call enum clone fns (e.g. BasicBlock__clone → Terminator__clone) and
# the inline forward-decl loops in each emit_X are too local to cover
# that boundary. See generate_c's `body = ... emit_all_drop_clone_forward_decls`
# call site for the rationale.
String emit_all_drop_clone_forward_decls(LirModule &m, Vector[String] &sn):
    String out = ""
    # Struct drop forward decls
    Vector[String] sd_keys = m.recursive_drop_structs.keys()
    sort_strings_in_place(&sd_keys)
    int i = 0
    while i < sd_keys.len():
        String tn = sd_keys.get(i).unwrap()
        # Collision types forward-declare the mangled glue `__gorget_dtor_{T}`
        # (matching the renamed definition in emit_struct_drops); declaring
        # `{T}__drop` here would conflict with the user 2-arg method's
        # signature. Typed `drop_collision_types` lookup, no name guess.
        String drop_name = tn + "__drop"
        if m.drop_collision_types.contains(tn):
            drop_name = "__gorget_dtor_" + tn
        if not fn_exists(drop_name, &m):
            String cname = find_c_name(tn, &m, &sn)
            out = out + "static inline void " + drop_name + "(" + cname + "* self);\n"
        i += 1
    # Struct clone forward decls
    int j = 0
    while j < sd_keys.len():
        String tn = sd_keys.get(j).unwrap()
        String clone_name = tn + "__clone"
        if not fn_exists(clone_name, &m):
            String cname = find_c_name(tn, &m, &sn)
            out = out + cname + " " + clone_name + "(void* __p);\n"
        j += 1
    # Enum drop forward decls (skip if also struct — structs take priority)
    Vector[String] ed_keys = m.recursive_drop_enums.keys()
    sort_strings_in_place(&ed_keys)
    int k = 0
    while k < ed_keys.len():
        String tn = ed_keys.get(k).unwrap()
        String drop_name = tn + "__drop"
        if not fn_exists(drop_name, &m) and not m.recursive_drop_structs.contains(tn):
            out = out + "void " + drop_name + "(void* __p);\n"
        k += 1
    # Enum clone forward decls (skip if also struct)
    int l = 0
    while l < ed_keys.len():
        String tn = ed_keys.get(l).unwrap()
        String clone_name = tn + "__clone"
        if not fn_exists(clone_name, &m) and not m.recursive_drop_structs.contains(tn):
            String cname = find_c_name(tn, &m, &sn)
            out = out + cname + " " + clone_name + "(void* __p);\n"
        l += 1
    if out.len() > 0:
        out = out + "\n"
    return out

String emit_struct_drops(LirModule &m, Vector[String] &sn):
    String out = ""
    Vector[String] keys = m.recursive_drop_structs.keys()
    # Sort keys alphabetically — Dict.keys() iteration order is
    # non-deterministic (depends on hash positions), which makes
    # stage-N's emit non-byte-equal to stage-(N+1)'s. Sort here so
    # the bootstrap fixed point can converge.
    sort_strings_in_place(&keys)
    # Forward declarations first — drop functions may call each other for
    # nested structs (Outer.drop calls Inner.drop). Without fwd decls, C
    # infers implicit int return and later static definition conflicts.
    int kf = 0
    while kf < keys.len():
        String type_name_f = keys.get(kf).unwrap()
        # For a drop-name collision type the auto glue is named
        # `__gorget_dtor_{T}` (the plain `T__drop` symbol is the user's
        # method). Read the typed `drop_collision_types` accessor — never
        # a name-shape heuristic. See docs/devbook/24-layering-discipline.md.
        String drop_name_f = type_name_f + "__drop"
        if m.drop_collision_types.contains(type_name_f):
            drop_name_f = "__gorget_dtor_" + type_name_f
        if not fn_exists(drop_name_f, &m):
            String cname_f = find_c_name(type_name_f, &m, &sn)
            out = out + "static inline void " + drop_name_f + "(" + cname_f + "* self);\n"
        kf += 1
    if keys.len() > 0:
        out = out + "\n"
    int ki = 0
    while ki < keys.len():
        String type_name = keys.get(ki).unwrap()
        # Auto-glue name: mangled for collision types, plain otherwise.
        String drop_name = type_name + "__drop"
        if m.drop_collision_types.contains(type_name):
            drop_name = "__gorget_dtor_" + type_name
        # Skip if a function with the glue name already exists. For a
        # collision type this checks `__gorget_dtor_{T}` (absent → emit),
        # so the auto glue is now generated instead of being shadowed by
        # the same-named user `T__drop` method.
        if fn_exists(drop_name, &m):
            ki += 1
            continue
        String cname = find_c_name(type_name, &m, &sn)
        Vector[FieldDrop] drops = m.recursive_drop_structs.get(type_name).unwrap()
        out = out + "static inline void " + drop_name + "(" + cname + "* self) {\n"
        # ③(c): a user Drop impl runs FIRST, then the per-field auto-drops
        # (mirror Rust drops.rs:322-341). The user method is recorded on
        # TypeDropInfo.user_drop_fn. Its C signature is `void {T}__drop(void* __p0)`;
        # passing `self` (a cname*) to the void* param is a valid implicit cast,
        # exactly as `Inner__drop(&self->inner)` already does below.
        String udf = ""
        if m.type_drop_fns.contains(type_name):
            udf = m.type_drop_fns.get(type_name).unwrap().user_drop_fn
        if udf != "":
            out = out + "    " + udf + "(self);\n"
        int di = 0
        while di < drops.len():
            FieldDrop fd = drops.get(di).unwrap()
            String access = field_access(type_name, fd.field_name, &m, &sn, true)
            if fd.drop_fn_name == "free":
                out = out + "    free(" + access + ");\n"
            else:
                out = out + "    " + fd.drop_fn_name + "(&" + access + ");\n"
            di += 1
        out = out + "}\n\n"
        ki += 1
    return out

# Emit struct clone functions from recursive_drop_structs metadata.
String emit_struct_clones(LirModule &m, Vector[String] &sn):
    String out = ""
    Vector[String] keys = m.recursive_drop_structs.keys()
    sort_strings_in_place(&keys)
    # Forward declarations to prevent implicit-decl conflicts.
    int kf = 0
    while kf < keys.len():
        String type_name_f = keys.get(kf).unwrap()
        String clone_name_f = type_name_f + "__clone"
        if not fn_exists(clone_name_f, &m):
            String cname_f = find_c_name(type_name_f, &m, &sn)
            out = out + cname_f + " " + clone_name_f + "(void* __p);\n"
        kf += 1
    if keys.len() > 0:
        out = out + "\n"
    int ki = 0
    while ki < keys.len():
        String type_name = keys.get(ki).unwrap()
        String clone_name = type_name + "__clone"
        if fn_exists(clone_name, &m):
            ki += 1
            continue
        String cname = find_c_name(type_name, &m, &sn)
        Vector[FieldDrop] drops = m.recursive_drop_structs.get(type_name).unwrap()

        # Clone function: T T__clone(void* __p)
        out = out + cname + " " + clone_name + "(void* __p) {\n"
        out = out + "    if (!__p) { " + cname + " z = {0}; return z; }\n"
        out = out + "    " + cname + " dst = *(" + cname + "*)__p;\n"
        int di = 0
        while di < drops.len():
            FieldDrop fd = drops.get(di).unwrap()
            String access = field_access(type_name, fd.field_name, &m, &sn, false)
            String cstmt = field_clone_c(access, fd.field_type_name, fd.drop_fn_name, &m, &sn)
            if cstmt != "":
                out = out + "    " + cstmt + "\n"
            di += 1
        out = out + "    return dst;\n"
        out = out + "}\n\n"

        # Clone-inplace wrapper
        out = out + "void " + type_name + "__clone_inplace(void* __p) { *(" + cname + "*)__p = " + clone_name + "(__p); }\n\n"
        ki += 1
    return out

# Emit enum drop functions from recursive_drop_enums metadata.
String emit_enum_drops(LirModule &m, Vector[String] &sn):
    String out = ""
    Vector[String] keys = m.recursive_drop_enums.keys()
    sort_strings_in_place(&keys)
    # Forward declarations first — drop fns may call each other for nested
    # variant payloads (Outer__drop dispatches to Inner__drop on a payload
    # field). Without these, C infers implicit int return and the later
    # definition produces a "conflicting types" error.
    int kf = 0
    while kf < keys.len():
        String type_name_f = keys.get(kf).unwrap()
        String drop_name_f = type_name_f + "__drop"
        if not fn_exists(drop_name_f, &m) and not m.recursive_drop_structs.contains(type_name_f):
            out = out + "void " + drop_name_f + "(void* __p);\n"
        kf += 1
    if keys.len() > 0:
        out = out + "\n"
    int ki = 0
    while ki < keys.len():
        String type_name = keys.get(ki).unwrap()
        String drop_name = type_name + "__drop"
        if fn_exists(drop_name, &m):
            ki += 1
            continue
        # Skip if also in recursive_drop_structs (structs take priority)
        if m.recursive_drop_structs.contains(type_name):
            ki += 1
            continue
        String cname = find_c_name(type_name, &m, &sn)
        Vector[EnumVariantDrop] variants = m.recursive_drop_enums.get(type_name).unwrap()

        out = out + "void " + drop_name + "(void* __p) {\n"
        out = out + "    " + cname + "* self = (" + cname + "*)__p;\n"
        out = out + "    switch (self->tag) {\n"

        # Group by variant index
        int vi = 0
        int max_idx = -1
        int vvi = 0
        while vvi < variants.len():
            EnumVariantDrop evd = variants.get(vvi).unwrap()
            if evd.variant_index > max_idx:
                max_idx = evd.variant_index
            vvi += 1

        vi = 0
        while vi <= max_idx:
            # Collect all drops for this variant
            bool has_drops = false
            String case_body = ""
            vvi = 0
            while vvi < variants.len():
                EnumVariantDrop evd = variants.get(vvi).unwrap()
                if evd.variant_index == vi:
                    has_drops = true
                    String access = field_access(type_name, evd.field_name, &m, &sn, true)
                    # `free` and other drop fns must both go through field_access
                    # so the union-layout `self->data.<vname>.<fname>` path is
                    # used consistently. The bare `self->fname` path generates
                    # `error: '__gg_Expr' has no member named 'EBinaryOp_0'`
                    # because EBinaryOp_0 lives inside `data.EBinaryOp.` for
                    # multi-field variants.
                    if evd.drop_fn_name == "free":
                        case_body = case_body + "            free(" + access + ");\n"
                    else:
                        case_body = case_body + "            " + evd.drop_fn_name + "(&" + access + ");\n"
                vvi += 1
            out = out + "        case " + int_to_str(vi) + ":"
            if has_drops:
                out = out + "\n" + case_body + "            break;\n"
            else:
                out = out + " break;\n"
            vi += 1
        out = out + "    }\n"
        out = out + "}\n\n"
        ki += 1
    return out

# Emit enum clone functions from recursive_drop_enums metadata.
String emit_enum_clones(LirModule &m, Vector[String] &sn):
    String out = ""
    Vector[String] keys = m.recursive_drop_enums.keys()
    sort_strings_in_place(&keys)
    # Forward declarations to prevent implicit-decl conflicts. Same
    # rationale as emit_struct_clones (mutual references between
    # T__clone() and U__clone() when T contains U).
    int kf = 0
    while kf < keys.len():
        String type_name_f = keys.get(kf).unwrap()
        String clone_name_f = type_name_f + "__clone"
        if not fn_exists(clone_name_f, &m) and not m.recursive_drop_structs.contains(type_name_f):
            String cname_f = find_c_name(type_name_f, &m, &sn)
            out = out + cname_f + " " + clone_name_f + "(void* __p);\n"
        kf += 1
    if keys.len() > 0:
        out = out + "\n"
    int ki = 0
    while ki < keys.len():
        String type_name = keys.get(ki).unwrap()
        String clone_name = type_name + "__clone"
        if fn_exists(clone_name, &m):
            ki += 1
            continue
        if m.recursive_drop_structs.contains(type_name):
            ki += 1
            continue
        String cname = find_c_name(type_name, &m, &sn)
        Vector[EnumVariantDrop] variants = m.recursive_drop_enums.get(type_name).unwrap()

        out = out + cname + " " + clone_name + "(void* __p) {\n"
        out = out + "    if (!__p) { " + cname + " z = {0}; return z; }\n"
        out = out + "    " + cname + " dst = *(" + cname + "*)__p;\n"
        out = out + "    switch (dst.tag) {\n"

        int max_idx = -1
        int vvi = 0
        while vvi < variants.len():
            EnumVariantDrop evd = variants.get(vvi).unwrap()
            if evd.variant_index > max_idx:
                max_idx = evd.variant_index
            vvi += 1

        int vi = 0
        while vi <= max_idx:
            bool has_clones = false
            String case_body = ""
            vvi = 0
            while vvi < variants.len():
                EnumVariantDrop evd = variants.get(vvi).unwrap()
                if evd.variant_index == vi:
                    String access = field_access(type_name, evd.field_name, &m, &sn, false)
                    String cstmt = field_clone_c(access, evd.field_type_name, evd.drop_fn_name, &m, &sn)
                    if cstmt != "":
                        has_clones = true
                        case_body = case_body + "            " + cstmt + "\n"
                vvi += 1
            out = out + "        case " + int_to_str(vi) + ":"
            if has_clones:
                out = out + "\n" + case_body + "            break;\n"
            else:
                out = out + " break;\n"
            vi += 1
        out = out + "    }\n"
        out = out + "    return dst;\n"
        out = out + "}\n\n"

        # Clone-inplace wrapper
        out = out + "void " + type_name + "__clone_inplace(void* __p) { *(" + cname + "*)__p = " + clone_name + "(__p); }\n\n"
        ki += 1
    return out

# Emit unified drop/clone functions from type_drop_fns metadata.
String emit_type_drop_fns(LirModule &m, Vector[String] &sn):
    String out = ""
    Vector[String] keys = m.type_drop_fns.keys()
    sort_strings_in_place(&keys)
    int ki = 0
    while ki < keys.len():
        String type_name = keys.get(ki).unwrap()
        TypeDropInfo info = m.type_drop_fns.get(type_name).unwrap()

        # Skip if already handled by recursive_drop_* or user-defined
        if m.recursive_drop_structs.contains(type_name):
            ki += 1
            continue
        if m.recursive_drop_enums.contains(type_name):
            ki += 1
            continue
        if fn_exists(info.drop_fn_name, &m):
            ki += 1
            continue

        String cname = find_c_name(type_name, &m, &sn)
        bool is_enum = info.enum_variants.len() > 0

        # Drop function
        out = out + "void " + info.drop_fn_name + "(void* __p) {\n"
        out = out + "    " + cname + "* self = (" + cname + "*)__p;\n"
        if info.user_drop_fn != "":
            out = out + "    " + info.user_drop_fn + "(__p);\n"
        if is_enum:
            out = out + "    switch (self->tag) {\n"
            int max_idx = -1
            int vvi = 0
            while vvi < info.enum_variants.len():
                EnumVariantDrop evd = info.enum_variants.get(vvi).unwrap()
                if evd.variant_index > max_idx:
                    max_idx = evd.variant_index
                vvi += 1
            int vi = 0
            while vi <= max_idx:
                bool has_drops = false
                String case_body = ""
                vvi = 0
                while vvi < info.enum_variants.len():
                    EnumVariantDrop evd = info.enum_variants.get(vvi).unwrap()
                    if evd.variant_index == vi:
                        has_drops = true
                        String access = field_access(type_name, evd.field_name, &m, &sn, true)
                        if evd.drop_fn_name == "free":
                            case_body = case_body + "            free(self->" + c_field_name(evd.field_name) + ");\n"
                        else:
                            case_body = case_body + "            " + evd.drop_fn_name + "(&" + access + ");\n"
                    vvi += 1
                out = out + "        case " + int_to_str(vi) + ":"
                if has_drops:
                    out = out + "\n" + case_body + "            break;\n"
                else:
                    out = out + " break;\n"
                vi += 1
            out = out + "    }\n"
        else:
            int di = 0
            while di < info.field_drops.len():
                FieldDrop fd = info.field_drops.get(di).unwrap()
                String access = field_access(type_name, fd.field_name, &m, &sn, true)
                if fd.drop_fn_name == "free":
                    out = out + "    free(" + access + ");\n"
                else:
                    out = out + "    " + fd.drop_fn_name + "(&" + access + ");\n"
                di += 1
        out = out + "}\n\n"

        # Clone function
        String clone_name = type_name + "__clone"
        if not fn_exists(clone_name, &m):
            out = out + cname + " " + clone_name + "(void* __p) {\n"
            out = out + "    if (!__p) { " + cname + " z = {0}; return z; }\n"
            out = out + "    " + cname + " dst = *(" + cname + "*)__p;\n"
            if is_enum:
                out = out + "    switch (dst.tag) {\n"
                int max_idx2 = -1
                int vvi2 = 0
                while vvi2 < info.enum_variants.len():
                    EnumVariantDrop evd = info.enum_variants.get(vvi2).unwrap()
                    if evd.variant_index > max_idx2:
                        max_idx2 = evd.variant_index
                    vvi2 += 1
                int vi2 = 0
                while vi2 <= max_idx2:
                    bool has_clones = false
                    String case_body = ""
                    vvi2 = 0
                    while vvi2 < info.enum_variants.len():
                        EnumVariantDrop evd = info.enum_variants.get(vvi2).unwrap()
                        if evd.variant_index == vi2:
                            String access = field_access(type_name, evd.field_name, &m, &sn, false)
                            String cstmt = field_clone_c(access, evd.field_type_name, evd.drop_fn_name, &m, &sn)
                            if cstmt != "":
                                has_clones = true
                                case_body = case_body + "            " + cstmt + "\n"
                        vvi2 += 1
                    out = out + "        case " + int_to_str(vi2) + ":"
                    if has_clones:
                        out = out + "\n" + case_body + "            break;\n"
                    else:
                        out = out + " break;\n"
                    vi2 += 1
                out = out + "    }\n"
            else:
                int di = 0
                while di < info.field_drops.len():
                    FieldDrop fd = info.field_drops.get(di).unwrap()
                    String access = field_access(type_name, fd.field_name, &m, &sn, false)
                    String cstmt = field_clone_c(access, fd.field_type_name, fd.drop_fn_name, &m, &sn)
                    if cstmt != "":
                        out = out + "    " + cstmt + "\n"
                    di += 1
            out = out + "    return dst;\n"
            out = out + "}\n\n"
            out = out + "void " + type_name + "__clone_inplace(void* __p) { *(" + cname + "*)__p = " + clone_name + "(__p); }\n\n"

        ki += 1
    return out

# ── Top-level code generation ──────────────────────────────

# Emit typedefs for monomorphized wrapper types.
# These types are skipped as struct definitions (they map to runtime types)
# but still need typedef'd so C code can reference them.
String emit_mono_typedefs(LirModule &m):
    StrBuf buf = sb_new()
    Dict[String, bool] seen = {}
    int si = 0
    while si < m.structs.len():
        LirStructDef sdef = m.structs.get(si).unwrap()
        if m.type_runtime_map.contains(sdef.name):
            if not seen.contains(sdef.name):
                seen.put(sdef.name.clone(), true)
                # Task__* types are self-contained inline anon structs — mirror
                # Rust c_lir/mod.rs:474 (the synthesized TaskHandle LIR struct is
                # NOT a runtime header type, so it has no standalone C decl; an
                # alias `typedef TaskHandle Task__T;` would dangle → cc-fail). Gate
                # on the typed runtime category, NOT a `Task__` name substring.
                if m.type_runtime_map.get(sdef.name).unwrap_or("") == "Task":
                    sb_push(&buf, "typedef struct { void* __task; void (*__drop)(void*); } ")
                    sb_push(&buf, sdef.name)
                    sb_push(&buf, ";\n")
                else:
                    String runtime_ty = mono_wrapper_runtime_type(sdef.name, &m)
                    if runtime_ty != "":
                        sb_push(&buf, "typedef ")
                        sb_push(&buf, runtime_ty)
                        sb_push(&buf, " ")
                        sb_push(&buf, sdef.name)
                        sb_push(&buf, ";\n")
        si += 1
    if buf.s.byte_len() > 0:
        sb_push(&buf, "\n")
    return buf.s

# Map a wrapper type name to its C typedef target.
# Phase A — parameterized types resolved via type_runtime_map (no starts_with);
# the three non-parameterized built-ins keep exact-name matches.
String mono_wrapper_runtime_type(String name, LirModule &m):
    if name == "TaskGroup":
        return "gorget_task_group_t*"
    if name == "AtomicInt":
        return "GorgetAtomicInt"
    if name == "AtomicBool":
        return "GorgetAtomicBool"
    # Guard contains before get (Dict.get() crashes on missing key in self-host).
    if not m.type_runtime_map.contains(name):
        return ""
    String runtime = m.type_runtime_map.get(name).unwrap_or("")
    return runtime_category_to_c_type(runtime)

# ── Test runner main ───────────────────────────────────────
#
# Mirrors Rust gg's `emit_test_runner_main`
# (src/backend/c_lir/helpers.rs:1145, called from mod.rs:1038). When a
# module contains `test "..."` blocks and NO user `main`, each test body
# is lowered to a `__test_N(void) {}` function (lower.gg gates all test
# lowering on `if not has_main`, so `__test_N` exists ⟺ no user main).
# The frontend then synthesizes a runner `main` that calls each test
# inside the panic/cleanup/capture machinery and reports a pass/fail
# tally — without it, the self-host emits one FEWER user function than
# Rust (the missing runner) and every test fixture is off-by-1 on
# `c_emit_comparison`.
#
# `test_names` are the ACTUAL emitted `__test_*` symbols in emission
# order (NON-CONTIGUOUS: an `@skip` test gets no body, so a module can
# emit `__test_0` and `__test_3` with no `__test_1`/`__test_2`). The
# runtime globals referenced here (`__gorget_test_jmp`, `__gorget_in_test`,
# …) are file-local `static`s in the spliced `panic_test.c` runtime, so
# the runner shares their translation unit. This is a SIMPLIFIED runner:
# the self-host does not model per-test should_panic / skip / timeout /
# tags / parallel-shard / results-file flags, so every emitted test is
# run as a plain pass/fail test. The signature line is emitted verbatim
# (`int main(int argc, char** argv) {` — ending `) {`) so the comparison
# harness's `user_fn_count` gate counts it.
String emit_test_runner_main(Vector[String] &test_names):
    StrBuf buf = sb_new()
    sb_push(&buf, "int main(int argc, char** argv) {\n")
    sb_push(&buf, "    gorget_init_args(argc, argv);\n")
    sb_push(&buf, "    int __test_passed = 0, __test_failed = 0, __test_skipped = 0;\n")
    sb_push(&buf, "    int __nocapture = (getenv(\"GORGET_TEST_NOCAPTURE\") != NULL);\n")
    sb_push(&buf, "    struct timespec __total_start, __total_end;\n")
    sb_push(&buf, "    clock_gettime(CLOCK_MONOTONIC, &__total_start);\n")
    sb_push(&buf, "    __gorget_snapshot_open();\n")
    sb_push(&buf, "    int __test_total = ")
    sb_push(&buf, int_to_str(test_names.len()))
    sb_push(&buf, ";\n")
    sb_push(&buf, "    printf(\"Running %d tests...\\n\", __test_total);\n")

    int ti = 0
    while ti < test_names.len():
        String fn_name = test_names.get(ti).unwrap()
        # Per-test label: the emitted `__test_N` symbol. The self-host
        # does not carry the test's source display name onto LirFunction
        # (display_name is "" for lowered test bodies), so we print the
        # function name rather than fish a name we don't have.
        sb_push(&buf, "    printf(\"  test: ")
        sb_push(&buf, fn_name)
        sb_push(&buf, " ... \");\n")
        sb_push(&buf, "    fflush(stdout);\n")
        sb_push(&buf, "    {\n")
        sb_push(&buf, "        __gorget_in_test = 1;\n")
        sb_push(&buf, "        __gorget_test_fail_msg = NULL;\n")
        sb_push(&buf, "        __gorget_test_timed_out = 0;\n")
        sb_push(&buf, "        __gorget_current_test = \"")
        sb_push(&buf, fn_name)
        sb_push(&buf, "\";\n")
        sb_push(&buf, "        int __cleanup_mark = __gorget_cleanup_top;\n")
        sb_push(&buf, "        struct timespec __t_start, __t_end;\n")
        sb_push(&buf, "        clock_gettime(CLOCK_MONOTONIC, &__t_start);\n")
        sb_push(&buf, "        __gorget_test_cleanup_mark = __cleanup_mark;\n")
        sb_push(&buf, "        if (!__nocapture) __gorget_capture_start();\n")
        sb_push(&buf, "        int __jmp_val = setjmp(__gorget_test_jmp);\n")
        sb_push(&buf, "        if (__jmp_val == 0) {\n")
        sb_push(&buf, "            ")
        sb_push(&buf, fn_name)
        sb_push(&buf, "();\n")
        sb_push(&buf, "            __gorget_cleanup_top = __cleanup_mark;\n")
        sb_push(&buf, "        }\n")
        sb_push(&buf, "        __gorget_cleanup_run(__cleanup_mark);\n")
        sb_push(&buf, "        __gorget_in_test = 0;\n")
        sb_push(&buf, "        size_t __cap_len = 0;\n")
        sb_push(&buf, "        const char *__cap_buf = __gorget_capture_end(&__cap_len);\n")
        sb_push(&buf, "        clock_gettime(CLOCK_MONOTONIC, &__t_end);\n")
        sb_push(&buf, "        long __t_ms = (__t_end.tv_sec - __t_start.tv_sec) * 1000 + (__t_end.tv_nsec - __t_start.tv_nsec) / 1000000;\n")
        sb_push(&buf, "        if (!__gorget_test_fail_msg) {\n")
        sb_push(&buf, "            __test_passed++;\n")
        sb_push(&buf, "            printf(\"PASS (%ldms)\\n\", __t_ms);\n")
        sb_push(&buf, "        } else {\n")
        sb_push(&buf, "            __test_failed++;\n")
        sb_push(&buf, "            printf(\"FAIL: %s (%ldms)\\n\", __gorget_test_fail_msg, __t_ms);\n")
        sb_push(&buf, "            if (__cap_len > 0) {\n")
        sb_push(&buf, "                printf(\"    --- captured output ---\\n\");\n")
        sb_push(&buf, "                fwrite(__cap_buf, 1, __cap_len, stdout);\n")
        sb_push(&buf, "                if (__cap_buf[__cap_len - 1] != '\\n') printf(\"\\n\");\n")
        sb_push(&buf, "                printf(\"    ---\\n\");\n")
        sb_push(&buf, "            }\n")
        sb_push(&buf, "        }\n")
        sb_push(&buf, "    }\n")
        ti += 1

    sb_push(&buf, "    clock_gettime(CLOCK_MONOTONIC, &__total_end);\n")
    sb_push(&buf, "    long __total_ms = (__total_end.tv_sec - __total_start.tv_sec) * 1000 + (__total_end.tv_nsec - __total_start.tv_nsec) / 1000000;\n")
    sb_push(&buf, "    if (__test_skipped > 0) printf(\"\\n%d passed, %d failed, %d skipped (%ldms)\\n\", __test_passed, __test_failed, __test_skipped, __total_ms);\n")
    sb_push(&buf, "    else printf(\"\\n%d passed, %d failed (%ldms)\\n\", __test_passed, __test_failed, __total_ms);\n")
    sb_push(&buf, "    __gorget_snapshot_close();\n")
    sb_push(&buf, "    return __test_failed > 0 ? 1 : 0;\n")
    sb_push(&buf, "}\n")
    return buf.s

String generate_c(LirModule &m):
    Vector[String] sn = build_struct_names(&m)

    String out = ""

    # Fallback stubs for prelude variants that fell through type inference.
    # The CORRECT path is to emit an inline struct literal with the proper
    # Result__T__E or Option__T monomorphization. When inference can't
    # determine the parameterization, the lowerer previously emitted these
    # as `#define Ok(x) ((void)(x), (int64_t)0)` which silently discarded
    # the payload — stage-1's `parse_int("42")` produced `Ok(0)` even though
    # the C extern returned 42 and stage-1 emitted `Ok(__v14)` with __v14=42,
    # because the macro threw it away.
    #
    # Now emit `#error` diagnostics so any surviving `Ok(x)` / `Some(x)` /
    # `Error(x)` / `None()` callsite surfaces as a C compile error — the
    # self-host's inference needs to be fixed at that site, not patched
    # over with a silently-lossy identity.
    #
    # Gated by GORGET_PRELUDE_FALLBACKS: defining it re-enables the legacy
    # lossy macros so builds can still link while the inference gap is
    # being worked on.
    out = out + "#if defined(GORGET_PRELUDE_FALLBACKS)\n"
    out = out + "#  define Some(x) ((void)(x), (int64_t)0)\n"
    out = out + "#  define Ok(x) ((void)(x), (int64_t)0)\n"
    out = out + "#  define Error(x) ((void)(x), (int64_t)0)\n"
    out = out + "#  define None() ((int64_t)0)\n"
    out = out + "#else\n"
    out = out + "/* Prelude variant fallbacks disabled. If cc fails below with */\n"
    out = out + "/* `implicit declaration of function 'Ok'`, the self-host's */\n"
    out = out + "/* type inference failed to monomorphize that callsite and the */\n"
    out = out + "/* bare `Ok(x)` call would otherwise silently lose x. Define */\n"
    out = out + "/* GORGET_PRELUDE_FALLBACKS=1 to re-enable the lossy fallback. */\n"
    out = out + "#endif\n\n"

    # Monomorphized wrapper typedefs (Vector__T, Dict__T, Channel__T, etc.)
    # Emit FIRST so struct field types like `Box__SpannedExpr` (void*) are
    # visible when the enclosing struct body is emitted.
    out = out + emit_mono_typedefs(&m)

    # Struct definitions
    out = out + emit_structs(&m, &sn)

    # Extern declarations
    out = out + emit_externs(&m, &sn)

    # Globals
    out = out + emit_globals(&m, &sn)

    # String literal pool
    Vector[StringLitEntry] slits = collect_string_lits(&m)
    Dict[String, int] slit_map = build_string_lit_map(&slits)
    out = out + emit_string_lits(&slits)

    # Function forward declarations
    out = out + emit_func_forward_decls(&m, &sn)

    # Hashable-key bridges. Must come AFTER forward decls (the bridges
    # call `T__hash` / `T__eq`) and BEFORE function bodies that
    # reference `__gorget_ktable_hash__T` / `__gorget_ktable_eq__T` via
    # ctor wiring.
    out = out + emit_hashable_key_bridges(&m)

    # Deferred globals (FuncAddr-bearing: GINIT_STRUCT vtables + scalar
    # GINIT_FUNC_ADDR). Emitted HERE — after forward-decls + hashable-key
    # bridges, before adapter functions — so the `(void*)&fn` casts
    # reference already-forward-declared functions. Mirrors Rust gg's
    # deferred-global emission in `src/backend/c_lir/mod.rs:857-864`.
    out = out + emit_deferred_globals(&m, &sn)

    # Adapter functions (FuncAddr → closure protocol)
    Dict[int, bool] fa_targets = collect_func_addr_targets(&m)
    out = out + emit_adapter_functions(&m, &sn, &fa_targets)

    # Emit function bodies to a temp buffer so we can scan them for
    # __gorget_box_alloc_* occurrences (codegen rewrites Box(x) → alloc at
    # emit time, so the call doesn't appear in LIR form).
    String body = ""
    # Pre-emit ALL drop + clone forward declarations BEFORE any definitions.
    # Struct drop/clone can call enum drop/clone (e.g. BasicBlock__clone
    # calls Terminator__clone) and vice versa. Without one cohesive
    # forward-decl block, the first cross-category call hits an implicit
    # int return type and the later definition produces a "conflicting
    # types" error. Each emit_X also has its own inline forward-decl
    # loop; the duplicate declarations are harmless (C allows them).
    body = body + emit_all_drop_clone_forward_decls(&m, &sn)
    body = body + emit_struct_drops(&m, &sn)
    body = body + emit_struct_clones(&m, &sn)
    body = body + emit_enum_drops(&m, &sn)
    body = body + emit_enum_clones(&m, &sn)
    body = body + emit_type_drop_fns(&m, &sn)

    # Use sb_push (in-place append) instead of `body = body + ...` —
    # the latter is O(N) per concat, O(N²) overall. For 600+ functions
    # producing a few MB total, the naive concat OOM-kills stage-1.
    # Mirrors src/backend/c_lir/mod.rs:`out: &mut String`.
    Vector[bool] reachable_body = compute_reachable_fns(&m)

    # Test-mode detection (metadata-free): the self-host's
    # `LirModule.test_fns` / `is_test_module` are NEVER populated
    # (constructed empty in lir_lower.gg), so we scan the REACHABLE
    # functions for emitted `__test_*` bodies. Collecting the actual
    # names here (not a `0..count` loop) handles the non-contiguous
    # indices that `@skip` produces. `has_test_runner` is true ⟺ any
    # `__test_*` is emitted ⟺ (per lower.gg's `if not has_main` gate) the
    # module has NO user `main`.
    Vector[String] test_names = []
    int tfi = 0
    while tfi < m.functions.len():
        if reachable_body.get(tfi).unwrap():
            String tfname = m.functions.get(tfi).unwrap().name
            if tfname.starts_with("__test_"):
                test_names.push(tfname.clone())
        tfi += 1
    bool has_test_runner = test_names.len() > 0

    StrBuf body_buf = StrBuf(body)
    sb_push(&body_buf, "// ── Function Definitions ──\n")
    int fi = 0
    while fi < m.functions.len():
        if not reachable_body.get(fi).unwrap():
            fi += 1
            continue
        # In test-mode the user `main` is replaced by the synthesized
        # runner. This guard mirrors Rust gg (mod.rs:1026) and is
        # future-proof, though it can never actually fire in the
        # self-host: `__test_*` exists ⟺ no user `main`.
        if has_test_runner and m.functions.get(fi).unwrap().name == "main":
            fi += 1
            continue
        # Pass the function as a BORROW to emit_function — `LirFunction func
        # = m.functions.get(fi).unwrap()` value-binds and deep-clones the
        # whole function per emitted definition (a generate_c clone consumer).
        sb_push(&body_buf, emit_function(&m.functions.get(fi).unwrap(), &m, &sn, &slit_map))
        sb_push(&body_buf, "\n")
        fi += 1

    # Synthesize the test-runner `main` AFTER the function loop (so it
    # lands in body_buf, past the `// ── Function Definitions ──` marker
    # the `user_fn_count` gate counts from). Calls each emitted
    # `__test_*` in emission order.
    if has_test_runner:
        sb_push(&body_buf, emit_test_runner_main(&test_names))
        sb_push(&body_buf, "\n")

    body = body_buf.s

    # Box allocator helpers: scan ICallExtern/ICall instructions directly
    # for Box__T references. Originally scanned the emitted body string,
    # but stage-1's runtime `body.slice()` / `index_of` mishandles 9MB
    # strings, leaving the box allocators undefined at link time. The
    # LIR-based scan is robust regardless.
    out = out + emit_box_allocators_from_lir(&m)

    out = out + body
    return out

# ════════════════════════════════════════════════════════════════════
# Chain 2 — full-program runtime preamble
#
# Ports Rust's `emit_runtime_modules` (src/backend/c_lir/emit_types.rs:1791)
# + `emit_lir_helpers` (:2308) into the self-host so `driver F lib --emit-c`
# emits a COMPLETE, standalone `.c` (runtime preamble + body) — no external
# splice. The 62 shared runtime `.c` files at `src/backend/c/runtime/` are read
# at emit time and conditionally concatenated in the SAME top-to-bottom order
# as the Rust source (a misordered dependency yields a `.c` that won't compile).
#
# The string is built with StrBuf/sb_push (NOT `out = out + X`): the latter is
# O(N²) and OOM-kills stage-1, and `&String`/`&bool` mutable-ref helpers
# MISCOMPILE in the self-host — sb_push mutates a StrBuf STRUCT through a
# pointer, which works. Emit-once flags are plain function-local bools.
# ════════════════════════════════════════════════════════════════════

# Read a runtime `.c` file and FAIL LOUD on an empty/missing read. read_file
# returns "" silently on a bad path; every runtime `.c` is non-empty, so an
# empty read ALWAYS means a wrong path → exit(1), don't emit a broken preamble.
String read_runtime(String rdir, String name):
    String s = read_file(rdir + "/" + name)
    if s.byte_len() == 0:
        print("error: runtime file " + name + " empty or missing at " + rdir, file=stderr)
        exit(1)
    return s

# any name in `names` starts with `prefix` (mirrors Rust `has(&|n| n.starts_with(...))`)
bool cn_has_prefix(Vector[String] &names, String prefix):
    int i = 0
    while i < names.len():
        if names.get(i).unwrap().starts_with(prefix):
            return true
        i += 1
    return false

# any name in `names` == `exact`
bool cn_has_eq(Vector[String] &names, String exact):
    int i = 0
    while i < names.len():
        if names.get(i).unwrap() == exact:
            return true
        i += 1
    return false

# any name in `names` contains `sub` (mirrors Rust `n.contains(...)`)
bool cn_has_contains(Vector[String] &names, String sub):
    int i = 0
    while i < names.len():
        if names.get(i).unwrap().contains(sub):
            return true
        i += 1
    return false

# Mirror Rust's `recursive_drop_fn_used` closure (emit_types.rs:1942): true if
# any recursive-drop struct field OR enum-variant payload resolves to
# `drop_fn` (a stable runtime drop symbol). The self-host's LirStructDef has no
# `elem_drop_fn` field (see lir.gg:270) — this scan + the name-prefix check are
# the surviving collection-presence disjuncts.
bool recursive_drop_fn_used(LirModule &m, String drop_fn):
    Vector[String] rds_keys = m.recursive_drop_structs.keys()
    int rk = 0
    while rk < rds_keys.len():
        Vector[FieldDrop] fds = m.recursive_drop_structs.get(rds_keys.get(rk).unwrap()).unwrap()
        int fk = 0
        while fk < fds.len():
            if fds.get(fk).unwrap().drop_fn_name == drop_fn:
                return true
            fk += 1
        rk += 1
    Vector[String] rde_keys = m.recursive_drop_enums.keys()
    int ek = 0
    while ek < rde_keys.len():
        Vector[EnumVariantDrop] evds = m.recursive_drop_enums.get(rde_keys.get(ek).unwrap()).unwrap()
        int vk = 0
        while vk < evds.len():
            if evds.get(vk).unwrap().drop_fn_name == drop_fn:
                return true
            vk += 1
        ek += 1
    return false

# Build the call-name set scanned by the family predicates: extern names +
# function names + every body ICallExtern name + every global's init_expr
# (the latter holds full C call exprs like "gorget_math_infinity()" for
# GINIT_RUNTIME_CALL globals — a fixture whose ONLY runtime-family trigger is a
# static global would otherwise miss its family and fail to link; the prefix
# matcher works directly since "gorget_math_" matches "gorget_math_infinity()").
Vector[String] build_all_call_names(LirModule &m):
    Vector[String] names = []
    int ei = 0
    while ei < m.externs.len():
        names.push(m.externs.get(ei).unwrap().name)
        ei += 1
    int fi = 0
    while fi < m.functions.len():
        names.push(m.functions.get(fi).unwrap().name)
        fi += 1
    fi = 0
    while fi < m.functions.len():
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case ICallExtern(_, name, _, _, _):
                        names.push(name)
                    else:
                        pass
                ii += 1
            bi += 1
        fi += 1
    int gi = 0
    while gi < m.globals.len():
        String ie = m.globals.get(gi).unwrap().init_expr
        if ie.byte_len() > 0:
            names.push(ie)
        gi += 1
    return names

# ── String-extended block predicate (emit_types.rs:1853-1871) ──
# Early-return-per-prefix (the Rust source is one big `||` chain; the self-host
# lexer has no backslash line-continuation, so split into statements).
bool needs_string_extended(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_str_to_upper") or cn_has_prefix(&n, "gorget_str_to_lower"): return true
    if cn_has_prefix(&n, "gorget_str_is_alpha") or cn_has_prefix(&n, "gorget_str_is_upper"): return true
    if cn_has_prefix(&n, "gorget_str_is_lower") or cn_has_prefix(&n, "gorget_str_is_digit"): return true
    if cn_has_prefix(&n, "gorget_str_is_whitespace"): return true
    if cn_has_prefix(&n, "gorget_str_contains") or cn_has_prefix(&n, "gorget_str_starts_with"): return true
    if cn_has_prefix(&n, "gorget_str_ends_with") or cn_has_prefix(&n, "gorget_str_find"): return true
    if cn_has_prefix(&n, "gorget_memmem"): return true
    if cn_has_prefix(&n, "gorget_str_trim") or cn_has_prefix(&n, "gorget_str_replace"): return true
    if cn_has_prefix(&n, "gorget_str_repeat") or cn_has_prefix(&n, "gorget_str_pad"): return true
    if cn_has_prefix(&n, "gorget_str_strip") or cn_has_prefix(&n, "gorget_str_lstrip"): return true
    if cn_has_prefix(&n, "gorget_str_rstrip") or cn_has_prefix(&n, "gorget_str_removeprefix"): return true
    if cn_has_prefix(&n, "gorget_str_removesuffix") or cn_has_prefix(&n, "gorget_str_index_of"): return true
    if cn_has_prefix(&n, "gorget_str_count") or cn_has_prefix(&n, "gorget_str_center"): return true
    if cn_has_prefix(&n, "gorget_str_ljust") or cn_has_prefix(&n, "gorget_str_rjust"): return true
    if cn_has_prefix(&n, "gorget_str_zfill") or cn_has_prefix(&n, "gorget_str_reverse"): return true
    if cn_has_prefix(&n, "gorget_str_encode_") or cn_has_prefix(&n, "gorget_str_decode_"): return true
    if cn_has_prefix(&n, "gorget_base64_") or cn_has_prefix(&n, "gorget_json_escape"): return true
    if cn_has_prefix(&n, "gorget_str_to_json") or cn_has_prefix(&n, "gorget_str_from_json"): return true
    if cn_has_prefix(&n, "gorget_uint8_is_") or cn_has_prefix(&n, "gorget_uint8_to_"): return true
    return false

# ── needs_sync (emit_types.rs:2081) ──
bool needs_sync_pred(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_atomic_int_") or cn_has_prefix(&n, "gorget_atomic_bool_"): return true
    if cn_has_prefix(&n, "gorget_atomic_") or cn_has_prefix(&n, "gorget_barrier_"): return true
    if cn_has_prefix(&n, "gorget_condvar_") or cn_has_prefix(&n, "gorget_rwlock_"): return true
    if cn_has_prefix(&n, "gorget_waitgroup_") or cn_has_prefix(&n, "gorget_semaphore_"): return true
    if cn_has_prefix(&n, "gorget_onceflag_"): return true
    if cn_has_prefix(&n, "gorget_read_guard_") or cn_has_prefix(&n, "gorget_write_guard_"): return true
    if cn_has_prefix(&n, "ReadGuard__") or cn_has_prefix(&n, "WriteGuard__"): return true
    return false

# ── needs_async (emit_types.rs:2094) ──
bool needs_async_pred(Vector[String] &n):
    if cn_has_contains(&n, "channel") or cn_has_contains(&n, "Channel"): return true
    if cn_has_prefix(&n, "gorget_mutex_") or cn_has_prefix(&n, "gorget_guard_"): return true
    if cn_has_prefix(&n, "gorget_executor_") or cn_has_eq(&n, "gorget_spawn"): return true
    if cn_has_prefix(&n, "__gorget_spawn_") or cn_has_prefix(&n, "__gorget_await_"): return true
    if cn_has_prefix(&n, "gorget_task_group_") or cn_has_prefix(&n, "gorget_reactor_"): return true
    if cn_has_prefix(&n, "Mutex__") or cn_has_prefix(&n, "RWLock__"): return true
    return false

# ── needs_spawn (emit_types.rs:2193) ──
bool needs_spawn_pred(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_process_spawn") or cn_has_prefix(&n, "gorget_process_wait"): return true
    if cn_has_prefix(&n, "gorget_process_kill") or cn_has_prefix(&n, "gorget_process_pid"): return true
    if cn_has_prefix(&n, "gorget_process_read_") or cn_has_prefix(&n, "gorget_process_write_"): return true
    if cn_has_prefix(&n, "gorget_process_close_"): return true
    if cn_has_prefix(&n, "gorget_signal_") or cn_has_eq(&n, "gorget_getpid"): return true
    return false


# Emit the full runtime preamble: the conditionally-selected runtime `.c` files
# followed by emit_lir_helpers, in the SAME order as Rust's emit_runtime_modules
# (emit_types.rs:1791-2302). Returns the preamble text; the driver prepends it
# to generate_c(&lir) for `--emit-c`.
#
# Self-host deviations from the Rust source (all per the executor brief):
#   - `clone_stats` field is ABSENT → default false → SKIP RUNTIME_CLONE_STATS.
#   - `target`/freestanding is ABSENT → default hosted → SKIP the freestanding
#     early-return; always emit the full hosted preamble.
#   - LirStructDef has no `elem_drop_fn` field → the array/map/set triggers lose
#     the `s.elem_drop_fn==Some(...)` disjunct; the recursive_drop_fn_used +
#     name-prefix disjuncts survive.
#   - emit-once is open-coded with plain function-local bools (a `bool &flag`
#     helper would miscompile — see file header on the StrBuf idiom).
String emit_runtime_preamble(LirModule &m, String runtime_dir):
    String rdir = runtime_dir
    Vector[String] n = build_all_call_names(&m)
    StrBuf buf = sb_new()

    # ── Minimal preamble (headers, allocator, scoped alloc stubs) ──
    sb_push(&buf, read_runtime(rdir, "runtime_preamble.c"))

    # ── Conditional allocators ──
    if cn_has_prefix(&n, "gorget_arena_") or cn_has_prefix(&n, "GorgetArena"):
        sb_push(&buf, read_runtime(rdir, "runtime_arena_alloc.c"))
    if cn_has_prefix(&n, "gorget_tracking_"):
        sb_push(&buf, read_runtime(rdir, "runtime_tracking_alloc.c"))
    if cn_has_prefix(&n, "gorget_pool_") or cn_has_prefix(&n, "GorgetPool"):
        sb_push(&buf, read_runtime(rdir, "runtime_pool_alloc.c"))
    if cn_has_prefix(&n, "gorget_tlsf_"):
        sb_push(&buf, read_runtime(rdir, "runtime_tlsf_alloc.c"))
    if cn_has_prefix(&n, "gorget_fba_") or cn_has_prefix(&n, "gorget_fixed_buffer_"):
        sb_push(&buf, read_runtime(rdir, "runtime_fixedbuf_alloc.c"))
    if cn_has_prefix(&n, "gorget_fallback_"):
        sb_push(&buf, read_runtime(rdir, "runtime_fallback_alloc.c"))

    # ── String types and operations ──
    sb_push(&buf, read_runtime(rdir, "runtime_string.c"))

    # Extended string methods (unicode tables, search, split/replace/trim/etc.)
    if needs_string_extended(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_string_extended.c"))

    # Base string operations (Str-aware concat, append, cstr conversion)
    sb_push(&buf, read_runtime(rdir, "runtime_string_base_ops.c"))

    # ── Alloc report (test/bench mode only) ──
    bool is_test_or_bench = m.test_fns.len() > 0 or m.bench_fns.len() > 0 or m.is_test_module
    if is_test_or_bench:
        sb_push(&buf, read_runtime(rdir, "runtime_alloc_report.c"))

    # ── Clone stats report: `clone_stats` field ABSENT → default false → skip. ──

    # ── Panic handler ──
    if not is_test_or_bench:
        sb_push(&buf, read_runtime(rdir, "panic_normal.c"))
    else:
        sb_push(&buf, read_runtime(rdir, "panic_test.c"))

    # ── Conditional core sections ──
    # emit-once flags (plain function-local bools — see the StrBuf note in the
    # file header; a `bool &flag` helper miscompiles).
    bool emitted_array = false
    bool emitted_map = false

    # Checked arithmetic
    if cn_has_prefix(&n, "gorget_checked_") or cn_has_prefix(&n, "GORGET_CHECKED_"):
        sb_push(&buf, read_runtime(rdir, "runtime_checked_arith.c"))

    # Collections: Array
    bool vector_struct_present = recursive_drop_fn_used(&m, "gorget_array_free")
    if vector_struct_present or cn_has_prefix(&n, "gorget_array_") or cn_has_prefix(&n, "Vector__"):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true

    # String/Array operations (join, split, iterators — needs RUNTIME_ARRAY)
    if pred_string_array(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_string_array.c"))

    # Collections: Map (depends on Array)
    bool map_struct_present = recursive_drop_fn_used(&m, "gorget_map_free")
    if map_struct_present or pred_map(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        if not emitted_map:
            sb_push(&buf, read_runtime(rdir, "runtime_map.c"))
            emitted_map = true

    # Collections: Set (depends on Map)
    bool set_struct_present = recursive_drop_fn_used(&m, "gorget_set_free")
    if set_struct_present or pred_set(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        if not emitted_map:
            sb_push(&buf, read_runtime(rdir, "runtime_map.c"))
            emitted_map = true
        sb_push(&buf, read_runtime(rdir, "runtime_set.c"))

    # Error handling (test/bench mode or explicit catch/throw)
    if is_test_or_bench or pred_error(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_error.c"))

    # File I/O (depends on Array for read_file_bytes)
    if pred_file(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_file.c"))

    # Path functions + readdir (depends on Array for readdir)
    if pred_path(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_path.c"))

    # CLI args (needs RUNTIME_ARRAY)
    if cn_has_eq(&n, "gorget_args"):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_args.c"))

    # Parsing (also detects int__parse/float__parse codegen patterns)
    if cn_has_prefix(&n, "gorget_parse_int") or cn_has_prefix(&n, "gorget_parse_float") or cn_has_prefix(&n, "gorget_try_parse") or parse_method_present(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_parse.c"))

    # to_str conversions
    if pred_tostr(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_tostr.c"))

    # Environment
    if pred_env(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_env.c"))

    # Interactive I/O, time, datetime, random, line input (depends on Array)
    if pred_io(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_io.c"))

    # Math
    if pred_math(&n):
        sb_push(&buf, read_runtime(rdir, "runtime_math.c"))

    # Sort comparators (depends on Array)
    if pred_sort(&n):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "runtime_sort.c"))

    # Blank line between core sections and sync/async sections (emit_types.rs:2078)
    sb_push(&buf, "\n")

    # Sync primitives
    bool needs_sync = needs_sync_pred(&n)
    if needs_sync:
        sb_push(&buf, read_runtime(rdir, "sync_runtime.c"))

    # Async core (compute needs_async FIRST — channel/mutex re-append it below)
    bool needs_async = needs_async_pred(&n)
    if needs_async:
        sb_push(&buf, read_runtime(rdir, "async_runtime.c"))
        sb_push(&buf, read_runtime(rdir, "task_common.c"))
        if m.scheduler_mode == SCHED_POOL:
            sb_push(&buf, read_runtime(rdir, "scheduler_pool_runtime.c"))
        elif m.scheduler_mode == SCHED_THREAD:
            sb_push(&buf, read_runtime(rdir, "scheduler_thread_runtime.c"))
        elif m.scheduler_mode == SCHED_INLINE:
            sb_push(&buf, read_runtime(rdir, "scheduler_inline_runtime.c"))
        elif m.scheduler_mode == SCHED_SINGLE:
            sb_push(&buf, read_runtime(rdir, "scheduler_single_runtime.c"))
        sb_push(&buf, read_runtime(rdir, "main_waker_runtime.c"))
        # EXECUTOR_RUNTIME is the empty const — emit nothing (no file).

    # Channels (also triggered by monomorphized Channel__T methods)
    if cn_has_prefix(&n, "gorget_channel_") or cn_has_prefix(&n, "Channel__"):
        if not needs_async:
            sb_push(&buf, read_runtime(rdir, "async_runtime.c"))
        sb_push(&buf, read_runtime(rdir, "channel_runtime.c"))

    # Shared / Weak references
    if cn_has_prefix(&n, "gorget_shared_") or cn_has_prefix(&n, "gorget_weak_") or cn_has_prefix(&n, "Shared__") or cn_has_prefix(&n, "Weak__"):
        sb_push(&buf, read_runtime(rdir, "shared_runtime.c"))

    # Mutex / Guard
    if pred_mutex(&n):
        if not needs_async:
            sb_push(&buf, read_runtime(rdir, "async_runtime.c"))
        sb_push(&buf, read_runtime(rdir, "mutex_runtime.c"))

    # Reactor (async I/O, sleep, timers)
    if cn_has_prefix(&n, "gorget_reactor_") or cn_has_prefix(&n, "gorget_sleep_async"):
        sb_push(&buf, read_runtime(rdir, "reactor_runtime.c"))

    # Blocking pool — also needed for spawned functions
    if cn_has_prefix(&n, "gorget_blocking_") or m.spawned_fns.len() > 0:
        sb_push(&buf, read_runtime(rdir, "blocking_pool_runtime.c"))

    # Task groups
    if cn_has_prefix(&n, "gorget_task_group_"):
        sb_push(&buf, read_runtime(rdir, "task_group_runtime.c"))

    # Bytes
    if cn_has_prefix(&n, "gorget_bytes_"):
        sb_push(&buf, read_runtime(rdir, "bytes_runtime.c"))

    # Crypto
    if pred_crypto(&n):
        sb_push(&buf, read_runtime(rdir, "crypto_runtime.c"))

    # Socket (depends on Array)
    if cn_has_prefix(&n, "gorget_socket_") or cn_has_prefix(&n, "gorget_tcp_"):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "socket_runtime.c"))

    # Server socket (depends on Array)
    if cn_has_prefix(&n, "gorget_server_socket_") or cn_has_prefix(&n, "gorget_listener_"):
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "server_socket_runtime.c"))

    # UDP socket
    if cn_has_prefix(&n, "gorget_udp_"):
        sb_push(&buf, read_runtime(rdir, "udp_socket_runtime.c"))

    # TLS
    if cn_has_prefix(&n, "gorget_tls_"):
        sb_push(&buf, read_runtime(rdir, "tls_socket_runtime.c"))
        sb_push(&buf, read_runtime(rdir, "tls_server_runtime.c"))

    # Process spawn + signal handling
    bool needs_spawn = needs_spawn_pred(&n)

    # Process — also needed when spawn is used (ExecResult typedef lives here)
    if needs_spawn or cn_has_prefix(&n, "gorget_process_") or cn_has_prefix(&n, "gorget_exec_") or cn_has_eq(&n, "gorget_getenv") or cn_has_eq(&n, "gorget_setenv"):
        sb_push(&buf, read_runtime(rdir, "process_runtime.c"))

    if needs_spawn:
        if not emitted_array:
            sb_push(&buf, read_runtime(rdir, "runtime_array.c"))
            emitted_array = true
        sb_push(&buf, read_runtime(rdir, "process_spawn_runtime.c"))

    # Thread
    if cn_has_prefix(&n, "gorget_thread_") or cn_has_prefix(&n, "gorget_current_thread_id") or cn_has_prefix(&n, "__gorget_thread_spawn_") or m.thread_spawned_fns.len() > 0:
        sb_push(&buf, read_runtime(rdir, "thread_runtime.c"))

    # Trace (trace_filename is a String, "" if none)
    if m.trace_filename != "" or cn_has_prefix(&n, "gorget_trace_"):
        sb_push(&buf, read_runtime(rdir, "trace_runtime.c"))

    # SDL (needs external libs; ported faithfully but gate-excluded)
    if cn_has_prefix(&n, "sdl_") or cn_has_prefix(&n, "gorget_sdl_"):
        if cn_has_eq(&n, "sdl_load_texture") or cn_has_eq(&n, "gorget_sdl_load_texture"):
            sb_push(&buf, "#define GORGET_USE_SDL_IMAGE\n")
        if pred_sdl_ttf(&n):
            sb_push(&buf, "#define GORGET_USE_SDL_TTF\n")
        sb_push(&buf, read_runtime(rdir, "sdl_runtime.c"))

    # Bytes f32/f64/i64 helpers
    if cn_has_bytes_fp(&n):
        sb_push(&buf, read_runtime(rdir, "bytes_f32_runtime.c"))

    # OpenGL
    if cn_has_prefix(&n, "gorget_gl_"):
        sb_push(&buf, read_runtime(rdir, "gl_runtime.c"))

    # Image loading (stb_image — vendored header outside runtime/)
    if cn_has_prefix(&n, "gorget_image_"):
        sb_push(&buf, "\n#define STB_IMAGE_IMPLEMENTATION\n")
        sb_push(&buf, "#define STBI_NO_STDIO\n")
        sb_push(&buf, "#define STBI_ONLY_PNG\n")
        sb_push(&buf, "#define STBI_ONLY_JPEG\n")
        sb_push(&buf, "#define STBI_ONLY_TGA\n")
        sb_push(&buf, "#define STBI_ONLY_BMP\n")
        sb_push(&buf, "#define GORGET_HAS_STB_IMAGE 1\n")
        sb_push(&buf, "#pragma GCC diagnostic push\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wunused-function\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wunused-parameter\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wsign-compare\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wshift-negative-value\"\n")
        sb_push(&buf, read_runtime(rdir, "../stb_image.h"))
        sb_push(&buf, "\n#pragma GCC diagnostic pop\n")
        sb_push(&buf, read_runtime(rdir, "image_runtime.c"))

    # Audio (SDL2_mixer)
    if cn_has_prefix(&n, "gorget_audio_"):
        sb_push(&buf, read_runtime(rdir, "audio_runtime.c"))

    # Compression (zlib/deflate)
    if cn_has_prefix(&n, "gorget_zlib_") or cn_has_prefix(&n, "gorget_deflate_") or cn_has_prefix(&n, "gorget_crc32_"):
        sb_push(&buf, read_runtime(rdir, "compress_runtime.c"))

    # Metal (macOS Objective-C wrappers)
    if cn_has_prefix(&n, "gorget_metal_") or cn_has_prefix(&n, "gorget_sdl_metal_"):
        sb_push(&buf, read_runtime(rdir, "metal_runtime.c"))

    # SQLite (vendored amalgamation outside runtime/)
    if cn_has_prefix(&n, "gorget_sqlite_") or cn_has_eq(&n, "sqlite_open"):
        sb_push(&buf, "\n#define SQLITE_MAX_MMAP_SIZE 0\n")
        sb_push(&buf, "#define HAVE_MREMAP 0\n")
        sb_push(&buf, "#pragma GCC diagnostic push\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wunused-parameter\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wunused-variable\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wunused-function\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wimplicit-fallthrough\"\n")
        sb_push(&buf, "#pragma GCC diagnostic ignored \"-Wpedantic\"\n")
        sb_push(&buf, read_runtime(rdir, "../sqlite3/sqlite3.c"))
        sb_push(&buf, "\n#pragma GCC diagnostic pop\n")
        sb_push(&buf, read_runtime(rdir, "../sqlite3/gorget_sqlite.c"))

    # Hot-reload runtime
    if m.hot_reload:
        sb_push(&buf, read_runtime(rdir, "hot_reload_runtime.c"))

    # LIR helpers (default values, comparators, hashers, char/utf8 helpers, etc.)
    sb_push(&buf, emit_lir_helpers(&m))

    return buf.s

# RUNTIME_PARSE also fires on int__parse/uint__parse/double__parse/etc. codegen
# patterns (emit_types.rs:2022-2023): `n.ends_with("__parse") && (n.starts_with("int")
# || n.starts_with("uint") || n == "double__parse" || n == "float__parse"
# || n == "bool__parse")`.
bool parse_method_present(Vector[String] &names):
    int i = 0
    while i < names.len():
        String nm = names.get(i).unwrap()
        if nm.ends_with("__parse"):
            if nm.starts_with("int") or nm.starts_with("uint") or nm == "double__parse" or nm == "float__parse" or nm == "bool__parse":
                return true
        i += 1
    return false

# BYTES_F32_RUNTIME: `n.starts_with("gorget_bytes_") && (n.contains("f32")
# || n.contains("f64") || n.contains("i64"))` (emit_types.rs:2235).
bool cn_has_bytes_fp(Vector[String] &names):
    int i = 0
    while i < names.len():
        String nm = names.get(i).unwrap()
        if nm.starts_with("gorget_bytes_"):
            if nm.contains("f32") or nm.contains("f64") or nm.contains("i64"):
                return true
        i += 1
    return false

# Build the name set emit_lir_helpers scans: extern names + body ICallExtern
# names ONLY (mirrors Rust's `has` closure at emit_types.rs:2309-2314 — it does
# NOT scan function names or globals, unlike emit_runtime_modules' all_call_names).
Vector[String] build_helper_call_names(LirModule &m):
    Vector[String] names = []
    int ei = 0
    while ei < m.externs.len():
        names.push(m.externs.get(ei).unwrap().name)
        ei += 1
    int fi = 0
    while fi < m.functions.len():
        int bi = 0
        while bi < m.functions.get(fi).unwrap().blocks.len():
            int ii = 0
            while ii < m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.len():
                match m.functions.get(fi).unwrap().blocks.get(bi).unwrap().insts.get(ii).unwrap():
                    case ICallExtern(_, name, _, _, _):
                        names.push(name)
                    else:
                        pass
                ii += 1
            bi += 1
        fi += 1
    return names

# Port of Rust's emit_lir_helpers (emit_types.rs:2308-2401): inline-GENERATED C
# text — default-value fns, str_ord, hashers, generic/typed comparators, the
# signal.h include, and a few has(...)-gated helpers (char_chr, utf8/codepoint
# helpers, the task_group_submit macro, file_create/open wrappers). These are in
# NEITHER any self-host .gg source NOR any runtime .c — the body CALLS them
# (e.g. int64_t__default()), so a standalone .c must emit them or fail to link.
String emit_lir_helpers(LirModule &m):
    Vector[String] n = build_helper_call_names(&m)
    StrBuf buf = sb_new()

    sb_push(&buf, "// ── LIR helpers ──\n")
    if cn_has_eq(&n, "gorget_char_chr"):
        sb_push(&buf, "static inline Str gorget_char_chr(int64_t code) { return gorget_codepoint_to_utf8(code); }\n")
    # Always emit gorget_str_ord — needed by .ord() AND int(string) cast.
    sb_push(&buf, "static inline int64_t gorget_str_ord(Str s) { size_t pos = 0; return (int64_t)gorget_utf8_decode((const char*)s.data, s.len, &pos); }\n")
    # Default value functions for primitive types
    sb_push(&buf, "static inline Str gorget_str_default(void) { return GORGET_EMPTY_STR; }\n")
    sb_push(&buf, "static inline int64_t int64_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline int64_t int__default(void) { return 0; }\n")
    sb_push(&buf, "static inline int8_t int8_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline int16_t int16_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline int32_t int32_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline uint8_t uint8_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline uint16_t uint16_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline uint32_t uint32_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline uint64_t uint64_t__default(void) { return 0; }\n")
    sb_push(&buf, "static inline double double__default(void) { return 0.0; }\n")
    sb_push(&buf, "static inline double float__default(void) { return 0.0; }\n")
    sb_push(&buf, "static inline bool bool__default(void) { return false; }\n")
    # Hash functions
    sb_push(&buf, "static inline int64_t __gorget_hash_int(int64_t v) { return (int64_t)__gorget_fnv1a(&v, sizeof(v)); }\n")
    sb_push(&buf, "static inline int64_t gorget_str_hash(Str s) { return (int64_t)__gorget_hash_str_len((const char*)s.data, s.len); }\n")
    # Signal functions — minimal include when the runtime signal module is absent.
    sb_push(&buf, "#ifndef _WIN32\n")
    sb_push(&buf, "#include <signal.h>\n")
    sb_push(&buf, "#endif\n")
    # Comparison functions for sorted()
    sb_push(&buf, "static int gorget_generic_compare(const void* a, const void* b) { return memcmp(a, b, sizeof(int64_t)); }\n")
    sb_push(&buf, "static int gorget_int_compare(const void* a, const void* b) { int64_t va = *(const int64_t*)a, vb = *(const int64_t*)b; return (va > vb) - (va < vb); }\n")
    sb_push(&buf, "static int gorget_float_compare(const void* a, const void* b) { double da = *(const double*)a, db = *(const double*)b; return (da > db) - (da < db); }\n")
    sb_push(&buf, "static int gorget_str_compare(const void* a, const void* b) { Str sa = *(const Str*)a, sb = *(const Str*)b; size_t la = sa.len, lb = sb.len; size_t ml = la < lb ? la : lb; int r = ml > 0 ? memcmp(sa.data, sb.data, ml) : 0; if (r) return r; return (la > lb) - (la < lb); }\n")
    sb_push(&buf, "static inline int64_t int64_t__one(void) { return 1; }\n")
    sb_push(&buf, "static inline int64_t int__one(void) { return 1; }\n")
    sb_push(&buf, "static inline double double__one(void) { return 1.0; }\n")
    sb_push(&buf, "static inline double float__one(void) { return 1.0; }\n")

    # UTF-8 codepoint helpers (normally in emit_runtime_modules)
    if cn_has_eq(&n, "gorget_utf8_codepoint_len_at"):
        sb_push(&buf, "static inline int64_t gorget_utf8_codepoint_len_at(Str s, int64_t byte_pos) { if (byte_pos < 0 || byte_pos >= (int64_t)s.len) return 0; return (int64_t)gorget_utf8_codepoint_len(((const unsigned char*)s.data)[byte_pos]); }\n")
    if cn_has_eq(&n, "gorget_str_codepoint_at"):
        sb_push(&buf, "static inline Str gorget_str_codepoint_at(Str s, int64_t byte_pos) { if (byte_pos < 0 || byte_pos >= (int64_t)s.len) return GORGET_EMPTY_STR; int cplen = gorget_utf8_codepoint_len(((const unsigned char*)s.data)[byte_pos]); if (byte_pos + cplen > (int64_t)s.len) cplen = (int)(s.len - (size_t)byte_pos); return gorget_str_view_region((const char*)s.data + byte_pos, (size_t)cplen); }\n")

    # gorget_task_group_submit MACRO (struct-type-agnostic Task__T submit).
    if cn_has_eq(&n, "gorget_task_group_submit"):
        sb_push(&buf, "#undef gorget_task_group_submit\n")
        sb_push(&buf, "#define gorget_task_group_submit(g, task) do { \\\n")
        sb_push(&buf, "    gorget_task_group_submit_raw((g), (task).__task, (task).__drop); \\\n")
        sb_push(&buf, "    (task).__task = NULL; \\\n")
        sb_push(&buf, "} while(0)\n")

    # gorget_file_create(GorgetString* path) synthetic — calls gorget_file_open(path, "w").
    if cn_has_eq(&n, "gorget_file_create"):
        sb_push(&buf, "GorgetFile gorget_file_create(GorgetString* path) {\n")
        sb_push(&buf, "    return gorget_file_open((const char*)path->data, \"w\");\n")
        sb_push(&buf, "}\n")
    # __gorget_file_open_r wrapper — adds the "r" mode.
    if cn_has_eq(&n, "gorget_file_open"):
        sb_push(&buf, "GorgetFile __gorget_file_open_r(const char* path) {\n")
        sb_push(&buf, "    return gorget_file_open(path, \"r\");\n")
        sb_push(&buf, "}\n")
    sb_push(&buf, "\n")
    return buf.s

# ── Multi-prefix family predicates (each mirrors one Rust `has(&|n| ...)`
# disjunction; split into early-return statements because the self-host lexer
# has no backslash line-continuation). All transcribed verbatim from the Rust
# source string-for-string. ──

bool pred_string_array(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_str_join") or cn_has_prefix(&n, "gorget_str_split"): return true
    if cn_has_prefix(&n, "gorget_str_bytes") or cn_has_prefix(&n, "gorget_str_codepoints"): return true
    if cn_has_prefix(&n, "gorget_str_chars"): return true
    return false

bool pred_map(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_map_") or cn_has_prefix(&n, "gorget_dict_"): return true
    if cn_has_prefix(&n, "Dict__") or cn_has_prefix(&n, "HashMap__"): return true
    return false

bool pred_set(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_set_") or cn_has_prefix(&n, "Set__"): return true
    if cn_has_prefix(&n, "HashSet__"): return true
    return false

bool pred_error(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_catch") or cn_has_prefix(&n, "gorget_throw"): return true
    if cn_has_prefix(&n, "gorget_cleanup_"): return true
    return false

bool pred_file(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_file_"): return true
    if cn_has_eq(&n, "gorget_read_file") or cn_has_eq(&n, "gorget_write_file"): return true
    if cn_has_eq(&n, "gorget_append_file") or cn_has_eq(&n, "gorget_read_file_bytes"): return true
    if cn_has_eq(&n, "File__open") or cn_has_eq(&n, "File__create"): return true
    return false

bool pred_path(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_path_") or cn_has_eq(&n, "gorget_is_file") or cn_has_eq(&n, "gorget_is_dir"): return true
    if cn_has_prefix(&n, "gorget_mkdir") or cn_has_prefix(&n, "gorget_readdir"): return true
    if cn_has_eq(&n, "gorget_rename") or cn_has_eq(&n, "gorget_copy_file") or cn_has_eq(&n, "gorget_remove"): return true
    if cn_has_eq(&n, "gorget_basename") or cn_has_eq(&n, "gorget_dirname") or cn_has_eq(&n, "gorget_file_size"): return true
    if cn_has_eq(&n, "gorget_file_mtime"): return true
    return false

bool pred_tostr(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_int_to_str") or cn_has_prefix(&n, "gorget_float_to_str"): return true
    if cn_has_prefix(&n, "gorget_bool_to_str") or cn_has_prefix(&n, "gorget_codepoint_to_utf8"): return true
    if cn_has_prefix(&n, "gorget_char_to_str") or cn_has_prefix(&n, "gorget_int_to_binary"): return true
    if cn_has_prefix(&n, "gorget_int_to_hex") or cn_has_prefix(&n, "gorget_int_to_octal"): return true
    if cn_has_prefix(&n, "gorget_int_to_float") or cn_has_prefix(&n, "gorget_float_to_int"): return true
    if cn_has_eq(&n, "gorget_string_debug"): return true
    if cn_has_eq(&n, "gorget_char_chr") or cn_has_eq(&n, "gorget_assert_fail_values"): return true
    return false

bool pred_env(Vector[String] &n):
    if cn_has_eq(&n, "gorget_getenv") or cn_has_eq(&n, "gorget_setenv") or cn_has_eq(&n, "gorget_getcwd"): return true
    if cn_has_eq(&n, "gorget_platform") or cn_has_eq(&n, "gorget_exit"): return true
    return false

bool pred_io(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_input") or cn_has_prefix(&n, "gorget_rand"): return true
    if cn_has_prefix(&n, "gorget_seed") or cn_has_prefix(&n, "gorget_sleep_ms"): return true
    if cn_has_eq(&n, "sleep_ms"): return true
    if cn_has_prefix(&n, "gorget_time") or cn_has_prefix(&n, "gorget_format_time"): return true
    if cn_has_prefix(&n, "gorget_parse_time") or cn_has_prefix(&n, "gorget_readline"): return true
    if cn_has_prefix(&n, "gorget_dt_decompose") or cn_has_prefix(&n, "gorget_getchar"): return true
    if cn_has_prefix(&n, "gorget_term_") or cn_has_eq(&n, "gorget_is_tty"): return true
    return false

bool pred_math(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_sqrt") or cn_has_prefix(&n, "gorget_pow"): return true
    if cn_has_prefix(&n, "gorget_floor") or cn_has_prefix(&n, "gorget_ceil"): return true
    if cn_has_prefix(&n, "gorget_round") or cn_has_prefix(&n, "gorget_abs"): return true
    if cn_has_prefix(&n, "gorget_sin") or cn_has_prefix(&n, "gorget_cos"): return true
    if cn_has_prefix(&n, "gorget_tan") or cn_has_prefix(&n, "gorget_log"): return true
    if cn_has_prefix(&n, "gorget_exp") or cn_has_prefix(&n, "gorget_atan2"): return true
    if cn_has_prefix(&n, "gorget_fmod") or cn_has_eq(&n, "gorget_min") or cn_has_eq(&n, "gorget_max"): return true
    if cn_has_prefix(&n, "gorget_math_"): return true
    if cn_has_prefix(&n, "GORGET_PI") or cn_has_prefix(&n, "GORGET_E"): return true
    if cn_has_prefix(&n, "GORGET_TAU") or cn_has_prefix(&n, "GORGET_INF"): return true
    if cn_has_prefix(&n, "GORGET_NAN"): return true
    return false

bool pred_sort(Vector[String] &n):
    if cn_has_prefix(&n, "__gorget_cmp_") or cn_has_prefix(&n, "gorget_array_sort"): return true
    if cn_has_prefix(&n, "gorget_array_reverse") or cn_has_prefix(&n, "gorget_array_unique"): return true
    return false

bool pred_mutex(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_mutex_") or cn_has_prefix(&n, "gorget_guard_"): return true
    if cn_has_prefix(&n, "Mutex__") or cn_has_prefix(&n, "RWLock__"): return true
    if cn_has_prefix(&n, "Guard__") or cn_has_prefix(&n, "ReadGuard__") or cn_has_prefix(&n, "WriteGuard__"): return true
    if cn_has_prefix(&n, "gorget_rwlock_") or cn_has_prefix(&n, "gorget_read_guard_"): return true
    if cn_has_prefix(&n, "gorget_write_guard_"): return true
    return false

bool pred_crypto(Vector[String] &n):
    if cn_has_prefix(&n, "gorget_crypto_") or cn_has_prefix(&n, "gorget_sha") or cn_has_prefix(&n, "gorget_hmac"): return true
    if cn_has_prefix(&n, "gorget_x25519") or cn_has_prefix(&n, "gorget_hkdf") or cn_has_prefix(&n, "gorget_aead"): return true
    return false

bool pred_sdl_ttf(Vector[String] &n):
    if cn_has_eq(&n, "sdl_load_font") or cn_has_eq(&n, "sdl_close_font") or cn_has_eq(&n, "sdl_draw_text"): return true
    if cn_has_eq(&n, "sdl_render_text") or cn_has_eq(&n, "sdl_text_width") or cn_has_eq(&n, "sdl_text_height"): return true
    if cn_has_prefix(&n, "gorget_sdl_load_font") or cn_has_prefix(&n, "gorget_sdl_draw_text"): return true
    if cn_has_prefix(&n, "gorget_sdl_render_text"): return true
    return false
