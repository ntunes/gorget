# ── CoW resource-bind forward-scan (split out of lower.gg) ─────────────
#
# The whole-function CoW tier-2 L1 forward-scan pass: `compute_cow_scan`
# and its recursive helpers (`cow_scan_expr`/`cow_scan_stmts`/`cow_mark_*`),
# plus `cow_pristine_after` (the position-aware Branch-C-pre flip gate) and
# `cow_source_root_name`. Moved verbatim from `lower.gg` as part of the
# `lower.gg` module split (output-neutral — pure function moves, no logic
# change). `LowerCtx` and the typed mutation accessor
# `method_mutates_receiver` stay in `lower.gg` and are imported back here;
# `lower.gg` imports the three scan entry points from this module — a mutual
# import, exactly like the existing `lower` <-> `lir_lower` pair. See
# `docs/devbook/22-modules-packages.md` for the loader's whole-file-load +
# flat-merge model that makes the mutual import safe.

from std.collections import Vector, Dict
from ast import Module, Item, FunctionDef, Param, Stmt, Expr, SpannedExpr, SpannedType, ElseBranch, EquipBlock, StructDef, EnumDef, EnumVariant, Type, MatchArm
from gir import GirModule, GirFunction, GirLocal
from lower import LowerCtx, method_mutates_receiver, call_arg_lets_callee_mutate, method_arg_lets_callee_mutate

# ── CoW resource-bind forward-scan (substrate ii) ───────────────────
#
# A coarse, whole-function pre-pass over the function body's statement
# tree. Records, for every identifier NAME, whether that name is ever
# *mutated* anywhere in the body — reassigned (`x = …` / `x += …`),
# the receiver of a mutating method (`x.push(…)` / `x.set(…)` / …),
# the target of an index-store (`x[i] = …`), or taken by a `&`/`!`
# borrow. The result drives `decide_svardecl_emission`'s Branch C-pre
# resource-bind borrow-flip: a `T x = coll.get(i).unwrap()` (or
# `T x = coll[i]`) bind may borrow-alias the collection element ONLY
# when NEITHER the bound name x NOR the source-collection identifier
# coll is ever mutated. This is the self-host analog of Rust's pair
# `is_cow_unsafe_at` (dst mutated forward → unsafe to alias) +
# `is_source_mut_unsafe_at` (source collection mutated forward →
# alias dangling after realloc), collapsed from flow-sensitive
# (block, position) gating to one whole-function set.
#
# CONSERVATIVE DIRECTION: whole-fn, not position-aware. A name mutated
# only BEFORE the bind still suppresses the flip (we can't tell "before"
# from "after" without flow info). That OVER-clones (keeps the eager
# deep-clone where a flip would have been sound) but NEVER under-clones
# — the safety property. A borrow-flip only ever happens for a bind
# whose name AND source are both pristine for the whole function, which
# is exactly the read-only-borrow shape the flip targets.
#
# The scan recurses into nested blocks (while/for/if/match/with/loop/
# do/named-scope bodies) so mutations inside loops (the
# cow_borrow_outlives_push witness's `while …: v.push(...)`) are seen.

# Whether a method call mutates its receiver is decided by the TYPED
# accessor `method_mutates_receiver` (builtin `is_mutating` table + user
# `&self`/`!self` self-convention), NOT a hand name-list. The proto's
# `cow_is_mutating_method` / `cow_is_readonly_method` name-lists were
# retired here (CLAUDE.md "No name matching"); `gmod` is threaded through
# the scan so the accessor can resolve the receiver type.

# If `e` is a bare `EIdentifier(name)`, mark `name` mutated. Also walks a
# field-path / index BASE down to its root identifier (`h.items` /
# `m[i]` mutate the owning container `h` / `m`) — structural, not a name
# list (the break3c field-path-heap-UAF fix).
# `pos` is the textual `span.start` of the MUTATION site (not of `e`).
# `in_closure` true means the mutation is textually inside a closure body
# (its run-time order bears no relation to `pos`) → route the name into
# `cow_closure_mutated` (NEVER-pristine) instead of the position-aware
# `cow_mut_max_span` (property (d)). The `max`-merge into `cow_mut_max_span`
# is load-bearing — see the field docstring.
void cow_mark_name(LowerCtx &ctx, String idn, int pos, bool in_closure):
    ctx.cow_mutated_names.put(idn, true)
    if in_closure:
        ctx.cow_closure_mutated.put(idn, true)
    else:
        int prev = -1
        if ctx.cow_mut_max_span.contains(idn):
            prev = ctx.cow_mut_max_span.get(idn).unwrap()
        if pos > prev:
            ctx.cow_mut_max_span.put(idn, pos)

# Record the root identifier of an EMove operand in `cow_moved_names`
# (the #37 Phase 2 lazy-bind eligibility exclusion). Same structural
# root walk as cow_mark_if_ident.
void cow_mark_moved_root(LowerCtx &ctx, SpannedExpr e):
    match e.expr:
        case EIdentifier(mvr_idn):
            ctx.cow_moved_names.put(mvr_idn, true)
        case EFieldAccess(mvr_base, _):
            cow_mark_moved_root(&ctx, *mvr_base)
        case EIndex(mvr_base, _):
            cow_mark_moved_root(&ctx, *mvr_base)
        else:
            pass

void cow_mark_if_ident(LowerCtx &ctx, SpannedExpr e, int pos, bool in_closure):
    match e.expr:
        case EIdentifier(idn):
            cow_mark_name(&ctx, idn, pos, in_closure)
        case EFieldAccess(base_box, _):
            cow_mark_if_ident(&ctx, *base_box, pos, in_closure)
        case EIndex(base_box, _):
            cow_mark_if_ident(&ctx, *base_box, pos, in_closure)
        else:
            pass

# Forward-walk one expression, recording any mutation it performs AND
# recursing into nested closures/blocks. Mutations recorded:
#   • `x.push(…)` / a method whose TYPED self-convention is mutating on a
#     bare-ident (or field-path/index-base) receiver → mark the root x
#   • `&x` / `!x` (EMutableBorrow / EMove) on a bare ident → mark x
# Reads (EIndex base, read-only method receivers, call args) are NOT
# marked — only an actual mutation marks the name. The walk still recurses
# through every sub-expression so a mutation nested inside (e.g.
# `f(g(x.push(1)))`) is caught.
# `in_closure` true once we are scanning textually inside a closure body
# (recursively); any mutation seen there is closure-deferred (property
# (d)) and routes to `cow_closure_mutated` (NEVER-pristine) rather than
# the position-aware `cow_mut_max_span`. The mutation POSITION threaded
# into the mark helpers is the mutating expression's own `span.start`.
void cow_scan_expr(LowerCtx &ctx, GirModule &gmod, SpannedExpr e, bool in_closure):
    match e.expr:
        case EMethodCall(recv_box, mname, margs, _):
            # TYPED: builtin `is_mutating` table OR user `&self`/`!self`
            # self-convention (method_mutates_receiver). A read-only call
            # does NOT mark its receiver; a mutating one marks the root.
            if method_mutates_receiver(*recv_box, mname, &gmod):
                cow_mark_if_ident(&ctx, *recv_box, e.span.start, in_closure)
            cow_scan_expr(&ctx, &gmod, *recv_box, in_closure)
            # F1 soundness (method half): the parser DISCARDS `&`/`!`
            # sigils on call args (parser.gg skip_ownership_markers), so
            # the EMutableBorrow/EMove arms below are dead code at arg
            # positions — `w.helper(&v)` mutations were invisible to this
            # scan. Recover the lost invariant from the callee's TYPED
            # signature (method_arg_lets_callee_mutate; `Type__mname`
            # key, param index ai+1). Mirrors Rust's prescan sig-arg
            # handling (functions.rs, compute_cow_reassigned_after).
            int scan_mai = 0
            for ma in margs:
                if method_arg_lets_callee_mutate(&ctx, *recv_box, mname, scan_mai, &gmod):
                    cow_mark_if_ident(&ctx, ma.value, ma.value.span.start, in_closure)
                cow_scan_expr(&ctx, &gmod, ma.value, in_closure)
                scan_mai = scan_mai + 1
        case EMutableBorrow(inner_box):
            cow_mark_if_ident(&ctx, *inner_box, e.span.start, in_closure)
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EMove(inner_box):
            cow_mark_if_ident(&ctx, *inner_box, e.span.start, in_closure)
            # #37 Phase 2 EMove EXCLUSION side-channel: an EMove that
            # SURVIVES in the AST is a non-call-position move (call args
            # strip the sigil) — decl-init `w = !v`, assign-RHS,
            # `return !v`, literal element, match scrutinee. These lower
            # at many positions with no choke point, so the lazy bind
            # gate (decide_svardecl_emission) excludes any bind whose
            # source root lands in this set, instead of hooking each
            # position.
            cow_mark_moved_root(&ctx, *inner_box)
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case ECall(callee_box, cargs, _):
            cow_scan_expr(&ctx, &gmod, *callee_box, in_closure)
            # F1 soundness (free-call half): the parser DISCARDS `&`/`!`
            # sigils on call args (parser.gg skip_ownership_markers), so
            # `f(&v)` / `f(!v)` mutations were invisible to this scan —
            # the bind gate mis-flipped BorrowAlias on mutated-via-call
            # collections (RUN-proven: mutarg_probe printed the mutated
            # element through a flipped alias). Recover the lost
            # invariant from the TYPED callee signature maps. The callee
            # name must be redirect-resolved FIRST: the loader registers
            # imported fns under mod-prefixed MANGLED names (loader.gg),
            # keying fn_borrow_params/fn_move_params by the mangled name
            # while the AST callee is bare — mirror lower_call's
            # resolution order. (Explicit-targ generic callees mangle
            # before the redirect in lower_call; the scan keys the bare
            # name only — a miss stays `false`, i.e. detection is purely
            # additive. Rust's prescan has the same raw-name shape.)
            match (*callee_box).expr:
                case EIdentifier(scan_fname):
                    String scan_resolved = scan_fname
                    if gmod.call_redirects.contains(scan_resolved):
                        scan_resolved = gmod.call_redirects.get(scan_resolved).unwrap()
                    int scan_ai = 0
                    for ca_sig in cargs:
                        if call_arg_lets_callee_mutate(&gmod, scan_resolved, scan_ai):
                            cow_mark_if_ident(&ctx, ca_sig.value, ca_sig.value.span.start, in_closure)
                        scan_ai = scan_ai + 1
                else:
                    pass
            for ca in cargs:
                cow_scan_expr(&ctx, &gmod, ca.value, in_closure)
        case EBinaryOp(lhs_box, _, rhs_box):
            cow_scan_expr(&ctx, &gmod, *lhs_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *rhs_box, in_closure)
        case EUnaryOp(_, inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EFieldAccess(base_box, _):
            cow_scan_expr(&ctx, &gmod, *base_box, in_closure)
        case EIndex(base_box, idx_box):
            cow_scan_expr(&ctx, &gmod, *base_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *idx_box, in_closure)
        case EDeref(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EAs(inner_box, _):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case ETry(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EPropagate(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EAwait(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case ESpawn(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case ESpawnBlocking(inner_box):
            cow_scan_expr(&ctx, &gmod, *inner_box, in_closure)
        case EArrayLiteral(elems):
            for el in elems:
                cow_scan_expr(&ctx, &gmod, el, in_closure)
        case ETupleLiteral(elems_t):
            for elt in elems_t:
                cow_scan_expr(&ctx, &gmod, elt, in_closure)
        case EDictLiteral(keys_d, vals_d):
            for kd in keys_d:
                cow_scan_expr(&ctx, &gmod, kd, in_closure)
            for vd in vals_d:
                cow_scan_expr(&ctx, &gmod, vd, in_closure)
        case EStructLiteral(_, _, fields_s):
            for fs in fields_s:
                cow_scan_expr(&ctx, &gmod, fs, in_closure)
        case EFString(_, parts_f, _):
            for pf in parts_f:
                cow_scan_expr(&ctx, &gmod, pf, in_closure)
        case EIf(cond_box, then_b, elses):
            cow_scan_expr(&ctx, &gmod, *cond_box, in_closure)
            cow_scan_stmts(&ctx, &gmod, then_b, in_closure)
            for eb in elses:
                # Same elif-CONDITION scan as the SIf arm (see there): an
                # `elif shrink(&xs):` inside an if-EXPRESSION was equally
                # scan-invisible.
                match eb.condition:
                    case Some(eb_cond_e):
                        cow_scan_expr(&ctx, &gmod, eb_cond_e, in_closure)
                    case None:
                        pass
                cow_scan_stmts(&ctx, &gmod, eb.body, in_closure)
        case EMatch(scrut_box, arms):
            cow_scan_expr(&ctx, &gmod, *scrut_box, in_closure)
            for arm in arms:
                match arm.guard:
                    case Some(ge):
                        cow_scan_expr(&ctx, &gmod, ge, in_closure)
                    case None:
                        pass
                cow_scan_stmts(&ctx, &gmod, arm.body, in_closure)
        case EBlock(blk_stmts):
            cow_scan_stmts(&ctx, &gmod, blk_stmts, in_closure)
        case EDo(do_stmts):
            cow_scan_stmts(&ctx, &gmod, do_stmts, in_closure)
        case EClosure(_, clo_body):
            # Property (d): a closure body that mutates a CAPTURED name
            # endangers any alias the enclosing fn holds, but the body's
            # textual span bears NO relation to WHEN the closure is
            # invoked (it can run AFTER the bind). Scan the body with
            # in_closure=true so every mutation there routes to
            # `cow_closure_mutated` (NEVER-pristine) — position-AGNOSTIC,
            # matching tier-1's whole-fn refusal.
            cow_scan_stmts(&ctx, &gmod, clo_body, true)
        case EImplicitClosure(ic_box):
            # An implicit closure (`it`-form) is also a closure body —
            # any mutation it performs is closure-deferred. (d).
            cow_scan_expr(&ctx, &gmod, *ic_box, true)
        case EDefaultOp(lhs_box, rhs_box):
            cow_scan_expr(&ctx, &gmod, *lhs_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *rhs_box, in_closure)
        case EListComp(elem_box, _, iter_box, opt_filt):
            cow_scan_expr(&ctx, &gmod, *elem_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *iter_box, in_closure)
            match opt_filt:
                case Some(filt_box):
                    cow_scan_expr(&ctx, &gmod, *filt_box, in_closure)
                case None:
                    pass
        case ESetComp(selem_box, _, siter_box, sfilt_opt):
            cow_scan_expr(&ctx, &gmod, *selem_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *siter_box, in_closure)
            match sfilt_opt:
                case Some(sfilt_box):
                    cow_scan_expr(&ctx, &gmod, *sfilt_box, in_closure)
                case None:
                    pass
        case EDictComp(dk_box, dv_box, _, diter_box, dfilt_opt):
            cow_scan_expr(&ctx, &gmod, *dk_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *dv_box, in_closure)
            cow_scan_expr(&ctx, &gmod, *diter_box, in_closure)
            match dfilt_opt:
                case Some(dfilt_box):
                    cow_scan_expr(&ctx, &gmod, *dfilt_box, in_closure)
                case None:
                    pass
        case ERethrow(re_inner, _, _, re_handler):
            cow_scan_expr(&ctx, &gmod, *re_inner, in_closure)
            cow_scan_expr(&ctx, &gmod, *re_handler, in_closure)
        case ECatch(ce_inner, _, ce_handler):
            cow_scan_expr(&ctx, &gmod, *ce_inner, in_closure)
            cow_scan_expr(&ctx, &gmod, *ce_handler, in_closure)
        case EFaultCatch(fc_inner, _, fc_handler):
            cow_scan_expr(&ctx, &gmod, *fc_inner, in_closure)
            cow_scan_expr(&ctx, &gmod, *fc_handler, in_closure)
        else:
            pass

# Forward-walk a statement list, recording mutations. Assignment and
# compound-assignment LHS mark the target name; every contained
# expression is scanned for in-place mutations; nested control-flow
# bodies recurse.
void cow_scan_stmts(LowerCtx &ctx, GirModule &gmod, Vector[Stmt] stmts, bool in_closure):
    for st in stmts:
        cow_scan_stmt_one(&ctx, &gmod, st, in_closure)

# The SINGLE-STATEMENT entry of the shared forward-scan walker — the body of
# the old inline `for st: match st:` moved verbatim (zero drift; one walker).
# Exists so the consumer-#1 SCOPE hoist can run the SHARED walker over JUST
# one scope statement's subtree (a bare `Stmt` param is a zero-cost borrow),
# mirroring Rust's `cow_mutations_in_stmt` = `cow_after_stmt` over `&Stmt`.
void cow_scan_stmt_one(LowerCtx &ctx, GirModule &gmod, Stmt st, bool in_closure):
    match st:
        case SVarDecl(sv_stype, sv_name, init_e, _, _, _):
            cow_record_decl_type(&ctx, sv_stype, sv_name, init_e)
            cow_scan_expr(&ctx, &gmod, init_e, in_closure)
        case SAssign(lhs_e, rhs_e):
            # `x = …` reassigns x; `x[i] = …` / `x.f = …` mutates the
            # base x. Mark the root identifier of the LHS path at the
            # LHS's textual position.
            cow_mark_assign_target(&ctx, lhs_e, lhs_e.span.start, in_closure)
            cow_scan_expr(&ctx, &gmod, lhs_e, in_closure)
            cow_scan_expr(&ctx, &gmod, rhs_e, in_closure)
        case SCompoundAssign(lhs_e, _, rhs_e):
            cow_mark_assign_target(&ctx, lhs_e, lhs_e.span.start, in_closure)
            cow_scan_expr(&ctx, &gmod, lhs_e, in_closure)
            cow_scan_expr(&ctx, &gmod, rhs_e, in_closure)
        case SExpr(ex):
            cow_scan_expr(&ctx, &gmod, ex, in_closure)
        case SReturn(opt_e):
            match opt_e:
                case Some(re):
                    cow_scan_expr(&ctx, &gmod, re, in_closure)
                case None:
                    pass
        case SThrow(te):
            cow_scan_expr(&ctx, &gmod, te, in_closure)
        case SBreak():
            pass
        case SWhile(cond_e, body_w, else_w):
            cow_scan_expr(&ctx, &gmod, cond_e, in_closure)
            cow_scan_stmts(&ctx, &gmod, body_w, in_closure)
            cow_scan_stmts(&ctx, &gmod, else_w, in_closure)
        case SLoop(body_l):
            cow_scan_stmts(&ctx, &gmod, body_l, in_closure)
        case SFor(_, iter_e, body_f, _, else_f):
            cow_scan_expr(&ctx, &gmod, iter_e, in_closure)
            cow_scan_stmts(&ctx, &gmod, body_f, in_closure)
            cow_scan_stmts(&ctx, &gmod, else_f, in_closure)
        case SIf(cond_if, then_if, elses_if):
            cow_scan_expr(&ctx, &gmod, cond_if, in_closure)
            cow_scan_stmts(&ctx, &gmod, then_if, in_closure)
            for eb_if in elses_if:
                # Planner consumer #1 fold: scan the ELIF CONDITION too
                # (`elif shrink(&xs):` mutates via a mut-borrow arg). Only
                # the branch BODIES were walked, so an elif-cond-only
                # mutation was scan-invisible and the pre-scope hoist never
                # fired — the SH analog of the Rust proto's
                # cow_mutations_in_branches drift (both missed elif conds;
                # match GUARDS were already scanned, making this the odd
                # one out). Mirrors Rust cow_after_stmt's Stmt::If arm:
                # cond + all elif-conds + body union.
                match eb_if.condition:
                    case Some(eb_cond):
                        cow_scan_expr(&ctx, &gmod, eb_cond, in_closure)
                    case None:
                        pass
                cow_scan_stmts(&ctx, &gmod, eb_if.body, in_closure)
        case SMatch(scrut_if, arms_if):
            cow_scan_expr(&ctx, &gmod, scrut_if, in_closure)
            for arm_if in arms_if:
                match arm_if.guard:
                    case Some(gif):
                        cow_scan_expr(&ctx, &gmod, gif, in_closure)
                    case None:
                        pass
                cow_scan_stmts(&ctx, &gmod, arm_if.body, in_closure)
        case SWith(with_e, _, body_with):
            cow_scan_expr(&ctx, &gmod, with_e, in_closure)
            cow_scan_stmts(&ctx, &gmod, body_with, in_closure)
        case SNamedScope(_, body_ns):
            cow_scan_stmts(&ctx, &gmod, body_ns, in_closure)
        case SOnError(body_oe):
            cow_scan_stmts(&ctx, &gmod, body_oe, in_closure)
        case SAssert(ae, _):
            cow_scan_expr(&ctx, &gmod, ae, in_closure)
        case SAssertReturn(are, _):
            cow_scan_expr(&ctx, &gmod, are, in_closure)
        case SSnapshot(_, _, se):
            cow_scan_expr(&ctx, &gmod, se, in_closure)
        case SSelect(sel_arms):
            for sel_arm in sel_arms:
                match sel_arm.op:
                    case SORecv(_, _, recv_e):
                        cow_scan_expr(&ctx, &gmod, recv_e, in_closure)
                    case SOSend(send_ch, send_v):
                        cow_scan_expr(&ctx, &gmod, send_ch, in_closure)
                        cow_scan_expr(&ctx, &gmod, send_v, in_closure)
                cow_scan_stmts(&ctx, &gmod, sel_arm.body, in_closure)
        else:
            pass

# Mark the root identifier of an assignment LHS as mutated. For a bare
# `x` this is x; for `x[i]` / `x.f` / `x.f[i]` it walks down to the
# root EIdentifier (the owning container is mutated through the path).
void cow_mark_assign_target(LowerCtx &ctx, SpannedExpr lhs, int pos, bool in_closure):
    match lhs.expr:
        case EIdentifier(idn):
            cow_mark_name(&ctx, idn, pos, in_closure)
        case EIndex(base_box, _):
            cow_mark_assign_target(&ctx, *base_box, pos, in_closure)
        case EFieldAccess(base_box, _):
            cow_mark_assign_target(&ctx, *base_box, pos, in_closure)
        case EDeref(inner_box):
            cow_mark_assign_target(&ctx, *inner_box, pos, in_closure)
        else:
            pass

# CoW tier-2 L1: is `name` PRISTINE for an alias bound at textual
# position `pos`? True iff the name is never mutated, OR its mutations
# are ALL strictly before `pos` (and none are closure-deferred). A
# closure-captured-mutated name is NEVER pristine (property (d), checked
# FIRST). This is the position-aware replacement for the whole-fn
# `cow_mutated_names.contains(name)` check in the Branch C-pre flip gate.
#
# Soundness for a non-escaping re-binding `SVarDecl` bind rests on three
# properties (re-derive if the bind shape or escape funnel changes):
#   (a) forward — a mutation at/after `pos` (in the live window) has
#       `max_span >= pos` ⇒ not pristine ⇒ no flip.
#   (b) back-edge — a mutation textually BEFORE `pos` re-executes only
#       AFTER the SVarDecl re-binds at the next iteration's top, so the
#       previous-iteration alias is already DEAD (shadowed).
#   (c) escape — a surviving previous-iteration alias is materialized by
#       the decide_ptr_consume/OpClone escape funnel.
#   (d) closure-deferred — a closure-body mutation runs at an unknown
#       time, so the name is never pristine (the cow_closure_mutated set).
bool cow_pristine_after(LowerCtx &ctx, String name, int pos):
    if ctx.cow_closure_mutated.contains(name):
        return false
    if not ctx.cow_mutated_names.contains(name):
        return true
    int last = -1
    if ctx.cow_mut_max_span.contains(name):
        last = ctx.cow_mut_max_span.get(name).unwrap()
    return last < pos

# Record `name`'s DECLARED type name into the scan-time side channel
# (`ctx.cow_decl_types`) so signature resolution for method args
# (`method_arg_lets_callee_mutate`) can form the `Type__mname` key —
# the typechecker side table does not key bare-ident receivers at scan
# time. `auto` resolves through a direct constructor init
# (`auto h = Holder(1)`); other `auto` shapes stay unrecorded — a miss
# only UNDER-marks, the same pre-existing scan-time blindness the
# parser typed-arg-ownership TODO retires for good.
void cow_record_decl_type(LowerCtx &ctx, SpannedType stype, String name, SpannedExpr init_e):
    String cdt_name = ""
    match stype.ty:
        case TNamed(cdt_tn, _):
            cdt_name = cdt_tn
        case TPrimitive(cdt_tp):
            cdt_name = cdt_tp
        else:
            pass
    if cdt_name == "auto" or cdt_name == "":
        match init_e.expr:
            case ECall(cdt_callee_box, _, _):
                match (*cdt_callee_box).expr:
                    case EIdentifier(cdt_ctor):
                        cdt_name = cdt_ctor
                    else:
                        pass
            else:
                pass
    if cdt_name != "" and cdt_name != "auto":
        ctx.cow_decl_types.put(name, cdt_name)

# Run the forward-scan over a whole function body, populating
# `ctx.cow_mutated_names`. Called once per function before the
# statement-lowering loop. `params` seeds the declared-type side
# channel so param receivers resolve too (closures pass []).
void compute_cow_scan(LowerCtx &ctx, GirModule &gmod, Vector[Param] params, Vector[Stmt] body):
    for cs_p in params:
        match cs_p.param_type.ty:
            case TNamed(cs_tn, _):
                ctx.cow_decl_types.put(cs_p.param_name, cs_tn)
            case TPrimitive(cs_tp):
                ctx.cow_decl_types.put(cs_p.param_name, cs_tp)
            else:
                pass
    cow_scan_stmts(&ctx, &gmod, body, false)

# Peel the read-chain of a resource-bind init expression down to its
# source-collection root identifier name. Handles `coll.get(i).unwrap()`,
# `coll[i]`, `coll.first().unwrap()`, `(*coll)…`, returning "" when the
# root is not a plain identifier (e.g. a fresh temp, a call result —
# those have no aliasable collection to track). Only NON-mutating read
# peels are followed; if the chain hits anything else we stop and return
# whatever root we reached (or "").
String cow_source_root_name(SpannedExpr e):
    match e.expr:
        case EIdentifier(idn):
            return idn
        case EMethodCall(recv_box, _, _, _):
            return cow_source_root_name(*recv_box)
        case EIndex(base_box, _):
            return cow_source_root_name(*base_box)
        case EFieldAccess(base_box, _):
            return cow_source_root_name(*base_box)
        case EDeref(inner_box):
            return cow_source_root_name(*inner_box)
        case ETry(inner_box):
            return cow_source_root_name(*inner_box)
        case EPropagate(inner_box):
            return cow_source_root_name(*inner_box)
        else:
            return ""
