# ── Generic monomorphization ─────────────────────────────

struct GenericInstance:
    String base_name
    Vector[SpannedType] type_args
    String mangled_name

# PROTO phase-1b: a discovered method-level-generic call site.
#
# A site is recorded in ONE of two forms:
#  * TURBOFISH form — `method_targs` (the syntactic AST types) is non-empty,
#    `method_targ_tids` is empty. Used by the explicit `v.iter().fold[A,F](…)`.
#  * BARE form (lazy-iterator phase 1b) — `method_targ_tids` (the inferred
#    resolved-type ids from the typechecker side-table) is non-empty,
#    `method_targs` is empty. Used by `v.iter().fold(0, f)` with no turbofish.
# The two are mutually exclusive; `proto_inst_targ_count` returns the
# effective arity and `proto_inst_targ_tid` resolves the i-th targ from
# whichever representation is populated.
struct ProtoMethInst:
    String recv_instance     # mangled receiver instance, e.g. VectorIter__int64_t
    String method_name       # e.g. map / filter / fold
    Vector[SpannedType] method_targs   # the turbofish args (turbofish form)
    Vector[int] method_targ_tids       # the inferred rtids (bare form)
    String mangled_symbol    # recv_instance__method__<targs...>

# PROTO phase-1b: map a method-level type-arg to its GIR type-id, with a
# function type binding to GorgetClosure (the closure value carried in the
# adapter struct's F field), not Ptr(FnPtr).
int proto_method_targ_tid(SpannedType t, GirModule &gmod):
    match t.ty:
        case TFunction(_, _, _):
            return lookup_or_register_named(&gmod, "GorgetClosure")
        else:
            return map_ast_type(t, &gmod)

# Effective method-targ arity of a discovered instance, independent of which
# representation (turbofish SpannedType vs inferred rtid) is populated.
int proto_inst_targ_count(ProtoMethInst pmi):
    if pmi.method_targs.len() > 0:
        return pmi.method_targs.len()
    return pmi.method_targ_tids.len()

# Resolve the i-th method-targ of a discovered instance to its GIR type-id,
# selecting the populated representation. The RTFunction→GorgetClosure rule
# is threaded through both paths (proto_method_targ_tid for the AST form,
# resolved_to_gir_type's RTFunction arm for the rtid form) so the bound subs
# are byte-identical regardless of how the site was discovered.
int proto_inst_targ_tid(ProtoMethInst pmi, int i, GirModule &gmod):
    if pmi.method_targs.len() > 0:
        return proto_method_targ_tid(pmi.method_targs.get(i).unwrap(), &gmod)
    return resolved_to_gir_type(pmi.method_targ_tids.get(i).unwrap(), gmod.tc_types, gmod.tc_scopes, &gmod)

# walk an expression collecting method-generic call sites.
void proto_walk_expr(SpannedExpr sexpr, GirModule &gmod, Vector[ProtoMethInst] &out, Dict[String, bool] &seen):
    match sexpr.expr:
        case EMethodCall(recv_box, mname, margs, _, mtargs):
            proto_walk_expr(*recv_box, &gmod, &out, &seen)
            for a in margs:
                proto_walk_expr(a, &gmod, &out, &seen)
            if mtargs.len() > 0:
                # TURBOFISH form: mangle from the syntactic AST types.
                # Resolve the receiver instance via the typecheck side-table.
                int recv_tid = lookup_expr_gir_type(*recv_box, &gmod)
                if recv_tid >= 0:
                    String recv_name = type_id_to_name(recv_tid, &gmod)
                    if recv_name.len() > 0 and recv_name.contains("__"):
                        String sym = recv_name + "__" + mname
                        for mt in mtargs:
                            sym = sym + "__" + type_to_c_name(mt, &gmod)
                        if not seen.contains(sym):
                            seen.put(sym.clone(), true)
                            out.push(ProtoMethInst(recv_name, mname, mtargs, [], sym))
            else:
                # BARE form (lazy-iterator phase 1b): no turbofish written.
                # If the typechecker recorded inferred method-targs for this
                # call's span, record the SAME instance the call-site mangle
                # produces — this drives BOTH the fn_sigs pre-reg AND the
                # body-emit, so the bare symbol is DEFINED (not just called).
                Vector[int] bm_tids = bare_method_targ_rtids(sexpr.span.end, mname, &gmod)
                if bm_tids.len() > 0:
                    int recv_tid_b = lookup_expr_gir_type(*recv_box, &gmod)
                    if recv_tid_b >= 0:
                        String recv_name_b = type_id_to_name(recv_tid_b, &gmod)
                        if recv_name_b.len() > 0 and recv_name_b.contains("__"):
                            String sym_b = recv_name_b + "__" + mname
                            for bmt in bm_tids:
                                sym_b = sym_b + "__" + bare_method_targ_c_name(bmt, &gmod)
                            if not seen.contains(sym_b):
                                seen.put(sym_b.clone(), true)
                                out.push(ProtoMethInst(recv_name_b, mname, [], bm_tids, sym_b))
        case ECall(callee_box, cargs, _, _):
            proto_walk_expr(*callee_box, &gmod, &out, &seen)
            for a in cargs:
                proto_walk_expr(a, &gmod, &out, &seen)
        case EFieldAccess(obj, _):
            proto_walk_expr(*obj, &gmod, &out, &seen)
        case EBinaryOp(l, _, r):
            proto_walk_expr(*l, &gmod, &out, &seen)
            proto_walk_expr(*r, &gmod, &out, &seen)
        case EUnaryOp(_, inner):
            proto_walk_expr(*inner, &gmod, &out, &seen)
        case EIndex(b, i):
            proto_walk_expr(*b, &gmod, &out, &seen)
            proto_walk_expr(*i, &gmod, &out, &seen)
        else:
            pass

void proto_walk_stmts(Vector[Stmt] stmts, GirModule &gmod, Vector[ProtoMethInst] &out, Dict[String, bool] &seen):
    for stmt in stmts:
        match stmt:
            case SVarDecl(_, _, init, _, _, _):
                proto_walk_expr(init, &gmod, &out, &seen)
            case SExpr(e):
                proto_walk_expr(e, &gmod, &out, &seen)
            case SReturn(opt):
                match opt:
                    case Some(e):
                        proto_walk_expr(e, &gmod, &out, &seen)
                    case None:
                        pass
            case SAssign(_, e):
                proto_walk_expr(e, &gmod, &out, &seen)
            case SIf(c, tb, elifs):
                proto_walk_expr(c, &gmod, &out, &seen)
                proto_walk_stmts(tb, &gmod, &out, &seen)
                for el in elifs:
                    proto_walk_stmts(el.body, &gmod, &out, &seen)
            case SWhile(c, b, eb):
                proto_walk_expr(c, &gmod, &out, &seen)
                proto_walk_stmts(b, &gmod, &out, &seen)
                proto_walk_stmts(eb, &gmod, &out, &seen)
            case SFor(_, p_iter, b, _, eb):
                proto_walk_expr(p_iter, &gmod, &out, &seen)
                proto_walk_stmts(b, &gmod, &out, &seen)
                proto_walk_stmts(eb, &gmod, &out, &seen)
            else:
                pass

# ── Cross-frame fault-propagation participation analysis ──────────
# (error-model.md §11, Inc-2.1a/2.1c/2.1d — C backend, single hop, the
# arithmetic faults Fault.Overflow + Fault.DivByZero AND the array-index
# Fault.Bounds.)
#
# A function PARTICIPATES iff:
#   (a) its body has a reachable-uncaught faultable op (an int Add/Sub/Mul/
#       Div/Rem OR an `array[index]` read) NOT lexically inside a local
#       `EFaultCatch` that catches that fault, AND
#   (b) it is directly called from inside an `EFaultCatch.inner` scope that
#       catches a propagatable fault (so a deep fault would actually need to
#       reach a handler).
#
# The INTERSECTION (a)∩(b) is the participating set — it bounds the blast
# radius of the uniform-signature design (D5): a participating callee gets a
# synthesized trailing `GtMutPtr(i32)` fault-slot param, and EVERY direct
# caller must pass the trailing arg. Marking every faultable-op-bearing fn
# would change thousands of signatures; the intersection limits it to exactly
# the deep-catch callees. Single-hop + conservative (over-approximates (a);
# (b) follows only DIRECT free-function calls inside the catch). Mirrors Rust
# gg's `src/ir/lowering/fault_participation.rs`. The result is a TYPED set on
# `GirModule.participating_fault_fns`, read via `participates_in_fault`
# (devbook/24 rule 2) — never re-derived from a name.
#
# INC-A SCOPE — FREE FUNCTIONS ONLY (B1): (b) resolves DIRECT free-function
# calls (`ECall` whose `callee.expr == EIdentifier`) ONLY. Both method shapes
# — `ECall(EFieldAccess(...))` AND the dedicated `EMethodCall` node — are
# SKIPPED (their signatures build through a SECOND, hand-synced param-build
# path in `lower_equip_block` + a different call-site dispatch — method
# participation is a later increment). An EXECUTABLE GUARD in
# `compute_participating_fault_fns` HARD-ERRORS if a name that resolves to a
# method/equip-method would enter the set, so the free-fn scope is ENFORCED,
# not assumed.

# Does this `FaultCatchPattern` catch any PROPAGATABLE fault
# (Fault.Overflow / Fault.DivByZero / Fault.Bounds)? The variant form catches
# exactly its named category; the binding form (`catch f:`) catches ANY fault.
# The per-op detector below discriminates which fault a body can actually
# raise; this only decides whether a catch scope is a participation source.
bool fp_pattern_catches_fault(FaultCatchPattern pattern):
    match pattern:
        case FcpVariant(_, vname):
            return vname == "Overflow" or vname == "DivByZero" or vname == "Bounds"
        case FcpBinding(_):
            return true
    return false

# Visitor (a): does an expr subtree contain a faultable op (int Add/Sub/Mul/
# Div/Rem OR an `array[index]` read) at catch_depth 0 (uncaught)? Returns true
# as soon as one is found. `catch_depth` counts enclosing fault-catching
# scopes; an op at depth 0 is uncaught. Over-approximates (any int binop / any
# index read) — sound: a flagged-but-never-deep-caught fn just isn't in (a)∩(b).
bool fp_expr_has_uncaught_fault(SpannedExpr sexpr, int catch_depth):
    match sexpr.expr:
        case EBinaryOp(l, op, r):
            bool is_arith = op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
            if is_arith and catch_depth == 0:
                return true
            # Operands are evaluated in the SAME scope.
            if fp_expr_has_uncaught_fault(*l, catch_depth):
                return true
            return fp_expr_has_uncaught_fault(*r, catch_depth)
        case EIndex(b, i):
            # An `object[index]` read is a faultable op (Bounds) at depth 0.
            if catch_depth == 0:
                return true
            if fp_expr_has_uncaught_fault(*b, catch_depth):
                return true
            return fp_expr_has_uncaught_fault(*i, catch_depth)
        case EFaultCatch(inner, pattern, handler):
            # The wrapped inner is inside the catch scope IFF the pattern catches
            # a propagatable fault; the handler runs OUTSIDE the caught scope.
            int inner_depth = catch_depth
            if fp_pattern_catches_fault(pattern):
                inner_depth = catch_depth + 1
            if fp_expr_has_uncaught_fault(*inner, inner_depth):
                return true
            return fp_expr_has_uncaught_fault(*handler, catch_depth)
        case ECall(callee_box, cargs, _, _):
            if fp_expr_has_uncaught_fault(*callee_box, catch_depth):
                return true
            for a in cargs:
                if fp_expr_has_uncaught_fault(a, catch_depth):
                    return true
            return false
        case EMethodCall(recv_box, _, margs, _, _):
            if fp_expr_has_uncaught_fault(*recv_box, catch_depth):
                return true
            for a in margs:
                if fp_expr_has_uncaught_fault(a, catch_depth):
                    return true
            return false
        case EFieldAccess(obj, _):
            return fp_expr_has_uncaught_fault(*obj, catch_depth)
        case EUnaryOp(_, inner):
            return fp_expr_has_uncaught_fault(*inner, catch_depth)
        else:
            return false

bool fp_stmts_have_uncaught_fault(Vector[Stmt] stmts):
    for stmt in stmts:
        if fp_stmt_has_uncaught_fault(stmt):
            return true
    return false

bool fp_stmt_has_uncaught_fault(Stmt stmt):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            return fp_expr_has_uncaught_fault(init, 0)
        case SExpr(e):
            return fp_expr_has_uncaught_fault(e, 0)
        case SReturn(opt):
            match opt:
                case Some(e):
                    return fp_expr_has_uncaught_fault(e, 0)
                case None:
                    return false
        case SAssign(_, e):
            return fp_expr_has_uncaught_fault(e, 0)
        case SCompoundAssign(_, _, e):
            return fp_expr_has_uncaught_fault(e, 0)
        case SIf(c, tb, elifs):
            if fp_expr_has_uncaught_fault(c, 0):
                return true
            if fp_stmts_have_uncaught_fault(tb):
                return true
            for el in elifs:
                if fp_stmts_have_uncaught_fault(el.body):
                    return true
            return false
        case SWhile(c, b, eb):
            if fp_expr_has_uncaught_fault(c, 0):
                return true
            if fp_stmts_have_uncaught_fault(b):
                return true
            return fp_stmts_have_uncaught_fault(eb)
        case SFor(_, p_iter, b, _, eb):
            if fp_expr_has_uncaught_fault(p_iter, 0):
                return true
            if fp_stmts_have_uncaught_fault(b):
                return true
            return fp_stmts_have_uncaught_fault(eb)
        else:
            return false

# Visitor (b): collect every DIRECT FREE-FUNCTION callee name that appears
# inside an `EFaultCatch.inner` scope (catch_depth > 0). A free direct call is
# `ECall` whose `callee.expr == EIdentifier(fname)` — BOTH method shapes
# (`ECall(EFieldAccess)` AND `EMethodCall`) are skipped (Inc-A free-fn scope).
void fp_collect_deep_callees_expr(SpannedExpr sexpr, int catch_depth, Dict[String, bool] &callees):
    match sexpr.expr:
        case EFaultCatch(inner, pattern, handler):
            int inner_depth = catch_depth
            if fp_pattern_catches_fault(pattern):
                inner_depth = catch_depth + 1
            fp_collect_deep_callees_expr(*inner, inner_depth, &callees)
            # The handler runs OUTSIDE the caught scope.
            fp_collect_deep_callees_expr(*handler, catch_depth, &callees)
        case ECall(callee_box, cargs, _, _):
            if catch_depth > 0:
                match (*callee_box).expr:
                    case EIdentifier(cname):
                        callees.put(cname.clone(), true)
                    else:
                        # `ECall(EFieldAccess(...))` method shape — SKIP (free-fn
                        # scope, Inc-A).
                        pass
            # Recurse into callee + args (nested calls / fault-catches).
            fp_collect_deep_callees_expr(*callee_box, catch_depth, &callees)
            for a in cargs:
                fp_collect_deep_callees_expr(a, catch_depth, &callees)
        case EMethodCall(recv_box, _, margs, _, _):
            # `EMethodCall` method shape — SKIP recording (free-fn scope), but
            # still recurse so a free call nested inside an arg is found.
            fp_collect_deep_callees_expr(*recv_box, catch_depth, &callees)
            for a in margs:
                fp_collect_deep_callees_expr(a, catch_depth, &callees)
        case EFieldAccess(obj, _):
            fp_collect_deep_callees_expr(*obj, catch_depth, &callees)
        case EBinaryOp(l, _, r):
            fp_collect_deep_callees_expr(*l, catch_depth, &callees)
            fp_collect_deep_callees_expr(*r, catch_depth, &callees)
        case EUnaryOp(_, inner):
            fp_collect_deep_callees_expr(*inner, catch_depth, &callees)
        case EIndex(b, i):
            fp_collect_deep_callees_expr(*b, catch_depth, &callees)
            fp_collect_deep_callees_expr(*i, catch_depth, &callees)
        else:
            pass

void fp_collect_deep_callees_stmts(Vector[Stmt] stmts, Dict[String, bool] &callees):
    for stmt in stmts:
        fp_collect_deep_callees_stmt(stmt, &callees)

void fp_collect_deep_callees_stmt(Stmt stmt, Dict[String, bool] &callees):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            fp_collect_deep_callees_expr(init, 0, &callees)
        case SExpr(e):
            fp_collect_deep_callees_expr(e, 0, &callees)
        case SReturn(opt):
            match opt:
                case Some(e):
                    fp_collect_deep_callees_expr(e, 0, &callees)
                case None:
                    pass
        case SAssign(_, e):
            fp_collect_deep_callees_expr(e, 0, &callees)
        case SCompoundAssign(_, _, e):
            fp_collect_deep_callees_expr(e, 0, &callees)
        case SIf(c, tb, elifs):
            fp_collect_deep_callees_expr(c, 0, &callees)
            fp_collect_deep_callees_stmts(tb, &callees)
            for el in elifs:
                fp_collect_deep_callees_stmts(el.body, &callees)
        case SWhile(c, b, eb):
            fp_collect_deep_callees_expr(c, 0, &callees)
            fp_collect_deep_callees_stmts(b, &callees)
            fp_collect_deep_callees_stmts(eb, &callees)
        case SFor(_, p_iter, b, _, eb):
            fp_collect_deep_callees_expr(p_iter, 0, &callees)
            fp_collect_deep_callees_stmts(b, &callees)
            fp_collect_deep_callees_stmts(eb, &callees)
        else:
            pass

# Compute the participating-function set over all non-generic FREE functions
# in the AST module. Returns the (a)∩(b) intersection. Mutates
# `gmod.participating_fault_fns` (the typed module set). Two AST passes:
#  (b) collect every direct free-fn callee inside a fault-catch scope;
#  (a)∩(b) a candidate participates iff its OWN body has an uncaught faultable
#  op. Generic functions (type_params non-empty) are EXCLUDED — their mono'd
# instances aren't named at AST-scan time (S1).
#
# EXECUTABLE GUARD (Core #6): a name that survives into the participating set
# MUST resolve to a FREE FUNCTION (an `IFunction` whose body owns the uncaught
# op). The (a) test is gated on `IFunction` membership, so a method/equip name
# can never enter the set — it has no top-level `IFunction` of that name. If
# the (b)-collector ever recorded a name that DOES match a non-generic free
# `IFunction` AND that fn has an uncaught fault, it participates; methods never
# reach (a) here (they aren't `IFunction` items), so the guard holds by
# construction. We additionally HARD-ERROR if a participating free-fn name
# also appears as an equip-method (the SAME short name), which would mean the
# free-fn scope's single param-build site is unsound for it.
void compute_participating_fault_fns(Module &m, GirModule &gmod):
    # Phase (b): collect every direct free-fn callee inside a fault catch.
    Dict[String, bool] deep_callees = {}
    for bp_item in m.items:
        match bp_item:
            case IFunction(bfdef):
                fp_collect_deep_callees_stmts(bfdef.body, &deep_callees)
            else:
                pass
    if deep_callees.len() == 0:
        # No deep-catch call site anywhere → nothing participates. Fast path:
        # the entire existing suite + self-host source take this branch (no
        # arith/bounds `catch Fault.X` over a user CALL), so signatures are
        # byte-identical and the bootstrap is unaffected.
        return

    # Phase (a)∩(b): a candidate participates iff its OWN body has an uncaught
    # faultable op. Only non-generic free `IFunction`s are candidates.
    for pa_item in m.items:
        match pa_item:
            case IFunction(pfdef):
                if pfdef.type_params.len() > 0:
                    # Generic — excluded (S1).
                    continue
                if not deep_callees.contains(pfdef.name):
                    continue
                if fp_stmts_have_uncaught_fault(pfdef.body):
                    gmod.participating_fault_fns.put(pfdef.name.clone(), true)
            else:
                pass

    # EXECUTABLE GUARD (Core #6): Inc-A scopes participation to FREE FUNCTIONS —
    # the trailing fault-slot param is built ONLY in `lower_function`, NOT in the
    # second hand-synced param-build site (`lower_equip_block`). If a
    # participating name ALSO names an equip-method (the SAME short name), that
    # method's signature would silently MISS the slot at the second build site →
    # an ABI mismatch → segfault. By construction the set only holds free-fn
    # names (the (a)-pass iterates `IFunction` items only, and (b) records only
    # `ECall(EIdentifier)` free calls), so this guard NEVER fires for the Inc-A
    # fixtures — it makes the free-fn scope boundary ENFORCED, not assumed. A
    # future method-participation increment (Inc-C) threads the slot at
    # `lower_equip_block` + adds a method-call-site gate, then relaxes this.
    for gd_item in m.items:
        match gd_item:
            case IEquip(gd_eqblk):
                for gd_m in gd_eqblk.methods:
                    if gmod.participating_fault_fns.contains(gd_m.name):
                        panic("cross-frame fault participation: free-fn name `" + gd_m.name + "` collides with an equip-method short name; method participation is out of Inc-A scope (the slot is built only at lower_function, not lower_equip_block — this would be an ABI mismatch). See error-model.md §11 Inc-C.")
            else:
                pass

# ── Lazy-iterator transitive adapter-instance discovery ──────────
#
# Walk method chains and register the RESULT type of each adapter chain link
# as a `GenericInstance`. For `v.iter().take(4).filter(p).count()`, the inner
# adapter results `TakeIter[VectorIter[int], int]` and
# `FilterIter[TakeIter[…], int, F]` are produced INSIDE default-method bodies
# (`take`/`filter` return `AdapterIter[Self, …]`), so the up-front
# `discover_generic_calls_*` walk — which only sees explicit type annotations
# and turbofish constructors — never registers them. Without registration the
# generic-equip emission loop (lower.gg) skips them and their methods
# (`next`/`count`/`filter`/…) are CALLED-but-never-DEFINED → CC-fail.
#
# This is the self-host analog of Rust's `try_register_default_return_type`
# (`src/ir/lowering/generics/mod.rs`): it consumes the per-link resolved type
# the typechecker recorded in `expr_link_types` (keyed by the call's UNIQUE
# span.end — the chain-link oracle), reconstructs its AST `SpannedType`, and
# pushes a `GenericInstance` so the existing emission machinery monomorphizes
# the adapter struct + its methods. Demand-gated: only result types whose base
# is a generic-equip adapter (`equip_generic_names`) are registered — builtin
# collections / Option / Result are left to their own paths.
void discover_adapter_chain_expr(SpannedExpr sexpr, GirModule &gmod, Dict[String, bool] equip_generic_names, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    match sexpr.expr:
        case EMethodCall(recv_box, _, margs, _, _):
            # Walk the receiver chain + args first (inner links / nested chains).
            discover_adapter_chain_expr(*recv_box, &gmod, equip_generic_names, &seen, &instances)
            for a in margs:
                discover_adapter_chain_expr(a, &gmod, equip_generic_names, &seen, &instances)
            # Register THIS link's result type if it is a generic-equip adapter.
            int link_end = sexpr.span.end
            if gmod.tc_types.expr_link_types.contains(link_end):
                int link_rtid = gmod.tc_types.expr_link_types.get(link_end).unwrap()
                if link_rtid >= 0 and link_rtid < gmod.tc_types.types.len():
                    match gmod.tc_types.types.get(link_rtid).unwrap():
                        case RTGeneric(def_id, _):
                            String base = gmod.tc_scopes.get_def(def_id).name
                            if equip_generic_names.contains(base):
                                SpannedType inst_ty = resolved_to_spanned_type(link_rtid, gmod.tc_types, gmod.tc_scopes)
                                match inst_ty.ty:
                                    case TNamed(_, inst_args):
                                        # inst_args are RESOLVER-typed (reconstructed
                                        # from expr_link_types' concrete instance), so
                                        # the type-variable ctx here is EMPTY — no
                                        # enclosing template params can appear in a
                                        # resolved chain-link type.
                                        Dict[String, bool] adp_empty_ctx = {}
                                        if inst_args.len() > 0 and not has_type_variable_ctx(inst_args, &adp_empty_ctx):
                                            String mangled = compute_mangled_name(inst_args, base)
                                            if not seen.contains(mangled):
                                                seen.put(mangled.clone(), true)
                                                instances.push(GenericInstance(base, inst_args, mangled))
                                    else:
                                        pass
                        else:
                            pass
        case ECall(callee_box, cargs, carg_names, ctargs):
            discover_adapter_chain_expr(*callee_box, &gmod, equip_generic_names, &seen, &instances)
            for a in cargs:
                discover_adapter_chain_expr(a, &gmod, equip_generic_names, &seen, &instances)
            # R43-C: register a turbofish-free generic FREE-FN call's instance.
            # `infer_free_fn_targs` binds the callee template's generic params
            # from the arg types (returns [] unless it's a known generic free-fn
            # with a fully-inferable positional call). The mangle site in
            # lower_expr re-derives the SAME targs, so the emitted symbol matches
            # this registered instance. Mirrors Rust gg's inferred_call_targs →
            # monomorphization discovery. Piggybacks on this already-gmod-threaded
            # walk (shares `seen` with the turbofish discovery, so no double-reg).
            if ctargs.len() == 0:
                match (*callee_box).expr:
                    case EIdentifier(cfname):
                        Vector[SpannedType] inf = infer_free_fn_targs(cfname, cargs, carg_names, &gmod)
                        if inf.len() > 0:
                            String cmangled = compute_mangled_name(inf, cfname)
                            if not seen.contains(cmangled):
                                seen.put(cmangled.clone(), true)
                                instances.push(GenericInstance(cfname, inf, cmangled))
                    else:
                        pass
        case EFieldAccess(obj, _):
            discover_adapter_chain_expr(*obj, &gmod, equip_generic_names, &seen, &instances)
        case EBinaryOp(l, _, r):
            discover_adapter_chain_expr(*l, &gmod, equip_generic_names, &seen, &instances)
            discover_adapter_chain_expr(*r, &gmod, equip_generic_names, &seen, &instances)
        case EUnaryOp(_, inner):
            discover_adapter_chain_expr(*inner, &gmod, equip_generic_names, &seen, &instances)
        case EIndex(b, i):
            discover_adapter_chain_expr(*b, &gmod, equip_generic_names, &seen, &instances)
            discover_adapter_chain_expr(*i, &gmod, equip_generic_names, &seen, &instances)
        case EClosure(_, cbody):
            discover_adapter_chain_stmts(cbody, &gmod, equip_generic_names, &seen, &instances)
        else:
            pass

void discover_adapter_chain_stmts(Vector[Stmt] stmts, GirModule &gmod, Dict[String, bool] equip_generic_names, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    for stmt in stmts:
        match stmt:
            case SVarDecl(_, _, init, _, _, _):
                discover_adapter_chain_expr(init, &gmod, equip_generic_names, &seen, &instances)
            case SExpr(e):
                discover_adapter_chain_expr(e, &gmod, equip_generic_names, &seen, &instances)
            case SReturn(opt):
                match opt:
                    case Some(e):
                        discover_adapter_chain_expr(e, &gmod, equip_generic_names, &seen, &instances)
                    case None:
                        pass
            case SAssign(_, e):
                discover_adapter_chain_expr(e, &gmod, equip_generic_names, &seen, &instances)
            case SIf(c, tb, elifs):
                discover_adapter_chain_expr(c, &gmod, equip_generic_names, &seen, &instances)
                discover_adapter_chain_stmts(tb, &gmod, equip_generic_names, &seen, &instances)
                for el in elifs:
                    discover_adapter_chain_stmts(el.body, &gmod, equip_generic_names, &seen, &instances)
            case SWhile(c, b, eb):
                discover_adapter_chain_expr(c, &gmod, equip_generic_names, &seen, &instances)
                discover_adapter_chain_stmts(b, &gmod, equip_generic_names, &seen, &instances)
                discover_adapter_chain_stmts(eb, &gmod, equip_generic_names, &seen, &instances)
            case SFor(_, p_iter, b, _, eb):
                discover_adapter_chain_expr(p_iter, &gmod, equip_generic_names, &seen, &instances)
                discover_adapter_chain_stmts(b, &gmod, equip_generic_names, &seen, &instances)
                discover_adapter_chain_stmts(eb, &gmod, equip_generic_names, &seen, &instances)
            case SMatch(scrut, arms):
                discover_adapter_chain_expr(scrut, &gmod, equip_generic_names, &seen, &instances)
                for arm in arms:
                    discover_adapter_chain_stmts(arm.body, &gmod, equip_generic_names, &seen, &instances)
            else:
                pass

# Expand generic calls inside meta for bodies to the 4 standard types.
# meta for T in type_variants(...): generates code for int, float, String, bool.
# `mf_ctx` holds the SMetaFor header's loop-var names (e.g. {T}) — a targ is
# a type variable iff it names one of them (never by name-shape guess).
void expand_meta_for_generics(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Dict[String, bool] &mf_ctx):
    # Standard column types that type_variants typically expands to.
    # Deliberately excludes 'bool' — variant_payloads() expands to enum payload
    # types (typically int/float/String), not bool.  Adding bool causes spurious
    # monomorphizations for fixtures like meta_variant_payloads.
    Vector[SpannedType] std_types = []
    std_types.push(SpannedType(TPrimitive("int"), -1))
    std_types.push(SpannedType(TPrimitive("float"), -1))
    std_types.push(SpannedType(TPrimitive("String"), -1))
    # Scan for generic calls with type variable args
    for stmt in stmts:
        expand_meta_for_stmt(stmt, &seen, &instances, std_types, &mf_ctx)

void expand_meta_for_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types, Dict[String, bool] &mf_ctx):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            expand_meta_for_expr(init, &seen, &instances, std_types, &mf_ctx)
        case SExpr(expr):
            expand_meta_for_expr(expr, &seen, &instances, std_types, &mf_ctx)
        case SReturn(opt):
            match opt:
                case Some(expr):
                    expand_meta_for_expr(expr, &seen, &instances, std_types, &mf_ctx)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            expand_meta_for_expr(cond, &seen, &instances, std_types, &mf_ctx)
            for ts in then_body:
                expand_meta_for_stmt(ts, &seen, &instances, std_types, &mf_ctx)
            for eb in branches:
                for ebs in eb.body:
                    expand_meta_for_stmt(ebs, &seen, &instances, std_types, &mf_ctx)
        case SMatch(scrutinee, arms):
            expand_meta_for_expr(scrutinee, &seen, &instances, std_types, &mf_ctx)
            for arm in arms:
                for abs in arm.body:
                    expand_meta_for_stmt(abs, &seen, &instances, std_types, &mf_ctx)
        else:
            pass

void expand_meta_for_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Vector[SpannedType] std_types, Dict[String, bool] &mf_ctx):
    match sexpr.expr:
        case ECall(callee_box, args, _, targs):
            if targs.len() > 0 and has_type_variable_ctx(targs, &mf_ctx):
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        # Expand each type variable to the 4 standard types
                        int ti = 0
                        while ti < std_types.len():
                            SpannedType concrete = std_types.get(ti).unwrap()
                            Vector[SpannedType] expanded = []
                            int tai = 0
                            while tai < targs.len():
                                SpannedType ta = targs.get(tai).unwrap()
                                bool is_var = false
                                match ta.ty:
                                    case TNamed(n, inner):
                                        # Substitute exactly the meta-for loop
                                        # vars — a short-named CONCRETE targ
                                        # (e.g. a user `struct Id` in
                                        # `foo[T, Id](...)`) stays as-is.
                                        if inner.len() == 0 and mf_ctx.contains(n):
                                            is_var = true
                                    else:
                                        pass
                                if is_var:
                                    expanded.push(concrete.clone())
                                else:
                                    expanded.push(ta)
                                tai += 1
                            String mangled = compute_mangled_name(expanded, fname)
                            if not seen.contains(mangled):
                                seen.put(mangled.clone(), true)
                                instances.push(GenericInstance(fname.clone(), !expanded, mangled))
                            ti += 1
                    else:
                        pass
            for arg in args:
                expand_meta_for_expr(arg, &seen, &instances, std_types, &mf_ctx)
        case EMethodCall(obj, _, margs, _, _):
            expand_meta_for_expr(*obj, &seen, &instances, std_types, &mf_ctx)
            for ma in margs:
                expand_meta_for_expr(ma, &seen, &instances, std_types, &mf_ctx)
        else:
            pass

# Discover generic call sites in an expression
void discover_generic_calls_expr(SpannedExpr sexpr, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Dict[String, bool] &tparams):
    match sexpr.expr:
        case ECall(callee_box, args, _, targs):
            if targs.len() > 0 and not has_type_variable_ctx(targs, &tparams):
                # R37-T2 (Core #4 sibling of the SVarDecl annotation path):
                # recurse into the call's OWN type-args via the shared type
                # walker so a NESTED generic (`foo[Wrapper[GNode[int]]](...)`)
                # discovers the inner `GNode[int]` too. Rust `scan_expr` scans
                # them (generics/mod.rs:672) before the identifier registration.
                for ta in targs:
                    discover_generic_calls_type(ta, &seen, &instances, &tparams)
                SpannedExpr callee = *callee_box
                match callee.expr:
                    case EIdentifier(fname):
                        String mangled = compute_mangled_name(targs, fname)
                        if not seen.contains(mangled):
                            seen.put(mangled.clone(), true)
                            GenericInstance gi = GenericInstance(fname, targs, mangled)
                            instances.push(!gi)
                    else:
                        pass
            # Recurse into call args
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances, &tparams)
            discover_generic_calls_expr(*callee_box, &seen, &instances, &tparams)
        case EMethodCall(obj, _, args, _, mtargs):
            discover_generic_calls_expr(*obj, &seen, &instances, &tparams)
            # R37-T2 (Core #4 sibling-drift): the method-call type-args were
            # IGNORED (`_`). Rust `scan_expr` scans them (generics/mod.rs:711)
            # so a turbofish like `v.collect[GNode[int]]()` discovers the
            # nested `GNode[int]`.
            for ta in mtargs:
                discover_generic_calls_type(ta, &seen, &instances, &tparams)
            for arg in args:
                discover_generic_calls_expr(arg, &seen, &instances, &tparams)
        case EBinaryOp(lhs, _, rhs):
            discover_generic_calls_expr(*lhs, &seen, &instances, &tparams)
            discover_generic_calls_expr(*rhs, &seen, &instances, &tparams)
        case EUnaryOp(_, inner):
            discover_generic_calls_expr(*inner, &seen, &instances, &tparams)
        case EIf(cond, then_body, branches):
            discover_generic_calls_expr(*cond, &seen, &instances, &tparams)
            discover_generic_calls_stmts(then_body, &seen, &instances, &tparams)
            # R37-T2: the elif/else branches were NOT walked (Rust `scan_expr`
            # walks them at generics/mod.rs:753-759) — a generic ctor in an
            # `else:` arm of an if-EXPRESSION was missed. Mirrors the SIf stmt
            # arm below.
            for eb in branches:
                match eb.condition:
                    case Some(elif_cond):
                        discover_generic_calls_expr(elif_cond, &seen, &instances, &tparams)
                    case None:
                        pass
                discover_generic_calls_stmts(eb.body, &seen, &instances, &tparams)
        case EFieldAccess(obj, _):
            discover_generic_calls_expr(*obj, &seen, &instances, &tparams)
        case EIndex(obj, idx):
            discover_generic_calls_expr(*obj, &seen, &instances, &tparams)
            discover_generic_calls_expr(*idx, &seen, &instances, &tparams)
        case EClosure(_, body):
            discover_generic_calls_stmts(body, &seen, &instances, &tparams)
        case EFString(_, fexprs, _):
            for fx in fexprs:
                discover_generic_calls_expr(fx, &seen, &instances, &tparams)
        # ── R37-T2 (Core #4): container / block / literal recurse-only arms ──
        # A generic-struct ctor nested in ANY of these was previously NEVER
        # visited (fell to `else: pass`), so its mono-struct body was never
        # registered → empty `{char __pad}` struct → `[bug] I64(0)` on a later
        # field read. These mirror Rust `scan_expr` (generics/mod.rs:663-806):
        # they RECURSE into sub-exprs but do NOT register — registration happens
        # only at the ECall/EMethodCall/SVarDecl type-arg sites through the
        # shared `discover_generic_calls_type` walker.
        case EArrayLiteral(aelems):
            for el in aelems:
                discover_generic_calls_expr(el, &seen, &instances, &tparams)
        case ETupleLiteral(telems):
            for el in telems:
                discover_generic_calls_expr(el, &seen, &instances, &tparams)
        case EStructLiteral(_, _, fvals):
            # ⚠ R3 (BLOCKING): the middle `Vector[String]` is FIELD NAMES, not
            # type args — do NOT register from it. Recurse ONLY the field VALUES
            # (`fvals`) so a nested ctor `S(f=GNode[int](...))` is discovered.
            # In-corpus generic-struct construction uses CALL syntax
            # `GNode[int](...)` (an ECall), never type-args-on-EStructLiteral,
            # so there is nothing to register here.
            for fv in fvals:
                discover_generic_calls_expr(fv, &seen, &instances, &tparams)
        case EDictLiteral(dkeys, dvals):
            for k in dkeys:
                discover_generic_calls_expr(k, &seen, &instances, &tparams)
            for dv in dvals:
                discover_generic_calls_expr(dv, &seen, &instances, &tparams)
        case EMatch(scrut, arms):
            discover_generic_calls_expr(*scrut, &seen, &instances, &tparams)
            for arm in arms:
                discover_generic_calls_stmts(arm.body, &seen, &instances, &tparams)
        case EBlock(bstmts):
            discover_generic_calls_stmts(bstmts, &seen, &instances, &tparams)
        case EDo(dstmts):
            discover_generic_calls_stmts(dstmts, &seen, &instances, &tparams)
        case ERange(opt_lo, opt_hi, _):
            match opt_lo:
                case Some(lo):
                    discover_generic_calls_expr(*lo, &seen, &instances, &tparams)
                case None:
                    pass
            match opt_hi:
                case Some(hi):
                    discover_generic_calls_expr(*hi, &seen, &instances, &tparams)
                case None:
                    pass
        case EMove(mv):
            discover_generic_calls_expr(*mv, &seen, &instances, &tparams)
        case EMutableBorrow(mb):
            discover_generic_calls_expr(*mb, &seen, &instances, &tparams)
        case EImplicitClosure(ic):
            discover_generic_calls_expr(*ic, &seen, &instances, &tparams)
        case EListComp(lc_body, _, lc_iter, lc_filter):
            discover_generic_calls_expr(*lc_body, &seen, &instances, &tparams)
            discover_generic_calls_expr(*lc_iter, &seen, &instances, &tparams)
            match lc_filter:
                case Some(lcf):
                    discover_generic_calls_expr(*lcf, &seen, &instances, &tparams)
                case None:
                    pass
        case ESetComp(sc_body, _, sc_iter, sc_filter):
            discover_generic_calls_expr(*sc_body, &seen, &instances, &tparams)
            discover_generic_calls_expr(*sc_iter, &seen, &instances, &tparams)
            match sc_filter:
                case Some(scf):
                    discover_generic_calls_expr(*scf, &seen, &instances, &tparams)
                case None:
                    pass
        case EDictComp(dc_key, dc_val, _, dc_iter, dc_filter):
            discover_generic_calls_expr(*dc_key, &seen, &instances, &tparams)
            discover_generic_calls_expr(*dc_val, &seen, &instances, &tparams)
            discover_generic_calls_expr(*dc_iter, &seen, &instances, &tparams)
            match dc_filter:
                case Some(dcf):
                    discover_generic_calls_expr(*dcf, &seen, &instances, &tparams)
                case None:
                    pass
        # ── R37-T2 (pass-3 completeness): pure recurse-only arms for the
        # remaining sub-expr-bearing self-host `Expr` variants (Rust `_ => {}`).
        # None has a reachable generic-ctor shape in the current corpus, but
        # they are added so the arm-count lint pins the FULL sub-expr-bearing
        # self-host `Expr` set — the next such variant is forced through. ──
        case EDotShorthand(_, dexprs):
            for de in dexprs:
                discover_generic_calls_expr(de, &seen, &instances, &tparams)
        case EAwait(aw):
            discover_generic_calls_expr(*aw, &seen, &instances, &tparams)
        case ESpawn(sp):
            discover_generic_calls_expr(*sp, &seen, &instances, &tparams)
        case ESpawnBlocking(spb):
            discover_generic_calls_expr(*spb, &seen, &instances, &tparams)
        case ETry(tr):
            discover_generic_calls_expr(*tr, &seen, &instances, &tparams)
        case EDeref(dr):
            discover_generic_calls_expr(*dr, &seen, &instances, &tparams)
        case EDefaultOp(do_l, do_r):
            discover_generic_calls_expr(*do_l, &seen, &instances, &tparams)
            discover_generic_calls_expr(*do_r, &seen, &instances, &tparams)
        case EIs(is_e, _, _):
            discover_generic_calls_expr(*is_e, &seen, &instances, &tparams)
        case EAs(as_e, _):
            discover_generic_calls_expr(*as_e, &seen, &instances, &tparams)
        case ERethrow(re1, _, _, re2):
            discover_generic_calls_expr(*re1, &seen, &instances, &tparams)
            discover_generic_calls_expr(*re2, &seen, &instances, &tparams)
        case ECatch(ce1, _, ce2):
            discover_generic_calls_expr(*ce1, &seen, &instances, &tparams)
            discover_generic_calls_expr(*ce2, &seen, &instances, &tparams)
        case EFaultCatch(fc1, _, fc2):
            discover_generic_calls_expr(*fc1, &seen, &instances, &tparams)
            discover_generic_calls_expr(*fc2, &seen, &instances, &tparams)
        else:
            pass

# R37-T2 (Core #4): shared walk of a TYPE annotation for nested generic
# instantiations, mirroring Rust gg's `scan_type` (generics/mod.rs:409-455).
# A `TNamed` with concrete type-args registers the instance AND recurses its
# args FIRST, so `Dict[String, GNode[int]]` discovers BOTH `Dict__…` and the
# nested `GNode__int64_t`. Invoked from ALL THREE targ sites (ECall targs,
# EMethodCall targs, SVarDecl annotation) so a nested generic in any of them is
# discovered — centralized at the producer, not patched per site. The self-host
# `Type` enum has NO `TRef`/`TOwned` (borrow/move are sigils, not Type
# variants), so there are no ref/owned arms. `seen`-dedup makes a double
# register a no-op.
void discover_generic_calls_type(SpannedType stype, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Dict[String, bool] &tparams):
    match stype.ty:
        case TNamed(tname, targs):
            if targs.len() > 0 and not has_type_variable_ctx(targs, &tparams):
                # Recurse into the args BEFORE registering the outer, so nested
                # instances (the `GNode[int]` inside `Dict[String, GNode[int]]`)
                # are discovered too. Mirrors Rust `scan_type` order.
                for ta in targs:
                    discover_generic_calls_type(ta, &seen, &instances, &tparams)
                String mangled = compute_mangled_name(targs, tname)
                if not seen.contains(mangled):
                    seen.put(mangled.clone(), true)
                    GenericInstance gi = GenericInstance(tname, targs, mangled)
                    instances.push(!gi)
        case TTuple(elems):
            for te in elems:
                discover_generic_calls_type(te, &seen, &instances, &tparams)
        case TFunction(ret, params, _):
            discover_generic_calls_type(*ret, &seen, &instances, &tparams)
            for pp in params:
                discover_generic_calls_type(pp, &seen, &instances, &tparams)
        case TArray(elem, _):
            discover_generic_calls_type(*elem, &seen, &instances, &tparams)
        case TSlice(elem):
            discover_generic_calls_type(*elem, &seen, &instances, &tparams)
        else:
            pass

void discover_generic_calls_stmt(Stmt stmt, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Dict[String, bool] &tparams):
    match stmt:
        case SVarDecl(stype, _, init, _, _, _):
            # Discover type instances from the annotation (e.g. `Stack[int] s`).
            # R37-T2 (Core #4): route through the shared `discover_generic_calls_type`
            # walker so a NESTED generic in the annotation
            # (`Dict[String, GNode[int]] d = {...}`) discovers the inner
            # `GNode[int]` too — the old inline `TNamed` match registered only
            # the OUTER type and dropped the nested targ.
            discover_generic_calls_type(stype, &seen, &instances, &tparams)
            discover_generic_calls_expr(init, &seen, &instances, &tparams)
        case SAssign(target, value):
            discover_generic_calls_expr(target, &seen, &instances, &tparams)
            discover_generic_calls_expr(value, &seen, &instances, &tparams)
        case SExpr(expr):
            discover_generic_calls_expr(expr, &seen, &instances, &tparams)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    discover_generic_calls_expr(expr, &seen, &instances, &tparams)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            discover_generic_calls_expr(cond, &seen, &instances, &tparams)
            discover_generic_calls_stmts(then_body, &seen, &instances, &tparams)
            for eb in branches:
                match eb.condition:
                    case Some(elif_cond):
                        discover_generic_calls_expr(elif_cond, &seen, &instances, &tparams)
                    case None:
                        pass
                discover_generic_calls_stmts(eb.body, &seen, &instances, &tparams)
        case SWhile(cond, body, _):
            discover_generic_calls_expr(cond, &seen, &instances, &tparams)
            discover_generic_calls_stmts(body, &seen, &instances, &tparams)
        case SFor(_, iter_expr, body, _, _):
            discover_generic_calls_expr(iter_expr, &seen, &instances, &tparams)
            discover_generic_calls_stmts(body, &seen, &instances, &tparams)
        case SMatch(scrutinee, arms):
            discover_generic_calls_expr(scrutinee, &seen, &instances, &tparams)
            for arm in arms:
                discover_generic_calls_stmts(arm.body, &seen, &instances, &tparams)
        case SMetaFor(mf_vars, mf_iter, meta_body):
            # Meta for type_variants: expand type-variable generic calls
            # to the standard column types. The header's loop-var names
            # (mf_vars) are the type-variable context for the body.
            Dict[String, bool] mf_ctx = {}
            for mf_var in mf_vars:
                mf_ctx.put(mf_var.clone(), true)
            expand_meta_for_generics(meta_body, &seen, &instances, &mf_ctx)
        else:
            pass

void discover_generic_calls_stmts(Vector[Stmt] stmts, Dict[String, bool] &seen, Vector[GenericInstance] &instances, Dict[String, bool] &tparams):
    for stmt in stmts:
        discover_generic_calls_stmt(stmt, &seen, &instances, &tparams)

# Lightweight type-to-C-name without GirModule (used during discovery before gmod exists)
String spanned_type_to_c_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            int pt = prim_name_to_type(name)
            if pt >= 0:
                return spanned_type_to_c_name(SpannedType(TPrimitive(name), -1))
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_c_name(ta)
            return result
        case TTuple(elems):
            # Tuple types mangle as "Tuple__<elem1>__<elem2>..." matching
            # lower_types.gg:spanned_type_to_name and the Rust reference.
            if elems.len() == 0:
                return "void"
            String result = "Tuple"
            for te in elems:
                result = result + "__" + spanned_type_to_c_name(te)
            return result
        case TFunction(_, _, _):
            # PROTO phase-1b: function-typed generic arg → GorgetClosure
            # (same as type_to_c_name), so the adapter struct instance name
            # agrees with the method-mono body + call-site symbol.
            return "GorgetClosure"
        else:
            pass
    return "int64_t"

# Context-aware type-variable check — the Rust-mirroring form
# (src/ir/lowering/generics/mod.rs:296 type_has_generic_param): a bare
# TNamed with no type args is a type VARIABLE iff its name is one of the
# ENCLOSING template's declared type params (`tparams`). No name-shape
# guessing — a user `enum V` or `struct Id` used as a generic arg in a
# non-generic context is CONCRETE (the retired `name.len() <= 2` heuristic
# misclassified those, so `Wrap[V]` / `Wrap[Id]` instances were never
# discovered → never monomorphized → link-fail / zeroed-field miscompile).
bool has_type_variable_ctx(Vector[SpannedType] targs, Dict[String, bool] &tparams):
    for ta in targs:
        match ta.ty:
            case TNamed(name, inner_targs):
                if inner_targs.len() == 0:
                    if tparams.contains(name):
                        return true
                else:
                    if has_type_variable_ctx(inner_targs, &tparams):
                        return true
            else:
                pass
    return false

String compute_mangled_name(Vector[SpannedType] targs, String base_name):
    String mangled = base_name
    for ta in targs:
        mangled = mangled + "__" + spanned_type_to_c_name(ta)
    return mangled

# Set up type substitutions for a generic instance.
void setup_type_subs(GirModule &gmod, Vector[String] type_params, Vector[SpannedType] type_args):
    gmod.type_subs = {}
    int i = 0
    while i < type_params.len() and i < type_args.len():
        String param_name = type_params.get(i).unwrap()
        SpannedType arg_type = type_args.get(i).unwrap()
        # Lazy-iterator mangle-unification (KEYSTONE): a function-typed
        # generic targ (the `F` of `MapIter[Iter,T,U,F]` / `FilterIter`)
        # is carried at runtime as a `GorgetClosure` (16-byte fn-ptr+env),
        # so its substitution must bind the `GorgetClosure` NAMED tid — the
        # same decision the ctor/struct/for-loop path makes (`type_to_c_name`
        # TFunction arm `:3160`) and the ResolvedType→GIR mapper makes
        # (`resolved_to_gir_type` RTFunction arm `:3386`). The general
        # `map_ast_type(TFunction)` instead returns a `Ptr(FnPtr)` tid, which
        # `type_id_to_name` derefs to no `GtNamed` and collapses to the
        # `int64_t` default — diverging the equip-`next`-body mono symbol
        # (`MapIter__…__int64_t__next` with an empty `{char __pad}` struct +
        # orphaned `unknown field 'inner'/'f'`) from the for-loop dispatcher's
        # `MapIter__…__GorgetClosure__next`. Narrowed to TFunction targs only
        # (no collateral on other generic equips). One funnel → centralized.
        int tid = -1
        match arg_type.ty:
            case TFunction(_, _, _):
                tid = lookup_or_register_named(&gmod, "GorgetClosure")
            else:
                tid = map_ast_type(arg_type, &gmod)
        gmod.type_subs.put(param_name, tid)
        i += 1

void clear_type_subs(GirModule &gmod):
    gmod.type_subs = {}

# ── [PROTOTYPE] Delayed-meta engine (monomorphization time) ──────────
# Mirrors Rust src/semantic/meta.rs evaluate_delayed_meta_block, wired at
# src/ir/lowering/functions.rs:852 (per-monomorphization, after type
# substitution, before GIR lowering). The self-host previously DROPPED
# every statement-body `meta if` (lower_stmt.gg SMetaIf -> pass), so a
# `meta if typename(T) == "int":` body silently vanished and the generic
# function returned garbage. Here we evaluate each `meta if` against the
# concrete type args known at this instantiation and SPLICE the winning
# branch's statements into the function body BEFORE lowering.
#
# PROTOTYPE SCOPE: handles `typename(T) (==|!=) "literal"` and
# `sizeof(T) (==|...) N` conditions (covers meta_delayed_basic/_nested/
# _match/_for, meta_log). `T is Category` (meta_type_is) and
# implements()/fields()/variant_names() reflection are follow-on slices.

# Build param-name -> typename map from the concrete type args.
Dict[String, String] build_meta_typename_env(Vector[String] type_params, Vector[SpannedType] type_args):
    Dict[String, String] env = {}
    int i = 0
    while i < type_params.len() and i < type_args.len():
        String pn = type_params.get(i).unwrap()
        SpannedType ta = type_args.get(i).unwrap()
        env.put(pn, meta_typename(ta.ty))
        i += 1
    return env

# Resolve a `typename(T)` / `sizeof(T)` call against the concrete env.
# Returns "" (string result) via out-params: kind 0=unknown, 1=string,
# 2=int. Kept minimal for the prototype.
String eval_meta_builtin_str(SpannedExpr se, Dict[String, String] &tn_env, bool &is_str):
    is_str = false
    match se.expr:
        case EStringLiteral(s, _):
            is_str = true
            return s
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    # `typeof` is identical to `typename` in Rust (meta.rs:2836
                    # vs :2800 — both return type_to_canonical_name of the
                    # resolved type param). Accept both spellings here.
                    if (fname == "typename" or fname == "typeof") and args.len() == 1:
                        match args.get(0).unwrap().expr:
                            case EIdentifier(tparam):
                                if tn_env.contains(tparam):
                                    is_str = true
                                    return tn_env[tparam]
                                # Not a bound type param: it's a CONCRETE type
                                # used directly (e.g. typename(int) in a
                                # non-generic context). Fall back to the literal
                                # type name, mirroring Rust meta.rs:2811-2812
                                # (typename) / :2846 (typeof) and the int-builtin
                                # idiom resolve_meta_tparam (returns tparam for a
                                # non-tparam). Without this the concrete case
                                # leaves is_str=false → the meta-if/match silently
                                # drops (Core #8 divergence vs the Rust oracle).
                                is_str = true
                                return tparam
                            else:
                                pass
                else:
                    pass
        else:
            pass
    return ""

# ── PROTOTYPE slice #4b: int/string meta-const env + enum reflection ──
# Resolve the concrete typename for a meta builtin's first argument
# (a type-param identifier), routing through tn_env. Returns "" if the
# arg is not a bare identifier or not in the env.
String resolve_meta_tparam(SpannedExpr arg, Dict[String, String] &tn_env):
    match arg.expr:
        case EIdentifier(tparam):
            if tn_env.contains(tparam):
                return tn_env.get(tparam).unwrap()
            return tparam
        else:
            return ""

# Evaluate an integer-valued meta expression against the per-mono env.
# Handles int literals, bound int meta-consts / loop-vars (int_env),
# sizeof/bitwidth(T), variant_count(T), and enum_ordinal(T, "Variant").
# Mirrors Rust eval_delayed_expr's int-producing builtins (meta.rs:3045
# variant_count, :3129 enum_ordinal). ok=false => unevaluable (caller
# leaves the construct inert, matching Rust).
int eval_meta_int_v2(SpannedExpr se, Dict[String, String] &tn_env, Dict[String, int] &int_env, GirModule &gmod, bool &ok):
    ok = false
    match se.expr:
        case EIntLiteral(n):
            ok = true
            return n
        case EIdentifier(name):
            # A bound int meta-const / int loop-var.
            if int_env.contains(name):
                ok = true
                return int_env.get(name).unwrap()
            return 0
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    if (fname == "sizeof" or fname == "bitwidth") and args.len() == 1:
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if concrete != "":
                            int byts = meta_type_byte_size(concrete)
                            ok = true
                            if fname == "bitwidth":
                                return byts * 8
                            return byts
                    elif fname == "min_val" and args.len() == 1:
                        # Integer-type lower bound. Mirrors Rust meta.rs:2867:
                        # signed -> type min, unsigned -> 0. Unknown/non-int
                        # type leaves ok=false (construct stays inert).
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if concrete == "int8":
                            ok = true
                            return 0 - 128
                        elif concrete == "int16":
                            ok = true
                            return 0 - 32768
                        elif concrete == "int32":
                            ok = true
                            return 0 - 2147483648
                        elif concrete == "int" or concrete == "int64":
                            # i64::MIN; written as -(i64::MAX) - 1 because the
                            # bare magnitude 9223372036854775808 overflows a
                            # positive i64 literal and fails to parse.
                            ok = true
                            return -9223372036854775807 - 1
                        elif concrete == "uint8" or concrete == "uint16" or concrete == "uint32" or concrete == "uint64" or concrete == "uint":
                            ok = true
                            return 0
                    elif fname == "max_val" and args.len() == 1:
                        # Integer-type upper bound. Mirrors Rust meta.rs:2886.
                        # uint/uint64 saturate at i64::MAX (same as Rust).
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if concrete == "int8":
                            ok = true
                            return 127
                        elif concrete == "int16":
                            ok = true
                            return 32767
                        elif concrete == "int32":
                            ok = true
                            return 2147483647
                        elif concrete == "int" or concrete == "int64":
                            ok = true
                            return 9223372036854775807
                        elif concrete == "uint8":
                            ok = true
                            return 255
                        elif concrete == "uint16":
                            ok = true
                            return 65535
                        elif concrete == "uint32":
                            ok = true
                            return 4294967295
                        elif concrete == "uint" or concrete == "uint64":
                            ok = true
                            return 9223372036854775807
                    elif fname == "variant_count" and args.len() == 1:
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if concrete != "" and gmod.enum_registry.contains(concrete):
                            ok = true
                            return gmod.enum_registry.get(concrete).unwrap().len()
                    elif fname == "field_count" and args.len() == 1:
                        # Struct field reflection. Mirrors Rust meta.rs:2947
                        # field_count -> s.fields.len(). Reads the registered
                        # GirTypeInfo.fields (the same data eval_meta_fields and
                        # meta_type_category_is consult).
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if concrete != "" and gmod.type_infos.contains(concrete):
                            GirTypeInfo ti = gmod.type_infos.get(concrete).unwrap()
                            if not ti.is_enum:
                                ok = true
                                return ti.fields.len()
                    elif fname == "enum_ordinal" and args.len() == 2:
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        # 2nd arg: a string literal (post-subst the loop var
                        # `vname` becomes an EStringLiteral).
                        String want = ""
                        match args.get(1).unwrap().expr:
                            case EStringLiteral(s, _):
                                want = s
                            else:
                                pass
                        if concrete != "" and want != "" and gmod.enum_registry.contains(concrete):
                            Vector[String] vnames = gmod.enum_registry.get(concrete).unwrap()
                            int vi = 0
                            while vi < vnames.len():
                                if vnames.get(vi).unwrap() == want:
                                    ok = true
                                    return vi
                                vi += 1
                else:
                    pass
        else:
            pass
    return 0

# Evaluate a string-valued meta expression for a meta-const RHS.
# Handles string literals and enum_from_ordinal(T, n). ok=false =>
# unevaluable. Mirrors Rust eval_delayed_expr enum_from_ordinal
# (meta.rs:3157).
String eval_meta_str_v2(SpannedExpr se, Dict[String, String] &tn_env, Dict[String, int] &int_env, GirModule &gmod, bool &ok):
    ok = false
    match se.expr:
        case EStringLiteral(s, _):
            ok = true
            return s
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    if (fname == "typename" or fname == "typeof") and args.len() == 1:
                        # typeof/typename(T): resolve a bound type param via
                        # tn_env, else fall back to the literal type name for a
                        # CONCRETE type (e.g. typename(int) → "int"). Mirrors
                        # Rust meta.rs:2811-2812 / :2846 and resolve_meta_tparam
                        # (which already returns the literal name for a
                        # non-tparam). eval_meta_builtin_str also covers this for
                        # the comparison/cond paths; this arm covers the
                        # str-v2-only call sites (e.g. `meta const s =
                        # typename(int)`). Without it the concrete case is a
                        # Core #8 silent-drop vs the Rust oracle.
                        String tn = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        if tn != "":
                            ok = true
                            return tn
                    elif fname == "platform" and args.len() == 0:
                        # Compile-time platform string. Mirrors Rust
                        # meta.rs:1015, which returns the HOST platform via
                        # cfg!(target_os). The self-host compiler is a native
                        # binary linked against the runtime, so calling the
                        # `gorget_platform` extern at lowering time yields the
                        # same host platform ("linux" on this build). Bind to a
                        # String VarDecl first so the cstr->String coercion
                        # fires (it only fires at an SVarDecl, not in return
                        # position).
                        String plat = platform()
                        ok = true
                        return plat
                    elif fname == "enum_from_ordinal" and args.len() == 2:
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        bool iok = false
                        int ord = eval_meta_int_v2(args.get(1).unwrap(), &tn_env, &int_env, &gmod, &iok)
                        if concrete != "" and iok and gmod.enum_registry.contains(concrete):
                            Vector[String] vnames = gmod.enum_registry.get(concrete).unwrap()
                            if ord >= 0 and ord < vnames.len():
                                ok = true
                                return vnames.get(ord).unwrap()
                    elif fname == "field_type" and args.len() == 2:
                        # Struct field reflection. Mirrors Rust meta.rs:2989
                        # field_type -> type_id_to_canonical_name of the named
                        # field's type. demangle_field_type_name maps the
                        # registered C-level type name (int64_t/double/...) back
                        # to the Gorget spelling (int/float/...), matching Rust's
                        # canonical-name output.
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        String want = ""
                        match args.get(1).unwrap().expr:
                            case EStringLiteral(s, _):
                                want = s
                            else:
                                pass
                        if concrete != "" and want != "" and gmod.type_infos.contains(concrete):
                            GirTypeInfo ti = gmod.type_infos.get(concrete).unwrap()
                            if not ti.is_enum:
                                for f in ti.fields:
                                    if f.name == want:
                                        ok = true
                                        return demangle_field_type_name(f.type_name)
                else:
                    pass
        else:
            pass
    return ""

# Compare two meta expressions for value-equality, for `meta match` arm
# selection. Tries int-eval on both (sizeof/bitwidth/min_val/max_val/literal/
# int-const); if both are ints, compares them. Otherwise tries string-eval on
# both (typeof/typename/enum_from_ordinal/string literal) and compares. Sets
# ok=false if neither side pair is evaluable (caller leaves the arm unmatched).
# Mirrors Rust meta_values_eq (meta.rs:2737) over two eval_delayed_expr results.
bool meta_value_eq_v2(SpannedExpr a, SpannedExpr b, Dict[String, String] &tn_env, Dict[String, int] &int_env, GirModule &gmod, bool &ok):
    ok = false
    bool ai = false
    bool bi = false
    int av = eval_meta_int_v2(a, &tn_env, &int_env, &gmod, &ai)
    int bv = eval_meta_int_v2(b, &tn_env, &int_env, &gmod, &bi)
    if ai and bi:
        ok = true
        return av == bv
    bool as_ = false
    bool bs = false
    String asv = eval_meta_builtin_str(a, &tn_env, &as_)
    if not as_:
        asv = eval_meta_str_v2(a, &tn_env, &int_env, &gmod, &as_)
    String bsv = eval_meta_builtin_str(b, &tn_env, &bs)
    if not bs:
        bsv = eval_meta_str_v2(b, &tn_env, &int_env, &gmod, &bs)
    if as_ and bs:
        ok = true
        return asv == bsv
    return false

# Evaluate a `meta if`/`meta elif` condition against the concrete env.
# Sets ok=false if the condition is not in the supported prototype subset
# (caller then leaves the meta-if inert, matching Rust's behavior).
bool eval_delayed_meta_cond(SpannedExpr cond, Dict[String, String] &tn_env, Dict[String, int] &int_env, GirModule &gmod, bool &ok):
    ok = false
    match cond.expr:
        case EBinaryOp(l, op, r):
            if op == "==" or op == "!=":
                # Try string comparison: typename(T) == "literal",
                # field_type(T, "f") == "literal". eval_meta_builtin_str
                # handles typename + string literals; fall back to
                # eval_meta_str_v2 for the richer string-valued builtins
                # (field_type, enum_from_ordinal) on either side.
                bool ls = false
                bool rs = false
                String lv = eval_meta_builtin_str(*l, &tn_env, &ls)
                String rv = eval_meta_builtin_str(*r, &tn_env, &rs)
                if not ls:
                    bool ls2 = false
                    String lv2 = eval_meta_str_v2(*l, &tn_env, &int_env, &gmod, &ls2)
                    if ls2:
                        ls = true
                        lv = lv2
                if not rs:
                    bool rs2 = false
                    String rv2 = eval_meta_str_v2(*r, &tn_env, &int_env, &gmod, &rs2)
                    if rs2:
                        rs = true
                        rv = rv2
                if ls and rs:
                    ok = true
                    bool eq = (lv == rv)
                    if op == "==":
                        return eq
                    return not eq
                # Try int comparison: sizeof(T) == N, or `i == 0` for an
                # int loop-var / meta-const bound in int_env.
                bool li = false
                bool ri = false
                int liv = eval_meta_int_v2(*l, &tn_env, &int_env, &gmod, &li)
                int riv = eval_meta_int_v2(*r, &tn_env, &int_env, &gmod, &ri)
                if li and ri:
                    ok = true
                    bool ieq = (liv == riv)
                    if op == "==":
                        return ieq
                    return not ieq
            elif op == "<" or op == ">" or op == "<=" or op == ">=":
                bool li = false
                bool ri = false
                int liv = eval_meta_int_v2(*l, &tn_env, &int_env, &gmod, &li)
                int riv = eval_meta_int_v2(*r, &tn_env, &int_env, &gmod, &ri)
                if li and ri:
                    ok = true
                    if op == "<":
                        return liv < riv
                    elif op == ">":
                        return liv > riv
                    elif op == "<=":
                        return liv <= riv
                    else:
                        return liv >= riv
            elif op == "or" or op == "and":
                # `meta if T is signed or T is float:` — recurse on each
                # operand (each typically an `is` predicate) and combine.
                # Both operands must be recognized for the meta-cond to be
                # decided; otherwise leave the construct inert (ok=false).
                bool lok = false
                bool rok = false
                bool lvb = eval_delayed_meta_cond(*l, &tn_env, &int_env, &gmod, &lok)
                bool rvb = eval_delayed_meta_cond(*r, &tn_env, &int_env, &gmod, &rok)
                if lok and rok:
                    ok = true
                    if op == "or":
                        return lvb or rvb
                    return lvb and rvb
        case EIs(lhs, negated, pat):
            # `ftype is numeric:` (after meta-for subst, lhs is an
            # EStringLiteral of the field's source type name) OR
            # `meta if T is float:` where T is a bare generic type-param
            # (lhs is an EIdentifier resolved through tn_env). The pattern
            # is a bare category name (PBinding/PConstructor).
            String category = ""
            match (*pat).pat:
                case PBinding(cat):
                    category = cat
                case PConstructor(cat, _):
                    category = cat
                else:
                    pass
            bool ls = false
            String lv = ""
            match (*lhs).expr:
                case EStringLiteral(s, _):
                    ls = true
                    lv = s
                case EIdentifier(tparam):
                    # Resolve a direct type-param `T` to its concrete type
                    # name via tn_env (the same map the EStringLiteral path
                    # ultimately consults). Mirrors Rust's delayed `T is C`
                    # check resolving T against the monomorphization binding.
                    if tn_env.contains(tparam):
                        ls = true
                        lv = tn_env.get(tparam).unwrap()
                else:
                    pass
            if ls and category != "":
                bool cat_ok = false
                bool is_cat = meta_type_category_is(lv, category, &gmod, &cat_ok)
                if cat_ok:
                    ok = true
                    if negated:
                        return not is_cat
                    return is_cat
        case ECall(callee, args, _, _):
            # Bare bool-valued reflection predicate as the whole meta-if
            # condition (`meta if has_field(T, "z"):`). Without this arm the
            # cond is unrecognized -> inert -> the generic fn returns garbage.
            # Mirrors Rust meta.rs:2966 has_field -> s.fields.any(name==f).
            match (*callee).expr:
                case EIdentifier(fname):
                    if fname == "has_field" and args.len() == 2:
                        String concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        String want = ""
                        match args.get(1).unwrap().expr:
                            case EStringLiteral(s, _):
                                want = s
                            else:
                                pass
                        if concrete != "" and want != "":
                            ok = true
                            if gmod.type_infos.contains(concrete):
                                GirTypeInfo ti = gmod.type_infos.get(concrete).unwrap()
                                if not ti.is_enum:
                                    for f in ti.fields:
                                        if f.name == want:
                                            return true
                            # Unknown type or no such field: Rust returns false
                            # (meta.rs:2984/2986), NOT inert.
                            return false
                    if fname == "implements" and args.len() == 2:
                        # `implements(T, "Trait")` — compile-time trait-impl
                        # predicate. Mirrors Rust meta.rs:2908 ->
                        # TraitRegistry::has_trait_impl_by_name (traits.rs:331):
                        # (1) explicit/derived equip (gmod.trait_impls_by_type),
                        # then (2) intrinsic-primitive satisfaction rules. Rust
                        # returns false (NOT inert) when neither matches.
                        String it_concrete = resolve_meta_tparam(args.get(0).unwrap(), &tn_env)
                        String it_trait = ""
                        match args.get(1).unwrap().expr:
                            case EStringLiteral(s, _):
                                it_trait = s
                            else:
                                pass
                        if it_concrete != "" and it_trait != "":
                            ok = true
                            # (1) explicit/derived equip table
                            if gmod.trait_impls_by_type.contains(it_concrete):
                                Vector[String] it_traits = gmod.trait_impls_by_type.get(it_concrete).unwrap()
                                for tn in it_traits:
                                    if tn == it_trait:
                                        return true
                            # (2) intrinsic-primitive satisfaction (traits.rs:339)
                            return meta_intrinsic_implements(it_concrete, it_trait)
                else:
                    pass
        else:
            pass
    return false

# Replicates Rust's intrinsic trait satisfaction
# (`src/semantic/traits.rs:339-351`): numeric primitives satisfy numeric
# traits; hashable primitives satisfy Hashable/Equatable; all primitives +
# String are Cloneable/Displayable/Debuggable. No registry needed — these
# hold by the primitive's nature, mirroring the Rust intrinsic-satisfaction
# block in `has_trait_impl_by_name`.
bool meta_is_numeric_primitive(String name):
    return name == "int" or name == "int8" or name == "int16" or name == "int32" or name == "int64" or name == "uint" or name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64" or name == "float" or name == "float32" or name == "float64"

bool meta_is_numeric_trait(String name):
    return name == "Numeric" or name == "Add" or name == "Sub" or name == "Mul" or name == "Div" or name == "Rem" or name == "Mod" or name == "Neg" or name == "Comparable" or name == "Equatable" or name == "Default" or name == "One"

bool meta_is_hashable_primitive(String name):
    return meta_is_numeric_primitive(name) or name == "str" or name == "bool" or name == "char" or name == "String"

bool meta_intrinsic_implements(String type_name, String trait_name):
    if meta_is_numeric_primitive(type_name) and meta_is_numeric_trait(trait_name):
        return true
    if meta_is_hashable_primitive(type_name) and (trait_name == "Hashable" or trait_name == "Equatable"):
        return true
    # All primitives + String are Cloneable / Displayable / Debuggable.
    if meta_is_hashable_primitive(type_name) and (trait_name == "Cloneable" or trait_name == "Displayable" or trait_name == "Debuggable"):
        return true
    return false

# ── PROTOTYPE slice #4: meta-for-over-reflection unroll ──────────────
# `meta for fname, ftype in fields(T):` / `meta for vname in
# variant_names(T):` must materialize their loop-vars per concrete T at
# monomorphization. The engine evaluates the iterable against the
# concrete type (looked up in gmod.type_infos / gmod.enum_registry),
# binds each loop-var to a string value per iteration, substitutes those
# bindings into the body (f-string parts + bare identifier renames), and
# splices the unrolled statements. Mirrors Rust src/semantic/meta.rs
# evaluate_delayed_meta_block's Stmt::MetaFor List-expression arm.

# Reverse the C-mangle so fields() reports SOURCE-level type names
# (Point.x : "double" -> "float"), matching Rust fields() which reads the
# type registry's canonical names and normalizes GorgetString -> String.
# This is the de-mangle boundary (the type_info type_name is the C
# contract; here we map it back to the user-facing spelling), the inverse
# of lower_types.gg prim_to_c_name. NOTE: partial inverse — covers the
# primitives meta_fields exercises (float/String/int/bool + sized int
# siblings); does NOT yet cover u8->byte (harmless for 4a, add when 4b
# needs it).
String demangle_field_type_name(String cname):
    match cname:
        case "int64_t":
            return "int"
        case "double":
            return "float"
        case "GorgetString":
            return "String"
        case "bool":
            return "bool"
        case "int8_t":
            return "int8"
        case "int16_t":
            return "int16"
        case "int32_t":
            return "int32"
        case "uint64_t":
            return "uint"
        case "uint8_t":
            return "uint8"
        case "uint16_t":
            return "uint16"
        case "uint32_t":
            return "uint32"
        case "float":
            return "float32"
        else:
            return cname

# `ftype is numeric:` (and a few sibling category predicates) used inside
# meta-for bodies. Mirrors Rust's meta `is`-category check on the
# resolved type string. Returns the boolean and sets ok=true when the
# predicate is recognized.
bool meta_type_category_is(String tyname, String category, GirModule &gmod, bool &ok):
    ok = true
    # Category families mirror Rust src/semantic/meta.rs eval_type_is_check.
    if category == "int" or category == "integer" or category == "numeric":
        bool is_int = tyname == "int8" or tyname == "int16" or tyname == "int32" or tyname == "int" or tyname == "int64" or tyname == "uint8" or tyname == "uint16" or tyname == "uint32" or tyname == "uint" or tyname == "uint64"
        if category == "numeric":
            return is_int or tyname == "float32" or tyname == "float" or tyname == "float64"
        return is_int
    elif category == "float":
        return tyname == "float32" or tyname == "float" or tyname == "float64"
    elif category == "signed":
        return tyname == "int8" or tyname == "int16" or tyname == "int32" or tyname == "int" or tyname == "int64"
    elif category == "unsigned":
        return tyname == "uint8" or tyname == "uint16" or tyname == "uint32" or tyname == "uint" or tyname == "uint64"
    elif category == "bool":
        return tyname == "bool"
    elif category == "Enum" or category == "enum":
        # Registry-backed: true when the resolved type is a user enum.
        # Mirrors Rust's TypeDefKind::Enum check against the type registry.
        if gmod.type_infos.contains(tyname):
            return gmod.type_infos.get(tyname).unwrap().is_enum
        return false
    elif category == "Struct" or category == "struct":
        # Registry-backed: true when the resolved type is a user struct.
        # Mirrors Rust's TypeDefKind::Struct check against the type registry.
        if gmod.type_infos.contains(tyname):
            return not gmod.type_infos.get(tyname).unwrap().is_enum
        return false
    # Exact match for everything else (bool, str, String, char, void,
    # float32, int8, uint64, MyStruct, …) — Rust's
    # `"bool" | "str" | "String" | "char" | "void" => resolved == category`
    # and `other => resolved == other` arms collapse to one equality here.
    # NOTE: there is NO `string` category in Rust — `T is string` correctly
    # falls through to this exact-match (false for every real type).
    return tyname == category

# Substitute the meta-for loop-var string bindings into an expression.
# A bare `EIdentifier(name)` bound in `sv` becomes an `EStringLiteral`,
# EXCEPT when used as the callee of a call (`vname(w)`) — there it is an
# identifier RENAME (ctor-call), mirroring Rust substitute_expr's
# Expr::Call special-case. Recurses structurally (f-string parts handled
# so `f"{fname}:{ftype}"` prints the substituted value).
SpannedExpr subst_mf_expr(SpannedExpr se, Dict[String, String] &sv, Dict[String, int] &iv):
    match se.expr:
        case EIdentifier(name):
            # PROTOTYPE 4b: int-bound names (int loop-var / int meta-const)
            # become EIntLiteral so `f"{idx}"` prints `0` (not `"0"`) and
            # `meta if i == 0` sees an int. String-bound names become
            # EStringLiteral (the 4a path). Mirrors Rust meta_value_to_expr.
            if iv.contains(name):
                return SpannedExpr(EIntLiteral(iv.get(name).unwrap()), se.span)
            if sv.contains(name):
                return SpannedExpr(EStringLiteral(sv.get(name).unwrap(), false), se.span)
            return se
        case EBinaryOp(l, op, r):
            return SpannedExpr(EBinaryOp(Box(subst_mf_expr(*l, &sv, &iv)), op, Box(subst_mf_expr(*r, &sv, &iv))), se.span)
        case EUnaryOp(op, operand):
            return SpannedExpr(EUnaryOp(op, Box(subst_mf_expr(*operand, &sv, &iv))), se.span)
        case ECall(callee, args, arg_names, targs):
            # Ctor-call rename: a bare `vname(...)` callee bound to a
            # string becomes `Circle(...)` (identifier), NOT
            # `"Circle"(...)` (string literal).
            SpannedExpr new_callee = *callee
            match (*callee).expr:
                case EIdentifier(cname):
                    if sv.contains(cname):
                        new_callee = SpannedExpr(EIdentifier(sv.get(cname).unwrap()), (*callee).span)
                else:
                    new_callee = subst_mf_expr(*callee, &sv, &iv)
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            for a in args:
                na.push(subst_mf_expr(a, &sv, &iv))
            return SpannedExpr(ECall(Box(new_callee), na, arg_names, targs), se.span)
        case EMethodCall(recv, mname, args, arg_names, targs):
            Vector[SpannedExpr] na = Vector[SpannedExpr]()
            for a in args:
                na.push(subst_mf_expr(a, &sv, &iv))
            return SpannedExpr(EMethodCall(Box(subst_mf_expr(*recv, &sv, &iv)), mname, na, arg_names, targs), se.span)
        case EFieldAccess(base, fname):
            return SpannedExpr(EFieldAccess(Box(subst_mf_expr(*base, &sv, &iv)), fname), se.span)
        case EIndex(base, idx):
            return SpannedExpr(EIndex(Box(subst_mf_expr(*base, &sv, &iv)), Box(subst_mf_expr(*idx, &sv, &iv))), se.span)
        case EFString(raw, parts, specs):
            Vector[SpannedExpr] np = Vector[SpannedExpr]()
            for p in parts:
                np.push(subst_mf_expr(p, &sv, &iv))
            # Carry the per-segment format specs through unchanged.
            return SpannedExpr(EFString(raw, np, specs), se.span)
        case EArrayLiteral(elems):
            Vector[SpannedExpr] ne = Vector[SpannedExpr]()
            for e in elems:
                ne.push(subst_mf_expr(e, &sv, &iv))
            return SpannedExpr(EArrayLiteral(ne), se.span)
        case EIs(inner, negated, pat):
            # `ftype is numeric` — substitute the LHS (the loop-var) so the
            # meta-cond engine sees `"int" is numeric` post-unroll. Rebuild
            # OWNED (never return the borrowed `se`): the pattern (category
            # name) is carried through via a value copy.
            SpannedPattern pat_copy = *pat
            return SpannedExpr(EIs(Box(subst_mf_expr(*inner, &sv, &iv)), negated, Box(pat_copy)), se.span)
        else:
            return se

# Substitute the loop-var bindings (string `sv` + int `iv`) into a
# statement list.
Vector[Stmt] subst_mf_stmts(Vector[Stmt] stmts, Dict[String, String] &sv, Dict[String, int] &iv):
    Vector[Stmt] out = Vector[Stmt]()
    for s in stmts:
        match s:
            case SExpr(e):
                out.push(SExpr(subst_mf_expr(e, &sv, &iv)))
            case SReturn(oe):
                match oe:
                    case Some(e):
                        out.push(SReturn(Some(subst_mf_expr(e, &sv, &iv))))
                    case None:
                        out.push(s)
            case SVarDecl(ty, name, val, a, b, c):
                out.push(SVarDecl(ty, name, subst_mf_expr(val, &sv, &iv), a, b, c))
            case SAssign(lhs, rhs):
                out.push(SAssign(subst_mf_expr(lhs, &sv, &iv), subst_mf_expr(rhs, &sv, &iv)))
            case SCompoundAssign(lhs, op, rhs):
                out.push(SCompoundAssign(subst_mf_expr(lhs, &sv, &iv), op, subst_mf_expr(rhs, &sv, &iv)))
            case SIf(cond, then_b, branches):
                Vector[ElseBranch] nb = Vector[ElseBranch]()
                for eb in branches:
                    Option[SpannedExpr] nc = None
                    match eb.condition:
                        case Some(c):
                            nc = Some(subst_mf_expr(c, &sv, &iv))
                        case None:
                            nc = None
                    nb.push(ElseBranch(nc, subst_mf_stmts(eb.body, &sv, &iv)))
                out.push(SIf(subst_mf_expr(cond, &sv, &iv), subst_mf_stmts(then_b, &sv, &iv), nb))
            case SMetaConst(mc_name, mc_val):
                # PROTOTYPE 4b: substitute loop-var / outer-const references
                # into the const's value expr (e.g. `enum_ordinal(T, vname)`
                # → `enum_ordinal(T, "North")`) so the engine can evaluate it.
                out.push(SMetaConst(mc_name, subst_mf_expr(mc_val, &sv, &iv)))
            case SMetaIf(meta_cond, then_body, elif_branches):
                Vector[ElseBranch] nb = Vector[ElseBranch]()
                for eb in elif_branches:
                    Option[SpannedExpr] nc = None
                    match eb.condition:
                        case Some(c):
                            nc = Some(subst_mf_expr(c, &sv, &iv))
                        case None:
                            nc = None
                    nb.push(ElseBranch(nc, subst_mf_stmts(eb.body, &sv, &iv)))
                out.push(SMetaIf(subst_mf_expr(meta_cond, &sv, &iv), subst_mf_stmts(then_body, &sv, &iv), nb))
            case SWhile(cond, body, else_b):
                out.push(SWhile(subst_mf_expr(cond, &sv, &iv), subst_mf_stmts(body, &sv, &iv), subst_mf_stmts(else_b, &sv, &iv)))
            case SFor(pat, iter_e, body, own, else_b):
                out.push(SFor(pat, subst_mf_expr(iter_e, &sv, &iv), subst_mf_stmts(body, &sv, &iv), own, subst_mf_stmts(else_b, &sv, &iv)))
            case SMatch(scrut, arms):
                Vector[MatchArm] na = Vector[MatchArm]()
                for a in arms:
                    na.push(MatchArm(a.pattern, a.guard, subst_mf_stmts(a.body, &sv, &iv)))
                out.push(SMatch(subst_mf_expr(scrut, &sv, &iv), na))
            else:
                out.push(s)
    return out

# Resolve a meta-for iterable of the form `fields(T)` to the list of
# (field-name, source-type-name) pairs for the concrete T. Sets ok=false
# if the iterable is not a recognized `fields(<param>)` call or the
# concrete type is not a registered struct. tn_env maps the type param
# (e.g. "T") to its concrete typename (e.g. "Point").
bool eval_meta_fields(SpannedExpr iter_e, Dict[String, String] &tn_env, GirModule &gmod, Vector[String] &out_names, Vector[String] &out_types):
    match iter_e.expr:
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    if fname == "fields" and args.len() == 1:
                        match args.get(0).unwrap().expr:
                            case EIdentifier(tparam):
                                String concrete = tparam
                                if tn_env.contains(tparam):
                                    concrete = tn_env.get(tparam).unwrap()
                                if gmod.type_infos.contains(concrete):
                                    GirTypeInfo ti = gmod.type_infos.get(concrete).unwrap()
                                    if not ti.is_enum:
                                        for f in ti.fields:
                                            out_names.push(f.name.clone())
                                            out_types.push(demangle_field_type_name(f.type_name))
                                        return true
                            else:
                                pass
                else:
                    pass
        else:
            pass
    return false

# Resolve `variant_names(T)` to the list of variant names for the
# concrete enum T. Sets ok=false if unrecognized / not an enum.
bool eval_meta_variant_names(SpannedExpr iter_e, Dict[String, String] &tn_env, GirModule &gmod, Vector[String] &out_names):
    match iter_e.expr:
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    if fname == "variant_names" and args.len() == 1:
                        match args.get(0).unwrap().expr:
                            case EIdentifier(tparam):
                                String concrete = tparam
                                if tn_env.contains(tparam):
                                    concrete = tn_env.get(tparam).unwrap()
                                if gmod.enum_registry.contains(concrete):
                                    Vector[String] vnames = gmod.enum_registry.get(concrete).unwrap()
                                    for vn in vnames:
                                        out_names.push(vn.clone())
                                    return true
                            else:
                                pass
                else:
                    pass
        else:
            pass
    return false

# Resolve `field_names(T)` to the list of struct field names (declaration
# order) for the concrete struct T. Mirrors Rust meta.rs:2924 field_names
# -> s.fields.map(|f| f.name). Sets the return to false (caller leaves the
# meta-for inert) if unrecognized / not a registered struct.
bool eval_meta_field_names(SpannedExpr iter_e, Dict[String, String] &tn_env, GirModule &gmod, Vector[String] &out_names):
    match iter_e.expr:
        case ECall(callee, args, _, _):
            match (*callee).expr:
                case EIdentifier(fname):
                    if fname == "field_names" and args.len() == 1:
                        match args.get(0).unwrap().expr:
                            case EIdentifier(tparam):
                                String concrete = tparam
                                if tn_env.contains(tparam):
                                    concrete = tn_env.get(tparam).unwrap()
                                if gmod.type_infos.contains(concrete):
                                    GirTypeInfo ti = gmod.type_infos.get(concrete).unwrap()
                                    if not ti.is_enum:
                                        for f in ti.fields:
                                            out_names.push(f.name.clone())
                                        return true
                            else:
                                pass
                else:
                    pass
        else:
            pass
    return false

# Cheap recursive scan: does this statement list contain any "delayed meta"
# statement (SMetaIf/SMetaFor/SMetaConst/SMetaForMatch/SMeta), reachable
# directly or through a nested block? Mirrors Rust meta.rs:3268
# block_has_delayed_meta / stmt_has_delayed_meta. Used to GATE the
# evaluate_delayed_meta_stmts pass at the NON-generic lower_function call
# site (lower.gg): only bodies that actually contain meta-stmts get the
# splice pass, so the vast majority of non-meta fns are byte-unchanged.
# The recursion shape MUST match evaluate_delayed_meta_stmts' splice shape
# (SIf/SWhile/SFor/SLoop/SMatch/SWith/SNamedScope/SSelect) so the gate never
# misses a body the pass would rewrite. NOTE: SOnError is intentionally NOT
# recursed here — Rust's pass recurse_delayed_meta_in_stmt (meta.rs:3656)
# likewise omits it (its OnError body is cloned into on_error_blocks at
# lower time, AFTER the delayed-meta pass runs), so a `meta if` inside an
# `on error` block is dropped by BOTH compilers; recursing here would
# diverge from the Rust oracle. (Shared latent gap, tracked separately.)
bool block_has_delayed_meta(Vector[Stmt] stmts):
    int i = 0
    while i < stmts.len():
        if stmt_has_delayed_meta(stmts.get(i).unwrap()):
            return true
        i += 1
    return false

bool stmt_has_delayed_meta(Stmt s):
    match s:
        case SMetaIf(_, _, _):
            return true
        case SMetaFor(_, _, _):
            return true
        case SMetaForMatch(_, _, _):
            return true
        case SMetaConst(_, _):
            return true
        case SMetaMatch(_, _, _):
            return true
        case SMetaWhile(_, _):
            return true
        case SMeta:
            return true
        case SIf(_, then_b, else_branches):
            if block_has_delayed_meta(then_b):
                return true
            int ei = 0
            while ei < else_branches.len():
                if block_has_delayed_meta(else_branches.get(ei).unwrap().body):
                    return true
                ei += 1
            return false
        case SWhile(_, body, else_b):
            return block_has_delayed_meta(body) or block_has_delayed_meta(else_b)
        case SFor(_, _, body, _, else_b):
            return block_has_delayed_meta(body) or block_has_delayed_meta(else_b)
        case SLoop(body):
            return block_has_delayed_meta(body)
        case SMatch(_, arms):
            int ai = 0
            while ai < arms.len():
                if block_has_delayed_meta(arms.get(ai).unwrap().body):
                    return true
                ai += 1
            return false
        case SWith(_, _, with_body):
            return block_has_delayed_meta(with_body)
        case SNamedScope(_, ns_body):
            return block_has_delayed_meta(ns_body)
        case SSelect(sel_arms):
            int sai = 0
            while sai < sel_arms.len():
                if block_has_delayed_meta(sel_arms.get(sai).unwrap().body):
                    return true
                sai += 1
            return false
        else:
            return false

# Walk a statement list, evaluating each SMetaIf against the env and
# splicing the winning branch. Recurses into nested blocks AND into the
# spliced branch bodies. Returns the rewritten statement list.
Vector[Stmt] evaluate_delayed_meta_stmts(Vector[Stmt] stmts, Dict[String, String] &tn_env, Dict[String, int] &int_env, GirModule &gmod):
    Vector[Stmt] out = Vector[Stmt]()
    # PROTOTYPE 4b: accumulate in-body `meta const` bindings as we scan the
    # block top-to-bottom, substituting them into each subsequent statement.
    # Mirrors Rust evaluate_delayed_meta_block's MetaConst arm (meta.rs:3320):
    # evaluate, bind into local_env, substitute remaining stmts. `cv_sv`
    # holds string-valued consts, `cv_iv` int-valued.
    Dict[String, String] cv_sv = {}
    Dict[String, int] cv_iv = {}
    int i = 0
    while i < stmts.len():
        Stmt s0 = stmts.get(i).unwrap()
        # Apply accumulated meta-const substitutions to this statement so
        # references (e.g. `f"{idx}"`, `enum_from_ordinal(T, i)`) see the
        # bound value. No-op when no consts bound yet.
        Stmt s = s0
        if cv_sv.len() > 0 or cv_iv.len() > 0:
            Vector[Stmt] one = Vector[Stmt]()
            one.push(s0)
            Vector[Stmt] subd = subst_mf_stmts(one, &cv_sv, &cv_iv)
            s = subd.get(0).unwrap()
        match s:
            case SMetaIf(meta_cond, then_body, elif_branches):
                bool ok = false
                bool taken = false
                bool cv = eval_delayed_meta_cond(meta_cond, &tn_env, &int_env, &gmod, &ok)
                if ok and cv:
                    # then-branch wins
                    Vector[Stmt] spliced = evaluate_delayed_meta_stmts(then_body, &tn_env, &int_env, &gmod)
                    int si = 0
                    while si < spliced.len():
                        out.push(spliced.get(si).unwrap())
                        si += 1
                    taken = true
                elif ok:
                    # then-branch false: try elif/else branches in order
                    int bi = 0
                    while bi < elif_branches.len() and not taken:
                        ElseBranch eb = elif_branches.get(bi).unwrap()
                        match eb.condition:
                            case Some(ec):
                                bool eok = false
                                bool ecv = eval_delayed_meta_cond(ec, &tn_env, &int_env, &gmod, &eok)
                                if eok and ecv:
                                    Vector[Stmt] sp = evaluate_delayed_meta_stmts(eb.body, &tn_env, &int_env, &gmod)
                                    int sj = 0
                                    while sj < sp.len():
                                        out.push(sp.get(sj).unwrap())
                                        sj += 1
                                    taken = true
                                elif not eok:
                                    # unevaluable elif: bail out, leave inert
                                    bi = elif_branches.len()
                            case None:
                                # else branch: wins if nothing taken yet
                                Vector[Stmt] sp = evaluate_delayed_meta_stmts(eb.body, &tn_env, &int_env, &gmod)
                                int sj = 0
                                while sj < sp.len():
                                    out.push(sp.get(sj).unwrap())
                                    sj += 1
                                taken = true
                        bi += 1
                if not ok:
                    # unevaluable condition: leave the meta-if inert (drop,
                    # like Rust when the env lacks the binding)
                    pass
            case SMetaConst(mc_name, mc_val):
                # PROTOTYPE 4b: evaluate the const RHS (already substituted
                # for prior consts + loop vars via the top-of-loop subst) and
                # bind it. Prefer int (enum_ordinal/variant_count/literal);
                # fall back to string (enum_from_ordinal/string literal).
                # Drop the SMetaConst statement (compile-time only). Mirrors
                # Rust meta.rs:3320 (eval, bind into local_env, remove).
                bool iok = false
                int ival = eval_meta_int_v2(mc_val, &tn_env, &int_env, &gmod, &iok)
                if iok:
                    cv_iv.put(mc_name.clone(), ival)
                    int_env.put(mc_name.clone(), ival)
                else:
                    bool sok = false
                    String sval = eval_meta_str_v2(mc_val, &tn_env, &int_env, &gmod, &sok)
                    if sok:
                        cv_sv.put(mc_name.clone(), sval)
                # If neither evaluated, the const is dropped (unevaluable);
                # downstream references stay as identifiers (Rust drops too).
            case SMetaFor(mf_vars, mf_iter, mf_body):
                # PROTOTYPE slice #4: unroll the meta-for over a reflection
                # iterable. Mirrors Rust evaluate_delayed_meta_block's
                # Stmt::MetaFor List arm: evaluate the iterable, bind the
                # loop-var(s) per item, substitute into a clone of the body,
                # recurse (for nested meta-if), and splice.
                bool handled = false
                # `fields(T)` → (name, type) pairs, two loop vars.
                if mf_vars.len() == 2:
                    Vector[String] fnames = Vector[String]()
                    Vector[String] ftypes = Vector[String]()
                    if eval_meta_fields(mf_iter, &tn_env, &gmod, &fnames, &ftypes):
                        handled = true
                        String var_n = mf_vars.get(0).unwrap()
                        String var_t = mf_vars.get(1).unwrap()
                        int fi = 0
                        while fi < fnames.len():
                            Dict[String, String] sv = {}
                            Dict[String, int] iv = {}
                            sv.put(var_n.clone(), fnames.get(fi).unwrap())
                            sv.put(var_t.clone(), ftypes.get(fi).unwrap())
                            Vector[Stmt] sub_body = subst_mf_stmts(mf_body, &sv, &iv)
                            Vector[Stmt] unrolled = evaluate_delayed_meta_stmts(sub_body, &tn_env, &int_env, &gmod)
                            for us in unrolled:
                                out.push(us)
                            fi += 1
                # `field_names(T)` → struct field names, one loop var.
                if mf_vars.len() == 1 and not handled:
                    Vector[String] fonly = Vector[String]()
                    if eval_meta_field_names(mf_iter, &tn_env, &gmod, &fonly):
                        handled = true
                        String var_f = mf_vars.get(0).unwrap()
                        for fn in fonly:
                            Dict[String, String] sv = {}
                            Dict[String, int] iv = {}
                            sv.put(var_f.clone(), fn.clone())
                            Vector[Stmt] sub_body = subst_mf_stmts(mf_body, &sv, &iv)
                            Vector[Stmt] unrolled = evaluate_delayed_meta_stmts(sub_body, &tn_env, &int_env, &gmod)
                            for us in unrolled:
                                out.push(us)
                # `variant_names(T)` → variant names, one loop var.
                if mf_vars.len() == 1 and not handled:
                    Vector[String] vnames = Vector[String]()
                    if eval_meta_variant_names(mf_iter, &tn_env, &gmod, &vnames):
                        handled = true
                        String var_v = mf_vars.get(0).unwrap()
                        for vn in vnames:
                            Dict[String, String] sv = {}
                            Dict[String, int] iv = {}
                            sv.put(var_v.clone(), vn.clone())
                            Vector[Stmt] sub_body = subst_mf_stmts(mf_body, &sv, &iv)
                            Vector[Stmt] unrolled = evaluate_delayed_meta_stmts(sub_body, &tn_env, &int_env, &gmod)
                            for us in unrolled:
                                out.push(us)
                # Integer range: `meta for i in start..end:` (end may be a
                # literal or `variant_count(T)`). One loop var, bound INT.
                # Mirrors Rust evaluate_delayed_meta_block's MetaFor integer
                # arm (meta.rs:3403). Per iteration: bind `i` into a COPY of
                # int_env + subst it into the body as an EIntLiteral, recurse.
                if mf_vars.len() == 1 and not handled:
                    match mf_iter.expr:
                        case ERange(ostart, oend, inclusive):
                            bool rok = true
                            int rstart = 0
                            match ostart:
                                case Some(sb):
                                    bool sok = false
                                    rstart = eval_meta_int_v2(*sb, &tn_env, &int_env, &gmod, &sok)
                                    if not sok:
                                        rok = false
                                case None:
                                    pass
                            int rend = 0
                            match oend:
                                case Some(eb):
                                    bool eok = false
                                    rend = eval_meta_int_v2(*eb, &tn_env, &int_env, &gmod, &eok)
                                    if not eok:
                                        rok = false
                                case None:
                                    rok = false
                            if rok:
                                handled = true
                                String var_i = mf_vars.get(0).unwrap()
                                int upper = rend
                                if inclusive:
                                    upper = rend + 1
                                int rv = rstart
                                while rv < upper:
                                    Dict[String, String] sv = {}
                                    Dict[String, int] iv = {}
                                    iv.put(var_i.clone(), rv)
                                    Vector[Stmt] sub_body = subst_mf_stmts(mf_body, &sv, &iv)
                                    # Child int_env carries the loop var so any
                                    # `meta const vname = enum_from_ordinal(T, i)`
                                    # / nested `meta if i == N` inside sees it.
                                    Dict[String, int] child_env = int_env.clone()
                                    child_env.put(var_i.clone(), rv)
                                    Vector[Stmt] unrolled = evaluate_delayed_meta_stmts(sub_body, &tn_env, &child_env, &gmod)
                                    for us in unrolled:
                                        out.push(us)
                                    rv += 1
                        else:
                            pass
                if not handled:
                    # Unrecognized iterable (variant_payloads, or unevaluable
                    # T): leave inert (Rust drops it too). The later lower_stmt
                    # SMetaFor arm is a no-op.
                    pass
            case SMetaMatch(mm_scrut, mm_arms, mm_else):
                # PROTOTYPE (deep-meta): evaluate the scrutinee, find the first
                # case whose value is meta-equal, splice that arm's (recursively
                # evaluated) body. If none match, splice the else body. If the
                # scrutinee is unevaluable, leave inert (drop) — matching Rust
                # evaluate_delayed_meta_block's MetaMatch arm (meta.rs:3510).
                bool taken = false
                int ai = 0
                while ai < mm_arms.len() and not taken:
                    MetaMatchArm arm = mm_arms.get(ai).unwrap()
                    bool eqok = false
                    bool eq = meta_value_eq_v2(mm_scrut, arm.case_value, &tn_env, &int_env, &gmod, &eqok)
                    if eqok and eq:
                        Vector[Stmt] sp = evaluate_delayed_meta_stmts(arm.body, &tn_env, &int_env, &gmod)
                        int sj = 0
                        while sj < sp.len():
                            out.push(sp.get(sj).unwrap())
                            sj += 1
                        taken = true
                    ai += 1
                if not taken and mm_else.len() > 0:
                    Vector[Stmt] sp = evaluate_delayed_meta_stmts(mm_else, &tn_env, &int_env, &gmod)
                    int sj = 0
                    while sj < sp.len():
                        out.push(sp.get(sj).unwrap())
                        sj += 1
            case SMetaWhile(mw_cond, mw_body):
                # PROTOTYPE (deep-meta): unroll the loop, splicing the
                # (recursively evaluated) body each time the condition holds.
                # Capped at 100000 iterations to match Rust's MAX_META_ITERATIONS
                # (meta.rs:3548). If the condition is unevaluable, leave inert.
                int iter_count = 0
                bool keep = true
                while keep and iter_count < 100000:
                    bool cok = false
                    bool cv = eval_delayed_meta_cond(mw_cond, &tn_env, &int_env, &gmod, &cok)
                    if cok and cv:
                        Vector[Stmt] sp = evaluate_delayed_meta_stmts(mw_body, &tn_env, &int_env, &gmod)
                        int sj = 0
                        while sj < sp.len():
                            out.push(sp.get(sj).unwrap())
                            sj += 1
                        iter_count += 1
                    else:
                        keep = false
            case SIf(cond, then_b, else_branches):
                Vector[ElseBranch] nb = Vector[ElseBranch]()
                int ei = 0
                while ei < else_branches.len():
                    ElseBranch eb = else_branches.get(ei).unwrap()
                    nb.push(ElseBranch(eb.condition, evaluate_delayed_meta_stmts(eb.body, &tn_env, &int_env, &gmod)))
                    ei += 1
                out.push(SIf(cond, evaluate_delayed_meta_stmts(then_b, &tn_env, &int_env, &gmod), nb))
            case SWhile(cond, body, else_b):
                out.push(SWhile(cond, evaluate_delayed_meta_stmts(body, &tn_env, &int_env, &gmod), evaluate_delayed_meta_stmts(else_b, &tn_env, &int_env, &gmod)))
            case SFor(pat, iter_e, body, own, else_b):
                out.push(SFor(pat, iter_e, evaluate_delayed_meta_stmts(body, &tn_env, &int_env, &gmod), own, evaluate_delayed_meta_stmts(else_b, &tn_env, &int_env, &gmod)))
            case SLoop(body):
                out.push(SLoop(evaluate_delayed_meta_stmts(body, &tn_env, &int_env, &gmod)))
            case SMatch(scrut, arms):
                Vector[MatchArm] na = Vector[MatchArm]()
                int ai = 0
                while ai < arms.len():
                    MatchArm a = arms.get(ai).unwrap()
                    na.push(MatchArm(a.pattern, a.guard, evaluate_delayed_meta_stmts(a.body, &tn_env, &int_env, &gmod)))
                    ai += 1
                out.push(SMatch(scrut, na))
            case SWith(with_res, with_name, with_body):
                # Recurse into the `with` block body. Mirrors Rust
                # recurse_delayed_meta_in_stmt's Stmt::With arm (meta.rs:3694).
                out.push(SWith(with_res, with_name, evaluate_delayed_meta_stmts(with_body, &tn_env, &int_env, &gmod)))
            case SNamedScope(ns_name, ns_body):
                # Recurse into the named-scope body. Mirrors Rust's
                # Stmt::NamedScope arm (meta.rs:3678).
                out.push(SNamedScope(ns_name, evaluate_delayed_meta_stmts(ns_body, &tn_env, &int_env, &gmod)))
            case SSelect(sel_arms):
                # Recurse into each select arm body. Mirrors Rust's
                # Stmt::Select arm (meta.rs:3697). Self-host SSelect has no
                # else arm (the Rust `else_arm` field is absent here).
                Vector[SelectArm] nsa = Vector[SelectArm]()
                int sai = 0
                while sai < sel_arms.len():
                    SelectArm sa = sel_arms.get(sai).unwrap()
                    nsa.push(SelectArm(sa.op, evaluate_delayed_meta_stmts(sa.body, &tn_env, &int_env, &gmod)))
                    sai += 1
                out.push(SSelect(nsa))
            else:
                out.push(s)
        i += 1
    return out

# Lower a monomorphized instance of a generic function
void lower_generic_function(FunctionDef fdef, String mangled_name, Vector[String] type_params, Vector[SpannedType] type_args, GirModule &gmod):
    setup_type_subs(&gmod, type_params, type_args)
    # PROTOTYPE: evaluate statement-body `meta if` against the concrete
    # type args, splicing the winning branch BEFORE lowering. Mirrors Rust
    # functions.rs:852 evaluate_delayed_meta_block.
    Dict[String, String] tn_env = build_meta_typename_env(type_params, type_args)
    Dict[String, int] int_env = {}
    Vector[Stmt] expanded_body = evaluate_delayed_meta_stmts(fdef.body, &tn_env, &int_env, &gmod)
    FunctionDef mfdef = FunctionDef(fdef.name, fdef.params, fdef.return_type, fdef.type_params, expanded_body, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub)
    GirFunction gfn = lower_function(mfdef, &gmod)

    # Detect bare Move-type params that are directly returned.
    # If return type is resource AND body is `return param_name` or just `param_name`,
    # upgrade that param from Ptr to MutPtr (matches Rust lowerer behavior).
    int ret_tid = gfn.return_type
    String ret_name = type_id_to_name(ret_tid, &gmod)
    if is_resource_type_name(ret_name, &gmod):
        # Check if body is a single return of a param identifier
        String returned_param = ""
        if fdef.is_expr_body and fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SExpr(sexpr):
                    match sexpr.expr:
                        case EIdentifier(name):
                            returned_param = name
                        else:
                            pass
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        elif fdef.body.len() == 1:
            Stmt body_stmt = fdef.body.get(0).unwrap()
            match body_stmt:
                case SReturn(opt_ret):
                    match opt_ret:
                        case Some(rexpr):
                            match rexpr.expr:
                                case EIdentifier(name):
                                    returned_param = name
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        # Upgrade matching param from Ptr to MutPtr
        if returned_param.len() > 0:
            int pi = 0
            while pi < fdef.params.len():
                Param p = fdef.params.get(pi).unwrap()
                if p.param_name == returned_param and p.ownership == 0:
                    # Param local is at index pi+1 (local 0 is return place)
                    int local_idx = pi + 1
                    if local_idx < gfn.locals.len():
                        GirLocal loc = gfn.locals.get(local_idx).unwrap()
                        int old_tid = loc.type_id
                        # Check if it's currently Ptr(T) — upgrade to MutPtr(T)
                        if old_tid >= PRIM_COUNT:
                            GirType gt = gmod.type_table.get(old_tid).unwrap()
                            match gt:
                                case GtPtr(inner):
                                    int new_tid = register_type(&gmod, GtMutPtr(inner))
                                    gfn.locals.set(local_idx, GirLocal(new_tid, loc.name_hint, loc.ownership, loc.borrow_origin, loc.owning_param))
                                    gfn.param_types.set(pi, new_tid)
                                else:
                                    pass
                pi += 1

    # Override the function name with the mangled name
    gmod.functions.push(GirFunction(mangled_name, gfn.param_types, gfn.return_type, gfn.locals, gfn.blocks, gfn.with_refresh_pairs, gfn.inner_shared_spawns))
    clear_type_subs(&gmod)

# Extract type parameter names from equip target's generic args
# e.g., Stack[T] → ["T"], Pair[A, B] → ["A", "B"]
Vector[String] extract_equip_type_params(EquipBlock eqblk):
    # First try explicit type_params
    if eqblk.type_params.len() > 0:
        return eqblk.type_params
    # Otherwise extract from target type args
    Vector[String] params = []
    match eqblk.target.ty:
        case TNamed(_, targs):
            for ta in targs:
                match ta.ty:
                    case TNamed(tname, _):
                        params.push(tname)
                    case TPrimitive(tname):
                        params.push(tname)
                    else:
                        pass
        else:
            pass
    return params

# Lower monomorphized instances of generic equip methods
void lower_generic_equip(EquipBlock eqblk, Vector[SpannedType] type_args, GirModule &gmod):
    Vector[String] type_params = extract_equip_type_params(eqblk)
    setup_type_subs(&gmod, type_params, type_args)
    # For generic equip, Rust uses Type__method naming (no trait prefix) and concrete self types.
    # Strip the trait_name so lower_equip_block uses plain Type__method naming.
    Option[String] no_trait = None
    EquipBlock plain_eqblk = EquipBlock(eqblk.target, eqblk.type_params, no_trait, eqblk.methods, eqblk.via_field, eqblk.trait_generic_args)
    # trait_name stripped to None → the equip-symbol-suffix branch is never
    # reached; the registration flag is moot. Pass false (Snag #11).
    lower_equip_block(plain_eqblk, &gmod, false)
    clear_type_subs(&gmod)

# ── Spawn wrapper scanning ───────────────────────────────

# Extract the base type name from a SpannedType (e.g. TNamed("Worker",[]) → "Worker").
String spawn_type_base_name(SpannedType ty):
    match ty.ty:
        case TNamed(n, _):
            return n
        case TPrimitive(n):
            return n
        else:
            return ""

# ── Body-await detector (round-16 Phase-2 async splice) ──────────────
#
# Populate `async_fns[c]=true` iff callee `c`'s BODY contains a SUSPENSION —
# an `.await()` (EAwait) OR a blocking-call membership (`sleep`, `read_file`,
# …). This gates the WHICH-wrapper decision: an async callee spawned against a
# shared var routes to `__shared_async_<c>` (release/reacquire-spliced), a sync
# one to `__shared_token_<c>` (lock-held wrapper). Mirrors Rust gg's
# `expr_has_await` / `stmt_has_await` (`src/ir/lowering/context.rs:3722-3804`).
#
# ⚠ Load-bearing: the detector MUST count blocking calls, not just `.await()`.
# `shared_with_spawned_refresh`'s `worker` has NO `.await()` — only `sleep(0.05)`
# — so it routes async SOLELY via `sleep`'s blocking-call membership. A detector
# matching only EAwait would leave `worker` SYNC → lock held across the sleep →
# fixture stays at 0. The `BLOCKING_AST_CALLS` name-set is the documented
# runtime-symbol-contract exception (it mirrors `BLOCKING_CALL_NAMES`
# `exprs/mod.rs:28`), NOT a layering violation.

# Is `name` one of the blocking stdlib calls that yield (release locks)?
# Mirrors Rust `BLOCKING_AST_CALLS` (`src/ir/lowering/context.rs:3717-3720`).
bool is_blocking_call_name(String name):
    if name == "sleep":
        return true
    if name == "read_file" or name == "write_file" or name == "append_file":
        return true
    if name == "readdir":
        return true
    if name == "http_get" or name == "http_post" or name == "http_put" or name == "http_delete":
        return true
    return false

bool expr_has_await(SpannedExpr sexpr):
    match sexpr.expr:
        case EAwait(_):
            return true
        case ECall(callee_box, args, _, _):
            match (*callee_box).expr:
                case EIdentifier(cname):
                    if is_blocking_call_name(cname):
                        return true
                else:
                    pass
            if expr_has_await(*callee_box):
                return true
            for a in args:
                if expr_has_await(a):
                    return true
            return false
        case EMethodCall(recv_box, _, margs, _, _):
            if expr_has_await(*recv_box):
                return true
            for ma in margs:
                if expr_has_await(ma):
                    return true
            return false
        case EBinaryOp(lhs_box, _, rhs_box):
            return expr_has_await(*lhs_box) or expr_has_await(*rhs_box)
        case EUnaryOp(_, operand_box):
            return expr_has_await(*operand_box)
        case ESpawn(inner_box):
            return expr_has_await(*inner_box)
        case ETupleLiteral(elems):
            for e in elems:
                if expr_has_await(e):
                    return true
            return false
        case EIndex(obj_box, idx_box):
            return expr_has_await(*obj_box) or expr_has_await(*idx_box)
        case EFieldAccess(obj_box, _):
            return expr_has_await(*obj_box)
        else:
            return false

bool stmt_has_await(Stmt stmt):
    match stmt:
        case SExpr(e):
            return expr_has_await(e)
        case SVarDecl(_, _, val, _, _, _):
            return expr_has_await(val)
        case SAssign(_, val2):
            return expr_has_await(val2)
        case SCompoundAssign(_, _, val3):
            return expr_has_await(val3)
        case SReturn(opt):
            match opt:
                case Some(rexpr):
                    return expr_has_await(rexpr)
                case None:
                    return false
        case SIf(cond, then_body, branches):
            if expr_has_await(cond):
                return true
            if stmts_have_await(then_body):
                return true
            for eb in branches:
                if stmts_have_await(eb.body):
                    return true
            return false
        case SWhile(wcond, wbody, _):
            return expr_has_await(wcond) or stmts_have_await(wbody)
        case SFor(_, iter_expr, fbody, _, _):
            return expr_has_await(iter_expr) or stmts_have_await(fbody)
        case SLoop(lbody):
            return stmts_have_await(lbody)
        case SMatch(scrut, arms):
            if expr_has_await(scrut):
                return true
            for arm in arms:
                if stmts_have_await(arm.body):
                    return true
            return false
        case SWith(_, _, wbody2):
            return stmts_have_await(wbody2)
        case SNamedScope(_, nbody):
            return stmts_have_await(nbody)
        else:
            return false

bool stmts_have_await(Vector[Stmt] stmts):
    for s in stmts:
        if stmt_has_await(s):
            return true
    return false

# Collect shared variable names from a list of statements
void collect_shared_vars(Vector[Stmt] stmts, Dict[String, bool] &shared_vars):
    for s in stmts:
        match s:
            case SVarDecl(_, name, _, _, sk, _):
                # Only auto-mutex (sk=1) gets __shared_token_ wrappers.
                # Atomic (sk=3) and rwlock (sk=2) use different patterns.
                if sk == 1:
                    shared_vars.put(name, true)
            else:
                pass

# Scan for ESpawn expressions and emit wrapper function stubs
# borrow_params: names of &-qualified params of the enclosing function;
# passing them to a spawn implies shared-derived ownership (inner shared spawn).
void scan_spawn_wrappers(Vector[Stmt] stmts, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    for s in stmts:
        match s:
            case SVarDecl(ty, name, init, _, sk, _):
                if sk == 1:
                    shared_vars.put(name, true)
                # Track variable types for method-spawn wrapper generation
                String tname = spawn_type_base_name(ty)
                if tname != "":
                    var_types.put(name, tname)
                scan_expr_for_spawn(init, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SExpr(expr):
                scan_expr_for_spawn(expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SAssign(_, val):
                scan_expr_for_spawn(val, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SWhile(cond, body, _):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SIf(cond, then_body, branches):
                scan_expr_for_spawn(cond, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(then_body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                for eb in branches:
                    scan_spawn_wrappers(eb.body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SFor(_, iter_expr, body, _, _):
                scan_expr_for_spawn(iter_expr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                scan_spawn_wrappers(body, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            case SReturn(opt):
                match opt:
                    case Some(rexpr):
                        scan_expr_for_spawn(rexpr, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
                    case None:
                        pass
            else:
                pass

void scan_expr_for_spawn(SpannedExpr sexpr, Dict[String, bool] &shared_vars, Dict[String, bool] &async_fns, Dict[String, bool] &emitted, GirModule &gmod, Dict[String, String] &var_types, Dict[String, bool] &borrow_params):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, args, _, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            # Check if any arg is:
                            # (a) a directly shared variable (shared_vars), or
                            # (b) a &-param of the enclosing function (borrow_params) —
                            #     skip_ownership_markers strips '&' in call args so
                            #     &counter arrives as EIdentifier("counter"), not EMutableBorrow.
                            bool has_shared = false
                            for arg in args:
                                match arg.expr:
                                    case EIdentifier(aname):
                                        if shared_vars.contains(aname) or borrow_params.contains(aname):
                                            has_shared = true
                                    case EMutableBorrow(inner):
                                        # Safety net: if &-prefix somehow survives into arg
                                        has_shared = true
                                    else:
                                        pass
                            if has_shared and not emitted.contains(callee_name):
                                # round-16 Phase 1 + Phase 2: BOTH the sync
                                # `__shared_token_<callee>` AND the async
                                # `__shared_async_<callee>` wrappers are now built
                                # FOR REAL — the sync one by `build_shared_token_wrapper`
                                # (lower_expr's `lower_shared_spawn`, with the real
                                # lock/get-ptr/call/unlock body), the async one by the
                                # GIR→GIR post-pass `build_shared_async_wrapper`
                                # (release/reacquire-spliced around each suspension).
                                # Emitting the old `(i64) -> unit` stub here would
                                # produce a DUPLICATE GirFunction with a conflicting C
                                # signature (void* carrier vs int64_t). So this scan no
                                # longer emits a wrapper for the shared-spawn case at
                                # all — `async_fns` (populated in lower.gg) drives the
                                # WRAPPER CHOICE inside the real builders, not a stub
                                # here. (The former `__shared_async_` stub at
                                # `lower_generics.gg:1968-1974`, a dead `(i64)->unit`
                                # placeholder, is retired per brief §5-item-1.)
                                pass
                        else:
                            pass
                case EMethodCall(obj_box, method_name, _, _, _):
                    # spawn obj.method() → emit __spawn_method_wrap_TypeName__method_name
                    match (*obj_box).expr:
                        case EIdentifier(var_name):
                            Option[String] opt_type = var_types.get(var_name)
                            match opt_type:
                                case Some(type_name):
                                    String wrapper_name = "__spawn_method_wrap_" + type_name + "__" + method_name
                                    if not emitted.contains(wrapper_name):
                                        emitted.put(wrapper_name.clone(), true)
                                        Vector[int] wp = [I64_TYPE]
                                        Vector[GirLocal] wl = [GirLocal(I64_TYPE, None, LoOwned(), BoNone(), false), GirLocal(I64_TYPE, None, LoParam(), BoParam(-1), false)]
                                        Vector[BasicBlock] wb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                        gmod.functions.push(GirFunction(wrapper_name, !wp, UNIT_TYPE, !wl, !wb, [], []))
                                case None:
                                    pass
                        else:
                            pass
                else:
                    pass
        case EAwait(inner):
            scan_expr_for_spawn(*inner, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case EMethodCall(obj, _, margs, _, _):
            scan_expr_for_spawn(*obj, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ma in margs:
                scan_expr_for_spawn(ma, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        case ECall(callee, cargs, _, _):
            scan_expr_for_spawn(*callee, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
            for ca in cargs:
                scan_expr_for_spawn(ca, &shared_vars, &async_fns, &emitted, &gmod, &var_types, &borrow_params)
        else:
            pass

# ── Named-closure spawn wrapper emission ─────────────────
# Emits __spawn_wrap___Closure_N stubs for `spawn var()` where var holds a closure.

# closure Phase 2 Step A: `fn_name` keys into gmod.closure_var_cids
# (`<fn_name>\0<varname>` → `__Closure_<cid>`), recorded at the make-site
# (SVarDecl lowering). A `spawn varname()` whose varname holds a closure in
# THIS function emits the `__spawn_wrap___Closure_<cid>` stub.
void emit_named_closure_spawn_expr(SpannedExpr sexpr, String fn_name, Dict[String, bool] &emitted, GirModule &gmod):
    match sexpr.expr:
        case ESpawn(inner_box):
            match (*inner_box).expr:
                case ECall(callee_box, _, _, _):
                    match (*callee_box).expr:
                        case EIdentifier(callee_name):
                            String cvc_key = fn_name + "\0" + callee_name
                            if gmod.closure_var_cids.contains(cvc_key):
                                String ctype = gmod.closure_var_cids.get(cvc_key).unwrap()
                                String wrap = "__spawn_wrap_" + ctype
                                if not emitted.contains(wrap):
                                    emitted.put(wrap.clone(), true)
                                    Vector[int] ncwp = []
                                    Vector[GirLocal] ncwl = [GirLocal(UNIT_TYPE, None, LoOwned(), BoNone(), false)]
                                    Vector[BasicBlock] ncwb = [BasicBlock([], GTReturn(OpConstUnit()))]
                                    gmod.functions.push(GirFunction(wrap, !ncwp, UNIT_TYPE, !ncwl, !ncwb, [], []))
                        else:
                            pass
                else:
                    pass
            emit_named_closure_spawn_expr(*inner_box, fn_name, &emitted, &gmod)
        case ECall(callee, args, _, _):
            emit_named_closure_spawn_expr(*callee, fn_name, &emitted, &gmod)
            for arg in args:
                emit_named_closure_spawn_expr(arg, fn_name, &emitted, &gmod)
        case EMethodCall(obj, _, margs, _, _):
            emit_named_closure_spawn_expr(*obj, fn_name, &emitted, &gmod)
            for ma in margs:
                emit_named_closure_spawn_expr(ma, fn_name, &emitted, &gmod)
        else:
            pass

void emit_named_closure_spawn_stmts(Vector[Stmt] stmts, String fn_name, Dict[String, bool] &emitted, GirModule &gmod):
    for ncs in stmts:
        match ncs:
            case SVarDecl(_, _, init, _, _, _):
                emit_named_closure_spawn_expr(init, fn_name, &emitted, &gmod)
            case SExpr(expr):
                emit_named_closure_spawn_expr(expr, fn_name, &emitted, &gmod)
            case SReturn(opt):
                match opt:
                    case Some(re):
                        emit_named_closure_spawn_expr(re, fn_name, &emitted, &gmod)
                    case None:
                        pass
            case SIf(cond, then_body, branches):
                emit_named_closure_spawn_expr(cond, fn_name, &emitted, &gmod)
                emit_named_closure_spawn_stmts(then_body, fn_name, &emitted, &gmod)
                for nceb in branches:
                    emit_named_closure_spawn_stmts(nceb.body, fn_name, &emitted, &gmod)
            case SWhile(_, body, _):
                emit_named_closure_spawn_stmts(body, fn_name, &emitted, &gmod)
            case SFor(_, iter_expr, body, _, _):
                emit_named_closure_spawn_expr(iter_expr, fn_name, &emitted, &gmod)
                emit_named_closure_spawn_stmts(body, fn_name, &emitted, &gmod)
            else:
                pass

# ── Transitive generic discovery ─────────────────────────
# Substitute type variables in a SpannedType using a name→type map.

SpannedType substitute_type(SpannedType stype, Dict[String, SpannedType] &type_sub_map):
    match stype.ty:
        case TNamed(name, inner_targs):
            if inner_targs.len() == 0:
                if type_sub_map.contains(name):
                    return type_sub_map.get(name).unwrap()
            if inner_targs.len() > 0:
                Vector[SpannedType] new_inner = []
                for ita in inner_targs:
                    SpannedType sub = substitute_type(ita, &type_sub_map)
                    new_inner.push(sub)
                return SpannedType(TNamed(name, new_inner), stype.span)
            return stype
        else:
            return stype

# PROTO method-instance discovery in a MONOMORPHIZED generic-fn body.
#
# When `hash_of[Key]` (template `hash_of[Hashable T](T v)`) is monomorphized
# with `type_sub_map = {T -> Key}`, its body contains `v.hash[FxHasher](&h)`.
# The receiver `v` is a parameter of declared type `T`; substituting through
# the mono map gives the CONCRETE equip target `Key`, so the call needs the
# per-call-site method instance `Key__hash__FxHasher` defined. The up-front
# `proto_walk_expr` can't reach this — it runs on the un-substituted template
# where `v: T` (no concrete receiver) — so we mirror Rust's
# `try_register_method_instance` here, in the transitive-fixpoint context
# where the substitution is known.
#
# Scope (bounded prototype): only PARAMETER receivers with a turbofish are
# discovered (covers `hash_of`'s `v.hash[FxHasher]`). Local/chain receivers
# need the full LocalTypeEnv inference Rust carries and are out of scope here.
void discover_mono_method_insts(Vector[Stmt] stmts, Dict[String, SpannedType] params_by_name, Dict[String, SpannedType] &type_sub_map, GirModule &gmod, Vector[ProtoMethInst] &out, Dict[String, bool] &seen):
    for stmt in stmts:
        discover_mono_method_insts_stmt(stmt, params_by_name, &type_sub_map, &gmod, &out, &seen)

void discover_mono_method_insts_stmt(Stmt stmt, Dict[String, SpannedType] params_by_name, Dict[String, SpannedType] &type_sub_map, GirModule &gmod, Vector[ProtoMethInst] &out, Dict[String, bool] &seen):
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            discover_mono_method_insts_expr(init, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case SExpr(e):
            discover_mono_method_insts_expr(e, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case SAssign(_, e):
            discover_mono_method_insts_expr(e, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case SReturn(opt):
            match opt:
                case Some(e):
                    discover_mono_method_insts_expr(e, params_by_name, &type_sub_map, &gmod, &out, &seen)
                case None:
                    pass
        case SIf(c, tb, elifs):
            discover_mono_method_insts_expr(c, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts(tb, params_by_name, &type_sub_map, &gmod, &out, &seen)
            for el in elifs:
                discover_mono_method_insts(el.body, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case SWhile(c, b, eb):
            discover_mono_method_insts_expr(c, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts(b, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts(eb, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case SFor(_, iter_e, b, _, eb):
            discover_mono_method_insts_expr(iter_e, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts(b, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts(eb, params_by_name, &type_sub_map, &gmod, &out, &seen)
        else:
            pass

void discover_mono_method_insts_expr(SpannedExpr sexpr, Dict[String, SpannedType] params_by_name, Dict[String, SpannedType] &type_sub_map, GirModule &gmod, Vector[ProtoMethInst] &out, Dict[String, bool] &seen):
    match sexpr.expr:
        case EMethodCall(recv_box, mname, margs, _, mtargs):
            discover_mono_method_insts_expr(*recv_box, params_by_name, &type_sub_map, &gmod, &out, &seen)
            for a in margs:
                discover_mono_method_insts_expr(a, params_by_name, &type_sub_map, &gmod, &out, &seen)
            if mtargs.len() > 0:
                # Receiver must be a bare parameter identifier whose declared
                # type substitutes to a CONCRETE named type (the equip base).
                match (*recv_box).expr:
                    case EIdentifier(rname):
                        if params_by_name.contains(rname):
                            # Type-variable ctx = the instantiation's
                            # substitution keys (the enclosing template's
                            # params) — a name is "still a type variable"
                            # iff substitution should have replaced it.
                            Dict[String, bool] mm_ctx = {}
                            for mm_ctx_k in type_sub_map.keys():
                                mm_ctx.put(mm_ctx_k.clone(), true)
                            SpannedType decl_ty = params_by_name.get(rname).unwrap()
                            SpannedType conc_ty = substitute_type(decl_ty, &type_sub_map)
                            String recv_name = ""
                            match conc_ty.ty:
                                case TNamed(cn, cargs):
                                    if cargs.len() == 0:
                                        recv_name = cn
                                    else:
                                        # Generic receiver (`Wrapper[int]`): the
                                        # method instance lives on the MONO'd
                                        # instance, so the recv_instance is the
                                        # mangled name `Wrapper__int64_t`. Skip if
                                        # any concrete arg is still a type variable
                                        # (deferred to a later mono pass).
                                        if not has_type_variable_ctx(cargs, &mm_ctx):
                                            recv_name = cn
                                            for ca in cargs:
                                                recv_name = recv_name + "__" + type_to_c_name(ca, &gmod)
                                else:
                                    pass
                            if recv_name.len() > 0:
                                # Substitute the turbofish targs too (they may
                                # reference the fn's own type params; here they
                                # are concrete like FxHasher, substitute is a
                                # no-op but kept for correctness).
                                Vector[SpannedType] sub_targs = []
                                for mt in mtargs:
                                    sub_targs.push(substitute_type(mt, &type_sub_map))
                                if not has_type_variable_ctx(sub_targs, &mm_ctx):
                                    String sym = recv_name + "__" + mname
                                    for st in sub_targs:
                                        sym = sym + "__" + type_to_c_name(st, &gmod)
                                    if not seen.contains(sym):
                                        seen.put(sym.clone(), true)
                                        out.push(ProtoMethInst(recv_name, mname, sub_targs, [], sym))
                    else:
                        pass
        case ECall(callee_box, cargs, _, _):
            discover_mono_method_insts_expr(*callee_box, params_by_name, &type_sub_map, &gmod, &out, &seen)
            for a in cargs:
                discover_mono_method_insts_expr(a, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case EFieldAccess(obj, _):
            discover_mono_method_insts_expr(*obj, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case EBinaryOp(l, _, r):
            discover_mono_method_insts_expr(*l, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts_expr(*r, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case EUnaryOp(_, inner):
            discover_mono_method_insts_expr(*inner, params_by_name, &type_sub_map, &gmod, &out, &seen)
        case EIndex(b, i):
            discover_mono_method_insts_expr(*b, params_by_name, &type_sub_map, &gmod, &out, &seen)
            discover_mono_method_insts_expr(*i, params_by_name, &type_sub_map, &gmod, &out, &seen)
        else:
            pass

# Extract meta-op suffix from a call argument list.
# Looks for EIdentifier("__metaop__<op>") produced by the parser's meta-op handling.
String extract_meta_op_suffix(Vector[SpannedExpr] args):
    for arg in args:
        match arg.expr:
            case EIdentifier(aname):
                if aname == "__metaop__add":
                    return "__add"
                elif aname == "__metaop__sub":
                    return "__sub"
                elif aname == "__metaop__mul":
                    return "__mul"
                elif aname == "__metaop__div":
                    return "__div"
                elif aname == "__metaop__mod":
                    return "__mod"
                elif aname == "__metaop__eq":
                    return "__eq"
                elif aname == "__metaop__ne":
                    return "__ne"
                elif aname == "__metaop__lt":
                    return "__lt"
                elif aname == "__metaop__gt":
                    return "__gt"
                elif aname == "__metaop__le":
                    return "__le"
                elif aname == "__metaop__ge":
                    return "__ge"
                else:
                    pass
            else:
                pass
    return ""

int discover_transitive_expr(SpannedExpr sexpr, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match sexpr.expr:
        case ECall(callee_box, args, _, targs):
            if targs.len() > 0:
                # Type-variable ctx = the instantiation's substitution keys
                # (the enclosing template's params). Calls whose targs are
                # concrete in this ctx were already registered by the
                # up-front discover_generic_calls walk.
                Dict[String, bool] tt_ctx = {}
                for tt_ctx_k in type_sub_map.keys():
                    tt_ctx.put(tt_ctx_k.clone(), true)
                if has_type_variable_ctx(targs, &tt_ctx):
                    Vector[SpannedType] resolved = []
                    for ta in targs:
                        resolved.push(substitute_type(ta, &type_sub_map))
                    if not has_type_variable_ctx(resolved, &tt_ctx):
                        String meta_suffix = extract_meta_op_suffix(args)
                        match (*callee_box).expr:
                            case EIdentifier(fname):
                                String mangled = compute_mangled_name(resolved, fname) + meta_suffix
                                if not seen.contains(mangled):
                                    seen.put(mangled.clone(), true)
                                    instances.push(GenericInstance(fname, resolved, mangled))
                                    added += 1
                            else:
                                pass
            for arg in args:
                added += discover_transitive_expr(arg, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*callee_box, &type_sub_map, &seen, &instances)
        case EMethodCall(obj, _, margs, _, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            for ma in margs:
                added += discover_transitive_expr(ma, &type_sub_map, &seen, &instances)
        case EBinaryOp(lhs, _, rhs):
            added += discover_transitive_expr(*lhs, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*rhs, &type_sub_map, &seen, &instances)
        case EUnaryOp(_, inner):
            added += discover_transitive_expr(*inner, &type_sub_map, &seen, &instances)
        case EIf(cond, then_body, branches):
            added += discover_transitive_expr(*cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case EFieldAccess(obj, _):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
        case EIndex(obj, idx):
            added += discover_transitive_expr(*obj, &type_sub_map, &seen, &instances)
            added += discover_transitive_expr(*idx, &type_sub_map, &seen, &instances)
        case EClosure(_, body):
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case EFString(_, fexprs, _):
            for fx in fexprs:
                added += discover_transitive_expr(fx, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmt(Stmt stmt, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    match stmt:
        case SVarDecl(_, _, init, _, _, _):
            added += discover_transitive_expr(init, &type_sub_map, &seen, &instances)
        case SAssign(_, value):
            added += discover_transitive_expr(value, &type_sub_map, &seen, &instances)
        case SExpr(expr):
            added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
        case SReturn(opt_expr):
            match opt_expr:
                case Some(expr):
                    added += discover_transitive_expr(expr, &type_sub_map, &seen, &instances)
                case None:
                    pass
        case SIf(cond, then_body, branches):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(then_body, &type_sub_map, &seen, &instances)
            for eb in branches:
                added += discover_transitive_stmts(eb.body, &type_sub_map, &seen, &instances)
        case SWhile(cond, body, _):
            added += discover_transitive_expr(cond, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SFor(_, iter_expr, body, _, _):
            added += discover_transitive_expr(iter_expr, &type_sub_map, &seen, &instances)
            added += discover_transitive_stmts(body, &type_sub_map, &seen, &instances)
        case SMatch(scrutinee, arms):
            added += discover_transitive_expr(scrutinee, &type_sub_map, &seen, &instances)
            for arm in arms:
                added += discover_transitive_stmts(arm.body, &type_sub_map, &seen, &instances)
        else:
            pass
    return added

int discover_transitive_stmts(Vector[Stmt] stmts, Dict[String, SpannedType] &type_sub_map, Dict[String, bool] &seen, Vector[GenericInstance] &instances):
    int added = 0
    for stmt in stmts:
        added += discover_transitive_stmt(stmt, &type_sub_map, &seen, &instances)
    return added

