# Phase C — Strict move/clone validation on self-host's GIR.
#
# Each validator is a pure read-only walk over the lowered GirModule
# returning a `Vector[String]` of violations with location context.
# No codegen, no behaviour change in the lowered IR. The validators
# get called by `driver.gg` immediately after `lower_module`, gated on
# per-validator `GG_VALIDATE_<NAME>=<log-path>` env vars.
#
# Migration framework (mirror of `structural-guards.md`):
#   1. Write the validator.
#   2. Gate behind `GG_VALIDATE_<NAME>` → log per-class counts; build
#      doesn't panic.
#   3. File a TODO with the burn-down by class.
#   4. Migrate one class at a time; each commit drops a class's count
#      to zero.
#   5. Promote to fatal once the count is zero. Gate removed; class
#      permanently closed.
#   6. Move the TODO to `DONE.md`.
#
# See `docs/internals/self-host-resource-model.md` §5.

from std.collections import Vector, Dict
from std.conv import int_to_str
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction, Operand
from gir import GirType, GirResourceMetadata
from gir import LocalOwnership
from gir import PRIM_COUNT
from lir_lower import build_resource_metadata

# Phase C validators are activated via flags passed to `run_validators`
# from `driver.gg`. The Rust-side framework uses `GG_VALIDATE_<NAME>`
# env vars (`structural-guards.md` Tier 1b); self-host's emit of
# `getenv` currently has an unfinished cstr→String wrap that makes
# the env-var path miscompile. Until that gap is closed (TODO entry,
# §7 of the resource model doc), pass configuration by argument
# from driver's argv parsing instead.
struct ValidateConfig:
    bool run_moves
    bool run_field_reads
    bool run_call_args

# ── Helpers ──────────────────────────────────────────────────

# Resolve a local's slot type to a name; returns "" for unknown OR
# for pointer-typed locals. Pointer-typed locals (`Ptr(T)`/`MutPtr(T)`)
# hold an alias, not a value — a byte-copy of a pointer is just a
# pointer copy, not a resource copy. Self-host's `type_id_to_name`
# (in lower.gg) recurses through Ptr/MutPtr to unwrap, but the
# validator's view needs the opposite: the slot's surface type
# determines whether OpCopy is a resource-byte-copy violation.
String resolve_type_name(int tid, GirModule &gmod):
    if tid == 0:
        return "bool"
    if tid == 4:
        return "int64_t"
    if tid == 10:
        return "double"
    if tid == 11:
        return "unit"
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(_):
                return ""
            case GtMutPtr(_):
                return ""
            else:
                return ""
    return ""

# True if the local's slot type is a resource (per `build_resource_metadata`).
# Borrowed locals are also resource-typed at the slot level; the
# ownership flag (LocalOwnership) is what distinguishes the cases.
bool local_is_resource(int lid, GirFunction &func, GirModule &gmod):
    if lid < 0 or lid >= func.locals.len():
        return false
    GirLocal loc = func.locals.get(lid).unwrap()
    String tname = resolve_type_name(loc.type_id, &gmod)
    if tname == "":
        return false
    match build_resource_metadata(tname):
        case Some(_):
            return true
        case None:
            return false

# Render a violation header — function name + block index + inst index.
String fmt_loc(String fn_name, int bi, int ii):
    return fn_name + ":bb" + int_to_str(bi) + ":i" + int_to_str(ii)

# ── validate_resource_moves ──────────────────────────────────
#
# Every `OpCopy(local)` whose source is a resource-typed local is a
# violation. The fix at the writer site is one of:
#   • OpMove(local) — last use; source becomes dead after this read.
#   • OpClone(local) — explicit refcount bump / deep copy.
#   • OpBorrow(local) — non-owning alias; consumer must accept borrow.
#
# Mirrors Rust's `validate_resource_moves` (`src/ir/validate.rs`).
Vector[String] validate_resource_moves(GirModule &gmod):
    Vector[String] violations = []
    int fi = 0
    while fi < gmod.functions.len():
        GirFunction func = gmod.functions.get(fi).unwrap()
        int bi = 0
        while bi < func.blocks.len():
            BasicBlock blk = func.blocks.get(bi).unwrap()
            int ii = 0
            while ii < blk.insts.len():
                Instruction inst = blk.insts.get(ii).unwrap()
                check_inst_for_copy(inst, &func, &gmod, &violations, fi, bi, ii)
                ii += 1
            bi += 1
        fi += 1
    return violations

# Check every Operand argument in a single Instruction for OpCopy on
# a resource-typed local. Walks each instruction shape explicitly so
# every operand site is covered.
void check_inst_for_copy(Instruction inst, GirFunction &func, GirModule &gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GIAssign(_, op):
            check_operand_for_copy(op, &func, &gmod, &violations, fi, bi, ii)
        case GIBinOp(_, _, _, lhs, rhs):
            check_operand_for_copy(lhs, &func, &gmod, &violations, fi, bi, ii)
            check_operand_for_copy(rhs, &func, &gmod, &violations, fi, bi, ii)
        case GIUnOp(_, _, _, src):
            check_operand_for_copy(src, &func, &gmod, &violations, fi, bi, ii)
        case GICmp(_, _, _, lhs, rhs):
            check_operand_for_copy(lhs, &func, &gmod, &violations, fi, bi, ii)
            check_operand_for_copy(rhs, &func, &gmod, &violations, fi, bi, ii)
        case GICall(_, _, args):
            int ai = 0
            while ai < args.len():
                check_operand_for_copy(args.get(ai).unwrap(), &func, &gmod, &violations, fi, bi, ii)
                ai += 1
        case GICallExtern(_, _, args):
            int ai = 0
            while ai < args.len():
                check_operand_for_copy(args.get(ai).unwrap(), &func, &gmod, &violations, fi, bi, ii)
                ai += 1
        else:
            pass

void check_operand_for_copy(Operand op, GirFunction &func, GirModule &gmod, Vector[String] &violations, int fi, int bi, int ii):
    match op:
        case OpCopy(lid):
            if local_is_resource(lid, &func, &gmod):
                GirFunction fr = gmod.functions.get(fi).unwrap()
                GirLocal loc = fr.locals.get(lid).unwrap()
                String tname = resolve_type_name(loc.type_id, &gmod)
                violations.push(fmt_loc(fr.name, bi, ii) + ": OpCopy(_" + int_to_str(lid) + ") on resource " + tname)
        else:
            pass

# ── validate_resource_field_reads ────────────────────────────
#
# Every `GICallExtern(dst, "__field_read_*", ...)` whose destination
# local has a resource slot type AND is tagged `LoOwned` is a
# violation. The destination should be `LoBorrowed/BoField` — a field
# load aliases into the parent aggregate's storage, not a fresh owned
# value. Treating it as owned is a shallow byte-copy of resource
# bytes that risks double-free.
#
# Mirrors Rust's `validate_resource_field_reads`
# (`src/ir/validate.rs` IFieldLoad-mode-Copy class).
Vector[String] validate_resource_field_reads(GirModule &gmod):
    Vector[String] violations = []
    int fi = 0
    while fi < gmod.functions.len():
        GirFunction func = gmod.functions.get(fi).unwrap()
        int bi = 0
        while bi < func.blocks.len():
            BasicBlock blk = func.blocks.get(bi).unwrap()
            int ii = 0
            while ii < blk.insts.len():
                Instruction inst = blk.insts.get(ii).unwrap()
                check_inst_for_field_read(inst, &func, &gmod, &violations, fi, bi, ii)
                ii += 1
            bi += 1
        fi += 1
    return violations

void check_inst_for_field_read(Instruction inst, GirFunction &func, GirModule &gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GICallExtern(dst, name, _):
            if dst < 0:
                return
            if not name.starts_with("__field_read_"):
                return
            if dst >= func.locals.len():
                return
            GirLocal dloc = func.locals.get(dst).unwrap()
            String dtname = resolve_type_name(dloc.type_id, &gmod)
            if dtname == "":
                return
            bool is_res = false
            match build_resource_metadata(dtname):
                case Some(_):
                    is_res = true
                case None:
                    is_res = false
            if not is_res:
                return
            # `dst` is a resource-typed field-read destination — flag
            # if its ownership is LoOwned (Copy-mode equivalent) rather
            # than LoBorrowed.
            match dloc.ownership:
                case LoOwned():
                    violations.push(fmt_loc(func.name, bi, ii) + ": __field_read_ into LoOwned resource local _" + int_to_str(dst) + " (" + dtname + ") via " + name)
                case LoMaybeOwned():
                    violations.push(fmt_loc(func.name, bi, ii) + ": __field_read_ into LoMaybeOwned resource local _" + int_to_str(dst) + " (" + dtname + ") via " + name)
                else:
                    pass
        else:
            pass

# ── validate_resource_call_args ──────────────────────────────
#
# Call argument modes must match the source local's ownership. The
# *Ownership at Consuming Positions* table (`CLAUDE.md`) spells out the
# allowed combinations:
#
#   Source                          | Allowed at consuming position
#   ───────────────────────────────-┼──────────────────────────────
#   Owns AND dead at this call      | OpMove (move after call)
#   Borrow OR owned-but-live        | OpClone (clone before call)
#   Static literal                  | (runtime *_materialize)
#
# The class this validator owns: `OpMove(local)` where the source
# local's ownership is `LoBorrowed`. Moving a borrow is a
# use-after-free — the source doesn't own the data it points into;
# the move semantics nullify the source slot but the underlying
# resource is owned elsewhere.
#
# `OpCopy(resource_local)` is already covered by validate_resource_moves;
# this validator deliberately doesn't double-report it (the underlying
# violation is the same write site).
#
# Mirrors Rust's `validate_resource_call_args`
# (`src/ir/validate.rs` Call/CallExtern arg-mode class).
Vector[String] validate_resource_call_args(GirModule &gmod):
    Vector[String] violations = []
    int fi = 0
    while fi < gmod.functions.len():
        GirFunction func = gmod.functions.get(fi).unwrap()
        int bi = 0
        while bi < func.blocks.len():
            BasicBlock blk = func.blocks.get(bi).unwrap()
            int ii = 0
            while ii < blk.insts.len():
                Instruction inst = blk.insts.get(ii).unwrap()
                check_inst_for_call_arg(inst, &func, &gmod, &violations, fi, bi, ii)
                ii += 1
            bi += 1
        fi += 1
    return violations

void check_inst_for_call_arg(Instruction inst, GirFunction &func, GirModule &gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GICall(_, callee, args):
            check_call_args(callee, args, &func, &gmod, &violations, fi, bi, ii)
        case GICallExtern(_, callee, args):
            check_call_args(callee, args, &func, &gmod, &violations, fi, bi, ii)
        else:
            pass

void check_call_args(String callee, Vector[Operand] args, GirFunction &func, GirModule &gmod, Vector[String] &violations, int fi, int bi, int ii):
    int ai = 0
    while ai < args.len():
        Operand op = args.get(ai).unwrap()
        match op:
            case OpMove(lid):
                if lid >= 0 and lid < func.locals.len():
                    GirLocal loc = func.locals.get(lid).unwrap()
                    match loc.ownership:
                        case LoBorrowed():
                            String tname = resolve_type_name(loc.type_id, &gmod)
                            violations.push(fmt_loc(func.name, bi, ii) + ": OpMove(_" + int_to_str(lid) + ") on LoBorrowed local at call to " + callee + " arg " + int_to_str(ai) + " (" + tname + ")")
                        else:
                            pass
            else:
                pass
        ai += 1
#
# Run every validator whose `GG_VALIDATE_<NAME>` env var is set, write
# its violations to the path the env var names. Returns silently if no
# gate is set — the call from `driver.gg` is free when nobody asked
# for validation.

void run_validators(GirModule &gmod, ValidateConfig cfg):
    if cfg.run_moves:
        Vector[String] vs = validate_resource_moves(&gmod)
        print_violations("validate_resource_moves", vs)
    if cfg.run_field_reads:
        Vector[String] vs2 = validate_resource_field_reads(&gmod)
        print_violations("validate_resource_field_reads", vs2)
    if cfg.run_call_args:
        Vector[String] vs3 = validate_resource_call_args(&gmod)
        print_violations("validate_resource_call_args", vs3)

# Phase C step 5a: validate_resource_field_reads is CLOSED (commit
# `<step-5a>`) — single emit site `emit_payload_read` tags LoBorrowed/
# BoField; baseline sweep is 0 across 1030 fixtures. Promotion to
# "fatal-on-violation" lives at the Rust-harness level (a lints-style
# test that runs the validator across the fixture suite and asserts
# zero violations), not inside self-host: `exit()` and the
# `noreturn void` extern signature don't yet round-trip through
# self-host's emit (cstr/void boundary gap, TODO in §7 of the resource
# model doc). Until that's fixed, fatal-promotion uses the same
# pattern as Tier E.1 lints — a Rust test, BUDGET=0.

# Emit violations to stdout. The driver runs validators after the
# GIR-print / LIR-print, so the lines arrive at the end of the stream
# and don't corrupt the format_module / generate_c body. The header
# line `# <name>: N violation(s)` is the parse-anchor for sweep
# scripts.
void print_violations(String name, Vector[String] vs):
    print("# " + name + ": " + int_to_str(vs.len()) + " violation(s)")
    int i = 0
    while i < vs.len():
        print(vs.get(i).unwrap())
        i += 1
