# Phase C — Strict move/clone validation on self-host's GIR.
#
# Each validator is a pure read-only walk over the lowered GirModule
# returning a `Vector[String]` of violations with location context.
# No codegen, no behaviour change in the lowered IR. The validators
# get called by `driver.gg` immediately after `lower_module`, gated on
# per-validator `GG_VALIDATE_<NAME>=<log-path>` env vars.
#
# Migration framework (mirror of `docs/devbook/25-structural-guards.md`):
#   1. Write the validator.
#   2. Gate behind `GG_VALIDATE_<NAME>` → log per-class counts; build
#      doesn't panic.
#   3. File a TODO with the burn-down by class.
#   4. Migrate one class at a time; each commit drops a class's count
#      to zero.
#   5. Promote to fatal once the count is zero. Gate removed; class
#      permanently closed.
#   6. Move the TODO to `DONE.md`.
#
# See `docs/devbook/26-self-host-frontend.md` §5.

from std.collections import Vector, Dict
from std.conv import int_to_str
from std.fs import write_file, append_file
from std.os import getenv, exit
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction, Operand
from gir import GirType, ResourceMetadata
from gir import LocalOwnership
from gir import PRIM_COUNT
from lir import LirModule, LirFunction, LirBlock, LirInst, LirTerm, SwitchCase, BlockParam
from lir_lower import build_resource_metadata

# ── Helpers ──────────────────────────────────────────────────

# Resolve a local's slot type to a name; returns "" for unknown OR
# for pointer-typed locals. Pointer-typed locals (`Ptr(T)`/`MutPtr(T)`)
# hold an alias, not a value — a byte-copy of a pointer is just a
# pointer copy, not a resource copy. Self-host's `type_id_to_name`
# (in lower.gg) recurses through Ptr/MutPtr to unwrap, but the
# validator's view needs the opposite: the slot's surface type
# determines whether OpCopy is a resource-byte-copy violation.
String resolve_type_name(int tid, GirModule gmod):
    if tid == 0:
        return "bool"
    if tid == 4:
        return "int64_t"
    if tid == 10:
        return "double"
    if tid == 11:
        return "unit"
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(_):
                return ""
            case GtMutPtr(_):
                return ""
            else:
                return ""
    return ""

# True if the local's slot type is a resource (per `build_resource_metadata`).
# Borrowed locals are also resource-typed at the slot level; the
# ownership flag (LocalOwnership) is what distinguishes the cases.
bool local_is_resource(int lid, GirFunction func, GirModule gmod):
    if lid < 0 or lid >= func.locals.len():
        return false
    GirLocal loc = func.locals.get(lid).unwrap()
    String tname = resolve_type_name(loc.type_id, gmod)
    if tname == "":
        return false
    match build_resource_metadata(tname):
        case Some(_):
            return true
        case None:
            return false

# Render a violation header — function name + block index + inst index.
String fmt_loc(String fn_name, int bi, int ii):
    return fn_name + ":bb" + int_to_str(bi) + ":i" + int_to_str(ii)

# ── validate_resource_moves ──────────────────────────────────
#
# Every `OpCopy(local)` whose source is a resource-typed local is a
# violation. The fix at the writer site is one of:
#   • OpMove(local) — last use; source becomes dead after this read.
#   • OpClone(local) — explicit refcount bump / deep copy.
#   • OpBorrow(local) — non-owning alias; consumer must accept borrow.
#
# Mirrors Rust's `validate_resource_moves` (`src/ir/validate.rs`).
Vector[String] validate_resource_moves(GirModule gmod):
    Vector[String] violations = []
    for (fi, func) in gmod.functions.enumerate():
        for (bi, blk) in func.blocks.enumerate():
            for (ii, inst) in blk.insts.enumerate():
                check_inst_for_copy(inst, func, gmod, &violations, fi, bi, ii)
    return violations

# Check every Operand argument in a single Instruction for OpCopy on
# a resource-typed local. Walks each instruction shape explicitly so
# every operand site is covered.
void check_inst_for_copy(Instruction inst, GirFunction func, GirModule gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GIAssign(_, op):
            check_operand_for_copy(op, func, gmod, &violations, fi, bi, ii)
        case GIBinOp(_, _, _, lhs, rhs):
            check_operand_for_copy(lhs, func, gmod, &violations, fi, bi, ii)
            check_operand_for_copy(rhs, func, gmod, &violations, fi, bi, ii)
        case GIUnOp(_, _, _, src):
            check_operand_for_copy(src, func, gmod, &violations, fi, bi, ii)
        case GICmp(_, _, _, lhs, rhs):
            check_operand_for_copy(lhs, func, gmod, &violations, fi, bi, ii)
            check_operand_for_copy(rhs, func, gmod, &violations, fi, bi, ii)
        case GICall(_, _, args):
            for arg in args:
                check_operand_for_copy(arg, func, gmod, &violations, fi, bi, ii)
        case GICallExtern(_, _, args):
            for arg in args:
                check_operand_for_copy(arg, func, gmod, &violations, fi, bi, ii)
        else:
            pass

void check_operand_for_copy(Operand op, GirFunction func, GirModule gmod, Vector[String] &violations, int fi, int bi, int ii):
    match op:
        case OpCopy(lid):
            if local_is_resource(lid, func, gmod):
                GirFunction fr = gmod.functions.get(fi).unwrap()
                GirLocal loc = fr.locals.get(lid).unwrap()
                # View-awareness skip (mirror of Rust's `validate_read` at
                # `src/ir/validate.rs:1080`): a Copy of a Borrowed / View
                # source is runtime-safe — both source and copy are
                # non-owning aliases, so the byte-copy creates another
                # non-owning alias whose drop is a no-op. The Phase D
                # step-2 work tagged collection-getter destinations and
                # field-access results as LoBorrowed; the validator now
                # understands those as alias copies, not shallow copies
                # of owned resources.
                match loc.ownership:
                    case LoBorrowed():
                        pass
                    case LoView():
                        pass
                    else:
                        String tname = resolve_type_name(loc.type_id, gmod)
                        violations.push(fmt_loc(fr.name, bi, ii) + ": OpCopy(_" + int_to_str(lid) + ") on resource " + tname)
        else:
            pass

# ── validate_resource_field_reads ────────────────────────────
#
# Every `GICallExtern(dst, "__field_read_*", ...)` whose destination
# local has a resource slot type AND is tagged `LoOwned` is a
# violation. The destination should be `LoBorrowed/BoField` — a field
# load aliases into the parent aggregate's storage, not a fresh owned
# value. Treating it as owned is a shallow byte-copy of resource
# bytes that risks double-free.
#
# Mirrors Rust's `validate_resource_field_reads`
# (`src/ir/validate.rs` IFieldLoad-mode-Copy class).
Vector[String] validate_resource_field_reads(GirModule gmod):
    Vector[String] violations = []
    for (fi, func) in gmod.functions.enumerate():
        for (bi, blk) in func.blocks.enumerate():
            for (ii, inst) in blk.insts.enumerate():
                check_inst_for_field_read(inst, func, gmod, &violations, fi, bi, ii)
    return violations

void check_inst_for_field_read(Instruction inst, GirFunction func, GirModule gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GICallExtern(dst, name, _):
            if dst < 0:
                return
            if not name.starts_with("__field_read_"):
                return
            if dst >= func.locals.len():
                return
            GirLocal dloc = func.locals.get(dst).unwrap()
            String dtname = resolve_type_name(dloc.type_id, gmod)
            if dtname == "":
                return
            bool is_res = false
            match build_resource_metadata(dtname):
                case Some(_):
                    is_res = true
                case None:
                    is_res = false
            if not is_res:
                return
            # `dst` is a resource-typed field-read destination — flag
            # if its ownership is LoOwned (Copy-mode equivalent) rather
            # than LoBorrowed.
            match dloc.ownership:
                case LoOwned():
                    violations.push(fmt_loc(func.name, bi, ii) + ": __field_read_ into LoOwned resource local _" + int_to_str(dst) + " (" + dtname + ") via " + name)
                case LoMaybeOwned():
                    violations.push(fmt_loc(func.name, bi, ii) + ": __field_read_ into LoMaybeOwned resource local _" + int_to_str(dst) + " (" + dtname + ") via " + name)
                else:
                    pass
        else:
            pass

# ── validate_resource_call_args ──────────────────────────────
#
# Call argument modes must match the source local's ownership. The
# *Ownership at Consuming Positions* table (`CLAUDE.md`) spells out the
# allowed combinations:
#
#   Source                          | Allowed at consuming position
#   ───────────────────────────────-┼──────────────────────────────
#   Owns AND dead at this call      | OpMove (move after call)
#   Borrow OR owned-but-live        | OpClone (clone before call)
#   Static literal                  | (runtime *_materialize)
#
# The class this validator owns: `OpMove(local)` where the source
# local's ownership is `LoBorrowed`. Moving a borrow is a
# use-after-free — the source doesn't own the data it points into;
# the move semantics nullify the source slot but the underlying
# resource is owned elsewhere.
#
# `OpCopy(resource_local)` is already covered by validate_resource_moves;
# this validator deliberately doesn't double-report it (the underlying
# violation is the same write site).
#
# Mirrors Rust's `validate_resource_call_args`
# (`src/ir/validate.rs` Call/CallExtern arg-mode class).
Vector[String] validate_resource_call_args(GirModule gmod):
    Vector[String] violations = []
    for (fi, func) in gmod.functions.enumerate():
        for (bi, blk) in func.blocks.enumerate():
            for (ii, inst) in blk.insts.enumerate():
                check_inst_for_call_arg(inst, func, gmod, &violations, fi, bi, ii)
    return violations

void check_inst_for_call_arg(Instruction inst, GirFunction func, GirModule gmod, Vector[String] &violations, int fi, int bi, int ii):
    match inst:
        case GICall(_, callee, args):
            check_call_args(callee, args, func, gmod, &violations, fi, bi, ii)
        case GICallExtern(_, callee, args):
            check_call_args(callee, args, func, gmod, &violations, fi, bi, ii)
        else:
            pass

void check_call_args(String callee, Vector[Operand] args, GirFunction func, GirModule gmod, Vector[String] &violations, int fi, int bi, int ii):
    for (ai, op) in args.enumerate():
        match op:
            case OpMove(lid):
                if lid >= 0 and lid < func.locals.len():
                    GirLocal loc = func.locals.get(lid).unwrap()
                    match loc.ownership:
                        case LoBorrowed():
                            String tname = resolve_type_name(loc.type_id, gmod)
                            violations.push(fmt_loc(func.name, bi, ii) + ": OpMove(_" + int_to_str(lid) + ") on LoBorrowed local at call to " + callee + " arg " + int_to_str(ai) + " (" + tname + ")")
                        else:
                            pass
            else:
                pass
# ── Validator dispatch ────────────────────────────────────
#
# Phase C step 5a / 5b / 5c shipped the burn-downs for three classes:
#   • validate_resource_field_reads — CLOSED (commit `8cfc94ff`)
#   • validate_resource_call_args   — CLOSED (commit `988ce1c3`)
#   • validate_resource_moves       — CLOSED (this commit, step 5c).
#     100,170 → 0 via the `op_consume(&ctx, &gmod, lid)` dispatcher in
#     lower.gg, which picks OpMove / OpBorrow / OpCopy from the source
#     local's ownership tag (LoBorrowed/LoView → OpBorrow; LoOwned/
#     LoParam → OpMove; non-resource → OpCopy). Migrated ~25 OpCopy
#     emit sites in lower.gg to use it. `is_resource_type_name` now
#     delegates to lir_lower's `build_resource_metadata` for the
#     single-source-of-truth resource classification (covers runtime
#     types GorgetString/Array/Map/Set/Closure, parameterised Vector__/
#     Dict__/Set__/Box__, and opaque handles Mutex__/Channel__/Shared__/
#     OnceFlag__/Semaphore__/AtomicInt__/etc.). The four operand modes
#     all lower to ISlotLoad in lir_lower.gg:2349-2394, so this burn-down
#     produces correct GIR ownership labels without changing runtime
#     behaviour; when Phase 5 codegen lands real OpClone/OpMove
#     emission, the labels become the contract.
#
# Per `docs/devbook/25-structural-guards.md`'s framework step 5, once a class hits
# zero it's promoted to fatal: the env gate is removed and the build
# halts on the first violation. All three run unconditionally below.
#
# The `GG_VALIDATE_RESOURCE_MOVES=<log-path>` env gate is preserved
# for diagnostic logging when a violation re-appears — the writer
# is a sweep entry point for `tools/sweep-validate.sh`-style harnesses.

void run_validators(GirModule gmod):
    # ── Closed classes: fatal-on-violation, no gate ──
    Vector[String] fr_v = validate_resource_field_reads(gmod)
    if fr_v.len() > 0:
        print_violations_to_stderr("validate_resource_field_reads (FATAL)", fr_v)
        exit(1)
    Vector[String] ca_v = validate_resource_call_args(gmod)
    if ca_v.len() > 0:
        print_violations_to_stderr("validate_resource_call_args (FATAL)", ca_v)
        exit(1)
    Vector[String] mv_v = validate_resource_moves(gmod)
    if mv_v.len() > 0:
        print_violations_to_stderr("validate_resource_moves (FATAL)", mv_v)
        exit(1)
    # ── Diagnostic gate: write violations to file when env-set ──
    # Now redundant since the class promotes to fatal above, but kept
    # for sweep tooling that wants a per-fixture violation log rather
    # than a single fatal-on-first stop.
    String moves_path = getenv("GG_VALIDATE_RESOURCE_MOVES")
    if moves_path.len() > 0:
        Vector[String] mv = validate_resource_moves(gmod)
        write_violations(moves_path, "validate_resource_moves", mv)

# Emit violations to stdout. The closed-class fatal path runs BEFORE
# the GIR/LIR print, so panicking here means the user sees the
# violations *as* the diagnostic — the would-be successful build
# output never lands. (Once self-host gains a stderr writer that
# round-trips through emit, switch to stderr to keep the violations
# visually separate from any stdout buffering; Rust gg uses stderr
# for validator panics.)
void print_violations_to_stderr(String name, Vector[String] vs):
    print("# " + name + ": " + int_to_str(vs.len()) + " violation(s)")
    for v in vs:
        print(v)

# Write the burn-down class's violations to its env-named log file.
# Header line `# <name>: N violation(s)` is the parse-anchor for
# sweep scripts (`tools/sweep-validate.sh`-style harnesses).
void write_violations(String path, String name, Vector[String] vs):
    String hdr = "# " + name + ": " + int_to_str(vs.len()) + " violation(s)\n"
    write_file(path, hdr)
    for v in vs:
        append_file(path, v + "\n")

# ── §6.2: validator-runs-after-every-pass ─────────────────────
#
# Mirrors Rust's `src/lir/validate.rs::assert_module_valid(module, after)`:
# a single dispatcher gated on `GG_VALIDATE_PASSES`, called from
# `driver.gg` after each pipeline pass. When the env var is unset
# (default), every hook is a no-op — zero cost on normal builds. When
# set, every hook runs the registered validators for its layer and
# panics with the offending pass's name + all errors found.
#
# Sweep-mode usage:
#
#   GG_VALIDATE_PASSES=1 ./driver fixture.gg lib
#
# Catches mid-pipeline regressions (e.g. a pass that leaves the IR in
# a malformed state, even if downstream passes happen to mask the bug)
# the same way the Rust side has used `assert_module_valid` since
# unified-resource-model.md §8.3 shipped.

# Read the GG_VALIDATE_PASSES env var. Set (any value) → true.
bool validate_passes_enabled():
    String v = getenv("GG_VALIDATE_PASSES")
    return v.len() > 0

# GIR-stage hook. Called from `driver.gg` immediately after
# `lower_module` returns. The closed-class fatal validators
# (`validate_resource_field_reads` / `_call_args` / `_moves`) ALREADY
# run unconditionally from `run_validators(&gir)`, so this hook adds
# the per-pass naming + a pass-name-tagged error message when any
# violations turn up.
void validate_gir_after(String after, GirModule gmod):
    if not validate_passes_enabled():
        return
    Vector[String] errors = []
    Vector[String] fr_v = validate_resource_field_reads(gmod)
    for v in fr_v:
        errors.push("[field_reads] " + v)
    Vector[String] ca_v = validate_resource_call_args(gmod)
    for v in ca_v:
        errors.push("[call_args] " + v)
    Vector[String] mv_v = validate_resource_moves(gmod)
    for v in mv_v:
        errors.push("[moves] " + v)
    if errors.len() > 0:
        print_pass_violations("GIR invariant violated after " + after, errors)
        exit(1)

# LIR-stage hook. Called from `driver.gg` after `lower_gir_to_lir`
# and after each LIR transformation pass (SSA construction, future
# optimizer passes). Runs the structural LIR invariants — mirrors
# Rust's `validate_module` registered in
# `src/lir/validate.rs::VALIDATORS`.
void validate_lir_after(String after, LirModule m):
    if not validate_passes_enabled():
        return
    Vector[String] errors = []
    for func in m.functions:
        validate_lir_function(func, &errors)
    if errors.len() > 0:
        print_pass_violations("LIR invariant violated after " + after, errors)
        exit(1)

# Per-function LIR structural checks:
#   • Block ids are sequential (block.id == position).
#   • Each block param's value_id is unique across the function (no
#     duplicate value definitions from block params).
#   • Each instruction's slot references are in `[0, num_slots)`
#     (ISlotLoad / ISlotStore / ISlotAddr / IMoveSlot / IClosurePack).
#   • Each terminator's successor block ids are in range AND its args
#     list length matches the target block's `params` list length —
#     the precise bug class the §6.4 pending_phis retirement hit when
#     phi params and branch args fell out of sync.
void validate_lir_function(LirFunction func, Vector[String] &errors):
    int num_blocks = func.blocks.len()
    int num_slots = func.slots.len()
    Dict[int, bool] seen_values = {}
    for (bi, blk) in func.blocks.enumerate():
        if blk.id != bi:
            errors.push("@" + func.name + " bb" + int_to_str(blk.id) + " at position " + int_to_str(bi) + " (non-sequential block id)")
        # Block params define values — check uniqueness.
        for bp in blk.params:
            if seen_values.contains(bp.value_id):
                errors.push("@" + func.name + " bb" + int_to_str(blk.id) + ": duplicate value definition v" + int_to_str(bp.value_id) + " (also defined earlier in this function)")
            else:
                seen_values.put(bp.value_id, true)
        # Per-instruction slot-reference bounds.
        for inst in blk.insts:
            check_inst_slot_refs(inst, blk.id, num_slots, func.name, &errors)
        # Terminator successor sanity + args-length-matches-target-params.
        check_term_successors(blk.term, blk.id, num_blocks, func, &errors)

void check_inst_slot_refs(LirInst inst, int blk_id, int num_slots, String fn_name, Vector[String] &errors):
    int slot = -1
    String label = ""
    match inst:
        case ISlotStore(s, _, _):
            slot = s
            label = "ISlotStore"
        case ISlotLoad(_, s, _):
            slot = s
            label = "ISlotLoad"
        case ISlotAddr(_, s):
            slot = s
            label = "ISlotAddr"
        case IMoveSlot(s):
            slot = s
            label = "IMoveSlot"
        case IClosurePack(s, _, _, _):
            slot = s
            label = "IClosurePack"
        else:
            return
    if slot < 0 or slot >= num_slots:
        errors.push("@" + fn_name + " bb" + int_to_str(blk_id) + ": " + label + " references slot s" + int_to_str(slot) + " out of range (0.." + int_to_str(num_slots) + ")")

void check_term_successors(LirTerm term, int blk_id, int num_blocks, LirFunction func, Vector[String] &errors):
    match term:
        case TJump(tgt, args):
            if tgt < 0 or tgt >= num_blocks:
                errors.push("@" + func.name + " bb" + int_to_str(blk_id) + ": TJump target bb" + int_to_str(tgt) + " out of range (0.." + int_to_str(num_blocks) + ")")
            else:
                check_args_match_params("TJump", tgt, args.len(), blk_id, func, &errors)
        case TBranch(_, then_bb, then_args, else_bb, else_args):
            if then_bb < 0 or then_bb >= num_blocks:
                errors.push("@" + func.name + " bb" + int_to_str(blk_id) + ": TBranch then-target bb" + int_to_str(then_bb) + " out of range (0.." + int_to_str(num_blocks) + ")")
            else:
                check_args_match_params("TBranch.then", then_bb, then_args.len(), blk_id, func, &errors)
            if else_bb < 0 or else_bb >= num_blocks:
                errors.push("@" + func.name + " bb" + int_to_str(blk_id) + ": TBranch else-target bb" + int_to_str(else_bb) + " out of range (0.." + int_to_str(num_blocks) + ")")
            else:
                check_args_match_params("TBranch.else", else_bb, else_args.len(), blk_id, func, &errors)
        case TSwitch(_, cases, default_bb, default_args):
            if default_bb < 0 or default_bb >= num_blocks:
                errors.push("@" + func.name + " bb" + int_to_str(blk_id) + ": TSwitch default bb" + int_to_str(default_bb) + " out of range (0.." + int_to_str(num_blocks) + ")")
            else:
                check_args_match_params("TSwitch.default", default_bb, default_args.len(), blk_id, func, &errors)
            for (ci, sc) in cases.enumerate():
                if sc.target < 0 or sc.target >= num_blocks:
                    errors.push("@" + func.name + " bb" + int_to_str(blk_id) + ": TSwitch case-" + int_to_str(ci) + " target bb" + int_to_str(sc.target) + " out of range (0.." + int_to_str(num_blocks) + ")")
                else:
                    check_args_match_params("TSwitch.case-" + int_to_str(ci), sc.target, sc.args.len(), blk_id, func, &errors)
        else:
            pass

# Each terminator that targets a block passes `args` values that must
# match the destination block's `params` list 1:1. This is the bug
# class that bit the §6.4 pending_phis retirement when args order
# fell out of sync with params order — the validator now catches it
# at the post-pass hook.
void check_args_match_params(String shape, int target_bb, int args_len, int src_bb, LirFunction func, Vector[String] &errors):
    if target_bb < 0 or target_bb >= func.blocks.len():
        return  # already flagged by out-of-range check
    LirBlock target = func.blocks.get(target_bb).unwrap()
    int params_len = target.params.len()
    if args_len != params_len:
        errors.push("@" + func.name + " bb" + int_to_str(src_bb) + ": " + shape + " → bb" + int_to_str(target_bb) + " args.len()=" + int_to_str(args_len) + " ≠ params.len()=" + int_to_str(params_len))

# Render a pass-tagged violation block to stdout. Header matches the
# pattern `phase_c_closed_classes_remain_at_zero_self_host`'s FATAL
# detector (`^# validate_` + `(FATAL)`) so the same regression
# tooling picks up violate-passes failures, but with a distinct
# header prefix so an operator can grep for `GG_VALIDATE_PASSES`
# specifically.
void print_pass_violations(String header, Vector[String] errors):
    print("# validate_passes (FATAL): " + header + " — " + int_to_str(errors.len()) + " violation(s)")
    for e in errors:
        print(e)
