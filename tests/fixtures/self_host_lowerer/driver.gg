from parser import parse_source
from ast import Module
from scope import ScopeTable
from types import TypeTable
from resolve import resolve_module, ResolveContext
from typecheck import type_check_module
from derive import expand_derives
from meta import expand_meta_types, expand_meta_for_match
from lower import lower_module, apply_collect_target_rewrites
from loader import load_imports
from gir import GirModule
from format_gir import format_module
from format_lir import format_lir_module
from validate import run_validators, validate_gir_after, validate_lir_after
from lir_lower import lower_gir_to_lir, eliminate_dead_globals
from lir_ssa import construct_ssa
from lir import LirModule, LirFunction
from lir_codegen import generate_c, emit_runtime_preamble
from drop_elab import elaborate_drops
from std.fs import read_file
from std.os import args, getenv
from std.collections import Vector, Dict
from std.time import time_ms
from std.conv import int_to_str
from std.io import stderr
from std.thread import thread_spawn, Thread

# A (#14): run the compile on a 512MB opt-in stack so the compiler tolerates
# deep expression lowering without overflowing the OS-default ~8MB main thread
# (the (B) parse-time limit caps input at 128; this gives the lowerer headroom).
# `run_with_stack` was consolidated into `thread_spawn(fn, stack_size)`.
# compile_main reads its inputs from the global `args()`, so the relocated body
# works (gorget_init_args runs in this wrapper main first).
void main():
    thread_spawn(compile_main, 512 * 1024 * 1024).join()

void compile_main():
    Vector[String] cmd_args = args()
    String path = cmd_args.get(1).unwrap()
    String lib_dir = "lib"
    if cmd_args.len() > 2:
        lib_dir = cmd_args.get(2).unwrap()
    # IR-dump flags, mirroring the Rust gg's --emit-gir / --emit-lir / --emit-c-lir.
    # Chain 2: `--emit-c` and `--lir-c` are now DISTINCT.
    #   --lir-c  → body-only C (the existing path; what self_host_bootstrap /
    #              self_host_bootstrap_fixed_point / c_emit_comparison invoke,
    #              splicing the Rust runtime preamble in front of it).
    #   --emit-c → FULL program: the runtime preamble (the conditionally-selected
    #              runtime .c files + emit_lir_helpers) followed by the body, so
    #              `driver F lib --emit-c | cc -` runs with NO external splice.
    # The pipeline (lower→ssa→drop_elab) is identical for both; only the final
    # emit differs (full = emit_runtime_preamble + generate_c, body = generate_c).
    bool emit_c_full = false
    bool emit_c_body = false
    bool emit_gir = false
    bool emit_lir = false
    # Repo-relative default; the gate test passes an absolute --runtime-dir so
    # the preamble read does not depend on cwd. read_file returns "" silently on
    # a bad path, so read_runtime (in lir_codegen.gg) fails loud on an empty read.
    String runtime_dir = "src/backend/c/runtime"
    int ai = 2
    while ai < cmd_args.len():
        String arg = cmd_args.get(ai).unwrap()
        if arg == "--emit-c":
            emit_c_full = true
        if arg == "--lir-c":
            emit_c_body = true
        if arg == "--emit-gir":
            emit_gir = true
        if arg == "--emit-lir":
            emit_lir = true
        if arg.starts_with("--runtime-dir="):
            runtime_dir = arg.slice(14, arg.len())
        ai += 1
    # Phase-timer gate: mirror the GG_VALIDATE_PASSES idiom in validate.gg:352.
    # OFF by default (env unset → getenv returns "" → _timing false) so every
    # PHASE stderr print below is suppressed — output-neutral for comparisons /
    # fixed_point. Set GG_PHASE_TIMING=1 to surface the per-phase ms breakdown.
    String _gpt = getenv("GG_PHASE_TIMING")
    bool _timing = _gpt.len() > 0
    int _t0 = time_ms()
    int _tp = _t0
    String source = read_file(path)
    int _t1 = time_ms()
    if _timing: print("PHASE read_file " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    Module m = parse_source(source)
    _t1 = time_ms()
    if _timing: print("PHASE parse_source " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    Dict[String, bool] imported_fns = {}
    # Pass the entry source length so the loader can shift imported-
    # module spans past it and avoid resolution_map collisions.
    Dict[String, String] call_redirects = load_imports(&m, path, lib_dir, &imported_fns, source.byte_len())
    _t1 = time_ms()
    if _timing: print("PHASE load_imports " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    expand_derives(&m)
    _t1 = time_ms()
    if _timing: print("PHASE expand_derives " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    ScopeTable scopes = ScopeTable.new_scope_table()
    scopes.init()
    TypeTable types = TypeTable.new_type_table()
    expand_meta_types(&m, &types)
    expand_meta_for_match(&m)
    _t1 = time_ms()
    if _timing: print("PHASE meta_expand " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    ResolveContext ctx = resolve_module(m, &scopes, &types)
    _t1 = time_ms()
    if _timing: print("PHASE resolve_module " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # Pass 2.6: LHS-type-driven `.collect()` target selection. Mirrors Rust
    # gg's `apply_collect_target_rewrites` (src/semantic/mod.rs:283 — after
    # resolve, before typecheck). A pure-AST rewrite: `Set[T] x = it.collect()`
    # becomes `it.to_set()` (and `Dict[K, V]` → `it.to_dict[K, V]()`), so IR
    # lowering dispatches the Set/Dict-targeted Iterator trait default
    # (lib/std/iter.gg) instead of the Vector-targeted `collect`. Mutates the
    # driver-local `m` (the proven `&m` mutation context, like
    # `expand_meta_for_match(&m)`); the rewritten `m` then flows into both
    # typecheck and lower_module.
    apply_collect_target_rewrites(&m)
    type_check_module(m, &scopes, &types, &ctx)
    _t1 = time_ms()
    if _timing: print("PHASE type_check " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    GirModule gir = lower_module(m, scopes, types, call_redirects, imported_fns)
    _t1 = time_ms()
    if _timing: print("PHASE lower_module(GIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # §6.2 hook: validate-after-every-pass dispatcher. No-op unless
    # `GG_VALIDATE_PASSES` is set; when set, runs the GIR validators
    # with a pass-tagged failure message that surfaces mid-pipeline
    # regressions.
    validate_gir_after("gir-lowering", &gir)
    # Phase C validators run BEFORE the GIR/LIR print so a fatal
    # violation (closed-class with non-zero count) halts the build
    # with the violations as the diagnostic. All three classes
    # (field_reads, call_args, moves) are unconditional fatal as
    # of step 5c.
    run_validators(&gir)
    _t1 = time_ms()
    if _timing: print("PHASE run_validators(GIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # --emit-gir: dump GIR text and stop before LIR lowering (matches Rust's
    # `--emit-gir`, which dumps the GIR module and returns without codegen).
    if emit_gir:
        print(format_module(&gir))
        return
    if emit_c_full or emit_c_body or emit_lir:
        LirModule lir = lower_gir_to_lir(&gir)
        _t1 = time_ms()
        if _timing: print("PHASE lower_gir_to_lir(LIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("lir-lowering", &lir)
        # Drop globals no function references — mirrors Rust gg's
        # `eliminate_dead_globals` in src/lir/optimize.rs. Without
        # this, stage-1's emitted .c carries dead `__lir_g<N>` decls
        # for stdin/stdout/stderr handles imported from lib/std/io.gg
        # even when the fixture never touches them.
        eliminate_dead_globals(&lir)
        _t1 = time_ms()
        if _timing: print("PHASE eliminate_dead_globals " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        run_ssa(&lir)
        _t1 = time_ms()
        if _timing: print("PHASE run_ssa " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("ssa-construction", &lir)
        # Phase 2c COMMIT 1: drop elaboration runs after SSA, mirroring
        # Rust's pipeline (src/lir/optimize.rs:78). Operates on the
        # non-promotable slots that survived SSA construction (those
        # touched by ISlotAddr / IDropGuardOpen). Phase 2c COMMITs 2-4
        # turn this from a no-observable-effect pass into the linchpin
        # of correct drop emission.
        elaborate_drops(&lir)
        _t1 = time_ms()
        if _timing: print("PHASE elaborate_drops " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("drop-elaboration", &lir)
        _t1 = time_ms()
        if _timing: print("PHASE validate_lir_after(x3) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        # --emit-lir: dump the post-SSA, post-drop-elaboration LIR (the form
        # the C backend consumes). Rust's `--emit-lir` dumps post-SSA-post-opt;
        # drop elaboration is the self-host's closest analog of that opt stage.
        if emit_lir:
            print(format_lir_module(&lir))
        elif emit_c_full:
            # FULL program: runtime preamble (selected runtime .c files +
            # emit_lir_helpers) THEN the body. Order is preamble-then-body,
            # matching Rust's splice boundary (the runtime precedes the body's
            # user typedefs). No external splice needed downstream.
            String _pre = emit_runtime_preamble(&lir, runtime_dir)
            String _body = generate_c(&lir)
            _t1 = time_ms()
            if _timing: print("PHASE generate_c " + int_to_str(_t1 - _tp) + " ms", file=stderr)
            _tp = _t1
            if _timing: print("PHASE TOTAL " + int_to_str(_t1 - _t0) + " ms", file=stderr)
            print(_pre + _body)
        else:
            String _c = generate_c(&lir)
            _t1 = time_ms()
            if _timing: print("PHASE generate_c " + int_to_str(_t1 - _tp) + " ms", file=stderr)
            _tp = _t1
            if _timing: print("PHASE TOTAL " + int_to_str(_t1 - _t0) + " ms", file=stderr)
            print(_c)
    else:
        # Default (no dump flag): GIR text, matching prior driver behavior.
        print(format_module(&gir))

void run_ssa(LirModule &m):
    int fi = 0
    while fi < m.functions.len():
        construct_ssa(&m.functions.get(fi).unwrap())
        fi += 1
