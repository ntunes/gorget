# ── Inc-3 PROTOTYPE: embedded lib/std/*.gg (relocatability for imports) ───────
# Same entry-module constraint as the runtime table: `embed_file` consts only
# work in driver.gg. Keyed on the NORMALIZED module path (std.net.X → std.X,
# mirroring resolve_module_path's rewrite), so load_imports consults it before
# the disk lib_dir. 28 lib/std/*.gg files, ~129 KB total.
meta String LIB_alloc = embed_file("../../../lib/std/alloc.gg")
meta String LIB_async = embed_file("../../../lib/std/async.gg")
meta String LIB_bytes = embed_file("../../../lib/std/bytes.gg")
meta String LIB_channel = embed_file("../../../lib/std/channel.gg")
meta String LIB_collections = embed_file("../../../lib/std/collections.gg")
meta String LIB_conv = embed_file("../../../lib/std/conv.gg")
meta String LIB_datetime = embed_file("../../../lib/std/datetime.gg")
meta String LIB_encoding = embed_file("../../../lib/std/encoding.gg")
meta String LIB_fmt = embed_file("../../../lib/std/fmt.gg")
meta String LIB_fs = embed_file("../../../lib/std/fs.gg")
meta String LIB_hash = embed_file("../../../lib/std/hash.gg")
meta String LIB_heap = embed_file("../../../lib/std/heap.gg")
meta String LIB_io = embed_file("../../../lib/std/io.gg")
meta String LIB_iter = embed_file("../../../lib/std/iter.gg")
meta String LIB_math = embed_file("../../../lib/std/math.gg")
meta String LIB_os = embed_file("../../../lib/std/os.gg")
