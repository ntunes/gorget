# ── Inc-2: embedded C runtime (relocatability) ───────────────────────────────
# Bake the 62 `src/backend/c/runtime/*.c` files into THIS binary via `embed_file`
# (Gorget's `include_str!`), so a built `gg-selfhost` carries its runtime and
# `build hello.gg -o hello && ./hello` works from ANY cwd with NO env vars (the
# emitted preamble reads these embedded bytes instead of the on-disk runtime dir).
#
# WHY HERE (the entry-module constraint): the meta-const pass evaluates
# `embed_file` consts ONLY in the ENTRY module (`src/semantic/meta.rs:476-478`
# iterates top-level `module.items`; imported modules are nested in `Item::Module`
# wrappers it does NOT descend into). driver.gg IS the entry, so the table + its
# builder MUST live here, not in lir_codegen.gg. `build_embedded_runtime()` is
# called by the 3 `emit_runtime_preamble` sites below and passed down as
# `&embedded`; lir_codegen.gg's `read_runtime` consults it (3-state precedence:
# --runtime-dir flag > GG_RUNTIME_DIR env > embedded; a dict-MISS — the three
# `../stb_image.h`/`../sqlite3/...` reads not in this 62-set — falls through to
# disk). Paths are entry-relative (driver.gg lives at
# tests/fixtures/self_host_lowerer/, so ../../../ reaches the repo root).
#
# SQLite (8.8 MB), SDL, stb_image are vendored OUTSIDE runtime/ and stay
# DISK-ONLY (embedding sqlite3.c would balloon this source + the bootstrap) —
# Inc-4 handles SQLite separately.
#
# ⚠ LINT-PINNED: `tests/lints.rs::self_host_embedded_runtime_table_count` asserts
# this table has exactly `ls src/backend/c/runtime/*.c | wc -l` entries, so a NEW
# runtime file is FORCED into the table (else it'd silently fall back to disk and
# break relocatability). When you add a runtime .c, add BOTH its `RT_` const and
# its `d[...] =` row, then bump the lint.
meta String RT_async_runtime = embed_file("../../../src/backend/c/runtime/async_runtime.c")
meta String RT_audio_runtime = embed_file("../../../src/backend/c/runtime/audio_runtime.c")
meta String RT_blocking_pool_runtime = embed_file("../../../src/backend/c/runtime/blocking_pool_runtime.c")
meta String RT_bytes_f32_runtime = embed_file("../../../src/backend/c/runtime/bytes_f32_runtime.c")
meta String RT_bytes_runtime = embed_file("../../../src/backend/c/runtime/bytes_runtime.c")
meta String RT_channel_runtime = embed_file("../../../src/backend/c/runtime/channel_runtime.c")
meta String RT_compress_runtime = embed_file("../../../src/backend/c/runtime/compress_runtime.c")
meta String RT_crypto_runtime = embed_file("../../../src/backend/c/runtime/crypto_runtime.c")
meta String RT_gl_runtime = embed_file("../../../src/backend/c/runtime/gl_runtime.c")
meta String RT_hot_reload_runtime = embed_file("../../../src/backend/c/runtime/hot_reload_runtime.c")
meta String RT_image_runtime = embed_file("../../../src/backend/c/runtime/image_runtime.c")
meta String RT_main_waker_runtime = embed_file("../../../src/backend/c/runtime/main_waker_runtime.c")
meta String RT_metal_runtime = embed_file("../../../src/backend/c/runtime/metal_runtime.c")
