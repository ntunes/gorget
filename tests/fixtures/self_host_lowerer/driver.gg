    d["gl_runtime.c"] = RT_gl_runtime
    d["hot_reload_runtime.c"] = RT_hot_reload_runtime
    d["image_runtime.c"] = RT_image_runtime
    d["main_waker_runtime.c"] = RT_main_waker_runtime
    d["metal_runtime.c"] = RT_metal_runtime
    d["mutex_runtime.c"] = RT_mutex_runtime
    d["panic_normal.c"] = RT_panic_normal
    d["panic_test.c"] = RT_panic_test
    d["process_runtime.c"] = RT_process_runtime
    d["process_spawn_runtime.c"] = RT_process_spawn_runtime
    d["reactor_runtime.c"] = RT_reactor_runtime
    d["runtime_alloc_report.c"] = RT_runtime_alloc_report
    d["runtime_arena_alloc.c"] = RT_runtime_arena_alloc
    d["runtime_args.c"] = RT_runtime_args
    d["runtime_array.c"] = RT_runtime_array
    d["runtime_checked_arith.c"] = RT_runtime_checked_arith
    d["runtime_clone_sites.c"] = RT_runtime_clone_sites
    d["runtime_clone_stats.c"] = RT_runtime_clone_stats
    d["runtime_env.c"] = RT_runtime_env
    d["runtime_error.c"] = RT_runtime_error
    d["runtime_fallback_alloc.c"] = RT_runtime_fallback_alloc
    d["runtime_file.c"] = RT_runtime_file
    d["runtime_fixedbuf_alloc.c"] = RT_runtime_fixedbuf_alloc
    d["runtime_io.c"] = RT_runtime_io
    d["runtime_map.c"] = RT_runtime_map
    d["runtime_math.c"] = RT_runtime_math
    d["runtime_parse.c"] = RT_runtime_parse
    d["runtime_path.c"] = RT_runtime_path
    d["runtime_pool_alloc.c"] = RT_runtime_pool_alloc
    d["runtime_preamble.c"] = RT_runtime_preamble
    d["runtime_set.c"] = RT_runtime_set
    d["runtime_sort.c"] = RT_runtime_sort
    d["runtime_string.c"] = RT_runtime_string
    d["runtime_string_array.c"] = RT_runtime_string_array
    d["runtime_string_base_ops.c"] = RT_runtime_string_base_ops
    d["runtime_string_extended.c"] = RT_runtime_string_extended
    d["runtime_tlsf_alloc.c"] = RT_runtime_tlsf_alloc
    d["runtime_tostr.c"] = RT_runtime_tostr
    d["runtime_tracking_alloc.c"] = RT_runtime_tracking_alloc
    d["scheduler_inline_runtime.c"] = RT_scheduler_inline_runtime
    d["scheduler_pool_runtime.c"] = RT_scheduler_pool_runtime
    d["scheduler_single_runtime.c"] = RT_scheduler_single_runtime
    d["scheduler_thread_runtime.c"] = RT_scheduler_thread_runtime
    d["sdl_runtime.c"] = RT_sdl_runtime
    d["server_socket_runtime.c"] = RT_server_socket_runtime
    d["shared_runtime.c"] = RT_shared_runtime
