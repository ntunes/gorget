# Build the basename → contents map from the embedded consts above. Each `RT_X`
# identifier is substituted with the file's bytes by the meta pass (Rust:
# meta.rs str_consts; self-host: meta.gg subst_expr EIdentifier→EStringLiteral),
# so this is a pure compile-time-inlined Dict build — no runtime file I/O.
Dict[String, String] build_embedded_runtime():
    Dict[String, String] d = {}
    d["async_runtime.c"] = RT_async_runtime
    d["audio_runtime.c"] = RT_audio_runtime
    d["blocking_pool_runtime.c"] = RT_blocking_pool_runtime
    d["bytes_f32_runtime.c"] = RT_bytes_f32_runtime
    d["bytes_runtime.c"] = RT_bytes_runtime
    d["channel_runtime.c"] = RT_channel_runtime
    d["compress_runtime.c"] = RT_compress_runtime
