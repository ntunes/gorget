meta String LIB_term = embed_file("../../../lib/std/term.gg")
meta String LIB_thread = embed_file("../../../lib/std/thread.gg")
meta String LIB_time = embed_file("../../../lib/std/time.gg")
meta String LIB_tls = embed_file("../../../lib/std/tls.gg")
meta String LIB_udp = embed_file("../../../lib/std/udp.gg")

# Build the normalized-module-path → source map (compile-time inlined, no I/O).
Dict[String, String] build_embedded_lib():
    Dict[String, String] d = {}
    d["std.alloc"] = LIB_alloc
    d["std.async"] = LIB_async
    d["std.bytes"] = LIB_bytes
    d["std.channel"] = LIB_channel
    d["std.collections"] = LIB_collections
    d["std.conv"] = LIB_conv
    d["std.datetime"] = LIB_datetime
    d["std.encoding"] = LIB_encoding
    d["std.fmt"] = LIB_fmt
    d["std.fs"] = LIB_fs
    d["std.hash"] = LIB_hash
    d["std.heap"] = LIB_heap
    d["std.io"] = LIB_io
    d["std.iter"] = LIB_iter
    d["std.math"] = LIB_math
    d["std.os"] = LIB_os
    d["std.path"] = LIB_path
    d["std.process"] = LIB_process
    d["std.random"] = LIB_random
    d["std.signal"] = LIB_signal
    d["std.slotmap"] = LIB_slotmap
    d["std.socket"] = LIB_socket
    d["std.sync"] = LIB_sync
    d["std.term"] = LIB_term
    d["std.thread"] = LIB_thread
    d["std.time"] = LIB_time
    d["std.tls"] = LIB_tls
    d["std.udp"] = LIB_udp
    return d

# A (#14): run the compile on a 512MB opt-in stack so the compiler tolerates
# deep expression lowering without overflowing the OS-default ~8MB main thread
# (the (B) parse-time limit caps input at 128; this gives the lowerer headroom).
# `run_with_stack` was consolidated into `thread_spawn(fn, stack_size)`.
# compile_main reads its inputs from the global `args()`, so the relocated body
# works (gorget_init_args runs in this wrapper main first).
void main():
    thread_spawn(compile_main, 512 * 1024 * 1024).join()

void compile_main():
    Vector[String] cmd_args = args()
    # ── Build/run/check subcommand (new standalone-compiler CLI) ─────────────
    # GG_IMPL=selfhost installs this binary as `gg`. When invoked as:
    #   gg build <input.gg> [-o <output>] [--backend=<b>] [--emit-c|--lir-c|--emit-gir|--emit-lir] [--runtime-dir=<dir>] [--lib-dir=<dir>]
    #   gg run   <input.gg>              [--backend=<b>] [--runtime-dir=<dir>] [--lib-dir=<dir>]
    #   gg check <input.gg>              [--lib-dir=<dir>]
    #   gg --help
    # delegate to run_build_mode / run_check_mode / print_usage and return. The
    # legacy path (driver <path> <lib_dir> [--emit-c|--lir-c|…]) is unchanged so
    # all existing test-harness callers (self_host_bootstrap_fixed_point,
    # c_emit_comparison, lowerer_comparison, …) continue to work.
    #
    # `--help` is matched FIRST (before any subcommand) so both `gg --help` and
    # a bare `gg` with no args print the usage summary and exit 0.
    if cmd_args.len() < 2:
        print_usage()
        exit(0)
    String _subcmd = cmd_args.get(1).unwrap()
    if _subcmd == "--help" or _subcmd == "-h":
        print_usage()
        exit(0)
    # G1: `--version` / `-V` — match Rust gg's `println!("gg {}", CARGO_PKG_VERSION)`
    # (src/main.rs). The version literal mirrors Cargo.toml `version` (0.1.4-alpha);
    # the self-host has no version constant, so it is hardcoded here. Stdout, exit 0.
    if _subcmd == "--version" or _subcmd == "-V":
        print("gg 0.1.4-alpha")
        exit(0)
    if _subcmd == "build":
        run_build_mode(cmd_args, false)
        return
    if _subcmd == "run":
        run_build_mode(cmd_args, true)
        return
    if _subcmd == "check":
        run_check_mode(cmd_args)
        return
    # G2: unknown-command diagnostic — mirror Rust gg's `Unknown command: <x>` + the
    # valid-command list on stderr + exit 1 (src/main.rs). The command list is the
    # self-host's ACTUAL commands (build/run/check) — listing commands it does not
    # implement would be a worse divergence than the prefix. CRITICAL gate: this must
    # NOT swallow the legacy harness shape `driver <file.gg> <lib_dir> [--lir-c]` that
    # self_host_bootstrap_fixed_point / c_emit_comparison depend on, so an arg1 is
    # treated as an unknown command ONLY when it does not start with `-` (not a flag)
    # AND does not end in `.gg` (not a source path). Everything else falls through.
    if not _subcmd.starts_with("-") and not _subcmd.ends_with(".gg"):
        print("Unknown command: " + _subcmd, file=stderr)
        print("valid commands: build, run, check", file=stderr)
        exit(1)
    # ── Legacy path ─────────────────────────────────────────────────────────
    String path = cmd_args.get(1).unwrap()
    String lib_dir = "lib"
    if cmd_args.len() > 2:
        lib_dir = cmd_args.get(2).unwrap()
    # IR-dump flags, mirroring the Rust gg's --emit-gir / --emit-lir / --emit-c-lir.
    # Chain 2: `--emit-c` and `--lir-c` are now DISTINCT.
    #   --lir-c  → body-only C (the existing path; what self_host_bootstrap /
    #              self_host_bootstrap_fixed_point / c_emit_comparison invoke,
    #              splicing the Rust runtime preamble in front of it).
    #   --emit-c → FULL program: the runtime preamble (the conditionally-selected
    #              runtime .c files + emit_lir_helpers) followed by the body, so
    #              `driver F lib --emit-c | cc -` runs with NO external splice.
    # The pipeline (lower→ssa→drop_elab) is identical for both; only the final
    # emit differs (full = emit_runtime_preamble + generate_c, body = generate_c).
    bool emit_c_full = false
    bool emit_c_body = false
    bool emit_gir = false
    bool emit_lir = false
    # Repo-relative default; the gate test passes an absolute --runtime-dir so
    # the preamble read does not depend on cwd. read_file returns "" silently on
    # a bad path, so read_runtime (in lir_codegen.gg) fails loud on an empty read.
    String runtime_dir = "src/backend/c/runtime"
    # Inc-2: `--runtime-dir=` FLAG forces a disk read (overrides the embedded
    # runtime). The legacy path is FLAG-ONLY — it never reads GG_RUNTIME_DIR (the
    # standalone `run_build_mode` path does), so `explicit` here tracks only the
    # flag. Output is byte-identical either way at the default dir: flag→disk at
    # `src/backend/c/runtime` reads the same bytes the embed baked in.
    bool runtime_dir_explicit = false
    int ai = 2
    while ai < cmd_args.len():
        String arg = cmd_args.get(ai).unwrap()
        if arg == "--emit-c":
            emit_c_full = true
        if arg == "--lir-c":
            emit_c_body = true
        if arg == "--emit-gir":
            emit_gir = true
        if arg == "--emit-lir":
            emit_lir = true
        if arg.starts_with("--runtime-dir="):
            runtime_dir = arg.slice(14, arg.len())
            runtime_dir_explicit = true
        ai += 1
    # Phase-timer gate: mirror the GG_VALIDATE_PASSES idiom in validate.gg:352.
    # OFF by default (env unset → getenv returns "" → _timing false) so every
    # PHASE stderr print below is suppressed — output-neutral for comparisons /
    # fixed_point. Set GG_PHASE_TIMING=1 to surface the per-phase ms breakdown.
    String _gpt = getenv("GG_PHASE_TIMING")
    bool _timing = _gpt.len() > 0
    int _t0 = time_ms()
    int _tp = _t0
    String source = read_file(path)
    int _t1 = time_ms()
    if _timing: print("PHASE read_file " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    Module m = parse_source(source)
    _t1 = time_ms()
    if _timing: print("PHASE parse_source " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    Dict[String, bool] imported_fns = {}
    # Pass the entry source length so the loader can shift imported-
    # module spans past it and avoid resolution_map collisions.
    # Inc-3 PROTOTYPE: legacy path is FLAG-ONLY (never reads GG_LIB_DIR). A lib_dir
    # positional arg (the harness always passes one) → explicit disk → byte-identical
    # to today; only a bare `driver <path>` with no lib_dir consults the embed.
    Dict[String, String] lib_embedded = build_embedded_lib()
    bool lib_explicit = cmd_args.len() > 2
    Dict[String, bool] imported_bare_names = {}
    Dict[String, String] call_redirects = load_imports(&m, path, lib_dir, &imported_fns, source.byte_len(), lib_embedded, lib_explicit, &imported_bare_names)
    _t1 = time_ms()
    if _timing: print("PHASE load_imports " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    expand_derives(&m)
    _t1 = time_ms()
    if _timing: print("PHASE expand_derives " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    ScopeTable scopes = ScopeTable.new_scope_table()
    scopes.init()
    TypeTable types = TypeTable.new_type_table()
    # embed_file() resolves paths relative to the entry source dir. Bind
    # to a String VarDecl first so the cstr->String coercion fires (it
    # only fires at an SVarDecl, not in argument position).
    String entry_source_dir = path_parent(path_absolute(path))
    expand_meta_types(&m, &types, entry_source_dir)
    expand_meta_for_match(&m)
    _t1 = time_ms()
    if _timing: print("PHASE meta_expand " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    ResolveContext ctx = resolve_module_with_imports(m, &scopes, &types, imported_bare_names)
    _t1 = time_ms()
    if _timing: print("PHASE resolve_module " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # Pass 2.6: LHS-type-driven `.collect()` target selection. Mirrors Rust
    # gg's `apply_collect_target_rewrites` (src/semantic/mod.rs:283 — after
    # resolve, before typecheck). A pure-AST rewrite: `Set[T] x = it.collect()`
    # becomes `it.to_set()` (and `Dict[K, V]` → `it.to_dict[K, V]()`), so IR
    # lowering dispatches the Set/Dict-targeted Iterator trait default
    # (lib/std/iter.gg) instead of the Vector-targeted `collect`. Mutates the
    # driver-local `m` (the proven `&m` mutation context, like
    # `expand_meta_for_match(&m)`); the rewritten `m` then flows into both
    # typecheck and lower_module.
    apply_collect_target_rewrites(&m)
    # Rebind aliased imports (`from X import Y as Z`) back to surface names so
    # the IR backend's `map_runtime_name` lowers `Z(...)` calls to the real C
    # symbol of `Y`. Mirrors Rust gg's `rewrite_import_aliases` (after resolve,
    # before lowering — src/semantic/mod.rs:248).
    rename_import_aliases(&m)
    type_check_module(m, &scopes, &types, &ctx)
    _t1 = time_ms()
    if _timing: print("PHASE type_check " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # Diagnostic gate (snag #11 item 4): the resolve + typecheck passes push
    # typed `Diagnostic`s onto `ctx.diagnostics`. If any are ERROR-severity,
    # render them all (source-grounded: path:line:col + the offending line +
    # a caret under the span) and HALT before lowering — an invalid program
    # must be REJECTED, not miscompiled. Warnings/suggestions do not halt.
    # Spurious-diagnostic risk is ~0: a full-corpus sweep found the self-host
    # typecheck emits ZERO diagnostics on every Rust-accepted fixture, and
    # zero on its own source (so bootstrap fixed_point stays clean).
    if has_errors(ctx.diagnostics):
        report_diagnostics(ctx.diagnostics, source, path)
        exit(1)
    GirModule gir = lower_module(&m, scopes, types, call_redirects, imported_fns)
    _t1 = time_ms()
    if _timing: print("PHASE lower_module(GIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # §6.2 hook: validate-after-every-pass dispatcher. No-op unless
    # `GG_VALIDATE_PASSES` is set; when set, runs the GIR validators
    # with a pass-tagged failure message that surfaces mid-pipeline
    # regressions.
    validate_gir_after("gir-lowering", &gir)
    # Phase C validators run BEFORE the GIR/LIR print so a fatal
    # violation (closed-class with non-zero count) halts the build
    # with the violations as the diagnostic. All three classes
    # (field_reads, call_args, moves) are unconditional fatal as
    # of step 5c.
    run_validators(&gir)
    _t1 = time_ms()
    if _timing: print("PHASE run_validators(GIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
    _tp = _t1
    # --emit-gir: dump GIR text and stop before LIR lowering (matches Rust's
    # `--emit-gir`, which dumps the GIR module and returns without codegen).
    if emit_gir:
        print(format_module(gir))
        return
    if emit_c_full or emit_c_body or emit_lir:
        LirModule lir = lower_gir_to_lir(&gir)
        _t1 = time_ms()
        if _timing: print("PHASE lower_gir_to_lir(LIR) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("lir-lowering", lir)
        # Drop globals no function references — mirrors Rust gg's
        # `eliminate_dead_globals` in src/lir/optimize.rs. Without
        # this, stage-1's emitted .c carries dead `__lir_g<N>` decls
        # for stdin/stdout/stderr handles imported from lib/std/io.gg
        # even when the fixture never touches them.
        eliminate_dead_globals(&lir)
        _t1 = time_ms()
        if _timing: print("PHASE eliminate_dead_globals " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        run_ssa(lir)
        _t1 = time_ms()
        if _timing: print("PHASE run_ssa " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("ssa-construction", lir)
        # Phase 2c COMMIT 1: drop elaboration runs after SSA, mirroring
        # Rust's pipeline (src/lir/optimize.rs:78). Operates on the
        # non-promotable slots that survived SSA construction (those
        # touched by ISlotAddr / IDropGuardOpen). Phase 2c COMMITs 2-4
        # turn this from a no-observable-effect pass into the linchpin
        # of correct drop emission.
        elaborate_drops(&lir)
        _t1 = time_ms()
        if _timing: print("PHASE elaborate_drops " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        validate_lir_after("drop-elaboration", lir)
        _t1 = time_ms()
        if _timing: print("PHASE validate_lir_after(x3) " + int_to_str(_t1 - _tp) + " ms", file=stderr)
        _tp = _t1
        # --emit-lir: dump the post-SSA, post-drop-elaboration LIR (the form
        # the C backend consumes). Rust's `--emit-lir` dumps post-SSA-post-opt;
        # drop elaboration is the self-host's closest analog of that opt stage.
        if emit_lir:
            print(format_lir_module(lir))
        elif emit_c_full:
            # FULL program: runtime preamble (selected runtime .c files +
            # emit_lir_helpers) THEN the body. Order is preamble-then-body,
            # matching Rust's splice boundary (the runtime precedes the body's
            # user typedefs). No external splice needed downstream.
            Dict[String, String] _embedded = build_embedded_runtime()
            String _pre = emit_runtime_preamble(&lir, runtime_dir, &_embedded, runtime_dir_explicit)
            String _body = generate_c(&lir)
            _t1 = time_ms()
            if _timing: print("PHASE generate_c " + int_to_str(_t1 - _tp) + " ms", file=stderr)
            _tp = _t1
            if _timing: print("PHASE TOTAL " + int_to_str(_t1 - _t0) + " ms", file=stderr)
            print(_pre + _body)
        else:
            String _c = generate_c(&lir)
            _t1 = time_ms()
            if _timing: print("PHASE generate_c " + int_to_str(_t1 - _tp) + " ms", file=stderr)
            _tp = _t1
            if _timing: print("PHASE TOTAL " + int_to_str(_t1 - _t0) + " ms", file=stderr)
            print(_c)
    else:
        # Default (no dump flag): GIR text, matching prior driver behavior.
        print(format_module(gir))

# ── usage / --help ───────────────────────────────────────────────────────────
# Printed by `gg --help`, a bare `gg`, and on a no-input-file error. Kept in one
# place so the subcommand list / flag set has a single source of truth.
void print_usage():
    print("gg — the Gorget compiler (self-host)")
    print("")
    print("usage:")
    print("  gg build <input.gg> [-o <output>] [options]   compile to a native binary")
    print("  gg run   <input.gg>              [options]    compile and execute (propagates exit code)")
    print("  gg check <input.gg>             [options]     parse + resolve + typecheck only (no codegen)")
    print("  gg --help                                     print this message")
    print("")
    print("options:")
    print("  -o <output>            output binary path (build; default: input with .gg stripped)")
    print("  --backend=<b>          codegen backend; self-host emits C only (c). llvm is rejected.")
    print("  --emit-c               dump full C (runtime preamble + body) to stdout, skip cc/link")
    print("  --lir-c                dump body-only C to stdout, skip cc/link")
    print("  --emit-gir             dump GIR text to stdout, skip codegen")
    print("  --emit-lir             dump post-drop-elaboration LIR to stdout, skip codegen")
    print("  --runtime-dir=<dir>    path to the C runtime (default: $GG_RUNTIME_DIR or src/backend/c/runtime)")
    print("  --lib-dir=<dir>        path to the std library (default: $GG_LIB_DIR or lib)")

# ── build/run subcommand implementation ─────────────────────────────────────
# Handles `gg build <input.gg> [-o <output>] [opts]` and
#          `gg run   <input.gg>               [opts]`
# where opts are:
#   --backend=<b>         codegen backend selector. The self-host backend emits
#                         C only, so `c` is accepted (and is the default); any
#                         other value (notably `llvm`) is REJECTED cleanly — the
#                         self-host driver has no LLVM emit path. (The Rust gg's
#                         `--backend=llvm` lives in src/main.rs, a different
#                         binary.)
#   --emit-c / --lir-c / --emit-gir / --emit-lir
#                         IR/C dump passthrough mirroring the legacy path: when
#                         any is set, emit the requested form to stdout and
#                         RETURN before cc/link (matches Rust gg's --emit-*,
#                         which dump-and-exit; src/main.rs:638/659).
#   --runtime-dir=<abs>   path to src/backend/c/runtime (default: $GG_RUNTIME_DIR
#                         or repo-relative "src/backend/c/runtime")
#   --lib-dir=<abs>       path to the lib/ standard library (default: $GG_LIB_DIR
#                         or repo-relative "lib")
# The runtime-dir and lib-dir are required for a standalone install; the
# GG_IMPL orchestrator (build.sh) always passes them as absolute paths.
void run_build_mode(Vector[String] cmd_args, bool do_run):
    # Arg parsing: skip argv[0] (binary name) and argv[1] ("build"/"run").
    String input_path = ""
    String output_path = ""
    # Defaults: env vars (set by the orchestrator) then repo-relative fallbacks.
    String runtime_dir = getenv("GG_RUNTIME_DIR")
    String lib_dir = getenv("GG_LIB_DIR")
    # Inc-2 3-state precedence: an EXPLICIT runtime dir (GG_RUNTIME_DIR env set,
    # OR a --runtime-dir= flag below) forces a DISK read in `read_runtime`;
    # otherwise the preamble uses the EMBEDDED runtime (relocatable). Seed from
    # the env read here; the flag-parse loop sets it true if --runtime-dir= is given.
    bool runtime_dir_explicit = runtime_dir != ""
    # Inc-3 3-state precedence (mirrors runtime_dir_explicit): an EXPLICIT lib dir
    # (GG_LIB_DIR env set, OR --lib-dir= below) forces DISK in load_imports;
    # otherwise std.* imports come from the EMBEDDED table (relocatable).
    bool lib_dir_explicit = lib_dir != ""
    if runtime_dir == "":
        runtime_dir = "src/backend/c/runtime"
    if lib_dir == "":
        lib_dir = "lib"

    # Emit-flag passthrough (mirrors the legacy path's flag set, :72-90). When
    # any is set, the requested IR/C is dumped to stdout and we RETURN before
    # cc/link. --emit-c = full program (preamble + body); --lir-c = body only.
    bool emit_c_full = false
    bool emit_c_body = false
    bool emit_gir = false
    bool emit_lir = false
    # --backend selector. The self-host emits C only, so default = "c" and any
    # other value is rejected below. Mirrors the Rust gg's --backend=c|llvm flag
    # surface so a caller's `--backend=c` is accepted (a no-op here).
    String backend = "c"

    int ai = 2
    while ai < cmd_args.len():
        String arg = cmd_args.get(ai).unwrap()
        if arg == "-o":
            ai += 1
            if ai < cmd_args.len():
                output_path = cmd_args.get(ai).unwrap()
        elif arg == "--emit-c":
            emit_c_full = true
        elif arg == "--lir-c":
            emit_c_body = true
        elif arg == "--emit-gir":
            emit_gir = true
        elif arg == "--emit-lir":
            emit_lir = true
        elif arg.starts_with("--backend="):
            backend = arg.slice(10, arg.len())
        elif arg.starts_with("--runtime-dir="):
            runtime_dir = arg.slice(14, arg.len())
            runtime_dir_explicit = true
        elif arg.starts_with("--lib-dir="):
            lib_dir = arg.slice(10, arg.len())
            lib_dir_explicit = true
        elif not arg.starts_with("-"):
            input_path = arg
        ai += 1

    # Reject any backend the self-host can't emit. The self-host has no LLVM
    # path (the Rust gg owns --backend=llvm); accept `c` (the only backend) and
    # reject everything else with a clear message rather than silently emitting C.
    if backend != "c":
        print("error: unsupported --backend=" + backend + " (the self-host compiler emits C only; use --backend=c)", file=stderr)
        exit(1)

    if input_path == "":
        print("error: no input file given", file=stderr)
        print("usage: gg build <input.gg> [-o <output>] [--backend=<b>] [--emit-c|--lir-c|--emit-gir|--emit-lir] [--runtime-dir=<dir>] [--lib-dir=<dir>]", file=stderr)
        exit(1)

    # Derive default output path from input: strip ".gg" suffix.
    if output_path == "":
        if input_path.ends_with(".gg"):
            output_path = input_path.slice(0, input_path.len() - 3)
        else:
            output_path = input_path + "_out"

    # Unique temp file for the emitted C (use timestamp to avoid collisions
    # when multiple gg invocations run concurrently).
    String c_path = "/tmp/gg_selfhost_build_" + int_to_str(time_ms()) + ".c"

    # ── Compile pipeline ─────────────────────────────────────────────────────
    String source = read_file(input_path)
    Module m = parse_source(source)
    Dict[String, bool] imported_fns = {}
    Dict[String, String] lib_embedded = build_embedded_lib()
    Dict[String, bool] imported_bare_names = {}
    Dict[String, String] call_redirects = load_imports(&m, input_path, lib_dir, &imported_fns, source.byte_len(), lib_embedded, lib_dir_explicit, &imported_bare_names)
    expand_derives(&m)
    ScopeTable scopes = ScopeTable.new_scope_table()
    scopes.init()
    TypeTable types = TypeTable.new_type_table()
    # embed_file() resolves paths relative to the entry source dir. Bind
    # to a String VarDecl first so the cstr->String coercion fires (it
    # only fires at an SVarDecl, not in argument position).
    String entry_source_dir = path_parent(path_absolute(input_path))
    expand_meta_types(&m, &types, entry_source_dir)
    expand_meta_for_match(&m)
    ResolveContext ctx = resolve_module_with_imports(m, &scopes, &types, imported_bare_names)
    apply_collect_target_rewrites(&m)
    # Rebind aliased imports (`from X import Y as Z`) back to surface names so
    # the IR backend's `map_runtime_name` lowers `Z(...)` calls to the real C
    # symbol of `Y`. Mirrors Rust gg's `rewrite_import_aliases` (after resolve,
    # before lowering — src/semantic/mod.rs:248).
    rename_import_aliases(&m)
    type_check_module(m, &scopes, &types, &ctx)
    if has_errors(ctx.diagnostics):
        report_diagnostics(ctx.diagnostics, source, input_path)
        exit(1)
    GirModule gir = lower_module(&m, scopes, types, call_redirects, imported_fns)
    validate_gir_after("gir-lowering", &gir)
    run_validators(&gir)
    # --emit-gir: dump GIR text and stop before LIR lowering (mirrors the legacy
    # path :178 and Rust's --emit-gir; src/main.rs:638).
    if emit_gir:
        print(format_module(gir))
        return
    LirModule lir = lower_gir_to_lir(&gir)
    validate_lir_after("lir-lowering", lir)
    eliminate_dead_globals(&lir)
    run_ssa(lir)
    validate_lir_after("ssa-construction", lir)
    elaborate_drops(&lir)
    validate_lir_after("drop-elaboration", lir)
    # --emit-lir: dump the post-SSA, post-drop-elaboration LIR and stop (mirrors
    # the legacy path :218 and Rust's --emit-lir; src/main.rs:659).
    if emit_lir:
        print(format_lir_module(lir))
        return
    # --lir-c: dump body-only C (no runtime preamble) and stop. --emit-c: dump
    # the full program (preamble + body) and stop. Both skip cc/link, matching
    # the legacy path's --lir-c/--emit-c (:220-238) + Rust's dump-and-exit.
    if emit_c_body:
        print(generate_c(&lir))
        return
    # Inc-2: the embedded runtime table (consulted by read_runtime when no
    # explicit --runtime-dir/GG_RUNTIME_DIR forces a disk read). Built once for
    # both the --emit-c dump and the cc/link path below.
    Dict[String, String] _embedded = build_embedded_runtime()
    if emit_c_full:
        print(emit_runtime_preamble(&lir, runtime_dir, &_embedded, runtime_dir_explicit) + generate_c(&lir))
        return
    # Emit full C (runtime preamble + body).
    String full_c = emit_runtime_preamble(&lir, runtime_dir, &_embedded, runtime_dir_explicit) + generate_c(&lir)

    # ── Write C → temp file ──────────────────────────────────────────────────
    write_file(c_path, full_c)

    # ── Invoke C compiler ────────────────────────────────────────────────────
    # Mirror the test harness's cc recipe (tests/integration.rs:16411-16417):
    #   cc -O0 -w -o <output> <c_file> -lm -lpthread
    # Respect $CC (same convention as the Rust gg; src/main.rs:1005).
    String cc = getenv("CC")
    if cc == "":
        cc = "cc"
    String cc_cmd = cc + " -O0 -w -o " + output_path + " " + c_path + " -lm -lpthread"
    int cc_exit = exec(cc_cmd)
    if cc_exit != 0:
        print("error: C compiler failed (exit " + int_to_str(cc_exit) + "): " + cc_cmd, file=stderr)
        exit(cc_exit)
    print("Built: " + output_path, file=stderr)

    # ── run mode: execute the compiled binary ────────────────────────────────
    if do_run:
        # `exec` shells out via system(), so a BARE output name (e.g. `-o hello`
        # or a derived `hello` from `hello.gg`) would be a PATH lookup — and PATH
        # excludes `.`, so the just-built binary in the cwd is "not found". Resolve
        # to an absolute path first (mirrors Rust gg, which execs the full exe
        # path); already-absolute paths pass through unchanged. Bind to a String
        # VarDecl so the cstr->String coercion fires (it only fires at SVarDecl).
        String run_path = path_absolute(output_path)
        int run_exit = exec(run_path)
        exit(run_exit)

# ── check subcommand implementation ──────────────────────────────────────────
# Handles `gg check <input.gg> [--lib-dir=<dir>]`: run the front-end passes
# (parse → load_imports → derive/meta → resolve → typecheck) and report whether
# the program is well-formed, WITHOUT codegen / cc / link. Exit NONZERO on any
# error diagnostic, 0 + "ok" if clean.
#
# ⚠ INTERIM SEMANTICS — pending a FILED self-host-typechecker defect:
# `check` reports exactly what `has_errors(ctx.diagnostics)` surfaces, which is
# the correct PLUMBING. But the self-host typechecker is currently PERMISSIVE —
# it ACCEPTS many ill-typed programs (e.g. `int x = "s"`, `print(undef)`,
# `int y = *x` on a non-Box) because most of Rust's `self.error(...)` check
# sites are unmigrated and emit no diagnostic. So `check` will exit 0 on those
# programs TODAY. That is the TYPECHECKER's filed gap, NOT this CLI work:
#   • TODO.md "gg check PERMISSIVENESS" (bare `return` in `T throws E`, etc.)
#   • TODO.md "explicit-VarDecl path skips initializer inference" (`int y = *x`
#     accepted though `auto y = *x` is rejected)
#   • TODO.md "typechecker — 42 of 47 Rust self.error(...) sites unmigrated"
# Do NOT fix the typechecker here — `check` is wired to surface whatever the
# typechecker reports and improves automatically as those check sites land. A
# `#[ignore]`'d integration test (gg_impl_check_rejects_illtyped) is the live
# breadcrumb that flips green when the typechecker stops accepting bad programs.
void run_check_mode(Vector[String] cmd_args):
    String input_path = ""
    String lib_dir = getenv("GG_LIB_DIR")
    bool lib_dir_explicit = lib_dir != ""
    if lib_dir == "":
        lib_dir = "lib"
    int ai = 2
    while ai < cmd_args.len():
        String arg = cmd_args.get(ai).unwrap()
        if arg.starts_with("--lib-dir="):
            lib_dir = arg.slice(10, arg.len())
            lib_dir_explicit = true
        elif not arg.starts_with("-"):
            input_path = arg
        ai += 1
    if input_path == "":
        print("error: no input file given", file=stderr)
        print("usage: gg check <input.gg> [--lib-dir=<dir>]", file=stderr)
        exit(1)

    # Front-end only: parse → resolve → typecheck (no GIR/LIR/codegen/cc/link).
    String source = read_file(input_path)
    Module m = parse_source(source)
    Dict[String, bool] imported_fns = {}
    Dict[String, String] lib_embedded = build_embedded_lib()
    Dict[String, bool] imported_bare_names = {}
    Dict[String, String] call_redirects = load_imports(&m, input_path, lib_dir, &imported_fns, source.byte_len(), lib_embedded, lib_dir_explicit, &imported_bare_names)
    expand_derives(&m)
    ScopeTable scopes = ScopeTable.new_scope_table()
    scopes.init()
    TypeTable types = TypeTable.new_type_table()
    # embed_file() resolves paths relative to the entry source dir. Bind
    # to a String VarDecl first so the cstr->String coercion fires (it
    # only fires at an SVarDecl, not in argument position).
    String entry_source_dir = path_parent(path_absolute(input_path))
    expand_meta_types(&m, &types, entry_source_dir)
    expand_meta_for_match(&m)
    ResolveContext ctx = resolve_module_with_imports(m, &scopes, &types, imported_bare_names)
    apply_collect_target_rewrites(&m)
    # Rebind aliased imports (`from X import Y as Z`) back to surface names so
    # the IR backend's `map_runtime_name` lowers `Z(...)` calls to the real C
    # symbol of `Y`. Mirrors Rust gg's `rewrite_import_aliases` (after resolve,
    # before lowering — src/semantic/mod.rs:248).
    rename_import_aliases(&m)
    type_check_module(m, &scopes, &types, &ctx)
    if has_errors(ctx.diagnostics):
        report_diagnostics(ctx.diagnostics, source, input_path)
        exit(1)
    print("ok")

void run_ssa(LirModule m):
    int fi = 0
    while fi < m.functions.len():
        construct_ssa(&m.functions.get(fi).unwrap())
        fi += 1
