# SSA construction pass for LIR.
#
# Promotes scalar slots to SSA values using a simplified Braun et al. 2013
# algorithm ("Simple and Efficient Construction of SSA Form").
#
# 1. Identify promotable slots (scalar type, no SlotAddr).
# 2. Walk blocks, tracking current definition per slot.
# 3. SlotStore to promoted slot → record new definition, remove instruction.
# 4. SlotLoad from promoted slot → replace with reaching definition.
# 5. At merge points → insert block parameters (phis), patch terminators.
# 6. Apply value substitutions across all instructions/terminators.

from lir import LirFunction, LirBlock, LirInst, LirTerm, LirSlot, BlockParam, SwitchCase, FieldInit
from lir import lir_is_scalar, lir_fn_next_value
from lir import LT_BOOL, LT_F32, LT_F64, LT_PTR
from std.collections import Vector, Dict

# ── Find promotable slots ───────────────────────────────────

# A slot is promotable if it has scalar type and no SlotAddr references it.
Dict[int, bool] find_promotable_slots(LirFunction f):
    Dict[int, bool] candidates = {}

    # All scalar slots are candidates.
    # CoW for-element BORROW scan: enumerate() preserves the slot index si.
    for (si, slot) in f.slots.enumerate():
        if lir_is_scalar(slot.ty):
            candidates.put(si, true)

    # Remove any slot referenced by SlotAddr.
    # CoW for-element BORROW scans (no LirBlock__clone/LirInst__clone): the
    # loops only read blk.insts and match each inst.
    for blk in f.blocks:
        for inst in blk.insts:
            match inst:
                case ISlotAddr(_, slot):
                    if candidates.contains(slot):
                        candidates.remove(slot)
                else:
                    pass

    return candidates

# ── Compute predecessor blocks ──────────────────────────────

Vector[Vector[int]] compute_predecessors(LirFunction f):
    Vector[Vector[int]] preds = []
    int pi = 0
    while pi < f.blocks.len():
        Vector[int] empty = []
        preds.push(empty)
        pi += 1

    # CoW for-element BORROW scan (no LirBlock__clone): only reads blk.term.
    # enumerate() preserves the block index bi pushed into preds.
    for (bi, blk) in f.blocks.enumerate():
        Vector[int] succs = term_successors(blk.term)
        int si = 0
        while si < succs.len():
            int succ = succs.get(si).unwrap()
            preds.get(succ).unwrap().push(bi)
            si += 1

    return preds

# Compute reverse post-order block visit sequence via DFS from entry.
# SSA construction must process each block AFTER all of its non-loop
# predecessors, otherwise read_variable's single-pred recursion chases
# back through the CFG into un-processed blocks and can't find the store
# that should flow the slot's value — it falls back to a zero-init
# constant and silently corrupts the result. This particularly breaks
# `case Ctor(bind): ...; if bind == K1: ... elif bind == K2: ...`
# shapes where `bind_bb` (where the destructure ISlotStore lives) gets
# a higher block id than `match_bb` (the arm body where `if bind == ...`
# reads), because lower_match_stmt creates arm_body_bb before calling
# lower_ctor_pattern which in turn creates bind_bb.
Vector[int] compute_rpo(LirFunction f):
    Vector[int] rpo = []
    if f.blocks.len() == 0:
        return rpo
    Dict[int, bool] visited = {}
    # Iterative post-order DFS. Stack holds (block, child_idx) pairs
    # encoded as two parallel vectors so we can update the child_idx
    # in place without struct rebuilds.
    Vector[int] stack_bb = []
    Vector[int] stack_ci = []
    stack_bb.push(0)
    stack_ci.push(0)
    visited.put(0, true)
    while stack_bb.len() > 0:
        int top = stack_bb.len() - 1
        int bb = stack_bb.get(top).unwrap()
        int ci = stack_ci.get(top).unwrap()
        LirBlock blk = f.blocks.get(bb).unwrap()
        Vector[int] succs = term_successors(blk.term)
        bool advanced = false
        while ci < succs.len():
            int s = succs.get(ci).unwrap()
            ci += 1
            if not visited.contains(s):
                visited.put(s, true)
                stack_ci.set(top, ci)
                stack_bb.push(s)
                stack_ci.push(0)
                advanced = true
                break
        if not advanced:
            rpo.push(bb)
            stack_bb.pop()
            stack_ci.pop()
    # Reverse to get RPO (DFS produces post-order; reversed is RPO).
    Vector[int] result = []
    int ri = rpo.len() - 1
    while ri >= 0:
        result.push(rpo.get(ri).unwrap())
        ri -= 1
    # If any blocks are unreachable from entry, append them at the end
    # in their natural id order so they still get processed (unreachable
    # blocks can be safely zero-init'd).
    int bi2 = 0
    while bi2 < f.blocks.len():
        if not visited.contains(bi2):
            result.push(bi2)
        bi2 += 1
    return result

Vector[int] term_successors(LirTerm term):
    Vector[int] result = []
    match term:
        case TRet(_):
            pass
        case TRetVoid():
            pass
        case TUnreachable():
            pass
        case TJump(target, _):
            result.push(target)
        case TBranch(_, then_bb, _, else_bb, _):
            result.push(then_bb)
            result.push(else_bb)
        case TSwitch(_, cases, default_bb, _):
            int ci = 0
            while ci < cases.len():
                SwitchCase sc = cases.get(ci).unwrap()
                result.push(sc.target)
                ci += 1
            result.push(default_bb)
    return result

# All ValueIds USED (read) by a terminator. The block-arg/phi liveness lives
# HERE — `TJump`/`TBranch`/`TSwitch` args are the values flowing into the
# successor's block params (the "arg live at end of pred" semantics). Ported
# ARM-FOR-ARM against the Rust gold reference `Term::uses()`
# (`src/lir/mod.rs:~1238`); the `LirTerm` operand positions come from the
# `lir.gg` decl (POSITIONAL). A missing arg here = an under-live range = a
# slot-aliasing clobber the emit-diff CANNOT catch (only the RUN gate would),
# so the arm set is cross-checked 1:1 by `term_uses_arms_count` in
# tests/lints.rs. MIND: don't forget the branch/switch ARGS.
Vector[int] term_uses(LirTerm term):
    Vector[int] result = []
    match term:
        case TRet(value):
            result.push(value)
        case TRetVoid():
            pass
        case TUnreachable():
            pass
        case TJump(_, args):
            int ji = 0
            while ji < args.len():
                result.push(args.get(ji).unwrap())
                ji += 1
        case TBranch(cond, _, then_args, _, else_args):
            result.push(cond)
            int ti = 0
            while ti < then_args.len():
                result.push(then_args.get(ti).unwrap())
                ti += 1
            int ei = 0
            while ei < else_args.len():
                result.push(else_args.get(ei).unwrap())
                ei += 1
        case TSwitch(value, cases, _, default_args):
            result.push(value)
            int ci = 0
            while ci < cases.len():
                SwitchCase sc = cases.get(ci).unwrap()
                int ai = 0
                while ai < sc.args.len():
                    result.push(sc.args.get(ai).unwrap())
                    ai += 1
                ci += 1
            int di = 0
            while di < default_args.len():
                result.push(default_args.get(di).unwrap())
                di += 1
    return result

# ── SSA Builder ─────────────────────────────────────────────

# Key-encode (block_id, slot_id) as a single int for Dict lookup.
int ssa_key(int bb, int slot): bb * 100000 + slot

# Process one block: eliminate promoted SlotStore/SlotLoad.
#
# Re-fetches the block at the end before writing `new_insts` back —
# `read_variable` may call `add_block_param(slot, bb, ...)` for THIS
# bb during the ISlotLoad iteration (multi-pred case), which appends
# a phi to `f.blocks[bb].params` (in place, via chained borrow). Writing back
# the start-of-function snapshot would clobber those param updates;
# the re-fetch picks up the latest state. (§6.4 retirement of
# pending_phis — the old code dodged this by deferring all phi-param
# application to a Phase-4 reconstruction after every process_block
# call had completed.)
void process_block(int bb, LirFunction &f, Dict[int, bool] &promotable, Dict[int, int] &current_def, Dict[int, int] &block_params, Dict[int, int] &incomplete_phis, Dict[int, int] &value_subst, Vector[Vector[int]] &preds):
    LirBlock blk = f.blocks.get(bb).unwrap()
    Vector[LirInst] new_insts = []

    int ii = 0
    while ii < blk.insts.len():
        LirInst inst = blk.insts.get(ii).unwrap()
        match inst:
            case ISlotStore(slot, value, _):
                if promotable.contains(slot):
                    int resolved = resolve_value(value, value_subst)
                    current_def.put(ssa_key(bb, slot), resolved)
                else:
                    new_insts.push(inst)
            case ISlotLoad(dst, slot, _):
                if promotable.contains(slot):
                    int reaching = read_variable(slot, bb, &f, &promotable, &current_def, &block_params, &incomplete_phis, &value_subst, &preds)
                    current_def.put(ssa_key(bb, slot), reaching)
                    if reaching != dst:
                        value_subst.put(dst, reaching)
                else:
                    new_insts.push(inst)
            else:
                new_insts.push(inst)
        ii += 1

    # Re-fetch to pick up any phi-param updates add_block_param
    # applied to f.blocks[bb] during the iteration above.
    LirBlock final_blk = f.blocks.get(bb).unwrap()
    final_blk.insts = new_insts
    f.blocks.set(bb, final_blk)

# Chase substitution chain to find canonical value.
int resolve_value(int val, Dict[int, int] value_subst):
    int current = val
    int iters = 0
    while value_subst.contains(current) and iters < 100:
        current = value_subst.get(current).unwrap()
        iters += 1
    return current

# Read the reaching definition of a slot at block entry.
int read_variable(int slot, int bb, LirFunction &f, Dict[int, bool] &promotable, Dict[int, int] &current_def, Dict[int, int] &block_params, Dict[int, int] &incomplete_phis, Dict[int, int] &value_subst, Vector[Vector[int]] &preds):
    int key = ssa_key(bb, slot)
    if current_def.contains(key):
        return current_def.get(key).unwrap()

    Vector[int] bb_preds = preds.get(bb).unwrap()

    if bb_preds.len() == 0:
        # Entry block, no definition — create zero constant and prepend it in
        # place. Mutate-through-borrow (the proven zero-clone shape — see
        # add_block_param below and `lir_push_inst` in lir.gg): `f.blocks.get(bb)`
        # borrows the live block (Ptr), `.insts.insert(0, ...)` shifts existing
        # insts via a shallow memmove and moves the fresh const temp in at index 0.
        # No whole-block value-local copy, no per-inst deep clone, no set-back —
        # replaces the old [const]++existing rebuild (same resulting order).
        int val = lir_fn_next_value(&f)
        LirSlot s = f.slots.get(slot).unwrap()
        if s.ty == LT_BOOL:
            f.blocks.get(bb).unwrap().insts.insert(0, IBoolConst(val, false))
        elif s.ty == LT_F32 or s.ty == LT_F64:
            f.blocks.get(bb).unwrap().insts.insert(0, IFConst(val, s.ty, 0))
        elif s.ty == LT_PTR:
            f.blocks.get(bb).unwrap().insts.insert(0, INullPtr(val))
        else:
            f.blocks.get(bb).unwrap().insts.insert(0, IIConst(val, s.ty, 0))
        current_def.put(key, val)
        return val
    elif bb_preds.len() == 1:
        # Single predecessor — use its definition
        int pred = bb_preds.get(0).unwrap()
        int val = read_variable(slot, pred, &f, &promotable, &current_def, &block_params, &incomplete_phis, &value_subst, &preds)
        current_def.put(key, val)
        return val
    else:
        # Multiple predecessors — need block parameter (phi)
        return add_block_param(slot, bb, &f, &block_params, &current_def, &incomplete_phis)

# Add a block parameter for a slot at a merge point.
#
# Mutate-through-borrow: push the new phi straight into the live block's
# params via the chained `f.blocks.get(bb).unwrap().params.push(...)` form
# — the proven zero-clone shape (see `lir_push_inst` / `lir_set_term` in
# lir.gg, where the same chained `.get().unwrap().FIELD.push/=` mutates the
# live block in place). `.get()` borrows the block (Option[Ref]),
# `.unwrap()` yields the ref, and `.push` mutates through it: no LirBlock
# copy, no set-back. `process_block` re-fetches `f.blocks[bb]` after its
# iteration (see its docstring) so it observes this push on the live block.
int add_block_param(int slot, int bb, LirFunction &f, Dict[int, int] &block_params, Dict[int, int] &current_def, Dict[int, int] &incomplete_phis):
    int key = ssa_key(bb, slot)
    if block_params.contains(key):
        return block_params.get(key).unwrap()

    LirSlot s = f.slots.get(slot).unwrap()
    int param_val = lir_fn_next_value(&f)
    block_params.put(key, param_val)
    current_def.put(key, param_val)
    incomplete_phis.put(key, param_val)

    f.blocks.get(bb).unwrap().params.push(BlockParam(param_val, s.ty))

    return param_val

# ── Value substitution ──────────────────────────────────────

void apply_value_substitutions(LirFunction &f, Dict[int, int] value_subst):
    if value_subst.len() == 0:
        return

    int bi = 0
    while bi < f.blocks.len():
        LirBlock blk = f.blocks.get(bi).unwrap()
        # Substitute in instructions
        Vector[LirInst] new_insts = []
        int ii = 0
        while ii < blk.insts.len():
            LirInst inst = substitute_inst(blk.insts.get(ii).unwrap(), value_subst)
            new_insts.push(inst)
            ii += 1
        blk.insts = new_insts
        # Substitute in terminator
        blk.term = substitute_term(blk.term, value_subst)
        f.blocks.set(bi, blk)
        bi += 1

int sub_val(int v, Dict[int, int] subst):
    if subst.contains(v):
        return subst.get(v).unwrap()
    return v

Vector[int] sub_vals(Vector[int] vals, Dict[int, int] subst):
    Vector[int] result = []
    int i = 0
    while i < vals.len():
        result.push(sub_val(vals.get(i).unwrap(), subst))
        i += 1
    return result

LirInst substitute_inst(LirInst inst, Dict[int, int] subst):
    match inst:
        case ISlotStore(slot, value, is_move):
            return ISlotStore(slot, sub_val(value, subst), is_move)
        case IClosurePack(slot, env_ptr, call_func, adapt):
            return IClosurePack(slot, sub_val(env_ptr, subst), call_func, adapt)
        case IAdd(dst, ty, lhs, rhs, ovf):
            return IAdd(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst), ovf)
        case ISub(dst, ty, lhs, rhs, ovf):
            return ISub(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst), ovf)
        case IMul(dst, ty, lhs, rhs, ovf):
            return IMul(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst), ovf)
        case IDiv(dst, ty, lhs, rhs):
            return IDiv(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IRem(dst, ty, lhs, rhs):
            return IRem(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IMod(dst, ty, lhs, rhs):
            return IMod(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IFaultCheck(dst, op, ty, lhs, rhs):
            return IFaultCheck(dst, op, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case INeg(dst, ty, op):
            return INeg(dst, ty, sub_val(op, subst))
        case IBitAnd(dst, ty, lhs, rhs):
            return IBitAnd(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IBitOr(dst, ty, lhs, rhs):
            return IBitOr(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IBitXor(dst, ty, lhs, rhs):
            return IBitXor(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IBitNot(dst, ty, op):
            return IBitNot(dst, ty, sub_val(op, subst))
        case IShl(dst, ty, lhs, rhs):
            return IShl(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case IShr(dst, ty, lhs, rhs):
            return IShr(dst, ty, sub_val(lhs, subst), sub_val(rhs, subst))
        case ICmp(dst, op, lhs, rhs):
            return ICmp(dst, op, sub_val(lhs, subst), sub_val(rhs, subst))
        case INot(dst, op):
            return INot(dst, sub_val(op, subst))
        case IIntCast(dst, val, to):
            return IIntCast(dst, sub_val(val, subst), to)
        case IFloatCast(dst, val, to):
            return IFloatCast(dst, sub_val(val, subst), to)
        case IIntToFloat(dst, val, to):
            return IIntToFloat(dst, sub_val(val, subst), to)
        case IFloatToInt(dst, val, to):
            return IFloatToInt(dst, sub_val(val, subst), to)
        case IPtrCast(dst, val):
            return IPtrCast(dst, sub_val(val, subst))
        case IBitcast(dst, val, to):
            return IBitcast(dst, sub_val(val, subst), to)
        case ILoad(dst, ptr, ty):
            return ILoad(dst, sub_val(ptr, subst), ty)
        case IStore(ptr, val):
            return IStore(sub_val(ptr, subst), sub_val(val, subst))
        case IBoxAlloc(dst, inner_ty, val):
            return IBoxAlloc(dst, inner_ty, sub_val(val, subst))
        case IAddressOf(dst, val, ty):
            return IAddressOf(dst, sub_val(val, subst), ty)
        case IStructInit(target, sid, fields):
            Vector[FieldInit] sub_fields = []
            int fii = 0
            while fii < fields.len():
                FieldInit fi = fields.get(fii).unwrap()
                sub_fields.push(FieldInit(fi.index, sub_val(fi.value, subst)))
                fii += 1
            return IStructInit(sub_val(target, subst), sid, sub_fields)
        case IEnumInit(target, sid, tag, fields):
            Vector[FieldInit] sub_fields = []
            int fii = 0
            while fii < fields.len():
                FieldInit fi = fields.get(fii).unwrap()
                sub_fields.push(FieldInit(fi.index, sub_val(fi.value, subst)))
                fii += 1
            return IEnumInit(sub_val(target, subst), sid, tag, sub_fields)
        case IFieldPtr(dst, base, sid, field):
            return IFieldPtr(dst, sub_val(base, subst), sid, field)
        case IElemPtr(dst, base, idx, esz):
            return IElemPtr(dst, sub_val(base, subst), sub_val(idx, subst), esz)
        case IMemset(ptr, byte, sz):
            return IMemset(sub_val(ptr, subst), sub_val(byte, subst), sub_val(sz, subst))
        case IMemcpy(dp, sp, sz):
            return IMemcpy(sub_val(dp, subst), sub_val(sp, subst), sub_val(sz, subst))
        case ICall(dst, func, args):
            return ICall(dst, func, sub_vals(args, subst))
        case ICallExtern(dst, name, args, orig, abis):
            return ICallExtern(dst, name, sub_vals(args, subst), orig, abis)
        case ICallPtr(dst, callee, args):
            return ICallPtr(dst, sub_val(callee, subst), sub_vals(args, subst))
        case ICallClosure(dst, kind, closure, args, abis, ret_ty):
            return ICallClosure(dst, kind, sub_val(closure, subst), sub_vals(args, subst), abis, ret_ty)
        case IDropGuardOpen(kind, value):
            return IDropGuardOpen(kind, sub_val(value, subst))
        # IDropGuardClose has no values to substitute — falls through to `else: return inst`
        case IBoundsCheck(idx, len):
            return IBoundsCheck(sub_val(idx, subst), sub_val(len, subst))
        case IDivCheck(divisor):
            return IDivCheck(sub_val(divisor, subst))
        case IPrintf(fmt, args):
            return IPrintf(fmt, sub_vals(args, subst))
        case IFprintf(fd, fmt, args):
            return IFprintf(sub_val(fd, subst), fmt, sub_vals(args, subst))
        else:
            return inst
    return inst

LirTerm substitute_term(LirTerm term, Dict[int, int] subst):
    match term:
        case TRet(v):
            return TRet(sub_val(v, subst))
        case TJump(target, args):
            return TJump(target, sub_vals(args, subst))
        case TBranch(cond, then_bb, then_args, else_bb, else_args):
            return TBranch(sub_val(cond, subst), then_bb, sub_vals(then_args, subst), else_bb, sub_vals(else_args, subst))
        case TSwitch(val, cases, default_bb, default_args):
            Vector[SwitchCase] new_cases = []
            int ci = 0
            while ci < cases.len():
                SwitchCase sc = cases.get(ci).unwrap()
                new_cases.push(SwitchCase(sc.value, sc.target, sub_vals(sc.args, subst)))
                ci += 1
            return TSwitch(sub_val(val, subst), new_cases, default_bb, sub_vals(default_args, subst))
        else:
            return term
    return term

# ── Terminator patching ─────────────────────────────────────

void patch_terminators(LirFunction &f, Dict[int, bool] &promotable, Dict[int, int] &block_params, Dict[int, int] &incomplete_phis, Dict[int, int] &current_def, Dict[int, int] &value_subst, Vector[Vector[int]] &preds):
    # Iteratively resolve reaching definitions for each phi's predecessors.
    # When a predecessor's `current_def` is missing, the slot's SSA value at
    # that predecessor must be the reaching definition from its own ancestors
    # — chase the CFG chain via `read_variable` rather than zero-init, which
    # was wrong for any slot whose def lived in an ancestor block.
    # New phis may be introduced as a side effect at multi-pred ancestors;
    # those land in `incomplete_phis` and are picked up by the fixed-point
    # iteration below.
    bool changed = true
    while changed:
        changed = false
        int prev_phi_count = incomplete_phis.len()
        Vector[int] phi_keys = incomplete_phis.keys()
        int ki = 0
        while ki < phi_keys.len():
            int key = phi_keys.get(ki).unwrap()
            int target_bb = key / 100000
            int slot = key - target_bb * 100000
            Vector[int] bb_preds = preds.get(target_bb).unwrap()
            int pi = 0
            while pi < bb_preds.len():
                int pred_bb = bb_preds.get(pi).unwrap()
                int pred_key = ssa_key(pred_bb, slot)
                if not current_def.contains(pred_key):
                    # Chase the reaching definition through pred_bb's
                    # ancestors. read_variable handles single-pred chains,
                    # multi-pred (adds a new phi), and entry (zero-init).
                    read_variable(slot, pred_bb, &f, &promotable, &current_def, &block_params, &incomplete_phis, &value_subst, &preds)
                    changed = true
                pi += 1
            ki += 1
        # If read_variable added new phis beyond our snapshot, loop again so
        # their predecessors get resolved the same way.
        if incomplete_phis.len() > prev_phi_count:
            changed = true

    # Build target_bb → [slots in param order] directly from
    # incomplete_phis. The Dict's keys() iteration is insertion-order
    # (Gorget Dict spec), which matches the order add_block_param
    # appended each phi onto blk.params — so the terminator's per-target
    # args list lines up by position with the destination block's
    # params list.
    Dict[int, Vector[int]] target_slots = {}
    Vector[int] all_phi_keys = incomplete_phis.keys()
    int akpi = 0
    while akpi < all_phi_keys.len():
        int key = all_phi_keys.get(akpi).unwrap()
        int target_bb = key / 100000
        int slot = key - target_bb * 100000
        if not target_slots.contains(target_bb):
            Vector[int] new_slots = [slot]
            target_slots.put(target_bb, !new_slots)
        else:
            target_slots.get(target_bb).unwrap().push(slot)
        akpi += 1

    # For each predecessor→target edge, collect args in param order.
    # Dict.keys() is now insertion-order, so iteration matches registration order.
    Vector[int] target_slots_keys = target_slots.keys()
    int ti = 0
    while ti < target_slots_keys.len():
        int target_bb = target_slots_keys.get(ti).unwrap()
        Vector[int] slots = target_slots.get(target_bb).unwrap()
        Vector[int] bb_preds = preds.get(target_bb).unwrap()
        int pi = 0
        while pi < bb_preds.len():
            int pred_bb = bb_preds.get(pi).unwrap()
            Vector[int] args = []
            int si = 0
            while si < slots.len():
                int slot = slots.get(si).unwrap()
                int pred_key = ssa_key(pred_bb, slot)
                if current_def.contains(pred_key):
                    args.push(current_def.get(pred_key).unwrap())
                else:
                    args.push(0)
                si += 1
            # Patch the terminator in place on the live block (mirrors
            # lir_set_term: chained .get().unwrap().term = ... mutates through
            # the borrow — no LirBlock copy, no set-back).
            f.blocks.get(pred_bb).unwrap().term = add_args_to_term(f.blocks.get(pred_bb).unwrap().term, target_bb, args)
            pi += 1
        ti += 1

LirTerm add_args_to_term(LirTerm term, int target, Vector[int] args):
    match term:
        case TJump(t, existing):
            if t == target:
                int ai = 0
                while ai < args.len():
                    existing.push(args.get(ai).unwrap())
                    ai += 1
                return TJump(t, existing)
            return TJump(t, existing)
        case TBranch(cond, then_bb, then_args, else_bb, else_args):
            if then_bb == target:
                int ai = 0
                while ai < args.len():
                    then_args.push(args.get(ai).unwrap())
                    ai += 1
            if else_bb == target:
                int ai = 0
                while ai < args.len():
                    else_args.push(args.get(ai).unwrap())
                    ai += 1
            return TBranch(cond, then_bb, then_args, else_bb, else_args)
        case TSwitch(val, cases, default_bb, default_args):
            Vector[SwitchCase] new_cases = []
            int ci = 0
            while ci < cases.len():
                SwitchCase sc = cases.get(ci).unwrap()
                if sc.target == target:
                    int ai = 0
                    while ai < args.len():
                        sc.args.push(args.get(ai).unwrap())
                        ai += 1
                new_cases.push(sc)
                ci += 1
            if default_bb == target:
                int ai = 0
                while ai < args.len():
                    default_args.push(args.get(ai).unwrap())
                    ai += 1
            return TSwitch(val, new_cases, default_bb, default_args)
        else:
            return term
    return term

# ── Main entry point ────────────────────────────────────────

void construct_ssa(LirFunction &f):
    Dict[int, bool] promotable = find_promotable_slots(f)
    if promotable.len() == 0:
        return

    Vector[Vector[int]] preds = compute_predecessors(f)

    Dict[int, int] current_def = {}
    Dict[int, int] block_params = {}
    Dict[int, int] incomplete_phis = {}
    Dict[int, int] value_subst = {}

    # Phase 1: Process blocks in RPO (reverse post-order) so predecessors
    # are visited before successors — this is critical for the
    # single-predecessor chain in read_variable to find reaching defs. In
    # the natural block-id order, `arm_body_bb` of a match arm gets a
    # lower id than the `bind_bb` where the destructure ISlotStore lives
    # (lower_match_stmt allocates arm_body_bb before calling
    # lower_ctor_pattern which allocates bind_bb), so processing in id
    # order chases back through the CFG past an unprocessed bind_bb and
    # zero-inits the destructured binding. Under RPO, bind_bb runs first,
    # records the store in current_def, and arm_body_bb's subsequent read
    # finds it correctly.
    Vector[int] rpo = compute_rpo(f)
    int rpi = 0
    while rpi < rpo.len():
        int bi_rpo = rpo.get(rpi).unwrap()
        process_block(bi_rpo, &f, &promotable, &current_def, &block_params, &incomplete_phis, &value_subst, &preds)
        rpi += 1

    # Phase 2: Apply value substitutions
    apply_value_substitutions(&f, value_subst)

    # Phase 3: Patch terminators with block arguments for phis. Phi
    # params themselves are appended to each merge block's `params`
    # in-place by `add_block_param`'s chained `.params.push` (Phase C step
    # §6.4 retirement of the flat-pending_phis workaround) — no
    # separate phase-4 block rebuild needed.
    patch_terminators(&f, &promotable, &block_params, &incomplete_phis, &current_def, &value_subst, &preds)
