# GIR text formatter — produces output matching `gg build --emit-gir`.

from std.collections import Vector
from std.conv import int_to_str, float_to_str
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction
from gir import Terminator, Operand, GirType, GirExtern
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE
from gir import U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT

# ── Type name formatting ─────────────────────────────────

String format_type_id(int tid, GirModule &gmod):
    if tid == BOOL_TYPE:
        return "bool"
    if tid == I8_TYPE:
        return "i8"
    if tid == I16_TYPE:
        return "i16"
    if tid == I32_TYPE:
        return "i32"
    if tid == I64_TYPE:
        return "i64"
    if tid == U8_TYPE:
        return "u8"
    if tid == U16_TYPE:
        return "u16"
    if tid == U32_TYPE:
        return "u32"
    if tid == U64_TYPE:
        return "u64"
    if tid == F32_TYPE:
        return "f32"
    if tid == F64_TYPE:
        return "f64"
    if tid == UNIT_TYPE:
        return "unit"
    if tid >= 0 and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(inner):
                return "*" + format_type_id(inner, &gmod)
            case GtMutPtr(inner):
                return "*mut " + format_type_id(inner, &gmod)
            case GtFnPtr(fn_params, fn_ret):
                String fn_str = "fn("
                int fpi = 0
                for fp_tid in fn_params:
                    if fpi > 0:
                        fn_str = fn_str + ", "
                    fn_str = fn_str + format_type_id(fp_tid, &gmod)
                    fpi += 1
                fn_str = fn_str + ") -> " + format_type_id(fn_ret, &gmod)
                return fn_str
            else:
                pass
    return "?type" + int_to_str(tid)

# ── Operand formatting ───────────────────────────────────

String format_operand(Operand op, GirModule &gmod):
    match op:
        case OpCopy(lid):
            return "copy _" + int_to_str(lid)
        case OpMove(lid):
            return "move _" + int_to_str(lid)
        case OpClone(lid):
            return "clone _" + int_to_str(lid)
        case OpBorrow(lid):
            return "borrow _" + int_to_str(lid)
        case OpConstBool(b):
            return if b: "const true" else: "const false"
        case OpConstI32(v):
            return "const " + int_to_str(v) + "i32"
        case OpConstI64(v):
            return "const " + int_to_str(v) + "i64"
        case OpConstF64(v):
            return "const " + float_to_str(v) + "f64"
        case OpConstStr(s):
            return "const " + "\"" + s + "\""
        case OpConstUnit():
            return "const unit"
        case OpConstNull():
            return "const null"
        case OpSizeOf(tid):
            return "const sizeof(" + format_type_id(tid, &gmod) + ")"

# ── Binary op name ───────────────────────────────────────

String binop_name(int op):
    if op == OP_ADD:
        return "add"
    if op == OP_SUB:
        return "sub"
    if op == OP_MUL:
        return "mul"
    if op == OP_DIV:
        return "div"
    if op == OP_REM:
        return "rem"
    if op == OP_MOD:
        return "mod"
    if op == OP_ADD_WRAP:
        return "add_wrap"
    if op == OP_SUB_WRAP:
        return "sub_wrap"
    if op == OP_MUL_WRAP:
        return "mul_wrap"
    if op == OP_BITAND:
        return "bitand"
    if op == OP_BITOR:
        return "bitor"
    if op == OP_BITXOR:
        return "bitxor"
    if op == OP_SHL:
        return "shl"
    if op == OP_SHR:
        return "shr"
    return "?op" + int_to_str(op)

String unop_name(int op):
    if op == UNOP_NEG:
        return "neg"
    if op == UNOP_NOT:
        return "not"
    if op == UNOP_BITNOT:
        return "bitnot"
    return "?unop" + int_to_str(op)

String cmpop_name(int op):
    if op == CMP_EQ:
        return "cmp_eq"
    if op == CMP_NE:
        return "cmp_ne"
    if op == CMP_LT:
        return "cmp_lt"
    if op == CMP_LE:
        return "cmp_le"
    if op == CMP_GT:
        return "cmp_gt"
    if op == CMP_GE:
        return "cmp_ge"
    return "?cmp" + int_to_str(op)

# ── Instruction formatting ───────────────────────────────

String format_args(Vector[Operand] args, GirModule &gmod):
    # `for (i, arg) in args.enumerate():` is the idiomatic shape but
    # hits a snag — tuple-destructuring in a for-loop iterator pattern
    # produces empty output when wrapped in a function. See TODO
    # "for-loop tuple destructure over EnumerateIter silently empty".
    # Manual index counter as the workaround until that's fixed.
    String result = ""
    int i = 0
    for arg in args:
        if i > 0:
            result = result + ", "
        result = result + format_operand(arg, &gmod)
        i = i + 1
    return result

String format_instruction(Instruction inst, GirModule &gmod):
    match inst:
        case GIAssign(dst, val):
            return "        _" + int_to_str(dst) + " = " + format_operand(val, &gmod)
        case GIBinOp(dst, op, tid, lhs, rhs):
            return "        _" + int_to_str(dst) + " = " + binop_name(op) + " " + format_type_id(tid, &gmod) + " " + format_operand(lhs, &gmod) + ", " + format_operand(rhs, &gmod)
        case GIUnOp(dst, op, tid, operand):
            return "        _" + int_to_str(dst) + " = " + unop_name(op) + " " + format_type_id(tid, &gmod) + " " + format_operand(operand, &gmod)
        case GICmp(dst, op, tid, lhs, rhs):
            return "        _" + int_to_str(dst) + " = " + cmpop_name(op) + " " + format_type_id(tid, &gmod) + " " + format_operand(lhs, &gmod) + ", " + format_operand(rhs, &gmod)
        case GICall(dst, name, args):
            String args_str = format_args(args, &gmod)
            if dst >= 0:
                return "        _" + int_to_str(dst) + " = call @" + name + "(" + args_str + ")"
            return "        call @" + name + "(" + args_str + ")"
        case GICallExtern(dst, name, args):
            String args_str = format_args(args, &gmod)
            if dst >= 0:
                return "        _" + int_to_str(dst) + " = call_extern @" + name + "(" + args_str + ")"
            return "        call_extern @" + name + "(" + args_str + ")"
        case GIDrop(lid):
            return "        drop _" + int_to_str(lid)
        case GIDropIfAlive(lid):
            return "        drop_if_alive _" + int_to_str(lid)
        case GIMoveZero(lid):
            return "        move_zero _" + int_to_str(lid)
        case GIDeref(dst, src, _):
            return "        _" + int_to_str(dst) + " = deref _" + int_to_str(src)
        case GINop():
            return "        nop"

# ── Terminator formatting ────────────────────────────────

String format_terminator(Terminator term, GirModule &gmod):
    match term:
        case GTReturn(val):
            return "        return " + format_operand(val, &gmod)
        case GTJump(bid):
            return "        jump bb" + int_to_str(bid)
        case GTBranch(cond, then_bb, else_bb):
            return "        br " + format_operand(cond, &gmod) + ", bb" + int_to_str(then_bb) + ", bb" + int_to_str(else_bb)

# ── Function formatting ──────────────────────────────────

String format_function(GirFunction func, GirModule &gmod):
    # Signature: fn @name(param_types) -> return_type {
    String params_str = ""
    int pi = 0
    for pt in func.param_types:
        if pi > 0:
            params_str = params_str + ", "
        params_str = params_str + format_type_id(pt, &gmod)
        pi += 1
    String sig = "fn @" + func.name + "(" + params_str + ") -> " + format_type_id(func.return_type, &gmod) + " {"

    # Locals — index drives the `_N` label so we keep a manual counter
    # alongside the for-loop. Once the EnumerateIter tuple-destructure
    # snag is closed (see TODO), this collapses to a single line.
    String locals_str = "    locals:"
    int li = 0
    for loc in func.locals:
        String line = "        _" + int_to_str(li) + ": " + format_type_id(loc.type_id, &gmod)
        match loc.name_hint:
            case Some(h):
                line = line + "         ; " + h
            else:
                pass
        locals_str = locals_str + "\n" + line
        li += 1

    # Blocks
    String blocks_str = ""
    int bi = 0
    for bb in func.blocks:
        blocks_str = blocks_str + "\n    bb" + int_to_str(bi) + ":"
        for inst in bb.insts:
            blocks_str = blocks_str + "\n" + format_instruction(inst, &gmod)
        match bb.term:
            case GTNone():
                pass
            else:
                blocks_str = blocks_str + "\n" + format_terminator(bb.term, &gmod)
        bi += 1

    return sig + "\n" + locals_str + "\n" + blocks_str + "\n}"

# ── Module formatting ────────────────────────────────────

String format_module(GirModule &gmod):
    String result = ""
    # Extern declarations
    for ext in gmod.externs:
        String variadic = if ext.is_variadic: "..." else: ""
        result = result + "extern fn @" + ext.name + "(" + variadic + ") -> " + format_type_id(ext.return_type, &gmod) + "\n"
    if gmod.externs.len() > 0:
        result = result + "\n"
    # Functions — same-file always kept; imported only if registered
    # in `fn_sigs` (i.e., transitively called).
    int fi = 0
    for func in gmod.functions:
        bool is_imported = gmod.imported_fns.contains(func.name)
        bool keep = not is_imported or gmod.fn_sigs.contains(func.name)
        if keep:
            if fi > 0:
                result = result + "\n"
            result = result + format_function(func, &gmod) + "\n"
        fi += 1
    return result
