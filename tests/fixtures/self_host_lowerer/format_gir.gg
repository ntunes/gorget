# GIR text formatter — produces output matching `gg build --emit-gir`.

from std.collections import Vector
from std.conv import float_to_str
from gir import GirModule, GirFunction, GirLocal, BasicBlock, Instruction
from gir import Terminator, Operand, GirType, GirExtern
from gir import BOOL_TYPE, I8_TYPE, I16_TYPE, I32_TYPE, I64_TYPE
from gir import U8_TYPE, U16_TYPE, U32_TYPE, U64_TYPE, F32_TYPE, F64_TYPE, UNIT_TYPE
from gir import OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_REM, OP_MOD
from gir import OP_ADD_WRAP, OP_SUB_WRAP, OP_MUL_WRAP
from gir import OP_BITAND, OP_BITOR, OP_BITXOR, OP_SHL, OP_SHR
from gir import CMP_EQ, CMP_NE, CMP_LT, CMP_LE, CMP_GT, CMP_GE
from gir import UNOP_NEG, UNOP_NOT, UNOP_BITNOT

# ── Type name formatting ─────────────────────────────────

String format_type_id(int tid, GirModule gmod):
    match tid:
        case BOOL_TYPE:
            return "bool"
        case I8_TYPE:
            return "i8"
        case I16_TYPE:
            return "i16"
        case I32_TYPE:
            return "i32"
        case I64_TYPE:
            return "i64"
        case U8_TYPE:
            return "u8"
        case U16_TYPE:
            return "u16"
        case U32_TYPE:
            return "u32"
        case U64_TYPE:
            return "u64"
        case F32_TYPE:
            return "f32"
        case F64_TYPE:
            return "f64"
        case UNIT_TYPE:
            return "unit"
        else:
            pass
    if tid >= 0 and tid < gmod.type_table.len():
        match gmod.type_table.get(tid).unwrap():
            case GtNamed(name):
                return name
            case GtPtr(inner):
                return f"*{format_type_id(inner, &gmod)}"
            case GtMutPtr(inner):
                return f"*mut {format_type_id(inner, &gmod)}"
            case GtFnPtr(fn_params, fn_ret):
                String fn_str = "fn("
                for (i, fp_tid) in fn_params.enumerate():
                    if i > 0:
                        fn_str = f"{fn_str}, "
                    fn_str = f"{fn_str}{format_type_id(fp_tid, &gmod)}"
                return f"{fn_str}) -> {format_type_id(fn_ret, &gmod)}"
            else:
                pass
    return f"?type{tid}"

# ── Operand formatting ───────────────────────────────────

String format_operand(Operand op, GirModule gmod):
    match op:
        case OpCopy(lid):
            return f"copy _{lid}"
        case OpMove(lid):
            return f"move _{lid}"
        case OpClone(lid):
            return f"clone _{lid}"
        case OpBorrow(lid):
            return f"borrow _{lid}"
        case OpConstBool(b):
            return if b: "const true" else: "const false"
        case OpConstI32(v):
            return f"const {v}i32"
        case OpConstI64(v):
            return f"const {v}i64"
        case OpConstF64(v):
            return f"const {float_to_str(v)}f64"
        case OpConstStr(s):
            return f"const \"{s}\""
        case OpConstUnit():
            return "const unit"
        case OpConstNull():
            return "const null"
        case OpSizeOf(tid):
            return f"const sizeof({format_type_id(tid, &gmod)})"

# ── Binary op name ───────────────────────────────────────

String binop_name(int op):
    match op:
        case OP_ADD:
            return "add"
        case OP_SUB:
            return "sub"
        case OP_MUL:
            return "mul"
        case OP_DIV:
            return "div"
        case OP_REM:
            return "rem"
        case OP_MOD:
            return "mod"
        case OP_ADD_WRAP:
            return "add_wrap"
        case OP_SUB_WRAP:
            return "sub_wrap"
        case OP_MUL_WRAP:
            return "mul_wrap"
        case OP_BITAND:
            return "bitand"
        case OP_BITOR:
            return "bitor"
        case OP_BITXOR:
            return "bitxor"
        case OP_SHL:
            return "shl"
        case OP_SHR:
            return "shr"
        else:
            return f"?op{op}"

String unop_name(int op):
    match op:
        case UNOP_NEG:
            return "neg"
        case UNOP_NOT:
            return "not"
        case UNOP_BITNOT:
            return "bitnot"
        else:
            return f"?unop{op}"

String cmpop_name(int op):
    match op:
        case CMP_EQ:
            return "cmp_eq"
        case CMP_NE:
            return "cmp_ne"
        case CMP_LT:
            return "cmp_lt"
        case CMP_LE:
            return "cmp_le"
        case CMP_GT:
            return "cmp_gt"
        case CMP_GE:
            return "cmp_ge"
        else:
            return f"?cmp{op}"

# ── Instruction formatting ───────────────────────────────

String format_args(Vector[Operand] args, GirModule gmod):
    String result = ""
    for (i, arg) in args.enumerate():
        if i > 0:
            result = f"{result}, "
        result = f"{result}{format_operand(arg, &gmod)}"
    return result

String format_instruction(Instruction inst, GirModule gmod):
    match inst:
        case GIAssign(dst, val):
            return f"        _{dst} = {format_operand(val, &gmod)}"
        case GIBinOp(dst, op, tid, lhs, rhs):
            return f"        _{dst} = {binop_name(op)} {format_type_id(tid, &gmod)} {format_operand(lhs, &gmod)}, {format_operand(rhs, &gmod)}"
        case GIFaultCheck(dst, op, tid, lhs, rhs):
            return f"        _{dst} = faultcheck {binop_name(op)} {format_type_id(tid, &gmod)} {format_operand(lhs, &gmod)}, {format_operand(rhs, &gmod)}"
        case GIUnOp(dst, op, tid, operand):
            return f"        _{dst} = {unop_name(op)} {format_type_id(tid, &gmod)} {format_operand(operand, &gmod)}"
        case GICmp(dst, op, tid, lhs, rhs):
            return f"        _{dst} = {cmpop_name(op)} {format_type_id(tid, &gmod)} {format_operand(lhs, &gmod)}, {format_operand(rhs, &gmod)}"
        case GICall(dst, name, args):
            String prefix = if dst >= 0: f"        _{dst} = " else: "        "
            return f"{prefix}call @{name}({format_args(args, &gmod)})"
        case GICallExtern(dst, name, args):
            String prefix = if dst >= 0: f"        _{dst} = " else: "        "
            return f"{prefix}call_extern @{name}({format_args(args, &gmod)})"
        case GIDrop(lid):
            return f"        drop _{lid}"
        case GIDropIfAlive(lid):
            return f"        drop_if_alive _{lid}"
        case GIMoveZero(lid):
            return f"        move_zero _{lid}"
        case GIDeref(dst, src, _):
            return f"        _{dst} = deref _{src}"
        case GICast(dst, src, from_ty, to_ty):
            return f"        _{dst} = cast {format_type_id(from_ty, &gmod)} _{src} to {format_type_id(to_ty, &gmod)}"
        case GIDerefStore(ptr, val, _):
            return f"        *_{ptr} = {format_operand(val, &gmod)}"
        case GIFieldLoad(dst, base, field):
            return f"        _{dst} = field_load _{base}, {field}"
        case GINop():
            return "        nop"

# ── Terminator formatting ────────────────────────────────

String format_terminator(Terminator term, GirModule gmod):
    match term:
        case GTReturn(val):
            return f"        return {format_operand(val, &gmod)}"
        case GTJump(bid):
            return f"        jump bb{bid}"
        case GTBranch(cond, then_bb, else_bb):
            return f"        br {format_operand(cond, &gmod)}, bb{then_bb}, bb{else_bb}"
        case GTNone():
            return "        <none>"

# ── Function formatting ──────────────────────────────────

String format_function(GirFunction func, GirModule gmod):
    # Signature: fn @name(param_types) -> return_type {
    String params_str = ""
    for (i, pt) in func.param_types.enumerate():
        if i > 0:
            params_str = f"{params_str}, "
        params_str = f"{params_str}{format_type_id(pt, &gmod)}"
    String sig = f"fn @{func.name}({params_str}) -> {format_type_id(func.return_type, &gmod)} {{"

    # Locals
    String locals_str = "    locals:"
    for (li, loc) in func.locals.enumerate():
        String line = f"        _{li}: {format_type_id(loc.type_id, &gmod)}"
        match loc.name_hint:
            case Some(h):
                line = f"{line}         ; {h}"
            else:
                pass
        locals_str = f"{locals_str}\n{line}"

    # Blocks
    String blocks_str = ""
    for (bi, bb) in func.blocks.enumerate():
        blocks_str = f"{blocks_str}\n    bb{bi}:"
        for inst in bb.insts:
            blocks_str = f"{blocks_str}\n{format_instruction(inst, &gmod)}"
        if bb.term is not GTNone():
            blocks_str = f"{blocks_str}\n{format_terminator(bb.term, &gmod)}"

    return f"{sig}\n{locals_str}\n{blocks_str}\n}}"

# ── Module formatting ────────────────────────────────────

String format_module(GirModule gmod):
    String result = ""
    # Extern declarations
    for ext in gmod.externs:
        String variadic = if ext.is_variadic: "..." else: ""
        result = f"{result}extern fn @{ext.name}({variadic}) -> {format_type_id(ext.return_type, &gmod)}\n"
    if gmod.externs.len() > 0:
        result = f"{result}\n"
    # Functions — same-file always kept; imported only if registered
    # in `fn_sigs` (i.e., transitively called).
    for (fi, func) in gmod.functions.enumerate():
        bool is_imported = gmod.imported_fns.contains(func.name)
        bool keep = not is_imported or gmod.fn_sigs.contains(func.name)
        if keep:
            if fi > 0:
                result = f"{result}\n"
            result = f"{result}{format_function(func, &gmod)}\n"
    return result
