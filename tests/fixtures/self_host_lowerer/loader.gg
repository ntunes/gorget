# Simple multi-module import loader.
# Reads imported .gg files, parses them, and merges their items into the
# main module for lowering.  Applies module-path name mangling to imported
# functions (e.g. std.conv.parse_int → std__conv___parse_int) and builds a
# call-redirect map so the lowerer can rewrite bare call names.

from parser import parse_source, parse_source_with_offset
from ast import Module, Item, ImportStmt, FunctionDef, EquipBlock, EnumDef, StructDef, SpannedExpr, SpannedType, SpannedPattern, Stmt, ElseBranch, MatchArm, SelectArm, SelectOp, Expr, Type, Pattern, TraitDef, Param
from derive import expand_derives
from std.fs import read_file, file_exists, is_dir
from std.path import path_absolute
from std.collections import Vector, Dict
from std.conv import int_to_str

# ── Path resolution ──────────────────────────────────────

String resolve_module_path(String base_dir, String module_path):
    # The Rust compiler maps std.net.{socket,tls,udp} to lib/std/{socket,tls,udp}.gg
    # via builtin_module_source (there is no std/net/ directory on disk).
    String resolved = module_path
    if module_path.starts_with("std.net."):
        resolved = "std." + module_path.slice(8, module_path.len())
    String path_part = resolved.replace(".", "/")
    return base_dir + "/" + path_part + ".gg"

String parent_dir(String path):
    # Extract parent directory: find last '/' by scanning
    int last_slash = -1
    int i = 0
    while i < path.len():
        if i + 1 <= path.len():
            String ch = path.slice(i, i + 1)
            if ch == "/":
                last_slash = i
        i += 1
    if last_slash >= 0:
        return path.slice(0, last_slash)
    return "."

# Project-root namespaces — first dotted segment that resolves
# against the project root (walk up from `start` to find an ancestor
# containing a sibling dir of that name) rather than `base_dir`.
# Mirrors `is_project_root_namespace` in src/loader.rs:88.
bool is_project_root_namespace(String mod_path):
    # Match first dotted segment.
    if mod_path == "compiler":
        return true
    if mod_path.starts_with("compiler."):
        return true
    return false

# Walk up from `start` until we find an ancestor directory containing
# a subdirectory named `root_dir_name`. Returns that ancestor path,
# or "" if none. Mirrors `find_project_root_for` in src/loader.rs:95.
String find_project_root_for(String start, String root_dir_name):
    String cur = start
    int guard = 0
    while guard < 32:
        if cur == "":
            return ""
        String candidate = cur + "/" + root_dir_name
        if is_dir(candidate):
            return cur
        String par = parent_dir(cur)
        if par == cur:
            return ""
        if par == ".":
            # Reached cwd-rooted shorthand; one more attempt then stop.
            String candidate2 = "./" + root_dir_name
            if is_dir(candidate2):
                return "."
            return ""
        cur = par
        guard += 1
    return ""

# First dotted segment of `mod_path`.
String first_dotted_segment(String mod_path):
    int dot_i = 0
    while dot_i < mod_path.len():
        if mod_path.slice(dot_i, dot_i + 1) == ".":
            return mod_path.slice(0, dot_i)
        dot_i += 1
    return mod_path

# ── std.iter auto-import ────────────────────────────────
#
# Helpers ported from `src/loader.rs:115` (`module_should_auto_load_std_iter`).
# The check itself is **inlined** at the load_imports entry point — see
# Self-host snag #5 in TODO.md: factoring it into a top-level helper
# triggers a Rust-stage codegen bug on the `Vector[Item]` match. These
# free helpers (name_is_iter_marker / type_mentions_iter / …) don't
# top-level-match-on-Item and compile fine when called transitively.

bool name_is_iter_marker(String name):
    if name == "Iterator" or name == "Iterable" or name == "IntoIterable" or name == "Drainable":
        return true
    if name == "VectorIter" or name == "VectorDrain":
        return true
    if name == "TakeIter" or name == "SkipIter" or name == "ChainIter":
        return true
    if name == "MapIter" or name == "FilterIter":
        return true
    if name == "TakeWhileIter" or name == "DropWhileIter":
        return true
    if name == "FilterMapIter" or name == "InspectIter":
        return true
    if name == "EnumerateIter" or name == "ZipIter":
        return true
    if name == "WindowsIter" or name == "ChunksIter":
        return true
    if name == "DictIter" or name == "SetIter":
        return true
    if name == "sum_iter" or name == "product_iter":
        return true
    if name == "min_iter" or name == "max_iter":
        return true
    if name == "join_iter" or name == "set_iter":
        return true
    return false

bool type_mentions_iter(SpannedType ty):
    match ty.ty:
        case TNamed(name, targs):
            if name_is_iter_marker(name):
                return true
            int i = 0
            while i < targs.len():
                SpannedType ta = targs.get(i).unwrap()
                if type_mentions_iter(ta):
                    return true
                i += 1
            return false
        case TTuple(elems):
            int j = 0
            while j < elems.len():
                SpannedType te = elems.get(j).unwrap()
                if type_mentions_iter(te):
                    return true
                j += 1
            return false
        case TFunction(ret_box, params, _):
            SpannedType ret_ty = *ret_box
            if type_mentions_iter(ret_ty):
                return true
            int k = 0
            while k < params.len():
                SpannedType pt = params.get(k).unwrap()
                if type_mentions_iter(pt):
                    return true
                k += 1
            return false
        case TArray(elem_box, _):
            SpannedType arr_elem = *elem_box
            return type_mentions_iter(arr_elem)
        case TSlice(elem_box):
            SpannedType sl_elem = *elem_box
            return type_mentions_iter(sl_elem)
        else:
            return false

bool expr_mentions_iter(SpannedExpr sexpr):
    match sexpr.expr:
        case EIdentifier(name):
            return name_is_iter_marker(name)
        case EMethodCall(recv_box, mname, args, _):
            if mname == "iter" or mname == "drain":
                return true
            SpannedExpr recv_e = *recv_box
            if expr_mentions_iter(recv_e):
                return true
            int i = 0
            while i < args.len():
                SpannedExpr a = args.get(i).unwrap().value
                if expr_mentions_iter(a):
                    return true
                i += 1
            return false
        case ECall(callee_box, args, _):
            SpannedExpr callee_e = *callee_box
            if expr_mentions_iter(callee_e):
                return true
            int i = 0
            while i < args.len():
                SpannedExpr a = args.get(i).unwrap().value
                if expr_mentions_iter(a):
                    return true
                i += 1
            return false
        case EStructLiteral(name, _, args):
            if name_is_iter_marker(name):
                return true
            int i = 0
            while i < args.len():
                SpannedExpr a = args.get(i).unwrap()
                if expr_mentions_iter(a):
                    return true
                i += 1
            return false
        case EBinaryOp(lhs_box, _, rhs_box):
            SpannedExpr lhs_e = *lhs_box
            SpannedExpr rhs_e = *rhs_box
            return expr_mentions_iter(lhs_e) or expr_mentions_iter(rhs_e)
        case EUnaryOp(_, inner_box):
            SpannedExpr inner_e = *inner_box
            return expr_mentions_iter(inner_e)
        case EFieldAccess(obj_box, _):
            SpannedExpr obj_e = *obj_box
            return expr_mentions_iter(obj_e)
        case EIndex(obj_box, idx_box):
            SpannedExpr ix_obj = *obj_box
            SpannedExpr ix_idx = *idx_box
            return expr_mentions_iter(ix_obj) or expr_mentions_iter(ix_idx)
        case EArrayLiteral(elems):
            int i = 0
            while i < elems.len():
                SpannedExpr el = elems.get(i).unwrap()
                if expr_mentions_iter(el):
                    return true
                i += 1
            return false
        case ETupleLiteral(elems):
            int i = 0
            while i < elems.len():
                SpannedExpr el = elems.get(i).unwrap()
                if expr_mentions_iter(el):
                    return true
                i += 1
            return false
        case EDictLiteral(keys, values):
            int i = 0
            while i < keys.len():
                SpannedExpr k = keys.get(i).unwrap()
                if expr_mentions_iter(k):
                    return true
                i += 1
            int j = 0
            while j < values.len():
                SpannedExpr v = values.get(j).unwrap()
                if expr_mentions_iter(v):
                    return true
                j += 1
            return false
        case EClosure(_, body):
            return block_mentions_iter(body)
        case EBlock(body):
            return block_mentions_iter(body)
        case EFString(_, fexprs, _):
            int i = 0
            while i < fexprs.len():
                SpannedExpr fe = fexprs.get(i).unwrap()
                if expr_mentions_iter(fe):
                    return true
                i += 1
            return false
        case EMove(inner_box):
            SpannedExpr mv_e = *inner_box
            return expr_mentions_iter(mv_e)
        case EMutableBorrow(inner_box):
            SpannedExpr mb_e = *inner_box
            return expr_mentions_iter(mb_e)
        case EDeref(inner_box):
            SpannedExpr de_e = *inner_box
            return expr_mentions_iter(de_e)
        case ETry(inner_box):
            SpannedExpr try_e = *inner_box
            return expr_mentions_iter(try_e)
        case EPropagate(inner_box):
            SpannedExpr prop_e = *inner_box
            return expr_mentions_iter(prop_e)
        case EAwait(inner_box):
            SpannedExpr aw_e = *inner_box
            return expr_mentions_iter(aw_e)
        case ESpawn(inner_box):
            SpannedExpr sp_e = *inner_box
            return expr_mentions_iter(sp_e)
        case ESpawnBlocking(inner_box):
            SpannedExpr spb_e = *inner_box
            return expr_mentions_iter(spb_e)
        case EDefaultOp(lhs_box, rhs_box):
            SpannedExpr do_lhs = *lhs_box
            SpannedExpr do_rhs = *rhs_box
            return expr_mentions_iter(do_lhs) or expr_mentions_iter(do_rhs)
        case EAs(inner_box, target_ty_box):
            SpannedExpr as_e = *inner_box
            SpannedType as_ty = *target_ty_box
            return expr_mentions_iter(as_e) or type_mentions_iter(as_ty)
        case ERange(start_opt, end_opt, _):
            match start_opt:
                case Some(s_box):
                    SpannedExpr s_e = *s_box
                    if expr_mentions_iter(s_e):
                        return true
                case None:
                    pass
            match end_opt:
                case Some(e_box):
                    SpannedExpr e_e = *e_box
                    if expr_mentions_iter(e_e):
                        return true
                case None:
                    pass
            return false
        case EIf(cond_box, then_body, branches):
            SpannedExpr if_cond = *cond_box
            if expr_mentions_iter(if_cond):
                return true
            if block_mentions_iter(then_body):
                return true
            int i = 0
            while i < branches.len():
                ElseBranch eb = branches.get(i).unwrap()
                match eb.condition:
                    case Some(ec):
                        if expr_mentions_iter(ec):
                            return true
                    case None:
                        pass
                if block_mentions_iter(eb.body):
                    return true
                i += 1
            return false
        case EMatch(scrut_box, arms):
            SpannedExpr scrut_e = *scrut_box
            if expr_mentions_iter(scrut_e):
                return true
            int i = 0
            while i < arms.len():
                MatchArm arm = arms.get(i).unwrap()
                if block_mentions_iter(arm.body):
                    return true
                match arm.guard:
                    case Some(g):
                        if expr_mentions_iter(g):
                            return true
                    case None:
                        pass
                i += 1
            return false
        case EDo(body):
            return block_mentions_iter(body)
        else:
            return false

bool stmt_mentions_iter(Stmt s):
    match s:
        case SVarDecl(ty, _, init, _, _, _):
            if type_mentions_iter(ty):
                return true
            return expr_mentions_iter(init)
        case SAssign(target, value):
            return expr_mentions_iter(target) or expr_mentions_iter(value)
        case SCompoundAssign(target, _, value):
            return expr_mentions_iter(target) or expr_mentions_iter(value)
        case SExpr(expr):
            return expr_mentions_iter(expr)
        case SReturn(opt_e):
            match opt_e:
                case Some(e):
                    return expr_mentions_iter(e)
                case None:
                    return false
        case SThrow(expr):
            return expr_mentions_iter(expr)
        case SBreak():
            return false
        case SIf(cond, then_body, branches):
            if expr_mentions_iter(cond):
                return true
            if block_mentions_iter(then_body):
                return true
            int i = 0
            while i < branches.len():
                ElseBranch eb = branches.get(i).unwrap()
                match eb.condition:
                    case Some(ec):
                        if expr_mentions_iter(ec):
                            return true
                    case None:
                        pass
                if block_mentions_iter(eb.body):
                    return true
                i += 1
            return false
        case SWhile(cond, body, else_body):
            if expr_mentions_iter(cond):
                return true
            if block_mentions_iter(body):
                return true
            return block_mentions_iter(else_body)
        case SFor(_, iter_expr, body, _, else_body):
            if expr_mentions_iter(iter_expr):
                return true
            if block_mentions_iter(body):
                return true
            return block_mentions_iter(else_body)
        case SLoop(body):
            return block_mentions_iter(body)
        case SMatch(scrut, arms):
            if expr_mentions_iter(scrut):
                return true
            int i = 0
            while i < arms.len():
                MatchArm arm = arms.get(i).unwrap()
                if block_mentions_iter(arm.body):
                    return true
                match arm.guard:
                    case Some(g):
                        if expr_mentions_iter(g):
                            return true
                    case None:
                        pass
                i += 1
            return false
        case SWith(expr, _, body):
            return expr_mentions_iter(expr) or block_mentions_iter(body)
        case SAssert(expr, _):
            return expr_mentions_iter(expr)
        case SAssertReturn(expr, _):
            return expr_mentions_iter(expr)
        case SNamedScope(_, body):
            return block_mentions_iter(body)
        case SOnError(body):
            return block_mentions_iter(body)
        case SSnapshot(_, _, expr):
            return expr_mentions_iter(expr)
        case SMetaFor(mf_vars, mf_iter, body):
            return block_mentions_iter(body)
        case SMetaIf(meta_cond, then_body, branches):
            if block_mentions_iter(then_body):
                return true
            int i = 0
            while i < branches.len():
                ElseBranch eb = branches.get(i).unwrap()
                if block_mentions_iter(eb.body):
                    return true
                i += 1
            return false
        case SMetaMatch(mm_scrut, mm_arms, mm_else):
            int mi = 0
            while mi < mm_arms.len():
                if block_mentions_iter(mm_arms.get(mi).unwrap().body):
                    return true
                mi += 1
            return block_mentions_iter(mm_else)
        case SMetaWhile(mw_cond, mw_body):
            return block_mentions_iter(mw_body)
        else:
            return false

bool block_mentions_iter(Vector[Stmt] stmts):
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        if stmt_mentions_iter(s):
            return true
        i += 1
    return false

bool function_mentions_iter(FunctionDef f):
    int i = 0
    while i < f.params.len():
        Param fp = f.params.get(i).unwrap()
        if type_mentions_iter(fp.param_type):
            return true
        i += 1
    if type_mentions_iter(f.return_type):
        return true
    return block_mentions_iter(f.body)

bool module_shadows_vector_iter(Module m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IStruct(sdef):
                if sdef.name == "VectorIter":
                    return true
            case IEnum(edef):
                if edef.name == "VectorIter":
                    return true
            case ITypeAlias(name, _, _):
                if name == "VectorIter":
                    return true
            case INewtype(name, _):
                if name == "VectorIter":
                    return true
            case ITrait(td):
                if td.name == "VectorIter":
                    return true
            else:
                pass
        i += 1
    return false

bool module_imports_std_iter(Module m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IImport(imp):
                if imp.module_path == "std.iter":
                    return true
            else:
                pass
        i += 1
    return false

# Auto-load std.hash when the module uses @derive(Hashable) on any
# struct or enum — the derived `equip T with Hashable: void hash(self,
# FxHasher &h)` references FxHasher's write_int / write_string / finish
# methods from std.hash. Without the auto-load those symbols are never
# loaded into the GIR module and the derived `T__hash` body link-fails
# against undefined `FxHasher__write_*`. Mirrors Rust gg's
# `module_uses_hashable_derive` (src/loader.rs:117) + the auto-load at
# src/loader.rs:623. Derives are pre-collapsed to `Vector[String]` on
# StructDef / EnumDef, so this is a direct membership scan (typed; no
# attribute re-parse).
bool module_uses_hashable_derive(Module m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IStruct(sdef):
                int di = 0
                while di < sdef.derives.len():
                    if sdef.derives.get(di).unwrap() == "Hashable":
                        return true
                    di += 1
            case IEnum(edef):
                int dei = 0
                while dei < edef.derives.len():
                    if edef.derives.get(dei).unwrap() == "Hashable":
                        return true
                    dei += 1
            else:
                pass
        i += 1
    return false

bool module_imports_std_hash(Module m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IImport(imp):
                if imp.module_path == "std.hash":
                    return true
            else:
                pass
        i += 1
    return false

bool ast_mentions_std_iter_need(Module m):
    int i = 0
    while i < m.items.len():
        Item item = m.items.get(i).unwrap()
        match item:
            case IFunction(f):
                if function_mentions_iter(f):
                    return true
            else:
                pass
        i += 1
    return false

bool should_auto_load_std_iter(Module m):
    if module_shadows_vector_iter(m):
        return false
    if module_imports_std_iter(m):
        return false
    return ast_mentions_std_iter_need(m)

# ── Module-path mangling ────────────────────────────────

String mangle_prefix(String module_path):
    # "std.conv" → "std__conv___"
    return module_path.replace(".", "__") + "___"

# PROTOTYPE: a return type "safe" to register in fn_sigs from an IMPORTED
# extern block. Imported extern blocks may declare externs the entry program
# never calls (e.g. `process_spawn` returning `Result[Process, String]` in
# std.process when the fixture only imports `exec`). Registering such a return
# type via map_ast_type SIDE-EFFECT-registers the user nominal (`Process` →
# `GorgetProcess`) and its `Result__Process__GorgetString` wrapper struct,
# which the C-emit then references WITHOUT a typedef (the `Process` struct decl
# is not merged) → cc-fail `unknown type name 'GorgetProcess'`. Restrict the
# push to externs whose return is a runtime-backed shape that always has a C
# typedef: primitives / void / cstr / String / the builtin collections. This
# is exactly the value-position-print bug class (scalar/String/cstr/Vector);
# user-nominal and Result/Option-of-nominal returns are NOT printed and need
# no fn_sigs entry here.
bool extern_ret_shape_safe_to_register(SpannedType rt):
    match rt.ty:
        case TPrimitive(_):
            return true
        case TNamed(rn, _):
            if rn == "String" or rn == "cstr" or rn == "void":
                return true
            if rn == "Vector" or rn == "Deque" or rn == "Dict" or rn == "Set":
                return true
            return false
        else:
            return false

# ── Import loading ───────────────────────────────────────

Dict[String, String] load_imports(Module &m, String entry_path, String lib_dir, Dict[String, bool] &imported_fns, int entry_source_len, Dict[String, String] lib_embedded, bool lib_explicit, Dict[String, bool] &imported_bare_names):
    # Canonicalize the entry path to an absolute path BEFORE deriving
    # `base_dir`. Mirrors Rust's `ModuleLoader::load_all` (src/loader.rs:581
    # `entry.canonicalize()` → `canonical.parent()`). Without this, a
    # relative entry path (`driver.gg`, cwd=self_host_lowerer) gives
    # `base_dir = "."`, and the project-root namespace walk for
    # `compiler.*` (find_project_root_for) cannot ascend past "." — so
    # `compiler.data.resources` is silently dropped, losing the RESOURCES /
    # *_BUILTIN_METHODS globals + their types/monos → bare-`Option`
    # type-loss in the emitted C. Absolute spelling worked by accident;
    # this makes module identity path-spelling-independent (devbook/24:
    # one canonical key, not a raw path string).
    String abs_entry = path_absolute(entry_path)
    String base_dir = parent_dir(abs_entry)
    # PROOF-OF-FIX: this used to be `Vector[String] loaded = []` with a
    # linear-scan `loaded_contains` helper, working around an alleged
    # "Dict[String, bool] state-loss" — `std.collections` getting
    # re-loaded 286× because contains-after-put returned false. The
    # actual root cause was twofold: (1) cross-file span collision in
    # the resolver's `Dict[int, int] resolution_map` (now fixed by per-
    # module `parse_source_with_offset`), and (2) `EDictLiteral` (`{}`)
    # for `Dict[String, _]` lowered to `__gorget_map_new_sized_K__GGSEP__V`
    # which the codegen ALWAYS expanded to `gorget_map_new(sizeof(K),
    # sizeof(V))` — never `gorget_map_new_str(sizeof(V))` — so for
    # String-keyed maps the runtime had `hash_fn = NULL` and the
    # fallback byte-FNV on the 32-byte `Str` struct (data ptr + cap +
    # len) gave different hashes for content-equal keys with different
    # data pointers. Both fixed now; Dict-backed dedup works.
    Dict[String, bool] loaded = {}
    Dict[String, String] call_redirects = {}

    # Cumulative span offset for imported modules: every module's spans
    # get shifted by this base so that span values stay globally unique
    # across the merged program. Without this, file-local byte offsets
    # collide and the resolver's `Dict[int, int] resolution_map` last-
    # write-wins on the collision — silently routing identifier uses to
    # defs in the wrong file. Mirrors `ModuleLoader.next_offset` in
    # `src/loader.rs`. The 1-byte separator keeps end-of-module spans
    # from butting against the next module's start.
    int next_offset = entry_source_len + 1

    # Collect import paths from the module
    Vector[String] import_paths = []
    Vector[String] import_mod_paths = []
    int ii = 0
    while ii < m.items.len():
        Item item = m.items.get(ii).unwrap()
        match item:
            case IImport(imp):
                if not loaded.contains(imp.module_path):
                    import_paths.push(imp.module_path.clone())
                    import_mod_paths.push(imp.module_path.clone())
                    loaded.put(imp.module_path.clone(), true)
            else:
                pass
        ii += 1

    # Auto-load `std.iter` via factored helper (REPRO of Snag #5).
    if should_auto_load_std_iter(m):
        String auto_iter = "std.iter"
        if not loaded.contains(auto_iter):
            import_paths.push(auto_iter.clone())
            import_mod_paths.push(auto_iter.clone())
            loaded.put(auto_iter.clone(), true)

    # Auto-load `std.hash` when the entry module uses @derive(Hashable)
    # and doesn't already import it. Mirrors Rust gg's auto-load at
    # src/loader.rs:623. Without this the derived `T__hash` body calls
    # `FxHasher__write_int` / `FxHasher__write_string` whose definitions
    # are never loaded → declared-but-undefined at link (the
    # `dict_user_key_auto` reachability gap). Gated on the derive so it
    # NEVER fires for the String-keyed-Dict driver (no @derive(Hashable)
    # in any self-host dir) → fixed_point emit stays byte-identical.
    if module_uses_hashable_derive(m) and not module_imports_std_hash(m):
        String auto_hash = "std.hash"
        if not loaded.contains(auto_hash):
            import_paths.push(auto_hash.clone())
            import_mod_paths.push(auto_hash.clone())
            loaded.put(auto_hash.clone(), true)

    # Load each imported module
    int pi = 0
    while pi < import_paths.len():
        String mod_path = import_paths.get(pi).unwrap()
        String mod_prefix = mangle_prefix(mod_path)

        # Try local directory first, then lib directory.
        String file_path = resolve_module_path(base_dir, mod_path)
        if not file_exists(file_path):
            file_path = resolve_module_path(lib_dir, mod_path)
        # Project-root namespace fallback: `compiler.data.schema` etc.
        # live at `<project_root>/compiler/data/schema.gg` regardless
        # of `base_dir` / `lib_dir`. Mirrors src/loader.rs:746-760.
        if not file_exists(file_path):
            if is_project_root_namespace(mod_path):
                String root_seg = first_dotted_segment(mod_path)
                String project_root = find_project_root_for(base_dir, root_seg)
                if project_root != "":
                    String pr_path = resolve_module_path(project_root, mod_path)
                    if file_exists(pr_path):
                        file_path = pr_path
        # Inc-3 PROTOTYPE: embedded lib/std fallback (relocatability). 3-state
        # precedence mirrors Inc-2's read_runtime: a local/lib_dir/project-root
        # disk file (file_exists above) always WINS; an explicit lib-dir
        # (--lib-dir= flag or GG_LIB_DIR env) forces disk; otherwise consult the
        # embedded table keyed on the NORMALIZED module path (std.net.X→std.X,
        # mirroring resolve_module_path). HIT → use embedded; MISS → fall through
        # to disk (so non-std imports / project namespaces stay disk-only).
        bool have_source = false
        String source = ""
        if file_exists(file_path):
            source = read_file(file_path)
            have_source = true
        elif not lib_explicit:
            String embed_key = mod_path
            if mod_path.starts_with("std.net."):
                embed_key = "std." + mod_path.slice(8, mod_path.len())
            if lib_embedded.contains(embed_key):
                source = lib_embedded.get(embed_key).unwrap()
                have_source = true
        if have_source:
            int module_offset = next_offset
            next_offset = next_offset + source.byte_len() + 1
            Module imported = parse_source_with_offset(source, module_offset)
            expand_derives(&imported)

            # Add imported items to main module, with mangling
            int ji = 0
            while ji < imported.items.len():
                Item imp_item = imported.items.get(ji).unwrap()
                match imp_item:
                    case IImport(sub_imp):
                        # Recursively discover imports from the imported module
                        if not loaded.contains(sub_imp.module_path):
                            import_paths.push(sub_imp.module_path.clone())
                            import_mod_paths.push(sub_imp.module_path.clone())
                            loaded.put(sub_imp.module_path.clone(), true)
                    case IFunction(fdef):
                        # A.3 carrier: record EVERY imported bare fn name (real-
                        # bodied, extern-stub of any ret type, or bodyless
                        # intrinsic fwd-decl) regardless of the downstream
                        # mangle/drop decision. This is the resolver's
                        # import-allow set — a superset of `call_redirects`
                        # bare keys plus the math/non-String externs the
                        # String-only redirect carve-out drops.
                        imported_bare_names.put(fdef.name.clone(), true)
                        # Aliased extern stub: body is one of SExpr(EStringLiteral)
                        # or SReturn(Some(EStringLiteral)) depending on how the
                        # parser wrapped `= "symbol"`.
                        if fdef.body.len() == 1:
                            Stmt alias_s = fdef.body.get(0).unwrap()
                            match alias_s:
                                case SExpr(alias_sx):
                                    match alias_sx.expr:
                                        case EStringLiteral(alias_val, _):
                                            call_redirects.put(fdef.name.clone(), alias_val.clone())
                                        else:
                                            pass
                                case SReturn(alias_ret_opt):
                                    match alias_ret_opt:
                                        case Some(alias_ret_expr):
                                            match alias_ret_expr.expr:
                                                case EStringLiteral(alias_val2, _):
                                                    call_redirects.put(fdef.name.clone(), alias_val2.clone())
                                                else:
                                                    pass
                                        case None:
                                            pass
                                else:
                                    pass
                        # Skip extern stubs and forward declarations.
                        # Real functions: >=2 body statements, OR expression body,
                        # OR 1 statement that is SIf/SWhile/SFor/SMatch.
                        # Stubs have 0 statements or 1 trivial statement.
                        # is_extern_stub (typed flag set by the parser at the
                        # extern ctor) forces the stub down the else branch: its
                        # preserved `= "symbol"` alias body — kept so the redirect
                        # above can read it — must NOT count as a real body (that
                        # would mangle + overwrite the clean redirect at :779).
                        bool has_real_body = (fdef.body.len() >= 2 or fdef.is_expr_body) and not fdef.is_extern_stub
                        if not fdef.is_extern_stub and not has_real_body and fdef.body.len() == 1:
                            Stmt first_s = fdef.body.get(0).unwrap()
                            match first_s:
                                case SIf(_, _, _):
                                    has_real_body = true
                                case SWhile(_, _, _):
                                    has_real_body = true
                                case SFor(_, _, _, _, _):
                                    has_real_body = true
                                case SMatch(_, _):
                                    has_real_body = true
                                case SReturn(opt_ret):
                                    match opt_ret:
                                        case Some(_):
                                            has_real_body = true
                                        case None:
                                            pass
                                case SVarDecl(_, _, _, _, _, _):
                                    has_real_body = true
                                case SAssign(_, _):
                                    has_real_body = true
                                case SMetaFor(_, _, _):
                                    has_real_body = true
                                case SMetaIf(_, _, _):
                                    has_real_body = true
                                case SMetaMatch(_, _, _):
                                    has_real_body = true
                                case SMetaWhile(_, _):
                                    has_real_body = true
                                case SExpr(sexpr):
                                    # Accept SExpr if it's a call (not a string literal
                                    # which is an extern stub marker)
                                    match sexpr.expr:
                                        case EStringLiteral(_, _):
                                            pass
                                        else:
                                            has_real_body = true
                                else:
                                    pass
                        if has_real_body:
                            # Mangle function name and register redirect
                            String bare_name = fdef.name.clone()
                            String mangled = mod_prefix + bare_name
                            call_redirects.put(bare_name, mangled.clone())
                            imported_fns.put(mangled.clone(), true)
                            # Create a renamed copy
                            FunctionDef renamed = FunctionDef(mangled, fdef.params, fdef.return_type, fdef.type_params, fdef.body, fdef.is_expr_body, fdef.throws_type, fdef.is_extern_stub, fdef.throws_inferred)
                            m.items.push(IFunction(renamed))
                        else:
                            # Imported extern stub / forward declaration
                            # (`extern "C" String __bytes_to_str_raw(...) = "sym"`).
                            # When imported, the parser yields an IFunction whose
                            # body is empty (forward-decl shape) or a single
                            # string-literal alias stmt — either way `has_real_body`
                            # is false and the stub is otherwise DROPPED, so its
                            # RETURN TYPE never reaches the lowerer's fn_sigs. A
                            # caller's `String chunk = __bytes_to_str_raw(buf.clone())`
                            # then types `chunk` as I64 (the default); the i64 slot
                            # mismatches the Str call result and the C-emit
                            # ISlotStore give-up (lir_codegen aggregate-into-scalar)
                            # zeroes the store whenever SSA doesn't promote the dead
                            # slot — the io.gg Writer-for-String self-instability
                            # (bug #4). Push an EMPTY-body copy under the SOURCE name
                            # so the fn_sigs refine pass registers the real return
                            # type; the empty body keeps the function-lowering loop
                            # (lower.gg:~9623, gated on body.len() > 0) from emitting
                            # a degenerate body, and lir_lower's map_runtime_name
                            # still spells the C symbol at the call site.
                            #
                            # SCOPE: only String-returning stubs. `cstr`-returning
                            # externs (getenv / _parse_last_error / getcwd …) also
                            # declare an aggregate-ish return but have a SEPARATE
                            # cstr-coercion path (is_cstr_returning_call at SVarDecl,
                            # gorget_str_from_cstr) that keys off the I64-default
                            # slot; registering them as GorgetString breaks that
                            # path (const char* vs Str cc mismatch). Restrict to the
                            # `String` return shape that the bug #4 class needs.
                            # PROTOTYPE: push an empty-body stub copy for EVERY
                            # imported inline extern stub (was String-only). The
                            # fn_sigs refine pass (lower.gg:~2835, IFunction arm)
                            # then registers the typed return — bool/cstr/String/
                            # float — under the bare name AND the C symbol, so a
                            # `bool t = is_tty()` value-position read (print /
                            # f-string) sees BOOL_TYPE instead of the I64 default
                            # (which prints `0`/`1` not `false`/`true`). The cstr
                            # case is mapped to GorgetString in the refine pass so
                            # the EMIT-side cstr wrap fires (see lower.gg). The empty
                            # body keeps the function-lowering loop (body.len() > 0)
                            # from emitting a degenerate body; is_extern_stub=true.
                            if fdef.is_extern_stub and extern_ret_shape_safe_to_register(fdef.return_type):
                                Vector[Stmt] empty_body = Vector[Stmt]()
                                FunctionDef stub_decl = FunctionDef(fdef.name.clone(), fdef.params, fdef.return_type, fdef.type_params, empty_body, false, fdef.throws_type, true, fdef.throws_inferred)
                                m.items.push(IFunction(stub_decl))
                    case IEnum(edef):
                        # Merge imported enums so type_infos has variant info —
                        # this lets the lowerer route bare variant constructors
                        # (IntCol, Red, ...) to their parent enum type, and
                        # lir_lower knows to skip emitting standalone variant
                        # structs. Concrete non-generic only. Mark in
                        # imported_fns with "__imported_type__" prefix so the
                        # lir_lower can skip drop/clone emission (Rust preamble
                        # already provides them via static inline).
                        if edef.type_params.len() == 0:
                            String ename = edef.name.clone()
                            m.items.push(IEnum(edef))
                            imported_fns.put("__imported_type__" + ename, true)
                    case IStruct(sdef):
                        # Merge imported concrete struct so the lowerer's
                        # type_infos can resolve field types — enables proper
                        # field access on imported struct types (self.x where
                        # self is Ptr(ImportedStruct)). Mark with
                        # __imported_type__ prefix so lir_lower / lir_codegen
                        # suppress duplicate struct body and drop/clone
                        # definitions (Rust preamble already provides them).
                        if sdef.type_params.len() == 0:
                            String sname = sdef.name.clone()
                            m.items.push(IStruct(sdef))
                            imported_fns.put("__imported_type__" + sname, true)
                        else:
                            # Generic struct template (`struct VectorIter[T]`,
                            # `struct VectorDrain[T]`, …): merge so the
                            # lowerer's `struct_templates` collector picks it
                            # up and `lower_module`'s mono-fields pass at
                            # line ~6100 registers field info for each
                            # concrete instance (`VectorIter__int64_t.source`,
                            # `.idx`, …). Don't tag `__imported_type__` —
                            # the Rust preamble doesn't emit mono'd struct
                            # bodies, so self-host must emit them itself.
                            m.items.push(IStruct(sdef))
                    case IEquip(eqblk):
                        # Extract the equip target's base type name (e.g. "File")
                        # for mangling extern-stub method redirects below.
                        String equip_target_name = ""
                        match eqblk.target.ty:
                            case TNamed(eq_tn, _):
                                equip_target_name = eq_tn
                            else:
                                pass
                        # Filter: real methods have >=2 body stmts, OR expression body,
                        # OR 1 stmt that isn't a string-literal extern stub marker.
                        # Extern stubs look like: method_name(): "abi_symbol"
                        Vector[FunctionDef] real_methods = []
                        int emi = 0
                        while emi < eqblk.methods.len():
                            FunctionDef emdef = eqblk.methods.get(emi).unwrap()
                            # Extern-method stub inside an equip: `extern int
                            # _write_bytes_buf(...) = "gorget_file_write_bytes_buf"`.
                            # The parser lowers `= "symbol"` to an EXPRESSION body
                            # `[SReturn(Some(EStringLiteral(symbol)))]` with
                            # `is_expr_body=true` — so the `or emdef.is_expr_body`
                            # gate below would WRONGLY treat it as a real method and
                            # emit a degenerate body that `return`s the symbol string
                            # (cc-rejected: returns Str where int64_t expected). These
                            # must instead become call_redirects to the C runtime
                            # symbol, exactly as Rust gg inlines `self._m(args)` to
                            # `gorget_<symbol>(self, args)` (see Writer_for_File__write
                            # → gorget_file_write_bytes_buf). Detect the stub shape,
                            # register `<Target>__<method>` → `<symbol>`, and SKIP it.
                            # Latent until the FIDELITY vtable globals made the io.gg
                            # Writer/Reader-for-File impls reachable.
                            if emdef.is_expr_body and emdef.body.len() == 1 and equip_target_name != "":
                                String stub_symbol = ""
                                Stmt stub_s = emdef.body.get(0).unwrap()
                                match stub_s:
                                    case SReturn(stub_ret_opt):
                                        match stub_ret_opt:
                                            case Some(stub_expr):
                                                match stub_expr.expr:
                                                    case EStringLiteral(stub_val, _):
                                                        stub_symbol = stub_val
                                                    else:
                                                        pass
                                            case None:
                                                pass
                                    else:
                                        pass
                                if stub_symbol != "":
                                    String stub_key = equip_target_name + "__" + emdef.name
                                    call_redirects.put(stub_key, stub_symbol.clone())
                                    # R10: void extern equip-method stubs are SKIPPED
                                    # here (continue below), so the equip fn_sigs
                                    # pre-pass (lower.gg:~10186) never registers their
                                    # return type → the call site defaults ret_tid to
                                    # I64 → emits `__v = <void call>` (cc "void value
                                    # not ignored"). Push an empty-body IFunction stub
                                    # under the mangled `Target__method` name so the
                                    # fn_sigs passes register `Arena__reset → UNIT_TYPE`;
                                    # the call site (lower.gg) looks it up by the
                                    # pre-redirect mangled name and takes the void-branch.
                                    # VOID ONLY — int returns already default to I64
                                    # correctly, and String/cstr returns MUST NOT be
                                    # registered (they rely on the I64-default slot +
                                    # the cstr-coercion path is_cstr_returning_call).
                                    # Empty body → the function-lowering loop
                                    # (lower.gg:~10305, gated body.len()>0) skips it;
                                    # codegen never sees it (iterates gmod.functions, not
                                    # m.items). Mirrors the IFunction String carve-out
                                    # above (loader.gg:~732).
                                    # Register the return type for void AND bool
                                    # extern equip stubs, AND for STRUCT (TNamed)
                                    # returns. void → UNIT_TYPE (the original R10
                                    # fix; else the call defaults to I64 →
                                    # `__v = <void call>` cc error). bool →
                                    # BOOL_TYPE (else the bool result defaults to
                                    # I64 → the formatter prints `1`/`0`, not
                                    # `true`/`false` — the R8 class; surfaced by
                                    # `AtomicBool.load`/`compare_exchange`/`swap`,
                                    # `OnceFlag.do_once`/`is_done`,
                                    # `Semaphore.try_acquire`). int → already
                                    # defaults to I64 correctly.
                                    #
                                    # TNamed STRUCT-HANDLE case (ArenaCheckpoint,
                                    # ExecResult, UdpAddr, …): register so the call
                                    # result types as the struct — `lir_to_runtime_name`
                                    # maps it to the runtime C type (e.g.
                                    # `ArenaCheckpoint → GorgetArenaCheckpoint`,
                                    # lir_codegen.gg:172), not the I64 default →
                                    # fixes the `int64_t = GorgetArenaCheckpoint`
                                    # cc error (`Arena.checkpoint`).
                                    #
                                    # WHY this arm can register ALL TNamed-except-
                                    # String, while the sibling FREE-extern stub arm
                                    # (loader.gg:~722-731) is deliberately String-ONLY
                                    # and WARNS that registering a `cstr` return breaks
                                    # the `const char*`-vs-`Str` coercion path
                                    # (is_cstr_returning_call): a `cstr` return can
                                    # NEVER reach THIS equip-stub arm. Every `cstr`-
                                    # returning extern (getenv / getcwd /
                                    # _parse_last_error …) is declared in an
                                    # `extern "C":` / `extern "Gorget":` block, NOT in
                                    # an equip block — so it flows through the free-
                                    # extern String-only path, not here. And
                                    # `String`/`str` are TYPE KEYWORDS, so they parse
                                    # as `TPrimitive("String")`/`TPrimitive("str")`
                                    # (parser.gg) and take the TPrimitive arm — they
                                    # can't reach the TNamed case either. So the
                                    # `!= "String"`/`!= "Str"` guard below is dead-but-
                                    # harmless belt-and-suspenders; there is no `cstr`-
                                    # vs-`Str` coercion hazard on this arm. (Two arms,
                                    # two carve-out philosophies, but NOT contradictory:
                                    # the difference is which externs can structurally
                                    # reach each arm.)
                                    bool stub_register_ret = false
                                    match emdef.return_type.ty:
                                        case TPrimitive(stub_rt):
                                            if stub_rt == "void" or stub_rt == "bool":
                                                stub_register_ret = true
                                        case TNamed(stub_tn, _):
                                            # Struct-returning extern equip method
                                            # (ArenaCheckpoint, ExecResult, UdpAddr, …):
                                            # register so the call result types as the
                                            # struct (lir_to_runtime_name maps it to the
                                            # runtime C type), not the I64 default →
                                            # fixes the `int64_t = GorgetArenaCheckpoint`
                                            # cc error.
                                            if stub_tn != "String" and stub_tn != "Str":   # dead-but-harmless: see comment block
                                                stub_register_ret = true
                                        else:
                                            pass
                                    if stub_register_ret:
                                        Vector[Stmt] empty_m_body = Vector[Stmt]()
                                        FunctionDef void_stub = FunctionDef(stub_key.clone(), emdef.params, emdef.return_type, emdef.type_params, empty_m_body, false, emdef.throws_type, true, emdef.throws_inferred)
                                        m.items.push(IFunction(void_stub))
                                    emi += 1
                                    continue
                            bool is_real = emdef.body.len() >= 2 or emdef.is_expr_body
                            if not is_real and emdef.body.len() == 1:
                                Stmt first_s = emdef.body.get(0).unwrap()
                                match first_s:
                                    case SIf(_, _, _):
                                        is_real = true
                                    case SWhile(_, _, _):
                                        is_real = true
                                    case SFor(_, _, _, _, _):
                                        is_real = true
                                    case SMatch(_, _):
                                        is_real = true
                                    case SReturn(opt_ret):
                                        match opt_ret:
                                            case Some(_):
                                                is_real = true
                                            case None:
                                                pass
                                    case SVarDecl(_, _, _, _, _, _):
                                        is_real = true
                                    case SAssign(_, _):
                                        is_real = true
                                    case SMetaFor(_, _, _):
                                        is_real = true
                                    case SMetaIf(_, _, _):
                                        is_real = true
                                    case SExpr(sexpr):
                                        # Reject string-literal stubs ("extern_abi_name")
                                        match sexpr.expr:
                                            case EStringLiteral(_, _):
                                                pass
                                            else:
                                                is_real = true
                                    else:
                                        pass
                            if is_real:
                                real_methods.push(emdef)
                            emi += 1
                        if real_methods.len() > 0:
                            EquipBlock filtered = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, real_methods, eqblk.via_field, eqblk.trait_generic_args)
                            m.items.push(IEquip(filtered))
                    case ITrait(tdef):
                        # Merge imported concrete (non-generic) trait
                        # declarations so the lowerer's `trait_defs` map has
                        # the full ordered method-slot list. Mirrors Rust gg's
                        # loader, which merges ALL imported items unconditionally
                        # (`src/loader.rs:1386 all_items.extend(module.items)`,
                        # including `Item::Trait`). Required by FIDELITY Phase 4:
                        # `emit_vtable_globals` gates on the trait being in
                        # `trait_defs` (analog of Rust's `trait_info.get(name)`),
                        # and the io.gg / serde traits (Writer/Reader/Error/
                        # Serializer/Deserializer) are all imported — without
                        # this merge, json_parse's trait-impl island is never
                        # vtable-rooted and stays DCE'd (28 user fns vs Rust's 67).
                        # Generic traits would need monomorphization (Rust skips
                        # them in register_trait_types too) — merge concrete only,
                        # EXCEPT generic traits carrying DEFAULT method bodies
                        # (`Iterator[T]`): the generic-equip default-emit path
                        # (lower.gg:14666) gates each `equip X with Iterator[T]:`
                        # instance on `trait_defs.contains("Iterator")`, then
                        # lowers the trait's default bodies (take/skip/count/…)
                        # under a Self+T type_subs binding. Without admitting the
                        # generic def WITH its bodies, `trait_defs` never has
                        # Iterator → the lazy-adapter defaults are never emitted →
                        # `__gg_VectorIter from int` CC-FAILs. The placeholder
                        # signature-only generic traits (Iterable/Drainable) carry
                        # no default bodies, so this guard leaves them filtered
                        # exactly as before — only generic traits with ≥1 default
                        # body are admitted.
                        bool trait_has_default = false
                        for tm in tdef.methods:
                            if tm.body.len() > 0:
                                trait_has_default = true
                        if tdef.type_params.len() == 0 or trait_has_default:
                            m.items.push(ITrait(tdef))
                    case IConstDecl(_, _, _):
                        # Merge module-level `const int X = 5` so the main
                        # lowerer's pre-scan sees them and EIdentifier(X)
                        # in callers resolves to the folded value instead
                        # of OpConstI64(0). Without this, parser.gg's
                        # TOK_* / KW_* constants stay invisible and the
                        # compiled parser deadlocks in skip_trivia.
                        m.items.push(imp_item)
                    case IStaticDecl(_, _, _):
                        # Same as IConstDecl: module-level `int X = -2` (the
                        # non-`const` spelling) is parsed as IStaticDecl by
                        # parser.gg:3654-3656. Without merging, references
                        # to module-level statics like `STRING_MARKER` (in
                        # lower.gg) fall through to the EIdentifier
                        # unknown-fallback (OpConstI64(0)) when imported.
                        m.items.push(imp_item)
                    case ITypeAlias(_, _, _):
                        # Merge imported module-level type aliases (`type Entity
                        # = SlotKey`) so collect_top_level's ITypeAlias arm
                        # (resolve.gg) registers the alias name AND the lowerer
                        # can resolve `Entity(...)` constructor calls / `Entity`
                        # type annotations through to the aliased type. Rust
                        # merges ALL imported items (loader.rs:1378-1390, keeping
                        # every non-import item incl. TypeAlias), so the alias is
                        # globally visible even when only sibling names are
                        # explicitly imported (`from xtd.ecs import EntityPool`).
                        # Without this merge the alias is dropped by the `else`
                        # arm below → `Entity` resolves to nothing (the ecs_*
                        # fixtures). (NOTE: this allowlist-merge diverges from the
                        # check-loader + Rust `else: push` merge-all; the broader
                        # divergence is filed in TODO as a follow-up.)
                        m.items.push(imp_item)
                    case IExternBlock(ext_fns):
                        # Extract aliases from extern stubs: body is one of
                        # SExpr(EStringLiteral) or SReturn(Some(EStringLiteral))
                        # depending on how parse_function_def wrapped `= "..."`.
                        int exi = 0
                        while exi < ext_fns.len():
                            FunctionDef ext_fd = ext_fns.get(exi).unwrap()
                            # A.3 carrier (extern-block arm): record the bare
                            # extern name so the resolver's import-allow set
                            # covers non-String externs the redirect drops.
                            imported_bare_names.put(ext_fd.name.clone(), true)
                            if ext_fd.body.len() == 1:
                                Stmt ext_s = ext_fd.body.get(0).unwrap()
                                match ext_s:
                                    case SExpr(ext_sx):
                                        match ext_sx.expr:
                                            case EStringLiteral(ext_val, _):
                                                call_redirects.put(ext_fd.name.clone(), ext_val.clone())
                                            else:
                                                pass
                                    case SReturn(ext_ret_opt):
                                        match ext_ret_opt:
                                            case Some(ext_ret_expr):
                                                match ext_ret_expr.expr:
                                                    case EStringLiteral(ext_val2, _):
                                                        call_redirects.put(ext_fd.name.clone(), ext_val2.clone())
                                                    else:
                                                        pass
                                            case None:
                                                pass
                                    else:
                                        pass
                            exi += 1
                        # PROTOTYPE: push a FILTERED imported extern block into
                        # m.items so the fn_sigs refine pass (lower.gg:~2873, which
                        # has gmod) registers the typed RETURN type under the bare
                        # Gorget name AND the redirected C symbol — exactly as it
                        # does for main-module extern blocks. Without this, an
                        # imported `extern bool mkdir(...) = "gorget_mkdir"` leaves
                        # fn_sigs[mkdir]/fn_sigs[gorget_mkdir] unregistered → I64
                        # default → print(mkdir(...)) emits "%lld" (1/0) not
                        # true/false; cstr/String returns print the pointer.
                        # Only externs with a runtime-backed return shape are
                        # pushed (see extern_ret_shape_safe_to_register): a
                        # user-nominal return (Result[Process, String]) would leak
                        # an undefined struct into the C-emit.
                        Vector[FunctionDef] safe_ext_fns = Vector[FunctionDef]()
                        int sxi = 0
                        while sxi < ext_fns.len():
                            FunctionDef sext_fd = ext_fns.get(sxi).unwrap()
                            if extern_ret_shape_safe_to_register(sext_fd.return_type):
                                safe_ext_fns.push(sext_fd.clone())
                            sxi += 1
                        if safe_ext_fns.len() > 0:
                            m.items.push(IExternBlock(safe_ext_fns))
                    else:
                        # Skip structs, enums, traits, etc. from imported modules.
                        # Only functions, equip blocks with real bodies, and
                        # extern aliases are needed.
                        pass
                ji += 1

        pi += 1

    # Main-module extern aliases: `extern "C": ... f(...) = "symbol"` declared
    # in the ENTRY module (not an import). Mirrors Rust gg's extern_bindings
    # pass (src/ir/lowering/mod.rs:717-718 `ctx.extern_bindings.insert(name,
    # c_symbol)`), which scans ALL module functions — including the entry one.
    # The imported-module loop above (pi) only covers extern aliases pulled in
    # via `import`; without this scan a top-level `extern "C": ... = "sym"`
    # block in the fixture itself never populates call_redirects, so lower_call
    # emits the Gorget name (e.g. `_llabs_borrowed`) instead of the C symbol
    # (`llabs`) → undefined link reference (extern_borrowed/borrowed_extern_
    # string).
    #
    # Scope: BLOCK-form externs only (IExternBlock). A top-level *inline*
    # `extern int f(...) = "sym"` parses to a bare IFunction that is shape-
    # indistinguishable from a real `String greet(): return "hi"` — registering
    # those by body-shape would mis-redirect real functions. That case (A.3)
    # needs a typed `is_extern_stub` flag on FunctionDef and is filed
    # separately; it is NOT one of the wired fixtures here (both use the block
    # form).
    int mi = 0
    while mi < m.items.len():
        Item main_item = m.items.get(mi).unwrap()
        match main_item:
            case IExternBlock(main_ext_fns):
                int mxi = 0
                while mxi < main_ext_fns.len():
                    FunctionDef main_ext_fd = main_ext_fns.get(mxi).unwrap()
                    if main_ext_fd.body.len() == 1:
                        Stmt main_ext_s = main_ext_fd.body.get(0).unwrap()
                        match main_ext_s:
                            case SExpr(main_ext_sx):
                                match main_ext_sx.expr:
                                    case EStringLiteral(main_ext_val, _):
                                        call_redirects.put(main_ext_fd.name.clone(), main_ext_val.clone())
                                    else:
                                        pass
                            case SReturn(main_ext_ret_opt):
                                match main_ext_ret_opt:
                                    case Some(main_ext_ret_expr):
                                        match main_ext_ret_expr.expr:
                                            case EStringLiteral(main_ext_val2, _):
                                                call_redirects.put(main_ext_fd.name.clone(), main_ext_val2.clone())
                                            else:
                                                pass
                                    case None:
                                        pass
                            else:
                                pass
                    mxi += 1
            else:
                pass
        mi += 1

    return call_redirects
