# Simple multi-module import loader.
# Reads imported .gg files, parses them, and merges their items into the
# main module for lowering.  Applies module-path name mangling to imported
# functions (e.g. std.conv.parse_int → std__conv___parse_int) and builds a
# call-redirect map so the lowerer can rewrite bare call names.

from parser import parse_source
from ast import Module, Item, ImportStmt, FunctionDef, EquipBlock, EnumDef, StructDef
from derive import expand_derives
from std.fs import read_file, file_exists
from std.collections import Vector, Dict

# ── Path resolution ──────────────────────────────────────

String resolve_module_path(String base_dir, String module_path):
    # The Rust compiler maps std.net.{socket,tls,udp} to lib/std/{socket,tls,udp}.gg
    # via builtin_module_source (there is no std/net/ directory on disk).
    String resolved = module_path
    if module_path.starts_with("std.net."):
        resolved = "std." + module_path.slice(8, module_path.len())
    String path_part = resolved.replace(".", "/")
    return base_dir + "/" + path_part + ".gg"

String parent_dir(String path):
    # Extract parent directory: find last '/' by scanning
    int last_slash = -1
    int i = 0
    while i < path.len():
        if i + 1 <= path.len():
            String ch = path.slice(i, i + 1)
            if ch == "/":
                last_slash = i
        i += 1
    if last_slash >= 0:
        return path.slice(0, last_slash)
    return "."

# ── Module-path mangling ────────────────────────────────

String mangle_prefix(String module_path):
    # "std.conv" → "std__conv___"
    return module_path.replace(".", "__") + "___"

# ── Import loading ───────────────────────────────────────

Dict[String, String] load_imports(Module &m, String entry_path, String lib_dir, Dict[String, bool] &imported_fns):
    String base_dir = parent_dir(entry_path)
    Dict[String, bool] loaded = {}
    Dict[String, String] call_redirects = {}

    # Collect import paths from the module
    Vector[String] import_paths = []
    Vector[String] import_mod_paths = []
    int ii = 0
    while ii < m.items.len():
        Item item = m.items.get(ii).unwrap()
        match item:
            case IImport(imp):
                if not loaded.contains(imp.module_path):
                    import_paths.push(imp.module_path.clone())
                    import_mod_paths.push(imp.module_path.clone())
                    loaded.put(imp.module_path, true)
            else:
                pass
        ii += 1

    # Load each imported module
    int pi = 0
    while pi < import_paths.len():
        String mod_path = import_paths.get(pi).unwrap()
        String mod_prefix = mangle_prefix(mod_path)

        # Try local directory first, then lib directory
        String file_path = resolve_module_path(base_dir, mod_path)
        if not file_exists(file_path):
            file_path = resolve_module_path(lib_dir, mod_path)
        if file_exists(file_path):
            String source = read_file(file_path)
            Module imported = parse_source(source)
            expand_derives(&imported)

            # Add imported items to main module, with mangling
            int ji = 0
            while ji < imported.items.len():
                Item imp_item = imported.items.get(ji).unwrap()
                match imp_item:
                    case IImport(sub_imp):
                        # Recursively discover imports from the imported module
                        if not loaded.contains(sub_imp.module_path):
                            import_paths.push(sub_imp.module_path.clone())
                            import_mod_paths.push(sub_imp.module_path.clone())
                            loaded.put(sub_imp.module_path, true)
                    case IFunction(fdef):
                        # Aliased extern stub: body is exactly one SExpr wrapping
                        # an EStringLiteral with the C symbol name. Register the
                        # rename in call_redirects so codegen calls the real ABI.
                        if fdef.body.len() == 1:
                            Stmt alias_s = fdef.body.get(0).unwrap()
                            match alias_s:
                                case SExpr(alias_sx):
                                    match alias_sx.expr:
                                        case EStringLiteral(alias_val, _):
                                            call_redirects.put(fdef.name.clone(), alias_val.clone())
                                        else:
                                            pass
                                else:
                                    pass
                        # Skip extern stubs and forward declarations.
                        # Real functions: >=2 body statements, OR expression body,
                        # OR 1 statement that is SIf/SWhile/SFor/SMatch.
                        # Stubs have 0 statements or 1 trivial statement.
                        bool has_real_body = fdef.body.len() >= 2 or fdef.is_expr_body
                        if not has_real_body and fdef.body.len() == 1:
                            Stmt first_s = fdef.body.get(0).unwrap()
                            match first_s:
                                case SIf(_, _, _):
                                    has_real_body = true
                                case SWhile(_, _):
                                    has_real_body = true
                                case SFor(_, _, _, _, _):
                                    has_real_body = true
                                case SMatch(_, _):
                                    has_real_body = true
                                case SReturn(opt_ret):
                                    match opt_ret:
                                        case Some(_):
                                            has_real_body = true
                                        case None:
                                            pass
                                case SVarDecl(_, _, _, _, _, _):
                                    has_real_body = true
                                case SAssign(_, _):
                                    has_real_body = true
                                case SMetaFor(_):
                                    has_real_body = true
                                case SMetaIf(_, _):
                                    has_real_body = true
                                case SExpr(sexpr):
                                    # Accept SExpr if it's a call (not a string literal
                                    # which is an extern stub marker)
                                    match sexpr.expr:
                                        case EStringLiteral(_, _):
                                            pass
                                        else:
                                            has_real_body = true
                                else:
                                    pass
                        if has_real_body:
                            # Mangle function name and register redirect
                            String bare_name = fdef.name.clone()
                            String mangled = mod_prefix + bare_name
                            call_redirects.put(bare_name, mangled.clone())
                            imported_fns.put(mangled.clone(), true)
                            # Create a renamed copy
                            FunctionDef renamed = FunctionDef(mangled, fdef.params, fdef.return_type, fdef.type_params, fdef.body, fdef.is_expr_body, fdef.throws_type)
                            m.items.push(IFunction(renamed))
                    case IEnum(edef):
                        # Merge imported enums so type_infos has variant info —
                        # this lets the lowerer route bare variant constructors
                        # (IntCol, Red, ...) to their parent enum type, and
                        # lir_lower knows to skip emitting standalone variant
                        # structs. Concrete non-generic only. Mark in
                        # imported_fns with "__imported_type__" prefix so the
                        # lir_lower can skip drop/clone emission (Rust preamble
                        # already provides them via static inline).
                        if edef.type_params.len() == 0:
                            String ename = edef.name.clone()
                            m.items.push(IEnum(edef))
                            imported_fns.put("__imported_type__" + ename, true)
                    case IStruct(sdef):
                        # Merge imported concrete struct so the lowerer's
                        # type_infos can resolve field types — enables proper
                        # field access on imported struct types (self.x where
                        # self is Ptr(ImportedStruct)). Mark with
                        # __imported_type__ prefix so lir_lower / lir_codegen
                        # suppress duplicate struct body and drop/clone
                        # definitions (Rust preamble already provides them).
                        if sdef.type_params.len() == 0:
                            String sname = sdef.name.clone()
                            m.items.push(IStruct(sdef))
                            imported_fns.put("__imported_type__" + sname, true)
                    case IEquip(eqblk):
                        # Filter: real methods have >=2 body stmts, OR expression body,
                        # OR 1 stmt that isn't a string-literal extern stub marker.
                        # Extern stubs look like: method_name(): "abi_symbol"
                        Vector[FunctionDef] real_methods = []
                        int emi = 0
                        while emi < eqblk.methods.len():
                            FunctionDef emdef = eqblk.methods.get(emi).unwrap()
                            bool is_real = emdef.body.len() >= 2 or emdef.is_expr_body
                            if not is_real and emdef.body.len() == 1:
                                Stmt first_s = emdef.body.get(0).unwrap()
                                match first_s:
                                    case SIf(_, _, _):
                                        is_real = true
                                    case SWhile(_, _):
                                        is_real = true
                                    case SFor(_, _, _, _, _):
                                        is_real = true
                                    case SMatch(_, _):
                                        is_real = true
                                    case SReturn(opt_ret):
                                        match opt_ret:
                                            case Some(_):
                                                is_real = true
                                            case None:
                                                pass
                                    case SVarDecl(_, _, _, _, _, _):
                                        is_real = true
                                    case SAssign(_, _):
                                        is_real = true
                                    case SMetaFor(_):
                                        is_real = true
                                    case SMetaIf(_, _):
                                        is_real = true
                                    case SExpr(sexpr):
                                        # Reject string-literal stubs ("extern_abi_name")
                                        match sexpr.expr:
                                            case EStringLiteral(_, _):
                                                pass
                                            else:
                                                is_real = true
                                    else:
                                        pass
                            if is_real:
                                real_methods.push(emdef)
                            emi += 1
                        if real_methods.len() > 0:
                            EquipBlock filtered = EquipBlock(eqblk.target, eqblk.type_params, eqblk.trait_name, real_methods, eqblk.via_field)
                            m.items.push(IEquip(filtered))
                    case IExternBlock(ext_fns):
                        # Extract aliases from extern stubs: body is exactly one
                        # SExpr(EStringLiteral(alias)). Populate call_redirects.
                        int exi = 0
                        while exi < ext_fns.len():
                            FunctionDef ext_fd = ext_fns.get(exi).unwrap()
                            if ext_fd.body.len() == 1:
                                Stmt ext_s = ext_fd.body.get(0).unwrap()
                                match ext_s:
                                    case SExpr(ext_sx):
                                        match ext_sx.expr:
                                            case EStringLiteral(ext_val, _):
                                                call_redirects.put(ext_fd.name.clone(), ext_val.clone())
                                            else:
                                                pass
                                    else:
                                        pass
                            exi += 1
                    else:
                        # Skip structs, enums, traits, etc. from imported modules.
                        # Only functions, equip blocks with real bodies, and
                        # extern aliases are needed.
                        pass
                ji += 1

        pi += 1

    return call_redirects
