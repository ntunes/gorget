# LIR — Low-Level Intermediate Representation.
#
# SSA-form IR between GIR and backends. All implicit operations (drop glue,
# vtable dispatch, closures, coercions) are explicit here.
#
# Identity types use int (not newtypes) for simplicity in the self-host.
# ValueId, SlotId, BlockId, StructId, FuncId, GlobalId are all plain ints.

from std.collections import Vector, Dict
from gir import BorrowOrigin
from gir import SCHED_POOL, SCHED_THREAD, SCHED_INLINE, SCHED_SINGLE

# ── Types ───────────────────────────────────────────────────────

# Concrete machine type — no generics, no ownership qualifiers.
# Encoded as int constants for fast comparison.
const int LT_I8 = 0
const int LT_I16 = 1
const int LT_I32 = 2
const int LT_I64 = 3
const int LT_U8 = 4
const int LT_U16 = 5
const int LT_U32 = 6
const int LT_U64 = 7
const int LT_F32 = 8
const int LT_F64 = 9
const int LT_BOOL = 10
const int LT_PTR = 11
const int LT_VOID = 12
# LT_PTR_TO and LT_STRUCT encode the StructId in high bits:
#   LT_PTR_TO_BASE + struct_id  (ptr to a known struct)
#   LT_STRUCT_BASE + struct_id  (aggregate struct value)
const int LT_PTR_TO_BASE = 1000
const int LT_STRUCT_BASE = 100000

int lir_ptr_to(int struct_id): LT_PTR_TO_BASE + struct_id
int lir_struct(int struct_id): LT_STRUCT_BASE + struct_id

bool lir_is_scalar(int ty):
    if ty < LT_PTR_TO_BASE:
        return ty != LT_VOID
    if ty >= LT_STRUCT_BASE:
        return false
    return true

bool lir_is_aggregate(int ty): ty >= LT_STRUCT_BASE

bool lir_is_integer(int ty):
    return ty >= LT_I8 and ty <= LT_U64

bool lir_is_float(int ty):
    return ty == LT_F32 or ty == LT_F64

bool lir_is_ptr(int ty):
    return ty == LT_PTR or (ty >= LT_PTR_TO_BASE and ty < LT_STRUCT_BASE)

int lir_struct_id(int ty):
    if ty >= LT_STRUCT_BASE:
        return ty - LT_STRUCT_BASE
    return -1

# ── Overflow semantics ──────────────────────────────────────────

const int OVF_TRAP = 0
const int OVF_WRAP = 1

# ── Comparison operators ────────────────────────────────────────

const int CMP_EQ = 0
const int CMP_NE = 1
const int CMP_LT = 2
const int CMP_LE = 3
const int CMP_GT = 4
const int CMP_GE = 5

# ── ABI kinds ───────────────────────────────────────────────────

const int ABI_AUTO = 0
const int ABI_CSTR = 1
const int ABI_BYTE_PTR = 2
const int ABI_GORGET_STRING = 3
const int ABI_SCALAR = 4
const int ABI_PTR = 5
const int ABI_OPAQUE = 6
const int ABI_BY_VALUE = 7
const int ABI_VOID_ELEM = 8
# Output pointer: arg the callee writes the result INTO (e.g.
# gorget_map_iter_key/value arg 2). Drop-elaboration marks the pointee
# slot Initialized so its drop survives (#11). Mirrors Rust AbiKind::OutPtr.
const int ABI_OUT_PTR = 9

# ── Scheduler modes ─────────────────────────────────────────────
# SCHED_POOL/THREAD/INLINE/SINGLE are defined in gir.gg and re-imported
# above (so GirModule.scheduler_mode can carry the mode without a lir→gir
# layering inversion).

# ── Instructions ────────────────────────────────────────────────

# (field_index, value_id) pair used by canonical IStructInit / IEnumInit ops.
struct FieldInit:
    int index
    int value

# Instructions are represented as a tagged enum. Each variant carries
# its operands as struct fields. dst=-1 means no destination.

enum LirInst:
    # Slot access (pre-SSA, lowered by SSA construction)
    ISlotStore(int, int, bool)        # slot, value, is_move
    ISlotLoad(int, int, int)          # dst, slot, ty
    ISlotAddr(int, int)               # dst, slot

    # Constants
    IIConst(int, int, int)            # dst, ty, value (i64)
    IFConst(int, int, int)            # dst, ty, bits (u64 as int)
    IBoolConst(int, bool)             # dst, value
    INullPtr(int)                     # dst
    IFuncAddr(int, int)               # dst, func_id
    IGlobalAddr(int, int)             # dst, global_id
    IStrLit(int, String)              # dst, value
    IParamRef(int, int, int)          # dst, index, ty

    # Arithmetic
    IAdd(int, int, int, int, int)     # dst, ty, lhs, rhs, overflow
    ISub(int, int, int, int, int)     # dst, ty, lhs, rhs, overflow
    IMul(int, int, int, int, int)     # dst, ty, lhs, rhs, overflow
    IDiv(int, int, int, int)          # dst, ty, lhs, rhs
    IRem(int, int, int, int)          # dst, ty, lhs, rhs
    IMod(int, int, int, int)          # dst, ty, lhs, rhs
    # Fault-catch checked arithmetic (error-model.md §11): dst (a bool flag)
    # = "lhs op rhs would fault" (overflow for Add/Sub/Mul; div-by-zero for
    # Div/Rem) WITHOUT trapping or committing the result. A Term/GTBranch on
    # dst routes to the handler; the real op runs only on the no-fault
    # continuation. `fault_op` is an OP_* constant. Emitted only inside an
    # active fault scope; the panic-default arithmetic stays IAdd/IDiv etc.
    IFaultCheck(int, int, int, int, int)   # dst_flag, fault_op, ty, lhs, rhs
    INeg(int, int, int)               # dst, ty, operand

    # Bitwise
    IBitAnd(int, int, int, int)       # dst, ty, lhs, rhs
    IBitOr(int, int, int, int)        # dst, ty, lhs, rhs
    IBitXor(int, int, int, int)       # dst, ty, lhs, rhs
    IBitNot(int, int, int)            # dst, ty, operand
    IShl(int, int, int, int)          # dst, ty, lhs, rhs
    IShr(int, int, int, int)          # dst, ty, lhs, rhs

    # Comparison & Logic
    ICmp(int, int, int, int)          # dst, cmp_op, lhs, rhs
    INot(int, int)                    # dst, operand

    # Type conversions
    IIntCast(int, int, int)           # dst, value, to_ty
    IFloatCast(int, int, int)         # dst, value, to_ty
    IIntToFloat(int, int, int)        # dst, value, to_ty
    IFloatToInt(int, int, int)        # dst, value, to_ty
    IPtrCast(int, int)                # dst, value
    IBitcast(int, int, int)           # dst, value, to_ty

    # Memory
    ILoad(int, int, int)              # dst, ptr, ty
    IStore(int, int)                  # ptr, value
    IFieldPtr(int, int, int, int)     # dst, base, struct_id, field
    IElemPtr(int, int, int, int)      # dst, base, index, elem_size
    IMemset(int, int, int)            # ptr, byte, size
    IMemcpy(int, int, int)            # dst_ptr, src_ptr, size

    # Canonical BIR ops (lowered to concrete memory ops at codegen time).
    # Dst is a heap Ptr; inner_ty identifies the payload size/layout; value is stored at the pointer.
    IBoxAlloc(int, int, int)          # dst, inner_ty, value

    # Address-of: spill an SSA value to a function-scope temp and take its address.
    # Emitted at extern Ptr-ABI arg sites; ty sizes the temp.
    IAddressOf(int, int, int)         # dst, value, ty

    # Struct in-place init: writes each FieldInit(index, value) into the
    # struct pointed to by `target`. Field indices are absolute struct slots;
    # unlisted fields are left untouched. No dst — target is an input pointer.
    IStructInit(int, int, Vector[FieldInit])        # target, struct_id, fields

    # Enum in-place init: writes tag at field 0, then each payload FieldInit.
    # Field indices in `fields` are absolute (caller computes 1 + offset + i).
    IEnumInit(int, int, int, Vector[FieldInit])     # target, struct_id, variant_tag, fields

    # Calls
    ICall(int, int, Vector[int])                       # dst (-1=void), func_id, args
    ICallExtern(int, String, Vector[int], String, Vector[int])  # dst, name, args, original_name, arg_abis
    ICallPtr(int, int, Vector[int])                    # dst (-1=void), callee, args

    # Runtime checks
    IBoundsCheck(int, int)            # index, len
    IDivCheck(int)                    # divisor
    ITrap(String)                     # message

    # Printf
    IPrintf(String, Vector[int])      # fmt, args
    IFprintf(int, String, Vector[int]) # fd, fmt, args

    # Inline C
    IInlineC(int, String)             # dst (-1=none), code

    # Closure packing: env_ptr + call_func → GorgetClosure slot
    IClosurePack(int, int, int, bool) # slot, env_ptr, call_func, needs_adapter

    # Closure dispatch: indirect call through fn_ptr + env
    # kind: 0=CallableParam (void*[2]), 1=EscapedClosure (GorgetClosure struct)
    # args: user arguments (closure excluded). arg_abis: per-arg ABI tags.
    # ret_ty: LIR return type index.
    ICallClosure(int, int, int, Vector[int], Vector[int], int) # dst, kind, closure, args, arg_abis, ret_ty

    # Drop guard: conditional block open/close
    # kind: 0=Bool (flag), 1+=NonZero (kind-1 = byte size)
    IDropGuardOpen(int, int)          # kind, value
    IDropGuardClose

    # Move annotation (dataflow only, no runtime cost — swept by drop elaboration)
    IMoveSlot(int)                    # slot

    # No-op
    INop

# ── Terminators ─────────────────────────────────────────────────

struct SwitchCase:
    int value
    int target
    Vector[int] args

enum LirTerm:
    TRet(int)                         # value
    TRetVoid
    TJump(int, Vector[int])           # target, args
    TBranch(int, int, Vector[int], int, Vector[int])  # cond, then_block, then_args, else_block, else_args
    TSwitch(int, Vector[SwitchCase], int, Vector[int]) # value, cases, default, default_args
    TUnreachable

# ── Blocks ──────────────────────────────────────────────────────

struct BlockParam:
    int value_id
    int ty

struct LirBlock:
    int id
    Vector[BlockParam] params
    Vector[LirInst] insts
    LirTerm term

# ── Slots ───────────────────────────────────────────────────────

struct LirSlot:
    int ty
    String name    # "" if unnamed

# ── Slot provenance ─────────────────────────────────────────────
#
# P2 of the CoW true-lazy keystone: the SINGLE SOURCE OF TRUTH for the
# owned-vs-borrowed-vs-value (read-routing) axis, replacing the `is_ptr`
# SHAPE-heuristic that re-derives it from the LirType range at every read
# site. Projected ONCE from the GIR ownership axis at the GIR→LIR
# slot-creation boundary (`lir_lower.gg`), GATED on the LIR layout axis
# (only POINTER-shaped slots can be OwnedPtr/Borrowed — the read-routing
# decision is about LAYOUT). Read at the consumer sites via a `match`.
#
# Exactly THREE variants (RUN-proven sufficient over the whole corpus):
#   • Value      — value-typed slot; drop reads `&slot`. A scalar/aggregate
#                  slot, or a ptr-shaped owned-VALUE (e.g. Box[T] drops via
#                  `Box__T__drop(&slot)`).
#   • OwnedPtr   — ptr-typed slot OWNS its pointee; drop reads the LOADED
#                  `T*`. The `!`-move resource param (folds the GIR
#                  `owning_param` flag into this variant).
#   • Borrowed   — ptr-typed ALIAS; never owns / never drops. Carries the
#                  GIR `BorrowOrigin` (source provenance) for P3.
enum SlotProvenance:
    PvValue()
    PvOwnedPtr()
    PvBorrowed(BorrowOrigin)

# ── Functions ───────────────────────────────────────────────────

struct LirFunction:
    String name
    Vector[int] params          # LirType for each param
    int return_type             # LirType
    Vector[LirSlot] slots
    Vector[LirBlock] blocks
    int next_value
    bool is_test_fn
    String display_name         # "" if none
    Vector[String] param_names  # "" entries for unnamed
    Vector[bool] const_params
    Vector[int] value_types     # per-value LirType, -1 = None
    # P2 — per-SLOT provenance, parallel to `slots`, indexed by slot-id.
    # Populated by the GIR→LIR slot-creation loop (`lir_lower.gg`). Temp
    # slots created LATER (after that loop) have NO entry, so every read
    # MUST guard `slot < slot_provenance.len()` and treat out-of-range as
    # the no-answer sentinel (fall back to the existing shape test).
    Vector[SlotProvenance] slot_provenance

# ── Struct Definitions ──────────────────────────────────────────

# Enum kind for clone/drop code generation.
const int EK_NOT_ENUM = 0
const int EK_OPTION = 1
const int EK_RESULT = 2
const int EK_GENERAL = 3

struct StructField:
    String name
    int ty                      # LirType

struct LirStructDef:
    String name
    Vector[StructField] fields
    int enum_kind               # EK_* constant
    bool is_union_layout
    int computed_c_size         # -1 if not yet computed
    int computed_c_align        # -1 if not yet computed
    # True iff this is a FAT trait-object box (`Box__<Trait>`, {data, vtable},
    # 16 bytes) rather than a value box or a plain struct. Set ONCE at the two
    # Box registrars in lir_lower.gg (both keyed on the typed
    # `box_inner_is_trait` `_VTable`-registry probe); read by the trait-object
    # construction intercept and the fat trait-box drop branch — replacing the
    # retired 2-field/"vtable"-name shape heuristic (devbook/24 rule 2).
    # Mirrors Rust gg's typed trait-box flag on `lir::StructDef`.
    bool is_trait_box

# Single source of truth for the GorgetMap / GorgetSet runtime struct size.
# MUST match the real C struct in `src/backend/c/runtime/runtime_preamble.c`
# (`typedef struct { ... } GorgetMap;` — 24 pointer/size_t fields × 8 bytes =
# 192 bytes: 19 legacy fields + 5 D39 dense-mode fields appended at struct
# END; `GorgetSet` is a typedef alias) and Rust gg's `src/lir/lower/types.rs`
# (`GorgetMap | GorgetSet => 192`). Over-counting this size inflates every
# enum/union/array layout that embeds a Dict/Set and overflows the stack slot
# in `gorget_array_push`; UNDER-counting it (e.g. reverting to the legacy 152
# after the D39 append) truncates every Dict/Set alloca so the runtime's
# stores off the tail walk into adjacent stack slots — keep all consumers
# reading THIS constant (devbook/24 rule 3 "one source of truth"; pinned by
# `tests/lints.rs::self_host_gorget_map_struct_size`).
const int GORGET_MAP_STRUCT_SIZE = 192

# ── Globals ─────────────────────────────────────────────────────

# Global initializer kinds.
const int GINIT_ZEROED = 0
const int GINIT_FUNC_ADDR = 1
const int GINIT_RUNTIME_CALL = 2
# ADD AT END (do NOT renumber 0/1/2 — MEMORY: mid-enum insert shifts
# ordinals → regressions). Struct-of-FuncAddr init (vtable). Mirrors
# `LirGlobalInit::Struct { struct_id, fields }` (`src/lir/mod.rs:1594-1598`).
const int GINIT_STRUCT = 3
# Const-bytes initializer for a scalar-literal global (`static int x = 0`).
# The `init_expr` holds the rendered C literal (`0LL`, `2.5`, `1`/`0`);
# the C backend emits `<type> <name> = <init_expr>;` at the declaration —
# no runtime synth fn. Mirrors `LirGlobalInit::Bytes` (`src/lir/mod.rs:1594`)
# / `GlobalInit::Bytes` (`src/ir/mod.rs:726`). ADD AT END.
const int GINIT_BYTES = 4
# Address of the backend-synthesized `Box__<inner>__drop` wrapper for the
# carried mangled concrete type name (`box_inner`) — the trait-object
# vtable's `__drop` slot. Distinct from GINIT_FUNC_ADDR because the wrapper
# is not an LIR function (the C backend synthesizes it from the deduped
# GINIT_BOX_DROP_ADDR field set at emit time), so no func_id exists for it.
# Mirrors Rust gg's `LirGlobalInit::BoxDropAddr` (`src/lir/mod.rs`). ADD AT END.
const int GINIT_BOX_DROP_ADDR = 5

# One field of a GINIT_STRUCT global init. For vtables: a FuncAddr by fid
# (method slots) or a BoxDropAddr by concrete name (the `__drop` glue slot).
struct LirGlobalField:
    int kind          # GINIT_FUNC_ADDR / GINIT_BOX_DROP_ADDR / GINIT_ZEROED (→ NULL)
    int func_id       # for GINIT_FUNC_ADDR; -1 otherwise
    String box_inner  # for GINIT_BOX_DROP_ADDR: mangled concrete type name; "" otherwise

struct LirGlobal:
    String name
    int ty                      # LirType
    int init_kind               # GINIT_* constant (now incl. GINIT_STRUCT)
    int init_func_id            # for GINIT_FUNC_ADDR
    String init_expr            # for GINIT_RUNTIME_CALL
    bool is_const
    Vector[LirGlobalField] struct_fields   # for GINIT_STRUCT (NEW, at end)

# ── Externs ─────────────────────────────────────────────────────

struct LirExtern:
    String name
    Vector[int] params          # LirType per param
    int return_type             # LirType
    bool is_variadic
    Vector[int] param_abis      # ABI_* per param
    int return_abi              # ABI_* constant

# ── Spawn Metadata ──────────────────────────────────────────────

struct SpawnParam:
    String name
    String c_type_name

struct CloneParam:
    int param_index
    String gir_type_name
    # The carrier's TYPED method-prefix (`gorget_channel` / `gorget_shared`),
    # read from resource_meta_for at the GIR→LIR re-derive site (where gmod is
    # in scope). Codegen routes the retain/release runtime symbols off THIS
    # VALUE — never an inline mangled-name prefix test (a Channel-name
    # `starts_with`) on the gir_type_name (Core #2: that would decide the
    # carrier family from the mangled name at the emit site, and the lint
    # counts it). Channel → retain
    # gorget_channel_retain / release gorget_channel_release; Shared/Weak →
    # retain gorget_shared_clone / release gorget_shared_drop.
    String method_prefix

struct LirSpawnedFn:
    String fn_name
    Vector[SpawnParam] params
    String ret_c_type
    Vector[int] ref_param_indices
    Vector[CloneParam] clone_params

struct LirThreadSpawnedFn:
    String fn_name
    # SYMBOL-NAME axis: the `Thread__{name}` symbol suffix (e.g. "int64_t",
    # "Vector__int64_t", "Point"; "void" for a unit fn), copied verbatim
    # from `ThreadSpawnRec.ret_name` at the GIR→LIR copy. Symbols emitted
    # from it MUST match the call sites byte-for-byte. The C-spelling axis
    # (the ctx `_result` field / join return C type) is resolved separately
    # at emit by `thread_payload_c_type` (lir_codegen). Mirrors Rust gg's
    # `ThreadSpawnedFn.ret_name`.
    String ret_name
    # LIR type of the join payload (LT_VOID for a void fn), mapped from the
    # typed `ThreadSpawnRec.ret_tid` at the GIR→LIR copy. Read by the
    # codegen call-extern type inference to type `Thread__T__join` results
    # (mirrors `TraitDispatchRequest.ret_lir_ty`).
    int ret_lir_ty
    # Requested pthread stack size in bytes. 0 = OS default (plain wrapper,
    # byte-identical to the pre-stack-size emit); non-zero = a sized wrapper.
    int stack_size

# A `d.get_or(k, default)` inline-wrapper REQUEST. Mirrors the
# thread_spawned_fns channel: a TYPED monomorphization-request recorded at
# the CLASSIFIED LIR call-mapping site (map_runtime_name's `coll_cat ==
# "GorgetMap"` + `method == "get_or"` arm), consumed by
# emit_dict_get_or_wrappers at codegen. There is no `gorget_map_get_or`
# runtime symbol — the wrapper IS the generated dispatch target the LIR
# map-method routing returns by name. Recording the request UPSTREAM (where
# the receiver is already typed CkDict via type_runtime_map) lets codegen
# emit each wrapper without re-deriving "this call is a Dict/HashMap get_or"
# from `inst_name.starts_with("Dict__"/"HashMap__")` (a wrong-layer read).
# `mangled_name` is the `Dict__K__V__get_or` / `HashMap__K__V__get_or` C
# symbol (the emit-boundary contract with the LIR call). `key_c` / `val_c`
# are the K and V type names read from the TYPED `coll_key_type_map` /
# `coll_val_type_map` (NOT parsed from the symbol). Deduped by mangled_name
# at the write site (Dict and HashMap of the same K/V share a body — the
# names differ so both are recorded).
struct DictGetOrReq:
    String mangled_name
    String key_c
    String val_c
    # is_put distinguishes `get_or` (read-only, map BY VALUE) from
    # `get_or_put` (mutating, map BY POINTER — the miss-side insert must
    # persist into the caller's map). TYPED metadata; downstream reads this
    # flag, never a `__get_or_put` suffix test.
    bool is_put

# A `b.get()` / `b.set(v)` inline-wrapper REQUEST. The Box analogue of
# DictGetOrReq: a TYPED monomorphization-request recorded at the CLASSIFIED
# LIR call-mapping site (map_runtime_name's `type_category_for_name(name) ==
# "Box"` + `method == "get"/"set"` arm), consumed by emit_box_method_wrappers
# at codegen. There is no `gorget_box_get`/`gorget_box_set` runtime symbol —
# the wrapper IS the generated dispatch target the LIR box-method routing
# returns by name. Recording the request UPSTREAM (where the receiver is
# already typed "Box" via type_runtime_map, with the inner type on the typed
# coll_elem_type_map channel) lets codegen emit each wrapper without
# re-deriving "this is a Box get/set" from a Box mangled-prefix test on the
# call name (a wrong-layer read). `inner_c` is the boxed element's C type name read from
# the TYPED coll_elem_type_map (NOT parsed from the symbol); `is_set`
# distinguishes the get vs set body. Deduped by (inner_c, is_set) at the
# write site (one wrapper per inner type per accessor).
struct BoxWrapperReq:
    String inner_c
    bool is_set

# A `Box__<Trait>__<method>` trait-object DISPATCH thunk REQUEST — the
# trait-object analogue of BoxWrapperReq. A TYPED monomorphization-request
# recorded at the CLASSIFIED LIR call-mapping site (map_runtime_name's
# `Box__<Trait>__<method>` arm, gated on `<Trait>_VTable` being a registered
# type — the trait-box discriminator), consumed by emit_trait_dispatch_thunks
# at codegen. There is no `Box__Greeter__greet` runtime/user symbol — the
# thunk IS the generated dispatch target: it loads `self->vtable`, then
# `vtable->slot<method_idx>`, then `self->data`, and indirect-calls
# `fnp(data, args...)`. Mirrors Rust gg's synth trait helper
# (`src/bir/synth.rs:emit_trait_helper_body:1265`). `trait_name` is the
# mangled trait (`Greeter`); `method` the method name (`greet`); `method_idx`
# the VTable slot; `ret_is_void` picks the return shape; `param_tys` are the
# user param LIR type ids (self EXCLUDED — the thunk's `void* self` receiver is
# emitted implicitly), each an aggregate `LT_PTR` (by-pointer, e.g. a `String`
# param → `void*`) or a scalar (`LT_I64`/`LT_BOOL`/`LT_F64`). Read via
# `c_type_name` at emit for the thunk's C signature AND the vtable-slot fn-ptr
# cast, so the thunk forwards each user arg with the PRECISE type the impl fn
# was emitted with (cleaner than Rust's uniform `(void*)`-cast-everything synth
# thunk, which can't spell a `double` param). `ret_lir_ty` is the method's REAL LIR
# return type (LT_VOID / LT_I64 / LT_F64 / LT_BOOL / a GorgetString struct id
# for a String return, …), threaded from the trait method decl's return_type
# so the thunk's C signature + the vtable-slot fn-ptr cast + `return` carry the
# concrete type (mirrors Rust `fn_ret = self.map_type(&fn_ret)` read off the
# VTable FnPtr field, `src/lir/lower/insts.rs:2550`). A non-void thunk that
# discarded the return (the void-only keystone shape) crashed a String/pointer
# return via a deref-of-0. Deduped by (trait_name, method).
struct TraitDispatchReq:
    String trait_name
    String method
    int method_idx
    bool ret_is_void
    Vector[int] param_tys
    int ret_lir_ty

# A `s.get()` / `s.at(i)` / `s.set_at(i, v)` / `s.slen()` inline-wrapper REQUEST
# for an EXPLICIT `Shared[T]` accessor. The Shared analogue of BoxWrapperReq: a
# TYPED monomorphization-request recorded at the CLASSIFIED LIR call-mapping site
# (map_runtime_name's `gorget_shared` prefix arm, scoped to the 4 explicit
# methods), consumed by emit_shared_method_wrappers at codegen. There is no bare
# `gorget_shared_get`/`_at`/`_set_at`/`_slen` runtime symbol — these wrappers ARE
# the generated dispatch target the LIR shared-method routing returns by name
# (the `Shared__<T>__<method>` mangled symbol). They delegate to the runtime
# primitives `gorget_shared_get_ptr` / `gorget_shared_array_{get,set,len}`.
#
# Unlike Box (which rebuilds `Box__<inner>` from inner_c), Shared has TWO shapes
# (`Shared__int64_t` vs `Shared__Vector__int64_t`) that can't be reconstructed
# from inner_c alone, so the FULL wrapper `type_name` is carried verbatim (the
# incoming mangled symbol's type prefix). `inner_c` is the resolved element C
# type (read from the TYPED coll_elem_type_map, NOT parsed from the symbol):
# for `Shared__int64_t` it is `int64_t`; for `Shared__Vector__int64_t` it is the
# Vector mangled name `Vector__int64_t` (codegen strips the `Vector__` prefix to
# get the per-element type for at/set_at). `kind` is the typed method tag
# (`get`/`at`/`set_at`/`slen`/`clone`) — the codegen reads it instead of
# re-deriving the method from the mangled name. `clone` (round-17 Inc-1) emits
# `return gorget_shared_clone(self)` (an atomic strong++, NOT a byte-copy — the
# byte-copy under-counts the strong ref and double-frees / UAFs at teardown).
# Deduped by (type_name, kind) at the write site.
struct SharedWrapperReq:
    String type_name
    String inner_c
    String kind

# ── Test/Bench Metadata ────────────────────────────────────────

struct LirTestFn:
    String fn_name
    String display_name
    bool should_panic
    String expected_panic_msg   # "" if none
    bool skipped
    String skip_reason          # "" if none
    int timeout_ms              # -1 if none

struct LirBenchFn:
    String fn_name
    String display_name

# ── Drop Metadata ───────────────────────────────────────────────

struct FieldDrop:
    String field_name
    String drop_fn_name
    String field_type_name

struct EnumVariantDrop:
    int variant_index
    String variant_name
    String field_name
    String drop_fn_name
    String field_type_name

struct TypeDropInfo:
    String drop_fn_name
    Vector[FieldDrop] field_drops
    String user_drop_fn         # "" if none
    Vector[EnumVariantDrop] enum_variants  # empty if not enum

# ── Module ──────────────────────────────────────────────────────

struct LirModule:
    Vector[LirStructDef] structs
    Vector[LirGlobal] globals
    Vector[LirFunction] functions
    Vector[LirExtern] externs
    String source_filename       # "" if none
    Vector[LirSpawnedFn] spawned_fns
    Vector[LirThreadSpawnedFn] thread_spawned_fns
    Vector[LirTestFn] test_fns
    Vector[LirBenchFn] bench_fns
    bool has_suite_setup
    bool has_suite_teardown
    int scheduler_mode           # SCHED_* constant
    String trace_filename        # "" if none
    bool is_test_module
    bool hot_reload
    String hot_reload_state_type # "" if none
    int hot_reload_state_hash
    bool hot_reload_has_reload_fn
    Dict[String, Vector[FieldDrop]] recursive_drop_structs
    Dict[String, Vector[EnumVariantDrop]] recursive_drop_enums
    Dict[String, bool] drop_collision_types
    Dict[String, TypeDropInfo] type_drop_fns
    # Struct/enum names imported from other modules — their C struct body and
    # drop/clone functions are already provided by the Rust-generated preamble,
    # so the self-host must not emit them again.
    Dict[String, bool] imported_type_names
    # Enum variant constructor → parent enum name. Used by lir_codegen to
    # rewrite `VariantName(args)` calls into inline struct initializers.
    Dict[String, String] enum_variant_parent
    # Enum variant constructor → ordinal tag (position in source enum decl).
    # Necessary for unit variants whose index can't be reconstructed from the
    # C struct's payload-field list: only variants-with-data contribute fields,
    # so the fallback tag-by-position was WRONG for TkEof / TkPlus / etc.
    # Downstream: TkEof() constructor needs tag=63 (its enum ordinal), not
    # the 9 that the struct-field-scan heuristic produced.
    Dict[String, int] enum_variant_tag
    # Phase A — typed resource metadata.
    # Maps monomorphized type names to their runtime C struct name.
    # Populated once in lower_type_defs; downstream code reads this instead
    # of re-deriving from starts_with name patterns.
    # Examples: "Vector__int64_t" → "GorgetArray",
    #           "Dict__GorgetString__int64_t" → "GorgetMap",
    #           "Box__Expr" → "Box", "Guard__Mutex__X" → "Guard".
    Dict[String, String] type_runtime_map
    # Phase A — maps monomorphized type names to their C method prefix, for
    # types that use a simple "gorget_prefix_method" naming scheme (no special
    # per-method dispatch needed).  Populated at type-registration time.
    # Examples: "Mutex__int64_t" → "gorget_mutex",
    #           "ReadGuard__int64_t" → "gorget_read_guard".
    Dict[String, String] type_method_prefix_map
    # Phase A — element type of Vector/Set/Deque/Heap collections.
    # "Vector__int64_t" → "int64_t", "Set__GorgetString" → "GorgetString".
    # Populated at registration time; avoids starts_with extraction downstream.
    Dict[String, String] coll_elem_type_map
    # Phase A — key type of Dict/HashMap collections.
    # "Dict__String__int64_t" → "String", "HashMap__bool__String" → "bool".
    Dict[String, String] coll_key_type_map
    # Phase A — value type of Dict/HashMap collections.
    # "Dict__String__int64_t" → "int64_t", "HashMap__bool__String" → "String".
    Dict[String, String] coll_val_type_map
    # Phase A — constructor base name for Dict/Set variants.
    # "Dict__K__V" → "gorget_dict_new", "HashMap__K__V" → "gorget_map_new",
    # "Set__T" → "gorget_ordered_set_new", "HashSet__T" → "gorget_set_new".
    # Populated at registration time for O(1) lookup without starts_with.
    Dict[String, String] coll_ctor_fn_map
    # `d.get_or(k, default)` inline-wrapper REQUESTS — the typed
    # monomorphization-request registry. Populated by map_runtime_name's
    # classified get_or arm (the typed CkDict site), drained by
    # emit_dict_get_or_wrappers at codegen. Replaces the read-side
    # `inst_name.starts_with("Dict__"/"HashMap__")` instruction scan with a
    # write-through typed channel (Layering rule 4, "resolve once, write
    # through"). Empty for modules with no get_or call. Appended AT END to
    # avoid shifting positional ctor call sites.
    Vector[DictGetOrReq] dict_get_or_requests
    # `b.get()` / `b.set(v)` inline-wrapper REQUESTS — the Box analogue of
    # dict_get_or_requests. Populated by map_runtime_name's classified Box
    # get/set arm (the typed `type_category_for_name == "Box"` site, inner
    # type read from coll_elem_type_map), drained by emit_box_method_wrappers
    # at codegen. Replaces the read-side Box mangled-prefix +
    # `__get`/`__set`-suffix instruction scan with a write-through typed
    # channel (Layering rule 4). Empty for modules with no Box get/set call.
    # Appended AT END to avoid shifting positional ctor call sites.
    Vector[BoxWrapperReq] box_wrapper_requests
    # `Box__<Trait>__<method>` trait-object dispatch-thunk REQUESTS — the
    # trait-object analogue of box_wrapper_requests. Populated by
    # map_runtime_name's `Box__<Trait>__<method>` arm (gated on the
    # `<Trait>_VTable` registered-type discriminator), drained by
    # emit_trait_dispatch_thunks at codegen. Each thunk does vtable-index +
    # indirect-call (mirrors Rust `src/bir/synth.rs:emit_trait_helper_body`).
    # Empty for modules with no Box[Trait] dispatch. Inserted right after
    # box_wrapper_requests (before shared_wrapper_requests); the sole
    # `new_lir_module` ctor call was updated in lockstep, so no positional
    # ctor site shifted.
    Vector[TraitDispatchReq] trait_dispatch_requests
    # `s.get()` / `s.at(i)` / `s.set_at(i, v)` / `s.slen()` inline-wrapper
    # REQUESTS for EXPLICIT `Shared[T]` accessors — the Shared analogue of
    # box_wrapper_requests. Populated by map_runtime_name's `gorget_shared`
    # prefix arm (scoped to the 4 explicit methods), drained by
    # emit_shared_method_wrappers at codegen. Replaces the bare-undefined
    # `gorget_shared_<method>` fallthrough with a typed per-type wrapper request
    # (Layering rule 4, mirrors the Box machinery). Empty for modules with no
    # explicit Shared accessor call. Appended AT END to avoid shifting positional
    # ctor call sites.
    Vector[SharedWrapperReq] shared_wrapper_requests

# ── LirFunction helpers ─────────────────────────────────────────

int lir_fn_next_value(LirFunction &f):
    int id = f.next_value
    f.next_value = f.next_value + 1
    return id

int lir_fn_add_slot(LirFunction &f, int ty, String name):
    int id = f.slots.len()
    f.slots.push(LirSlot(ty, name))
    return id

int lir_fn_add_block(LirFunction &f):
    int id = f.blocks.len()
    Vector[BlockParam] empty_params = []
    Vector[LirInst] empty_insts = []
    f.blocks.push(LirBlock(id, empty_params, empty_insts, TUnreachable()))
    return id

# Append an instruction to block `bb`'s instruction list, IN PLACE.
#
# Mirrors Rust's `self.lir_func.block_mut(bb).push_inst(inst)`
# (src/lir/lower/mod.rs:1480). The `.get(bb).unwrap()` returns a BORROW
# of the block (Option[Ref] → GtPtr alias, zero-copy) and `.insts.push`
# mutates the block's vector through that alias. This is O(1) amortised.
#
# This REPLACES the old `LirBlock blk = f.blocks.get(bb).unwrap();
# blk.insts.push(inst); f.blocks.set(bb, blk)` get-mutate-set idiom, which
# bound the block to a VALUE local — deep-cloning the ENTIRE block (its
# whole, growing `insts` vector) on every single instruction emitted.
# That made `lower_operand`/`lower_instruction` O(n^2) in block size and
# blew the self-host's `lower_gir_to_lir` to ~13 GB (OOM). The clone was a
# CoW-contract violation: a read (`.get()`) must borrow, not deep-copy.
void lir_push_inst(LirFunction &f, int bb, LirInst inst):
    f.blocks.get(bb).unwrap().insts.push(inst)

# Set block `bb`'s terminator IN PLACE. Mirrors Rust's
# `block.terminator = term` via `block_mut(bb)` (src/lir/lower/mod.rs:1490).
# Same borrow-not-clone rationale as `lir_push_inst`.
void lir_set_term(LirFunction &f, int bb, LirTerm term):
    f.blocks.get(bb).unwrap().term = term

# SINGLE SOURCE OF TRUTH for the "this runtime fn returns a raw C string
# (`const char*`) and a `GorgetString`-typed slot needs the
# `gorget_str_from_cstr` wrap" axis. Two complementary wrap mechanisms read
# this set: EMIT (`is_cstr_returning_fn`, lir_codegen.gg — wraps the raw call
# when its LIR result type is already GorgetString) and LOWERING
# (`is_cstr_returning_call`, lower_types.gg — inserts the coercion at SVarDecl
# when the raw result stays cstr). They were two hand-synced name-lists that
# nearly diverged during the loader work; both now delegate here. STOPGAP: the
# durable end-state is TYPED cstr provenance on the call (mirror Rust's
# `ValueOrigin::CStr` / `AbiKind::CStr` return ABI, src/lir/types.rs:982),
# retiring this name-list entirely. Until then, add new cstr-returning runtime
# fns HERE ONLY — `tests/lints.rs cstr_return_registry_single_source` enforces
# the two siblings stay pure delegations.
bool runtime_fn_returns_cstr(String name):
    if name == "gorget_getenv" or name == "gorget_getcwd" or name == "gorget_platform":
        return true
    if name == "gorget_parse_last_error":
        return true
    if name == "gorget_path_join" or name == "gorget_path_parent" or name == "gorget_path_basename":
        return true
    if name == "gorget_path_extension" or name == "gorget_path_stem":
        return true
    if name == "gorget_path_normalize" or name == "gorget_path_absolute":
        return true
    if name == "gorget_input" or name == "gorget_readline":
        return true
    if name == "gorget_format_time":
        return true
    return false

# ── LirModule helpers ───────────────────────────────────────────

int lir_mod_add_struct(LirModule &m, LirStructDef sdef):
    int id = m.structs.len()
    m.structs.push(sdef)
    return id

int lir_mod_add_global(LirModule &m, LirGlobal g):
    int id = m.globals.len()
    m.globals.push(g)
    return id

int lir_mod_add_function(LirModule &m, LirFunction f):
    int id = m.functions.len()
    m.functions.push(f)
    return id

LirModule new_lir_module(int sched):
    Vector[LirStructDef] structs = []
    Vector[LirGlobal] globals = []
    Vector[LirFunction] functions = []
    Vector[LirExtern] externs = []
    Vector[LirSpawnedFn] spawned = []
    Vector[LirThreadSpawnedFn] thread_spawned = []
    Vector[LirTestFn] tests = []
    Vector[LirBenchFn] benches = []
    Dict[String, Vector[FieldDrop]] rec_drop_s = {}
    Dict[String, Vector[EnumVariantDrop]] rec_drop_e = {}
    Dict[String, bool] drop_coll = {}
    Dict[String, TypeDropInfo] type_drops = {}
    Dict[String, bool] imported_t = {}
    Dict[String, String] evp = {}
    Dict[String, int] evt = {}
    Dict[String, String] trt = {}
    Dict[String, String] tmpm = {}
    Dict[String, String] cet = {}
    Dict[String, String] ckt = {}
    Dict[String, String] cvt = {}
    Dict[String, String] ccf = {}
    Vector[DictGetOrReq] dgor = []
    Vector[BoxWrapperReq] bwr = []
    Vector[TraitDispatchReq] tdr = []
    Vector[SharedWrapperReq] swr = []
    return LirModule(structs, globals, functions, externs, "", spawned, thread_spawned, tests, benches, false, false, sched, "", false, false, "", 0, false, rec_drop_s, rec_drop_e, drop_coll, type_drops, imported_t, evp, evt, trt, tmpm, cet, ckt, cvt, ccf, dgor, bwr, tdr, swr)
