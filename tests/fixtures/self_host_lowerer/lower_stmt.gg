from lower_types import prim_name_to_type, spanned_type_to_name, mangle_type_name, all_return_nominals_registered, setup_concrete_trait_subs, prim_to_c_name, type_to_c_name, resolved_to_c_name, register_tuple_type, resolved_to_gir_type, lookup_expr_gir_type, bare_method_targ_c_name, map_ast_type, map_fn_return_type, type_id_to_name, binop_method_name, enum_variant_parent, is_type_constructor, allocator_constructor_runtime_name, sync_constructor_runtime_name, allocator_type_destroy_name, local_type_name, type_id_to_base_name, resolve_field_gir_type, record_field_enum_category, is_known_field_type_name, lower_float_const_ident, lower_fn_addr_ident, lower_static_ref_ident, lower_nullary_variant_ident, lower_metaop_ident, try_register_static_runtime_call, static_is_literal_init, static_is_scalar_literal_init, static_init_fn_name, scalar_static_c_literal, register_scalar_static, collection_ctor_init_expr, try_register_collection_ctor_static, try_register_struct_ctor_static, register_literal_static, build_static_init_fn, gmod_next_closure_id, infer_method_return_type, builtin_call_return_type, collection_element_type, index_value_type_name, is_cstr_returning_call, is_string_local, is_string_type_id, is_ptr_to_string_type_id, is_resource_field_type, register_optionlike_resource, is_resource_type_name, map_binop, map_compound_binop, emit_compound_arith, is_comparison, map_cmpop
from lower_expr import block_terminated, lower_block_expr, lower_stmt_as_tail_value, lower_if_chain_expr, refine_local_type, lower_expr, lower_expr_inner, apply_container_hint_for_ctor_arg, lower_call, guard_field_deref_base, box_deref_inner_name
from lower_expr import register_shared_carrier_type, emit_shared_mutex_lock_get, emit_shared_mutex_lock_set
from lower_expr import register_rwlock_carrier_type, register_atomic_carrier_type, atomic_runtime_prefix
from lower_expr import emit_shared_read, emit_shared_write, emit_shared_compound

# ── Statement lowering ───────────────────────────────────

void lower_stmt(LowerCtx &ctx, Stmt stmt, GirModule &gmod, bool is_main):
    match stmt:
        case SVarDecl(stype, name, init_expr, _, shared_kind, _):
            # ── Shared-variable carrier model (round-16 Phase 1 + round-33
            # override strategies) ─────────
            # `shared int x = 0` (shared_kind==1 = auto → ArcMutex),
            # `shared(rwlock) int x` (2 → RWLock carrier) and
            # `shared(atomic) int x` (3 → AtomicInt/AtomicBool carrier) all
            # mint a hidden sync carrier + a facade local; reads/writes of
            # `x` route through the carrier per kind. Mirrors Rust gg's four
            # strategy arms (`src/ir/lowering/stmts/mod.rs:1449-1640`).
            # Gated to a SCALAR inner (the only shape the chains handle;
            # a non-scalar `shared` falls through to the plain var-decl
            # path — a live gap, filed).
            if shared_kind >= 1 and shared_kind <= 3:
                int shc_inner_ty = map_ast_type(stype, &gmod)
                if shc_inner_ty < PRIM_COUNT and shc_inner_ty != UNIT_TYPE:
                    lower_shared_var_decl(&ctx, name, init_expr, shc_inner_ty, shared_kind, &gmod)
                    return
            # Facet 2 — tuple destructure VarDecl. The parser packs a tuple
            # binding pattern (`auto a, b = expr`, `(int a, String b) = expr`,
            # `auto (x, y) = expr`) into ONE SVarDecl whose `name` is the
            # literal parenthesized string `"(a, b)"` (parser.gg:3182-3208).
            # Lower the init to a tuple VALUE, then project each sub-name to its
            # `_N` field via the shared `bind_tuple_destructure`. Without this
            # the whole `"(a, b)"` string `nl_put`s and every `print(a)` hits
            # `unknown identifier 'a'`. (Mirrors Rust's tuple-pattern desugar.)
            if name.starts_with("(") and name.ends_with(")"):
                # Hint the init's expected type to the declared tuple type so
                # an `(int, String) (a, b) = (…)` literal init / a Result-peel
                # element resolves correctly (no-op for `auto`).
                int td_prev_et = ctx.expected_type
                int td_decl_ty = map_ast_type(stype, &gmod)
                if td_decl_ty != I64_TYPE and td_decl_ty != UNIT_TYPE:
                    ctx.expected_type = td_decl_ty
                int td_tuple = lower_expr(&ctx, init_expr, &gmod)
                ctx.expected_type = td_prev_et
                td_tuple = maybe_auto_propagate(&ctx, td_tuple, &gmod)
                String td_inner = name.substring(1, name.len() - 1)
                Vector[String] td_names = td_inner.split(", ")
                bind_tuple_destructure(&ctx, td_tuple, td_names, &gmod)
                return
            # Element-type hint for container literals: `Vector[T] x = []`
            # needs `gorget_array_new(sizeof(T))`, not the hardcoded 8.
            # Lift T from stype and park it on ctx; the EArrayLiteral /
            # EDictLiteral handlers consume and clear it. Without this hint
            # every aggregate Vector got elem_size=8, so pushes of 128-byte
            # LirStructDef structs corrupted adjacent elements — stage-1
            # crashed in lower_type_defs's `safe_get(i)` memcpy.
            match init_expr.expr:
                case EArrayLiteral(_):
                    match stype.ty:
                        case TNamed(tn_v, targs_v):
                            if (tn_v == "Vector" or tn_v == "Array" or tn_v == "Set" or tn_v == "HashSet" or tn_v == "OrderedSet") and targs_v.len() >= 1:
                                SpannedType elem_st = targs_v.get(0).unwrap()
                                # type_to_c_name may return a view (literal or
                                # borrowed slice); clone so the String outlives
                                # the temporary.
                                String vec_tc = type_to_c_name(elem_st, &gmod)
                                ctx.pending_vec_elem_tyname = vec_tc.clone()
                        else:
                            pass
                case EDictLiteral(_, _):
                    match stype.ty:
                        case TNamed(tn_d, targs_d):
                            if (tn_d == "Dict" or tn_d == "HashMap" or tn_d == "Map" or tn_d == "OrderedDict") and targs_d.len() >= 2:
                                SpannedType key_st = targs_d.get(0).unwrap()
                                SpannedType val_st = targs_d.get(1).unwrap()
                                String key_tc = type_to_c_name(key_st, &gmod)
                                String val_tc = type_to_c_name(val_st, &gmod)
                                ctx.pending_dict_key_tyname = key_tc.clone()
                                ctx.pending_dict_val_tyname = val_tc.clone()
                                ctx.pending_dict_ordered = (tn_d == "Dict" or tn_d == "OrderedDict")
                        else:
                            pass
                else:
                    pass
            # Expected-type propagation: mirrors Rust gg's `lower_var_decl`
            # at `src/ir/lowering/stmts/mod.rs:477-487`. Setting
            # `ctx.expected_type` to the declared local type BEFORE
            # lowering the init expression lets reader sites
            # (bare `Ok`/`Error`/`Some`/`None` ctors, bare `None`
            # literal, EIdentifier) resolve a context-dependent type
            # the local expression shape cannot determine alone — so
            # the init's dst slot is typed to the declared shape
            # upstream, never round-tripped through a wrong slot type.
            int prev_expected_vd = ctx.expected_type
            int declared_ty_pre = map_ast_type(stype, &gmod)
            if declared_ty_pre != I64_TYPE and declared_ty_pre != UNIT_TYPE:
                ctx.expected_type = declared_ty_pre
            int val = lower_expr(&ctx, init_expr, &gmod)
            ctx.expected_type = prev_expected_vd
            # D10(a) (decisions.md, ratified 2026-07-06): a mutable-borrow BIND
            # (`auto r = &b` / `auto r = &b.field`) is a TYPECHECK ERROR
            # (`E_LocalBorrowBind` in Rust gg; `DkLocalBorrowBind` in
            # typecheck.gg's `check_local_borrow_bind`) — an `EMutableBorrow`
            # init can no longer reach a valid lowering. The round-38 T-D
            # write-through intercept that used to live here (bind `r` as a
            # LoBorrowed `GtMutPtr` alias of the source slot) is RETIRED with
            # the form itself.
            # Auto-propagate a `throws` call captured into a non-Result local
            # (`int v = might()` unwraps; `Result[int,E] r = might()` keeps the
            # raw Result so the user can match/destructure it). Skip when the
            # declared destination type IS a Result__ (don't unwrap into it).
            if not (enum_category_of(&gmod, declared_ty_pre).category == ENUM_CAT_RESULT):
                val = maybe_auto_propagate(&ctx, val, &gmod)
            # closure Phase 2 Step A: record `<fn>\0<varname>` →
            # `__Closure_<cid>` when the init is a closure, so the re-pointed
            # named-spawn pass can wire `spawn varname()`'s wrapper to the
            # closure's make-site cid. The just-pushed record is the last
            # entry in lifted_closures. Keyed by current fn name + NUL +
            # varname so two functions' `auto f = …` don't collide.
            match init_expr.expr:
                case EClosure(_, _):
                    int cvc_n = gmod.lifted_closures.len()
                    if cvc_n > 0:
                        int cvc_cid = gmod.lifted_closures.get(cvc_n - 1).unwrap().cid
                        gmod.closure_var_cids.put(ctx.current_fn_name + "\0" + name, "__Closure_" + int_to_str(cvc_cid))
                case EImplicitClosure(_):
                    int icvc_n = gmod.lifted_closures.len()
                    if icvc_n > 0:
                        int icvc_cid = gmod.lifted_closures.get(icvc_n - 1).unwrap().cid
                        gmod.closure_var_cids.put(ctx.current_fn_name + "\0" + name, "__Closure_" + int_to_str(icvc_cid))
                else:
                    pass
            int var_type = ctx.locals.get(val).unwrap().type_id
            # Prefer the declared type when it carries more info than the
            # init expression's inferred type. This recovers the Vector[T]
            # parametrization from e.g. `Vector[String] cmd_args = args()`
            # — the init would otherwise type the local as the runtime's
            # bare GorgetArray, losing the element type.
            int declared_ty = map_ast_type(stype, &gmod)
            if declared_ty != I64_TYPE and declared_ty != UNIT_TYPE and declared_ty != var_type:
                # Accept the declared type if it's a more specific monomorphized
                # collection (e.g. Vector__GorgetString vs GorgetArray).
                String declared_name = type_id_to_name(declared_ty, &gmod)
                String inferred_name = type_id_to_name(var_type, &gmod)
                if declared_name.contains("__") and not inferred_name.contains("__"):
                    var_type = declared_ty
            # cstr → String coercion at the boundary: `String err =
            # _parse_last_error()` where the extern returns `cstr`. Without
            # this, the cstr pointer gets stored into a Str slot and
            # subsequent `err.len()` calls treat the 8-byte pointer as a
            # 40-byte Str struct — the `len` field read aliases adjacent
            # stack and zeroes unrelated locals. Mirrors Rust's
            # `extern_cstr_return_vals` handling in
            # `src/backend/c_lir/mod.rs` which wraps the value with
            # `gorget_str_from_cstr` when the slot is Str-typed and the
            # source is a cstr-returning extern call.
            int gs_tid_decl = lookup_or_register_named(&gmod, "GorgetString")
            # `var_type != gs_tid_decl` is the companion guard for the unified
            # cstr registry (runtime_fn_returns_cstr, lir.gg): the LOWERING
            # coercion fires ONLY when the raw init result is still cstr. When
            # the raw result is already GorgetString (e.g. getenv, which
            # runtime_fn_return_type types as GorgetString → the EMIT side
            # wraps it), this guard skips LOWERING so the value is wrapped by
            # exactly one mechanism. Without it, feeding the full 14-name set
            # to both sites double-wraps getenv → cc error "expected
            # 'const char *' but argument is of type 'Str'".
            if declared_ty == gs_tid_decl and var_type != gs_tid_decl and is_cstr_returning_call(init_expr, &gmod):
                int coerced = add_local(&ctx, gs_tid_decl, None)
                # gorget_str_from_cstr reads the cstr pointer to build a
                # new GorgetString — borrow.
                Vector[Operand] cstr_args = [op_consume(&ctx, &gmod, val, CkCallArgBorrow())]
                emit(&ctx, GICallExtern(coerced, "gorget_str_from_cstr", cstr_args))
                val = coerced
                var_type = gs_tid_decl
            # Auto-box closure coercion: `Box[Callable[..]] f = (n): n+100`.
            # The init lowers to a bare 16-byte GorgetClosure VALUE; assigning
            # it straight into a `Box__…` slot (`typedef void*`) is a C type
            # error (incompatible types from 'GorgetClosure'). The explicit
            # `Box.new(closure)` form already routes through lower_call("Box")
            # → emit_box_alloc; mirror it here by synthesizing the Box ctor
            # so the closure is heap-boxed identically. GUARD ON THE INIT-EXPR
            # SHAPE (a closure literal), NOT on the val's GIR type: a name-shape
            # guard on the val's type (excluding already-boxed values) DOUBLE-
            # boxes the `Box.new(closure)` forms (their result mistypes as I64,
            # so the name-guard mis-fires → ASan heap-overflow). Box-ness of the
            # declared type is read via the TYPED `box_kind` channel
            # (`box_deref_inner_name` → Some, the same helper the `*b` deref
            # sites use), never a name prefix. Mirrors Rust gg's auto-box
            # coercion at the var-decl boundary.
            bool init_is_closure_lit = false
            match init_expr.expr:
                case EClosure(_, _):
                    init_is_closure_lit = true
                case EImplicitClosure(_):
                    init_is_closure_lit = true
                else:
                    pass
            if init_is_closure_lit and declared_ty != I64_TYPE and declared_ty != UNIT_TYPE:
                String declared_box_name = type_id_to_name(declared_ty, &gmod)
                match box_deref_inner_name(declared_box_name, &gmod):
                    case Some(_):
                        # Heap-box the closure value via the canonical Box ctor
                        # (GICall "Box" → emit_box_alloc / IBoxAlloc). The arg is
                        # consumed OWNING: the fresh closure temp is dead after
                        # this, so op_consume routes it as a move into the box
                        # (no clone). The box dst is the declared Box__… type so
                        # downstream SVarDecl binding sees a box exactly as it
                        # would for `Box.new(closure)`.
                        int box_dst = add_local(&ctx, declared_ty, None)
                        Vector[Operand] box_ctor_args = [op_consume(&ctx, &gmod, val, CkCallArgOwning())]
                        emit(&ctx, GICall(box_dst, "Box", box_ctor_args))
                        val = box_dst
                        var_type = declared_ty
                    case None:
                        pass
            # Phase B.1 (2026-05-22): 7-branch SVarDecl assign-mode
            # decision tree. Mirrors Rust's `lower_var_decl_assign_mode`
            # at `src/ir/lowering/stmts/mod.rs:1055-1273`. Three emission
            # strategies (BorrowAlias / CloneAndMove / MoveDirect) chosen
            # from the cross-product of source ownership, source type,
            # declared type, and (pragma'd) liveness + CoW-safety. See
            # `decide_svardecl_emission` (line ~660) for the full branch
            # logic and pragma rationale.
            #
            # Supersedes the Prereq B carve-out: that older 3-case
            # inheritance (LoBorrowed/LoView → inherit, else → LoOwned)
            # is now a subset of Branch C (the BorrowAlias strategy
            # also fires for live Owned resource sources, the
            # `String b = a` shape per CoW-default-borrow). The Phase 3
            # `add_local_inheriting` helper stays — it handles
            # intermediate-temp bindings (match scrutinee, PBinding,
            # PCtor field) that don't go through this user-level
            # SVarDecl path.
            GirLocal val_loc = ctx.locals.get(val).unwrap()
            # Source-collection root of the init expr (e.g. `v` for
            # `v.get(0).unwrap()`) — feeds the substrate-(ii) resource-bind
            # borrow-flip gate in decide_svardecl_emission.
            String cow_src_root = cow_source_root_name(init_expr)
            # T-C (round-40): flag a bare-identifier init that names a resource-
            # typed module `static` (`T x = SHARED`). decide_svardecl_emission
            # DEEP-CLONES it (CloneAndMove) instead of MoveDirect-aliasing the
            # global's heap — mirrors Rust's clone_resource_global_ref. Gated to
            # a bare identifier so `x = STATIC[i]` / `x = STATIC.field` (element/
            # field reads, not the whole-collection alias) are untouched. Gate on
            # the READ identifier `gv_static_nm` (NOT the LHS `name`) matching a
            # static AND not being shadowed by a local — mirrors the sibling
            # static-read guard at lower_expr.gg:8268 (`static_contains(&gmod,
            # ad_name) and not nl_contains(&ctx, ad_name)`). Using the LHS `name`
            # would misfire on a re-declared LHS (`Vector[int] alias = SHARED`
            # twice → 2nd bind's `nl_contains("alias")` true → gate falls through
            # → the exact aliasing WRONG this removes); gating on the read name
            # also correctly SKIPs a shadowing local (read the local, not the
            # static → no deep-clone).
            bool src_is_static_global = false
            match init_expr.expr:
                case EIdentifier(gv_static_nm):
                    if static_contains(&gmod, gv_static_nm) and not nl_contains(&ctx, gv_static_nm):
                        src_is_static_global = true
                else:
                    pass
            SVarDeclEmission plan = decide_svardecl_emission(&ctx, &gmod, val, var_type, name, cow_src_root, init_expr.span.start, src_is_static_global)
            int var_local = 0
            match plan:
                case BorrowAlias():
                    # Branch A / C / (transitive A/C) — mark dst as a
                    # borrow alias of val. Ownership: inherit val's
                    # LoBorrowed/LoView if val is already a borrow
                    # (preserves the chain); otherwise tag dst as
                    # LoBorrowed/BoAlias(val) — a fresh alias of an
                    # owned source.
                    #
                    # Drop discipline. Two scenarios:
                    #   (a) val is itself a borrow (transitive alias):
                    #       neither val nor var_local registers for drop;
                    #       the root aggregate up the chain owns the
                    #       heap. This is the Prereq B carve-out shape.
                    #   (b) val is LoOwned (fresh Branch A/C): val IS
                    #       the owner. var_local must NOT register for
                    #       drop (would double-free). val keeps its
                    #       drop registration if it had one; otherwise
                    #       the heap leaks once the function returns
                    #       — caller's responsibility (the typical case
                    #       is val is an unnamed coerced temp from
                    #       `gorget_str_from_cstr` which we deliberately
                    #       don't drop because the alias keeps its
                    #       bytes alive across the function body).
                    LocalOwnership new_own = LoBorrowed()
                    BorrowOrigin new_origin = BoAlias(val)
                    bool inherited_chain = false
                    match val_loc.ownership:
                        case LoBorrowed():
                            new_own = val_loc.ownership
                            new_origin = val_loc.borrow_origin
                            inherited_chain = true
                        case LoView():
                            new_own = val_loc.ownership
                            new_origin = val_loc.borrow_origin
                            inherited_chain = true
                        else:
                            pass
                    # D.1 (2026-05-22) — Branch C retype to Ptr(T). B.1
                    # left the dst slot value-typed because the LIR's
                    # `GIAssign(dst, OpBorrow(src))` shape would byte-copy
                    # an aggregate value into a Ptr-typed slot (silent
                    # corruption). D.1 ships the LIR fix at
                    # `lir_lower.gg:GIAssign` (OpBorrow + Ptr-typed-dst +
                    # value-typed-src → ISlotAddr instead of ISlotLoad),
                    # so the slot can now genuinely be `Ptr(T)`.
                    #
                    # The retype unifies Branch C with Rust's `set_ref`:
                    # downstream Ptr-typed-slot consumers (GIFieldLoad
                    # auto-deref, GICall pass-by-ptr, GICallExtern
                    # pass-by-ptr, OpClone short-circuit) all handle the
                    # Ptr-typed shape — borrow propagation now works at
                    # the LIR layer, not just at the GIR ownership tag.
                    # When `val` is ALREADY a Ptr/MutPtr (Leak-1 Branch A-agg:
                    # a `Ptr(T)` element-borrow from `coll.get(i).unwrap()`, or
                    # any inherited-chain Ptr source), the dst alias is the SAME
                    # Ptr type — a pointer-value COPY, NOT a fresh `register_ptr`
                    # wrap (which would double-indirect to `Ptr(Ptr(T))` and
                    # break the downstream droppable-pointee predicate +
                    # field-read auto-deref). Only a VALUE source (e.g. the
                    # original Branch A `String b = a` same-type alias) gets
                    # `register_ptr(var_type)` so the dst Ptr points AT the value.
                    bool val_is_ptr_already = false
                    if val_loc.type_id >= 0 and val_loc.type_id < gmod.type_table.len():
                        match gmod.type_table.get(val_loc.type_id).unwrap():
                            case GtPtr(_):
                                val_is_ptr_already = true
                            case GtMutPtr(_):
                                val_is_ptr_already = true
                            else:
                                pass
                    int dst_type_id = register_ptr(&gmod, var_type)
                    Operand alias_op = OpBorrow(val)
                    if val_is_ptr_already:
                        # dst type = val's Ptr type (no re-wrap); pointer-value
                        # copy via OpCopy (ISlotLoad of the 8-byte pointer).
                        dst_type_id = val_loc.type_id
                        alias_op = OpCopy(val)
                    var_local = add_local_with(&ctx, dst_type_id, Some(name), new_own, new_origin)
                    # Explicit OpBorrow/OpCopy — bypass op_consume because val
                    # may be LoOwned (which op_consume would resolve to
                    # OpMove, but for the alias shape we want a pointer-
                    # like copy, not a move-out). With D.1's Branch C
                    # retype, the LIR's GIAssign handler dispatches:
                    #   • val_loc value-typed (e.g. fresh coerced cstr →
                    #     GorgetString) → ISlotAddr(src) + ISlotStore(dst)
                    #   • val_loc Ptr-typed (e.g. inherited from another
                    #     Branch C / from GIFieldLoad) → ISlotLoad(src) +
                    #     ISlotStore(dst) = pointer copy = alias chain.
                    emit(&ctx, GIAssign(var_local, alias_op))
                    # cow_register_alias overwrites BorrowOrigin with
                    # BoAlias(val). Only call when we DIDN'T inherit a
                    # specific origin from val — otherwise we'd lose the
                    # transitive chain's information (BoField/BoCollectionElement/etc.).
                    if not inherited_chain:
                        cow_register_alias(&ctx, var_local, val)
                    nl_put(&ctx, name, var_local)
                    # Borrow alias: don't register for drop. Drop discipline
                    # is preserved because val (or the root aggregate it
                    # aliases) covers the underlying heap.
                case CloneAndMove(clone_fn_name):
                    # Branch B / D / E + Branch C-pre — emit `<T>__clone(&val)`
                    # (or the runtime equivalent like gorget_string_clone_to_owned),
                    # then bind dst LoOwned to the clone result. Register
                    # for drop because dst genuinely owns a fresh allocation.
                    #
                    # OWNED-RESULT TYPE (option_ref_borrow Phase 4a): for the
                    # Branch C-pre shape `T x = coll.get(i).unwrap()`, the
                    # source `val` is a `GtPtr(inner)` (the element's address)
                    # and the clone fn DEREFERENCES it, returning an OWNED
                    # `inner` value — NOT a pointer. `var_type` here is the
                    # source's slot type, which is the `GtPtr(inner)` (the
                    # declared-type heuristic at ~5523 can't override it
                    # because `type_id_to_name` collapses `GtPtr(inner)`→inner,
                    # so declared and inferred names match). Typing `cloned` /
                    # `var_local` as that Ptr would (1) mislabel an owned value
                    # as a pointer and (2) make the subsequent
                    # `op_consume(cloned, CkAssign)` re-enter the GtPtr arm and
                    # emit a SECOND `OpClone` (the triple-clone / value-where-
                    # pointer bug). When the source is a `GtPtr(inner)`, bind
                    # the owned locals at the pointee type `inner` so the clone
                    # result is value-typed and op_consume picks OpMove.
                    int owned_type = var_type
                    bool source_was_ptr = false
                    GirLocal cam_src = ctx.locals.get(val).unwrap()
                    if cam_src.type_id >= 0 and cam_src.type_id < gmod.type_table.len():
                        GirType cam_src_gt = gmod.type_table.get(cam_src.type_id).unwrap()
                        match cam_src_gt:
                            case GtPtr(cam_inner):
                                owned_type = cam_inner
                                source_was_ptr = true
                            case GtMutPtr(cam_inner):
                                # Symmetric with GtPtr above. `&T`/`!T` params
                                # lower to `GtMutPtr(T)` (resolve_param_type at
                                # context.rs:1613). A `T x = &param` clone
                                # produces an owned value `T`, so the dst slot
                                # must be value-typed at `T`, not `MutPtr(T)`.
                                # Without this unwrap the dst slot stayed
                                # `MutPtr(T)` and lir_codegen.gg:2809-2810's
                                # "pointer slot receiving aggregate value →
                                # NULL" coercion fired (self_host_bootstrap_
                                # fixed_point lower_call SIGSEGV).
                                owned_type = cam_inner
                                source_was_ptr = true
                            else:
                                pass
                    int cloned = add_local(&ctx, owned_type, None)
                    Vector[Operand] clone_args = []
                    clone_args.push(OpBorrow(val))
                    emit(&ctx, GICallExtern(cloned, clone_fn_name, clone_args))
                    var_local = add_local(&ctx, owned_type, Some(name))
                    emit(&ctx, GIAssign(var_local, op_consume(&ctx, &gmod, cloned, CkAssign())))
                    nl_put(&ctx, name, var_local)
                    # When the source was a GtPtr/GtMutPtr (the Branch C-pre
                    # `coll.get(i).unwrap()` deref-clone), do NOT register the
                    # owned local for drop. The clone fn makes a DEEP independent
                    # heap copy (resolve_payload_clone_fn → <T>__clone, :7983-8013),
                    # so dropping it is NOT a double-free — it's a memory-SAFE
                    # EXTRA drop. But the ORACLE borrows the element and never
                    # drops it, so that extra drop DOUBLE-PRINTS (e.g.
                    # drop_struct_collection_fields). Suppressing it matches the
                    # oracle's borrow-no-drop stdout, AT THE COST OF LEAKING the
                    # deref-clone's heap (invisible to fixtures, which have no
                    # mem_live() check). Removable once Branch C-pre BORROWS
                    # instead of clones (see TODO). Value-owned clones
                    # (source not a Ptr) still register normally.
                    if not source_was_ptr:
                        register_local_for_drop(&ctx, var_local, owned_type, &gmod)
                    else:
                        # ③(d)-RSS: a RUNTIME-resource deref-clone (String/Array/
                        # Vector/Dict/Set/Box/…) has no observable drop, so
                        # registering it frees its fresh independent heap invisibly
                        # (the self-compile RSS leak — string_free 2.6M vs Rust 93.8M,
                        # stage-1 peak 9.96→6.28 GB). The blanket-skip above left
                        # EVERY `T x = coll.get(i).unwrap()` deref-clone leaking.
                        String owned_tname = type_id_to_name(owned_type, &gmod)
                        bool is_runtime_resource = false
                        match resource_meta_for(&gmod, owned_tname):
                            case Some(_):
                                is_runtime_resource = true
                            case None:
                                pass
                        if is_runtime_resource:
                            register_local_for_drop(&ctx, var_local, owned_type, &gmod)
                        else:
                            # P0 Bug A: a USER struct/enum ptr-clone (e.g. `Rec`
                            # with a String field) genuinely OWNS a fresh
                            # independent heap (the deref-clone deep-copies the
                            # field buffers). Not registering it leaks that heap
                            # (ASan `LeakSanitizer: N byte(s)` via
                            # `<T>__clone`→`gorget_string_clone_to_owned`→`main`).
                            # The deep-clone makes dropping it memory-SAFE (no
                            # double-free against the borrowed element's owner).
                            # The ONLY observable difference vs the borrow-no-drop
                            # oracle is a USER `drop` method's side effects (a
                            # `print` would double vs the oracle). So register
                            # ONLY when the type has NO user-defined `drop`: the
                            # implicit field-drop frees the clone's buffers with
                            # zero stdout effect (matches the oracle's output AND
                            # closes the leak). A type WITH a user drop stays on
                            # the leak-but-stdout-correct path until Branch C-pre
                            # BORROWS (the root-cause fix, TODO). Typed
                            # real-declared-property discriminator, not a name
                            # match (`types_with_user_drop`, pre-scanned in
                            # lower_module).
                            if not gmod.types_with_user_drop.contains(owned_tname):
                                register_local_for_drop(&ctx, var_local, owned_type, &gmod)
                case MoveDirect():
                    # Branch F / G — direct Move. Primitives, FnPtr,
                    # non-resource user types. op_consume picks
                    # OpCopy/OpMove as appropriate.
                    var_local = add_local(&ctx, var_type, Some(name))
                    emit(&ctx, GIAssign(var_local, op_consume(&ctx, &gmod, val, CkAssign())))
                    nl_put(&ctx, name, var_local)
                    register_local_for_drop(&ctx, var_local, var_type, &gmod)
                    # A single-owner sync handle (`Mutex[T] m = Mutex[T](v)`) is
                    # bound as a `GtPtr(Mutex__T)` slot (the ctor mints a
                    # pointer-to-handle — lower_expr.gg:5855-5876). `register_local_
                    # for_drop` above SKIPPED it (is_droppable_type rejects every
                    # GtPtr), so the owner leaked at scope exit. Register the owning
                    # opaque handle via the dedicated GtPtr-deref path — the typed
                    # `method_prefix == "gorget_mutex"` gate scopes it to the
                    # single-owner Mutex (NOT a name substring), so the GIDropIfAlive
                    # routes through drop_fn_for_type → `gorget_mutex_free`. No-op
                    # for the value-typed Channel (it's not a GtPtr) and for borrow
                    # aliases (LoBorrowed/LoView are excluded inside the helper).
                    register_owning_opaque_local(&ctx, var_local, var_type, &gmod)
                    # Async spawn (Inc-1): `Task[T] t = spawn f()` mints a
                    # FRESH binding local for `t` here, distinct from the spawn
                    # dst. `t.await()` reads THIS local, so the spawn→producer
                    # mapping must key off `var_local`, NOT the dst. The ESpawn
                    # arm set `pending_spawn_fn`; consume it into
                    # `result_locals[var_local]` (and clear it). A `Task[T]` is
                    # a non-resource ptr/int handle, so it routes through this
                    # MoveDirect arm. Mirrors Rust gg (`stmts/mod.rs:502-505`).
                    if ctx.pending_spawn_fn != "":
                        ctx.result_locals.put(var_local, ctx.pending_spawn_fn.clone())
                        ctx.pending_spawn_fn = ""
                    # ② closure ENV-FIELD leak fix — a resource/CoW-capturing
                    # closure value (`GorgetClosure`, fresh-Owned resource) lands
                    # in MoveDirect, which mints a FRESH `var_local` != the make-
                    # site's `cdst`. The dropped local is `var_local`, so copy
                    # the make-site's `<fn>\0<cdst> -> __Closure_N` channel entry
                    # onto `<fn>\0<var_local>`. The GorgetClosure GIDropIfAlive
                    # lowering reads it to route the env-field drop through
                    # `__Closure_N__drop`. (The OpMove zeroes `cdst`, so its own
                    # stale key never drops — no double-free.)
                    String cevt_src_key = ctx.current_fn_name + "\0" + int_to_str(val)
                    if gmod.closure_env_type.contains(cevt_src_key):
                        gmod.closure_env_type.put(ctx.current_fn_name + "\0" + int_to_str(var_local), gmod.closure_env_type.get(cevt_src_key).unwrap())
                    # closure Phase 2 increment 3 — copy the make-site's closure
                    # VALUE return-type channel entry (`<fn>\0<cdst> -> ret_tid`)
                    # onto the fresh dropped `var_local`, so a call through the
                    # named binding recovers the return type. Same shape/idiom as
                    # the `closure_env_type` copy-forward above.
                    if gmod.closure_value_ret_type.contains(cevt_src_key):
                        gmod.closure_value_ret_type.put(ctx.current_fn_name + "\0" + int_to_str(var_local), gmod.closure_value_ret_type.get(cevt_src_key).unwrap())
                case EagerAggClone():
                    # round-40 (none_assign_to_option_slot) — eager deref-clone of
                    # a `GtPtr(agg)`/`GtMutPtr(agg)` borrow into a VALUE-typed
                    # owned local, materialising an INDEPENDENT copy at the bind
                    # (Branch A-agg's non-pristine path: the source aggregate is
                    # mutated after the bind, so a BorrowAlias would observe the
                    # clobbered value at the owning consume). Unwrap `val`'s
                    # pointee type so the dst slot is value-typed — else the dst
                    # stays `GtPtr(agg)`-typed and the owning consume (`return x`)
                    # re-enters op_consume's GtPtr→OpClone arm, double-cloning a
                    # value as a pointer (the CloneAndMove "triple-clone" trap).
                    # `OpClone(val)` lowers via the LIR `resource_clone_fn` deref-
                    # clone — the same path the return-escape already uses.
                    int eac_owned = var_type
                    GirLocal eac_src = ctx.locals.get(val).unwrap()
                    if eac_src.type_id >= 0 and eac_src.type_id < gmod.type_table.len():
                        match gmod.type_table.get(eac_src.type_id).unwrap():
                            case GtPtr(eac_inner):
                                eac_owned = eac_inner
                            case GtMutPtr(eac_inner_m):
                                eac_owned = eac_inner_m
                            else:
                                pass
                    var_local = add_local(&ctx, eac_owned, Some(name))
                    emit(&ctx, GIAssign(var_local, OpClone(val)))
                    nl_put(&ctx, name, var_local)
                    register_local_for_drop(&ctx, var_local, eac_owned, &gmod)
                case LazyViewBind(lv_clone_fn):
                    # #37 Phase 2 — lazy loop-carried element borrow. `val`
                    # is the GtPtr(GorgetString) element address. The bind
                    # is a VALUE slot holding a cap=0
                    # `gorget_string_borrow_view` (drop-safe: the
                    # cap-driven free no-ops) plus a materialized-flag
                    # seeded false. Mutation sites of the source collection
                    # run the flag-guarded in-place materialize
                    # (cow_lazy_materialize_family). The slot is tagged
                    # LoView so every consuming read (return / push / ctor)
                    # routes through op_consume's LoView→OpClone arm — a
                    # still-view escape always deep-copies (escape-safe) —
                    # while a same-type decl bind (`String x = s`) takes
                    # Branch A's SLOT alias: the alias derefs the slot at
                    # READ time and observes the materialized value.
                    # Provenance propagation by slot-aliasing — the ViewOf
                    # design from docs/language-design.md, with no view
                    # header copy to go stale.
                    int lv_owned_type = var_type
                    GirLocal lv_src = ctx.locals.get(val).unwrap()
                    if lv_src.type_id >= 0 and lv_src.type_id < gmod.type_table.len():
                        match gmod.type_table.get(lv_src.type_id).unwrap():
                            case GtPtr(lv_inner):
                                lv_owned_type = lv_inner
                            case GtMutPtr(lv_inner):
                                lv_owned_type = lv_inner
                            else:
                                pass
                    var_local = add_local_with(&ctx, lv_owned_type, Some(name), LoView(), BoRuntimeView(val))
                    Vector[Operand] lv_args = [OpBorrow(val)]
                    emit(&ctx, GICallExtern(var_local, "gorget_string_borrow_view", lv_args))
                    int lv_flag = add_local(&ctx, BOOL_TYPE, None)
                    emit(&ctx, GIAssign(lv_flag, OpConstBool(false)))
                    nl_put(&ctx, name, var_local)
                    # Typed drop override: the slot OWNS its buffer
                    # post-materialize (register_local_for_drop would skip
                    # the LoView tag; the cap=0 pre-materialize state makes
                    # the unconditional entry safe in both states).
                    register_lazy_slot_for_drop(&ctx, var_local, lv_owned_type)
                    ctx.cow_lazy_members.push(LazyMember(cow_src_root.clone(), var_local, lv_flag, lv_owned_type, lv_clone_fn, false))
        case SReturn(opt_expr):
            # Phase 2: emit cleanup drops for every scope back to the
            # function frame BEFORE assigning the return value /
            # closing the block with GTReturn. Exclude _0 (the return
            # place) since its value is being moved out as the return
            # value; dropping it would double-free.
            match opt_expr:
                case Some(ret_expr):
                    # Expected-type-at-return (mirrors Rust gg's
                    # `lower_return` setting `func_state.expected_type =
                    # locals[0].type_id` at `stmts/mod.rs:1523-1526`).
                    # Set BEFORE lowering — the reader sites (bare
                    # prelude-variant ctors in `lower_call`, bare `None`,
                    # EIdentifier) pick up the return place's full
                    # monomorphised type and type their dst slot
                    # accordingly. This is the proper expected_type port
                    # (mirrors Rust gg's `lower_return` in
                    # `src/ir/lowering/stmts.rs`).
                    int prev_expected_ret = ctx.expected_type
                    int ret_place_ty_pre = ctx.locals.get(0).unwrap().type_id
                    if ret_place_ty_pre != I64_TYPE and ret_place_ty_pre != UNIT_TYPE:
                        ctx.expected_type = ret_place_ty_pre
                    # Defect B (throws fn with a Result/Option success type T):
                    # the declared `T` of a `throws T` fn is the UNWRAPPED `T`
                    # but `_0` is the synthesized `Result[T, E]` (one layer
                    # wider). When `T` is ITSELF a Result/Option, an explicit
                    # `return Ok(...)` / `Some(...)` tail builds the INNER `T`,
                    # not the outer slot — so the variant-ctor reader sites in
                    # `lower_call` must resolve against the inner `T` (the
                    # slot's `Ok_0` payload `ok_type`), else `Ok(x*4)` resolves
                    # its `Ok_0` field against the OUTER slot (payload = inner
                    # Result) and drops the int. GATED ON `ctx.fn_is_throws`: a
                    # PLAIN `Result[Option[int], String]` fn whose
                    # `return Ok(Some(42))` correctly builds the FULL Result is
                    # structurally identical at this site — only the throws flag
                    # distinguishes the synthesized-slot reinterpretation
                    # (without the gate, `option_result_nested` regresses).
                    # Mirrors Rust gg's `declared_t_is_enum_wrapper` /
                    # `expected_for_value = inner T`
                    # (`src/ir/lowering/stmts/mod.rs:1651-1679`).
                    if ctx.fn_is_throws and enum_category_of(&gmod, ret_place_ty_pre).category == ENUM_CAT_RESULT:
                        int ok_inner_ty = enum_category_of(&gmod, ret_place_ty_pre).ok_type
                        if ok_inner_ty >= 0:
                            int ok_inner_cat = enum_category_of(&gmod, ok_inner_ty).category
                            if ok_inner_cat == ENUM_CAT_RESULT or ok_inner_cat == ENUM_CAT_OPTION:
                                ctx.expected_type = ok_inner_ty
                    int val = lower_expr(&ctx, ret_expr, &gmod)
                    ctx.expected_type = prev_expected_ret
                    # Divergent expr-body tail guard (mirrors Rust gg's
                    # `if !builder.is_terminated()` in
                    # `src/ir/lowering/functions.rs`): the inline expr-body
                    # form `RetType f(...): return EXPR` parses the body as
                    # `SReturn(Some(EDo([SReturn(Some(EXPR))])))` — the inner
                    # `return`/`throw` (now an EDo-wrapped divergent expr, see
                    # parser.gg parse_prefix) already assigned `_0` AND
                    # terminated this block. The outer assign/drops/ret below
                    # would clobber `_0` with the EDo's unit tail value (and
                    # re-set the terminator). Bail out: the block is done.
                    if block_terminated(&ctx):
                        return
                    # Throws-function Result.Ok wrapping (mirrors Rust gg's
                    # `lower_return` at `stmts/mod.rs:1585-1658`): when the
                    # return place is a `Result__T__E` (the fn is `throws`)
                    # and the returned expression produced a PLAIN value (not
                    # already a Result — e.g. a bare `Ok(x)`/`Error(x)` ctor,
                    # a throws-call result, or another Result value), wrap it
                    # in `Result.Ok(val)`. Without this, `return 42` in a
                    # throws-fn zero-inits the Result (tag=0=Ok, Ok_0=0) and
                    # silently drops the value. The bare `Ok` variant name
                    # routes through the LIR `try_lower_prelude_variant`
                    # rewrite (same substrate as `lower_throw_stmt`'s Error).
                    #
                    # Defect A — the skip-guard compares by TYPE-EQUALITY, not
                    # category: skip the Ok-wrap ONLY when `val`'s (Ptr/MutPtr-
                    # peeled) type is the SAME `Result[T, E]` as the slot, i.e.
                    # the operand already IS the fn's own Result (an explicit
                    # `return Ok(x)` whose ctor built the outer slot, a
                    # throws-call result, or a borrowed `return r`). A
                    # category-only check wrongly skipped the wrap when `T` is
                    # ITSELF a Result of a DIFFERENT type (outer
                    # `Result[Result[int,String],String]`, tail value
                    # `Result[int,String]`): both are category RESULT, so the
                    # inner Result got direct-assigned into the wider outer
                    # slot and the outer was zero-inited (`Ok(0)`). Mirrors Rust
                    # gg's `op_ty == ret_type` type-equality guards in
                    # `wrap_expr_tail_in_ok` (`functions.rs:224`) and
                    # `lower_return` (`stmts/mod.rs:1717`). `ret_place_ty_pre` is
                    # already the bare slot tid; peel `val`'s slot type so a
                    # borrowed `return r` (a `GtPtr(Result__…)` tid) still
                    # compares equal and is not double-wrapped.
                    int val_ty_raw = ctx.locals.get(val).unwrap().type_id
                    int val_ty_peeled = val_ty_raw
                    if val_ty_raw >= 0 and val_ty_raw < gmod.type_table.len():
                        match gmod.type_table.get(val_ty_raw).unwrap():
                            case GtPtr(vt_inner):
                                val_ty_peeled = vt_inner
                            case GtMutPtr(vt_inner):
                                val_ty_peeled = vt_inner
                            else:
                                pass
                    if enum_category_of(&gmod, ret_place_ty_pre).category == ENUM_CAT_RESULT and val_ty_peeled != ret_place_ty_pre:
                        int ok_dst = add_local(&ctx, ret_place_ty_pre, None)
                        Vector[Operand] ok_args = [op_consume(&ctx, &gmod, val, CkCallArgOwning())]
                        emit(&ctx, GICallExtern(ok_dst, "Ok", ok_args))
                        val = ok_dst
                    # Option[Ref[T]] → Option[T] lift (mirrors Rust gg's
                    # `try_lift_option_ref` call at the return site,
                    # `stmts/mod.rs:1755-1767`). `peek()`-style fns
                    # `return coll.get(i)` where `.get()` produced an
                    # `Option[Ref[T]]` but the fn returns `Option[T]` by
                    # value: deref the Ref + rebuild an OWNED Option, else
                    # the C backend hardcodes None at the type mismatch and
                    # the value leaks. Gate (mirrors Rust `:1755`): the
                    # return place (local 0) is a non-Ref `Option[T]` AND
                    # `val`'s type is a RECORDED `Option__Ref__T` (the typed
                    # `option_ref_payload` channel). No-op fallback (returns
                    # -1) otherwise — leaves `val` untouched so `return
                    # Some(x)` / `return x` / `return coll.pop()` (owned
                    # Option) / nested-Option returns are unaffected.
                    # "non-Ref Option" reads the typed channel (CLAUDE.md
                    # "No name matching"): `enum_category_of` peels Ptr/MutPtr
                    # and classifies via the recorded `EnumCategory`;
                    # `option_ref_payload_of(...) < 0` distinguishes a value
                    # Option from a borrowing `Option[Ref[T]]`. Equivalent to
                    # the former name-prefix test (Option-mangled and not
                    # Ref-Option-mangled), probe-verified identical over the
                    # full driver self-emit + Option/Result corpus
                    # (4523+93 agreements / 0 disagreements). Same idiom as
                    # lower_expr.gg's ENone-with-expected-type arm.
                    int ret_place_ty = ctx.locals.get(0).unwrap().type_id
                    int val_ty_lift = ctx.locals.get(val).unwrap().type_id
                    if enum_category_of(&gmod, ret_place_ty).category == ENUM_CAT_OPTION and option_ref_payload_of(&gmod, ret_place_ty) < 0 and option_ref_payload_of(&gmod, val_ty_lift) >= 0:
                        int lifted = try_lift_option_ref(&ctx, val, ret_place_ty, &gmod)
                        if lifted >= 0:
                            val = lifted
                    Operand ret_op = op_consume(&ctx, &gmod, val, CkReturn())
                    # a-6 (concern #5, the keystone): when the value is MOVED
                    # out of a bare owned local, that local now aliases _0 and
                    # the caller's return value. Move-zero it and exclude it
                    # from the scope-exit drops — otherwise the exit
                    # drop_if_alive frees it and the caller double-frees the
                    # same heap (the canonical return-corruption double-free).
                    int excl = 0
                    match ret_op:
                        case OpMove(src):
                            excl = src
                        else:
                            pass
                    emit(&ctx, GIAssign(0, ret_op))
                    if excl != 0:
                        emit(&ctx, GIMoveZero(excl))
                    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(excl))
                    set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
                case None:
                    # Explicit bare `return` in a value fn whose ret_type was
                    # widened to Result__V__E (a `void throws E`) must return the
                    # zero-inited _0 (tag 0 = Ok), not a bare unit — else the
                    # struct-returning C fn returns garbage. Genuinely-void fns
                    # (ret_type UNIT, non-Result) keep the OpConstUnit route.
                    # Typed metadata (enum_category_of), not name-matching.
                    int none_ret_place_ty = ctx.locals.get(0).unwrap().type_id
                    emit_drops_for_early_exit(&ctx, DSK_FUNCTION, Some(0))
                    if enum_category_of(&gmod, none_ret_place_ty).category == ENUM_CAT_RESULT:
                        set_terminator(&ctx, GTReturn(op_consume(&ctx, &gmod, 0, CkReturn())))
                    else:
                        set_terminator(&ctx, GTReturn(OpConstUnit()))
        case SExpr(sexpr):
            lower_expr(&ctx, sexpr, &gmod)
        case SIf(cond_expr, then_body, elif_branches):
            # Planner consumer #1 (SH mirror): SUBTREE-scoped pre-branch
            # bare-param materialize -- exact subtree membership from the
            # ONE-PASS scope sets (anchor = cond span start, matching the
            # walker's SIf push). Covers the elif recursion inside lower_if
            # too (the set spans every ElseBranch), so lower_if itself
            # carries no hoist. See materialize_scope_carried_bare_params.
            materialize_scope_carried_bare_params(&ctx, &gmod, cond_expr.span.start)
            lower_if(&ctx, cond_expr, then_body, elif_branches, &gmod, is_main)
        case SWhile(cond_expr, body, else_body):
            lower_while(&ctx, cond_expr, body, else_body, &gmod, is_main)
        case SAssign(target_expr, value_expr):
            # #37 Phase 2 hook 4 (SAssign target root): reassign `v = w`,
            # index-store `v[i] = x`, field-store `v.f = x` destroy or
            # replace elements of the target's root collection —
            # materialize its lazy family BEFORE the mutation lowers (the
            # sever-on-reassign analogue of Rust's
            # cow_sever_all_aliases_from lazy routing).
            if ctx.cow_lazy_members.len() > 0:
                cow_lazy_materialize_family(&ctx, cow_source_root_name(target_expr))
            match target_expr.expr:
                case EIdentifier(name):
                    # Shared-variable transparent WRITE (round-16 Phase 1).
                    # `x = v` where x is a `shared` var writes the new value
                    # through the carrier per kind (mutex guard / rwlock write
                    # guard / atomic store). Mirrors Rust gg's plain-assign
                    # dispatch (`stmts/assigns.rs:31-56`).
                    if ctx.shared_locals.contains(name):
                        SharedLocalInfo sas_sh = ctx.shared_locals.get(name).unwrap()
                        int sas_prev_et = ctx.expected_type
                        ctx.expected_type = sas_sh.inner_type
                        int sas_val = lower_expr(&ctx, value_expr, &gmod)
                        ctx.expected_type = sas_prev_et
                        emit_shared_write(&ctx, &gmod, sas_sh, sas_val)
                        # Keep the facade local in sync so any non-shared read
                        # path (defensive) sees the latest value too.
                        if sas_sh.facade_local >= 0:
                            emit(&ctx, GIAssign(sas_sh.facade_local, OpCopy(sas_val)))
                        return
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        # `&`/`!`-param whole-value WRITE detection. A
                        # `GtMutPtr(inner)`-typed slot holds a `T*`; a plain
                        # GIAssign would clobber the POINTER slot instead of
                        # writing the pointee. Emit GIDerefStore (`*ptr = v`)
                        # for ANY inner — scalar `&`-writes are the primary
                        # bug, but resource `&`-writes (`String &s = s + "!"`)
                        # were ALSO dropped. Mirrors Rust gg's assign into a
                        # `Place{local,[Deref]}` (assigns.rs:231-243).
                        int asn_inner_ty = -1
                        int asn_lhs_full_ty = ctx.locals.get(lid).unwrap().type_id
                        if asn_lhs_full_ty >= PRIM_COUNT and asn_lhs_full_ty < gmod.type_table.len():
                            match gmod.type_table.get(asn_lhs_full_ty).unwrap():
                                case GtMutPtr(asn_inner):
                                    asn_inner_ty = asn_inner
                                else:
                                    pass
                        # Expected-type propagation: mirrors Rust gg's
                        # `lower_assign` at `src/ir/lowering/stmts/assigns.rs:108-117`.
                        # Setting `ctx.expected_type` to the LHS local's type
                        # BEFORE lowering the RHS lets reader sites resolve
                        # bare prelude-variant ctors / bare `None` to the
                        # destination's shape, instead of typing them by
                        # the bare variant name (which collapses to an
                        # 8-byte Ptr slot for a multi-word aggregate). For a
                        # `&`-write the destination is the POINTEE, so use the
                        # inner type, not the `GtMutPtr` wrapper.
                        int prev_expected_asn = ctx.expected_type
                        int lhs_ty = asn_lhs_full_ty
                        if asn_inner_ty >= 0:
                            lhs_ty = asn_inner_ty
                        if lhs_ty != I64_TYPE and lhs_ty != UNIT_TYPE:
                            ctx.expected_type = lhs_ty
                        int val = lower_expr(&ctx, value_expr, &gmod)
                        ctx.expected_type = prev_expected_asn
                        if asn_inner_ty >= 0:
                            emit(&ctx, GIDerefStore(lid, op_consume(&ctx, &gmod, val, CkAssign()), asn_inner_ty))
                        else:
                            Operand rhs_op = op_consume(&ctx, &gmod, val, CkAssign())
                            # ③(a) drop-on-overwrite (mirror Rust gg assigns.rs:197-231):
                            # drop `lid`'s PRIOR value AFTER computing the RHS, BEFORE the
                            # assign overwrites the slot. Gate on (1) the slot type being
                            # droppable AND (2) `lid` currently OWNING its value. A
                            # LoBorrowed/LoView alias does NOT own the old value — dropping
                            # it would free another local's heap (protects
                            # cow_param_alias_reassign: `alias = alias + " world"` where
                            # `alias` is a CoW borrow of a param). Same ownership gate as
                            # register_local_for_drop's a-1 rule.
                            bool drop_old = false
                            if is_droppable_type(asn_lhs_full_ty, &gmod):
                                match ctx.locals.get(lid).unwrap().ownership:
                                    case LoBorrowed():
                                        pass
                                    case LoView():
                                        pass
                                    else:
                                        drop_old = true
                            # Self-assign guard: `s = s` lowers to rhs source == lid;
                            # dropping then re-moving the same slot is a UAF. Skip the drop
                            # (degenerate no-op). Extract the rhs source local id.
                            int rhs_src = -1
                            match rhs_op:
                                case OpMove(s0):
                                    rhs_src = s0
                                case OpClone(s0):
                                    rhs_src = s0
                                case OpCopy(s0):
                                    rhs_src = s0
                                case OpBorrow(s0):
                                    rhs_src = s0
                                else:
                                    pass
                            if rhs_src == lid:
                                drop_old = false
                            if drop_old:
                                # Self-referential VIEW guard (mirror assigns.rs:178-196):
                                # when rhs_op is an OpClone of a borrow/view, the source may
                                # alias `lid`'s buffer (`s = s.trim()` / `s = s.slice(..)`).
                                # Materialise the clone into a fresh OWNED temp FIRST, so the
                                # clone reads the OLD buffer while it is still alive; only
                                # THEN free the old value and Move the temp in. (OpMove/OpCopy
                                # sources are independent of lid — concat/ctor results, owned
                                # locals — and the self-assign guard above already excluded
                                # rhs_src == lid, so they need no pre-materialisation.)
                                match rhs_op:
                                    case OpClone(_):
                                        int mat = add_local(&ctx, asn_lhs_full_ty, None)
                                        emit(&ctx, GIAssign(mat, rhs_op))
                                        rhs_op = OpMove(mat)
                                    else:
                                        pass
                                # GIDropIfAlive (memcmp-gated), NOT GIDrop: a slot already
                                # moved-out earlier in this fn (drop_reassign_after_move:
                                # `tokens.push(current)` zeroes current's slot via the
                                # post-pass GIMoveZero, then `current = ""`) is then a
                                # runtime no-op. Mirrors Rust's is_moved -> drop_if_alive.
                                emit(&ctx, GIDropIfAlive(lid))
                            emit(&ctx, GIAssign(lid, rhs_op))
                    elif static_contains(&gmod, name):
                        # Module-level mutable-static WRITE (`STATIC = value`).
                        # A `static` is mutable storage; the destination is the
                        # global itself. `lower_place_base` returns a
                        # `GtMutPtr(sty)` slot holding the global's address
                        # (`__global_ref__<name>` → IGlobalAddr), so we
                        # deref-store the RHS through it. Without this the write
                        # was silently dropped (statics fell through every local
                        # arm). Mirrors Rust gg's assign into a static
                        # `Place{global,[Deref]}` (assigns.rs:389-392).
                        int sty = static_lookup_type(&gmod, name)
                        int prev_expected_st = ctx.expected_type
                        if sty != I64_TYPE and sty != UNIT_TYPE:
                            ctx.expected_type = sty
                        int sval = lower_expr(&ctx, value_expr, &gmod)
                        ctx.expected_type = prev_expected_st
                        int sptr = lower_place_base(&ctx, target_expr, &gmod)
                        emit(&ctx, GIDerefStore(sptr, op_consume(&ctx, &gmod, sval, CkAssign()), sty))
                case EFieldAccess(base_box, field_name):
                    # self.field = value
                    # Lower as: __field_write_TYPE_FIELD(&base, value).
                    # The codegen expands this to `((T*)base)->field = value;`.
                    # Previously silently dropped — `self.lex_pos += 1` didn't
                    # increment, leaving the lexer loop spinning.
                    # R36-B: PROJECTED field-store (`v[i].f = x`, `o.inner.f = x`)
                    # through a bare param materializes the immutable-in-context
                    # ROOT first (caller untouched). A bare `self.f = x` (root is
                    # `self`, a `&self` GtMutPtr param) is skipped by the helper.
                    cow_materialize_projected_root(&ctx, &gmod, target_expr)
                    lower_field_write(&ctx, *base_box, field_name, value_expr, &gmod)
                case EIndex(base_box, idx_box):
                    # v[i] = x — Vector/Dict/Set index assignment. Dispatch
                    # to the collection's runtime setter based on the base
                    # type name. The self-host uses this for Dict[K,V] put
                    # (int_consts[name] = val) and Vector[T] set patterns.
                    # R36-B: a bare-param root (`v[i] = x`, `m[i][j] = x`)
                    # materializes the root collection first (caller untouched).
                    cow_materialize_projected_root(&ctx, &gmod, target_expr)
                    lower_index_assign(&ctx, *base_box, *idx_box, value_expr, &gmod)
                case EDeref(inner_box):
                    # `*b = X` — write X THROUGH the box pointer into the heap
                    # pointee (Snag #26). The box VALUE is itself the heap
                    # pointer (Box__T is `typedef void*`), so `GIDerefStore`
                    # loads that pointer (ISlotLoad LT_PTR) and stores X
                    # through it — `*(T*)box = X`. Without this arm the write
                    # fell into `else: lower_fail` and was SILENTLY DROPPED.
                    #
                    # Mirrors Rust gg's `Expr::Deref` lvalue arm
                    # (src/ir/lowering/stmts/assigns.rs:504-557): lower the
                    # inner box to a place, project a `Deref`, propagate the
                    # pointee type as expected_type for the RHS, route the RHS
                    # through the consuming-position CoW helper, then store.
                    # Here `op_consume(..CkAssign())` IS that CoW helper — a
                    # borrowed/live resource source (box_deref_borrowed_string:
                    # `*b = original` where `original` is read again) becomes
                    # OpClone (independent heap, no double-free), a fresh owned
                    # temp (`*b = Inner(99)`) stays OpMove/OpCopy. The
                    # is_resource_type(pointee) gate Rust applies is subsumed by
                    # op_consume's per-source move/clone decision (it never
                    # clones a non-resource fresh value). Same machinery as the
                    # EIdentifier `&`/`!`-param GtMutPtr arm above (:637).
                    int dbox = lower_expr(&ctx, *inner_box, &gmod)
                    int dbox_tid = ctx.locals.get(dbox).unwrap().type_id
                    String dbox_tname = type_id_to_name(dbox_tid, &gmod)
                    match box_deref_inner_name(dbox_tname, &gmod):
                        case Some(dbox_inner_name):
                            int dbox_inner_tid = resolve_field_gir_type(dbox_inner_name, &gmod)
                            # Propagate the pointee type as expected_type so a
                            # bare `None` / variant-ctor RHS materialises at the
                            # destination shape (mirror the EIdentifier-write +
                            # Rust assigns.rs:536-539 expected_type propagation).
                            int prev_expected_db = ctx.expected_type
                            if dbox_inner_tid != I64_TYPE and dbox_inner_tid != UNIT_TYPE:
                                ctx.expected_type = dbox_inner_tid
                            int dbox_val = lower_expr(&ctx, value_expr, &gmod)
                            ctx.expected_type = prev_expected_db
                            emit(&ctx, GIDerefStore(dbox, op_consume(&ctx, &gmod, dbox_val, CkAssign()), dbox_inner_tid))
                        case None:
                            lower_fail("SAssign *deref target is not a Box (got: " + dbox_tname + ")")
                else:
                    lower_fail("SAssign target is neither EIdentifier, EFieldAccess, EIndex, nor EDeref (got: " + expr_kind(target_expr.expr) + ")")
        case SBreak():
            # Jump to the innermost loop's break target. Silently dropped
            # before, which caused while-loops in the self-host lexer to
            # never exit on their closing-quote checks.
            # Phase 2: emit cleanup drops up to (and including) the
            # innermost Loop scope before the jump.
            if ctx.loop_break_stack.len() > 0:
                int tgt = ctx.loop_break_stack.get(ctx.loop_break_stack.len() - 1).unwrap()
                emit_drops_for_early_exit(&ctx, DSK_LOOP, None)
                set_terminator(&ctx, GTJump(tgt))
        case SContinue:
            if ctx.loop_continue_stack.len() > 0:
                int tgt = ctx.loop_continue_stack.get(ctx.loop_continue_stack.len() - 1).unwrap()
                emit_drops_for_early_exit(&ctx, DSK_LOOP, None)
                set_terminator(&ctx, GTJump(tgt))
        case SPass:
            # `pass` is a literal no-op statement. Explicit case silences
            # the lower_fail diagnostic; behaviour is unchanged.
            pass
        case SMeta:
            # Standalone `meta` marker — compile-time sentinel, no runtime.
            pass
        case SMetaConst(_, _):
            # `meta const` — compile-time binding consumed by the delayed-meta
            # engine at lower_generic_function time. A residual here = a
            # non-generic context (no concrete T was substituted); drop.
            pass
        case SMetaFor(_, _, _):
            # `meta for` — compile-time loop already expanded earlier in
            # the pipeline; any remaining SMetaFor is a residual marker.
            pass
        case SMetaIf(_, _, _):
            # `meta if` — compile-time conditional. Should have been
            # expanded by the delayed-meta engine at lower_generic_function
            # time. A residual here = non-generic context (no concrete T) or
            # an unevaluable condition; drop (Rust also leaves it inert).
            pass
        case SMetaMatch(_, _, _):
            # `meta match` — compile-time value match. Expanded by the
            # delayed-meta engine at lower_generic_function time; any residual
            # here is non-generic / unevaluable, so drop (inert, like SMetaIf).
            pass
        case SMetaWhile(_, _):
            # `meta while` — compile-time loop. Expanded by the delayed-meta
            # engine at lower_generic_function time; any residual here is
            # non-generic / unevaluable, so drop (inert, like SMetaIf).
            pass
        case SMatch(scrutinee, arms):
            # Planner consumer #1 (SH mirror): SUBTREE-scoped pre-scrutinee
            # bare-param materialize (scrutinee + guards + arm bodies -- the
            # walker's SMatch arm captures the set; anchor = scrutinee span
            # start). Match arm bodies + guards lower inside per-arm
            # nl_snapshot/nl_restore scopes (lower_match.gg); an in-arm CoW
            # rebind is reverted, so a bare-param mutation in an arm/guard
            # is thrown away without this hoist. Dominates every arm.
            materialize_scope_carried_bare_params(&ctx, &gmod, scrutinee.span.start)
            # Real SMatch lowering — delegates to lower_match_stmt for
            # the per-arm ctor / binding / guard scaffolding. Payload
            # binds of type Box[T] are consumed via EDeref → GIDeref
            # which emits a proper load.
            lower_match_stmt(&ctx, scrutinee, arms, &gmod, is_main)
        case SLoop(body):
            # Unconditional loop — `loop: body`, exit via break. Same
            # shape as `while true:`, but the body's default back-edge
            # jumps to the body itself rather than a condition header.
            # CoW 2G: hoist any loop-carried bare-param materialize into the
            # pre-header (current block) BEFORE the loop block + DSK_LOOP scope.
            # SLoop carries NO condition/iterable span, so anchor=0 degenerates
            # the scan negation to whole-fn membership (safe over-approximation:
            # the clone is idempotent per root, so a param mutated only before the
            # loop is already owned and skipped).
            materialize_loop_carried_bare_params(&ctx, &gmod, 0)
            int loop_bb = new_block(&ctx)
            int loop_exit_bb = new_block(&ctx)
            set_terminator(&ctx, GTJump(loop_bb))
            ctx.loop_continue_stack.push(loop_bb)
            ctx.loop_break_stack.push(loop_exit_bb)
            # Phase 2: open a Loop drop scope around the body. Locals
            # declared inside the body get cleaned up before the
            # back-edge / break-edge jumps fire.
            push_drop_scope(&ctx.drop_elab, DSK_LOOP)
            switch_to(&ctx, loop_bb)
            lower_stmts(&ctx, body, &gmod, is_main)
            Terminator loop_body_term = ctx.block_terms.get(ctx.current_block).unwrap()
            match loop_body_term:
                case GTNone():
                    # Natural body fall-off — emit Loop-scope drops
                    # before the back-edge jump.
                    pop_drop_scope(&ctx)
                    set_terminator(&ctx, GTJump(loop_bb))
                else:
                    # Body already broke / continued / returned. Those
                    # paths emitted their own drops; just pop the scope
                    # bookkeeping without re-emitting.
                    pop_drop_scope_no_emit(&ctx)
            ctx.loop_continue_stack.pop()
            ctx.loop_break_stack.pop()
            switch_to(&ctx, loop_exit_bb)
        case SCompoundAssign(target_expr, op, value_expr):
            # #37 Phase 2 hook 5 (SCompoundAssign target root): same
            # materialize-before-mutate as the SAssign hook. Note: a
            # compound on a family MEMBER (`s += x`) never reaches a lazy
            # state (a written bound name fails the bound-name-pristine
            # eligibility gate); a collection-root compound (`v[i] += x`)
            # now lowers via lower_index_compound_assign (the EIndex arm
            # below) and the hook fires for it too (class-rule completeness).
            if ctx.cow_lazy_members.len() > 0:
                cow_lazy_materialize_family(&ctx, cow_source_root_name(target_expr))
            # x <op>= y  →  x = x <op> y. Lower per target shape: local
            # identifier goes through GIAssign, field access goes through
            # __field_read + binop + __field_write.
            match target_expr.expr:
                case EIdentifier(name):
                    # Shared-variable compound-assign: kind-dispatched via
                    # emit_shared_compound (native atomic add/sub; single
                    # write-lock RMW for rwlock; lock-get→op→lock-set for
                    # mutex). Mirrors Rust gg's compound dispatch
                    # (`stmts/assigns.rs:1015-1105`).
                    if ctx.shared_locals.contains(name):
                        SharedLocalInfo sca_sh = ctx.shared_locals.get(name).unwrap()
                        int sca_rhs = lower_expr(&ctx, value_expr, &gmod)
                        int sca_dst = emit_shared_compound(&ctx, &gmod, sca_sh, op, sca_rhs)
                        if sca_sh.facade_local >= 0:
                            emit(&ctx, GIAssign(sca_sh.facade_local, OpCopy(sca_dst)))
                        return
                    if nl_contains(&ctx, name):
                        int lid = nl_get(&ctx, name)
                        int lhs_full_type = ctx.locals.get(lid).unwrap().type_id
                        # `&`/`!`-param compound-assign (`x += 1` on `int &x`)
                        # is broken on BOTH legs: the slot holds a `T*`, so a
                        # bare read of `lid` consumes the POINTER bits (the
                        # binop would do arithmetic on the pointer) AND the
                        # GIAssign write-back clobbers the pointer slot. Detect
                        # `GtMutPtr(inner)`: deref-load the current value before
                        # the binop, run the binop at the INNER type, and store
                        # the result back THROUGH the pointer via GIDerefStore.
                        int cmp_inner_ty = -1
                        if lhs_full_type >= PRIM_COUNT and lhs_full_type < gmod.type_table.len():
                            match gmod.type_table.get(lhs_full_type).unwrap():
                                case GtMutPtr(cmp_inner):
                                    cmp_inner_ty = cmp_inner
                                else:
                                    pass
                        if cmp_inner_ty >= 0:
                            # `&`-param path: read `*lid` into a value temp.
                            int cmp_cur = add_local(&ctx, cmp_inner_ty, None)
                            emit(&ctx, GIDeref(cmp_cur, lid, cmp_inner_ty))
                            int cmp_rhs = lower_expr(&ctx, value_expr, &gmod)
                            int cmp_dst = add_local(&ctx, cmp_inner_ty, None)
                            emit_compound_arith(&ctx, op, cmp_dst, cmp_cur, cmp_rhs, cmp_inner_ty, &gmod)
                            emit(&ctx, GIDerefStore(lid, op_consume(&ctx, &gmod, cmp_dst, CkAssign()), cmp_inner_ty))
                        else:
                            int lhs_type = lhs_full_type
                            int lhs_val = add_local(&ctx, lhs_type, None)
                            emit(&ctx, GIAssign(lhs_val, op_consume(&ctx, &gmod, lid, CkAssign())))
                            int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                            int op_dst = add_local(&ctx, lhs_type, None)
                            # R42-A: user operator-overload compound-assign
                            # (`a += b` on a struct/enum with `equip X with Add`)
                            # is dispatched INSIDE emit_compound_arith (Core #4
                            # "centralize at the producer"), so this and every
                            # other emit_compound_arith caller gets it uniformly.
                            emit_compound_arith(&ctx, op, op_dst, lhs_val, rhs_val, lhs_type, &gmod)
                            emit(&ctx, GIAssign(lid, op_consume(&ctx, &gmod, op_dst, CkAssign())))
                    elif static_contains(&gmod, name):
                        # Module-level mutable-static COMPOUND-assign
                        # (`STATIC += y` → `STATIC = STATIC <op> y`). Read the
                        # current value via `lower_expr` (routes through
                        # `lower_static_ref_ident` → `__global_ref__` load), run
                        # the binop at the static's type, then store the result
                        # back THROUGH the global-address pointer that
                        # `lower_place_base` yields. Mirrors Rust gg's compound
                        # assign into a static (assigns.rs:1120-1146).
                        int csty = static_lookup_type(&gmod, name)
                        int clhs_val = lower_expr(&ctx, target_expr, &gmod)
                        int crhs_val = lower_expr(&ctx, value_expr, &gmod)
                        int cop_dst = add_local(&ctx, csty, None)
                        emit_compound_arith(&ctx, op, cop_dst, clhs_val, crhs_val, csty, &gmod)
                        int csptr = lower_place_base(&ctx, target_expr, &gmod)
                        emit(&ctx, GIDerefStore(csptr, op_consume(&ctx, &gmod, cop_dst, CkAssign()), csty))
                case EFieldAccess(base_box, field_name):
                    # self.field <op>= value
                    # Lower as: self.field = self.field <op> value.
                    # Read via lower_expr on the original field-access
                    # expression (reuses __field_read), binop, field write.
                    # #1 (matcluster): PROJECTED compound field-store
                    # (`v[i].f += x`, `o.inner.f += x`) through a bare param
                    # materializes the immutable-in-context ROOT first (caller
                    # untouched) — exact mirror of the SAssign EFieldAccess arm
                    # (:1023) and Rust assigns.rs compound FieldAccess arm. Must
                    # run BEFORE the :1246 field read so it reads the private
                    # copy. A `&self`/owned root is skipped by the helper.
                    cow_materialize_projected_root(&ctx, &gmod, target_expr)
                    int lhs_val = lower_expr(&ctx, target_expr, &gmod)
                    int lhs_type = ctx.locals.get(lhs_val).unwrap().type_id
                    int rhs_val = lower_expr(&ctx, value_expr, &gmod)
                    int op_dst = add_local(&ctx, lhs_type, None)
                    emit_compound_arith(&ctx, op, op_dst, lhs_val, rhs_val, lhs_type, &gmod)
                    # Wrap op_dst in a synthetic SpannedExpr to feed the
                    # same field-write path used above.
                    emit_field_write_from_local(&ctx, *base_box, field_name, op_dst, &gmod)
                case EIndex(base_box, idx_box):
                    # v[i] OP= x / d[k] OP= x — desugar to read-binop-write on
                    # the collection, evaluating base+idx once. Mirrors Rust
                    # lower_compound_assign's Expr::Index arm (assigns.rs:1345).
                    # #1 (matcluster): a bare-param root (`xs[i] += x`,
                    # `s.counts[i] += x`) materializes the root collection FIRST
                    # (caller untouched) — exact mirror of the SAssign EIndex arm
                    # (:1032) with `target_expr` (NOT inside
                    # lower_index_compound_assign — no target_expr there). A
                    # `&`/owned root is skipped by the helper.
                    cow_materialize_projected_root(&ctx, &gmod, target_expr)
                    lower_index_compound_assign(&ctx, *base_box, *idx_box, op, value_expr, &gmod)
                else:
                    lower_fail("SCompoundAssign target is neither EIdentifier, EFieldAccess, nor EIndex (got: " + expr_kind(target_expr.expr) + ")")
        case SFor(pat, iter_expr, body, _own, else_body):
            lower_for(&ctx, pat, iter_expr, body, else_body, &gmod, is_main)
        case SThrow(throw_expr):
            lower_throw_stmt(&ctx, throw_expr, &gmod)
        case SOnError(cleanup_body):
            # Register the cleanup block — emitted on error-exit paths
            # (throw / rethrow error return). Mirrors Rust's
            # `Stmt::OnError` push at `stmts/mod.rs:342`.
            ctx.on_error_blocks.push(cleanup_body)
        case SWith(with_resource, with_name, with_body):
            # ── Shared-variable `with x:` form (round-16 Phase 1) ────────
            # `with x:` where x is a `shared` var acquires the carrier's lock
            # for the block, providing FRESHNESS (not atomicity across awaits
            # — that's Phase 2). Phase-1 callees inside the block have no inner
            # await, so the lock is held for the whole block: lock at entry,
            # run the body (reads of x re-lock; safe — pthread recursive? no:
            # we DROP the guard before the body so per-read locks don't
            # deadlock), drop at exit. The block body runs in a fresh drop
            # scope so its locals clean up. Mirrors Rust gg's `with`-shared
            # lowering (the freshness contract, book/14-concurrency.md). The
            # parser routes a bare `with ident:` to SWith(EIdentifier(ident),
            # ident, body) (parser.gg:513), so detect the shared form by the
            # resource being a shared-var identifier.
            match with_resource.expr:
                case EIdentifier(sw_name):
                    if ctx.shared_locals.contains(sw_name):
                        # Re-bind the facade to a FRESH locked read at block
                        # entry (the freshness point), then lower the body. Each
                        # `x` read inside re-locks (correct + race-free); the
                        # lock is NOT held across the body so a nested per-read
                        # lock cannot self-deadlock on the non-recursive mutex.
                        SharedLocalInfo sw_sh = ctx.shared_locals.get(sw_name).unwrap()
                        int sw_fresh = emit_shared_read(&ctx, &gmod, sw_sh)
                        if sw_sh.facade_local >= 0:
                            emit(&ctx, GIAssign(sw_sh.facade_local, OpCopy(sw_fresh)))
                        push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
                        lower_stmts(&ctx, with_body, &gmod, is_main)
                        pop_drop_scope(&ctx)
                        return
                else:
                    pass
            # R9 FIDELITY — `with <allocator>: as name:`-block lowering.
            # Mirrors Rust gg's `lower_with` (`src/ir/lowering/stmts/mod.rs:
            # 2732-2849`), single-binding. Before this, SWith hit the `else`
            # fall-through → lower_fail → the whole body was silently DROPPED.
            #
            # The `with` block is linear control flow (no new basic blocks):
            # construct the resource, push it as the active thread-local
            # allocator, run the body inside a fresh block drop-scope, then
            # pop the scope (dropping body locals while the allocator is still
            # alive — avoids UAF), pop the allocator, and destroy it.
            #
            # SCOPED to allocator `with`-blocks whose body uses VALUE methods.
            # Detection of the allocator-constructor shape mirrors Rust's
            # `is_allocator_constructor` (`stmts/mod.rs:2609`) via the
            # runtime-name map.
            #
            # Step 1 — lower the resource expr (routes through Root A's
            # allocator-constructor interception → `gorget_<kind>_new`,
            # yielding a `GtPtr(Named(kind))` local). Bind the with-name.
            String with_alloc_kind = ""
            match with_resource.expr:
                case ECall(with_callee_box, _, _):
                    SpannedExpr with_callee = *with_callee_box
                    match with_callee.expr:
                        case EIdentifier(with_ctor_name):
                            if allocator_constructor_runtime_name(with_ctor_name) != "":
                                with_alloc_kind = with_ctor_name
                        else:
                            pass
                else:
                    pass
            # round-16 Phase-2: capture whether `with <name>:` binds a
            # mutable-borrow PARAM, and the param's local id, BEFORE lowering the
            # resource + rebinding the name (the `nl_put` below shadows the param
            # with the with-binding, so a later `nl_get(name)` would no longer
            # see the param).
            int wr_param_local = -1
            match with_resource.expr:
                case EIdentifier(wr_name):
                    if nl_contains(&ctx, wr_name):
                        int wr_cand = nl_get(&ctx, wr_name)
                        if is_mut_borrow_param_local(&ctx, &gmod, wr_cand):
                            wr_param_local = wr_cand
                else:
                    pass
            int with_val = lower_expr(&ctx, with_resource, &gmod)
            int with_ty = ctx.locals.get(with_val).unwrap().type_id
            int with_local = add_local(&ctx, with_ty, Some(with_name))
            # ⚠ MUST nl_put to bind the identifier: add_local only appends to
            # ctx.locals, it does NOT bind the name. Body refs (`pool.…`)
            # resolve via nl_get; SVarDecl binds the same way. Without this
            # the body method calls resolve to `…__bytes_used(0)`.
            emit(&ctx, GIAssign(with_local, op_consume(&ctx, &gmod, with_val, CkAssign())))
            nl_put(&ctx, with_name, with_local)
            # round-16 Phase-2: record the (binding_local, param_local) refresh
            # pair captured above. When this function is later transformed into
            # `__shared_async_<f>` the param becomes the shared carrier; after each
            # lock-reacquire the post-pass re-reads the binding from the freshly-
            # derived facade (the freshness contract, book/14-concurrency.md).
            # This is the ONLY path that makes the `with counter:` block see
            # `main`'s write across the sleep. Mirrors Rust gg's `with_refresh_pairs`
            # recording at SWith lowering (`shared_async.rs:239`).
            if wr_param_local >= 0:
                ctx.with_refresh_pairs.push(with_local)
                ctx.with_refresh_pairs.push(wr_param_local)
            # Allocator local is `GtPtr(Named(kind))` — is_droppable_type
            # returns false for Ptr slots, so register_local_for_drop skips
            # it (no double-free; the manual destroy below is sole cleanup).
            register_local_for_drop(&ctx, with_local, with_ty, &gmod)
            # Step 2 — push as the active thread-local allocator.
            if with_alloc_kind != "":
                Vector[Operand] with_push_args = []
                with_push_args.push(OpCopy(with_local))
                emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", with_push_args))
            # Step 3 — lower the body inside a fresh block drop-scope so locals
            # declared in the body are cleaned up at block exit (canonical
            # block pattern, mirrors lower_if's then-branch).
            push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
            lower_stmts(&ctx, with_body, &gmod, is_main)
            # Step 4 — body locals drop FIRST (while the allocator is alive),
            # then pop + destroy the allocator (mirrors lower_with:2826-2847).
            pop_drop_scope(&ctx)
            # Step 5 — pop the active allocator + destroy the handle.
            if with_alloc_kind != "":
                emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
                String with_destroy_fn = allocator_type_destroy_name(with_alloc_kind)
                if with_destroy_fn != "":
                    Vector[Operand] with_destroy_args = []
                    with_destroy_args.push(OpCopy(with_local))
                    emit(&ctx, GICallExtern(-1, with_destroy_fn, with_destroy_args))
        case SAssert(assert_cond, assert_msg_opt):
            # R11: lower an assert to a conditional panic — mirrors Rust's
            # lower_assert simple path (src/ir/lowering/stmts/mod.rs:2358-2385).
            # Without this, SAssert hit `else: lower_fail` and was SILENTLY
            # DROPPED (the assert + a [lower_fail] comment; the body continued).
            #
            # `directive strip-asserts` makes asserts no-ops — emit NOTHING
            # (no blocks, no branch), mirroring Rust's early-return
            # (stmts/mod.rs:2293-2296). Guarding the WHOLE body (not just the
            # condition eval) is required: otherwise `assert false` under
            # strip-asserts would still panic (regresses use_strip_asserts),
            # and a stripped condition would leave assert_cv unbound.
            if not gmod.strip_asserts:
                int assert_cv = lower_expr(&ctx, assert_cond, &gmod)
                int assert_pass_bb = new_block(&ctx)
                int assert_fail_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(assert_cv), assert_pass_bb, assert_fail_bb))
                switch_to(&ctx, assert_fail_bb)
                # Default panic message. For a comparison condition with no
                # user message, mirror Rust's rich form `assertion failed:
                # left <op> right` (generate_assert_static_msg,
                # stmts/mod.rs:2712) so `@should_panic("left == right")` matches.
                String assert_msg = "assertion failed"
                match assert_cond.expr:
                    case EBinaryOp(_a_lhs, a_op, _a_rhs):
                        if a_op == "==" or a_op == "!=" or a_op == "<" or a_op == ">" or a_op == "<=" or a_op == ">=":
                            assert_msg = "assertion failed: left " + a_op + " right"
                    else:
                        pass
                match assert_msg_opt:
                    case Some(am):
                        assert_msg = am
                    case None:
                        pass
                # D11 trap normalization (was gorget_panic): a failing assert
                # traps as trap[T_AssertFailed] + exit 101. The T_ code is a cstr
                # literal prepended to the message. Mirrors Rust gg
                # src/ir/lowering/stmts/mod.rs (gorget_trap(T_AssertFailed, msg)).
                emit(&ctx, GICallExtern(-1, "gorget_trap", [OpConstStr("T_AssertFailed"), OpConstStr(assert_msg)]))
                # gorget_panic is noreturn; this jump is a DEAD edge that keeps
                # the CFG well-formed (Terminator has no GTUnreachable — Rust
                # uses unreachable(); GTJump(pass_bb) is the faithful self-host
                # equivalent, mirroring the merge-jump idiom at lower.gg:4285).
                set_terminator(&ctx, GTJump(assert_pass_bb))
                switch_to(&ctx, assert_pass_bb)
        case SItem(item):
            # Function-LOCAL `const` declarations parse as
            # `SItem(IConstDecl(ty, name, val))` (parser.gg:2802/3844). Before
            # this arm they hit `else: lower_fail("…SItem")` and were SILENTLY
            # DROPPED — every later reference to the const name then fell
            # through EIdentifier to the `OpConstI64(0)` placeholder (WRONG),
            # so `const int LOCAL = 42; print(LOCAL)` printed 0.
            #
            # A local const is an immutable local binding: lower its literal
            # init to a value and bind the NAME to that local id (the same
            # nl_put mechanism SVarDecl / SWith use). The init is always a
            # compile-time literal/const-expr, so lower_expr handles every
            # value kind (int/bool/float/String/char) directly. Mirrors Rust's
            # local-const = `DefKind::Const` folded at use; here we materialize
            # the value once and alias the name to it.
            match item:
                case IConstDecl(_, lc_name, lc_val):
                    int lc_local = lower_expr(&ctx, lc_val, &gmod)
                    nl_put(&ctx, lc_name, lc_local)
                else:
                    lower_fail("unhandled Item in lower_stmt SItem")
        case SNamedScope(_name, ns_body):
            # `label: <body>` named scope. The label is a break/continue
            # TARGET, NOT a new binding — typecheck (typecheck.gg:1173) just
            # recurses through the body without binding the name. Before this
            # arm SNamedScope hit `else: lower_fail` and the ENTIRE named-scope
            # body was SILENTLY DROPPED (`outer:`/`inner:` blocks vanished).
            #
            # A named scope is a block scope (linear control flow): snapshot
            # the name→local map so body bindings don't leak past the scope,
            # open a Block drop scope so body locals are cleaned up at exit,
            # lower the body, drop the scope (no-emit if the body already
            # terminated via return/break — those emitted their own drops),
            # then restore the name map. Mirrors Rust's `lower_named_scope`
            # (src/ir/lowering/stmts/mod.rs:2878) + the SWith block pattern.
            #
            # Planner consumer #1 (SH mirror): SUBTREE-scoped pre-scope
            # bare-param materialize -- nl_restore below reverts an in-body
            # CoW rebind, so a bare-param mutation in the named scope is
            # thrown away without this hoist. SNamedScope carries no span;
            # anchor = stmts_first_pos(body), the SAME shared helper the
            # walker's push uses (keying cannot drift).
            materialize_scope_carried_bare_params(&ctx, &gmod, stmts_first_pos(ns_body))
            Dict[String, int] ns_snapshot = nl_snapshot(&ctx)
            push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
            lower_stmts(&ctx, ns_body, &gmod, is_main)
            Terminator ns_term = ctx.block_terms.get(ctx.current_block).unwrap()
            match ns_term:
                case GTNone():
                    pop_drop_scope(&ctx)
                else:
                    pop_drop_scope_no_emit(&ctx)
            nl_restore(&ctx, ns_snapshot)
        else:
            lower_fail("unhandled in lower_stmt: " + stmt_kind(stmt))

# Lower `shared[(<override>)] T x = <init>`. Mints the hidden sync carrier
# for the resolved strategy + a facade local bound to `name`, and records a
# SharedLocalInfo (with its typed `kind`) in ctx.shared_locals for the
# read/write facade + spawn deferral. Mirrors Rust gg's strategy arms of
# `lower_shared_var_decl` (`src/ir/lowering/stmts/mod.rs:1449-1640`):
#   SHK_MUTEX  (auto): tmp → Mutex__c__new(tmp) → Shared__Mutex__c__new(mutex)
#   SHK_RWLOCK       : tmp → RWLock__c__new(tmp)   (both guard types forced)
#   SHK_ATOMIC       : tmp → gorget_atomic_{int,bool}_new(tmp)
# then in all arms: carrier hidden local (drop-registered) + facade seeded
# from a kind-dispatched read.
void lower_shared_var_decl(LowerCtx &ctx, String name, SpannedExpr init_expr, int inner_ty, int shared_kind, GirModule &gmod):
    String inner_c = type_id_to_name(inner_ty, &gmod)
    String mutex_mangled = "Mutex__" + inner_c
    String guard_mangled = "Guard__" + inner_c
    String shared_mangled = "Shared__Mutex__" + inner_c
    # 1. Lower the init value (a plain scalar).
    int prev_et = ctx.expected_type
    ctx.expected_type = inner_ty
    int shv_init = lower_expr(&ctx, init_expr, &gmod)
    ctx.expected_type = prev_et
    # 2-3. Mint the hidden carrier per strategy.
    int carrier_ty = -1
    int shv_carrier = -1
    if shared_kind == SHK_RWLOCK:
        # carrier = RWLock__c__new(init) → gorget_rwlock_new(sizeof(T), &init).
        # register_rwlock_carrier_type registers BOTH guard named types (the
        # R2 both-typedefs rule — see the helper's comment).
        String rw_mangled = "RWLock__" + inner_c
        mutex_mangled = rw_mangled
        guard_mangled = "ReadGuard__" + inner_c
        shared_mangled = ""
        carrier_ty = register_rwlock_carrier_type(&gmod, inner_c)
        shv_carrier = add_local(&ctx, carrier_ty, None)
        emit(&ctx, GICall(shv_carrier, rw_mangled + "__new", [op_consume(&ctx, &gmod, shv_init, CkCallArgBorrow())]))
    elif shared_kind == SHK_ATOMIC:
        # carrier = gorget_atomic_{int,bool}_new(init) — by-value ctor, no
        # sizeof/address shaping needed.
        mutex_mangled = ""
        guard_mangled = ""
        shared_mangled = ""
        carrier_ty = register_atomic_carrier_type(&gmod, inner_ty)
        shv_carrier = add_local(&ctx, carrier_ty, None)
        emit(&ctx, GICallExtern(shv_carrier, atomic_runtime_prefix(inner_ty) + "_new", [OpCopy(shv_init)]))
    else:
        # SHK_MUTEX: mutex_val = Mutex__c__new(init) → gorget_mutex_new(
        # sizeof(T), &init); carrier = Shared__Mutex__c__new(mutex_val).
        carrier_ty = register_shared_carrier_type(&gmod, inner_c)
        int shv_mutex_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, mutex_mangled))
        int shv_mutex = add_local(&ctx, shv_mutex_ty, None)
        emit(&ctx, GICall(shv_mutex, mutex_mangled + "__new", [op_consume(&ctx, &gmod, shv_init, CkCallArgBorrow())]))
        shv_carrier = add_local(&ctx, carrier_ty, None)
        emit(&ctx, GICall(shv_carrier, shared_mangled + "__new", [OpCopy(shv_mutex)]))
    nl_put(&ctx, "__shared_carrier_" + name, shv_carrier)
    # Register the carrier for drop at its BIRTH (Core #3):
    #   SHK_MUTEX  → gorget_shared arm (gorget_shared_mutex_drop, refcount)
    #   SHK_RWLOCK → gorget_rwlock arm (gorget_rwlock_free, single-owner)
    #   SHK_ATOMIC → gorget_atomic_{int,bool} arm (single-owner free)
    # all via register_owning_opaque_local's typed method-prefix gate +
    # drop_fn_for_type's matching arms (the two MUST stay in lockstep).
    register_owning_opaque_local(&ctx, shv_carrier, carrier_ty, &gmod)
    # 4. Build the SharedLocalInfo + a facade local seeded from a read.
    int shv_order = ctx.shared_decl_counter
    ctx.shared_decl_counter = ctx.shared_decl_counter + 1
    SharedLocalInfo shv_info = SharedLocalInfo(-1, shv_carrier, inner_ty, carrier_ty, inner_c.clone(), mutex_mangled.clone(), guard_mangled.clone(), shared_mangled.clone(), shv_order, shared_kind)
    int shv_facade_val = emit_shared_read(&ctx, &gmod, shv_info)
    int shv_facade = add_local(&ctx, inner_ty, Some(name))
    emit(&ctx, GIAssign(shv_facade, OpCopy(shv_facade_val)))
    nl_put(&ctx, name, shv_facade)
    # Finalize the info with the facade local + store in the carrier table.
    SharedLocalInfo shv_final = SharedLocalInfo(shv_facade, shv_carrier, inner_ty, carrier_ty, inner_c.clone(), mutex_mangled.clone(), guard_mangled.clone(), shared_mangled.clone(), shv_order, shared_kind)
    ctx.shared_locals.put(name.clone(), shv_final)

# Lower the BASE of a place projection (field access, index, method
# receiver) to its local id WITHOUT the value-read auto-deref. A bare
# `EIdentifier` naming a local resolves directly to its slot — for a
# `&`/`!` param (`GtMutPtr`) or bare-resource param (`GtPtr`) that slot
# holds the POINTER, which is exactly what the field/index/method
# codegen needs (`((T*)base)->field`). Going through `lower_expr` here
# would trip Edit-1's value-read deref and hand back a dereffed VALUE
# copy, so a field write would update a discarded temp. Mirrors Rust gg,
# where place lowering (assigns.rs) keeps the base local + a Deref
# projection and never routes through the value-operand deref
# (exprs/mod.rs:140). Non-identifier bases (nested field access, calls,
# etc.) fall back to `lower_expr` unchanged.
int lower_place_base(LowerCtx &ctx, SpannedExpr base_expr, GirModule &gmod):
    match base_expr.expr:
        case EIdentifier(name):
            if nl_contains(&ctx, name):
                return nl_get(&ctx, name)
            # static-as-place — emit a Ptr alias to the global so a method
            # receiver / field-write / index base mutates the REAL static,
            # not a value copy. A GtMutPtr slot makes lir_lower store the
            # global's address directly (no load/copy).
            if static_contains(&gmod, name):
                int sty = static_lookup_type(&gmod, name)
                int pty = register_type(&gmod, GtMutPtr(sty))
                int pdst = add_local(&ctx, pty, None)
                Vector[Operand] no_args = []
                emit(&ctx, GICallExtern(pdst, "__global_ref__" + name, no_args))
                return pdst
        case EDeref(inner_box):
            # `(*b).field = X` place-base. The box VALUE is itself the heap
            # pointer (Box__T is `typedef void*`); returning the box LOCAL
            # (NOT `lower_expr(*b)` which emits a GIDeref value-LOAD into a
            # stack copy → the field-write mutated the copy, Snag #26) keeps
            # the place a POINTER. `lower_field_write` then re-points
            # `base_type_name` to the inner via `box_deref_inner_name` and the
            # `__field_write_` arg-prep loads the box pointer (lir_slot_is_box,
            # lir_lower.gg:3265) → `((T*)box)->field = X`, in place. Mirrors
            # Rust assigns.rs:504-557 (the `Expr::Deref` lvalue place, a
            # `Projection::Deref` on the inner box place).
            int dpb_box = lower_expr(&ctx, *inner_box, &gmod)
            int dpb_tid = ctx.locals.get(dpb_box).unwrap().type_id
            String dpb_tname = type_id_to_name(dpb_tid, &gmod)
            match box_deref_inner_name(dpb_tname, &gmod):
                case Some(_):
                    return dpb_box
                case None:
                    pass
            return dpb_box
        else:
            pass
    return lower_expr(&ctx, base_expr, &gmod)

# Field-WRITE place base — the write-only extension of `lower_place_base`.
# A field store whose object is a Vector INDEX element (`v[i].field = x`,
# `PTS[i].field += n`) must resolve the ELEMENT to a WRITE-THROUGH pointer (an
# alias INTO the collection's heap buffer), else the store lands on a throwaway
# VALUE COPY (`gorget_array_get` typed as the bare element) and is silently LOST
# (wave-0 gap B). Mirrors Rust gg's `try_resolve_field_place` Index arm
# (src/ir/lowering/exprs/mod.rs:2553-2595): force the element `Ptr(T)` for BOTH
# value-struct AND resource elements.
#
# ⚠ WHY a WRITE-ONLY producer, not the shared `lower_place_base`: that resolver
# is ALSO called by the method-RECEIVER arm (lower_expr.gg:3289), the field-READ
# arm (:4582), and the hasher (:3932). A value-struct method receiver like
# `rs[i].clone()` must stay a VALUE — `.clone()` on a Copy-ish value struct is
# ELIDED to identity and returns the receiver directly, so a pointer receiver
# would assign a raw `void*` into the destination value slot (cc: "incompatible
# types … from void *"). Rust scopes its element-pointer to field PLACES for the
# same reason. Field READS stay value-copy here too: reading a field FROM a copy
# is correct (non-mutating), and the compound-store read leg reads the current
# value while only the write-back needs the pointer. So the pointer is minted
# ONLY at the two field-write call sites (`lower_field_write` /
# `emit_field_write_from_local`). Track 1C (Dict/Set) and 2F (nested `&`) extend
# THIS producer.
int lower_field_place_base(LowerCtx &ctx, SpannedExpr base_expr, GirModule &gmod):
    match base_expr.expr:
        case EIndex(fpb_base_box, fpb_idx_box):
            # Lower the collection base via the SHARED `lower_place_base` (a
            # static resolves to a `GtMutPtr` through `__global_ref__`, a
            # `&self`/`&param` to its `GtPtr`), then consume it with the
            # is_ptr_type→OpCopy idiom below — NEVER `lower_expr` (a static
            # through `lower_expr` yields a value slot whose address is a
            # pointer-to-pointer).
            int fpb_base = lower_place_base(&ctx, *fpb_base_box, &gmod)
            int fpb_base_tid = ctx.locals.get(fpb_base).unwrap().type_id
            String fpb_base_name = type_id_to_name(fpb_base_tid, &gmod)
            # Unwrap a Ptr/MutPtr base (param / static via __global_ref__ /
            # self.field) to the collection name.
            if fpb_base_tid >= 0 and fpb_base_tid < gmod.type_table.len():
                GirType fpb_bt = gmod.type_table.get(fpb_base_tid).unwrap()
                match fpb_bt:
                    case GtPtr(fpb_inner):
                        fpb_base_name = type_id_to_name(fpb_inner, &gmod)
                    case GtMutPtr(fpb_inner2):
                        fpb_base_name = type_id_to_name(fpb_inner2, &gmod)
                    else:
                        pass
            # Collection-kind gate → the element/value pointer-getter. CkVector/
            # CkDeque resolve the element via `gorget_array_get`; CkDict resolves
            # the VALUE slot via `gorget_map_get` (Track 1C — a pointer INTO the
            # map's value buffer, exactly the write-through target the array arm
            # gets from `gorget_array_get`). Set / user-Index fall through to the
            # shared resolver unchanged (a set's element IS its key — no
            # addressable value slot; `gorget_map_get` returns a sentinel in
            # set-mode). Dispatch via the typed `collection_kind`, never a name
            # match — a `gorget_array_get` on a Map base would be UB.
            String fpb_getter = ""
            match resource_meta_for(&gmod, fpb_base_name):
                case Some(fpb_rmeta):
                    match fpb_rmeta.collection_kind:
                        case CkVector():
                            fpb_getter = "gorget_array_get"
                        case CkDeque():
                            fpb_getter = "gorget_array_get"
                        case CkDict():
                            fpb_getter = "gorget_map_get"
                        else:
                            pass
                case None:
                    pass
            if fpb_getter != "":
                # Element type NAME → id via the SAME `index_value_type_name`
                # helper the read/compound arms use (one source of truth).
                String fpb_elem_name = index_value_type_name(fpb_base_name)
                if fpb_elem_name != "":
                    String fpb_elem_norm = fpb_elem_name
                    if fpb_elem_name == "Str":
                        fpb_elem_norm = "GorgetString"
                    int fpb_elem_tid = resolve_field_gir_type(fpb_elem_norm, &gmod)
                    # Only struct/resource elements (>= PRIM_COUNT) get the
                    # pointer — a field store needs a struct-ish element. Scalar
                    # (< PRIM_COUNT) and unregistered (< 0) fall through (a scalar
                    # has no field to write through).
                    if fpb_elem_tid >= PRIM_COUNT:
                        # Index is independently typed — clear any leaked
                        # expected_type (mirror the read / index-assign arms).
                        int fpb_saved_expected = ctx.expected_type
                        ctx.expected_type = -1
                        int fpb_idx = lower_expr(&ctx, *fpb_idx_box, &gmod)
                        ctx.expected_type = fpb_saved_expected
                        fpb_idx = maybe_auto_propagate(&ctx, fpb_idx, &gmod)
                        # Consume the base with the ptr-or-borrow idiom (static →
                        # GtMutPtr → OpCopy the pointer value; value slot →
                        # OpBorrow its address), exactly as lower_index_assign's
                        # setter call does — NEVER OpBorrow a ptr slot (that is a
                        # pointer-to-pointer).
                        Operand fpb_base_op = OpBorrow(fpb_base)
                        if is_ptr_type(fpb_base_tid, &gmod):
                            fpb_base_op = OpCopy(fpb_base)
                        # dst = gorget_array_get(base, idx) typed GtPtr(elem) +
                        # LoBorrowed — a pointer INTO the buffer. The GtPtr dst
                        # makes lir_lower emit a plain ISlotStore of the raw
                        # pointer (NOT the bare-aggregate `*(StructT*)` copy-out
                        # that is gap B). LoBorrowed keeps the element ptr out of
                        # drop-tracking (a LoOwned dst would drop-register the
                        # buffer element → double-free — this is the ASan gate's
                        # #1 risk). idx is OpBorrow (the read never consumes;
                        # matches the read/compound arms).
                        int fpb_ptr_tid = register_ptr(&gmod, fpb_elem_tid)
                        int fpb_dst = add_local_with(&ctx, fpb_ptr_tid, None, LoBorrowed(), BoNone())
                        Vector[Operand] fpb_args = [fpb_base_op, OpBorrow(fpb_idx)]
                        emit(&ctx, GICallExtern(fpb_dst, fpb_getter, fpb_args))
                        return fpb_dst
        else:
            pass
    return lower_place_base(&ctx, base_expr, &gmod)

# Lower `base.field = value_expr`. Emits GICallExtern for the codegen-side
# __field_write_TYPE_FIELD helper which expands to `((T*)base)->field = value`.
void lower_field_write(LowerCtx &ctx, SpannedExpr base_expr, String field_name, SpannedExpr value_expr, GirModule &gmod):
    # Field WRITE: an Index-element base (`v[i].f = x`) resolves to a
    # write-through element pointer (Track 1B) — see lower_field_place_base.
    int base = lower_field_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    # Unwrap Ptr/MutPtr to get the inner type name.
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    # Box[T] field write: `(*b).field = v` — the place-base returned the box
    # LOCAL (Box__T = `typedef void*`, holding the heap pointer). Re-point
    # `base_type_name` to the inner T so `write_fn` is `__field_write_T_field`
    # and the `__field_write_` arg-prep loads the box pointer (lir_slot_is_box,
    # lir_lower.gg:3265) → `((T*)box)->field = v`, mutating the heap in place.
    # `base` itself stays the box local. Sibling of the Guard re-point below;
    # Box-ness via the typed box_kind channel (box_deref_inner_name), NOT a
    # name-prefix test. Mirrors Rust assigns.rs:504-557.
    match box_deref_inner_name(base_type_name, &gmod):
        case Some(bx_inner):
            base_type_name = bx_inner
        case None:
            pass
    # Guard[T] field write: `g.field = v` where `g: Guard[T]` /
    # `ReadGuard[T]` / `WriteGuard[T]` must mutate the GUARDED data, not the
    # guard's own owner/ptr fields. Re-point `base` to the inner-data pointer
    # (`get_ptr(&g)`) and `base_type_name` to the guarded type — the write_fn
    # then becomes `__field_write_T_field` and the codegen emits
    # `((T*)inner_ptr)->field = v`, writing in place. Sibling of the read-side
    # arm in lower_expr EFieldAccess; mirrors Rust assigns.rs:661.
    match guard_field_deref_base(&ctx, base, base_type_name, &gmod):
        case Some(gdr):
            base = gdr.inner_ptr_local
            base_tid = ctx.locals.get(base).unwrap().type_id
            base_type_name = gdr.inner_name
        case None:
            pass
    # Expected-type propagation for the RHS, mirroring the EStructLiteral
    # field-init site (lower.gg:~5915-5924). Without it a bare `None`
    # field-store (`fm.desc = None`) lowers to an 8-byte `void*` default
    # slot — the field-write then `memcpy`s from a NULL/garbage source into
    # the Option slot → SEGV. Look the dest field's declared type up via
    # `gmod.type_infos` matched by field NAME (`base_type_name` is already
    # Ptr/MutPtr-unwrapped here), set `ctx.expected_type` under the same
    # I64/UNIT guard as the EStructLiteral site, lower, then RESTORE.
    int prev_expected_fw = ctx.expected_type
    if gmod.type_infos.contains(base_type_name):
        GirTypeInfo fw_ti = gmod.type_infos.get(base_type_name).unwrap()
        int fw_fi = 0
        while fw_fi < fw_ti.fields.len():
            GirFieldInfo fw_field = fw_ti.fields.get(fw_fi).unwrap()
            if fw_field.name == field_name:
                String fw_fty_name = fw_field.type_name.clone()
                if fw_fty_name != "":
                    int fw_fty = lookup_or_register_named(&gmod, fw_fty_name)
                    if fw_fty != I64_TYPE and fw_fty != UNIT_TYPE:
                        ctx.expected_type = fw_fty
            fw_fi += 1
    int val = lower_expr(&ctx, value_expr, &gmod)
    ctx.expected_type = prev_expected_fw
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # A field-store never consumes its base; it mutates in place via the
        # base's address. Borrowed base → OpBorrow; owned (LoOwned) base → also
        # OpBorrow (its slot address), NOT OpMove — an OpMove gets rewritten to
        # OpClone by the liveness pass when the base is live past the store,
        # which would clone-and-discard the base and never mutate the original.
        GirLocal fw_base_loc = ctx.locals.get(base).unwrap()
        match fw_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpBorrow(base))
    write_args.push(op_consume(&ctx, &gmod, val, CkFieldWrite()))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# Variant of lower_field_write that takes a pre-lowered local id for the
# value rather than re-lowering an expression.
void emit_field_write_from_local(LowerCtx &ctx, SpannedExpr base_expr, String field_name, int value_local, GirModule &gmod):
    # Field WRITE-BACK (compound `v[i].f += n`, pre-lowered value): same
    # write-through element pointer as lower_field_write (Track 1B).
    int base = lower_field_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_type_name = type_id_to_name(base_tid, &gmod)
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType bt = gmod.type_table.get(base_tid).unwrap()
        match bt:
            case GtPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                base_type_name = type_id_to_name(inner, &gmod)
            else:
                pass
    # Box[T] field write (compound-assign `(*b).x += 1` and other pre-lowered-
    # value field stores). Same in-place box re-point as lower_field_write —
    # re-point base_type_name to the inner so the store projects through the
    # box pointer, mutating the heap pointee not a stack copy.
    match box_deref_inner_name(base_type_name, &gmod):
        case Some(bx_inner):
            base_type_name = bx_inner
        case None:
            pass
    # Guard[T] field write (compound-assign `g.x += 1` and other pre-lowered-
    # value field stores). Same in-place guard-deref as lower_field_write —
    # re-point base to the guarded-data pointer so the store mutates the real
    # data, not the guard's own fields.
    match guard_field_deref_base(&ctx, base, base_type_name, &gmod):
        case Some(gdr):
            base = gdr.inner_ptr_local
            base_tid = ctx.locals.get(base).unwrap().type_id
            base_type_name = gdr.inner_name
        case None:
            pass
    String write_fn = "__field_write_" + base_type_name + "_" + field_name
    Vector[Operand] write_args = []
    bool base_is_ptr = is_ptr_type(base_tid, &gmod)
    if base_is_ptr:
        write_args.push(OpCopy(base))
    else:
        # A field-store never consumes its base; it mutates in place via the
        # base's address. Borrowed base → OpBorrow; owned (LoOwned) base → also
        # OpBorrow (its slot address), NOT OpMove — an OpMove gets rewritten to
        # OpClone by the liveness pass when the base is live past the store,
        # which would clone-and-discard the base and never mutate the original.
        GirLocal fwf_base_loc = ctx.locals.get(base).unwrap()
        match fwf_base_loc.ownership:
            case LoBorrowed():
                write_args.push(OpBorrow(base))
            else:
                write_args.push(OpBorrow(base))
    write_args.push(op_consume(&ctx, &gmod, value_local, CkFieldWrite()))
    emit(&ctx, GICallExtern(-1, write_fn, write_args))

# ── Control flow lowering ────────────────────────────────

void lower_stmts(LowerCtx &ctx, Vector[Stmt] stmts, GirModule &gmod, bool is_main):
    for stmt in stmts:
        lower_stmt(&ctx, stmt, &gmod, is_main)
        # #37 Phase 2: derivation-join view TEMPS die with their
        # statement — retire them so later mutation sites don't emit
        # guards for dead slots.
        cow_lazy_retire_stmt_temps(&ctx)

void lower_if(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] then_body, Vector[ElseBranch] elif_branches, GirModule &gmod, bool is_main):
    # Planner consumer #1: the pre-branch bare-param materialize runs at the
    # SIf DISPATCH ARM (`materialize_scope_carried_bare_params`, subtree-
    # scoped), NOT here — the dispatch-level union covers cond + elif-conds +
    # every branch body, so the elif RECURSION below needs no re-hoist.
    # The condition is bool-typed and independent of any enclosing
    # destination — clear `expected_type` around it so a leaked Result-typed
    # expectation doesn't make the centralized auto-prop hook's capture-form
    # check suppress a throws-call condition's peel (`if might():`).
    int saved_expected_if = ctx.expected_type
    ctx.expected_type = -1
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    ctx.expected_type = saved_expected_if
    # Auto-propagate a `throws` call used as the condition (`if might():`).
    cond = maybe_auto_propagate(&ctx, cond, &gmod)
    int then_bb = new_block(&ctx)
    int else_bb = new_block(&ctx)
    int merge_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
    # Then branch — Phase 2: open a Block drop scope per branch so
    # locals declared inside the branch get cleaned up at the merge
    # edge. Use pop_drop_scope_no_emit on early-exit branches (return/
    # break/continue already emitted their drops).
    switch_to(&ctx, then_bb)
    Dict[String, int] saved_then = nl_snapshot(&ctx)
    push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
    lower_stmts(&ctx, then_body, &gmod, is_main)
    # Only jump to merge if not already terminated (no return/break)
    Terminator then_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match then_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    nl_restore(&ctx, saved_then)
    # Else branch
    switch_to(&ctx, else_bb)
    Dict[String, int] saved_else = nl_snapshot(&ctx)
    push_drop_scope(&ctx.drop_elab, DSK_BLOCK)
    if elif_branches.len() > 0:
        ElseBranch eb = elif_branches.get(0).unwrap()
        match eb.condition:
            case Some(elif_cond):
                # elif branch — recurse
                Vector[ElseBranch] remaining = []
                int ebi = 1
                while ebi < elif_branches.len():
                    remaining.push(elif_branches.get(ebi).unwrap())
                    ebi = ebi + 1
                lower_if(&ctx, elif_cond, eb.body, remaining, &gmod, is_main)
            case None:
                # else branch
                lower_stmts(&ctx, eb.body, &gmod, is_main)
    Terminator else_term = ctx.block_terms.get(ctx.current_block).unwrap()
    match else_term:
        case GTNone():
            pop_drop_scope(&ctx)
            set_terminator(&ctx, GTJump(merge_bb))
        else:
            pop_drop_scope_no_emit(&ctx)
    nl_restore(&ctx, saved_else)
    switch_to(&ctx, merge_bb)


# Lower `base[idx] = value` as a collection-typed setter call. Vector
# routes to gorget_array_set; Dict / HashMap route to gorget_map_put;
# Set has no meaningful index-assign so falls through to lower_fail.
void lower_index_assign(LowerCtx &ctx, SpannedExpr base_expr, SpannedExpr idx_expr, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_tname = type_id_to_name(base_tid, &gmod)
    # Unwrap a Ptr/MutPtr base (param/static/self.field) to the collection
    # name so index_value_type_name can recover the element/value type
    # (mirrors the lower_index_compound_assign arm).
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType ia_bt = gmod.type_table.get(base_tid).unwrap()
        match ia_bt:
            case GtPtr(ia_inner):
                base_tname = type_id_to_name(ia_inner, &gmod)
            case GtMutPtr(ia_inner2):
                base_tname = type_id_to_name(ia_inner2, &gmod)
            else:
                pass
    # Resolve the collection's VALUE/element type so the value RHS is lowered
    # WITH that context. Without it `g["k"] = []` lowered the empty literal
    # with the Ptr-default `elem_size=8`, truncating 32-byte `Str` pushes
    # (empty output). Same value-type recovery the EIndex read + compound arm
    # use (index_value_type_name → resolve_field_gir_type) — one source of
    # truth for the Dict/HashMap value-suffix split. The INDEX stays
    # independently typed (expected_type=-1).
    String ia_elem_name = index_value_type_name(base_tname)
    String ia_elem_norm = ia_elem_name
    if ia_elem_name == "Str":
        ia_elem_norm = "GorgetString"
    int ia_elem_tid = -1
    if ia_elem_norm != "":
        int ia_resolved = resolve_field_gir_type(ia_elem_norm, &gmod)
        if ia_resolved >= 0:
            ia_elem_tid = ia_resolved
    # idx (int/key) + val (element) are independently typed, not the
    # surrounding context — clear any leaked `expected_type` so a Result-typed
    # expectation doesn't make the centralized auto-prop hook's capture-form
    # check suppress a throws-call idx/value's peel (`v[pick()] = might()`).
    # The idx lowers with no context; the val lowers WITH the resolved
    # collection value type so an empty `[]` gets the right element size.
    int saved_expected_ia = ctx.expected_type
    ctx.expected_type = -1
    int idx = lower_expr(&ctx, idx_expr, &gmod)
    ctx.expected_type = ia_elem_tid
    int val = lower_expr(&ctx, value_expr, &gmod)
    ctx.expected_type = saved_expected_ia
    idx = maybe_auto_propagate(&ctx, idx, &gmod)
    val = maybe_auto_propagate(&ctx, val, &gmod)
    String setter = ""
    # Phase A typed read: dispatch on the receiver's collection_kind.
    # CkOrderedSet / CkHashSet / CkHeap have no meaningful index-assign — fall through to lower_fail.
    match resource_meta_for(&gmod, base_tname):
        case Some(rmeta):
            match rmeta.collection_kind:
                case CkVector():
                    setter = "gorget_array_set"
                case CkDeque():
                    setter = "gorget_array_set"
                case CkDict():
                    setter = "gorget_map_put"
                else:
                    pass
        case None:
            pass
    # R42-A: user IndexMut operator overload — `g[i] = x` on a struct/enum with
    # `equip X with IndexMut` → X__set(&g, i, x). Mirrors Rust lower_index_assign's
    # IndexMut equip-set dispatch (src/ir/lowering/stmts/assigns.rs:1090). Without
    # it a user index-write hit the lower_fail below.
    if setter == "" and gmod.type_infos.contains(base_tname):
        String ia_set_full = base_tname + "__set"
        if gmod.fn_sigs.contains(ia_set_full):
            Operand ia_set_self = OpBorrow(base)
            if is_ptr_type(base_tid, &gmod):
                ia_set_self = OpCopy(base)
            Vector[Operand] ia_set_args = [ia_set_self, op_consume(&ctx, &gmod, idx, classify_call_arg(&gmod, ia_set_full, 1)), op_consume(&ctx, &gmod, val, classify_call_arg(&gmod, ia_set_full, 2))]
            emit(&ctx, GICallExtern(-1, ia_set_full, ia_set_args))
            return
    if setter == "":
        lower_fail("lower_index_assign: unsupported base type " + base_tname)
        return
    # gorget_array_set / gorget_map_put take self by pointer (&base),
    # key/index by value, and value by pointer-or-value depending on
    # element type. An index-assign NEVER consumes its base — it mutates
    # in place via the base's address. Mirror lower_field_write's documented
    # fix (~:7394): Ptr/static base → OpCopy (the local already holds the
    # address); owned OR borrowed base → OpBorrow (its slot address), NOT
    # OpMove. An OpMove gets rewritten to OpClone by the liveness pass when
    # the base is live past the store (it always is — `d[k]=v` keeps `d`
    # live), which clones-and-discards the base and never mutates the
    # original (the d[k]=v clone-bomb: every assign mutated a throwaway).
    Operand base_op = OpBorrow(base)
    if is_ptr_type(base_tid, &gmod):
        base_op = OpCopy(base)
    # `base[idx] = val` → setter(base, idx, val): the collection takes
    # ownership of BOTH key/idx AND val (consuming position per CLAUDE.md).
    # gorget_map_put is the NO-CLONE ownership-transfer variant — it does
    # NOT hash/clone the key internally; the map TAKES the key. So key →
    # CkCallArgOwning (an owned String key would otherwise double-free).
    # For Vector int index this is inert (by-value scalar, no drop). val →
    # CkCallArgOwning (unchanged).
    Vector[Operand] set_args = [base_op, op_consume(&ctx, &gmod, idx, CkCallArgOwning()), op_consume(&ctx, &gmod, val, CkCallArgOwning())]
    emit(&ctx, GICallExtern(-1, setter, set_args))

# Lower `base[idx] OP= value` (compound index-assign on a collection).
# Desugars to: `cur = base[idx]; result = cur OP value; base[idx] = result`,
# evaluating `base` and `idx` exactly ONCE (so `v[pick()] += x` calls
# `pick()` once). Mirrors Rust `lower_compound_assign`'s `Expr::Index`
# arm (src/ir/lowering/stmts/assigns.rs:1345-1560): save the index into a
# local, read the current element via the collection getter, run the
# binop, then write the result back via the same setter `lower_index_assign`
# uses. Collection dispatch is the TYPED `resource_meta_for(...).collection_kind`
# (Vector/Deque → gorget_array_get/set, Dict → gorget_map_get/put) — no name
# matching. Previously every `v[i] += x` / `d[k] += x` hit the
# `SCompoundAssign` `else: lower_fail` and was silently dropped.
void lower_index_compound_assign(LowerCtx &ctx, SpannedExpr base_expr, SpannedExpr idx_expr, String op, SpannedExpr value_expr, GirModule &gmod):
    int base = lower_place_base(&ctx, base_expr, &gmod)
    int base_tid = ctx.locals.get(base).unwrap().type_id
    String base_tname = type_id_to_name(base_tid, &gmod)
    # Unwrap a Ptr/MutPtr base (param/static/self.field) to the collection name.
    if base_tid >= 0 and base_tid < gmod.type_table.len():
        GirType ica_bt = gmod.type_table.get(base_tid).unwrap()
        match ica_bt:
            case GtPtr(ica_inner):
                base_tname = type_id_to_name(ica_inner, &gmod)
            case GtMutPtr(ica_inner2):
                base_tname = type_id_to_name(ica_inner2, &gmod)
            else:
                pass
    # idx + value are independently typed (clear any leaked expected_type,
    # mirroring lower_index_assign).
    int saved_expected_ica = ctx.expected_type
    ctx.expected_type = -1
    int idx = lower_expr(&ctx, idx_expr, &gmod)
    ctx.expected_type = saved_expected_ica
    idx = maybe_auto_propagate(&ctx, idx, &gmod)
    # Typed getter/setter dispatch on collection_kind (same mapping as
    # lower_index_assign + the EIndex read arm).
    String ica_getter = ""
    String ica_setter = ""
    match resource_meta_for(&gmod, base_tname):
        case Some(ica_rmeta):
            match ica_rmeta.collection_kind:
                case CkVector():
                    ica_getter = "gorget_array_get"
                    ica_setter = "gorget_array_set"
                case CkDeque():
                    ica_getter = "gorget_array_get"
                    ica_setter = "gorget_array_set"
                case CkDict():
                    ica_getter = "gorget_map_get"
                    ica_setter = "gorget_map_put"
                else:
                    pass
        case None:
            pass
    if ica_setter == "":
        lower_fail("lower_index_compound_assign: unsupported base type " + base_tname)
        return
    # Element/value type via the shared `index_value_type_name` helper (the
    # SAME one the EIndex read arm uses — one source of truth for the Dict/
    # HashMap value-suffix split). Falls back to I64 for scalars / unresolved.
    String ica_elem_name = index_value_type_name(base_tname)
    String ica_elem_norm = ica_elem_name
    if ica_elem_name == "Str":
        ica_elem_norm = "GorgetString"
    int ica_elem_tid = I64_TYPE
    if ica_elem_norm != "":
        int resolved = resolve_field_gir_type(ica_elem_norm, &gmod)
        if resolved >= 0:
            ica_elem_tid = resolved
    # Read current = getter(base, idx). Both base + idx are BORROWED (the
    # read never consumes), matching the EIndex read arm (idx must be
    # OpBorrow — OpCopy on a String dict key trips validate_resource_moves).
    int ica_cur = add_local(&ctx, ica_elem_tid, None)
    Vector[Operand] ica_get_args = [OpBorrow(base), OpBorrow(idx)]
    emit(&ctx, GICallExtern(ica_cur, ica_getter, ica_get_args))
    # result = cur OP value, at the element type.
    int ica_rhs = lower_expr(&ctx, value_expr, &gmod)
    int ica_result = add_local(&ctx, ica_elem_tid, None)
    emit_compound_arith(&ctx, op, ica_result, ica_cur, ica_rhs, ica_elem_tid, &gmod)
    # Write back base[idx] = result via the setter. A compound index-assign
    # never consumes the base — borrow it (Ptr base → OpCopy), exactly as
    # lower_index_assign does.
    Operand ica_base_op = OpBorrow(base)
    if is_ptr_type(base_tid, &gmod):
        ica_base_op = OpCopy(base)
    Vector[Operand] ica_set_args = [ica_base_op, op_consume(&ctx, &gmod, idx, CkCallArgOwning()), op_consume(&ctx, &gmod, ica_result, CkCallArgOwning())]
    emit(&ctx, GICallExtern(-1, ica_setter, ica_set_args))

