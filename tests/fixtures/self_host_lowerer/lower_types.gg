# ── Type mapping ─────────────────────────────────────────

int prim_name_to_type(String name):
    match name:
        case "int":
            return I64_TYPE
        case "float":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "void":
            return UNIT_TYPE
        case "int8":
            return I8_TYPE
        case "int16":
            return I16_TYPE
        case "int32":
            return I32_TYPE
        case "uint":
            return U64_TYPE
        case "uint8":
            return U8_TYPE
        case "byte":
            return U8_TYPE
        case "uint16":
            return U16_TYPE
        case "uint32":
            return U32_TYPE
        case "float32":
            return F32_TYPE
        else:
            return -1

# Resolve a SpannedType to a type name string (for drop analysis).
# Does NOT require GirModule — uses direct primitive and generic name resolution.
String spanned_type_to_name(SpannedType stype):
    match stype.ty:
        case TPrimitive(name):
            return prim_to_c_name(name)
        case TNamed(name, targs):
            if name == "String":
                return "GorgetString"
            if targs.len() == 0:
                return name
            String result = name
            for ta in targs:
                result = result + "__" + spanned_type_to_name(ta)
            return result
        case TTuple(elems):
            if elems.len() == 0:
                return "void"
            String result = "Tuple"
            for te in elems:
                result = result + "__" + spanned_type_to_name(te)
            return result
        else:
            pass
    return "int64_t"

String mangle_type_name(String name, Vector[SpannedType] targs, GirModule &gmod):
    # Mangle generic type names: Vector[int] → Vector__int64_t
    if targs.len() == 0:
        if name == "String":
            return "GorgetString"
        return name
    String result = name
    for ta in targs:
        result = result + "__" + type_to_c_name(ta, &gmod)
    return result

# Lazy-iterator Phase 1a — the DEMAND-GATE predicate. Walk an AST type
# and return true ONLY if every nominal (named struct / enum) reachable
# through it is already registered as an instance in `gmod.type_infos`.
# Used to gate bulk trait-default emission for generic-equip instances:
# an adapter-returning default like `TakeIter[Self, T] take(self, int n)`
# is emitted ONLY if `TakeIter__<mangled Self>__<mangled T>` was demanded
# (and thus registered) by a real user call site — otherwise emitting it
# would cascade into every adapter constructor for every Iterator
# implementor forever. Mirrors Rust `all_return_nominals_registered`
# (`src/ir/lowering/functions.rs:69-100`). MANGLER CHOICE IS LOAD-BEARING:
# `mangle_type_name`/`type_to_c_name` are type_subs-AWARE (read the active
# `Self`/`T` bindings), so the mangled instance name matches the registered
# one; the blind `compute_mangled_name` would NOT see `type_subs`.
bool all_return_nominals_registered(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TNamed(name, args):
            # Bare names (no generic args) mangle directly to a primitive /
            # builtin (int64_t / GorgetString / …) and need no instance reg.
            if args.len() == 0:
                return true
            # Skip the substitution placeholders themselves — a `T`/`Self`
            # name with no args is handled above; with args (impossible for a
            # bound param) we still recurse below.
            String mangled = mangle_type_name(name, args, &gmod)
            # Read the name->tid registry (`named_types`), NOT `type_infos`:
            # prelude `Option__T`/`Result__T__E` monos land in `named_types`
            # (via `lookup_or_register_named`) but have no struct/enum body in
            # `type_infos`, so a `type_infos` check spuriously drops every
            # terminal returning `Option[T]`/`Result[T,E]` (`min`/`max`/`last`/
            # `nth`/`find`). Faithful mirror of Rust `all_return_nominals_
            # registered` (`src/ir/lowering/functions.rs:81`: `lookup_named`).
            if not gmod.named_types.contains(mangled):
                return false
            for a in args:
                if not all_return_nominals_registered(a, &gmod):
                    return false
            return true
        case TTuple(elems):
            for e in elems:
                if not all_return_nominals_registered(e, &gmod):
                    return false
            return true
        case TArray(elem_box, _):
            return all_return_nominals_registered(*elem_box, &gmod)
        case TSlice(elem_box):
            return all_return_nominals_registered(*elem_box, &gmod)
        case TFunction(ret_box, fparams, _):
            if not all_return_nominals_registered(*ret_box, &gmod):
                return false
            for fp in fparams:
                if not all_return_nominals_registered(fp, &gmod):
                    return false
            return true
        else:
            # TPrimitive / TSelf / TInferred → no nominal to register.
            return true

# Lazy-iterator Phase 1a — set up `gmod.type_subs` for a CONCRETE
# `equip Target with Trait[args]:` default-method emission. Binds
# `"Self"` → the concrete target type-id AND each trait generic param
# (`tdef.type_params`, e.g. `["T"]` for `Iterator[T]`) → the trait
# clause arg (`trait_generic_args`, e.g. `[int]` for `Iterator[int]`).
# Mirrors the generic-equip site's bind (and Rust's `default_subs`).
# After A1 dropped `Iterator` from `is_builtin_trait` + A3 admitted the
# generic trait def, a concrete `equip Counter with Iterator[int]:` now
# reaches the concrete default-emit; without this bind + the method-
# generic skip + demand-gate, every default (`take`/`any[F]`/…) would
# emit with an UNBOUND `Self`/`T`/`F` → broken dead bodies (the
# `iterator`/`iterator_direct` regressions). `clear_type_subs` after.
void setup_concrete_trait_subs(GirModule &gmod, SpannedType target, Vector[String] trait_params, Vector[SpannedType] trait_args):
    gmod.type_subs = {}
    String tgt_name = type_to_c_name(target, &gmod)
    int tgt_tid = lookup_or_register_named(&gmod, tgt_name)
    gmod.type_subs.put("Self", tgt_tid)
    int ci = 0
    while ci < trait_params.len() and ci < trait_args.len():
        String pname = trait_params.get(ci).unwrap()
        int atid = map_ast_type(trait_args.get(ci).unwrap(), &gmod)
        gmod.type_subs.put(pname, atid)
        ci += 1

String prim_to_c_name(String name):
    match name:
        case "int":
            return "int64_t"
        case "float":
            return "double"
        case "bool":
            return "bool"
        case "void":
            return "void"
        case "String":
            return "GorgetString"
        case "int8":
            return "int8_t"
        case "int16":
            return "int16_t"
        case "int32":
            return "int32_t"
        case "uint":
            return "uint64_t"
        case "uint8":
            return "uint8_t"
        case "byte":
            return "u8"
        case "uint16":
            return "uint16_t"
        case "uint32":
            return "uint32_t"
        case "float32":
            return "float"
        else:
            return name

String type_to_c_name(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return prim_to_c_name(name)
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization mangling.
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            return mangle_type_name(name, targs, &gmod)
        case TTuple(elems):
            # `Vector[(int,int)]` mangles the element tuple to `Tuple__…` AND
            # registers its struct body (so the for-loop / index element read
            # gets the full struct, not a collapsed `int64_t`). Route through
            # `map_ast_type` so the shared `register_tuple_type` helper runs,
            # then return the registered name. (Previously this fell through to
            # the `int64_t` default — the bare_tuples for-loop bug.)
            return type_id_to_name(map_ast_type(stype, &gmod), &gmod)
        case TFunction(_, _, _):
            # PROTO phase-1b: a function-typed generic arg (e.g. the `F` of
            # MapIter[...,int(int)]) mangles to GorgetClosure so the struct
            # instance, its `F` field, the method-mono body, and the call-site
            # symbol all agree on one name. Mirrors Rust mangle_type_for_name.
            return "GorgetClosure"
        case TSelf():
            # Lazy-iterator Phase 1a: under the generic-equip default-method
            # emit (lower.gg:14666), `gmod.type_subs` carries a `"Self"` →
            # mono-type-id binding so `Self` inside a trait-default body/sig
            # (e.g. `take`'s return `TakeIter[Self, T]`) mangles to the
            # concrete instance name (`TakeIter__VectorIter__int64_t…`),
            # matching the call site. When NO `"Self"` binding is active
            # (the general `lower_function` path for concrete equips that set
            # no Self sub), fall through to the existing `int64_t` default.
            if gmod.type_subs.contains("Self"):
                return type_id_to_name(gmod.type_subs.get("Self").unwrap(), &gmod)
        else:
            pass
    return "int64_t"

# ── ResolvedType → GIR translation (Gap #2 Phase 2) ─────
#
# The typechecker computes per-expression types into `types.expr_types`
# (a side-table keyed by `SpannedExpr.span.start`). Self-host's lowerer
# reads from there as typed metadata — single source of truth for
# expression types (Layering rule 3). These helpers translate the
# typechecker's `ResolvedType` representation into the GIR type-id
# space that the lowerer uses elsewhere.
#
# The two functions mirror `type_to_c_name` / `map_ast_type` but start
# from a `ResolvedType` id (an index into `types.types`) rather than
# an AST `SpannedType`. Substitutions in `gmod.type_subs` still apply
# at primitive leaves so generic-equip method bodies under active mono
# subs translate consistently.

String resolved_to_c_name(int rtid, GirModule &gmod):
    if rtid < 0 or rtid >= gmod.tc_types.types.len():
        return "int64_t"
    ResolvedType rt = gmod.tc_types.types.get(rtid).unwrap()
    match rt:
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return type_id_to_name(gmod.type_subs.get(pname).unwrap(), &gmod)
            return prim_to_c_name(pname)
        case RTDefined(def_id):
            DefInfo di = gmod.tc_scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return type_id_to_name(gmod.type_subs.get(name).unwrap(), &gmod)
            if name == "String":
                return "GorgetString"
            return name
        case RTGeneric(def_id, type_args):
            DefInfo di = gmod.tc_scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, &gmod)
                mangled = mangled + "__" + arg_name
            return mangled
        case RTRef(inner_rtid):
            # option_ref_borrow Phase 1: a `Ref[T]` mangles to `Ref__<pointee>`
            # so an `Option[Ref[T]]` becomes `Option__Ref__T` (Rust parity,
            # matches driver.c's `__gg_Option__Ref__*`) — distinct from the
            # owned `Option__T` that pop/remove produce. The pointer-ness is
            # carried by the matching `GtPtr` in `resolved_to_gir_type`. We do
            # NOT strip the Ref here anymore: stripping collapsed the borrowed
            # and owned Option types onto one name and erased the payload's
            # pointer representation (the shallow-copy unsoundness).
            return "Ref__" + resolved_to_c_name(inner_rtid, &gmod)
        case RTTuple(elem_rtids):
            String tup_name = "Tuple"
            for et in elem_rtids:
                tup_name = tup_name + "__" + resolved_to_c_name(et, &gmod)
            return tup_name
        case RTArray(elem_rtid, _):
            return resolved_to_c_name(elem_rtid, &gmod)
        case RTSlice(elem_rtid):
            return resolved_to_c_name(elem_rtid, &gmod)
        case RTFunction(_, _, _):
            # Lazy-iterator chain-link parity: a function-typed adapter targ
            # (the `F` of `filter[F]`/`map[U,F]`, inferred from a bare-form
            # closure/free-fn arg) is carried as a `GorgetClosure`, exactly as
            # `resolved_to_gir_type`'s RTFunction arm and `resolved_to_spanned_type`
            # (TFunction→GorgetClosure) already mangle it. Without this arm `F`
            # fell to the `else` `int64_t` default, so a BARE-form chain-link
            # VAR type (e.g. `FilterIter__TakeIter__VectorIter__int64_t…`)
            # diverged from the method-mono symbol (`…__GorgetClosure`) and the
            # `for x in chain:` SFor CC-failed on incompatible struct types.
            # The turbofish form was unaffected (its AST `TFunction` already
            # routes through GorgetClosure). One source of truth: all three
            # RTFunction-mangle paths now agree.
            return "GorgetClosure"
        else:
            return "int64_t"

# Register a `Tuple__<T1>__<T2>__…` struct type from its element GIR type
# ids and return the registered named tid. Mirrors Rust
# `register_tuple_type` (`src/ir/lowering/exprs/type_reg.rs:10`): a tuple is
# a positional struct with fields `_0`, `_1`, … (one per element). Idempotent:
# a re-registration with the same name is a no-op (the first GirTypeInfo wins),
# so this is safe to call from BOTH the type-mapping site
# (`resolved_to_gir_type` RTTuple arm) AND `ETupleLiteral` lowering — they
# converge on the same name because element mangles come from the same
# `type_id_to_name`. The struct body is filled by `lower_type_defs` Pass 2,
# which reads `gmod.type_infos` (same path as the closure env-struct at
# `:6756`). Fields are named ONLY `_N` (Rust parity); the bare-digit `.N`
# access form is reconciled at the EFieldAccess lookup (digit→`_N`).
int register_tuple_type(Vector[int] elem_tids, GirModule &gmod):
    String tup_name = "Tuple"
    for et in elem_tids:
        tup_name = tup_name + "__" + type_id_to_name(et, &gmod)
    int tup_tid = lookup_or_register_named(&gmod, tup_name)
    # First-write-wins: skip if a GirTypeInfo body already exists (the type
    # may have been name-registered with no body by an earlier
    # `lookup_or_register_named`, so we key on the type_infos body, not the
    # named id).
    if gmod.type_infos.contains(tup_name):
        return tup_tid
    Vector[GirFieldInfo] tup_fields = []
    bool tup_owns_resource = false
    int fi = 0
    while fi < elem_tids.len():
        int et = elem_tids.get(fi).unwrap()
        tup_fields.push(GirFieldInfo("_" + int_to_str(fi), type_id_to_name(et, &gmod)))
        # Coherence-at-construction: a tuple holding a droppable element is
        # itself a resource (its drop must recurse). The `resource_types`
        # fixpoint (`:13530`) only walks AST-declared structs/enums, so a
        # dynamically-created tuple never enters it — register here directly so
        # `is_droppable_type` returns true and the GIR `register_local_for_drop`
        # at the literal site fires (else the resource element LEAKS — ASan on
        # `tuple_literal_resource_value`). Mirrors Rust's
        # `compute_drop_strategy_for_struct` marking the tuple Resource
        # (`type_reg.rs:48`).
        if is_droppable_type(et, &gmod):
            tup_owns_resource = true
        fi += 1
    Vector[GirEnumVariantInfo] tup_no_variants = []
    gmod.type_infos.put(tup_name.clone(), GirTypeInfo(tup_name.clone(), !tup_fields, !tup_no_variants, false))
    if tup_owns_resource:
        gmod.resource_types.put(tup_name.clone(), true)
    return tup_tid

int resolved_to_gir_type(int rtid, GirModule &gmod):
    if rtid < 0 or rtid >= gmod.tc_types.types.len():
        return I64_TYPE
    ResolvedType rt = gmod.tc_types.types.get(rtid).unwrap()
    match rt:
        case RTVoid():
            return UNIT_TYPE
        case RTNever():
            return UNIT_TYPE
        case RTError():
            return I64_TYPE
        case RTPrimitive(pname):
            if gmod.type_subs.contains(pname):
                return gmod.type_subs.get(pname).unwrap()
            int prim_tid = prim_name_to_type(pname)
            if prim_tid >= 0:
                return prim_tid
            if pname == "String" or pname == "str":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, pname)
        case RTDefined(def_id):
            DefInfo di = gmod.tc_scopes.get_def(def_id)
            String name = di.name
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            if name == "String":
                return lookup_or_register_named(&gmod, "GorgetString")
            return lookup_or_register_named(&gmod, name)
        case RTGeneric(def_id, type_args):
            DefInfo di = gmod.tc_scopes.get_def(def_id)
            String mangled = di.name
            for arg_rtid in type_args:
                String arg_name = resolved_to_c_name(arg_rtid, &gmod)
                mangled = mangled + "__" + arg_name
            int opt_tid = lookup_or_register_named(&gmod, mangled)
            # option_ref_borrow Phase 2b: when this is a borrowing-getter
            # result `Option[Ref[T]]` / `Result[Ref[T], _]`, thread the
            # payload `GtPtr(T)` id through the typed `option_ref_payload`
            # channel so unwrap / match-destructure mint a real pointer
            # without re-parsing the `Ref__` infix (CLAUDE.md "No name
            # matching"). The Option id is name-deduped, so this same id
            # appears at every read site.
            if (di.name == "Option" or di.name == "Result") and type_args.len() >= 1:
                int first_arg = get_int_at(type_args, 0)
                if first_arg >= 0 and first_arg < gmod.tc_types.types.len():
                    ResolvedType arg_rt = gmod.tc_types.types.get(first_arg).unwrap()
                    match arg_rt:
                        case RTRef(pointee_rtid):
                            int ptr_tid = register_ptr(&gmod, resolved_to_gir_type(pointee_rtid, &gmod))
                            record_option_ref_payload(&gmod, opt_tid, ptr_tid)
                        else:
                            pass
                # Typed enum-category channel: record the resolved payload
                # tids so unwrap / match / catch / rethrow / LIR field-shape
                # never re-parse the mangled name. The first type-arg is the
                # Some_0 / Ok_0 payload; the second (Result only) is Error_0.
                # The payload tids come straight from the typechecker's
                # `type_args` — the authoritative typed source (Layering rule
                # 4, resolve once / write through).
                int ec_ok = resolved_to_gir_type(get_int_at(type_args, 0), &gmod)
                if di.name == "Option":
                    record_enum_category(&gmod, opt_tid, ENUM_CAT_OPTION, ec_ok, -1)
                elif type_args.len() >= 2:
                    int ec_err = resolved_to_gir_type(get_int_at(type_args, 1), &gmod)
                    record_enum_category(&gmod, opt_tid, ENUM_CAT_RESULT, ec_ok, ec_err)
            if di.name == "Thread" and type_args.len() == 1:
                # Typed thread-payload channel (typechecker-resolved mint
                # path — sibling of the `map_ast_type` TNamed arm write).
                int thr_payload = resolved_to_gir_type(get_int_at(type_args, 0), &gmod)
                record_thread_payload(&gmod, opt_tid, thr_payload)
            return opt_tid
        case RTRef(inner_rtid):
            # option_ref_borrow Phase 1: a `Ref[T]` lowers to `GtPtr(T)` (Rust
            # parity — ResolvedType::Ref → GirType::Ptr). We no longer strip
            # the Ref to the bare pointee: stripping erased the pointer
            # representation that downstream deref / clone-at-owning relies on.
            # The borrow vs owned distinction is ALSO carried on the GIR
            # local's `ownership` (LoBorrowed); the type now carries it too
            # (Decision D2), and a standalone-Ref bind matches `GtPtr(inner)`
            # directly at the svardecl site.
            return register_ptr(&gmod, resolved_to_gir_type(inner_rtid, &gmod))
        case RTTuple(elem_rtids):
            # Register the `Tuple__T1__T2__…` struct here — at the
            # type-MAPPING site, not only at the literal — so a tuple that
            # arrives via a typed binding with NO literal (e.g. `m.items()`
            # typed `Vector[(int,int)]`, then `item._1`) resolves its fields
            # against `gmod.type_infos`. Mirrors Rust registering at
            # `map_ast_type_mut` (`type_reg.rs:25`), not just literal lowering.
            # `register_tuple_type` is the SHARED helper that `ETupleLiteral`
            # also calls; both converge on the same name. We resolve each
            # element rtid → GIR tid first so the per-element mangle is driven
            # by `type_id_to_name` (the same source the helper uses).
            Vector[int] tup_elem_tids = []
            for et in elem_rtids:
                tup_elem_tids.push(resolved_to_gir_type(et, &gmod))
            return register_tuple_type(tup_elem_tids, &gmod)
        case RTArray(elem_rtid, _):
            # Arrays map to GorgetArray (the C-level Vector backing); the
            # element type is metadata stored elsewhere (type_infos).
            return lookup_or_register_named(&gmod, "GorgetArray")
        case RTSlice(elem_rtid):
            return lookup_or_register_named(&gmod, "GorgetArray")
        case RTFunction(_, _, _):
            # Lazy-iterator phase 1b: a function-typed method-targ (the `F`
            # of `fold[A,F]` / `any[F]`, inferred from a passed fn value) is
            # carried at runtime as a `GorgetClosure` (16-byte fn-ptr + env),
            # NOT an I64. Without this arm the inferred `F` falls to the
            # `else` I64 default and the bare-form call mangles `__int64_t`
            # instead of `__GorgetClosure`, diverging from both the body-emit
            # symbol and the turbofish form (whose `TFunction` AST type
            # already maps to GorgetClosure via type_to_c_name).
            return lookup_or_register_named(&gmod, "GorgetClosure")
        else:
            return I64_TYPE

# Lazy-iterator transitive discovery: reconstruct an AST `SpannedType` from a
# typechecker `ResolvedType` id. Used to register an adapter chain link's
# RESULT type (e.g. `TakeIter[VectorIter[int], int]`) as a `GenericInstance`
# so the existing generic-equip + method-mono emission loops emit its methods
# (`next`/`take`/`count`/…). Mirrors the AST types Rust's `scan_type` registers
# from the substituted default-method return type. Closures become `TFunction`
# (→ `GorgetClosure` via `spanned_type_to_c_name`), nested adapters recurse as
# `TNamed`, primitives as `TPrimitive` — so the reconstructed instance's
# mangled name agrees byte-for-byte with the proto symbol + the call site.
SpannedType resolved_to_spanned_type(int rtid, TypeTable types, ScopeTable scopes):
    if rtid < 0 or rtid >= types.types.len():
        return SpannedType(TPrimitive("int"), -1)
    ResolvedType rt = types.types.get(rtid).unwrap()
    match rt:
        case RTPrimitive(pname):
            return SpannedType(TPrimitive(pname), -1)
        case RTDefined(def_id):
            DefInfo di = scopes.get_def(def_id)
            return SpannedType(TNamed(di.name, []), -1)
        case RTGeneric(def_id, type_args):
            DefInfo di = scopes.get_def(def_id)
            Vector[SpannedType] args = []
            for at in type_args:
                args.push(resolved_to_spanned_type(at, types, scopes))
            return SpannedType(TNamed(di.name, args), -1)
        case RTTuple(elem_rtids):
            Vector[SpannedType] telems = []
            for et in elem_rtids:
                telems.push(resolved_to_spanned_type(et, types, scopes))
            return SpannedType(TTuple(telems), -1)
        case RTRef(inner_rtid):
            return resolved_to_spanned_type(inner_rtid, types, scopes)
        case RTFunction(fparams, fowns, fret):
            # Function-typed arg (`F` of `filter[F]`/`map[U,F]`). The concrete
            # params/return don't affect the mangle (TFunction → GorgetClosure),
            # so a minimally-shaped TFunction is sufficient and avoids re-walking.
            Vector[SpannedType] fp = []
            Vector[int] fo = []
            return SpannedType(TFunction(Box(SpannedType(TPrimitive("int"), -1)), fp, fo), -1)
        else:
            return SpannedType(TPrimitive("int"), -1)
    return SpannedType(TPrimitive("int"), -1)

# Convenience: query the typechecker's per-expression type for a given
# SpannedExpr (by span.start) and translate to GIR. Returns -1 if no
# entry is recorded; callers should fall back to their existing path.
# Reads the typechecker side-tables stashed on `gmod` at lower_module
# entry (single accessor — typed-metadata write-through, Layering rule 2).
int lookup_expr_gir_type(SpannedExpr sexpr, GirModule &gmod):
    # Chain-link oracle (lazy iterators): for an EMethodCall, prefer the
    # per-link table keyed on the UNIQUE span.end. The parser shares one
    # span.start across a whole method chain, so the span.start-keyed
    # `expr_types` collapses every link onto the OUTERMOST type — reading it
    # for an inner `.take()` returns the chain's final `FilterIter` type and
    # the lowerer emits a type-mismatched local. `expr_link_types` (keyed on
    # span.end, unique per link) preserves each link's own resolved type, the
    # self-host analog of Rust's recursive span-table-free `infer_expr_ast_type`.
    # Non-chain exprs fall through to the span.start `expr_types` table.
    match sexpr.expr:
        case EMethodCall(_, _, _, _):
            int link_end = sexpr.span.end
            if gmod.tc_types.expr_link_types.contains(link_end):
                int link_rtid = gmod.tc_types.expr_link_types.get(link_end).unwrap()
                return resolved_to_gir_type(link_rtid, &gmod)
        else:
            pass
    int span_start = sexpr.span.start
    if not gmod.tc_types.expr_types.contains(span_start):
        return -1
    int rtid = gmod.tc_types.expr_types.get(span_start).unwrap()
    return resolved_to_gir_type(rtid, &gmod)

# Lazy-iterator phase 1b: the inferred method-level type-args recorded by
# the typechecker for a bare-form (no-turbofish) Iterator method call, keyed
# on the EMethodCall UNIQUE span.END. Returns the resolved-type ids exactly
# as `infer_method_targs` produced them (an `F` targ is an RTFunction id, an
# `A` targ a primitive id). Empty vector when nothing recorded.
#
# Keyed on span.END (not span.start) so a chain with multiple method-generic
# links (`v.iter().take(N).filter(p).map(f)`) keeps EACH link's targs — the
# parser shares one span.start across the whole chain, which collided away all
# but one link's entry. span.end is unique per link (same invariant
# `expr_link_types` uses). The recorded method NAME is still cross-checked as
# a cheap belt-and-suspenders guard.
Vector[int] bare_method_targ_rtids(int span_end, String mname, GirModule gmod):
    if gmod.tc_types.expr_method_targs.contains(span_end):
        if gmod.tc_types.expr_method_targs_name.contains(span_end):
            String recorded = gmod.tc_types.expr_method_targs_name.get(span_end).unwrap()
            if recorded == mname:
                return gmod.tc_types.expr_method_targs.get(span_end).unwrap()
    return []

# Mangle one recorded method-targ rtid to its C name, threading the
# RTFunction→GorgetClosure rule via `resolved_to_gir_type` so the bare-form
# suffix is byte-identical to the turbofish form (whose AST `TFunction`
# already maps to GorgetClosure through type_to_c_name).
String bare_method_targ_c_name(int rtid, GirModule &gmod):
    int gir_tid = resolved_to_gir_type(rtid, &gmod)
    return type_id_to_name(gir_tid, &gmod)

int map_ast_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TPrimitive(name):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            match name:
                case "int":
                    return I64_TYPE
                case "float":
                    return F64_TYPE
                case "bool":
                    return BOOL_TYPE
                case "void":
                    return UNIT_TYPE
                case "String":
                    return lookup_or_register_named(&gmod, "GorgetString")
                else:
                    pass
        case TNamed(name, targs):
            # Apply type substitutions for generic monomorphization.
            if gmod.type_subs.contains(name):
                return gmod.type_subs.get(name).unwrap()
            # Resolve type aliases (meta type = ...)
            if targs.len() == 0 and gmod.meta_aliases.contains(name):
                String alias_target = gmod.meta_aliases.get(name).unwrap()
                int at = prim_name_to_type(alias_target)
                if at >= 0:
                    return at
                return lookup_or_register_named(&gmod, alias_target)
            int t = prim_name_to_type(name)
            if t >= 0:
                return t
            # Callable types: Callable[T(int)] → FnPtr([int], T) for type inference.
            # The actual ABI is Ptr (void*), but we record the function type
            # so callable dispatch can infer return types.
            if name == "Callable" or name == "MutCallable" or name == "ConsumeCallable":
                if targs.len() == 1:
                    # Single type arg is a function type: T(int, int)
                    SpannedType fn_arg = targs.get(0).unwrap()
                    match fn_arg.ty:
                        case TFunction(ret_box, fn_params, _):
                            Vector[int] param_tids = []
                            for fp in fn_params:
                                param_tids.push(map_ast_type(fp, &gmod))
                            int ret_tid = map_ast_type(*ret_box, &gmod)
                            int fn_tid = register_type(&gmod, GtFnPtr(param_tids, ret_tid))
                            return register_ptr(&gmod, fn_tid)
                        else:
                            pass
                return UNIT_TYPE
            # Named type with possible generic args
            String mangled = mangle_type_name(name, targs, &gmod)
            int mat_tid = lookup_or_register_named(&gmod, mangled)
            # Typed enum-category channel (AST path — mirrors the
            # ResolvedType RTGeneric arm). Record the payload tids resolved
            # from the AST type-args so downstream never re-parses `mangled`.
            if name == "Option" and targs.len() >= 1:
                int mat_ok = map_ast_type(targs.get(0).unwrap(), &gmod)
                record_enum_category(&gmod, mat_tid, ENUM_CAT_OPTION, mat_ok, -1)
            elif name == "Result" and targs.len() >= 2:
                int mat_rok = map_ast_type(targs.get(0).unwrap(), &gmod)
                int mat_rerr = map_ast_type(targs.get(1).unwrap(), &gmod)
                record_enum_category(&gmod, mat_tid, ENUM_CAT_RESULT, mat_rok, mat_rerr)
            elif name == "Thread" and targs.len() == 1:
                # Typed thread-payload channel (sibling of the enum-category
                # records above; AST-annotation mint path). The join/id
                # intercept in lower_expr reads this instead of re-deriving
                # the payload tid from the `Thread__` name suffix.
                int mat_thr_payload = map_ast_type(targs.get(0).unwrap(), &gmod)
                record_thread_payload(&gmod, mat_tid, mat_thr_payload)
            return mat_tid
        case TFunction(ret_box, fn_params_f, _):
            # Function types as params/fields → Ptr(FnPtr). The C-level ABI for
            # bare closure params is void* (GorgetClosure* effectively); encode
            # as Ptr(FnPtr(...)) so lir_lower sees a pointer type.
            # Function types as return types are handled by map_fn_return_type.
            Vector[int] fpf_params = []
            for fpf in fn_params_f:
                fpf_params.push(map_ast_type(fpf, &gmod))
            int fpf_ret = map_ast_type(*ret_box, &gmod)
            int fpf_tid = register_type(&gmod, GtFnPtr(fpf_params, fpf_ret))
            return register_ptr(&gmod, fpf_tid)
        case TInferred():
            return I64_TYPE
        case TTuple(elems):
            # A tuple type maps to a `Tuple__…` positional struct. Register the
            # struct BODY (fields `_N`) via the shared `register_tuple_type`
            # helper — not just the bare name — so a `Vector[(int,int)]` decl,
            # a tuple param/field/return type resolves its element struct
            # shape (mirrors Rust `map_ast_type_mut` for `Type::Tuple` →
            # `register_tuple_type`, `type_reg.rs:25`). Without the body the
            # for-loop element / field access read a collapsed `int64_t`.
            Vector[int] mat_tup_elems = []
            for elem in elems:
                mat_tup_elems.push(map_ast_type(elem, &gmod))
            return register_tuple_type(mat_tup_elems, &gmod)
        case TSelf():
            # Lazy-iterator Phase 1a: param/return-type lowering of a trait
            # default whose self param / nested type-arg is `Self` (parser
            # emits `TSelf()` for the `Self` keyword everywhere). Under the
            # generic-equip default-emit, `gmod.type_subs["Self"]` binds the
            # concrete mono type-id; resolve through it. The general
            # `lower_function` path at the CONCRETE equip default sites
            # (lower.gg:14548/14559/14606 — e.g. `equip SparseSetIter with
            # Iterator[Entity]`) sets NO `"Self"` sub, so guard the lookup
            # and fall through to the `I64_TYPE` default there (otherwise an
            # unguarded `.get("Self").unwrap()` panics → ecs.gg / bootstrap
            # RED).
            if gmod.type_subs.contains("Self"):
                return gmod.type_subs.get("Self").unwrap()
        else:
            pass
    return I64_TYPE

# Map return type — same as map_ast_type but TFunction produces GtFnPtr
int map_fn_return_type(SpannedType stype, GirModule &gmod):
    match stype.ty:
        case TFunction(ret_type_box, fn_param_types, _):
            Vector[int] fn_params = []
            for fp in fn_param_types:
                fn_params.push(map_ast_type(fp, &gmod))
            int fn_ret = map_ast_type(*ret_type_box, &gmod)
            return register_type(&gmod, GtFnPtr(fn_params, fn_ret))
        else:
            return map_ast_type(stype, &gmod)

# ── Type ID to name ──────────────────────────────────────

String type_id_to_name(int tid, GirModule &gmod):
    match tid:
        case 0:
            return "bool"
        case 4:
            return "int64_t"
        case 10:
            return "double"
        case 11:
            return "unit"
        else:
            pass
    if tid >= PRIM_COUNT and tid < gmod.type_table.len():
        GirType gt = gmod.type_table.get(tid).unwrap()
        match gt:
            case GtNamed(name):
                return name
            case GtPtr(inner):
                return type_id_to_name(inner, &gmod)
            case GtMutPtr(inner):
                return type_id_to_name(inner, &gmod)
            else:
                pass
    return "int64_t"

# ── Resource type detection ──────────────────────────────

# Get parameter type IDs for a function from the GIR module.
Vector[int] get_fn_param_types(String name, GirModule gmod):
    Vector[int] types = []
    int i = 0
    while i < gmod.functions.len():
        if gmod.functions.get(i).unwrap().name == name:
            for pt in gmod.functions.get(i).unwrap().param_types:
                types.push(pt)
            return types
        i += 1
    # FALLBACK (NOT primary): a forward-referenced callee — one defined
    # TEXTUALLY BELOW the caller — is not yet in `gmod.functions` when the
    # caller lowers, so the scan above misses and returns []. The bare-`None`
    # / prelude-variant arg expected-type lookup then fails (the
    # `ai < callee_param_types.len()` guard at lower_expr.gg), zeroing the
    # Option (tag 0 = Some) → miscompile/segfault. Recover the param types
    # from the order-independent `fn_param_sigs` pre-pass (populated over ALL
    # functions before any body is lowered; Rust gg `mod.rs:656`). These are
    # the UNWRAPPED VALUE types — that is correct here: the consumer peels the
    # ABI Ptr wrapper anyway (a value type is a no-op peel) and `&`-param
    # by-ptr detection routes via the order-independent `fn_borrow_params`
    # map, NOT these tids. The primary scan above stays authoritative for any
    # already-lowered callee, so an already-found callee's result is byte-for-
    # byte unchanged.
    if gmod.fn_param_sigs.contains(name):
        for fps_pt in gmod.fn_param_sigs.get(name).unwrap():
            types.push(fps_pt)
    return types

# Check if a call name is a type constructor (produces a named type).
# Map binary operator strings to their trait-method names (for operator
# overload dispatch on user structs).
String binop_method_name(String op):
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "/":
        return "div"
    if op == "%":
        return "rem"
    return ""

# Returns the parent enum name if `name` is a variant of a known enum,
# or "" if not a variant. Used to route bare variant constructors
# (IntCol, Red, Ok, ...) to their enclosing enum's named type.
String enum_variant_parent(String name, GirModule gmod):
    # O(1) lookup into the flat variant→enum index (built FIRST-WRITE-WINS
    # at lower_module construction, mirroring this scan's old insertion-order
    # first-match). Replaces an O(types) scan that deep-cloned a
    # `GirTypeInfo` per type (the #1 array_clone site).
    if gmod.enum_variant_parent_idx.contains(name):
        return gmod.enum_variant_parent_idx.get(name).unwrap()
    return ""

bool is_type_constructor(String name, GirModule &gmod):
    # Phase A typed read: parameterised resource families with the
    # `T(args)` user-code constructor shape (Vector__T, Dict__K__V,
    # Mutex__T, …) carry `is_typed_constructor=true` in their
    # metadata. Built-in singletons / factory-shape opaques /
    # Box / Heap / Atomic / etc. carry `false`.
    match resource_meta_for(&gmod, name):
        case Some(rmeta):
            if rmeta.is_typed_constructor:
                return true
            return false
        case None:
            pass
    # Primitive type-constructor calls (String("x"), Int(1)) and other
    # bare names — coercions or runtime-helper construction, not
    # user struct instantiation. build_resource_metadata returns None
    # for the user-struct-name case, so we drop here.
    if name == "String" or name == "Int" or name == "Float" or name == "Bool":
        return false
    if name == "Char":
        return false
    if name == "Rc" or name == "Arc":
        return false
    # Builtin GorgetArray/Map/Set-backed collection bases — single source of
    # truth in `is_builtin_collection_base` (lower.gg). Routed to the runtime
    # type, never user-struct-constructed. See tests/lints.rs
    # `collection_base_names_single_source`.
    if is_builtin_collection_base(name):
        return false
    if name == "Option" or name == "Result":
        return false
    # User-defined struct names (capitalised, no __ suffix). The
    # metadata path returned None for these, so they fall through here.
    if name.len() > 0:
        String first = name.slice(0, 1)
        if first >= "A" and first <= "Z" and not name.contains("__"):
            return true
    return false

# R9 FIDELITY — scoped-allocator constructor → runtime `gorget_<kind>_new`.
# Mirrors Rust gg's allocator-constructor special-cases in
# `src/ir/lowering/exprs/calls.rs:708-744`. Returns the runtime symbol for
# the 6 stdlib allocator constructors, "" for anything else. Name-matching
# these 6 builtin allocator types is the Rust-blessed exception (the
# constructor name IS the contract with the runtime — there is no
# corresponding `T(args)` user code, the allocator structs are opaque
# handles). Kept FLAT with explicit literals (no concat) per the layering
# discipline + R9 MINOR-1 (a nested/concat shape tripped a spurious driver
# C error in prototyping).
String allocator_constructor_runtime_name(String name):
    if name == "Arena":
        return "gorget_arena_new"
    if name == "TrackingAllocator":
        return "gorget_tracking_new"
    if name == "PoolAllocator":
        return "gorget_pool_new"
    if name == "TlsfAllocator":
        return "gorget_tlsf_new"
    if name == "FixedBufferAllocator":
        return "gorget_fba_new"
    if name == "FallbackAllocator":
        return "gorget_fallback_new"
    return ""

# SYNC FIDELITY — non-generic sync-primitive constructor → runtime
# `gorget_<kind>_new`. Mirrors the R9 allocator special-case above and Rust
# gg's hardcoded sync constructors (`src/ir/lowering/exprs/calls.rs:851` /
# `exprs/mod.rs:1652`). These structs are opaque handles (the runtime returns
# a `GorgetAtomicInt*` etc.); there is no user `T(args)` body, so the default
# struct-constructor path would build a zero-field struct + store into a
# nameless field (cc-rejected `-> = `). Name-matching these builtin sync types
# is the same Rust-blessed exception as the allocator map (the constructor name
# IS the contract with the runtime). RWLock/ReadGuard/WriteGuard are GENERIC
# (`RWLock__T`) and construct via the existing method_prefix path — NOT listed
# here. Kept FLAT with explicit literals (no concat) per R9.
String sync_constructor_runtime_name(String name):
    if name == "AtomicInt":
        return "gorget_atomic_int_new"
    if name == "AtomicBool":
        return "gorget_atomic_bool_new"
    if name == "Barrier":
        return "gorget_barrier_new"
    if name == "CondVar":
        return "gorget_condvar_new"
    if name == "Semaphore":
        return "gorget_semaphore_new"
    if name == "WaitGroup":
        return "gorget_waitgroup_new"
    if name == "OnceFlag":
        return "gorget_onceflag_new"
    return ""

# R9 FIDELITY — allocator TYPE-name → runtime `gorget_<kind>_destroy`.
# Mirrors Rust gg's `lower_with` destroy dispatch
# (`src/ir/lowering/stmts/mod.rs:2835-2841`). Keys are the FULL allocator
# type-names (mirrors Rust `type_name_for_id`). Returns "" for non-allocator
# types. Same Rust-blessed-name-match exception as the `_new` map above.
String allocator_type_destroy_name(String type_name):
    if type_name == "Arena":
        return "gorget_arena_destroy"
    if type_name == "TrackingAllocator":
        return "gorget_tracking_destroy"
    if type_name == "PoolAllocator":
        return "gorget_pool_destroy"
    if type_name == "TlsfAllocator":
        return "gorget_tlsf_destroy"
    if type_name == "FixedBufferAllocator":
        return "gorget_fba_destroy"
    if type_name == "FallbackAllocator":
        return "gorget_fallback_destroy"
    return ""

# Get the type name for a GIR local (e.g., "Vector__int64_t", "GorgetString").
String local_type_name(int local_id, LowerCtx ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return "int64_t"
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return type_id_to_base_name(tid, &gmod)

# Typed predicate: does the GIR local's (Ptr/MutPtr-peeled) base type carry the
# given method_prefix metadata VALUE? Reads `resource_meta_for(...).method_prefix`
# — a TYPED single-source dispatch (Core #2 / layering rule 2), NOT a `Shared__`/
# `Channel__` name-prefix test. Used to route `Shared[T].clone()` to the refcount-
# bump wrapper (method_prefix == "gorget_shared") instead of the byte-copy OpClone.
bool local_method_prefix_is(int local_id, String want_prefix, LowerCtx ctx, GirModule &gmod):
    String base = local_type_name(local_id, ctx, &gmod)
    match resource_meta_for(&gmod, base):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(p):
                    return p == want_prefix
                case None:
                    return false
        case None:
            return false
    return false

# Unwrap Ptr/MutPtr to reach the underlying named type (for method dispatch
# on borrow/move params).
String type_id_to_base_name(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return "int64_t"
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name
        case GtPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        case GtMutPtr(inner):
            return type_id_to_base_name(inner, &gmod)
        case GtBool():
            # A `bool` value's base name must be the canonical C name "bool"
            # (matching prim_to_c_name/type_to_c_name) — NOT the "int64_t"
            # fallback below. Method dispatch on a bool receiver mangles
            # `<recv_type_name>__<method>`; a user `equip bool:` method is
            # DEFINED as `bool__method` (target_name = type_to_c_name(bool)),
            # so a call receiver reported as "int64_t" mis-dispatched to a
            # phantom `int64_t__method` (undefined ref after DCE dropped the
            # unreferenced `bool__method`). The other scalar variants
            # (GtI8/I16/I32/U*/F32/F64) still fall through to the "int64_t"
            # default — they are NOT exercised by any current equip fixture and
            # a broader remap has wider blast radius (the "int64_t" fallback is
            # DELIBERATELY load-bearing — GtI64/plain int relies on it, see
            # lower_expr.gg:3785-3800). Extend per-variant with the same
            # prim_to_c_name spelling if/when a scalar equip needs it, after a
            # positive audit of every downstream `== "<cname>"` name-test.
            return "bool"
        else:
            pass
    return "int64_t"

# Infer the return type of a method call.
# Resolve a field type name from GirFieldInfo to a GIR type ID.
int resolve_field_gir_type(String type_name, GirModule &gmod):
    match type_name:
        case "int" | "int64_t":
            return I64_TYPE
        case "float" | "double":
            return F64_TYPE
        case "bool":
            return BOOL_TYPE
        case "String" | "GorgetString" | "Str":
            return lookup_or_register_named(&gmod, "GorgetString")
        case "int32_t" | "i32":
            return I32_TYPE
        case "int16_t" | "i16":
            return I16_TYPE
        case "int8_t" | "i8" | "byte":
            return I8_TYPE
        case "uint8_t" | "u8":
            return U8_TYPE
        case "uint16_t" | "u16":
            return U16_TYPE
        case "uint32_t" | "u32":
            return U32_TYPE
        case "uint64_t" | "u64":
            return U64_TYPE
        else:
            # BRIDGE (option_ref_borrow): a `Ref__<pointee>` field name is a
            # borrow-payload (Option[Ref[T]].Some_0) — resolve it to a real
            # GtPtr(pointee). This is the ONE name-matching site (mirrors Rust
            # methods.rs:612-615 strip_prefix("Ref__")→Ptr), reached only by a
            # heuristic that derives the payload type from a NAME before any
            # registered Option id exists. The typed path (option_ref_payload,
            # Phase 2b) covers unwrap + match-destructure directly; delete this
            # bridge once every name-deriving caller is on the typed channel.
            if type_name.starts_with("Ref__"):
                String pointee = type_name.slice(5, type_name.len())
                return register_ptr(&gmod, resolve_field_gir_type(pointee, &gmod))
            # Named type (user struct, collection, etc.)
            int rft_tid = lookup_or_register_named(&gmod, type_name)
            # Typed enum-category recording for a mono'd Option/Result that
            # arrives as a struct/enum FIELD type NAME (e.g. `R.outcome:
            # Result[int, String]`). These don't flow through a typed mint —
            # the typechecker's RTGeneric was lost when the field type was
            # stored as a name in `GirTypeInfo`, and `gmod` doesn't exist yet
            # at struct-registration time — so this lazy resolver is the
            # earliest point with `gmod` in hand. Record ONCE here (write
            # site) so the match-destructure / LIR field-shape readers stay
            # name-free (Layering rule 4). Idempotent (record_enum_category
            # is first-write-wins).
            record_field_enum_category(type_name, rft_tid, &gmod)
            return rft_tid

# Record the typed `enum_category` payloads for a mono'd `Option__`/
# `Result__` field-type NAME (the one residual name-derivation site — a
# field type stored as a name in `GirTypeInfo`, with no surviving typed
# RTGeneric). The Option payload is unambiguous (`Option__<rest>`). The
# Result split (`Result__<Ok>__<Err>`, Ok possibly compound) probes each
# `__` boundary and accepts the first where the Err half resolves to a
# registered/primitive type — recorded into the typed channel so EVERY
# READER reads tids, not names. (`Option__Ref__` is left to the
# option_ref_payload channel.)
void record_field_enum_category(String type_name, int enum_tid, GirModule &gmod):
    if has_enum_category(&gmod, enum_tid):
        return
    if type_name.starts_with("Option__") and not type_name.starts_with("Option__Ref__"):
        String inner = type_name.slice(8, type_name.len())
        record_enum_category(&gmod, enum_tid, ENUM_CAT_OPTION, resolve_field_gir_type(inner, &gmod), -1)
    elif type_name.starts_with("Result__"):
        String rest = type_name.slice(8, type_name.len())
        String ok_name = ""
        String err_name = ""
        int si = 0
        while si + 1 < rest.byte_len():
            if rest.byte_at(si) == 0x5F and rest.byte_at(si + 1) == 0x5F:
                String e_try = rest.slice(si + 2, rest.len())
                # Accept the boundary whose Err half is a known concrete type
                # (registered user type / mono'd collection / primitive). The
                # Ok half is then whatever precedes it — possibly compound.
                if is_known_field_type_name(e_try, gmod):
                    ok_name = rest.slice(0, si)
                    err_name = e_try
                    break
            si += 1
        if ok_name == "":
            # Fall back to the leftmost split.
            int split = rest.index_of("__").unwrap_or(-1)
            if split > 0:
                ok_name = rest.slice(0, split)
                err_name = rest.slice(split + 2, rest.len())
        if ok_name != "":
            record_enum_category(&gmod, enum_tid, ENUM_CAT_RESULT, resolve_field_gir_type(ok_name, &gmod), resolve_field_gir_type(err_name, &gmod))

# True when `name` is a CONCRETE field-type name: a primitive, a
# registered user struct/enum, or a mono'd collection prefix. Used only by
# `record_field_enum_category` to pick the Result Ok/Err `__` boundary.
bool is_known_field_type_name(String name, GirModule gmod):
    if name == "int" or name == "int64_t" or name == "float" or name == "double" or name == "bool":
        return true
    if name == "String" or name == "GorgetString" or name == "Str":
        return true
    if name == "int32_t" or name == "i32" or name == "int8_t" or name == "i8" or name == "byte" or name == "uint8_t":
        return true
    if name == "int16_t" or name == "uint16_t" or name == "uint32_t" or name == "uint64_t":
        return true
    if gmod.type_infos.contains(name):
        return true
    if name.starts_with("Vector__") or name.starts_with("Deque__") or name.starts_with("Heap__"):
        return true
    if name.starts_with("Set__") or name.starts_with("HashSet__") or name.starts_with("Dict__"):
        return true
    if name.starts_with("HashMap__") or name.starts_with("GorgetMap__") or name.starts_with("Box__"):
        return true
    return false

# Constant-fold a top-level `const int` initializer. Supports int
# literals, references to other const_decls, and the binary/unary ops
# the self-host's parser.gg actually uses in KW_* / PREC_* decls.
# Returns None for unsupported shapes — the const is dropped silently
# and the identifier reference later falls back to OpConstI64(0).
# Float-constant evaluator. Mirrors `eval_const_int_expr` but for
# `float EPSILON = 0.000001` etc. — module-level float consts that
# the int-evaluator can't represent. Used by the IConstDecl /
# IStaticDecl handlers to populate `gmod.float_const_decls`, which
# `EIdentifier` then consults before the [bug] fallback.
# Helper extracted from `lower_expr`'s EIdentifier arm — keeps that
# function's already-massive stack frame from growing further.
# Returns the new local id on hit (>= 0); -1 on miss.
int lower_float_const_ident(LowerCtx &ctx, GirModule gmod, String name):
    if not gmod.float_const_decls.contains(name):
        return -1
    int fdst = add_local(&ctx, F64_TYPE, None)
    emit(&ctx, GIAssign(fdst, OpConstF64(gmod.float_const_decls.get(name).unwrap())))
    return fdst

# Function-as-value: `filter(is_even)` / `map(double)` etc. — a bare
# function name passed where a Callable is expected. Mirrors Rust
# gg's `Constant::FuncRef(name)` operand. Emit a synthetic
# `__fn_addr__<name>` GICallExtern; `lir_lower` intercepts that
# prefix and lowers to `IFuncAddr(fid)`, which the C codegen turns
# into the `static void*[] = {(void*)__adapt_<name>, NULL}` shape
# `gorget_array_filter` / etc. expect. Returns the new local id on
# hit (>= 0); -1 on miss.
#
# Only fires for non-generic functions registered in `fn_sigs` — a
# generic template wouldn't have a single mono'd target to point at.
# The helper is in its own function (not inlined) for the same
# stack-frame reason as `lower_float_const_ident`.
int lower_fn_addr_ident(LowerCtx &ctx, GirModule &gmod, String name):
    if not gmod.fn_sigs.contains(name):
        return -1
    int gs_tid = lookup_or_register_named(&gmod, "GorgetClosure")
    int adst = add_local(&ctx, gs_tid, None)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(adst, "__fn_addr__" + name, no_args))
    return adst

# Module-level static reference: `stdout` / `stderr` / `stdin` etc.
# Emits a synthetic `__global_ref__<name>` GICallExtern which
# `lir_lower` rewrites to `IGlobalAddr(dst, gid)`. Mirrors Rust gg's
# `Operand::Constant(Constant::GlobalRef(name))`
# (`src/ir/lowering/exprs/mod.rs:128-130`). Returns the new local id
# on hit (>= 0); -1 on miss. Out-of-line for the same stack-frame
# reason as `lower_float_const_ident` / `lower_fn_addr_ident`.
int lower_static_ref_ident(LowerCtx &ctx, GirModule gmod, String name):
    if not static_contains(gmod, name):
        return -1
    int sty = static_lookup_type(gmod, name)
    int sdst = add_local(&ctx, sty, None)
    Vector[Operand] no_args = []
    emit(&ctx, GICallExtern(sdst, "__global_ref__" + name, no_args))
    return sdst

# Bare nullary enum-variant used as a value: `IDropGuardClose` brought
# into scope via `from lir import IDropGuardClose` and referenced WITHOUT
# parens (lir_lower.gg:3296 `dia_blk.insts.push(IDropGuardClose)`).
# docs/language-reference.md:677/719 permit bare nullary variants
# (`LogLevel lvl = Info`); Rust gg accepts them (kept as an identifier
# through parse/resolve, resolved in the lowerer — src/ir/lowering/exprs/
# mod.rs:176-180). The with-parens form `IDropGuardClose()` already works,
# so we delegate the bare form to the identical `lower_call(name, [], [])`
# path: lower_call types the dst as the parent enum via is_type_constructor
# + enum_variant_parent (lower.gg:5432-5436), emits `GICall(dst, name, [])`,
# which lir_lower passes through as an ICallExtern and the C backend renders
# as a full-size `(Inst){.tag = N}` compound literal (lir_codegen.gg:4043,
# 4106-4132). (NOT via try_lower_prelude_variant/IEnumInit — that path is
# Some/None/Ok/Error only.) Without this, the bare form falls through to the
# EIdentifier [bug] fallback and emits an 8-byte OpConstI64(0); a later
# `vec.push(...)` then memcpy's it as a full-size Inst (208 B) → stack-
# buffer-overflow at runtime. Out-of-line for the same stack-frame reason
# as lower_fn_addr_ident / lower_static_ref_ident (lower_expr's frame is
# ~148 KB and overflows on deep recursion). Returns the new local id
# (>= 0) on hit, -1 on miss.
int lower_nullary_variant_ident(LowerCtx &ctx, GirModule &gmod, String name):
    String parent = enum_variant_parent(name, gmod)
    if parent == "":
        return -1
    Vector[SpannedExpr] no_args = []
    Vector[String] no_arg_names = []
    Vector[SpannedType] no_targs = []
    return lower_call(&ctx, name, no_args, no_arg_names, no_targs, &gmod)

# Meta-op token (`meta +`, `meta /`, …): the parser encodes these
# as `EIdentifier("__metaop__add")` / `__metaop__div` / etc. and
# passes them as args to generic functions like
# `tensor_elemwise[T](a, b, meta op)` (`lib/xtd/tensor.gg:307`).
# These tokens are *compile-time only* — Rust gg filters them out
# of the call arg list at GIR lowering
# (`src/ir/lowering/exprs/calls.rs:882-893`) and uses them only to
# build the mangled callee name (`tensor_elemwise__add` etc.) via
# what `meta_op_arg_suffix` mirrors here. They have no runtime
# representation; if `lower_expr` walks one as a real value
# identifier (because the call's arg-lowering didn't filter it),
# the existing `[bug] EIdentifier` fallback triggers.
#
# Emit a harmless zero-int placeholder when the EIdentifier arm
# encounters one. The mangled call name was already computed by
# `meta_op_arg_suffix` during transitive-generic discovery, so
# the runtime call dispatches to e.g. `tensor_elemwise__add`,
# which doesn't take a meta-op param. Whatever extra arg gets
# emitted from this placeholder is dead at the C level — but the
# cascade closes (24 EIdentifier `[bug]` markers across the
# `xtd__tensor` family in the fixture sweep go to zero). Out-of-line
# for the same stack-frame reason as the other ident helpers above.
int lower_metaop_ident(LowerCtx &ctx, String name):
    if not name.starts_with("__metaop__"):
        return -1
    int mdst = add_local(&ctx, I64_TYPE, None)
    emit(&ctx, GIAssign(mdst, OpConstI64(0)))
    return mdst

# Module-level static with a runtime-call init: `public static File
# stdout = _stdout_handle()` etc. (lib/std/io.gg). Mirrors Rust gg's
# `LoweringContext::global_names` + `module.globals: Vec<Global>`
# (`src/ir/lowering/mod.rs:1074-1111`). Recognises the zero-arg
# `_<sym>()` shape and registers it under `gmod.static_keys` so the
# `EIdentifier` arm can resolve to a `__global_ref__<name>` synthetic
# intrinsic which `lir_lower` rewrites to `IGlobalAddr`.
#
# Only the `_<sym>` → `gorget_<sym>` underscore-prefix mapping is
# wired (sufficient for `_stdin_handle` / `_stdout_handle` /
# `_stderr_handle`). Other init shapes return false; the caller
# falls through to the existing ENoneLiteral / [bug] cascade.
#
# Helper lives in its own fn for the same stack-frame reason as
# `lower_float_const_ident` / `lower_fn_addr_ident` — keeping the
# IStaticDecl-arm dispatch site small.
bool try_register_static_runtime_call(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, _):
            if args.len() != 0:
                return false
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fn_name):
                    if not fn_name.starts_with("_"):
                        return false
                    String runtime_call = "gorget_" + fn_name.slice(1, fn_name.len()) + "()"
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put(&gmod, sd_name, runtime_call, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Module-level static with a CONSTRUCTIVE (non-compile-time-constant)
# initializer. Mirrors Rust gg's TWO-PATH static lowering
# (`src/ir/lowering/mod.rs`), and stays faithful to it so the
# `c_emit_comparison` user-fn count matches:
#
#  (1) ARRAY/DICT LITERAL (`static Vector[T] X = [..]` / `= {..}`) →
#      a synthesized zero-arg `__gg_static_init_<name>()` fn whose body
#      materializes the RHS (Rust's `initializer_needs_synthetic_fn`
#      `:2381` + `synthesize_static_init_fn` `:2397`). The static's
#      init_expr is the call `__gg_static_init_<name>()`.
#
#  (2) COLLECTION CONSTRUCTOR (`static Vector[int] N = Vector[int]()` /
#      `Dict[String,int]()`) → a DIRECT runtime allocator init_expr
#      (`gorget_array_new(sizeof(T))` / `gorget_dict_new[_str](...)`),
#      NO synth fn (Rust's `eval_static_init` arms `:2580-2620`). Rust
#      emits ZERO user fns for these, so a synth fn here would over-count.
#
# Both register the static with its declared `Vector__T`/`Dict__K__V`
# type so an `EIdentifier` reference resolves to a properly-typed
# `__global_ref__<name>` → `IGlobalAddr`, and the loop / `.get()` route
# to `lower_for_vector` / the typed collection methods. The
# `GINIT_RUNTIME_CALL` global is assigned in the `main` prologue
# (`lir_codegen.gg:4504-4513`) — for (1) it calls the synth fn, for (2)
# it runs the allocator C-expr directly.

# True for an array/dict/string literal RHS → synth-fn path (case 1 above).
# A module-level `static String s = "hi"` belongs here too: a String
# literal is NOT a compile-time const-bytes value (it needs a runtime
# `gorget_str_from_literal` wrap of text+len into a `Str` struct), and a
# `static` is MUTABLE — so it must NOT be const-folded into
# `string_const_decls` (the IConstDecl `const String` path) which would
# inline the value and silently drop any later write. The synth fn
# `String __gg_static_init_s(): String __r = "hi"; return __r` builds the
# GorgetString via the normal string-literal VarDecl lowering (escaping /
# interpolation handled there) and returns it into the real mutable global.
# Mirrors Rust's `GlobalInit::Extern { gorget_str_from_literal }` for a
# String static (`src/ir/lowering/mod.rs:2787-2795`); the SH wraps the same
# runtime call in the uniform synth-init fn instead of an inline extern.
bool static_is_literal_init(SpannedExpr sd_val):
    match sd_val.expr:
        case EArrayLiteral(_):
            return true
        case EDictLiteral(_, _):
            return true
        case EStringLiteral(_, _):
            return true
        else:
            return false

# True for a SCALAR-literal RHS (int / float / bool), including a leading
# unary `-` / `+` thereof (`static int x = -1`). Scalar statics are
# MUTABLE module-level globals (a `static` is not a `const`), so they are
# registered under `gmod.statics` with a runtime-init synth fn rather than
# const-folded — see the IStaticDecl pre-pass.
bool static_is_scalar_literal_init(SpannedExpr sd_val):
    match sd_val.expr:
        case EIntLiteral(_):
            return true
        case EFloatLiteral(_):
            return true
        case EBoolLiteral(_):
            return true
        case EUnaryOp(op, inner_box):
            if op == "-" or op == "+":
                return static_is_scalar_literal_init(*inner_box)
            return false
        else:
            return false

String static_init_fn_name(String sd_name):
    return "__gg_static_init_" + sd_name

# Render a SCALAR-literal static RHS as a const C initializer expression
# (the `init_expr` of a GGSTATIC_BYTES global): int → `<n>LL`, float →
# `float_to_str(v)`, bool → `1`/`0`, recursing through a leading unary
# `-` / `+`. Mirrors Rust encoding the literal as `GlobalInit::Bytes`
# then the C backend rendering those bytes back to a literal
# (`src/backend/c_lir/emit_types.rs:630-655`: int = `<n>LL`, float = the
# decimal value, bool = the byte). Returns "" if not a recognised scalar
# literal (caller falls through to the runtime synth-fn path).
String scalar_static_c_literal(SpannedExpr sd_val):
    match sd_val.expr:
        case EIntLiteral(n):
            return int_to_str(n) + "LL"
        case EFloatLiteral(v):
            return float_to_str(v)
        case EBoolLiteral(b):
            if b:
                return "1"
            return "0"
        case EUnaryOp(op, inner_box):
            if op == "-" or op == "+":
                String inner = scalar_static_c_literal(*inner_box)
                if inner == "":
                    return ""
                return op + inner
            return ""
        else:
            return ""

# Register a SCALAR-literal static (`static int x = 0`) as a const-bytes
# global: render the RHS to a C literal and store it as the global's
# `init_expr` under GGSTATIC_BYTES. NO synth init fn, NO main-prologue
# call — the C backend emits `<type> <name> = <literal>;` at the
# declaration. Mirrors Rust's every-StaticDecl-is-a-mutable-Global rule
# emitting a scalar literal via `GlobalInit::Bytes`
# (`src/ir/lowering/mod.rs:2459-2461`, `is_const:false`). The static stays
# MUTABLE (write-backs via SAssign work as before).
void register_scalar_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    int ty_id = map_ast_type(sd_ty, &gmod)
    String lit = scalar_static_c_literal(sd_val)
    static_put_bytes(&gmod, sd_name, lit, ty_id)

# Spell the C type name used as the `sizeof(...)` element-size operand of
# a runtime collection constructor (`gorget_dict_new(sizeof(K), sizeof(V))`,
# `gorget_array_new(sizeof(E))`). The surface arg type is NOT always a
# declared C type:
#   - a NESTED COLLECTION value (`Dict[int, Vector[int]]`'s `Vector[int]`,
#     `Dict[int, Set[int]]`'s `Set[int]`) decays to its runtime HANDLE
#     struct (`GorgetArray`/`GorgetMap`/`GorgetSet`), read from the typed
#     `ResourceMetadata.runtime_name` via the resolved CollectionKind — NOT
#     a name-prefix test (layering discipline). A bare `sizeof(Vector)` /
#     `sizeof(Set)` is an undeclared C type (cc error on C, size-8
#     truncation on LLVM).
#   - a USER-STRUCT value (`Dict[int, Point]`'s `Point`) must be spelled
#     `__gg_<name>` HERE: this function builds a verbatim GIR-level init
#     string that BYPASSES the later `build_struct_names` `__gg_` prefixing
#     pass (`lir_codegen.gg:260`), so a bare `sizeof(Point)` is undeclared.
#   - everything else (primitives, GorgetString) routes through
#     `type_to_c_name`, which already spells the declared C type.
# Mirrors Rust's `collection_arg_sizeof_c_type` (`src/ir/lowering/mod.rs:2913`,
# reads `BuiltinTypeProtocol.collection_kind`); the user-struct `__gg_`
# spelling mirrors the C-emit `Sizeof` remap (`src/backend/c_lir/mod.rs:193`).
String collection_arg_sizeof_c_type(SpannedType arg_ty, GirModule &gmod):
    match arg_ty.ty:
        case TNamed(name, _):
            # Nested-collection value → runtime handle struct (typed).
            CollectionKind vkind = collection_kind_of(&gmod, name + "__")
            match vkind:
                case CkNotCollection():
                    # User-struct value → spell `__gg_<name>` directly (this
                    # fn bypasses the `build_struct_names` prefixing pass).
                    if gmod.type_infos.contains(name):
                        return "__gg_" + name
                else:
                    match resource_meta_for(&gmod, name + "__"):
                        case Some(rm):
                            return rm.runtime_name
                        case None:
                            pass
        else:
            pass
    # Primitives / GorgetString / fallthrough.
    return type_to_c_name(arg_ty, &gmod)

# Build the `gorget_array_new(...)` / `gorget_ordered_set_new[_str](...)` /
# `gorget_set_new[_str](...)` / `gorget_dict_new[_str](...)` C init expr for
# a collection-CONSTRUCTOR static (case 2). The element C-type names come
# from the DECLARED type's args (Rust's `eval_static_init` reads `ty`, not
# the call). Returns "" if the declared type isn't a recognised collection
# — the caller then falls through (a non-collection constructor static is
# not handled by this path).
#
# The Set/HashSet ordered-vs-unordered axis is read from the TYPED resolved
# CollectionKind of the mangled name (`collection_kind_of(&gmod, tn + "__")`
# → `Set__`→CkOrderedSet, `HashSet__`→CkHashSet), NOT a name match — the
# single producer of that axis is the RESOURCES prefix table
# (`lir_lower.gg:289`). The lumped `gorget_array_new` arm was WRONG for
# Set/HashSet: the global's C type is `GorgetSet`, so an array header is an
# incompatible-types cc error (and a runtime segfault). Mirrors Rust's
# per-type `eval_static_init` arms (`src/ir/lowering/mod.rs:2753-2795`):
# `Vector`→`gorget_array_new`; `Set`→`gorget_ordered_set_new[_str]`;
# `HashSet`→`gorget_set_new[_str]`. The `_str` variants (zero-arg) fire when
# the element C type is `GorgetString`.
String collection_ctor_init_expr(SpannedType sd_ty, GirModule &gmod):
    match sd_ty.ty:
        case TNamed(tn, targs):
            if targs.len() >= 1:
                CollectionKind kind = collection_kind_of(&gmod, tn + "__")
                String elem_c = collection_arg_sizeof_c_type(targs.get(0).unwrap(), &gmod)
                match kind:
                    case CkOrderedSet():
                        if elem_c == "GorgetString":
                            return "gorget_ordered_set_new_str()"
                        return "gorget_ordered_set_new(sizeof(" + elem_c + "))"
                    case CkHashSet():
                        if elem_c == "GorgetString":
                            return "gorget_set_new_str()"
                        return "gorget_set_new(sizeof(" + elem_c + "))"
                    case CkVector():
                        return "gorget_array_new(sizeof(" + elem_c + "))"
                    case CkDeque():
                        return "gorget_array_new(sizeof(" + elem_c + "))"
                    case CkHeap():
                        return "gorget_array_new(sizeof(" + elem_c + "))"
                    else:
                        pass
            if (tn == "Dict" or tn == "HashMap") and targs.len() >= 2:
                String key_c = collection_arg_sizeof_c_type(targs.get(0).unwrap(), &gmod)
                String val_c = collection_arg_sizeof_c_type(targs.get(1).unwrap(), &gmod)
                if key_c == "GorgetString":
                    return "gorget_dict_new_str(sizeof(" + val_c + "))"
                return "gorget_dict_new(sizeof(" + key_c + "), sizeof(" + val_c + "))"
            return ""
        else:
            return ""

# Detect + register a collection-constructor static (case 2). The init
# RHS must be a zero-arg `ECall` whose callee is an EIdentifier matching
# the declared collection type (`Vector[int]()` parses as
# `ECall(EIdentifier("Vector"), [], [int])`). Returns true on hit
# (registered with a direct allocator init_expr, NO synth fn); false to
# fall through to the literal / None cascade.
bool try_register_collection_ctor_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, _):
            if args.len() != 0:
                return false
            match (*callee_box).expr:
                case EIdentifier(_):
                    String init_expr = collection_ctor_init_expr(sd_ty, &gmod)
                    if init_expr == "":
                        return false
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put(&gmod, sd_name, init_expr, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Detect + register a USER-STRUCT-constructor static (case 3): a
# `static Counter c = Counter(0)` whose RHS is `ECall(EIdentifier(cname),
# [literal, ...], [])` with the declared type bare `TNamed(cname, [])`,
# `cname` a NON-enum user struct (in `gmod.type_infos`), NOT a sync/atomic
# constructor, and EVERY arg a recognised scalar literal. Builds the
# positional C compound literal in arg order (`Counter(0)` → `{0LL}`) and
# registers it as a GGSTATIC_BYTES const init — the C backend emits
# `<struct> __lir_gN = {0LL};` at the declaration, no synth fn. Mirrors
# Rust's `GlobalInit::Struct` (`src/ir/lowering/mod.rs:2630-2659`): all-args-
# literal struct ctor → typed compile-time initializer, both backends render
# it to `{f0, f1, …}`. Returns true on hit; false (any guard fails) to fall
# through to the literal / None cascade with NO regression.
bool try_register_struct_ctor_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, targs):
            if targs.len() != 0:
                return false
            if args.len() == 0:
                return false
            match (*callee_box).expr:
                case EIdentifier(cname):
                    # Declared type must be bare `TNamed(cname, [])` (no
                    # generic args; the call's name must match the type).
                    match sd_ty.ty:
                        case TNamed(tn, ty_targs):
                            if tn != cname:
                                return false
                            if ty_targs.len() != 0:
                                return false
                        else:
                            return false
                    # `cname` must be a registered NON-enum user struct, and
                    # NOT a sync/atomic constructor (those route through
                    # `sync_constructor_runtime_name` at the runtime path).
                    if not gmod.type_infos.contains(cname):
                        return false
                    GirTypeInfo sct_ti = gmod.type_infos.get(cname).unwrap()
                    if sct_ti.is_enum:
                        return false
                    if sync_constructor_runtime_name(cname) != "":
                        return false
                    # Every arg must render as a scalar C literal; build the
                    # positional compound literal in arg order.
                    String lit = "{"
                    int ai = 0
                    while ai < args.len():
                        String al = scalar_static_c_literal(args.get(ai).unwrap().value)
                        if al == "":
                            return false
                        if ai > 0:
                            lit = lit + ", "
                        lit = lit + al
                        ai += 1
                    lit = lit + "}"
                    int ty_id = map_ast_type(sd_ty, &gmod)
                    static_put_bytes(&gmod, sd_name, lit, ty_id)
                    return true
                else:
                    return false
        else:
            return false

# Detect + register a SYNC-PRIMITIVE-constructor static (`AtomicInt counter
# = AtomicInt(0)`, `Barrier b = Barrier(2)`, `CondVar cv = CondVar()`, …).
# These are module-level sync GLOBALS — the language spec
# (`docs/language-reference.md:3592`) lets them be declared without the
# `static` keyword. The runtime ctor (`gorget_atomic_int_new` etc.) returns
# an OPAQUE HANDLE POINTER (`GorgetAtomicInt*`), allocated at runtime — NOT a
# compile-time constant. So register it as a GINIT_RUNTIME_CALL static whose
# init_expr is the `gorget_<kind>_new(<args>)` C call (run once at the main
# prologue, `lir_codegen.gg:5535`), with the static TYPED as a
# `Ptr(Named(cname))` slot so:
#   (a) `emit_globals` declares it `GorgetAtomicInt* __lir_gN;` (a pointer
#       slot can hold the handle — a bare value slot can't), and
#   (b) a later `EIdentifier(counter)` read takes the GlobalRef→GlobalAddr
#       +Load path (`lir_lower.gg`) which now loads the handle VALUE for a
#       pointer-handle slot, then `local_type_name`→`type_id_to_base_name`
#       unwraps the Ptr to "AtomicInt" so `counter.add(1)` dispatches
#       `gorget_atomic_int_add` (not the `int64_t__add` placeholder bug).
# Mirrors Rust gg's `eval_static_init` sync arms emitting `GlobalInit::Extern
# { name, args }` (`src/ir/lowering/mod.rs:2650-2674`) — the SAME runtime-call
# global Rust produces. Keyed on the TYPED `sync_constructor_runtime_name`
# map (NOT a name-match here — that map IS the typed registry, the same
# Rust-blessed constructor-name-is-the-runtime-contract exception the
# allocator/sync ctor branches at the expr path already use). Returns true on
# hit; false (not a sync ctor / arg not a scalar literal) to fall through.
bool try_register_sync_ctor_static(GirModule &gmod, SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    match sd_val.expr:
        case ECall(callee_box, args, targs):
            match (*callee_box).expr:
                case EIdentifier(cname):
                    # GENERIC sync ctor: `Mutex[T] g = Mutex[T](v)` / `RWLock`.
                    # The runtime ctor `gorget_mutex_new(size_t, void* init)`
                    # returns a `GorgetMutex*` handle. Rust's GlobalInit::Extern
                    # emits a MANGLED `Mutex__<elem_c>__new` (mod.rs:2675) that
                    # the LIR then remaps to `gorget_mutex_new(sizeof(T), &init)`
                    # — but the self-host static path emits the init_expr as a
                    # RAW C STRING (no GIR-call / LIR-remap hop), so we spell the
                    # FINAL resolved runtime call directly:
                    #   `gorget_mutex_new(sizeof(<elem_c>), &(<elem_c>){<val>})`
                    # (the size + by-address-value shape `runtime.rs:472`). This
                    # mirrors how the non-generic sync ctors above already emit
                    # their resolved `gorget_<kind>_new(...)` string verbatim.
                    # `Mutex[T]` is GENERIC so it never reaches the bare-name
                    # `sync_constructor_runtime_name` arm below.
                    if cname == "Mutex" or cname == "RWLock":
                        if targs.len() == 0:
                            return false
                        String gen_run_fn = "gorget_mutex_new"
                        if cname == "RWLock":
                            gen_run_fn = "gorget_rwlock_new"
                        String gen_elem_c = type_to_c_name(targs.get(0).unwrap(), &gmod)
                        # Initial value literal (defaults to 0 — Rust
                        # `arg_inits.first().unwrap_or(Int(0))`).
                        String gen_val = "0"
                        if args.len() > 0:
                            gen_val = scalar_static_c_literal(args.get(0).unwrap().value)
                            if gen_val == "":
                                return false
                        String gen_init = gen_run_fn + "(sizeof(" + gen_elem_c + "), &(" + gen_elem_c + "){" + gen_val + "})"
                        String gen_mangled = mangle_type_name(cname, targs, &gmod)
                        int gen_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, gen_mangled))
                        static_put(&gmod, sd_name, gen_init, gen_ptr_ty)
                        return true
                    if targs.len() != 0:
                        return false
                    String sync_new_fn = sync_constructor_runtime_name(cname)
                    if sync_new_fn == "":
                        return false
                    # Build the `gorget_<kind>_new(<arg literals>)` init expr.
                    # Sync-ctor args are scalar literals (count / initial
                    # value): `AtomicInt(0)` / `Barrier(2)` / `CondVar()`.
                    # `scalar_static_c_literal` renders int→`<n>LL`,
                    # bool→`1`/`0` (the C `gorget_atomic_bool_new` takes an
                    # int 0/1 — bool literal already renders compatibly).
                    String init_expr = sync_new_fn + "("
                    int ai = 0
                    while ai < args.len():
                        String al = scalar_static_c_literal(args.get(ai).unwrap().value)
                        if al == "":
                            return false
                        if ai > 0:
                            init_expr = init_expr + ", "
                        init_expr = init_expr + al
                        ai += 1
                    init_expr = init_expr + ")"
                    # Type the static as `Ptr(Named(cname))` — the runtime
                    # returns a `GorgetAtomicInt*`; a bare value slot can't
                    # hold it. `type_id_to_base_name` unwraps the Ptr→cname
                    # so method dispatch still resolves on the type name.
                    int sync_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, cname))
                    static_put(&gmod, sd_name, init_expr, sync_ptr_ty)
                    return true
                else:
                    return false
        else:
            return false

# Register a LITERAL-init static (case 1) under `gmod.statics`; the
# matching `FunctionDef` is built by `build_static_init_fn` and lowered in
# the main function loop. Mirrors Rust pushing a `Global { init:
# Extern { name: synth_name, args: [] } }`.
void register_literal_static(GirModule &gmod, SpannedType sd_ty, String sd_name):
    int ty_id = map_ast_type(sd_ty, &gmod)
    String init_call = static_init_fn_name(sd_name) + "()"
    static_put(&gmod, sd_name, init_call, ty_id)

# Build the synthetic `<T> __gg_static_init_<name>(): T __r = RHS; return __r`
# FunctionDef. The body MUST be the VarDecl-with-declared-type then
# `return __r` shape (NOT `return RHS`): the VarDecl init lowering reads
# the declared type to size collection-literal buffers + propagate the
# element type (`lower_stmt`'s SVarDecl arm sets `pending_vec_elem_tyname`
# / `pending_dict_*`). Mirrors Rust's `synthesize_static_init_fn`
# (`src/ir/lowering/mod.rs:2386-2441`) — same anti-"simplify-to-return-RHS"
# warning applies.
FunctionDef build_static_init_fn(SpannedType sd_ty, String sd_name, SpannedExpr sd_val):
    # ownership=0 (OWN_BORROW), shared=0, name_span=-1 — matching the
    # self-host parser's local-VarDecl construction (parser.gg:3208).
    Stmt vd = SVarDecl(sd_ty, "__r", sd_val, 0, 0, -1)
    SpannedExpr ret_id = SpannedExpr(EIdentifier("__r"), sd_val.span)
    Stmt rs = SReturn(Some(ret_id))
    Vector[Stmt] body = [vd, rs]
    Vector[Param] no_params = []
    Vector[String] no_tparams = []
    return FunctionDef(static_init_fn_name(sd_name), no_params, sd_ty, no_tparams, body, false, None, false, false)

Option[float] eval_const_float_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EFloatLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.float_const_decls.contains(name):
                return Some(gmod.float_const_decls.get(name).unwrap())
            return None
        case EUnaryOp(op, inner_box):
            Option[float] iv = eval_const_float_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0.0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

# Constant-fold a `const bool` initializer (`const bool ENABLED = true`).
# Mirrors Rust's `eval_const_expr` BoolLiteral arm (Constant::Bool) +
# the `not` unary fold + int-comparison fold (`a > b` etc. → Bool).
# Used by the module-const registration loop to populate
# `gmod.bool_const_decls`, which the EIdentifier arm reads before the
# [bug] fallback. Without this, a module-level bool const falls through
# int/float eval and is dropped → reads as OpConstI64(0).
Option[bool] eval_const_bool_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EBoolLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.bool_const_decls.contains(name):
                return Some(gmod.bool_const_decls.get(name).unwrap())
            return None
        case EUnaryOp(op, inner_box):
            if op == "not" or op == "!":
                Option[bool] bv = eval_const_bool_expr(*inner_box, &gmod)
                match bv:
                    case Some(ba):
                        return Some(not ba)
                    case None:
                        return None
            return None
        case EBinaryOp(lhs_box, op, rhs_box):
            # Int-comparison fold (`const bool X = A > B`). Mirrors Rust's
            # `eval_const_expr` (mod.rs:3731-3736): a comparison of two
            # int consts → Constant::Bool. Both sides must const-fold to
            # ints; non-comparison ops (or non-int operands) → None.
            Option[int] lv = eval_const_int_expr(*lhs_box, &gmod)
            Option[int] rv = eval_const_int_expr(*rhs_box, &gmod)
            match lv:
                case Some(la):
                    match rv:
                        case Some(ra):
                            if op == ">":
                                return Some(la > ra)
                            if op == "<":
                                return Some(la < ra)
                            if op == ">=":
                                return Some(la >= ra)
                            if op == "<=":
                                return Some(la <= ra)
                            if op == "==":
                                return Some(la == ra)
                            if op == "!=":
                                return Some(la != ra)
                            return None
                        case None:
                            return None
                case None:
                    return None
        else:
            return None

# Constant-fold a `const String` initializer (`const String G = "hi"`).
# Mirrors Rust's `eval_const_expr` StringLiteral arm (Constant::Str),
# limited to NON-interpolated string literals (same restriction Rust
# applies). Used by the module-const registration loop to populate
# `gmod.string_const_decls`, read by the EIdentifier arm.
Option[String] eval_const_string_expr(SpannedExpr spe, GirModule gmod):
    match spe.expr:
        case EStringLiteral(s, _):
            return Some(s)
        case EIdentifier(name):
            if gmod.string_const_decls.contains(name):
                return Some(gmod.string_const_decls.get(name).unwrap())
            return None
        else:
            return None

Option[int] eval_const_int_expr(SpannedExpr spe, GirModule &gmod):
    match spe.expr:
        case EIntLiteral(v):
            return Some(v)
        case EIdentifier(name):
            if gmod.const_decls.contains(name):
                return Some(gmod.const_decls.get(name).unwrap())
            return None
        case EBinaryOp(lhs_box, op, rhs_box):
            Option[int] lv = eval_const_int_expr(*lhs_box, &gmod)
            Option[int] rv = eval_const_int_expr(*rhs_box, &gmod)
            match lv:
                case Some(la):
                    match rv:
                        case Some(ra):
                            if op == "+":
                                return Some(la + ra)
                            if op == "-":
                                return Some(la - ra)
                            if op == "*":
                                return Some(la * ra)
                            if op == "/" and ra != 0:
                                return Some(la / ra)
                            if op == "%" and ra != 0:
                                return Some(la - (la / ra) * ra)
                            return None
                        case None:
                            return None
                case None:
                    return None
        case EUnaryOp(op, inner_box):
            Option[int] iv = eval_const_int_expr(*inner_box, &gmod)
            match iv:
                case Some(ia):
                    if op == "-":
                        return Some(0 - ia)
                    if op == "+":
                        return Some(ia)
                    return None
                case None:
                    return None
        else:
            return None

# Get and increment the module-level closure ID counter. Stored in
# `gmod.named_types` under the synthetic key `__closure_counter` so it
# tags along with the same Dict that holds named-type registrations.
int gmod_next_closure_id(GirModule &gmod):
    int cid = 0
    if gmod.named_types.contains("__closure_counter"):
        cid = gmod.named_types.get("__closure_counter").unwrap()
    gmod.named_types.put("__closure_counter", cid + 1)
    return cid

# Strip the mangled map prefix (`Dict__`/`HashMap__`/`GorgetMap__`) from a
# receiver type name, returning the `K__V` payload (or "" if not a map type).
# SINGLE name-parsing site shared by the `items` and `keys`/`values`
# return-type-inference arms (was duplicated inline in both). The K/V are
# encoded only in the mangled name at this layer, so name-parsing is the
# available mechanism; consolidating to one helper keeps the self-host
# name-prefix routing ratchet flat instead of adding sibling sites.
String map_kv_payload(String recv_name):
    if recv_name.starts_with("Dict__"):
        return recv_name.slice(6, recv_name.len())
    elif recv_name.starts_with("HashMap__"):
        return recv_name.slice(9, recv_name.len())
    elif recv_name.starts_with("GorgetMap__"):
        return recv_name.slice(11, recv_name.len())
    return ""

int infer_method_return_type(String method, int recv, LowerCtx ctx, GirModule &gmod):
    # Void-returning methods. `Vector[T].remove(idx)` was previously
    # treated as void, but actually returns `Option[T]` — the void
    # classification left bindings in `T x = v.remove(i).unwrap()`
    # typed unit, cascading every `x.field` into
    # `EFieldAccess: unknown field on base type 'unit'`. Vector.remove
    # is now routed through the receiver-aware path (~line 752).
    # Set/HashSet.remove returns bool (runtime `gorget_set_remove`
    # reports presence); Dict.remove returns `Option[V]` (runtime
    # `gorget_map_remove_opt` transfers the removed value out). Both are
    # dispatched receiver-aware below via the typed `collection_kind`.
    if method == "push" or method == "set" or method == "put":
        return UNIT_TYPE
    # `Vector[T].fill(n, val)` — preallocates capacity + memcpys n
    # copies of val into the buffer. Void return; runtime symbol
    # `gorget_array_fill`. Phase 1 cheap-win (`5e6b3bef`) introduced
    # the call site without wiring this entry, which left the call
    # typed as I64 → stage-1 cc errored "void value not ignored".
    if method == "fill":
        return UNIT_TYPE
    # `remove` is dispatched receiver-aware below: Vector/Deque → Option[T],
    # Set/HashSet → bool, Dict → Option[V] (all via typed collection_kind).
    if method == "remove":
        String recv_n = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_t = ctx.locals.get(recv).unwrap().type_id
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_t).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_t = inner
                    case GtMutPtr(inner):
                        recv_t = inner
                    else:
                        pass
            if recv_t >= 0 and recv_t < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_t).unwrap()
                match gt:
                    case GtNamed(rname):
                        recv_n = rname
                    else:
                        pass
        # Phase A typed read: `Set.remove(k)` returns bool at the runtime
        # (`gorget_set_remove` reports whether the element was present), so the
        # result slot is bool — without this it defaults to I64 and a
        # `print(f"{s.remove(x)}")` prints 1/0 instead of true/false. `Dict.remove(k)`,
        # however, returns `Option[V]` (runtime `gorget_map_remove_opt`
        # transfers the removed value out) — it falls through to the shared
        # consuming-getter path below (~line 1868), which mints `Option__V`
        # off the receiver's V suffix exactly like `.get()`/`.pop()`. Mirrors
        # Rust gg (`builtins.rs:459` Set.remove → ret_bool; HashSet shares
        # SET.methods. `typecheck.rs:5458` Dict.remove → Option[V !]).
        match resource_meta_for(&gmod, recv_n):
            case Some(rmeta):
                match rmeta.collection_kind:
                    case CkOrderedSet():
                        return BOOL_TYPE
                    case CkHashSet():
                        return BOOL_TYPE
                    else:
                        pass
            case None:
                pass
        # Dict/Vector/Deque/etc. — fall through to receiver-aware path below.
    if method == "clear" or method == "insert" or method == "extend" or method == "reverse":
        return UNIT_TYPE
    # `Dict/HashMap.update(other)` merges other's entries in place; void
    # return (runtime `gorget_map_update`). Mirrors Rust typecheck.rs:5613
    # (`"put" | "set" | "update" => void_id`). Without this the call falls
    # through to the I64 default → cc errors "void value not ignored".
    if method == "update":
        return UNIT_TYPE
    # `Vector[T].reserve(n)` — grows the allocation in place; void return
    # (runtime `gorget_array_reserve`). Sibling of clear/insert/extend
    # above. Without this entry the call falls through to the I64 default,
    # creating a bogus destination → cc errors "void value not ignored".
    if method == "reserve":
        return UNIT_TYPE
    if method == "sort" or method == "swap":
        return UNIT_TYPE
    # `swap_remove` is receiver-aware per D39 Phase A.3 DD#6 (each type's OWN
    # `remove` shape wins): Vector/Deque → void (protocol); Set/HashSet → bool;
    # Dict/HashMap → Option[V] (fall through to the consuming-getter path
    # below). Mirrors the `remove` arm above (~line 1838).
    if method == "swap_remove":
        String swrn_n = ""
        if recv >= 0 and recv < ctx.locals.len():
            int swrn_t = ctx.locals.get(recv).unwrap().type_id
            if swrn_t >= 0 and swrn_t < gmod.type_table.len():
                GirType swrn_gt0 = gmod.type_table.get(swrn_t).unwrap()
                match swrn_gt0:
                    case GtPtr(inner):
                        swrn_t = inner
                    case GtMutPtr(inner):
                        swrn_t = inner
                    else:
                        pass
            if swrn_t >= 0 and swrn_t < gmod.type_table.len():
                GirType swrn_gt = gmod.type_table.get(swrn_t).unwrap()
                match swrn_gt:
                    case GtNamed(rname):
                        swrn_n = rname
                    else:
                        pass
        match resource_meta_for(&gmod, swrn_n):
            case Some(swrn_meta):
                match swrn_meta.collection_kind:
                    case CkOrderedSet():
                        return BOOL_TYPE
                    case CkHashSet():
                        return BOOL_TYPE
                    case CkVector():
                        # Vector protocol: void (matches Rust builtins.rs
                        # `ret_void`; the swap_remove | swap | fill row).
                        return UNIT_TYPE
                    case CkDeque():
                        return UNIT_TYPE
                    else:
                        # CkDict → fall through to the receiver-aware
                        # Option[V]-minting path below (line ~2425, shared
                        # with `remove`).
                        pass
            case None:
                # No metadata (e.g., unresolved receiver) — default to void.
                return UNIT_TYPE
    # Int-returning methods
    if method == "len" or method == "capacity" or method == "find_index":
        return I64_TYPE
    if method == "find":
        # Sentinel→Option: Rust's sentinel_to_option set is {find, index_of,
        # find_from, find_ext} (ir/lowering/mod.rs:3720) — these return
        # Option[int] (codepoint index, None if absent), wrapped at the LIR
        # layer by emit_sentinel_scalar_option_wrap. MUST record the enum
        # category, or the downstream `.unwrap()` arm (which classifies via
        # enum_category_of → ok_type) falls to the I64 fallback and the type
        # side disagrees with the LIR unwrap (silent miscompile + bootstrap
        # divergence). Mirrors the `.pop()`/`.get()` two-step idiom below.
        int find_opt_tid = lookup_or_register_named(&gmod, "Option__int64_t")
        record_enum_category(&gmod, find_opt_tid, ENUM_CAT_OPTION, I64_TYPE, -1)
        return find_opt_tid
    # Bool-returning methods
    # `Set/HashSet.is_subset(other)` / `.is_superset(other)` return bool
    # (runtime `gorget_set_is_subset` / `_is_superset`). Mirrors Rust
    # typecheck.rs:5665. Without this the result slot defaults to I64 and a
    # `print(f"{a.is_subset(b)}")` prints 1/0 instead of true/false.
    if method == "contains" or method == "is_empty" or method == "any" or method == "all" or method == "is_subset" or method == "is_superset" or method == "is_disjoint":
        return BOOL_TYPE
    if method == "starts_with" or method == "ends_with":
        return BOOL_TYPE
    if method == "is_some" or method == "is_none" or method == "is_ok" or method == "is_error":
        return BOOL_TYPE
    if method == "is_alpha" or method == "is_digit" or method == "is_alphanumeric" or method == "is_whitespace" or method == "is_upper" or method == "is_lower" or method == "is_ascii" or method == "is_hex_digit":
        return BOOL_TYPE
    # `slice` / `substr` are RECEIVER-AWARE: on a String they return Str
    # (BrkString via the table below); on an array-shaped receiver
    # (`GorgetArray` / `Vector__*` / `Deque__*`) they return the receiver's
    # OWN type — Rust has two separate slice decls (collection
    # `builtins.rs:294` ret_self vs string `:723` ret_owned_string), and the
    # self-host already picks `gorget_array_slice` (lir_lower.gg) for arrays;
    # only the result/slot TYPE was wrong. Mirrors the `remove`
    # receiver-aware arm above — classifies the receiver via the TYPED
    # `resource_meta_for`/`collection_kind` metadata, not a name prefix.
    if method == "slice" or method == "substr":
        int slice_recv_t = -1
        if recv >= 0 and recv < ctx.locals.len():
            slice_recv_t = ctx.locals.get(recv).unwrap().type_id
            if slice_recv_t >= 0 and slice_recv_t < gmod.type_table.len():
                GirType slice_gt0 = gmod.type_table.get(slice_recv_t).unwrap()
                match slice_gt0:
                    case GtPtr(slice_inner):
                        slice_recv_t = slice_inner
                    case GtMutPtr(slice_inner2):
                        slice_recv_t = slice_inner2
                    else:
                        pass
        if slice_recv_t >= 0 and slice_recv_t < gmod.type_table.len():
            GirType slice_gt = gmod.type_table.get(slice_recv_t).unwrap()
            match slice_gt:
                case GtNamed(slice_n):
                    # Phase A typed read (mirrors the `remove` arm above):
                    # `build_resource_metadata` classifies the receiver via
                    # `collection_kind`. Array-backed kinds (`CkVector` —
                    # GorgetArray/Vector__*; `CkDeque` — Deque__*) return the
                    # receiver's OWN type; String (`CkNotCollection`) and
                    # user types (None) fall through to the string table → Str.
                    match resource_meta_for(&gmod, slice_n):
                        case Some(slice_rmeta):
                            match slice_rmeta.collection_kind:
                                case CkVector():
                                    return slice_recv_t
                                case CkDeque():
                                    return slice_recv_t
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
    # `Set/HashSet.union(other)` / `.intersection(other)` / `.difference(other)`
    # are RECEIVER-AWARE: they return the receiver's OWN Set type (mirrors Rust
    # typecheck.rs:5670 — `Some(receiver_type)`). Classify the receiver via the
    # TYPED `resource_meta_for`/`collection_kind` metadata (CkOrderedSet /
    # CkHashSet), not a name prefix — the same idiom as the `slice`/`remove`
    # receiver-aware arms above. Without this the result slot defaults to I64
    # and the `Set[int] u = a.union(b)` assignment is `incompatible types`.
    if method == "union" or method == "intersection" or method == "difference" or method == "symmetric_difference":
        int setop_recv_t = -1
        if recv >= 0 and recv < ctx.locals.len():
            setop_recv_t = ctx.locals.get(recv).unwrap().type_id
            if setop_recv_t >= 0 and setop_recv_t < gmod.type_table.len():
                GirType setop_gt0 = gmod.type_table.get(setop_recv_t).unwrap()
                match setop_gt0:
                    case GtPtr(setop_inner):
                        setop_recv_t = setop_inner
                    case GtMutPtr(setop_inner2):
                        setop_recv_t = setop_inner2
                    else:
                        pass
        if setop_recv_t >= 0 and setop_recv_t < gmod.type_table.len():
            GirType setop_gt = gmod.type_table.get(setop_recv_t).unwrap()
            match setop_gt:
                case GtNamed(setop_n):
                    match resource_meta_for(&gmod, setop_n):
                        case Some(setop_rmeta):
                            match setop_rmeta.collection_kind:
                                case CkOrderedSet():
                                    return setop_recv_t
                                case CkHashSet():
                                    return setop_recv_t
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
    # StringBuilder void appends — RECEIVER-AWARE (String only). `s.push_line(x)`
    # / `s.push_char(c)` are void in-place appends (Rust ref: the String builtin
    # table's ret_void rows, src/ir/lowering/builtins.rs:735-750; runtime:
    # `void gorget_string_push_line*` / `gorget_string_push_char`,
    # runtime_string.c:421/472). They are absent from STRING_BUILTIN_METHODS'
    # BrkString set, so without this arm they fall through to the I64 default
    # and mint a bogus i64 dst → cc "void value not ignored". Gated on a String
    # receiver so a same-named user/collection method is unaffected (`push`/
    # `clear`/`capacity` are already classified receiver-independent above).
    if is_string_local(recv, ctx, &gmod):
        if method == "push_line" or method == "push_char":
            return UNIT_TYPE
    # String-returning methods — declared in STRING_BUILTIN_METHODS
    # (compiler/data/resources.gg) with `ret_kind == BrkString`. NOTE the
    # ordering contract: `reverse` is classified UNIT by the earlier arm
    # above (first-match wins) and is deliberately ABSENT from the table's
    # BrkString set, so consulting the table here cannot reclassify it.
    # The view column (`returns_view`) is INDEPENDENT — view-only methods
    # (str/as_str/trim_left/trim_right) carry BrkInfer and correctly fall
    # through to the receiver/I64 path, exactly as the old name list did.
    match string_builtin_method(method):
        case Some(sdecl):
            match sdecl.ret_kind:
                case BrkString():
                    return lookup_or_register_named(&gmod, "GorgetString")
                else:
                    pass
        case None:
            pass
    if method == "byte_at":
        return U8_TYPE
    # Collection-returning methods.
    #
    # `split`/`lines`/`chars` return `Vector[String]`; `bytes` returns
    # `Vector[u8]`. Mirror Rust's mod.rs `GorgetString__{split,lines,chars}`
    # → `Vector__GorgetString` (`vec_str_type`) and `GorgetString__bytes` →
    # `Vector__uint8_t` (`vec_u8_type`). Returning the ELEMENT-CARRYING
    # `Vector__<T>` (not the element-erased bare `GorgetArray`) is the SIBLING
    # of the `keys`/`values`/`items` fix below: the erased element type makes
    # the downstream `parts[i]` index-read take the INT path (emits
    # `(int64_t)0LL` + `%lld`, no `gorget_array_get`) → prints `0`. The
    # element-carrying type lets `collection_element_type` recover the element
    # so the index-read takes the correct String/u8 path.
    if method == "split" or method == "lines" or method == "chars":
        return lookup_or_register_named(&gmod, "Vector__GorgetString")
    if method == "bytes":
        return lookup_or_register_named(&gmod, "Vector__uint8_t")
    # `codepoints` returns `Vector[int]` (the Unicode scalar values). Runtime
    # `gorget_str_codepoints` (runtime_string_array.c:41) builds a `GorgetArray`
    # of `int64_t`. Unlike the sibling String collection-returners above, the
    # DEFAULT here is NOT a bare element-erased `GorgetArray` — it is the
    # `return I64_TYPE` fall-through at the bottom of this function. Without this
    # arm, `Vector[int] cps = s.codepoints()` types the result SLOT `int64_t`
    # while the runtime value is a `GorgetArray`, so C-emit rejects the bind with
    # `incompatible types when assigning to type 'int64_t' from type
    # 'GorgetArray'` — the mismatch fires at the ASSIGNMENT, before any index
    # read. Returning the element-carrying `Vector__int64_t` (int → int64_t)
    # types the slot as the GorgetArray it is. Mirrors Rust gg
    # (`typecheck.rs:6506` codepoints → `Vector[int]`); sibling of the
    # `split`/`lines`/`chars` → `Vector__GorgetString` and `bytes` →
    # `Vector__uint8_t` arms above.
    if method == "codepoints":
        return lookup_or_register_named(&gmod, "Vector__int64_t")
    # `sorted`/`reversed`/`unique`/`sorted_by`/`sorted_by_key`/`enumerate` are
    # ELEMENT-PRESERVING eager array methods — they return a NEW array with the
    # receiver's OWN element type. Mirror Rust gg (`builtins.rs` `return_type:
    # ret_self` for each, and `typecheck.rs:5665` `"sorted" | "sorted_by" |
    # "sorted_by_key" | "reversed" | "unique" | "slice" | "enumerate" =>
    # Some(receiver_type)`): return the RECEIVER's own element-CARRYING type id,
    # NOT the element-erased bare `GorgetArray`. SIBLING of the `slice`/`substr`
    # receiver-aware arm above and the `split`/`lines`/`chars` → `Vector__<T>`
    # arm: the erased bare `GorgetArray` drops the element type, so a chained
    # `.filter`/`.map` after `v.sorted()` fails the `CkVector` HOF-intercept gate
    # (`try_lower_vector_hof`, which needs `collection_element_type` to recover
    # the element) → the chained HOF lowers as a generic int-returning
    # `GorgetArray__filter`, and the C-emit errors `incompatible types when
    # assigning to type 'GorgetArray' from type 'int'`. Classify the receiver via
    # the TYPED `resource_meta_for`/`collection_kind` metadata (CkVector /
    # CkDeque), not a name prefix — array-backed receivers return their own type;
    # String / user-type receivers fall through to the bare GorgetArray.
    #
    # NOTE `take`/`skip` are deliberately ABSENT: they are iterator-adapter
    # methods (lib/std/iter.gg `TakeIter`/`SkipIter` on `*Iter` receivers), NOT
    # eager array methods, so they have no element-carrying array receiver to
    # preserve and are left on the bare-GorgetArray fall-through here.
    if method == "sorted" or method == "reversed" or method == "unique" or method == "sorted_by" or method == "sorted_by_key" or method == "enumerate":
        int sorted_recv_t = -1
        if recv >= 0 and recv < ctx.locals.len():
            sorted_recv_t = ctx.locals.get(recv).unwrap().type_id
            if sorted_recv_t >= 0 and sorted_recv_t < gmod.type_table.len():
                GirType sorted_gt0 = gmod.type_table.get(sorted_recv_t).unwrap()
                match sorted_gt0:
                    case GtPtr(sorted_inner):
                        sorted_recv_t = sorted_inner
                    case GtMutPtr(sorted_inner2):
                        sorted_recv_t = sorted_inner2
                    else:
                        pass
        if sorted_recv_t >= 0 and sorted_recv_t < gmod.type_table.len():
            GirType sorted_gt = gmod.type_table.get(sorted_recv_t).unwrap()
            match sorted_gt:
                case GtNamed(sorted_n):
                    match resource_meta_for(&gmod, sorted_n):
                        case Some(sorted_rmeta):
                            match sorted_rmeta.collection_kind:
                                case CkVector():
                                    return sorted_recv_t
                                case CkDeque():
                                    return sorted_recv_t
                                else:
                                    pass
                        case None:
                            pass
                else:
                    pass
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "take" or method == "skip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "items":
        # `Dict[K,V].items()` returns `Vector[(K, V)]`. The self-host
        # typechecker doesn't record this chain's expr-type (tc side-table
        # miss), so derive it here: split the receiver `Dict__K__V` into K/V,
        # register the `Tuple__K__V` struct (shared helper), and return a
        # `Vector__Tuple__K__V` so the downstream `.get(i).unwrap()` element
        # extraction (collection_element_type) yields the tuple — making
        # `item._N` resolve against `gmod.type_infos`. Falls back to the bare
        # GorgetArray when the receiver isn't a recognized Dict.
        String items_recv = ""
        if recv >= 0 and recv < ctx.locals.len():
            int items_rtid = ctx.locals.get(recv).unwrap().type_id
            if items_rtid >= 0 and items_rtid < gmod.type_table.len():
                match gmod.type_table.get(items_rtid).unwrap():
                    case GtPtr(items_inner):
                        items_recv = type_id_to_name(items_inner, &gmod)
                    case GtMutPtr(items_inner2):
                        items_recv = type_id_to_name(items_inner2, &gmod)
                    case GtNamed(items_n):
                        items_recv = items_n
                    else:
                        pass
        String items_kv = map_kv_payload(items_recv)
        if items_kv != "":
            # Split K__V at the top-level `__` boundary.
            int items_split = items_kv.index_of("__").unwrap_or(-1)
            if items_split > 0:
                String items_k = items_kv.slice(0, items_split)
                String items_v = items_kv.slice(items_split + 2, items_kv.len())
                Vector[int] items_elem_tids = []
                items_elem_tids.push(resolve_field_gir_type(items_k, &gmod))
                items_elem_tids.push(resolve_field_gir_type(items_v, &gmod))
                int items_tup_tid = register_tuple_type(items_elem_tids, &gmod)
                return lookup_or_register_named(&gmod, "Vector__" + type_id_to_name(items_tup_tid, &gmod))
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "keys" or method == "values":
        # `Dict[K,V].keys()` returns `Vector[K]`; `.values()` returns
        # `Vector[V]`. Mirror Rust's builtins.rs `keys`/`values` return_type
        # (`Vector__{elem_name}` / `Vector__{val_name}`, falling back to the
        # bare GorgetArray only when the receiver isn't a recognized Dict):
        # split the receiver `Dict__K__V` into K/V and return the
        # element-CARRYING `Vector__K` / `Vector__V` so the downstream
        # `for k in d.keys()` / `.get(i).unwrap()` element extraction
        # (collection_element_type) can resolve the element type — the bare
        # `GorgetArray` erased it, dropping the loop body via lower_fail.
        String kv_recv = ""
        if recv >= 0 and recv < ctx.locals.len():
            int kv_rtid = ctx.locals.get(recv).unwrap().type_id
            if kv_rtid >= 0 and kv_rtid < gmod.type_table.len():
                match gmod.type_table.get(kv_rtid).unwrap():
                    case GtPtr(kv_inner):
                        kv_recv = type_id_to_name(kv_inner, &gmod)
                    case GtMutPtr(kv_inner2):
                        kv_recv = type_id_to_name(kv_inner2, &gmod)
                    case GtNamed(kv_n):
                        kv_recv = kv_n
                    else:
                        pass
        String kv_str = map_kv_payload(kv_recv)
        if kv_str != "":
            int kv_split = kv_str.index_of("__").unwrap_or(-1)
            if kv_split > 0:
                if method == "keys":
                    String kv_k = kv_str.slice(0, kv_split)
                    return lookup_or_register_named(&gmod, "Vector__" + kv_k)
                else:
                    String kv_v = kv_str.slice(kv_split + 2, kv_str.len())
                    return lookup_or_register_named(&gmod, "Vector__" + kv_v)
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "chunks" or method == "zip":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # Closure Phase-2 Inc-4a (R1): receiver-aware combinator return type.
    # On an Option/Result receiver, `map`/`filter`/`and_then`/`or_else`/`or`/
    # `map_err`/`flat_map` yield the receiver's OWN Option/Result type — NOT
    # the bare `GorgetArray` the Vector-HOF arms below mint. The bare
    # GorgetArray collapses the 16-byte `Option__T`/`Result__T__E` result to an
    # 8-byte pointer slot, so the `emit_option_result_combinator` template
    # (lir_codegen) writes the tag + payload past the end of the destination →
    # the downstream `.unwrap()`/`.is_none()` reads garbage (option_map crash;
    # map_err truncation). Mirror Rust's typecheck.rs combinator arms
    # (`("Option","map") => Option[U]`, `("Result","map_err") => Result[T,F]`,
    # etc.): filter/or_else/or preserve the receiver type exactly.
    # CROSS-TYPE map/map_err/and_then/flat_map: this helper has no closure arg,
    # so it cannot mint Option[U]. Round XV SH-3 lands the closure-return
    # rewrite at the Inc-4e-1 sibling in `lower_expr.gg` (method-call return
    # path) — `infer_method_return_type` alone is NOT sufficient for those.
    # Returning the receiver here is the last-resort floor (correct when
    # U==T / same-type and_then). GUARDED on `enum_category_of` so Vector/Dict
    # receivers fall through UNCHANGED to the GorgetArray HOF arms below.
    if method == "map" or method == "filter" or method == "and_then" or method == "or_else" or method == "or" or method == "map_err" or method == "flat_map":
        if recv >= 0 and recv < ctx.locals.len():
            int comb_recv_tid = ctx.locals.get(recv).unwrap().type_id
            EnumCategory comb_ec = enum_category_of(&gmod, comb_recv_tid)
            if comb_ec.category == ENUM_CAT_OPTION or comb_ec.category == ENUM_CAT_RESULT:
                return peel_ptr_tid(&gmod, comb_recv_tid)
    # `Option[Option[T]].flatten()` → `Option[T]` (the INNER Option = the
    # receiver's payload type, recorded as `ok_type` on the enum-category
    # channel). NOT the receiver type itself (that would keep the outer
    # `Option[Option[T]]`), and NOT the bare GorgetArray (8-byte slot truncates
    # the 16-byte inner Option → flatten().unwrap() reads garbage). Guarded on
    # Option category so Vector.flatten() falls through to the GorgetArray arm.
    if method == "flatten":
        if recv >= 0 and recv < ctx.locals.len():
            int flat_recv_tid = ctx.locals.get(recv).unwrap().type_id
            EnumCategory flat_ec = enum_category_of(&gmod, flat_recv_tid)
            if flat_ec.category == ENUM_CAT_OPTION and flat_ec.ok_type >= 0:
                return flat_ec.ok_type
    if method == "filter_by" or method == "filter":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # HOFs that return collections (preserve receiver type heuristically).
    if method == "map" or method == "flat_map" or method == "flatten":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if method == "concat":
        return lookup_or_register_named(&gmod, "GorgetArray")
    # Float-returning methods
    if method == "sum" or method == "avg" or method == "min" or method == "max":
        return I64_TYPE  # could be float, but I64 is safe default
    if method == "abs" or method == "sqrt" or method == "ceil" or method == "floor":
        return F64_TYPE
    if method == "round":
        return F64_TYPE
    # Hash/count — stay raw I64 (NOT in Rust's sentinel_to_option set).
    if method == "hash" or method == "count":
        return I64_TYPE
    # index_of: sentinel→Option (Rust's set is {find, index_of, find_from,
    # find_ext}; ir/lowering/mod.rs:3720). Receiver-blind: String AND Vector
    # index_of both type as Option[int] (correct — Rust's set covers
    # collections), wrapped at the LIR layer (emit_sentinel_scalar_option_wrap,
    # keyed on the mapped gorget_str_index_of / gorget_array_index_of symbols).
    # MUST record the enum category for the downstream `.unwrap()` arm — see the
    # `find` arm comment above.
    if method == "index_of":
        int idx_opt_tid = lookup_or_register_named(&gmod, "Option__int64_t")
        record_enum_category(&gmod, idx_opt_tid, ENUM_CAT_OPTION, I64_TYPE, -1)
        return idx_opt_tid
    # unwrap on Option__V receiver: return inner V.
    if method == "unwrap":
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            # option_ref_borrow Phase 3 (typed path): if the receiver Option is
            # a borrowing-getter result `Option[Ref[V]]`, unwrap yields the
            # typed `GtPtr(V)` payload recorded on the channel — `auto x =
            # coll.get(i).unwrap()` infers a pointer, not the name-derived V.
            int unwrap_ref_payload = option_ref_payload_of(&gmod, recv_tid)
            if unwrap_ref_payload >= 0:
                # option_ref_borrow Phase 6 (R1, refinement — site #2): gate on
                # the POINTEE so type-inference consumers (`auto x =
                # …unwrap()` via fallback) agree with the SSA that site #1
                # produces. Resource pointee → keep the `GtPtr` borrow;
                # primitive pointee → the deref'd VALUE pointee type. (The
                # plain-unwrap LOWERING doesn't read this — it returns the
                # local directly — so this is refinement, not the load-bearing
                # fix; keep it consistent anyway.)
                if unwrap_ref_payload >= 0 and unwrap_ref_payload < gmod.type_table.len():
                    GirType urp_gt = gmod.type_table.get(unwrap_ref_payload).unwrap()
                    match urp_gt:
                        case GtPtr(urp_inner):
                            if is_resource_type_name(type_id_to_name(urp_inner, &gmod), &gmod):
                                return unwrap_ref_payload
                            else:
                                return urp_inner
                        else:
                            pass
                return unwrap_ref_payload
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
            # Typed enum-category channel (value-payload Option/Result):
            # `.unwrap()` yields the Some_0 / Ok_0 payload recorded at the
            # mint site — no mangled-name re-parse. (`Option__Ref__` results
            # already returned above via `option_ref_payload`.) This is the
            # SOLE classifier for the unwrap payload type now: the former
            # `recv_name`-prefix Option/Result name
            # fallback (which re-derived the payload by slicing the mangled
            # name) was probe-DEAD — 0 fires over the full driver self-emit +
            # the Option/Result corpus, because the channel covers every
            # mono'd Option/Result that reaches here (and most `.unwrap()`
            # sites resolve their return type via the typechecker side-table
            # before `infer_method_return_type` is consulted at all). Retired
            # per CLAUDE.md "No name matching" (Layering rule 2).
            EnumCategory uec = enum_category_of(&gmod, recv_tid)
            if uec.category == ENUM_CAT_OPTION or uec.category == ENUM_CAT_RESULT:
                return uec.ok_type
        # Fallback: pass through receiver type for non-Option/Result
        # receivers — keeps legacy behaviour for already-typed values.
        if recv_name != "":
            if recv >= 0 and recv < ctx.locals.len():
                return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # unwrap_or_else on an Option/Result receiver: returns the UNWRAPPED Some_0 /
    # Ok_0 payload type (the closure on the empty path also yields that type), the
    # SAME `ok_type` `.unwrap()` returns — read off the typed enum-category
    # channel. Inc-4c (R2 completion): this arm was MISSING, so the result
    # defaulted to I64_TYPE — a `String`-payload `unwrap_or_else` was typed
    # `int64_t`, so `emit_option_result_combinator` declared the dst slot + the
    # closure-call return as `int64_t` and TRUNCATED the 16-byte `Str` return to
    # 8 bytes (empty Str on the fn() path). Mirrors the `unwrap` arm above and
    # Rust `typecheck.rs` (`unwrap_or_else` → the Ok/Some payload type).
    if method == "unwrap_or_else":
        if recv >= 0 and recv < ctx.locals.len():
            int uoe_recv_tid = ctx.locals.get(recv).unwrap().type_id
            if uoe_recv_tid >= 0 and uoe_recv_tid < gmod.type_table.len():
                GirType uoe_gt0 = gmod.type_table.get(uoe_recv_tid).unwrap()
                match uoe_gt0:
                    case GtPtr(uoe_inner):
                        uoe_recv_tid = uoe_inner
                    case GtMutPtr(uoe_inner2):
                        uoe_recv_tid = uoe_inner2
                    else:
                        pass
            EnumCategory uoe_ec = enum_category_of(&gmod, uoe_recv_tid)
            if uoe_ec.category == ENUM_CAT_OPTION or uoe_ec.category == ENUM_CAT_RESULT:
                return uoe_ec.ok_type
        return I64_TYPE
    # unwrap_error / unwrap_err on a Result__Ok__Err receiver: return the Err
    # payload type. Reads the SAME typed enum-category channel `.unwrap()` uses
    # (mint-site `err_type` recorded by `record_enum_category`), so a String-Err
    # Result yields `GorgetString`, not the I64 default — the default left
    # `r.unwrap_error()` typed int64_t (printed `%lld`/garbage) and the codegen
    # reading the Ok_0 slot. Mirrors Rust `typecheck.rs:5714` (val_type).
    if method == "unwrap_error" or method == "unwrap_err":
        if recv >= 0 and recv < ctx.locals.len():
            int uerr_tid = ctx.locals.get(recv).unwrap().type_id
            if uerr_tid >= 0 and uerr_tid < gmod.type_table.len():
                GirType uerr_gt0 = gmod.type_table.get(uerr_tid).unwrap()
                match uerr_gt0:
                    case GtPtr(uerr_inner):
                        uerr_tid = uerr_inner
                    case GtMutPtr(uerr_inner2):
                        uerr_tid = uerr_inner2
                    else:
                        pass
            EnumCategory uerr_ec = enum_category_of(&gmod, uerr_tid)
            if uerr_ec.category == ENUM_CAT_RESULT:
                return uerr_ec.err_type
        return I64_TYPE
    # get/pop/last/first/remove/safe_get on a collection: return Option[V].
    # option_ref_borrow Phase 3 (R1 — SPLIT, don't flip): the borrowing
    # getters (get/first/last/safe_get) return Option[Ref[V]] — a borrow into
    # the collection; the consuming getters (pop/remove) transfer ownership
    # OUT and keep the owned Option[V] (a wholesale flip would alias→double-
    # free them). This is the heuristic FALLBACK for getters the typechecker
    # didn't type as RTRef (first/last/safe_get have no infer arm); the
    # typed-path (.get()) already produced Option__Ref__T upstream so it never
    # reaches here. Kept for parity/robustness.
    if method == "get" or method == "first" or method == "last" or method == "safe_get" or method == "pop" or method == "remove" or method == "swap_remove":
        # D39 Phase A.3: `swap_remove` joins the consuming-getter set for
        # Dict/HashMap (Option[V !] return, same TLS-buffer void* runtime
        # path). Vector/Deque and Set/HashSet are short-circuited above
        # (void / bool respectively) — only Dict/HashMap reach this arm.
        bool borrowing_getter = method == "get" or method == "first" or method == "last" or method == "safe_get"
        String recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int recv_tid = ctx.locals.get(recv).unwrap().type_id
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt0 = gmod.type_table.get(recv_tid).unwrap()
                match gt0:
                    case GtPtr(inner):
                        recv_tid = inner
                    case GtMutPtr(inner):
                        recv_tid = inner
                    else:
                        pass
            if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                GirType gt = gmod.type_table.get(recv_tid).unwrap()
                match gt:
                    case GtNamed(name):
                        recv_name = name
                    else:
                        pass
        # Guard `.get()` returns the guarded VALUE directly (the runtime
        # `gorget_guard_get` yields `*(T*)g->ptr`), NOT an Option — unlike a
        # collection getter. `Guard[bool].get()` must type as `bool` (else it
        # prints `1`, not `true`, and the deref reads 8 bytes off a 1-byte
        # bool). The elem is the suffix after the Guard family prefix. Mirrors
        # Rust's `gorget_guard_get` inline yielding the concrete inner type.
        String guard_elem = ""
        if recv_name.starts_with("WriteGuard__"):
            guard_elem = recv_name.slice(12, recv_name.len())
        elif recv_name.starts_with("ReadGuard__"):
            guard_elem = recv_name.slice(11, recv_name.len())
        elif recv_name.starts_with("Guard__"):
            guard_elem = recv_name.slice(7, recv_name.len())
        if guard_elem != "":
            return resolve_field_gir_type(guard_elem, &gmod)
        # Shared `.get()` returns the shared VALUE directly (the wrapper
        # `Shared__<T>__get` reads `*(elem*)gorget_shared_get_ptr(self)`),
        # NOT an Option — exactly like the Guard arm above, and mirroring
        # Rust gg's `"get"` arm (methods.rs:1069-1074, `elem_type` not
        # Option). Without this, `cfg.get()` falls to the collection-getter
        # path: `collection_element_type` misses on a `Shared__` receiver →
        # `I64_TYPE`, so `Shared[Config].get()`'s slot is `int64_t` while the
        # synthesized `Shared__Config__get` returns `__gg_Config` → cc errors
        # `int64_t = __gg_Config`, and `.max_connections` then resolves on
        # `int64_t` (`[bug] unknown field`). The DECISION is keyed on the
        # TYPED `method_prefix == "gorget_shared"` metadata (Core #2 / layering
        # rule 2), NOT a `Shared__` name match. `build_resource_metadata` maps
        # ONLY the `Shared__` prefix to `gorget_shared`, so the typed gate alone
        # guarantees the receiver name is `Shared__<T>` — the inner-element STRIP
        # (8 chars, `Shared__Config`→`Config`) is then mechanical, mirroring the
        # wrapper registrar in lir_lower.gg (line ~722, gated on the same resolved
        # `opm == "gorget_shared"`). `Shared[int].get()` previously worked only by
        # the I64 default coinciding with `int64_t`; this arm makes it explicit
        # (still `I64_TYPE`, no regression).
        if method == "get":
            match resource_meta_for(&gmod, recv_name):
                case Some(shared_rmeta):
                    match shared_rmeta.method_prefix:
                        case Some(shared_pfx):
                            if shared_pfx == "gorget_shared":
                                String shared_elem = recv_name.slice(8, recv_name.len())
                                return resolve_field_gir_type(shared_elem, &gmod)
                        case None:
                            pass
                case None:
                    pass
        String elem = collection_element_type(recv_name)
        if elem == "":
            if recv_name.starts_with("Dict__GorgetString__"):
                elem = recv_name.slice(20, recv_name.len())
            elif recv_name.starts_with("Dict__int64_t__"):
                elem = recv_name.slice(15, recv_name.len())
            elif recv_name.starts_with("HashMap__GorgetString__"):
                elem = recv_name.slice(23, recv_name.len())
            elif recv_name.starts_with("HashMap__int64_t__"):
                elem = recv_name.slice(18, recv_name.len())
        if elem == "":
            return I64_TYPE
        String elem_norm = elem
        if elem == "Str":
            elem_norm = "GorgetString"
        if borrowing_getter:
            # Borrowing getter (heuristic fallback): result is Option[Ref[V]].
            # Mint the typed GtPtr(V) payload and record it on the
            # option_ref_payload channel so unwrap/match-destructure mint a
            # real pointer (same as the typed .get() path) — no Ref__ parsing
            # downstream.
            String ref_opt_name = "Option__Ref__" + elem_norm
            int ref_opt_tid = lookup_or_register_named(&gmod, ref_opt_name)
            int elem_gir = resolve_field_gir_type(elem_norm, &gmod)
            int ref_ptr_tid = register_ptr(&gmod, elem_gir)
            record_option_ref_payload(&gmod, ref_opt_tid, ref_ptr_tid)
            record_enum_category(&gmod, ref_opt_tid, ENUM_CAT_OPTION, ref_ptr_tid, -1)
            return ref_opt_tid
        String opt_name = "Option__" + elem_norm
        int opt_pop_tid = lookup_or_register_named(&gmod, opt_name)
        record_enum_category(&gmod, opt_pop_tid, ENUM_CAT_OPTION, resolve_field_gir_type(elem_norm, &gmod), -1)
        return opt_pop_tid
    # `Dict[K,V].get_or(k, default)` → V (the OWNED value type). Unlike the
    # borrowing `.get()` above (which returns Option[Ref[V]]), get_or yields a
    # bare owned V — the inline `Dict__K__V__get_or` wrapper clones String
    # values / copies scalars. Without this arm the call falls through to the
    # I64 default, so a String-valued get_or assigns a `Str` into an `int64_t`
    # slot (cc type error). Mirrors the `.get()` Dict V-suffix extraction.
    if method == "get_or" or method == "get_or_put":
        String gor_recv_name = ""
        if recv >= 0 and recv < ctx.locals.len():
            int gor_recv_tid = ctx.locals.get(recv).unwrap().type_id
            if gor_recv_tid >= 0 and gor_recv_tid < gmod.type_table.len():
                GirType gor_gt0 = gmod.type_table.get(gor_recv_tid).unwrap()
                match gor_gt0:
                    case GtPtr(gor_inner):
                        gor_recv_tid = gor_inner
                    case GtMutPtr(gor_inner2):
                        gor_recv_tid = gor_inner2
                    else:
                        pass
            if gor_recv_tid >= 0 and gor_recv_tid < gmod.type_table.len():
                GirType gor_gt = gmod.type_table.get(gor_recv_tid).unwrap()
                match gor_gt:
                    case GtNamed(gor_name):
                        gor_recv_name = gor_name
                    else:
                        pass
        String gor_elem = ""
        if gor_recv_name.starts_with("Dict__GorgetString__"):
            gor_elem = gor_recv_name.slice(20, gor_recv_name.len())
        elif gor_recv_name.starts_with("Dict__int64_t__"):
            gor_elem = gor_recv_name.slice(15, gor_recv_name.len())
        elif gor_recv_name.starts_with("HashMap__GorgetString__"):
            gor_elem = gor_recv_name.slice(23, gor_recv_name.len())
        elif gor_recv_name.starts_with("HashMap__int64_t__"):
            gor_elem = gor_recv_name.slice(18, gor_recv_name.len())
        if gor_elem != "":
            String gor_elem_norm = gor_elem
            if gor_elem == "Str":
                gor_elem_norm = "GorgetString"
            return resolve_field_gir_type(gor_elem_norm, &gmod)
        return I64_TYPE
    # clone: return receiver type
    if method == "clone":
        if recv >= 0 and recv < ctx.locals.len():
            return ctx.locals.get(recv).unwrap().type_id
        return I64_TYPE
    # `Shared[T].downgrade()` -> `Weak[T]`; `Weak[T].upgrade()` -> `Option[Shared[T]]`.
    # Mirrors Rust gg's SHARED.downgrade (-> `Weak__{elem}`) and WEAK.upgrade
    # (-> `Option__Shared__{elem}`) return_type closures (src/ir/lowering/builtins.rs
    # :549 / :576). Gated on the TYPED method_prefix (`gorget_shared` / `gorget_weak`
    # via resource_meta_for, Core #2 / layering rule 2), NOT a `Shared__`/`Weak__`
    # name-match. Without these arms both fall through to the I64 default below:
    # downgrade's `GorgetShared*` result lands in an int64_t slot (so `w` becomes
    # `&slot`), and upgrade's raw `int` result is assigned into the
    # `Option__Shared__<T>` STRUCT slot (cc: incompatible types). The upgrade arm
    # additionally records the enum category so the downstream `match ...: case
    # Some(x):` destructures the `Shared[T]` payload (mirrors the `.get()`/`find`
    # option-minting arms above). The nullable-ptr -> Option LIFT and the typed
    # `Weak__T__upgrade` wrapper live in lir_lower.gg / lir_codegen.gg.
    if method == "downgrade" or method == "upgrade":
        String sw_recv = ""
        if recv >= 0 and recv < ctx.locals.len():
            int sw_tid = ctx.locals.get(recv).unwrap().type_id
            if sw_tid >= 0 and sw_tid < gmod.type_table.len():
                GirType sw_gt0 = gmod.type_table.get(sw_tid).unwrap()
                match sw_gt0:
                    case GtPtr(sw_in):
                        sw_tid = sw_in
                    case GtMutPtr(sw_in2):
                        sw_tid = sw_in2
                    else:
                        pass
            if sw_tid >= 0 and sw_tid < gmod.type_table.len():
                GirType sw_gt = gmod.type_table.get(sw_tid).unwrap()
                match sw_gt:
                    case GtNamed(sw_n):
                        sw_recv = sw_n
                    else:
                        pass
        match resource_meta_for(&gmod, sw_recv):
            case Some(sw_meta):
                match sw_meta.method_prefix:
                    case Some(sw_pfx):
                        if method == "downgrade" and sw_pfx == "gorget_shared":
                            String dg_elem = sw_recv.slice(8, sw_recv.len())
                            return lookup_or_register_named(&gmod, "Weak__" + dg_elem)
                        if method == "upgrade" and sw_pfx == "gorget_weak":
                            String ug_elem = sw_recv.slice(6, sw_recv.len())
                            int ug_opt = lookup_or_register_named(&gmod, "Option__Shared__" + ug_elem)
                            int ug_payload = resolve_field_gir_type("Shared__" + ug_elem, &gmod)
                            record_enum_category(&gmod, ug_opt, ENUM_CAT_OPTION, ug_payload, -1)
                            return ug_opt
                    case None:
                        pass
            case None:
                pass
    # `Mutex[T].lock()` → `Guard[T]`; `RWLock[T].read()` → `ReadGuard[T]`;
    # `RWLock[T].write()` → `WriteGuard[T]`. Mirrors Rust builtins.rs:672–728
    # (MUTEX.lock / RWLOCK.read|write return_type closures). Gated on the
    # TYPED method_prefix (`gorget_mutex` / `gorget_rwlock` via
    # resource_meta_for, Core #2) — NOT a Guard-style name-prefix strip to
    # the element type (that path is for Guard.get → T). Without these arms
    # the call falls to I64, so the GIR slot is `int64_t` while the runtime
    # returns `gorget_guard_t` / `gorget_read_guard_t` / `gorget_write_guard_t`
    # (cc: incompatible types; fixtures guard_boxed_trait_dispatch,
    # rwlock_chained_read_get, rwlock_chained_write_set). Monomorph method
    # names (`Mutex__T__lock`) are not map_mono_to_runtime'd, so GIR typing
    # is load-bearing; CallExtern→SlotStore then picks the aggregate slot
    # via apply_callextern_slotstore_override. Strip lengths: Mutex__ = 7,
    # RWLock__ = 8 (mechanical after the typed gate).
    if method == "lock" or method == "read" or method == "write":
        String lk_recv = ""
        if recv >= 0 and recv < ctx.locals.len():
            int lk_tid = ctx.locals.get(recv).unwrap().type_id
            if lk_tid >= 0 and lk_tid < gmod.type_table.len():
                GirType lk_gt0 = gmod.type_table.get(lk_tid).unwrap()
                match lk_gt0:
                    case GtPtr(lk_in):
                        lk_tid = lk_in
                    case GtMutPtr(lk_in2):
                        lk_tid = lk_in2
                    else:
                        pass
            if lk_tid >= 0 and lk_tid < gmod.type_table.len():
                GirType lk_gt = gmod.type_table.get(lk_tid).unwrap()
                match lk_gt:
                    case GtNamed(lk_n):
                        lk_recv = lk_n
                    else:
                        pass
        match resource_meta_for(&gmod, lk_recv):
            case Some(lk_meta):
                match lk_meta.method_prefix:
                    case Some(lk_pfx):
                        if method == "lock" and lk_pfx == "gorget_mutex":
                            String lk_elem = lk_recv.slice(7, lk_recv.len())
                            return lookup_or_register_named(&gmod, "Guard__" + lk_elem)
                        if method == "read" and lk_pfx == "gorget_rwlock":
                            String rd_elem = lk_recv.slice(8, lk_recv.len())
                            return lookup_or_register_named(&gmod, "ReadGuard__" + rd_elem)
                        if method == "write" and lk_pfx == "gorget_rwlock":
                            String wr_elem = lk_recv.slice(8, lk_recv.len())
                            return lookup_or_register_named(&gmod, "WriteGuard__" + wr_elem)
                    case None:
                        pass
            case None:
                pass
    # Default to I64 for unknown methods
    return I64_TYPE

# Return type inference for builtin free-standing calls (args, read_file, etc.)
# Returns -1 if not a builtin.
int builtin_call_return_type(String fname, GirModule &gmod):
    if fname == "args":
        return lookup_or_register_named(&gmod, "GorgetArray")
    if fname == "read_file" or fname == "read_line" or fname == "stdin" or fname == "env" or fname == "getenv":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "int_to_str" or fname == "float_to_str" or fname == "bool_to_str":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "chr":
        return lookup_or_register_named(&gmod, "GorgetString")
    if fname == "parse_int" or fname == "str_to_int":
        return I64_TYPE
    if fname == "parse_float" or fname == "str_to_float":
        return F64_TYPE
    if fname == "time_now" or fname == "monotonic_ns":
        return I64_TYPE
    if fname == "sqrt" or fname == "pow" or fname == "floor" or fname == "ceil" or fname == "round":
        return F64_TYPE
    if fname == "sin" or fname == "cos" or fname == "tan" or fname == "asin" or fname == "acos" or fname == "atan" or fname == "atan2":
        return F64_TYPE
    if fname == "log" or fname == "log2" or fname == "log10":
        return F64_TYPE
    if fname == "int_to_float":
        return F64_TYPE
    if fname == "float_to_int" or fname == "float_to_bits":
        return I64_TYPE
    return -1

# Extract element type from a collection name: Vector__int64_t → int64_t
String collection_element_type(String name):
    if name.starts_with("Vector__"):
        return name.slice(8, name.len())
    if name.starts_with("Deque__"):
        return name.slice(7, name.len())
    if name.starts_with("Set__"):
        return name.slice(5, name.len())
    if name.starts_with("HashSet__"):
        return name.slice(9, name.len())
    # For Option__T, extract T
    if name.starts_with("Option__"):
        return name.slice(8, name.len())
    # For Result__T, extract T (ok type)
    if name.starts_with("Result__"):
        return name.slice(8, name.len())
    return ""

# Element/value type NAME for an index target `base[idx]`: Vector/Deque/Set
# element via `collection_element_type`, Dict/HashMap VALUE-type via the
# mangled-name value suffix (`Dict__<key>__<value>` → `<value>`). Returns ""
# if unresolved. SINGLE SOURCE OF TRUTH for the Dict/HashMap value-suffix
# recovery — shared by the EIndex read arm (lower_expr) and the compound
# index-assign (lower_stmt) so the `starts_with` value-suffix split lives in
# exactly ONE place (was duplicated). At GIR-lowering time the LIR
# `coll_elem_type_map` typed channel isn't populated yet, so the suffix split
# is the available mechanism here (same as `infer_method_return_type`).
String index_value_type_name(String base_name):
    String elem = collection_element_type(base_name)
    if elem == "":
        if base_name.starts_with("Dict__GorgetString__"):
            elem = base_name.slice(20, base_name.len())
        elif base_name.starts_with("Dict__int64_t__"):
            elem = base_name.slice(15, base_name.len())
        elif base_name.starts_with("HashMap__GorgetString__"):
            elem = base_name.slice(23, base_name.len())
        elif base_name.starts_with("HashMap__int64_t__"):
            elem = base_name.slice(18, base_name.len())
    return elem

# ── Centralized collection-accumulator typing (Layering rules 3+4) ──────
# THE single source of truth for typing a freshly-built collection LOCAL
# (the dst of an array/dict/set LITERAL or a list/set/dict COMPREHENSION /
# HOF accumulator). It maps the recovered element / key / value type NAMES
# to the ELEMENT-CARRYING mangled type id (`Vector__<T>` / `Dict__K__V` /
# `HashMap__K__V` / `Set__<T>`), falling back to the bare runtime struct
# (`GorgetArray` / `GorgetMap` / `GorgetSet`) only when the element type is
# unknown.
#
# WHY this is centralized (CLAUDE.md invariant #4 "one fix, all siblings"
# + devbook/24 rule 3 "one source of truth per axis"): the runtime layout
# is identical for the mangled and bare names (resource_meta_for maps both
# to the same GorgetArray/Map/Set category in lir_lower.gg), so the alloc /
# push / put / get / len calls and the C-emit are BYTE-UNCHANGED — only the
# GIR type NAME gains element info. That extra info is load-bearing
# downstream: a `v[i]` value-read, a `for x in v` iteration, and a chained
# HOF all re-resolve the element type from the local's NAME (via
# `collection_element_type` / `index_value_type_name`). A bare
# `GorgetArray`/`GorgetMap` decays that name → the reader recovers `""` and
# stubs the result. Routing EVERY producer through this one helper means a
# new producer site cannot reintroduce the element-type loss (the
# `no_bare_collection_accumulator_outside_helper` lint in tests/lints.rs
# forces the next one through here).
#
# `kind`: "array" → Vector__<elem>; "set" → Set__<elem>;
#         "map_ordered" → Dict__<key>__<val>; "map_unordered" → HashMap__<key>__<val>.
# An empty element / key / value name (couldn't recover the type) yields
# the bare fallback for that `kind` — never a half-mangled name.
int collection_accumulator_tid(GirModule &gmod, String kind, String elem_name, String key_name, String val_name):
    if kind == "array":
        if elem_name != "":
            return lookup_or_register_named(&gmod, "Vector__" + elem_name)
        return lookup_or_register_named(&gmod, "GorgetArray")
    if kind == "set":
        if elem_name != "":
            return lookup_or_register_named(&gmod, "Set__" + elem_name)
        return lookup_or_register_named(&gmod, "GorgetSet")
    if kind == "map_ordered":
        if key_name != "" and val_name != "":
            return lookup_or_register_named(&gmod, "Dict__" + key_name + "__" + val_name)
        return lookup_or_register_named(&gmod, "GorgetMap")
    if kind == "map_unordered":
        if key_name != "" and val_name != "":
            return lookup_or_register_named(&gmod, "HashMap__" + key_name + "__" + val_name)
        return lookup_or_register_named(&gmod, "GorgetMap")
    # Unknown kind — defensive bare-array fallback (never reached for the
    # four producer kinds above).
    return lookup_or_register_named(&gmod, "GorgetArray")

# ── The set accumulator's CTOR-NAME channel (the twin of the tid above) ──
# THE single producer of a set constructor's magic name. One decision has
# two channels — the accumulator TYPE (`collection_accumulator_tid` above,
# which carries the element story to every downstream reader) and the ctor
# NAME (here, which `lir_codegen.gg::emit_typed_set_ctor` expands into BOTH
# the key WIDTH and the `hash_fn`/`eq_fn`/`key_drop`/`key_clone` bridge).
# A producer that supplies only one of the two closes half the class, so
# they live side by side.
#
# The shape this retires: `GICallExtern(acc, "gorget_(ordered_)set_new",
# [OpConstI64(8)])` — a raw runtime symbol with a HARDCODED 8-byte key. That
# spelling is accidentally right for `int64_t`, too WIDE for `bool`, too
# NARROW for any aggregate whose discriminating field sits past byte 8, and
# it never reaches `*_new_str` for a `String` element or installs a
# `@derive(Hashable)` key table. Rust gg mints the same result via
# `gorget_set_new_like` (copying the receiver's hash/eq/order config); this
# magic name is the self-host's equivalent, and `ordered` is one of its two
# inputs, not the whole naming rule.
#
# Callers: the set LITERAL, the set COMPREHENSION's deferred mint
# (`comp_mint_ctor`), and the Set-HOF `filter` intercept
# (`try_lower_set_hof`) — all in `lower_expr.gg`.
String set_ctor_name(String elem_name, bool ordered):
    if ordered:
        return "__gorget_ordered_set_new_sized_" + elem_name
    return "__gorget_set_new_sized_" + elem_name

# Return true when the init expression is a call to a known
# `cstr`-returning runtime/extern function. Used at SVarDecl to
# insert a `gorget_str_from_cstr` coercion before storing into a
# Str-typed slot, matching the Rust backend's
# `extern_cstr_return_vals` handling. Conservative allow-list
# covering the std.conv / std.fs / env extern surface —
# adding a new cstr-returning extern here is the same shape of
# change as the Rust-side `fn_return_abis` registration.
bool is_cstr_returning_call(SpannedExpr init_expr, GirModule gmod):
    match init_expr.expr:
        case ECall(callee_box, _, _):
            match (*callee_box).expr:
                case EIdentifier(fname):
                    # Resolve through call_redirects so both the Gorget
                    # source name (`_parse_last_error`) and the C symbol
                    # (`gorget_parse_last_error`) match.
                    String resolved = fname
                    if gmod.call_redirects.contains(fname):
                        resolved = gmod.call_redirects.get(fname).unwrap()
                    # Delegate the terminal name-set test to the single source
                    # of truth (`runtime_fn_returns_cstr`, lir.gg) — do NOT
                    # re-inline a name list here. The LOWERING coercion fires
                    # only when the raw result stays cstr; the companion guard
                    # at lower_stmt.gg (var_type != gs_tid_decl) prevents the
                    # double-wrap of fns the EMIT side already types as
                    # GorgetString (e.g. getenv). New cstr-returning runtime
                    # fns go in lir.gg ONLY (enforced by tests/lints.rs).
                    return runtime_fn_returns_cstr(resolved)
                else:
                    return false
        else:
            return false
    return false

# Check if a GIR local holds a string type.
bool is_string_local(int local_id, LowerCtx ctx, GirModule &gmod):
    if local_id < 0 or local_id >= ctx.locals.len():
        return false
    int tid = ctx.locals.get(local_id).unwrap().type_id
    return is_string_type_id(tid, &gmod)

bool is_string_type_id(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtNamed(name):
            return name == "GorgetString" or name == "String" or name == "Str"
        case GtPtr(inner):
            return is_string_type_id(inner, &gmod)
        case GtMutPtr(inner):
            return is_string_type_id(inner, &gmod)
        else:
            return false
    return false

# True only for a POINTER to a string (`GtPtr`/`GtMutPtr` whose inner is a
# string) — a BORROWED String, as `EFieldAccess` produces for a resource
# String field (lower.gg:~5520-5524). A value String (bare `GorgetString`,
# even under a `"String"`/`"Str"` alias id) returns false, so the
# print/f-string deref-before-format step never mis-derefs a value as a ptr.
bool is_ptr_to_string_type_id(int tid, GirModule &gmod):
    if tid < 0 or tid >= gmod.type_table.len():
        return false
    GirType gt = gmod.type_table.get(tid).unwrap()
    match gt:
        case GtPtr(inner):
            return is_string_type_id(inner, &gmod)
        case GtMutPtr(inner):
            return is_string_type_id(inner, &gmod)
        else:
            return false
    return false

bool is_resource_field_type(SpannedType stype, Dict[String, bool] resource_types):
    match stype.ty:
        case TPrimitive(name):
            match name:
                case "String":
                    return true
                else:
                    return false
        case TNamed(name, targs):
            match name:
                case "Vector" | "Dict" | "Set" | "Box" | "Rc" | "Arc":
                    return true
                case "Option" | "Result":
                    # Resource if any type argument is a resource
                    for ota in targs:
                        if is_resource_field_type(ota, resource_types):
                            return true
                    return false
                else:
                    if resource_types.contains(name):
                        return true
                    return false
        else:
            return false

# Register the mangled names of mono'd Option__X / Result__X__E instances
# whose payload is a resource into `resource_types`, recursing through
# nested Option/Result payloads. ONLY Option/Result: Vector/Dict/Set/Box
# are already classified by lir_lower's `build_resource_metadata`, and
# their mangled names (`Dict__GorgetString__GirTypeInfo`) have no C
# typedef — registering THOSE flips field emission to a non-existent type
# (832 cc errors). Option/Result instances DO emit a typedef, so keying
# `is_resource_type_name` on them is safe. See the call site in
# lower_module for why this gap exists (mono'd prelude generics aren't
# user `m.items` defs).
void register_optionlike_resource(SpannedType stype, Dict[String, bool] resource_types, Dict[String, bool] &optionlike):
    match stype.ty:
        case TNamed(name, targs):
            if name == "Option" or name == "Result":
                bool payload_resource = false
                for ta in targs:
                    if is_resource_field_type(ta, resource_types):
                        payload_resource = true
                if payload_resource:
                    optionlike.put(spanned_type_to_name(stype), true)
                # Nested Option[Option[Resource]] / Result[Option[..]] etc.
                for ta in targs:
                    register_optionlike_resource(ta, resource_types, &optionlike)
        else:
            pass

bool is_resource_type_name(String name, GirModule &gmod):
    # Delegate to `resource_meta_for` (lazy accessor over the
    # `build_resource_metadata` cascade in lir_lower.gg — the single
    # source of truth for the runtime-resource classification, covering
    # GorgetString / Array / Map / Set / Closure, parameterised Vector__/
    # Dict__/Set__/Box__, opaque handles Mutex__/Channel__/Shared__/
    # Weak__/AtomicInt__/Semaphore__/OnceFlag__/WaitGroup__/etc.).
    # Layering rule 3: one source of truth per axis.
    match resource_meta_for(&gmod, name):
        case Some(_):
            return true
        case None:
            pass
    # User struct/enum types registered as resource by lower_module's
    # type-registration pass (Phase D step 1 didn't extend
    # build_resource_metadata to cover user types, so this fallback
    # remains until that consolidation lands).
    if gmod.resource_types.contains(name):
        return true
    # Mono'd Option__X / Result__X__E whose payload owns a resource: a
    # by-value struct that must still be CLONED (not byte-copied) at a
    # consume position. Kept OUT of resource_types so C emission keeps the
    # by-value ABI; see GirModule.optionlike_resource_types.
    if gmod.optionlike_resource_types.contains(name):
        return true
    return false

# ── Binary operator mapping ──────────────────────────────

int map_binop(String op):
    match op:
        case "+":
            return OP_ADD
        case "-":
            return OP_SUB
        case "*":
            return OP_MUL
        case "/":
            return OP_DIV
        case "%":
            return OP_REM
        case "+%":
            return OP_ADD_WRAP
        case "-%":
            return OP_SUB_WRAP
        case "*%":
            return OP_MUL_WRAP
        case "**":
            return OP_POW
        # D26 (Round XXXIII Batch C1): fallible arithmetic operators.
        # SH's Route-A MINIMUM shape — same as their base op (trap-on-fault).
        # This matches the Rust foundation-slice behaviour BEFORE F1 landed
        # its dedicated Route-A (early-return Error) and Route-B (Result
        # capture) lowering. Sound for Route A inside a `throws ArithError`
        # fn on values that don't fault; incomplete for the fault path and
        # for Result-capture. Follow-up: SH F1 mirror (own scout+brief).
        case "+!":
            return OP_ADD
        case "-!":
            return OP_SUB
        case "*!":
            return OP_MUL
        case "/!":
            return OP_DIV
        case "%!":
            return OP_REM
        case "<<!":
            return OP_SHL
        case ">>!":
            return OP_SHR
        case "&":
            return OP_BITAND
        case "|":
            return OP_BITOR
        case "^":
            return OP_BITXOR
        case "<<":
            return OP_SHL
        case ">>":
            return OP_SHR
        else:
            # HARD BUG: returning OP_ADD for an unrecognised operator
            # silently mis-compiles it as addition. Emit a diagnostic
            # so the mis-compile is visible.
            diag_bug("map_binop", "unknown operator '" + op + "' — defaulting to OP_ADD (WRONG)")
            return OP_ADD

# Map the compound-assignment operator spelling (`+=`, `-=`, `*=`, `/=`,
# `%=`) to the matching GIR binop. Stage-1 was compiling every `last_us
# -= 1` as `last_us += 1` because the parser stored the full compound-op
# spelling ("-=") in SCompoundAssign's op field, but `map_binop` only
# recognised the arithmetic spelling ("-") and fell through to the
# OP_ADD default for any compound form — producing infinite loops in
# lower_type_defs's field-name scanner.
int map_compound_binop(String op):
    match op:
        case "+=":
            return OP_ADD
        case "-=":
            return OP_SUB
        case "*=":
            return OP_MUL
        case "/=":
            return OP_DIV
        case "%=":
            return OP_REM
        case "+%=":
            return OP_ADD_WRAP
        case "-%=":
            return OP_SUB_WRAP
        case "*%=":
            return OP_MUL_WRAP
        case "**=":
            return OP_POW
        case "&=":
            return OP_BITAND
        case "|=":
            return OP_BITOR
        case "^=":
            return OP_BITXOR
        case "<<=":
            return OP_SHL
        case ">>=":
            return OP_SHR
        else:
            # Defensive: the parser should always emit the compound
            # spelling for SCompoundAssign. Falling back to the bare-op
            # mapping mostly works but emits a diagnostic — an unmapped
            # compound op here is almost certainly a parser/lowerer
            # mismatch worth noticing.
            diag_warn("map_compound_binop", "unknown compound operator '" + op + "' — routing through map_binop")
            return map_binop(op)

# ── Track W (Round XIII): shared user-operator-overload call helper ──
#
# Analog of Rust gg's `emit_operator_overload_call` (src/ir/lowering/exprs/
# calls.rs:3037-3082). Centralises the ownership/drop discipline for every
# user-op-overload call site (binary op, unary neg, compound-arith arm,
# `Type__compare`, `Type__eq`) so a future 7th site can't re-open the class
# — Core #4 (fix the class, not the instance).
#
# Contract:
#   1. Emit `GICallExtern(op_dst, callee, args)` and register `op_dst` for
#      scope-exit drop. `register_local_for_drop`'s `is_droppable_type`
#      gate makes BOOL-return dispatch (`Type__eq`, `Type__compare` folded
#      through a comparator) a natural no-op — no spurious drop on a scalar.
#   2. For each source local in `arg_sources` that is an ANONYMOUS OWNING
#      RESOURCE (typically an inline-ctor RHS temp like `Acc(5, [5])` — no
#      `name_hint`, `LoOwned`, `is_droppable_type` true), emit a post-call
#      `GIDropIfAlive(src)` + `GIMoveZero(src)`. drop_elab strips the guard
#      (state=Initialized) and its scope-exit sibling (state=Uninitialized
#      after IMoveSlot), so the temp drops EXACTLY ONCE at the semantically
#      correct point — right after the call, mirroring Rust's
#      `pending_temp_drops` drain. Named live locals (`name_hint = Some(_)`)
#      skip: the scope-exit drop covers them and the caller may still read
#      them past the call.
#
# Callers MUST pre-flip user-overload receivers from `OpMove(recv)` →
# `OpBorrow(recv)` (the C ABI `T__add(T*, T*)` passes the receiver by
# pointer; `OpMove` would falsely mark the receiver dead and elide its
# scope-exit drop → LHS leak — the Track W root cause on all four
# `overload_arg_temp_*` pins). Non-user-overload receivers keep their
# existing operand shape.
void emit_overload_call(LowerCtx &ctx, GirModule &gmod, String callee, Vector[Operand] args, int op_dst, int ret_ty, Vector[int] arg_sources):
    emit(&ctx, GICallExtern(op_dst, callee, args))
    register_local_for_drop(&ctx, op_dst, ret_ty, &gmod)
    int asi = 0
    while asi < arg_sources.len():
        int src = arg_sources.get(asi).unwrap()
        asi += 1
        if src < 0 or src >= ctx.locals.len():
            continue
        GirLocal src_loc = ctx.locals.get(src).unwrap()
        # A non-droppable source (primitive, pointer, POD struct) cannot leak
        # — skip. Guards against Type__compare/Type__eq sites whose args happen
        # to be non-resource wrappers too.
        if not is_droppable_type(src_loc.type_id, &gmod):
            continue
        # A NAMED local outlives the call: the user still refers to it by
        # name, and the scope-exit drop is exactly right. An anonymous local
        # (`name_hint == None`) is a candidate temp — but still gated by
        # ownership + drop-registration below.
        match src_loc.name_hint:
            case Some(_):
                continue
            case None:
                pass
        # LoBorrowed / LoView aliases are not owners — the real owner's
        # drop covers the buffer. LoParam / LoMaybeOwned are the caller's
        # responsibility. Only LoOwned candidates get further consideration.
        match src_loc.ownership:
            case LoOwned():
                pass
            else:
                continue
        # A genuine inline-ctor temp SELF-REGISTERS on creation (lower_call
        # / SVarDecl / EStructLiteral all route through
        # register_local_for_drop). An UNREGISTERED anonymous owning droppable
        # is typically a builtin-getter-result slot — e.g.
        # `gorget_array_get`'s Acc-typed dst in `lower_index_compound_assign`
        # — whose C-emit stores a Ptr-alias into an Acc-typed slot; the
        # collection still owns the element, so post-dropping it double-frees
        # the buffer. Only registered temps get the post-call drain (mirrors
        # Rust's `pending_temp_drops` — Rust re-homes UNREGISTERED owning
        # temps because Rust's ctor doesn't auto-register; SH's ctors DO
        # register, so the criterion inverts: registered = candidate).
        if not is_local_registered_for_drop(ctx, src):
            continue
        emit(&ctx, GIDropIfAlive(src))
        emit(&ctx, GIMoveZero(src))

# Emit a compound-assign arithmetic step (`x = x <op> y`). For `+=` with a
# String operand, route to `gorget_str_cat(lhs, rhs)` (allocates a new
# String, reads both operands → both borrow) — same form as the EBinaryOp
# `+` String-concat path (lower.gg:~4781-4789). For `+=` on Array-kind
# (Vector/Deque — typed `collection_kind`, never a name match), emit the
# same clone+extend as binary `+` (lower_expr EBinaryOp). Without these,
# String/Array `+=` become a raw C `+` and fail to compile or miscompile.
# Every other op is the raw `GIBinOp(dst, map_compound_binop(op), …)` path.
void emit_compound_arith(LowerCtx &ctx, String op, int dst, int lhs_val, int rhs_val, int result_ty, GirModule &gmod):
    # Array-kind compound concat FIRST (before user-overload arm): Vector/
    # Deque live in `type_infos` and would otherwise be routed to a
    # non-existent `Vector__T__add` user method. Mirrors binary `+`
    # (lower_expr.gg) and Rust Array compound (assigns.rs). Typed kind.
    if op == "+=":
        String arr_tn = local_type_name(lhs_val, ctx, &gmod)
        CollectionKind arr_ck = collection_kind_of(&gmod, arr_tn)
        if collection_kind_eq(arr_ck, CkVector()) or collection_kind_eq(arr_ck, CkDeque()):
            # dst = gorget_array_clone(&lhs); gorget_array_extend(&dst, &rhs)
            Vector[Operand] clone_args = [op_consume(ctx, &gmod, lhs_val, CkCallArgBorrow())]
            emit(&ctx, GICallExtern(dst, "gorget_array_clone", clone_args))
            # Self (the cloned result) is borrowed (mutated in place via the
            # by-pointer ABI), NOT copied — OpCopy on a resource trips
            # validate_resource_moves. rhs is read-only (CkCallArgBorrow).
            Vector[Operand] ext_args = [OpBorrow(dst), op_consume(ctx, &gmod, rhs_val, CkCallArgBorrow())]
            emit(&ctx, GICallExtern(-1, "gorget_array_extend", ext_args))
            register_local_for_drop(&ctx, dst, result_ty, &gmod)
            return
    # R42-A (Core #4 — centralize at the producer): user operator-overload
    # compound-assign (`a += b` on a struct/enum with `equip X with Add`) is
    # dispatched HERE rather than at each of the 5+ emit_compound_arith call
    # sites, so the whole sibling class is closed at once: a `Vec2 &v: v += …`
    # (deref-store site), a struct-field `s.v += …`, a mutable-static compound,
    # AND a struct-element `arr[i] += …` all route `dst = X__add(&a, b)` here.
    # The guard (`lhs_val` is a REGISTERED user type AND `X__op` is a real
    # fn_sig) makes it inert for scalar/String operands — so the Shared/Mutex/
    # Atomic inner-type callers (lower_expr.gg) and the scalar static/field/
    # element callers keep the raw binop. Mirrors Rust lower_compound_assign's
    # identifier overload arm (src/ir/lowering/stmts/assigns.rs:1292-1330).
    #
    # Track W: receiver is OpBorrow (C ABI passes by pointer; OpMove would
    # falsely mark it dead and elide its scope-exit drop → LHS leak).
    # Post-call temp drops + result registration go through emit_overload_call.
    String ov_meth = compound_op_overload_method(op)
    if ov_meth != "":
        String ov_tn = local_type_name(lhs_val, ctx, &gmod)
        bool ov_user = gmod.type_infos.contains(ov_tn)
        if not ov_user and ov_tn.contains("__"):
            int ov_dd = ov_tn.index_of("__").unwrap()
            if ov_dd > 0 and gmod.type_infos.contains(ov_tn.slice(0, ov_dd)):
                ov_user = true
        String ov_full = ov_tn + "__" + ov_meth
        if ov_user and gmod.fn_sigs.contains(ov_full):
            Vector[Operand] ov_args = [OpBorrow(lhs_val), op_consume(ctx, &gmod, rhs_val, classify_call_arg(gmod, ov_full, 1))]
            Vector[int] ov_sources = [lhs_val, rhs_val]
            emit_overload_call(&ctx, &gmod, ov_full, ov_args, dst, result_ty, ov_sources)
            return
    if op == "+=" and (is_string_local(lhs_val, ctx, &gmod) or is_string_local(rhs_val, ctx, &gmod)):
        Vector[Operand] cat_args = []
        cat_args.push(op_consume(ctx, &gmod, lhs_val, CkCallArgBorrow()))
        cat_args.push(op_consume(ctx, &gmod, rhs_val, CkCallArgBorrow()))
        emit(&ctx, GICallExtern(dst, "gorget_str_cat", cat_args))
    else:
        emit(&ctx, GIBinOp(dst, map_compound_binop(op), result_ty, op_consume(ctx, &gmod, lhs_val, CkBinOpArg()), op_consume(ctx, &gmod, rhs_val, CkBinOpArg())))

# R42-A: compound-assign operator → the user-overload method name it dispatches
# to (`a += b` → X__add(&a, b)). Only the arithmetic ops overload; wrap/bitwise/
# shift compound-assigns keep the raw binop. Mirrors Rust lower_compound_assign's
# `overload_method` match (src/ir/lowering/stmts/assigns.rs:1293-1300).
String compound_op_overload_method(String op):
    if op == "+=":
        return "add"
    if op == "-=":
        return "sub"
    if op == "*=":
        return "mul"
    if op == "/=":
        return "div"
    if op == "%=":
        return "rem"
    return ""

bool is_comparison(String op):
    match op:
        case "==" | "!=" | "<" | "<=" | ">" | ">=":
            return true
        else:
            return false

int map_cmpop(String op):
    match op:
        case "==":
            return CMP_EQ
        case "!=":
            return CMP_NE
        case "<":
            return CMP_LT
        case "<=":
            return CMP_LE
        case ">":
            return CMP_GT
        case ">=":
            return CMP_GE
        else:
            return CMP_EQ

