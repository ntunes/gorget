                bool _rh_is_uint = recv_type_name == "uint64_t" or recv_type_name == "uint32_t" or recv_type_name == "uint16_t" or recv_type_name == "uint8_t" or recv_type_name == "byte"
                bool _rh_is_str = recv_type_name == "String" or recv_type_name == "GorgetString" or recv_type_name == "Str"
                bool _rh_is_other_prim = recv_type_name == "bool" or recv_type_name == "char"
                if _rh_is_int or _rh_is_uint or _rh_is_str or _rh_is_other_prim:
                    # Lower the hasher arg (`&h`) as a PLACE (the pointer),
                    # not a value read. A bare `lower_expr` on the `&`-param
                    # `h` (a `GtMutPtr(FxHasher)` slot) deref-loads a VALUE
                    # COPY (the EIdentifier `&`/`!`-param value-read at :415),
                    # so each field write would mutate a discarded copy and
                    # the hasher state never accumulates. `lower_place_base`
                    # on the borrow's inner returns the pointer slot directly
                    # (same reason the receiver dispatch uses it at :1113).
