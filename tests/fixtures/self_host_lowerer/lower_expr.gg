# ── f-string format-spec application (`{x:.2f}`, `{n:08d}`, `{255:#x}`) ──
#
# Port of Rust gg's `apply_format_spec` (src/ir/lowering/exprs/calls.rs:2082).
# Given a user format spec (`.2f`, `08d`, `x`, `#x`, `b`, …) and the arg's
# GIR type, build the printf format fragment (e.g. `%08lld`, `%.2f`, `%#llx`)
# and push the consumed operand(s) into `gsf_args`. Returns the fragment, or
# "" to DECLINE — the caller then falls through to the existing type-based
# default (mirrors Rust's `Option` returning `None`). Two decline cases, both
# yielding "": (i) the spec is empty, (ii) the spec is present but inapplicable
# to this arg's type (e.g. `:.2f` on an int).
#
# The `b` (binary) arm calls `gorget_int_to_binary(val, alt)` → owned Str and
# registers it for drop at its producer (print-temp leak class), exactly like
# the bool arm in the EFString lowering.
#
# Spec grammar (mirror Rust + docs/language-reference.md §14.1):
#   [#][0][width][.precision][type]   type ∈ {d x X o b | f e E}
#
# NOTE (completeness, not required for the 2-fixture flip — corpus candidates
# are I64/F64 only): narrow-int widening to 64-bit (`widen_int`) and unsigned
# `%llu` are NOT handled here; a narrow int passed through C's variadic ABI
# with `%lld` may mis-render. Mirror Rust's `widen_int` if/when narrow-int
# f-string specs land in the corpus. [TODO: this brief — f-string format-spec]
String apply_format_spec(LowerCtx &ctx, GirModule &gmod, Vector[Operand] &gsf_args, String spec, int aloc, int aty, int gs_tid):
    if spec.byte_len() == 0:
        return ""
    bool is_int = aty == I8_TYPE or aty == I16_TYPE or aty == I32_TYPE or aty == I64_TYPE or aty == U8_TYPE or aty == U16_TYPE or aty == U32_TYPE or aty == U64_TYPE
    bool is_float = aty == F32_TYPE or aty == F64_TYPE

    int n = spec.byte_len()
    int pos = 0

    # '#' — alternate form (0x / 0o / 0b prefix)
    bool alt = false
    if pos < n and spec.byte_at(pos) == b'#':
        alt = true
        pos = pos + 1

    # '0' — zero-pad (only when followed by a digit, matching Rust)
    bool zero_pad = false
    if pos < n and spec.byte_at(pos) == b'0' and pos + 1 < n and is_ascii_digit(spec.byte_at(pos + 1)):
        zero_pad = true
        pos = pos + 1

    # width digits
    int width_start = pos
    while pos < n and is_ascii_digit(spec.byte_at(pos)):
        pos = pos + 1
    String width = ""
    if pos > width_start:
        width = owned_slice(spec, width_start, pos)

    # precision: .N
    bool has_prec = false
    String prec = ""
    if pos < n and spec.byte_at(pos) == b'.':
        pos = pos + 1
        int prec_start = pos
        while pos < n and is_ascii_digit(spec.byte_at(pos)):
            pos = pos + 1
        prec = owned_slice(spec, prec_start, pos)
        has_prec = true

    String zflag = ""
    if zero_pad:
        zflag = "0"
    String aprefix = ""
    if alt:
        aprefix = "#"

    # No type char — width/precision with the default type.
    if pos >= n:
        if is_int and (width.byte_len() > 0 or zero_pad):
            gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
            return "%" + zflag + width + "lld"
        if is_float and has_prec:
            gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
            return "%." + prec + "f"
        return ""

    byte tc = spec.byte_at(pos)

    # ── Integer formats ──
    if tc == b'd' and is_int:
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + zflag + width + "lld"
    if tc == b'x' and is_int:
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + aprefix + zflag + width + "llx"
    if tc == b'X' and is_int:
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + aprefix + zflag + width + "llX"
    if tc == b'o' and is_int:
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + aprefix + zflag + width + "llo"
    if tc == b'b' and is_int:
        # Binary has no printf equivalent — call the runtime helper, which
        # returns an owned Str (heap buffer). Clone of the bool arm below.
        int balt = 0
        if alt:
            balt = 1
        int bdst = add_local(&ctx, gs_tid, None)
        Vector[Operand] bargs = [OpCopy(aloc), OpConstI64(balt)]
        emit(&ctx, GICallExtern(bdst, "gorget_int_to_binary", bargs))
        register_local_for_drop(&ctx, bdst, gs_tid, &gmod)
        gsf_args.push(op_consume(ctx, &gmod, bdst, CkFormatArg()))
        return "%.*s"

    # ── Float formats ──
    if tc == b'f' and is_float:
        String fp = prec
        if not has_prec:
            fp = "6"
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + zflag + width + "." + fp + "f"
    if tc == b'e' and is_float:
        String ep = prec
        if not has_prec:
            ep = "6"
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + width + "." + ep + "e"
    if tc == b'E' and is_float:
        String Ep = prec
        if not has_prec:
            Ep = "6"
        gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
        return "%" + width + "." + Ep + "E"

    # Unrecognized / inapplicable spec — decline, caller uses the default.
    return ""

bool is_ascii_digit(byte c):
    return c >= b'0' and c <= b'9'

# ── Displayable dispatch for `print(x)` / f-string `{x}` ─────────────
#
# Return the `display` method symbol to call for a value of type `tid`
# if its type derives / equips Displayable, else "". Mirrors the
# Displayable branch of Rust gg's `format_for_printf`
# (src/ir/lowering/exprs/calls.rs:1964-1996): a `Named(T)` type with a
# `T__display` entry in `fn_sigs` (either the short `Type__display` key
# or the trait-qualified `Displayable_for_Type__display` key, both
# registered at lower.gg:~2990 / :~3008) → call it and format the
# returned String with %.*s. TYPED gate (core-invariant #2): the check
# is a `fn_sigs` Dict lookup of the actually-emitted symbol, NOT a
# name-shape test on the type.
Option[String] fstr_displayable_display_method(int tid, GirModule &gmod):
    # Only user struct/enum types (Named) have a display method; the
    # primitive ids (bool/int/double) and pointer wrappers never do.
    # type_id_to_name unwraps GtPtr/GtMutPtr to the pointee name, but a
    # Displayable value local is a bare value (the Ptr cases are handled
    # by the borrowed-String deref above), so the bare-name lookup is
    # the right one here. Returns the display symbol as `Some` (so the
    # caller binds it once via `if … is Some(fn):` — no sentinel, no
    # re-lookup), `None` when the type isn't Displayable.
    String tyname = type_id_to_name(tid, &gmod)
    String short_key = tyname + "__display"
    if gmod.fn_sigs.contains(short_key):
        return Some(short_key)
    String trait_key = "Displayable_for_" + tyname + "__display"
    if gmod.fn_sigs.contains(trait_key):
        return Some(trait_key)
    return None()

# ── Block-as-expression / tail-value lowering ───────────
#
# These three helpers implement the block-as-value path that any
# `if`/`elif`/`else` (or, in follow-up rounds, `match` / `do:` block)
# used in expression position needs. Mirrors Rust gg's
# `lower_block_expr` (`src/ir/lowering/exprs/mod.rs:3203`),
# `lower_stmt_as_tail_value` (`:3236`), and `build_if_chain_expr`
# (`:3414`).

# Return true iff the current block already has a real terminator
# (return / break / jump / branch). Used to suppress the
# assign-result + jump-to-merge when a branch body already diverged
# (e.g. ended in `return`). Mirrors Rust's `!builder.is_terminated()`.
bool block_terminated(LowerCtx ctx):
    Terminator cur = ctx.block_terms.get(ctx.current_block).unwrap()
    match cur:
        case GTNone():
            return false
        else:
            return true

# Lower a block of statements as an EXPRESSION, returning the local id
# of its tail value. Mirrors Rust `lower_block_expr` (`:3203`):
#   • empty block → a fresh Unit local (Rust returns Constant::Unit;
#     the `is_empty()` guard avoids a `len()-1` underflow);
#   • otherwise lower all-but-last as statements, then the LAST stmt as
#     a tail value via `lower_stmt_as_tail_value`. A -1 (no tail value —
#     the SMatch/else deferral) becomes a Unit local so the caller still
#     has a valid local to read.
int lower_block_expr(LowerCtx &ctx, Vector[Stmt] block_stmts, GirModule &gmod):
    if block_stmts.len() == 0:
        int unit_dst = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(unit_dst, OpConstUnit()))
        return unit_dst
    int last_idx = block_stmts.len() - 1
    int si = 0
    while si < last_idx:
        lower_stmt(&ctx, block_stmts.get(si).unwrap(), &gmod, false)
        si = si + 1
    int tail = lower_stmt_as_tail_value(&ctx, block_stmts.get(last_idx).unwrap(), &gmod)
    if tail < 0:
        int unit_dst2 = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(unit_dst2, OpConstUnit()))
        return unit_dst2
    return tail

# Lower the LAST statement of a block as a tail value. Mirrors Rust
# `lower_stmt_as_tail_value` (`:3236`): recognises the tail-value
# shapes and returns the producing local; for any other statement form
# lowers it as a regular statement and returns -1 ("no tail value").
#
# This round handles `SExpr` (bare trailing expression), `SIf`
# (if-chain used as a value, sharing `lower_if_chain_expr` with the
# EIf-in-`lower_expr` case), and `SMatch` (match used as a value,
# sharing `lower_match_expr` with the EMatch-in-`lower_expr` case —
# mirrors Rust `lower_stmt_as_tail_value` `exprs/mod.rs:3246-3248`).
int lower_stmt_as_tail_value(LowerCtx &ctx, Stmt last_stmt, GirModule &gmod):
    match last_stmt:
        case SExpr(e):
            return lower_expr(&ctx, e, &gmod)
        case SIf(cond_expr, then_body, elif_branches):
            return lower_if_chain_expr(&ctx, cond_expr, then_body, elif_branches, &gmod)
        case SMatch(scrutinee, arms):
            return lower_match_expr(&ctx, scrutinee, arms, &gmod)
        else:
            lower_stmt(&ctx, last_stmt, &gmod, false)
            return -1

# Lower an `if`/`elif`/`else` chain in EXPRESSION position, producing a
# single `result` local that every reaching branch assigns. Mirrors Rust
# `build_if_chain_expr` (`src/ir/lowering/exprs/mod.rs:3414-3500`).
#
# Shape: the self-host AST folds elif + else into one `Vector[ElseBranch]`
# (`ElseBranch.condition` = Some(cond) → elif, None → explicit else).
# We materialise `result` up front (so the merge sees a single def — SSA
# inserts the phi), lower cond → GTBranch(then, else), then in the then
# block lift `then_body` via `lower_block_expr`, assign it into `result`
# via `op_consume(CkAssign)` (clone-or-move per ownership — resource
# branches need the clone), and jump to merge. Each elif spins a fresh
# branch (cond → elif_then / next_else); the explicit else lifts its
# block + assigns. If NO explicit-else (None-condition) branch exists,
# the terminal else block assigns the typed default (`OpConstI64(0)`,
# mirroring Rust `:3494`) so `result` is assigned on EVERY path to merge.
# Every assign+jump is guarded on `not block_terminated` — a branch that
# ended in `return`/`break` must not also jump to merge.
#
# Result-type refinement: start from `ctx.expected_type` (set by the
# enclosing SVarDecl/SAssign/SReturn writer) when valid; otherwise refine
# from the FIRST non-Unit branch value's type (mirrors Rust's
# `infer_operand_type_full` + the `result_type_refined` latch).
int lower_if_chain_expr(LowerCtx &ctx, SpannedExpr cond_expr, Vector[Stmt] then_body, Vector[ElseBranch] else_branches, GirModule &gmod):
    # The condition is bool-typed, NOT the if-expression's result type —
    # clear the enclosing `expected_type` (the if-RESULT's) around the cond so
    # the centralized auto-prop hook's capture-form check doesn't suppress a
    # throws-call condition's peel; restore it before the result_type seeding.
    int saved_expected_ifc = ctx.expected_type
    ctx.expected_type = -1
    int cond = lower_expr(&ctx, cond_expr, &gmod)
    ctx.expected_type = saved_expected_ifc
    # Auto-propagate a `throws` call used as the if-expression condition.
    cond = maybe_auto_propagate(&ctx, cond, &gmod)
    # Seed result type from expected_type when the writer set a concrete
    # one; else I64 (refined below from the first non-Unit branch).
    int result_type_init = I64_TYPE
    bool result_type_refined = false
    if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
        result_type_init = ctx.expected_type
        result_type_refined = true
    int result = add_local(&ctx, result_type_init, None)
    int merge_bb = new_block(&ctx)
    int then_bb = new_block(&ctx)
    int else_bb = new_block(&ctx)
    set_terminator(&ctx, GTBranch(OpCopy(cond), then_bb, else_bb))
    # Then branch.
    switch_to(&ctx, then_bb)
    int then_val = lower_block_expr(&ctx, then_body, &gmod)
    if not block_terminated(ctx):
        if not result_type_refined:
            int tty = ctx.locals.get(then_val).unwrap().type_id
            if tty != UNIT_TYPE:
                refine_local_type(&ctx, result, tty)
                result_type_refined = true
        emit(&ctx, GIAssign(result, op_consume(ctx, &gmod, then_val, CkAssign())))
        set_terminator(&ctx, GTJump(merge_bb))
    # Elif chain + explicit else, walking the folded ElseBranch vector.
    int current_else_bb = else_bb
    bool saw_else = false
    int ebi = 0
    while ebi < else_branches.len():
        ElseBranch eb = else_branches.get(ebi).unwrap()
        match eb.condition:
            case Some(elif_cond):
                switch_to(&ctx, current_else_bb)
                int elif_cond_val = lower_expr(&ctx, elif_cond, &gmod)
                int elif_then_bb = new_block(&ctx)
                int next_else_bb = new_block(&ctx)
                set_terminator(&ctx, GTBranch(OpCopy(elif_cond_val), elif_then_bb, next_else_bb))
                switch_to(&ctx, elif_then_bb)
                int elif_val = lower_block_expr(&ctx, eb.body, &gmod)
                if not block_terminated(ctx):
                    if not result_type_refined:
                        int ety = ctx.locals.get(elif_val).unwrap().type_id
                        if ety != UNIT_TYPE:
                            refine_local_type(&ctx, result, ety)
                            result_type_refined = true
                    emit(&ctx, GIAssign(result, op_consume(ctx, &gmod, elif_val, CkAssign())))
                    set_terminator(&ctx, GTJump(merge_bb))
                current_else_bb = next_else_bb
            case None:
                # Explicit else — terminal branch.
                saw_else = true
                switch_to(&ctx, current_else_bb)
                int else_val = lower_block_expr(&ctx, eb.body, &gmod)
                if not block_terminated(ctx):
                    if not result_type_refined:
                        int sty = ctx.locals.get(else_val).unwrap().type_id
                        if sty != UNIT_TYPE:
                            refine_local_type(&ctx, result, sty)
                            result_type_refined = true
                    emit(&ctx, GIAssign(result, op_consume(ctx, &gmod, else_val, CkAssign())))
                    set_terminator(&ctx, GTJump(merge_bb))
        ebi = ebi + 1
    # No explicit else → the all-conditions-false path lands in the
    # terminal else block with `result` unassigned. Assign the typed
    # default (I64(0), mirroring Rust `:3494`) so EVERY path to merge
    # writes `result`.
    if not saw_else:
        switch_to(&ctx, current_else_bb)
        if not block_terminated(ctx):
            emit(&ctx, GIAssign(result, OpConstI64(0)))
            set_terminator(&ctx, GTJump(merge_bb))
    switch_to(&ctx, merge_bb)
    return result

# Overwrite a local's recorded type_id in place (used by the if-chain
# result-type refinement: the result slot is allocated with a seed type,
# then narrowed to the first non-Unit branch value's type). Mirrors Rust's
# `builder.locals[result_id.0].type_id = ty` — in-place field mutation.
void refine_local_type(LowerCtx &ctx, int lid, int new_type):
    ctx.locals.get(lid).unwrap().type_id = new_type

# ── Expression lowering ─────────────────────────────────

# Centralized producer-side Result→T auto-propagation hook (mirrors Rust
# gg's `lower_expr` wrapper, `src/ir/lowering/exprs/mod.rs:73-86`, landed at
# `90d09414`). When the expression is a `Call` or `MethodCall` — the only
# expression shapes that PRODUCE a `throws`-fn's `Result[T,E]` via the
# throws-sugar — apply `maybe_auto_propagate` at the tail: in a propagating
# context (enclosing fn is `throws` / returns `Result`) and where the
# surrounding destination doesn't itself want a `Result`, peel `Result→T`
# (forwarding the `Error` branch to the function's Result return slot).
#
# This subsumes the former CONSUMER-targeted design (N explicit call sites)
# with ONE producer-side decision, mirroring the now-canonical Rust shape —
# and closes the same per-position gaps Rust closed: binop operands, method
# args, aggregate-literal elements, if-expr / match-expr arm tails, and
# inline match scrutinees whose arms discriminate USER variants (snag48).
# The decision is purely typed (operand IR type + enclosing-fn return type),
# no name-matching beyond the `Result__` mangled-name prefix already used by
# `maybe_auto_propagate`.
#
# Sites that need the RAW `Result` even at a Call/MethodCall position set
# `ctx.suppress_auto_prop = true` before calling `lower_expr`: match
# scrutinees whose arms match `Ok`/`Error`/`Some`/`None` (so the user can
# discriminate the Result), `catch` inner, and `rethrow` inner (which
# extract the Ok/Error payloads themselves). The flag is a ONE-SHOT —
# consumed (reset to false) at entry — so nested sub-expressions still
# auto-prop normally.

# ── Guard[T] field-access auto-deref (shared read+write helper) ─────
# `g.field` where `g: Guard[T]` / `ReadGuard[T]` / `WriteGuard[T]` is sugar
# for `(*get_ptr(&g)).field`: the guard wraps a `{owner/rwlock, void* ptr}`
# struct (single-owner carve-out, docs/devbook/11), so the field projection
# must go THROUGH the guard's inner data pointer, not the guard's own
# `owner`/`ptr` fields. Mirrors Rust `lower_field_access`'s leading guard
# arm (src/ir/lowering/exprs/mod.rs:2109-2162 — `guard_inner_suffix` +
# `emit_guard_get_ptr` + a `Deref`-projected field place).
#
# Returns Some((inner_ptr_local, inner_name)) when `base` is a guard:
#   - `inner_ptr_local` is a `GtPtr(inner)`-typed local holding the result
#     of `gorget_{guard,read_guard,write_guard}_get_ptr(&g)` (= `g->ptr`).
#     Pointer-typed so the downstream GIFieldLoad / __field_write_ codegen
#     loads the pointer and projects the field THROUGH it (mutating the
#     real guarded data in place — correct for both reads and writes).
#   - `inner_name` is the guarded type name (`Point` / `int64_t` / ...),
#     resolved from the typed `is_guard_struct_type` / `guard_method_prefix`
#     channels (NO name-matching for the semantic decision — the Guard-ness
#     comes from `resource_meta_for(...).runtime_name == "Guard"`, exactly
#     like the Box arm reads `box_kind == BkRegularBox`).
# Returns None for a non-guard base (caller falls through to the normal
# struct field path).
#
# ⚠ THIS HELPER IS UNIFORM ACROSS Guard / ReadGuard / WriteGuard — deliberately.
# The READ face (`lower_field_access`) needs the same field projection for all
# three. The WRITE-face soundness gate — ReadGuard has no write place, and
# writing through one would let two concurrent readers observe shared mutation
# — lives at the WRITE-FACE CALLER (`amp_object_base` with `for_write=true`),
# not inside this helper. Do NOT push the gate down here: it would break the
# read arm.
Option[FieldDerefResult] guard_field_deref_base(LowerCtx &ctx, int base, String base_type_name, GirModule &gmod):
    if not is_guard_struct_type(base_type_name, &gmod):
        return None
    # Recover the guarded type name = everything after the family-prefix
    # boundary (the FIRST `__`). Uniform across `Guard__`/`ReadGuard__`/
    # `WriteGuard__` (`ReadGuard__Point` → `Point`, `Guard__Box__Foo` →
    # `Box__Foo`), so NO per-variant `starts_with` name-routing — the
    # Guard-ness was already decided by the typed `is_guard_struct_type`
    # above; this just strips the prefix to its `__` boundary.
    int gd_sep = base_type_name.index_of("__").unwrap_or(-1)
    if gd_sep < 0:
        return None
    String gd_inner_name = base_type_name.slice(gd_sep + 2, base_type_name.len())
    int gd_inner_tid = resolve_field_gir_type(gd_inner_name, &gmod)
    int gd_inner_ptr_tid = register_ptr(&gmod, gd_inner_tid)
    # gorget_{guard,read_guard,write_guard}_get_ptr(&g) → void* at the
    # guarded data. The runtime fn name is the typed method prefix + _get_ptr.
    String gd_get_ptr_fn = guard_method_prefix(base_type_name, &gmod) + "_get_ptr"
    int gd_inner_ptr = add_local(&ctx, gd_inner_ptr_tid, None)
    emit(&ctx, GICallExtern(gd_inner_ptr, gd_get_ptr_fn, [OpBorrow(base)]))
    return Some(FieldDerefResult(gd_inner_ptr, gd_inner_name))

# Typed check: is this a `ReadGuard[T]` type? Reads through the typed
# `guard_method_prefix` channel (which unwraps `method_prefix` off
# `resource_meta_for` — ReadGuard's slot is populated with the literal
# `gorget_read_guard` at `build_resource_metadata`), NOT a `ReadGuard__`
# prefix substring. One decision, one source of truth (Core #2 / layering
# rule 2). Used by the WRITE-face `amp_object_base` gate to REFUSE emitting a
# write place for a ReadGuard base; the READ face keeps resolving all three
# guard variants uniformly through `guard_field_deref_base`.
bool is_read_guard_type(String name, GirModule &gmod):
    return guard_method_prefix(name, &gmod) == "gorget_read_guard"

# ── Box[T] deref-as-PLACE inner-name (shared write helper) ──────────
# `box_deref_inner_name(name)` returns Some(inner) when `name` is a
# parameterised `Box__<inner>` struct (`BkRegularBox`), else None.
# Box-ness is decided by the TYPED `box_kind` channel (the same
# `resource_meta_for(...).box_kind == BkRegularBox()` discriminator the
# read-side `*b` / `b.field` arms use), NOT a name-prefix test — the
# slice past the `Box__` prefix below only RUNS once the typed channel
# has already classified the value as a regular box (so it carries no
# routing decision; mirrors the read-side arms' prefix-slice).
# Used by the deref-as-PLACE write sites (`*b = x`, `(*b).f = x`) where
# the box VALUE is itself the heap pointer and the write must project
# THROUGH it (Rust assigns.rs:504-557 — the `Expr::Deref` lvalue arm
# pushes a `Projection::Deref`; the self-host's pointer-in-the-tid
# representation makes "the box value IS the pointer" the equivalent).
Option[String] box_deref_inner_name(String base_type_name, GirModule &gmod):
    match resource_meta_for(&gmod, base_type_name):
        case Some(rmeta):
            match rmeta.box_kind:
                case BkRegularBox():
                    return Some(base_type_name.slice(5, base_type_name.len()))
                else:
                    return None
        case None:
            return None

# ── Box[T] deref-as-PLACE base (shared read+write helper) ──────────
# The exact SIBLING of `guard_field_deref_base` above: both answer the one
# question the OBJECT DOMAIN of a projection asks — *given a wrapper object,
# which local holds the ADDRESS of the wrapped T, and what is T called?*
#
# `Box__T` is `typedef void*`, so the box local's VALUE already is the heap
# address; the whole job is to re-TYPE it as `GtPtr(T)`. That re-typing is the
# load-bearing part, not a formality:
#   * `GIFieldLoad` derives its LIR struct id from the base local's own type
#     name (`gir_type_id_to_base_name` → `sr.get(...)`). `Box__T` is not a
#     registered struct, so a box-typed base yields struct id -1 and a bogus
#     `IFieldPtr`; `GtPtr(T)` yields T's real id.
#   * the `GtPtr` slot is pointer-KIND, so `GIFieldLoad` LOADS the pointer
#     rather than taking the slot's address — the field pointer lands inside
#     the HEAP allocation.
# The alternative — `GIDeref` — byte-copies sizeof(T) into a stack slot and
# projects THAT, so every write through the resulting pointer is lost when the
# statement ends. Copying the POINTER, never the pointee, is the invariant.
#
# Returns None for a non-box base (caller falls through unchanged).
Option[FieldDerefResult] box_deref_ptr_base(LowerCtx &ctx, int base, String base_type_name, GirModule &gmod):
    match box_deref_inner_name(base_type_name, &gmod):
        case Some(bd_inner_name):
            int bd_inner_tid = resolve_field_gir_type(bd_inner_name, &gmod)
            int bd_ptr_tid = register_ptr(&gmod, bd_inner_tid)
            # LoBorrowed: the alias points INTO the box's allocation, which the
            # box local still owns — a LoOwned alias would drop-register the
            # same heap block twice (Core #3, the same reasoning the collection
            # element-pointer producer records).
            int bd_ptr = add_local_with(&ctx, bd_ptr_tid, None, LoBorrowed(), BoRuntimeView(base))
            # `GIAssign(PtrDst, OpBorrow(src))` is the canonical alias shape.
            # For a BOX src the LIR resolves it to the slot's VALUE (the heap
            # address), not its address — see the box arm of the D.1 rebind in
            # `lir_lower.gg`. `OpCopy` would be wrong twice over: it reads as a
            # resource duplication to `validate_resource_moves`, and it is not
            # what an alias means.
            emit(&ctx, GIAssign(bd_ptr, OpBorrow(base)))
            return Some(FieldDerefResult(bd_ptr, bd_inner_name))
        case None:
            return None

# ── The OBJECT DOMAIN of a place projection ────────────────────────
# A projection has TWO INDEPENDENT axes, and conflating them is what makes
# place resolution grow arms that contradict each other:
#
#   * the projection KIND — which sub-place of the object is named
#     (`.field`, `[index]`); resolved by `lower_amp_place` below.
#   * the OBJECT DOMAIN  — what KIND OF THING the object is, and therefore
#     WHO produces its address; resolved HERE, once, for every kind.
#
#   domain                      address produced by                result
#   ──────────────────────────  ─────────────────────────────────  ───────────
#   local / `&`/`!` param /     lower_place_base (the slot, or     value slot
#   `self` / module static      the param's own pointer)           or GtPtr(T)
#   Box[T]   (`*b`, `b.f`)      box_deref_ptr_base                 GtPtr(T)
#   Guard[T] (`g.f`)            guard_field_deref_base             GtPtr(T)
#   collection element          lower_index_element_ptr_place      GtPtr(elem)
#     (`v[i]`, `d[k]`)            (gorget_array_get/map_get)
#   nested projection (`o.a.b`) lower_amp_place, recursively       GtPtr(T)
#
# Every domain hands back the SAME shape — a local plus the struct name to
# project through — so the projection arms never learn what produced the base,
# and a new domain (a future smart pointer, a newtype) is one arm HERE rather
# than one arm in each kind.
#
# Note the two wrapper domains are resolved by TYPE, not by an `Expr::` arm:
# `b.f` and `g.f` are syntactically ordinary field accesses. That is exactly
# why they belong in the domain resolver and not in a kind-keyed arm set — and
# why the arm-set lints cannot see them (TODO.md's recorded blind spot).
#
# Returns None when the base is not a resolvable PLACE (a call result, an
# arithmetic temp, a literal) — the caller falls through unchanged.
#
# `for_write` is caller-scoped (same pattern the diff already uses for
# `require_struct_elem` on the index producer). Both `&`-formation call-arg
# faces are WRITE-through by construction, so every consumer here passes
# `true`. The gate switches on a single arm — a ReadGuard base — because
# writing through a read view lets two concurrent readers observe shared
# mutation (measured: `inc(&rg.fd)` mutated a `RWLock`-guarded value the
# read view was supposed to freeze). Kept CALLER-scoped so the READ arm
# (`lower_field_access`) can go on resolving all three guard variants
# uniformly through `guard_field_deref_base` — the RIGHT thing for the read
# face is not the right thing for the write face.
Option[FieldDerefResult] amp_object_base(LowerCtx &ctx, SpannedExpr base_expr, GirModule &gmod, bool for_write):
    # A3 guard (BLOCKING #2 re-open shield): every current caller is a
    # `&`-formation write face and passes `for_write=true`. A future naive
    # caller passing `false` would silently no-op the ReadGuard rejection
    # below and re-open the write-through-a-read-view class. Trip loudly
    # instead — if you legitimately need a read-face variant of this helper,
    # split it off as its own function rather than widening this one.
    if not for_write:
        diag_bug("amp_object_base", "called with for_write=false — split off a read-face variant instead of widening this helper (see fold rationale)")
    int aob_local = -1
    match base_expr.expr:
        case EIndex(aob_coll_box, aob_idx_box):
            # A collection element's address comes from the runtime getter, not
            # from a slot — `require_struct_elem=false` because a PLACE of a
            # scalar element (`&v[0]`) is exactly what an `&`-argument wants.
            aob_local = lower_index_element_ptr_place(&ctx, *aob_coll_box, *aob_idx_box, true, false, &gmod)
        case EFieldAccess(_, _):
            # Nested projection (`&o.inner.fd`): the inner object is itself a
            # place, so recurse through the SAME resolver rather than falling
            # back to a value read of the intermediate struct.
            aob_local = lower_amp_place(&ctx, base_expr, &gmod)
        case EIdentifier(_):
            # Bare local or module-level static. `lower_place_base` is a
            # nl_get lookup (idempotent) for a local and a `__global_ref__`
            # Ptr alias reservation for a static — no user-visible side
            # effect either way. Safe to re-run on a decline path.
            aob_local = lower_place_base(&ctx, base_expr, &gmod)
        case ESelfExpr():
            # `self.…` — bare `self` resolves through `lower_place_base` →
            # `lower_expr(ESelfExpr)` → nl_get on "self". Idempotent.
            aob_local = lower_place_base(&ctx, base_expr, &gmod)
        case EDeref(_):
            # `(*b).f`. `lower_place_base` returns the BOX local so the
            # downstream box arm re-types it to `GtPtr(T)` (Family-1 write
            # place). Non-idempotent for a call-typed box (`(*mk_bx()).f`)
            # — the box expression is user-lowered — but that shape is
            # rejected by the checker unless the inner is itself a place,
            # so the surviving cells are lookups.
            aob_local = lower_place_base(&ctx, base_expr, &gmod)
        else:
            # NOT a resolvable place shape (a call, arithmetic, literal,
            # method-chain result, …). BLOCKING #1 fold: the pre-fix code
            # fell THROUGH to `lower_place_base(base_expr)` for every shape,
            # which for a non-place bottomed out in `lower_expr(base_expr)`
            # and EMITTED the base's side effects. The chokepoint (line
            # ~8956) then declined on a downstream predicate — a
            # pointer-in-storage field, a nested type miss — and re-lowered
            # the WHOLE argument via `lower_expr(arg)`, evaluating the base
            # a SECOND time. Measured on `look(&mk().rwlock_field)`:
            # `MK / MK / …`; base (Rust gg + un-patched self-host)
            # `MK / …`. Refusing to emit HERE keeps the caller's fallback
            # to a single `lower_expr(arg)`. Mirrors the `_ => None` arm of
            # Rust's `place_expr_type_only` (src/ir/lowering/exprs/mod.rs
            # around `Postcondition 2 — EMISSION`).
            return None
    if aob_local < 0 or aob_local >= ctx.locals.len():
        return None
    # The struct name is read off the resolved local's OWN type (Ptr/MutPtr
    # unwrapped) — one derivation, never a per-arm recomputation.
    String aob_name = type_id_to_base_name(ctx.locals.get(aob_local).unwrap().type_id, &gmod)
    # Wrapper hop: a Box or Guard base needs one more step to reach the wrapped
    # value. Both produce a GtPtr(T) local; both are typed decisions.
    match box_deref_ptr_base(&ctx, aob_local, aob_name, &gmod):
        case Some(aob_bx):
            return Some(aob_bx)
        case None:
            pass
    # BLOCKING #2 fold — WRITE-face soundness gate. A `ReadGuard[T]` base
    # holds a read view; writing THROUGH one lets two concurrent read guards
    # observe shared mutation. `guard_field_deref_base` is uniform across
    # Guard/ReadGuard/WriteGuard by design (the READ face
    # `lower_field_access` needs that uniformity), so the write-face
    # asymmetry lives HERE, at the caller. `is_read_guard_type` reads the
    # typed method-prefix channel — no name-substring dispatch. Declining
    # falls the argument through to the value-read path (mirrors Rust gg
    # `try_resolve_field_place`'s ReadGuard early-out at
    # src/ir/lowering/exprs/mod.rs); an ideal follow-up is a check-time
    # `E_CannotWriteThroughReadView` reject, filed.
    if for_write and is_read_guard_type(aob_name, &gmod):
        return None
    match guard_field_deref_base(&ctx, aob_local, aob_name, &gmod):
        case Some(aob_gd):
            return Some(aob_gd)
        case None:
            pass
    return Some(FieldDerefResult(aob_local, aob_name))

# ── `&<projection>` → the ADDRESS OF THE PLACE ─────────────────────
# A `&`-argument names a PLACE, and the callee writes THROUGH it. Lowering the
# projection as a value read — load the field into a fresh slot, then borrow
# that slot — hands the callee the address of a temp that dies at the end of
# the statement, so every write is silently lost.
#
# This resolver dispatches on the projection KIND only; the object is handed to
# `amp_object_base` (above), which owns the domain axis. Returns the local
# holding the place pointer, or -1 to DECLINE (the caller then lowers the
# argument as a value read, exactly ONCE).
#
# ⚠ DECLINING IS NOT FREE. The pre-fix comment claimed "declining is always
# safe, never a silent drop"; the SILENT DROP half is still true (Core #10),
# but the SAFE half was measurably wrong — a decline downstream of an
# emitting `amp_object_base` used to make the chokepoint re-lower the WHOLE
# argument (`lower_expr(arg)`), evaluating the base twice. The write-place
# resolver now refuses to emit for a non-place base and the ReadGuard write
# arm, so the `MK / MK / …` class is closed.
# ⚠ A NARROW RESIDUAL survives: an `EIndex` base whose index expression has
# a side effect (`&v[side_effect_call()].pointer_storage_field`) emits the
# index via `lower_index_element_ptr_place` at the object arm above, then
# `lower_amp_place` may decline at a downstream predicate
# (`field_storage_holds_pointer`), triggering the caller's fallback
# `lower_expr(arg)` re-fire — so the index expression evaluates TWICE. The
# reservation-shape emissions (owned static's `__global_ref__`, nested
# EFieldAccess into a pointer-storage outer field) remain locally idempotent:
# they widen the generated locals, never the observable execution. The
# side-effecting-index cell is filed in TODO.md; a fix here belongs at the
# `field_storage_holds_pointer` predicate hoisted ahead of the `EIndex`
# emission (mirroring what BLOCKING 1's fold did for the object-domain arm).
#
# The `.field` arm is deliberately the SAME emission the field-READ arm uses
# for a resource field (`GIFieldLoad` into a `GtPtr(field)`-typed,
# `LoBorrowed` dst + `set_field_borrow`) — the read arm was already correct for
# resource fields and wrong only in that it gated the Ptr-typed dst on
# `is_resource_type_name`. A place is a place regardless of what is stored in
# it, so here the gate is absent. `set_field_borrow` keeps the borrow ORIGIN
# truthful: the resulting pointer is known to be field #i of the base, which is
# what the escaping-borrow validators read.
int lower_amp_place(LowerCtx &ctx, SpannedExpr arg, GirModule &gmod):
    match arg.expr:
        case EFieldAccess(ap_base_box, ap_field_name):
            match amp_object_base(&ctx, *ap_base_box, &gmod, true):
                case Some(ap_obj):
                    # Tuple `t.0` registers as `_0` (same normalisation the
                    # read arm and both write arms apply).
                    String ap_fname = normalize_tuple_digit_field(ap_field_name)
                    if not gmod.type_infos.contains(ap_obj.inner_name):
                        return -1
                    GirTypeInfo ap_info = gmod.type_infos.get(ap_obj.inner_name).unwrap()
                    int ap_fi = -1
                    String ap_ftn = ""
                    int ap_i = 0
                    while ap_i < ap_info.fields.len():
                        GirFieldInfo ap_f = ap_info.fields.get(ap_i).unwrap()
                        if ap_f.name == ap_fname:
                            ap_fi = ap_i
                            ap_ftn = ap_f.type_name.clone()
                            break
                        ap_i += 1
                    if ap_fi < 0:
                        return -1
                    # DECLINE: the field's storage already HOLDS a pointer
                    # (`Ref[T]`/`MutRef[T]`, or an opaque handle). `GIFieldLoad`
                    # deliberately loads the stored pointer for those rather
                    # than aliasing the cell, so what we could return is the
                    # POINTEE's address, not the place's. One predicate, shared
                    # with the LIR consumer so the two cannot drift.
                    if field_storage_holds_pointer(ap_obj.inner_name, ap_fi, &gmod):
                        return -1
                    int ap_fty = resolve_field_gir_type(ap_ftn, &gmod)
                    int ap_dst = add_local_with(&ctx, register_ptr(&gmod, ap_fty), None, LoBorrowed(), BoNone())
                    set_field_borrow(&ctx, ap_dst, ap_obj.inner_ptr_local, ap_fi)
                    emit(&ctx, GIFieldLoad(ap_dst, ap_obj.inner_ptr_local, ap_fi))
                    return ap_dst
                case None:
                    return -1
        case EIndex(ap_coll_box, ap_idx_box):
            # `&v[i]` / `&d[k]` — the element IS the place.
            return lower_index_element_ptr_place(&ctx, *ap_coll_box, *ap_idx_box, true, false, &gmod)
        case EDeref(ap_box_box):
            # `&*b` — the box VALUE is the heap address. Re-typed to GtPtr(T)
            # by the domain resolver so downstream consumers see a real struct
            # pointer rather than an unregistered `Box__T`.
            int ap_bl = lower_expr(&ctx, *ap_box_box, &gmod)
            if ap_bl < 0 or ap_bl >= ctx.locals.len():
                return -1
            String ap_bn = type_id_to_base_name(ctx.locals.get(ap_bl).unwrap().type_id, &gmod)
            match box_deref_ptr_base(&ctx, ap_bl, ap_bn, &gmod):
                case Some(ap_bx):
                    return ap_bx.inner_ptr_local
                case None:
                    return -1
        else:
            pass
    return -1

# Map a GIR type-id to the runtime C-struct name used for a spawn param/return
# slot in the SpawnCtx and the spawn helper signatures. String collapses to the
# runtime `GorgetString`; the collections (Vector/Dict/Set/Deque/Heap) collapse
# to their runtime struct (`GorgetArray`/`GorgetMap`/`GorgetSet`); scalars pass
# through as their plain C name. Mirrors the resolved-type routing the Rust
# backend performs in `emit_types.rs` (the spawned-fn ctx/run emit, ~418-440).
String spawn_runtime_c_name(int tid, GirModule &gmod):
    String nm = type_id_to_name(tid, &gmod)
    if nm == "String" or nm == "Str" or nm == "GorgetString":
        return "GorgetString"
    String rt = collection_runtime_type(nm, &gmod)
    if rt != "":
        return rt
    # KEYSTONE: an opaque carrier handle (Channel today; the spawn-shape gate
    # below admits no other opaque carrier yet) is stored as void* in the
    # self-host — no `Channel__T` typedef is emitted; methods route straight to
    # gorget_channel_*. Read the TYPED `opaque_handle` flag via
    # `is_opaque_pointer_type` (resource_meta_for → .opaque_handle), NOT a name
    # prefix (Core #2). Collections/String returned above, so the only
    # opaque-handle type that reaches here is one the gate let through.
    if is_opaque_pointer_type(nm, &gmod):
        return "void*"
    return nm

# ── Shared-variable carrier model (round-16 Phase 1) ────────────────
#
# Mirrors Rust gg's ArcMutex `lower_shared_var_decl` arm
# (`src/ir/lowering/stmts/mod.rs:1579-1630`) + the read/write facade
# (`src/ir/lowering/exprs/shared.rs`). A `shared int x = 0` mints a hidden
# CARRIER local of type `Shared__Mutex__<inner_c>` (a `gorget_shared` handle
# whose `data` holds a `gorget_mutex` over the inner value) and a facade
# local bound to the user name. Reads/writes route through the carrier's
# lock-chain. The mangled type names (`Mutex__c` / `Guard__c` /
# `Shared__Mutex__c`) are registered as named types so lower_type_defs wires
# their `type_method_prefix_map` entries (gorget_mutex / gorget_guard /
# gorget_shared), making every mangled GICall below route to the right
# runtime symbol via `map_runtime_name` — the SAME path `mutex_basic.gg`
# (a working snapshot) exercises for `counter.lock()`/`guard.get()`.

# Register the carrier's named types and return the carrier GIR type-id
# (a Ptr-to-Shared__Mutex__c). inner_c is the inner value's C type name
# (int64_t / bool / double).
int register_shared_carrier_type(GirModule &gmod, String inner_c):
    String mutex_mangled = "Mutex__" + inner_c
    String guard_mangled = "Guard__" + inner_c
    String shared_mangled = "Shared__Mutex__" + inner_c
    # Register all three named types so build_resource_metadata classifies
    # them and lower_type_defs writes their method-prefix map entries.
    lookup_or_register_named(&gmod, mutex_mangled)
    lookup_or_register_named(&gmod, guard_mangled)
    int shared_tid = lookup_or_register_named(&gmod, shared_mangled)
    # The carrier VALUE local holds a `Shared__Mutex__c` HANDLE — a pointer
    # typedef (GorgetShared*). Slot is a Ptr-to-named (a bare value slot
    # can't hold the handle), matching the Mutex/sync-ctor pattern at
    # lower_expr.gg:5897.
    return register_ptr(&gmod, shared_tid)

# Unwrap a Shared__Mutex__c carrier into the inner Mutex handle (a
# `GorgetMutex*`). Rust gg emits a per-type wrapper `Shared__Mutex__c__get`
# that does `*(Mutex__c*)gorget_shared_get_ptr(self)` (helpers.rs:251); the
# self-host has NO per-type wrappers, so we inline the same two steps:
#   raw = gorget_shared_get_ptr(carrier)   # void* AT the stored mutex pointer
#   mutex = *(Mutex__c*)raw                 # GIDeref loads the 8-byte handle
# `gorget_shared_get_ptr` is emitted via GICallExtern (NOT a mangled GICall)
# so it bypasses the collection-Option-lift gate (`is_collection_void_return`
# includes gorget_shared_get_ptr — that lift is for `Shared[T].get()`, not
# the carrier unwrap). Returns the Mutex-handle local.
int emit_shared_unwrap_mutex(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info):
    int mutex_tid = register_ptr(&gmod, lookup_or_register_named(&gmod, info.mutex_mangled))
    # raw void* AT the stored mutex pointer (a Ptr-to-Mutex-handle).
    int su_raw_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, info.mutex_mangled))
    int su_raw = add_local(&ctx, su_raw_ty, None)
    emit(&ctx, GICallExtern(su_raw, "gorget_shared_get_ptr", [OpCopy(info.hidden_local)]))
    # mutex = *(Mutex__c*)raw — load the 8-byte handle pointer.
    int su_mutex = add_local(&ctx, mutex_tid, None)
    emit(&ctx, GIDeref(su_mutex, su_raw, mutex_tid))
    return su_mutex

# Emit the lock-chain READ of a shared var's current value, returning a
# fresh local of the inner type. Mirrors Rust `emit_shared_mutex_lock_get`
# (`shared.rs:11-39`):
#   mv = unwrap(carrier)                  # -> Mutex handle (gorget_shared_get_ptr + deref)
#   g  = Mutex__c__lock(mv)               # -> guard value (gorget_mutex_lock)
#   gp = &g
#   val = Guard__c__get(gp)               # -> T (gorget_guard_get + deref)
#   Guard__c__drop(gp)                    # release (gorget_guard_release)
int emit_shared_mutex_lock_get(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info):
    int guard_tid = lookup_or_register_named(&gmod, info.guard_mangled)
    # 1. unwrap the carrier → the inner Mutex handle.
    int sg_mutex = emit_shared_unwrap_mutex(&ctx, &gmod, info)
    # 2. lock the mutex → a Guard value. Emitted as GICallExtern (mangled) so
    #    the lir_lower arg-shaping (the SAME path mutex_basic.gg's working
    #    `counter.lock()`/`guard.get()`/`set()` take) applies — GICall lacks
    #    the guard_set size-append + the guard_get deref-lift.
    int sg_guard = add_local(&ctx, guard_tid, None)
    emit(&ctx, GICallExtern(sg_guard, info.mutex_mangled + "__lock", [OpCopy(sg_mutex)]))
    # 3. read the guarded value (Guard__c__get borrows &g, routes to
    #    gorget_guard_get which the arg-shaping derefs once for a scalar).
    int sg_val = add_local(&ctx, info.inner_type, None)
    emit(&ctx, GICallExtern(sg_val, info.guard_mangled + "__get", [OpBorrow(sg_guard)]))
    # 4. release the lock (Guard__c__drop → gorget_guard_release).
    emit(&ctx, GICallExtern(-1, info.guard_mangled + "__drop", [OpBorrow(sg_guard)]))
    return sg_val

# Emit the lock-chain WRITE of `value_local` into a shared var. Mirrors Rust
# `emit_shared_mutex_lock_set` (`shared.rs:42-69`).
void emit_shared_mutex_lock_set(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info, int value_local):
    int guard_tid = lookup_or_register_named(&gmod, info.guard_mangled)
    int ss_mutex = emit_shared_unwrap_mutex(&ctx, &gmod, info)
    int ss_guard = add_local(&ctx, guard_tid, None)
    emit(&ctx, GICallExtern(ss_guard, info.mutex_mangled + "__lock", [OpCopy(ss_mutex)]))
    # Guard__c__set(&g, value) → gorget_guard_set(&g, &value, sizeof(T)) (the
    # arg-shaping in lir_lower address-takes the value + appends sizeof).
    emit(&ctx, GICallExtern(-1, info.guard_mangled + "__set", [OpBorrow(ss_guard), OpCopy(value_local)]))
    emit(&ctx, GICallExtern(-1, info.guard_mangled + "__drop", [OpBorrow(ss_guard)]))

# ── shared(<sync>) override strategies (round-33) ────────────────
# The rwlock/atomic carriers below mirror Rust gg's ArcRwLock / ArcAtomic
# arms (`src/ir/lowering/stmts/mod.rs:1450-1578`) and the per-kind
# read/write emitters (`src/ir/lowering/exprs/shared.rs:86-200`).

# Atomic wrapper type name for an inner GIR type (Rust `atomic_type_name_for`,
# shared.rs:203). Bool → AtomicBool, every other scalar → AtomicInt.
String atomic_mangled_for(int inner_ty):
    if inner_ty == BOOL_TYPE:
        return "AtomicBool"
    return "AtomicInt"

# Runtime symbol family for the atomic carrier. The C-emit boundary spells
# the runtime symbol (layering exception: the name IS the runtime contract);
# selection is driven by the TYPED inner_type, not a name match.
String atomic_runtime_prefix(int inner_ty):
    if inner_ty == BOOL_TYPE:
        return "gorget_atomic_bool"
    return "gorget_atomic_int"

# Register the RWLock carrier's named types and return the carrier GIR
# type-id (a Ptr-to-RWLock__c). Registers BOTH guard types up front —
# `ReadGuard__c` AND `WriteGuard__c` — whenever the facade is minted,
# regardless of which accessor user code exercises. This mirrors Rust gg's
# forced double-registration in the ArcRwLock arm (`stmts/mod.rs:1540-1546`,
# the R2 lesson): the 16-byte by-value guard returns need their C typedefs
# in module.structs, or the slot falls back to void* (8B) and the runtime's
# 16-byte guard write stack-buffer-overflows.
int register_rwlock_carrier_type(GirModule &gmod, String inner_c):
    String rw_mangled = "RWLock__" + inner_c
    lookup_or_register_named(&gmod, "ReadGuard__" + inner_c)
    lookup_or_register_named(&gmod, "WriteGuard__" + inner_c)
    int rw_tid = lookup_or_register_named(&gmod, rw_mangled)
    return register_ptr(&gmod, rw_tid)

# Register the atomic carrier's named type and return the carrier GIR
# type-id (a Ptr-to-AtomicInt/AtomicBool handle).
int register_atomic_carrier_type(GirModule &gmod, int inner_ty):
    int at_tid = lookup_or_register_named(&gmod, atomic_mangled_for(inner_ty))
    return register_ptr(&gmod, at_tid)

# Emit the guard-chain READ of a shared(rwlock) var, returning a fresh local
# of the inner type. Mirrors Rust `emit_rwlock_read_get` (shared.rs:112-134):
#   g   = RWLock__c__read(carrier)      # gorget_rwlock_read → 16-byte guard
#   val = ReadGuard__c__get(&g)         # gorget_read_guard_get + deref
#   ReadGuard__c__drop(&g)              # gorget_read_guard_release
int emit_rwlock_read_get(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info):
    String rg_mangled = "ReadGuard__" + info.inner_c
    int rg_guard_tid = lookup_or_register_named(&gmod, rg_mangled)
    int rg_guard = add_local(&ctx, rg_guard_tid, None)
    emit(&ctx, GICallExtern(rg_guard, "RWLock__" + info.inner_c + "__read", [OpCopy(info.hidden_local)]))
    int rg_val = add_local(&ctx, info.inner_type, None)
    emit(&ctx, GICallExtern(rg_val, rg_mangled + "__get", [OpBorrow(rg_guard)]))
    emit(&ctx, GICallExtern(-1, rg_mangled + "__drop", [OpBorrow(rg_guard)]))
    return rg_val

# Emit the guard-chain WRITE of a shared(rwlock) var. Mirrors Rust
# `emit_rwlock_write_set` (shared.rs:136-159).
void emit_rwlock_write_set(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info, int value_local):
    String wg_mangled = "WriteGuard__" + info.inner_c
    int wg_guard_tid = lookup_or_register_named(&gmod, wg_mangled)
    int wg_guard = add_local(&ctx, wg_guard_tid, None)
    emit(&ctx, GICallExtern(wg_guard, "RWLock__" + info.inner_c + "__write", [OpCopy(info.hidden_local)]))
    emit(&ctx, GICallExtern(-1, wg_mangled + "__set", [OpBorrow(wg_guard), OpCopy(value_local)]))
    emit(&ctx, GICallExtern(-1, wg_mangled + "__drop", [OpBorrow(wg_guard)]))

# Emit the atomic LOAD of a shared(atomic) var (Rust `emit_atomic_load`,
# shared.rs:86). Direct runtime symbol — same GICallExtern idiom as
# `gorget_shared_get_ptr` in the carrier unwrap above.
int emit_atomic_load(LowerCtx &ctx, GirModule gmod, SharedLocalInfo info):
    int al_val = add_local(&ctx, info.inner_type, None)
    emit(&ctx, GICallExtern(al_val, atomic_runtime_prefix(info.inner_type) + "_load", [OpCopy(info.hidden_local)]))
    return al_val

# Emit the atomic STORE of a shared(atomic) var (Rust `emit_atomic_store`,
# shared.rs:99).
void emit_atomic_store(LowerCtx &ctx, GirModule gmod, SharedLocalInfo info, int value_local):
    emit(&ctx, GICallExtern(-1, atomic_runtime_prefix(info.inner_type) + "_store", [OpCopy(info.hidden_local), OpCopy(value_local)]))

# Kind-dispatched transparent READ of a shared var's current value. ONE
# producer for every consumer site (EIdentifier read, `with x:` refresh,
# compound-assign current-value) — Core #4: new kinds extend HERE, not at
# each site. Mirrors Rust gg's Identifier-arm dispatch (exprs/mod.rs:115-139).
int emit_shared_read(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info):
    if info.kind == SHK_RWLOCK:
        return emit_rwlock_read_get(&ctx, &gmod, info)
    if info.kind == SHK_ATOMIC:
        return emit_atomic_load(&ctx, gmod, info)
    return emit_shared_mutex_lock_get(&ctx, &gmod, info)

# Kind-dispatched transparent WRITE (SAssign site). Mirrors Rust gg's
# plain-assign dispatch (stmts/assigns.rs:31-56).
void emit_shared_write(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info, int value_local):
    if info.kind == SHK_RWLOCK:
        emit_rwlock_write_set(&ctx, &gmod, info, value_local)
        return
    if info.kind == SHK_ATOMIC:
        emit_atomic_store(&ctx, gmod, info, value_local)
        return
    emit_shared_mutex_lock_set(&ctx, &gmod, info, value_local)

# Kind-dispatched COMPOUND assign (`x <op>= rhs`). Returns the new-value
# local (the caller syncs the defensive facade slot from it). Mirrors Rust
# gg's compound dispatch (stmts/assigns.rs:1015-1105):
#   Atomic  += / -= → native fetch-add/sub (lock-free); other ops load-op-store.
#   RwLock  one WRITE lock held across get-op-set (write_get/write_finish).
#   Mutex   lock-get → op → lock-set (each re-locks; the existing shape).
int emit_shared_compound(LowerCtx &ctx, GirModule &gmod, SharedLocalInfo info, String op, int rhs_local):
    if info.kind == SHK_ATOMIC:
        String at_pfx = atomic_runtime_prefix(info.inner_type)
        if op == "+=" or op == "-=":
            String at_fn = at_pfx + "_add"
            if op == "-=":
                at_fn = at_pfx + "_sub"
            # fetch_add/fetch_sub returns the OLD value; the facade wants the
            # NEW one — re-load after the RMW (matches the read-refresh model;
            # Rust discards the return entirely, assigns.rs:1052-1060).
            int at_old = add_local(&ctx, info.inner_type, None)
            emit(&ctx, GICallExtern(at_old, at_fn, [OpCopy(info.hidden_local), OpCopy(rhs_local)]))
            return emit_atomic_load(&ctx, gmod, info)
        int at_cur = emit_atomic_load(&ctx, gmod, info)
        int at_dst = add_local(&ctx, info.inner_type, None)
        emit_compound_arith(&ctx, op, at_dst, at_cur, rhs_local, info.inner_type, &gmod)
        emit_atomic_store(&ctx, gmod, info, at_dst)
        return at_dst
    if info.kind == SHK_RWLOCK:
        # ONE write lock across the read-modify-write (Rust emit_rwlock_
        # write_get + write_finish, shared.rs:162-200).
        String cwg_mangled = "WriteGuard__" + info.inner_c
        int cwg_guard_tid = lookup_or_register_named(&gmod, cwg_mangled)
        int cwg_guard = add_local(&ctx, cwg_guard_tid, None)
        emit(&ctx, GICallExtern(cwg_guard, "RWLock__" + info.inner_c + "__write", [OpCopy(info.hidden_local)]))
        int cwg_cur = add_local(&ctx, info.inner_type, None)
        emit(&ctx, GICallExtern(cwg_cur, cwg_mangled + "__get", [OpBorrow(cwg_guard)]))
        int cwg_dst = add_local(&ctx, info.inner_type, None)
        emit_compound_arith(&ctx, op, cwg_dst, cwg_cur, rhs_local, info.inner_type, &gmod)
        emit(&ctx, GICallExtern(-1, cwg_mangled + "__set", [OpBorrow(cwg_guard), OpCopy(cwg_dst)]))
        emit(&ctx, GICallExtern(-1, cwg_mangled + "__drop", [OpBorrow(cwg_guard)]))
        return cwg_dst
    int mx_cur = emit_shared_mutex_lock_get(&ctx, &gmod, info)
    int mx_dst = add_local(&ctx, info.inner_type, None)
    emit_compound_arith(&ctx, op, mx_dst, mx_cur, rhs_local, info.inner_type, &gmod)
    emit_shared_mutex_lock_set(&ctx, &gmod, info, mx_dst)
    return mx_dst

# Is this param/return type-id a shape the named-fn spawn lowering fully handles?
# Supported: scalar (< PRIM_COUNT, by-value) OR String OR a runtime collection
# (Vector/Dict/Set/Deque/Heap → GorgetArray/GorgetMap/GorgetSet, passed by-ptr).
# Unsupported (the gate returns -1 → bare passthrough): opaque/sync/refcounted
# carriers (Shared/Mutex/AtomicInt/Channel/Semaphore/…), structs, and enums —
# those need is_opaque→void*, clone_params, and per-param by-value-vs-ptr
# resolution that the named-fn spawn path does not yet carry. A precise positive
# allow-list (not a bare ">= PRIM_COUNT relax") is load-bearing: relaxing it
# regresses those carriers to an `unknown type name` C-emit failure.
bool spawn_shape_supported(int tid, GirModule &gmod):
    if tid < PRIM_COUNT:
        return true
    String nm = type_id_to_name(tid, &gmod)
    if nm == "String" or nm == "Str" or nm == "GorgetString":
        return true
    String rt = collection_runtime_type(nm, &gmod)
    if rt == "GorgetArray" or rt == "GorgetMap" or rt == "GorgetSet":
        return true
    # Accept a spawn-supported CARRIER param — the Channel carrier (Inc-keystone)
    # and the Shared__Mutex carrier (round-16 shared-spawn). Both have the
    # clone_params retain/release + by-void* ctx plumbing wired; the OTHER opaque
    # carriers (Mutex / RWLock / Semaphore / AtomicInt) do NOT and would regress
    # to an `unknown type name` C-emit failure (RWLock is spawned in
    # async_rwlock / shared_rwlock / stress_rwlock_*; AtomicInt in
    # stress_atomic_hammer; Semaphore in semaphore_basic).
    #
    # TYPED gate (Core #2): `spawn_supported_carrier` reads the carrier's
    # `method_prefix` metadata VALUE (gorget_channel / gorget_shared) — the
    # SAME typed-value dispatch `drop_fn_for_type` / `register_owning_opaque_local`
    # use — NOT a Channel/Shared mangled-name prefix test (which would
    # decide spawn-supportedness from the mangled name). This retires the former
    # interim Channel-prefix name-gate (lint budget 79→78). It does NOT
    # over-admit: `is_opaque_pointer_type` (.opaque_handle) lets Mutex/RWLock/
    # Semaphore through, and `is_refcounted_carrier` (CsRefCounted) lets
    # AtomicInt/Semaphore/Weak through — matching on the two supported
    # method_prefix VALUES admits exactly Channel + Shared. (RWLock is now
    # CsResource, not CsRefCounted — Inc-B a1331b4d reclassified it.)
    return spawn_supported_carrier(nm, &gmod)

# Typed predicate: is `nm` a CARRIER the named-fn / shared spawn path fully
# supports (Channel or Shared)? Reads the `method_prefix` metadata VALUE via
# resource_meta_for — a typed single-source dispatch, NOT a name-prefix test.
bool spawn_supported_carrier(String nm, GirModule &gmod):
    match resource_meta_for(&gmod, nm):
        case Some(rmeta):
            match rmeta.method_prefix:
                case Some(mp):
                    if mp == "gorget_channel" or mp == "gorget_shared":
                        return true
                case None:
                    pass
        case None:
            pass
    return false

# Lower a NAMED-function async spawn `spawn f(args)`. Supports scalar+void
# returns, String/collection returns, and scalar/String/collection params (the
# `spawn_shape_supported` allow-list); opaque/sync/struct/enum shapes roll to a
# later increment. Mirrors Rust gg's named-fn spawn path
# (`src/ir/lowering/exprs/mod.rs:1388-1405`):
#   • register the producer fn (push a deduped SpawnFnRec carrying the C
#     return type + per-param C type names) so the GIR→LIR copy builds the
#     LirSpawnedFn that emit_spawn_helpers consumes;
#   • set `ctx.pending_spawn_fn` (the SVarDecl that binds this spawn result
#     deposits it into `result_locals[var_local]` — the load-bearing keying);
#   • register `task_type_fns[Task__<ret_c>]` (deduped) for the type-based
#     await fallback;
#   • register the `Task__<ret_c>` named type (the SAME ret_c string the
#     helpers spell) so emit_mono_typedefs emits a matching typedef;
#   • lower the args and emit `__gorget_spawn_<fn>(args)` into a Task-typed dst.
# Returns -1 (sentinel) when the spawn is OUT of scope — the caller then falls
# back to the bare passthrough (which keeps the pre-spawn-lowering WRONG-output
# behavior, NOT a regression to a fresh cc-fail). An unsupported return type or
# ANY unsupported param shape (see `spawn_shape_supported`) triggers the -1.
int lower_named_fn_spawn(LowerCtx &ctx, String spawn_fn_name, Vector[SpannedExpr] spawn_args, GirModule &gmod):
    # Producer return type. Prefer the REAL GIR-function return type (fn_sigs
    # mis-records a String/collection return as I64_TYPE in the pre-scan, so it
    # cannot distinguish a String return from an int one) — fall back to
    # fn_sigs only when the callee is not yet in gmod.functions (forward ref).
    int spawn_ret_ty = I64_TYPE
    bool spawn_ret_found = false
    int spfi = 0
    while spfi < gmod.functions.len():
        if gmod.functions.get(spfi).unwrap().name == spawn_fn_name:
            spawn_ret_ty = gmod.functions.get(spfi).unwrap().return_type
            spawn_ret_found = true
            spfi = gmod.functions.len()
        else:
            spfi += 1
    if not spawn_ret_found and gmod.fn_sigs.contains(spawn_fn_name):
        spawn_ret_ty = gmod.fn_sigs.get(spawn_fn_name).unwrap()
    # Scope gate (return): unit OR a supported shape (scalar / String / runtime
    # collection). Opaque/sync/struct/enum returns are out of scope → passthrough.
    if spawn_ret_ty != UNIT_TYPE and not spawn_shape_supported(spawn_ret_ty, &gmod):
        return -1
    String spawn_ret_c = "void"
    if spawn_ret_ty != UNIT_TYPE:
        spawn_ret_c = spawn_runtime_c_name(spawn_ret_ty, &gmod)
    String spawn_task_name = "Task__" + spawn_ret_c
    # Scope gate (params): every param must be a supported shape. Record the
    # runtime C-struct name (String → GorgetString, Vector → GorgetArray, scalar
    # → scalar); the by-value-vs-by-ptr emit split is handled in
    # emit_spawn_helpers (collections/String pass by-ptr, scalars by-value).
    Vector[String] spawn_param_ctys = []
    Vector[int] spawn_param_tys = get_fn_param_types(spawn_fn_name, gmod)
    int sppi = 0
    while sppi < spawn_param_tys.len():
        int sp_pty = spawn_param_tys.get(sppi).unwrap()
        if not spawn_shape_supported(sp_pty, &gmod):
            return -1
        spawn_param_ctys.push(spawn_runtime_c_name(sp_pty, &gmod))
        sppi += 1
    # Register the spawn fn (dedup by fn_name — a fn spawned twice emits one
    # helper set).
    bool spawn_already = false
    for sfr in gmod.spawned_fns:
        if sfr.fn_name == spawn_fn_name:
            spawn_already = true
    if not spawn_already:
        gmod.spawned_fns.push(SpawnFnRec(spawn_fn_name.clone(), spawn_ret_c.clone(), !spawn_param_ctys))
    # Deposit marker — the binding SVarDecl consumes it into result_locals.
    ctx.pending_spawn_fn = spawn_fn_name.clone()
    # Register the Task type → producer fn (deduped: N spawns of the SAME fn
    # collapse to len 1; two DISTINCT producers of the same Task type stay
    # len 2 so the await type-fallback's len()==1 gate correctly doesn't fire).
    Vector[String] spawn_ttf = []
    if ctx.task_type_fns.contains(spawn_task_name):
        spawn_ttf = ctx.task_type_fns.get(spawn_task_name).unwrap()
    bool spawn_ttf_has = false
    for ttf_fn in spawn_ttf:
        if ttf_fn == spawn_fn_name:
            spawn_ttf_has = true
    if not spawn_ttf_has:
        spawn_ttf.push(spawn_fn_name.clone())
    ctx.task_type_fns.put(spawn_task_name, !spawn_ttf)
    # Register the Task named type (the SAME ret_c string the helpers spell)
    # so emit_mono_typedefs emits a typedef whose name matches the helper
    # symbols. Mirrors the thread arm's `lookup_or_register_named(&gmod,
    # "Thread__" + ts_ret_name)`.
    int spawn_task_ty = lookup_or_register_named(&gmod, spawn_task_name)
    # Lower the spawn-call args (scalar by-value in Inc-1) and emit the call.
    Vector[Operand] spawn_call_args = []
    for spawn_arg in spawn_args:
        int spawn_arg_local = lower_expr(&ctx, spawn_arg, &gmod)
        spawn_call_args.push(op_consume(ctx, &gmod, spawn_arg_local, CkCallArgBorrow()))
    int spawn_dst = add_local(&ctx, spawn_task_ty, None)
    emit(&ctx, GICall(spawn_dst, "__gorget_spawn_" + spawn_fn_name, spawn_call_args))
    return spawn_dst

# ── Shared-spawn deferral + token wrapper (round-16 Phase 1) ─────────
#
# `spawn worker(&x)` where x is a `shared` var must NOT pass a producer-stack
# pointer to the worker (a data race / UAF). Instead it passes the refcounted
# CARRIER (Shared__Mutex__T) by value; the worker, inside a synthesized
# `__shared_token_<worker>` wrapper, LOCKS the carrier, derives the inner
# mut-ptr, calls the real worker, then unlocks. Mirrors Rust gg's
# `build_shared_token_wrapper` (`src/ir/lowering/exprs/spawn.rs:523`) + the
# spawn-site collection (`exprs/mod.rs:1196-1399`). The carrier is refcount-
# cloned into the spawn ctx before SUBMIT (clone_params, already wired for
# Shared__ via is_refcounted_carrier) so the worker owns its own strong ref.
# This is the SOUNDNESS keystone (Core #8): the worker locks; no stack pointer
# crosses the thread boundary.

# Build the `__shared_token_<callee>` GIR wrapper. Its params mirror the
# callee's, EXCEPT each shared-arg slot is the carrier Ptr type. The body
# (one straight-line block) locks all carriers in ascending decl_order,
# derives each inner mut-ptr via Guard__c__get_ptr, calls the real callee,
# then drops the guards in reverse order. Mirrors spawn.rs:534-726.
void build_shared_token_wrapper(GirModule &gmod, String wrapper_name, String callee_name, Vector[int] callee_param_types, Vector[int] shared_arg_indices, Vector[SharedLocalInfo] shared_arg_infos, int callee_ret_ty):
    Vector[GirLocal] tw_locals = []
    Vector[Instruction] tw_insts = []
    # _0 = return place (UNIT for void callees — the Phase-1 callees are void).
    tw_locals.push(GirLocal(callee_ret_ty, None, LoOwned(), BoNone(), false))
    # _1.._N = params. A shared-arg slot becomes the carrier Ptr type; every
    # other slot keeps the callee's param type.
    Vector[int] tw_param_types = []
    int twp = 0
    while twp < callee_param_types.len():
        int tw_slot_ty = callee_param_types.get(twp).unwrap()
        int tw_shared_pos = -1
        int twsi = 0
        while twsi < shared_arg_indices.len():
            if shared_arg_indices.get(twsi).unwrap() == twp:
                tw_shared_pos = twsi
            twsi += 1
        if tw_shared_pos >= 0:
            tw_slot_ty = shared_arg_infos.get(tw_shared_pos).unwrap().carrier_type
        tw_param_types.push(tw_slot_ty)
        tw_locals.push(GirLocal(tw_slot_ty, None, LoParam(), BoParam(-1), false))
        twp += 1
    # Local-id allocator: next free id after _0 + params.
    int tw_next = callee_param_types.len() + 1
    # Phase 1 — lock-all in ascending decl_order; collect (param_local,
    # guard_ptr_local) per shared arg, and the inner-ptr operand for the call.
    # We process shared args in their decl_order; build a parallel list of the
    # guard locals so Phase 3 can drop them in reverse.
    Vector[int] tw_guard_locals = []
    Vector[int] tw_guard_order = []
    # call_inner_ptr[arg_index] holds the inner mut-ptr local for a shared arg.
    Dict[int, int] tw_inner_ptr_for_arg = {}
    # Sort shared args by decl_order (ascending). Small N — insertion order is
    # usually already ascending, but sort to honor the lock-ordering contract.
    Vector[int] tw_sorted = []
    int twso = 0
    while twso < shared_arg_indices.len():
        tw_sorted.push(twso)
        twso += 1
    # simple selection sort by decl_order
    int tssi = 0
    while tssi < tw_sorted.len():
        int tssj = tssi + 1
        while tssj < tw_sorted.len():
            int a_idx = tw_sorted.get(tssi).unwrap()
            int b_idx = tw_sorted.get(tssj).unwrap()
            if shared_arg_infos.get(b_idx).unwrap().decl_order < shared_arg_infos.get(a_idx).unwrap().decl_order:
                tw_sorted.set(tssi, b_idx)
                tw_sorted.set(tssj, a_idx)
            tssj += 1
        tssi += 1
    int twk = 0
    while twk < tw_sorted.len():
        int sh_k = tw_sorted.get(twk).unwrap()
        SharedLocalInfo sh_info = shared_arg_infos.get(sh_k).unwrap()
        int sh_arg_idx = shared_arg_indices.get(sh_k).unwrap()
        int sh_param_local = sh_arg_idx + 1
        # mutex_ptr = *(Mutex__c*)gorget_shared_get_ptr(carrier_param)
        int tw_mutex_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, sh_info.mutex_mangled))
        int tw_raw = tw_next
        tw_next += 1
        tw_locals.push(GirLocal(tw_mutex_ptr_ty, None, LoOwned(), BoNone(), false))
        tw_insts.push(GICallExtern(tw_raw, "gorget_shared_get_ptr", [OpCopy(sh_param_local)]))
        int tw_mutex = tw_next
        tw_next += 1
        tw_locals.push(GirLocal(tw_mutex_ptr_ty, None, LoOwned(), BoNone(), false))
        tw_insts.push(GIDeref(tw_mutex, tw_raw, tw_mutex_ptr_ty))
        # guard = Mutex__c__lock(mutex_ptr)
        int tw_guard_ty = lookup_or_register_named(&gmod, sh_info.guard_mangled)
        int tw_guard = tw_next
        tw_next += 1
        tw_locals.push(GirLocal(tw_guard_ty, None, LoOwned(), BoNone(), false))
        tw_insts.push(GICallExtern(tw_guard, sh_info.mutex_mangled + "__lock", [OpCopy(tw_mutex)]))
        tw_guard_locals.push(tw_guard)
        tw_guard_order.push(sh_k)
        # inner_ptr = Guard__c__get_ptr(&guard)  — a MutPtr(inner) the callee
        # receives as its `&counter` arg.
        int tw_inner_ptr_ty = register_type(&gmod, GtMutPtr(sh_info.inner_type))
        int tw_inner_ptr = tw_next
        tw_next += 1
        tw_locals.push(GirLocal(tw_inner_ptr_ty, None, LoOwned(), BoNone(), false))
        tw_insts.push(GICallExtern(tw_inner_ptr, sh_info.guard_mangled + "__get_ptr", [OpBorrow(tw_guard)]))
        tw_inner_ptr_for_arg.put(sh_arg_idx, tw_inner_ptr)
        twk += 1
    # Phase 2 — call the real callee. Build args in parameter order: a shared
    # slot passes its inner mut-ptr; a non-shared slot passes the param local.
    Vector[Operand] tw_call_args = []
    int twc = 0
    while twc < callee_param_types.len():
        if tw_inner_ptr_for_arg.contains(twc):
            tw_call_args.push(OpCopy(tw_inner_ptr_for_arg.get(twc).unwrap()))
        else:
            tw_call_args.push(OpCopy(twc + 1))
        twc += 1
    if callee_ret_ty == UNIT_TYPE:
        tw_insts.push(GICall(-1, callee_name, tw_call_args))
    else:
        tw_insts.push(GICall(0, callee_name, tw_call_args))
    # Phase 3 — unlock-all in REVERSE acquisition order.
    int twg = tw_guard_locals.len() - 1
    while twg >= 0:
        int rev_guard = tw_guard_locals.get(twg).unwrap()
        int rev_k = tw_guard_order.get(twg).unwrap()
        SharedLocalInfo rev_info = shared_arg_infos.get(rev_k).unwrap()
        tw_insts.push(GICallExtern(-1, rev_info.guard_mangled + "__drop", [OpBorrow(rev_guard)]))
        twg -= 1
    # Assemble the one-block function + Return.
    Operand tw_ret_op = OpConstUnit()
    if callee_ret_ty != UNIT_TYPE:
        tw_ret_op = OpCopy(0)
    Vector[BasicBlock] tw_blocks = [BasicBlock(!tw_insts, GTReturn(tw_ret_op))]
    gmod.functions.push(GirFunction(wrapper_name, !tw_param_types, callee_ret_ty, !tw_locals, !tw_blocks, [], []))

# ── round-16 Phase-2: the `__shared_async_<callee>` await-splice (GIR→GIR) ──
#
# Mirrors Rust gg's `inject_shared_token_management`
# (`src/ir/transforms/shared_async.rs:106`): take the ALREADY-LOWERED async
# callee's GIR, clone it, and surgically rewrite it so the shared param is the
# refcounted carrier and the lock is RELEASED before every suspension and
# REACQUIRED after — never held across an `await`/`sleep` (Core #8). The
# self-host emits the SAME lock-chain shape as `build_shared_token_wrapper`
# (gorget_shared_get_ptr + deref + Mutex__lock + Guard__get_ptr/__drop), NOT the
# Rust per-type `Shared__get` wrapper (the self-host has none).

# Substitute local id `from_id` → `to_id` inside a single Operand.
Operand remap_op_local(Operand op, int from_id, int to_id):
    match op:
        case OpCopy(l):
            if l == from_id:
                return OpCopy(to_id)
            return op
        case OpMove(l):
            if l == from_id:
                return OpMove(to_id)
            return op
        case OpClone(l):
            if l == from_id:
                return OpClone(to_id)
            return op
        case OpBorrow(l):
            if l == from_id:
                return OpBorrow(to_id)
            return op
        case OpSizeOf(l):
            if l == from_id:
                return OpSizeOf(to_id)
            return op
        else:
            return op

# Substitute one local id inside a single Instruction (all local-carrying
# fields). Type-id / op-code / field-index ints are LEFT ALONE. Operand-vector
# instructions (GICall/GICallExtern) remap each arg.
Instruction remap_inst_local(Instruction inst, int from_id, int to_id):
    match inst:
        case GIAssign(dst, v):
            int nd = dst
            if dst == from_id:
                nd = to_id
            return GIAssign(nd, remap_op_local(v, from_id, to_id))
        case GIBinOp(dst, opc, ty, lhs, rhs):
            int nd = dst
            if dst == from_id:
                nd = to_id
            return GIBinOp(nd, opc, ty, remap_op_local(lhs, from_id, to_id), remap_op_local(rhs, from_id, to_id))
        case GIFaultCheck(dst, fop, ty, lhs, rhs):
            int nd = dst
            if dst == from_id:
                nd = to_id
            return GIFaultCheck(nd, fop, ty, remap_op_local(lhs, from_id, to_id), remap_op_local(rhs, from_id, to_id))
        case GIUnOp(dst, opc, ty, operand):
            int nd = dst
            if dst == from_id:
                nd = to_id
            return GIUnOp(nd, opc, ty, remap_op_local(operand, from_id, to_id))
        case GICmp(dst, opc, ty, lhs, rhs):
            int nd = dst
            if dst == from_id:
                nd = to_id
            return GICmp(nd, opc, ty, remap_op_local(lhs, from_id, to_id), remap_op_local(rhs, from_id, to_id))
        case GICall(dst, name, args):
            int nd = dst
            if dst == from_id:
                nd = to_id
            Vector[Operand] na = []
            for a in args:
                na.push(remap_op_local(a, from_id, to_id))
            return GICall(nd, name, !na)
        case GICallExtern(dst, name, args):
            int nd = dst
            if dst == from_id:
                nd = to_id
            Vector[Operand] na = []
            for a in args:
                na.push(remap_op_local(a, from_id, to_id))
            return GICallExtern(nd, name, !na)
        case GIDrop(l):
            if l == from_id:
                return GIDrop(to_id)
            return inst
        case GIDropIfAlive(l):
            if l == from_id:
                return GIDropIfAlive(to_id)
            return inst
        case GIMoveZero(l):
            if l == from_id:
                return GIMoveZero(to_id)
            return inst
        case GIDeref(dst, src, ity):
            int nd = dst
            if dst == from_id:
                nd = to_id
            int ns = src
            if src == from_id:
                ns = to_id
            return GIDeref(nd, ns, ity)
        case GICast(dst, src, fty, tty):
            int nd = dst
            if dst == from_id:
                nd = to_id
            int ns = src
            if src == from_id:
                ns = to_id
            return GICast(nd, ns, fty, tty)
        case GIFieldLoad(dst, base, fidx):
            int nd = dst
            if dst == from_id:
                nd = to_id
            int nb = base
            if base == from_id:
                nb = to_id
            return GIFieldLoad(nd, nb, fidx)
        case GIDerefStore(ptr, v, ity):
            int np = ptr
            if ptr == from_id:
                np = to_id
            return GIDerefStore(np, remap_op_local(v, from_id, to_id), ity)
        else:
            return inst

# Substitute one local id inside a Terminator (only GTReturn/GTBranch carry
# Operands).
Terminator remap_term_local(Terminator term, int from_id, int to_id):
    match term:
        case GTReturn(op):
            return GTReturn(remap_op_local(op, from_id, to_id))
        case GTBranch(op, t, f):
            return GTBranch(remap_op_local(op, from_id, to_id), t, f)
        else:
            return term

# Emit the lock-acquire chain for one shared carrier into `out`, re-deriving
# into the SAME pre-allocated slots (raw/mutex/guard/facade). Used at the entry
# preamble AND at every reacquire after a suspension. Self-host convention
# (mirrors emit_shared_unwrap_mutex + emit_shared_mutex_lock_get's get_ptr form):
#   raw  = gorget_shared_get_ptr(copy carrier_param)   ; *Mutex
#   mtx  = deref raw                                    ; Mutex handle
#   grd  = Mutex__c__lock(copy mtx)                     ; Guard
#   fac  = Guard__c__get_ptr(borrow grd)                ; *mut inner  (→ facade)
void emit_async_lock_acquire(GirModule gmod, Vector[Instruction] &out, int carrier_param, SharedLocalInfo info, int raw_local, int mutex_local, int guard_local, int facade_local, int mutex_ptr_ty):
    out.push(GICallExtern(raw_local, "gorget_shared_get_ptr", [OpCopy(carrier_param)]))
    out.push(GIDeref(mutex_local, raw_local, mutex_ptr_ty))
    out.push(GICallExtern(guard_local, info.mutex_mangled + "__lock", [OpCopy(mutex_local)]))
    out.push(GICallExtern(facade_local, info.guard_mangled + "__get_ptr", [OpBorrow(guard_local)]))

# Detect + lower a `spawn callee(args)` that passes ≥1 shared mut-borrow.
# Returns the spawn dst local, or -1 if no shared arg (caller falls back to
# the normal named-fn spawn / passthrough). Mirrors the spawn-site shared
# collection at Rust `exprs/mod.rs:1196-1399`.
# round-16 Phase-2: lower a `spawn callee(&param)` INSIDE a function whose
# `&param` is a mutable-borrow PARAM (traces back to a shared carrier in the
# enclosing async variant). At THIS lowering the enclosing param is still a
# `*mut T` (the carrier retype happens in the post-pass), so we emit a REAL
# `__gorget_spawn_<callee>(value)` + `__gorget_await_<callee>` (matching the
# untransformed-template `@reader` in the Rust oracle) AND record an
# `InnerSharedSpawn` so the post-pass rewrites the CLONE to forward the carrier
# through `__shared_token_<callee>`. Returns the spawn dst, or -1 if no `&param`
# arg (caller falls through to the normal spawn paths). Mirrors Rust gg's inner-
# spawn collection (`exprs/mod.rs`) + `InnerSpawnRewrite` (`shared_async.rs:72`).
int lower_inner_shared_spawn(LowerCtx &ctx, String callee_name, Vector[SpannedExpr] spawn_args, GirModule &gmod):
    # Collect (call-arg index, enclosing-param index) for each `&param` arg whose
    # param is a mutable-borrow param of THIS function.
    Vector[int] iss_call_indices = []
    Vector[int] iss_param_indices = []
    int isi = 0
    while isi < spawn_args.len():
        String iss_ident = ""
        match spawn_args.get(isi).unwrap().expr:
            case EMutableBorrow(iss_inner):
                match (*iss_inner).expr:
                    case EIdentifier(iss_n):
                        iss_ident = iss_n
                    else:
                        pass
            case EIdentifier(iss_n2):
                iss_ident = iss_n2
            else:
                pass
        if iss_ident != "" and not ctx.shared_locals.contains(iss_ident) and nl_contains(ctx, iss_ident):
            int iss_plocal = nl_get(ctx, iss_ident)
            if is_mut_borrow_param_local(ctx, gmod, iss_plocal):
                # The enclosing-param index is (param_local - 1) (locals[0] = ret).
                iss_call_indices.push(isi)
                iss_param_indices.push(iss_plocal - 1)
        isi += 1
    if iss_call_indices.len() == 0:
        return -1
    # Callee must be a void-or-scalar-returning fn (the fixture's `modifier` is
    # `async void`). Resolve its param types + return.
    Vector[int] iss_ptys = get_fn_param_types(callee_name, gmod)
    int iss_ret = UNIT_TYPE
    bool iss_ret_found = false
    int isf = 0
    while isf < gmod.functions.len():
        if gmod.functions.get(isf).unwrap().name == callee_name:
            iss_ret = gmod.functions.get(isf).unwrap().return_type
            iss_ret_found = true
            isf = gmod.functions.len()
        else:
            isf += 1
    if not iss_ret_found and gmod.fn_sigs.contains(callee_name):
        iss_ret = gmod.fn_sigs.get(callee_name).unwrap()
    if iss_ret != UNIT_TYPE and not (iss_ret < PRIM_COUNT):
        return -1
    # Record the InnerSharedSpawn on the enclosing function (consumed by the
    # post-pass). `callee_has_awaits` is the per-callee await-ness — the inner
    # callee picks `__shared_token_` (sync) vs `__shared_async_` (async).
    bool iss_callee_async = gmod.async_fns.contains(callee_name)
    ctx.inner_shared_spawns.push(InnerSharedSpawn(callee_name.clone(), iss_call_indices.clone(), iss_param_indices.clone(), iss_ptys.clone(), iss_ret, iss_callee_async))
    # Register the (template) `__gorget_spawn_<callee>` helper so the
    # untransformed enclosing fn links. The shared `&param` arg passes the
    # DEREF'd inner value (scalar) in the template; the post-pass replaces it
    # with the carrier (void*) when it rewrites the clone. Param C-types: a
    # shared slot is the inner scalar's C name (the template passes a value),
    # others their runtime C name.
    Vector[String] iss_ctys = []
    int ispw = 0
    while ispw < iss_ptys.len():
        bool ispw_shared = false
        for ci in iss_call_indices:
            if ci == ispw:
                ispw_shared = true
        if ispw_shared:
            # The template passes the deref'd inner value — its C name is the
            # pointee scalar. Peel the MutPtr to the inner type.
            int iss_inner_ty = peel_ptr_tid(&gmod, iss_ptys.get(ispw).unwrap())
            iss_ctys.push(spawn_runtime_c_name(iss_inner_ty, &gmod))
        else:
            iss_ctys.push(spawn_runtime_c_name(iss_ptys.get(ispw).unwrap(), &gmod))
        ispw += 1
    String iss_ret_c = "void"
    if iss_ret != UNIT_TYPE:
        iss_ret_c = spawn_runtime_c_name(iss_ret, &gmod)
    bool iss_spawn_reg = false
    for sfr_i in gmod.spawned_fns:
        if sfr_i.fn_name == callee_name:
            iss_spawn_reg = true
    if not iss_spawn_reg:
        gmod.spawned_fns.push(SpawnFnRec(callee_name.clone(), iss_ret_c.clone(), !iss_ctys))
    ctx.pending_spawn_fn = callee_name.clone()
    String iss_task_name = "Task__" + iss_ret_c
    Vector[String] iss_ttf = []
    if ctx.task_type_fns.contains(iss_task_name):
        iss_ttf = ctx.task_type_fns.get(iss_task_name).unwrap()
    bool iss_ttf_has = false
    for ttf_i in iss_ttf:
        if ttf_i == callee_name:
            iss_ttf_has = true
    if not iss_ttf_has:
        iss_ttf.push(callee_name.clone())
    ctx.task_type_fns.put(iss_task_name, !iss_ttf)
    int iss_task_ty = lookup_or_register_named(&gmod, iss_task_name)
    # Lower the args: a shared `&param` arg passes the DEREF'd inner value
    # (template behavior); a non-shared arg lowers normally.
    Vector[Operand] iss_call_args = []
    int ispa = 0
    while ispa < spawn_args.len():
        SpannedExpr iss_arg = spawn_args.get(ispa).unwrap()
        bool ispa_shared = false
        for ci2 in iss_call_indices:
            if ci2 == ispa:
                ispa_shared = true
        if ispa_shared:
            # `&param` → lower the INNER identifier (a `*mut T` param) and DEREF
            # to the inner value (matching the Rust template `_3 = copy _1.*`).
            match iss_arg.expr:
                case EMutableBorrow(ispa_inner):
                    iss_arg = *ispa_inner
                else:
                    pass
        int iss_arg_local = lower_expr(&ctx, iss_arg, &gmod)
        iss_call_args.push(op_consume(ctx, &gmod, iss_arg_local, CkCallArgBorrow()))
        ispa += 1
    int iss_dst = add_local(&ctx, iss_task_ty, None)
    emit(&ctx, GICall(iss_dst, "__gorget_spawn_" + callee_name, iss_call_args))
    return iss_dst

int lower_shared_spawn(LowerCtx &ctx, String callee_name, Vector[SpannedExpr] spawn_args, GirModule &gmod):
    # Collect shared-arg (index, info). A shared arg is `&x` / `!x` / bare `x`
    # whose identifier is a shared var. Phase-1 fixtures pass `&x`
    # (EMutableBorrow(EIdentifier(x))).
    Vector[int] sp_indices = []
    Vector[SharedLocalInfo] sp_infos = []
    int spi = 0
    while spi < spawn_args.len():
        String sp_ident = ""
        # `&x` / `!x` is ALWAYS a borrow (the carrier is passed). A BARE
        # `EIdentifier(x)` is only a shared-spawn arg if the CALLEE's param at
        # this index is a mut-borrow (`int &val` → GtMutPtr); a by-value param
        # (`int val`, as in print_val/reader) must instead READ x (lock-get)
        # and pass the VALUE — NOT the carrier. So a bare ident defers the
        # decision to the callee-param check below.
        bool sp_is_explicit_borrow = false
        match spawn_args.get(spi).unwrap().expr:
            case EMutableBorrow(sp_inner):
                match (*sp_inner).expr:
                    case EIdentifier(sp_n):
                        sp_ident = sp_n
                        sp_is_explicit_borrow = true
                    else:
                        pass
            case EMove(sp_inner2):
                match (*sp_inner2).expr:
                    case EIdentifier(sp_n2):
                        sp_ident = sp_n2
                        sp_is_explicit_borrow = true
                    else:
                        pass
            case EIdentifier(sp_n3):
                sp_ident = sp_n3
            else:
                pass
        if sp_ident != "" and ctx.shared_locals.contains(sp_ident):
            bool sp_treat_shared = sp_is_explicit_borrow
            if not sp_treat_shared:
                # Bare ident — only a shared-spawn arg when the callee param is
                # a mut-borrow (GtMutPtr). Otherwise it's a by-value read.
                Vector[int] sp_pre_ptys = get_fn_param_types(callee_name, gmod)
                if spi < sp_pre_ptys.len():
                    match gmod.type_table.get(sp_pre_ptys.get(spi).unwrap()).unwrap():
                        case GtMutPtr(_):
                            sp_treat_shared = true
                        else:
                            pass
            if sp_treat_shared:
                sp_indices.push(spi)
                sp_infos.push(ctx.shared_locals.get(sp_ident).unwrap())
        spi += 1
    if sp_indices.len() == 0:
        return -1
    # The callee must be a void-returning fn this phase (the Phase-1 workers
    # are `async void`). A non-void shared callee rolls to a later increment.
    int sp_callee_ret = UNIT_TYPE
    bool sp_ret_found = false
    int spf = 0
    while spf < gmod.functions.len():
        if gmod.functions.get(spf).unwrap().name == callee_name:
            sp_callee_ret = gmod.functions.get(spf).unwrap().return_type
            sp_ret_found = true
            spf = gmod.functions.len()
        else:
            spf += 1
    if not sp_ret_found and gmod.fn_sigs.contains(callee_name):
        sp_callee_ret = gmod.fn_sigs.get(callee_name).unwrap()
    # The callee returns UNIT (void worker) or a SCALAR (the wrapper stores the
    # callee result in `_0` and returns it via the spawn ctx `result`). A
    # String/collection/owned return rolls to a later increment.
    if sp_callee_ret != UNIT_TYPE and not (sp_callee_ret < PRIM_COUNT):
        return -1
    Vector[int] sp_callee_ptys = get_fn_param_types(callee_name, gmod)
    # Non-shared params must be a supported (scalar) shape — Phase-1 workers
    # take only the shared `&counter`, but guard generally.
    int spcheck = 0
    while spcheck < sp_callee_ptys.len():
        bool is_shared_slot = false
        int spck = 0
        while spck < sp_indices.len():
            if sp_indices.get(spck).unwrap() == spcheck:
                is_shared_slot = true
            spck += 1
        if not is_shared_slot:
            int sp_pty = sp_callee_ptys.get(spcheck).unwrap()
            # The non-shared slot may be a MutPtr (another & param) — out of
            # Phase-1 scope; only plain scalars are supported alongside shared.
            if not spawn_shape_supported(sp_pty, &gmod):
                return -1
        spcheck += 1
    # round-16 Phase-2: pick the wrapper by the callee's AST await-ness
    # (`gmod.async_fns`, populated by the pre-pass at the top of lower_module).
    #   • async callee → `__shared_async_<callee>` — a GIR→GIR transform of the
    #     callee's body, built LATER by the post-pass `build_shared_async_wrapper`.
    #     We record a `PendingSharedAsync` and do NOT build a body here.
    #   • sync callee  → `__shared_token_<callee>` — the Phase-1 lock-held wrapper,
    #     built FOR REAL right here by `build_shared_token_wrapper`.
    # The SOUNDNESS split (Core #8): the async wrapper releases the lock across
    # every suspension; the sync one holds it (its callee has no suspension).
    bool sp_callee_async = gmod.async_fns.contains(callee_name)
    String sp_wrapper = "__shared_token_" + callee_name
    if sp_callee_async:
        sp_wrapper = "__shared_async_" + callee_name
    bool sp_wrap_exists = false
    for sfr in gmod.spawned_fns:
        if sfr.fn_name == sp_wrapper:
            sp_wrap_exists = true
    if not sp_wrap_exists:
        if sp_callee_async:
            # Defer the async-variant body to the GIR→GIR post-pass (the callee's
            # GIR may not even be lowered yet at this spawn site). Dedup by
            # variant name. Mirrors Rust gg's `PendingSharedVariant` push at the
            # spawn site (`exprs/mod.rs:1318`).
            bool sp_pend_exists = false
            for pend in gmod.pending_shared_async:
                if pend.variant_name == sp_wrapper:
                    sp_pend_exists = true
            if not sp_pend_exists:
                gmod.pending_shared_async.push(PendingSharedAsync(callee_name.clone(), sp_wrapper.clone(), sp_indices.clone(), sp_infos.clone(), sp_callee_ret))
        else:
            build_shared_token_wrapper(&gmod, sp_wrapper, callee_name, sp_callee_ptys.clone(), sp_indices.clone(), sp_infos.clone(), sp_callee_ret)
        # Register fn_sigs for the wrapper (return type) so downstream
        # resolution sees it.
        gmod.fn_sigs.put(sp_wrapper.clone(), sp_callee_ret)
    # Compute the wrapper's spawn-param C-types (carrier = void* opaque,
    # non-shared = the callee's runtime C name).
    Vector[String] sp_wrap_ctys = []
    int spw = 0
    while spw < sp_callee_ptys.len():
        bool spw_is_shared = false
        int spwk = 0
        while spwk < sp_indices.len():
            if sp_indices.get(spwk).unwrap() == spw:
                spw_is_shared = true
            spwk += 1
        if spw_is_shared:
            # Carrier is opaque → void* in the spawn ctx (clone_params retains it).
            sp_wrap_ctys.push("void*")
        else:
            sp_wrap_ctys.push(spawn_runtime_c_name(sp_callee_ptys.get(spw).unwrap(), &gmod))
        spw += 1
    # Wrapper return C-type: "void" for a unit callee, else the scalar runtime
    # C name. The spawn helper stores the scalar in the ctx `result` and await
    # reads it back.
    String sp_ret_c = "void"
    if sp_callee_ret != UNIT_TYPE:
        sp_ret_c = spawn_runtime_c_name(sp_callee_ret, &gmod)
    # Register the spawned wrapper (dedup by name).
    bool sp_reg_exists = false
    for sfr2 in gmod.spawned_fns:
        if sfr2.fn_name == sp_wrapper:
            sp_reg_exists = true
    if not sp_reg_exists:
        gmod.spawned_fns.push(SpawnFnRec(sp_wrapper.clone(), sp_ret_c.clone(), !sp_wrap_ctys))
    ctx.pending_spawn_fn = sp_wrapper.clone()
    String sp_task_name = "Task__" + sp_ret_c
    Vector[String] sp_ttf = []
    if ctx.task_type_fns.contains(sp_task_name):
        sp_ttf = ctx.task_type_fns.get(sp_task_name).unwrap()
    bool sp_ttf_has = false
    for ttf in sp_ttf:
        if ttf == sp_wrapper:
            sp_ttf_has = true
    if not sp_ttf_has:
        sp_ttf.push(sp_wrapper.clone())
    ctx.task_type_fns.put(sp_task_name, !sp_ttf)
    int sp_task_ty = lookup_or_register_named(&gmod, sp_task_name)
    # Lower the spawn args, passing the CARRIER for each shared arg (set
    # shared_pass_raw so a shared identifier resolves to its carrier handle).
    Vector[Operand] sp_call_args = []
    bool sp_prev_raw = ctx.shared_pass_raw
    ctx.shared_pass_raw = true
    int spa = 0
    while spa < spawn_args.len():
        # A shared arg is `&x`; lower the INNER identifier (so pass_raw yields
        # the carrier handle) rather than the EMutableBorrow wrapper.
        SpannedExpr sp_arg_expr = spawn_args.get(spa).unwrap()
        bool spa_is_shared = false
        int spak = 0
        while spak < sp_indices.len():
            if sp_indices.get(spak).unwrap() == spa:
                spa_is_shared = true
            spak += 1
        if spa_is_shared:
            match sp_arg_expr.expr:
                case EMutableBorrow(spa_inner):
                    sp_arg_expr = *spa_inner
                case EMove(spa_inner2):
                    sp_arg_expr = *spa_inner2
                else:
                    pass
        int sp_arg_local = lower_expr(&ctx, sp_arg_expr, &gmod)
        sp_call_args.push(op_consume(ctx, &gmod, sp_arg_local, CkCallArgBorrow()))
        spa += 1
    ctx.shared_pass_raw = sp_prev_raw
    int sp_dst = add_local(&ctx, sp_task_ty, None)
    emit(&ctx, GICall(sp_dst, "__gorget_spawn_" + sp_wrapper, sp_call_args))
    return sp_dst

# Is a GIR call func-name a YIELD POINT (suspension)? The lock must be released
# before it and reacquired after. Mirrors Rust gg's `is_yield_point`
# (`shared_async.rs:455`): the `__gorget_await_` prefix (the sanctioned
# runtime-symbol-contract exception — Rust does the same `:459`) OR membership in
# the blocking-extern set. For these fixtures the verified members are
# `gorget_reactor_sleep_seconds` (the `from std.time import sleep` extern) and
# the `__gorget_await_*` prefix. `gorget_reactor_sleep_ms` (std.async.async_sleep)
# is carried too for completeness; NOT `gorget_async_sleep` (a separate
# builtin-method path that doesn't apply to extern-bound stdlib sleep).
bool is_yield_point_fn(String fname):
    if fname.starts_with("__gorget_await_"):
        return true
    if fname == "gorget_reactor_sleep_seconds":
        return true
    if fname == "gorget_reactor_sleep_ms":
        return true
    return false

# True iff inst is a yield-point call (Call or CallExtern to a yield fn).
bool inst_is_yield_point(Instruction inst):
    match inst:
        case GICall(_, fname, _):
            return is_yield_point_fn(fname)
        case GICallExtern(_, fname, _):
            return is_yield_point_fn(fname)
        else:
            return false

# Build the GIR→GIR `__shared_async_<callee>` variant from a PendingSharedAsync
# request. Clones the already-lowered source function, retypes each shared param
# to its carrier, splices a lock preamble + release/reacquire-around-suspension
# + with-refresh + release-before-return, and rewrites inner shared spawns to
# their token wrappers. Mirrors Rust gg's `inject_shared_token_management`
# (`shared_async.rs:106`). SINGLE shared arg in scope (the two fixtures) — guard
# generally but the splice is written for the 1-carrier case.
void build_shared_async_wrapper(GirModule &gmod, PendingSharedAsync pend):
    # Locate the source function (already lowered).
    int src_idx = -1
    int sfi = 0
    while sfi < gmod.functions.len():
        if gmod.functions.get(sfi).unwrap().name == pend.source_fn_name:
            src_idx = sfi
            sfi = gmod.functions.len()
        else:
            sfi += 1
    if src_idx < 0:
        return
    GirFunction src = gmod.functions.get(src_idx).unwrap()
    Vector[GirLocal] aw_locals = src.locals.clone()
    Vector[int] aw_param_types = src.param_types.clone()
    Vector[BasicBlock] aw_blocks = src.blocks.clone()
    Vector[int] aw_refresh = src.with_refresh_pairs.clone()

    # This fixture set has exactly ONE shared arg. Resolve its carrier + facade.
    int sh_idx = pend.shared_arg_indices.get(0).unwrap()
    SharedLocalInfo sh = pend.shared_arg_infos.get(0).unwrap()
    int param_local = sh_idx + 1

    # 1. Retype the param slot to the carrier Ptr type (Ptr-to-Shared__Mutex__c).
    int carrier_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, sh.shared_mangled))
    GirLocal old_p = aw_locals.get(param_local).unwrap()
    aw_locals.set(param_local, GirLocal(carrier_ty, old_p.name_hint, LoParam(), BoParam(-1), false))
    aw_param_types.set(sh_idx, carrier_ty)

    # 2. Allocate the lock-management slots (re-derived into the same slots at
    #    every reacquire). facade is a `*mut inner` that REPLACES the param in
    #    the body.
    int mutex_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, sh.mutex_mangled))
    int guard_ty = lookup_or_register_named(&gmod, sh.guard_mangled)
    int inner_mutptr_ty = register_type(&gmod, GtMutPtr(sh.inner_type))
    int raw_local = aw_locals.len()
    aw_locals.push(GirLocal(mutex_ptr_ty, None, LoOwned(), BoNone(), false))
    int mutex_local = aw_locals.len()
    aw_locals.push(GirLocal(mutex_ptr_ty, None, LoOwned(), BoNone(), false))
    int guard_local = aw_locals.len()
    aw_locals.push(GirLocal(guard_ty, None, LoOwned(), BoNone(), false))
    int facade_local = aw_locals.len()
    aw_locals.push(GirLocal(inner_mutptr_ty, Some("__facade"), LoOwned(), BoNone(), false))

    # 3. Remap every body reference of the param local → facade (so `deref _1`
    #    becomes `deref facade`). Walk all blocks' insts + terminators.
    int rb = 0
    while rb < aw_blocks.len():
        BasicBlock blk = aw_blocks.get(rb).unwrap()
        Vector[Instruction] rmi = []
        for inst in blk.insts:
            rmi.push(remap_inst_local(inst, param_local, facade_local))
        Terminator rmt = remap_term_local(blk.term, param_local, facade_local)
        aw_blocks.set(rb, BasicBlock(!rmi, rmt))
        rb += 1

    # 4. Build with-refresh instructions (re-read each binding from facade after
    #    reacquire): binding = deref facade. param in the pair was remapped, but
    #    we deref the facade directly (the facade IS the *mut inner).
    Vector[Instruction] refresh_insts = []
    int wri = 0
    while wri + 1 < aw_refresh.len():
        int wr_binding = aw_refresh.get(wri).unwrap()
        int wr_param = aw_refresh.get(wri + 1).unwrap()
        if wr_param == param_local:
            refresh_insts.push(GIDeref(wr_binding, facade_local, sh.inner_type))
        wri += 2

    # 5. Splice each block: entry preamble (block 0 only), release/reacquire
    #    around yield points, release before Return.
    int bb = 0
    while bb < aw_blocks.len():
        BasicBlock blk2 = aw_blocks.get(bb).unwrap()
        Vector[Instruction] out = []
        # Entry preamble on block 0.
        if bb == 0:
            emit_async_lock_acquire(gmod, &out, param_local, sh, raw_local, mutex_local, guard_local, facade_local, mutex_ptr_ty)
        # Walk insts, splicing release-before / reacquire-after each yield.
        for inst2 in blk2.insts:
            if inst_is_yield_point(inst2):
                # release before
                out.push(GICallExtern(-1, sh.guard_mangled + "__drop", [OpBorrow(guard_local)]))
                out.push(inst2)
                # reacquire after + with-refresh
                emit_async_lock_acquire(gmod, &out, param_local, sh, raw_local, mutex_local, guard_local, facade_local, mutex_ptr_ty)
                for ri in refresh_insts:
                    out.push(ri)
            else:
                out.push(inst2)
        # Release before a Return terminator.
        Terminator t2 = blk2.term
        match t2:
            case GTReturn(_):
                out.push(GICallExtern(-1, sh.guard_mangled + "__drop", [OpBorrow(guard_local)]))
            case GTNone():
                # An async void body falls off with no explicit return; synthesize
                # the guard release + a unit return so the lock is freed on exit.
                out.push(GICallExtern(-1, sh.guard_mangled + "__drop", [OpBorrow(guard_local)]))
                t2 = GTReturn(OpConstUnit())
            else:
                pass
        aw_blocks.set(bb, BasicBlock(!out, t2))
        bb += 1

    # 6. Inner shared spawns: rewrite `__gorget_spawn_<inner>` →
    #    `__gorget_spawn___shared_token_<inner>` (+ await) and forward the carrier
    #    param local. Also build the inner token wrapper + register its spawn rec.
    #    The inner shared arg traces to the SAME enclosing carrier (`sh`).
    for iss in src.inner_shared_spawns:
        rewrite_inner_shared_spawn(&gmod, &aw_blocks, iss, param_local, sh)

    gmod.functions.push(GirFunction(pend.variant_name.clone(), !aw_param_types, pend.return_type, !aw_locals, !aw_blocks, [], []))

# Rewrite an inner `spawn modifier(&counter)` (already lowered to a real
# `__gorget_spawn_modifier` / `__gorget_await_modifier` pair in the cloned body)
# to forward the CARRIER through the inner token wrapper. Builds
# `__shared_token_<inner>` (the SYNC wrapper — the inner callee has no
# suspension) + registers its spawn helper. Mirrors Rust gg's `InnerSpawnRewrite`
# (`shared_async.rs:278-357`) + the post-pass wrapper build.
void rewrite_inner_shared_spawn(GirModule &gmod, Vector[BasicBlock] &blocks, InnerSharedSpawn iss, int carrier_param_local, SharedLocalInfo encl):
    String orig_spawn = "__gorget_spawn_" + iss.callee_name
    String orig_await = "__gorget_await_" + iss.callee_name
    # The inner callee has no awaits in this fixture set → SYNC token wrapper.
    String inner_wrap = "__shared_token_" + iss.callee_name
    if iss.callee_has_awaits:
        inner_wrap = "__shared_async_" + iss.callee_name
    String new_spawn = "__gorget_spawn_" + inner_wrap
    String new_await = "__gorget_await_" + inner_wrap

    # The inner callee's shared arg reuses the ENCLOSING carrier's mangled names
    # (the same `&counter` thread): build its SharedLocalInfo from `encl`. The
    # facade/hidden locals are wrapper-relative (-1 — `build_shared_token_wrapper`
    # only reads the mangled-name + inner_type fields).
    SharedLocalInfo inner_info = SharedLocalInfo(-1, -1, encl.inner_type, encl.carrier_type, encl.inner_c.clone(), encl.mutex_mangled.clone(), encl.guard_mangled.clone(), encl.shared_mangled.clone(), 0, SHK_MUTEX)

    # Build the inner SYNC token wrapper (dedup by name).
    bool inner_built = false
    for ifn in gmod.functions:
        if ifn.name == inner_wrap:
            inner_built = true
    if not inner_built:
        Vector[int] inner_indices = iss.shared_arg_call_indices.clone()
        Vector[SharedLocalInfo] inner_infos = [inner_info]
        build_shared_token_wrapper(&gmod, inner_wrap, iss.callee_name, iss.callee_param_types.clone(), inner_indices, inner_infos, iss.callee_return_type)
        gmod.fn_sigs.put(inner_wrap.clone(), iss.callee_return_type)

    # Register the inner wrapper's spawn helper (carrier param → void*).
    Vector[String] inner_ctys = []
    int ici = 0
    while ici < iss.callee_param_types.len():
        bool ici_shared = false
        for sci in iss.shared_arg_call_indices:
            if sci == ici:
                ici_shared = true
        if ici_shared:
            inner_ctys.push("void*")
        else:
            inner_ctys.push(spawn_runtime_c_name(iss.callee_param_types.get(ici).unwrap(), &gmod))
        ici += 1
    String inner_ret_c = "void"
    if iss.callee_return_type != UNIT_TYPE:
        inner_ret_c = spawn_runtime_c_name(iss.callee_return_type, &gmod)
    bool inner_spawn_reg = false
    for sfr3 in gmod.spawned_fns:
        if sfr3.fn_name == inner_wrap:
            inner_spawn_reg = true
    if not inner_spawn_reg:
        gmod.spawned_fns.push(SpawnFnRec(inner_wrap.clone(), inner_ret_c.clone(), !inner_ctys))

    # Rewrite the spawn/await calls in the cloned body: name + carrier arg.
    int irb = 0
    while irb < blocks.len():
        BasicBlock iblk = blocks.get(irb).unwrap()
        Vector[Instruction] iout = []
        for iinst in iblk.insts:
            match iinst:
                case GICall(idst, ifname, iargs):
                    if ifname == orig_spawn:
                        # Forward the CARRIER param local (not the stack value) for
                        # each shared arg position.
                        Vector[Operand] nargs = iargs.clone()
                        for sci2 in iss.shared_arg_call_indices:
                            if sci2 < nargs.len():
                                nargs.set(sci2, OpCopy(carrier_param_local))
                        iout.push(GICall(idst, new_spawn, !nargs))
                    elif ifname == orig_await:
                        iout.push(GICall(idst, new_await, iargs))
                    else:
                        iout.push(iinst)
                case GICallExtern(idst2, ifname2, iargs2):
                    if ifname2 == orig_await:
                        iout.push(GICallExtern(idst2, new_await, iargs2))
                    else:
                        iout.push(iinst)
                else:
                    iout.push(iinst)
        blocks.set(irb, BasicBlock(!iout, iblk.term))
        irb += 1

# Run the GIR→GIR async-splice post-pass over all pending requests, AFTER every
# function is lowered. Mirrors Rust gg's driver (`src/ir/lowering/mod.rs:1547`).
void process_pending_shared_async(GirModule &gmod):
    int pi = 0
    while pi < gmod.pending_shared_async.len():
        build_shared_async_wrapper(&gmod, gmod.pending_shared_async.get(pi).unwrap())
        pi += 1

# Method-RECEIVER place resolver. A `&self`/`!self` method receives `self`
# BY POINTER, so a receiver that is a struct-FIELD place (`self.inner.next()`)
# must borrow the field IN PLACE — a pointer INTO the aggregate — not a
# by-value copy of the field. A mutating `&self` method (`SetIter.next`
# advancing its cursor) called on a by-value copy writes the mutation into
# the discarded copy: the Set/Dict lazy-iterator adapters (`Take`/`Skip`/
# `Filter`/…) that hold their inner iterator by value then re-yield element 0
# forever (the ROOT-A SPIN class). Mirrors Rust gg's dedicated receiver-field
# branch (src/ir/lowering/exprs/methods.rs:2037-2064): borrow the field place
# unless the field is itself a `Ref[T]`/`MutRef[T]` borrow pointer (whose
# STORED value IS the receiver pointer — the LIR loads it).
#
# The `EFieldAccess` `case` in `lower_expr_inner` already Ptr-types the
# field-load dst for RESOURCE fields (Vector/Dict/String/… → the LIR
# GIFieldLoad handler alias-stores the field ADDRESS, no byte-copy) — that
# is why a `VectorIter` inner (holds a `Vector` resource) borrows correctly
# while a `SetIter`/`DictKeysIter`/`DictValuesIter` inner (holds a `Ref`,
# NOT a resource) value-copies. This resolver closes that gap for a receiver:
# a PLAIN (non-resource, non-Ref) struct field is Ptr-typed too, so the
# LIR aliases its address. Scoped to a bare-local base (`self.f` / `x.f`)
# only — `nl_get` never emits, so the fall-through re-resolve is free; every
# other receiver shape (resource field, Ref field, scalar field, Box/Guard/
# nested/index base) delegates to `lower_place_base` UNCHANGED (byte-identical
# emission). The LIR handler's own `Ref__`/`MutRef__`/opaque-handle carve-out
# (lir_lower.gg:5138-5145) is the second line of defense on the Ref case.
int lower_recv_place(LowerCtx &ctx, SpannedExpr recv_expr, GirModule &gmod):
    match recv_expr.expr:
        case EFieldAccess(rp_base_box, rp_field):
            # Bare-place base only (`self.f` / `local.f`): `nl_get` returns the
            # local (a Ptr for a `&self`/`&param`) with NO emit, so the
            # fall-through `lower_place_base(recv_expr)` below re-reads it for
            # free. Any static / Box / nested / index base is left entirely to
            # `lower_place_base` (avoids double-emitting the base). The self
            # receiver arrives as the distinct `ESelfExpr` node (lower.gg:1067),
            # not `EIdentifier("self")`, so both are handled.
            int rp_base = -1
            match (*rp_base_box).expr:
                case ESelfExpr():
                    if nl_contains(ctx, "self"):
                        rp_base = nl_get(ctx, "self")
                case EIdentifier(rp_bn):
                    if nl_contains(ctx, rp_bn):
                        rp_base = nl_get(ctx, rp_bn)
                else:
                    pass
            if rp_base >= 0:
                int rp_base_tid = ctx.locals.get(rp_base).unwrap().type_id
                String rp_base_tn = type_id_to_name(rp_base_tid, &gmod)
                # Peel Ptr/MutPtr for the struct-name lookup.
                if rp_base_tid >= 0 and rp_base_tid < gmod.type_table.len():
                    match gmod.type_table.get(rp_base_tid).unwrap():
                        case GtPtr(rp_i):
                            rp_base_tn = type_id_to_name(rp_i, &gmod)
                        case GtMutPtr(rp_i2):
                            rp_base_tn = type_id_to_name(rp_i2, &gmod)
                        else:
                            pass
                if gmod.type_infos.contains(rp_base_tn):
                    GirTypeInfo rp_info = gmod.type_infos.get(rp_base_tn).unwrap()
                    int rp_found = -1
                    String rp_ftn = ""
                    int rp_fi = 0
                    while rp_fi < rp_info.fields.len():
                        GirFieldInfo rp_finfo = rp_info.fields.get(rp_fi).unwrap()
                        if rp_finfo.name == rp_field:
                            rp_found = rp_fi
                            rp_ftn = rp_finfo.type_name.clone()
                            break
                        rp_fi += 1
                    if rp_found >= 0:
                        int rp_ftid = resolve_field_gir_type(rp_ftn, &gmod)
                        bool rp_is_ref = rp_ftn.starts_with("Ref__") or rp_ftn.starts_with("MutRef__")
                        # Specialize ONLY a plain aggregate field: a non-scalar
                        # nominal that is neither a runtime resource (already
                        # Ptr-loads via the resource arm) nor a `Ref`/`MutRef`
                        # borrow ptr. This is exactly the SetIter/DictKeysIter/
                        # DictValuesIter inner-iterator shape.
                        if rp_ftid >= PRIM_COUNT and not is_resource_type_name(rp_ftn, &gmod) and not rp_is_ref:
                            int rp_pt = register_ptr(&gmod, rp_ftid)
                            int rp_dst = add_local_with(&ctx, rp_pt, None, LoBorrowed(), BoNone())
                            set_field_borrow(&ctx, rp_dst, rp_base, rp_found)
                            emit(&ctx, GIFieldLoad(rp_dst, rp_base, rp_found))
                            return rp_dst
        else:
            pass
    return lower_place_base(&ctx, recv_expr, &gmod)

int lower_expr(LowerCtx &ctx, SpannedExpr sexpr, GirModule &gmod):
    # D29: `expr!` (EPropagate) is TRANSPARENT — unwrap it BEFORE the suppress
    # one-shot is consumed, so the inner call inherits the match-scrutinee /
    # catch / rethrow suppress signal (otherwise the mark eats it, the call
    # auto-props to `T`, and a match on the raw Result reads garbage → SIGSEGV;
    # the two-layer transparency, mirror of Rust `exprs/mod.rs` lower_expr).
    match sexpr.expr:
        case EPropagate(prop_inner):
            return lower_expr(&ctx, *prop_inner, &gmod)
        else:
            pass
    # Consume the one-shot suppress flag for THIS expression.
    bool suppress = ctx.suppress_auto_prop
    ctx.suppress_auto_prop = false
    # Only Call / MethodCall produce a throws-Result via the throws sugar.
    bool is_producer = false
    match sexpr.expr:
        case ECall(_, _, _):
            is_producer = true
        case EMethodCall(_, _, _, _):
            is_producer = true
        else:
            pass
    int v = lower_expr_inner(&ctx, sexpr, &gmod)
    if suppress or not is_producer:
        return v
    return maybe_auto_propagate(&ctx, v, &gmod)

int lower_expr_inner(LowerCtx &ctx, SpannedExpr sexpr, GirModule &gmod):
    match sexpr.expr:
        case EIntLiteral(v):
            int dst = add_local(&ctx, I64_TYPE, None)
            emit(&ctx, GIAssign(dst, OpConstI64(v)))
            return dst
        case EFloatLiteral(v):
            int dst = add_local(&ctx, F64_TYPE, None)
            emit(&ctx, GIAssign(dst, OpConstF64(v)))
            return dst
        case EBoolLiteral(v):
            int dst = add_local(&ctx, BOOL_TYPE, None)
            emit(&ctx, GIAssign(dst, OpConstBool(v)))
            return dst
        case EStringLiteral(s, _):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, None)
            emit(&ctx, GIAssign(dst, OpConstStr(s)))
            return dst
        case EFString(s, fexprs, specs):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            if fexprs.len() == 0:
                # No interpolation — just a string literal
                int dst = add_local(&ctx, gs_tid, None)
                emit(&ctx, GIAssign(dst, OpConstStr(s)))
                return dst
            # Walk template, replacing each "{}" placeholder with the printf
            # specifier for the corresponding fexprs[i]'s type, and build the
            # arg list in parallel. Emit `gorget_string_format(fmt, ...args)`
            # which returns a fresh, null-terminated GorgetString. Mirrors
            # Rust gg's `lower_string_interpolation` at
            # `src/ir/lowering/exprs/mod.rs:3505`.
            #
            # Without this fix, EFString emitted only the raw template
            # (with literal `{}` placeholders), so `print(f"{x}")` printed
            # "{}" — the dominant OutputMismatch cluster in self_host_e2e
            # (46 fixtures at baseline 94/995). [filed: 2026-05-19]
            Vector[Operand] gsf_args = []
            gsf_args.push(OpConstStr(""))  # placeholder for fmt at index 0; overwritten below
            String fmt = ""
            int fi = 0
            int byte_i = 0
            int byte_n = s.byte_len()
            while byte_i < byte_n:
                # `{}` placeholder bytes are 0x7B 0x7D.
                bool is_placeholder = false
                if byte_i + 1 < byte_n:
                    if s.byte_at(byte_i) == 0x7B and s.byte_at(byte_i + 1) == 0x7D:
                        is_placeholder = true
                if is_placeholder:
                    if fi >= fexprs.len():
                        # Mismatched placeholder count — emit literal `{}`
                        fmt = fmt + "{}"
                    else:
                        SpannedExpr farg = fexprs.get(fi).unwrap()
                        int aloc = lower_expr(&ctx, farg, &gmod)
                        int aty = I64_TYPE
                        if aloc >= 0 and aloc < ctx.locals.len():
                            aty = ctx.locals.get(aloc).unwrap().type_id
                        # Borrowed string (`Ptr(GorgetString)` from a struct
                        # String-field read / match-payload binding) — deref to
                        # a NON-OWNING value GorgetString so the `%s` branch
                        # below fires (the `aty == gs_tid` check misses the Ptr,
                        # else the f-string prints the pointer via `%lld`).
                        if is_ptr_to_string_type_id(aty, &gmod):
                            int saloc = add_local_with(&ctx, gs_tid, None, LoBorrowed(), BoNone())
                            emit(&ctx, GIDeref(saloc, aloc, gs_tid))
                            aloc = saloc
                            aty = gs_tid
                        # User format spec (`{x:.2f}`, `{n:08d}`, `{255:#x}`,
                        # `{x:b}`) present for THIS placeholder? Try to apply it
                        # (mirror Rust apply_format_spec). A non-empty fragment
                        # means the spec was applied (and its operand(s) already
                        # pushed into gsf_args); "" means absent OR inapplicable
                        # to this arg's type → fall through to the type default.
                        bool spec_applied = false
                        if specs.get(fi).unwrap() is Some(uspec):
                            String spec_frag = apply_format_spec(&ctx, &gmod, &gsf_args, uspec, aloc, aty, gs_tid)
                            if spec_frag.byte_len() > 0:
                                fmt = fmt + spec_frag
                                spec_applied = true
                        if not spec_applied:
                            if aty == F64_TYPE or aty == F32_TYPE:
                                fmt = fmt + "%f"
                                gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
                            elif aty == gs_tid:
                                # String → %.*s with (int)len,data (the printf-style
                                # emitter for gorget_string_format decomposes a
                                # GorgetString value arg into `(int)len, data`).
                                # %.*s bounds the read to len bytes — required for
                                # non-NUL-terminated cap=0 views (trim/strip/slice).
                                fmt = fmt + "%.*s"
                                gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
                            elif aty == BOOL_TYPE:
                                # Bool → "true"/"false" via gorget_bool_to_str.
                                int bstr = add_local(&ctx, gs_tid, None)
                                Vector[Operand] bargs = [OpCopy(aloc)]
                                emit(&ctx, GICallExtern(bstr, "gorget_bool_to_str", bargs))
                                # FRESH-OWNED-TEMP drop registration (#7-style):
                                # gorget_bool_to_str allocates a fresh `GorgetString`
                                # (LoOwned) that is only BORROWED by the surrounding
                                # gorget_string_format below (CkFormatArg → OpBorrow),
                                # so it is orphaned and leaks. Register at creation so
                                # the scope-exit GIDropIfAlive frees it once. Borrow-
                                # only consume ⇒ never moved ⇒ no double-free.
                                register_local_for_drop(&ctx, bstr, gs_tid, &gmod)
                                fmt = fmt + "%.*s"
                                gsf_args.push(op_consume(ctx, &gmod, bstr, CkFormatArg()))
                            elif fstr_displayable_display_method(aty, &gmod) is Some(disp_fn):
                                # Displayable dispatch: `{x}` where x is a struct/enum
                                # with a `display` method (user `equip … with
                                # Displayable` or `@derive(Displayable)`) → call
                                # `Type__display(&x)` → String, then %.*s. Without
                                # this the value falls to the `%lld` int default
                                # below, printing the struct/enum's raw bits (a
                                # pointer or 0) instead of the formatted text.
                                # Mirrors Rust gg's format_for_printf Displayable
                                # branch (src/ir/lowering/exprs/calls.rs:1964-1996).
                                # TYPED gate: the method's presence in `fn_sigs`
                                # (a Dict lookup of the actually-emitted symbol),
                                # not a name-shape test. `is Some(disp_fn)` binds
                                # the symbol once in the condition — no sentinel, no
                                # second lookup.
                                int disp_dst = add_local(&ctx, gs_tid, None)
                                # `display(self)` takes `&self` (a borrow) — pass
                                # the value local by OpBorrow, exactly as the
                                # explicit `.display()` method-call path does.
                                emit(&ctx, GICallExtern(disp_dst, disp_fn, [OpBorrow(aloc)]))
                                # FRESH-OWNED-TEMP drop registration (#7-style):
                                # `display` returns an OWNED GorgetString (return
                                # position = ownership boundary) that is only
                                # BORROWED by the surrounding gorget_string_format
                                # (CkFormatArg → OpBorrow), so it is orphaned and
                                # would leak. A literal-returning display body is a
                                # cap=0 view whose free no-ops, so the registration
                                # is safe on views too. Mirrors Rust
                                # `ctx.drops.register_local(result, …)` (calls.rs:1990).
                                register_local_for_drop(&ctx, disp_dst, gs_tid, &gmod)
                                fmt = fmt + "%.*s"
                                gsf_args.push(op_consume(ctx, &gmod, disp_dst, CkFormatArg()))
                            else:
                                # Default: int64_t printf via %lld. Narrow ints
                                # are auto-promoted by C's variadic ABI to
                                # `int` (4 bytes) — but vsnprintf with `%lld`
                                # reads 8 bytes. Acceptable for I64; narrow
                                # ints may render incorrectly until a typed
                                # specifier table is added.
                                fmt = fmt + "%lld"
                                gsf_args.push(op_consume(ctx, &gmod, aloc, CkFormatArg()))
                        fi += 1
                    byte_i += 2
                else:
                    # Copy literal byte. byte_i is a BYTE offset (byte_at/byte_len
                    # above), so the copy MUST be byte-indexed too — .slice() is
                    # CODEPOINT-indexed, which desyncs after the first multibyte
                    # literal char and corrupts the rest (fstring_unicode_passthrough).
                    # byte_slice ≡ slice for ASCII, so zero ASCII regression; the
                    # lexer's owned_slice uses the same byte_slice idiom.
                    fmt = fmt + s.byte_slice(byte_i, byte_i + 1)
                    byte_i += 1
            # Overwrite fmt placeholder at position 0 with the built format string.
            gsf_args.set(0, OpConstStr(fmt))
            int gsdst = add_local(&ctx, gs_tid, None)
            emit(&ctx, GICallExtern(gsdst, "gorget_string_format", gsf_args))
            # FRESH-OWNED-TEMP drop registration (#7-style): gorget_string_format
            # allocates a fresh `GorgetString` (LoOwned). When this f-string
            # EXPRESSION flows into a print/format arg it is BORROWED only
            # (CkFormatArg → is_consume_kind=false → OpBorrow), so the assembled
            # buffer is orphaned and leaks (O(1) end-of-program residue per
            # f-string). Registering at creation makes the scope-exit
            # GIDropIfAlive free it exactly once. SAFE-BY-CONSTRUCTION: when the
            # result is instead MOVED into a binding (`String s = f"…"`) or
            # RETURNED, op_consume/wire-liveness emits OpMove → GIMoveZero →
            # drop_elab marks the slot uninitialized and statically deletes the
            # guard, so no double-free. GorgetString is a runtime resource
            # (LoOwned, droppable) → register_local_for_drop's
            # LoView/LoBorrowed/non-droppable gates pass it through.
            register_local_for_drop(&ctx, gsdst, gs_tid, &gmod)
            return gsdst
        case EIdentifier(name):
            # Shared-variable transparent READ (round-16 Phase 1). A read of a
            # `shared int x` routes through the carrier's lock-chain so it sees
            # the CURRENT value (not the decl-time snapshot in the facade
            # local). When `shared_pass_raw` is set (the spawn-of-`&shared`
            # site), return the raw carrier handle instead — the worker must
            # receive the carrier, not a locked snapshot. Mirrors Rust gg's
            # Identifier arm shared dispatch (`exprs/mod.rs:115-139`).
            if ctx.shared_locals.contains(name):
                SharedLocalInfo eid_sh = ctx.shared_locals.get(name).unwrap()
                if ctx.shared_pass_raw:
                    return eid_sh.hidden_local
                return emit_shared_read(&ctx, &gmod, eid_sh)
            if nl_contains(ctx, name):
                int eid_lid = nl_get(ctx, name)
                # `&`/`!`-param value READ. A `GtMutPtr(inner)`-typed slot
                # holds a `T*`; a bare read returns the POINTER bits, so a
                # later `x + 10` does arithmetic on the pointer instead of
                # `*ptr`. Deref-load the pointee into a fresh value temp and
                # return THAT — mirrors Rust gg's Deref projection into a
                # `pointee_type` temp (src/ir/lowering/exprs/mod.rs:140-164).
                #
                # Gate ONLY on NON-resource inner: resource slots ARE pointer-
                # valued by ABI and their consumers already deref, so a deref
                # here would double-deref the working `&String` read path. This
                # is the exact precedent shipped at lower.gg (the
                # Option[Ref[T]] getter): resource inner → return the local
                # unchanged; primitive inner → GIDeref into a value temp.
                int eid_tid = ctx.locals.get(eid_lid).unwrap().type_id
                if eid_tid >= PRIM_COUNT and eid_tid < gmod.type_table.len():
                    match gmod.type_table.get(eid_tid).unwrap():
                        case GtMutPtr(eid_inner):
                            if not is_resource_type_name(type_id_to_name(eid_inner, &gmod), &gmod):
                                int eid_value_local = add_local(&ctx, eid_inner, None)
                                emit(&ctx, GIDeref(eid_value_local, eid_lid, eid_inner))
                                return eid_value_local
                        else:
                            pass
                return eid_lid
            # Module-level `const int` — inline the evaluated value.
            # Without this, the self-compiled parser's KW_* / PREC_*
            # constants all become 0 and check_kw(0, 0) hangs.
            if gmod.const_decls.contains(name):
                int cv = gmod.const_decls.get(name).unwrap()
                int cdst = add_local(&ctx, I64_TYPE, None)
                emit(&ctx, GIAssign(cdst, OpConstI64(cv)))
                return cdst
            # Module-level `const bool` — inline OpConstBool(value). Without
            # this a `const bool ENABLED = true` reads as OpConstI64(0)
            # (false), so `if ENABLED:` never fires and `print(ENABLED)`
            # shows 0. Mirrors Rust's Constant::Bool inlining.
            if gmod.bool_const_decls.contains(name):
                bool bcv = gmod.bool_const_decls.get(name).unwrap()
                int bcdst = add_local(&ctx, BOOL_TYPE, None)
                emit(&ctx, GIAssign(bcdst, OpConstBool(bcv)))
                return bcdst
            # Module-level `const String` — inline OpConstStr(value) into a
            # fresh GorgetString local. Mirrors Rust's Constant::Str. The
            # value is a static-literal-backed String (cap=0 view), same as
            # an inline `"hello"` literal at lower_expr's EStringLiteral arm.
            if gmod.string_const_decls.contains(name):
                String scv = gmod.string_const_decls.get(name).unwrap()
                int gs_tid_sc = lookup_or_register_named(&gmod, "GorgetString")
                int scdst = add_local(&ctx, gs_tid_sc, None)
                emit(&ctx, GIAssign(scdst, OpConstStr(scv)))
                return scdst
            # Module-level float constants — `float EPSILON = 0.000001`
            # in lib/xtd/math3d.gg etc. Mirrors Rust's unified
            # `module_constants` table where float consts inline as
            # `Operand::Constant(Constant::F64(value))` rather than
            # falling through to the unknown-identifier `[bug]`. The
            # check / emission lives in a helper to avoid growing
            # `lower_expr`'s stack frame — that frame is already
            # ~148 KB (see assembly), and recursion through deeply
            # nested expressions hits ~50 levels on `driver.gg`,
            # putting us right at the 8 MB stack limit. Adding even
            # a couple of locals to `lower_expr` overflows.
            int fdst_or_neg = lower_float_const_ident(&ctx, gmod, name)
            if fdst_or_neg >= 0:
                return fdst_or_neg
            # Function-as-value: `filter(is_even)` / `.map(double)` etc.
            # — bare fn name passed where a Callable is expected. Helper
            # lives in its own function to keep `lower_expr`'s already-
            # massive stack frame from growing.
            int adst_or_neg = lower_fn_addr_ident(&ctx, &gmod, name)
            if adst_or_neg >= 0:
                return adst_or_neg
            # Module-level static with runtime-call init — `stdout` /
            # `stderr` / `stdin` from lib/std/io.gg etc. Mirrors Rust
            # gg's `Operand::Constant(Constant::GlobalRef(name))`
            # (`src/ir/lowering/exprs/mod.rs:128-130`). Helper emits a
            # `__global_ref__<name>` synthetic GICallExtern that
            # `lir_lower` rewrites to `IGlobalAddr`. Same out-of-line
            # rationale as the float-const / fn-addr helpers above.
            int sdst_or_neg = lower_static_ref_ident(&ctx, gmod, name)
            if sdst_or_neg >= 0:
                return sdst_or_neg
            # Meta-op token (`meta +`, `meta /`, …) encoded as
            # `EIdentifier("__metaop__add")` etc. — compile-time only;
            # never has a runtime value. Mirrors Rust gg's
            # `MetaOpToken` filtering at call-arg lowering
            # (`src/ir/lowering/exprs/calls.rs:882`). Helper is
            # out-of-line for stack-frame reasons.
            int mdst_or_neg = lower_metaop_ident(&ctx, name)
            if mdst_or_neg >= 0:
                return mdst_or_neg
            # Module-level `Option[T] X = None` (e.g. None) — emit a
            # properly-TYPED `None`: a local typed as the const's concrete
            # Option struct, filled by the prelude-variant `None` ctor. That
            # routes through lir_lower's `try_lower_prelude_variant` →
            # `IEnumInit(slot, struct_id, tag=1, [])`, giving a full-size
            # (e.g. 40-byte Option__GorgetString) value. The former
            # `OpConstUnit()` produced an 8-byte I32-0 slot, which add_local's
            # drop-emission clone over-read as a 40-byte Option (tag 0 == Some
            # → bogus Str payload → stack-buffer-overflow). Mirrors Rust gg's
            # `__lir_g1 = {0}` None global: what matters is the 40-byte
            # SIZE, not the tag (cloning an empty/None Option copies nothing).
            if gmod.none_decls.contains(name):
                int opt_tid = gmod.none_decls.get(name).unwrap()
                int ndst = add_local(&ctx, opt_tid, None)
                Vector[Operand] none_args = []
                emit(&ctx, GICallExtern(ndst, "None", none_args))
                return ndst
            # Bare nullary enum-variant used as a value (see
            # lower_nullary_variant_ident). Runs after all the resolution
            # categories above and immediately before the [bug] fallback —
            # a variant name can't legitimately collide with any of them.
            # Cures the `push(IDropGuardClose)` 208-vs-8-byte overflow.
            int evdst_or_neg = lower_nullary_variant_ident(&ctx, &gmod, name)
            if evdst_or_neg >= 0:
                return evdst_or_neg
            # HARD BUG: silently returning `OpConstI64(0)` for an unknown
            # identifier lies about both value and type — every downstream
            # use thinks it's holding an int64 with value 0. Stage-1 has
            # been running with `gmod`, `self`, and similar getting this
            # fallback and cascading into PConstructor failures. Emit a
            # diagnostic so each miss is visible.
            diag_bug("EIdentifier", "in fn '" + ctx.current_fn_name + "': unknown identifier '" + name + "' — returning OpConstI64(0) placeholder (WRONG)")
            int unk = add_local(&ctx, I64_TYPE, None)
            emit(&ctx, GIAssign(unk, OpConstI64(0)))
            return unk
        case EBinaryOp(lhs_box, op, rhs_box):
            # Short-circuit `and` / `or` — `a and b` is NOT `a + b`. Lower
            # to a branch-and-merge so the rhs isn't evaluated when the
            # lhs already determines the result. Previously fell through
            # to map_binop("and") = OP_ADD, and both sides always ran —
            # crashed in the self-host lexer on guards like
            # `self.lex_pos < byte_len and self.lex_peek() == b'\n'`
            # when lex_pos was at/past end.
            if op == "and" or op == "or":
                int lhs_sc = lower_expr(&ctx, *lhs_box, &gmod)
                int result_local = add_local(&ctx, BOOL_TYPE, None)
                # Initialize result to short-circuit constant so the
                # early-exit path lands on the right value.
                if op == "and":
                    emit(&ctx, GIAssign(result_local, OpConstBool(false)))
                else:
                    emit(&ctx, GIAssign(result_local, OpConstBool(true)))
                int rhs_bb = new_block(&ctx)
                int merge_bb = new_block(&ctx)
                # `and`: if lhs: jump to rhs else merge. `or`: opposite.
                if op == "and":
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), rhs_bb, merge_bb))
                else:
                    set_terminator(&ctx, GTBranch(OpCopy(lhs_sc), merge_bb, rhs_bb))
                switch_to(&ctx, rhs_bb)
                int rhs_sc = lower_expr(&ctx, *rhs_box, &gmod)
                emit(&ctx, GIAssign(result_local, OpCopy(rhs_sc)))
                set_terminator(&ctx, GTJump(merge_bb))
                switch_to(&ctx, merge_bb)
                return result_local
            # `x in collection` membership operator → `collection.contains(x)`.
            # Lower as a Type__contains call on the rhs (the collection)
            # rather than letting it fall through to `map_binop("in")`
            # which would silently mis-compile as `x + collection`.
            # Handles Vector / Set / Dict / String — all expose `contains`
            # in the runtime via collection_runtime_name → gorget_*_contains.
            if op == "in":
                int in_lhs = lower_expr(&ctx, *lhs_box, &gmod)
                int in_rhs = lower_expr(&ctx, *rhs_box, &gmod)
                String coll_tname = local_type_name(in_rhs, ctx, &gmod)
                String contains_method = coll_tname + "__contains"
                # `x in coll` → coll.contains(x): collection is the receiver
                # (OpMove first arg), x is just read by contains — borrow.
                Vector[Operand] in_args = [OpMove(in_rhs), op_consume(ctx, &gmod, in_lhs, CkCallArgBorrow())]
                int in_dst = add_local(&ctx, BOOL_TYPE, None)
                emit(&ctx, GICallExtern(in_dst, contains_method, in_args))
                return in_dst
            # `lhs ?? rhs` — the default operator. `??` is NOT arithmetic; the
            # parser models it as an EBinaryOp with op "??" (parser.gg:838), but
            # falling through to `map_binop("??")` defaults to OP_ADD (WRONG) and
            # emitted `(Option__T)lhs + (Option__T)rhs` (a non-scalar C add).
            # Mirrors Rust gg's `Expr::DefaultOp` lowering
            # (src/ir/lowering/exprs/mod.rs:772-953): if lhs is Some/Ok, unwrap
            # to its inner T; else evaluate rhs (which may be a value OR a
            # divergent `panic(...)` / `return` / `throw`). Built on the same
            # tag-read + branch + payload-read vocabulary as `.unwrap_or()`
            # (lower_expr.gg:1502-1520) fused with the divergent-arm gate from
            # `lower_match_expr` (lower_match.gg:1451-1457) so a divergent rhs
            # contributes no merge edge.
            if op == "??":
                int qq_lhs = lower_expr(&ctx, *lhs_box, &gmod)
                int qq_recv_tid = ctx.locals.get(qq_lhs).unwrap().type_id
                # Classify the lhs off the typed enum_category channel (peels
                # Ptr/MutPtr internally), exactly as unwrap_or does — never a
                # name re-parse. Some(0)/Ok(0) is the success variant; .ok_type
                # is its inner payload tid.
                EnumCategory qq_ec = enum_category_of(&gmod, qq_recv_tid)
                String qq_variant = ""
                if qq_ec.category == ENUM_CAT_OPTION:
                    qq_variant = "Some"
                elif qq_ec.category == ENUM_CAT_RESULT:
                    qq_variant = "Ok"
                if qq_variant != "":
                    int qq_inner_tid = qq_ec.ok_type
                    String qq_recv_tn = local_type_name(qq_lhs, ctx, &gmod)
                    # Round XXXIX Track E: this arm ONLY lowers the inner-T
                    # (unwrap) shape. The Option-preserving shape (owner
                    # Option B, Rust src/ir/lowering/exprs/mod.rs) is
                    # unreachable here because SH TC's `check_default_op_rhs`
                    # explicitly REJECTS carrier-matching RHS with a
                    # lane-specific E_DefaultOpRhsTypeMismatch (SH GIR lacks
                    # direct enum-init; loud check-time reject > loud C-emit
                    # build-fail, Core #8 + #10). Pinned by
                    # `self_host_driver_rejects_default_op_option_preserving_sh_lane_gap`
                    # in tests/integration.rs. When SH GIR grows enum-init,
                    # remove the SH TC reject AND add the extract-and-wrap
                    # branch here (mirror of the Rust arm).
                    int qq_dst = add_local(&ctx, qq_inner_tid, None)
                    int qq_scr_ptr = match_scrutinee_ptr(&ctx, &gmod, qq_lhs)
                    int qq_tag = emit_tag_read(&ctx, qq_scr_ptr, qq_recv_tn, &gmod)
                    # tag == 0 → Some / Ok arm.
                    int qq_cmp = add_local(&ctx, BOOL_TYPE, None)
                    emit(&ctx, GICmp(qq_cmp, CMP_EQ, I64_TYPE, OpCopy(qq_tag), OpConstI64(0)))
                    int qq_some_bb = new_block(&ctx)
                    int qq_else_bb = new_block(&ctx)
                    int qq_merge_bb = new_block(&ctx)
                    set_terminator(&ctx, GTBranch(OpCopy(qq_cmp), qq_some_bb, qq_else_bb))
                    # Some/Ok arm: read the payload, store into the merge slot.
                    switch_to(&ctx, qq_some_bb)
                    int qq_payload = emit_payload_read(&ctx, qq_scr_ptr, qq_recv_tn, qq_variant, 0, qq_inner_tid, &gmod)
                    emit(&ctx, GIAssign(qq_dst, op_consume(ctx, &gmod, qq_payload, CkAssign())))
                    set_terminator(&ctx, GTJump(qq_merge_bb))
                    # None/Error arm: lower the rhs. It may diverge (panic /
                    # return / throw) — its lower_expr then sets a terminator
                    # itself. Only assign + jump when the arm did NOT diverge
                    # (block_terms still GTNone), mirroring lower_match_expr's
                    # divergent-arm gate. A divergent rhs contributes no merge
                    # edge; a value rhs is moved/copied into the T-typed slot.
                    # LAZY: RHS lowered INSIDE the else block — do NOT hoist
                    # (owner ratification 2026-08-09).
                    switch_to(&ctx, qq_else_bb)
                    int qq_rhs = lower_expr(&ctx, *rhs_box, &gmod)
                    match ctx.block_terms.get(ctx.current_block).unwrap():
                        case GTNone():
                            emit(&ctx, GIAssign(qq_dst, op_consume(ctx, &gmod, qq_rhs, CkAssign())))
                            set_terminator(&ctx, GTJump(qq_merge_bb))
                        else:
                            pass
                    switch_to(&ctx, qq_merge_bb)
                    return qq_dst
                # lhs is not an Option/Result (channel miss) — surface it and
                # fall through to the lhs value as a best-effort (never the
                # bogus OP_ADD). A genuine `??` only applies to Option/Result.
                diag_bug("lower_expr", "?? on non-Option/Result lhs — channel miss; returning lhs unchanged")
                return qq_lhs
            # A binop's OPERANDS are scalar/string-typed by the operator, not
            # by the binop's destination. Clear the enclosing `expected_type`
            # so a Result-typed surrounding context (e.g. `return to_n(x) + 5`
            # from a `throws` fn, where SReturn set expected_type to the
            # function's `Result[T,E]` slot) doesn't make the centralized
            # auto-prop hook's capture-form check SUPPRESS the peel on a
            # throws-call operand — leaving a `Result + int` mismatch at C.
            # Mirrors Rust gg's `operators.rs:46-60`.
            int prev_expected_binop = ctx.expected_type
            ctx.expected_type = -1
            int lhs = lower_expr(&ctx, *lhs_box, &gmod)
            int rhs = lower_expr(&ctx, *rhs_box, &gmod)
            ctx.expected_type = prev_expected_binop
            if is_comparison(op):
                # Comparable operator overload: `a < b` etc. on user types →
                # TypeName__compare(&a, b) OP 0.
                String lhs_cmp_name = local_type_name(lhs, ctx, &gmod)
                if gmod.type_infos.contains(lhs_cmp_name) and (op == "<" or op == "<=" or op == ">" or op == ">="):
                    String cmp_method = lhs_cmp_name + "__compare"
                    if gmod.fn_sigs.contains(cmp_method):
                        # `a < b` → Type__compare(a, b): comparison reads only.
                        # Track W: OpBorrow (C ABI `Type__compare(T*, T*)`);
                        # emit_overload_call registers cmp_val for drop (no-op
                        # for I64 return via is_droppable_type gate) + post-call
                        # drops for anonymous owning receivers/RHS temps.
                        Vector[Operand] cmp_args = [OpBorrow(lhs), op_consume(ctx, &gmod, rhs, CkCallArgBorrow())]
                        int cmp_val = add_local(&ctx, I64_TYPE, None)
                        Vector[int] cmp_sources = [lhs, rhs]
                        emit_overload_call(&ctx, &gmod, cmp_method, cmp_args, cmp_val, I64_TYPE, cmp_sources)
                        int zero = add_local(&ctx, I64_TYPE, None)
                        emit(&ctx, GIAssign(zero, OpConstI64(0)))
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, None)
                        emit(&ctx, GICmp(cmp_dst, map_cmpop(op), I64_TYPE, OpCopy(cmp_val), OpCopy(zero)))
                        return cmp_dst
                # Equatable operator overload for ==/!=: `a == b` → a.eq(b) / !a.eq(b).
                if (op == "==" or op == "!=") and gmod.type_infos.contains(lhs_cmp_name):
                    String eq_method = lhs_cmp_name + "__eq"
                    if gmod.fn_sigs.contains(eq_method):
                        # `a == b` → Type__eq(a, b): equality reads only.
                        # Track W: OpBorrow (C ABI `Type__eq(T*, T*) -> bool`);
                        # emit_overload_call gates BOOL result (non-droppable)
                        # → no spurious drop-reg; post-call drops the RHS temp
                        # if it is a fresh inline-ctor.
                        Vector[Operand] eq_args = [OpBorrow(lhs), op_consume(ctx, &gmod, rhs, CkCallArgBorrow())]
                        int eq_dst = add_local(&ctx, BOOL_TYPE, None)
                        Vector[int] eq_sources = [lhs, rhs]
                        emit_overload_call(&ctx, &gmod, eq_method, eq_args, eq_dst, BOOL_TYPE, eq_sources)
                        if op == "==":
                            return eq_dst
                        int neq_dst = add_local(&ctx, BOOL_TYPE, None)
                        emit(&ctx, GIUnOp(neq_dst, UNOP_NOT, BOOL_TYPE, OpCopy(eq_dst)))
                        return neq_dst
                # String ==/!=: content equality via gorget_str_eq(Str, Str).
                # Mirrors Rust src/ir/lowering/exprs/operators.rs:87-95. Without
                # this, String ==/!= falls to the GICmp(I64_TYPE) below — a raw
                # pointer/int compare that breaks for two distinct String
                # instances (and for GtPtr(String) operands from .get().unwrap()).
                # is_string_local unwraps GtPtr/GtMutPtr, so a Ref[String]
                # operand is detected; gorget_str_eq takes operands by pointer
                # and compares CONTENT, so borrow operands are correct whether
                # the operand is a value String or a GtPtr(String).
                if (op == "==" or op == "!=") and (is_string_local(lhs, ctx, &gmod) or is_string_local(rhs, ctx, &gmod)):
                    int eqd = add_local(&ctx, BOOL_TYPE, None)
                    Vector[Operand] str_eq_args = [op_consume(ctx, &gmod, lhs, CkCallArgBorrow()), op_consume(ctx, &gmod, rhs, CkCallArgBorrow())]
                    emit(&ctx, GICallExtern(eqd, "gorget_str_eq", str_eq_args))
                    if op == "==":
                        return eqd
                    int nd = add_local(&ctx, BOOL_TYPE, None)
                    emit(&ctx, GIUnOp(nd, UNOP_NOT, BOOL_TYPE, OpCopy(eqd)))
                    return nd
                int dst = add_local(&ctx, BOOL_TYPE, None)
                emit(&ctx, GICmp(dst, map_cmpop(op), I64_TYPE, op_consume(ctx, &gmod, lhs, CkBinOpArg()), op_consume(ctx, &gmod, rhs, CkBinOpArg())))
                return dst
            # String concatenation: + on string operands → gorget_str_cat(Str, Str)
            if op == "+" and (is_string_local(lhs, ctx, &gmod) or is_string_local(rhs, ctx, &gmod)):
                int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
                int dst = add_local(&ctx, gs_tid, None)
                Vector[Operand] concat_args = []
                # `a + b` (string) → gorget_str_cat(a, b): allocates new
                # String, reads both operands — borrow.
                concat_args.push(op_consume(ctx, &gmod, lhs, CkCallArgBorrow()))
                concat_args.push(op_consume(ctx, &gmod, rhs, CkCallArgBorrow()))
                emit(&ctx, GICallExtern(dst, "gorget_str_cat", concat_args))
                # FRESH-OWNED-TEMP drop registration (#7): `gorget_str_cat`
                # allocates a fresh `GorgetString` (LoOwned). In a NESTED
                # concat `a + b + c`, the inner `a + b` result is borrowed by
                # the outer `+` (CkCallArgBorrow) and orphaned — its heap
                # leaks (ASan: 1400 bytes / 200 str_cat allocs over a 200-iter
                # loop). Registering it at creation makes the scope-exit
                # GIDropIfAlive free it exactly once. SAFE-BY-CONSTRUCTION:
                # when the result is instead MOVED into a named binding
                # (`String s = a + b`), op_consume emits OpMove → GIMoveZero →
                # drop_elab marks the slot IS_UNINITIALIZED and statically
                # deletes the guard, so no double-free; a GorgetString is a
                # runtime resource (LoOwned, droppable), so register_local_for_
                # drop's LoView/LoBorrowed/non-droppable gates pass it through.
                # NOTE (#7 scope): the SISTER leak — a fresh STRUCT/ENUM
                # constructor temp passed to a bare param (`take(Node([1,2,3]))`)
                # — is NOT registered here. That class is entangled with the
                # named-binding move/clone path whose correct (move) resolution
                # unmasks the pre-existing `!`-param-no-drop gap; see TODO.md.
                register_local_for_drop(&ctx, dst, gs_tid, &gmod)
                return dst
            # Vector + Vector concat: `a + b` → clone(a) then extend(&result, b).
            # Mirrors Rust gg's LIR `is_vector_add` arm
            # (src/lir/lower/insts.rs:75-101), gated on the receiver's typed
            # `collection_kind == Array` (CkVector / CkDeque) — NOT a name
            # match. Must run BEFORE the user-op-overload arm below, since
            # `Vector` lives in `type_infos` and would otherwise be routed to
            # the non-existent `Vector__T__add` user method.
            if op == "+":
                String lhs_ckname = local_type_name(lhs, ctx, &gmod)
                CollectionKind lhs_ck = collection_kind_of(&gmod, lhs_ckname)
                if collection_kind_eq(lhs_ck, CkVector()) or collection_kind_eq(lhs_ck, CkDeque()):
                    int arr_tid = ctx.locals.get(lhs).unwrap().type_id
                    # result = gorget_array_clone(&lhs)
                    int cdst = add_local(&ctx, arr_tid, None)
                    Vector[Operand] clone_args = [op_consume(ctx, &gmod, lhs, CkCallArgBorrow())]
                    emit(&ctx, GICallExtern(cdst, "gorget_array_clone", clone_args))
                    # gorget_array_extend(&result, &rhs) — void, no dst (-1).
                    # Self (the cloned result) is borrowed (mutated in place via
                    # the by-pointer ABI), NOT copied — OpCopy on a resource trips
                    # validate_resource_moves. rhs is read-only (CkCallArgBorrow).
                    Vector[Operand] ext_args = [OpBorrow(cdst), op_consume(ctx, &gmod, rhs, CkCallArgBorrow())]
                    emit(&ctx, GICallExtern(-1, "gorget_array_extend", ext_args))
                    register_local_for_drop(&ctx, cdst, arr_tid, &gmod)
                    return cdst
            # Operator overload on user types: if lhs is a user struct/enum,
            # route `a + b` → a.add(b), `a - b` → a.sub(b), etc.
            String op_method = binop_method_name(op)
            if op_method != "":
                String lhs_tname = local_type_name(lhs, ctx, &gmod)
                bool lhs_is_user = gmod.type_infos.contains(lhs_tname)
                # Also consider monomorphized names (Wrapper__int64_t has
                # template Wrapper in type_infos).
                if not lhs_is_user and lhs_tname.contains("__"):
                    int dd = lhs_tname.index_of("__").unwrap()
                    if dd > 0:
                        String tp = lhs_tname.slice(0, dd)
                        if gmod.type_infos.contains(tp):
                            lhs_is_user = true
                if lhs_is_user:
                    String method_full = lhs_tname + "__" + op_method
                    # User op overload `a OP b` → Type__OP(a, b): consult
                    # callee signature for the rhs (lhs is the receiver, C ABI
                    # is `Type__op(T*, T*)` — pass by pointer). bare `T` →
                    # borrow; `!T` → owning.
                    #
                    # Track W (Round XIII): OpBorrow for the receiver, NOT
                    # OpMove. The C ABI already passes the receiver by pointer
                    # via SlotAddr; OpMove would flip the caller-side ownership
                    # tracker (drop-elab) into treating `lhs` as dead after the
                    # call, silently eliding its scope-exit drop → LHS leaks
                    # on all four `overload_arg_temp_*` pins. emit_overload_call
                    # registers the result for drop AND drains anonymous owning
                    # arg-source temps (inline-ctor RHS shapes) post-call —
                    # mirrors Rust `emit_operator_overload_call` at
                    # `src/ir/lowering/exprs/calls.rs:3037-3082`.
                    Vector[Operand] op_args = [OpBorrow(lhs), op_consume(ctx, &gmod, rhs, classify_call_arg(gmod, method_full, 1))]
                    int op_ret = I64_TYPE
                    if gmod.fn_sigs.contains(method_full):
                        op_ret = gmod.fn_sigs.get(method_full).unwrap()
                    else:
                        # Assume op returns lhs type (common for Add/Sub/Mul/Div).
                        int lhs_tid = ctx.locals.get(lhs).unwrap().type_id
                        if lhs_tid != I64_TYPE:
                            op_ret = lhs_tid
                    int op_dst = add_local(&ctx, op_ret, None)
                    Vector[int] op_sources = [lhs, rhs]
                    emit_overload_call(&ctx, &gmod, method_full, op_args, op_dst, op_ret, op_sources)
                    return op_dst
            # Result type of + - * / follows the operand type, not hardcoded
            # I64. Mirrors Rust infer_operand_type_full + bin_op
            # (src/ir/lowering/exprs/operators.rs:54,288). Without this, float
            # arithmetic lowered as I64 → wrong C type, the print-format pick
            # below, and the integer IDiv path (div-by-zero guard) for floats.
            int op_ty = ctx.locals.get(lhs).unwrap().type_id
            int dst = add_local(&ctx, op_ty, None)
            # Fault-catch routing (error-model.md §11.2): inside an active fault
            # scope, an INTEGER faultable op branches to the scope's handler on
            # a fault instead of panicking. Overflow (+/-/*) → overflow handler;
            # div-by-zero (/, %) → divzero handler. Typed gate (op kind +
            # integer type), never a name check. Mirrors Rust `fault_handler_for`
            # (`src/ir/lowering/exprs/operators.rs:332`). The scope is consulted
            # at THIS op's own lowering site; a callee's faults stay deep (its
            # body lowers with a fresh per-function ctx → fresh None scope).
            int binop_code = map_binop(op)
            emit(&ctx, GIBinOp(dst, binop_code, op_ty, op_consume(ctx, &gmod, lhs, CkBinOpArg()), op_consume(ctx, &gmod, rhs, CkBinOpArg())))
            return dst
        case EUnaryOp(op, inner_box):
            int inner = lower_expr(&ctx, *inner_box, &gmod)
            int inner_type = ctx.locals.get(inner).unwrap().type_id
            match op:
                case "-":
                    # Operator overload: -user_struct → user_struct.neg()
                    # Track W: OpBorrow for the receiver (C ABI passes by
                    # pointer); emit_overload_call registers the result AND
                    # post-drops an anonymous owning inner temp — sibling of
                    # binary op / compare / eq / compound-arith.
                    String inner_tname = local_type_name(inner, ctx, &gmod)
                    if gmod.type_infos.contains(inner_tname):
                        String neg_method = inner_tname + "__neg"
                        Vector[Operand] neg_args = [OpBorrow(inner)]
                        int neg_ret = inner_type
                        if gmod.fn_sigs.contains(neg_method):
                            neg_ret = gmod.fn_sigs.get(neg_method).unwrap()
                        int neg_dst = add_local(&ctx, neg_ret, None)
                        Vector[int] neg_sources = [inner]
                        emit_overload_call(&ctx, &gmod, neg_method, neg_args, neg_dst, neg_ret, neg_sources)
                        return neg_dst
                    int dst = add_local(&ctx, inner_type, None)
                    emit(&ctx, GIUnOp(dst, UNOP_NEG, inner_type, OpCopy(inner)))
                    return dst
                case "not":
                    int dst = add_local(&ctx, BOOL_TYPE, None)
                    emit(&ctx, GIUnOp(dst, UNOP_NOT, BOOL_TYPE, OpCopy(inner)))
                    return dst
                case "~":
                    # Bitwise NOT — result keeps the operand's integer type
                    # (mirrors Rust src/ir/lowering/exprs/operators.rs:407,410
                    # where BitNot's result_type == operand_type). Without this
                    # case the `~` was silently dropped (fell through to
                    # `return inner`), corrupting e.g. `cur & ~(mask)` masks.
                    int dst = add_local(&ctx, inner_type, None)
                    emit(&ctx, GIUnOp(dst, UNOP_BITNOT, inner_type, OpCopy(inner)))
                    return dst
                else:
                    pass
            return inner
        case ECall(callee_box, args, targs):
            SpannedExpr callee = *callee_box
            match callee.expr:
                case EIdentifier(fname):
                    # Check if fname is a local variable (callable parameter or closure).
                    # If so, dispatch through closure protocol instead of direct call.
                    # A named local SHADOWS a same-named top-level function (lexical
                    # scoping): `nl_contains` holds ONLY genuine local bindings
                    # (params / var-decls / closures via `nl_put`) — a plain
                    # function call never `nl_put`s its name — so a hit here means a
                    # real shadowing local (`auto pick = (int n): …` over a top-level
                    # `int pick(bool)`) that MUST route through the closure protocol,
                    # NOT the direct function call. A `not fn_sigs.contains(fname)`
                    # guard here would fire ONLY in the shadow case and wrongly pick
                    # the function (test_if_expressions case #20). Redirects still
                    # take priority (call-redirect'd names are not shadowing locals).
                    if nl_contains(ctx, fname) and not gmod.call_redirects.contains(fname):
                        int callable_local = nl_get(ctx, fname)
                        # Lower args
                        Vector[Operand] cl_args = []
                        # Closure/__callable_N dispatch: the callable
                        # itself is a Ptr (op_consume returns OpCopy
                        # regardless of kind for Ptr slots). Args go
                        # through dynamic dispatch — callee signature
                        # isn't available here, so default to borrow
                        # per CLAUDE.md "Ownership at Consuming Positions".
                        cl_args.push(op_consume(ctx, &gmod, callable_local, CkCallArgBorrow()))  # closure/callable as first arg
                        for carg in args:
                            # closure Phase 2 increment 5b — pass a borrow-unique
                            # PARAM identifier THROUGH by pointer (don't deref to a
                            # value). The `__callable_N` adapter expects the param's
                            # `T*` (the same pointer the param slot holds); if we let
                            # the general `lower_expr` EIdentifier reader (:696-706)
                            # run, it auto-derefs a `GtMutPtr(non-resource)` slot to a
                            # by-VALUE struct → the callee derefs the value-as-address
                            # → SIGSEGV (callable_ref_param / generic_callable_ref).
                            # NARROW carve-out (mirrors Rust gg `is_param_borrow_unique`
                            # at calls.rs:1186-1196): only when the arg is an
                            # `EIdentifier` bound to a local that is a `LoParam()`
                            # whose `type_id` is `GtMutPtr(_)`. The `LoParam` gate is
                            # LOAD-BEARING for narrowness — a `&x` borrow TEMP is also
                            # `GtMutPtr` but is NOT `LoParam`, so it stays on the deref
                            # path; ONLY a borrow-unique PARAM is passed by pointer.
                            # `op_consume(..., CkCallArgBorrow())` is a non-consume
                            # kind → returns `OpBorrow(raw_pointer_local)`, forwarding
                            # the pointer bits. The general scalar-read deref
                            # (:696-706) is UNCHANGED (still derefs for `x + 10` etc.).
                            bool carg_passed_ptr = false
                            match carg.value.expr:
                                case EIdentifier(carg_name):
                                    if nl_contains(ctx, carg_name):
                                        int carg_lid = nl_get(ctx, carg_name)
                                        GirLocal carg_loc = ctx.locals.get(carg_lid).unwrap()
                                        bool carg_is_param = false
                                        match carg_loc.ownership:
                                            case LoParam():
                                                carg_is_param = true
                                            else:
                                                pass
                                        if carg_is_param and carg_loc.type_id >= PRIM_COUNT and carg_loc.type_id < gmod.type_table.len():
                                            match gmod.type_table.get(carg_loc.type_id).unwrap():
                                                case GtMutPtr(_):
                                                    cl_args.push(op_consume(ctx, &gmod, carg_lid, CkCallArgBorrow()))
                                                    carg_passed_ptr = true
                                                else:
                                                    pass
                                else:
                                    pass
                            if not carg_passed_ptr:
                                int cval = lower_expr(&ctx, carg.value, &gmod)
                                cl_args.push(op_consume(ctx, &gmod, cval, CkCallArgBorrow()))
                        # Emit as __callable_N (codegen handles this as void*[2] dispatch)
                        int arity = args.len()
                        String cl_call = "__callable_" + int_to_str(arity)
                        # Infer return type from the callable's type (function pointer return type)
                        int cl_ret_type = I64_TYPE
                        # Set true ONLY when an FnPtr-signature arm below reads a
                        # real return tid. When the callable's static type is the
                        # ERASED `GorgetClosure` named struct (a mono'd adapter's
                        # `F` field), NO FnPtr arm fires → `cl_ret_found` stays
                        # false → the typed `expected_type` the WRITER set is read
                        # through below. CLAUDE.md #2 (typed-metadata-read-through,
                        # NOT mangled-name reconstruction).
                        bool cl_ret_found = false
                        int callable_tid = ctx.locals.get(callable_local).unwrap().type_id
                        # Callable params are passed ByPtr — a `Callable` arg is
                        # `Ptr(FnPtr(...))`, and a double-returning callback handed
                        # in through a nested-ptr shape is `Ptr(Ptr(FnPtr(...)))`.
                        # Peel ALL Ptr/MutPtr layers recursively (was a single
                        # hand-unrolled level → a `**fn` never reached the FnPtr →
                        # the return defaulted to I64_TYPE → a `double()` callback
                        # mis-cast `int64_t(*)(...)` → garbage). Mirrors Rust gg's
                        # `extract_callable_return_type` recursive peel.
                        int peeled_tid = peel_ptr_tid(&gmod, callable_tid)
                        if peeled_tid >= 0 and peeled_tid < gmod.type_table.len():
                            GirType ct = gmod.type_table.get(peeled_tid).unwrap()
                            match ct:
                                case GtFnPtr(_, ret_tid):
                                    # GUARD on `!= UNIT_TYPE` (mirror the
                                    # closure_value_ret_type guard below): a
                                    # `void()` callable's recovered UNIT return must
                                    # NOT be cast over a used result — `void value
                                    # not ignored as it ought to be` CC-FAIL. Drop a
                                    # UNIT recovery so it falls through to the
                                    # correct baseline `expected_type` path.
                                    if ret_tid != UNIT_TYPE:
                                        cl_ret_type = ret_tid
                                        cl_ret_found = true
                                else:
                                    pass
                        # closure Phase 2 increment 3 — the callable is the
                        # env-erased `GorgetClosure` value of a closure LOCAL (no
                        # FnPtr sig fired above). Recover the closure's return
                        # type from the typed `closure_value_ret_type`
                        # side-channel the make-site recorded (keyed
                        # `<fn>\0<callable_local>`). WITHOUT this, a non-return
                        # context (`print(greet(...))`) has no `expected_type`
                        # either → the indirect call is cast `int64_t`-return; a
                        # `String` (>16B SysV hidden-sret) result then shifts
                        # env-ptr/sret/args → corruption → SIGSEGV. GUARD on
                        # `!= UNIT_TYPE` is LOAD-BEARING: compute_closure_sig
                        # mis-infers a match/if-tail-value body as UNIT (a
                        # separate filed gap), and a `void`-return cast of a USED
                        # result is a `void value not ignored` CC-FAIL — so a
                        # UNIT recovery is dropped and falls through to the
                        # correct baseline `expected_type` path. Typed
                        # metadata-read-through, not mangled-name reconstruction
                        # (CLAUDE.md #2). Mirrors Rust gg's `callable_return_types`.
                        if not cl_ret_found:
                            String cvrt_key = ctx.current_fn_name + "\0" + int_to_str(callable_local)
                            if gmod.closure_value_ret_type.contains(cvrt_key):
                                int cvrt_ret = gmod.closure_value_ret_type.get(cvrt_key).unwrap()
                                if cvrt_ret != UNIT_TYPE:
                                    cl_ret_type = cvrt_ret
                                    cl_ret_found = true
                        # Fallback: the callable is the erased `GorgetClosure`
                        # struct (no FnPtr sig) — read the WRITER-set
                        # `ctx.expected_type` (the result slot's real type, e.g.
                        # `U`=GorgetString set at SReturn / a double accumulator in
                        # fold[double, F]). GUARD: `>= 0` rejects the -1 sentinel
                        # (cleared by lower_if before the cond), allows all valid
                        # type IDs including primitives (F64_TYPE=10 < PRIM_COUNT=12
                        # but IS a valid return type for cross-type folds).
                        # The defensive `< type_table.len()` bounds-checks struct ids.
                        if not cl_ret_found and ctx.expected_type >= 0:
                            cl_ret_type = ctx.expected_type
                        int cl_dst = add_local(&ctx, cl_ret_type, None)
                        emit(&ctx, GICallExtern(cl_dst, cl_call, cl_args))
                        return cl_dst
                    Vector[SpannedExpr] _lc_vals = callarg_values(args)
                    Vector[String] _lc_names = callarg_names(args)
                    return lower_call(&ctx, fname, _lc_vals, _lc_names, targs, &gmod)
                case EFieldAccess(_, method_name):
                    # Method-style call: obj.method(args) parsed as ECall(EFieldAccess(...))
                    # Lower args but return unit (method calls are complex)
                    for marg in args:
                        lower_expr(&ctx, marg.value, &gmod)
                    int mdst = add_local(&ctx, UNIT_TYPE, None)
                    emit(&ctx, GIAssign(mdst, OpConstUnit()))
                    return mdst
                case EClosure(iife_params, iife_body):
                    # closure Phase 2 increment 1/7: an immediately-invoked
                    # closure `((p…): body)(args)` (IIFE). Lower the EClosure
                    # callee to its GorgetClosure VALUE (the make-site arm mints
                    # the cid, records the LiftedClosure, and the post-pass pushes
                    # __Closure_N__call), then dispatch it exactly like the
                    # named-callable-value call arm above (:1196): closure value
                    # as arg-0, call args borrowed, emit __callable_<arity>. The
                    # codegen passes arg-0 by pointer (needs_ptr_arg) so the
                    # GorgetClosure value's address becomes the void*[2] {fn,env}.
                    # Previously this arm lowered for side-effects and returned
                    # hardcoded OpConstUnit() (`0`), so every IIFE evaluated to 0.
                    int iife_callable = lower_expr(&ctx, callee, &gmod)
                    Vector[Operand] iife_call_args = []
                    iife_call_args.push(op_consume(ctx, &gmod, iife_callable, CkCallArgBorrow()))  # closure value as first arg
                    for iife_arg in args:
                        # closure Phase 2 increment 5b — SIBLING of the named-callable
                        # arg loop above (:1206). Same `__callable_N` dispatch, same
                        # hazard: a borrow-unique PARAM identifier arg must be passed
                        # THROUGH by pointer, not auto-dereffed to a value (the general
                        # EIdentifier reader :696-706 would deref a `GtMutPtr` slot to a
                        # by-VALUE struct → callee derefs value-as-address → SIGSEGV).
                        # Narrow carve-out (LoParam + GtMutPtr) — see :1206 for the full
                        # rationale + the Rust ref (calls.rs:1186-1196). Fixing the
                        # CLASS, not just the named-callable instance (CLAUDE.md
                        # "Sibling-site drift — fix the class, not the instance").
                        bool iife_passed_ptr = false
                        match iife_arg.value.expr:
                            case EIdentifier(iife_name):
                                if nl_contains(ctx, iife_name):
                                    int iife_lid = nl_get(ctx, iife_name)
                                    GirLocal iife_loc = ctx.locals.get(iife_lid).unwrap()
                                    bool iife_is_param = false
                                    match iife_loc.ownership:
                                        case LoParam():
                                            iife_is_param = true
                                        else:
                                            pass
                                    if iife_is_param and iife_loc.type_id >= PRIM_COUNT and iife_loc.type_id < gmod.type_table.len():
                                        match gmod.type_table.get(iife_loc.type_id).unwrap():
                                            case GtMutPtr(_):
                                                iife_call_args.push(op_consume(ctx, &gmod, iife_lid, CkCallArgBorrow()))
                                                iife_passed_ptr = true
                                            else:
                                                pass
                            else:
                                pass
                        if not iife_passed_ptr:
                            int iife_aval = lower_expr(&ctx, iife_arg.value, &gmod)
                            iife_call_args.push(op_consume(ctx, &gmod, iife_aval, CkCallArgBorrow()))
                    int iife_arity = args.len()
                    String iife_call = "__callable_" + int_to_str(iife_arity)
                    # Return type from the closure's signature (body-inferred via
                    # guess_return_type). compute_closure_sig's `cid` arg only
                    # names the env struct / self-ptr — the return_type derivation
                    # is cid-independent (lower_closures.gg:1592-1623), so a
                    # throwaway 0 is safe here.
                    int iife_ret = compute_closure_sig(0, iife_params, iife_body, &gmod, ctx.expected_type).return_type
                    int iife_dst = add_local(&ctx, iife_ret, None)
                    emit(&ctx, GICallExtern(iife_dst, iife_call, iife_call_args))
                    return iife_dst
                case ENoneLiteral():
                    # `None()` call form (e.g. `Dict[String,Option[int]] d = {"b":None()}`).
                    # Route through lower_call as the bare-`None` ctor: lower_call's
                    # fname=="None" + expected_type starts_with "Option__" branch
                    # adopts Option__T and emits IEnumInit(tag=1). Without this the
                    # call fell to `else: pass` → add_local(UNIT_TYPE), ignoring
                    # expected_type and yielding a unit value at an Option boundary.
                    String none_name = "None"
                    Vector[SpannedExpr] _nc_vals = callarg_values(args)
                    Vector[String] _nc_names = callarg_names(args)
                    return lower_call(&ctx, none_name, _nc_vals, _nc_names, targs, &gmod)
                else:
                    pass
            return add_local(&ctx, UNIT_TYPE, None)
        case EMethodCall(recv_box, mname, margs, mtargs_proto):
            # CallArg adapter: this arm's named-arg reorder / default-fill logic
            # keys off the parallel keyword-name list. Derive it once from the
            # typed CallArg args (`.name`); the arg VALUES are read via `.value`
            # element-wise below, so the lowering the arm performs is unchanged.
            Vector[String] _marg_names = callarg_names(margs)
            # #37 Phase 2 hook 1 (mutating method receiver): `v.push(..)` /
            # `v.set(..)` / a `&self`/`!self` user method on a lazy-family
            # source collection is a mutation site — emit the flag-guarded
            # in-place materialize for every family member BEFORE the
            # receiver/args lower (the guards' blocks precede the call's
            # block; the call lands in the join block). Typed dispatch via
            # method_mutates_receiver — the same accessor the cow scan uses.
            if ctx.cow_lazy_members.len() > 0:
                if method_mutates_receiver(*recv_box, mname, &gmod):
                    cow_lazy_materialize_family(&ctx, cow_source_root_name(*recv_box))
            # Static method call: receiver is a TYPE name (e.g. Point.default()
            # or int.parse(s)). Route to TypeName__method with no self argument.
            #
            # Parameterised-type receiver: `Heap[int].new()` /
            # `SparseSet[int].new()` parse as EMethodCall on EIndex, NOT
            # EIdentifier. Detect that pattern and rewrite the receiver
            # as if it were `Heap__int64_t.new()` — the static-method
            # path below will then dispatch to `Heap__int64_t__new()`.
            # Without this, the lowerer would walk into EIndex and
            # lower `Heap` as a bare value identifier, emitting [bug].
            SpannedExpr recv_for_match = *recv_box
            match (*recv_box).expr:
                case EIndex(eix_base_box, eix_idx_box):
                    String eix_base_name = ""
                    String eix_idx_name = ""
                    match (*eix_base_box).expr:
                        case EIdentifier(b):
                            eix_base_name = b
                        else:
                            pass
                    match (*eix_idx_box).expr:
                        case EIdentifier(i):
                            eix_idx_name = i
                        else:
                            pass
                    # CRITICAL discriminator: this synthesizes a MONOMORPHIZED
                    # TYPE receiver (`SetIter[int].next()` → `SetIter__int64_t`,
                    # `Heap[int].new()` → `Heap__int64_t`) for a STATIC method on a
                    # generic type instantiation. It must NOT fire for a VALUE
                    # index-read (`rs[i].clone()`, where `rs` is a local Vector and
                    # `i` an int loop var) — that builds the bogus type name `rs__i`
                    # and `rs[i].clone()` then emits `rs__i__clone()` (undefined
                    # reference at cc).
                    #
                    # The discriminator is BINDING-VS-TYPE: `eix_base_name` is a TYPE
                    # only when it is NOT a bound local variable. `named_locals`
                    # holds every value binding in scope; a local (`rs`, `parts`,
                    # `alts`) is present → value index-read; a generic type name
                    # (`Heap`, `SetIter`, registered nowhere as a value) is absent →
                    # static-method synthesis. This is broader and more correct than
                    # `type_infos.contains` (which misses BUILTIN generic types like
                    # `Heap`/`SlotMap` that are resource types, not type_infos
                    # entries — gating on it regressed `Heap[int].new()`). Typed
                    # binding-table test, no name match.
                    if eix_base_name.len() > 0 and eix_idx_name.len() > 0 and not ctx.named_locals.contains(eix_base_name):
                        # Substitute through `gmod.type_subs` (T → int64_t).
                        if gmod.type_subs.contains(eix_idx_name):
                            int sub_tid = gmod.type_subs.get(eix_idx_name).unwrap()
                            String sub_name = type_id_to_name(sub_tid, &gmod)
                            if sub_name.len() > 0:
                                eix_idx_name = sub_name
                        # Map surface type names to their C-level form
                        # so the mangled mono name matches what's
                        # registered in `type_infos`.
                        if eix_idx_name == "int":
                            eix_idx_name = "int64_t"
                        elif eix_idx_name == "float":
                            eix_idx_name = "double"
                        elif eix_idx_name == "String":
                            eix_idx_name = "GorgetString"
                        String mono_name = eix_base_name + "__" + eix_idx_name
                        # Synthesise an EIdentifier-shaped receiver so
                        # the existing static-method path picks it up.
                        recv_for_match = SpannedExpr(EIdentifier(mono_name), (*recv_box).span)
                else:
                    pass
            match recv_for_match.expr:
                case EIdentifier(ident_name_raw):
                    # Generic type-param substitution. In monomorphized
                    # bodies like `equip [T] SetIter[T] with Iterator[T]:
                    # Option[T] next(...): T out = T.default()`, the `T`
                    # of `T.default()` is a type-parameter name. After
                    # `setup_type_subs(T → int)`, look it up before the
                    # is_type check so `T.default()` dispatches to
                    # `int64_t__default()` rather than falling through to
                    # the EIdentifier-on-`T` value path (which has no
                    # binding and emits a [bug] placeholder).
                    String ident_name = ident_name_raw
                    # -1 = not a generic-param substitution. When `ident_name`
                    # IS a generic type-param (`T`), `type_subs` already
                    # resolved it to a concrete type id; keep that tid so the
                    # `.default()` / `.parse()` static-return arms below can use
                    # it directly instead of round-tripping through the C-name
                    # string (which `prim_name_to_type` can't parse back — it
                    # only accepts surface names like "int", not "int64_t" /
                    # "GorgetString" / "double"). Core #1/#2: carry the typed
                    # tid forward from the write site, never re-derive it from a
                    # name at the read site.
                    int substituted_tid = -1
                    if gmod.type_subs.contains(ident_name):
                        int sub_tid = gmod.type_subs.get(ident_name).unwrap()
                        substituted_tid = sub_tid
                        String sub_name = type_id_to_name(sub_tid, &gmod)
                        if sub_name.len() > 0:
                            ident_name = sub_name
                    # Named locals shadow type names. Without this guard,
                    # a synth local whose name happens to contain `__`
                    # (e.g. `__for_coll_N` from a desugared SFor) gets
                    # picked up by the `__`-infix fallback below and
                    # misrouted to static-method dispatch
                    # (`__for_coll_N.get(i)` → `__for_coll_N__get(i)`,
                    # undefined symbol). The named-local check is also
                    # the safe answer in general: if a binding exists in
                    # scope, it's a value, regardless of name shape.
                    # (Self-host snag #5, 2026-05-14.)
                    bool is_local = nl_contains(ctx, ident_name_raw)
                    bool is_type = false
                    if not is_local:
                        is_type = gmod.type_infos.contains(ident_name)
                    # Also treat primitive type names as types.
                    if not is_type and not is_local:
                        if ident_name == "int" or ident_name == "float" or ident_name == "bool":
                            is_type = true
                        elif ident_name == "String" or ident_name == "byte" or ident_name == "char":
                            is_type = true
                        elif ident_name == "int8" or ident_name == "int16" or ident_name == "int32" or ident_name == "int64":
                            is_type = true
                        elif ident_name == "uint8" or ident_name == "uint16" or ident_name == "uint32" or ident_name == "uint64":
                            is_type = true
                        elif ident_name == "float32" or ident_name == "float64":
                            is_type = true
                        # C-level primitive names — these arrive after
                        # `gmod.type_subs` substitution where `T → int64_t`
                        # (the C type name, not the Gorget surface `int`).
                        elif ident_name == "int64_t" or ident_name == "int32_t" or ident_name == "int16_t" or ident_name == "int8_t":
                            is_type = true
                        elif ident_name == "uint64_t" or ident_name == "uint32_t" or ident_name == "uint16_t" or ident_name == "uint8_t":
                            is_type = true
                        elif ident_name == "double" or ident_name == "GorgetString":
                            is_type = true
                        # Generic prelude types — `Box.new(x)` /
                        # `Heap.new()` etc. show up as static-method
                        # calls in surface syntax. The unparameterised
                        # name isn't in `type_infos` (only mono'd
                        # `Box__T` is), so it'd fall through to the
                        # bare-EIdentifier path and emit `[bug]`.
                        elif ident_name == "Box" or ident_name == "Heap":
                            is_type = true
                        elif ident_name == "Vector" or ident_name == "Deque":
                            is_type = true
                        elif ident_name == "Dict" or ident_name == "HashMap":
                            is_type = true
                        elif ident_name == "Set" or ident_name == "HashSet":
                            is_type = true
                        elif ident_name == "Channel" or ident_name == "Shared" or ident_name == "Weak":
                            is_type = true
                        elif ident_name == "Option" or ident_name == "Result":
                            is_type = true
                        # Monomorphized generic types — `Container__Foo`,
                        # `Heap__int64_t`, `SparseSet__int64_t`, etc. arrive
                        # here after the EIndex rewrite above. They may not
                        # be in `type_infos` yet (registration happens lazily
                        # during lowering, sometimes after the call site),
                        # but a `__` separator in an identifier is reliable
                        # signal it's a mangled type — Gorget's surface
                        # syntax doesn't allow identifiers to contain `__`.
                        elif ident_name.contains("__"):
                            is_type = true
                    if is_type:
                        # `Box.new(x)` / `Heap.new()` etc. parse as a static
                        # method call, but `Box.new(value)` is semantically the
                        # bare-name `Box(value)` constructor (heap-alloc). Rust
                        # gg normalises both entry points to identical IR
                        # (`src/ir/lowering/exprs/methods.rs:128` mirrors the
                        # `Box(value)` ctor at `exprs/mod.rs:1638`). Route the
                        # self-host `Box.new(x)` through `lower_call("Box", …)`
                        # so it hits the canonical `func_name == "Box"`
                        # IBoxAlloc path in lir_lower (emit_box_alloc) — instead
                        # of the generic static path, which mangles `Box__new`
                        # and (via the box-alloc generator) emits a bogus
                        # `__gorget_box_alloc_new(__gg_new)` → cc-fail.
                        if ident_name == "Box" and mname == "new" and margs.len() == 1:
                            String _box_ctor = "Box"
                            Vector[SpannedType] _box_no_targs = []
                            Vector[String] _box_no_names = []
                            Vector[SpannedExpr] _box_vals = callarg_values(margs)
                            return lower_call(&ctx, _box_ctor, _box_vals, _box_no_names, _box_no_targs, &gmod)
                        # Static method / variant ctor: dispatch via
                        # classify_call_arg against the mangled callee
                        # name. Built early enough that the callee name
                        # may not yet be in fn_move_params (lazy
                        # registration); classify_call_arg defaults to
                        # CkCallArgBorrow when the lookup misses — correct
                        # per the docs.
                        Vector[Operand] static_args = []
                        # Compute the mangled callee name once for
                        # classify_call_arg lookups. Mirrors the post-loop
                        # `static_name` build below.
                        String _static_call = ident_name
                        if ident_name == "int":
                            _static_call = "int64_t"
                        elif ident_name == "float":
                            _static_call = "double"
                        elif ident_name == "String":
                            _static_call = "GorgetString"
                        _static_call = _static_call + "__" + mname
                        int _sai = 0
                        # Trait-static-method redirect (below) disambiguates
                        # overlapping `From[A]`/`From[B]` impls by the FIRST
                        # arg's C-type, which is baked into the trait prefix
                        # (`From__<arg0_c>_for_<Type>__from`). Capture arg0's
                        # type_id here so the search key can spell it.
                        int _static_arg0_tid = -1
                        # STATIC equip-method named-arg REORDER + default-fill.
                        # A static method (`Maker.make(5)` for `Maker make(int a,
                        # int b = 7)`) has NO self, so `fn_param_names`/`fn_defaults`
                        # (keyed by the Gorget `Type__method` mangling) carry no
                        # self slot. Reorder named args by slot and fill trailing
                        # defaults so `gg check` (which accepts) and lowering agree
                        # (else "too few arguments to function 'Maker__make'").
                        # Mirrors the instance-method reorder above and Rust gg's
                        # static default-fill (`methods.rs`). Enum-variant ctors
                        # carry no fn_defaults entry → no-op.
                        String _s_defaults_key = ident_name + "__" + mname
                        Vector[SpannedExpr] static_margs = callarg_values(margs)
                        bool _s_has_named = false
                        int _sn_i = 0
                        while _sn_i < _marg_names.len():
                            if _marg_names.get(_sn_i).unwrap() != "":
                                _s_has_named = true
                            _sn_i += 1
                        bool _s_did_reorder = false
                        if _s_has_named and gmod.fn_param_names.contains(_s_defaults_key):
                            Vector[String] _s_pnames = gmod.fn_param_names.get(_s_defaults_key).unwrap()
                            int _s_skip = 0
                            if _s_pnames.len() > 0 and _s_pnames.get(0).unwrap() == "self":
                                _s_skip = 1
                            int _s_n = _s_pnames.len() - _s_skip
                            Vector[bool] _s_filled = []
                            Vector[SpannedExpr] _s_expr = []
                            int _ssi = 0
                            while _ssi < _s_n:
                                _s_filled.push(false)
                                _s_expr.push(margs.get(0).unwrap().value)
                                _ssi += 1
                            bool _s_ok = true
                            int _s_pos = 0
                            int _sr_i = 0
                            while _sr_i < margs.len() and _s_ok:
                                String _sr_name = ""
                                if _sr_i < _marg_names.len():
                                    _sr_name = _marg_names.get(_sr_i).unwrap()
                                if _sr_name != "":
                                    int _s_target = -1
                                    int _sp_i = 0
                                    while _sp_i < _s_n:
                                        if _s_pnames.get(_sp_i + _s_skip).unwrap() == _sr_name:
                                            _s_target = _sp_i
                                        _sp_i += 1
                                    if _s_target < 0:
                                        _s_ok = false
                                    else:
                                        _s_filled.set(_s_target, true)
                                        _s_expr.set(_s_target, margs.get(_sr_i).unwrap().value)
                                else:
                                    while _s_pos < _s_n and _s_filled.get(_s_pos).unwrap():
                                        _s_pos += 1
                                    if _s_pos < _s_n:
                                        _s_filled.set(_s_pos, true)
                                        _s_expr.set(_s_pos, margs.get(_sr_i).unwrap().value)
                                        _s_pos += 1
                                    else:
                                        _s_ok = false
                                _sr_i += 1
                            if _s_ok:
                                Vector[Option[SpannedExpr]] _sr_defaults = []
                                if gmod.fn_defaults.contains(_s_defaults_key):
                                    _sr_defaults = gmod.fn_defaults.get(_s_defaults_key).unwrap()
                                int _sf_i = 0
                                while _sf_i < _s_n and _s_ok:
                                    if not _s_filled.get(_sf_i).unwrap():
                                        int _sf_si = _sf_i + _s_skip
                                        if _sf_si < _sr_defaults.len():
                                            match _sr_defaults.get(_sf_si).unwrap():
                                                case Some(_sfd_expr):
                                                    _s_filled.set(_sf_i, true)
                                                    _s_expr.set(_sf_i, _sfd_expr)
                                                case None:
                                                    _s_ok = false
                                        else:
                                            _s_ok = false
                                    _sf_i += 1
                            if _s_ok:
                                static_margs = []
                                int _sc_i = 0
                                while _sc_i < _s_n:
                                    static_margs.push(_s_expr.get(_sc_i).unwrap())
                                    _sc_i += 1
                                _s_did_reorder = true
                        if not _s_did_reorder:
                            static_margs = callarg_values(margs)
                            if gmod.fn_defaults.contains(_s_defaults_key):
                                Vector[Option[SpannedExpr]] _s_defaults = gmod.fn_defaults.get(_s_defaults_key).unwrap()
                                int _s_skip2 = 0
                                if gmod.fn_param_names.contains(_s_defaults_key):
                                    Vector[String] _s_pn2 = gmod.fn_param_names.get(_s_defaults_key).unwrap()
                                    if _s_pn2.len() > 0 and _s_pn2.get(0).unwrap() == "self":
                                        _s_skip2 = 1
                                int _sdf_si = static_margs.len() + _s_skip2
                                while _sdf_si < _s_defaults.len():
                                    match _s_defaults.get(_sdf_si).unwrap():
                                        case Some(_sdf_expr):
                                            static_margs.push(_sdf_expr)
                                        else:
                                            pass
                                    _sdf_si += 1
                        for sma in static_margs:
                            int sma_val = lower_expr(&ctx, sma, &gmod)
                            if _sai == 0:
                                _static_arg0_tid = ctx.locals.get(sma_val).unwrap().type_id
                            static_args.push(op_consume(ctx, &gmod, sma_val, classify_call_arg(gmod, _static_call, _sai)))
                            _sai += 1
                        # Primitive method names need C-runtime mangling.
                        String type_prefix = ident_name
                        if ident_name == "int":
                            type_prefix = "int64_t"
                        elif ident_name == "float":
                            type_prefix = "double"
                        elif ident_name == "String":
                            type_prefix = "GorgetString"
                        String static_name = type_prefix + "__" + mname
                        int static_ret = I64_TYPE
                        # Qualified enum variant constructor: `EnumName.Variant(args)`
                        # is parsed as EMethodCall(EIdentifier(EnumName), "Variant",
                        # args). The static-method path mangles to
                        # `EnumName__Variant` — for variants this is a constructor,
                        # not a real method, so the return type is the enum struct
                        # itself. Without this, `static_ret` falls through to
                        # I64_TYPE and the destination local lands at int64_t —
                        # the C codegen then tries to assign a 100+ byte enum
                        # struct literal into a scalar slot and barfs with
                        # "incompatible types when assigning to type 'int64_t'
                        # from type '__gg_Foo'". Mirrors Rust gg's enum-variant
                        # branch in `src/ir/lowering/exprs/methods.rs` (snag #51).
                        bool is_variant_ctor = false
                        if gmod.type_infos.contains(ident_name):
                            GirTypeInfo enum_info = gmod.type_infos.get(ident_name).unwrap()
                            if enum_info.is_enum:
                                for evv in enum_info.variants:
                                    if evv.name == mname:
                                        is_variant_ctor = true
                                        break
                        if is_variant_ctor:
                            static_ret = lookup_or_register_named(&gmod, ident_name)
                        elif gmod.fn_sigs.contains(static_name):
                            static_ret = gmod.fn_sigs.get(static_name).unwrap()
                        elif mname == "default" or mname == "one":
                            # `.default()` (additive identity) AND `.one()`
                            # (multiplicative identity, Numeric) BOTH return the
                            # RECEIVER type. Root A2 (R43): the `.one()` arm was
                            # missing, so `T acc = T.one()` in the `product`
                            # default fell through to I64_TYPE — `acc` landed
                            # int64_t while `double__one()` returns double, so the
                            # loop's `acc * x` lowered as INTEGER mul (op_ty =
                            # lhs/acc type) → `vf.iter().product()` computed 0.0
                            # instead of 1.875. Mirrors the `.default()` handling.
                            if substituted_tid >= 0:
                                # Generic-param substitution: the tid `type_subs`
                                # already resolved. Use it directly — DO NOT
                                # reconstruct it from the C-name (int64_t /
                                # GorgetString / double) via `prim_name_to_type`,
                                # which returns -1 for C-names → static_ret stays
                                # I64_TYPE → the slot lands int64_t while the call
                                # returns Str/double → C "incompatible types".
                                static_ret = substituted_tid
                            elif gmod.type_infos.contains(ident_name):
                                static_ret = lookup_or_register_named(&gmod, ident_name)
                            else:
                                # int.default() → int, float.default() → double, etc.
                                int pt = prim_name_to_type(ident_name)
                                if pt >= 0:
                                    static_ret = pt
                        elif mname == "parse":
                            # int.parse(s) returns Option[int]. Same class as
                            # `.default()` above (Core #4): a generic-param
                            # substitution carries its resolved tid in
                            # `substituted_tid`; use it as the inner type instead
                            # of `prim_name_to_type(ident_name)`, which returns -1
                            # for the substituted C-name. (Untested by the current
                            # corpus — no fixture exercises a substituted
                            # `T.parse()` — but it is the same lost-metadata class
                            # and costs nothing to close.)
                            int pt = prim_name_to_type(ident_name)
                            if substituted_tid >= 0:
                                pt = substituted_tid
                            if pt >= 0:
                                String opt_name = "Option__" + type_id_to_name(pt, &gmod)
                                static_ret = lookup_or_register_named(&gmod, opt_name)
                                record_enum_category(&gmod, static_ret, ENUM_CAT_OPTION, pt, -1)
                        else:
                            int binfer = builtin_call_return_type(static_name, &gmod)
                            if binfer >= 0:
                                static_ret = binfer
                        # Trait-static-method symbol redirect (sibling of the
                        # instance-method redirect at ~:2182). A trait impl /
                        # `@derive(From)` / equip-trait emits the static method
                        # BODY under the trait-prefixed mangling
                        # (`From__<arg0_c>_for_<Type>__from`,
                        # `Default_for_<Type>__default`, etc. — see
                        # lower_closures.gg lower_equip_block :361), NOT the bare
                        # `<Type>__<method>` this call site reconstructs. The
                        # bare name is undeclared → C implicit-int → `incompatible
                        # types … from type 'int'` (CC-FAIL). A PHANTOM bare
                        # `<Type>__<method>` sits in fn_sigs (it carries the
                        # correct RETURN type, used by the static_ret chain
                        # above), so a `contains` gate would never fire — run the
                        # redirect UNCONDITIONALLY (skip only variant ctors, which
                        # are real struct ctors, never trait impls). Mirrors Rust
                        # gg src/ir/lowering/exprs/methods.rs:298-326.
                        #
                        # DISAMBIGUATION (load-bearing): overlapping impls on the
                        # SAME type (`equip UserId with From[int]` AND
                        # `From[Label]`) both end `_for_UserId__from`. The arg0
                        # C-type qualifier in the trait prefix is what tells them
                        # apart, so try the arg-type-qualified suffix
                        # `__<arg0_c>_for_<Type>__<method>` FIRST. type_id_to_name
                        # peels Ptr/MutPtr, so a borrowed arg resolves to the same
                        # name the equip-site baked in (int64_t / double / Label).
                        # Only if that misses (a no-arg trait method like
                        # Default::default, or no arg-qualified key) fall back to
                        # the bare `_for_<Type>__<method>` suffix. No `_for_`
                        # match at all ⇒ a plain non-trait static method ⇒ keep
                        # the bare name untouched.
                        if not is_variant_ctor:
                            String _ts_for_suffix = "_for_" + type_prefix + "__" + mname
                            String _ts_redirect = ""
                            String _ts_arg_qual = ""
                            if _static_arg0_tid >= 0:
                                _ts_arg_qual = "__" + type_id_to_name(_static_arg0_tid, &gmod) + _ts_for_suffix
                            Vector[String] _ts_keys = gmod.fn_sigs.keys()
                            int _tsk = 0
                            # Pass 1: arg-type-qualified (disambiguates overloads).
                            if _ts_arg_qual != "":
                                while _tsk < _ts_keys.len():
                                    String _cand = _ts_keys.get(_tsk).unwrap()
                                    if _cand.ends_with(_ts_arg_qual):
                                        _ts_redirect = _cand
                                    _tsk += 1
                            # Pass 2: bare `_for_` suffix (no-arg trait methods).
                            if _ts_redirect == "":
                                _tsk = 0
                                while _tsk < _ts_keys.len():
                                    String _cand = _ts_keys.get(_tsk).unwrap()
                                    if _cand.ends_with(_ts_for_suffix):
                                        _ts_redirect = _cand
                                    _tsk += 1
                            if _ts_redirect != "":
                                static_name = _ts_redirect.clone()
                        int sdst = add_local(&ctx, static_ret, None)
                        emit(&ctx, GICallExtern(sdst, static_name, static_args))
                        # Bug D (Core #4, sibling 4/4): this static-method / variant-
                        # ctor / trait-static path returns here BEFORE the generic
                        # method-call `register_local_for_drop` (~:4265). `sdst` is
                        # the extern call's owned return value (LoOwned) — a
                        # `default()`/static-ctor that yields a genuinely HEAP-owned
                        # resource (`Res.default()` building a heap String, a static
                        # `F.make()` returning a runtime-built String) LEAKED when
                        # discarded (measured: 33B static String / 27B struct-with-
                        # String). Register `sdst`; self-gating no-ops POD returns
                        # (`int.default()` → I64, `int.parse()` → Option[int]:
                        # is_droppable_type skips both). A static method that returns
                        # a bare string LITERAL yields a cap=0 view VALUE in the
                        # LoOwned slot — it registers, but the scope-exit
                        # `gorget_string_free` no-ops on cap=0, so it stays CLEAN (no
                        # double-free). Bound/consumed results move-zero the temp so
                        # its DropIfAlive no-ops.
                        register_local_for_drop(&ctx, sdst, static_ret, &gmod)
                        return sdst
                else:
                    pass
            # unwrap() / unwrap_or() — extract the payload field from the
            # Option/Result receiver. Previously a no-op GIAssign copy with
            # a re-typed target, which silently mishandled aggregate receivers:
            # `.unwrap_or(0)` on a `Result[int, ParseError]` emits "0" via
            # emit_variant_arg's aggregate-arg/scalar-expected fallback,
            # losing the actual Ok_0 value. Now emits a real field read
            # through the `__field_read_<enum>_<Variant>_0` helper, same as
            # PConstructor destructure.
            #
            # ── R37 T1 (S3/S4): CoW G1/G1a decide-at-root materialize for a
            # mutating-method receiver whose root is a bare (immutable-in-
            # context) by-value param. Supersedes the R35 T4 builtin-only,
            # single-level `EFieldAccess(EIdentifier)` block; the shared
            # `cow_materialize_projected_root` helper walks `cow_source_root_name`
            # so ONE call covers every receiver shape (named / index-projected /
            # field-of-index / field-path). Mirrors Rust cow_before_mutation on
            # the projection root (methods.rs:1851). Helper skips a `&`/`!`
            # (GtMutPtr, caught by is_mut_borrow_param_local), owned (LoOwned≠
            # LoParam), or POD/`.get()`-view root (0 clone); rebinds root→LoOwned
            # (idempotent per root in the statement).
            #
            # ⚠ GATE (load-bearing — a full `method_mutates_receiver` gate is a
            # ~14 GB clone bomb on the self-compile, OOM-kills the bootstrap):
            #   • BUILTIN mutating (`builtin_method_mutates` is_mutating) →
            #     materialize on ANY receiver shape. Covers S4 builtin push
            #     (`v.push(v[0])`, `m[0].push(m[1][0])`).
            #   • USER method (builtin lookup None) → materialize ONLY on a
            #     PROJECTED receiver (EIndex / EFieldAccess base), gated on
            #     `method_mutates_receiver`. Covers S3 (`v[0].set_name(x)`,
            #     `v[0].inner.set_name(x)`) + `v[0].set_from(v[1])`.
            #   • NAMED USER receiver (builtin lookup None, bare EIdentifier) →
            #     materialize ONLY when the R38 `&self` mutation-inference pass
            #     classified the method a GENUINE mutator of the receiver type
            #     (`mutinf_named_recv_writes_self`). A blanket `&self`⇒mutating
            #     over-approx here is the ~14 GB clone bomb (a read-only `&self`
            #     getter / `.clone()` in a hot loop deep-clones the whole root),
            #     so the pass separates read-only `&self` from mutating: only the
            #     latter clone. This CLOSES the R37 T1 named-receiver
            #     write-through divergence while keeping peak self-compile RSS at
            #     ~1 GB (== baseline). A false read-only degrades to the BASE
            #     write-through (no NEW miscompile — the gate below is itself
            #     double-gated on a bare-value root); the residuals
            #     (generic-equip instances, name-collision on an unresolvable
            #     self-projection) are FILED in TODO.md per Core #8.
            bool _r37_mut = false
            match builtin_method_mutates(mname):
                case Some(_r37d):
                    _r37_mut = _r37d.is_mutating
                    # R38 name-collision guard (Core #4 — keep the GATE
                    # user-first for EVERY receiver shape, mirroring both the
                    # SCAN's user→builtin order and method_mutates_receiver):
                    # a user `&self`-mutator whose name COLLIDES with a READ-ONLY
                    # builtin (`get`/`map`/`peek`/`values`/`find`/…) must still
                    # materialize — the builtin table says read-only but the
                    # user-first classification has the correct (mutating)
                    # answer. Applies to a bare NAMED receiver (via
                    # `mutinf_named_recv_writes_self`) AND to a PROJECTED
                    # receiver (`v[0].get()` / `o.inner.get()`, via the shipping
                    # user-first `method_mutates_receiver`, which resolves the
                    # projected/element type). ORs `true` ONLY for a genuine
                    # user mutator (rare) → bomb-free (still double-gated on a
                    # bare-value root by cow_materialize_projected_root; a
                    # genuine projected builtin call `s.items[0].len()` resolves
                    # to `Elem__len`, absent from method_mutates_self → stays
                    # false, no clone. `mutinf_projected_recv_writes_self` walks
                    # the projection (named / `v[i]` / `s.v[i]` / `o.inner`) to
                    # the element/field type and reads the PRECISE
                    # method_mutates_self map, so it is user-first for EVERY
                    # receiver shape — NOT method_mutates_receiver, which returns
                    # the builtin's read-only answer for a projected receiver
                    # (lookup_expr_gir_type does not key projections at lowering).
                    if not _r37_mut:
                        if mutinf_projected_recv_writes_self(&ctx, &gmod, *recv_box, mname):
                            _r37_mut = true
                case None:
                    match (*recv_box).expr:
                        case EIndex(_r37ib, _r37ii):
                            # 2E-SH: a SELF-ROOTED projected receiver (`self.v[i].m()`)
                            # must use the PRECISE mutation-inference gate, not the
                            # conservative `method_mutates_receiver` (which returns TRUE
                            # for an unresolvable self-projection — a false positive that,
                            # now that plain self is a materializable LoParam, would clone
                            # self inside a READ-ONLY method). `mutinf_projected_recv_writes_self`
                            # resolves the projected type and reads `method_mutates_self`
                            # (genuine user &self/!self mutators only) → bomb-safe. Non-self
                            # receivers keep the existing conservative gate (unchanged).
                            if mutinf_expr_is_self_rooted(*recv_box):
                                _r37_mut = mutinf_projected_recv_writes_self(&ctx, &gmod, *recv_box, mname)
                            else:
                                _r37_mut = method_mutates_receiver(*recv_box, mname, &gmod)
                        case EFieldAccess(_r37fb, _r37ff):
                            # 2E-SH: same self-rooted precise-gate routing as EIndex above
                            # (`self.id.hash(&h)` in a derived Hashable body must NOT clone
                            # self — int's `hash` is read-only, absent from method_mutates_self).
                            if mutinf_expr_is_self_rooted(*recv_box):
                                _r37_mut = mutinf_projected_recv_writes_self(&ctx, &gmod, *recv_box, mname)
                            else:
                                _r37_mut = method_mutates_receiver(*recv_box, mname, &gmod)
                        case EIdentifier(_r37id):
                            # R38: a NAMED (bare-identifier) receiver materializes
                            # ONLY when the `&self`/`!self` mutation-inference pass
                            # classified `mname` as a GENUINE mutator of this
                            # receiver type. A read-only `&self` (getter/.clone())
                            # stays borrowed → no clone bomb; a real mutator flips
                            # WRONG→correct (closes the R37 T1 named-receiver
                            # write-through divergence). Supersedes the deliberate
                            # "named receivers never materialize" narrowing.
                            _r37_mut = mutinf_named_recv_writes_self(ctx, &gmod, _r37id, mname)
                        else:
                            pass
            if _r37_mut:
                cow_materialize_projected_root(&ctx, &gmod, *recv_box)
            # Track V — SH mirror of Rust's `try_resolve_index_element_ptr`
            # method-receiver path (src/ir/lowering/exprs/methods.rs:2229-2266).
            # A bare Index mut receiver `cs[i].bump()` on a VALUE-typed element
            # is silently dropped by the base `lower_recv_place` path: its
            # EIndex fallback runs `lower_expr(EIndex)` → `lower_index_access`
            # which mints a VALUE COPY (`gorget_array_get` typed as the bare
            # element, not `Ptr(elem)`), so the mut method borrows that
            # throwaway and the mutation never reaches the collection buffer.
            # Route mutating-method Index receivers through the shared
            # WRITE-ONLY element-ptr producer instead — the returned `GtPtr(elem)`
            # (LoBorrowed) aliases the collection's heap slot; downstream the
            # method-call arm sees `LoBorrowed` → `OpBorrow(recv)`, and the LIR
            # `OpBorrow` arm (lir_lower.gg:~3665) detects a Ptr-typed slot and
            # emits `ISlotLoad` of the pointer VALUE (not `&slot`), so the
            # method's `T* self` ABI receives the buffer-slot address. The
            # sibling EFieldAccess arm below (Track X) handles the nested
            # `hs[0].c.bump()` shape by routing through `lower_amp_place`.
            #
            # 1B lesson (DONE.md 2026-07-16): this producer is WRITE-ONLY. A
            # value-struct `.clone()` receiver on the SAME `cs[i]` shape must
            # stay a value read (`.clone()` is Copy-ish-elided to identity —
            # returning the receiver's value directly; a pointer receiver would
            # assign `void*` into a value dst → cc-fail). The `_r37_mut` gate
            # (the SAME typed mutation flag used for the CoW materialize above)
            # is exactly Rust's `needs_mut` filter — read-only methods skip
            # this path unchanged. `require_struct_elem=false` mirrors the
            # `&`-formation call-arg producer (`lower_amp_place` EIndex, :752):
            # a scalar-element mutating method (unusual but permitted; e.g. a
            # trait-instance user equip on int) still wants the ptr.
            int recv = -1
            if _r37_mut:
                match (*recv_box).expr:
                    case EIndex(_tv_coll_box, _tv_idx_box):
                        recv = lower_index_element_ptr_place(&ctx, *_tv_coll_box, *_tv_idx_box, true, false, &gmod)
                    case EFieldAccess(_, _):
                        # Track 2F — sibling of the EIndex arm above for the
                        # nested-place mut method receiver `hs[0].c.bump()`
                        # (EFieldAccess-of-EIndex) and any EFieldAccess-rooted
                        # place shape. `lower_amp_place` is the SAME shared
                        # `&`-formation write-only producer used by
                        # `lower_field_place_base`'s EFieldAccess arm
                        # (`lower_stmt.gg`), so the mut-method receiver face
                        # and the field-store face cannot drift into a
                        # served-at-one-face asymmetry. It recurses through
                        # `amp_object_base` on the base (`hs[0]` → element
                        # pointer via `lower_index_element_ptr_place`), then
                        # loads the field via `GIFieldLoad` into a
                        # `GtPtr(field)+LoBorrowed` dst — an alias INTO the
                        # collection's heap buffer. Declines (-1) for a
                        # `Ref[T]`/`MutRef[T]` field (their storage IS the
                        # pointer) or a ReadGuard base, falling through to
                        # `lower_recv_place` unchanged.
                        recv = lower_amp_place(&ctx, *recv_box, &gmod)
                    else:
                        pass
            # Place base — a method receiver is passed as `self` BY POINTER,
            # so a `&`/`!`-param (`GtMutPtr`) receiver must stay the pointer
            # (else the method mutates a discarded dereffed copy, not the
            # caller's value). `lower_recv_place` additionally borrows a
            # struct-FIELD receiver IN PLACE (`self.inner.next()`) so a
            # mutating `&self` method advances the real field, not a discarded
            # by-value copy (ROOT-A lazy-iterator SPIN); it delegates every
            # non-field-receiver shape to `lower_place_base` unchanged, which
            # bypasses Edit-1's value-read deref for a bare identifier.
            if recv < 0:
                recv = lower_recv_place(&ctx, *recv_box, &gmod)
            if mname == "unwrap" or mname == "unwrap_or" or mname == "expect":
                # `unwrap`, `expect`, and `unwrap_or` share this intercept so
                # the Option[Ref[T]] ref-payload deref (Phase 3 below) applies
                # to all three — mirrors Rust's single
                # `matches!(method_name, "unwrap" | "expect" | "unwrap_or")`
                # arm (src/ir/lowering/exprs/methods.rs:681). Without `expect`
                # here it fell through to the generic `__option_expect`
                # combinator, which returned the raw `Some_0` pointer for an
                # `Option[int &]` instead of dereferencing it (garbage value).
                # Lower the default value first (for `unwrap_or` ONLY) and
                # capture its local id — needed if we synthesize a tag check
                # below. `unwrap` (no args) leaves this at -1; `expect`'s arg is
                # the panic MESSAGE, not a default — like Rust, the success path
                # ignores it (it would only matter on the None panic, which the
                # plain-unwrap path below does not emit), so we still lower it
                # for its side effects but never use it as a default.
                int default_local = -1
                int uoi = 0
                while uoi < margs.len():
                    int lo = lower_expr(&ctx, margs.get(uoi).unwrap().value, &gmod)
                    if uoi == 0 and mname == "unwrap_or":
                        default_local = lo
                    uoi += 1
                # Determine the wrapper type, inner type name, and variant.
                String recv_tn = local_type_name(recv, ctx, &gmod)
                String variant_name = ""
                String inner_name_str = ""
                # option_ref_borrow Phase 3 (typed path, no name-matching):
                # for a borrowing-getter result `Option[Ref[T]]`, the payload
                # is a real `GtPtr(T)` recorded at registration. Read it from
                # the typed `option_ref_payload` channel keyed on the receiver
                # Option's GIR id — the unwrap then mints the pointer directly,
                # never slicing the `Ref__` infix out of recv_tn. The
                # downstream emit_payload_read GtPtr guard returns the pointer
                # (no clone); field-access auto-derefs; op_consume clones the
                # pointee only at owning positions (§2 table).
                int recv_type_id = ctx.locals.get(recv).unwrap().type_id
                int ref_payload_tid = option_ref_payload_of(&gmod, recv_type_id)
                # `enum_category_of` peels Ptr/MutPtr internally, so a raw
                # `recv_type_id` that is a `GtPtr(Option__…)` (projected/borrowed
                # recv) still classifies correctly.
                EnumCategory recv_ec = enum_category_of(&gmod, recv_type_id)
                # The Ok/Some payload TYPE comes from the typed `enum_category`
                # channel (`recv_ec.ok_type`), recorded at the mint site with the
                # already-monomorphized payload tid — NEVER re-derived by slicing
                # the mangled `recv_tn` at a `__` boundary. That slice is
                # AMBIGUOUS for a compound Ok payload whose own name contains
                # `__` (`Result__Vector__Item__GorgetString`): the first-`__`
                # split yields a bare `Vector`, which registers a degenerate
                # `__gg_Vector` placeholder struct and cc-errors `incompatible
                # types … '__gg_Vector' from 'GorgetArray'`. CLAUDE.md "No name
                # matching" / Layering rule 2 — read the typed tid, don't reparse
                # the name. The `inner_name_str` (used only to recover a SCALAR
                # inner tid below + as the panic/expect label) is taken from the
                # typed tid's canonical name so the two never disagree.
                int channel_ok_tid = recv_ec.ok_type
                if recv_ec.category == ENUM_CAT_OPTION:
                    variant_name = "Some"
                    inner_name_str = recv_tn.slice(8, recv_tn.len())
                elif recv_ec.category == ENUM_CAT_RESULT:
                    variant_name = "Ok"
                    # Ok type: longest-prefix scan for first `__` splits
                    # Result__<OkT>__<ErrT>.
                    String rest = recv_tn.slice(8, recv_tn.len())
                    int split = rest.index_of("__").unwrap_or(-1)
                    if split > 0:
                        inner_name_str = rest.slice(0, split)
                # Prefer the typed channel's payload name when it carries the
                # full monomorphized Ok/Some type (`Vector__Item`), overriding
                # the possibly-truncated name-slice above. Gated on a real named
                # tid so the `Ref__`/borrow paths (which thread a GtPtr through
                # `ref_payload_tid` below) are untouched.
                if channel_ok_tid >= 0 and channel_ok_tid < gmod.type_table.len():
                    match gmod.type_table.get(channel_ok_tid).unwrap():
                        case GtNamed(_chan_name):
                            if _chan_name != "":
                                inner_name_str = _chan_name
                        else:
                            pass
                int inner_tid = -1
                if inner_name_str != "":
                    int prim_t = prim_name_to_type(inner_name_str)
                    if prim_t >= 0:
                        inner_tid = prim_t
                    elif inner_name_str == "int64_t":
                        inner_tid = I64_TYPE
                    elif inner_name_str == "int32_t":
                        inner_tid = I32_TYPE
                    elif inner_name_str == "int16_t":
                        inner_tid = I16_TYPE
                    elif inner_name_str == "int8_t":
                        inner_tid = I8_TYPE
                    elif inner_name_str == "uint64_t":
                        inner_tid = U64_TYPE
                    elif inner_name_str == "uint32_t":
                        inner_tid = U32_TYPE
                    elif inner_name_str == "uint16_t":
                        inner_tid = U16_TYPE
                    elif inner_name_str == "uint8_t":
                        inner_tid = U8_TYPE
                    elif inner_name_str == "double":
                        inner_tid = F64_TYPE
                    elif inner_name_str == "float":
                        inner_tid = F32_TYPE
                    elif inner_name_str == "Str":
                        inner_tid = lookup_or_register_named(&gmod, "GorgetString")
                    elif inner_name_str.starts_with("Ref__"):
                        # option_ref_borrow: an `Option__Ref__T` payload name
                        # `Ref__T` must resolve to a real `GtPtr(T)` via the
                        # bridge — NOT `lookup_or_register_named` (which would
                        # register a `GtNamed("Ref__T")` → empty C struct that
                        # poisons resolve_field_lir_type's LT_PTR fallback,
                        # making Some_0 a value struct → shallow-copy/memcpy
                        # type-error). Mirrors the guard at the infer site
                        # (~3461) + the resolve_field_gir_type bridge (~3070).
                        # The typed override below sets the same GtPtr; this
                        # just avoids the GtNamed registration SIDE EFFECT.
                        inner_tid = resolve_field_gir_type(inner_name_str, &gmod)
                    else:
                        inner_tid = lookup_or_register_named(&gmod, inner_name_str)
                # Typed-channel override: when the mint recorded a non-primitive
                # named Ok/Some payload (`Vector__Item`, a user struct, a nested
                # `Result__…`), use that EXACT tid rather than re-registering by
                # name. Identical to `lookup_or_register_named(inner_name_str)` in
                # the common case, but it ALSO guarantees the result slot is the
                # SAME registered tid the enum-category / collection-alias passes
                # saw (so a `Vector__Item` Ok payload maps to its GorgetArray
                # alias, not a fresh degenerate placeholder). Skipped for the
                # `Ref__` borrow payload (handled by `ref_payload_tid` below).
                if channel_ok_tid >= 0 and channel_ok_tid < gmod.type_table.len() and not inner_name_str.starts_with("Ref__"):
                    match gmod.type_table.get(channel_ok_tid).unwrap():
                        case GtNamed(_chan_name2):
                            if _chan_name2 != "" and _chan_name2 != "Str":
                                inner_tid = channel_ok_tid
                        else:
                            pass
                # option_ref_borrow Phase 3: override with the typed GtPtr
                # payload when this is an Option[Ref[T]] — the name-slice above
                # produced a GtNamed("Ref__T"); we want the real GtPtr(T).
                if ref_payload_tid >= 0:
                    inner_tid = ref_payload_tid
                if inner_tid >= 0 and variant_name != "":
                    int scr_ptr = match_scrutinee_ptr(&ctx, &gmod, recv)
                    # `.unwrap_or(default)`: emit a real tag check so
                    # None/Error returns the default instead of dereffing
                    # a NULL pointer (closes showcase blocker #4 — the
                    # `sr_lookup` workaround in lir_lower.gg:35 can now
                    # inline as `sr.get(name).unwrap_or(-1)`).
                    if mname == "unwrap_or" and default_local >= 0:
                        # option_ref_borrow Phase 6 (R1, site #4 — extended
                        # 2026-05-28 for NEXT BLOCKER #4): the result SLOT
                        # (`uo_dst`) needs a SEPARATE type from `inner_tid`.
                        # ⚠ `inner_tid` MUST stay `GtPtr` — it is reused at
                        # the `emit_payload_read` field reads (Some-arm ~below
                        # AND the plain-unwrap path) where the site-#1 guard
                        # fires and emits the GIDeref. The two slot types are
                        # ALREADY decoupled here; the `uo_slot_tid` override
                        # only changes the result-slot, not the field-read dst.
                        #
                        # For BOTH primitive and resource pointees, the slot
                        # type is the VALUE pointee — the Some-arm clones the
                        # GtPtr payload (`op_consume(payload, CkAssign)` →
                        # OpClone → `<T>__clone(ptr)` → fresh value) and stores
                        # the value; the None-arm moves the value-typed default
                        # into the same value slot. The caller's
                        # `op_consume(uo_dst, CkReturn)` then sees a value-typed
                        # owned local — OpMove → direct return.
                        #
                        # Pre-2026-05-28: this gated the override on
                        # `not is_resource_type_name(...)` so resource pointees
                        # kept `uo_slot_tid = inner_tid` (GtPtr). The Some-arm
                        # then hit lir_codegen's "Ptr-slot ← aggregate-value →
                        # NULL" give-up branch (`__s33 = NULL`), and the merge's
                        # downstream `clone_to_owned` SIGSEGV'd. The resource
                        # case wants the SAME value-typed slot as primitives;
                        # the GtPtr requirement was only about `inner_tid`, not
                        # `uo_slot_tid`.
                        int uo_slot_tid = inner_tid
                        if ref_payload_tid >= 0 and ref_payload_tid < gmod.type_table.len():
                            GirType rp_gt = gmod.type_table.get(ref_payload_tid).unwrap()
                            match rp_gt:
                                case GtPtr(rp_inner):
                                    uo_slot_tid = rp_inner
                                else:
                                    pass
                        # Materialise the result slot up front; both arms
                        # store into it so the merge block sees a single
                        # def (SSA construction inserts the phi).
                        int uo_dst = add_local(&ctx, uo_slot_tid, None)
                        int tag = emit_tag_read(&ctx, scr_ptr, recv_tn, &gmod)
                        # tag == 0 → Some / Ok arm.
                        int cmp_dst = add_local(&ctx, BOOL_TYPE, None)
                        emit(&ctx, GICmp(cmp_dst, CMP_EQ, I64_TYPE, OpCopy(tag), OpConstI64(0)))
                        int some_bb = new_block(&ctx)
                        int none_bb = new_block(&ctx)
                        int uo_merge_bb = new_block(&ctx)
                        set_terminator(&ctx, GTBranch(OpCopy(cmp_dst), some_bb, none_bb))
                        # Some arm: read payload, store to uo_dst.
                        switch_to(&ctx, some_bb)
                        int payload = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                        emit(&ctx, GIAssign(uo_dst, op_consume(ctx, &gmod, payload, CkAssign())))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        # None arm: store the default.
                        switch_to(&ctx, none_bb)
                        emit(&ctx, GIAssign(uo_dst, op_consume(ctx, &gmod, default_local, CkAssign())))
                        set_terminator(&ctx, GTJump(uo_merge_bb))
                        switch_to(&ctx, uo_merge_bb)
                        # Bug D (Core #4, sibling 1/4): this `unwrap_or` intercept
                        # RETURNS here BEFORE the generic method-call arm's
                        # `register_local_for_drop` (~:4265) that every fall-through
                        # method gets. `uo_dst` is an owned value slot: the Some-arm
                        # deep-clones the payload (`gorget_string_clone_to_owned` /
                        # `<T>__clone`) and the None-arm moves the value-typed
                        # default in — a DISCARDED resource result
                        # (`if o.unwrap_or(d) == x:`) LEAKED (measured 6B String).
                        # Register `uo_dst`; `register_local_for_drop` self-gates
                        # (lower_drops.gg:236-253: non-droppable / LoBorrowed /
                        # LoView skip) so a POD / view result no-ops, and a
                        # bound/returned/consumed result move-zeros the temp so its
                        # DropIfAlive no-ops.
                        register_local_for_drop(&ctx, uo_dst, uo_slot_tid, &gmod)
                        return uo_dst
                    # Panic-by-default (reference §15.2): a plain `unwrap()` /
                    # `expect()` on a `None` / `Error` value TRAPS rather than
                    # dereffing a zeroed payload. Emit the tag check + a
                    # `gorget_panic` branch BEFORE the payload read — mirrors the
                    # shared LIR guard (src/lir/lower/insts.rs `emit_unwrap_panic_guard`)
                    # and message text (matches ggdef). `unwrap_error` is NOT in this
                    # intercept (its self-host emit path is the lir_codegen.gg
                    # combinator case); `unwrap_or` already returned above. Valid
                    # tag = 0 (Some/Ok); the invalid word is None (Option) / Error
                    # (Result). Uses the ASSERT-LOWERING idiom (lower_stmt.gg
                    # SAssert): noreturn gorget_panic + a GTJump dead edge (the
                    # self-host GIR has no GTUnreachable).
                    int uw_tag = emit_tag_read(&ctx, scr_ptr, recv_tn, &gmod)
                    int uw_cmp = add_local(&ctx, BOOL_TYPE, None)
                    emit(&ctx, GICmp(uw_cmp, CMP_EQ, I64_TYPE, OpCopy(uw_tag), OpConstI64(0)))
                    int uw_ok_bb = new_block(&ctx)
                    int uw_panic_bb = new_block(&ctx)
                    set_terminator(&ctx, GTBranch(OpCopy(uw_cmp), uw_ok_bb, uw_panic_bb))
                    switch_to(&ctx, uw_panic_bb)
                    String uw_word = "None"
                    if recv_ec.category == ENUM_CAT_RESULT:
                        uw_word = "Error"
                    String uw_msg = "called `unwrap()` on a `" + uw_word + "` value"
                    # D11 trap normalization (was gorget_panic): the T_ code is
                    # derived from the receiver variant — None → T_UnwrapNone,
                    # Error → T_UnwrapError. Mirrors src/lir/lower/insts.rs
                    # emit_unwrap_panic_guard. gorget_trap exits 101 with trap[T_X].
                    String uw_code = "T_UnwrapNone"
                    if uw_word == "Error":
                        uw_code = "T_UnwrapError"
                    emit(&ctx, GICallExtern(-1, "gorget_trap", [OpConstStr(uw_code), OpConstStr(uw_msg)]))
                    set_terminator(&ctx, GTJump(uw_ok_bb))
                    switch_to(&ctx, uw_ok_bb)
                    # Plain unwrap: emit a real field read through the
                    # scrutinee-ptr helper, matching PConstructor destructure.
                    int field_val = emit_payload_read(&ctx, scr_ptr, recv_tn, variant_name, 0, inner_tid, &gmod)
                    # Prereq B-extension (2026-05-21): when the receiver
                    # was a borrow (e.g., `coll.get(i).unwrap()` where
                    # `.get()` returned LoBorrowed/BoCollectionElement,
                    # or a SVarDecl-bound borrow propagated via Prereq
                    # B), demote `field_val` to LoBorrowed so the
                    # COMMIT 3 drop emission doesn't double-free the
                    # underlying aggregate data. emit_payload_read tags
                    # `dst` LoBorrowed/BoField when no clone fn is
                    # available (the common case for user enums whose
                    # payload types aren't runtime resources); the
                    # inherit shim leaves LoOwned dst's alone (those
                    # were explicitly cloned and need their own drop).
                    inherit_borrow_from(&ctx, field_val, recv)
                    # Bug D (Core #4, sibling 1/4): register the owned resource clone
                    # this plain `unwrap`/`expect` returns for scope-exit drop —
                    # mirrors the generic method-call `register_local_for_drop`
                    # (~:4265) this early return skips. `emit_payload_read`
                    # deep-clones a resource Some/Ok payload into a fresh owned slot;
                    # discarded (`if o.unwrap() == x:`) it LEAKED (measured: 6B
                    # String / 24B Vector / 786B Dict). Runs AFTER
                    # `inherit_borrow_from`, so a borrowed-recv unwrap
                    # (`coll.get(i).unwrap()` GtPtr, a `(&opt).unwrap()`) is
                    # LoBorrowed → self-skipped (no double-free against the element /
                    # receiver owner). POD / view payloads self-skip via
                    # is_droppable_type / LoView; bound/returned/consumed results
                    # move-zero the temp so its DropIfAlive no-ops.
                    register_local_for_drop(&ctx, field_val, ctx.locals.get(field_val).unwrap().type_id, &gmod)
                    return field_val
                # Fall back to re-cast if we couldn't identify the variant.
                # Phase 3 (Class 8): inherit recv's borrow tag onto ud so a
                # chained `coll.get(i).unwrap()` doesn't byte-copy the alias
                # into a fresh LoOwned slot.
                #
                # Bug D (Core #4 class-completeness): these two fallback returns
                # are DELIBERATELY NOT `register_local_for_drop`'d. They are
                # UNREACHABLE for well-typed code: `variant_name == ""` (which is
                # the only way inner_tid stays derivable-but-variant-unknown, or
                # `inner_tid < 0`) means `recv` is neither an Option nor a Result,
                # i.e. a type error the checker already rejects. `ud`
                # inherit-copies recv's borrow tag (so a borrowed recv stays
                # LoBorrowed → would self-skip anyway) and `return recv` is a
                # harmless alias of an already-tracked local (recv is itself
                # registered/param-owned at its own birth). Registering here would
                # risk double-registering `recv`. If a future feature makes this
                # path reachable for a genuinely-owned discardable temp, register
                # `ud` (NOT `recv`) — mirror the plain-unwrap site above.
                if inner_tid >= 0:
                    int ud = add_local_inheriting(&ctx, inner_tid, None, recv)
                    emit(&ctx, GIAssign(ud, op_consume(ctx, &gmod, recv, CkAssign())))
                    return ud
                return recv
            # clone() — return a copy of the receiver
            #
            # Round-17 Inc-1: a `Shared[T].clone()` is NOT a byte-copy / deep
            # copy — it is an atomic refcount bump (strong++) over the SAME
            # `GorgetShared*` handle. OpClone on a raw-ptr Shared slot falls
            # through to a plain ISlotLoad byte-copy (lir_lower OpClone handler),
            # which under-counts the strong ref → N drops on rc=1 → heap UAF /
            # double-free. So route a Shared receiver to the synthesized per-type
            # `Shared__<T>__clone` wrapper (`return gorget_shared_clone(self)`)
            # instead, exactly as the explicit `.get()`/`.at()`/`.slen()`
            # accessors already route to `Shared__<T>__<method>` via the generic
            # dispatch below. The gate is the TYPED `method_prefix ==
            # "gorget_shared"` off resource_meta_for (Core #2 — keyed on typed
            # metadata, NOT a `Shared__` name prefix); when it fires we fall
            # THROUGH to the generic method-call dispatch, which builds the
            # `recv_type_name + "__clone"` GICall, passes `self` by value (as the
            # emitted `.get()` wrapper call proves), records the wrapper request
            # in map_runtime_name, and types the result as the receiver's Shared
            # type via infer_method_return_type. Mirrors Rust gg
            # (src/ir/lowering/exprs/methods.rs:1064 → builder.call("Shared__T__
            # clone", vec![recv], recv_type)). Every OTHER receiver type keeps the
            # OpClone deep-copy/refcount semantics below unchanged.
            if mname == "clone" and not local_method_prefix_is(recv, "gorget_shared", ctx, &gmod):
                # Phase D step 3: explicit `.clone()` produces an owned
                # copy of the receiver. Emit OpClone so downstream layers
                # (LIR codegen, Phase C validators) know this read is a
                # deliberate refcount bump / deep copy, not an alias.
                #
                # Phase 2.3.5 (2026-05-22) — the dst's type is the
                # POINTEE when recv is Ptr(T)/MutPtr(T): clone produces
                # an owned T value, not a pointer. Without this unwrap,
                # the clone_dst slot is typed as Ptr(T); the lir_lower
                # OpClone handler treats the slot as a Ptr-to-resource
                # at every later consume position, emitting an EXTRA
                # `gorget_<T>__clone_to_owned` that takes the prior
                # clone's Str RESULT as a pointer — type-mismatch at
                # cc (`Str` arg vs `const GorgetString*` expected) and
                # a guaranteed crash if it ever ran. Writer-site fix:
                # unwrap the Ptr/MutPtr so clone_dst's GIR type matches
                # the actual runtime value being stored.
                int recv_tid = ctx.locals.get(recv).unwrap().type_id
                if recv_tid >= 0 and recv_tid < gmod.type_table.len():
                    GirType recv_gt = gmod.type_table.get(recv_tid).unwrap()
                    match recv_gt:
                        case GtPtr(inner_tid):
                            recv_tid = inner_tid
                        case GtMutPtr(inner_tid):
                            recv_tid = inner_tid
                        else:
                            pass
                int clone_dst = add_local(&ctx, recv_tid, None)
                emit(&ctx, GIAssign(clone_dst, OpClone(recv)))
                # Bug D (Core #4, sibling 2/4): `.clone()` returns here BEFORE the
                # generic method-call `register_local_for_drop` (~:4265). `OpClone`
                # deep-copies the receiver into a FRESH owned slot (LoOwned,
                # `gorget_string_clone_to_owned` / `<T>__clone` / `gorget_array_clone`)
                # — never an alias of `recv` — so a DISCARDED resource
                # `.clone()` (`if s.clone() == x:`) LEAKED (measured: 28B String /
                # 24B Vector). Register `clone_dst`; self-gating no-ops for a POD /
                # view clone, and a bound/consumed clone move-zeros the temp so its
                # DropIfAlive no-ops. Registering the owned COPY never double-frees
                # the receiver (they are separate heap objects). (`Shared.clone()`
                # is refcount-bump and never reaches here — it falls through the
                # `gorget_shared` gate to the generic dispatch, which registers it.)
                register_local_for_drop(&ctx, clone_dst, recv_tid, &gmod)
                return clone_dst
            # Thread[T] methods — join / id. The receiver is a `Thread__{T}`
            # opaque handle with NO registered fn body, so `fn_sigs` has no
            # `Thread__T__join` return type and the generic dispatch would
            # mis-type the result. TYPED dispatch: the receiver is a Thread
            # handle iff its (Ptr-peeled) tid is in the thread_payload_tids
            # channel — written at every Thread-handle mint site — and the
            # join payload tid comes from that same channel, never re-derived
            # by slicing the payload name out of the `Thread__` prefix
            # (CLAUDE.md "No name matching"). The receiver's type NAME is
            # used only to spell the `Thread__{T}__join`/`__id` helper symbol
            # (the symbol axis). Mirrors Rust gg's intercept
            # (`src/ir/lowering/exprs/methods.rs`, thread_payload_types).
            # `__join` returns the payload T (void → unit); `__id` int64_t.
            int thr_recv_tid = -1
            if recv >= 0 and recv < ctx.locals.len():
                thr_recv_tid = ctx.locals.get(recv).unwrap().type_id
            int thr_payload_tid = thread_payload_tid_of(&gmod, thr_recv_tid)
            if thr_payload_tid >= 0 and (mname == "join" or mname == "id"):
                String thr_recv_tn = local_type_name(recv, ctx, &gmod)
                String thr_join_fn = thr_recv_tn + "__" + mname
                if mname == "id":
                    int thr_id_dst = add_local(&ctx, I64_TYPE, None)
                    emit(&ctx, GICall(thr_id_dst, thr_join_fn, [op_consume(ctx, &gmod, recv, CkCallArgBorrow())]))
                    return thr_id_dst
                # join: void payload → unit (no dst); else the payload's tid.
                if thr_payload_tid == UNIT_TYPE:
                    emit(&ctx, GICall(-1, thr_join_fn, [op_consume(ctx, &gmod, recv, CkCallArgOwning())]))
                    int thr_void_dst = add_local(&ctx, UNIT_TYPE, None)
                    emit(&ctx, GIAssign(thr_void_dst, OpConstUnit()))
                    return thr_void_dst
                int thr_join_dst = add_local(&ctx, thr_payload_tid, None)
                emit(&ctx, GICall(thr_join_dst, thr_join_fn, [op_consume(ctx, &gmod, recv, CkCallArgOwning())]))
                # Bug D (Core #4, sibling 3/4): `Thread.join()` returns here BEFORE
                # the generic method-call `register_local_for_drop` (~:4265).
                # `thr_join_dst` is the payload T returned BY VALUE from the joined
                # thread (a fresh owned value, never an alias — the handle itself is
                # move-consumed above) — so a DISCARDED resource payload
                # (`if t.join() == x:`) LEAKED (measured: 35B heap String). Register
                # `thr_join_dst`; self-gating no-ops a POD payload (`Thread[int]`)
                # and the void→unit path above never reaches here. Bound/consumed
                # results move-zero the temp so its DropIfAlive no-ops.
                register_local_for_drop(&ctx, thr_join_dst, thr_payload_tid, &gmod)
                return thr_join_dst
            # Detect mutating-method-on-field-access pattern *before*
            # lowering args, so we capture wb_base / wb_field while the
            # recv_box AST is still in scope. `self.field.push(x)` and
            # similar mutators are lowered as:
            #   copy = __field_read_(base, idx)
            #   method(&copy, args)
            # …the mutation lives on `copy`; without a follow-up write-back,
            # the original field never sees the change. Writing back after
            # the call persists the mutation. Classic symptom: lex_emit's
            # `self.lex_tokens.push(...)` silently drops every token and the
            # self-compiled lexer returns 0 tokens.
            # TYPED (CLAUDE.md #4, "one fix all siblings"): route the
            # writeback mutator test through the SAME typed source of truth
            # as the CoW scan — `builtin_method_mutates` reads the
            # `is_mutating` column off BUILTIN_METHOD_MUTATES. This is a
            # NAME-table scan only (no per-call type resolution) so it does
            # NOT add a type lookup to this O(N²)-sensitive parser-lexing
            # hot loop. The old hand-list (push/put/set/pop/remove/clear)
            # is a subset of the typed `is_mutating=true` rows; widening to
            # the full mutator set is sound (a read-only method correctly
            # skips the writeback; the field-writeback only fires for an
            # EFieldAccess receiver that is NOT a Ptr-borrow, the genuine
            # by-value-copy mutator shape). Conservative default for an
            # unknown name = NOT a known builtin mutator ⇒ no writeback,
            # matching the old list's "absent ⇒ false".
            # TODO(P3-tier1, /tmp/p3_tier1_brief.md §2): if any future
            # parser self-lex perf regression is traced here, this is the
            # site — but the typed table marks all 6 original names true,
            # so behavior for them is unchanged.
            bool is_mutating = false
            match builtin_method_mutates(mname):
                case Some(wb_decl):
                    is_mutating = wb_decl.is_mutating
                case None:
                    pass
            # Detect whether the field-read receiver is Ptr-typed (A.2,
            # 2026-05-22: GIFieldLoad emits Ptr-typed locals for resource
            # field reads). If so, the mutating call goes through the
            # field POINTER directly and mutates the field in place — no
            # writeback needed. Pre-A.2 the field-read produced a by-value
            # copy and writeback was the only way to persist mutations.
            # Today the writeback is not just redundant: emit_field_write_
            # from_local routes the value through CkFieldWrite → OpClone,
            # triggering an O(N) gorget_array_clone of the WHOLE collection
            # after every push. That's O(N²) overall — pathological on
            # parser.gg's ~25k-token lexing run (5min+ per file).
            bool recv_is_ptr_borrow = false
            GirLocal recv_loc_for_check = ctx.locals.get(recv).unwrap()
            match recv_loc_for_check.ownership:
                case LoBorrowed():
                    recv_is_ptr_borrow = is_ptr_type(recv_loc_for_check.type_id, gmod)
                else:
                    pass
            bool need_writeback = false
            SpannedExpr wb_base = (*recv_box)
            String wb_field = ""
            # option_ref_borrow Phase 4b: the `coll.get(i).unwrap()
            # .mut_method(args)` chain needs NO writeback. `.get()` now
            # returns `Option[Ref[T]]`, so the unwrapped receiver is a
            # `GtPtr(T)` borrow whose pointer IS the collection element's
            # address — the mutating call goes THROUGH the pointer and
            # mutates the real element in place. The old `coll.set(idx,
            # !recv)` chain-writeback (retired here) would store a pointer
            # into the collection's own element slot → corruption. This
            # also retires the `feedback_nested_vector_get_set` workaround.
            if is_mutating:
                match (*recv_box).expr:
                    case EFieldAccess(wb_base_box, wb_f):
                        # Skip writeback when recv is a Ptr-borrow (A.2 path):
                        # the push goes through the field pointer directly,
                        # so the field is already mutated in place. The
                        # writeback would trigger a spurious whole-field
                        # clone (CkFieldWrite → OpClone).
                        if not recv_is_ptr_borrow:
                            need_writeback = true
                            wb_base = *wb_base_box
                            wb_field = wb_f
                    else:
                        pass
            # Method call: lower receiver as first arg (&self), then args.
            # Most collection/object methods take self by pointer.
            #
            # Phase C step 5b + Path A receiver-dispatch (2026-05-21):
            # pick operand mode by consulting the callee's signature for
            # param 0 (the implicit self slot):
            #   • `!self` (OWN_MOVE) → CkCallArgOwning → OpMove
            #   • `&self` / bare `self` → CkCallArgBorrow → OpBorrow
            # A LoBorrowed receiver (most commonly a field-loaded local
            # — `self.columns.get(...)`) must always be OpBorrow — moving
            # a borrow is a use-after-free shape, irrespective of the
            # callee's declared ownership. For LoOwned / LoParam sources
            # we let the callee signature drive the decision rather than
            # hardcoding OpMove: that hardcode is the dominant source of
            # over-consumption (Phase 2c COMMIT 2 blocker, scout
            # `a38eb352`). Methods not pre-registered in fn_move_params
            # default to CkCallArgBorrow — correct per CLAUDE.md
            # "Ownership at Consuming Positions" (bare-T propagates the
            # Ptr alias at zero cost). At the LIR layer OpBorrow lowers
            # identically to OpMove for pass-by-ptr method args (commit
            # `af687f3d`); validators downstream get the typed signal.
            #
            # Build the mangled method name once — used both for the
            # receiver dispatch and the per-arg classify_call_arg.
            String recv_type_name = local_type_name(recv, ctx, &gmod)
            # ── `.mod(divisor)` → Euclidean modulo (GIBinOp OP_MOD) ──────
            # `(-7).mod(3)` / `(-7.0).mod(3.0)` has no userland
            # `int64_t__mod` / `double__mod` body — Rust gg lowers it
            # directly to an inline `BinOp::Mod` of (receiver, divisor)
            # (src/ir/lowering/exprs/methods.rs:502). Mirror that here: the
            # result type follows the receiver's local type (int → integer
            # Euclidean `%`, float → fmod-based), which the downstream
            # IMod codegen (lir_codegen.gg:3577) branches on. Without this
            # the method falls through to `recv_type_name + "__" + mname`
            # and emits a call to the nonexistent `int64_t__mod` → link
            # error. Fires for the numeric `mod` method (the built-in `Mod`
            # trait's dispatch key), unconditional like the Rust reference.
            if mname == "mod" and margs.len() == 1:
                int _mod_op_ty = ctx.locals.get(recv).unwrap().type_id
                int _mod_div = lower_expr(&ctx, margs.get(0).unwrap().value, &gmod)
                int _mod_dst = add_local(&ctx, _mod_op_ty, None)
                emit(&ctx, GIBinOp(_mod_dst, OP_MOD, _mod_op_ty, op_consume(ctx, &gmod, recv, CkBinOpArg()), op_consume(ctx, &gmod, _mod_div, CkBinOpArg())))
                return _mod_dst
            # ── Primitive `.display()` / `.debug()` → runtime to-str ──────
            # `x.display()` / `x.debug()` on a numeric/bool receiver has no
            # userland `int64_t__display` / `__debug` body — Rust gg lowers it
            # directly to the matching `gorget_{int,float,bool}_to_str`
            # (src/ir/lowering/exprs/methods.rs:730-786). Without this the call
            # falls to `recv_type_name + "__" + mname` → an undefined symbol →
            # gcc implicit-int "aggregate <== int" CC-FAIL.
            #
            # ⚠ DISPATCH OFF THE PEELED RECEIVER `type_id`, NOT `recv_type_name`
            # (Core #2, layering rule 2): `type_id_to_base_name` (and hence
            # `recv_type_name`) returns the `"int64_t"` fallback for EVERY
            # primitive — bool=0 / f32=9 / f64=10 are all `< PRIM_COUNT=12`,
            # NOT stored as `GtNamed` — so a name-string test would silently
            # emit `gorget_int_to_str` for a bool (→ `1`, Rust `true`) or a
            # float (→ `3`, Rust `3.5`). Keying on the type_id makes bool/float
            # ACTUALLY correct, each via its own runtime symbol. The i8/i16/i32
            # → i64 and f32 → f64 widening in Rust `methods.rs:745-775` happens
            # IMPLICITLY at the C extern call (the symbols take `int64_t`/
            # `double`), so no explicit cast is needed. A struct receiver
            # (`type_id ≥ PRIM_COUNT` → `GtNamed`) falls through to the userland
            # equip-block `display`/`debug` dispatch unchanged.
            if (mname == "debug" or mname == "display") and margs.len() == 0:
                int _pd_tid = peel_ptr_tid(&gmod, ctx.locals.get(recv).unwrap().type_id)
                bool _pd_is_int = _pd_tid == I8_TYPE or _pd_tid == I16_TYPE or _pd_tid == I32_TYPE or _pd_tid == I64_TYPE or _pd_tid == U8_TYPE or _pd_tid == U16_TYPE or _pd_tid == U32_TYPE or _pd_tid == U64_TYPE
                bool _pd_is_f = _pd_tid == F32_TYPE or _pd_tid == F64_TYPE
                bool _pd_is_bool = _pd_tid == BOOL_TYPE
                if _pd_is_int or _pd_is_f or _pd_is_bool:
                    int _pd_gs = resolve_field_gir_type("GorgetString", &gmod)
                    int _pd_dst = add_local(&ctx, _pd_gs, None)
                    String _pd_fn = "gorget_int_to_str"
                    if _pd_is_f:
                        _pd_fn = "gorget_float_to_str"
                    elif _pd_is_bool:
                        _pd_fn = "gorget_bool_to_str"
                    emit(&ctx, GICallExtern(_pd_dst, _pd_fn, [op_consume(ctx, &gmod, recv, CkFormatArg())]))
                    register_local_for_drop(&ctx, _pd_dst, _pd_gs, &gmod)
                    return _pd_dst
                # String receiver: `debug()` quotes+escapes via
                # `gorget_string_debug`; `display()` is IDENTITY (returns the
                # receiver unchanged — no runtime call). Mirrors Rust gg
                # (src/ir/lowering/exprs/methods.rs:777-784). Without this the
                # String call fell to the generic dispatch, which (a) mis-typed
                # the result I64 (→ f-string `{s.debug()}` picked `%lld` and
                # printed the byte length, e.g. `5` for `"abc"`), and (b) for
                # `display` mapped `GorgetString__display` through the
                # `gorget_str_` fallback to the NON-EXISTENT `gorget_str_display`
                # (implicit-int decl → cc "Str <== int" error).
                if is_string_type_id(_pd_tid, &gmod):
                    int _sd_gs = resolve_field_gir_type("GorgetString", &gmod)
                    # A Ptr-to-String receiver (a String FIELD read `self.msg` or a
                    # `&`-borrow) must be dereferenced to a VALUE before it reaches
                    # `gorget_string_debug` (which takes a `Str` by value) or is
                    # returned by the identity `display`. Mirrors Rust's pointee
                    # deref (methods.rs:732-742) and the f-string arg deref
                    # (is_ptr_to_string_type_id branch above).
                    int _sd_recv = recv
                    if is_ptr_to_string_type_id(ctx.locals.get(recv).unwrap().type_id, &gmod):
                        int _sd_v = add_local_with(&ctx, _sd_gs, None, LoBorrowed(), BoNone())
                        emit(&ctx, GIDeref(_sd_v, recv, _sd_gs))
                        _sd_recv = _sd_v
                    if mname == "debug":
                        int _sd_dst = add_local(&ctx, _sd_gs, None)
                        emit(&ctx, GICallExtern(_sd_dst, "gorget_string_debug", [op_consume(ctx, &gmod, _sd_recv, CkFormatArg())]))
