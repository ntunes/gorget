                    # `None`/`Some`/`Ok`/`Error` materializes TAGGED rather than
                    # as int32 0) is the LAST arg for EVERY collection value-
                    # mutator (push→0, set/insert/put/fill/get_or_put→last).
                    # Deriving the hint POSITION from the arg count — not from
                    # `owning_arg_positions` — DECOUPLES the HINT from the
                    # CONSUME: `fill`/`get_or_put` carry an EMPTY
                    # `owning_arg_positions` (they clone/borrow the value per
                    # element, so consuming would double-free a live source) yet
                    # still get the hint. Byte-identical for the existing owning
                    # rows (their last owning position IS the last arg). Mirrors
                    # Rust gg's split of the value-arg hint from the consume set.
                    if filled_margs.len() > 0:
                        _mut_val_pos = filled_margs.len() - 1
                        String _mut_val_name = index_value_type_name(recv_type_name)
                        if _mut_val_name == "Str":
                            _mut_val_name = "GorgetString"
                        if _mut_val_name != "":
                            int _mv_cand = resolve_field_gir_type(_mut_val_name, &gmod)
                            if _mv_cand >= 0:
                                EnumCategory _mv_ec = enum_category_of(&gmod, _mv_cand)
                                if _mv_ec.category == ENUM_CAT_OPTION or _mv_ec.category == ENUM_CAT_RESULT:
                                    _mut_val_et = _mv_cand
                case None:
                    pass
            int _ma_idx = 0
            for ma in filled_margs:
                # closure Phase 2 Step A: a method-call arg that CONTAINS a
                # raw `it` (e.g. `.map(it*2)`, where the self-host parser does
                # NOT always wrap it in EImplicitClosure) is an implicit-it
                # closure body — record it (the OLD scan did the same via
                # expr_has_it → emit_it_closure). Otherwise lower normally.
                int ma_val = -1
                # Inc-4c: for a same-type combinator arg, expose the receiver
                # Option/Result type as `expected_type` (else -1, the historical
                # clear). `record_implicit_it_closure` and the EClosure make-site
                # both read `ctx.expected_type`, so set it for BOTH paths;
                # save/restore keeps it scoped to this arg.
                int prev_expected_ma = ctx.expected_type
                ctx.expected_type = _combinator_et
                # Collection-mutator owning-value arg: hint the Option/Result
                # element type (see the `_mut_val_et` computation above the loop)
                # so a bare `None`/`Some`/`Ok`/`Error` materializes tagged.
                if _ma_idx == _mut_val_pos and _mut_val_et >= 0:
                    ctx.expected_type = _mut_val_et
                if expr_has_it(ma):
                    ma_val = record_implicit_it_closure(&ctx, ma, &gmod)
                else:
                    # Clear the enclosing `expected_type` around the arg so a
                    # Result-typed surrounding context (e.g. `return a.add(to_n(sel))`
                    # from a `throws` fn) doesn't make the centralized auto-prop
                    # hook's capture-form check suppress the peel on a throws-call
                    # arg — leaving a `Result` where the param wants `T`. (For a
                    # combinator closure/value arg this is the receiver
                    # Option/Result type, set above; for every other arg it is the
                    # prior -1.) Mirrors the free-call arg loop and Rust gg's
                    # per-arg expected_type clear.
                    ma_val = lower_expr(&ctx, ma, &gmod)
                ctx.expected_type = prev_expected_ma
                # #37 Phase 2 hook 3 (method non-receiver `&`/`!` args):
                # `h.poke_vec(&v)` lets the callee mutate `v` through a
                # method arg whose sigil the parser stripped — the hook is
                # signature-driven off the same resolved `full_name` the
                # arg classification below uses. The collection-mutator
                # owning-promotion is NOT a mutation of the ARG (push/put
                # CLONE from a live source), so only the declared `&`/`!`
                # flags fire the materialize. Guards emit BEFORE the call.
                if ctx.cow_lazy_members.len() > 0:
                    if call_arg_lets_callee_mutate(gmod, full_name, _ma_idx + 1):
                        cow_lazy_materialize_family(&ctx, cow_source_root_name(ma))
                ConsumeKind ma_kind = classify_call_arg(gmod, full_name, _ma_idx + 1)
                # Owning-mutator promotion: a collection mutator takes
                # ownership of the value (and, for Dict, the key) at the
                # `owning_arg_positions` indices carried by its typed decl
                # (COLLECTION_BUILTIN_METHODS, keyed by the RESOLVED kind).
                # None (non-collection receiver or non-mutator method) → no
                # promotion, exactly as the old `is_owning_mutator_arg` false.
                # Reuses the hoisted `_mut_decl` (same lookup as the value-type
                # hint above) instead of re-calling collection_builtin_method
                # per arg.
                match _mut_decl:
                    case Some(cdecl):
                        if int_vec_contains(cdecl.owning_arg_positions, _ma_idx):
                            ma_kind = CkCallArgOwning()
                    case None:
                        pass
                call_args.push(op_consume(ctx, &gmod, ma_val, ma_kind))
                _ma_idx += 1
            # Return-type resolution priority — single source of truth
            # at each step (Layering rule 3):
            #
            #   1. fn_sigs (the lowerer's own registrations: Option B
            #      pre-pass for mono'd generic-equip methods + the
            #      non-generic-equip pre-pass at line ~6201). Fast,
            #      authoritative for the cases it covers.
            #   2. Typechecker side-table (`tc_types.expr_types`) —
            #      covers method-generic call sites (`v.iter().
            #      take_while[P](pred)`, `.map[U,F](f)`, full iterator
            #      chains, etc.) where the typechecker already resolved
            #      the mono'd return type. The architectural single
            #      source of truth for "what type does this expression
            #      have?" (Phase 1 + 2 of Gap #2). Returns a fully-
            #      mangled GIR type id via `resolved_to_gir_type`.
            #   3. Name-based heuristic (`infer_method_return_type`) —
            #      last resort for built-in collection runtime methods
            #      the typechecker doesn't model (raw runtime symbols
            #      like `gorget_array_get`); returns I64 when truly
            #      unknown.
            int ret_tid = I64_TYPE
            if gmod.fn_sigs.contains(sig_lookup_name):
                # R10: fn_sigs is keyed by the Gorget-level mangled method name
                # (Target__method, see lower.gg:~10190). For a call_redirect'd
                # extern method, full_name was rewritten to the C symbol above,
                # which is never a fn_sigs key — so the void extern-method return
                # type (registered under the mangled name by loader.gg) is found here.
                ret_tid = gmod.fn_sigs.get(sig_lookup_name).unwrap()
            elif gmod.fn_sigs.contains(full_name):
                ret_tid = gmod.fn_sigs.get(full_name).unwrap()
            else:
                int tc_ret = lookup_expr_gir_type(sexpr, &gmod)
                if tc_ret >= 0:
                    ret_tid = tc_ret
                else:
                    ret_tid = infer_method_return_type(mname, recv, ctx, &gmod)
            # closure Phase-2 increment 4e-1: CROSS-TYPE map/map_err result type.
            # `infer_method_return_type` (and every other source above) returns
            # the RECEIVER's Option/Result type for map/map_err — correct only
            # when the new inner type U equals the old T. For a cross-type
            # `Option[int].map((x): "str")` that names the result `Option__int64_t`,
            # whose 8-byte payload slot the 16-byte `Str` overflows AND through
            # which the Str-returning closure is called via an `int64_t(*)` cast
            # (SysV sret mismatch → SIGSEGV). Derive the real inner type from the
            # closure ARG's return type and re-mint the wrapper. The combinator
            # templates (lir_codegen) ALREADY read `dst_ty` and cast the closure
            # to it, so once `ret_tid` carries `Option__U` / `Result__U__E` /
            # `Result__T__F` the emitted call is correct.
            #
            # GATE is TYPED, not name-driven: the method NAME (map/map_err) only
            # SELECTS the combinator family; the decision to fire rests on
            # `enum_category_of(peel(recv))` being Option/Result. Vector/Dict
            # `.map` receivers fall through UNCHANGED (no enum category). The U==T
            # case re-mints the IDENTICAL mangled name (`type_id_to_name(I64)` ==
            # "int64_t", etc.), so a same-type `.map` is byte-for-byte unchanged.
            if mname == "map" or mname == "map_err":
                int _cm_recv_tid = ctx.locals.get(recv).unwrap().type_id
                EnumCategory _cm_ec = enum_category_of(&gmod, _cm_recv_tid)
                if (_cm_ec.category == ENUM_CAT_OPTION or _cm_ec.category == ENUM_CAT_RESULT) and margs.len() == 1:
                    int _cm_u = combinator_closure_ret_type(margs.get(0).unwrap().value, &gmod)
                    if mname == "map":
                        if _cm_ec.category == ENUM_CAT_OPTION:
                            # Option.map: ok payload becomes U; Option has no err.
                            String _cm_u_name = type_id_to_name(_cm_u, &gmod)
                            int _cm_opt = lookup_or_register_named(&gmod, "Option__" + _cm_u_name)
                            record_enum_category(&gmod, _cm_opt, ENUM_CAT_OPTION, _cm_u, -1)
                            ret_tid = _cm_opt
                        else:
                            # Result.map: ok payload becomes U; err type preserved.
                            int _cm_e = _cm_ec.err_type
                            String _cm_u_name2 = type_id_to_name(_cm_u, &gmod)
                            String _cm_e_name = type_id_to_name(_cm_e, &gmod)
                            int _cm_res = lookup_or_register_named(&gmod, "Result__" + _cm_u_name2 + "__" + _cm_e_name)
                            record_enum_category(&gmod, _cm_res, ENUM_CAT_RESULT, _cm_u, _cm_e)
                            ret_tid = _cm_res
                    else:
                        # map_err is only valid on Result: ok payload T preserved;
                        # err type becomes F (= the closure return U).
                        if _cm_ec.category == ENUM_CAT_RESULT:
                            int _cm_t = _cm_ec.ok_type
                            String _cm_t_name = type_id_to_name(_cm_t, &gmod)
                            String _cm_f_name = type_id_to_name(_cm_u, &gmod)
                            int _cm_res2 = lookup_or_register_named(&gmod, "Result__" + _cm_t_name + "__" + _cm_f_name)
                            record_enum_category(&gmod, _cm_res2, ENUM_CAT_RESULT, _cm_t, _cm_u)
                            ret_tid = _cm_res2
            # SH-3 (Inc-4e-1 sibling): CROSS-TYPE and_then/flat_map result type.
            # The closure returns the FULL Option[U] / Result[U,E] — use that
            # return DIRECTLY; do NOT re-wrap as if it were map's inner U.
            # Without this, ret_tid stays the RECEIVER Option[Money] while the
            # closure yields Option[int] → emit cast + match as Money (empty/
            # wrong print). Gate is TYPED on enum_category (Vector.and_then
            # falls through). Same-type and_then re-reads the identical tid.
            if mname == "and_then" or mname == "flat_map" or mname == "or_else":
                int _at_recv_tid = ctx.locals.get(recv).unwrap().type_id
                EnumCategory _at_ec = enum_category_of(&gmod, _at_recv_tid)
                if (_at_ec.category == ENUM_CAT_OPTION or _at_ec.category == ENUM_CAT_RESULT) and margs.len() == 1:
                    int _at_ret = combinator_closure_ret_type(margs.get(0).unwrap().value, &gmod)
                    EnumCategory _at_ret_ec = enum_category_of(&gmod, _at_ret)
                    if _at_ret_ec.category == ENUM_CAT_OPTION or _at_ret_ec.category == ENUM_CAT_RESULT:
                        ret_tid = _at_ret
            if ret_tid == UNIT_TYPE:
                # Void-returning method — no destination
                emit(&ctx, GICallExtern(-1, full_name, call_args))
                if need_writeback:
                    emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
                int void_dst = add_local(&ctx, UNIT_TYPE, None)
                emit(&ctx, GIAssign(void_dst, OpConstUnit()))
                return void_dst
            # Phase D step 2: borrowing collection getters (.get / .first /
            # .last / .safe_get) return `Option[Ref[V]]` whose payload is a
            # borrow into the collection element, not an owned copy. Tag the
            # destination LoBorrowed/BoCollectionElement so validators
            # downstream can distinguish "owned wrapper around a borrow" from
            # "wrapper around an owned value." Detection is by RETURN-TYPE
            # SHAPE (typed) — `option_ref_payload_of(&gmod, ret_tid) >= 0`
            # iff `ret_tid` is the `Option__Ref__T` shape recorded on the
            # `option_ref_payload` channel; mirrors Rust's
            # `ret_option_ref_or_val_elem` discriminator at
            # `src/ir/lowering/builtins.rs:172-185`. Consuming getters
            # (`pop`/`remove`) return `Option[T]` (owned, ownership transfers
            # OUT) and correctly fall through to the default `add_local`
            # (LoOwned) path. Receiver-type gate still avoids false positives
            # when the user shadows these names on a non-collection type.
            int mdst = -1
            bool recv_is_string = recv_type_name == "String" or recv_type_name == "GorgetString" or recv_type_name == "Str"
            # Does this String method return a non-owning VIEW into the
            # receiver's buffer? Read the typed `returns_view` column off the
            # String builtin table (STRING_BUILTIN_METHODS) instead of the
            # old `is_string_view_method` name match. None (not a String
            # builtin) → false, same as the old list's fall-through.
            bool mname_is_view = false
            match string_builtin_method(mname):
                case Some(sdecl):
                    mname_is_view = sdecl.returns_view
                case None:
                    pass
            if option_ref_payload_of(&gmod, ret_tid) >= 0:
                bool recv_is_collection = false
                match resource_meta_for(&gmod, recv_type_name):
                    case Some(rmeta):
                        match rmeta.collection_kind:
                            case CkNotCollection():
                                recv_is_collection = false
                            else:
                                recv_is_collection = true
                    case None:
                        recv_is_collection = false
                if recv_is_collection:
                    mdst = add_local_with(&ctx, ret_tid, None, LoBorrowed(), BoCollectionElement(-1))
                else:
                    mdst = add_local(&ctx, ret_tid, None)
            elif recv_is_string and mname_is_view:
                # View-returning String method: result aliases the receiver's
                # buffer (cap==0). Tag LoView so op_consume materializes it
                # (OpClone) at any owning consume position — otherwise the
                # view is moved-by-value into owned storage and dangles.
                mdst = add_local_with(&ctx, ret_tid, None, LoView(), BoNone())
                # #37 Phase 2 derivation join (a) — the ONE String-view
                # tag site: a view result derived from a lazy family
                # member joins the family (cow_lazy_join_view_result,
                # statement-scoped) and gets the typed drop override —
                # once a guard materializes it in place it OWNS its
                # buffer (the cap=0 pre-materialize free no-ops).
                if ctx.cow_lazy_members.len() > 0:
                    if cow_lazy_join_view_result(&ctx, recv, mdst, ret_tid):
                        register_lazy_slot_for_drop(&ctx, mdst, ret_tid)
            elif mname == "get" and margs.len() == 0 and is_guard_struct_type(recv_type_name, &gmod):
                # Guard/ReadGuard/WriteGuard `.get()` returns a pointer INTO the
                # mutex-owned payload, so the loaded value is a VIEW, not an
                # owned value. Tagging LoView does two things that both matter:
                # drop-insertion skips it (lower_drops.gg — `case LoView(): return`),
                # so we no longer free a buffer the mutex still owns; and
                # op_consume materializes it with OpClone at an owning consume
                # position instead of moving the shallow alias in.
                # Mirrors Rust's emit_guard_get_ptr + set_view_of
                # (src/ir/lowering/exprs/methods.rs). The arity guard mirrors
                # Rust's `args.is_empty()` — a `get(k)` on a user type must not
                # be caught here.
                mdst = add_local_with(&ctx, ret_tid, None, LoView(), BoRuntimeView(recv))
            else:
                mdst = add_local(&ctx, ret_tid, None)
            # FRESH-OWNED-TEMP drop registration (#19, sibling of #17 at the
            # lower_call return-temp site lower.gg:~7405): an owning String
            # method (`.upper()`/`.lower()`/`.replace()`/`.repeat()`/`.trim()`/
            # `.strip()`/`.reverse()`/`.center()`/`.ljust()`/`.rjust()`/
            # `.zfill()`/`.removeprefix()`/`.removesuffix()`) materializes a
            # fresh OWNED GorgetString in the default `add_local` (LoOwned)
            # branch above. When this CALL EXPRESSION flows directly into a
            # non-consuming position (`print(s.upper())`, `f"{s.replace("a","b")}"`)
            # it is BORROWED only (CkFormatArg/CkCallArgBorrow → is_consume_kind=
            # false → OpBorrow), so the result is orphaned and leaks (O(1) per
            # occurrence). Registering at creation makes the scope-exit
            # GIDropIfAlive free it exactly once.
            #
            # SCOPE — NARROW (owning-String methods only), NOT the general "any
            # owned method result". The general one-liner (register every
            # `mdst`) RED'd `self_host_runtime` (stdlib_iter_drain): it woke a
            # PRE-EXISTING LATENT ownership bug — `equip [T] Vector[T] with
            # Drainable[T]: VectorDrain[T] drain(!self)` is a GENERIC-equip
            # `!self`-consuming method, so `Vector__int64_t__drain` is NEVER put
            # in `fn_move_params` (the generic-equip `!`-param gap documented at
            # lower.gg:~12934). classify_call_arg therefore returns
            # CkCallArgBorrow → op_consume does NOT move-zero the receiver, so
            # the SOURCE Vector buffer is logically owned by BOTH the `drain()`
            # result (which now drops it, post-registration) AND the source
            # local / `!`-param `g` (whose own exit-drop also frees it) →
            # double-free (ASan: __gorget_dtor_VectorDrain frees the array, then
            # gorget_array_free on the same region from the `!`-param drop). The
            # leak this registration was masking was the SAFE side of that latent
            # bug. The CORRECT general fix is to close the generic-equip
            # `fn_move_params` gap (separate, larger — logged in TODO); until
            # then we register ONLY owning-String-method results, which all take
            # `&self` (a borrow, never `!self`) so there is no receiver-move to
            # mis-track. View-returning String methods are excluded by
            # `not mname_is_view` (and would self-skip via register_local_for_drop's
            # LoView gate anyway).
            #
            # SELF-GATING beyond the String gate: primitive/non-droppable returns
            # are skipped by register_local_for_drop's is_droppable_type gate
            # (lower.gg:1230); LoView results self-skip (lower.gg:1244).
            # SAFE-BY-CONSTRUCTION when MOVED instead (`String s = obj.upper()`,
            # `return s.trim()`, pushed/field-init'd): op_consume/wire-liveness
            # emits OpMove → GIMoveZero zeros the moved-out slot, so the
            # unconditional memcmp-guarded scope-exit GIDropIfAlive finds a zeroed
            # slot and suppresses the drop (drop_elab further elides statically);
            # the SReturn path separately move-zeros + excludes the returned local.
            # Placed BEFORE the emit so the `need_writeback` path is covered too.
            # Mirrors Rust's call_extern_tracked `needs_drop` registration.
            # #19-GENERAL (prototype, separable from the generic-equip fix):
            # register EVERY owned, droppable method-call result for drop, not
            # just owning-String methods. `register_local_for_drop` self-gates:
            # is_droppable_type skips primitives/non-resource returns, and the
            # LoView/LoBorrowed tag self-skips view/element-borrow results. This
            # was previously gated to `recv_is_string` because the general form
            # woke the generic-equip `!self` double-free (drain) — now that the
            # generic-equip `fn_move_params` pre-pass move-zeroes the drain
            # SOURCE, registering the drain RESULT here drops the buffer exactly
            # once. Mirrors Rust's `call_extern_tracked` `needs_drop`.
            if not mname_is_view:
                register_local_for_drop(&ctx, mdst, ret_tid, &gmod)
            emit(&ctx, GICallExtern(mdst, full_name, call_args))
            if need_writeback:
                emit_field_write_from_local(&ctx, wb_base, wb_field, recv, &gmod)
            return mdst
        case EFieldAccess(base_box, field_name):
            # Qualified nullary enum variant used as a VALUE: `Color.Red`,
            # `E.A`. The parser models these as EFieldAccess(EIdentifier(Type),
            # Variant) — NOT ECall — so without this they fall through to
            # `lower_place_base` (which lowers `Color` as a bare value ident →
            # the [bug] OpConstI64(0)) and then the EFieldAccess give-up below
            # (`unknown field 'Red' on base type 'int64_t'` → another I64(0)),
            # losing the enum value entirely. Detect via the TYPED
            # `enum_variant_parent` accessor — `field_name`'s enclosing enum ==
            # `name` — and route to the SAME `lower_nullary_variant_ident`
            # helper the bare-EIdentifier nullary-variant path uses (lower_expr
            # :493). Guard `not nl_contains` so a struct local named after an
            # enum type keeps the field-access path. Mirrors Rust
            # `lower_field_access`'s leading qualified-variant check
            # (src/ir/lowering/exprs/mod.rs:2036-2058).
            match (*base_box).expr:
                case EIdentifier(qual_base_name):
                    if not nl_contains(ctx, qual_base_name):
                        if enum_variant_parent(field_name, gmod) == qual_base_name:
                            int qv_dst = lower_nullary_variant_ident(&ctx, &gmod, field_name)
                            if qv_dst >= 0:
                                return qv_dst
                else:
                    pass
            # Place base — keep a `&`/`!`-param (`GtMutPtr`) or bare-resource
            # param (`GtPtr`) base as the POINTER (the field codegen wants
            # `((T*)base)->field`). `lower_place_base` bypasses Edit-1's
            # value-read deref for a bare identifier; nested bases fall back
            # to `lower_expr`.
            int base = lower_place_base(&ctx, *base_box, &gmod)
            # Resolve the base's struct type to find the field
            int base_tid = ctx.locals.get(base).unwrap().type_id
            String base_type_name = type_id_to_name(base_tid, &gmod)
            # Unwrap Ptr/MutPtr to get the inner type name
            int inner_tid = base_tid
            if base_tid >= 0 and base_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(base_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    case GtMutPtr(inner):
                        base_type_name = type_id_to_name(inner, &gmod)
                        inner_tid = inner
                    else:
                        pass
            # Box auto-deref: `box.field` is sugar for `(*box).field` — peel
            # the Box wrapper so the field lookup hits the inner struct's
            # fields, not Box's (which has no user fields). Without this,
            # `expr.span` where `expr` is `Box[SpannedExpr]` (auto-boxed
            # parameter, etc.) silently fell into the [bug] OpConstI64(0)
            # placeholder. The inner-name extraction mirrors `case EDeref`'s
            # prefix-slice.
            # Phase A — typed-metadata classification (BkRegularBox) via
            # resource_meta_for; the inner name is the post-`Box__` suffix
            # (rmeta doesn't carry parsed inner names, so slice the prefix).
            bool base_is_regular_box = false
            match resource_meta_for(&gmod, base_type_name):
                case Some(rmeta):
                    match rmeta.box_kind:
                        case BkRegularBox():
                            base_is_regular_box = true
                        else:
                            pass
                case None:
                    pass
            if base_is_regular_box:
                String inner_name = base_type_name.slice(5, base_type_name.len())
                int box_inner_tid = resolve_field_gir_type(inner_name, &gmod)
                # Phase 3 (Class 8): the box-deref's inner local ALWAYS
                # aliases into the box's heap allocation — for an LoOwned
                # box, `add_local_inheriting` would fall through to a fresh
                # LoOwned derefed, and a consume of `box.field` (into a
                # store / collection / field-init) would then shallow-alias
                # the box heap → double-free when COMMIT 3 drops both. Tag
                # LoBorrowed unconditionally (the deref-inner is a borrow
                # view regardless of who owns the box), matching the EDeref
                # write-site above and Rust's AssignMode::Borrow rvalue tag.
                # Defense-in-depth: `box.field`-into-a-store currently
                # mis-CCs on Rust gg too (a separate pre-existing Rust bug,
                # out of scope), but this keeps the two box-deref sites
                # consistent so the next fixture can't hit the LoOwned hole.
                int derefed = add_local_with(&ctx, box_inner_tid, None, LoBorrowed(), BoRuntimeView(base))
                emit(&ctx, GIDeref(derefed, base, box_inner_tid))
                base = derefed
                base_tid = box_inner_tid
                base_type_name = inner_name
                inner_tid = box_inner_tid
            # Guard[T] auto-deref: `g.field` where `g: Guard[T]` /
            # `ReadGuard[T]` / `WriteGuard[T]` projects THROUGH the guard's
            # inner-data pointer (`get_ptr(&g)` = `g->ptr`), not the guard's
            # own owner/ptr fields. Sibling of the Box arm above — same
            # write-site shape, just a runtime get_ptr call instead of a
            # GIDeref (a guard is a 16-byte struct, not a bare pointer). The
            # resulting `base` is a Ptr(inner)-typed local, so GIFieldLoad's
            # auto-deref loads the pointer and the field-load projects through
            # it (also makes the WRITE path mutate the real data — see
            # lower_stmt lower_field_write). Mirrors Rust
            # src/ir/lowering/exprs/mod.rs:2109-2162.
            match guard_field_deref_base(&ctx, base, base_type_name, &gmod):
                case Some(gdr):
                    base = gdr.inner_ptr_local
                    base_tid = ctx.locals.get(base).unwrap().type_id
                    base_type_name = gdr.inner_name
                    inner_tid = base_tid
                case None:
                    pass
            # Tuple-index reconciliation: the parser produces field-name `"_0"`
            # for `t._0` but a BARE DIGIT `"0"/"1"/…` for `t.0` (parser.gg:
            # 1802-1816). Tuple structs register their fields ONLY as `_N`
            # (Rust parity — `register_tuple_type`), so a bare-digit access
            # must normalize digit→`_N` to hit the field. Without this, `t.0`
            # / `nested.1.0` / `p.0` miss the lookup and fall through to the
            # `[bug] I64(0) placeholder` (4 of the tuple targets). All-digit
            # (and non-empty) is the trigger; a normal `.field` is untouched.
            String tuple_lookup_name = field_name
            bool fld_all_digits = field_name.byte_len() > 0
            int fld_di = 0
            while fld_di < field_name.byte_len():
                int fld_b = field_name.byte_at(fld_di)
                if fld_b < 0x30 or fld_b > 0x39:
                    fld_all_digits = false
                    break
                fld_di += 1
            if fld_all_digits:
                tuple_lookup_name = "_" + field_name
            # Look up field info from type_infos. Resolve to
            # (field_name, field_type_name, field_index) tuples without
            # cloning the whole GirTypeInfo — the Vector clone path
            # double-frees nested heap data on the self-host.
            int found_fi = -1
            String found_type_name = ""
            if gmod.type_infos.contains(base_type_name):
                GirTypeInfo info = gmod.type_infos.get(base_type_name).unwrap()
                int fi = 0
                while fi < info.fields.len():
                    GirFieldInfo finfo = info.fields.get(fi).unwrap()
                    if finfo.name == tuple_lookup_name:
                        found_fi = fi
                        found_type_name = finfo.type_name.clone()
                        break
                    fi += 1
            if found_fi >= 0:
                int field_type = resolve_field_gir_type(found_type_name, &gmod)
                # A.2 (2026-05-22) — emit GIFieldLoad with Ptr-typed dst
                # for resource fields; value-typed dst for non-resource
                # fields. Mirrors Rust `Instruction::FieldLoad` lowering
                # at `src/lir/lower/insts.rs:800-869`. The Ptr-typed-dst
                # variant lets the LIR dispatch pick the POINTER-ALIAS
                # path (no byte-copy) for collection-/string-/struct-
                # holding fields — eliminating the silent
                # `field.push(...)` writeback class of bugs that motivated
                # the EMethodCall writeback hack at line ~4154.
                #
                # For non-resource fields (int, bool, simple structs)
                # the dst stays value-typed and the LIR emits a byte-copy
                # ILoad — observationally identical to the previous
                # `__field_read_*` GICallExtern path.
                #
                # `set_field_borrow(&ctx, fdst, base, found_fi)` writes
                # the BoField(base, field_idx) origin payload that C.1
                # provisioned but no caller wired. E.1 reads it back
                # in the return-path validator; Phase C validators read
                # it to flag escaping borrows. Replaces the
                # `BoField(-1, -1)` sentinel from Phase D step 2.
                bool field_is_resource = is_resource_type_name(found_type_name, &gmod)
                int dst_type_id = field_type
                if field_is_resource:
                    dst_type_id = register_ptr(&gmod, field_type)
                int fdst = add_local_with(&ctx, dst_type_id, None, LoBorrowed(), BoNone())
                set_field_borrow(&ctx, fdst, base, found_fi)
                emit(&ctx, GIFieldLoad(fdst, base, found_fi))
                return fdst
            # HARD BUG: unknown field access fell through to I64/0
            # placeholder, losing both the struct identity and the field
            # type. Every downstream read of the "field value" sees 0 and
            # is typed int64 — responsible for the cascade of PConstructor
            # failures in stage-1 output. Report each miss with the base
            # type name and field name so the root cause is visible.
            diag_bug("EFieldAccess", "in fn '" + ctx.current_fn_name + "': unknown field '" + field_name + "' on base type '" + base_type_name + "' — returning I64(0) placeholder (WRONG)")
            int fdst = add_local(&ctx, I64_TYPE, None)
            emit(&ctx, GIAssign(fdst, OpConstI64(0)))
            return fdst
        case EIndex(base_box, idx_box):
            # `base[idx]` value-READ → collection getter call. Mirrors
            # `lower_index_assign` (the LHS-write twin, ~:7662): dispatch
            # the getter on the base's collection_kind, NOT a name match.
            # Vector/Deque → gorget_array_get, Dict → gorget_map_get.
            # The base (a collection) + index (int/key) are independently
            # typed, NOT the EIndex's destination — clear the enclosing
            # `expected_type` so a Result-typed surrounding context (e.g.
            # `return v[pick()]` from a `throws` fn) doesn't make the
            # centralized auto-prop hook's capture-form check suppress the peel
            # on a throws-call index (snag49c). Mirrors the binop-operand clear.
            int prev_expected_eix = ctx.expected_type
            ctx.expected_type = -1
            int eix_base = lower_expr(&ctx, *base_box, &gmod)
            # Range slice `base[a..b]` — the index is an ERange(Some,Some,_),
            # NOT a scalar. Lowering it through `lower_expr` returns Unit
            # (the standalone-ERange fallback at lower_expr :3489), so for a
            # STRING base it would wrongly call `gorget_str_index(base, 0)`
            # (single codepoint at 0) instead of `gorget_str_slice(base, a, b)`.
            # Detect the range here, lower start/end separately, and route to
            # the slice runtime fn. Mirrors Rust gg's `lower_index_access`
            # range branch (src/ir/lowering/exprs/methods.rs:3397-3404) — there
            # the index lowers to a GorgetRange struct and the LIR's index_load
            # dispatches gorget_str_slice; the self-host has no value-position
            # ERange, so we emit the slice call directly from the start/end
            # operands (the runtime fn is already wired — lir_lower.gg:1526).
            match (*idx_box).expr:
                case ERange(eix_rs_opt, eix_re_opt, eix_rincl):
                    match eix_rs_opt:
                        case Some(eix_rs_box):
                            match eix_re_opt:
                                case Some(eix_re_box):
                                    if is_string_local(eix_base, ctx, &gmod):
                                        int eix_sl_start = lower_expr(&ctx, *eix_rs_box, &gmod)
                                        int eix_sl_end = lower_expr(&ctx, *eix_re_box, &gmod)
                                        ctx.expected_type = prev_expected_eix
                                        int eix_sl_gs = lookup_or_register_named(&gmod, "GorgetString")
                                        # The slice result is a cap=0 VIEW REGION into the base's
                                        # buffer — tag LoView (not the default LoOwned) so op_consume
                                        # MATERIALIZES (OpClone) at an owning consume position. Without
                                        # this the view is moved-by-value and the SAssign drop-on-overwrite
                                        # frees the source buffer before the view aliases it (UAF —
                                        # fmt_basic/fmt_edge). Mirrors the method-view path at :~2264.
                                        int eix_sl_dst = add_local_with(&ctx, eix_sl_gs, None, LoView(), BoNone())
                                        Vector[Operand] eix_sl_args = [op_consume(ctx, &gmod, eix_base, CkCallArgBorrow()), op_consume(ctx, &gmod, eix_sl_start, CkBinOpArg()), op_consume(ctx, &gmod, eix_sl_end, CkBinOpArg())]
                                        emit(&ctx, GICallExtern(eix_sl_dst, "gorget_str_slice", eix_sl_args))
                                        return eix_sl_dst
                                case None:
                                    pass
                        case None:
                            pass
                else:
                    pass
            int eix_idx = lower_expr(&ctx, *idx_box, &gmod)
            ctx.expected_type = prev_expected_eix
            eix_idx = maybe_auto_propagate(&ctx, eix_idx, &gmod)
            # Base type name, unwrapping a Ptr/MutPtr param/static base.
            int eix_base_tid = ctx.locals.get(eix_base).unwrap().type_id
            String eix_base_name = type_id_to_name(eix_base_tid, &gmod)
            if eix_base_tid >= 0 and eix_base_tid < gmod.type_table.len():
                GirType eix_bt = gmod.type_table.get(eix_base_tid).unwrap()
                match eix_bt:
                    case GtPtr(eix_inner):
                        eix_base_name = type_id_to_name(eix_inner, &gmod)
                    case GtMutPtr(eix_inner2):
                        eix_base_name = type_id_to_name(eix_inner2, &gmod)
                    else:
                        pass
            # String character index-read (`s[i]`) → gorget_str_index(Str, int).
            # Mirrors Rust gg's `lower_index_access` (methods.rs:3370-3386):
            # resolve through Ptr — a by-pointer `String` PARAM is a
            # GtPtr(GorgetString), so is_string_local (which unwraps GtPtr/
            # GtMutPtr) detects both the value-String and by-pointer-String base.
            # gorget_str_index takes `Str` BY VALUE; the codegen's
            # `runtime_takes_str_by_value("gorget_str_index")` (gorget_str_ prefix)
            # inserts the `*(Str*)` deref for a Ptr-typed actual, so a borrowed
            # base is handled exactly like the gorget_str_eq/gorget_str_cat paths.
            # The result is a cap=0 VIEW REGION into the base's buffer; typing the
            # dst GorgetString lets the boundary clone own it when it escapes.
            if is_string_local(eix_base, ctx, &gmod):
                int eix_str_gs = lookup_or_register_named(&gmod, "GorgetString")
                # cap=0 VIEW REGION into the base's buffer (see comment above) —
                # tag LoView so op_consume MATERIALIZES (OpClone) at an owning
                # consume position. The default LoOwned moves the view by value,
                # and the SAssign drop-on-overwrite then frees the source buffer
                # before the view aliases it (UAF). Mirrors :~2264.
                int eix_str_dst = add_local_with(&ctx, eix_str_gs, None, LoView(), BoNone())
                Vector[Operand] eix_str_args = [op_consume(ctx, &gmod, eix_base, CkCallArgBorrow()), op_consume(ctx, &gmod, eix_idx, CkBinOpArg())]
                emit(&ctx, GICallExtern(eix_str_dst, "gorget_str_index", eix_str_args))
                return eix_str_dst
            String eix_getter = ""
            match resource_meta_for(&gmod, eix_base_name):
                case Some(eix_rmeta):
                    match eix_rmeta.collection_kind:
                        case CkVector():
                            eix_getter = "gorget_array_get"
                        case CkDeque():
                            eix_getter = "gorget_array_get"
                        case CkDict():
                            eix_getter = "gorget_map_get"
                        else:
                            pass
                case None:
                    pass
            # R42-A: user Index operator overload — `g[i]` on a struct/enum with
            # `equip X with Index` → X__get(&g, i). Mirrors Rust lower_index_
            # access's equip-get dispatch. Placed HERE (after collection-getter
            # resolution, gated `eix_getter == ""`) so a real collection can never
            # reach it — symmetric with the WRITE side (lower_index_assign gates
            # its user-__set dispatch on `setter == ""`). A resource collection
            # always sets eix_getter non-empty above, so `eix_getter == ""` proves
            # this base is NOT a runtime collection. Without this a user index-read
            # fell to the I64/0 stub below (silent wrong-value).
            if eix_getter == "" and gmod.type_infos.contains(eix_base_name):
                String eix_get_full = eix_base_name + "__get"
                if gmod.fn_sigs.contains(eix_get_full):
                    int eix_get_ret = gmod.fn_sigs.get(eix_get_full).unwrap()
                    int eix_get_dst = add_local(&ctx, eix_get_ret, None)
                    Vector[Operand] eix_get_args = [OpBorrow(eix_base), op_consume(ctx, &gmod, eix_idx, classify_call_arg(gmod, eix_get_full, 1))]
                    emit(&ctx, GICallExtern(eix_get_dst, eix_get_full, eix_get_args))
                    return eix_get_dst
            if eix_getter == "":
                # Unsupported base (Set has no index-read, unknown type):
                # keep the legacy I64/0 placeholder rather than crash.
                int idst = add_local(&ctx, I64_TYPE, None)
                emit(&ctx, GIAssign(idst, OpConstI64(0)))
                return idst
            # Element/value type NAME — Vector/Deque via collection_element_type,
            # Dict via the value-type suffix — through the shared
            # `index_value_type_name` helper (one source of truth, also used by
            # the compound index-assign in lower_stmt). Empty → fall back to the
            # I64/0 placeholder.
            String eix_elem_name = index_value_type_name(eix_base_name)
            if eix_elem_name == "":
                int idst = add_local(&ctx, I64_TYPE, None)
                emit(&ctx, GIAssign(idst, OpConstI64(0)))
                return idst
            String eix_elem_norm = eix_elem_name
            if eix_elem_name == "Str":
                eix_elem_norm = "GorgetString"
            int eix_elem_tid = resolve_field_gir_type(eix_elem_norm, &gmod)
            # MANDATORY 3-way dst split (a 2-way split regresses
            # leak_game_loop):
            #   (a) scalar elem (< PRIM_COUNT): BARE element type — the
            #       lir_lower scalar-deref ILoad derefs the void*.
            #   (b) runtime-RESOURCE elem (String/Array/Map/…): GtPtr(elem)
            #       LoBorrowed — op_consume clones at owning boundaries.
            #   (c) NON-resource non-scalar elem (a plain struct): BARE
            #       element type BY VALUE — lir_lower emits an aggregate
            #       `*(StructT*)(void*)` copy-out for the raw
            #       gorget_array_get/gorget_map_get getter.
            #   (d) truly-UNREGISTERED elem (< 0): FALL BACK to the I64/0
            #       stub.
            # Determine the dst CASE up front (scalar / resource / struct /
            # unregistered) — needed by BOTH the no-fault getter and the
            # faultable Bounds route below, which SHARE this materialization.
            bool eix_is_scalar = eix_elem_tid < PRIM_COUNT
            bool eix_is_resource = (not eix_is_scalar) and is_resource_type_name(eix_elem_norm, &gmod)
            bool eix_is_struct = (not eix_is_scalar) and (not eix_is_resource) and eix_elem_tid >= 0
            # (d) truly-UNREGISTERED elem (< 0): FALL BACK to the I64/0 stub
            # (shared by both paths; nothing faultable about an unknown elem).
            if (not eix_is_scalar) and (not eix_is_resource) and (not eix_is_struct):
                int idst_stub = add_local(&ctx, I64_TYPE, None)
                emit(&ctx, GIAssign(idst_stub, OpConstI64(0)))
                return idst_stub
            # Post-D25: no fault-catch — the panicking getter is the only path.
            # index/key MUST be OpBorrow (NOT OpCopy — OpCopy on a String
            # dict key trips validate_resource_moves → lowerer crashes).
            Vector[Operand] eix_args = [OpBorrow(eix_base), OpBorrow(eix_idx)]
            # Panicking getter into the 3-way-typed dst.
            int idst = -1
            if eix_is_scalar:
                idst = add_local(&ctx, eix_elem_tid, None)
            elif eix_is_resource:
                int eix_ptr_tid = register_ptr(&gmod, eix_elem_tid)
                idst = add_local_with(&ctx, eix_ptr_tid, None, LoBorrowed(), BoNone())
            else:
                idst = add_local(&ctx, eix_elem_tid, None)
            emit(&ctx, GICallExtern(idst, eix_getter, eix_args))
            return idst
        case EIf(cond_box, then_body, else_branches):
            # If-as-EXPRESSION (`int x = if c: a else: b`). Mirrors Rust
            # `build_if_chain_expr` via the shared helper: lower each
            # branch's block as a tail value and assign it into a single
            # `result` local at the merge. The same helper backs the
            # SIf-as-tail-value case in `lower_stmt_as_tail_value`, so a
            # nested `if` ending a branch body becomes a value too.
            return lower_if_chain_expr(&ctx, *cond_box, then_body, else_branches, &gmod)
        case ENoneLiteral():
            # Bare `None` literal — when expected_type is a typed
            # `Option__T`, emit a properly-TYPED `None` ctor call
            # that routes through `try_lower_prelude_variant`'s
            # canonical `IEnumInit(slot, struct_id, tag=1, [])` at
            # LIR. Mirrors Rust gg's
            # `materialise_none_for_expected_type` at
            # `src/ir/lowering/exprs/mod.rs:2504-2529`. Without
            # expected_type set, fall back to the legacy
            # UNIT/OpConstUnit shape — `Constant::Null` in Rust —
            # which the SVarDecl/SAssign Assign handler may rewrite
            # downstream if it sees a typed dst slot.
            if ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
                if enum_category_of(&gmod, ctx.expected_type).category == ENUM_CAT_OPTION and option_ref_payload_of(&gmod, ctx.expected_type) < 0:
                    int ndst_nl = add_local(&ctx, ctx.expected_type, None)
                    Vector[Operand] none_args_nl = []
                    emit(&ctx, GICallExtern(ndst_nl, "None", none_args_nl))
                    return ndst_nl
            int dst = add_local(&ctx, UNIT_TYPE, None)
            emit(&ctx, GIAssign(dst, OpConstUnit()))
            return dst
        case ECharLiteral(ch):
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int dst = add_local(&ctx, gs_tid, None)
            emit(&ctx, GIAssign(dst, OpConstStr(ch)))
            return dst
        case EArrayLiteral(elems):
            # Set-literal disambiguation: the parser produces EArrayLiteral for
            # BOTH `[a, b, c]` (Vector) AND `{a, b, c}` (Set) — semantic
            # analysis distinguishes them by the declared type context. When the
            # surrounding `expected_type` is a Set/HashSet, the literal must
            # build a GorgetSet, not a GorgetArray (a memcpy of array bytes into
            # a Set slot is silent UB). Mirrors Rust's `lower_array_literal`
            # set-dispatch (src/ir/lowering/exprs/collections.rs:27-35 →
            # lower_set_literal_from_array :196). Ordered-ness comes from the
            # TYPED `collection_kind` variant (CkOrderedSet vs CkHashSet) read
            # off `expected_type`, NOT a `Set__`-prefix probe.
            if ctx.expected_type >= 0:
                String eali_set_outer = type_id_to_name(ctx.expected_type, &gmod)
                bool eali_is_set = false
                bool eali_set_ordered = false
                match resource_meta_for(&gmod, eali_set_outer):
                    case Some(set_rmeta):
                        match set_rmeta.collection_kind:
                            case CkOrderedSet():
                                eali_is_set = true
                                eali_set_ordered = true
                            case CkHashSet():
                                eali_is_set = true
                                eali_set_ordered = false
                            else:
                                pass
                    case None:
                        pass
                if eali_is_set:
                    # Element type from the SVarDecl hint (set above for Set/
                    # HashSet at lower_stmt.gg:80), else from `collection_element_type`
                    # of the declared Set type name, else int64_t fallback.
                    String set_elem = ctx.pending_vec_elem_tyname
                    ctx.pending_vec_elem_tyname = ""
                    if set_elem == "":
                        set_elem = collection_element_type(eali_set_outer)
                    if set_elem == "":
                        set_elem = "int64_t"
                    # Ordered → gorget_ordered_set_new; unordered → gorget_set_new,
                    # chosen by the typed `eali_set_ordered` (matches the
                    # CkOrderedSet/CkHashSet ctor split in lir_lower.gg and Rust's
                    # OrderedSet/Set CollectionKind discriminator).
                    int set_acc_tid = collection_accumulator_tid(&gmod, "set", set_elem, "", "")
                    int set_acc = add_local(&ctx, set_acc_tid, None)
                    Vector[Operand] set_new_args = [OpConstI64(8)]
                    if eali_set_ordered:
                        emit(&ctx, GICallExtern(set_acc, "gorget_ordered_set_new", set_new_args))
                    else:
                        emit(&ctx, GICallExtern(set_acc, "gorget_set_new", set_new_args))
                    register_local_for_drop(&ctx, set_acc, set_acc_tid, &gmod)
                    # Lower + add each element. Elements are independently typed
                    # (clear the Set destination expected_type around each).
                    int set_prev_et = ctx.expected_type
                    int set_elem_et = lookup_or_register_named(&gmod, set_elem)
                    for set_el in elems:
                        if set_elem_et != I64_TYPE and set_elem_et != UNIT_TYPE:
                            ctx.expected_type = set_elem_et
                        else:
                            ctx.expected_type = -1
                        int set_el_local = lower_expr(&ctx, set_el, &gmod)
                        ctx.expected_type = set_prev_et
                        Vector[Operand] set_add_args = [OpBorrow(set_acc), OpMove(set_el_local)]
                        emit(&ctx, GICallExtern(-1, "gorget_set_add", set_add_args))
                    return set_acc
            # Consume element-type hint set by SVarDecl (`Vector[T] x = []`).
            # An empty hint means the declared type was not a concrete
            # Vector[T] — fall back to pointer size, which is correct for
            # scalar-element Vectors used as temporaries.
            String vec_tyname = ctx.pending_vec_elem_tyname
            ctx.pending_vec_elem_tyname = ""
            # ADD-only fallback: when no pending hint was set, try
            # deriving elem type from `ctx.expected_type` (Rust counterpart
            # `src/ir/lowering/exprs/collections.rs:27,46-49,62` — the
            # empty-array branch reads expected_type to size the array
            # buffer). This closes empty-array literals at writer sites
            # that already set expected_type but didn't set the
            # `pending_vec_elem_tyname` side-channel (e.g. EStructLiteral's
            # field-init port above; the call-arg loop's per-arg expected
            # type). NOT a replacement for the pending-name protocol —
            # that wins when set; this is the fallback for when it isn't.
            if vec_tyname == "" and ctx.expected_type >= 0:
                String eali_outer_name = type_id_to_name(ctx.expected_type, &gmod)
                String eali_elem_name = collection_element_type(eali_outer_name)
                if eali_elem_name != "":
                    vec_tyname = eali_elem_name
            # Lower each element — we'll push them in order after the
            # array is constructed. Need to keep the value locals around
            # so we can reference them in the subsequent push calls.
            # Per-element expected_type propagation (Rust counterpart
            # `src/ir/lowering/exprs/collections.rs:49-63`): when the
            # outer is a collection (Vector/Deque/Set/HashSet — same
            # wider gate as STEP 2.4 elem-size fallback above; type-
            # checker rejects non-array shapes upstream), propagate the
            # element type INTO each element's lower_expr via
            # ctx.expected_type. This resolves e.g.
            # `Vector[Option[int]] v = [None(), Some(1)]` per-element
            # None() to Option__int instead of bare Constant::Null.
            # Restored unconditionally after the loop. Same I64/UNIT
            # guard as SVarDecl / SAssign / SReturn / call-arg sites.
            int prev_eali_et = ctx.expected_type
            String eali_outer_name2 = ""
            String eali_elem_name2 = ""
            if ctx.expected_type >= 0:
                eali_outer_name2 = type_id_to_name(ctx.expected_type, &gmod)
                eali_elem_name2 = collection_element_type(eali_outer_name2)
            if elems.len() > 0 and eali_elem_name2 != "":
                int eali_et_new = lookup_or_register_named(&gmod, eali_elem_name2)
                if eali_et_new != I64_TYPE and eali_et_new != UNIT_TYPE:
                    ctx.expected_type = eali_et_new
            Vector[int] elem_locals = []
            for elem in elems:
                int elem_val = lower_expr(&ctx, elem, &gmod)
                elem_locals.push(elem_val)
            ctx.expected_type = prev_eali_et
            # ELEMENT-TYPE WRITE-THROUGH (Layering rule 4 — resolve once,
            # write through): when no SVarDecl/expected_type hint named the
            # element type (`auto v = [1,2,3]`), recover it from the first
            # lowered element's local type. Mirrors Rust
            # `lower_array_literal`'s `infer_operand_type_full(ctx,&first,…)`
            # (collections.rs:68). Carrying `vec_tyname` here is what lets
            # the array's dst local below be typed the ELEMENT-CARRYING
            # `Vector__<elem>` instead of decaying to a bare `GorgetArray`
            # that drops the element type — the loss that makes a downstream
            # `v[i]` read / `for x in v` / `v.map(..)` unable to recover T.
            if vec_tyname == "" and elem_locals.len() > 0:
                int eali_first = elem_locals.get(0).unwrap()
                int eali_first_tid = ctx.locals.get(eali_first).unwrap().type_id
                vec_tyname = type_id_to_name(eali_first_tid, &gmod)
            # Call gorget_array_new(elem_size) so the resulting array has a
            # valid `alloc` pointer from __gorget_current_alloc. Without
            # this, subsequent `.push()` on a zero-init'd GorgetArray
            # segfaults dereferencing arr->alloc->realloc(...).
            # With a type hint we emit a magic call `__gorget_array_new_sized_<T>()`
            # which the C codegen expands to `gorget_array_new(sizeof(T))` —
            # that's the only way for the size to track the real aggregate
            # footprint (e.g. 128 bytes for LirStructDef). Without the hint
            # we fall back to 8, which still works for pointer-/int-sized
            # element types (the common case for local temporaries).
            #
            # Type the dst with the ELEMENT-CARRYING `Vector__<elem>` name
            # when the element type is known, so the value is self-describing
            # (a `v[i]` read / for-loop / HOF re-resolves the element type via
            # `collection_element_type`). The runtime layout is the same
            # `GorgetArray` struct (resource_meta_for maps both), so the
            # push/get/len calls and C-emit are unchanged. Routed through the
            # centralized `collection_accumulator_tid` helper (the single
            # source of truth for collection-accumulator typing) — an empty
            # `vec_tyname` yields the bare `GorgetArray` fallback.
            int eali_arr_tid = collection_accumulator_tid(&gmod, "array", vec_tyname, "", "")
            int adst = add_local(&ctx, eali_arr_tid, None)
            if vec_tyname != "":
                String magic_name = "__gorget_array_new_sized_" + vec_tyname
                Vector[Operand] an_args_typed = []
                emit(&ctx, GICallExtern(adst, magic_name, an_args_typed))
            else:
                Vector[Operand] an_args = [OpConstI64(8)]
                emit(&ctx, GICallExtern(adst, "gorget_array_new", an_args))
            # Push each element into the just-created Vector. Without
            # this, `[!init_insts]` and similar "array literal with
            # explicit elements" produced an EMPTY array, and any
            # subsequent `.get(0)` returned NULL.
            # `gorget_array_push` mutates the array in place THROUGH a
            # pointer — the receiver is a borrow, NOT a consumed value. It
            # must use OpBorrow(adst): `adst` is live past every push (the
            # next iteration pushes again, and `return adst` hands the
            # filled array out). Passing OpMove(adst) tripped drop-emission's
            # "owned but live-past → clone before call" rule, so each push
            # mutated a throwaway CLONE while the original `adst` stayed
            # empty — `[!init_insts]` then returned a 0-length array and the
            # first `emit()` paniced (index 0, length 0). Follows the
            # gorget_array_push pass-self-by-pointer (OpBorrow) convention.
            # The element keeps OpMove — it IS consumed into the array.
            for el in elem_locals:
                Vector[Operand] push_args = [OpBorrow(adst), OpMove(el)]
                emit(&ctx, GICallExtern(-1, "gorget_array_push", push_args))
            return adst
        case ETupleLiteral(elems):
            # A tuple literal is a positional struct value. Mirror Rust
            # `Expr::TupleLiteral` (`src/ir/lowering/exprs/mod.rs:469`):
            #   1. lower each element (per-element `expected_type` peel),
            #   2. register the `Tuple__…` struct type from the element types,
            #   3. emit a struct-ctor `GICall` that `try_lower_user_struct_ctor`
            #      (`lir_lower.gg:2476`) lowers to `IStructInit`.
            #
            # Per-element `expected_type` (Rust exprs/mod.rs:484-505): when the
            # enclosing destination declares a tuple (possibly wrapped in the
            # `throws`/Result return slot, which we peel), set each element's
            # `expected_type` to the corresponding declared field type before
            # lowering it — else CLEAR it. This is load-bearing for the
            # `Result→T` auto-prop of a throwing-call element
            # (`throws_autoprop_tuple_element`): leaving the function's
            # `Result[Tuple.., E]` slot in place suppresses
            # `maybe_auto_propagate`'s peel (it skips when the destination
            # expects a `Result`), so the raw `Result` would be memcpy'd into
            # the element's int slot (reads back as a zero-init default).
            int tup_saved_et = ctx.expected_type
            # Peel a Result wrapper, then keep only a Tuple destination.
            int tup_dest = -1
            if tup_saved_et >= 0 and tup_saved_et < gmod.type_table.len():
                int tup_dest_try = tup_saved_et
                EnumCategory tup_ec = enum_category_of(&gmod, tup_saved_et)
                if tup_ec.category == ENUM_CAT_RESULT:
                    tup_dest_try = tup_ec.ok_type
                if tup_dest_try >= 0 and type_id_to_name(tup_dest_try, &gmod).starts_with("Tuple__"):
                    tup_dest = tup_dest_try
            Vector[int] tup_elem_locals = []
            int tup_ei = 0
            for te in elems:
                # Per-element expected_type: the destination tuple's i-th
                # field type (peeled above), else clear so a nested literal
                # / bare ctor doesn't inherit the whole-tuple slot.
                int tup_elem_et = -1
                if tup_dest >= 0:
                    String tup_dest_name = type_id_to_name(tup_dest, &gmod)
                    if gmod.type_infos.contains(tup_dest_name):
                        GirTypeInfo tup_dti = gmod.type_infos.get(tup_dest_name).unwrap()
                        if tup_ei < tup_dti.fields.len():
                            tup_elem_et = resolve_field_gir_type(tup_dti.fields.get(tup_ei).unwrap().type_name, &gmod)
                ctx.expected_type = tup_elem_et
                int tup_ev = lower_expr(&ctx, te, &gmod)
                ctx.expected_type = tup_saved_et
                # Auto-prop a throwing-call element to its payload (the peel
                # above cleared the Result-suppress for this element).
                tup_ev = maybe_auto_propagate(&ctx, tup_ev, &gmod)
                tup_elem_locals.push(tup_ev)
                tup_ei += 1
            ctx.expected_type = tup_saved_et
            # Re-infer element types AFTER lowering (a nested tuple element is
            # typed as its inner `Tuple__…`, an auto-prop'd element as its
            # peeled payload — facet 4: nested-element typing flows through
            # here, not a hardcoded i64).
            Vector[int] tup_elem_types = []
            for tel in tup_elem_locals:
                tup_elem_types.push(ctx.locals.get(tel).unwrap().type_id)
            int tup_tid = register_tuple_type(tup_elem_types, &gmod)
            # Build the struct-ctor args. Route EACH element through the
            # OWNING consume position `CkFieldWrite` (clone-or-move): the tuple
            # OWNS its element, so a borrow/view/live-owned resource element
            # CLONES (facet 5 — CoW consume-position rule; raw OpCopy would
            # shallow-alias a String/Vector element and trip
            # validate_resource_moves / double-free), a dead-owned resource
            # MOVES, and a primitive byte-copies. Mirrors the closure
            # env-ctor at `:6778` and the struct-field-init path.
            Vector[Operand] tup_ctor_args = []
            for tel2 in tup_elem_locals:
                tup_ctor_args.push(op_consume(ctx, &gmod, tel2, CkFieldWrite()))
            String tup_ctor_name = type_id_to_name(tup_tid, &gmod)
            int tdst = add_local(&ctx, tup_tid, None)
            emit(&ctx, GICall(tdst, tup_ctor_name, tup_ctor_args))
            # FRESH-OWNED-TEMP drop registration: a tuple holding a resource
            # element is itself droppable (its drop recurses into the element).
            # Register it so a scope-exit drop frees the owned element exactly
            # once (the OpMove/MoveZero on a later consume suppresses it).
            register_local_for_drop(&ctx, tdst, tup_tid, &gmod)
            return tdst
        case EStructLiteral(sname, fnames, fvals):
            # Expected-type propagation per field (Rust counterpart
            # `src/ir/lowering/exprs/mod.rs:1867-1890`). For each positional
            # field-init expr, set `ctx.expected_type` to that field's
            # declared type via `gmod.type_infos` BEFORE lowering — so reader
            # sites (bare prelude-variant ctors, bare `None`, empty array
            # literals consuming elem-size from expected_type, EIdentifier)
            # resolve to the field's declared shape instead of an
            # 8-byte default. Mirrors `apply_container_hint_for_ctor_arg`'s
            # GirTypeInfo lookup at `lower.gg:~5432-5441`. Restored
            # unconditionally after each lower_expr. Same I64/UNIT guard as
            # SVarDecl / SAssign / SReturn / call-arg sites.
            # CoW for-element BORROW scan (no SpannedExpr__clone): sv is only
            # read by lower_expr's immutable-borrow param; enumerate() preserves
            # the positional index sli_i used for the field-type pairing.
            for (sli_i, sv) in fvals.enumerate():
                int prev_expected_sli = ctx.expected_type
                if gmod.type_infos.contains(sname):
                    GirTypeInfo sli_ti = gmod.type_infos.get(sname).unwrap()
                    if not sli_ti.is_enum and sli_i < sli_ti.fields.len():
                        String sli_fty_name = sli_ti.fields.get(sli_i).unwrap().type_name.clone()
                        if sli_fty_name != "":
                            int sli_fty = lookup_or_register_named(&gmod, sli_fty_name)
                            if sli_fty != I64_TYPE and sli_fty != UNIT_TYPE:
                                ctx.expected_type = sli_fty
                lower_expr(&ctx, sv, &gmod)
                ctx.expected_type = prev_expected_sli
            int sdst = add_local(&ctx, lookup_or_register_named(&gmod, sname), None)
            emit(&ctx, GIAssign(sdst, OpConstI64(0)))
            return sdst
        case EClosure(cparams, cbody):
            # closure Phase 2 Step A/B: the make-site is the SOLE closure-id
            # source + recorder. Take the cid from gmod_next_closure_id, build
            # the GorgetClosure value, AND push a LiftedClosure record. The
            # post-pass (sole pusher of __Closure_N__call) drains
            # lifted_closures after the lower_function loop.
            int cid = gmod_next_closure_id(&gmod)
            String closure_name = "__Closure_" + int_to_str(cid)
            # The closure value at the GIR level is a GorgetClosure struct
            # (not __Closure_N which is the captured-vars env struct).
            int closure_tid = lookup_or_register_named(&gmod, "GorgetClosure")
            ClosureSig cl_sig = compute_closure_sig(cid, cparams, cbody, &gmod, ctx.expected_type)
            # ── Step B (§4a/§4b): collect + classify ByValue captures. ──
            # The collector mirrors the Phase-1 detector's walk EXACTLY (same
            # capture-shaped criterion, scoping, nested-skip); `unliftable` is
            # the safety net (a capture-shaped var that is NOT a genuine outer
            # local → STUB, as Phase 1 would). This is now the SOLE lowering-
            # decision input for the EClosure make-site; the Phase-1 inverted
            # `closure_body_captures` is no longer consulted HERE (still used
            # at the inline-spawn make-site, so it stays defined).
            CaptureCollector cl_cc = collect_closure_captures(&ctx, cparams, cbody, &gmod)
            # Bind the collector result into owned locals so the `!cl_caps`
            # move at the LiftedClosure push below doesn't invalidate `cl_cc`
            # mid-use (a field move is a whole-value move at the BC layer).
            bool cl_unliftable = cl_cc.unliftable
            Vector[ClosureCapture] cl_caps = cl_cc.caps.clone()
            # 2a guard (§4b): lift ONLY IF — (a) no UNLIFTABLE capture-shaped
            # var; AND (b) every capture's type_id ∈ {BOOL,I64,F64} (the
            # type_id_to_name-faithful primitive subset) OR a byte-copyable
            # COPY struct OR a RESOURCE (Phase 2b: String/Vector/resource-
            # struct — env owns an independent snapshot via op_consume's
            # clone-or-move, body reads through a Ptr-alias field-load);
            # AND (c) no captured local is mutated in the body; AND (d) no
            # nested closure.
            bool cl_caps_ok = not cl_unliftable
            int cl_ci = 0
            while cl_ci < cl_caps.len():
                int cl_ctid = cl_caps.get(cl_ci).unwrap().type_id
                if cl_ctid != BOOL_TYPE and cl_ctid != I64_TYPE and cl_ctid != F64_TYPE:
                    # 2b-1: accept a byte-copyable COPY struct — a
                    # registered non-resource non-enum struct (e.g.
                    # `Config{int,int}`). The env-field build + IStructInit /
                    # GIFieldLoad byte-copy paths already handle it (no
                    # clone/drop machinery).
                    # 2b-2 (Phase 2b): ALSO accept a RESOURCE capture
                    # (String/Vector/resource-struct — is_resource_type_name).
                    # The make-site env-ctor arg routes through
                    # op_consume(CkFieldWrite) so a LIVE owned source CLONES
                    # and a DEAD owned source MOVES — the env owns an
                    # INDEPENDENT snapshot. The body field-loads it as a
                    # Ptr-alias (see lower_closure_body §4e) so it borrows
                    # the env's storage and auto-clones at owning boundaries
                    # (no body-side double-free). A NON-resource enum (a plain
                    # user enum, or a primitive-payload optionlike like
                    # `Option[int]`) still STUBs (no enum clone-through wired at
                    # the ctor arg yet); a RESOURCE-payload optionlike
                    # (`Option[String]`, droppable per optionlike_resource_types)
                    # IS admitted here via `cl_is_resource` and handled by the
                    # resource clone path above.
                    String cl_tname = type_id_to_name(cl_ctid, &gmod)
                    bool cl_is_resource = is_resource_type_name(cl_tname, &gmod)
                    bool cl_is_copy_struct = gmod.type_infos.contains(cl_tname) and not cl_is_resource and not gmod.type_infos.get(cl_tname).unwrap().is_enum
                    if not (cl_is_resource or cl_is_copy_struct):
                        cl_caps_ok = false
                cl_ci += 1
            # (c) mutation check — RECLASSIFY mutated PRIMITIVE captures to
            # CAP_BY_MUT_REF (2c) instead of stubbing. A closure that mutates
            # a captured outer var (`count = count + 1`, `total += n`) holds a
            # `MutPtr(T)` to the outer slot in its env (named `MutRef__<T>` at
            # §4c-2c so the body GIFieldLoad loads-the-stored-pointer), and the
            # body reads/writes deref through it (the shared `&`/`!`-param
            # paths fire on the `GtMutPtr(T)`-typed body load — see §4e-2c).
            # Mirrors Rust `closures.rs` ByMutRef: detect_mutations (:101-118) →
            # MutPtr field (:124-138) → emit_borrow_mut (:326-332) → body deref
            # (:413-425). RESTRICTED to primitive pointees {BOOL,I64,F64}: a
            # mutated RESOURCE / COPY-struct capture stays STUB (2c is
            # primitive-only; resource/nested/enum mutable captures are later
            # increments). Build the new caps vector in walk order (single
            # source of truth) flipping the mode per mutated primitive.
            if cl_caps_ok and cl_caps.len() > 0:
                Vector[ClosureCapture] cl_caps2 = []
                int cl_cni = 0
                while cl_cni < cl_caps.len():
                    ClosureCapture cl_mc = cl_caps.get(cl_cni).unwrap()
                    # Per-name mutation test (single-name set → reuse
                    # stmts_mutate_any). Cheap: closures capture few vars.
                    Dict[String, bool] cl_one_name = {}
                    cl_one_name.put(cl_mc.name.clone(), true)
                    bool cl_mut = stmts_mutate_any(cbody, cl_one_name)
                    bool cl_prim = cl_mc.type_id == BOOL_TYPE or cl_mc.type_id == I64_TYPE or cl_mc.type_id == F64_TYPE
                    if cl_mut and cl_prim:
                        # Reclassify → ByMutRef (mutate-through-MutPtr).
                        cl_caps2.push(ClosureCapture(cl_mc.name.clone(), cl_mc.type_id, cl_mc.local_id, CAP_BY_MUT_REF))
                    elif cl_mut:
                        # Mutated non-primitive (resource / COPY struct) → STUB.
                        cl_caps_ok = false
                        cl_caps2.push(cl_mc)
                    else:
                        cl_caps2.push(cl_mc)
                    cl_cni += 1
                cl_caps = !cl_caps2
            # (d) nested-closure guard (retain the Phase-1 guard).
            bool cl_nested = stmts_have_nested_closure(cbody)
            bool cl_lowerable = cl_caps_ok and not cl_nested
            bool cl_has_caps = cl_caps.len() > 0
            int cdst = add_local(&ctx, closure_tid, None)
            # closure Phase 2 increment 3 — record the closure VALUE local's
            # return type. `cdst` is the env-erased `GorgetClosure` slot, which
            # loses the FnPtr return tid; the call site recovers it from this
            # channel (keyed `<fn>\0<cdst>`, the exact `closure_env_type`
            # idiom). Recorded UNCONDITIONALLY for every closure value (any
            # branch below, capturing or stubbed) so a String-returning closure
            # is recoverable regardless of env shape. The SVarDecl MoveDirect
            # arm copies it onto the dropped `var_local`. Read GATED on
            # `!= UNIT_TYPE` at the call site (see gir.gg field comment).
            gmod.closure_value_ret_type.put(ctx.current_fn_name + "\0" + int_to_str(cdst), cl_sig.return_type)
            if cl_lowerable and cl_has_caps:
                # ── §4c: register __Closure_N's FIELDS at the MAKE-SITE. ──
                # type_id_to_name is FAITHFUL for the §4b-restricted set
                # (bool/int64_t/double); the guard above guarantees no capture
                # reaches a width it would mis-name as int64_t. LIR Pass-2
                # then fills LirStructDef.fields → codegen stops emitting the
                # `char __pad` placeholder. (NOT in compute_closure_sig, which
                # also runs for stub closures.)
                Vector[GirFieldInfo] cl_env_fields = []
                int cl_fi = 0
                while cl_fi < cl_caps.len():
                    ClosureCapture cl_cap = cl_caps.get(cl_fi).unwrap()
                    # §4c-2 (Phase 2b): the env field OWNS the pointee T, never
                    # a Ptr. If a ByValue capture's type_id is a Ptr(T)/MutPtr(T)
                    # CoW-alias (mirrors Rust closures.rs:128-130 "Resolve
                    # Ptr(T) → T for CoW aliases"), name the field by the OWNED
                    # pointee T — op_consume's clone-through (decide_ptr_consume)
                    # materialises the owned value into it. Value-typed
                    # resource/COPY captures keep their own name. (Self-host's
                    # SVarDecl Branch-C-pre already keeps most CoW aliases
                    # value-typed, so this is mostly defensive parity; it makes
                    # the field-owns-pointee invariant explicit at the source.)
                    int cl_field_tid = cl_cap.type_id
                    if cl_field_tid >= 0 and cl_field_tid < gmod.type_table.len():
                        match gmod.type_table.get(cl_field_tid).unwrap():
                            case GtPtr(cl_pointee):
                                cl_field_tid = cl_pointee
                            case GtMutPtr(cl_pointee2):
                                cl_field_tid = cl_pointee2
                            else:
                                pass
                    # §4c-2c (Phase 2c ByMutRef): a MUTATED primitive capture's
                    # env field holds a `MutPtr(T)` to the OUTER slot, NOT the
                    # value. Name it `MutRef__<pointee>` (e.g. `MutRef__int64_t`)
                    # — this is LOAD-BEARING: the body GIFieldLoad dispatch
                    # (lir_lower.gg ~4360) decides pointer-alias-store vs
                    # load-stored-pointer from the field-type-NAME prefix
                    # `Ref__`/`MutRef__`. A `MutPtr(int)` field named plain
                    # `int64_t` would take the ALIAS-STORE path (store `&field`)
                    # → a `**int` double-pointer bug. `MutRef__int64_t` makes
                    # `fl_field_is_borrow_ptr` true → the correct load-stored-
                    # pointer path. This REUSES the existing accepted
                    # `Ref__`/`MutRef__` borrow-ptr residual (the same one
                    # Round-8 Track A reads + `resolve_field_lir_type`'s `Ref__`
                    # guard / the fallback LT_PTR resolves it to a pointer
                    # field). The principled typed-`is_borrow_ptr`-flag cleanup
                    # (a typed field on GirFieldInfo, set at the source, read via
                    # an accessor — replacing this name-prefix residual) is FILED
                    # in TODO.md as a separate class-fix track; do NOT implement
                    # it here. (`type_id_to_name` peels MutPtr→pointee, so the
                    # value-typed pointee name is what we prefix.)
                    String cl_field_name = type_id_to_name(cl_field_tid, &gmod)
                    if cl_cap.mode == CAP_BY_MUT_REF:
                        cl_field_name = "MutRef__" + cl_field_name
                    cl_env_fields.push(GirFieldInfo(cl_cap.name.clone(), cl_field_name))
                    cl_fi += 1
                # ② closure ENV-FIELD leak fix — compute "does the heap env own
                # >=1 RESOURCE field" BEFORE the `!cl_env_fields` move below.
                # `cl_env_fields[i].type_name` is the OWNED pointee name
                # (Ptr->pointee already resolved at §4c-2), so a resource check
                # on it is the exact "this field needs freeing on drop" signal.
                bool cl_env_owns_resource = false
                int cl_ri = 0
                while cl_ri < cl_env_fields.len():
                    if is_resource_type_name(cl_env_fields.get(cl_ri).unwrap().type_name, &gmod):
                        cl_env_owns_resource = true
                    cl_ri += 1
                Vector[GirEnumVariantInfo] cl_no_variants = []
                gmod.type_infos.put(closure_name.clone(), GirTypeInfo(closure_name.clone(), !cl_env_fields, !cl_no_variants, false))
                # ── §4d: build a struct-ctor of __Closure_N (capture sources
                # as field args) → the user-struct-ctor intercept turns it
                # into an IStructInit (a STACK env). Use GICall (NOT
                # GICallExtern) so try_lower_user_struct_ctor fires. Then
                # assign that __Closure_N value into the GorgetClosure slot —
                # the step-5 LIR closure-pack promotion packs it onto the heap.
                int cl_env_tmp = add_local(&ctx, lookup_or_register_named(&gmod, closure_name), None)
                Vector[Operand] cl_ctor_args = []
                int cl_ai = 0
                while cl_ai < cl_caps.len():
                    ClosureCapture cl_arg_cap = cl_caps.get(cl_ai).unwrap()
                    if cl_arg_cap.mode == CAP_BY_MUT_REF:
                        # §4d-2c (Phase 2c ByMutRef): the env field is a
                        # `MutPtr(T)` to the OUTER slot, so push its ADDRESS, not
                        # the value. Mint a fresh `GtMutPtr(T)` temp and emit
                        # `GIAssign(tmp, OpBorrow(cap.local_id))`; the LIR D.1
                        # dispatch (lir_lower.gg ~3296) sees a value-typed source
                        # rebound into a Ptr-typed dst and emits
                        # `tmp = &outer_slot` (ISlotAddr+ISlotStore). Push
                        # `OpCopy(tmp)` (a plain pointer copy into the env field)
                        # — NOT op_consume, which would clone/move the VALUE.
                        # Mirrors Rust `emit_borrow_mut` (closures.rs:326-332).
                        int cl_mr_ptr_ty = register_type(&gmod, GtMutPtr(cl_arg_cap.type_id))
                        int cl_mr_tmp = add_local(&ctx, cl_mr_ptr_ty, None)
                        emit(&ctx, GIAssign(cl_mr_tmp, OpBorrow(cl_arg_cap.local_id)))
                        cl_ctor_args.push(OpCopy(cl_mr_tmp))
                    else:
                        # §4d-2 (Phase 2b): route the capture source through
                        # op_consume at an OWNING (CkFieldWrite) position — the
                        # env field OWNS its data. A LIVE owned resource → OpClone
                        # (the wire pass keeps it for live sources; e.g.
                        # `String s` printed after the make-site MUST clone, not
                        # move); a DEAD owned resource → OpMove (refined by the
                        # liveness wire pass); a Ptr/borrow-alias → OpClone through
                        # the pointer (decide_ptr_consume). Primitives / COPY
                        # structs fall to OpCopy inside op_consume, identical to
                        # the prior raw OpCopy. So the env always holds an
                        # INDEPENDENT snapshot, never a shared alias.
                        cl_ctor_args.push(op_consume(ctx, &gmod, cl_arg_cap.local_id, CkFieldWrite()))
                    cl_ai += 1
                emit(&ctx, GICall(cl_env_tmp, closure_name.clone(), cl_ctor_args))
                emit(&ctx, GIAssign(cdst, OpCopy(cl_env_tmp)))
                # ② closure ENV-FIELD leak fix — record the GorgetClosure value's
                # `cdst` local -> `__Closure_N` ONLY when the heap env owns >=1
                # RESOURCE field (a droppable SNAPSHOT — flag computed above,
                # before `cl_env_fields` was moved). A pure-primitive / COPY-
                # struct env has no `__Closure_N__drop` generated, so recording
                # it would be a harmless no-op — but we gate to keep the
                # channel's invariant tight (an entry => a real per-field dtor
                # exists). The SVarDecl MoveDirect arm copies this onto the fresh
                # dropped `var_local`; the read site at the GorgetClosure
                # GIDropIfAlive routes through `__Closure_N__drop`.
                if cl_env_owns_resource:
                    gmod.closure_env_type.put(ctx.current_fn_name + "\0" + int_to_str(cdst), closure_name.clone())
            else:
                # lowerable+no-captures OR stubbed → keep the Step-A
                # __make_closure_N NULL-env path. (Stubbed stays WRONG as
                # today; 2b/2c fix.)
                String make_fn = "__make_closure_" + int_to_str(cid)
                Vector[Operand] make_args = []
                gmod.fn_sigs.put(make_fn, closure_tid)
                emit(&ctx, GICallExtern(cdst, make_fn, make_args))
            # Record the closure for the post-pass, carrying the captures so
            # the post-pass field-loads them before lowering the body.
            gmod.lifted_closures.push(LiftedClosure(cid, closure_name + "__call", cl_sig.self_ptr, cl_sig.abi_param_types, cl_sig.body_param_types, cl_sig.body_param_names, cl_sig.return_type, cbody, false, cl_lowerable, !cl_caps))
            # CLOSURE LEAK Class B — register the freshly-packed GorgetClosure
            # value (`cdst`, LoOwned) for drop at the MAKE-SITE. A capturing
            # closure owns a HEAP env-box (`__gorget_closure_env_alloc`); when
            # the make-site value flows DIRECTLY into a non-consuming position —
            # an INLINE callable arg (`apply_mut((int n): n+base, 5)`, borrowed
            # → never registered) — it is orphaned and the env-box leaks
            # (closure_mutable_capture: 16B). Registering at creation makes the
            # scope-exit GIDropIfAlive(GorgetClosure) free it exactly once via
            # `gorget_closure_free` (+ the per-field `__Closure_N__drop` when a
            # `closure_env_type` entry exists). SAFE-BY-CONSTRUCTION for the
            # directly-bound case (`auto f = (int y): y+k`): the SVarDecl
            # MoveDirect arm mints a fresh registered `var_local` and op_consume
            # emits OpMove → GIMoveZero zeros `cdst`, so its scope-exit memcmp-
            # guarded drop finds a zeroed slot and is suppressed (drop_elab
            # further elides it) — the var_local drops the env exactly once, no
            # double-free. A no-capture / stubbed closure has a NULL env, and
            # `gorget_closure_free` no-ops on NULL (`if (c->env)`), so this is
            # harmless there too. Mirrors the FRESH-OWNED-TEMP registration the
            # String/resource call-results already use (lower.gg:7464).
            register_local_for_drop(&ctx, cdst, closure_tid, &gmod)
            return cdst
        case EAs(inner_box, type_box):
            # `expr as T` — numeric scalar conversion. Lower the inner, read
            # its GIR type, resolve the target type, and emit a GICast when
            # BOTH endpoints are DISTINCT numeric scalars (int-family or
            # float-family). Mirrors Rust's EAs lowering
            # (src/ir/lowering/exprs/mod.rs:446) which emits `builder.cast`
            # then routes to the right LIR cast op by source/target family
            # (insts.rs:393-402).
            #
            # Scalar-only guard — `from_ty`/`to_ty` in [I8_TYPE, F64_TYPE]
            # (ids 1..10) so BOTH are int- or float-family:
            #   • int↔float / float↔float / int↔int(width) → routed (the fix).
            #   • `int as bool` (to_ty == BOOL_TYPE = 0, outside the range) →
            #     falls through to the no-op, preserving the truthy-by-no-op
            #     semantics the `if (x as bool)` one-liners rely on.
            #   • `char as int` (char is an aggregate, not a prim id) → falls
            #     through → stays a `gg check` / cc reject like Rust.
            #   • `"x" as String`, Ref-deref casts, same-type casts → fall
            #     through to the existing no-op (out of scope; pre-existing).
            int eas_loc = lower_expr(&ctx, *inner_box, &gmod)
            int eas_from = I64_TYPE
            if eas_loc >= 0 and eas_loc < ctx.locals.len():
                eas_from = ctx.locals.get(eas_loc).unwrap().type_id
            int eas_to = map_ast_type(*type_box, &gmod)
            bool eas_from_num = eas_from >= I8_TYPE and eas_from <= F64_TYPE
            bool eas_to_num = eas_to >= I8_TYPE and eas_to <= F64_TYPE
            if eas_from_num and eas_to_num and eas_from != eas_to:
                # Mint the dst with `to_ty` so the formatter renders the
                # target type (and downstream type inference sees the cast
                # result correctly).
                int eas_dst = add_local(&ctx, eas_to, None)
                emit(&ctx, GICast(eas_dst, eas_loc, eas_from, eas_to))
                return eas_dst
            return eas_loc
        case EMove(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EMutableBorrow(inner_box):
            # `&*b` — a mutable borrow of a box deref must yield a pointer to
            # the HEAP pointee, not to a stack value-copy. `lower_expr(*b)`
            # emits a GIDeref value-LOAD (copies the pointee into a fresh
            # stack local), so `mutate(&*b)` would mutate the copy (Snag #26,
            # box_deref_write's `mutate(&*b2)` shape). The box VALUE is itself
            # the heap pointer (Box__T = `typedef void*`), so return the box
            # LOCAL directly — the call arg-prep's `lir_slot_is_box` path
            # (lir_lower.gg:3265) then passes the loaded box pointer as the
            # `&`-borrow arg = a pointer straight to the heap pointee. Mirrors
            # Rust gg modelling `&*b` as a borrow of `Place{box,[Deref]}`.
            match (*inner_box).expr:
                case EDeref(mb_box):
                    # Lower the inner ONCE and reuse the local on both the box
                    # and the (defensive) non-box path. `&*<non-box>` is now a
                    # `gg check` error (typecheck DerefNonBox), so the `None`
                    # branch is unreachable from valid source — but if a non-box
                    # deref ever reaches the lowerer, re-lowering `*inner_box`
                    # here would EXECUTE the inner expression a SECOND time (the
                    # EDeref arm at the bottom of this match re-lowers `*mb_box`).
                    # Reuse `mb_box_local` so the inner is evaluated exactly once.
                    int mb_box_local = lower_expr(&ctx, *mb_box, &gmod)
                    int mb_box_tid = ctx.locals.get(mb_box_local).unwrap().type_id
                    String mb_box_tname = type_id_to_name(mb_box_tid, &gmod)
                    match box_deref_inner_name(mb_box_tname, &gmod):
                        case Some(_):
                            return mb_box_local
                        case None:
                            # Non-box `&*x` — invalid per typecheck. Reuse the
                            # already-lowered inner local; do NOT re-lower.
                            return mb_box_local
                else:
                    pass
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDeref(inner_box):
            # `*box` — actually load the inner value. The inner AST is
            # lowered to a local of type `Box[T]` (void* at C level). We
            # need to emit a load so downstream code that passes the
            # result to a function expecting `T` works.
            int dsrc = lower_expr(&ctx, *inner_box, &gmod)
            int dsrc_tid = ctx.locals.get(dsrc).unwrap().type_id
            String dsrc_tname = type_id_to_name(dsrc_tid, &gmod)
            # Phase A typed read: BkRegularBox identifies parameterised
            # Box[T]; the bare trait Box's no-suffix name doesn't reach
            # an EDeref site (a trait box deref goes through vtable
            # dispatch, not raw pointer load).
            bool dsrc_is_box = false
            match resource_meta_for(&gmod, dsrc_tname):
                case Some(rmeta):
                    match rmeta.box_kind:
                        case BkRegularBox():
                            dsrc_is_box = true
                        else:
                            pass
                case None:
                    pass
            if dsrc_is_box:
                # The inner name is the post-`Box__` suffix of the mangled
                # name (e.g. "Box__SpannedExpr" -> "SpannedExpr").
                String d_inner_name = dsrc_tname.slice(5, dsrc_tname.len())
                int d_inner_tid = resolve_field_gir_type(d_inner_name, &gmod)
                # Phase 3 (Class 8): see EFieldAccess box-deref site
                # at line ~4246 for the architectural rationale —
                # the deref-inner aliases the box's heap. An OWNED box's
                # `dsrc` is LoOwned, so `add_local_inheriting` would fall
                # through to a FRESH LoOwned ddst (the bug): at a consume
                # position (`*b = *b`, `*b = (*b).f`) op_consume then
                # returns OpMove and shallow-aliases the box's heap buffer
                # — the drop-on-overwrite below would dangle it (a UAF, the
                # exact defect the prior read-site patch 05a40cbf shipped).
                # Tag LoBorrowed unconditionally: the deref-inner is ALWAYS
                # a borrow alias into the box heap regardless of who owns
                # the box, so a consume must CLONE (op_consume LoBorrowed →
                # OpClone → gorget_string_clone_to_owned, an independent
                # buffer). Mirrors Rust's EDeref rvalue tag AssignMode::Borrow
                # (src/ir/lowering/exprs/mod.rs:690-700).
                int ddst = add_local_with(&ctx, d_inner_tid, None, LoBorrowed(), BoRuntimeView(dsrc))
                emit(&ctx, GIDeref(ddst, dsrc, d_inner_tid))
                return ddst
            return dsrc
        case ETry(inner_box):
            return lower_expr(&ctx, *inner_box, &gmod)
        case EPropagate(inner_box):
            # D29: transparent to inner (normally intercepted at lower_expr's
            # entry; this arm covers any direct lower_expr_inner call).
            return lower_expr(&ctx, *inner_box, &gmod)
        case EDotShorthand(variant, sargs):
            # `.Variant` / `.Variant(args)` in value position. The variant name
            # alone is the constructor; delegate to `lower_call`, which resolves
            # the parent enum via the typed `enum_variant_parent` index and adopts
            # `ctx.expected_type` for the dst slot, emitting a full-size enum
            # aggregate `(Inst){.tag = N, ...}`. The prior stub lowered `sargs`
            # for side-effects then returned a bare `add_local(I64_TYPE)` — it
            # dropped the variant AND the expected-type, so every dot-shorthand
            # collapsed to a zero-init tag-0 value. Mirrors Rust `EDotShorthand`
            # lowering (exprs/mod.rs:1472-1503) and `lower_nullary_variant_ident`
            # (lower_types.gg), which delegate the qualified `.Variant` ident form
            # through the same typed path.
            String ds_name = variant.clone()
            Vector[SpannedType] ds_no_targs = []
            # RV-B: EDotShorthand now carries Vector[CallArg]; adapt to lower_call's
            # bare-value + names interface exactly like the ECall arm (lower_call
            # keys off the callee's borrow_flags, NOT the arg sigil — ast.gg:43).
            Vector[SpannedExpr] ds_vals = callarg_values(sargs)
            Vector[String] ds_names = callarg_names(sargs)
            return lower_call(&ctx, ds_name, ds_vals, ds_names, ds_no_targs, &gmod)
        case EBlock(block_stmts):
            # Block in value position — lower via `lower_block_expr` and return
            # its tail value (was dropping it into a fresh UNIT local). Mirrors
            # Rust `lower_expr` Block dispatch (`exprs/mod.rs` → lower_block_expr
            # `:3203`), sibling of the EMatch/EIf value-position cases.
            return lower_block_expr(&ctx, block_stmts, &gmod)
        case EDo(do_stmts):
            # `do:` block in value position — same as EBlock: lower the block
            # and return its tail value (was falling to the UNIT `else`). Also
            # covers multi-line `catch` recovery bodies (parser.gg:1700-1713).
            return lower_block_expr(&ctx, do_stmts, &gmod)
        case ESelfExpr():
            if nl_contains(ctx, "self"):
                return nl_get(ctx, "self")
            int sdst = add_local(&ctx, UNIT_TYPE, None)
            return sdst
        case EDefaultOp(lhs_box, rhs_box):
            lower_expr(&ctx, *lhs_box, &gmod)
            return lower_expr(&ctx, *rhs_box, &gmod)
        case EIs(inner_box, negated, pattern):
            # `x is Pattern` — test the scrutinee against the pattern and
            # bind any sub-pattern names into the function-scope named
            # locals. Mirrors Rust gg's `Expr::Is` lowering (src/ir/lowering/
            # exprs/mod.rs:649) + `emit_is_bindings` (stmts/mod.rs:2643)
            # collapsed into one site — `lower_pattern_match` does both
            # the tag-test and the field-extract, and `nl_put` is
            # function-scoped so the bindings remain visible in the
            # then-branch of any enclosing `if x is Some(k):`.
            int scrutinee = lower_expr(&ctx, *inner_box, &gmod)
            int scr_tid = ctx.locals.get(scrutinee).unwrap().type_id
            String type_name = type_id_to_name(scr_tid, &gmod)
            # Unwrap Ptr/MutPtr — borrowed scrutinees show up as Ptr(T).
            if scr_tid >= 0 and scr_tid < gmod.type_table.len():
                GirType bt = gmod.type_table.get(scr_tid).unwrap()
                match bt:
                    case GtPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    case GtMutPtr(inner):
                        type_name = type_id_to_name(inner, &gmod)
                    else:
                        pass
            String enum_name = match_enum_type(type_name, &gmod)
            int match_bb = new_block(&ctx)
            int no_match_bb = new_block(&ctx)
            int merge_bb = new_block(&ctx)
            int isdst = add_local(&ctx, BOOL_TYPE, None)
            lower_pattern_match(&ctx, scrutinee, *pattern, enum_name, match_bb, no_match_bb, &gmod)
            # Match path: scrutinee matched the pattern. Bindings already
            # emitted in lower_pattern_match's bind_bb upstream.
            switch_to(&ctx, match_bb)
            bool match_val = true
            if negated:
                match_val = false
            emit(&ctx, GIAssign(isdst, OpConstBool(match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            # No-match path.
            switch_to(&ctx, no_match_bb)
            bool no_match_val = false
            if negated:
                no_match_val = true
            emit(&ctx, GIAssign(isdst, OpConstBool(no_match_val)))
            set_terminator(&ctx, GTJump(merge_bb))
            switch_to(&ctx, merge_bb)
            return isdst
        case EAwait(inner_box):
            # Async await (Inc-1). Lower the inner expr (the awaited Task
            # local), resolve the producer fn, and dispatch through the
            # monomorphic `__gorget_await_<fn>` helper. Mirrors Rust gg
            # (`src/ir/lowering/exprs/mod.rs:1036-1108`).
            int aw_inner = lower_expr(&ctx, *inner_box, &gmod)
            # Resolution order: (1) DIRECT — the awaited local is a Task
            # BINDING local registered at its SVarDecl (the path all 3 Inc-1
            # fixtures use); (2) TYPE-based fallback when exactly one producer
            # exists for the Task's type (the `len()==1` gate). Two fns
            # producing the same Task[int] (coroutine_dict_set/option_result)
            # correctly DON'T fire the fallback — the direct path resolves them.
            String aw_fn = ""
            if aw_inner >= 0 and aw_inner < ctx.locals.len():
                if ctx.result_locals.contains(aw_inner):
                    aw_fn = ctx.result_locals.get(aw_inner).unwrap()
                else:
                    int aw_task_ty = ctx.locals.get(aw_inner).unwrap().type_id
                    String aw_task_name = type_id_to_name(aw_task_ty, &gmod)
                    if ctx.task_type_fns.contains(aw_task_name):
                        Vector[String] aw_fns = ctx.task_type_fns.get(aw_task_name).unwrap()
                        if aw_fns.len() == 1:
                            aw_fn = aw_fns.get(0).unwrap()
            if aw_fn == "":
                # Not a tracked Task (e.g. a non-async passthrough) — preserve
                # the old bare-passthrough behavior.
                return aw_inner
            # Producer return type → `void`-await (no result) or value-await.
            # Prefer the REAL GIR-function return type from gmod.functions: the
            # pre-scan that builds fn_sigs mis-records a String/collection return
            # as I64, so trusting fn_sigs here would type the await dst local as
            # int for a String producer (wrong width → cc-fail). Fall back to
            # fn_sigs only for a forward ref not yet in gmod.functions.
            int aw_ret_ty = UNIT_TYPE
            bool aw_ret_found = false
            int awfi = 0
            while awfi < gmod.functions.len():
                if gmod.functions.get(awfi).unwrap().name == aw_fn:
                    aw_ret_ty = gmod.functions.get(awfi).unwrap().return_type
                    aw_ret_found = true
                    awfi = gmod.functions.len()
                else:
                    awfi += 1
            if not aw_ret_found and gmod.fn_sigs.contains(aw_fn):
                aw_ret_ty = gmod.fn_sigs.get(aw_fn).unwrap()
            String aw_call = "__gorget_await_" + aw_fn
            Vector[Operand] aw_args = [op_consume(ctx, &gmod, aw_inner, CkCallArgBorrow())]
            int aw_dst = 0
            if aw_ret_ty == UNIT_TYPE:
                aw_dst = add_local(&ctx, UNIT_TYPE, None)
                emit(&ctx, GICall(-1, aw_call, aw_args))
                emit(&ctx, GIAssign(aw_dst, OpConstUnit()))
            else:
                aw_dst = add_local(&ctx, aw_ret_ty, None)
                emit(&ctx, GICall(aw_dst, aw_call, aw_args))
            # Defensive move-zero of the awaited Task binding local: the join +
            # free happens inside `__gorget_await_<fn>`, and `drop_fn_for_type`
            # returns "" for a Task runtime type (so there is no scope-exit drop
            # entry today). `mark_local_moved` no-ops cleanly when the local has
            # no drop entry — this is parity/forward-safety, not load-bearing for
            # the Inc-1 flip. Mirrors Rust's `move_zero_and_mark`
            # (`exprs/mod.rs:1075-1078`).
            mark_local_moved(&ctx, aw_inner)
            return aw_dst
        case ESpawn(inner_box):
            # closure Phase 2 Step A: inline-spawn `spawn ((): body)(args)`.
            # The ECall make-site arm only handles EIdentifier/EFieldAccess
            # callees, so an EClosure callee would otherwise be DROPPED. Peek
            # for the inline-closure shape: if found, take the cid, push the
            # `__spawn_wrap___Closure_N` stub (the exact stub the old scan
            # pushed), record a LiftedClosure (so the post-pass pushes its
            # `__Closure_N__call`), lower the args (so capturing-closure args
            # aren't silently dropped), and return a value local. A NAMED-fn
            # callee (`spawn f(args)`) routes through `lower_named_fn_spawn`
            # (Inc-1: int+void returns, scalar by-value params — real
            # spawn/await wiring). Any other shape falls back to the bare
            # passthrough.
            match (*inner_box).expr:
                case ECall(spawn_callee_box, spawn_args, _):
                    match (*spawn_callee_box).expr:
                        case EClosure(sp_params, sp_body):
                            # Inline-spawn `spawn ((): body)(args)`. The self-host
                            # closure-spawn model is SYNCHRONOUS-INLINE: the closure
                            # body runs at the call site and the paired `.await()`
                            # is a no-op — identical to the already-passing
                            # `spawn printer()` closure-variable path (which lowers
                            # `printer()` as a direct `fn_ptr(env)` call cast to the
                            # Task type). The OLD code emitted an EMPTY
                            # `__spawn_wrap_` stub + passed empty captures ("capture
                            # support DEFERRED"), so the closure body NEVER ran
                            # (spawn_closure_inline / spawn_unchecked* printed
                            # nothing for the spawned closure).
                            #
                            # Fix: materialize the inline closure to its
                            # GorgetClosure VALUE (the EClosure make-site mints the
                            # cid, records the LiftedClosure, materializes captures
                            # into a heap env-box, and the post-pass pushes
                            # `__Closure_N__call`), then dispatch it exactly like
                            # the direct-IIFE arm (:2626): closure value as arg-0,
                            # call args borrowed, emit `__callable_<arity>`. The
                            # result is typed with `ctx.expected_type` (the Task
                            # type from the binding SVarDecl) so the codegen casts
                            # the fn ptr to `Task__T(*)(void*)` (non-void) — a bare
                            # `void` return over a used slot would `void value not
                            # ignored` CC-FAIL. Mirrors the closure-LOCAL call
                            # path's `expected_type` return-type fallback (:2610).
                            int isp_callable = lower_expr(&ctx, *spawn_callee_box, &gmod)
                            Vector[Operand] isp_call_args = []
                            isp_call_args.push(op_consume(ctx, &gmod, isp_callable, CkCallArgBorrow()))
                            for isp_arg in spawn_args:
                                # SIBLING of the IIFE arg loop (:2650): a
                                # borrow-unique PARAM identifier arg is passed
                                # THROUGH by pointer, not auto-dereffed to a value.
                                bool isp_passed_ptr = false
                                match isp_arg.value.expr:
                                    case EIdentifier(isp_name):
                                        if nl_contains(ctx, isp_name):
                                            int isp_lid = nl_get(ctx, isp_name)
                                            GirLocal isp_loc = ctx.locals.get(isp_lid).unwrap()
                                            bool isp_is_param = false
                                            match isp_loc.ownership:
                                                case LoParam():
                                                    isp_is_param = true
                                                else:
                                                    pass
                                            if isp_is_param and isp_loc.type_id >= PRIM_COUNT and isp_loc.type_id < gmod.type_table.len():
                                                match gmod.type_table.get(isp_loc.type_id).unwrap():
                                                    case GtMutPtr(_):
                                                        isp_call_args.push(op_consume(ctx, &gmod, isp_lid, CkCallArgBorrow()))
                                                        isp_passed_ptr = true
                                                    else:
                                                        pass
                                    else:
                                        pass
                                if not isp_passed_ptr:
                                    int isp_aval = lower_expr(&ctx, isp_arg.value, &gmod)
                                    isp_call_args.push(op_consume(ctx, &gmod, isp_aval, CkCallArgBorrow()))
                            int isp_arity = spawn_args.len()
                            String isp_call = "__callable_" + int_to_str(isp_arity)
                            # Return type: the Task expected_type from the binding
                            # SVarDecl (non-void so the cast over the result slot is
                            # valid). Fall back to the closure's own return type when
                            # no expected_type is set (bare `spawn (...)()` statement).
                            int isp_ret = ctx.expected_type
                            if isp_ret < 0:
                                isp_ret = compute_closure_sig(0, sp_params, sp_body, &gmod, -1).return_type
                            int isp_dst = add_local(&ctx, isp_ret, None)
                            emit(&ctx, GICallExtern(isp_dst, isp_call, isp_call_args))
                            return isp_dst
                        case EIdentifier(spawn_named_fn):
                            # `spawn ident(args)`: the identifier is EITHER a real
                            # named function OR a local CLOSURE variable (`auto g =
                            # (): …; spawn g()`). ONLY a real named fn — present in
                            # `fn_sigs` and NOT shadowed by a closure LOCAL of the
                            # same name — routes to the Inc-1 spawn wiring. A
                            # closure-variable spawn falls through to the bare
                            # passthrough (its existing behavior — emitting
                            # `__gorget_spawn_<g>` would reference a non-existent
                            # `g` symbol → undefined-reference link-fail, regressing
                            # spawn_closure_void/spawn_closure_copy). Mirrors the
                            # ECall EIdentifier closure-vs-fn guard (:1195).
                            if gmod.fn_sigs.contains(spawn_named_fn) and not nl_contains(ctx, spawn_named_fn):
                                # Shared-spawn deferral (round-16 Phase 1): a
                                # `spawn worker(&x)` with x a `shared` var routes
                                # to the token-wrapper path (pass the carrier, not
                                # &x; lock inside the worker). Returns -1 when no
                                # shared arg → fall through to the normal named-fn
                                # spawn.
                                int spawn_shared_dst = lower_shared_spawn(&ctx, spawn_named_fn, callarg_values(spawn_args), &gmod)
                                if spawn_shared_dst >= 0:
                                    return spawn_shared_dst
                                # round-16 Phase-2 inner-shared-spawn: a
                                # `spawn inner(&param)` where `&param` is a
                                # mutable-borrow PARAM of THIS function (an async
                                # variant in waiting). Emits a real spawn/await +
                                # records the InnerSharedSpawn the post-pass rewrites
                                # to forward the carrier. Returns -1 when no `&param`
                                # arg → fall through to the named-fn spawn.
                                int spawn_inner_dst = lower_inner_shared_spawn(&ctx, spawn_named_fn, callarg_values(spawn_args), &gmod)
                                if spawn_inner_dst >= 0:
                                    return spawn_inner_dst
                                # Named-fn spawn (Inc-1). Returns -1 when OUT of
                                # Inc-1 scope (String/owned return or non-scalar
                                # param) — fall back to the bare passthrough (keeps
                                # the pre-Inc-1 WRONG-output, NOT a fresh cc-fail).
                                # Rolls to Inc-2.
                                int spawn_named_dst = lower_named_fn_spawn(&ctx, spawn_named_fn, callarg_values(spawn_args), &gmod)
                                if spawn_named_dst >= 0:
                                    return spawn_named_dst
                            # Bare-passthrough fallback. When an arg is a
                            # shared OVERRIDE-kind facade (shared(rwlock)/
                            # shared(atomic)), the callee's param IS the raw
                            # sync primitive (RWLock[T]/AtomicInt) — pass the
                            # CARRIER, not a locked/loaded snapshot. Mirrors
                            # Rust gg's override rule at the spawn site
                            # ("user overrides pass the raw sync primitive —
                            # the callee uses it directly", exprs/mod.rs:
                            # 1205-1209 + the pass_raw else-arm :1392-1397).
                            # Auto (SHK_MUTEX) facades keep the existing
                            # value-snapshot passthrough — their callees take
                            # the plain inner type.
                            bool sp_stub_raw = false
                            for sp_stub_arg in spawn_args:
                                match sp_stub_arg.value.expr:
                                    case EIdentifier(sp_stub_n):
                                        if ctx.shared_locals.contains(sp_stub_n):
                                            if ctx.shared_locals.get(sp_stub_n).unwrap().kind != SHK_MUTEX:
                                                sp_stub_raw = true
                                    else:
                                        pass
                            if sp_stub_raw:
                                bool sp_stub_prev = ctx.shared_pass_raw
                                ctx.shared_pass_raw = true
                                int sp_stub_dst = lower_expr(&ctx, *inner_box, &gmod)
                                ctx.shared_pass_raw = sp_stub_prev
                                return sp_stub_dst
                            return lower_expr(&ctx, *inner_box, &gmod)
                        else:
                            return lower_expr(&ctx, *inner_box, &gmod)
                else:
                    return lower_expr(&ctx, *inner_box, &gmod)
        case ESpawnBlocking(inner_box):
            # `spawn blocking fn(args)` — runs the function on the blocking
            # thread pool. For OUTPUT parity the blocking-pool vs async-pool
            # distinction is invisible: what matters is that the awaited result
            # is the function's real return value. Route a NAMED-fn call through
            # the same `lower_named_fn_spawn` wiring the regular `ESpawn`
            # EIdentifier arm uses (emits `__gorget_spawn_<fn>` into a Task-typed
            # dst; the binding SVarDecl + `.await()` complete the round-trip).
            # Mirrors Rust gg's `Expr::SpawnBlocking` arm (exprs/mod.rs:1471) —
            # same producer/task registration as regular spawn (Rust also adds
            # `blocking_fn_names` for pool selection, which does not change the
            # emitted VALUE). Any non-named-fn shape falls back to the bare
            # passthrough (its prior behavior).
            match (*inner_box).expr:
                case ECall(sb_callee_box, sb_args, _):
                    match (*sb_callee_box).expr:
                        case EIdentifier(sb_named_fn):
                            if gmod.fn_sigs.contains(sb_named_fn) and not nl_contains(ctx, sb_named_fn):
                                int sb_named_dst = lower_named_fn_spawn(&ctx, sb_named_fn, callarg_values(sb_args), &gmod)
                                if sb_named_dst >= 0:
                                    return sb_named_dst
                            return lower_expr(&ctx, *inner_box, &gmod)
                        else:
                            return lower_expr(&ctx, *inner_box, &gmod)
                else:
                    return lower_expr(&ctx, *inner_box, &gmod)
        case EDictLiteral(dkeys, dvals):
            # `{}` / `{k: v, …}` — lower each key/value for side effects,
            # then call the appropriate constructor to produce a map with
            # valid `alloc`. Dict[K,V] → insertion-order-preserving
            # (gorget_dict_new*); HashMap[K,V] → unordered (gorget_map_new*).
            # Without a hint from SVarDecl the sizes fall back to 8
            # (pointer/int); with the hint we emit a magic sentinel name
            # `__gorget_{dict,map}_new_sized_K__<K>__V__<V>` which the
            # codegen expands to `gorget_{dict,map}_new(sizeof(K), sizeof(V))`
            # — required whenever K or V is an aggregate (LirStructDef et al.).
            String dict_kname = ctx.pending_dict_key_tyname
            String dict_vname = ctx.pending_dict_val_tyname
            bool dict_ordered = ctx.pending_dict_ordered
            ctx.pending_dict_key_tyname = ""
            ctx.pending_dict_val_tyname = ""
            ctx.pending_dict_ordered = false
            # Lower each (key, value) pair into fresh locals so we can
            # `gorget_map_put` them into the constructed map below. The
            # previous code lowered keys/values for side effects ONLY and
            # DISCARDED the locals, so a `static Dict[K,V] M={"a":1}`
            # produced an EMPTY map (the entries were never inserted).
            # Mirrors Rust `lower_dict_literal` (src/ir/lowering/exprs/
            # collections.rs:338-388): lower the KEY first (keys are not
            # value-typed), then set the value-override expected_type from
            # the declared V before lowering the VALUE, then restore.
            # Single paired loop — a separate value loop would double-lower
            # (double side effects + double owning temps).
            Vector[int] dict_key_locals = []
            Vector[int] dict_val_locals = []
            int dict_pair_n = dkeys.len()
            int dict_pi = 0
            int prev_dict_et = ctx.expected_type
            while dict_pi < dict_pair_n:
                # Keys + values are independently typed, NOT the dict's
                # destination type — clear the enclosing `expected_type` so a
                # Result-typed surrounding context (e.g. `return {"a": to_n(sel)}`
                # from a `throws` fn, where SReturn set expected_type to the
                # function's `Result[Dict..,E]` slot) doesn't make the
                # centralized auto-prop hook's capture-form check suppress the
                # peel on a throws-call value — leaving a raw `Result` memcpy'd
                # into the int slot (zero-init garbage). Mirrors the tuple/dict
                # per-element expected_type override+clear documented on the
                # throws_autoprop_dict_value fixture.
                ctx.expected_type = -1
                # Key first: keys can be any type, not V — lower BEFORE the
                # value-override (Rust collections.rs:338-340).
                int dict_key_local = lower_expr(&ctx, dkeys.get(dict_pi).unwrap(), &gmod)
                # Value-override from `dict_vname` when known (else -1 — let the
                # value type itself, e.g. the auto-prop'd Ok payload, decide).
                if dict_vname != "":
                    int dict_v_et = lookup_or_register_named(&gmod, dict_vname)
                    if dict_v_et != I64_TYPE and dict_v_et != UNIT_TYPE:
                        ctx.expected_type = dict_v_et
                int dict_val_local = lower_expr(&ctx, dvals.get(dict_pi).unwrap(), &gmod)
                dict_key_locals.push(dict_key_local)
                dict_val_locals.push(dict_val_local)
                dict_pi = dict_pi + 1
            ctx.expected_type = prev_dict_et
            # ELEMENT-TYPE WRITE-THROUGH (Layering rule 4): when no SVarDecl
            # hint named K/V (`auto d = {"x": 1}`), recover them from the
            # first lowered key/value locals. Mirrors Rust `lower_dict_literal`
            # inferring key/val types from the first pair. Carrying both names
            # lets the dst local below be typed the VALUE-CARRYING
            # `Dict__<k>__<v>` instead of decaying to a bare `GorgetMap` that
            # drops the value type — the loss that makes a downstream `d[k]`
            # read unable to recover V (`index_value_type_name("GorgetMap")`
            # is "" → the read stubs to OpConstI64(0)).
            if (dict_kname == "" or dict_vname == "") and dict_key_locals.len() > 0:
                int ddl_first_k = dict_key_locals.get(0).unwrap()
                int ddl_first_v = dict_val_locals.get(0).unwrap()
                if dict_kname == "":
                    dict_kname = type_id_to_name(ctx.locals.get(ddl_first_k).unwrap().type_id, &gmod)
                if dict_vname == "":
                    dict_vname = type_id_to_name(ctx.locals.get(ddl_first_v).unwrap().type_id, &gmod)
            # Centralized collection-accumulator typing (one source of truth):
            # ordered → `Dict__K__V`, unordered → `HashMap__K__V`, bare
            # `GorgetMap` fallback when either K or V is unknown.
            String ddst_kind = "map_unordered"
            if dict_ordered:
                ddst_kind = "map_ordered"
            int ddst_tid = collection_accumulator_tid(&gmod, ddst_kind, "", dict_kname, dict_vname)
            int ddst = add_local(&ctx, ddst_tid, None)
            if dict_kname != "" and dict_vname != "":
                # Sentinel `__GGSEP__` separates K and V type names — zero
                # collision risk with real type names (no "GGSEP" pattern
                # appears in any monomorphized Gorget type).
                String magic_prefix = "__gorget_map_new_sized_"
                if dict_ordered:
                    magic_prefix = "__gorget_dict_new_sized_"
                String magic_dict = magic_prefix + dict_kname + "__GGSEP__" + dict_vname
                Vector[Operand] dn_args_typed = []
                emit(&ctx, GICallExtern(ddst, magic_dict, dn_args_typed))
            else:
                if dict_ordered:
                    Vector[Operand] dn_args_ord = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_dict_new", dn_args_ord))
                else:
                    Vector[Operand] dn_args = [OpConstI64(8), OpConstI64(8)]
                    emit(&ctx, GICallExtern(ddst, "gorget_map_new", dn_args))
            # Insert each lowered (key, value) pair into the freshly-built
            # map. Mirrors `lower_index_assign:7392` and Rust `insert_pair`
            # (collections.rs:380-388/398-417). Both Dict (ordered) and
            # HashMap (unordered) use the SAME runtime mutator
            # `gorget_map_put` — no ordered/unordered split here.
            # `OpBorrow(ddst)` is REQUIRED: `ddst` is owned, live past every
            # put (the next iteration puts again) AND returned, so OpMove
            # would trip drop-emission's "owned but live-past → clone before
            # call" rule and each put would mutate a throwaway clone while
            # `ddst` stayed empty (same hazard the array arm documents at
            # :5804-5814). Both key AND value → CkCallArgOwning: gorget_map_put
            # is the NO-CLONE ownership-transfer variant — the map TAKES
            # ownership of both at this consuming position. Passing the key as
            # CkCallArgBorrow double-freed an owned String key (the put-loop
            # never zeroed the source, so drop-emission dropped it AND the map
            # later dropped its stored copy).
            int dict_put_i = 0
            while dict_put_i < dict_pair_n:
                Vector[Operand] put_args = [OpBorrow(ddst), op_consume(ctx, &gmod, dict_key_locals.get(dict_put_i).unwrap(), CkCallArgOwning()), op_consume(ctx, &gmod, dict_val_locals.get(dict_put_i).unwrap(), CkCallArgOwning())]
                emit(&ctx, GICallExtern(-1, "gorget_map_put", put_args))
                dict_put_i = dict_put_i + 1
            return ddst
        case ECatch(inner_box, error_binding, recovery_box):
            return lower_catch_expr(&ctx, *inner_box, error_binding, *recovery_box, &gmod)
        case ERethrow(inner_box, error_binding, _err_ty, transform_box):
            return lower_rethrow_expr(&ctx, *inner_box, error_binding, *transform_box, &gmod)
        case EMatch(scrut_box, arms):
            # `match` in value position — lower into one result local that
            # every reaching arm assigns. Mirrors Rust `lower_expr` EMatch
            # dispatch (`exprs/mod.rs:391`).
            return lower_match_expr(&ctx, *scrut_box, arms, &gmod)
        case EImplicitClosure(ic_body_box):
            # closure Phase 2 Step A: implicit `it` closure (`.map(it*2)`).
            # Make-site = sole id source + recorder, exactly like EClosure.
            # Subsumes the deleted emit_it_closure via the shared helper.
            return record_implicit_it_closure(&ctx, *ic_body_box, &gmod)
        case EIt():
            # closure Phase 2 Step A: `it` is a VALUE (the live implicit
            # param), NOT a closure. Mirror Rust exprs/mod.rs:417 — resolve
            # `it` to the in-scope param when present, else a UNIT local.
            # No cid bump, no record. When an implicit-it body is lowered in
            # the post-pass, "it" is registered as a named local so this
            # resolves to the param.
            if nl_contains(ctx, "it"):
                return nl_get(ctx, "it")
            int it_dst = add_local(&ctx, UNIT_TYPE, None)
            emit(&ctx, GIAssign(it_dst, OpConstUnit()))
            return it_dst
        case EListComp(lc_comp_box, lc_var, lc_iter_box, lc_filt_opt):
            return lower_list_comprehension(&ctx, *lc_comp_box, lc_var, *lc_iter_box, lc_filt_opt, &gmod)
        case ESetComp(sc_comp_box, sc_var, sc_iter_box, sc_filt_opt):
            # Set comprehension `{expr for x in iter [if cond]}`. The 4th
            # AST field is `Option[Box[SpannedExpr]]` (mirrors EListComp):
            # the filter feeds the same `Some`-guarded synth body.
            return lower_set_comprehension(&ctx, *sc_comp_box, sc_var, *sc_iter_box, sc_filt_opt, &gmod)
        case EDictComp(dc_key_box, dc_val_box, dc_var, dc_iter_box, dc_filt_opt):
            # Dict comprehension `{k: v for x in iter [if cond]}`. The 5th
            # AST field is `Option[Box[SpannedExpr]]` (mirrors EListComp):
            # the filter is threaded into the synth body.
            return lower_dict_comprehension(&ctx, *dc_key_box, *dc_val_box, dc_var, *dc_iter_box, dc_filt_opt, &gmod)
        else:
            # Remaining: ERange
            int fallback = add_local(&ctx, UNIT_TYPE, None)
            emit(&ctx, GIAssign(fallback, OpConstUnit()))
            return fallback

# ── Vector higher-order-function (HOF) inline-loop lowering ──────────
# Desugar `v.map/filter/fold/reduce/any/all((explicit closure))` into an
# inline `for x in v:` loop with an accumulator, mirroring Rust gg's
# `try_emit_vector_each_hof` (src/lir/lower/insts.rs). The self-host has
# NO BIR, so we desugar directly to the AST-loop form the run-proven
# `lower_for_vector` already handles (the SAME machinery
# `lower_list_comprehension` reuses) — there is no `Vector__T__map` body.
#
# The closure is INLINED via AST substitution rather than dispatched: we
# name the synthesized loop var (and, for fold/reduce, the accumulator)
# after the closure's own PARAMETER names, so the closure's body
# expression — used verbatim — references those bindings directly. This
# sidesteps the erased-`GorgetClosure` closure-call return-type fallback
# and produces GIR byte-identical in shape to a hand-written loop.
#
# Scope (per the task): explicit NON-CAPTURING closures with a single
# expression body (`(int x): x*2`) and scalar elements only. Anything
# else (implicit `it`, capturing, block body without a tail expr,
# aggregate elements) returns -1 → the caller falls through to the normal
# extern dispatch (no behavioural change for those cases).
#
# Returns the result local id (>= 0) when handled, or -1 to fall through.
int try_lower_vector_hof(LowerCtx &ctx, int recv, String recv_type_name, String mname, Vector[SpannedExpr] margs, SpannedExpr sexpr, GirModule &gmod):
    Span span = sexpr.span
    String elem_name = collection_element_type(recv_type_name)
    if elem_name == "":
        return -1
    # ── map / filter: build a NEW Vector via an accumulator ──────────
    if mname == "map" or mname == "filter":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
        # map's output element type defaults to the INPUT element type (the
        # scalar-preserving common case, e.g. `map(double)` int→int); filter
        # always keeps the input type. For a CROSS-TYPE `map(f)` with a NAMED
        # function whose registered `fn_sigs` return type differs (e.g.
        # `map(label)` with `String label(int)`), resolve the output element
        # from the function's return type so the accumulator is `Vector[U]`,
        # not `Vector[T]` — otherwise a `String` return gets stored into an
        # int64 slot and read back as pointer garbage. Falls back to the input
        # element type for inline closures / unregistered fns (unchanged — a
        # known gap for inline cross-type map).
        String out_elem_name = elem_name
        if mname == "map":
            match margs.get(0).unwrap().expr:
                case EIdentifier(map_fn_nm):
                    if gmod.fn_sigs.contains(map_fn_nm):
                        out_elem_name = type_id_to_name(gmod.fn_sigs.get(map_fn_nm).unwrap(), &gmod)
                else:
                    pass
        # Type the accumulator with the ELEMENT-CARRYING `Vector__<elem>`
        # name (not bare `GorgetArray`) so the result is a self-describing
        # Vector: a CHAINED HOF (`v.filter(…).map(…).fold(…)`) sees a
        # `Vector__<elem>` receiver and re-resolves the element type via
        # `collection_element_type`, instead of hitting a bare `GorgetArray`
        # that `lower_for_vector` can't iterate. The runtime layout is the
        # same `GorgetArray` struct (resource_meta_for maps both), so the
        # push/extend/get/len calls and the C-emit assignment are unchanged.
        # Routed through the centralized `collection_accumulator_tid` helper
        # (one source of truth for collection-accumulator typing).
        int acc_tid = collection_accumulator_tid(&gmod, "array", out_elem_name, "", "")
        int acc = comp_make_acc(&ctx, acc_tid, out_elem_name, &gmod)
        String acc_name = "__hof_acc_" + int_to_str(acc)
        nl_put(&ctx, acc_name, acc)
        Vector[Stmt] body = []
        SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
        Vector[SpannedType] no_targs = []
        Vector[String] no_arg_names = []
        if mname == "map":
            # `acc.push(<closure body>)`
            Vector[CallArg] push_args = [pos_arg(cbody.clone())]
            SpannedExpr push_call = SpannedExpr(EMethodCall(Box(acc_ref), "push", push_args, no_targs), span)
            body.push(SExpr(push_call))
        else:
            # `if <closure body>: acc.push(<element>)`
            SpannedExpr elem_ref = SpannedExpr(EIdentifier(var_name), span)
            Vector[CallArg] push_args = [pos_arg(elem_ref)]
            SpannedExpr push_call = SpannedExpr(EMethodCall(Box(acc_ref), "push", push_args, no_targs), span)
            Vector[Stmt] then_body = [SExpr(push_call)]
            Vector[ElseBranch] no_elifs = []
            body.push(SIf(cbody.clone(), then_body, no_elifs))
        lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
        return acc
    # ── flat_map: concatenate the Vector the closure returns per element ──
    # `v.flat_map(f)` ≡ `acc = []; for x in v: acc.extend(f(x))`. Mirrors
    # Rust gg's `expand_flat_map` (src/bir/lower.rs:2297) — per element call
    # the closure (a Vector of the SAME element type, flat_map preserves the
    # element type) and append its elements into the accumulator via
    # `gorget_array_extend`. The synthesized `acc.extend(<closure body>)`
    # routes through the normal method dispatch (`extend` → gorget_array_extend,
    # lir_lower.gg:1559) — NOT the HOF intercept, since `extend` isn't a HOF.
    if mname == "flat_map":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
        # Centralized collection-accumulator typing (flat_map preserves the
        # element type — the closure returns a Vector of the same element).
        int acc_tid = collection_accumulator_tid(&gmod, "array", elem_name, "", "")
        int acc = comp_make_acc(&ctx, acc_tid, elem_name, &gmod)
        String acc_name = "__hof_acc_" + int_to_str(acc)
        nl_put(&ctx, acc_name, acc)
        SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
        Vector[SpannedType] no_targs = []
        Vector[String] no_arg_names = []
        # `acc.extend(<closure body>)` — the closure body is a Vector
        # expression; extend appends all its elements into acc.
        Vector[CallArg] ext_args = [pos_arg(cbody.clone())]
        SpannedExpr ext_call = SpannedExpr(EMethodCall(Box(acc_ref), "extend", ext_args, no_targs), span)
        Vector[Stmt] body = [SExpr(ext_call)]
        lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
        return acc
    # ── fold: seeded scalar accumulator threaded through the closure ──
    if mname == "fold":
        if margs.len() != 2:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(1).unwrap(), 2, &cparams, &cbody):
            return -1
        if cparams.len() != 2:
            return -1
        String acc_param = cparams.get(0).unwrap()
        String elem_param = cparams.get(1).unwrap()
        return lower_vector_fold(&ctx, recv, recv_type_name, margs.get(0).unwrap(), acc_param, elem_param, cbody, span, &gmod)
    # ── reduce: acc = first element, then thread the rest ────────────
    if mname == "reduce":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 2, &cparams, &cbody):
            return -1
        if cparams.len() != 2:
            return -1
        String acc_param = cparams.get(0).unwrap()
        String elem_param = cparams.get(1).unwrap()
        return lower_vector_reduce(&ctx, recv, recv_type_name, acc_param, elem_param, cbody, span, &gmod)
    # ── any / all: boolean short-circuit accumulator ─────────────────
    if mname == "any" or mname == "all":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        bool is_all = mname == "all"
        return lower_vector_any_all(&ctx, recv, recv_type_name, var_name, cbody, is_all, span, &gmod)
    # ── find / find_index: first-match Option accumulator ────────────
    # `v.find(p)`   → `for x in v: if p(x): acc = Some(x);   break` → Option[T]
    # `v.find_index(p)` → threads a 0-based counter, `Some(idx)` → Option[int].
    # Mirrors Rust gg's HofOp::Find / HofOp::FindIndex inline loop
    # (src/lir/lower/insts.rs). Without this the named-fn/closure arg falls
    # through to the broken extern dispatch (emits `gorget_array_new(arr,
    # closure)` — CC-FAIL "too many arguments").
    if mname == "find" or mname == "find_index":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        bool by_index = mname == "find_index"
        return lower_vector_find(&ctx, recv, recv_type_name, var_name, cbody, by_index, elem_name, span, &gmod)
    # ── each / for_each: side-effecting iteration, no result ─────────
    # `v.each((x): f(x))` / `v.for_each(f)` → `for x in v: f(x)`. Void HOF —
    # the closure body is emitted as a statement; the call expression yields
    # unit. `for_each` is the user-space-wrapper spelling (lib/std/iter.gg
    # `Vector.for_each[F]`); `each` is the builtin alias — both desugar the
    # same way, mirroring Rust gg's HofOp::Each.
    if mname == "each" or mname == "for_each":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
        Vector[Stmt] body = [SExpr(cbody.clone())]
        lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
        int unit_dst = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(unit_dst, OpConstUnit()))
        return unit_dst
    return -1

# ── Set/HashSet HOF inline-loop intercept ────────────────────────
# `s.fold/any/all/each/filter((closure))` has no userland `Set__T__method`
# body and no `gorget_*` runtime symbol — Rust gg desugars these inline at
# LIR (`try_emit_set_hof`, src/lir/lower/insts.rs:2862, op-set = SetEach /
# SetFold / SetAny / SetAll / SetFilter). Mirror that here by synthesizing a
# `for x in s:` loop over the run-proven `lower_for_set` iteration machinery,
# inlining the explicit closure body via AST substitution (the SAME strategy
# as `try_lower_vector_hof`). `is_ordered` is the TYPED CkOrderedSet/CkHashSet
# discriminator resolved by the caller — it threads into `lower_for_set` (the
# iteration walk) AND, for `filter`, picks the result set's ctor so the new
# set preserves the receiver's ordered-ness (Rust mints the result via
# `gorget_set_new_like`, mirroring src's hash/eq/order config; the self-host
# mirrors it via the ordered-vs-unordered ctor split).
#
# Result types mirror Rust's `try_emit_set_hof`: fold → value, any/all →
# bool, each → unit, filter → a fresh Set of the receiver's element type.
# `map`/`reduce`/`flat_map` are deliberately NOT here — Rust's Set op-set has
# no such variants (only Vector does), so they fall through to the normal
# extern dispatch, exactly as in Rust.
#
# Scope (per the Vector intercept): explicit NON-CAPTURING single-expression
# closures over scalar/String elements; anything else returns -1 → the caller
# falls through to the normal extern dispatch (no behavioural change).
#
# Returns the result local id (>= 0) when handled, or -1 to fall through.
int try_lower_set_hof(LowerCtx &ctx, int recv, String recv_type_name, bool is_ordered, String mname, Vector[SpannedExpr] margs, SpannedExpr sexpr, GirModule &gmod):
    Span span = sexpr.span
    String elem_name = collection_element_type(recv_type_name)
    if elem_name == "":
        return -1
    Vector[Stmt] no_else = []
    # ── filter: build a NEW Set of the same kind via an accumulator ──
    if mname == "filter":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
        # Result accumulator: a fresh Set typed with the receiver's
        # element-carrying name (so a CHAINED HOF re-resolves the element
        # type), built with the ordered-matching ctor. Centralized
        # accumulator typing (`collection_accumulator_tid` "set").
        int acc_tid = collection_accumulator_tid(&gmod, "set", elem_name, "", "")
        int acc = add_local(&ctx, acc_tid, None)
        Vector[Operand] new_args = [OpConstI64(8)]
        if is_ordered:
            emit(&ctx, GICallExtern(acc, "gorget_ordered_set_new", new_args))
        else:
            emit(&ctx, GICallExtern(acc, "gorget_set_new", new_args))
        register_local_for_drop(&ctx, acc, acc_tid, &gmod)
        String acc_name = "__set_hof_acc_" + int_to_str(acc)
        nl_put(&ctx, acc_name, acc)
        # Body: `if <closure body>: acc.add(<element>)`. The `.add` routes
        # through the normal method-call consume machinery (clone-at-boundary
        # for the still-live per-iteration element), mirroring the set-comp's
        # `comp_synth_set_body`.
        SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
        SpannedExpr elem_ref = SpannedExpr(EIdentifier(var_name), span)
        Vector[SpannedType] no_targs = []
        Vector[String] no_arg_names = []
        Vector[CallArg] add_args = [pos_arg(elem_ref)]
        SpannedExpr add_call = SpannedExpr(EMethodCall(Box(acc_ref), "add", add_args, no_targs), span)
        Vector[Stmt] then_body = [SExpr(add_call)]
        Vector[ElseBranch] no_elifs = []
        Vector[Stmt] body = [SIf(cbody.clone(), then_body, no_elifs)]
        lower_for_set(&ctx, var_pat, recv, recv_type_name, is_ordered, body, no_else, &gmod, false)
        return acc
    # ── fold: seeded scalar/resource accumulator threaded through the closure ──
    if mname == "fold":
        if margs.len() != 2:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(1).unwrap(), 2, &cparams, &cbody):
            return -1
        if cparams.len() != 2:
            return -1
        String acc_param = cparams.get(0).unwrap()
        String elem_param = cparams.get(1).unwrap()
        return lower_set_fold(&ctx, recv, recv_type_name, is_ordered, margs.get(0).unwrap(), acc_param, elem_param, cbody, span, &gmod)
    # ── any / all: boolean short-circuit accumulator ─────────────────
    if mname == "any" or mname == "all":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        bool is_all = mname == "all"
        return lower_set_any_all(&ctx, recv, recv_type_name, is_ordered, var_name, cbody, is_all, span, &gmod)
    # ── each: side-effecting iteration, no result ────────────────────
    if mname == "each":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 1, &cparams, &cbody):
            return -1
        if cparams.len() != 1:
            return -1
        String var_name = cparams.get(0).unwrap()
        SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
        Vector[Stmt] body = [SExpr(cbody.clone())]
        lower_for_set(&ctx, var_pat, recv, recv_type_name, is_ordered, body, no_else, &gmod, false)
        int unit_dst = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(unit_dst, OpConstUnit()))
        return unit_dst
    return -1

# `s.fold(init, (acc, x): body)` → `acc = init; for x in s: acc = body`.
# The accumulator is a scalar/resource local seeded with the lowered `init`,
# bound under the closure's FIRST param name so the closure body references
# it directly; the loop var carries the SECOND param name. Mirrors
# `lower_vector_fold` exactly, only swapping `lower_for_vector` for
# `lower_for_set` (which binds an OWNED per-iteration element + per-iter drop).
int lower_set_fold(LowerCtx &ctx, int recv, String recv_type_name, bool is_ordered, SpannedExpr init_expr, String acc_param, String elem_param, SpannedExpr cbody, Span span, GirModule &gmod):
    int init_local = lower_expr(&ctx, init_expr, &gmod)
    int acc_tid = ctx.locals.get(init_local).unwrap().type_id
    int acc = add_local(&ctx, acc_tid, None)
    # Seed via CkAssign (byte-copies a scalar init, move/clones a resource
    # init), NOT a raw OpCopy — same resource-safety reasoning as the vector
    # fold seed. Register for drop when droppable so the seed AND the
    # per-iteration `acc = body` reassigns are leak/UAF-correct.
    emit(&ctx, GIAssign(acc, op_consume(ctx, &gmod, init_local, CkAssign())))
    if is_droppable_type(acc_tid, &gmod):
        register_local_for_drop(&ctx, acc, acc_tid, &gmod)
    nl_put(&ctx, acc_param, acc)
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_param), span)
    Vector[Stmt] body = [SAssign(acc_lhs, cbody.clone())]
    SpannedPattern var_pat = SpannedPattern(PBinding(elem_param), span)
    Vector[Stmt] no_else = []
    lower_for_set(&ctx, var_pat, recv, recv_type_name, is_ordered, body, no_else, &gmod, false)
    return acc

# `s.any((x): p)` / `s.all((x): p)` → a boolean accumulator with early break.
# any: `acc = false; for x in s: if p: acc = true; break`.
# all: `acc = true;  for x in s: if not p: acc = false; break`.
# Mirrors `lower_vector_any_all`, swapping `lower_for_vector` for `lower_for_set`.
int lower_set_any_all(LowerCtx &ctx, int recv, String recv_type_name, bool is_ordered, String var_name, SpannedExpr cbody, bool is_all, Span span, GirModule &gmod):
    int acc = add_local(&ctx, BOOL_TYPE, None)
    if is_all:
        emit(&ctx, GIAssign(acc, OpConstBool(true)))
    else:
        emit(&ctx, GIAssign(acc, OpConstBool(false)))
    String acc_name = "__set_hof_pred_acc_" + int_to_str(acc)
    nl_put(&ctx, acc_name, acc)
    SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
    SpannedExpr guard = cbody.clone()
    if is_all:
        guard = SpannedExpr(EUnaryOp("not", Box(cbody.clone())), span)
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_name), span)
    SpannedExpr setval = SpannedExpr(EBoolLiteral(not is_all), span)
    Vector[Stmt] then_body = [SAssign(acc_lhs, setval), SBreak()]
    Vector[ElseBranch] no_elifs = []
    Vector[Stmt] body = [SIf(guard, then_body, no_elifs)]
    Vector[Stmt] no_else = []
    lower_for_set(&ctx, var_pat, recv, recv_type_name, is_ordered, body, no_else, &gmod, false)
    return acc

# Extract an explicit non-capturing closure's parameter names and its
# single result expression from `EClosure(params, body)`. Supports the two
# in-scope body shapes: an inline expression body (`[SExpr(e)]`) and a
# block whose tail is `return e` or a bare expression `[…, SExpr(e)]`.
# A multi-statement body with non-trivial leading stmts, or any other
# closure form (implicit `it`, no usable tail expr), returns false → the
# caller falls through. Writes the param names into `out_params` and the
# result expression into `out_body` (cloned), returning true on success.
bool closure_extract(SpannedExpr arg, Vector[String] &out_params, SpannedExpr &out_body):
    match arg.expr:
        case EClosure(params, cbody):
            # Only single-statement bodies are in scope: an inline
            # expression closure parses to exactly `[SExpr(e)]`, and the
            # multi-line `return e` form to `[SReturn(Some(e))]`. A longer
            # body (locals, control flow) is out of scope — fall through.
            if cbody.len() != 1:
                return false
            int pi = 0
            while pi < params.len():
                out_params.push(params.get(pi).unwrap().param_name)
                pi += 1
            match cbody.get(0).unwrap():
                case SExpr(e):
                    out_body = e.clone()
                    return true
                case SReturn(ret_opt):
                    match ret_opt:
                        case Some(re):
                            out_body = re.clone()
                            return true
                        case None:
                            return false
                else:
                    return false
        else:
            return false

# Extract a HOF closure body OR synthesize a wrapper for a non-closure-literal
# CALLABLE arg (a named function like `v.map(double)`, or a callable-valued
# local). `closure_extract` only matches `EClosure` literals, so `map(double)`
# — where the arg is `EIdentifier("double")` — would fall through to the
# undefined `Vector__T__map` monomorph. Instead synthesize a wrapper closure
# `(p0, ..., p{arity-1}): arg(p0, ..., p{arity-1})` with fresh param names, so
# the SAME inline-loop machinery lowers it exactly like a closure literal. The
# synthesized `arg(p...)` ECall routes through normal dispatch, handling named
# functions AND callable-valued locals uniformly (Rust gg wraps named fns in an
# `__adapt_*` thunk; the self-host inlines the call directly). `arity` is fixed
# by the HOF at each call site (map/filter/any/all/each/flat_map = 1; Vector/Set
# fold, reduce, Dict filter = 2; Dict fold = 3) — read from that site's own
# trailing `cparams.len()` check.
bool extract_hof_closure(SpannedExpr arg, int arity, Vector[String] &out_params, SpannedExpr &out_body):
    if closure_extract(arg.clone(), &out_params, &out_body):
        return true
    Vector[CallArg] call_args = []
    int i = 0
    while i < arity:
        String pn = "__hofp" + int_to_str(i)
        out_params.push(pn)
        call_args.push(pos_arg(SpannedExpr(EIdentifier(pn), arg.span)))
        i += 1
    Vector[String] no_names = []
    Vector[SpannedType] no_targs = []
    out_body = SpannedExpr(ECall(Box(arg), call_args, no_targs), arg.span)
    return true

# `fold(init, (acc, x): body)` → `acc = init; for x in v: acc = body`.
# The accumulator is a scalar local seeded with the lowered `init`,
# bound under the closure's FIRST param name so the closure body
# references it directly; the loop var carries the SECOND param name.
int lower_vector_fold(LowerCtx &ctx, int recv, String recv_type_name, SpannedExpr init_expr, String acc_param, String elem_param, SpannedExpr cbody, Span span, GirModule &gmod):
    # Seed the accumulator with the lowered init value. The accumulator
    # type follows the init's type (fold's result type = the acc type).
    int init_local = lower_expr(&ctx, init_expr, &gmod)
    int acc_tid = ctx.locals.get(init_local).unwrap().type_id
    int acc = add_local(&ctx, acc_tid, None)
    # Seed via the consume machinery (CkAssign), NOT a raw OpCopy: a raw
    # OpCopy of a resource init (`fold("", …)` — a GorgetString) trips
    # `validate_resource_moves` (no resource may be byte-copied). CkAssign
    # byte-copies a scalar init and move/clones a resource init, mirroring a
    # resource VarDecl seed. Register the acc for drop when its type is
    # droppable so the seed AND the per-iteration `acc = body` reassigns
    # (which the SAssign path drop-on-overwrites) are leak/UAF-correct.
    emit(&ctx, GIAssign(acc, op_consume(ctx, &gmod, init_local, CkAssign())))
    if is_droppable_type(acc_tid, &gmod):
        register_local_for_drop(&ctx, acc, acc_tid, &gmod)
    nl_put(&ctx, acc_param, acc)
    # Body: `acc = <closure body>` — a reassign of the accumulator local.
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_param), span)
    Vector[Stmt] body = [SAssign(acc_lhs, cbody.clone())]
    SpannedPattern var_pat = SpannedPattern(PBinding(elem_param), span)
    lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
    return acc

# `reduce((a, b): body)` → seed the accumulator from the FIRST element,
# then thread the rest. To reuse the run-proven `lower_for_vector` (which
# always starts at index 0) instead of re-emitting the loop scaffold, the
# first-vs-rest split is a `seen` boolean inside the body:
#   acc = <placeholder>; seen = false
#   for x in v:
#       if not seen: acc = x; seen = true
#       else:        acc = body(acc, x)
# The accumulator carries the closure's first param name and the loop var
# its second, so the closure body references both directly. Scalar-element
# only (the placeholder seed is `0`/false-overwritten on the first
# iteration); aggregate reduce is out of scope and never reaches here.
int lower_vector_reduce(LowerCtx &ctx, int recv, String recv_type_name, String acc_param, String elem_param, SpannedExpr cbody, Span span, GirModule &gmod):
    # Accumulator: scalar slot seeded with a placeholder (overwritten on
    # the first iteration). Reduce on an empty Vector is UB in the source
    # language (Rust gg panics), matching this placeholder-leak behaviour.
    int acc = add_local(&ctx, I64_TYPE, None)
    emit(&ctx, GIAssign(acc, OpConstI64(0)))
    nl_put(&ctx, acc_param, acc)
    int seen = add_local(&ctx, BOOL_TYPE, None)
    emit(&ctx, GIAssign(seen, OpConstBool(false)))
    String seen_name = "__hof_seen_" + int_to_str(seen)
    nl_put(&ctx, seen_name, seen)
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_param), span)
    SpannedExpr elem_ref = SpannedExpr(EIdentifier(elem_param), span)
    SpannedExpr seen_lhs = SpannedExpr(EIdentifier(seen_name), span)
    # then (first element): `acc = x; seen = true`
    Vector[Stmt] first_body = [SAssign(acc_lhs.clone(), elem_ref), SAssign(seen_lhs, SpannedExpr(EBoolLiteral(true), span))]
    # else (subsequent): `acc = body(acc, x)`
    Vector[Stmt] rest_body = [SAssign(acc_lhs.clone(), cbody.clone())]
    SpannedExpr seen_cond = SpannedExpr(EUnaryOp("not", Box(SpannedExpr(EIdentifier(seen_name), span))), span)
    Vector[ElseBranch] else_arms = [ElseBranch(None, rest_body)]
    Vector[Stmt] body = [SIf(seen_cond, first_body, else_arms)]
    SpannedPattern var_pat = SpannedPattern(PBinding(elem_param), span)
    lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
    return acc

# `any((x): p)` / `all((x): p)` → a boolean accumulator with early break.
# any: `acc = false; for x in v: if p: acc = true; break`.
# all: `acc = true;  for x in v: if not p: acc = false; break`.
# The predicate is the closure body; the loop var carries the closure's
# param name so the body references it directly.
int lower_vector_any_all(LowerCtx &ctx, int recv, String recv_type_name, String var_name, SpannedExpr cbody, bool is_all, Span span, GirModule &gmod):
    int acc = add_local(&ctx, BOOL_TYPE, None)
    if is_all:
        emit(&ctx, GIAssign(acc, OpConstBool(true)))
    else:
        emit(&ctx, GIAssign(acc, OpConstBool(false)))
    nl_put(&ctx, "__hof_pred_acc_" + int_to_str(acc), acc)
    String acc_name = "__hof_pred_acc_" + int_to_str(acc)
    SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
    # Guard expression: `p` for any, `not p` for all.
    SpannedExpr guard = cbody.clone()
    if is_all:
        guard = SpannedExpr(EUnaryOp("not", Box(cbody.clone())), span)
    # then-body: `acc = <bool>; break`.
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_name), span)
    SpannedExpr setval = SpannedExpr(EBoolLiteral(not is_all), span)
    Vector[Stmt] then_body = [SAssign(acc_lhs, setval), SBreak()]
    Vector[ElseBranch] no_elifs = []
    Vector[Stmt] body = [SIf(guard, then_body, no_elifs)]
    lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
    return acc

# `find((x): p)` / `find_index((x): p)` → a first-match Option accumulator
# with early break. `find` yields `Option[T]` (the element); `find_index`
# yields `Option[int]` (the 0-based position, threaded via a self-managed
# counter). The accumulator is seeded with a typed `None` (routed through the
# `None` ctor → LIR `IEnumInit(tag=1)`) and reassigned to `Some(<x|idx>)` on
# the first match. Mirrors `lower_vector_any_all` (same early-break shape) but
# with an Option result. The `Some(...)` construction routes through the
# SAssign consume machinery: the acc local's Option type drives the
# expected-type adoption (`try_lower_prelude_variant` → `IEnumInit(tag=0)`).
int lower_vector_find(LowerCtx &ctx, int recv, String recv_type_name, String var_name, SpannedExpr cbody, bool by_index, String elem_name, Span span, GirModule &gmod):
    # Accumulator: Option[elem] (find) / Option[int] (find_index).
    String opt_inner = elem_name
    if by_index:
        opt_inner = "int64_t"
    int inner_tid = resolve_elem_type_id(opt_inner, &gmod)
    int acc_tid = lookup_or_register_named(&gmod, "Option__" + opt_inner)
    record_enum_category(&gmod, acc_tid, ENUM_CAT_OPTION, inner_tid, -1)
    int acc = add_local(&ctx, acc_tid, None)
    Vector[Operand] none_args = []
    emit(&ctx, GICallExtern(acc, "None", none_args))
    if is_droppable_type(acc_tid, &gmod):
        register_local_for_drop(&ctx, acc, acc_tid, &gmod)
    String acc_name = "__hof_find_acc_" + int_to_str(acc)
    nl_put(&ctx, acc_name, acc)
    # 0-based match-position counter (find_index only, but harmless for find).
    int idxc = add_local(&ctx, I64_TYPE, None)
    emit(&ctx, GIAssign(idxc, OpConstI64(0)))
    String idxc_name = "__hof_find_idx_" + int_to_str(idxc)
    nl_put(&ctx, idxc_name, idxc)
    SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
    # then-body: `acc = Some(<x | idx>); break`.
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_name), span)
    SpannedExpr some_arg = SpannedExpr(EIdentifier(var_name), span)
    if by_index:
        some_arg = SpannedExpr(EIdentifier(idxc_name), span)
    Vector[CallArg] some_args = [pos_arg(some_arg)]
    Vector[String] no_names = []
    Vector[SpannedType] no_targs = []
    SpannedExpr some_callee = SpannedExpr(EIdentifier("Some"), span)
    SpannedExpr some_call = SpannedExpr(ECall(Box(some_callee), some_args, no_targs), span)
    Vector[Stmt] then_body = [SAssign(acc_lhs, some_call), SBreak()]
    Vector[ElseBranch] no_elifs = []
    Vector[Stmt] body = [SIf(cbody.clone(), then_body, no_elifs)]
    # Advance the position counter each iteration (after the check, so a
    # 0th-element match records index 0).
    SpannedExpr idxc_lhs = SpannedExpr(EIdentifier(idxc_name), span)
    body.push(SCompoundAssign(idxc_lhs, "+", SpannedExpr(EIntLiteral(1), span)))
    lower_for_vector(&ctx, var_pat, recv, recv_type_name, false, false, body, &gmod, false)
    return acc

# ── Dict/HashMap HOF inline-loop intercept ───────────────────
# `d.fold(init, (acc, k, v): body)` desugars to an accumulator threaded
# through a `for k, v in d:` loop, reusing `lower_for_dict` (which binds
# OWNED k/v copies + handles the slot-state filter and per-iteration drop).
# Mirrors Rust gg's `try_emit_dict_hof` (HofOp::DictFold, src/lir/lower/
# insts.rs:2436) at a higher level — the SAME AST-rewrite strategy the
# Vector HOF intercept uses (`try_lower_vector_hof` / `lower_vector_fold`).
# Returns -1 (fall through to the normal extern dispatch) when the method
# isn't an inlinable Dict HOF or the closure arg isn't an explicit
# non-capturing form.
int try_lower_dict_hof(LowerCtx &ctx, int recv, String recv_type_name, String mname, Vector[SpannedExpr] margs, SpannedExpr sexpr, GirModule &gmod):
    Span span = sexpr.span
    # ── fold: seeded accumulator threaded through `(acc, k, v)` ──
    if mname == "fold":
        if margs.len() != 2:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(1).unwrap(), 3, &cparams, &cbody):
            return -1
        if cparams.len() != 3:
            return -1
        String acc_param = cparams.get(0).unwrap()
        String key_param = cparams.get(1).unwrap()
        String val_param = cparams.get(2).unwrap()
        return lower_dict_fold(&ctx, recv, recv_type_name, margs.get(0).unwrap(), acc_param, key_param, val_param, cbody, span, &gmod)
    # ── filter: build a NEW Dict/HashMap of the same K/V via an accumulator ──
    # `d.filter((k, v): pred)` → `acc = {}; for k, v in d: if pred: acc[k] = v`.
    # The k/v mirror of the Set-HOF filter arm (`try_lower_set_hof`): a fresh
    # map shaped EXACTLY like the receiver, an `if pred: acc[k] = v` body routed
    # through `lower_for_dict` (binds OWNED per-iteration k/v copies). The
    # `acc[k] = v` index-assign routes through `lower_index_assign` →
    # `gorget_map_put` (the NO-CLONE owning mutator), so the still-live
    # per-iteration k/v are clone-at-boundary'd by that path. Mirrors Rust gg's
    # `try_emit_dict_hof` ("filter" => DictFilter, src/lir/lower/insts.rs),
    # which builds the result via `gorget_map_new_like` — result = a fresh Dict
    # of the receiver's K/V.
    if mname == "filter":
        if margs.len() != 1:
            return -1
        Vector[String] cparams = []
        SpannedExpr cbody = sexpr
        if not extract_hof_closure(margs.get(0).unwrap(), 2, &cparams, &cbody):
            return -1
        if cparams.len() != 2:
            return -1
        String key_param = cparams.get(0).unwrap()
        String val_param = cparams.get(1).unwrap()
        # Result accumulator: a fresh map shaped like the RECEIVER via the
        # runtime `gorget_map_new_like(&recv)` helper (the k/v mirror of the
        # set ops' `gorget_set_new_like`, emitted in lir_codegen.gg). It reads
        # `__src->order` at RUNTIME to pick `gorget_dict_new` (ordered) vs
        # `gorget_map_new` (unordered) and copies the receiver's key/value
        # size + hash/eq/drop/clone fn-ptrs — so the ordered-ness and the
        # resource-value drop wiring are preserved with NO compile-time
        # name-prefix classification (CLAUDE.md rule #2: ordered-ness is NOT
        # carried in the typed CollectionKind for maps — both Dict and HashMap
        # are CkDict — so the only honest source is the receiver's own runtime
        # `order` field). Mirrors Rust gg's `try_emit_dict_hof` DictFilter
        # ctor. The accumulator LOCAL is typed the receiver's own (value-
        # carrying) type id, so a CHAINED HOF / downstream `acc[k]` read
        # re-resolves K/V from the name, exactly like the receiver.
        int df_acc_tid = ctx.locals.get(recv).unwrap().type_id
        int df_acc = add_local(&ctx, df_acc_tid, None)
        Vector[Operand] df_ctor_args = [OpBorrow(recv)]
        emit(&ctx, GICallExtern(df_acc, "gorget_map_new_like", df_ctor_args))
        # Register at birth (Core invariant #3 — no leak).
        register_local_for_drop(&ctx, df_acc, df_acc_tid, &gmod)
        String df_acc_name = "__dict_hof_acc_" + int_to_str(df_acc)
        nl_put(&ctx, df_acc_name, df_acc)
        # Body: `if <closure body>: acc[k] = v`. The index-assign routes
        # through `lower_index_assign` → `gorget_map_put` (clone-at-boundary
        # for the still-live per-iteration k/v).
        SpannedExpr df_acc_ref = SpannedExpr(EIdentifier(df_acc_name), span)
        SpannedExpr df_key_ref = SpannedExpr(EIdentifier(key_param), span)
        SpannedExpr df_val_ref = SpannedExpr(EIdentifier(val_param), span)
        SpannedExpr df_index = SpannedExpr(EIndex(Box(df_acc_ref), Box(df_key_ref)), span)
        Vector[Stmt] df_then = [SAssign(df_index, df_val_ref)]
        Vector[ElseBranch] df_no_elifs = []
        Vector[Stmt] df_body = [SIf(cbody.clone(), df_then, df_no_elifs)]
        SpannedPattern df_k_pat = SpannedPattern(PBinding(key_param), span)
        SpannedPattern df_v_pat = SpannedPattern(PBinding(val_param), span)
        Vector[SpannedPattern] df_kv_parts = [df_k_pat, df_v_pat]
        SpannedPattern df_kv_pat = SpannedPattern(PTuple(df_kv_parts), span)
        lower_for_dict(&ctx, df_kv_pat, recv, recv_type_name, df_body, &gmod, false)
        return df_acc
    return -1

# `d.fold(init, (acc, k, v): body)` →
#   acc = init
#   for k, v in d: acc = body
# The accumulator is a scalar/resource local seeded with the lowered `init`
# (via the consume machinery — clone/move-at-boundary, drop-registered when
# droppable), bound under the closure's FIRST param name so the body
# references it directly. The closure's 2nd/3rd params carry the iteration
# key/value names — fed to `lower_for_dict` as a 2-tuple binding pattern.
# Exact mirror of `lower_vector_fold` on the Dict k/v axis.
int lower_dict_fold(LowerCtx &ctx, int recv, String recv_type_name, SpannedExpr init_expr, String acc_param, String key_param, String val_param, SpannedExpr cbody, Span span, GirModule &gmod):
    # Seed the accumulator with the lowered init value. The accumulator type
    # follows the init's type (fold's result type = the acc type). CkAssign
    # byte-copies a scalar init and move/clones a resource init (a raw OpCopy
    # of a resource init would trip validate_resource_moves) — same seed shape
    # as lower_vector_fold.
    int init_local = lower_expr(&ctx, init_expr, &gmod)
    int acc_tid = ctx.locals.get(init_local).unwrap().type_id
    int acc = add_local(&ctx, acc_tid, None)
    emit(&ctx, GIAssign(acc, op_consume(ctx, &gmod, init_local, CkAssign())))
    if is_droppable_type(acc_tid, &gmod):
        register_local_for_drop(&ctx, acc, acc_tid, &gmod)
    nl_put(&ctx, acc_param, acc)
    # Body: `acc = <closure body>`. The (k, v) tuple binding makes the closure's
    # key/value params available; lower_for_dict binds them as OWNED locals.
    SpannedExpr acc_lhs = SpannedExpr(EIdentifier(acc_param), span)
    Vector[Stmt] body = [SAssign(acc_lhs, cbody.clone())]
    SpannedPattern k_pat = SpannedPattern(PBinding(key_param), span)
    SpannedPattern v_pat = SpannedPattern(PBinding(val_param), span)
    Vector[SpannedPattern] kv_parts = [k_pat, v_pat]
    SpannedPattern kv_pat = SpannedPattern(PTuple(kv_parts), span)
    lower_for_dict(&ctx, kv_pat, recv, recv_type_name, body, &gmod, false)
    return acc

# ── List comprehension lowering ──────────────────────────
# `[comp_expr for var in iterable if filter]` → a loop that builds an
# array accumulator. Mirrors Rust `lower_list_comprehension`
# (src/ir/lowering/exprs/collections.rs:509), but reuses the self-host's
# existing run-proven `lower_for_*` loop machinery instead of re-emitting
# the loop scaffold: synthesize an `acc.push(comp_expr)` body (wrapped in
# `if filter:` for the filtered variant) and route it through
# `lower_for_string` (String base — single UTF-8 codepoint pass, matches
# `for c in s:` semantics), `lower_for_range` (both-bounded `start..end`),
# or `lower_for_vector` (general indexed collection). All three already
# handle the loop var binding, the borrow-alias element read, and the
# per-iteration drop scope — so the only new emit is the accumulator
# alloc + the synthesized push.
#
# The accumulator for the String base is typed as the mangled
# `Vector__GorgetString` (Rust's `ensure_collection_type` precedent): the
# typechecker returns error for comprehensions, so the GIR acc type ALONE
# carries the element story for the push consume-clone machinery, drops,
# and downstream element inference. The codepoint view (`ch`) is a cap=0
# borrow alias; the synthesized `acc.push(ch)` clones it at the ownership
# boundary via the normal method-call consume machinery (run-proven by
# the `for c in s: stack.push(c)` idiom).
int lower_list_comprehension(LowerCtx &ctx, SpannedExpr comp_expr, String var_name, SpannedExpr iterable, Option[Box[SpannedExpr]] filt_opt, GirModule &gmod):
    Span span = comp_expr.span
    # ── RANGE base: `[x for x in start..end]` / `[x for x in start..=end]`.
    # The ERange's inclusive flag (`rng_incl`) threads into `lower_for_range`,
    # which picks `<=` vs `<`. Mirrors collections.rs:520.
    match iterable.expr:
        case ERange(start_opt, end_opt, rng_incl):
            match start_opt:
                case Some(start_box):
                    match end_opt:
                        case Some(end_box):
                            # Range elements are scalar I64 (the loop var is
                            # I64); the comp body is overwhelmingly int-typed,
                            # so the result element type is `int64_t`. Type the
                            # accumulator LOCAL with the element-carrying
                            # `Vector__int64_t` (via the centralized helper) —
                            # NOT a bare GorgetArray. Otherwise `auto v = [x*x
                            # for x in 0..5]` decays `v` to a bare GorgetArray
                            # and a downstream `v[i]` / `for e in v` can't
                            # recover the element type (the read stubs / the
                            # iteration finds no element shape). The runtime
                            # alloc stays the 8-byte sized-int form, layout-
                            # identical to before. (A range comp whose body
                            # changes the element type, e.g. `[float(x) for x
                            # in 0..n]`, is a known edge — same scalar-8-byte
                            # limitation the Rust gg range-comp accumulator has,
                            # collections.rs:520. The element type is recovered
                            # from a TYPED VarDecl when one is present.)
                            int racc_tid = collection_accumulator_tid(&gmod, "array", "int64_t", "", "")
                            int racc = comp_make_acc(&ctx, racc_tid, "int64_t", &gmod)
                            String racc_name = "__listcomp_acc_" + int_to_str(racc)
                            nl_put(&ctx, racc_name, racc)
                            Vector[Stmt] rbody = comp_synth_body(racc_name, comp_expr, filt_opt, span)
                            lower_for_range(&ctx, var_name, *start_box, *end_box, rng_incl, rbody, Vector[Stmt](), &gmod, false)
                            return racc
                        case None:
                            pass
                case None:
                    pass
        else:
            pass
    # Lower the iterable once; clear any leaked expected_type (the iterable
    # is collection-typed, not the surrounding context).
    # Track 1A: strip a `for x in &coll` wrapper off the iterable via the SHARED
    # iterable-mode helper (the same one `lower_for` uses — Core #4). The self-host
    # reads `&a` correctly either way, but routing the strip through the one helper
    # keeps the comprehension from drifting from the loop. Element write-through
    # inside a comprehension is DEFERRED, so the flag is discarded and
    # lower_for_vector is called with write_through=false.
    bool comp_write_through = false
    SpannedExpr comp_iter = for_iterable_mode(iterable, &comp_write_through)
    int saved_et = ctx.expected_type
    ctx.expected_type = -1
    int coll_local = lower_expr(&ctx, comp_iter, &gmod)
    ctx.expected_type = saved_et
    coll_local = maybe_auto_propagate(&ctx, coll_local, &gmod)
    String coll_tn = local_type_name(coll_local, ctx, &gmod)
    SpannedPattern var_pat = SpannedPattern(PBinding(var_name), span)
    # ── STRING base: `[c for c in s]` — UTF-8 codepoint pass via
    # `lower_for_string`. Accumulator typed `Vector__GorgetString` so the
    # synthesized push clones the cap=0 codepoint view at the boundary.
    if coll_tn == "GorgetString":
        int sacc_tid = collection_accumulator_tid(&gmod, "array", "GorgetString", "", "")
        int sacc = comp_make_acc(&ctx, sacc_tid, "GorgetString", &gmod)
        String sacc_name = "__listcomp_acc_" + int_to_str(sacc)
        nl_put(&ctx, sacc_name, sacc)
        Vector[Stmt] sbody = comp_synth_body(sacc_name, comp_expr, filt_opt, span)
        # String list-comprehension `[c for c in s]` is never enumerate (a bare
        # PBinding loop var) — pass is_enumerate=false.
        lower_for_string(&ctx, var_pat, coll_local, false, sbody, &gmod, false)
        return sacc
    # ── VECTOR base: idx-walk via `lower_for_vector`. Accumulator element
    # type recovered from the SOURCE collection name (the element-preserving
    # common case — `[x for x in v]`, `[x*2 for x in v]`); a body that
    # changes the element type recovers it from a TYPED VarDecl when present.
    # Type the accumulator LOCAL with the element-carrying `Vector__<elem>`
    # (via the centralized helper) — NOT a bare GorgetArray — so an
    # auto-bound result is self-describing for a downstream `v[i]` / `for x
    # in v`. The sized alloc (driven by `elem_name`) clones correctly at the
    # push boundary, unchanged.
    String elem_name = collection_element_type(coll_tn)
    int vacc_tid = collection_accumulator_tid(&gmod, "array", elem_name, "", "")
    int vacc = comp_make_acc(&ctx, vacc_tid, elem_name, &gmod)
    String vacc_name = "__listcomp_acc_" + int_to_str(vacc)
    nl_put(&ctx, vacc_name, vacc)
    Vector[Stmt] vbody = comp_synth_body(vacc_name, comp_expr, filt_opt, span)
    lower_for_vector(&ctx, var_pat, coll_local, coll_tn, false, false, vbody, &gmod, false)
    return vacc

# Allocate a comprehension accumulator array. When `elem_tyname` names a
# concrete element type, emit the `__gorget_array_new_sized_<T>` magic (it
# expands at C-emit to gorget_array_new(sizeof(T)) + the T
# elem_drop/elem_clone/elem_materialize fn-ptr registration, exactly like
# the typed EArrayLiteral path) so non-scalar elements (e.g. GorgetString
# codepoint views) are sized, freed, and cloned correctly. An empty name
# falls back to the scalar `gorget_array_new(8)`.
int comp_make_acc(LowerCtx &ctx, int acc_tid, String elem_tyname, GirModule &gmod):
    int acc_local = add_local(&ctx, acc_tid, None)
    if elem_tyname != "":
        Vector[Operand] an_args = []
        emit(&ctx, GICallExtern(acc_local, "__gorget_array_new_sized_" + elem_tyname, an_args))
    else:
        Vector[Operand] an_args = [OpConstI64(8)]
        emit(&ctx, GICallExtern(acc_local, "gorget_array_new", an_args))
    register_local_for_drop(&ctx, acc_local, acc_tid, &gmod)
    return acc_local

# Synthesize the loop body `[if filter:] acc.push(comp_expr)` referencing
# the accumulator through `EIdentifier(acc_name)`. The push routes through
# the normal method-call consume machinery (clone-at-boundary for live /
# borrowed sources). For the filtered variant the push is guarded by an
# `if filter:` — `lower_for_*` rejoins the body to the position-advance, so
# a filtered-out element never skips the loop's increment.
Vector[Stmt] comp_synth_body(String acc_name, SpannedExpr comp_expr, Option[Box[SpannedExpr]] filt_opt, Span span):
    SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
    Vector[CallArg] push_args = [pos_arg(comp_expr.clone())]
    Vector[SpannedType] no_targs = []
    Vector[String] no_arg_names = []
    SpannedExpr push_call = SpannedExpr(EMethodCall(Box(acc_ref), "push", push_args, no_targs), span)
    Stmt push_stmt = SExpr(push_call)
    Vector[Stmt] body = []
    match filt_opt:
        case Some(filt_box):
            Vector[Stmt] then_body = [push_stmt]
            Vector[ElseBranch] no_elifs = []
            SpannedExpr filt_expr = (*filt_box).clone()
            Stmt if_stmt = SIf(filt_expr, then_body, no_elifs)
            body.push(if_stmt)
        case None:
            body.push(push_stmt)
    return body

# ── Set comprehension lowering ───────────────────────────
# `{comp_expr for var in iterable [if filter]}` → a loop that builds a
# `Set__int64_t`-typed accumulator. Same philosophy as
# `lower_list_comprehension`: synthesize an `acc.add(comp_expr)` body
# (wrapped in `if filter:` for the filtered variant) and route it through
# the run-proven `lower_for_range` loop machinery. The destination VarDecl
# lowers to a `Set__int64_t` LOCAL, so the accumulator is typed with that
# same MANGLED element-carrying name (NOT the raw `GorgetSet`): the
# mangled name carries the element metadata `resource_meta_for`/
# `coll_elem_type_map` need (it routes to the `GorgetSet` runtime category
# in `lir_lower.gg`) AND makes the comprehension result type match the
# destination at the CoW/assignment boundary. This deliberately DIVERGES
# from Rust's raw-`GorgetSet` set-comp shape (collections.rs:872), which
# is correct for Rust but not for the self-host's mangled-name CoW layer.
#
# Range-only is sufficient (both corpus fixtures iterate `start..end`);
# non-range falls back to Unit, the SAME as Rust (collections.rs:932).
int lower_set_comprehension(LowerCtx &ctx, SpannedExpr comp_expr, String var_name, SpannedExpr iterable, Option[Box[SpannedExpr]] filt_opt, GirModule &gmod):
    Span span = comp_expr.span
    match iterable.expr:
        case ERange(start_opt, end_opt, rng_incl):
            match start_opt:
                case Some(start_box):
                    match end_opt:
                        case Some(end_box):
                            int sacc = comp_make_set_acc(&ctx, &gmod)
                            String sacc_name = "__setcomp_acc_" + int_to_str(sacc)
                            nl_put(&ctx, sacc_name, sacc)
                            Vector[Stmt] sbody = comp_synth_set_body(sacc_name, comp_expr, filt_opt, span)
                            lower_for_range(&ctx, var_name, *start_box, *end_box, rng_incl, sbody, Vector[Stmt](), &gmod, false)
                            return sacc
                        case None:
                            pass
                case None:
                    pass
        else:
            pass
    # Non-range base: fall back to Unit, matching Rust (collections.rs:932).
    int sfallback = add_local(&ctx, UNIT_TYPE, None)
    emit(&ctx, GIAssign(sfallback, OpConstUnit()))
    return sfallback

# Allocate a set comprehension accumulator. Typed as the MANGLED
# `Set__int64_t` (8-byte int elements) so it matches the destination at
# the CoW boundary and routes to the `GorgetSet` runtime category. Do NOT
# reuse `comp_make_acc` — that hardcodes a `gorget_array_new`/sized-array
# alloc (a 64-byte GorgetArray), which downstream code would treat as a
# GorgetSet → heap corruption. Emit `gorget_set_new` directly with an
# `OpConstI64(8)` element-size arg (mirror Rust collections.rs:884-888).
int comp_make_set_acc(LowerCtx &ctx, GirModule &gmod):
    # Centralized collection-accumulator typing — Set comprehensions iterate
    # `start..end`, so the element is scalar `int64_t` (`Set__int64_t`).
    int acc_tid = collection_accumulator_tid(&gmod, "set", "int64_t", "", "")
    int acc_local = add_local(&ctx, acc_tid, None)
    Vector[Operand] sn_args = [OpConstI64(8)]
    # The accumulator type (`Set__int64_t`) is the ORDERED kind (a `Set[T]`
    # comprehension preserves insertion order). Drive the ctor fn from the
    # TYPED `collection_kind` of acc_tid so the runtime alloc matches the
    # declared kind — emitting the unordered `gorget_set_new` for an ordered
    # `Set__` accumulator was a latent type/runtime mismatch (the typedef said
    # ordered, the alloc was unordered).
    String acc_tn = type_id_to_name(acc_tid, &gmod)
    bool acc_ordered = false
    match resource_meta_for(&gmod, acc_tn):
        case Some(acc_rmeta):
            match acc_rmeta.collection_kind:
                case CkOrderedSet():
                    acc_ordered = true
                else:
                    pass
        case None:
            pass
    if acc_ordered:
        emit(&ctx, GICallExtern(acc_local, "gorget_ordered_set_new", sn_args))
    else:
        emit(&ctx, GICallExtern(acc_local, "gorget_set_new", sn_args))
    register_local_for_drop(&ctx, acc_local, acc_tid, &gmod)
    return acc_local

# Synthesize the set-comp loop body `[if filter:] acc.add(comp_expr)`.
# Identical shape to `comp_synth_body` but emits `.add` (the set inserter)
# instead of `.push`. `comp_expr` is passed DIRECTLY (a `SpannedExpr`
# param) — never threaded through a `Vector[SpannedExpr]` PARAM, which the
# self-host miscompiles when the element type carries a `Box` (logged in
# TODO). For the filtered variant the `.add` is guarded by `if filter:` so
# a filtered-out element never skips the loop's position-advance.
Vector[Stmt] comp_synth_set_body(String acc_name, SpannedExpr comp_expr, Option[Box[SpannedExpr]] filt_opt, Span span):
    SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
    Vector[CallArg] add_args = [pos_arg(comp_expr.clone())]
    Vector[SpannedType] no_targs = []
    Vector[String] no_arg_names = []
    SpannedExpr add_call = SpannedExpr(EMethodCall(Box(acc_ref), "add", add_args, no_targs), span)
    Stmt add_stmt = SExpr(add_call)
    Vector[Stmt] body = []
    match filt_opt:
        case Some(filt_box):
            Vector[Stmt] then_body = [add_stmt]
            Vector[ElseBranch] no_elifs = []
            SpannedExpr filt_expr = (*filt_box).clone()
            Stmt if_stmt = SIf(filt_expr, then_body, no_elifs)
            body.push(if_stmt)
        case None:
            body.push(add_stmt)
    return body

# ── Dict comprehension lowering ──────────────────────────
# `{key_expr: val_expr for var in iterable [if filter]}` → a loop that
# builds a `Dict__int64_t__int64_t`-typed accumulator. Same philosophy as
# the list and set comps; the optional filter (`EDictComp` 5th AST field)
# threads through to the synth body, guarding the `.put` with `if filter:`.
# The accumulator is typed with the MANGLED `Dict__int64_t__int64_t` name
# (matching the destination VarDecl at the CoW boundary + routing to the
# `GorgetMap` runtime category). Rust's dict-comp ALSO mangles
# (collections.rs:812), so only the SET channel diverges from Rust.
# Range-only; non-range → Unit (Rust collections.rs:863).
int lower_dict_comprehension(LowerCtx &ctx, SpannedExpr key_expr, SpannedExpr val_expr, String var_name, SpannedExpr iterable, Option[Box[SpannedExpr]] filt_opt, GirModule &gmod):
    Span span = key_expr.span
    match iterable.expr:
        case ERange(start_opt, end_opt, rng_incl):
            match start_opt:
                case Some(start_box):
                    match end_opt:
                        case Some(end_box):
                            int dacc = comp_make_dict_acc(&ctx, &gmod)
                            String dacc_name = "__dictcomp_acc_" + int_to_str(dacc)
                            nl_put(&ctx, dacc_name, dacc)
                            Vector[Stmt] dbody = comp_synth_dict_body(dacc_name, key_expr, val_expr, filt_opt, span)
                            lower_for_range(&ctx, var_name, *start_box, *end_box, rng_incl, dbody, Vector[Stmt](), &gmod, false)
                            return dacc
                        case None:
                            pass
                case None:
                    pass
        else:
            pass
    # Non-range base: fall back to Unit, matching Rust (collections.rs:863).
    int dfallback = add_local(&ctx, UNIT_TYPE, None)
    emit(&ctx, GIAssign(dfallback, OpConstUnit()))
    return dfallback

# Allocate a dict comprehension accumulator. Typed as the MANGLED
# `Dict__int64_t__int64_t` (8-byte key + 8-byte value). Mirrors the
# `EDictLiteral` path (lower_expr.gg:2645-2662): `gorget_dict_new` with
# `[OpConstI64(8), OpConstI64(8)]`. Do NOT reuse `comp_make_acc` (it
# allocs a GorgetArray → heap corruption when treated as a GorgetMap).
int comp_make_dict_acc(LowerCtx &ctx, GirModule &gmod):
    # Centralized collection-accumulator typing — dict comprehensions iterate
    # `start..end`, so key + value are scalar `int64_t`
    # (`Dict__int64_t__int64_t`, ordered to match the destination VarDecl).
    int acc_tid = collection_accumulator_tid(&gmod, "map_ordered", "", "int64_t", "int64_t")
    int acc_local = add_local(&ctx, acc_tid, None)
    Vector[Operand] dn_args = [OpConstI64(8), OpConstI64(8)]
    emit(&ctx, GICallExtern(acc_local, "gorget_dict_new", dn_args))
    register_local_for_drop(&ctx, acc_local, acc_tid, &gmod)
    return acc_local

# Synthesize the dict-comp loop body `[if filter:] acc.put(key_expr, val_expr)`.
# Both `key_expr` and `val_expr` are passed as DIRECT `SpannedExpr` params
# (deref'd from the `EDictComp` boxes at the call site) — NEVER threaded
# through a `Vector[SpannedExpr]` PARAM (which the self-host miscompiles
# for Box-bearing elements). `comp_synth_body` only emits single-arg
# push/add, so this 2-arg `.put` helper is distinct. The `.put` routes
# through the normal method-call consume machinery (clone-at-boundary for
# live/borrowed sources) → `gorget_map_put` (map_dict_method). For the
# filtered variant the `.put` is guarded by `if filter:` (mirrors
# `comp_synth_set_body`) so a filtered-out element never skips the loop's
# position-advance.
Vector[Stmt] comp_synth_dict_body(String acc_name, SpannedExpr key_expr, SpannedExpr val_expr, Option[Box[SpannedExpr]] filt_opt, Span span):
    SpannedExpr acc_ref = SpannedExpr(EIdentifier(acc_name), span)
    Vector[CallArg] put_args = [pos_arg(key_expr.clone()), pos_arg(val_expr.clone())]
    Vector[SpannedType] no_targs = []
    Vector[String] no_arg_names = []
    SpannedExpr put_call = SpannedExpr(EMethodCall(Box(acc_ref), "put", put_args, no_targs), span)
    Stmt put_stmt = SExpr(put_call)
    Vector[Stmt] body = []
    match filt_opt:
        case Some(filt_box):
            Vector[Stmt] then_body = [put_stmt]
            Vector[ElseBranch] no_elifs = []
            SpannedExpr filt_expr = (*filt_box).clone()
            Stmt if_stmt = SIf(filt_expr, then_body, no_elifs)
            body.push(if_stmt)
        case None:
            body.push(put_stmt)
    return body

# ── Call lowering ────────────────────────────────────────

# Set ctx.pending_*_tyname hints for a container-literal arg at a struct
# constructor call site. Early-exits when arg is NOT an empty container
# literal — the normal-case fast path — so per-arg overhead stays O(1)
# in the common case. Only when we've identified a container literal do
# we pay for the `gmod.type_infos.get(ctor_name)` lookup (a Dict probe +
# GirTypeInfo copy).
void apply_container_hint_for_ctor_arg(LowerCtx &ctx, String ctor_name, int ai, SpannedExpr arg, GirModule gmod):
    # Fast reject for non-container-literal args (the common case).
    bool is_arr_lit = false
    bool is_dict_lit = false
    match arg.expr:
        case EArrayLiteral(_):
            is_arr_lit = true
        case EDictLiteral(_, _):
            is_dict_lit = true
        else:
            return
    # Look up the ctor's field type. Avoid value-copying GirTypeInfo
    # (its nested Vectors don't survive a shallow clone in stage-1).
    String fty_name = ""
    if gmod.type_infos.contains(ctor_name):
        GirTypeInfo cti_info = gmod.type_infos.get(ctor_name).unwrap()
        if cti_info.is_enum:
            return
        if ai >= cti_info.fields.len():
            return
        fty_name = cti_info.fields.get(ai).unwrap().type_name.clone()
    else:
        # ENUM-VARIANT constructor (e.g. `GICall(int, String, Vector[Operand])`).
        # `ctor_name` is the VARIANT name, so `type_infos` (keyed by the ENUM
        # name) misses above. Resolve the parent enum, find the matching
        # variant, and read its field[ai] type — the EXACT struct-ctor logic,
        # one indirection deeper. Without this the container-literal arg
        # (`[op]`) of a variant ctor gets NO element-size hint and falls back
        # to the hardcoded 8 (`OpConstI64(8)` in the EArrayLiteral lowering) —
        # which TRUNCATES every >8-byte element (e.g. a 16-byte `Operand`
        # enum, whose `OpMove(int)` payload was silently dropped on push →
        # read back as `OpMove(0)`). This was the bootstrap-SIGSEGV root for
        # `GICall(-1, join_fn, [OpMove(handle)])` (#14 A): the join arg's
        # local id became 0 → `pthread_join(NULL)` in the self-compiled stage.
        # struct ctors are unaffected (they take the `is_enum`-true `return`
        # path's sibling above). Mirrors Rust gg, whose per-arg
        # `expected_type` is set from the variant's field type uniformly.
        String parent_enum = enum_variant_parent(ctor_name, gmod)
        if parent_enum == "":
            return
        if not gmod.type_infos.contains(parent_enum):
            return
        GirTypeInfo penum_info = gmod.type_infos.get(parent_enum).unwrap()
        int vci = 0
        while vci < penum_info.variants.len():
            GirEnumVariantInfo cti_var = penum_info.variants.get(vci).unwrap()
            if cti_var.name == ctor_name:
                if ai < cti_var.fields.len():
                    fty_name = cti_var.fields.get(ai).unwrap().type_name.clone()
                vci = penum_info.variants.len()
            else:
                vci += 1
    if fty_name == "":
        return
    if is_arr_lit:
        if fty_name.starts_with("Vector__"):
            # `.slice(...)` returns a view (cap=0) into fty_name's buffer;
            # fty_name is dropped at function exit and the view becomes
            # dangling. Materialize to an owned String before storing on
            # the LowerCtx field — the downstream magic-name concat would
            # otherwise read stale bytes and emit garbage like
            # `sizeof(��0XA./)` in stage-1's C.
            String elem_slice = fty_name.slice(8, fty_name.len())
            ctx.pending_vec_elem_tyname = elem_slice.clone()
    elif is_dict_lit:
        # Dict__<K>__<V> / HashMap__<K>__<V>. Simple first-split only;
        # nested generics (Dict__Vector__int64_t__int64_t) stay unhinted
        # and fall back to size 8.
        int d_prefix_len = -1
        bool d_ordered = false
        if fty_name.starts_with("Dict__"):
            d_prefix_len = 6
            d_ordered = true
        elif fty_name.starts_with("HashMap__"):
            d_prefix_len = 9
        elif fty_name.starts_with("Map__"):
            d_prefix_len = 5
        elif fty_name.starts_with("OrderedDict__"):
            d_prefix_len = 13
            d_ordered = true
        if d_prefix_len > 0:
            String d_rest = fty_name.slice(d_prefix_len, fty_name.len())
            int d_sep = d_rest.index_of("__").unwrap_or(-1)
            if d_sep > 0:
                String k_only = d_rest.slice(0, d_sep)
                String v_only = d_rest.slice(d_sep + 2, d_rest.len())
                if not k_only.contains("__") and not v_only.contains("__"):
                    # Same view-lifetime concern as the Vector case —
                    # clone to owned before storing.
                    ctx.pending_dict_key_tyname = k_only.clone()
                    ctx.pending_dict_val_tyname = v_only.clone()
                    ctx.pending_dict_ordered = d_ordered

# NAMED-ARG MODELING helper — does this collection ctor's arg list carry a
# capacity (named `cap=` OR a lone positional int) or allocator (`alloc=`)
# argument that must be split out of the `__new` call? Returns false for the
# bare `Vector[int]()` zero-arg case (the common path, unchanged) so the
# interception only fires when there is actually something to split.
bool collection_ctor_has_cap_alloc_or_positional(Vector[SpannedExpr] args, Vector[String] arg_names):
    if args.len() == 0:
        return false
    return true

# NAMED-ARG MODELING — does this call carry a `cap=` or `alloc=` named arg?
# Gates the String / Channel ctor named-arg-split arms so the plain positional
# forms stay on their existing (unchanged) paths. Reads the parser-preserved
# `arg_names` (parallel to args, "" = positional) — a typed lookup, no name
# match on the callee.
bool call_has_named_cap_or_alloc(Vector[String] arg_names):
    int i = 0
    while i < arg_names.len():
        String n = arg_names.get(i).unwrap()
        if n == "cap" or n == "alloc":
            return true
        i += 1
    return false

# Cross-frame fault propagation (error-model.md §11, Inc-2.1c/2.1d): emit the
# caller-side per-category TAG-DISPATCH after a participating callee's GICall.
# Load the i32 slot's tag VALUE ONCE, then chain a per-category equality branch
# for ALL THREE categories; `==0` (no fault) falls through to the continuation
# (where the call RESULT is read — branch-before-read).
#
# A single `slot != 0` branch CANNOT distinguish Overflow from DivByZero/Bounds
# → it would route every fault to ONE entry, constructing the WRONG `Fault`
# variant (the measured Core-#8 silent miscompile: a deep div0 printed 100 not
# 200). Tags are the `Fault` discriminants + 1 (0 = "no fault"), read from the
# typed enum registry — no magic `1`/`2`/`3` literal (devbook/24 rule 2).
#
# ⚠ EVERY category is resolved to an ALWAYS-PRESENT destination — the user's
# catch entry when this scope catches it (handler arg >= 0), ELSE a synthesized
# RE-PANIC block (handler arg == -1). WITHOUT the re-panic, a category the
# callee CAN raise but this scope does NOT catch would leave the slot tag
# unmatched → fall to the continuation → SILENTLY SWALLOWED (the Core-#8
# miscompile: `fault_deep_mixed_*` would print the sentinel `0` instead of
# re-panicking). The self-host has no per-scope panic blocks (unlike Rust's
# FaultScope.div_*_panic/bounds_panic), so the re-panic block is synthesized
# HERE at the dispatch. Mirrors Rust gg's gate resolving each handler
# `unwrap_or(panic_block)` (`exprs/calls.rs`) + the GIR→LIR tag-switch
# (`src/lir/lower/insts.rs`).
# Is `e` a string LITERAL (plain or interpolated f-string)? Used to gate the
# `format(x)` free-fn identity intercept below to ONLY the shape Rust gg absorbs
# (src/ir/lowering/exprs/calls.rs:807-819 intercepts a StringLiteral arg). Taken
# BY VALUE (the caller passes an rvalue temp `args.get(0).unwrap()`, which a
# `&`-param can't borrow — sibling read-only predicates like eval_const_int_expr
# / static_is_literal_init also take SpannedExpr by value).
bool arg_is_string_literal(SpannedExpr e):
    match e.expr:
        case EFString(_, _, _):
            return true
        case EStringLiteral(_, _):
            return true
        else:
            return false

# ── R43-C: inferred type-args for a turbofish-free generic FREE-FN call ──────
# A generic free-fn invoked WITHOUT `[T,...]` (`passthrough(producer())`,
# `pick(7, 9)`) must still be monomorphized. The self-host's discovery + mangle
# both gate on `targs.len() > 0`, so these calls emit a bare template symbol
# that is DCE'd → undefined-reference. This mirrors Rust gg's per-call subst →
# `inferred_call_targs` side-table + `apply_inferred_call_targs`
# (semantic/typecheck.rs:1926 / :7486): bind each of the callee template's
# generic params structurally from the ARGUMENT types. Fully deterministic and
# `gmod`-only so the discovery pre-pass (lower_generics) and this mangle site
# derive the SAME targs from the SAME AST args — no span-keyed side-table
# needed. STRICTLY GATED (returns [] unless the callee is a known generic
# free-fn, the call is positional, every arg resolves to a concrete type, and
# every generic param binds), so non-generic / turbofish / partially-typed
# calls are untouched and the bootstrap (which has no such calls today) is safe.

# Normalize a primitive name spelled as a bare `TNamed` (e.g. the `int` inside a
# callee's `Result[int, E]` return type) to `TPrimitive`, so `type_to_c_name`
# and `spanned_type_to_c_name` mangle it identically (`int64_t`, not `int`).
SpannedType r43c_normalize_prim(SpannedType t):
    match t.ty:
        case TNamed(name, targs):
            if targs.len() == 0 and prim_name_to_type(name) >= 0:
                return SpannedType(TPrimitive(name), t.span)
        else:
            pass
    return t

# Concrete AST type of a call ARGUMENT, or `TInferred()` when unresolvable
# (→ inference bails). Literals + a non-generic call's declared return type.
SpannedType infer_arg_ast_type(SpannedExpr arg, GirModule gmod):
    match arg.expr:
        case EIntLiteral(_):
            return SpannedType(TPrimitive("int"), -1)
        case EFloatLiteral(_):
            return SpannedType(TPrimitive("float"), -1)
        case EBoolLiteral(_):
            return SpannedType(TPrimitive("bool"), -1)
        case EStringLiteral(_, _):
            return SpannedType(TNamed("String", []), -1)
        case EFString(_, _, _):
            return SpannedType(TNamed("String", []), -1)
        case ECall(callee_box, _, _):
            match (*callee_box).expr:
                case EIdentifier(cname):
                    if gmod.fn_ast_defs.contains(cname):
                        FunctionDef cdef = gmod.fn_ast_defs.get(cname).unwrap()
                        if cdef.type_params.len() == 0:
                            return cdef.return_type
                else:
                    pass
        else:
            pass
    return SpannedType(TInferred(), -1)

# Structurally bind generic param `gp` from a (param-type, arg-type) pair.
# Returns the bound AST type, or `TInferred()` when `gp` does not appear.
SpannedType bind_gparam_ast(SpannedType param, SpannedType arg, String gp):
    match param.ty:
        case TNamed(pname, pargs):
            if pname == gp and pargs.len() == 0:
                return arg
            match arg.ty:
                case TNamed(aname, aargs):
                    if pname == aname and pargs.len() == aargs.len():
                        int i = 0
                        while i < pargs.len():
                            SpannedType sub = bind_gparam_ast(pargs.get(i).unwrap(), aargs.get(i).unwrap(), gp)
                            match sub.ty:
                                case TInferred():
                                    pass
                                else:
                                    return sub
                            i += 1
                else:
                    pass
        else:
            pass
    return SpannedType(TInferred(), -1)

Vector[SpannedType] infer_free_fn_targs(String fname, Vector[SpannedExpr] args, Vector[String] arg_names, GirModule gmod):
    Vector[SpannedType] empty = []
    if not gmod.fn_ast_defs.contains(fname):
        return empty
    FunctionDef tmpl = gmod.fn_ast_defs.get(fname).unwrap()
    # Generic free-fn only; positional args only; exact arity.
    if tmpl.type_params.len() == 0:
        return empty
    if tmpl.params.len() != args.len():
        return empty
    for an in arg_names:
        if an != "":
            return empty
    # Resolve each arg to a concrete AST type; bail if any is unresolvable.
    Vector[SpannedType] arg_types = []
    for a in args:
        SpannedType at = infer_arg_ast_type(a, gmod)
        match at.ty:
            case TInferred():
                return empty
            else:
                pass
        arg_types.push(at)
    # Bind each generic param; bail unless ALL bind to a concrete type.
    Vector[SpannedType] result = []
    for gp in tmpl.type_params:
        SpannedType bound = SpannedType(TInferred(), -1)
        int pi = 0
        while pi < tmpl.params.len():
            SpannedType cand = bind_gparam_ast(tmpl.params.get(pi).unwrap().param_type, arg_types.get(pi).unwrap(), gp)
            match cand.ty:
                case TInferred():
                    pass
                else:
                    bound = cand
            pi += 1
        match bound.ty:
            case TInferred():
                return empty
            else:
                pass
        result.push(r43c_normalize_prim(bound))
    return result

int lower_call(LowerCtx &ctx, String fname, Vector[SpannedExpr] args, Vector[String] arg_names, Vector[SpannedType] targs, GirModule &gmod):
    int result = -1
    bool is_print = fname == "print"
    if is_print:
        # print() → printf. The CALL's result is UNIT (mirrors Rust gg, which
        # returns `Operand::Constant(Constant::Unit)`, src/ir/lowering/exprs/
        # calls.rs:511-513), NOT the I32 printf byte-count. The printf
        # side-effect still happens below; only the value the caller reads is
        # unit. Setting `result` here (for the WHOLE arm) also covers the
        # no-arg `print()` case, which would otherwise leave `result = -1`.
        # Without this, `void main(): print("hi")` (expr-body, pre-desugared to
        # `return print(...)`) and `void main(): return print("hi")` flow the
        # byte-count into main's i32 return slot → the binary exits with the
        # byte count (3 for "hi\n") instead of 0. OpConstUnit() → IIConst(LT_I32,0).
        int unit_dst = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(unit_dst, OpConstUnit()))
        result = unit_dst
        # Resolve the `terminator=` kwarg (default "\n"). Mirrors Rust gg's
        # lower_print_call (src/ir/lowering/exprs/calls.rs:1604-1618): the
        # terminator must be a plain (non-interpolated) string literal so it
        # can be spliced into the printf format string at compile time. The
        # parser puts the keyword for value i at arg_names[i] ("" for a
        # positional arg, parser.gg:1896), parallel to `args`. Scan args[1..]
        # for `terminator`; the positional value stays args[0]. Without this
        # the hardcoded `\n` below ignores `print(x, terminator="")` /
        # `terminator=", "`, breaking the print_terminator / print_builtin
        # fixtures (every line gets a spurious newline).
        String term = "\n"
        # The `file=stderr` kwarg routes the printf to STDERR via the
        # fprintf_stderr runtime symbol (with a NULL placeholder first arg the
        # C-emit skips). Mirrors Rust gg's lower_print_call (src/ir/lowering/
        # exprs/calls.rs:1697-1762): `file` must be the bare identifier
        # `stderr`. Without this the kwarg is dropped and the write lands on
        # stdout, breaking the print_builtin fixture.
        bool use_stderr = false
        int pterm_i = 1
        while pterm_i < args.len():
            String pterm_name = ""
            if pterm_i < arg_names.len():
                pterm_name = arg_names.get(pterm_i).unwrap()
            if pterm_name == "terminator":
                SpannedExpr pterm_arg = args.get(pterm_i).unwrap()
                match pterm_arg.expr:
                    case EStringLiteral(pterm_s, pterm_interp):
                        # Single-segment (non-interpolated) literal only; an
                        # interpolated terminator is silently ignored (matches
                        # Rust's `if !has_interp` gate — not a real use case).
                        if not pterm_interp:
                            term = pterm_s.clone()
                    else:
                        pass
            elif pterm_name == "file":
                SpannedExpr pfile_arg = args.get(pterm_i).unwrap()
                match pfile_arg.expr:
                    case EIdentifier(pfile_id):
                        if pfile_id == "stderr":
                            use_stderr = true
                    else:
                        pass
            pterm_i = pterm_i + 1
        if args.len() > 0:
            SpannedExpr parg = args.get(0).unwrap()
            int val = lower_expr(&ctx, parg, &gmod)
            int val_type = I64_TYPE
            if val >= 0 and val < ctx.locals.len():
                val_type = ctx.locals.get(val).unwrap().type_id
            int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            # Borrowed string (`Ptr(GorgetString)` from a struct String-field
            # read or a match/`is` enum-payload binding) — deref to a NON-OWNING
            # value GorgetString so the `%s`/`.data` path fires. The exact
            # `val_type == gs_tid` check below otherwise misses the Ptr and
            # falls through to `%lld`, printing the pointer as an int. The deref
            # local is LoBorrowed so drop-elab won't free the aliased buffer.
            if is_ptr_to_string_type_id(val_type, &gmod):
                int sval = add_local_with(&ctx, gs_tid, None, LoBorrowed(), BoNone())
                emit(&ctx, GIDeref(sval, val, gs_tid))
                val = sval
                val_type = gs_tid
            # Format SPEC only (no terminator); `term` is appended at the
            # build site below so the `terminator=` kwarg is honoured.
            String fmt = "%lld"
            if val_type == F64_TYPE:
                fmt = "%f"
            elif val_type == BOOL_TYPE:
                # bool → gorget_bool_to_str → GorgetString, print as "%s\n".
                # Mirrors Rust format_for_printf BOOL_TYPE→"%s"
                # (src/ir/lowering/exprs/calls.rs:1915) + bool→gorget_bool_to_str
                # (src/lir/lower/calls.rs:50-53). Without this, print(true)
                # emits printf("%lld\n", true) → "1".
                int bdst = add_local(&ctx, gs_tid, None)
                emit(&ctx, GICallExtern(bdst, "gorget_bool_to_str", [op_consume(ctx, &gmod, val, CkFormatArg())]))
                # FRESH-OWNED-TEMP drop registration (#7-style):
                # gorget_bool_to_str allocates a fresh `GorgetString` (LoOwned)
                # that is only BORROWED by the printf below (CkFormatArg →
                # OpBorrow), so it is orphaned and leaks. Register at creation
                # so the scope-exit GIDropIfAlive frees it once. Borrow-only
                # consume ⇒ never moved ⇒ no double-free.
                register_local_for_drop(&ctx, bdst, gs_tid, &gmod)
                val = bdst
                val_type = gs_tid
                fmt = "%.*s"
            elif fstr_displayable_display_method(val_type, &gmod) is Some(pdisp_fn):
                # Displayable dispatch: `print(x)` where x is a struct/enum
                # with a `display` method → call `Type__display(&x)` → String,
                # then route through the `%.*s\n` String branch below. Without
                # this `print(p)` falls to the `%lld\n` default and prints the
                # struct/enum's raw bits (pointer / 0) instead of the formatted
                # text. Mirrors Rust gg's format_for_printf Displayable branch
                # (src/ir/lowering/exprs/calls.rs:1964-1996); sibling of the
                # EFString-arg Displayable branch above. TYPED gate: the
                # method's presence in `fn_sigs`, not a name-shape test.
                # `is Some(pdisp_fn)` binds the symbol once in the condition.
                int pdisp_dst = add_local(&ctx, gs_tid, None)
                emit(&ctx, GICallExtern(pdisp_dst, pdisp_fn, [OpBorrow(val)]))
                # FRESH-OWNED-TEMP drop registration (#7-style): `display`
                # returns an OWNED GorgetString that is only BORROWED by the
                # printf below, so register at creation. A literal-returning
                # display body is a cap=0 view whose free no-ops.
                register_local_for_drop(&ctx, pdisp_dst, gs_tid, &gmod)
                val = pdisp_dst
                val_type = gs_tid
                fmt = "%.*s"
            if val_type == gs_tid:
                # %.*s + (int)len,data so a non-NUL-terminated cap=0 view
                # (trim/strip/slice) prints exactly len bytes, not over-reading.
                # The printf emitter decomposes the Str value arg (ai != 0).
                fmt = "%.*s"
            # Append the resolved terminator (default "\n") so `terminator=`
            # is honoured (was a hardcoded "\n" baked into each spec above).
            fmt = fmt + term
            int pdst = add_local(&ctx, I32_TYPE, None)
            if use_stderr:
                # `file=stderr` → fprintf_stderr(NULL placeholder, fmt, args).
                # The C-emit skips the placeholder and emits fprintf(stderr, …);
                # mirrors Rust gg (calls.rs:1734-1738 / 1753-1757).
                Vector[Operand] ferr_args = [OpConstNull(), OpConstStr(fmt), op_consume(ctx, &gmod, val, CkFormatArg())]
                emit(&ctx, GICallExtern(pdst, "fprintf_stderr", ferr_args))
            else:
                Vector[Operand] printf_args = [OpConstStr(fmt), op_consume(ctx, &gmod, val, CkFormatArg())]
                emit(&ctx, GICallExtern(pdst, "printf", printf_args))
            # `result` is already the UNIT local set at the top of the is_print
            # arm; the printf byte-count `pdst` is intentionally discarded.
    elif fname == "panic" and args.len() == 1:
        # `panic(msg)` — noreturn builtin. Mirrors Rust gg's lower_call
        # special-case (src/ir/lowering/exprs/calls.rs:525-531): lower the
        # message, route through the same `gorget_panic` runtime symbol the
        # assert lowering already uses (lower_stmt.gg:1031), then emit an
        # unreachable terminator so post-panic code is dead. Because `panic`
        # is used as a VALUE here (match-arm tail, `?? panic(...)`), the old
        # generic-call path emitted `__v = panic(__msg)` — an undefined symbol
        # AND a non-scalar conversion at the `??` coalesce site. The runtime
        # `gorget_panic(const char*)` is registered cstr-position
        # (lir_codegen.gg:2012 / runtime_arg_is_cstr), so the lowered String
        # message is converted via gorget_str_to_cstr at the C-emit boundary.
        SpannedExpr panic_arg = args.get(0).unwrap()
        int panic_msg = lower_expr(&ctx, panic_arg, &gmod)
        # Borrow-only consume (gorget_panic reads the message, never owns it),
        # matching the format-arg / print String-to-extern idiom (CkFormatArg
        # lowers to OpBorrow, so the message is not moved).
        # D11 trap normalization (was gorget_panic): explicit `panic(msg)` traps
        # as trap[T_Panic] + exit 101. The T_Panic code is prepended as a cstr
        # literal; the message stays the borrowed arg. Mirrors Rust gg
        # src/ir/lowering/exprs/calls.rs (gorget_trap(T_Panic, msg)).
        emit(&ctx, GICallExtern(-1, "gorget_trap", [OpConstStr("T_Panic"), op_consume(ctx, &gmod, panic_msg, CkFormatArg())]))
        # gorget_panic is noreturn. The self-host Terminator has no
        # GTUnreachable, so jump to a fresh dead block — the faithful
        # equivalent Rust's `builder.unreachable()` (the same idiom the
        # assert lowering uses, lower_stmt.gg:1036). Any code lowered after
        # the panic lands in `panic_dead_bb`, which has no predecessors.
        int panic_dead_bb = new_block(&ctx)
        set_terminator(&ctx, GTJump(panic_dead_bb))
        switch_to(&ctx, panic_dead_bb)
        # `panic` is Never-typed; it yields no value. Return a UNIT local so
        # the (dynamically unreachable) value-position use has a well-typed
        # placeholder, mirroring Rust's `Operand::Constant(Constant::Unit)`.
        int panic_unit = add_local(&ctx, UNIT_TYPE, None)
        emit(&ctx, GIAssign(panic_unit, OpConstUnit()))
        result = panic_unit
    elif (fname == "Str" or fname == "String" or fname == "GorgetString") and enum_variant_parent(fname, gmod) == "" and call_has_named_cap_or_alloc(arg_names):
        # NAMED-ARG MODELING — String ctor cap=/alloc= split (round-39, mirroring
        # Rust gg's `if name == "String"` branch in
        # `src/ir/lowering/exprs/calls.rs`). `alloc=a` runs the ctor under a
        # push/pop-allocator bracket (the SAME mechanism as the collection
        # ctors) so the runtime snapshots the allocator into the Str's `alloc`
        # field and growth reallocs stick to it (§15.3 "Composable allocation").
        # Before this the bare positional arms below were named-arg-BLIND:
        # `String(alloc=a)` (args.len()==1) identity-coerced the ARENA HANDLE
        # into the String slot, and `String(cap=n, alloc=a)` / `String("x",
        # alloc=a)` (args.len()==2) fell through to the generic tail (driver
        # error / cc-fail). GATED to the named forms so the bare `String(x)` /
        # `String()` paths below are unchanged. `arg_names` is parallel to args.
        int str_alloc_idx = -1
        int str_cap_idx = -1
        int str_pos_idx = -1
        int sni = 0
        while sni < args.len():
            String sn = ""
            if sni < arg_names.len():
                sn = arg_names.get(sni).unwrap()
            if sn == "alloc":
                str_alloc_idx = sni
            elif sn == "cap":
                str_cap_idx = sni
            elif sn == "" and str_pos_idx < 0:
                str_pos_idx = sni
            sni += 1
        int str_gs_tid = lookup_or_register_named(&gmod, "GorgetString")
        # alloc= → push the active allocator BEFORE the ctor so the fresh Str's
        # buffer (and its recorded `alloc`) come from it.
        bool str_bracketed = false
        if str_alloc_idx >= 0:
            int str_alloc_val = lower_expr(&ctx, args.get(str_alloc_idx).unwrap(), &gmod)
            emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", [op_consume(ctx, &gmod, str_alloc_val, CkCallArgBorrow())]))
            str_bracketed = true
        int str_dst = add_local(&ctx, str_gs_tid, None)
        if str_cap_idx >= 0:
            # cap= → with_capacity(n).
            int str_cap_val = lower_expr(&ctx, args.get(str_cap_idx).unwrap(), &gmod)
            emit(&ctx, GICallExtern(str_dst, "gorget_string_with_capacity", [OpCopy(str_cap_val)]))
        elif str_pos_idx >= 0:
            # Positional content/capacity: int → with_capacity, String content →
            # from_str (materialise an OWNED Str in the bracketed allocator; the
            # bare identity-coercion below would keep the static cap=0 view,
            # which records NO allocator and would silently NOT bind).
            int str_pos_val = lower_expr(&ctx, args.get(str_pos_idx).unwrap(), &gmod)
            int str_pty = -1
            if str_pos_val >= 0 and str_pos_val < ctx.locals.len():
                str_pty = ctx.locals.get(str_pos_val).unwrap().type_id
            bool str_pos_is_int = str_pty == I8_TYPE or str_pty == I16_TYPE or str_pty == I32_TYPE or str_pty == I64_TYPE or str_pty == U8_TYPE or str_pty == U16_TYPE or str_pty == U32_TYPE or str_pty == U64_TYPE
            if str_pos_is_int:
                emit(&ctx, GICallExtern(str_dst, "gorget_string_with_capacity", [OpCopy(str_pos_val)]))
            else:
                emit(&ctx, GICallExtern(str_dst, "gorget_string_from_str", [op_consume(ctx, &gmod, str_pos_val, CkFormatArg())]))
        elif str_bracketed:
            # Empty + alloc= → with_capacity(0) (the runtime clamps to a 16-byte
            # minimum) so the Str records the allocator; from_str("") would
            # return the shared static empty view and NOT bind.
            emit(&ctx, GICallExtern(str_dst, "gorget_string_with_capacity", [OpConstI64(0)]))
        else:
            emit(&ctx, GICallExtern(str_dst, "gorget_string_from_str", [OpConstStr("")]))
        # alloc= → pop the allocator immediately after the ctor (one-shot).
        if str_bracketed:
            emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
        # FRESH-OWNED-TEMP drop registration (Core #3): with_capacity/from_str
        # eagerly allocate, so an unconsumed temp would leak; a move into a
        # binding self-suppresses the scope-exit drop (GIMoveZero). Same as the
        # int-capacity arm below.
        register_local_for_drop(&ctx, str_dst, str_gs_tid, &gmod)
        result = str_dst
    elif (fname == "Str" or fname == "String" or fname == "GorgetString") and args.len() == 1 and enum_variant_parent(fname, gmod) == "":
        # Identity coercion: Str(x) / String(x) returns x (already a string).
        # Lower the inner arg and pass its type through.
        # GATE (Core #2, no name-matching): a user enum may declare a variant
        # named `Str` (e.g. json.gg's `Json.Str(String)`). A bare `Str(s)` ctor
        # then collides with this coercion — without the guard the variant
        # construction is SWALLOWED (the String is passed straight through into
        # the enum-typed slot, yielding a zero-tag `Null` at runtime). Skip the
        # coercion when `fname` is a registered enum variant so the call falls
        # through to the variant-ctor lowering (mirrors the qualified
        # `Enum.Str(s)` path → `call_extern @Enum__Str`).
        SpannedExpr inner = args.get(0).unwrap()
        int sc1_inner = lower_expr(&ctx, inner, &gmod)
        # Capacity ctor: `String(<int>)` → gorget_string_with_capacity(n),
        # mirroring Rust gg (src/ir/lowering/exprs/mod.rs:1651-1667): branch on
        # the arg's TYPED type — an int/uint routes to the capacity allocator
        # (fresh owned GorgetString), any other type (a String content, incl.
        # char literals which lower as GorgetString here) identity-coerces.
        # Without this branch `String(256)` passes the int straight through, so
        # the binding is typed i64 and the whole method cascade breaks
        # (`.push()` misroutes → runtime stack-overflow read, `.capacity()`
        # emits an undefined symbol).
        int sc1_aty = -1
        if sc1_inner >= 0 and sc1_inner < ctx.locals.len():
            sc1_aty = ctx.locals.get(sc1_inner).unwrap().type_id
        bool sc1_is_int = sc1_aty == I8_TYPE or sc1_aty == I16_TYPE or sc1_aty == I32_TYPE or sc1_aty == I64_TYPE or sc1_aty == U8_TYPE or sc1_aty == U16_TYPE or sc1_aty == U32_TYPE or sc1_aty == U64_TYPE
        if sc1_is_int:
            int sc1_gs_tid = lookup_or_register_named(&gmod, "GorgetString")
            int sc1_dst = add_local(&ctx, sc1_gs_tid, None)
            emit(&ctx, GICallExtern(sc1_dst, "gorget_string_with_capacity", [OpCopy(sc1_inner)]))
            # FRESH-OWNED-TEMP drop registration (Core #3, sibling of the
            # generic GICall tail below): gorget_string_with_capacity
            # eagerly allocates `cap` bytes (runtime_string.c:400 →
            # str_alloc_with), so an unconsumed temp would leak. When the
            # result is instead MOVED into a binding (`String sb =
            # String(256)`), op_consume emits OpMove → GIMoveZero and the
            # scope-exit drop of the temp self-suppresses — dropped exactly
            # once either way. (The `String()` empty-ctor arm below skips
            # this only because gorget_string_from_str("") is cap=0/static.)
            # Mirrors Rust's call_extern_tracked (exprs/mod.rs:1664).
            register_local_for_drop(&ctx, sc1_dst, sc1_gs_tid, &gmod)
            result = sc1_dst
        else:
            result = sc1_inner
    elif (fname == "Str" or fname == "String" or fname == "GorgetString") and args.len() == 0:
        # Bare `String()` ctor → empty owned GorgetString. Mirror Rust gg
        # (src/ir/lowering/exprs/mod.rs:1664): emit gorget_string_from_str("")
        # and type the result GorgetString at the WRITE site so the cascade
        # (every `buf.push(...)` routing to int64_t__push, the bare `gorget_str_`
        # undefined ref) never starts. Without this arm a bare `String()` falls
        # through to the default call lowering and is typed i64.
        int sc_gs_tid = lookup_or_register_named(&gmod, "GorgetString")
        int sc_dst = add_local(&ctx, sc_gs_tid, None)
        emit(&ctx, GICallExtern(sc_dst, "gorget_string_from_str", [OpConstStr("")]))
        result = sc_dst
    elif fname == "format" and args.len() == 1 and enum_variant_parent(fname, gmod) == "" and arg_is_string_literal(args.get(0).unwrap()):
        # `format(x)` free-fn → identity on the already-lowered string arg,
        # mirroring Rust gg (src/ir/lowering/exprs/calls.rs:807): an interpolated
        # string literal lowers to `gorget_string_format(...)` (EFString below at
        # ~:1788) and a plain literal to a GorgetString `OpConstStr` (EStringLiteral
        # at ~:1783) — both already GorgetString-typed. The outer `format(...)` is
        # ABSORBED (Rust emits NO `format` call). Without this arm the self-host
        # emitted a raw `format(__vN)` (undefined symbol, typed i64), so a
        # `format(...).to_upper()` receiver was int → dispatched to the char method
        # `gorget_uint8_to_upper` (Str = int cc-fail). Identity passes the arg's
        # GorgetString type through so the method cascade dispatches to gorget_str_*.
        # GUARD (Core #8 fidelity): only a string-literal arg is absorbed — Rust
        # `calls.rs:807-819` intercepts only a StringLiteral. A non-literal
        # `format(some_var)` / `format(42)` FAILS this elif and falls through to the
        # terminal `else` (a real free-call / clean CC-FAIL), not an inner match
        # (which would strand the `-1` sentinel out of `return result`).
        result = lower_expr(&ctx, args.get(0).unwrap(), &gmod)
    elif fname == "len" and args.len() == 1:
        # Free `len(x)` → dispatch to the runtime fn for the ARG's type,
        # mirroring Rust gg's free-len handler (src/ir/lowering/exprs/
        # calls.rs:534-571). String → gorget_str_codepoint_count (by value),
        # Vector/Deque/Heap → gorget_array_len, Dict → gorget_map_len,
        # Set → gorget_set_len (the latter three take the receiver by pointer,
        # which lir_lower's needs_ptr_arg wraps for us — gorget_array_len is in
        # that list, lir_lower.gg:2205). Without this arm the call falls through
        # to the generic GICall path and emits a literal `len(x)` C call to an
        # undefined symbol. The dispatch is keyed on the TYPED arg type
        # (is_string_type_id / collection_kind_of), not a name match.
        SpannedExpr len_arg = args.get(0).unwrap()
        int len_local = lower_expr(&ctx, len_arg, &gmod)
        int len_arg_ty = I64_TYPE
        if len_local >= 0 and len_local < ctx.locals.len():
            len_arg_ty = ctx.locals.get(len_local).unwrap().type_id
        int len_dst = add_local(&ctx, I64_TYPE, None)
        if is_string_type_id(len_arg_ty, &gmod):
            # gorget_str_codepoint_count takes Str BY VALUE (lir_lower.gg:2283,
            # NOT in needs_ptr_arg). Pass the receiver as a read-only OpBorrow —
            # the SAME shape the `.len()` METHOD path uses (the resource-move
            # validator forbids OpCopy on a resource; OpBorrow is read-only so
            # the String isn't consumed and the C-emit reads it by value).
            # A borrowed-String arg (Ptr(GorgetString)) is deref'd to a value
            # first so the by-value ABI is satisfied.
            int len_str_val = len_local
            if is_ptr_to_string_type_id(len_arg_ty, &gmod):
                int gs_tid = lookup_or_register_named(&gmod, "GorgetString")
                int len_sval = add_local_with(&ctx, gs_tid, None, LoBorrowed(), BoNone())
                emit(&ctx, GIDeref(len_sval, len_local, gs_tid))
                len_str_val = len_sval
            emit(&ctx, GICallExtern(len_dst, "gorget_str_codepoint_count", [OpBorrow(len_str_val)]))
        else:
            # Collection: pick the runtime fn off the RESOLVED CollectionKind.
            # Default to gorget_array_len (Vector/Deque/Heap/unknown), matching
            # Rust's else-branch fall-through (calls.rs:568).
            String len_fn = "gorget_array_len"
            String len_tn = type_id_to_name(len_arg_ty, &gmod)
            CollectionKind len_ck = collection_kind_of(&gmod, len_tn)
            if collection_kind_eq(len_ck, CkDict()):
                len_fn = "gorget_map_len"
            elif collection_kind_eq(len_ck, CkOrderedSet()) or collection_kind_eq(len_ck, CkHashSet()):
                len_fn = "gorget_set_len"
            emit(&ctx, GICallExtern(len_dst, len_fn, [OpBorrow(len_local)]))
        result = len_dst
    elif fname == "thread_spawn" and (args.len() == 1 or args.len() == 2):
        # thread_spawn(fn[, stack_size]) → __gorget_thread_spawn_{fn}().
        # Mirrors Rust gg's intrinsic (`src/ir/lowering/exprs/calls.rs:914`).
        # The intrinsic runs on the RAW args BEFORE the default-fill, so a
        # 1-arg call arrives as 1 arg (stack_size 0) and a 2-arg call as 2.
        # V1: only bare function references supported (closures are a follow-up).
        # The emitted wrapper text is byte-identical to Rust's (`emit_types.rs`):
        # the symbol is fn-name-keyed (`__gorget_thread_spawn_{fn}`), with the
        # stack_size riding as the typed `ThreadSpawnRec.stack_size` field —
        # 0 = OS default (plain pthread_create), non-zero = a sized wrapper.
        int ts_result = -1
        match args.get(0).unwrap().expr:
            case EIdentifier(spawn_fn_name):
                # Return type of the spawned fn (Thread__{ret_name}). `fn_sigs`
                # maps fn name → return type id; default to int64_t if absent.
                int ts_ret_type = I64_TYPE
                if gmod.fn_sigs.contains(spawn_fn_name):
                    ts_ret_type = gmod.fn_sigs.get(spawn_fn_name).unwrap()
                # SYMBOL-NAME axis: the payload type NAME baked into the
                # `Thread__{name}` symbols — "void" for a unit-returning fn
                # (Rust special-cases UNIT_TYPE → Thread__void), else the
                # type's language-level name. The C spelling of the ctx
                # `_result` field is resolved separately at emit
                # (`thread_payload_c_type`, lir_codegen).
                String ts_ret_name = "void"
                if ts_ret_type != UNIT_TYPE:
                    ts_ret_name = type_id_to_name(ts_ret_type, &gmod)
                String ts_thread_name = "Thread__" + ts_ret_name
                # stack_size: 0 for the 1-arg form; for the 2-arg form, const-fold
                # the 2nd arg (a non-foldable value also routes to the plain wrapper).
                int ts_stack_size = 0
                if args.len() == 2:
                    match eval_const_int_expr(args.get(1).unwrap(), &gmod):
                        case Some(sz):
                            ts_stack_size = sz
                        case None:
                            ts_stack_size = 0
                # Register the spawned fn (first-write-wins — one size per fn).
                bool ts_already = false
                for tsf_rec in gmod.thread_spawned_fns:
                    if tsf_rec.fn_name == spawn_fn_name:
                        ts_already = true
                if not ts_already:
                    gmod.thread_spawned_fns.push(ThreadSpawnRec(spawn_fn_name.clone(), ts_ret_name.clone(), ts_ret_type, ts_stack_size))
                # Register the Thread__{ret_name} named type for the dst local
                # and emit the spawn call (no args — the wrapper is `(void)`).
                int ts_thread_ty = lookup_or_register_named(&gmod, ts_thread_name)
                # Typed thread-payload channel (sibling of the map_ast_type /
                # resolved_to_gir_type mint-site writes): an unannotated
                # `thread_spawn(f).join()` chain mints the handle type HERE,
                # so this site must record the payload too.
                record_thread_payload(&gmod, ts_thread_ty, ts_ret_type)
                int ts_dst = add_local(&ctx, ts_thread_ty, None)
                Vector[Operand] ts_args = []
                emit(&ctx, GICall(ts_dst, "__gorget_thread_spawn_" + spawn_fn_name, ts_args))
                ts_result = ts_dst
            else:
                pass
        result = ts_result
    elif (fname == "Vector" or fname == "Deque") and targs.len() == 1 and collection_ctor_has_cap_alloc_or_positional(args, arg_names):
        # NAMED-ARG MODELING — Vector/Deque capacity/allocator constructors.
        # Mirrors Rust gg `src/ir/lowering/exprs/calls.rs:972-1019`:
        #   • `cap=N`         → `__new()` + `reserve(&arr, N)`
        #   • positional int  → `Vector[int](10)` is a capacity hint → reserve too
        #   • `alloc=X`       → push_allocator(X); `__new()`; pop_allocator()
        # The parser keeps the value but DISCARDED the name, so `cap=`/`alloc=`/
        # positional `10` all arrived as ONE positional arg → the LIR appended
        # elem_size → `gorget_array_new(10, 8)` (CC-FAIL: too many args). With
        # `arg_names` carried on the AST we now split the args by name HERE: the
        # `__new` GICall is emitted with NO user args (so the LIR appends only
        # elem_size → `gorget_array_new(elem_size)`), then reserve/allocator
        # calls wrap it. The collection mangled name routes through the existing
        # `is_collection_constructor` LIR path that picks `gorget_array_new`.
        String coll_mangled = fname
        for cta in targs:
            coll_mangled = coll_mangled + "__" + type_to_c_name(cta, &gmod)
        int coll_ret = lookup_or_register_named(&gmod, coll_mangled)
        # Split the args into cap (named "cap" OR a lone positional) and alloc
        # (named "alloc"). `arg_names` is parallel to `args` ("" = positional).
        int cap_idx = -1
        int alloc_idx = -1
        int csa_i = 0
        while csa_i < args.len():
            String an = ""
            if csa_i < arg_names.len():
                an = arg_names.get(csa_i).unwrap()
            if an == "cap":
                cap_idx = csa_i
            elif an == "alloc":
                alloc_idx = csa_i
            elif an == "":
                # A lone positional arg on a collection ctor is a capacity hint.
                cap_idx = csa_i
            csa_i += 1
        # alloc= → push the active thread-local allocator before __new.
        if alloc_idx >= 0:
            int alloc_val = lower_expr(&ctx, args.get(alloc_idx).unwrap(), &gmod)
            Vector[Operand] push_args = [op_consume(ctx, &gmod, alloc_val, CkCallArgBorrow())]
            emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", push_args))
        # __new() — NO user args; the LIR collection-ctor path appends elem_size.
        int coll_dst = add_local(&ctx, coll_ret, None)
        Vector[Operand] coll_new_args = []
        emit(&ctx, GICall(coll_dst, coll_mangled, coll_new_args))
        register_local_for_drop(&ctx, coll_dst, coll_ret, &gmod)
        # alloc= → pop the allocator immediately after __new (one-shot, matches
        # Rust: only the allocation inside the ctor uses the arena).
        if alloc_idx >= 0:
            emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
        # cap= / positional → reserve(&arr, N). gorget_array_reserve takes the
        # array by pointer (arg 0, needs_ptr_arg) — OpBorrow(coll_dst) supplies
        # the pointer (OpCopy would FATAL validate_resource_moves on a resource
        # copy). The capacity scalar passes by value.
        if cap_idx >= 0:
            int cap_val = lower_expr(&ctx, args.get(cap_idx).unwrap(), &gmod)
            Vector[Operand] reserve_args = [OpBorrow(coll_dst), op_consume(ctx, &gmod, cap_val, CkCallArgBorrow())]
            emit(&ctx, GICallExtern(-1, "gorget_array_reserve", reserve_args))
        result = coll_dst
    elif allocator_constructor_runtime_name(fname) != "":
        # R9 FIDELITY — scoped-allocator constructor (`Arena(8192)`,
        # `PoolAllocator(sz, n)`, `TrackingAllocator()`, …). These are NOT
        # user-struct instantiations: the runtime returns an opaque handle
        # pointer (`GorgetArena*` etc.), so emit a runtime `gorget_<kind>_new`
        # CallExtern instead of routing through the user-struct constructor
        # path (which would build `Arena{_handle=...}` and deref garbage).
        # Mirrors Rust gg `src/ir/lowering/exprs/calls.rs:708-744`.
        #
        # ⚠ The dst MUST be a POINTER-to-named slot, NOT a bare named type:
        # the runtime fn returns a `GorgetArena*`, and a bare `Arena` slot
        # (C `struct __gg_Arena`) can't hold it (C type error). Rust
        # pre-registers allocators as `MutPtr(Named(...))`; the self-host has
        # no such pre-registration, so we register the Ptr explicitly here.
        # `type_id_to_base_name` unwraps `GtPtr`→"Arena" so later method
        # dispatch (`pool.bytes_used()`) still resolves on the type name.
        # NAMED-ARG MODELING — allocator ctors accept the cap=/alloc=/positional
        # split, the class completion of the String/collection ctor brackets
        # (round-39, mirroring Rust gg's `alloc_ctor` table in
        # `src/ir/lowering/exprs/calls.rs`). Every allocator runtime ctor
        # captures `__gorget_current_alloc` as its parent (struct + backing
        # buffer come from it, destroy releases back into it), so `alloc=a`
        # brackets the ctor via the SAME push/pop mechanism as the collection
        # ctors — the one-shot spelling of §15.3's nesting rule. Before this the
        # arm was named-arg-BLIND: it lowered EVERY arg positionally, so
        # `Arena(alloc=outer)` passed the Arena STRUCT as the byte capacity and
        # `Arena(cap=n, alloc=a)` passed two args to the 1-arg runtime ctor
        # (cc-fail). `arg_names` is parallel to `args` ("" = positional).
        String alloc_new_fn = allocator_constructor_runtime_name(fname)
        # Fixed positional arity (mirrors Rust's `alloc_ctor` table): -1 = one
        # OPTIONAL capacity (cap= OR a single positional; omitting → I64(0),
        # which hits the runtime default — Arena 4096 / TLSF 65536). 0 =
        # TrackingAllocator (no capacity axis). 2 = Pool/Fallback (two fixed
        # positionals, no cap= axis).
        int alloc_fixed_arity = -1
        if fname == "TrackingAllocator":
            alloc_fixed_arity = 0
        elif fname == "PoolAllocator" or fname == "FallbackAllocator":
            alloc_fixed_arity = 2
        # Split the args by name.
        int alloc_alloc_idx = -1
        int alloc_cap_idx = -1
        Vector[int] alloc_pos_idxs = []
        int aci = 0
        while aci < args.len():
            String an = ""
            if aci < arg_names.len():
                an = arg_names.get(aci).unwrap()
            if an == "alloc":
                alloc_alloc_idx = aci
            elif an == "cap":
                alloc_cap_idx = aci
            else:
                alloc_pos_idxs.push(aci)
            aci += 1
        # alloc= → push the active thread-local allocator before the ctor so its
        # struct AND backing buffer come from the chosen parent.
        bool alloc_bracketed = false
        if alloc_alloc_idx >= 0:
            int a_alloc_val = lower_expr(&ctx, args.get(alloc_alloc_idx).unwrap(), &gmod)
            emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", [op_consume(ctx, &gmod, a_alloc_val, CkCallArgBorrow())]))
            alloc_bracketed = true
        Vector[Operand] alloc_args = []
        if alloc_fixed_arity < 0:
            # One optional capacity: cap= OR a single positional, else I64(0).
            int a_cap_src = -1
            if alloc_cap_idx >= 0:
                a_cap_src = alloc_cap_idx
            elif alloc_pos_idxs.len() > 0:
                a_cap_src = alloc_pos_idxs.get(0).unwrap()
            if a_cap_src >= 0:
                int a_cap_val = lower_expr(&ctx, args.get(a_cap_src).unwrap(), &gmod)
                alloc_args.push(op_consume(ctx, &gmod, a_cap_val, CkCallArgBorrow()))
            else:
                alloc_args.push(OpConstI64(0))
        else:
            # Fixed positional signature (Pool/Fallback = 2; Tracking = 0).
            int api = 0
            while api < alloc_pos_idxs.len():
                int a_pv = lower_expr(&ctx, args.get(alloc_pos_idxs.get(api).unwrap()).unwrap(), &gmod)
                alloc_args.push(op_consume(ctx, &gmod, a_pv, CkCallArgBorrow()))
                api += 1
        int alloc_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, fname))
        int alloc_dst = add_local(&ctx, alloc_ptr_ty, None)
        emit(&ctx, GICallExtern(alloc_dst, alloc_new_fn, alloc_args))
        # alloc= → pop immediately after the ctor (one-shot; only the ctor's own
        # allocation uses the parent).
        if alloc_bracketed:
            emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
        result = alloc_dst
    elif (fname == "Mutex" or fname == "RWLock") and targs.len() == 1 and args.len() == 1:
        # SYNC FIDELITY — GENERIC sync-primitive ctor `Mutex[T](v)` /
        # `RWLock[T](v)`. These are PARAMETERISED opaque handles: the runtime
        # ctor `gorget_mutex_new(size_t, void* init)` returns a `GorgetMutex*`.
        # Emit a mangled `Mutex__<elem_c>__new` GICall: `map_runtime_name`'s
        # opaque-method-prefix dispatch remaps it to `gorget_mutex_new`, and the
        # generalized concurrency-ctor reorder in lir_lower.gg computes
        # `sizeof(T)` and swaps the args to `gorget_mutex_new(size, &val)`. The
        # dst is a POINTER-to-named slot (a bare value slot can't hold the
        # handle). Mirrors Rust gg `src/ir/lowering/exprs/mod.rs:1791-1806`
        # (Mutex) and `:1840-1857` (RWLock) — both route through
        # `<kind>__<inner>__new(val)` → LIR `gorget_<kind>_new(sizeof, &val)`
        # (insts.rs:3437-3446).
        String gen_elem_c = type_to_c_name(targs.get(0).unwrap(), &gmod)
        String gen_mangled = fname + "__" + gen_elem_c
        String gen_new_fn = gen_mangled + "__new"
        int gen_val = lower_expr(&ctx, args.get(0).unwrap(), &gmod)
        Vector[Operand] gen_args = [op_consume(ctx, &gmod, gen_val, CkCallArgBorrow())]
        int gen_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, gen_mangled))
        int gen_dst = add_local(&ctx, gen_ptr_ty, None)
        emit(&ctx, GICall(gen_dst, gen_new_fn, gen_args))
        result = gen_dst
    elif sync_constructor_runtime_name(fname) != "":
        # SYNC FIDELITY — non-generic sync-primitive constructor
        # (`AtomicInt(0)`, `OnceFlag()`, `Semaphore(n)`, …). Same shape as the
        # allocator branch above: the runtime returns an opaque handle pointer
        # (`GorgetAtomicInt*` etc.), so emit `gorget_<kind>_new` and register
        # the dst as a POINTER-to-named slot (a bare value slot can't hold the
        # `GorgetAtomicInt*`). Mirrors Rust gg calls.rs:851 / exprs/mod.rs:1652.
        String sync_new_fn = sync_constructor_runtime_name(fname)
        Vector[Operand] sync_args = []
        # CoW for-element BORROW scan (no SpannedExpr__clone): sarg is only read
        # by lower_expr's immutable-borrow param.
        for sarg in args:
            int sval = lower_expr(&ctx, sarg, &gmod)
            sync_args.push(op_consume(ctx, &gmod, sval, CkCallArgBorrow()))
        int sync_ptr_ty = register_ptr(&gmod, lookup_or_register_named(&gmod, fname))
        int sync_dst = add_local(&ctx, sync_ptr_ty, None)
        emit(&ctx, GICallExtern(sync_dst, sync_new_fn, sync_args))
        result = sync_dst
    elif fname == "Channel" and targs.len() == 1 and call_has_named_cap_or_alloc(arg_names):
        # NAMED-ARG MODELING — Channel[T] cap=/alloc= split (round-39, mirroring
        # Rust gg's `if name == "Channel"` branch in
        # `src/ir/lowering/exprs/calls.rs`). §15.3 lists Channel among the
        # alloc=-accepting ctors and the runtime snapshots
        # `__gorget_current_alloc` into `ch->alloc` at construction
        # (channel_runtime.c gorget_channel_new), so the bracket is sticky for
        # the ring buffer + waiter arrays. Before this the plain generic-ctor
        # tail read the args positionally: `Channel[int](alloc=a)` passed the
        # allocator struct AS the capacity (NULL ring buffer → SIGSEGV on first
        # send) and `Channel[int](cap=4, alloc=a)` passed TWO args to the 1-arg
        # `Channel__T` ctor (cc "too many arguments to gorget_channel_new").
        # GATED to the named-arg forms so the plain `Channel[int](4)` path stays
        # on the unchanged generic tail. Emits the SAME single-arg
        # `Channel__<elem_c>(cap)` GICall the plain path does (the LIR
        # concurrency-ctor reorder appends elem_size → gorget_channel_new).
        String chan_mangled = "Channel"
        for cta in targs:
            chan_mangled = chan_mangled + "__" + type_to_c_name(cta, &gmod)
        int chan_ret = lookup_or_register_named(&gmod, chan_mangled)
        # Split cap (named "cap" OR a lone positional) and alloc (named "alloc").
        int chan_cap_idx = -1
        int chan_alloc_idx = -1
        int chci = 0
        while chci < args.len():
            String cn = ""
            if chci < arg_names.len():
                cn = arg_names.get(chci).unwrap()
            if cn == "alloc":
                chan_alloc_idx = chci
            elif cn == "cap":
                chan_cap_idx = chci
            elif cn == "" and chan_cap_idx < 0:
                chan_cap_idx = chci
            chci += 1
        bool chan_bracketed = false
        if chan_alloc_idx >= 0:
            int chan_alloc_val = lower_expr(&ctx, args.get(chan_alloc_idx).unwrap(), &gmod)
            emit(&ctx, GICallExtern(-1, "__gorget_push_allocator", [op_consume(ctx, &gmod, chan_alloc_val, CkCallArgBorrow())]))
            chan_bracketed = true
        # cap= / positional → the capacity scalar; omitted → 0 (rendezvous).
        Operand chan_cap_op = OpConstI64(0)
        if chan_cap_idx >= 0:
            int chan_cap_val = lower_expr(&ctx, args.get(chan_cap_idx).unwrap(), &gmod)
            chan_cap_op = op_consume(ctx, &gmod, chan_cap_val, CkCallArgBorrow())
        int chan_dst = add_local(&ctx, chan_ret, None)
        emit(&ctx, GICall(chan_dst, chan_mangled, [chan_cap_op]))
        if chan_bracketed:
            emit(&ctx, GICallExtern(-1, "__gorget_pop_allocator", []))
        result = chan_dst
    else:
        # Compute mangled name for generic calls
        String call_name = fname
        if targs.len() > 0:
            for ta in targs:
                call_name = call_name + "__" + type_to_c_name(ta, &gmod)
        else:
            # R43-C: a turbofish-free generic free-fn call — infer its type-args
            # from the arg types (same helper the discovery pre-pass uses) so the
            # emitted GICall targets the monomorphized symbol
            # (`passthrough` → `passthrough__int64_t__AppError`). `fn_sigs` under
            # the mangled name then yields the SUBSTITUTED return type for the
            # dst-slot below (no separate return-type fix needed). Empty result
            # ⇒ not an inferred generic call ⇒ `call_name` stays `fname`.
            Vector[SpannedType] inf_targs = infer_free_fn_targs(fname, args, arg_names, gmod)
            for ta in inf_targs:
                call_name = call_name + "__" + type_to_c_name(ta, &gmod)
        # Resolve call redirects (bare → module-prefixed name).
        if gmod.call_redirects.contains(call_name):
            call_name = gmod.call_redirects.get(call_name).unwrap()
        # Resolve a TYPE-ALIAS struct/enum constructor through `meta_aliases`
        # (`type Handle = SlotKey` then `Handle(7, 0)`). The alias item is
        # erased in GIR, so `call_name = "Handle"` reaches the ctor path with
        # no entry in `type_infos` → the struct/enum-ctor field-init resolution
        # below sees no fields → emits an empty `(Handle){}` with the ctor args
        # DROPPED (and `h.id` reads a placeholder 0). `meta_aliases` already
        # records `Handle → SlotKey` (lower.gg's ITypeAlias collection, keyed
        # by the alias name for a 0-tparam `TNamed` target); rewrite `call_name`
        # to the aliased name HERE, before the downstream ctor resolution, so
        # `type_infos`/`is_type_constructor`/the field-init loop/the ret_type
        # block/the emitted `GICall` all see the REAL struct. SCOPE: gated on
        # the resolved target being a declared struct/enum (`type_infos`
        # contains it) — a TYPED discriminator (no name matching). A primitive
        # alias (`type Id = int`, target `"int"`) and a COLLECTION alias
        # (`type IntList = Vector[int]`, stored as bare `"Vector"`) both have a
        # target ABSENT from `type_infos`, so they fall through unchanged (the
        # collection-alias targ-drop is a separate, deeper item). Guard on a
        # non-mangled name (`not contains("__")`) so a monomorphized generic
        # `call_name` can't accidentally alias-resolve.
        if not call_name.contains("__") and gmod.meta_aliases.contains(call_name):
            String _alias_target = gmod.meta_aliases.get(call_name).unwrap()
            if gmod.type_infos.contains(_alias_target):
                call_name = _alias_target
        # User function call
        Vector[Operand] gir_args = []
        # Look up borrow params from pre-scanned ownership info
        Vector[bool] borrow_flags = []
        if gmod.fn_borrow_params.contains(call_name):
            borrow_flags = gmod.fn_borrow_params.get(call_name).unwrap()
        # Resolve callee param types ONCE for the call-arg expected_type
        # propagation. Mirrors Rust gg's call-arg path at
        # `src/ir/lowering/exprs/calls.rs:1228-1255` — set
        # `ctx.expected_type = param_types[i]` BEFORE recursing into
        # `lower_expr` for each arg, then restore. Reader sites
        # (bare prelude-variant ctors, bare `None`, EIdentifier) thus
        # type their result to the parameter's declared shape rather
        # than to the bare variant name — fixes the NULL-give-up class
        # for `f(Ok(x))` / `f(None)` / etc. at non-return user-level
        # consume positions.
        Vector[int] callee_param_types = get_fn_param_types(call_name, gmod)
        # Prelude-variant ctor arg expected-type, off the typed enum-category
        # channel. `Ok`/`Error`/`Some` aren't real fns (no `callee_param_types`),
        # so a nested ctor arg like `Ok(None())` / `Some(Box(x))` would lower
        # its inner with no expected type and mis-slot it (`None()` typed
        # `int64_t` instead of `Option__int64_t`). When the ENCLOSING
        # `expected_type` is a recorded `Result__`/`Option__`, the arg's
        # expected type IS that enum's Ok/Error/Some payload — read it from the
        # channel (CLAUDE.md "No name matching"; the same typed fact the field
        # shape and match-destructure read). -1 when not a variant ctor / no
        # record / no enclosing expectation.
        int variant_arg_expected = -1
        if fname == "Ok" or fname == "Error" or fname == "Some":
            EnumCategory pvec = enum_category_of(&gmod, ctx.expected_type)
            if pvec.category == ENUM_CAT_RESULT:
                if fname == "Ok":
                    variant_arg_expected = pvec.ok_type
                elif fname == "Error":
                    variant_arg_expected = pvec.err_type
            elif pvec.category == ENUM_CAT_OPTION and fname == "Some":
                variant_arg_expected = pvec.ok_type
        # User struct/enum-variant ctor arg expected-type (mirrors Rust gg
        # `calls.rs:1080-1137`: resolve the ctor's declared field types and set
        # `expected_type = field_types[i]` per arg before lowering it).
        # `get_fn_param_types` returns [] for a struct/variant ctor (neither is
        # a real function), so without this an `Option[Box[T]]`/`Option[...]`
        # field arg like `If(.., .., None())` or `R(.., None())` lowers its
        # inner `None()` with no expectation → mis-slotted `int64_t` instead of
        # the registered `Option__Box__T`/`Option__Box__R` (cc-fail
        # "incompatible types assigning to int64_t"). Read the field type off
        # the type_infos field channel — for a struct ctor directly, for a
        # variant ctor one indirection deeper via the parent enum — the same
        # typed source `apply_container_hint_for_ctor_arg` reads (no name
        # matching). `user_ctor_enum` empty when `call_name` isn't a resolved
        # ctor / has primitive (I64) field types only.
        String user_ctor_enum = ""
        String user_ctor_variant = ""
        if callee_param_types.len() == 0 and variant_arg_expected < 0:
            if gmod.type_infos.contains(call_name) and not gmod.type_infos.get(call_name).unwrap().is_enum:
                # Struct ctor: type_infos keyed by the struct name; the variant
                # arg of lookup_ctor_field_type is unused for structs.
                user_ctor_enum = call_name
                user_ctor_variant = ""
            else:
                String _uce_parent = enum_variant_parent(call_name, gmod)
                if _uce_parent != "" and gmod.type_infos.contains(_uce_parent):
                    user_ctor_enum = _uce_parent
                    user_ctor_variant = call_name
        int first_arg_type = -1
        # Ownership at Consuming Positions: a struct/enum CONSTRUCTOR's
        # field-init is a consuming position — the destination field must
        # OWN, so each arg routes through `CkFieldWrite` (clone-if-live,
        # move-if-dead). A plain function call instead borrows bare `T`
        # args (CoW-default-borrow) via `classify_call_arg`. The TWO-ARM
        # ctor discriminator is the canonical idiom this fn already uses at
        # the ret_type block (`:7823`+`:7832`): `is_type_constructor` for
        # plain user-struct / prelude-variant ctors, `type_infos.contains`
        # for the MONOMORPHIZED ctor whose mangled name contains `__` (which
        # `is_type_constructor` explicitly excludes `:3661`) — e.g. the
        # lazy-adapter `MapIter__…__GorgetClosure`, registered in
        # `type_infos` under its mangled name. Both arms are TYPED (no name
        # match). Without CkFieldWrite the ctor's resource arg is a borrow →
        # shallow memcpy into the field → the source and the field alias one
        # buffer → both drop → double-free (the adapter `inner`/`f` fields).
        bool is_ctor_call = is_type_constructor(call_name, &gmod) or gmod.type_infos.contains(call_name)
        # Named-argument REORDERING (free-function calls only). The arg loop
        # below binds args POSITIONALLY (`ai` = the param index), and the
        # trailing default-fill is APPEND-ONLY. So a named arg that SKIPS a
        # middle defaulted param (`compute(5, offset=10)` — `factor` keeps its
        # default) would land `offset` into `factor`'s slot and never fill
        # `factor`. Fix: when a named arg is present and we know the callee's
        # ordered param names, build a reordered `r_args` in PARAM order —
        # named args by NAME, positionals into the next free slot, empty slots
        # from `fn_defaults` — then iterate THAT. Mirrors Rust gg's
        # `resolve_call_args` (`src/ir/lowering/exprs/calls.rs:386-445`).
        # SCOPED to free-function calls: ctor field-init keeps its existing
        # by-index handling (`is_ctor_call` guard); the method-call path uses
        # a different lowering and is untouched.
        bool did_reorder = false
        Vector[SpannedExpr] r_args = []
        bool nr_has_named = false
        int nr_i = 0
        while nr_i < arg_names.len():
            if arg_names.get(nr_i).unwrap() != "":
                nr_has_named = true
            nr_i += 1
        if nr_has_named and not is_ctor_call and gmod.fn_param_names.contains(call_name):
            Vector[String] r_pnames = gmod.fn_param_names.get(call_name).unwrap()
            int r_n = r_pnames.len()
            # Slot array in param order; each slot tracks whether it's filled
            # and (when filled) holds the SpannedExpr to lower at that index.
            Vector[bool] r_slot_filled = []
            Vector[SpannedExpr] r_slot_expr = []
            int rs_i = 0
            while rs_i < r_n:
                r_slot_filled.push(false)
                # Placeholder expr (overwritten on fill); never lowered while
                # r_slot_filled[i] is false.
                r_slot_expr.push(args.get(0).unwrap())
                rs_i += 1
            # Place args: named by NAME-slot, positional into next free slot.
            bool r_ok = true
            int r_pos = 0
            int ra_i = 0
            while ra_i < args.len() and r_ok:
                String ra_name = ""
                if ra_i < arg_names.len():
                    ra_name = arg_names.get(ra_i).unwrap()
                if ra_name != "":
                    # Named — find its param index.
                    int r_target = -1
                    int rp_i = 0
                    while rp_i < r_n:
                        if r_pnames.get(rp_i).unwrap() == ra_name:
                            r_target = rp_i
                        rp_i += 1
                    if r_target < 0:
                        # Unknown param name → fall back to the positional path.
                        r_ok = false
                    else:
                        r_slot_filled.set(r_target, true)
                        r_slot_expr.set(r_target, args.get(ra_i).unwrap())
                else:
                    # Positional → next free slot in order.
                    while r_pos < r_n and r_slot_filled.get(r_pos).unwrap():
                        r_pos += 1
                    if r_pos < r_n:
                        r_slot_filled.set(r_pos, true)
                        r_slot_expr.set(r_pos, args.get(ra_i).unwrap())
                        r_pos += 1
                    else:
                        # More positionals than params → fall back.
                        r_ok = false
                ra_i += 1
            # Fill empty slots from the callee's parsed defaults.
            if r_ok:
                Vector[Option[SpannedExpr]] r_defaults = []
                if gmod.fn_defaults.contains(call_name):
                    r_defaults = gmod.fn_defaults.get(call_name).unwrap()
                elif gmod.fn_defaults.contains(fname):
                    r_defaults = gmod.fn_defaults.get(fname).unwrap()
                int rf_i = 0
                while rf_i < r_n and r_ok:
                    if not r_slot_filled.get(rf_i).unwrap():
                        if rf_i < r_defaults.len():
                            match r_defaults.get(rf_i).unwrap():
                                case Some(rd_expr):
                                    r_slot_filled.set(rf_i, true)
                                    r_slot_expr.set(rf_i, rd_expr)
                                case None:
                                    # No default for an unfilled slot → malformed
                                    # call; fall back to the positional path
                                    # rather than lower a placeholder.
                                    r_ok = false
                        else:
                            r_ok = false
                    rf_i += 1
            # Only commit the reorder if every slot is now filled.
            if r_ok:
                int rc_i = 0
                while rc_i < r_n:
                    r_args.push(r_slot_expr.get(rc_i).unwrap())
                    rc_i += 1
                did_reorder = true
        # CoW for-element BORROW scan (no SpannedExpr__clone): arg is only read
        # (apply_container_hint/lower_expr/match arg.expr — all immutable-borrow
        # uses); enumerate() preserves the positional arg index ai. When we
        # reordered, iterate the freshly-built `r_args` (each element a deep
        # `.get().unwrap()` clone — independently owned, so dropping `r_args` on
        # scope exit does NOT alias/double-free the caller's `args`). When we did
        # NOT reorder, iterate the BORROWED `args` directly — the original
        # zero-clone path. (A whole-vector `Vector[SpannedExpr] x = args` shallow-
        # CoW aliases the inner buffers → double-free; the `Vector[SpannedExpr]`-
        # by-value self-host gap, lower_expr.gg:4538.) Selected via a per-element
        # index read below so there is exactly ONE loop body.
        int call_arg_count = args.len()
        if did_reorder:
            call_arg_count = r_args.len()
        int ai = 0
        while ai < call_arg_count:
            # Per-element read of the active source. When reordered, `r_args`
            # holds independently-owned deep clones (each from a single
            # `.get().unwrap()`), so binding `arg` from it does NOT alias the
            # caller's `args` → no double-free on scope exit. In the common path
            # `args.get(ai)` reads the caller's vector. `arg` is READ-ONLY in the
            # body (lower_expr / apply_container_hint / match arg.expr all borrow
            # it), so the per-element clone is semantically identical to the
            # original for-element borrow scan. The init reads `args.get(0)`
            # (always in-bounds: the loop runs only when `call_arg_count > 0`,
            # which guarantees `args.len() >= 1`) and is immediately overwritten
            # from the correct source — `r_args` may be LONGER than `args` (it
            # includes the reorder's filled defaults) and `r_args` is EMPTY when
            # not reordered, so the source MUST be selected by the flag.
            SpannedExpr arg = args.get(0).unwrap()
            if did_reorder:
                arg = r_args.get(ai).unwrap()
            else:
                arg = args.get(ai).unwrap()
            # For struct-constructor calls, hint the container-literal
            # element size for each positional arg using the target field's
            # declared type. Look up type_infos inline (per-arg) — keeping
            # the GirTypeInfo as a local across iterations tripped a
            # field-move issue in the self-host compiler; querying anew
            # each time sidesteps it. Without this, `LowerCtx([], ..., {},
            # ...)` keeps scalar-sized allocators for the Vector/Dict
            # fields and later pushes corrupt adjacent slots.
            apply_container_hint_for_ctor_arg(&ctx, call_name, ai, arg, gmod)
            # Expected-type propagation per arg (Rust calls.rs:1239-1255).
            # The arg's destination is the PARAM type, NOT the surrounding
            # context — so START by clearing any leaked `expected_type` (e.g. a
            # `Result[T,E]` from an enclosing `throws` return, `return f(g(x))`).
            # Otherwise the centralized auto-prop hook's capture-form check
            # would see that leaked Result and wrongly suppress the peel on a
            # throws-call arg passed to a NON-Result (e.g. `int`) param — the
            # case (3) `double_it(might(x))` regression. Then set the param type
            # for non-primitive params (so bare None/Ok reader sites resolve).
            int prev_expected_arg = ctx.expected_type
            ctx.expected_type = -1
            if ai < callee_param_types.len():
                int pt = callee_param_types.get(ai).unwrap()
                # Peel the bare-resource-param ABI wrapper. `lower_function`
                # Ptr-wraps bare resource params (by-pointer ABI) and that
                # WRAPPED tid is what GirFunction.param_types records — but
                # the arg EXPRESSION's expected type is the VALUE type; the
                # pointer-ness is the call's ABI concern (OpBorrow at the
                # consume site), not the arg producer's. Without the peel, a
                # bare `None` arg against an `Option[String]` param types its
                # dst local as the Ptr tid → scalar LIR slot → the
                # prelude-variant intercept falls back → cc-invalid
                # `(Option__T){.tag=1}` assigned into an int64 temp (the
                # split-attempt's stage-1 cc failure, 146 sites). GtMutPtr
                # (`&`/`!` params) stays unpeeled: those args are explicitly
                # sigiled at source.
                if pt >= PRIM_COUNT and pt < gmod.type_table.len():
                    match gmod.type_table.get(pt).unwrap():
                        case GtPtr(pt_inner):
                            pt = pt_inner
                        else:
                            pass
                if pt != I64_TYPE and pt != UNIT_TYPE:
                    ctx.expected_type = pt
            # Prelude-variant ctor (Ok/Error/Some): no callee_param_types, so
            # use the channel-derived payload type as the arg's expectation
            # (the `ai == 0` payload position). This is what makes a nested
            # `Ok(None())` type its inner `None()` to the Ok payload.
            elif ai == 0 and variant_arg_expected >= 0:
                ctx.expected_type = variant_arg_expected
            # User struct/enum-variant ctor: each arg's expectation is the
            # ctor's declared field type at this index (Rust gg `calls.rs:1093`
            # / `:1128`). Struct → the type's `fields[ai]`; variant → the parent
            # enum's matching-variant `fields[ai]` (lookup_ctor_field_type).
            elif user_ctor_enum != "":
                int _ucft = I64_TYPE
                if user_ctor_variant == "":
                    String _ucft_name = ""
                    GirTypeInfo _ucti = gmod.type_infos.get(user_ctor_enum).unwrap()
                    if ai < _ucti.fields.len():
                        _ucft_name = _ucti.fields.get(ai).unwrap().type_name.clone()
                    if _ucft_name != "":
                        _ucft = resolve_field_gir_type(_ucft_name, &gmod)
                else:
                    _ucft = lookup_ctor_field_type(user_ctor_enum, user_ctor_variant, ai, &gmod)
                if _ucft != I64_TYPE and _ucft != UNIT_TYPE:
                    ctx.expected_type = _ucft
            # `&*b` / `!*b` at a by-pointer param — pass the box POINTER, not
            # a value-load. The parser stripped the `&`/`!` sigil, so the arg
            # is a bare `EDeref(box)` here; the callee's param is by-pointer
            # (`&T`/`!T` → borrow_flags / GtMutPtr). `lower_expr(*box)` would
            # value-LOAD the pointee into a stack copy → the callee mutates the
            # copy (box_deref_write `mutate(&*b2)` shape, Snag #26). The box
            # VALUE is itself the heap pointer; lower the BOX directly so the
            # arg-prep's `lir_slot_is_box` (lir_lower.gg:3265) passes the box
            # pointer = a pointer straight to the heap pointee. Mirrors Rust gg
            # modelling `&*b` as a borrow of `Place{box,[Deref]}`.
            bool ad_param_by_ptr = false
            if ai < borrow_flags.len() and borrow_flags.get(ai).unwrap():
                ad_param_by_ptr = true
            if not ad_param_by_ptr and ai < callee_param_types.len():
                match gmod.type_table.get(callee_param_types.get(ai).unwrap()).unwrap():
                    case GtMutPtr(_):
                        ad_param_by_ptr = true
                    else:
                        pass
            int arg_local = -1
            bool ad_handled = false
            if ad_param_by_ptr:
                match arg.expr:
                    case EDeref(ad_box):
                        # Lower the inner box ONCE; reuse the local on both the
                        # box and the (defensive) non-box path. `&*<non-box>` is
                        # a `gg check` error (typecheck DerefNonBox), so `None`
                        # is unreachable from valid source — but if it ever
                        # reaches here, falling through to `lower_expr(arg)`
                        # below re-lowers the whole `EDeref`, EXECUTING the inner
                        # a SECOND time. Reuse `ad_box_local` to lower once.
                        int ad_box_local = lower_expr(&ctx, *ad_box, &gmod)
                        int ad_box_tid = ctx.locals.get(ad_box_local).unwrap().type_id
                        match box_deref_inner_name(type_id_to_name(ad_box_tid, &gmod), &gmod):
                            case Some(_):
                                arg_local = ad_box_local
                                ad_handled = true
                            case None:
                                # Non-box `&*x` — invalid per typecheck. Reuse
                                # the already-lowered inner; do NOT re-lower.
                                arg_local = ad_box_local
                                ad_handled = true
                    case EIdentifier(ad_name):
                        # `&value` where `value` is a module-level scalar STATIC.
                        # The parser strips the `&` sigil, so this reaches the arg
                        # loop as a bare `EIdentifier`. Falling through to
                        # `lower_expr(arg)` routes through `lower_static_ref_ident`,
                        # which types the dst as the static's OWN scalar type — so
                        # `lir_lower`'s scalar-read gate (`lir_lower.gg`:
                        # `lir_is_scalar(slot_ty) and not ptr-kind`) LOADS the value
                        # into a stack temp, and `OpBorrow` then borrows the THROWAWAY
                        # temp: the callee mutates the copy, the static stays 0.
                        #
                        # Fix: emit `__global_ref__<name>` into a `GtMutPtr`-typed dst.
                        # The PTR-kind slot makes `gr_slot_is_ptr_kind` true →
                        # the scalar-load gate is SKIPPED → `IGlobalAddr` yields
                        # `&__lir_gN` straight through, and `OpBorrow` passes the
                        # global's REAL address to the callee. Emitted C goes from
                        # load-into-temp to `set_to(&__lir_g0, 42)`. Mirrors Rust gg's
                        # `Constant::GlobalRefPtr` (addr-only, no load —
                        # `src/lir/lower/operands.rs:128-134`); identical shape to the
                        # static place-base arm in `lower_place_base`
                        # (`lower_stmt.gg`). GATED on a TRUE static
                        # (`static_contains and not nl_contains`): a name-local /
                        # param shadow falls through to the existing `lower_expr(arg)`
                        # path below, so this hot arg-lowering path is unchanged for
                        # everything that is not a module-level static.
                        if static_contains(gmod, ad_name) and not nl_contains(ctx, ad_name):
                            int ad_sty = static_lookup_type(gmod, ad_name)
                            int ad_pty = register_type(&gmod, GtMutPtr(ad_sty))
                            int ad_pdst = add_local(&ctx, ad_pty, None)
                            Vector[Operand] ad_no_args = []
                            emit(&ctx, GICallExtern(ad_pdst, "__global_ref__" + ad_name, ad_no_args))
                            arg_local = ad_pdst
                            ad_handled = true
                    else:
                        pass
            # ── R37 T1 (S5 site 1): CoW G2 `&`-of-a-bare-value FORMATION.
            # A `&t` call arg (parser strips the sigil; callee param is `&T` =
            # borrow_flags[ai]) passing a bare immutable-in-context resource must
            # materialize a private copy at the FORMATION site. Only PROJECTED /
            # bare-param roots that the helper accepts clone; a `&`/`!`/owned/POD
            # root is skipped. Mirrors Rust G2 site 1 (calls.rs, 2c7fbf04).
            if ai < borrow_flags.len() and borrow_flags.get(ai).unwrap():
                cow_materialize_projected_root(&ctx, &gmod, arg)
                # FAMILY-1: `&<projection>` borrows THE PLACE. Strictly AFTER
                # the materialize above (which may replace the projection ROOT
                # with a private copy) and BEFORE the value-read fallback
                # below, so the place we resolve is the post-materialize one.
                # Declining (-1) falls through to the unchanged value read.
                if not ad_handled:
                    int amp_place = lower_amp_place(&ctx, arg, &gmod)
                    if amp_place >= 0:
                        arg_local = amp_place
                        ad_handled = true
            if not ad_handled:
                arg_local = lower_expr(&ctx, arg, &gmod)
            ctx.expected_type = prev_expected_arg
            # Auto-propagate a `throws` call passed as an argument
            # (`f(might())` unwraps; `f(r)` where the param is Result keeps the
            # raw Result). Skip when the callee's param IS a Result__ — don't
            # unwrap into a parameter that wants the Result. Ctor args flow
            # through this same loop, so struct/enum-field ctors are covered.
            bool arg_param_is_result = false
            if ai < callee_param_types.len():
                # `callee_param_types` wraps `&`/`!` params in GtMutPtr and bare
                # by-value resource-payload Result params in GtPtr (see
                # `lower_function`); `enum_category_of` peels internally, so a
                # borrowed/by-ptr Result param still classifies as a Result and
                # `maybe_auto_propagate` is correctly skipped.
                arg_param_is_result = enum_category_of(&gmod, callee_param_types.get(ai).unwrap()).category == ENUM_CAT_RESULT
            if not arg_param_is_result:
                arg_local = maybe_auto_propagate(&ctx, arg_local, &gmod)
            if ai == 0 and arg_local >= 0 and arg_local < ctx.locals.len():
                first_arg_type = ctx.locals.get(arg_local).unwrap().type_id
            # Detect &arg (borrow) or pre-scanned borrow param
            bool is_borrow = false
            match arg.expr:
                case EMutableBorrow(_):
                    is_borrow = true
                else:
                    pass
            if not is_borrow and ai < borrow_flags.len():
                is_borrow = borrow_flags.get(ai).unwrap()
            # Borrow-typed ctor field (`Ref[T]` / `MutRef[T]`): the field IS a
            # pointer, so a Ptr-typed source operand is exactly what we want
            # stored — the field aliases the source, it does not copy. Cloning
            # at `CkFieldWrite` would deref+copy the pointee into a fresh stack
            # local and then store ITS address into the field → a dangling
            # pointer the instant the stack local dies (the `DictIter.source`
            # = `Ref[Dict[K,V]]` slice-view-to-stack-local UAF: the map is
            # cloned into a stack `GorgetMap`, `source` points at it, on
            # `Dict__iter` return the stack map dies → `DictIter__next` reads
            # garbage → empty iteration). Resolve the ctor field's declared
            # GIR type at this arg index (same TYPED `type_infos` /
            # `lookup_ctor_field_type` channel the `_ucft` expected-type block
            # above reads — NO name matching) and, when it is `GtPtr`/`GtMutPtr`,
            # store the borrow pointer THROUGH (`OpBorrow`) instead of the owning
            # clone. Mirrors Rust gg `lower_struct_literal`
            # (`src/ir/lowering/exprs/mod.rs:1994-2001`: `field_is_ptr =
            # matches!(field_type, Ptr | MutPtr)` → `continue` to skip the
            # owning boundary). `user_ctor_enum`/`user_ctor_variant` are the
            # already-resolved struct/parent-enum + variant names (set above for
            # the `callee_param_types.len() == 0` ctor case that borrow-field
            # structs like `DictIter` take).
            bool ctor_field_is_ptr = false
            if is_ctor_call and user_ctor_enum != "":
                int _cfpt = I64_TYPE
                if user_ctor_variant == "":
                    String _cfpt_name = ""
                    GirTypeInfo _cfpti = gmod.type_infos.get(user_ctor_enum).unwrap()
                    if ai < _cfpti.fields.len():
                        _cfpt_name = _cfpti.fields.get(ai).unwrap().type_name.clone()
                    if _cfpt_name != "":
                        _cfpt = resolve_field_gir_type(_cfpt_name, &gmod)
                else:
                    _cfpt = lookup_ctor_field_type(user_ctor_enum, user_ctor_variant, ai, &gmod)
                if _cfpt >= 0 and _cfpt < gmod.type_table.len():
                    match gmod.type_table.get(_cfpt).unwrap():
                        case GtPtr(_):
                            ctor_field_is_ptr = true
                        case GtMutPtr(_):
                            ctor_field_is_ptr = true
                        else:
                            pass
            # #37 Phase 2 hook 2 (free-call `&`/`!` args): a `&v` / `!v`
            # call arg lets the callee mutate (or drop) the collection —
            # a mutation site for the lazy family. The parser DISCARDS
            # the sigils (skip_ownership_markers), so the hook is
            # SIGNATURE-driven (`is_borrow` from fn_borrow_params; `!`
            # via classify_call_arg → CkCallArgOwning) on the
            # redirect-RESOLVED `call_name`, mirroring the scan's F1 arm.
            # Guards emit BEFORE the call.
            if ctx.cow_lazy_members.len() > 0:
                bool lz_arg_mut = is_borrow
                if not lz_arg_mut:
                    lz_arg_mut = is_consume_kind(classify_call_arg(gmod, call_name, ai))
                if lz_arg_mut:
                    cow_lazy_materialize_family(&ctx, cow_source_root_name(arg))
            if is_borrow:
                # Phase C step 5b + Path A receiver-dispatch (2026-05-21):
                # the callee declared this param as `&T` (OWN_MUTABLE)
                # OR the caller wrote `&x` syntactically. Either way it
                # is a borrow position: the local stays alive past the
                # call. A LoBorrowed source must propagate as OpBorrow
                # (moving a borrow is a use-after-free); for owned
                # sources, route through classify_call_arg — for a
                # borrow-declared param this naturally returns
                # CkCallArgBorrow → OpBorrow, never OpMove. The previous
                # hardcoded OpMove for owned sources was a Path A bug
                # (over-consumption: turned alias reads into moves at
                # call boundaries).
                GirLocal arg_loc = ctx.locals.get(arg_local).unwrap()
                match arg_loc.ownership:
                    case LoBorrowed():
                        gir_args.push(OpBorrow(arg_local))
                    else:
                        if is_ctor_call and ctor_field_is_ptr:
                            # Borrow-typed field: store the pointer through, no clone.
                            gir_args.push(OpBorrow(arg_local))
                        elif is_ctor_call:
                            gir_args.push(op_consume(ctx, &gmod, arg_local, CkFieldWrite()))
                        else:
                            gir_args.push(op_consume(ctx, &gmod, arg_local, classify_call_arg(gmod, call_name, ai)))
            else:
                # Phase C step 5c + Path A bugfix (2026-05-21): pick the
                # ConsumeKind from the callee's param ownership. bare `T`
                # → CkCallArgBorrow (Ptr alias propagation, no clone);
                # `!T` → CkCallArgOwning (drives OpMove/OpClone). The
                # outer `is_borrow` branch already handled `&T` params.
                # A constructor field-init is a CONSUME position (the field
                # must own) → CkFieldWrite; see `is_ctor_call` above. EXCEPT a
                # borrow-typed field (`Ref[T]`/`MutRef[T]`) — the field IS the
                # pointer, so store the borrow THROUGH (`OpBorrow`), never the
                # owning deref+copy-into-stack-local that dangles (see
                # `ctor_field_is_ptr` resolution above; Rust gg mod.rs:1994).
                if is_ctor_call and ctor_field_is_ptr:
                    gir_args.push(OpBorrow(arg_local))
                elif is_ctor_call:
                    gir_args.push(op_consume(ctx, &gmod, arg_local, CkFieldWrite()))
                else:
                    gir_args.push(op_consume(ctx, &gmod, arg_local, classify_call_arg(gmod, call_name, ai)))
            ai += 1
        # P0 default-arg FILL: an explicit call may leave trailing param slots
        # unsupplied. For each such slot whose declared param has a parsed
        # default expr (`fn_defaults[call_name][idx]`), lower the default with
        # the param's expected type and APPEND its operand to `gir_args` —
        # routing through the SAME expected-type + op_consume path the arg loop
        # uses above. Mirrors Rust gg's trailing-slot fill in `resolve_call_args`
        # (`src/ir/lowering/exprs/calls.rs:386-445`) reading `ctx.fn_defaults`.
        # APPEND-only (the loop already pushed the explicit args) — no mutation
        # of `args`. Keyed on the redirect-resolved `call_name`; the
        # template-name `fname` is the fallback for a mono'd call whose mangled
        # name isn't itself registered (defaults live under the template name).
        # GATED on `not did_reorder`: the named-arg reorder above already
        # placed every slot (named + positional + default) into `r_args`, so
        # the loop pushed all params — appending here would DOUBLE-fill.
        if not did_reorder and args.len() < callee_param_types.len():
            Vector[Option[SpannedExpr]] call_defaults = []
            if gmod.fn_defaults.contains(call_name):
                call_defaults = gmod.fn_defaults.get(call_name).unwrap()
            elif gmod.fn_defaults.contains(fname):
                call_defaults = gmod.fn_defaults.get(fname).unwrap()
            int df_idx = args.len()
            while df_idx < callee_param_types.len():
                if df_idx < call_defaults.len():
                    Option[SpannedExpr] df_opt = call_defaults.get(df_idx).unwrap()
                    match df_opt:
                        case Some(df_expr):
                            # Container-size hint for a ctor default arg.
                            apply_container_hint_for_ctor_arg(&ctx, call_name, df_idx, df_expr, gmod)
                            # Expected-type = the param's declared type, peeling
                            # the by-pointer ABI wrapper exactly as the arg loop.
                            int df_prev_expected = ctx.expected_type
                            ctx.expected_type = -1
                            int df_pt = callee_param_types.get(df_idx).unwrap()
                            if df_pt >= PRIM_COUNT and df_pt < gmod.type_table.len():
                                match gmod.type_table.get(df_pt).unwrap():
                                    case GtPtr(df_pt_inner):
                                        df_pt = df_pt_inner
                                    else:
                                        pass
                            if df_pt != I64_TYPE and df_pt != UNIT_TYPE:
                                ctx.expected_type = df_pt
                            int df_local = lower_expr(&ctx, df_expr, &gmod)
                            ctx.expected_type = df_prev_expected
                            bool df_param_is_result = enum_category_of(&gmod, callee_param_types.get(df_idx).unwrap()).category == ENUM_CAT_RESULT
                            if not df_param_is_result:
                                df_local = maybe_auto_propagate(&ctx, df_local, &gmod)
                            if is_ctor_call:
                                gir_args.push(op_consume(ctx, &gmod, df_local, CkFieldWrite()))
                            else:
                                gir_args.push(op_consume(ctx, &gmod, df_local, classify_call_arg(gmod, call_name, df_idx)))
                        else:
                            pass
                df_idx += 1
        # Look up return type from module's fn_sigs, or from function definitions
        int ret_type = I64_TYPE
        # Expected-type read for bare prelude-variant ctors (Rust gg's
        # `resolve_option_result_variant` at `src/ir/lowering/exprs/mod.rs:1452-1551`).
        # When the caller (SVarDecl / SAssign / SReturn / call-arg / struct-field-init)
        # has set `ctx.expected_type` to a typed `Option__T` / `Result__T__E` enum,
        # adopt it as ret_type. This makes the dst slot struct-typed upstream so
        # `try_lower_prelude_variant` fires at LIR (emits canonical `IEnumInit`).
        # Subsumes the Some-with-non-primitive-inner hack at the end of this
        # block at non-return user-level consume positions (the SReturn site
        # used to retype after-the-fact; that path remains as a defensive
        # backstop, see `case SReturn:`).
        if (fname == "Ok" or fname == "Error" or fname == "Some" or fname == "None") and ctx.expected_type >= 0:
            int et = ctx.expected_type
            if et < gmod.type_table.len():
                # `enum_category_of`/`option_ref_payload_of` peel Ptr/MutPtr
                # internally, so `et` (possibly a borrowed/param `GtPtr(Result__…)`)
                # classifies correctly while staying raw for the dst-slot
                # `add_local`/`ret_type` uses below, which want the real type.
                EnumCategory et_ec = enum_category_of(&gmod, et)
                bool et_is_option = et_ec.category == ENUM_CAT_OPTION and option_ref_payload_of(&gmod, et) < 0
                bool et_is_result = et_ec.category == ENUM_CAT_RESULT
                bool variant_matches_option = (fname == "Some" or fname == "None") and et_is_option
                bool variant_matches_result = (fname == "Ok" or fname == "Error") and et_is_result
                if variant_matches_option or variant_matches_result:
                    ret_type = et
        # USER generic-enum variant ctor expected-type adoption. A bare
        # `Value(42)` / `Empty()` whose enclosing `expected_type` is a MONO'd
        # user enum (`Wrapper__int64_t`, registered in type_infos with `fname`
        # as a variant) adopts that mono type — so the ctor slot AND the LIR
        # IEnumInit literal agree on `Wrapper__int64_t` (else the GIR slot routes
        # via the template-keyed `enum_variant_parent` → `Wrapper` while the LIR
        # init mints the mono layout → C type mismatch). Mirrors the prelude
        # adoption above; gated on `expected_type` being a type_infos enum that
        # actually OWNS this variant (typed membership, no name matching).
        if ret_type == I64_TYPE and ctx.expected_type >= 0 and ctx.expected_type < gmod.type_table.len():
            String et_name = type_id_to_name(ctx.expected_type, &gmod)
            if gmod.type_infos.contains(et_name):
                GirTypeInfo et_ti = gmod.type_infos.get(et_name).unwrap()
                if et_ti.is_enum:
                    for et_v in et_ti.variants:
                        if et_v.name == fname:
                            ret_type = ctx.expected_type
                            # QUALIFY the ctor name to the disambiguated parent
                            # (`Empty` → `RxNode__Empty`). A BARE variant whose
                            # name collides across enums (`RxNode.Empty` vs the
                            # transitively-imported `ParseError.Empty`) would
                            # otherwise route through the first-write-wins
                            # `enum_variant_parent` map at the C-emit and mint the
                            # WRONG parent struct (`(__gg_ParseError){.tag=0}` into
                            # an `__gg_RxNode` slot → cc-fail "incompatible types").
                            # Writing the parent through into the call name here is
                            # "resolve once, write through": the GIR has the typed
                            # expected-type fact, so it records the parent on the
                            # GICall name, and the C-emit reads it from the
                            # collision-free QUALIFIED key (Rust gg resolves the
                            # same way from the receiver name, methods.rs:281-296,
                            # after the loader's collision-excluding qualification,
                            # src/loader.rs:907-940).
                            #
                            # ONLY for a NON-GENERIC parent (`et_name` free of
                            # `__`). The C-emit splits a qualified ctor name on the
                            # FIRST `__` to recover (parent, variant); a MONO'd
                            # generic enum parent (`Wrapper__int64_t`) already
                            # contains `__`, so `Wrapper__int64_t__Value` would
                            # mis-split to parent=`Wrapper`, variant=`int64_t__Value`
                            # (cc-fail: `__gg_Wrapper__int64_t has no member
                            # int64_t__Value_0`). The mono'd case needs no
                            # qualification anyway: `ret_type = ctx.expected_type`
                            # already pins the mono slot type, and the LIR mints the
                            # mono layout from the bare variant name correctly. So
                            # the qualification is scoped to the genuine cross-enum
                            # bare-name collision (`RxNode`/`ParseError`), which is
                            # exactly the non-generic case.
                            if not call_name.contains("__") and not et_name.contains("__"):
                                call_name = et_name + "__" + fname
                            break
        if ret_type == I64_TYPE and gmod.fn_sigs.contains(call_name):
            ret_type = gmod.fn_sigs.get(call_name).unwrap()
        # PROTOTYPE (option b): consult fn_sigs under the PRE-REDIRECT bare name
        # `fname` — but ONLY for a REDIRECTED extern (`fname` is in
        # call_redirects). Imported externs register their return type in fn_sigs
        # under the bare Gorget name (loader stub push → refine pass), but the
        # call site rewrites `call_name` to the redirected C symbol FIRST (above),
        # so the post-redirect lookup misses. Mirror Rust gg, which looks up the
        # ret_type on the bare `effective_name` and applies the C-symbol redirect
        # only to the emitted name (calls.rs:~1354/1391). The call_redirects guard
        # is load-bearing: without it, a GENERIC user call (`extract_first[int,
        # String](p)`, call_name=`extract_first__int64_t__GorgetString`) would
        # match the bare `fn_sigs[extract_first]` whose return type is the
        # un-monomorphized generic param `A` → wrong slot → garbage.
        if ret_type == I64_TYPE and gmod.call_redirects.contains(fname) and gmod.fn_sigs.contains(fname):
            ret_type = gmod.fn_sigs.get(fname).unwrap()
        # Also check call_redirects for the original name.
        if ret_type == I64_TYPE and gmod.call_redirects.contains(fname):
            String redir = gmod.call_redirects.get(fname).unwrap()
            if gmod.fn_sigs.contains(redir):
                ret_type = gmod.fn_sigs.get(redir).unwrap()
        # Check function definitions for return type
        if ret_type == I64_TYPE:
            int i = 0
            while i < gmod.functions.len():
                if gmod.functions.get(i).unwrap().name == call_name:
                    ret_type = gmod.functions.get(i).unwrap().return_type
                    break
                i += 1
        # Collection/struct constructors: return the named type
        if ret_type == I64_TYPE and is_type_constructor(call_name, &gmod):
            # If call_name is an enum variant, route to the parent enum type.
            String parent = enum_variant_parent(call_name, gmod)
            if parent != "":
                ret_type = lookup_or_register_named(&gmod, parent)
            else:
                ret_type = lookup_or_register_named(&gmod, call_name)
        # Monomorphized user-struct constructors (e.g. Wrapper__int64_t) —
        # detect via type_infos lookup even if name contains "__".
        if ret_type == I64_TYPE and gmod.type_infos.contains(call_name):
            ret_type = lookup_or_register_named(&gmod, call_name)
        # Template-name constructor: Wrapper__int64_t has template Wrapper
        # in type_infos. Route to the monomorphized named type.
        if ret_type == I64_TYPE:
            if call_name.contains("__"):
                int dunder = call_name.index_of("__").unwrap()
                if dunder > 0:
                    String tmpl_name = call_name.slice(0, dunder)
                    if gmod.type_infos.contains(tmpl_name):
                        ret_type = lookup_or_register_named(&gmod, call_name)
        # Builtin calls (args, read_file, int_to_str, ...)
        if ret_type == I64_TYPE:
            int builtin_ret = builtin_call_return_type(fname, &gmod)
            if builtin_ret >= 0:
                ret_type = builtin_ret
        # Float-arg dispatch for abs/min/max: when the first arg is F64,
        # the return is F64. Mirrors Rust gg `src/lir/lower/insts.rs:505-517`
        # (the LIR-level gorget_min→gorget_fmin remap) on the GIR side —
        # the GIR local must also be typed F64 so the f-string format
        # selection (EFString arm) picks `%f` not `%lld`.
        if (fname == "abs" or fname == "min" or fname == "max") and first_arg_type == F64_TYPE:
            ret_type = F64_TYPE
        # Prelude variant constructor `Some(x)` → `Option__<inner>`. The
        # block above can't route it (Option is a prelude enum, absent from
        # gmod.type_infos → enum_variant_parent "" → typed by the BARE
        # variant name `Some`), which resolves to an LT_PTR MIS-SLOT at LIR
        # (8 bytes for a 16-byte Option) — wrong-sized AND defeats
        # by-pointer-param address-taking (blocks the reference-grade
        # by-pointer Option ABI). The inner type is taken from the LOWERED
        # ARGUMENT's local type — reliable, unlike guess_return_type (which
        # collapses Box/struct inners to I64 → Option__int64_t ≠ the actual
        # Option__Box__SpannedExpr) and unlike the typechecker side-table
        # (which misses arg-position calls here). Unwrap any Ptr: a borrowed
        # arg is typed `*T`, but the Option OWNS its payload (value type).
        # Gate on a NON-PRIMITIVE inner: a resource/struct payload (String,
        # user structs) is what needs the precise Option__T slot for the
        # by-pointer ABI. Primitive-typed inners (incl. a `Box.new(...)` arg
        # currently mistyped as I64 — a separate pre-existing gap) keep the
        # legacy bare-`Some` typing, which coerces fine into int-typed fields
        # (e.g. ERange); retyping them to Option__int64_t would MISMATCH
        # those fields. This is the minimal correct scope to unblock A
        # without depending on the orthogonal Box-typing fix.
        # Widened gate: ALSO fire for a primitive-inner `Some(<prim>)` whose
        # resolved `ret_type` carries NO enum-category yet — i.e. it fell through
        # to the bare-variant `Some` named type (Option is a prelude enum absent
        # from type_infos → `enum_variant_parent` "" → typed by the bare `Some`).
        # Without an enum-category recorded, a downstream combinator read-site
        # (`enum_category_of`) returns the sentinel and mis-routes the chain to
        # the GorgetArray HOF arm (`Some__map`/`GorgetArray = int`). The
        # `not has_enum_category(ret_type)` disjunct PRESERVES the expected-type
        # path: when adoption (above) already pinned a real `Option__T`,
        # `has_enum_category(ret_type)` is true → arm SKIPPED → Some(Box)/ERange
        # behavior unchanged.
        if (fname == "Some") and first_arg_type >= 0 and (first_arg_type >= PRIM_COUNT or not has_enum_category(&gmod, ret_type)):
            int some_inner = first_arg_type
            if some_inner >= 0 and some_inner < gmod.type_table.len():
                match gmod.type_table.get(some_inner).unwrap():
                    case GtPtr(p_inner):
                        some_inner = p_inner
                    case GtMutPtr(p_inner):
                        some_inner = p_inner
                    else:
                        pass
            ret_type = lookup_or_register_named(&gmod, "Option__" + type_id_to_name(some_inner, &gmod))
            record_enum_category(&gmod, ret_type, ENUM_CAT_OPTION, some_inner, -1)
        # CLOSURE LEAK Class A — a closure-returning fn (`int(int) make_adder(...)`)
        # has a DECLARED return type that resolves to a `GtFnPtr` (`fn(i64)->i64`),
        # but its RUNTIME value is a `GorgetClosure` (the producer literally returns
        # a 16-byte {fn_ptr, env} struct and `__gorget_closure_env_alloc`s a heap
        # env-box). The `GtFnPtr` typing is the lossy abstraction; the concrete
        # runtime representation is `GorgetClosure` — resolve it here (layering
        # rule 1/4: fix at the writer). Without this the call-result local stays
        # `GtFnPtr`, `is_droppable_type` returns false for it, the FRESH-OWNED-TEMP
        # registration below is a no-op, and the escaping env-box is NEVER freed
        # (closure_escape/closure_returning_closure 32B, closure_partial_application
        # 48B — SELF-HOST-ONLY; Rust gg is clean). Retyping to `GorgetClosure`
        # makes `dst` droppable so it registers below, AND makes op_consume route
        # the var-decl binding through the resource path (owned last-use → OpMove →
        # GIMoveZero), so the call-result's drop is move-elided and the VAR-LOCAL
        # drops the env exactly once — identical to a directly-bound closure
        # (`auto add_x = (int y): x+y` lowers its make-site value as GorgetClosure
        # and binds with `move`). No double-free: exactly one live owner at a time.
        # Borrowed callable PARAMS are `GtPtr`/`GtMutPtr` (not GtFnPtr) so they are
        # unaffected; a bare top-level fn-ref return would carry a NULL env, which
        # `gorget_closure_free` no-ops on — safe either way.
        if ret_type >= PRIM_COUNT and ret_type < gmod.type_table.len():
            match gmod.type_table.get(ret_type).unwrap():
                case GtFnPtr(_, _):
                    ret_type = lookup_or_register_named(&gmod, "GorgetClosure")
                else:
                    pass
        # VOID-RETURNING call: a `void` free-fn / extern (`extern void seed`,
        # `extern void signal_trap`, …) yields UNIT. Capturing it into a slot
        # would emit `__v = gorget_void_fn(...)` where the runtime symbol is
        # declared `void` → cc `error: void value not ignored`. Emit the call
        # as a STATEMENT with no result binding (GICall with the `-1` no-capture
        # dst sentinel — the same form the `panic`/print-byte-count paths use;
        # lir_lower's GICall/GICallExtern arms pass `dst = -1` to ICall/
        # ICallExtern and skip the ISlotStore when `dst_local < 0`), then return
        # a UNIT local so a value-position use has a well-typed placeholder.
        # Mirrors Rust gg's lower_call: `if ret_type == UNIT_TYPE {
        # builder.call_void(...); Operand::Constant(Constant::Unit) }`
        # (src/ir/lowering/exprs/calls.rs:1477-1479). Gated strictly on
        # `ret_type == UNIT_TYPE`, so it NEVER fires on a ctor call (struct/enum
        # ret_type) or a value-returning call (int/String/…). Drop registration
        # is correctly skipped — there is no owned result to free.
        # Cross-frame fault propagation (error-model.md §11, Inc-2.1a/2.1c/2.1d):
        # does the callee PARTICIPATE? If so it has a synthesized trailing
        # `GtMutPtr(i32)` fault-slot param, so EVERY direct caller MUST pass the
        # trailing arg (uniform signature, D5). A CATCHING caller (inside ANY
        # fault scope) allocates a zero-init i32 slot, passes `&slot`, and after
        # the call dispatches on the slot TAG VALUE to the matching per-category
        # handler (branch-before-read). A NON-CATCHING caller passes NULL and the
        # callee's fault arm panics by default. `participating_fault_fns` is empty
        # for the existing suite + self-host → this block is dead → byte-identical.
        #
        # QUALIFY a bare user-enum variant ctor name (Core #2 / layering rule 4:
        # resolve-once-write-through). A bare `Str(s)` for a USER enum variant
        # (`Json.Str(String)`) reaches here with `call_name == "Str"` when the
        # resolver did not qualify it (e.g. a method-call VALUE arg like
        # `dict.put(k, Str(v))`, unlike a return-position `Str(s)` which the
        # resolver already rewrites to `Json__Str`). Emitting the bare `Str`
        # GICall makes LIR `map_runtime_name` mistake it for the runtime
        # GorgetString category and panic ("`Str` has no method"). Rewrite to the
        # qualified `Enum__Variant` — the SAME form the qualified `Enum.Str(s)`
        # path and the resolver-qualified return path emit, which LIR lowers to a
        # canonical variant IEnumInit. Prelude variants (Ok/Error/Some/None) have
        # `enum_variant_parent == ""` (Option/Result are absent from type_infos)
        # so they are untouched; an already-qualified name (`contains("__")`) is
        # skipped so a monomorphized ctor can't be double-qualified.
        #
        # SCOPE (`ret_type == I64_TYPE` gate): fire ONLY when the ret_type block
        # above FAILED to route the bare variant to its parent enum — i.e. the
        # name was shadowed by a coercion sibling (`Str`/`String`) and slipped
        # through as I64. A CONCRETE enum's normally-routed variant already has
        # the right parent ret_type (non-I64), so it is skipped. Crucially this
        # excludes a GENERIC enum's variant (`Value(42)` for `Wrapper[int]`),
        # whose ret_type is the MONOMORPHIZED `Wrapper__int64_t` (non-I64) and
        # whose `enum_variant_parent` returns the TEMPLATE `Wrapper` — qualifying
        # to `Wrapper__Value` (dropping `__int64_t`) would mis-name the ctor.
        if ret_type == I64_TYPE and not call_name.contains("__"):
            String _ev_parent = enum_variant_parent(call_name, gmod)
            if _ev_parent != "" and gmod.type_infos.contains(_ev_parent):
                call_name = _ev_parent + "__" + call_name
                # The dst slot must carry the PARENT ENUM type so the LIR
                # variant-ctor lowering (needs the parent struct id) and the
                # C-emit aggregate `(Enum){.tag=N,...}` are well-typed. Without
                # this the 100+-byte enum mis-slots into an 8-byte int temp.
                ret_type = lookup_or_register_named(&gmod, _ev_parent)
        if ret_type == UNIT_TYPE:
            emit(&ctx, GICall(-1, call_name, gir_args))
            int void_unit = add_local(&ctx, UNIT_TYPE, None)
            emit(&ctx, GIAssign(void_unit, OpConstUnit()))
            return void_unit
        int dst = add_local(&ctx, ret_type, None)
        emit(&ctx, GICall(dst, call_name, gir_args))
        # FRESH-OWNED-TEMP drop registration (#7-style): a resource/String-
        # returning free-fn/builtin/user call (`int_to_str`/`chr`/`read_file`/
        # `getenv`/`args`/user `String f()`) yields a fresh OWNED value (LoOwned).
        # When this CALL EXPRESSION flows directly into a non-consuming position
        # (`print(int_to_str(x))`, `f"{int_to_str(x)}"`) it is BORROWED only
        # (CkFormatArg/CkCallArgBorrow → is_consume_kind=false → OpBorrow), so the
        # result is orphaned and leaks (O(1) per occurrence). Registering at
        # creation makes the scope-exit GIDropIfAlive free it exactly once.
        # SAFE-BY-CONSTRUCTION: when the result is instead MOVED into a binding
        # (`String s = int_to_str(x)`), RETURNED, or pushed/field-init'd,
        # op_consume/wire-liveness emits OpMove → GIMoveZero zeros the moved-out
        # slot, so the unconditional scope-exit GIDropIfAlive — which lowers to a
        # memcmp-guarded drop — finds a zeroed slot and SUPPRESSES the drop at
        # runtime (and the LIR drop_elab pass further elides the guard statically
        # when init is provable). SReturn separately excludes the moved local from
        # early-exit drops. Either way the value is dropped exactly once; no
        # double-free.
        # register_local_for_drop's is_droppable_type gate makes this a no-op for
        # primitive returns (int/bool/F64) and its LoView/LoBorrowed gates pass
        # only genuine fresh owners; `dst` is LoOwned here. Mirrors Rust's
        # call_tracked/call_extern_tracked `needs_drop` registration (context.rs).
        register_local_for_drop(&ctx, dst, ret_type, &gmod)
        result = dst
    return result

