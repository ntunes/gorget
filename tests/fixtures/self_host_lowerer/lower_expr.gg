                if gmod.fn_defaults.contains(_m_defaults_key):
                    Vector[Option[SpannedExpr]] _m_defaults = gmod.fn_defaults.get(_m_defaults_key).unwrap()
                    # surface index of the first missing trailing slot. With a
                    # leading self, non-self position `filled_margs.len()` maps to
                    # surface `filled_margs.len() + self_skip`.
                    int _m_self_skip2 = 0
                    if gmod.fn_param_names.contains(_m_defaults_key):
                        Vector[String] _m_pn2 = gmod.fn_param_names.get(_m_defaults_key).unwrap()
                        if _m_pn2.len() > 0 and _m_pn2.get(0).unwrap() == "self":
                            _m_self_skip2 = 1
