            # call_redirects under this Type__method shape, so this never
            # perturbs ordinary user-method dispatch.
            if gmod.call_redirects.contains(full_name):
                full_name = gmod.call_redirects.get(full_name).unwrap()
            Vector[Operand] call_args = []
