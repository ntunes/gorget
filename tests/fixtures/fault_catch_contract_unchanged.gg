# Post-D25 sanity: the contract `catch (msg):` form is UNCHANGED. Combines a
# throwing-call `!` propagate + contract catch with D26 `+!` capture. Axis:
# contract-catch coexists with D26 fallible-arith on the same site.
int parse_it(String s) throws String:
    if s == "bad":
        throw "parse failed"
    return 42

void main():
    int v = parse_it("bad")! catch (msg): -1
    print(f"{v}")
    int w = parse_it("ok")! catch (msg): -1
    print(f"{w}")
    int big = 9223372036854775807
    Result[int, ArithError] r = big *! 2
    match r:
        case Ok(v):    print(f"{v}")
        case Error(_): print("-2")
