# Regression guard: the existing `Result` `catch (name):` contract-error path is
# UNCHANGED by the new fault-catch form. `catch (msg)` (parenthesized) still
# recovers a thrown error; `catch Fault.Overflow` (no parens) is the new form.
int parse_it(String s) throws String:
    if s == "bad":
        throw "parse failed"
    return 42

void main():
    int v = parse_it("bad")! catch (msg): -1
    print(f"{v}")
    int w = parse_it("ok")! catch (msg): -1
    print(f"{w}")
    int big = 9223372036854775807
    int r = (big * 2) catch Fault.Overflow: -2
    print(f"{r}")
