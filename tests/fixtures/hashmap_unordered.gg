from std.collections import HashMap

void main():
    HashMap[int, int] m = HashMap[int, int]()
    m.put(10, 100)
    m.put(20, 200)
    m.put(30, 300)

    # Basic operations
    print(f"{m.len()}")
    print(f"{m.get(10).unwrap()}")
    print(f"{m.get(20).unwrap()}")
    print(f"{m.get(30).unwrap()}")
    print(f"{m.contains(10)}")
    print(f"{m.contains(99)}")

    # Remove
    m.remove(20)
    print(f"{m.len()}")

    # Fold (order-independent sum)
    int total = m.fold(0, (int acc, int k, int v): acc + v)
    print(f"{total}")
