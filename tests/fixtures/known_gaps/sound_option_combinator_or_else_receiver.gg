# DURABLE REPRO — `.or_else()` has the SAME receiver-emptying defect as
# `.map()` / `.filter()`. Third costume of that mode, committed so the sibling
# census is executable rather than prose (Core #4).
#
# WRONG TODAY (measured at HEAD): `gg check` clean; the program runs and prints
# **0** where it should print 11 — the receiver's heap payload was consumed by
# the combinator even though a bare receiver is a BORROW.
#
# INTENDED: 11.
#
# ⚠ RESOURCE-PAYLOAD-SPECIFIC — an `int` payload works, so a trivial-payload
# fixture is a false negative for this whole family.
# ⚠ ggdef is OUT OF SUBSET for the combinator family, so there is no
# definitional adjudication here (Core #9).
#
# Full census of the family lives in TODO.md: 6 of 7 combinators broken with a
# resource payload, in 3 distinct failure modes.

struct Money:
    Vector[int] cents

struct Holder:
    Option[Money] slot

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void main():
    Holder h = Holder(make_opt(11))
    Option[Money] r = h.slot.or_else((): make_opt(99))
    if h.slot is Some(m2):
        print(size_of(m2))
