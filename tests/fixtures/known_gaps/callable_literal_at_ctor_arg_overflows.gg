# t0937 — a closure LITERAL at a CONSTRUCTOR argument position is never
# constructed: no `__gorget_closure_env_alloc` and no `.fn_ptr =` designator are
# emitted, and the field init then memcpys sizeof(GorgetClosure)=16 bytes out of
# the 1-byte env placeholder. ASan: stack-buffer-overflow, READ of size 16.
# Reproduces at `Some(...)` too, i.e. at enum-init as well as at a constructor —
# both are consuming boundaries per AGENTS.md § Ownership at Consuming Positions.
# INTENDED: prints 2.
struct S:
    Callable[int(int)] f

void main():
    S s = S((int x): x + 1)
    Callable[int(int)] g = s.f.clone()
    print(g(1))
