# SELF-HOST LANE GAP (`todo/t1055`), the SIBLING prefix. `needs_ptr_arg`'s
# first clause tests BOTH `__callable_` and `__gorget_closure_call_` in one
# expression, so both spellings reach the same address-take. Pinned separately
# because a fix that only teaches one of them is half a fix.
int __gorget_closure_call_1(int a, int b):
    return a + b

int(int) make_doubler(int n):
    return (int y): y * n

void main():
    auto d = make_doubler(2)
    print(d(21))
    print(__gorget_closure_call_1(40, 2))
