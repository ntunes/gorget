# KNOWN GAP (Round XIX Track N2 cell H / TODO:879): formation = closure-return
# of Box[Trait] (vs plain fn-return control which is GREEN R2).
# Callable[Box[Speaker]()] f = (): Box.new(Robot("R2")) builds clean, exits 132
# (SIGILL): emit_implicit_return overrides LocalId(0) to Box[Concrete], killing
# try_trait_object_construct. Intended: f().speak() prints R2.
#
# RED-verify (pre-fix, 2026-07-30): builds; run exit 132 (SIGILL).
# Control: typed fn return Box[Speaker] make(): Box.new(...) → R2 GREEN.
# Promote when ambient Callable return types LiftedClosure + pack + no
# Concrete re-pin on trait-box dest.
from std.collections import Box
trait Speaker:
    String speak(self)
struct Robot:
    String id
equip Robot with Speaker:
    String speak(self):
        return self.id
void main():
    Callable[Box[Speaker]()] f = (): Box.new(Robot("R2"))
    print(f().speak())
