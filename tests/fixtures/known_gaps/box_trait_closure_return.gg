from std.collections import Box
trait Speaker:
    String speak(self)
struct Robot:
    String id
equip Robot with Speaker:
    String speak(self):
        return self.id
void main():
    Callable[Box[Speaker]()] f = (): Box.new(Robot("R2"))
    print(f().speak())
