# `Vector[String].filter` where the RESULT ESCAPES its producing function.
#
# The filtered array owns and drops its elements, so the element it keeps must
# be an independent copy of the source's — not a pointer into the source
# buffer, which the source's own drop invalidates on return.
#
# Elements are heap-forced through `mk`: a static string literal lives in
# read-only storage and cannot expose an ownership defect at all.
# `from std.iter import Iterable` is a live axis on this grid and is stated
# explicitly rather than left to resolution order.
from std.iter import Iterable

String mk(String a, String b):
    return a + b

Vector[String] pick():
    Vector[String] v = Vector[String]()
    v.push(mk("aa", "bc"))
    v.push(mk("dd", "efg"))
    return v.filter((s): s.len() == 4)

void main():
    Vector[String] r = pick()
    r.each((t): print(t))
