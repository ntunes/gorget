# Round XI Track M — shared trait + impl for the guard_trait_named_reject
# family (bare-trait class 2 — `main_bare.gg`; the Box variant graduated
# out in Round XII Track N2 to `tests/fixtures/guard_trait_named_box_dispatch/`).
#
# Kept in a separate module (rather than embedded in `main_bare.gg`) so
# the fixture adjudicates the check-reject on the Guard-wrapper type,
# not on any accidental same-file resolution shortcut.

trait Speaker:
    String greet(self)

struct Robot:
    String name

equip Robot with Speaker:
    String greet(self):
        return "beep " + self.name
