# REGRESSION FIXTURE — B1: a `&`-arg naming a BY-VALUE place must write THROUGH
# to that place. Nine rows, all asserting the write reaches the caller:
#     11 / 11.000000 / true / 11 / 11 / 11 / 11 / 11 / 11
#
# AXIS + CELL (Core #12): this samples the *projected TYPE* axis of the
# `&`-argument face, on the BY-VALUE side — `int` · `float` · `bool` · value
# struct · tuple · Dict value · Vector element, plus two rows with no struct at
# all. The RESOURCE side of the same axis (`String`/`Vector`/`Dict`/resource
# struct fields, which used to work by accident) is
# `security/sound_amp_field_thinptr_control.gg`; the resource/value contrast
# INSIDE each type kind is `cow_amp_projection_resource_value_split.gg`.
#
# RED-VERIFIED: against the pre-fix compiler this printed
#     10 / 10.000000 / false / 10 / 10 / 10 / 10 / 10 / 10
# — EVERY row dropped the callee's write on the floor, `gg check` clean, on both
# backends, for ~5 months. ggdef printed the incremented value throughout: the
# definition lane was right and both production backends were wrong (Core #8).
#
# GUARDED MECHANISM: the Family-1 chokepoint — `try_resolve_place` called from
# `lower_call_arg`'s `MutableBorrow` arm before `lower_expr`. Short-circuit that
# call to `None` and every row below returns to 10.
#
# ⚠ THE FILED "by-value FIELD" FRAMING UNDERCOUNTS THE CLASS. Rows 8 and 9 have
# NO struct anywhere: `&vv[0]` and `&dd["k"]` on a PLAIN LOCAL collection lose
# the write too. The discriminator is not "is it a field" but "how is the
# projection's result TYPED" — a by-value place is lowered to a value temp and
# the borrow is taken of the temp. Only a whole bare local scalar (`&loc`,
# pinned in `sound_amp_local_scalar_control.gg`) survives, along with the
# thin-pointer field types pinned in
# `security/sound_amp_field_thinptr_control.gg`.
#
# Every seed is COMPUTED, never a literal, so no const-fold can elide a write.
#
# Cited from TODO.md (CoW / ownership / High): "By-value-field `&`-arg
# write-through is SILENTLY LOST".
struct Inner:
    int a
    int b

struct Holder:
    int i
    float f
    bool z
    Inner st
    (int, int) tup
    Dict[String, int] d
    Vector[int] vec

int seed():
    return 10

float fseed():
    return 10.0

void bump_int(int &n):
    n = n + 1

void bump_float(float &x):
    x = x + 1.0

void flip_bool(bool &b):
    b = true

void bump_struct(Inner &s):
    s.a = s.a + 1

void bump_tuple((int, int) &t):
    t.0 = t.0 + 1

void main():
    Dict[String, int] dd = Dict[String, int]()
    dd.put("k", seed())
    Vector[int] vv = Vector[int]()
    vv.push(seed())
    Holder h = Holder(seed(), fseed(), false, Inner(seed(), 0), (seed(), 0), dd, vv)

    # 1. scalar int field
    bump_int(&h.i)
    print(h.i)

    # 2. float field
    bump_float(&h.f)
    print(h.f)

    # 3. bool field
    flip_bool(&h.z)
    print(h.z)

    # 4. plain (by-value) struct field
    bump_struct(&h.st)
    print(h.st.a)

    # 5. tuple field
    bump_tuple(&h.tup)
    print(h.tup.0)

    # 6. Dict value under a field
    bump_int(&h.d["k"])
    print(h.d["k"])

    # 7. Vector element under a field
    bump_int(&h.vec[0])
    print(h.vec[0])

    # 8. Vector element of a PLAIN LOCAL — no struct involved
    Vector[int] loose_vec = Vector[int]()
    loose_vec.push(seed())
    bump_int(&loose_vec[0])
    print(loose_vec[0])

    # 9. Dict value of a PLAIN LOCAL — no struct involved
    Dict[String, int] loose_dict = Dict[String, int]()
    loose_dict.put("k", seed())
    bump_int(&loose_dict["k"])
    print(loose_dict["k"])
