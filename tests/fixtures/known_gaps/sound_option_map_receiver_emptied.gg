# DURABLE REPRO — `.map()` DESTROYS ITS RECEIVER'S PAYLOAD for bare-param and
# field-access receivers. Silent wrong output on BOTH backends.
#
# This is an ownership defect, not a combinator bug: the receiver is a BORROW at
# these positions, and the adapter consumes it anyway. The value is still there
# by the type system's reckoning; its heap payload has been emptied underneath.
#
# WRONG TODAY (measured at HEAD, C and LLVM byte-identical):
#   bare-param receiver   `p.map(...)`      then read `p`  -> 10 then **0**  (want 10 then 10)
#   field-access receiver `h.slot.map(...)` then read it   -> 11 then **0**  (want 11 then 11)
#   plain-local receiver  (the loop below)                 -> 39 then 13     ✅ CORRECT
#
# ⚠ THE THIRD ROW IS A LIVE CONTROL, NOT A GAP — it passes today and must keep
# passing. It is also the reason this went unnoticed: a plain-local receiver is
# the shape fixtures happened to use, and it is the one shape that works.
#
# MECHANISM (localized, `src/ir/lowering/exprs/methods.rs`): the receiver-clone
# path is gated on `p.projections.is_empty()`, so a FIELD-ACCESS place is not
# recognised as a place at all and falls to the `else` branch commented
# "Non-place operand (constants, etc.) — Copy is safe". That comment is FALSE
# for a field place, and it is a Core #14 comment with no enforcing guard. The
# bare-param row takes the adjacent "no clone fn registered — fall back to
# plain Copy" branch, whose own comment concedes "validator may flag".
#
# INTENDED (what this fixture asserts):
#     10 / 10 / param-end / 11 / 11 / field-end / 39 / 13 / loop-end
#
# ORACLE: ggdef is OUT OF SUBSET here — `.map()` is not in the phase-0 subset
# ("method `.map()` is outside the phase-0 subset"). So this defect has NO
# definitional adjudication; C and LLVM agreeing is necessary, not sufficient
# (Core #8). Recorded explicitly per Core #9 — the ggdef subset gap is filed.
#
# The payloads are HEAP-FORCED (a built `Vector[int]`, not a literal), so the
# emptying is observable rather than const-folded away.

struct Money:
    Vector[int] cents

struct Holder:
    Option[Money] slot

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

# BROKEN CELL 1 — bare (borrow) param receiver, read back after the combinator.
void via_param(Option[Money] p):
    Option[int] r = p.map((Money m): size_of(m))
    if r is Some(v):
        print(v)
    if p is Some(m2):
        print(size_of(m2))
    print("param-end")

# BROKEN CELL 2 — field-access receiver, read back after the combinator.
void via_field():
    Holder h = Holder(make_opt(11))
    Option[int] r = h.slot.map((Money m): size_of(m))
    if r is Some(v):
        print(v)
    if h.slot is Some(m2):
        print(size_of(m2))
    print("field-end")

# LIVE CONTROL — plain-local receiver, combinator'd repeatedly. Correct today.
void via_loop():
    Option[Money] o = make_opt(13)
    int i = 0
    int acc = 0
    while i < 3:
        Option[int] r = o.map((Money m): size_of(m))
        if r is Some(v):
            acc = acc + v
        i = i + 1
    print(acc)
    if o is Some(m2):
        print(size_of(m2))
    print("loop-end")

void main():
    via_param(make_opt(10))
    via_field()
    via_loop()
