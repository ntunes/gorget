# KNOWN GAP `todo/t1286` (self-host lane): `Deque.map` does not compile on the
# self-host. Its emitted C fails at the C compiler with
#
#   error: incompatible types when assigning to type 'GorgetArray'
#          {aka 'struct <anonymous>'} from type 'int'
#
# The Rust lane compiles and runs the same program correctly on BOTH backends,
# so this is a lane divergence with a settled direction: Rust is right and the
# self-host lags.
#
# THE ELEMENT TYPE IS `int` DELIBERATELY — the simplest possible shape. If the
# gap needed a resource element, a user struct, or a `Drop` body to reproduce,
# this cell would be green and the filing would be narrower than the defect.
#
# INTENDED on both lanes: prints 3 then 60.

from std.collections import Deque

void main():
    Deque[int] d = Deque[int]()
    d.push(1)
    d.push(2)
    d.push(3)
    Deque[int] r = d.map((n): n * 10)
    print(f"{r.len()}")
    int total = 0
    for n in r:
        total = total + n
    print(f"{total}")
