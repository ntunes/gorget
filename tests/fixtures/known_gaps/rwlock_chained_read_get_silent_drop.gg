from std.sync import RWLock

# known_gaps repro (filed Round XII Track N3, 2026-07-28): chained
# `r.read().get()` silently drops the `.get()` and the ReadGuard temp — the
# emitted C fills the guard slot via `gorget_rwlock_read_to` but never reads
# `.ptr` and never emits the ReadGuard drop. Prints `0` on C and LLVM.
# Distinct from Track N3's typecheck-return-type fix (post-fix the guard is
# still typed `ReadGuard[int]`, and the annotated shape `ReadGuard[int] g =
# r.read(); print(g.get())` prints 42 as expected — the miscompile is in the
# LIR chained-receiver lowering, likely because `.get()`'s
# `SelfConvention::MutBorrow` receiver has no place to mut-borrow from when
# the receiver is a temporary). When the LIR bug lands, un-ignore and
# promote out of known_gaps/. Intended output: `42`.
void main():
    RWLock[int] r = RWLock[int](42)
    print(r.read().get())
