# DURABLE REPRO — SH-lane companion for the Round XXIII Track α cross-type
# `.or_else` fix. The Rust lane is fixed by this commit:
#   - `src/ir/lowering/exprs/methods.rs:3779` — `or_else` joined the
#     `and_then | flat_map` arm so `result_type` is sized from the closure's
#     declared return.
#   - `src/ir/lowering/exprs/methods.rs:3701-3715` — the dual `expected_type`
#     rule now covers `or_else` too (mirror of `and_then`).
#   - `src/semantic/typecheck.rs::unify_closure_ret_axis` — the shared
#     3-cell class-guard rejects the ill-typed Ok-axis cross-type at check.
#
# The SELF-HOST lane at `tests/fixtures/self_host_lowerer/lower_expr.gg:4592-
# 4597` still forces `_combinator_et = peel(recv)` for `or_else | or`
# unconditionally — it lacks the dual outer-annotation-wins rule that the
# Rust lane now applies to `and_then | flat_map | or_else`. This is the
# SH-lane sibling of the Rust write-site fix (Core #9 lane parity).
#
# WHAT TO DO: SH-lane port follow-up (owned): mirror the dual rule to
# `or_else` in the SH lowerer's expected-type dispatch (add `or_else` to
# the `and_then | flat_map` arm at lower_expr.gg:4597-4611). Ordering:
# scout the SH backend's `result_local` sizing site too — the Rust bug had
# BOTH an expected_type mis-hint AND a `result_type` write-site fall-
# through; the SH side may share both.
#
# WHY THIS FIXTURE STAYS `#[ignore]`d: the SH driver hasn't been ported
# yet, so the SH-lane emit-cc-run would replicate the Rust pre-fix bug
# (silent-wrong on cross-type shapes, potential SBO for a call-body
# closure returning a differently-sized Result). Rust-lane behaviour is
# GREEN post-fix and serves as the asserted parity target.
#
# Cited from TODO.md (SH-lag section, Round XXIII Track α SH-follow-up).

struct Money:
    Vector[int] cents

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Result[int, int] recover(Money m):
    return Ok(m.cents.len())

void via_param(Result[int, Money] p):
    Result[int, int] r = p.or_else((Money m): recover(m))
    if r is Ok(v):
        print(v)

void main():
    via_param(Error(Money(heap_cents(5))))
