# KNOWN GAP todo/t1407 — `Vector[String].fill(n, x)` double-frees.
#
# `gorget_array_fill` (src/backend/c/runtime/runtime_array.c) memcpys ONE
# source value into N slots and never calls the per-slot materialize hook, so
# all N slots alias a single heap payload and `gorget_array_free` releases it
# N times. The discriminator is DUPLICATION, not a missing hook: `.set` and
# `.insert` place one value in one slot and are measured clean.
#
# The element must be HEAP-FORCED. Every pre-existing `.fill` fixture uses
# POD elements (`bool`), which have no payload to alias — which is why the
# defect was never seen. `mk()` builds the String at runtime so it is an
# owned (`cap>0`) buffer rather than a `.rodata` view.
#
# Today: `free(): double free detected in tcache 2`, rc 134 on C and LLVM;
# under `--sanitize`, `AddressSanitizer: attempting double-free`.
# The expected output below is what the language SHOULD produce.

String mk(String a, String b):
    return a + b


void main():
    Vector[String] v = Vector[String]()
    v.fill(3, mk("ab", "cd"))
    print(f"len={v.len()} first={v[0]} last={v[2]}")
