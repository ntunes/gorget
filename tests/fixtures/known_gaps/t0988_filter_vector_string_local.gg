# `Vector[String].filter` where the source OUTLIVES the result.
#
# The companion of `t0988_filter_vector_string_escape` on the source-liveness
# axis: here the source array is still alive when the result is read, so the
# right bytes reach stdout even when the element merely aliases the source
# buffer. The cell is pinned because a fix that clones at the wrong place turns
# this accidentally-correct shape into a double free.
from std.iter import Iterable

String mk(String a, String b):
    return a + b

void main():
    Vector[String] v = Vector[String]()
    v.push(mk("aa", "bc"))
    v.push(mk("dd", "efg"))
    Vector[String] r = v.filter((s): s.len() == 4)
    r.each((t): print(t))
