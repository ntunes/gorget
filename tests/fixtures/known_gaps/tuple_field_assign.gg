# Tuple-field mutation: `t.INDEX = v` and `t.INDEX OP= v`. A tuple is a struct
# with positionally-indexed fields, so a tuple field is a valid mutable PLACE —
# `lower_assign` / `lower_compound_assign` resolve it to `object_place` +
# `Projection::Field(index)` (mirroring the tuple-field READ). Pre-fix, plain
# `x.0 = 9` fell to lower_assign's `_ =>` no-op and SILENTLY DROPPED (printed 1),
# and `x.0 += 5` ICE'd in lower_compound_assign's catch-all on typecheck-ACCEPTED
# code. This is the exact `xs.0 = v` class CLAUDE.md Core #10 names. Same output
# on C + LLVM.
#
# Exercises: direct compound (`x.0 += 5`, `x.1 *= 3`), `&`-param write-through
# (`bump`), nested tuple-field on a struct field (`h.pair.0 += 1`), and plain-`=`.
#
# Core #9 lagging lane: the self-host `SAssign` / `SCompoundAssign` lowerers have
# NO tuple-field (nor, for compound, EDeref) arm — they `lower_fail` it
# (lower_stmt.gg:1013 / :1228). So this lives in `known_gaps/` (out of the
# self-host runtime-diff corpus), an EXPLICIT cited lagging lane (Core #9), filed
# with TODO:262. Promote to top-level when the SH grows tuple-field assign arms.
# run_gg only ever builds via Rust gg (C/LLVM) — never the self-host.

void bump((int, int) &t):
    t.0 += 10
    t.1 -= 1

struct Holder:
    (int, String) pair

void main():
    (int, int) x = (1, 2)
    x.0 += 5
    x.1 *= 3
    print(x.0)          # 6
    print(x.1)          # 6
    bump(&x)
    print(x.0)          # 16  (&-param write-through)
    print(x.1)          # 5
    Holder h = Holder((100, "a"))
    h.pair.0 += 1
    print(h.pair.0)     # 101 (nested: tuple field on a struct field)
    x.0 = 9             # plain-= tuple field (control)
    print(x.0)          # 9
    print("done")
