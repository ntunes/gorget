# KNOWN GAP (found by R41 T-FMT-A while wiring the extern-block comment hooks,
# 2026-08-11) — the LAST interior comment of a container block DEDENTS to
# column 0, escaping the block it was written inside.
#
# This is a CROSS-CONTAINER class, not a per-container bug: it reproduces
# identically in ALL FIVE container formatters (struct / enum / trait / equip /
# extern block), so it must be fixed at the shared chokepoint, not patched into
# one arm (Core #4 — fix the class, not the instance).
#
# Mechanism: each container's member loop pairs `emit_comments_before(
# child.span.start)` with `emit_trailing_comment_after(child.span.end)`. A
# comment AFTER the last child has no following child to lead, and it is on its
# own line so it is not a trailing comment either — so no hook claims it, and it
# falls through to the module-level leading/EOF flush at indent 0. What is
# missing is an ORPHAN-PRE-CLOSE flush before each container's `dedent()`
# (the shared collection-literal helper already has exactly such a hook —
# `format_bracketed_broken_with_comments` — which is the shape to generalise).
#
# INTENDED: each `# trailing in <container>` comment stays INDENTED inside its
# own block. `gg fmt` currently emits all five at column 0.
#
# The `#[ignore]`d guard `fmt_container_last_interior_comment_stays_inside` in
# tests/integration.rs asserts the INTENDED indented output; un-ignore +
# graduate the round the shared flush lands.

struct S:
    int a
    # trailing in struct

enum E:
    One()
    # trailing in enum

trait T:
    int m()
    # trailing in trait

equip S:
    int g(self):
        return self.a
    # trailing in equip

extern "C":
    extern int puts(String s) = "puts"
    # trailing in extern block

void main():
    print(1)
