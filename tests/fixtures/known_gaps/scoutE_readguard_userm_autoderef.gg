from std.sync import RWLock

struct Person:
    String name
    int age

equip Person:
    int greet(int e): return self.age + e

void main():
    RWLock[Person] r = RWLock[Person](Person("A", 30))
    ReadGuard[Person] g = r.read()
    print(g.greet(5))
