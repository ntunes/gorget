# t0936 — `.clone()` on a `Callable` bound to a NAMED LOCAL segfaults, while the
# byte-equivalent clone through a temp receiver works.
#
#   Callable[int(int)] h = (int x): x + 1
#   h.clone()                     -> SIGSEGV
#   fns.get(0).unwrap().clone()   -> correct (prints 2)
#
# `.clone()` on a Callable is a SUPPORTED operation, not a carve-out violation:
# `src/ir/lowering/builtins.rs:1109` registers
# `clone_fn: Some("gorget_closure_clone_to_owned")`, and
# `tests/fixtures/security/attack_91_callable_clone_outlives_source.gg` pins the
# deep-clone path green. So the defect is in the clone PRODUCER for a
# named-local receiver, and the intended behaviour is that this prints 2.
void main():
    Callable[int(int)] h = (int x): x + 1
    Callable[int(int)] g = h.clone()
    print(g(1))
