# RUST GG BUG — `Callable[int(Struct &)]` + named-fn callback +
# `Vector.get().unwrap()` iterator pattern SIGSEGVs at runtime.
#
# Discovered R39 Phase 2e Sub-task 0 probe (2026-08-09).  See
# tests/fixtures/known_gaps/rust_gg_bug_callable_amp_struct_iterator_segv/README.md.
#
# Observed: SIGSEGV during the callback invocation.
# Intended: prints `1\n2` (each Thing's .val, one per iteration).
#
# Note: `callable_ref_param.gg` at top-level tests the DIRECT
# shape (`with_counter(f, &c)` — no Vector iteration) and passes.
# The SIGSEGV is triggered by the combination of the Vector
# unwrap into a local + the `&t` re-borrow at the callback call.

from std.collections import Vector

struct Thing:
    int val

int get_val(Thing &p):
    return p.val

Vector[int] map_thing(Vector[Thing] xs, Callable[int(Thing &)] f):
    Vector[int] out = []
    int i = 0
    while i < xs.len():
        Thing t = xs.get(i).unwrap()
        out.push(f(&t))
        i = i + 1
    return out

void main():
    Vector[Thing] xs = [Thing(1), Thing(2)]
    Vector[int] r = map_thing(xs, get_val)
    print(f"{r.get(0).unwrap()}")
    print(f"{r.get(1).unwrap()}")
