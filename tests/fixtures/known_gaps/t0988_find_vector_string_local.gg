# `Vector[String].find` with the result bound to a local `Option[String]` and
# then pattern-matched. The `Option` owns and drops its payload, so `find` must
# put an independent copy of the element in it.
from std.iter import Iterable

String mk(String a, String b):
    return a + b

void main():
    Vector[String] v = Vector[String]()
    v.push(mk("aa", "bc"))
    v.push(mk("dd", "efg"))
    Option[String] r = v.find((s): s.len() == 4)
    if r is Some(x):
        print(x)
    else:
        print("none")
