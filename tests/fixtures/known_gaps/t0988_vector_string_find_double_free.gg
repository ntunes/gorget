# `Vector[String].find(<pred>)` with the result matched inline.
#
# The `Option` the search returns owns and drops its payload, so `find` must put
# an independent copy of the matched element in it — not a pointer into the
# array's buffer, which the array frees too.
#
# Elements are heap-forced through `mk` on purpose: with string literals the
# behaviour can hide behind static storage. `from std.iter import Iterable` is
# stated explicitly because the import is a live axis on this grid — without it
# this spelling is rejected at BIR VALIDATION, before any C is emitted and
# before any link, on an unrelated defect (todo/t0987) that masks what the cell
# is for.
from std.iter import Iterable

String mk(String a, String b):
    return a + b

void main():
    Vector[String] v = Vector[String]()
    v.push(mk("a", "bc"))
    v.push(mk("de", "fg"))
    if v.find((s): s.len() == 3) is Some(s):
        print(s)
    else:
        print("none")
