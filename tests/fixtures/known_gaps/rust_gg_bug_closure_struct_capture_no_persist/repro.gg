# RUST GG BUG — Closure capturing a local struct doesn't persist
# `.method(&self)` mutations across successive closure invocations.
#
# Discovered R39 Phase 2e Sub-task 0 probe (2026-08-09) while probing
# alternative HOF-callback designs for the trailing-comma-cascade
# helper.  See tests/fixtures/known_gaps/rust_gg_bug_closure_struct_capture_no_persist/README.md.
#
# Observed: prints `1 1 1` (each call sees value=0, increments to 1).
# Intended: prints `1 2 3` (mutation persists across calls).
#
# Isolated: reproduces WITHOUT any HOF — the closure is called
# in-place three times in `main`.  So the bug is NOT about
# HOF/Callable indirection; it's specifically about how the
# closure's captured struct handle is materialized on each call.

struct Counter:
    int value

equip Counter:
    void increment(&self):
        self.value = self.value + 1
    int get(self):
        return self.value

void main():
    Counter c = Counter(0)
    auto step = ():
        c.increment()
        return c.get()
    print(f"{step()}")
    print(f"{step()}")
    print(f"{step()}")
