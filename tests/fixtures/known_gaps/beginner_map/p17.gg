void main():
    Vector[int] v = [1, 2, 3]
    int a = 0
    a = a + v.get(0).unwrap()
    print(f"plus {a}")
    int b = 0
    b += v.get(0).unwrap()
    print(f"pluseq {b}")
    int c = 5
    c -= v.get(0).unwrap()
    print(f"minuseq {c}")
    int d = 5
    d *= v.get(1).unwrap()
    print(f"muleq {d}")
    Dict[String, int] m = Dict[String, int]()
    m.put("k", 4)
    int e = 0
    e += m.get("k").unwrap()
    print(f"dict {e}")
    Option[int] o = Some(7)
    int f = 0
    f += o.unwrap()
    print(f"plainopt {f}")
