void main():
    Vector[int] v = [10, 20, 30]
    match v.index_of(20):
        case Some(i):
            print(f"idx {i}")
        case None:
            print("missing")
    match v.index_of(99):
        case Some(i):
            print(f"idx {i}")
        case None:
            print("missing")
    auto a = [10, 20, 30]
    match a.index_of(20):
        case Some(i):
            print(f"arr idx {i}")
        case None:
            print("arr missing")
    match a.index_of(99):
        case Some(i):
            print(f"arr idx {i}")
        case None:
            print("arr missing")
