struct Person:
    int age

void main():
    Vector[Person] ps = Vector[Person]()
    ps.push(Person(30))
    ps.push(Person(25))
    ps.push(Person(40))
    ps.sort((a, b): a.age - b.age)
    for p in ps:
        print(f"{p.age}")
    print("---")
    Vector[Person] qs = Vector[Person]()
    qs.push(Person(30))
    qs.push(Person(25))
    Vector[Person] sorted_qs = qs.sorted((a, b): a.age - b.age)
    for q in sorted_qs:
        print(f"{q.age}")
