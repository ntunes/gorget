void case_isempty():
    Vector[int] v = [10, 20, 30]
    bool e = v.is_empty()
    print(f"{e}")
    match v.index_of(20):
        case Some(i):
            print(f"isempty-then {i}")
        case None:
            print("isempty-then missing")

void case_contains_other_var():
    Vector[int] v = [10, 20, 30]
    Vector[int] w = [7, 8]
    bool has = w.contains(8)
    print(f"{has}")
    match v.index_of(20):
        case Some(i):
            print(f"othervar {i}")
        case None:
            print("othervar missing")

void case_contains_then_plain_call():
    Vector[int] v = [10, 20, 30]
    bool has = v.contains(20)
    print(f"{has}")
    Option[int] r = v.index_of(20)
    match r:
        case Some(i):
            print(f"viatemp {i}")
        case None:
            print("viatemp missing")

void main():
    case_isempty()
    case_contains_other_var()
    case_contains_then_plain_call()
