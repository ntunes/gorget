# D39 Phase A.3: Dict[int, Vector[int]].swap_remove — trivial key, resource
# value (nested owned buffer). Verifies the value transfers OUT to the caller
# via Option[Vector[int]] (no double-drop of the inner Vector).
#
# Axis cell: int key, Vector[int] value; MIDDLE removal.

void main():
    Dict[int, Vector[int]] d = Dict[int, Vector[int]]()
    Vector[int] v1 = Vector[int]()
    v1.push(10)
    v1.push(11)
    d.put(1, v1)

    Vector[int] v2 = Vector[int]()
    v2.push(20)
    v2.push(21)
    v2.push(22)
    d.put(2, v2)

    Vector[int] v3 = Vector[int]()
    v3.push(30)
    d.put(3, v3)

    print(f"len={d.len()}")

    # Remove key 2 — get back its Vector; iteration order is now 1,3.
    Option[Vector[int]] taken = d.swap_remove(2)
    Vector[int] out = taken.unwrap()
    print(f"taken_len={out.len()}")
    print(f"taken0={out.get(0).unwrap()} taken1={out.get(1).unwrap()} taken2={out.get(2).unwrap()}")

    print(f"len={d.len()}")
    for k in d.keys():
        Option[Vector[int]] gvo = d.get(k)
        Vector[int] gv = gvo.unwrap().clone()
        print(f"k={k} first={gv.get(0).unwrap()}")
