# The CROSS-TYPE control: `Vector[String].map` produces a `Vector[int]` whose
# element type is NOT the source's.
#
# It is correct as written and must stay correct. A `filter`/`find` remedy that
# hands the result array the SOURCE's per-element hooks is only sound where the
# result element type is identical to the source's; this cell is the one where
# it is not, and it fails loudly if that remedy ever spreads to `map`.
String mk(String a, String b):
    return a + b

void main():
    Vector[String] v = Vector[String]()
    v.push(mk("aa", "bc"))
    v.push(mk("dd", "efg"))
    Vector[int] r = v.map((s): s.len())
    r.each((n): print(n))
