# RUST GG BUG — `Callable[T(Struct &)]` + closure literal `(p): p.field`
# infers `p` as `int64_t` instead of the Callable's `Struct &` param.
#
# Discovered R39 Phase 2e Sub-task 0 probe (2026-08-09).  See
# tests/fixtures/known_gaps/rust_gg_bug_callable_amp_struct_closure_literal/README.md.
#
# Observed: prints `0` (default int64_t "read" of what should have
# been `Thing.val`).  Sometimes fails at LINK time with
# `undefined reference to 'int64_t__<method_name>'` when the closure
# body invokes a method on the mis-inferred parameter.
# Intended: prints `1` (the first Thing's `.val` field).
#
# The `(p): p.val` closure has an UNTYPED parameter `p`.  The Callable
# type `Callable[T(Thing &)]` requires `p` to be inferred as `Thing &`.
# Rust gg's closure-typing pass instead falls back to `int64_t`, so the
# resulting closure struct + generated C treat `.val` as an offset into
# an integer, producing garbage / a link failure.

from std.collections import Vector

struct Thing:
    int val

Vector[T] map_things[T](Vector[Thing] xs, Callable[T(Thing &)] f):
    Vector[T] out = []
    int i = 0
    while i < xs.len():
        Thing t = xs.get(i).unwrap()
        out.push(f(&t))
        i = i + 1
    return out

void main():
    Vector[Thing] xs = [Thing(1), Thing(2)]
    Vector[int] ys = map_things[int](xs, (p): p.val)
    print(f"{ys.get(0).unwrap()}")
