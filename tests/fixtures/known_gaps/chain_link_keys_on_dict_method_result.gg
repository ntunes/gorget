# KNOWN GAP -- CHAIN-LINK class, the DICT-RECEIVER cell.
#
# CELL: `.keys()` over a `Dict`-returning USER method. Third receiver kind on
# the receiver-TYPE axis (String / Vector / Dict), so the axis is sampled rather
# than assumed from the String rows.
#
# INTENDED OUTPUT: `1`. Rust gg answers `1` (regenerated 2026-08-29:
# `./target/debug/gg run tests/fixtures/known_gaps/chain_link_keys_on_dict_method_result.gg`).
#
# TODAY the SELF-HOST emits C that will not compile:
#   error: incompatible types when assigning to type 'GorgetMap' from type 'GorgetArray'
#
# PRE-EXISTING, not a regression: identical on a pristine `2d619258` driver.
#
# CONTROL (compiles and runs correctly on both lanes today, recorded rather than
# wired so it cannot change the asserted output):
#   Dict[String, int] loc = h.make()   then  print(loc.keys().len())   -> 1
#
# HEAP-FORCED: the receiver is a Dict field read back out of a struct.
#
# THE CLASS FIX is todo/t0712 (gate the name-list arms on the receiver type).
struct HD:
    Dict[String, int] d

equip HD:
    Dict[String, int] make(self):
        return self.d

void main():
    HD h = HD({"a": 1})
    print(h.make().keys().len())
