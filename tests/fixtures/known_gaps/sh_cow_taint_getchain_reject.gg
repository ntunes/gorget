# SELF-HOST 2T get-chain materialize reject (Core #9 SH-lane close): the
# self-host typechecker REJECTS the get-chain store below on a bare
# drop-tainted param (`E_MoveWithoutOperator`), matching Rust gg + ggdef.
# Pin for `sh_cow_taint_getchain_reject` (SH check driver must exit nonzero).
# Lives under known_gaps as a check-only NEG (not a runtime corpus fixture).
from std.collections import Vector
struct R:
    String name
equip R with Drop:
    void drop(!self):
        print(f"drop R {self.name}")
struct H:
    Vector[R] items
    int tag
void f_chain(H h):
    h.items.get(0).unwrap().name = "changed"
void main():
    H h = H([R("a")], 1)
    f_chain(h)
    print("done")
