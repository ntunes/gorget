# Error handling patterns with throws, auto-propagation, catch, rethrow

int safe_divide(int a, int b) throws String:
    if b == 0:
        throw "divide by zero"
    return a / b

int chain_ops(int x) throws String:
    int r1 = safe_divide(x, 2)!
    int r2 = safe_divide(r1, 3)!
    return r2

int rethrow_with_context(int a, int b) throws String:
    int val = safe_divide(a, b)! rethrow (String e): f"calc failed: {e}"
    return val

void main():
    # Basic Result via auto-wrapping (calling throws fn from non-throws)
    Result[int, String] r1 = safe_divide(10, 2)
    match r1:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    Result[int, String] r2 = safe_divide(10, 0)
    match r2:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # Auto-propagation through chain_ops
    Result[int, String] r3 = chain_ops(60)
    match r3:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # chain_ops(1): 1/2=0, 0/3=0
    Result[int, String] r4 = chain_ops(1)
    match r4:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # chain_ops with zero divisor propagates error
    Result[int, String] r5 = chain_ops(0)
    match r5:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # catch — success path
    int v1 = safe_divide(10, 3)! catch (e): -1
    print(f"{v1}")

    # catch — error path
    int v2 = safe_divide(10, 0)! catch (e): -1
    print(f"{v2}")

    # rethrow — success path
    Result[int, String] r6 = rethrow_with_context(10, 2)
    match r6:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # rethrow — error path (transformed message)
    Result[int, String] r7 = rethrow_with_context(10, 0)
    match r7:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    # Result capture — success gives Ok, error gives Error
    Result[int, String] r8 = safe_divide(10, 5)
    match r8:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    Result[int, String] r9 = safe_divide(10, 0)
    match r9:
        case Ok(v):
            print(f"{v}")
        case Error(e):
            print(e)

    print("done")
