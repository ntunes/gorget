struct Inner:
    int value

trait Showable:
    String show(self)

equip Inner with Showable:
    String show(self):
        return "inner"

struct Outer:
    Inner inner
    int extra

equip Outer with Showable via inner:
    pass

trait Describable:
    String describe(self)
    int count(self)

equip Inner with Describable:
    String describe(self):
        return "desc"
    int count(self):
        return self.value

struct Wrapper:
    Inner inner
    String label

equip Wrapper with Describable via inner:
    String describe(self):
        return self.label

void main():
    Inner i = Inner(42)
    Outer o = Outer(Inner(10), 5)
    String s = o.show()
    print(s)
    Wrapper w = Wrapper(Inner(7), "custom")
    String d = w.describe()
    print(d)
    int c = w.count()
    print(f"{c}")
