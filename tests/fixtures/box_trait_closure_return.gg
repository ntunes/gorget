# Box[Trait] formation cell H — Round XIX N2 residual (graduated).
# Axis: Box[Trait] · H formation · C+LLVM · Rust lane.
# RED-verify (pre-fix): pre-fix C: SIGILL 132; LLVM: SIGSEGV (make/__call returned ptr not %Box__Speaker)
# Post-fix: prints R2 on C and LLVM (Class A/B/C pack + llvm_type_full is_trait_box).
from std.collections import Box
trait Speaker:
    String speak(self)
struct Robot:
    String id
equip Robot with Speaker:
    String speak(self):
        return self.id
void main():
    Callable[Box[Speaker]()] f = (): Box.new(Robot("R2"))
    print(f().speak())
