from std.conv import ord, chr, parse_int

void main():
    str c1 = "A"
    str c2 = "3"
    str c3 = " "
    str c4 = "!"
    print(f"{c1.is_alpha()}")
    print(f"{c2.is_alpha()}")
    print(f"{c1.is_digit()}")
    print(f"{c2.is_digit()}")
    print(f"{c1.is_alphanumeric()}")
    print(f"{c4.is_alphanumeric()}")
    print(f"{c3.is_whitespace()}")
    print(f"{c4.is_whitespace()}")
    int code = ord("A")
    print(f"{code}")
    str back = chr(65)
    print(f"{back}")
    int n = parse_int("42").unwrap_or(0)
    print(f"{n}")
    int neg = parse_int("-7").unwrap_or(0)
    print(f"{neg}")
