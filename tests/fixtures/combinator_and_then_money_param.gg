# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[int] r = p.and_then((Money m): Some(size_of(m)))
    if r is Some(v):
        print(v)

void main():
    call_it(make_opt(10))
