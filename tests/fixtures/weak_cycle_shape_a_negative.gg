# Cycle-breaking proof (shape A — interior-mutability cycle).
#
# NEGATIVE CONTROL: two `Shared[Node]` values point at each other through
# a `Cell[Option[Shared[Node]]]` field. Both edges are strong, so the
# refcount never decays to zero. Under leak-tracking (mem_live or LSan),
# this fixture MUST report a leak — that's how we know the test harness
# can see a real cycle.
#
# Status: BLOCKED on missing `Cell[T]` runtime type. `Cell` is documented
# in docs/book/16-smart-pointers.md but not implemented; the resolver
# rejects it. See TODO.md "Weak[T] cycle-breaking — missing primitives".
#
# When the primitive lands, this fixture must produce:
#     leaked=true
#     done
# That is the proof that without Weak[T], a Shared cycle is a real leak.

from std.os import mem_live

struct Node:
    int id
    Cell[Option[Shared[Node]]] next

void main():
    int baseline = mem_live()
    int i = 0
    while i < 100:
        Shared[Node] a = Shared[Node](Node(1, Cell[Option[Shared[Node]]](None)))
        Shared[Node] b = Shared[Node](Node(2, Cell[Option[Shared[Node]]](None)))
        # Form the cycle: a -> b and b -> a, both strong.
        a.next.set(Some(b.clone()))
        b.next.set(Some(a.clone()))
        # At scope exit, refcounts on a and b are both still 2 (each holds
        # the other inside its Cell). Neither drops; both leak.
        i = i + 1
    int delta = mem_live() - baseline
    print(f"leaked={delta > 0}")
    print("done")
