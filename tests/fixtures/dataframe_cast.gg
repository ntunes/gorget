from xtd.dataframe import DataFrame, Column, df_from_columns, col_from_ints, col_from_floats, col_from_strs, col_from_bools, col_ints_null, df_cast

void main():
    # ── int → float ──
    Vector[int] iv = Vector[int]()
    iv.push(1)
    iv.push(2)
    iv.push(3)
    Vector[String] n1 = Vector[String]()
    n1.push("x")
    Vector[Column] c1 = Vector[Column]()
    c1.push(col_from_ints(iv))
    DataFrame df1 = df_from_columns(n1, c1)
    Result[DataFrame, String] r1 = df_cast(df1, "x", "float")
    print(f"{r1.is_ok()}")
    Column fc = r1.unwrap().get_column("x")
    print(f"{fc.dtype_name()}")
    print(f"{fc.value_as_str(0)}")
    print(f"{fc.value_as_str(2)}")

    # ── float → int (truncation toward zero) ──
    Vector[float] fv = Vector[float]()
    fv.push(3.9)
    fv.push(-2.8)
    fv.push(0.0)
    Vector[String] n2 = Vector[String]()
    n2.push("y")
    Vector[Column] c2 = Vector[Column]()
    c2.push(col_from_floats(fv))
    DataFrame df2 = df_from_columns(n2, c2)
    Result[DataFrame, String] r2 = df_cast(df2, "y", "int")
    print(f"{r2.is_ok()}")
    Column ic = r2.unwrap().get_column("y")
    print(f"{ic.value_as_str(0)}")
    print(f"{ic.value_as_str(1)}")
    print(f"{ic.value_as_str(2)}")

    # ── int → String ──
    Result[DataFrame, String] r3 = df_cast(df1, "x", "String")
    print(f"{r3.is_ok()}")
    Column sc = r3.unwrap().get_column("x")
    print(f"{sc.dtype_name()}")
    print(f"{sc.value_as_str(0)}")

    # ── String → int (non-parseable becomes null) ──
    Vector[String] sv = Vector[String]()
    sv.push("42")
    sv.push("hello")
    sv.push("7")
    Vector[String] n4 = Vector[String]()
    n4.push("z")
    Vector[Column] c4 = Vector[Column]()
    c4.push(col_from_strs(sv))
    DataFrame df4 = df_from_columns(n4, c4)
    Result[DataFrame, String] r4 = df_cast(df4, "z", "int")
    print(f"{r4.is_ok()}")
    Column zc = r4.unwrap().get_column("z")
    print(f"{zc.value_as_str(0)}")
    print(f"{zc.value_as_str(1)}")
    print(f"{zc.value_as_str(2)}")

    # ── bool → int ──
    Vector[bool] bv = Vector[bool]()
    bv.push(true)
    bv.push(false)
    Vector[String] n5 = Vector[String]()
    n5.push("b")
    Vector[Column] c5 = Vector[Column]()
    c5.push(col_from_bools(bv))
    DataFrame df5 = df_from_columns(n5, c5)
    Result[DataFrame, String] r5 = df_cast(df5, "b", "int")
    print(f"{r5.is_ok()}")
    Column bc = r5.unwrap().get_column("b")
    print(f"{bc.value_as_str(0)}")
    print(f"{bc.value_as_str(1)}")

    # ── int → bool (0 = false, nonzero = true) ──
    Result[DataFrame, String] r6 = df_cast(df1, "x", "bool")
    print(f"{r6.is_ok()}")
    Column boolc = r6.unwrap().get_column("x")
    print(f"{boolc.value_as_str(0)}")

    # ── same type → no-op ──
    Result[DataFrame, String] r7 = df_cast(df1, "x", "int")
    print(f"{r7.is_ok()}")

    # ── Error: column not found ──
    Result[DataFrame, String] r8 = df_cast(df1, "missing", "float")
    print(f"{r8.is_ok()}")

    # ── Error: unsupported target type ──
    Result[DataFrame, String] r9 = df_cast(df1, "x", "unknown")
    print(f"{r9.is_ok()}")

    # ── null propagation: int column with nulls cast to float ──
    Vector[int] ndata = Vector[int]()
    ndata.push(10)
    ndata.push(0)
    ndata.push(20)
    Vector[bool] nmask = Vector[bool]()
    nmask.push(true)
    nmask.push(false)
    nmask.push(true)
    Vector[String] n10 = Vector[String]()
    n10.push("v")
    Vector[Column] c10 = Vector[Column]()
    c10.push(col_ints_null(ndata, nmask))
    DataFrame df10 = df_from_columns(n10, c10)
    Result[DataFrame, String] r10 = df_cast(df10, "v", "float")
    print(f"{r10.is_ok()}")
    Column vc = r10.unwrap().get_column("v")
    print(f"{vc.value_as_str(0)}")
    print(f"{vc.value_as_str(1)}")
    print(f"{vc.value_as_str(2)}")

    print("done")
