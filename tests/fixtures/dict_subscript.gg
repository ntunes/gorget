from std.collections import Dict

void main():
    auto d = {"x": 10, "y": 20}

    # Subscript read
    print(f"{d["x"]}")
    print(f"{d["y"]}")

    # Subscript write (update existing)
    d["x"] = 99
    print(f"{d["x"]}")

    # Subscript write (insert new)
    d["z"] = 30
    print(f"{d["z"]}")
    print(f"{d.len()}")

    # Integer dict subscript
    auto nums = {1: 100, 2: 200}
    nums[3] = 300
    print(f"{nums[1]}")
    print(f"{nums[3]}")
    print(f"{nums.len()}")
