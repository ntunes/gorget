from std.collections import Vector

struct Wrapper:
    Vector[int] data

# ERROR: & resource param stored in struct
Wrapper wrap_mut(Vector[int] &v):
    return Wrapper(v)

# ERROR: & resource param returned
Vector[int] identity_mut(Vector[int] &v):
    return v

void main():
    Vector[int] items = [1, 2, 3]
    Wrapper w = wrap_mut(&items)
