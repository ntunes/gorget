#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; its own header says "all core features exercised without TCP"
#!  and lists the exact expected output
# Test: Router dispatch — all core features exercised without TCP.
#
# Exercises (via direct Router.dispatch):
#   - Exact GET route /hello → 200 + "hello"
#   - Exact POST route /data → 200 + "posted"
#   - Unknown GET path → 404
#   - Unknown POST path → 404
#   - Param route GET /users/:id with /users/42 → "user:42"
#   - Multi-param route GET /posts/:pid/comments/:cid → "post:7:comment:99"
#   - Query string via req.query_params() → key extraction
#   - Middleware registration count
#   - CORS middleware adds header "*"
#   - HttpServerResponse.redirect("/new-location") → 302 + Location header
#
# Expected output:
#   200\nhello\n200\nposted\n404\n404\n200\nuser:42\n200\npost:7:comment:99\nhello\n2\n*\n302\n/new-location

from xtd.httpserver import Router, HttpRequest, HttpServerResponse, parse_query_string
from std.collections import Dict

HttpServerResponse handle_hello(HttpRequest req):
    return HttpServerResponse.ok("hello")

HttpServerResponse handle_post_data(HttpRequest req):
    return HttpServerResponse.ok("posted")

HttpServerResponse handle_user(HttpRequest req):
    return HttpServerResponse.ok("user:" + req.params["id"])

HttpServerResponse handle_post_comment(HttpRequest req):
    return HttpServerResponse.ok("post:" + req.params["pid"] + ":comment:" + req.params["cid"])

HttpServerResponse cors_middleware(HttpRequest req, HttpServerResponse resp):
    return resp.with_header("access-control-allow-origin", "*")

HttpServerResponse logging_middleware(HttpRequest req, HttpServerResponse resp):
    return resp.with_header("x-proto", "http")

void main():
    Router router = Router.new()
    router.get("/hello", handle_hello)
    router.post("/data", handle_post_data)
    router.get("/users/:id", handle_user)
    router.get("/posts/:pid/comments/:cid", handle_post_comment)
    router.use(cors_middleware)
    router.use(logging_middleware)

    # 1. Exact GET /hello → 200 + "hello"
    HttpRequest req1 = HttpRequest("GET", "/hello", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp1 = router.dispatch(req1)
    print(f"{resp1.status_code}")
    print(resp1.body)

    # 2. POST /data → 200 + "posted"
    HttpRequest req2 = HttpRequest("POST", "/data", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp2 = router.dispatch(req2)
    print(f"{resp2.status_code}")
    print(resp2.body)

    # 3. Unknown GET path → 404
    HttpRequest req3 = HttpRequest("GET", "/notfound", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp3 = router.dispatch(req3)
    print(f"{resp3.status_code}")

    # 4. Unknown POST path → 404
    HttpRequest req4 = HttpRequest("POST", "/notfound", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp4 = router.dispatch(req4)
    print(f"{resp4.status_code}")

    # 5. Param route GET /users/:id
    HttpRequest req5 = HttpRequest("GET", "/users/42", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp5 = router.dispatch(req5)
    print(f"{resp5.status_code}")
    print(resp5.body)

    # 6. Multi-param GET /posts/:pid/comments/:cid
    HttpRequest req6 = HttpRequest("GET", "/posts/7/comments/99", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp6 = router.dispatch(req6)
    print(f"{resp6.status_code}")
    print(resp6.body)

    # 7. Query string via req.query_params()
    HttpRequest req7 = HttpRequest("GET", "/hello", "name=hello", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    Dict[String, String] qp = req7.query_params()
    print(qp["name"])

    # 8. Middleware count
    int mw_count = router.middlewares.len()
    print(f"{mw_count}")

    # 9. CORS * header via middleware
    HttpRequest req9 = HttpRequest("GET", "/hello", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp9 = router.dispatch(req9)
    print(resp9.headers["access-control-allow-origin"])

    # 10. redirect → 302 + Location header (validates fix 1A)
    HttpServerResponse redir = HttpServerResponse.redirect("/new-location")
    print(f"{redir.status_code}")
    print(redir.headers["Location"])
