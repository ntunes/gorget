from gg.dataframe import DataFrame, Column, df_from_csv, df_to_csv

void main():
    String csv_text = "name,age,score\nAlice,25,8.5\nBob,30,9.0\nCharlie,35,7.5"
    Result[DataFrame, String] res = df_from_csv(csv_text)
    DataFrame df = res.unwrap()

    print(f"{df.nrows()}")
    print(f"{df.ncols()}")

    String age_col = "age"
    String name_col = "name"
    String score_col = "score"
    Column ac = df.get_column(age_col)
    print(f"{ac.dtype_name()}")
    print(f"{ac.value_as_str(0)}")

    Column sc = df.get_column(score_col)
    print(f"{sc.dtype_name()}")
    print(f"{sc.value_as_str(1)}")

    Column nc = df.get_column(name_col)
    print(f"{nc.value_as_str(2)}")

    # round-trip: to_csv preserves shape
    String csv_out = df_to_csv(df)
    Result[DataFrame, String] res2 = df_from_csv(csv_out)
    DataFrame df2 = res2.unwrap()
    print(f"{df2.nrows()}")
    print(f"{df2.ncols()}")
