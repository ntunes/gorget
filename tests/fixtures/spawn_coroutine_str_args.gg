# Test string literal arguments passed to functions within a coroutine.
# Verifies Constant::Str operands are wrapped in gorget_str_from_literal.

String format_greeting(String prefix, String name):
    return prefix + " " + name

async int compute(int x):
    return x + 1

async void worker():
    Task[int] t = spawn compute(10)
    int n = t.await()
    # String literal args in coroutine context — these must be Str, not bare "..."
    String result = format_greeting("hello", "world")
    print(result)
    print(n)

async void main():
    Task[void] t = spawn worker()
    t.await()
