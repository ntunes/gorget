# Prerequisite test for Phase C: verify Dict[String, Callable[...]] works.
# Uses two-step pattern: assign to Callable local first, then put/call.
# `put` is a consuming position and `Callable[T]` is single-owner by design
# (no clone path in the lowering), so the named local is moved in with `^`.
from std.collections import Dict

int double_it(int x):
    return x * 2

int triple_it(int x):
    return x * 3

void main():
    Dict[String, Callable[int(int)]] fns = Dict[String, Callable[int(int)]]()
    Callable[int(int)] dfn = double_it
    Callable[int(int)] tfn = triple_it
    int factor = 10
    Callable[int(int)] afn = (x): x + factor
    fns.put("double", ^dfn)
    fns.put("triple", ^tfn)
    fns.put("add10", ^afn)

    Callable[int(int)] d = fns["double"]
    Callable[int(int)] t = fns["triple"]
    Callable[int(int)] a = fns["add10"]
    int r1 = d(5)
    int r2 = t(4)
    int r3 = a(7)
    print(r1)
    print(r2)
    print(r3)
