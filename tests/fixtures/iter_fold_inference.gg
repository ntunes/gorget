# Method-level generic inference — Shape 3 (fold).
#
# `A fold[A, F](self, A init, F f)` has two method-level generics:
# A appears directly as `init`'s type, and F appears directly as `f`'s
# type. Both bind via the shape-1 named-slot rule — `init`'s arg-type
# pins A, `f`'s arg-type pins F. The accumulator type can differ from
# the iterator's element type (e.g. accumulate ints into a String).

from std.collections import Vector
from std.iter import VectorIter

int sum_int(int acc, int x):
    return acc + x

float sum_into_float(float acc, int x):
    return acc + float(x)

int main():
    Vector[int] v = [1, 2, 3, 4]

    # Same-type fold: A=int, F=int(int,int).
    int total = v.iter().fold(0, sum_int)
    print(total)

    # Same-type fold with non-zero init.
    int total2 = v.iter().fold(100, sum_int)
    print(total2)

    # Cross-type fold: A=float (from init), F=float(float,int) (from f).
    # T (iter element) is int — A is allowed to differ.
    float ftot = v.iter().fold(0.5, sum_into_float)
    print(ftot)

    return 0
