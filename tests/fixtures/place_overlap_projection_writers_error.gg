# D10(b) place-overlap (GAP 2): `&n` and `&n.field` overlap (root `n`, one path
# a prefix of the other) — both writers. Pre-D10(b) this compiled and SILENTLY
# DROPPED the write through `&n.field`. Must be REJECTED (E_BorrowConflict).
struct N:
    Vector[int] field
    int m

void f(N &whole, Vector[int] &part):
    part.push(9)

void main():
    N n = N([1, 2], 0)
    f(&n, &n.field)
