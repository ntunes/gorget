from std.bytes import bytes_from_str, bytes_to_str, bytes_from_hex, bytes_to_hex
from std.bytes import bytes_write_u32_be, bytes_read_u32_be
from std.bytes import bytes_write_u16_be, bytes_read_u16_be
from std.bytes import bytes_write_u32_le, bytes_read_u32_le
from std.bytes import bytes_write_u16_le, bytes_read_u16_le
from std.bytes import bytes_concat, bytes_slice, random_bytes
from std.bytes import base64_encode, base64_decode
from std.collections import Vector

void main():
    # str → bytes → str roundtrip
    Vector[uint8] b = bytes_from_str("Hello")
    print(f"{b.len()}")
    str s = bytes_to_str(b).unwrap()
    print(s)

    # hex roundtrip
    Vector[uint8] h = bytes_from_hex("48656c6c6f")
    str hs = bytes_to_str(h).unwrap()
    print(hs)

    # bytes_to_hex
    str hex = bytes_to_hex(h)
    print(hex)

    # big-endian u32 read/write
    Vector[uint8] buf = bytes_from_hex("00000000aabbccdd")
    bytes_write_u32_be(&buf, 0, 305419896)
    int val = bytes_read_u32_be(buf, 0)
    print(f"{val}")

    # read the second u32
    int val2 = bytes_read_u32_be(buf, 4)
    print(f"{val2}")

    # big-endian u16 read/write
    Vector[uint8] buf16 = bytes_from_hex("00001234")
    bytes_write_u16_be(&buf16, 0, 4660)
    int v16 = bytes_read_u16_be(buf16, 0)
    print(f"{v16}")

    # little-endian u32 read/write
    Vector[uint8] le_buf = bytes_from_hex("0000000000000000")
    bytes_write_u32_le(&le_buf, 0, 305419896)
    int le_val = bytes_read_u32_le(le_buf, 0)
    print(f"{le_val}")
    # verify byte order: 305419896 = 0x12345678
    # LE stores as 78 56 34 12
    str le_hex = bytes_to_hex(le_buf)
    print(le_hex)

    # little-endian u16 read/write
    Vector[uint8] le_buf16 = bytes_from_hex("00000000")
    bytes_write_u16_le(&le_buf16, 0, 4660)
    int le_v16 = bytes_read_u16_le(le_buf16, 0)
    print(f"{le_v16}")
    # verify byte order: 4660 = 0x1234, LE stores as 34 12
    str le_hex16 = bytes_to_hex(le_buf16)
    print(le_hex16)

    # concat
    Vector[uint8] a = bytes_from_str("Hello")
    Vector[uint8] c = bytes_from_str(" World")
    Vector[uint8] cat = bytes_concat(a, c)
    print(bytes_to_str(cat).unwrap())

    # slice
    Vector[uint8] sl = bytes_slice(cat, 0, 5)
    print(bytes_to_str(sl).unwrap())

    # random_bytes produces correct length
    Vector[uint8] r = random_bytes(16)
    print(f"{r.len()}")

    # base64 encode
    str b64_enc = base64_encode(bytes_from_str("Hello"))
    print(b64_enc)

    # base64 decode
    auto b64_dec = base64_decode("SGVsbG8=")
    match b64_dec:
        case Ok(b64_decoded):
            print(bytes_to_str(b64_decoded).unwrap())
        else:
            print("error")

    # base64 roundtrip empty
    print(base64_encode(Vector[uint8]()))

    # base64 decode error
    auto b64_bad = base64_decode("!!!")
    match b64_bad:
        case Error(b64_msg):
            print("caught error")
        else:
            print("unexpected ok")

    print("done")
