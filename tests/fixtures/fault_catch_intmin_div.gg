# D26 division-split: a single signed `/!` distinguishes overflow (INT_MIN / -1)
# from divzero. Post-D25 (no fault-catch) the D26 `Result[T, ArithError]` form
# is the canonical path.
void main():
    int imin = -9223372036854775807 - 1
    int neg1 = -1
    Result[int, ArithError] a = imin /! neg1
    match a:
        case Ok(_):                        print("0")
        case Error(ArithError.Overflow):   print("1")
        case Error(ArithError.DivByZero):  print("2")
    Result[int, ArithError] b = imin /! neg1
    match b:
        case Ok(_):     print("0")
        case Error(_):  print("11")
    int z = 0
    Result[int, ArithError] c = 10 /! z
    match c:
        case Ok(_):     print("0")
        case Error(_):  print("22")
    Result[int, ArithError] d = imin %! neg1
    match d:
        case Ok(_):     print("0")
        case Error(_):  print("33")
