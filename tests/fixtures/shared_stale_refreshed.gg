# Test: no stale warning when local is refreshed after await.
# Reading shared var before await, then reassigning the local after await,
# should NOT produce a stale-condition warning.

directive scheduler=single

from std.async import sleep

async void worker(int &counter):
    counter = counter + 1

async void main():
    shared int x = 0
    Task[void] t = spawn worker(&x)
    int val = x
    t.await()
    val = x
    if val > 0:
        print("refreshed")
    print(x)
