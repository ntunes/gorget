# Lifetime error: String view from owned String, source moved
# (After str/String unification, String takes ownership of return value;
#  the original TemporaryBorrow error is subsumed by ownership transfer.
#  This test now verifies use-after-move on a view derived from the owned result.)
void consume(String !s):
    pass

void main():
    String s = "hello" + ""
    String v = s.as_str()
    consume(!s)
    print(v)
