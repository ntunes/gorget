# Comprehensive Vector[int] method coverage
from std.collections import Vector

Vector[int] expand_int(int x):
    Vector[int] r = Vector[int]()
    r.push(x)
    r.push(x * 10)
    return r

void main():
    # --- Construction ---
    Vector[int] v = Vector[int]()
    print(f"{v.len()}")
    print(f"{v.is_empty()}")

    # --- push / len ---
    v.push(1)
    v.push(2)
    v.push(3)
    print(f"{v.len()}")

    # --- get (bounds check) ---
    print(f"{v.get(0).unwrap()}")
    print(f"{v.get(2).unwrap()}")
    print(f"{v.get(99).is_none()}")

    # --- set ---
    v.set(0, 10)
    print(f"{v.get(0).unwrap()}")

    # --- contains ---
    print(f"{v.contains(10)}")
    print(f"{v.contains(99)}")

    # --- index_of ---
    print(f"{v.index_of(10).unwrap()}")
    print(f"{v.index_of(99).is_none()}")

    # --- insert ---
    v.insert(1, 20)
    # v is now [10, 20, 2, 3]
    print(f"{v.get(0).unwrap()}")
    print(f"{v.get(1).unwrap()}")
    print(f"{v.get(2).unwrap()}")
    print(f"{v.get(3).unwrap()}")

    # --- remove ---
    Option[int] rem = v.remove(0)
    print(f"{rem.unwrap()}")
    print(f"{v.remove(99).is_none()}")

    # --- pop ---
    # v is now [20, 2, 3]
    Option[int] popped = v.pop()
    print(f"{popped.unwrap()}")

    # pop until empty
    v.pop()
    v.pop()
    print(f"{v.pop().is_none()}")

    # --- first / last ---
    v.push(5)
    v.push(6)
    v.push(7)
    print(f"{v.first().unwrap()}")
    print(f"{v.last().unwrap()}")
    Vector[int] empty = Vector[int]()
    print(f"{empty.first().is_none()}")
    print(f"{empty.last().is_none()}")

    # --- clear ---
    v.clear()
    print(f"{v.len()}")
    print(f"{v.is_empty()}")

    # --- reserve ---
    v.reserve(100)
    print(f"{v.len()}")

    # --- clone ---
    Vector[int] orig = Vector[int]()
    orig.push(1)
    orig.push(2)
    orig.push(3)
    Vector[int] cloned = orig.clone()
    orig.set(0, 99)
    print(f"{cloned.get(0).unwrap()}")
    print(f"{cloned.len()}")

    # --- extend ---
    Vector[int] a = Vector[int]()
    a.push(1)
    a.push(2)
    Vector[int] b = Vector[int]()
    b.push(3)
    b.push(4)
    a.extend(b)
    print(f"{a.len()}")
    print(f"{a.get(2).unwrap()}")
    print(f"{a.get(3).unwrap()}")
    # extend with empty
    Vector[int] mt = Vector[int]()
    a.extend(mt)
    print(f"{a.len()}")

    # --- slice ---
    Vector[int] sl = a[1:3]
    print(f"{sl.len()}")
    print(f"{sl.get(0).unwrap()}")
    print(f"{sl.get(1).unwrap()}")
    # empty slice
    Vector[int] esl = a[0:0]
    print(f"{esl.len()}")

    # --- sort ---
    Vector[int] unsorted = Vector[int]()
    unsorted.push(3)
    unsorted.push(1)
    unsorted.push(2)
    unsorted.sort()
    print(f"{unsorted.get(0).unwrap()}")
    print(f"{unsorted.get(1).unwrap()}")
    print(f"{unsorted.get(2).unwrap()}")

    # --- sorted (immutable) ---
    Vector[int] orig2 = Vector[int]()
    orig2.push(5)
    orig2.push(2)
    orig2.push(8)
    Vector[int] s = orig2.sorted()
    print(f"{s.get(0).unwrap()}")
    print(f"{s.get(1).unwrap()}")
    print(f"{s.get(2).unwrap()}")
    print(f"{orig2.get(0).unwrap()}")

    # --- reverse ---
    Vector[int] rv = Vector[int]()
    rv.push(1)
    rv.push(2)
    rv.push(3)
    rv.reverse()
    print(f"{rv.get(0).unwrap()}")
    print(f"{rv.get(1).unwrap()}")
    print(f"{rv.get(2).unwrap()}")

    # --- reversed (immutable) ---
    Vector[int] rv2 = Vector[int]()
    rv2.push(10)
    rv2.push(20)
    rv2.push(30)
    Vector[int] rev = rv2.reversed()
    print(f"{rev.get(0).unwrap()}")
    print(f"{rv2.get(0).unwrap()}")

    # --- unique ---
    Vector[int] dupes = Vector[int]()
    dupes.push(1)
    dupes.push(2)
    dupes.push(2)
    dupes.push(3)
    dupes.push(3)
    dupes.push(3)
    Vector[int] uniq = dupes.unique()
    print(f"{uniq.len()}")

    # --- binary_search ---
    Vector[int] bs = Vector[int]()
    bs.push(10)
    bs.push(20)
    bs.push(30)
    print(f"{bs.binary_search(20)}")
    print(f"{bs.binary_search(99)}")

    # --- filter ---
    Vector[int] nums = Vector[int]()
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    Vector[int] evens = nums.filter((int x): x % 2 == 0)
    print(f"{evens.len()}")
    print(f"{evens.get(0).unwrap()}")
    print(f"{evens.get(1).unwrap()}")
    # filter none match
    Vector[int] none_match = nums.filter((int x): x > 100)
    print(f"{none_match.len()}")

    # --- map ---
    Vector[int] doubled = nums.map((int x): x * 2)
    print(f"{doubled.get(0).unwrap()}")
    print(f"{doubled.get(3).unwrap()}")

    # --- fold ---
    int total = nums.fold(0, (int acc, int x): acc + x)
    print(f"{total}")
    # fold on empty
    int empty_fold = empty.fold(42, (int acc, int x): acc + x)
    print(f"{empty_fold}")

    # --- reduce ---
    int reduced = nums.reduce((int a, int b): a + b)
    print(f"{reduced}")

    # --- any ---
    print(f"{nums.any((int x): x > 3)}")
    print(f"{nums.any((int x): x > 100)}")
    # any on empty
    print(f"{empty.any((int x): x > 0)}")

    # --- all ---
    print(f"{nums.all((int x): x > 0)}")
    print(f"{nums.all((int x): x > 2)}")
    # all on empty
    print(f"{empty.all((int x): x > 0)}")

    # --- enumerate (for-loop) ---
    Vector[int] en = Vector[int]()
    en.push(10)
    en.push(20)
    en.push(30)
    for (i, val) in en.enumerate():
        print(f"{i}:{val}")

    # --- each ---
    Vector[int] ec = Vector[int]()
    ec.push(100)
    ec.push(200)
    ec.each((int x): print(f"{x}"))

    # --- flat_map ---
    Vector[int] fm = Vector[int]()
    fm.push(1)
    fm.push(2)
    Vector[int] flat = fm.flat_map((int x): expand_int(x))
    print(f"{flat.len()}")
    print(f"{flat.get(0).unwrap()}")
    print(f"{flat.get(1).unwrap()}")
    print(f"{flat.get(2).unwrap()}")
    print(f"{flat.get(3).unwrap()}")
