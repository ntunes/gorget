# Comprehensive Set[int] method coverage (order-independent)
# HashSet tests — using Set[int] (HashSet is an alias with same hash-based behavior)
from std.collections import Set

void main():
    # --- Construction ---
    Set[int] s = Set[int]()
    print(f"{s.len()}")
    print(f"{s.is_empty()}")

    # --- add ---
    s.add(1)
    s.add(2)
    s.add(3)
    print(f"{s.len()}")
    # duplicate
    s.add(2)
    print(f"{s.len()}")

    # --- contains ---
    print(f"{s.contains(1)}")
    print(f"{s.contains(99)}")

    # --- remove ---
    bool rem1 = s.remove(2)
    print(f"{rem1}")
    bool rem2 = s.remove(99)
    print(f"{rem2}")
    print(f"{s.len()}")

    # --- clear ---
    Set[int] s2 = Set[int]()
    s2.add(10)
    s2.clear()
    print(f"{s2.len()}")
    print(f"{s2.is_empty()}")

    # --- Set algebra ---
    Set[int] a = Set[int]()
    a.add(1)
    a.add(2)
    a.add(3)
    Set[int] b = Set[int]()
    b.add(2)
    b.add(3)
    b.add(4)

    # union
    Set[int] u = a.union(b)
    print(f"{u.len()}")

    # intersection
    Set[int] inter = a.intersection(b)
    print(f"{inter.len()}")

    # difference (asymmetric)
    Set[int] diff_ab = a.difference(b)
    print(f"{diff_ab.len()}")
    print(f"{diff_ab.contains(1)}")
    Set[int] diff_ba = b.difference(a)
    print(f"{diff_ba.len()}")
    print(f"{diff_ba.contains(4)}")

    # --- is_subset / is_superset ---
    Set[int] sub = Set[int]()
    sub.add(1)
    sub.add(2)
    print(f"{sub.is_subset(a)}")
    print(f"{a.is_subset(sub)}")
    # reflexive
    print(f"{a.is_subset(a)}")

    print(f"{a.is_superset(sub)}")
    print(f"{sub.is_superset(a)}")

    # --- Edge cases ---
    Set[int] empty = Set[int]()
    Set[int] u_empty = a.union(empty)
    print(f"{u_empty.len()}")
    Set[int] disjoint = Set[int]()
    disjoint.add(10)
    disjoint.add(20)
    Set[int] i_dis = a.intersection(disjoint)
    print(f"{i_dis.len()}")

    # --- fold (order-independent sum) ---
    int total = a.fold(0, (int acc, int x): acc + x)
    print(f"{total}")

    # --- filter ---
    Set[int] evens = a.filter((int x): x % 2 == 0)
    print(f"{evens.len()}")
