# R39 Phase 2e Round-close R1 (2026-08-09) — `??` with `SBreak`
# divergent RHS wrapped in a multi-line `do:` block.  `break` isn't
# valid in bare expression position (Rust gg rejects at parse; D19
# retired `break EXPR`), so the divergent-break RHS is spelled as a
# multi-line `do:` block containing a `break` stmt — the `EDo` wraps
# the `SBreak`.  Type inference walks the last stmt via
# `infer_stmt_return_type`; the pre-fold `else` arm returned
# `void_id`, false-rejecting the whole expression.
#
# RED signature pre-fold (against HEAD 0fb64cf0c): the pre-fold
# infer_stmt_return_type fell through to `else: return types.void_id`
# for `SBreak`, so the enclosing `do:` `EDo` typed as `void`.
# Neither the inner `int` nor the same `Option[int]` carrier, so
# `check_default_op_rhs` at typecheck.gg:699-707 rejected with
# `E_DefaultOpRhsTypeMismatch`.
#
# Post-fold: `SBreak() → never_id` accepts.

int scan(Vector[Option[int]] xs):
    int total = 0
    int i = 0
    while i < xs.len():
        Option[int] o = xs.get(i).unwrap()
        int v = o ?? do:
            break
        total = total + v
        i = i + 1
    return total

void main():
    Vector[Option[int]] a = [Some(10), Some(20), Some(30)]
    print(f"{scan(a)}")
    Vector[Option[int]] b = [Some(10), None, Some(30)]
    print(f"{scan(b)}")
