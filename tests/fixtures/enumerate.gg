void main():
    # Vector enumerate
    Vector[String] words = ["hello", "world", "foo"]
    for (i, word) in words.enumerate():
        print(f"{i}: {word}")

    # String enumerate
    String text = "abc"
    for (i, ch) in text.enumerate():
        print(f"{i}: {ch}")

    # Empty collection
    Vector[int] empty = []
    for (i, x) in empty.enumerate():
        print("should not print")
    print("done")
