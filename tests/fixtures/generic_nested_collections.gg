from std.collections import Dict

void main():
    Dict[String, Vector[int]] groups = Dict[String, Vector[int]]()
    Vector[int] evens = [2, 4, 6]
    Vector[int] odds = [1, 3, 5]
    groups["even"] = !evens
    groups["odd"] = !odds

    auto e = groups["even"]
    print(e.len())
    print(e[0])
    auto o = groups["odd"]
    print(o.len())
    print(o[2])
