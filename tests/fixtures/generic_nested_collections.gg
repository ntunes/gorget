from std.collections import Dict

void main():
    Dict[str, Vector[int]] groups = Dict[str, Vector[int]]()
    Vector[int] evens = [2, 4, 6]
    Vector[int] odds = [1, 3, 5]
    groups["even"] = move evens
    groups["odd"] = move odds

