enum Color:
    Red
    Green
    Blue

void main():
    # match on Option containing enum
    Option[Color] c1 = Some(Color.Red())
    Option[Color] c2 = None

    match c1:
        case Some(Color.Red()):
            print("some red")
        case Some(Color.Green()):
            print("some green")
        case Some(Color.Blue()):
            print("some blue")
        case None:
            print("none")

    match c2:
        case Some(c):
            print("has color")
        case None:
            print("no color")

    # match on Result containing values
    Result[int, String] r1 = Ok(42)
    Result[int, String] r2 = Error("oops")

    match r1:
        case Ok(n):
            print(f"ok: {n}")
        case Error(e):
            print(f"err: {e}")

    match r2:
        case Ok(n):
            print(f"ok: {n}")
        case Error(e):
            print(f"err: {e}")
