# Self-hosting parser AST types for the Gorget programming language.
# Defines all node types used in the abstract syntax tree.

from std.collections import Vector

# ── Spans ────────────────────────────────────────────────────

struct Span:
    int start
    int end

struct SpannedExpr:
    Expr expr
    Span span

struct SpannedType:
    Type ty
    Span span

struct SpannedPattern:
    Pattern pat
    Span span

# ── Types ────────────────────────────────────────────────────

enum Type:
    TPrimitive(str)
    TNamed(str, Vector[SpannedType])
    TArray(Box[SpannedType], int)
    TSlice(Box[SpannedType])
    TTuple(Vector[SpannedType])
    TFunction(Box[SpannedType], Vector[SpannedType], Vector[int])
    TSelf
    TInferred

# ── Patterns ─────────────────────────────────────────────────

enum Pattern:
    PWildcard
    PBinding(str)
    PLiteral(SpannedExpr)
    PConstructor(str, Vector[SpannedPattern])
    PDotShorthand(str, Vector[SpannedPattern])
    PTuple(Vector[SpannedPattern])
    POr(Vector[SpannedPattern])
    PRest

# ── Expressions ──────────────────────────────────────────────

enum Expr:
    EIntLiteral(int)
    EFloatLiteral(float)
    EBoolLiteral(bool)
    EStringLiteral(str, bool)
    ECharLiteral(str)
    ENoneLiteral
    EIdentifier(str)
    ESelfExpr
    EIt
    EBinaryOp(Box[SpannedExpr], str, Box[SpannedExpr])
    EUnaryOp(str, Box[SpannedExpr])
    ECall(Box[SpannedExpr], Vector[SpannedExpr], Vector[SpannedType])
    EMethodCall(Box[SpannedExpr], str, Vector[SpannedExpr], Vector[SpannedType])
    EFieldAccess(Box[SpannedExpr], str)
    EIndex(Box[SpannedExpr], Box[SpannedExpr])
    ERange(Option[Box[SpannedExpr]], Option[Box[SpannedExpr]])
    EIf(Box[SpannedExpr], Vector[Stmt], Vector[ElseBranch])
    EMatch(Box[SpannedExpr], Vector[MatchArm])
    EClosure(Vector[Param], Vector[Stmt])
    EImplicitClosure(Box[SpannedExpr])
    EArrayLiteral(Vector[SpannedExpr])
    ETupleLiteral(Vector[SpannedExpr])
    EDictLiteral(Vector[SpannedExpr], Vector[SpannedExpr])
    EStructLiteral(str, Vector[str], Vector[SpannedExpr])
    EDotShorthand(str, Vector[SpannedExpr])
    ETry(Box[SpannedExpr])
    EMove(Box[SpannedExpr])
    EMutableBorrow(Box[SpannedExpr])
    EDeref(Box[SpannedExpr])
    EAs(Box[SpannedExpr], Box[SpannedType])
    EBlock(Vector[Stmt])
    EListComp(Box[SpannedExpr], str, Box[SpannedExpr], Option[Box[SpannedExpr]])
    ESetComp(Box[SpannedExpr], str, Box[SpannedExpr], Box[SpannedExpr])
    EDictComp(Box[SpannedExpr], Box[SpannedExpr], str, Box[SpannedExpr])
    EDefaultOp(Box[SpannedExpr], Box[SpannedExpr])
    EIs(Box[SpannedExpr], bool, Box[SpannedPattern])
    EDo(Vector[Stmt])
    EAwait(Box[SpannedExpr])
    ESpawn(Box[SpannedExpr])
    ESpawnBlocking(Box[SpannedExpr])
    ERethrow(Box[SpannedExpr], Option[str], Option[Box[SpannedType]], Box[SpannedExpr])
    ECatch(Box[SpannedExpr], str, Box[SpannedExpr])

# ── Statements ───────────────────────────────────────────────

enum Stmt:
    SVarDecl(SpannedType, str, SpannedExpr, int, int, int)
    SAssign(SpannedExpr, SpannedExpr)
    SCompoundAssign(SpannedExpr, str, SpannedExpr)
    SExpr(SpannedExpr)
    SReturn(Option[SpannedExpr])
    SThrow(SpannedExpr)
    SBreak(Option[SpannedExpr])
    SContinue
    SPass
    SMeta
    SMetaFor(Vector[Stmt])
    SMetaIf(Vector[Stmt], Vector[ElseBranch])
    SFor(SpannedPattern, SpannedExpr, Vector[Stmt], int, Vector[Stmt])
    SWhile(SpannedExpr, Vector[Stmt])
    SLoop(Vector[Stmt])
    SIf(SpannedExpr, Vector[Stmt], Vector[ElseBranch])
    SMatch(SpannedExpr, Vector[MatchArm])
    SWith(SpannedExpr, str, Vector[Stmt])
    SAssert(SpannedExpr, Option[str])
    SAssertReturn(SpannedExpr, Option[str])
    SNamedScope(str, Vector[Stmt])
    SSelect(Vector[SelectArm])
    SOnError(Vector[Stmt])
    SItem(Item)
    SSnapshot(str, int, SpannedExpr)

# ── Items ────────────────────────────────────────────────────

enum Item:
    IFunction(FunctionDef)
    IStruct(StructDef)
    IEnum(EnumDef)
    ITrait(TraitDef)
    IEquip(EquipBlock)
    IImport(ImportStmt)
    IDirective(str, str)
    ITypeAlias(str, Vector[str], SpannedType)
    INewtype(str, SpannedType)
    IConstDecl(SpannedType, str, SpannedExpr)
    IMetaConst(SpannedType, str, SpannedExpr)
    IMetaType(str, MetaTypeRhs)
    IMetaTypeFunc(str)
    IMetaAssert
    IMetaIf
    IMetaLog
    IStaticDecl(SpannedType, str, SpannedExpr)
    IExternBlock(Vector[FunctionDef])
    ITest(str, Vector[SpannedExpr], Vector[str], Vector[Stmt])
    IBench(str, Vector[Stmt])
    ISuiteSetup(Vector[Stmt])
    ISuiteTeardown(Vector[Stmt])

# ── Meta type RHS ────────────────────────────────────────────

enum MetaTypeRhs:
    MtrPlain(SpannedType)
    MtrConditional(SpannedType, str, SpannedType)
    MtrCall(str, Vector[SpannedExpr])
    MtrUnresolved

# ── Supporting structures ────────────────────────────────────

struct Param:
    SpannedType param_type
    str param_name
    int ownership

struct FunctionDef:
    str name
    Vector[Param] params
    SpannedType return_type
    Vector[str] type_params
    Vector[Stmt] body
    bool is_expr_body

struct StructDef:
    str name
    Vector[Param] fields
    Vector[str] type_params
    Vector[str] derives

struct EnumDef:
    str name
    Vector[EnumVariant] variants
    Vector[str] type_params
    Vector[str] derives

struct EnumVariant:
    str name
    Vector[SpannedType] fields

struct TraitDef:
    str name
    Vector[str] type_params
    Vector[FunctionDef] methods
    Vector[str] parent_traits

struct EquipBlock:
    SpannedType target
    Vector[str] type_params
    Option[str] trait_name
    Vector[FunctionDef] methods

struct MatchArm:
    SpannedPattern pattern
    Option[SpannedExpr] guard
    Vector[Stmt] body

struct ElseBranch:
    Option[SpannedExpr] condition
    Vector[Stmt] body

struct ImportStmt:
    str module_path
    Vector[str] names

enum SelectOp:
    SORecv(str, int, SpannedExpr)
    SOSend(SpannedExpr, SpannedExpr)

struct SelectArm:
    SelectOp op
    Vector[Stmt] body

struct Module:
    Vector[Item] items
