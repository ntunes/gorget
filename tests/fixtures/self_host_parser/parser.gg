# Self-hosting recursive-descent parser for the Gorget programming language.
# Consumes a token stream from the lexer and produces an AST.

from std.collections import Vector
from lexer import lex_tokenize, SpannedToken, Token, Keyword, StringLiteral, StringKind, StringSegment
from ast import Module, Item, Stmt, Expr, Type, Pattern, Span, SpannedExpr, SpannedType, SpannedPattern, FunctionDef, StructDef, EnumDef, EnumVariant, TraitDef, EquipBlock, MatchArm, ElseBranch, Param, ImportStmt
from diagnostic import Diagnostic, DiagKind, DkParseError

