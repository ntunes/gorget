            return 0

# ── Helper: decompose 'expr as name' for with-statement ─────
# parse_expr() consumes 'expr as name' as EAs(expr, type);
# extract the inner expression and binding name.

Stmt decompose_with_stmt(SpannedExpr !full_expr, Vector[Stmt] !body):
    match full_expr.expr:
        case EAs(inner_expr, cast_ty):
            String name = ""
            match (*cast_ty).ty:
                case TNamed(type_name, _):
                    name = type_name
                else:
                    pass
            return SWith(*inner_expr, name, body)
        case EIdentifier(ident_name):
            return SWith(!full_expr, ident_name, body)
        else:
            return SWith(!full_expr, "", body)

# ── Helper: extract identifier name ─────────────────────────

String token_ident(Token tok):
    match tok:
        case TkIdentifier(name):
            return name
        else:
            return ""

int token_int_val(Token tok):
    match tok:
        case TkInt(v):
            return v
        else:
            return 0

float token_float_val(Token tok):
    match tok:
        case TkFloat(v):
            return v
        else:
            return 0.0

String token_string_val(Token tok):
    match tok:
        case TkString(slit):
            String result = ""
            int i = 0
            while i < slit.lex_segments.len():
                StringSegment seg = slit.lex_segments.get(i).unwrap()
                match seg:
                    case SegLiteral(s):
                        result = result + s
                    case SegInterpolation(s, _):
                        String open_b = r"{"
                        String close_b = r"}"
                        result = result + open_b + s + close_b
                i = i + 1
            return result
        else:
            return ""

bool token_has_interpolation(Token tok):
    match tok:
        case TkString(slit):
            int i = 0
            while i < slit.lex_segments.len():
                StringSegment seg = slit.lex_segments.get(i).unwrap()
                match seg:
                    case SegInterpolation(_, _):
                        return true
                    else:
                        pass
                i = i + 1
            return false
        else:
            return false

String token_char_val(Token tok):
    match tok:
        else:
            return ""

# ── Helper: convert parsed type to name string ──────────────

SpannedType stype_vec_get(Vector[SpannedType] v, int i):
    return v.get(i).unwrap()

int stype_vec_len(Vector[SpannedType] v):
    return v.len()

String type_to_name(SpannedType st):
    match st.ty:
        case TPrimitive(name):
            return "" + name
        case TNamed(name, args):
            if stype_vec_len(args) == 0:
                return "" + name
            String result = name + "["
            int i = 0
            while i < stype_vec_len(args):
                if i > 0:
                    result = result + ", "
                SpannedType a = stype_vec_get(args, i)
                result = result + type_to_name(a)
                i = i + 1
            result = result + "]"
            return result
        else:
            return "?"

# ── Helper: check if keyword is a type keyword ──────────────


# Check if an expression contains the implicit `it` parameter.
# Stops at closure boundaries (it inside a closure belongs to that closure).
bool expr_contains_it(Expr e):
    # Simple tag check — "it" keyword detection doesn't need deep traversal
    # for the self-host parser's use case (only top-level check).
    match e:
        case EIt():
            return true
        case EIdentifier(name):
            return name == "it"
        else:
            return false

bool is_type_keyword(int kw):
    if kw == KW_INT:
        return true
    elif kw == KW_INT8:
        return true
    elif kw == KW_INT16:
        return true
    elif kw == KW_INT32:
        return true
    elif kw == KW_INT64:
        return true
    elif kw == KW_UINT:
        return true
    elif kw == KW_UINT8:
        return true
    elif kw == KW_UINT16:
        return true
    elif kw == KW_UINT32:
        return true
    elif kw == KW_UINT64:
        return true
    elif kw == KW_FLOAT:
        return true
    elif kw == KW_FLOAT32:
        return true
    elif kw == KW_FLOAT64:
        return true
    elif kw == KW_BOOL:
        return true
    elif kw == KW_CHAR:
        return true
    elif kw == KW_STR:
        return true
    elif kw == KW_STRING_TYPE:
        return true
    elif kw == KW_VOID:
        return true
    elif kw == KW_AUTO:
        return true
    elif kw == KW_SELF_UPPER:
        return true
    return false

