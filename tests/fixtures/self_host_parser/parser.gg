# ── Operator helpers ─────────────────────────────────────────

String op_str(int tag):
    if tag == TOK_PLUS:
        return "+"
    elif tag == TOK_MINUS:
        return "-"
    elif tag == TOK_STAR:
        return "*"
    elif tag == TOK_STARSTAR:
        return "**"
    elif tag == TOK_SLASH:
        return "/"
    elif tag == TOK_PERCENT:
        return "%"
    elif tag == TOK_EQEQ:
        return "=="
    elif tag == TOK_BANGEQ:
        return "!="
    elif tag == TOK_LT:
        return "<"
    elif tag == TOK_GT:
        return ">"
    elif tag == TOK_LTEQ:
        return "<="
    elif tag == TOK_GTEQ:
        return ">="
    elif tag == TOK_LTLT:
        return "<<"
    elif tag == TOK_GTGT:
        return ">>"
    elif tag == TOK_AMP:
        return "&"
    elif tag == TOK_PIPE:
        return "|"
    elif tag == TOK_CARET:
        return "^"
    elif tag == TOK_DOTDOT:
        return ".."
    elif tag == TOK_DOUBLEQUESTION:
        return "??"
    return ""

String compound_op_str(int tag):
    if tag == TOK_PLUSEQ:
        return "+="
    elif tag == TOK_MINUSEQ:
        return "-="
    elif tag == TOK_STAREQ:
        return "*="
    elif tag == TOK_SLASHEQ:
        return "/="
    elif tag == TOK_PERCENTEQ:
        return "%="
    elif tag == TOK_AMPEQ:
        return "&="
    elif tag == TOK_PIPEEQ:
        return "|="
    elif tag == TOK_CARETEQ:
        return "^="
    elif tag == TOK_LTLTEQ:
        return "<<="
    elif tag == TOK_GTGTEQ:
        return ">>="
    elif tag == TOK_PLUSPERCENTEQ:
        return "+%="
    elif tag == TOK_MINUSPERCENTEQ:
        return "-%="
    elif tag == TOK_STARPERCENTEQ:
        return "*%="
    elif tag == TOK_STARSTAREQ:
        return "**="
    return ""

bool is_compound_assign(int tag):
    if tag == TOK_PLUSEQ:
        return true
    elif tag == TOK_MINUSEQ:
        return true
    elif tag == TOK_STAREQ:
        return true
    elif tag == TOK_SLASHEQ:
        return true
    elif tag == TOK_PERCENTEQ:
        return true
    elif tag == TOK_AMPEQ:
        return true
    elif tag == TOK_PIPEEQ:
        return true
    elif tag == TOK_CARETEQ:
        return true
    elif tag == TOK_LTLTEQ:
        return true
    elif tag == TOK_GTGTEQ:
        return true
    elif tag == TOK_PLUSPERCENTEQ:
        return true
    elif tag == TOK_MINUSPERCENTEQ:
        return true
    elif tag == TOK_STARPERCENTEQ:
        return true
    elif tag == TOK_STARSTAREQ:
        return true
    return false

# ── Binding power for Pratt parser ──────────────────────────

int infix_left_bp(int tag):
    if tag == TOK_DOUBLEQUESTION:
        return 3
    elif tag == TOK_DOTDOT:
        return 23
    elif tag == TOK_DOTDOTEQ:
        return 23
    elif tag == TOK_EQEQ:
        return 11
    elif tag == TOK_BANGEQ:
        return 11
    elif tag == TOK_LT:
        return 13
    elif tag == TOK_GT:
        return 13
    elif tag == TOK_LTEQ:
        return 13
    elif tag == TOK_GTEQ:
        return 13
    elif tag == TOK_PIPE:
        return 17
    elif tag == TOK_CARET:
        return 19
    elif tag == TOK_AMP:
        return 21
    elif tag == TOK_LTLT:
        return 25
    elif tag == TOK_GTGT:
        return 25
    elif tag == TOK_PLUS:
        return 27
    elif tag == TOK_MINUS:
        return 27
    elif tag == TOK_STAR:
        return 29
    elif tag == TOK_SLASH:
        return 29
    elif tag == TOK_PERCENT:
        return 29
    elif tag == TOK_STARSTAR:
        # D28 amendment R2: right-associative. Binds tighter than unary
        # prefix; `2 ** 3 ** 2` = 512.
        return 34
    return 0

int infix_right_bp(int tag):
    if tag == TOK_DOUBLEQUESTION:
        return 4
    elif tag == TOK_DOTDOT:
        return 24
    elif tag == TOK_DOTDOTEQ:
        return 24
    elif tag == TOK_EQEQ:
        return 12
    elif tag == TOK_BANGEQ:
        return 12
    elif tag == TOK_LT:
        return 14
    elif tag == TOK_GT:
        return 14
    elif tag == TOK_LTEQ:
        return 14
    elif tag == TOK_GTEQ:
        return 14
    elif tag == TOK_PIPE:
        return 18
    elif tag == TOK_CARET:
        return 20
    elif tag == TOK_AMP:
        return 22
    elif tag == TOK_LTLT:
        return 26
    elif tag == TOK_GTGT:
        return 26
    elif tag == TOK_PLUS:
        return 28
    elif tag == TOK_MINUS:
        return 28
    elif tag == TOK_STAR:
        return 30
    elif tag == TOK_SLASH:
        return 30
    elif tag == TOK_PERCENT:
        return 30
    elif tag == TOK_STARSTAR:
        # D28 R2 right-assoc: right BP < left BP (33 < 34).
        return 33
    return 0

# ── Expression helpers ───────────────────────────────────────

String expr_ident_name(Expr e):
    match e:
        case EIdentifier(id_name):
            String result = "" + id_name
            return result
        else:
            return ""

# ── Parser struct ────────────────────────────────────────────

struct Parser:
    Vector[SpannedToken] tokens
    int pos
    Vector[Diagnostic] diagnostics
    int call_arg_depth
    # Speculation depth — bumped at each speculative-call site, restored
    # before the position rollback. While > 0, parse_type's fallback
    # path suppresses the "expected type" diagnostic push. Mirrors the
    # Rust parser's Result-flowing design where speculation failure
    # propagates Err without ever pushing to the parser's error stream.
    int speculation_depth
    # Parse-time expression-nesting depth guard. Incremented on each
    # `parse_expr_bp` recursive descent (catches `(((…)))` / `-(-(-…))`
    # nesting) and tracked as a left-spine count in `parse_expr_bp_with_lhs`
    # (catches the FLAT `a+a+…+a` chain — parsed iteratively, so the parser
    # call stack stays ~2 deep while the AST tree grows one level per loop
    # turn). When either exceeds MAX_EXPR_DEPTH we emit a clean teaching error
    # instead of letting a later pass SIGSEGV on the deep tree (clang
    # `-fbracket-depth` / rustc `recursion_limit` analog). See
    # the expr-depth-limit brief (git history) §B.
    int expr_depth
    # Out-param for parse_call_args: the parallel arg-NAME vector for the
    # most-recently-parsed call. Index i holds the keyword for value i
    # ("" for a positional arg). Written by parse_call_args, READ by each
    # ECall/EMethodCall construction site immediately after. Mirrors Rust
    # gg's `CallArg.name: Option<Spanned<String>>` (src/parser/ast.rs:758) —
    # the self-host AST keeps names in a parallel `Vector[String]` (the same
    # name+value shape EStructLiteral already uses), so `cap=`/`alloc=`
    # survive to lowering instead of being discarded.
    Vector[String] last_arg_names

# MAX nesting for a single expression's AST tree (parens/unary recursion OR
# a flat operator chain's left spine). 128 ≈ 2.46× the deepest real-code
# expression and well under the ~88-frame true-8MB stack crash, so the
# compiler degrades gracefully rather than crashing.
const int MAX_EXPR_DEPTH = 128

# ── Parser methods ───────────────────────────────────────────

equip Parser:

    # ── Token management ─────────────────────────────────────

    SpannedToken peek(self):
        if self.pos >= self.tokens.len():
            return SpannedToken(TkEof(), 0, 0)
        return self.tokens.get(self.pos).unwrap()

    SpannedToken peek_at(self, int offset):
        int idx = self.pos + offset
        if idx >= self.tokens.len():
            return SpannedToken(TkEof(), 0, 0)
        return self.tokens.get(idx).unwrap()

    SpannedToken advance(&self):
        SpannedToken t = self.peek()
        self.pos = self.pos + 1
        return t

    bool at_end(self):
        return token_tag(self.peek().lex_token) == TOK_EOF

    Span current_span(self):
        SpannedToken t = self.peek()
        return Span(t.lex_start, t.lex_end)

    # Speculation entry/exit helpers. The Rust parser disambiguates
    # `name[...]` as generic-call-vs-index by speculating with a
    # Result-returning `parse_generic_type_args`; failure propagates
    # `Err` and is dropped by `try_parse(... .ok()? ...)` — diagnostics
    # are NEVER pushed on speculation failure because errors flow
    # through Result, not the parser's error stream.
    #
    # The self-host parser doesn't have Result, so diagnostics get
    # pushed to the typed `Vector[Diagnostic]` field. The equivalent
    # contract is: bump `speculation_depth` around the speculative
    # call, and inside `parse_type`'s fallback path, gate the push on
    # `speculation_depth == 0`. Mirrors `try_parse`'s atomic
    # save/restore — only failures that survive past the speculation
    # boundary surface as diagnostics.
    #
    # Without this gating, `print(v[0])` fires a spurious "expected
    # type" because `parse_type_args` calls `parse_type` on `0`, which
    # falls through to the error path and pushes a diagnostic that the
    # `self.pos = saved` restore never undoes. The speculation_depth
    # gate is a meaningful semantic distinction (speculative parse vs.
    # real parse) — a `truncate-by-pop` rollback would also work but
    # this shape is clearer.
    void enter_speculation(&self):
        self.speculation_depth = self.speculation_depth + 1

    void exit_speculation(&self):
        self.speculation_depth = self.speculation_depth - 1

    # Emit the expression-too-deep diagnostic (the depth-guard sites call this
    # the moment they cross MAX_EXPR_DEPTH, then bail to recover).
    void report_expr_too_deep(&self):
        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expression nesting too deep (max 128); split into intermediate variables"))

    int peek_tag(self):
        return token_tag(self.peek().lex_token)

    int peek_kw(self):
        return keyword_tag(self.peek().lex_token)

    String peek_ident(self):
        return token_ident(self.peek().lex_token)

    bool check_tok(self, int tag):
        return self.peek_tag() == tag

    bool check_kw(self, int kw):
        return self.peek_kw() == kw

    bool match_tok(&self, int tag):
        if self.check_tok(tag):
            self.advance()
            return true
        return false

    # ── Comma-separated-list chokepoint (Core #4 class fix) ──────────────
    # Consume a `,` if present, then check for the terminator. Returns true
    # if we should parse another item, false if the list is done (either no
    # comma, or trailing comma before terminator). See DONE.md R39.
    bool consume_comma_or_tok(&self, int terminator):
        if not self.match_tok(TOK_COMMA):
            return false
        return not self.check_tok(terminator)

    bool match_kw(&self, int kw):
        if self.check_kw(kw):
            self.advance()
            return true
        return false

    void expect_tok(&self, int tag, String msg):
        if not self.match_tok(tag):
            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), msg))

    void expect_kw(&self, int kw, String msg):
        if not self.match_kw(kw):
            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), msg))

    # Extract a name from a token that may be an identifier or a keyword used as a name
    String extract_name(self, SpannedToken tok):
        String name = token_ident(tok.lex_token)
        if name != "":
            return name
        int kt = keyword_tag(tok.lex_token)
        if kt == KW_BOX:
            return "Box"
        if kt == KW_RC:
            return "Rc"
        if kt == KW_ARC:
            return "Arc"
        if kt == KW_OPTION:
            return "Option"
        if kt == KW_WEAK:
            return "Weak"
        if kt == KW_CELL:
            return "Cell"
        if kt == KW_REFCELL:
            return "RefCell"
        if kt == KW_MUTEX:
            return "Mutex"
        if kt == KW_RWLOCK:
            return "RwLock"
        # Result/Option variant keywords used as imported names
        # (e.g. `from std.io import IoError, Error`).
        if kt == KW_ERROR:
            return "Error"
        if kt == KW_OK:
            return "Ok"
        if kt == KW_SOME:
            return "Some"
        if kt == KW_NONE:
            return "None"
        return ""

    void skip_newlines(&self):
        while self.check_tok(TOK_NEWLINE):
            self.advance()

    void skip_comments(&self):
        while self.check_tok(TOK_COMMENT) or self.check_tok(TOK_DOCCOMMENT):
            self.advance()

    void skip_trivia(&self):
        while self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_COMMENT) or self.check_tok(TOK_DOCCOMMENT):
            self.advance()

    # Skip a meta statement header up to and including the colon and newline.
    # Used for `meta for ....:` and `meta if ...:` — leaves the cursor at the
    # start of the indented body (INDENT token).
    void skip_meta_header(&self):
        while not self.at_end() and not self.check_tok(TOK_COLON):
            self.advance()
        self.expect_tok(TOK_COLON, "expected ':' in meta header")
        self.expect_tok(TOK_NEWLINE, "expected newline after meta header ':'")

    # PROTOTYPE slice #4: read one meta-for loop-var name (an identifier;
    # type-keyword spellings tolerated defensively). Mirrors the
    # typechecker copy's helper; here keyword_tag maps Keyword -> int for
    # the int-form type_keyword_name / non_type_keyword_name.
    String parse_meta_for_var_name(&self):
        SpannedToken st = self.advance()
        String n = token_ident(st.lex_token)
        if n != "":
            return n
        int kt = keyword_tag(st.lex_token)
        String tn = type_keyword_name(kt)
        if tn != "":
            return tn
        return non_type_keyword_name(kt)

    # Skip the rest of a meta item: consume tokens to end of line, then consume
    # any indented body block, plus elif/else continuations.
    void skip_meta_rest(&self):
        # First skip to end of current line
        while not self.at_end() and not self.check_tok(TOK_NEWLINE) and not self.check_tok(TOK_DEDENT):
            self.advance()
        if self.check_tok(TOK_NEWLINE):
            self.advance()
        # If an indented body follows, skip it entirely
        if self.check_tok(TOK_INDENT):
            int depth = 1
            self.advance()
            while not self.at_end() and depth > 0:
                if self.check_tok(TOK_INDENT):
                    depth = depth + 1
                elif self.check_tok(TOK_DEDENT):
                    depth = depth - 1
                self.advance()
        # Skip trailing newlines
        while self.check_tok(TOK_NEWLINE):
            self.advance()
        # Skip elif/else continuations (for meta if blocks)
        while self.check_kw(KW_ELIF) or self.check_kw(KW_ELSE):
            while not self.at_end() and not self.check_tok(TOK_NEWLINE) and not self.check_tok(TOK_DEDENT):
                self.advance()
            if self.check_tok(TOK_NEWLINE):
                self.advance()
            if self.check_tok(TOK_INDENT):
                int depth = 1
                self.advance()
                while not self.at_end() and depth > 0:
                    if self.check_tok(TOK_INDENT):
                        depth = depth + 1
                    elif self.check_tok(TOK_DEDENT):
                        depth = depth - 1
                    self.advance()
            while self.check_tok(TOK_NEWLINE):
                self.advance()

    # ── Helper: make spanned nodes ───────────────────────────

    SpannedExpr mk_expr(self, Expr !e, int start):
        SpannedToken cur = self.peek()
        return SpannedExpr(!e, Span(start, cur.lex_start))

    SpannedType mk_type(self, Type !t, int start):
        SpannedToken cur = self.peek()
        return SpannedType(!t, Span(start, cur.lex_start))

    SpannedPattern mk_pat(self, Pattern !p, int start):
        SpannedToken cur = self.peek()
        return SpannedPattern(!p, Span(start, cur.lex_start))

    # ── Type parsing ─────────────────────────────────────────

    SpannedType parse_type(&self):
        int start = self.peek().lex_start

        # Primitive type keywords
        int kw = self.peek_kw()
        if is_type_keyword(kw):
            String name = type_keyword_name(kw)
            self.advance()
            if kw == KW_SELF_UPPER:
                return self.mk_type(!TSelf(), start)
            elif kw == KW_AUTO:
                return self.mk_type(!TInferred(), start)
            # Check for function type: RetType(ParamTypes...)
            if self.check_tok(TOK_LPAREN):
                int saved = self.pos
                self.enter_speculation()
                SpannedType ret_ty = self.mk_type(!TPrimitive(name), start)
                SpannedType fn_ty = self.parse_function_type(ret_ty, start)
                # Accept if followed by a name, closing bracket, comma, newline, colon, or EOF (in type context)
                if self.check_tok(TOK_IDENT) or self.check_tok(TOK_RBRACKET) or self.check_tok(TOK_COMMA) or self.check_tok(TOK_RPAREN) or self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET) or self.check_tok(TOK_AMP) or self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_COLON) or self.at_end():
                    self.exit_speculation()
                    return fn_ty
                # Restore — wasn't a function type.
                self.exit_speculation()
                self.pos = saved
            return self.mk_type(!TPrimitive(name), start)

        # Box[T], Rc[T], Arc[T], Mutex[T], RwLock[T], Weak[T], Cell[T], RefCell[T]
        if self.check_kw(KW_BOX) or self.check_kw(KW_RC) or self.check_kw(KW_ARC) or self.check_kw(KW_WEAK) or self.check_kw(KW_CELL) or self.check_kw(KW_REFCELL) or self.check_kw(KW_MUTEX) or self.check_kw(KW_RWLOCK):
            SpannedToken kw_tok = self.advance()
            String wrapper_name = token_ident(kw_tok.lex_token)
            if wrapper_name == "":
                # It's a keyword, reconstruct the name
                int kt = keyword_tag(kw_tok.lex_token)
                if kt == KW_BOX:
                    wrapper_name = "Box"
                elif kt == KW_RC:
                    wrapper_name = "Rc"
                elif kt == KW_ARC:
                    wrapper_name = "Arc"
                elif kt == KW_WEAK:
                    wrapper_name = "Weak"
                elif kt == KW_CELL:
                    wrapper_name = "Cell"
                elif kt == KW_REFCELL:
                    wrapper_name = "RefCell"
                elif kt == KW_MUTEX:
                    wrapper_name = "Mutex"
                elif kt == KW_RWLOCK:
                    wrapper_name = "RwLock"
            if self.check_tok(TOK_LBRACKET):
                Vector[SpannedType] args = self.parse_type_args()
                return self.mk_type(!TNamed(wrapper_name, args), start)
            return self.mk_type(!TNamed(wrapper_name, Vector[SpannedType]()), start)

        # Option, Result, Vector, Dict, HashMap — named types that are keywords
        # Actually these are identifiers, not keywords. Let's handle identifier case.

        # Tuple type: (T1, T2)
        if self.check_tok(TOK_LPAREN):
            self.advance()
            Vector[SpannedType] elems = Vector[SpannedType]()
            if not self.check_tok(TOK_RPAREN):
                elems.push(self.parse_type())
                while self.consume_comma_or_tok(TOK_RPAREN):
                    elems.push(self.parse_type())
            self.expect_tok(TOK_RPAREN, "expected ')' in tuple type")
            return self.mk_type(!TTuple(elems), start)

        # Array/slice type: [T; N] or [T]
        if self.check_tok(TOK_LBRACKET):
            self.advance()
            SpannedType elem = self.parse_type()
            if self.match_tok(TOK_COMMA):
                # Could be [T; N] — but Gorget uses semicolons? Actually let's check...
                # Actually in Gorget, arrays are Type[N] or [T] for slices. Let me handle [T]
                pass
            self.expect_tok(TOK_RBRACKET, "expected ']' in array/slice type")
            return self.mk_type(!TSlice(Box(elem)), start)

        # Named type (identifier possibly with generic args)
        if self.check_tok(TOK_IDENT):
            SpannedToken name_tok = self.advance()
            String name = token_ident(name_tok.lex_token)
            if self.check_tok(TOK_LBRACKET):
                Vector[SpannedType] args = self.parse_type_args()
                SpannedType named_ty = self.mk_type(!TNamed(name, args), start)
                # Check for function type: NamedType[T](params)
                if self.check_tok(TOK_LPAREN):
                    int saved = self.pos
                    self.enter_speculation()
                    SpannedType fn_ty = self.parse_function_type(named_ty, start)
                    # Only accept if followed by closing bracket/paren/comma/newline/colon (inside type context)
                    if self.check_tok(TOK_RBRACKET) or self.check_tok(TOK_COMMA) or self.check_tok(TOK_RPAREN) or self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_COLON) or self.at_end():
                        self.exit_speculation()
                        return fn_ty
                    # Restore — wasn't a function type.
                    self.exit_speculation()
                    self.pos = saved
                return named_ty
            # Check for function type: Name(params) — only in contexts where followed by ) ] , or name
            if self.check_tok(TOK_LPAREN):
                int saved = self.pos
                self.enter_speculation()
                SpannedType named_ty = self.mk_type(!TNamed(name, Vector[SpannedType]()), start)
                SpannedType fn_ty = self.parse_function_type(named_ty, start)
                # Accept if followed by name (var/param name) or closing context
                if self.check_tok(TOK_IDENT) or self.check_tok(TOK_RBRACKET) or self.check_tok(TOK_COMMA) or self.check_tok(TOK_RPAREN) or self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET) or self.check_tok(TOK_AMP) or self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_COLON) or self.at_end():
                    self.exit_speculation()
                    return fn_ty
                # Restore — wasn't a function type.
                self.exit_speculation()
                self.pos = saved
            return self.mk_type(!TNamed(name, Vector[SpannedType]()), start)

        # Fallback: error. Gate the diagnostic push on
        # `speculation_depth == 0` so speculative callers (postfix
        # `expr[...]` generic-call-vs-index disambiguation, method-level
        # turbofish, `Option[int](...)` generic constructor, function-
        # type vs primitive disambiguation) don't pollute the typed
        # diagnostic stream when their speculation fails. See
        # `enter_speculation` doc-comment.
        if self.speculation_depth == 0:
            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected type"))
        self.advance()
        return self.mk_type(!TPrimitive("void"), start)

    SpannedType parse_function_type(&self, SpannedType ret_ty, int start):
        # Function type: RetType(Param1, Param2, ...)
        # D35 (docs/define-gorget/decisions.md, ratified 2026-07-26): an
        # unnamed parameter's sigil is spelled AFTER the type — `Type &`,
        # `Type !` — uniform with the named form (`Message &msg`). The pre-D35
        # spelling with the sigil BEFORE the type is REJECTED with a
        # diagnostic naming the replacement.
        self.expect_tok(TOK_LPAREN, "expected '(' for function type")
        Vector[SpannedType] param_types = Vector[SpannedType]()
        Vector[int] ownerships = Vector[int]()
        if not self.check_tok(TOK_RPAREN):
            # Advisory A2 (2026-07-28): after pushing the D35 diagnostic,
            # ADVANCE past the sigil so `parse_type()` sees the underlying
            # type — otherwise it hits `&`/`!` again and cascades a
            # second, unrelated "expected type" error. Rust gg's site
            # returns Err instead (see src/parser/types.rs); the SH
            # equivalent is push+advance, so the recovery path pins the
            # sigil to a single diagnostic.
            if self.check_tok(TOK_AMP) or self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
                self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), self.d35_sigil_before_type_msg()))
                self.advance()
            param_types.push(self.parse_type())
            ownerships.push(self.parse_fn_type_param_ownership())
            while self.consume_comma_or_tok(TOK_RPAREN):
                if self.check_tok(TOK_AMP) or self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
                    self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), self.d35_sigil_before_type_msg()))
                    self.advance()
                param_types.push(self.parse_type())
                ownerships.push(self.parse_fn_type_param_ownership())
        self.expect_tok(TOK_RPAREN, "expected ')' for function type")
        return self.mk_type(!TFunction(Box(ret_ty), param_types, ownerships), start)

    # D35 diagnostic text, parameterized by the sigil ACTUALLY SEEN — a
    # `^Type` author must be told to write `Type ^`, never the retired `!`.
    # Mirrors Rust gg's `FunctionTypeParamSigilBeforeType { sigil }`
    # (src/errors.rs:248-256). ONE producer for both call sites above.
    String d35_sigil_before_type_msg(self):
        String sigil = "&"
        if self.check_tok(TOK_BANG):
            sigil = "!"
        elif self.check_tok(TOK_CARET):
            sigil = "^"
        return "D35: an unnamed parameter's sigil goes AFTER the type in a function type — write `Type " + sigil + "` instead of `" + sigil + "Type`"

    # D35: consume the trailing sigil AFTER an unnamed function-type parameter
    # (`Type &` / `Type ^`, and retired-but-accepted `Type !`) and return its
    # OWN_* code. Sibling of
    # `skip_ownership_markers` (which is retained for other positions).
    int parse_fn_type_param_ownership(&self):
        if self.check_tok(TOK_AMP):
            self.advance()
            return OWN_MUTABLE
        # D27 accept-both: `Type ^` and retired `Type !` both mean OWN_MOVE
        # at the fn-type param sigil suffix (D35 spelling).
        elif self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
            self.advance()
            return OWN_MOVE
        return OWN_BORROW

    Vector[SpannedType] parse_type_args(&self):
        Vector[SpannedType] args = Vector[SpannedType]()
        self.expect_tok(TOK_LBRACKET, "expected '[' for type args")
        if not self.check_tok(TOK_RBRACKET):
            args.push(self.parse_type())
            # Skip optional ownership sigil after a type arg (`!` move,
            # `&` borrow). The Rust formatter preserves these but the
            # self-host AST drops them; consuming here keeps the parser
            # from tripping on the `]` mismatch.
            self.skip_ownership_markers()
            while self.consume_comma_or_tok(TOK_RBRACKET):
                args.push(self.parse_type())
                self.skip_ownership_markers()
        self.expect_tok(TOK_RBRACKET, "expected ']' after type args")
        return args

    Vector[String] parse_type_params(&self):
        Vector[String] params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            self.advance()
            # Loop while we have a type-like token: ident, value-namespace
            # keyword usable as trait name (Error/Ok/Some/None), or const.
            while self.check_tok(TOK_IDENT) or self.check_kw(KW_CONST) or self.check_kw(KW_ERROR) or self.check_kw(KW_OK) or self.check_kw(KW_SOME) or self.check_kw(KW_NONE):
                if self.check_kw(KW_CONST):
                    self.advance()
                    # Skip the type, read the name
                    self.skip_type_lookahead()
                    SpannedToken name_tok = self.advance()
                    params.push(token_ident(name_tok.lex_token))
                else:
                    # Tentatively skip a type-like prefix (the trait bound)
                    # plus any `& AdditionalTrait` chains. If a name-IDENT
                    # follows, the prefix was the bound(s); else the prefix
                    # WAS the name. Handles [Error E], [A & B & C T],
                    # plain [T], etc.
                    int saved = self.pos
                    self.skip_type_lookahead()
                    while self.check_tok(TOK_AMP):
                        self.advance()
                        self.skip_type_lookahead()
                    if self.check_tok(TOK_IDENT):
                        SpannedToken name_tok = self.advance()
                        params.push(token_ident(name_tok.lex_token))
                    else:
                        # Wasn't a bound — restore and read just the name.
                        self.pos = saved
                        SpannedToken t = self.advance()
                        params.push(token_ident(t.lex_token))
                if not self.match_tok(TOK_COMMA):
                    break
            self.expect_tok(TOK_RBRACKET, "expected ']' after type params")
        return params

    # ── Pattern parsing ──────────────────────────────────────

    SpannedPattern parse_pattern(&self):
        int start = self.peek().lex_start
        return self.parse_pattern_or(start)

    SpannedPattern parse_pattern_or(&self, int start):
        SpannedPattern first = self.parse_pattern_atom()
        if not self.check_tok(TOK_PIPE):
            return first
        Vector[SpannedPattern] alts = Vector[SpannedPattern]()
        alts.push(first)
        while self.match_tok(TOK_PIPE):
            alts.push(self.parse_pattern_atom())
        return self.mk_pat(!POr(alts), start)

    SpannedPattern parse_pattern_atom(&self):
        int start = self.peek().lex_start

        # Wildcard: _
        if self.check_tok(TOK_UNDERSCORE):
            self.advance()
            return self.mk_pat(!PWildcard(), start)

        # Rest: ..
        if self.check_tok(TOK_DOTDOT):
            self.advance()
            return self.mk_pat(!PRest(), start)

        # Literals: int, float, string, bool, None
        if self.check_tok(TOK_INT):
            SpannedToken t = self.advance()
            int val = token_int_val(t.lex_token)
            SpannedExpr lit = SpannedExpr(EIntLiteral(val), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        if self.check_tok(TOK_FLOAT):
            SpannedToken t = self.advance()
            float val = token_float_val(t.lex_token)
            SpannedExpr lit = SpannedExpr(EFloatLiteral(val), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        if self.check_tok(TOK_STRING):
            SpannedToken t = self.advance()
            String val = token_string_val(t.lex_token)
            SpannedExpr lit = SpannedExpr(EStringLiteral(val, token_has_interpolation(t.lex_token)), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        if self.check_kw(KW_TRUE):
            SpannedToken t = self.advance()
            SpannedExpr lit = SpannedExpr(EBoolLiteral(true), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        if self.check_kw(KW_FALSE):
            SpannedToken t = self.advance()
            SpannedExpr lit = SpannedExpr(EBoolLiteral(false), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        if self.check_kw(KW_NONE):
            SpannedToken t = self.advance()
            # `None()` and `None` are both valid; consume optional parens
            # so the trailing `()` doesn't leak into the body parser.
            if self.check_tok(TOK_LPAREN):
                self.advance()
                self.expect_tok(TOK_RPAREN, "expected ')' after None()")
            SpannedExpr lit = SpannedExpr(ENoneLiteral(), Span(t.lex_start, t.lex_end))
            return self.mk_pat(!PLiteral(lit), start)

        # Negative int literal: -42
        if self.check_tok(TOK_MINUS):
            SpannedToken m = self.advance()
            if self.check_tok(TOK_INT):
                SpannedToken t = self.advance()
                int val = 0 - token_int_val(t.lex_token)
                SpannedExpr lit = SpannedExpr(EIntLiteral(val), Span(m.lex_start, t.lex_end))
                return self.mk_pat(!PLiteral(lit), start)

        # Tuple pattern: (p1, p2, ...)
        if self.check_tok(TOK_LPAREN):
            self.advance()
            Vector[SpannedPattern] elems = Vector[SpannedPattern]()
            if not self.check_tok(TOK_RPAREN):
                elems.push(self.parse_pattern())
                while self.consume_comma_or_tok(TOK_RPAREN):
                    elems.push(self.parse_pattern())
            self.expect_tok(TOK_RPAREN, "expected ')' in tuple pattern")
            return self.mk_pat(!PTuple(elems), start)

        # Dot-shorthand pattern: .Variant() or .Variant(args) or .Variant
        if self.check_tok(TOK_DOT):
            self.advance()
            SpannedToken vname_tok = self.advance()
            String vname = token_ident(vname_tok.lex_token)
            if self.check_tok(TOK_LPAREN):
                self.advance()
                Vector[SpannedPattern] args = Vector[SpannedPattern]()
                if not self.check_tok(TOK_RPAREN):
                    args.push(self.parse_pattern())
                    while self.consume_comma_or_tok(TOK_RPAREN):
                        args.push(self.parse_pattern())
                self.expect_tok(TOK_RPAREN, "expected ')' in dot-shorthand pattern")
                return self.mk_pat(!PDotShorthand(vname, args), start)
            return self.mk_pat(!PDotShorthand(vname, Vector[SpannedPattern]()), start)

        # Constructor or binding: Name(p1, p2) or name
        # Constructors start with uppercase; bindings are lowercase identifiers
        # But we can also have Some(x), None, Ok(x), Error(x), etc.
        if self.check_tok(TOK_IDENT):
            SpannedToken name_tok = self.advance()
            String name = token_ident(name_tok.lex_token)
            # Qualified name: Name.Variant(args)
            if self.check_tok(TOK_DOT):
                self.advance()
                SpannedToken qual_tok = self.advance()
                String qual_name = name + "." + token_ident(qual_tok.lex_token)
                if self.check_tok(TOK_LPAREN):
                    self.advance()
                    Vector[SpannedPattern] args = Vector[SpannedPattern]()
                    if not self.check_tok(TOK_RPAREN):
                        args.push(self.parse_pattern())
                        while self.consume_comma_or_tok(TOK_RPAREN):
                            args.push(self.parse_pattern())
                    self.expect_tok(TOK_RPAREN, "expected ')' in qualified constructor pattern")
                    return self.mk_pat(!PConstructor(qual_name, args), start)
                return self.mk_pat(!PConstructor(qual_name, Vector[SpannedPattern]()), start)
            if self.check_tok(TOK_LPAREN):
                self.advance()
                Vector[SpannedPattern] args = Vector[SpannedPattern]()
                if not self.check_tok(TOK_RPAREN):
                    args.push(self.parse_pattern())
                    while self.consume_comma_or_tok(TOK_RPAREN):
                        args.push(self.parse_pattern())
                self.expect_tok(TOK_RPAREN, "expected ')' in constructor pattern")
                return self.mk_pat(!PConstructor(name, args), start)
            return self.mk_pat(!PBinding(name), start)

        # Keywords that can be constructors: Some, Ok, Error, None
        if self.check_kw(KW_SOME) or self.check_kw(KW_OK) or self.check_kw(KW_ERROR) or self.check_kw(KW_NONE):
            SpannedToken kw_tok = self.advance()
            String name = ""
            int kt = keyword_tag(kw_tok.lex_token)
            if kt == KW_SOME:
                name = "Some"
            elif kt == KW_OK:
                name = "Ok"
            elif kt == KW_ERROR:
                name = "Error"
            elif kt == KW_NONE:
                name = "None"
            if self.check_tok(TOK_LPAREN):
                self.advance()
                Vector[SpannedPattern] args = Vector[SpannedPattern]()
                if not self.check_tok(TOK_RPAREN):
                    args.push(self.parse_pattern())
                    while self.consume_comma_or_tok(TOK_RPAREN):
                        args.push(self.parse_pattern())
                self.expect_tok(TOK_RPAREN, "expected ')' in constructor pattern")
                return self.mk_pat(!PConstructor(name, args), start)
            # Bare keyword without parens: treated as binding (matches Rust parser)
            return self.mk_pat(!PBinding(name), start)

        # Type-keyword tokens (`int`, `byte`, `float`, …) and other
        # keywords with source spellings (`for`, `match`, `as`, …) are
        # accepted as binding names in pattern position — Rust gg's
        # parser accepts them, and the lexer's keyword promotion
        # (`byte` → KwUint8) is context-free, so otherwise users
        # couldn't write `case Foo(x, byte, z):` with `byte` as a
        # middle binding. Surfaced 2026-05-10 by Phase A.4's lift port.
        match self.peek().lex_token:
            case TkKeyword(_):
                int kw = self.peek_kw()
                String tk_name = type_keyword_name(kw)
                if tk_name != "":
                    self.advance()
                    return self.mk_pat(!PBinding(tk_name), start)
                String ntk_name = non_type_keyword_name(kw)
                if ntk_name != "":
                    self.advance()
                    return self.mk_pat(!PBinding(ntk_name), start)
            else:
                pass

        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected pattern"))
        self.advance()
        return self.mk_pat(!PWildcard(), start)

    # ── Expression parsing (Pratt) ───────────────────────────

    SpannedExpr parse_expr(&self):
        return self.parse_expr_bp(0)

    SpannedExpr parse_expr_with_lhs(&self, SpannedExpr !lhs):
        return self.parse_expr_bp_with_lhs(0, !lhs)

    SpannedExpr parse_expr_bp(&self, int min_bp):
        # Recursion-depth guard: every nested level (`(((…)))`, `-(-(-…))`)
        # passes through exactly one parse_expr_bp → parse_prefix, so this is
        # the single chokepoint that bounds AST-tree depth from parens/unary.
        # The FLAT chain is bounded separately by the spine count in
        # parse_expr_bp_with_lhs.
        self.expr_depth = self.expr_depth + 1
        if self.expr_depth > MAX_EXPR_DEPTH:
            self.expr_depth = self.expr_depth - 1
            self.report_expr_too_deep()
            # Recover: consume one token to make progress and return a leaf,
            # unwinding the deep recursion without building further.
            SpannedToken dtok = self.advance()
            return SpannedExpr(EIntLiteral(0), Span(dtok.lex_start, dtok.lex_end))
        SpannedExpr lhs = self.parse_prefix()
        SpannedExpr bp_result = self.parse_expr_bp_with_lhs(min_bp, !lhs)
        self.expr_depth = self.expr_depth - 1
        return bp_result

    SpannedExpr parse_expr_bp_with_lhs(&self, int min_bp, SpannedExpr !lhs):

        # Left-spine count for the FLAT-chain depth guard. Each loop turn wraps
        # `lhs` one level deeper (EBinaryOp / ECall / EIndex / …) without
        # growing the parser call stack, so the AST tree can balloon while
        # recursion stays shallow — the parse_expr_bp recursion guard never
        # sees it. Bound it here.
        int spine_depth = 0
        while not self.at_end():
            spine_depth = spine_depth + 1
            if spine_depth > MAX_EXPR_DEPTH:
                self.report_expr_too_deep()
                break
            # Postfix: field access, method call, index, function call, ?, as
            int ptag = self.peek_tag()

            # Dot: field access or method call
            if ptag == TOK_DOT:
                lhs = self.parse_dot_expr(!lhs)
                continue

            # Index or generic constructor: expr[...]
            if ptag == TOK_LBRACKET:
                int bp_start = lhs.span.start
                # If lhs is an identifier, try to parse as generic type args + call
                String ident_name = expr_ident_name(lhs.expr)
                if ident_name != "":
                    int saved = self.pos
                    self.enter_speculation()
                    Vector[SpannedType] targs = self.parse_type_args()
                    if self.check_tok(TOK_LPAREN):
                        # Generic constructor: Name[T](args)
                        Vector[SpannedExpr] call_args = self.parse_call_args()
                        Vector[String] call_names = self.last_arg_names
                        self.exit_speculation()

                        lhs = SpannedExpr(ECall(Box(lhs), call_args, call_names, targs), Span(bp_start, self.peek().lex_start))
                        continue
                    # Not a generic constructor — restore and parse as index.
                    # Failed speculation is silent — mirrors Rust's
                    # `try_parse(... .ok()?)`.
                    self.exit_speculation()
                    self.pos = saved
                self.advance()
                # D22 (ratified 2026-07-06): colon-slice `v[a:b]` is
                # canonical. Four accept-forms + two parse rejects for the
                # deferred negative-literal and step syntaxes. Desugars to
                # `EIndex(v, ERange(start, end, false))` so it composes with
                # the existing range-lower path used by `v[a..b]`. The
                # colon-vs-dotdot distinction is formatter-only, and the
                # self-host has no formatter, so ERange is produced verbatim.
                int slice_start = self.peek().lex_start
                # Colon-first slice: `[:...]`
                if self.check_tok(TOK_COLON):
                    self.advance()
                    # Reject step at second colon: `[::stride]`
                    if self.check_tok(TOK_COLON):
                        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_SliceStepDeferred: step in `v[a:b:c]` is deferred (D22); use `v.reversed()` for reverse iteration"))
                    Option[Box[SpannedExpr]] end_opt = None
                    if not self.check_tok(TOK_RBRACKET):
                        # Reject negative-literal end: `[:-1]`
                        if self.check_tok(TOK_MINUS) and token_tag(self.peek_at(1).lex_token) == TOK_INT:
                            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_NegativeSliceIndex: negative-literal indices in `v[a:b]` slice syntax are deferred (D22); use `v.len() - N`"))
                        SpannedExpr end_expr = self.parse_expr()
                        # Reject step after end: `[:b:c]`
                        if self.check_tok(TOK_COLON):
                            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_SliceStepDeferred: step in `v[a:b:c]` is deferred (D22); use `v.reversed()`"))
                        end_opt = Some(Box(end_expr))
                    self.expect_tok(TOK_RBRACKET, "expected ']' after slice")
                    SpannedExpr rng = SpannedExpr(ERange(None, end_opt, false), Span(slice_start, self.peek().lex_start))
                    lhs = SpannedExpr(EIndex(Box(lhs), Box(rng)), Span(bp_start, self.peek().lex_start))
                    continue

                # Detect a negative-literal start: `[-a...]` — needed for the
                # reject path when a colon follows.
                bool start_is_neg_lit = self.check_tok(TOK_MINUS) and token_tag(self.peek_at(1).lex_token) == TOK_INT
                int start_neg_span_start = self.peek().lex_start
                int start_neg_span_end = self.peek().lex_end
                SpannedExpr idx = self.parse_expr()
                # Colon-slice with explicit start: `[a:...]`, `[a:]`
                if self.check_tok(TOK_COLON):
                    if start_is_neg_lit:
                        self.diagnostics.push(Diagnostic.error(Span(start_neg_span_start, start_neg_span_end), DkParseError(), "E_NegativeSliceIndex: negative-literal indices in `v[a:b]` slice syntax are deferred (D22); use `v.len() - N`"))
                    self.advance()
                    # Reject step at second colon: `[a::c]`
                    if self.check_tok(TOK_COLON):
                        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_SliceStepDeferred: step in `v[a:b:c]` is deferred (D22); use `v.reversed()`"))
                    Option[Box[SpannedExpr]] end_opt2 = None
                    if not self.check_tok(TOK_RBRACKET):
                        if self.check_tok(TOK_MINUS) and token_tag(self.peek_at(1).lex_token) == TOK_INT:
                            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_NegativeSliceIndex: negative-literal indices in `v[a:b]` slice syntax are deferred (D22); use `v.len() - N`"))
                        SpannedExpr end_expr2 = self.parse_expr()
                        if self.check_tok(TOK_COLON):
                            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "E_SliceStepDeferred: step in `v[a:b:c]` is deferred (D22); use `v.reversed()`"))
                        end_opt2 = Some(Box(end_expr2))
                    self.expect_tok(TOK_RBRACKET, "expected ']' after slice")
                    SpannedExpr rng2 = SpannedExpr(ERange(Some(Box(idx)), end_opt2, false), Span(slice_start, self.peek().lex_start))
                    lhs = SpannedExpr(EIndex(Box(lhs), Box(rng2)), Span(bp_start, self.peek().lex_start))
                    continue
                self.expect_tok(TOK_RBRACKET, "expected ']' after index")
                lhs = SpannedExpr(EIndex(Box(lhs), Box(idx)), Span(bp_start, self.peek().lex_start))
                continue

            # Function call: expr(args)
            if ptag == TOK_LPAREN:
                int bp_start = lhs.span.start
                Vector[SpannedExpr] call_args = self.parse_call_args()
                Vector[String] call_names = self.last_arg_names
                lhs = SpannedExpr(ECall(Box(lhs), call_args, call_names, Vector[SpannedType]()), Span(bp_start, self.peek().lex_start))
                continue

            # Try: expr?
            if ptag == TOK_QUESTION:
                int bp_start = lhs.span.start
                self.advance()
                lhs = SpannedExpr(ETry(Box(lhs)), Span(bp_start, self.peek().lex_start))
                continue

            # D29: postfix error-propagation `expr!` (TkBangEq never splits, so
            # TOK_BANG here is always the postfix mark).
            if ptag == TOK_BANG:
                int bp_start = lhs.span.start
                self.advance()
                lhs = SpannedExpr(EPropagate(Box(lhs)), Span(bp_start, self.peek().lex_start))
                continue

            # As cast: expr as Type
            if self.check_kw(KW_AS):
                int bp_start = lhs.span.start
                self.advance()
                SpannedType cast_ty = self.parse_type()
                lhs = SpannedExpr(EAs(Box(lhs), Box(cast_ty)), Span(bp_start, self.peek().lex_start))
                continue

            # Is / Is not: pattern matching expressions
            if self.check_kw(KW_IS):
                int bp_start = lhs.span.start
                self.advance()
                bool negated = false
                if self.check_kw(KW_NOT):
                    negated = true
                    self.advance()
                SpannedPattern pat = self.parse_pattern()
                lhs = SpannedExpr(EIs(Box(lhs), negated, Box(pat)), Span(bp_start, self.peek().lex_start))
                continue

            # and / or: keyword-based infix operators
            if self.check_kw(KW_AND):
                int l_bp = 7
                if l_bp < min_bp:
                    break
                self.advance()
                SpannedExpr rhs = self.parse_expr_bp(8)
                lhs = SpannedExpr(EBinaryOp(Box(lhs), "and", Box(rhs)), Span(lhs.span.start, rhs.span.end))
                continue

            if self.check_kw(KW_OR):
                int l_bp = 5
                if l_bp < min_bp:
                    break
                self.advance()
                SpannedExpr rhs = self.parse_expr_bp(6)
                lhs = SpannedExpr(EBinaryOp(Box(lhs), "or", Box(rhs)), Span(lhs.span.start, rhs.span.end))
                continue

            if self.check_kw(KW_IN):
                int l_bp = 15
                if l_bp < min_bp:
                    break
                self.advance()
                SpannedExpr rhs = self.parse_expr_bp(16)
                lhs = SpannedExpr(EBinaryOp(Box(lhs), "in", Box(rhs)), Span(lhs.span.start, rhs.span.end))
                continue

            if self.check_kw(KW_NOT):
                # Check for 'not in' operator
                if self.pos + 1 < self.tokens.len():
                    SpannedToken next_ni = self.tokens.get(self.pos + 1).unwrap()
                    if keyword_tag(next_ni.lex_token) == KW_IN:
                        int l_bp = 15
                        if l_bp < min_bp:
                            break
                        self.advance()
                        self.advance()
                        SpannedExpr rhs = self.parse_expr_bp(16)
                        lhs = SpannedExpr(EBinaryOp(Box(lhs), "not in", Box(rhs)), Span(lhs.span.start, rhs.span.end))
                        continue

            # rethrow: expr rethrow [( Type name ):] transform
            if self.check_kw(KW_RETHROW):
                if 1 < min_bp:
                    break
                self.advance()
                Option[String] err_name = None[String]()
                Option[Box[SpannedType]] err_type = None[Box[SpannedType]]()
                if self.check_tok(TOK_LPAREN):
                    self.advance()
                    SpannedType rt = self.parse_type()
                    err_type = Some(Box[SpannedType](rt))
                    SpannedToken en_tok = self.advance()
                    err_name = Some(token_ident(en_tok.lex_token))
                    self.expect_tok(TOK_RPAREN, "expected ')' in rethrow binding")
                    self.expect_tok(TOK_COLON, "expected ':' after rethrow binding")
                SpannedExpr rt_val = self.parse_expr_bp(2)
                lhs = SpannedExpr(ERethrow(Box(lhs), err_name, err_type, Box(rt_val)), Span(lhs.span.start, rt_val.span.end))
                continue

            # catch: only the Result contract-catch `catch (name):` remains.
            # D25 removed the fault-`catch` recovery form entirely; faults
            # trap uncatchably.
            if self.check_kw(KW_CATCH):
                if 1 < min_bp:
                    break
                self.advance()
                if self.check_tok(TOK_LPAREN):
                    # ── Result contract-catch (unchanged) ──
                    self.expect_tok(TOK_LPAREN, "expected '(' after catch")
                    SpannedToken cn_tok = self.advance()
                    String catch_name = token_ident(cn_tok.lex_token)
                    self.expect_tok(TOK_RPAREN, "expected ')' in catch")
                    self.expect_tok(TOK_COLON, "expected ':' after catch binding")
                    SpannedExpr catch_val = SpannedExpr(EIntLiteral(0), Span(0, 0))
                    if self.check_tok(TOK_NEWLINE):
                        Vector[Stmt] body = self.parse_block()
                        catch_val = SpannedExpr(EDo(body), Span(lhs.span.start, self.peek().lex_start))
                    else:
                        catch_val = self.parse_expr_bp(2)
                    lhs = SpannedExpr(ECatch(Box(lhs), catch_name, Box(catch_val)), Span(lhs.span.start, catch_val.span.end))
                    continue
                # ── D25: fault-catch removed — reject at parse ──
                panic("E_FaultCatchRemoved: the `catch Fault.X:` recovery form was removed (D25). Faults now panic uncatchably; use the fallible arithmetic operators (`+!`/`-!`/`*!`/`/!`/`%!`/`<<!`/`>>!`) to capture faults as `Result[T, ArithError]` instead")

            # mod: keyword-based binary operator (same precedence as %)
            if self.check_kw(KW_MOD):
                int l_bp = 29
                if l_bp < min_bp:
                    break
                self.advance()
                SpannedExpr rhs = self.parse_expr_bp(30)
                lhs = SpannedExpr(EBinaryOp(Box(lhs), "mod", Box(rhs)), Span(lhs.span.start, rhs.span.end))
                continue

            # Wrapping operators: +%, -%, *%
            if ptag == TOK_PLUSPERCENT or ptag == TOK_MINUSPERCENT or ptag == TOK_STARPERCENT:
                int w_bp = 27
                if ptag == TOK_STARPERCENT:
                    w_bp = 29
                if w_bp < min_bp:
                    break
                String wop = "+%"
                if ptag == TOK_MINUSPERCENT:
                    wop = "-%"
                elif ptag == TOK_STARPERCENT:
                    wop = "*%"
                self.advance()
                int w_rbp = w_bp + 1
                SpannedExpr rhs = self.parse_expr_bp(w_rbp)
                lhs = SpannedExpr(EBinaryOp(Box(lhs), wop, Box(rhs)), Span(lhs.span.start, rhs.span.end))
                continue

            # Infix operators
            int l_bp = infix_left_bp(ptag)
            if l_bp == 0:
                break
            if l_bp < min_bp:
                break
            int r_bp = infix_right_bp(ptag)
            String op = op_str(ptag)
            self.advance()
            SpannedExpr rhs = self.parse_expr_bp(r_bp)
            if ptag == TOK_DOTDOT:
                lhs = SpannedExpr(ERange(Some(Box(lhs)), Some(Box(rhs)), false), Span(lhs.span.start, rhs.span.end))
            elif ptag == TOK_DOTDOTEQ:
                lhs = SpannedExpr(ERange(Some(Box(lhs)), Some(Box(rhs)), true), Span(lhs.span.start, rhs.span.end))
            else:
                lhs = SpannedExpr(EBinaryOp(Box(lhs), op, Box(rhs)), Span(lhs.span.start, rhs.span.end))

        return lhs

    SpannedExpr parse_dot_expr(&self, SpannedExpr !lhs):
        int start = lhs.span.start
        self.advance()
        # Handle identifier or keyword-as-method-name (e.g. .String(), .or(), .len())
        if self.check_tok(TOK_IDENT) or self.peek_kw() > 0:
            SpannedToken name_tok = self.advance()
            String name = token_ident(name_tok.lex_token)
            if name == "":
                # Keyword token — extract name from keyword tag
                int kw = keyword_tag(name_tok.lex_token)
                name = type_keyword_name(kw)
                if name == "":
                    name = non_type_keyword_name(kw)
            if name == "await" and self.check_tok(TOK_LPAREN):
                self.advance()  # (
                self.expect_tok(TOK_RPAREN, "expected ')' after .await(")
                return SpannedExpr(EAwait(Box(lhs)), Span(start, self.peek().lex_start))
            # Method-level turbofish: `.method[T1, T2, ...](args)`. Without
            # parsing the [args] eagerly, `v.hash[FxHasher](&h)` parses as
            # `(v.hash)[FxHasher]` then `(&h)` — the EMethodCall arm never
            # fires and the type-args vanish from the format output.
            if self.check_tok(TOK_LBRACKET):
                int saved = self.pos
                self.enter_speculation()
                Vector[SpannedType] mtargs = self.parse_type_args()
                if self.check_tok(TOK_LPAREN):
                    Vector[SpannedExpr] call_args = self.parse_call_args()
                    Vector[String] call_names = self.last_arg_names
                    self.exit_speculation()
                    return SpannedExpr(EMethodCall(Box(lhs), name, call_args, call_names, mtargs), Span(start, self.peek().lex_start))
                # Restore — wasn't a method-level turbofish.
                self.exit_speculation()
                self.pos = saved
            if self.check_tok(TOK_LPAREN):
                Vector[SpannedExpr] call_args = self.parse_call_args()
                Vector[String] call_names = self.last_arg_names
                return SpannedExpr(EMethodCall(Box(lhs), name, call_args, call_names, Vector[SpannedType]()), Span(start, self.peek().lex_start))
            return SpannedExpr(EFieldAccess(Box(lhs), name), Span(start, self.peek().lex_start))
        # Numeric field access for tuples: t.0, t.1
        if self.check_tok(TOK_INT):
            SpannedToken num_tok = self.advance()
            String field_name = "_"
            int val = token_int_val(num_tok.lex_token)
            if val == 0:
                field_name = "0"
            elif val == 1:
                field_name = "1"
            elif val == 2:
                field_name = "2"
            elif val == 3:
                field_name = "3"
            return SpannedExpr(EFieldAccess(Box(lhs), field_name), Span(start, self.peek().lex_start))
        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected field name after '.'"))
        return lhs

    Vector[SpannedExpr] parse_call_args(&self):
        Vector[SpannedExpr] args = Vector[SpannedExpr]()
        # Parallel arg-NAME vector (written to self.last_arg_names): index i
        # holds the keyword for value i ("" for a positional arg). The name is
        # detected HERE (peek `IDENT =`) so the value parse in parse_call_arg
        # stays unchanged; the caller reads self.last_arg_names right after.
        Vector[String] names = Vector[String]()
        self.expect_tok(TOK_LPAREN, "expected '(' for call args")
        if not self.check_tok(TOK_RPAREN):
            # Skip ownership markers before args
            self.skip_ownership_markers()
            names.push(self.peek_arg_name())
            args.push(self.parse_call_arg())
            while self.consume_comma_or_tok(TOK_RPAREN):
                self.skip_ownership_markers()
                names.push(self.peek_arg_name())
                args.push(self.parse_call_arg())
        self.expect_tok(TOK_RPAREN, "expected ')' after call args")
        self.last_arg_names = names
        return args

    # Peek for a `name =` named-arg prefix WITHOUT consuming. Returns the
    # keyword string, or "" for a positional arg. parse_call_arg consumes the
    # `name =` tokens; this only reports the name so the parallel vector lines
    # up. Mirrors Rust gg recording `CallArg.name` (src/parser/ast.rs:758).
    String peek_arg_name(self):
        if self.check_tok(TOK_IDENT) and self.pos + 1 < self.tokens.len():
            SpannedToken next_arg = self.tokens.get(self.pos + 1).unwrap()
            if token_tag(next_arg.lex_token) == TOK_EQ:
                return token_ident(self.peek().lex_token)
        return ""

    void skip_ownership_markers(&self):
        # Skip &, !, ^, move before args (D27 accept-both `!`/`^`)
        if self.check_tok(TOK_AMP) or self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
            self.advance()
        elif self.check_kw(KW_MOVE):
            self.advance()

    SpannedExpr parse_call_arg(&self):
        # Handle named args: name = value — just parse the value, discard the name
        if self.check_tok(TOK_IDENT) and self.pos + 1 < self.tokens.len():
            SpannedToken next_arg = self.tokens.get(self.pos + 1).unwrap()
            if token_tag(next_arg.lex_token) == TOK_EQ:
                self.advance()
                self.advance()
                self.call_arg_depth = self.call_arg_depth + 1
                SpannedExpr val = self.parse_expr()
                self.call_arg_depth = self.call_arg_depth - 1
                if self.call_arg_depth == 0 and expr_contains_it(val.expr):
                    return SpannedExpr(EImplicitClosure(Box[SpannedExpr](val)), val.span)
                return val
        self.call_arg_depth = self.call_arg_depth + 1
        SpannedExpr val = self.parse_expr()
        self.call_arg_depth = self.call_arg_depth - 1
        if self.call_arg_depth == 0 and expr_contains_it(val.expr):
            return SpannedExpr(EImplicitClosure(Box[SpannedExpr](val)), val.span)
        return val

    # ── Prefix expressions ───────────────────────────────────

    # Try to detect if current position starts a closure: (params): body
    # Returns true if it looks like a closure, false otherwise.
    # Does NOT consume tokens (caller must save/restore pos).
    bool try_detect_closure(&self):
        if not self.check_tok(TOK_LPAREN):
            return false
        self.advance()
        # Empty parens followed by colon = no-arg closure
        if self.check_tok(TOK_RPAREN):
            self.advance()
            return self.check_tok(TOK_COLON)
        # Check if first thing inside parens is a type keyword or 'auto' followed by an identifier
        # Pattern: (Type name, Type name, ...):
        # We need to check if the first parameter looks like Type Ident
        int kw = self.peek_kw()
        bool first_is_type = is_type_keyword(kw)
        if not first_is_type:
            # Could also be a named type (identifier) followed by another identifier
            if self.check_tok(TOK_IDENT):
                # Save pos, try: skip identifier, check if next is also an identifier
                int saved2 = self.pos
                self.advance()
                if self.check_tok(TOK_IDENT):
                    first_is_type = true
                elif self.check_tok(TOK_LBRACKET):
                    # Could be Vector[int] name — skip type args
                    first_is_type = true
                self.pos = saved2
        if not first_is_type:
            # Could be an untyped closure: (a, b): body
            # Check if contents are just identifiers separated by commas, followed by ):
            bool all_idents = true
            if not self.check_tok(TOK_IDENT):
                all_idents = false
            if all_idents:
                # Scan: ident (comma ident)* rparen colon.  Non-migrating
                # LOOKAHEAD: this is a pure peek that restores `pos` either
                # way, not a parse-items loop, so it doesn't participate in
                # the trailing-comma-cascade class.  Rewritten to a
                # `check_tok/advance` shape so the lint's raw-loop grep
                # doesn't count it — the shape is still trivially correct
                # (loop advances one comma per iteration, breaks on the
                # first non-ident, restores pos on any failure).
                int saved3 = self.pos
                self.advance()
                while self.check_tok(TOK_COMMA):
                    self.advance()
                    if not self.check_tok(TOK_IDENT):
                        all_idents = false
                        break
                    self.advance()
                if all_idents and self.check_tok(TOK_RPAREN):
                    self.advance()
                    if self.check_tok(TOK_COLON):
                        self.pos = saved3
                        return true
                self.pos = saved3
            return false
        # Skip through params to find matching ) then :
        int depth = 1
        while depth > 0 and not self.at_end():
            if self.check_tok(TOK_LPAREN):
                depth = depth + 1
            elif self.check_tok(TOK_RPAREN):
                depth = depth - 1
                if depth == 0:
                    self.advance()
                    return self.check_tok(TOK_COLON)
            elif self.tok_cannot_be_in_closure_params():
                return false
            self.advance()
        return false

    # Tokens that can never appear in a closure parameter list — if any is
    # seen inside the parens, this is a parenthesized expression, not a
    # closure. Mirrors Rust's looks_like_closure bail-set (src/parser/expr.rs).
    # `-`/`*`/`&`/`!` are deliberately EXCLUDED: they double as unary/sigil
    # tokens in param-type contexts (`-1` default, `*T` ptr, `&T` borrow, `!T` move).
    bool tok_cannot_be_in_closure_params(self):
        if self.check_kw(KW_AND) or self.check_kw(KW_OR) or self.check_kw(KW_NOT):
            return true
        if self.check_kw(KW_AS) or self.check_kw(KW_IS):
            return true
        int tag = self.peek_tag()
        return tag == TOK_EQEQ or tag == TOK_BANGEQ or tag == TOK_LTEQ or tag == TOK_GTEQ or tag == TOK_LT or tag == TOK_GT or tag == TOK_PLUS or tag == TOK_SLASH or tag == TOK_PERCENT or tag == TOK_PIPE or tag == TOK_CARET or tag == TOK_LTLT or tag == TOK_GTGT or tag == TOK_DOTDOT or tag == TOK_DOTDOTEQ or tag == TOK_PLUSPERCENT or tag == TOK_MINUSPERCENT or tag == TOK_STARPERCENT or tag == TOK_QUESTION or tag == TOK_DOUBLEQUESTION or tag == TOK_QUESTIONDOT or tag == TOK_DOT

    # Parse a single closure parameter — could be typed (Type name) or untyped (name)
    Param parse_closure_param(&self):
        # Check if this is a typed param: Type ident
        # or untyped: just ident
        int saved = self.pos
        int kw = self.peek_kw()
        bool is_typed = is_type_keyword(kw)
        if not is_typed and self.check_tok(TOK_IDENT):
            # Could be: ident ident (typed) or just ident (untyped)
            self.advance()
            if self.check_tok(TOK_IDENT):
                is_typed = true
            elif self.check_tok(TOK_LBRACKET):
                is_typed = true
            self.pos = saved
        if is_typed:
            SpannedType pt = self.parse_type()
            SpannedToken pn = self.advance()
            String pname = token_ident(pn.lex_token)
            return Param(pt, pname, OWN_BORROW, None)
        # Untyped param — just an identifier, use auto as type
        SpannedToken pn = self.advance()
        String pname = token_ident(pn.lex_token)
        SpannedType auto_type = SpannedType(TInferred(), Span(pn.lex_start, pn.lex_end))
        return Param(auto_type, pname, OWN_BORROW, None)

    # Parse a closure expression: (params): body
    SpannedExpr parse_closure_expr(&self, int start):
        self.expect_tok(TOK_LPAREN, "expected '(' for closure")
        Vector[Param] params = Vector[Param]()
        if not self.check_tok(TOK_RPAREN):
            params.push(self.parse_closure_param())
            while self.consume_comma_or_tok(TOK_RPAREN):
                params.push(self.parse_closure_param())
        self.expect_tok(TOK_RPAREN, "expected ')' after closure params")
        self.expect_tok(TOK_COLON, "expected ':' after closure params")
        # Inline closure: body is a single expression or a block
        Vector[Stmt] body = Vector[Stmt]()
        if self.check_tok(TOK_NEWLINE):
            # Multi-line closure body
            body = self.parse_block()
        else:
            # Inline closure: parse single expression
            SpannedExpr expr = self.parse_expr()
            body.push(SExpr(expr))
        return SpannedExpr(EClosure(params, body), Span(start, self.peek().lex_start))

    SpannedExpr parse_prefix(&self):
        int start = self.peek().lex_start
        int ptag = self.peek_tag()

        # Integer literal
        if ptag == TOK_INT:
            SpannedToken t = self.advance()
            return SpannedExpr(EIntLiteral(token_int_val(t.lex_token)), Span(t.lex_start, t.lex_end))

        # Float literal
        if ptag == TOK_FLOAT:
            SpannedToken t = self.advance()
            return SpannedExpr(EFloatLiteral(token_float_val(t.lex_token)), Span(t.lex_start, t.lex_end))

        # String literal
        if ptag == TOK_STRING:
            SpannedToken t = self.advance()
            return SpannedExpr(EStringLiteral(token_string_val(t.lex_token), token_has_interpolation(t.lex_token)), Span(t.lex_start, t.lex_end))

        # Bool literal
        if ptag == TOK_BOOL:
            SpannedToken t = self.advance()
            match t.lex_token:
                case TkBool(v):
                    return SpannedExpr(EBoolLiteral(v), Span(t.lex_start, t.lex_end))
                else:
                    return SpannedExpr(EBoolLiteral(false), Span(t.lex_start, t.lex_end))

        # true / false keywords
        if self.check_kw(KW_TRUE):
            SpannedToken t = self.advance()
            return SpannedExpr(EBoolLiteral(true), Span(t.lex_start, t.lex_end))
        if self.check_kw(KW_FALSE):
            SpannedToken t = self.advance()
            return SpannedExpr(EBoolLiteral(false), Span(t.lex_start, t.lex_end))

        # None literal
        if self.check_kw(KW_NONE):
            SpannedToken t = self.advance()
            return SpannedExpr(ENoneLiteral(), Span(t.lex_start, t.lex_end))

        # self keyword
        if self.check_kw(KW_SELF_LOWER):
            SpannedToken t = self.advance()
            return SpannedExpr(ESelfExpr(), Span(t.lex_start, t.lex_end))

        # Type keyword as expression (e.g., int.parse(), SparseSet[int])
        int prefix_kw = self.peek_kw()
        if is_type_keyword(prefix_kw) and prefix_kw != KW_AUTO and prefix_kw != KW_SELF_UPPER and prefix_kw != KW_VOID:
            String tname = type_keyword_name(prefix_kw)
            SpannedToken t = self.advance()
            return SpannedExpr(EIdentifier(tname), Span(t.lex_start, t.lex_end))

        # it keyword (implicit closure parameter)
        if self.check_kw(KW_IT):
            SpannedToken t = self.advance()
            return SpannedExpr(EIt(), Span(t.lex_start, t.lex_end))

        # panic keyword (treated as a function call)
        if self.check_kw(KW_PANIC):
            SpannedToken t = self.advance()
            SpannedExpr callee = SpannedExpr(EIdentifier("panic"), Span(t.lex_start, t.lex_end))
            if self.check_tok(TOK_LPAREN):
                Vector[SpannedExpr] call_args = self.parse_call_args()
                Vector[String] call_names = self.last_arg_names
                return SpannedExpr(ECall(Box(callee), call_args, call_names, Vector[SpannedType]()), Span(start, self.peek().lex_start))
            return callee

        # Unary minus
        if ptag == TOK_MINUS:
            self.advance()
            # D28 R1 (docs/define-gorget/decisions.md:1197): unparenthesized
            # unary `-` with `**` is a compile REJECT (JS/TC39 guardrail).
            # Cross-lane parity with Rust `src/parser/expr.rs:544-563`.
            # Operand bp is 33 (one below Pow's left-bp of 34) so `**` IS
            # consumed inside the operand — this exposes the shape for
            # structural detection.
            int r1_next_ptag = self.peek_tag()
            SpannedExpr operand = self.parse_expr_bp(33)
            if r1_next_ptag != TOK_LPAREN:
                match operand.expr:
                    case EBinaryOp(_l1, r1_op, _r1):
                        if r1_op == "**":
                            panic("error[E_AmbiguousUnaryMinusPow]: unparenthesized unary `-` with `**` is ambiguous (D28 amendment R1). Write `-(x ** y)` (negation of the result) or `(-x) ** y` (base is negated).")
                    else:
                        pass
            return SpannedExpr(EUnaryOp("-", Box(operand)), Span(start, operand.span.end))

        # Bitwise NOT
        if ptag == TOK_TILDE:
            self.advance()
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EUnaryOp("~", Box(operand)), Span(start, operand.span.end))

        # Unary not
        if self.check_kw(KW_NOT):
            self.advance()
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EUnaryOp("not", Box(operand)), Span(start, operand.span.end))

        # Unary bang/caret (move) — but !(params):/^(params): is a move
        # closure. D27 accept-both: `!` (retired) and `^` (canonical) both
        # produce the same EMove AST this round. Round B does the fmt-swap
        # and later rejects `!`.
        if ptag == TOK_BANG or ptag == TOK_CARET:
            self.advance()
            # Check for move closure: !(params): body / ^(params): body
            if self.check_tok(TOK_LPAREN):
                int saved_move = self.pos
                bool is_closure = self.try_detect_closure()
                self.pos = saved_move
                if is_closure:
                    return self.parse_closure_expr(start)
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EMove(Box(operand)), Span(start, operand.span.end))

        # move keyword as move (same as !)
        if self.check_kw(KW_MOVE):
            self.advance()
            if self.check_tok(TOK_LPAREN):
                int saved_move2 = self.pos
                bool is_closure2 = self.try_detect_closure()
                self.pos = saved_move2
                if is_closure2:
                    return self.parse_closure_expr(start)
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EMove(Box(operand)), Span(start, operand.span.end))

        # prefix await expr
        if self.check_kw(KW_AWAIT):
            self.advance()
            SpannedExpr aw_operand = self.parse_expr_bp(2)
            return SpannedExpr(EAwait(Box(aw_operand)), Span(start, aw_operand.span.end))

        # spawn [blocking] [unchecked] expr / spawn [unchecked] [blocking] expr
        # Rust formatter strips `unchecked` (the AST stores it as a flag,
        # not a syntactic token); to round-trip through self-host we just
        # consume and discard it.
        if self.check_kw(KW_SPAWN):
            self.advance()
            bool is_blocking = false
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "blocking":
                is_blocking = true
                self.advance()
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "unchecked":
                self.advance()
            if not is_blocking and self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "blocking":
                is_blocking = true
                self.advance()
            if is_blocking:
                SpannedExpr sb_operand = self.parse_expr_bp(2)
                return SpannedExpr(ESpawnBlocking(Box(sb_operand)), Span(start, sb_operand.span.end))
            SpannedExpr s_operand = self.parse_expr_bp(2)
            return SpannedExpr(ESpawn(Box(s_operand)), Span(start, s_operand.span.end))

        # Mutable borrow &expr
        if ptag == TOK_AMP:
            self.advance()
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EMutableBorrow(Box(operand)), Span(start, operand.span.end))

        # Dot-shorthand: .Variant() or .Variant(args) or .Variant
        if ptag == TOK_DOT:
            self.advance()
            SpannedToken vname_tok = self.advance()
            String vname = token_ident(vname_tok.lex_token)
            Vector[SpannedExpr] ds_args = Vector[SpannedExpr]()
            if self.check_tok(TOK_LPAREN):
                ds_args = self.parse_call_args()
            return SpannedExpr(EDotShorthand(vname, ds_args), Span(start, self.peek().lex_start))

        # Deref *expr
        if ptag == TOK_STAR:
            self.advance()
            SpannedExpr operand = self.parse_expr_bp(60)
            return SpannedExpr(EDeref(Box(operand)), Span(start, operand.span.end))

        # Closure or parenthesized expr or tuple
        if ptag == TOK_LPAREN:
            # Try to detect closure: (params): body
            int saved = self.pos
            bool is_closure = self.try_detect_closure()
            self.pos = saved
            if is_closure:
                return self.parse_closure_expr(start)
            self.advance()
            if self.check_tok(TOK_RPAREN):
                self.advance()
                # Check if this is a no-arg closure: (): body
                if self.check_tok(TOK_COLON):
                    self.advance()
                    Vector[Stmt] body = Vector[Stmt]()
                    if self.check_tok(TOK_NEWLINE):
                        body = self.parse_block()
                    else:
                        SpannedExpr expr = self.parse_expr()
                        body.push(SExpr(expr))
                    return SpannedExpr(EClosure(Vector[Param](), body), Span(start, self.peek().lex_start))
                return SpannedExpr(ETupleLiteral(Vector[SpannedExpr]()), Span(start, self.peek().lex_start))
            SpannedExpr first = self.parse_expr()
            if self.match_tok(TOK_COMMA):
                Vector[SpannedExpr] elems = Vector[SpannedExpr]()
                elems.push(first)
                if not self.check_tok(TOK_RPAREN):
                    elems.push(self.parse_expr())
                    while self.consume_comma_or_tok(TOK_RPAREN):
                        elems.push(self.parse_expr())
                self.expect_tok(TOK_RPAREN, "expected ')' after tuple")
                return SpannedExpr(ETupleLiteral(elems), Span(start, self.peek().lex_start))
            self.expect_tok(TOK_RPAREN, "expected ')'")
            return first

        # Array literal or list comprehension: [a, b, c] or [expr for var in iter]
        if ptag == TOK_LBRACKET:
            self.advance()
            Vector[SpannedExpr] elems = Vector[SpannedExpr]()
            if not self.check_tok(TOK_RBRACKET):
                elems.push(self.parse_expr())
                # Check for list comprehension: [expr for var in iter [if cond]]
                if self.check_kw(KW_FOR):
                    SpannedExpr comp_expr = elems.get(0).unwrap()
                    self.advance()
                    SpannedToken var_tok = self.advance()
                    String var_name = token_ident(var_tok.lex_token)
                    self.expect_kw(KW_IN, "expected 'in' in comprehension")
                    SpannedExpr iterable = self.parse_expr()
                    # Optional 'if cond' filter
                    Option[Box[SpannedExpr]] cond = None
                    if self.check_kw(KW_IF):
                        self.advance()
                        SpannedExpr cond_expr = self.parse_expr()
                        cond = Some(Box(cond_expr))
                    self.expect_tok(TOK_RBRACKET, "expected ']' after comprehension")
                    return SpannedExpr(EListComp(Box(comp_expr), var_name, Box(iterable), cond), Span(start, self.peek().lex_start))
                while self.consume_comma_or_tok(TOK_RBRACKET):
                    elems.push(self.parse_expr())
            self.expect_tok(TOK_RBRACKET, "expected ']' after array literal")
            return SpannedExpr(EArrayLiteral(elems), Span(start, self.peek().lex_start))

        # Dict literal, set comprehension, or dict comprehension: {}, {k: v}, {expr for var in iter}, {k: v for var in iter}
        if ptag == TOK_LBRACE:
            self.advance()
            Vector[SpannedExpr] keys = Vector[SpannedExpr]()
            Vector[SpannedExpr] vals = Vector[SpannedExpr]()
            if not self.check_tok(TOK_RBRACE):
                SpannedExpr first = self.parse_expr()
                # Set comprehension: {expr for var in iter [if cond]}
                if self.check_kw(KW_FOR):
                    self.advance()
                    SpannedToken var_tok = self.advance()
                    String var_name = token_ident(var_tok.lex_token)
                    self.expect_kw(KW_IN, "expected 'in' in set comprehension")
                    SpannedExpr iterable = self.parse_expr()
                    # Optional 'if cond' filter
                    Option[Box[SpannedExpr]] cond = None
                    if self.check_kw(KW_IF):
                        self.advance()
                        SpannedExpr cond_expr = self.parse_expr()
                        cond = Some(Box(cond_expr))
                    self.expect_tok(TOK_RBRACE, "expected '}' after set comprehension")
                    return SpannedExpr(ESetComp(Box(first), var_name, Box(iterable), cond), Span(start, self.peek().lex_start))
                self.expect_tok(TOK_COLON, "expected ':' in dict literal")
                SpannedExpr v = self.parse_expr()
                # Dict comprehension: {key: value for var in iter}
                if self.check_kw(KW_FOR):
                    self.advance()
                    SpannedToken dvar_tok = self.advance()
                    String dvar_name = token_ident(dvar_tok.lex_token)
                    self.expect_kw(KW_IN, "expected 'in' in dict comprehension")
                    SpannedExpr diterable = self.parse_expr()
                    # Optional 'if cond' filter
                    Option[Box[SpannedExpr]] dcond = None
                    if self.check_kw(KW_IF):
                        self.advance()
                        SpannedExpr dcond_expr = self.parse_expr()
                        dcond = Some(Box(dcond_expr))
                    self.expect_tok(TOK_RBRACE, "expected '}' after dict comprehension")
                    return SpannedExpr(EDictComp(Box(first), Box(v), dvar_name, Box(diterable), dcond), Span(start, self.peek().lex_start))
                keys.push(first)
                vals.push(v)
                while self.consume_comma_or_tok(TOK_RBRACE):
                    SpannedExpr k2 = self.parse_expr()
                    self.expect_tok(TOK_COLON, "expected ':' in dict literal")
                    SpannedExpr v2 = self.parse_expr()
                    keys.push(k2)
                    vals.push(v2)
            self.expect_tok(TOK_RBRACE, "expected '}' after dict literal")
            return SpannedExpr(EDictLiteral(keys, vals), Span(start, self.peek().lex_start))

        # If expression
        if self.check_kw(KW_IF):
            return self.parse_if_expr()

        # Match expression
        if self.check_kw(KW_MATCH):
            return self.parse_match_expr()

        # Do block expression
        if self.check_kw(KW_DO):
            self.advance()
            self.expect_tok(TOK_COLON, "expected ':' after do")
            Vector[Stmt] body = self.parse_block()
            return SpannedExpr(EDo(body), Span(start, self.peek().lex_start))

        # Some(expr), Ok(expr), Error(expr), Box(expr), String(...), Option(...) — keyword constructors
        if self.check_kw(KW_SOME) or self.check_kw(KW_OK) or self.check_kw(KW_ERROR) or self.check_kw(KW_BOX) or self.check_kw(KW_RC) or self.check_kw(KW_ARC) or self.check_kw(KW_STRING_TYPE) or self.check_kw(KW_OPTION) or self.check_kw(KW_WEAK) or self.check_kw(KW_CELL) or self.check_kw(KW_REFCELL) or self.check_kw(KW_MUTEX) or self.check_kw(KW_RWLOCK):
            SpannedToken kw_tok = self.advance()
            String ctor_name = ""
            int kt = keyword_tag(kw_tok.lex_token)
            if kt == KW_SOME:
                ctor_name = "Some"
            elif kt == KW_OK:
                ctor_name = "Ok"
            elif kt == KW_ERROR:
                ctor_name = "Error"
            elif kt == KW_BOX:
                ctor_name = "Box"
            elif kt == KW_RC:
                ctor_name = "Rc"
            elif kt == KW_ARC:
                ctor_name = "Arc"
            elif kt == KW_STRING_TYPE:
                ctor_name = "String"
            elif kt == KW_OPTION:
                ctor_name = "Option"
            elif kt == KW_WEAK:
                ctor_name = "Weak"
            elif kt == KW_CELL:
                ctor_name = "Cell"
            elif kt == KW_REFCELL:
                ctor_name = "RefCell"
            elif kt == KW_MUTEX:
                ctor_name = "Mutex"
            elif kt == KW_RWLOCK:
                ctor_name = "RwLock"
            SpannedExpr callee = SpannedExpr(EIdentifier(ctor_name), Span(kw_tok.lex_start, kw_tok.lex_end))
            if self.check_tok(TOK_LBRACKET):
                # Generic constructor: Option[int]()
                int saved = self.pos
                self.enter_speculation()
                Vector[SpannedType] targs = self.parse_type_args()
                if self.check_tok(TOK_LPAREN):
                    Vector[SpannedExpr] call_args = self.parse_call_args()
                    Vector[String] call_names = self.last_arg_names
                    self.exit_speculation()
                    return SpannedExpr(ECall(Box(callee), call_args, call_names, targs), Span(start, self.peek().lex_start))
                # Restore — wasn't a generic constructor.
                self.exit_speculation()
                self.pos = saved
            if self.check_tok(TOK_LPAREN):
                Vector[SpannedExpr] call_args = self.parse_call_args()
                Vector[String] call_names = self.last_arg_names
                return SpannedExpr(ECall(Box(callee), call_args, call_names, Vector[SpannedType]()), Span(start, self.peek().lex_start))
            return callee

        # Identifier (variable, function name, type constructor)
        if ptag == TOK_IDENT:
            SpannedToken name_tok = self.advance()
            String name = token_ident(name_tok.lex_token)
            return SpannedExpr(EIdentifier(name), Span(name_tok.lex_start, name_tok.lex_end))

        # Fallback
        self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected expression"))
        SpannedToken err_tok = self.advance()
        return SpannedExpr(EIntLiteral(0), Span(err_tok.lex_start, err_tok.lex_end))

    # ── If expression ────────────────────────────────────────

    SpannedExpr parse_if_expr(&self):
        int start = self.peek().lex_start
        self.expect_kw(KW_IF, "expected 'if'")
        SpannedExpr cond = self.parse_expr()
        self.expect_tok(TOK_COLON, "expected ':' after if condition")
        Vector[Stmt] body = self.parse_block()
        Vector[ElseBranch] branches = Vector[ElseBranch]()
        while self.check_kw(KW_ELIF):
            self.advance()
            SpannedExpr elif_cond = self.parse_expr()
            self.expect_tok(TOK_COLON, "expected ':' after elif condition")
            Vector[Stmt] elif_body = self.parse_block()
            branches.push(ElseBranch(Some(elif_cond), elif_body))
        if self.check_kw(KW_ELSE):
            self.advance()
            self.expect_tok(TOK_COLON, "expected ':' after else")
            Vector[Stmt] else_body = self.parse_block()
            branches.push(ElseBranch(None, else_body))
        return SpannedExpr(EIf(Box(cond), body, branches), Span(start, self.peek().lex_start))

    # ── Match expression ─────────────────────────────────────

    SpannedExpr parse_match_expr(&self):
        int start = self.peek().lex_start
        self.expect_kw(KW_MATCH, "expected 'match'")
        SpannedExpr subject = self.parse_expr()
        self.expect_tok(TOK_COLON, "expected ':' after match subject")
        self.expect_tok(TOK_NEWLINE, "expected newline after match ':'")
        self.expect_tok(TOK_INDENT, "expected indent in match body")
        Vector[MatchArm] arms = Vector[MatchArm]()
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            if self.check_kw(KW_CASE):
                self.advance()
                SpannedPattern pat = self.parse_pattern()
                # Parse optional guard: if expr
                Option[SpannedExpr] guard = None
                if self.check_kw(KW_IF):
                    self.advance()
                    guard = Some(self.parse_expr())
                self.expect_tok(TOK_COLON, "expected ':' after case pattern")
                Vector[Stmt] arm_body = self.parse_block()
                arms.push(MatchArm(pat, guard, arm_body))
            elif self.check_kw(KW_ELSE):
                self.advance()
                self.expect_tok(TOK_COLON, "expected ':' after else")
                Vector[Stmt] else_body = self.parse_block()
                SpannedPattern wild = SpannedPattern(PWildcard(), Span(start, start))
                arms.push(MatchArm(wild, None, else_body))
            else:
                self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected 'case' or 'else' in match"))
                self.advance()
        self.match_tok(TOK_DEDENT)
        return SpannedExpr(EMatch(Box(subject), arms), Span(start, self.peek().lex_start))

    # ── Block parsing ────────────────────────────────────────

    Vector[Stmt] parse_block(&self):
        Vector[Stmt] stmts = Vector[Stmt]()
        self.skip_trivia()
        if not self.match_tok(TOK_INDENT):
            # Single-line block after colon
            if not self.check_tok(TOK_NEWLINE) and not self.check_tok(TOK_DEDENT) and not self.at_end():
                stmts.push(self.parse_statement())
                self.skip_newlines()
            return stmts
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            stmts.push(self.parse_statement())
            self.skip_newlines()
        self.match_tok(TOK_DEDENT)
        return stmts

    # ── Statement parsing ────────────────────────────────────

    Stmt parse_statement(&self):
        self.skip_trivia()
        int start = self.peek().lex_start

        # return
        if self.check_kw(KW_RETURN):
            self.advance()
            if self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_DEDENT) or self.at_end():
                return SReturn(None)
            SpannedExpr val = self.parse_expr()
            # Bare tuple return: `return 10, 20` → ETupleLiteral
            # Trailing comma ACCEPTED (owner-directive 2026-08-09): the
            # loop advances past `,` then checks for end-of-statement
            # (NEWLINE/DEDENT/EOF) before parsing another expression.
            # Uses `check_tok`/`advance` (not `match_tok`) so the site
            # doesn't add to the raw-loop lint count.
            if self.check_tok(TOK_COMMA):
                Vector[SpannedExpr] elems = Vector[SpannedExpr]()
                elems.push(val)
                while self.check_tok(TOK_COMMA):
                    self.advance()
                    if self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_DEDENT) or self.at_end():
                        break
                    elems.push(self.parse_expr())
                val = SpannedExpr(ETupleLiteral(elems), Span(0, 0))
            return SReturn(Some(val))

        # break
        if self.check_kw(KW_BREAK):
            self.advance()
            if self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_DEDENT) or self.at_end():
                return SBreak()
            # `break <expr>` (loop-as-expression) was removed from the
            # surface (D19). Report the teaching error, then parse and
            # discard the value so recovery stays statement-local.
            self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "break takes no value; loops are not expressions"))
            self.parse_expr()
            return SBreak()

        # continue
        if self.check_kw(KW_CONTINUE):
            self.advance()
            return SContinue()

        # pass
        if self.check_kw(KW_PASS):
            self.advance()
            return SPass()

        # throw
        if self.check_kw(KW_THROW):
            self.advance()
            SpannedExpr val = self.parse_expr()
            return SThrow(val)

        # assert / assert return
        if self.check_kw(KW_ASSERT):
            self.advance()
            # assert return __return__ <op> <expr>
            if self.check_kw(KW_RETURN):
                int ret_start = self.peek().lex_start
                self.advance()
                SpannedExpr ret_ident = SpannedExpr(EIdentifier("__return__"), Span(ret_start, ret_start + 6))
                SpannedExpr cond = self.parse_expr_with_lhs(!ret_ident)
                Option[String] msg = None
                if self.match_tok(TOK_COMMA):
                    if self.check_tok(TOK_STRING):
                        SpannedToken mt = self.advance()
                        Option[String] some_msg = Some(token_string_val(mt.lex_token))
                        msg = !some_msg
                return SAssertReturn(cond, msg)
            SpannedExpr cond = self.parse_expr()
            Option[String] msg = None
            if self.match_tok(TOK_COMMA):
                if self.check_tok(TOK_STRING):
                    SpannedToken mt = self.advance()
                    Option[String] some_msg = Some(token_string_val(mt.lex_token))
                    msg = !some_msg
            return SAssert(cond, msg)

        # snapshot "name" expr
        if self.check_kw(KW_SNAPSHOT):
            self.advance()
            String snap_name = ""
            int snap_name_span = 0
            if self.check_tok(TOK_STRING):
                SpannedToken snap_name_tok = self.advance()
                snap_name = token_string_val(snap_name_tok.lex_token)
                snap_name_span = snap_name_tok.lex_start
            SpannedExpr snap_val = self.parse_expr()
            return SSnapshot(snap_name, snap_name_span, snap_val)

        # on error: body
        if self.check_kw(KW_ON):
            int on_saved = self.pos
            self.advance()
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "error":
                self.advance()
                self.expect_tok(TOK_COLON, "expected ':' after 'on error'")
                Vector[Stmt] on_body = self.parse_block()
                return SOnError(on_body)
            self.pos = on_saved

        # if statement
        if self.check_kw(KW_IF):
            return self.parse_if_stmt()

        # while
        if self.check_kw(KW_WHILE):
            self.advance()
            SpannedExpr cond = self.parse_expr()
            self.expect_tok(TOK_COLON, "expected ':' after while condition")
            Vector[Stmt] body = self.parse_block()
            # Skip optional else: block (while-else)
            if self.check_kw(KW_ELSE):
                self.advance()
                self.expect_tok(TOK_COLON, "expected ':' after else")
                self.parse_block()
            return SWhile(cond, body)

        # for
        if self.check_kw(KW_FOR):
            return self.parse_for_stmt()

        # loop
        if self.check_kw(KW_LOOP):
            self.advance()
            self.expect_tok(TOK_COLON, "expected ':' after loop")
            Vector[Stmt] body = self.parse_block()
            return SLoop(body)

        # match statement
        if self.check_kw(KW_MATCH):
            return self.parse_match_stmt()

        # with — parse_expr() consumes 'expr as name' as EAs(expr, type);
        # decompose the cast to extract the binding name
        if self.check_kw(KW_WITH):
            self.advance()
            SpannedExpr full_expr = self.parse_expr()
            self.expect_tok(TOK_COLON, "expected ':' after with binding")
            Vector[Stmt] body = self.parse_block()
            return decompose_with_stmt(!full_expr, !body)

        # Items: struct, enum, trait, equip, import, from, directive, const, type, newtype, extern, test
        if self.check_kw(KW_STRUCT):
            return SItem(self.parse_struct_item(!Vector[String]()))
        if self.check_kw(KW_ENUM):
            return SItem(self.parse_enum_item(!Vector[String]()))
        if self.check_kw(KW_TRAIT):
            return SItem(self.parse_trait_item())
        if self.check_kw(KW_EQUIP):
            return SItem(self.parse_equip_item())
        if self.check_kw(KW_IMPORT) or self.check_kw(KW_FROM):
            return SItem(self.parse_import_item())
        if self.check_kw(KW_DIRECTIVE):
            return SItem(self.parse_directive_item())
        if self.check_kw(KW_CONST):
            return SItem(self.parse_const_item())
        if self.check_kw(KW_TYPE):
            return SItem(self.parse_type_alias_item())
        if self.check_kw(KW_NEWTYPE):
            return SItem(self.parse_newtype_item())
        if self.check_kw(KW_EXTERN):
            return SItem(self.parse_extern_block())
        if self.check_kw(KW_TEST):
            return SItem(self.parse_test_item())
        if self.check_kw(KW_BENCH):
            return SItem(self.parse_bench_item())
        if self.check_kw(KW_SUITE):
            return SItem(self.parse_suite_item())

        # select statement: produce SSelect with SelectArm entries
        if self.check_kw(KW_SELECT):
            self.advance()
            self.expect_tok(TOK_COLON, "expected ':' after select")
            self.skip_trivia()
            Vector[SelectArm] arms = Vector[SelectArm]()
            if self.match_tok(TOK_INDENT):
                while not self.check_tok(TOK_DEDENT) and not self.at_end():
                    self.skip_trivia()
                    if self.check_tok(TOK_DEDENT):
                        break
                    if self.check_kw(KW_CASE):
                        self.advance()
                        SelectOp op = self.parse_select_op()
                        if self.check_tok(TOK_COLON):
                            self.advance()
                        Vector[Stmt] arm_body = self.parse_block()
                        arms.push(SelectArm(op, arm_body))
                    else:
                        self.advance()
                    self.skip_newlines()
                self.match_tok(TOK_DEDENT)
            return SSelect(arms)

        # meta statements: parse bodies for for/if, skip rest for others
        if self.check_kw(KW_META):
            self.advance()
            if self.check_kw(KW_FOR):
                # meta for <vars> in <iterable>: body
                # PROTOTYPE slice #4: capture the loop-var names + the
                # iterable expression so the 3-arity SMetaFor matches the
                # typechecker/lowerer copies (fidelity — this parser dir is
                # an independent comparison driver).
                self.advance()
                Vector[String] mf_vars = Vector[String]()
                String mf_first = self.parse_meta_for_var_name()
                if mf_first != "":
                    mf_vars.push(mf_first)
                while self.check_tok(TOK_COMMA):
                    self.advance()
                    String mf_nv = self.parse_meta_for_var_name()
                    if mf_nv != "":
                        mf_vars.push(mf_nv)
                self.expect_kw(KW_IN, "expected 'in' in meta-for header")
                SpannedExpr mf_iter = self.parse_expr()
                self.expect_tok(TOK_COLON, "expected ':' after meta-for header")
                self.expect_tok(TOK_NEWLINE, "expected newline after meta-for ':'")
                Vector[Stmt] body = self.parse_block()
                return SMetaFor(mf_vars, mf_iter, body)
            elif self.check_kw(KW_IF):
                # meta if <cond>: body [elif <cond>: body]* [else: body]
                # Capture the condition expression so the delayed-meta engine
                # can evaluate it per-mono. Mirrors the IMetaIf #1 fix at the
                # statement level.
                self.advance()
                SpannedExpr meta_cond = self.parse_expr()
                self.expect_tok(TOK_COLON, "expected ':' after meta if condition")
                self.expect_tok(TOK_NEWLINE, "expected newline after meta if ':'")
                Vector[Stmt] then_body = self.parse_block()
                Vector[ElseBranch] branches = Vector[ElseBranch]()
                while self.check_kw(KW_ELIF):
                    self.advance()
                    SpannedExpr elif_cond = self.parse_expr()
                    self.expect_tok(TOK_COLON, "expected ':' after meta elif condition")
                    self.expect_tok(TOK_NEWLINE, "expected newline after meta elif ':'")
                    Vector[Stmt] elif_body = self.parse_block()
                    branches.push(ElseBranch(Some(elif_cond), elif_body))
                if self.check_kw(KW_ELSE):
                    self.advance()
                    self.expect_tok(TOK_COLON, "expected ':' after else")
                    self.expect_tok(TOK_NEWLINE, "expected newline after else ':'")
                    Vector[Stmt] else_body = self.parse_block()
                    branches.push(ElseBranch(None, else_body))
                return SMetaIf(meta_cond, then_body, branches)
            elif self.check_kw(KW_CONST):
                # meta const <name> = <expr>
                # PROTOTYPE slice #4b: capture the binding name + value so the
                # delayed-meta engine can evaluate it (e.g.
                # `enum_ordinal(T, vname)`) and substitute references. Mirrors
                # Rust parse_meta_const_stmt (stmt.rs:999). Previously fell into
                # the else arm below and was discarded as bare SMeta().
                self.advance()
                SpannedToken mc_name_tok = self.advance()
                String mc_name = token_ident(mc_name_tok.lex_token)
                self.expect_tok(TOK_EQ, "expected '=' in meta const")
                SpannedExpr mc_val = self.parse_expr()
                self.skip_newlines()
                return SMetaConst(mc_name, mc_val)
            else:
                self.skip_meta_rest()
                return SMeta()

        # async — skip the keyword and parse the rest as normal
        if self.check_kw(KW_ASYNC):
            self.advance()
            # The rest could be a function def, var decl, etc.
            return self.parse_statement()

        # on error: — contextual keyword (on and error are identifiers)
        if self.check_tok(TOK_IDENT):
            SpannedToken maybe_on = self.peek()
            if token_ident(maybe_on.lex_token) == "on":
                # Check if next token is identifier 'error'
                int saved = self.pos
                self.advance()
                if self.check_tok(TOK_IDENT):
                    SpannedToken maybe_err = self.peek()
                    if token_ident(maybe_err.lex_token) == "error":
                        self.advance()
                        # Skip optional binding: on error as e:
                        if self.check_kw(KW_AS):
                            self.advance()
                            self.advance()
                        # on error: block or on error inline-stmt
                        if self.check_tok(TOK_COLON):
                            self.advance()
                            self.parse_block()
                        else:
                            # inline form: on error stmt
                            while not self.at_end() and not self.check_tok(TOK_NEWLINE) and not self.check_tok(TOK_DEDENT):
                                self.advance()
                        return SPass()
                self.pos = saved

        # shared variable declaration: shared [type] name = expr
        if self.check_kw(KW_SHARED):
            return self.parse_shared_var_decl()

        # Named scope: identifier: \n INDENT body DEDENT
        if self.check_tok(TOK_IDENT):
            int ns_saved = self.pos
            bool is_named_scope = false
            self.advance()
            if self.check_tok(TOK_COLON):
                self.advance()
                if self.check_tok(TOK_NEWLINE):
                    self.advance()
                    self.skip_trivia()
                    if self.check_tok(TOK_INDENT):
                        is_named_scope = true
            self.pos = ns_saved
            if is_named_scope:
                SpannedToken label_tok = self.advance()
                String label_name = token_ident(label_tok.lex_token)
                self.expect_tok(TOK_COLON, "expected ':'")
                Vector[Stmt] ns_body = self.parse_block()
                return SNamedScope(label_name, ns_body)

        # Try to parse as var decl: Type name = expr
        # We detect this by checking if current position looks like a type followed by an identifier and =
        int saved_pos = self.pos
        bool is_var_decl = self.try_detect_var_decl()
        self.pos = saved_pos

        if is_var_decl:
            return self.parse_var_decl()

        # Function definition: Type name(...):
        int saved_pos2 = self.pos
        bool is_func = self.try_detect_function()
        self.pos = saved_pos2

        if is_func:
            return SItem(self.parse_function_item())

        # Expression statement (possibly followed by assignment)
        SpannedExpr expr = self.parse_expr()

        # Check for assignment: expr = expr
        if self.check_tok(TOK_EQ):
            self.advance()
            SpannedExpr rhs = self.parse_expr()
            return SAssign(expr, rhs)

        # Check for compound assignment: expr += expr, etc.
        int op_tag = self.peek_tag()
        if is_compound_assign(op_tag):
            String cop = compound_op_str(op_tag)
            self.advance()
            SpannedExpr rhs = self.parse_expr()
            return SCompoundAssign(expr, cop, rhs)

        return SExpr(expr)

    # ── If statement ─────────────────────────────────────────

    Stmt parse_if_stmt(&self):
        int start = self.peek().lex_start
        self.expect_kw(KW_IF, "expected 'if'")
        SpannedExpr cond = self.parse_expr()
        self.expect_tok(TOK_COLON, "expected ':' after if condition")
        Vector[Stmt] body = self.parse_block()
        Vector[ElseBranch] branches = Vector[ElseBranch]()
        bool done = false
        while not done:
            if self.check_kw(KW_ELIF):
                self.advance()
                SpannedExpr elif_cond = self.parse_expr()
                self.expect_tok(TOK_COLON, "expected ':' after elif condition")
                Vector[Stmt] elif_body = self.parse_block()
                branches.push(ElseBranch(Some(elif_cond), elif_body))
            elif self.check_kw(KW_ELSE):
                self.advance()
                if self.check_kw(KW_IF):
                    # else if → treat as elif
                    self.advance()
                    SpannedExpr elif_cond = self.parse_expr()
                    self.expect_tok(TOK_COLON, "expected ':' after elif condition")
                    Vector[Stmt] elif_body = self.parse_block()
                    branches.push(ElseBranch(Some(elif_cond), elif_body))
                else:
                    self.expect_tok(TOK_COLON, "expected ':' after else")
                    Vector[Stmt] else_body = self.parse_block()
                    branches.push(ElseBranch(None, else_body))
                    done = true
            else:
                done = true
        return SIf(cond, body, branches)

    # ── For statement ────────────────────────────────────────

    Stmt parse_for_stmt(&self):
        self.expect_kw(KW_FOR, "expected 'for'")
        SpannedPattern pat = self.parse_pattern()
        # Bare tuple for pattern: `for a, b in ...` → PTuple
        # Trailing comma ACCEPTED (owner-directive 2026-08-09): advance
        # past `,` then check for `in` (KW terminator) before parsing.
        # Uses `check_tok`/`advance` so this doesn't add to the
        # raw-loop lint count.
        if self.check_tok(TOK_COMMA):
            Vector[SpannedPattern] pats = Vector[SpannedPattern]()
            pats.push(pat)
            while self.check_tok(TOK_COMMA):
                self.advance()
                if self.check_kw(KW_IN):
                    break
                pats.push(self.parse_pattern())
            pat = SpannedPattern(PTuple(pats), Span(0, 0))
        self.expect_kw(KW_IN, "expected 'in' in for loop")
        SpannedExpr iter = self.parse_expr()
        self.expect_tok(TOK_COLON, "expected ':' after for iterable")
        Vector[Stmt] body = self.parse_block()
        # Parse optional else: block (for-else)
        Vector[Stmt] else_body = Vector[Stmt]()
        if self.check_kw(KW_ELSE):
            self.advance()
            self.expect_tok(TOK_COLON, "expected ':' after else")
            else_body = self.parse_block()
        return SFor(pat, iter, body, OWN_BORROW, else_body)

    # ── Match statement ──────────────────────────────────────

    Stmt parse_match_stmt(&self):
        int start = self.peek().lex_start
        self.expect_kw(KW_MATCH, "expected 'match'")
        SpannedExpr subject = self.parse_expr()
        self.expect_tok(TOK_COLON, "expected ':' after match subject")
        self.expect_tok(TOK_NEWLINE, "expected newline after match ':'")
        self.expect_tok(TOK_INDENT, "expected indent in match body")
        Vector[MatchArm] arms = Vector[MatchArm]()
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            if self.check_kw(KW_CASE):
                self.advance()
                SpannedPattern pat = self.parse_pattern()
                # Parse optional guard: if expr
                Option[SpannedExpr] guard = None
                if self.check_kw(KW_IF):
                    self.advance()
                    guard = Some(self.parse_expr())
                self.expect_tok(TOK_COLON, "expected ':' after case pattern")
                Vector[Stmt] arm_body = self.parse_block()
                arms.push(MatchArm(pat, guard, arm_body))
            elif self.check_kw(KW_META):
                # meta for/if inside match — skip entirely
                self.advance()
                self.skip_meta_rest()
            elif self.check_kw(KW_ELSE):
                self.advance()
                self.expect_tok(TOK_COLON, "expected ':' after else")
                Vector[Stmt] else_body = self.parse_block()
                SpannedPattern wild = SpannedPattern(PWildcard(), Span(start, start))
                arms.push(MatchArm(wild, None, else_body))
            else:
                self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "expected 'case' or 'else' in match"))
                self.advance()
        self.match_tok(TOK_DEDENT)
        return SMatch(subject, arms)

    # ── Var decl detection (lookahead) ───────────────────────

    bool try_detect_var_decl(&self):
        # A var decl looks like: Type name = ...
        # Type can be: keyword, Ident, Ident[...], (T, T), etc.
        # After type, must be Ident followed by =

        # Skip the type
        if not self.skip_type_lookahead():
            return false

        # Must have an identifier or tuple pattern (for destructuring)
        if self.check_tok(TOK_IDENT):
            self.advance()
            # Bare tuple destructuring: `auto a, b = expr`
            if self.check_tok(TOK_COMMA):
                while self.check_tok(TOK_COMMA):
                    self.advance()
                    if self.check_tok(TOK_IDENT):
                        self.advance()
                return self.check_tok(TOK_EQ)
            # Must have =
            return self.check_tok(TOK_EQ)
        # Tuple pattern: Type (a, b) = expr
        if self.check_tok(TOK_LPAREN):
            self.skip_paren_contents()
            return self.check_tok(TOK_EQ)
        return false

    bool skip_type_lookahead(&self):
        # Try to skip over what looks like a type expression
        int kw = self.peek_kw()
        if is_type_keyword(kw):
            self.advance()
            # Check for function type: RetType(ParamTypes...) — but not auto(...)
            if kw != KW_AUTO and kw != KW_SELF_UPPER and self.check_tok(TOK_LPAREN):
                self.skip_paren_contents()
            return true

        if self.check_kw(KW_BOX) or self.check_kw(KW_RC) or self.check_kw(KW_ARC) or self.check_kw(KW_WEAK) or self.check_kw(KW_CELL) or self.check_kw(KW_REFCELL) or self.check_kw(KW_MUTEX) or self.check_kw(KW_RWLOCK):
            self.advance()
            if self.check_tok(TOK_LBRACKET):
                self.skip_bracket_contents()
            return true

        # Result/Option variant keywords used as trait names in
        # generic-param trait bounds (e.g. `[Error E]`).
        if self.check_kw(KW_ERROR) or self.check_kw(KW_OK) or self.check_kw(KW_SOME) or self.check_kw(KW_NONE):
            self.advance()
            if self.check_tok(TOK_LBRACKET):
                self.skip_bracket_contents()
            return true

        if self.check_tok(TOK_IDENT):
            self.advance()
            if self.check_tok(TOK_LBRACKET):
                self.skip_bracket_contents()
            # Check for function type: Name[T](ParamTypes...)
            if self.check_tok(TOK_LPAREN):
                self.skip_paren_contents()
            return true

        if self.check_tok(TOK_LPAREN):
            self.skip_paren_contents()
            return true

        if self.check_tok(TOK_LBRACKET):
            self.skip_bracket_contents()
            return true

        return false

    void skip_bracket_contents(&self):
        if not self.match_tok(TOK_LBRACKET):
            return
        int depth = 1
        while depth > 0 and not self.at_end():
            if self.check_tok(TOK_LBRACKET):
                depth = depth + 1
            elif self.check_tok(TOK_RBRACKET):
                depth = depth - 1
            self.advance()

    void skip_paren_contents(&self):
        if not self.match_tok(TOK_LPAREN):
            return
        int depth = 1
        while depth > 0 and not self.at_end():
            if self.check_tok(TOK_LPAREN):
                depth = depth + 1
            elif self.check_tok(TOK_RPAREN):
                depth = depth - 1
            self.advance()

    # ── Function detection (lookahead) ───────────────────────

    bool try_detect_function(&self):
        # A function looks like: Type name(...):  or  Type name(...) = expr
        if not self.skip_type_lookahead():
            return false
        # Bare tuple return type: `int, String name(...)` — skip comma-separated types
        while self.check_tok(TOK_COMMA):
            self.advance()
            if not self.skip_type_lookahead():
                return false
        # Function name can be an identifier or a keyword (e.g., 'from' in trait impl)
        if not self.check_tok(TOK_IDENT) and self.peek_kw() == 0:
            return false
        self.advance()
        # Optional type params
        if self.check_tok(TOK_LBRACKET):
            self.skip_bracket_contents()
        if self.check_tok(TOK_LPAREN):
            return true
        return false

    # ── Var decl parsing ─────────────────────────────────────

    Stmt parse_var_decl(&self):
        int own = OWN_BORROW
        SpannedType ty = self.parse_type()
        String name = ""
        if self.check_tok(TOK_LPAREN):
            # Tuple pattern: Type (a, b, ...) = expr
            self.advance()
            name = "("
            bool first = true
            while not self.check_tok(TOK_RPAREN) and not self.at_end():
                if not first:
                    self.expect_tok(TOK_COMMA, "expected ',' in tuple pattern")
                    name = name + ", "
                first = false
                SpannedToken ptok = self.advance()
                name = name + token_ident(ptok.lex_token)
            self.expect_tok(TOK_RPAREN, "expected ')' in tuple pattern")
            name = name + ")"
        else:
            SpannedToken name_tok = self.advance()
            name = token_ident(name_tok.lex_token)
            # Bare tuple destructuring: `auto a, b = expr`
            # Trailing comma ACCEPTED (owner-directive 2026-08-09):
            # advance past `,` then check for `=` before consuming the
            # next ident.  Uses `check_tok`/`advance` so this doesn't add
            # to the raw-loop lint count.
            if self.check_tok(TOK_COMMA):
                name = "(" + name
                while self.check_tok(TOK_COMMA):
                    self.advance()
                    if self.check_tok(TOK_EQ):
                        break
                    SpannedToken next_tok = self.advance()
                    name = name + ", " + token_ident(next_tok.lex_token)
                name = name + ")"
        self.expect_tok(TOK_EQ, "expected '=' in variable declaration")
        SpannedExpr init = self.parse_expr()
        return SVarDecl(ty, name, init, own, 0, -1)

    # Like parse_var_decl but captures name_span for RES entry (used in select arms)
    Stmt parse_select_var_decl(&self):
        int own = OWN_BORROW
        SpannedType ty = self.parse_type()
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        int name_span = name_tok.lex_start
        self.expect_tok(TOK_EQ, "expected '=' in variable declaration")
        SpannedExpr init = self.parse_expr()
        return SVarDecl(ty, name, init, own, 0, name_span)

    # Parse a select arm operation: recv or send
    SelectOp parse_select_op(&self):
        int saved = self.pos
        # Try recv: Type name = channel.recv()
        if self.try_detect_var_decl():
            self.pos = saved
            SpannedType ty = self.parse_type()
            SpannedToken name_tok = self.advance()
            String name = token_ident(name_tok.lex_token)
            int name_span = name_tok.lex_start
            self.expect_tok(TOK_EQ, "expected '=' in select recv")
            SpannedExpr recv_expr = self.parse_expr()
            # Extract channel from MethodCall(.recv())
            match recv_expr.expr:
                case EMethodCall(receiver, method, _, _, _):
                    if method == "recv":
                        return SORecv(name, name_span, *receiver)
                else:
                    pass
            # Fallback: use the whole expression
            return SORecv(name, name_span, recv_expr)
        self.pos = saved
        # Try send: channel.send(value)
        SpannedExpr send_expr = self.parse_expr()
        match send_expr.expr:
            case EMethodCall(receiver, method, args, _, _):
                if method == "send" and sexpr_vec_len(args) == 1:
                    SpannedExpr value = get_sexpr_at(args, 0)
                    return SOSend(*receiver, value)
            else:
                pass
        # Fallback: treat as recv with empty name
        return SORecv("", 0, send_expr)

    Stmt parse_shared_var_decl(&self):
        self.advance()  # consume 'shared'
        # Parse optional override: shared(rwlock) or shared(atomic)
        int shared_kind = 1  # 1 = auto
        if self.check_tok(TOK_LPAREN):
            self.advance()
            SpannedToken override_tok = self.advance()
            String override_name = token_ident(override_tok.lex_token)
            if override_name == "rwlock":
                shared_kind = 2
            elif override_name == "atomic":
                shared_kind = 3
            self.expect_tok(TOK_RPAREN, "expected ')' after shared override")
        SpannedType ty = self.parse_type()
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        self.expect_tok(TOK_EQ, "expected '=' in shared variable declaration")
        SpannedExpr init = self.parse_expr()
        return SVarDecl(ty, name, init, OWN_BORROW, shared_kind, name_tok.lex_start)

    # ── Item parsing ─────────────────────────────────────────

    Item parse_function_item(&self):
        FunctionDef fd = self.parse_function_def()
        return IFunction(fd)

    FunctionDef parse_function_def(&self):
        SpannedType ret_ty = self.parse_type()
        # Bare tuple return type: `int, String f()` → `(int, String) f()`
        # Trailing comma ACCEPTED (owner-directive 2026-08-09): advance
        # past `,` then check for the fn name (TOK_IDENT) before parsing
        # another type, so `int, String, f():` breaks cleanly.  Uses
        # `check_tok`/`advance` so this doesn't add to the raw-loop
        # lint count.
        if self.check_tok(TOK_COMMA):
            Vector[SpannedType] tuple_types = Vector[SpannedType]()
            tuple_types.push(ret_ty)
            while self.check_tok(TOK_COMMA):
                self.advance()
                if self.check_tok(TOK_IDENT):
                    break
                tuple_types.push(self.parse_type())
            ret_ty = SpannedType(TTuple(tuple_types), Span(0, 0))
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        if name == "":
            # Function name is a keyword (e.g., 'from' in trait impl)
            int fn_kw = keyword_tag(name_tok.lex_token)
            name = non_type_keyword_name(fn_kw)
            if name == "":
                name = type_keyword_name(fn_kw)
        Vector[String] type_params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            type_params = self.parse_type_params()
        self.expect_tok(TOK_LPAREN, "expected '(' in function def")
        Vector[Param] params = self.parse_params()
        self.expect_tok(TOK_RPAREN, "expected ')' in function def")

        # Skip optional 'throws Type' — or the D29/A31 bare `!` (inferred
        # error set; this reduced AST drops the throws clause entirely).
        if self.check_kw(KW_THROWS):
            self.advance()
            self.parse_type()
        elif self.check_tok(TOK_BANG):
            self.advance()
            if not (self.check_tok(TOK_COLON) or self.check_tok(TOK_EQ) or self.check_tok(TOK_NEWLINE)):
                self.diagnostics.push(Diagnostic.error(self.current_span(), DkParseError(), "`! Type` is not a signature form — write `throws E` for an explicit error contract (bare `!` is reserved for A31 inferred error sets)"))

        # Expression-body function: Type name(params) = expr (deprecated)
        if self.check_tok(TOK_EQ):
            self.advance()
            SpannedExpr body_expr = self.parse_expr()
            Vector[Stmt] body = Vector[Stmt]()
            body.push(SReturn(Some(body_expr)))
            return FunctionDef(name, params, ret_ty, type_params, body, true)

        # Declaration-only function (no body — e.g. trait method signatures)
        if self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_DEDENT) or self.at_end():
            Vector[Stmt] body = Vector[Stmt]()
            return FunctionDef(name, params, ret_ty, type_params, body, false)

        self.expect_tok(TOK_COLON, "expected ':' after function signature")
        # Skip any comment tokens between : and the newline/indent
        self.skip_comments()
        # Colon + same-line content = expression body
        if not self.check_tok(TOK_NEWLINE):
            SpannedExpr body_expr = self.parse_expr()
            Vector[Stmt] body = Vector[Stmt]()
            body.push(SReturn(Some(body_expr)))
            return FunctionDef(name, params, ret_ty, type_params, body, true)
        Vector[Stmt] body = self.parse_block()
        return FunctionDef(name, params, ret_ty, type_params, body, false)

    Vector[Param] parse_params(&self):
        Vector[Param] params = Vector[Param]()
        if self.check_tok(TOK_RPAREN):
            return params
        params.push(self.parse_param())
        while self.consume_comma_or_tok(TOK_RPAREN):
            params.push(self.parse_param())
        return params

    Param parse_param(&self):
        int own = OWN_BORROW

        # Check for 'self' or '&self' or '!self'
        if self.check_kw(KW_SELF_LOWER):
            self.advance()
            SpannedType self_ty = SpannedType(TSelf(), self.current_span())
            return Param(self_ty, "self", OWN_BORROW, None)

        if self.check_tok(TOK_AMP):
            if keyword_tag(self.peek_at(1).lex_token) == KW_SELF_LOWER:
                self.advance()
                self.advance()
                SpannedType self_ty = SpannedType(TSelf(), self.current_span())
                return Param(self_ty, "self", OWN_MUTABLE, None)

        # D27 accept-both: `!self` (retired) and `^self` (canonical) both
        # mean OWN_MOVE on the self-face. Round B rejects `!self` here.
        if self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
            if keyword_tag(self.peek_at(1).lex_token) == KW_SELF_LOWER:
                self.advance()
                self.advance()
                SpannedType self_ty = SpannedType(TSelf(), self.current_span())
                return Param(self_ty, "self", OWN_MOVE, None)

        if self.check_kw(KW_MOVE):
            own = OWN_MOVE
            self.advance()

        SpannedType ty = self.parse_type()
        # Handle ownership markers between type and name (D27 accept-both `!`/`^`)
        if self.check_tok(TOK_BANG) or self.check_tok(TOK_CARET):
            own = OWN_MOVE
            self.advance()
        elif self.check_tok(TOK_AMP):
            own = OWN_MUTABLE
            self.advance()
        elif self.check_kw(KW_MOVE):
            own = OWN_MOVE
            self.advance()
        SpannedToken name_tok = self.advance()
        String pname = token_ident(name_tok.lex_token)
        # Capture optional default value: = expr
        Option[SpannedExpr] dflt = None
        if self.check_tok(TOK_EQ):
            self.advance()
            dflt = Some(self.parse_expr())
        return Param(ty, pname, own, dflt)

    Item parse_struct_item(&self, Vector[String] !derives):
        self.expect_kw(KW_STRUCT, "expected 'struct'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        Vector[String] type_params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            type_params = self.parse_type_params()
        self.expect_tok(TOK_COLON, "expected ':' after struct name")
        self.expect_tok(TOK_NEWLINE, "expected newline after struct ':'")
        self.expect_tok(TOK_INDENT, "expected indent in struct body")
        Vector[Param] fields = Vector[Param]()
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            SpannedType ftype = self.parse_type()
            SpannedToken fname_tok = self.advance()
            String fname = token_ident(fname_tok.lex_token)
            if fname == "":
                int fname_kw = keyword_tag(fname_tok.lex_token)
                fname = non_type_keyword_name(fname_kw)
                if fname == "":
                    fname = type_keyword_name(fname_kw)
            fields.push(Param(ftype, fname, OWN_BORROW, None))
            self.skip_newlines()
        self.match_tok(TOK_DEDENT)
        return IStruct(StructDef(name, fields, type_params, derives))

    Item parse_enum_item(&self, Vector[String] !derives):
        self.expect_kw(KW_ENUM, "expected 'enum'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        Vector[String] type_params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            type_params = self.parse_type_params()
        self.expect_tok(TOK_COLON, "expected ':' after enum name")
        self.expect_tok(TOK_NEWLINE, "expected newline after enum ':'")
        self.expect_tok(TOK_INDENT, "expected indent in enum body")
        Vector[EnumVariant] variants = Vector[EnumVariant]()
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            SpannedToken vname_tok = self.advance()
            String vname = token_ident(vname_tok.lex_token)
            Vector[SpannedType] vfields = Vector[SpannedType]()
            if self.match_tok(TOK_LPAREN):
                if not self.check_tok(TOK_RPAREN):
                    vfields.push(self.parse_type())
                    while self.consume_comma_or_tok(TOK_RPAREN):
                        vfields.push(self.parse_type())
                self.expect_tok(TOK_RPAREN, "expected ')' after variant fields")
            variants.push(EnumVariant(vname, vfields))
            self.skip_newlines()
        self.match_tok(TOK_DEDENT)
        return IEnum(EnumDef(name, variants, type_params, derives))

    Item parse_trait_item(&self):
        self.expect_kw(KW_TRAIT, "expected 'trait'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        Vector[String] type_params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            type_params = self.parse_type_params()
        Vector[String] extends_list = Vector[String]()
        if self.check_kw(KW_EXTENDS):
            self.advance()
            SpannedToken ext_tok = self.advance()
            extends_list.push(token_ident(ext_tok.lex_token))
            # Trait extension separator can be `,` or `&` (Rust formatter
            # normalises both to `, `).  This site has a TWO-token
            # separator so it doesn't fit `consume_comma_or_tok` —
            # rewritten in the pass-1-R1-fold advance-then-check shape so
            # a trailing separator (`extends A, B,`) breaks cleanly
            # instead of cascading a spurious empty bound at `:`.
            while self.check_tok(TOK_COMMA) or self.check_tok(TOK_AMP):
                self.advance()
                if self.check_tok(TOK_COLON):
                    break
                SpannedToken ext_tok2 = self.advance()
                extends_list.push(token_ident(ext_tok2.lex_token))
        self.expect_tok(TOK_COLON, "expected ':' after trait name")
        self.expect_tok(TOK_NEWLINE, "expected newline after trait ':'")
        self.expect_tok(TOK_INDENT, "expected indent in trait body")
        Vector[FunctionDef] methods = Vector[FunctionDef]()
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            # Associated type alias: `type Name [: Bound (& Bound)*]? [= Default]?`
            # Mirrors Rust's parse_associated_type (src/parser/mod.rs:1155). We
            # consume the tokens but do not model the assoc type in TraitDef yet
            # — the resolver/typechecker pipelines don't need it, and the only
            # fixture using this shape (sigil_type_args.gg) mismatches earlier
            # on `int !` sigil rendering anyway. The point is to silence the
            # spurious "expected type" diagnostic the fallback would emit.
            if self.check_kw(KW_TYPE):
                self.advance()
                self.advance()
                if self.match_tok(TOK_COLON):
                    SpannedType first_bound = self.parse_type()
                    while self.match_tok(TOK_AMP):
                        SpannedType next_bound = self.parse_type()
                if self.match_tok(TOK_EQ):
                    SpannedType default_ty = self.parse_type()
                self.skip_newlines()
                continue
            # Skip 'async' modifier before method def
            if self.check_kw(KW_ASYNC):
                self.advance()
            FunctionDef m = self.parse_function_def()
            methods.push(m)
            self.skip_newlines()
        self.match_tok(TOK_DEDENT)
        return ITrait(TraitDef(name, type_params, methods, extends_list))

    Item parse_equip_item(&self):
        self.expect_kw(KW_EQUIP, "expected 'equip'")
        # Parse optional generic params: equip [T] TypeName[T] with Trait:
        Vector[String] type_params = Vector[String]()
        if self.check_tok(TOK_LBRACKET):
            type_params = self.parse_type_params()
        SpannedType target = self.parse_type()
        Option[String] trait_name = None
        if self.check_kw(KW_WITH):
            self.advance()
            # Parse trait name as a type, then convert to string
            SpannedType trait_type = self.parse_type()
            String tn = type_to_name(trait_type)
            Option[String] some_tn = Some(tn)
            trait_name = !some_tn
            # Skip optional 'via field_name' delegation
            if self.check_kw(KW_VIA):
                self.advance()
                self.advance()
        Vector[FunctionDef] methods = Vector[FunctionDef]()
        # Bodyless equip: `equip T with Trait` (no colon) — default implementations
        if not self.check_tok(TOK_COLON):
            self.skip_newlines()
            return IEquip(EquipBlock(target, type_params, trait_name, methods))
        self.expect_tok(TOK_COLON, "expected ':' after equip target")
        self.expect_tok(TOK_NEWLINE, "expected newline after equip ':'")
        self.expect_tok(TOK_INDENT, "expected indent in equip body")
        while not self.check_tok(TOK_DEDENT) and not self.at_end():
            self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                break
            # Handle 'pass' as empty equip body (delegation with no overrides)
            if self.check_kw(KW_PASS):
                self.advance()
                self.skip_newlines()
                continue
            # Skip 'async' modifier before method def
            if self.check_kw(KW_ASYNC):
                self.advance()
            FunctionDef m = self.parse_function_def()
            methods.push(m)
            self.skip_newlines()
        self.match_tok(TOK_DEDENT)
        return IEquip(EquipBlock(target, type_params, trait_name, methods))

    Item parse_import_item(&self):
        int start = self.peek().lex_start
        String module_path = ""
        Vector[String] names = Vector[String]()

        if self.check_kw(KW_FROM):
            self.advance()
            # Parse dotted path: std.collections
            SpannedToken first = self.advance()
            module_path = token_ident(first.lex_token)
            while self.match_tok(TOK_DOT):
                SpannedToken next = self.advance()
                String seg = token_ident(next.lex_token)
                if seg == "":
                    seg = non_type_keyword_name(keyword_tag(next.lex_token))
                    if seg == "":
                        seg = type_keyword_name(keyword_tag(next.lex_token))
                module_path = module_path + "." + seg
            self.expect_kw(KW_IMPORT, "expected 'import' after from path")
            # Parse names (identifiers or keywords used as names like Box, Rc, Arc)
            # Trailing comma ACCEPTED (owner-directive 2026-08-09):
            # advance past `,` then check for end-of-statement
            # (NEWLINE/DEDENT/EOF).  Uses `check_tok`/`advance` so this
            # doesn't add to the raw-loop lint count.
            SpannedToken n1 = self.advance()
            String n1_name = self.extract_name(n1)
            names.push(n1_name)
            while self.check_tok(TOK_COMMA):
                self.advance()
                if self.check_tok(TOK_NEWLINE) or self.check_tok(TOK_DEDENT) or self.at_end():
                    break
                SpannedToken n2 = self.advance()
                String n2_name = self.extract_name(n2)
                names.push(n2_name)
        elif self.check_kw(KW_IMPORT):
            self.advance()
            SpannedToken first = self.advance()
            module_path = token_ident(first.lex_token)
            while self.match_tok(TOK_DOT):
                SpannedToken next = self.advance()
                module_path = module_path + "." + token_ident(next.lex_token)

        return IImport(ImportStmt(module_path, names))

    Item parse_directive_item(&self):
        self.expect_kw(KW_DIRECTIVE, "expected 'directive'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        # Consume hyphenated parts: immutable-by-default → "immutable-by-default"
        while self.check_tok(TOK_MINUS):
            self.advance()
            SpannedToken next = self.advance()
            name = name + "-" + token_ident(next.lex_token)
        # Check for test_suite directive
        if name == "test_suite":
            self.expect_tok(TOK_COLON, "expected ':' after test_suite")
            self.skip_trivia()
            # Look for setup: or teardown:
            if self.check_tok(TOK_INDENT):
                self.advance()
            SpannedToken sub_tok = self.advance()
            String sub_name = token_ident(sub_tok.lex_token)
            self.expect_tok(TOK_COLON, "expected ':' after setup/teardown")
            Vector[Stmt] body = self.parse_block()
            if sub_name == "setup":
                return ISuiteSetup(body)
            return ISuiteTeardown(body)
        String value = ""
        if self.match_tok(TOK_EQ):
            # directive name=value
            SpannedToken val_tok = self.advance()
            value = token_ident(val_tok.lex_token)
        elif not self.check_tok(TOK_NEWLINE) and not self.at_end():
            SpannedToken val_tok = self.advance()
            value = token_ident(val_tok.lex_token)
            # Consume hyphenated parts of value
            while self.check_tok(TOK_MINUS):
                self.advance()
                SpannedToken next = self.advance()
                value = value + "-" + token_ident(next.lex_token)
        return IDirective(name, value)

    Item parse_const_item(&self):
        self.expect_kw(KW_CONST, "expected 'const'")
        SpannedType ty = self.parse_type()
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        self.expect_tok(TOK_EQ, "expected '=' in const declaration")
        SpannedExpr val = self.parse_expr()
        return IConstDecl(ty, name, val)

    Item parse_type_alias_item(&self):
        self.expect_kw(KW_TYPE, "expected 'type'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        Vector[String] type_params = Vector[String]()
        if self.match_tok(TOK_LBRACKET):
            SpannedToken tp_tok = self.advance()
            type_params.push(token_ident(tp_tok.lex_token))
            while self.consume_comma_or_tok(TOK_RBRACKET):
                SpannedToken tp2 = self.advance()
                type_params.push(token_ident(tp2.lex_token))
            self.expect_tok(TOK_RBRACKET, "expected ']' after type params")
        self.expect_tok(TOK_EQ, "expected '=' in type alias")
        SpannedType target = self.parse_type()
        return ITypeAlias(name, type_params, target)

    Item parse_newtype_item(&self):
        self.expect_kw(KW_NEWTYPE, "expected 'newtype'")
        SpannedToken name_tok = self.advance()
        String name = token_ident(name_tok.lex_token)
        self.expect_tok(TOK_LPAREN, "expected '(' in newtype")
        SpannedType inner = self.parse_type()
        self.expect_tok(TOK_RPAREN, "expected ')' in newtype")
        return INewtype(name, inner)

    Item parse_extern_block(&self):
        self.expect_kw(KW_EXTERN, "expected 'extern'")
        # Skip optional ABI string (e.g., "C")
        if self.check_tok(TOK_STRING):
            self.advance()
        # Inline extern: extern int func(int x) = "symbol"
        # Detected when next token is a type keyword or identifier (not ':')
        if not self.check_tok(TOK_COLON):
            # Skip optional `blocking` / `noreturn` / `borrowed` (non-owning FFI
            # return alias) bare-ident modifiers before the return type — same
            # shape as the block form. Without skipping them the qualifier is
            # parsed as the return type and the whole inline extern decl is
            # dropped → an undefined link reference. (A.1b: the un-fixed sibling
            # of the `borrowed`-only inline skip; CLAUDE.md "fix the class, not
            # the instance".)
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "blocking":
                self.advance()
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "noreturn":
                self.advance()
            if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "borrowed":
                self.advance()
            FunctionDef fd = self.parse_function_def()
            # Convert expr-body (= "symbol") to declaration (empty body)
            Vector[Stmt] empty = Vector[Stmt]()
            FunctionDef decl = FunctionDef(fd.name, fd.params, fd.return_type, fd.type_params, empty, false)
            return IFunction(decl)
        self.expect_tok(TOK_COLON, "expected ':' after extern")
        Vector[FunctionDef] fns = Vector[FunctionDef]()
        if self.match_tok(TOK_INDENT):
            while not self.check_tok(TOK_DEDENT) and not self.at_end():
                self.skip_trivia()
                if self.check_tok(TOK_DEDENT) or self.at_end():
                    break
                # Skip 'public' if present
                if self.check_kw(KW_PUBLIC):
                    self.advance()
                # Skip the inner `extern` keyword so the next token is the
                # return type, matching what parse_function_def expects.
                if self.check_kw(KW_EXTERN):
                    self.advance()
                # Skip optional `blocking` / `noreturn` / `borrowed` modifiers
                # before the return type. These are bare identifiers in the
                # self-host lexer (not keywords). `borrowed` (e.g. `extern
                # borrowed String f() = "sym"`) marks a non-owning FFI return
                # alias; without skipping it the qualifier is parsed as the
                # return type and the extern decl mis-parses.
                if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "blocking":
                    self.advance()
                if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "noreturn":
                    self.advance()
                if self.check_tok(TOK_IDENT) and token_ident(self.peek().lex_token) == "borrowed":
                    self.advance()
                if self.check_kw(KW_ASYNC):
                    self.advance()
                Item fn_item = self.parse_function_item()
                match fn_item:
                    case IFunction(fd):
                        fns.push(fd)
                    else:
                        pass
                self.skip_trivia()
            if self.check_tok(TOK_DEDENT):
                self.advance()
        return IExternBlock(fns)

    Item parse_test_item(&self):
        self.expect_kw(KW_TEST, "expected 'test'")
        SpannedToken name_tok = self.advance()
        String name = token_string_val(name_tok.lex_token)
        # Parse optional 'with Expr as name [, Expr as name]*' clause
        # Token-level extraction: scan for `as <ident>` patterns and collect exprs/names
        Vector[SpannedExpr] with_exprs = Vector[SpannedExpr]()
        Vector[String] with_names = Vector[String]()
        if self.check_kw(KW_WITH):
            self.advance()
            # Parse each 'expr as name' binding
            while not self.check_tok(TOK_COLON) and not self.at_end():
                SpannedExpr wexpr = self.parse_expr()
                # parse_expr consumes 'expr as name' as EAs
                # Extract name by looking at what parse_expr produced
                String binding_name = "_"
                match wexpr.expr:
                    case EAs(_, _):
                        # The 'as name' was consumed; extract name from the last token
                        # before current position (the identifier after 'as')
                        # Since parse_expr already consumed it, peek back
                        if self.pos > 0:
                            SpannedToken prev = self.tokens.get(self.pos - 1).unwrap()
                            if token_tag(prev.lex_token) == TOK_IDENT:
                                binding_name = token_ident(prev.lex_token)
                    else:
                        pass
                with_exprs.push(wexpr)
                with_names.push(binding_name)
                if not self.match_tok(TOK_COMMA):
                    break
        self.expect_tok(TOK_COLON, "expected ':' after test name")
        Vector[Stmt] body = self.parse_block()
        return ITest(name, with_exprs, with_names, body)

    Item parse_bench_item(&self):
        self.expect_kw(KW_BENCH, "expected 'bench'")
        SpannedToken name_tok = self.advance()
        String name = token_string_val(name_tok.lex_token)
        self.expect_tok(TOK_COLON, "expected ':' after bench name")
        Vector[Stmt] body = self.parse_block()
        return IBench(name, body)

    Item parse_suite_item(&self):
        self.expect_kw(KW_SUITE, "expected 'suite'")
        SpannedToken sub_tok = self.advance()
        String sub_name = token_ident(sub_tok.lex_token)
        self.expect_tok(TOK_COLON, "expected ':' after suite setup/teardown")
        Vector[Stmt] body = self.parse_block()
        if sub_name == "setup":
            return ISuiteSetup(body)
        return ISuiteTeardown(body)

    # ── Module parsing ───────────────────────────────────────

    Module parse_module(&self):
        Vector[Item] items = Vector[Item]()
        self.skip_trivia()
        while not self.at_end():
            self.skip_trivia()
            if self.at_end():
                break

            # Parse @attributes — capture @derive(...) trait names
            Vector[String] pending_derives = Vector[String]()
            while self.check_tok(TOK_AT):
                self.advance()
                String attr_name = ""
                if self.check_tok(TOK_IDENT):
                    SpannedToken attr_tok = self.advance()
                    attr_name = token_ident(attr_tok.lex_token)
                elif self.peek_kw() > 0:
                    self.advance()
                if attr_name == "derive" and self.check_tok(TOK_LPAREN):
                    self.advance()
                    while not self.check_tok(TOK_RPAREN) and not self.at_end():
                        if self.check_tok(TOK_IDENT):
                            SpannedToken dt = self.advance()
                            pending_derives.push(token_ident(dt.lex_token))
                        if self.check_tok(TOK_COMMA):
                            self.advance()
                    self.match_tok(TOK_RPAREN)
                elif self.check_tok(TOK_LPAREN):
                    self.skip_paren_contents()
                self.skip_trivia()

            if self.at_end():
                break

            # Skip 'public' visibility modifier
            if self.check_kw(KW_PUBLIC):
                self.advance()

            # Try to detect an item
            if self.check_kw(KW_STRUCT):
                items.push(self.parse_struct_item(!pending_derives))
            elif self.check_kw(KW_ENUM):
                items.push(self.parse_enum_item(!pending_derives))
            elif self.check_kw(KW_TRAIT):
                items.push(self.parse_trait_item())
            elif self.check_kw(KW_EQUIP):
                items.push(self.parse_equip_item())
            elif self.check_kw(KW_IMPORT) or self.check_kw(KW_FROM):
                items.push(self.parse_import_item())
            elif self.check_kw(KW_DIRECTIVE):
                items.push(self.parse_directive_item())
            elif self.check_kw(KW_CONST):
                items.push(self.parse_const_item())
            elif self.check_kw(KW_TYPE):
                items.push(self.parse_type_alias_item())
            elif self.check_kw(KW_NEWTYPE):
                items.push(self.parse_newtype_item())
            elif self.check_kw(KW_EXTERN):
                items.push(self.parse_extern_block())
            elif self.check_kw(KW_TEST):
                items.push(self.parse_test_item())
            elif self.check_kw(KW_BENCH):
                items.push(self.parse_bench_item())
            elif self.check_kw(KW_SUITE):
                items.push(self.parse_suite_item())
            elif self.check_kw(KW_ASYNC):
                # Skip 'async' and re-enter the item detection loop
                self.advance()
                continue
            elif self.check_kw(KW_META):
                int meta_saved = self.pos
                self.advance()
                bool parsed_meta_item = false
                # meta if ...
                if self.check_kw(KW_IF):
                    items.push(IMetaIf())
                    parsed_meta_item = true
                # meta assert ...
                elif self.check_kw(KW_ASSERT):
                    items.push(IMetaAssert())
                    parsed_meta_item = true
                # meta log(...)
                elif self.check_tok(TOK_IDENT) and self.peek_ident() == "log":
                    items.push(IMetaLog())
                    parsed_meta_item = true
                # meta type Name = ... or meta type Name(...)
                elif self.check_kw(KW_TYPE):
                    self.advance()  # skip 'type'
                    SpannedToken mt_name_tok = self.advance()
                    String mt_name = token_ident(mt_name_tok.lex_token)
                    if self.check_tok(TOK_LPAREN):
                        items.push(IMetaTypeFunc(mt_name))
                    elif self.check_tok(TOK_EQ):
                        self.advance()  # skip '='
                        # Try to parse RHS: type, type if cond else type, or call(args)
                        int mt_saved = self.pos
                        bool mt_is_call = false
                        # Check for call form: ident(args)
                        if self.check_tok(TOK_IDENT) or self.peek_kw() > 0:
                            int mt_peek = self.pos
                            self.advance()  # skip callee name
                            if self.check_tok(TOK_LPAREN):
                                mt_is_call = true
                            self.pos = mt_peek
                        if mt_is_call:
                            String mt_callee = ""
                            if self.check_tok(TOK_IDENT):
                                SpannedToken ct = self.advance()
                                mt_callee = token_ident(ct.lex_token)
                            elif self.peek_kw() > 0:
                                SpannedToken ct = self.advance()
                                mt_callee = non_type_keyword_name(keyword_tag(ct.lex_token))
                            self.match_tok(TOK_LPAREN)
                            Vector[SpannedExpr] mt_call_args = Vector[SpannedExpr]()
                            while not self.check_tok(TOK_RPAREN) and not self.at_end():
                                mt_call_args.push(self.parse_expr())
                                if self.check_tok(TOK_COMMA):
                                    self.advance()
                            self.match_tok(TOK_RPAREN)
                            items.push(IMetaType(mt_name, MtrCall(mt_callee, mt_call_args)))
                        else:
                            SpannedType mt_rhs = self.parse_type()
                            if self.check_kw(KW_IF):
                                self.advance()  # skip 'if'
                                String mt_cond = ""
                                if self.check_tok(TOK_IDENT):
                                    SpannedToken cond_tok = self.advance()
                                    mt_cond = token_ident(cond_tok.lex_token)
                                self.expect_kw(KW_ELSE, "expected 'else'")
                                SpannedType mt_else = self.parse_type()
                                items.push(IMetaType(mt_name, MtrConditional(mt_rhs, mt_cond, mt_else)))
                            else:
                                items.push(IMetaType(mt_name, MtrPlain(mt_rhs)))
                    else:
                        items.push(IMetaType(mt_name, MtrUnresolved()))
                    parsed_meta_item = true
                # meta Type name = expr (meta const)
                elif not self.check_kw(KW_FOR) and not self.check_kw(KW_WHILE) and not self.check_kw(KW_MATCH) and not self.check_tok(TOK_NEWLINE) and not self.at_end():
                    int mc_saved = self.pos
                    if self.try_detect_var_decl():
                        self.pos = mc_saved
                        SpannedType mc_type = self.parse_type()
                        SpannedToken mc_name_tok = self.advance()
                        String mc_name = token_ident(mc_name_tok.lex_token)
                        if mc_name != "" and self.check_tok(TOK_EQ):
                            self.advance()
                            SpannedExpr mc_val = self.parse_expr()
                            items.push(IMetaConst(mc_type, mc_name, mc_val))
                            parsed_meta_item = true
                        else:
                            self.pos = meta_saved
                            self.advance()
                    else:
                        self.pos = meta_saved
                        self.advance()
                # Skip to end of line/block for all meta items
                if parsed_meta_item:
                    self.skip_meta_rest()
                else:
                    self.skip_meta_rest()
            else:
                    # Must be a function definition or top-level statement
                    int saved_pos = self.pos
                    bool is_func = self.try_detect_function()
                    self.pos = saved_pos
                    if is_func:
                        items.push(self.parse_function_item())
                    else:
                        Stmt s = self.parse_statement()
                        match s:
                            case SItem(found_item):
                                items.push(found_item)
                            case SVarDecl(ty, name, val, _, _, _):
                                # Module-level VarDecl → static declaration
                                items.push(IStaticDecl(ty, name, val))
                            else:
                                pass
            self.skip_trivia()
        return Module(items)

# ── Public API ───────────────────────────────────────────────

# Result of parsing: AST module plus any diagnostics gathered along the
# way. Parse errors don't abort — they get recorded and the parser does
# a best-effort recovery so downstream stages can still run on a partial
# AST. Mirrors the resolver's `ResolveContext` shape (one struct carrying
# both the staged output and the typed diagnostics stream).
struct ParseResult:
    Module module
    Vector[Diagnostic] diagnostics

# Parse `source` and return both the AST module and the collected
# diagnostics. Comparison drivers / CLIs use this entry point.
ParseResult parse_source(String source):
    Vector[SpannedToken] all_tokens = lex_tokenize(source)
    # Strip comment tokens from the stream — the Rust parser does this at init.
    # Without stripping, comments between structural tokens (COLON NEWLINE INDENT)
    # cause expect_tok failures that corrupt block parsing in equip/trait/etc.
    Vector[SpannedToken] tokens = Vector[SpannedToken]()
    int ti = 0
    while ti < all_tokens.len():
        SpannedToken tok = all_tokens.get(ti).unwrap()
        int tag = token_tag(tok.lex_token)
        if tag != TOK_COMMENT and tag != TOK_DOCCOMMENT:
            tokens.push(tok)
        ti = ti + 1
    Parser p = Parser(tokens, 0, Vector[Diagnostic](), 0, 0, 0, Vector[String]())
    Module m = p.parse_module()
    return ParseResult(m, p.diagnostics)
