# ── Token tag extraction ────────────────────────────────────

int token_tag(Token tok):
    match tok:
        case TkKeyword(_):
            return TOK_KEYWORD
        case TkIdentifier(_):
            return TOK_IDENT
        case TkInt(_):
            return TOK_INT
        case TkFloat(_):
            return TOK_FLOAT
        case TkString(_):
            return TOK_STRING
        case TkChar(_):
            return TOK_CHAR
        case TkBool(_):
            return TOK_BOOL
        case TkPlus:
            return TOK_PLUS
        case TkMinus:
            return TOK_MINUS
        case TkStar:
            return TOK_STAR
        case TkSlash:
            return TOK_SLASH
        case TkPercent:
            return TOK_PERCENT
        case TkEq:
            return TOK_EQ
        case TkLt:
            return TOK_LT
        case TkGt:
            return TOK_GT
        case TkBang:
            return TOK_BANG
        case TkAmpersand:
            return TOK_AMP
        case TkPipe:
            return TOK_PIPE
        case TkCaret:
            return TOK_CARET
        case TkTilde:
            return TOK_TILDE
        case TkDot:
            return TOK_DOT
        case TkQuestion:
            return TOK_QUESTION
        case TkAt:
            return TOK_AT
        case TkUnderscore:
            return TOK_UNDERSCORE
        case TkEqEq:
            return TOK_EQEQ
        case TkBangEq:
            return TOK_BANGEQ
        case TkLtEq:
            return TOK_LTEQ
        case TkGtEq:
            return TOK_GTEQ
        case TkLtLt:
            return TOK_LTLT
        case TkGtGt:
            return TOK_GTGT
        case TkPlusEq:
            return TOK_PLUSEQ
        case TkArrow:
            return TOK_ARROW
        case TkMinusEq:
            return TOK_MINUSEQ
        case TkStarEq:
            return TOK_STAREQ
        case TkSlashEq:
            return TOK_SLASHEQ
        case TkPercentEq:
            return TOK_PERCENTEQ
        case TkDotDot:
            return TOK_DOTDOT
        case TkDotDotEq:
            return TOK_DOTDOTEQ
        case TkQuestionDot:
            return TOK_QUESTIONDOT
        case TkDoubleQuestion:
            return TOK_DOUBLEQUESTION
        case TkLParen:
            return TOK_LPAREN
        case TkRParen:
            return TOK_RPAREN
        case TkLBracket:
            return TOK_LBRACKET
        case TkRBracket:
            return TOK_RBRACKET
        case TkLBrace:
            return TOK_LBRACE
        case TkRBrace:
            return TOK_RBRACE
        case TkColon:
            return TOK_COLON
        case TkComma:
            return TOK_COMMA
        case TkIndent:
            return TOK_INDENT
        case TkDedent:
            return TOK_DEDENT
        case TkNewline:
            return TOK_NEWLINE
        case TkEof:
            return TOK_EOF
        case TkComment(_):
            return TOK_COMMENT
        case TkDocComment(_):
            return TOK_DOCCOMMENT
        case TkError(_):
            return TOK_ERROR
        case TkAmpEq:
            return TOK_AMPEQ
        case TkPipeEq:
            return TOK_PIPEEQ
        case TkCaretEq:
            return TOK_CARETEQ
        case TkLtLtEq:
            return TOK_LTLTEQ
        case TkGtGtEq:
            return TOK_GTGTEQ
        else:
            return 0

int keyword_tag(Token tok):
