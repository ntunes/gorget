# CLI driver for parser comparison testing.
# Reads a .gg file, parses it, and prints canonical AST, one item per line
# to stdout. Diagnostics gathered during parsing are drained to stderr as
# `DIAG ...` lines (sorted by span start for determinism), keeping the
# stdout comparison contract line-by-line stable while still surfacing the
# typed diagnostic stream for inspection.
# Usage: driver <path-to-file.gg>

from parser import parse_source_into
from format import format_item, format_module
from ast import Module
from diagnostic import Diagnostic, format_diagnostic
from std.io import stderr
from std.fs import read_file
from std.os import args
from std.collections import Vector

void main():
    Vector[String] cmd_args = args()
    String path = cmd_args.get(1).unwrap()
    String source = read_file(path)
    Vector[Diagnostic] diagnostics = Vector[Diagnostic]()
    Module m = parse_source_into(source, &diagnostics)
    print(format_module(m))
    # Drain diagnostics to stderr. Sort by span start so the order is
    # deterministic regardless of parser-internal traversal order. Stderr
    # rather than stdout because parser_comparison does a line-by-line
    # match on stdout; routing DIAG lines off-band keeps clean parses
    # byte-identical while still making the diagnostic stream readable.
    if diagnostics.len() > 0:
        Vector[int] order = Vector[int]()
        int i = 0
        while i < diagnostics.len():
            order.push(i)
            i = i + 1
        int oi = 1
        while oi < order.len():
            int key = order.get(oi).unwrap()
            int key_start = diagnostics.get(key).unwrap().span.start
            int oj = oi - 1
            while oj >= 0:
                int other = order.get(oj).unwrap()
                if diagnostics.get(other).unwrap().span.start <= key_start:
                    break
                order.set(oj + 1, other)
                oj = oj - 1
            order.set(oj + 1, key)
            oi = oi + 1
        int k = 0
        while k < order.len():
            int idx = order.get(k).unwrap()
            Diagnostic d = diagnostics.get(idx).unwrap()
            print(format_diagnostic(d), file=stderr)
            k = k + 1
