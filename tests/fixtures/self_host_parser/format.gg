# AST formatter for the self-hosting Gorget parser.
# Produces canonical string representations of AST nodes for testing.

from std.collections import Vector
from std.conv import int_to_str, float_to_str
from std.math import floor, abs
from ast import Module, Item, Stmt, Expr, Type, Pattern, Span, SpannedExpr, SpannedType, SpannedPattern, FunctionDef, StructDef, EnumDef, EnumVariant, TraitDef, EquipBlock, MatchArm, ElseBranch, Param, ImportStmt, FaultCatchPattern

# ── Float formatting (decimal, no scientific notation) ──────────
# Matches Rust's Display for f64: shortest decimal without e+/e- notation.
# When %g produces scientific notation (e.g. 1e+06), convert to integer string.
# For floats that %g renders in decimal, return as-is.
String format_float_decimal(float f):
    String s = float_to_str(f)
    # If no scientific notation, return as-is
    if not s.contains("e") and not s.contains("E"):
        return s
    # Special values
    if s == "inf" or s == "-inf" or s == "nan":
        return s
    # For values that are exactly integers, convert via int
    # This handles the common case: 1e+06, 3.14159e+06, etc.
    float a = f
    if a < 0.0:
        a = 0.0 - a
    if a == floor(a) and a < 1000000000000000.0:
        int iv = 0
        if f >= 0.0:
            iv = f as int
        else:
            iv = (0.0 - (0.0 - f)) as int
        return int_to_str(iv)
    # For non-integer values with scientific notation, fall back to %g
    # (rare in parser canonical output — most large floats are integer-valued)
    return s

# ── Typed accessors (workaround: pattern-destructured Vectors lose generic type) ──

SpannedType get_stype_at(Vector[SpannedType] v, int i):
    return v.get(i).unwrap()

SpannedPattern get_spat_at(Vector[SpannedPattern] v, int i):
    return v.get(i).unwrap()

SpannedExpr get_sexpr_at(Vector[SpannedExpr] v, int i):
    return v.get(i).unwrap()

ElseBranch get_else_at(Vector[ElseBranch] v, int i):
    return v.get(i).unwrap()

MatchArm get_arm_at(Vector[MatchArm] v, int i):
    return v.get(i).unwrap()

Param get_param_at(Vector[Param] v, int i):
    return v.get(i).unwrap()

Stmt get_stmt_at(Vector[Stmt] v, int i):
    return v.get(i).unwrap()

String get_str_at(Vector[String] v, int i):
    return v.get(i).unwrap()

int sexpr_vec_len(Vector[SpannedExpr] v):
    return v.len()

bool has_opt_boxed_expr(Option[Box[SpannedExpr]] opt):
    match opt:
        case Some(_):
            return true
        else:
            return false

SpannedExpr get_opt_boxed_expr(Option[Box[SpannedExpr]] opt):
    match opt:
        case Some(b):
            return *b
        else:
            return SpannedExpr(EIntLiteral(0), Span(0, 0))

# ── Type formatting ──────────────────────────────────────────

String format_type(SpannedType st):
    match st.ty:
        case TPrimitive(name):
            return "" + name
        case TNamed(name, args):
            if args.len() == 0:
                return "" + name
            String result = name + "["
            int i = 0
            while i < args.len():
                if i > 0:
                    result = result + ", "
                SpannedType arg = get_stype_at(args, i)
                result = result + format_type(arg)
                i = i + 1
            result = result + "]"
            return result
        case TArray(elem, size):
            String es = format_type(*elem)
            String ss = int_to_str(size)
            return "[" + es + "; " + ss + "]"
        case TSlice(elem):
            String es = format_type(*elem)
            return "[" + es + "]"
        case TTuple(elems):
            String result = "("
            int i = 0
            while i < elems.len():
                if i > 0:
                    result = result + ", "
                SpannedType e = get_stype_at(elems, i)
                result = result + format_type(e)
                i = i + 1
            result = result + ")"
            return result
        case TFunction(ret, params, owns):
            String result = format_type(*ret) + "("
            int i = 0
            while i < params.len():
                if i > 0:
                    result = result + ", "
                SpannedType p = get_stype_at(params, i)
                result = result + format_type(p)
                i = i + 1
            result = result + ")"
            return result
        case TSelf:
            return "Self"
        case TInferred:
            return "auto"
        else:
            return "?"

# ── Pattern formatting ───────────────────────────────────────

String format_pattern(SpannedPattern sp):
    match sp.pat:
        case PWildcard:
            return "_"
        case PBinding(name):
            return "" + name
        case PLiteral(expr):
            return format_expr(expr)
        case PConstructor(name, args):
            if args.len() == 0:
                return "" + name
            String result = name + "("
            int i = 0
            while i < args.len():
                if i > 0:
                    result = result + ", "
                SpannedPattern a = get_spat_at(args, i)
                result = result + format_pattern(a)
                i = i + 1
            result = result + ")"
            return result
        case PDotShorthand(name, args):
            if args.len() == 0:
                return "." + name
            String result = "." + name + "("
            int i = 0
            while i < args.len():
                if i > 0:
                    result = result + ", "
                SpannedPattern a = get_spat_at(args, i)
                result = result + format_pattern(a)
                i = i + 1
            result = result + ")"
            return result
        case PTuple(elems):
            String result = "("
            int i = 0
            while i < elems.len():
                if i > 0:
                    result = result + ", "
                SpannedPattern e = get_spat_at(elems, i)
                result = result + format_pattern(e)
                i = i + 1
            result = result + ")"
            return result
        case POr(alts):
            String result = ""
            int i = 0
            while i < alts.len():
                if i > 0:
                    result = result + " | "
                SpannedPattern a = get_spat_at(alts, i)
                result = result + format_pattern(a)
                i = i + 1
            return result
        case PRest:
            return ".."
        else:
            return "?"

# ── Expression formatting ────────────────────────────────────

String format_expr(SpannedExpr se):
    match se.expr:
        case EIntLiteral(n):
            return int_to_str(n)
        case EFloatLiteral(f):
            String fs = format_float_decimal(f)
            if not fs.contains(".") and not fs.contains("e") and not fs.contains("E"):
                return fs + ".0"
            return fs
        case EBoolLiteral(b):
            if b:
                return "true"
            return "false"
        case EStringLiteral(s, _):
            return "\"" + s + "\""
        case ECharLiteral(c):
            if c.len() == 0:
                return "'\\0'"
            return "'" + c + "'"
        case ENoneLiteral:
            return "None"
        case EIdentifier(name):
            return "" + name
        case ESelfExpr:
            return "self"
        case EBinaryOp(l, op, r):
            String ls = format_expr(*l)
            String rs = format_expr(*r)
            return "(" + ls + " " + op + " " + rs + ")"
        case EUnaryOp(op, operand):
            String os = format_expr(*operand)
            return "(" + op + " " + os + ")"
        case ECall(callee, args, _, targs):
            String cs = format_expr(*callee)
            String result = cs + "("
            int i = 0
            while i < args.len():
                if i > 0:
                    result = result + ", "
                SpannedExpr a = get_sexpr_at(args, i)
                result = result + format_expr(a)
                i = i + 1
            result = result + ")"
            return result
        case EMethodCall(obj, name, args, _, targs):
            String os = format_expr(*obj)
            String result = os + "." + name + "("
            int i = 0
            while i < args.len():
                if i > 0:
                    result = result + ", "
                SpannedExpr a = get_sexpr_at(args, i)
                result = result + format_expr(a)
                i = i + 1
            result = result + ")"
            return result
        case EFieldAccess(obj, name):
            String os = format_expr(*obj)
            return os + "." + name
        case EIndex(obj, idx):
            String os = format_expr(*obj)
            String is_ = format_expr(*idx)
            return os + "[" + is_ + "]"
        case ERange(lo, hi, inclusive):
            String result = ""
            if has_opt_boxed_expr(lo):
                result = format_expr(get_opt_boxed_expr(lo))
            if inclusive:
                result = result + "..="
            else:
                result = result + ".."
            if has_opt_boxed_expr(hi):
                result = result + format_expr(get_opt_boxed_expr(hi))
            return result
        case EIf(cond, body, branches):
            String result = "if " + format_expr(*cond) + ":"
            result = result + format_block(body)
            int i = 0
            while i < branches.len():
                ElseBranch br = get_else_at(branches, i)
                match br.condition:
                    case Some(c):
                        result = result + " elif " + format_expr(c) + ":"
                    else:
                        result = result + " else:"
                result = result + format_block(br.body)
                i = i + 1
            return result
        case EMatch(subject, arms):
            String result = "match " + format_expr(*subject) + ":"
            int i = 0
            while i < arms.len():
                MatchArm arm = get_arm_at(arms, i)
                String arm_str = " case " + format_pattern(arm.pattern)
                result = result + arm_str + ":"
                result = result + format_block(arm.body)
                i = i + 1
            return result
        case EClosure(params, body):
            String result = "("
            int i = 0
            while i < params.len():
                if i > 0:
                    result = result + ", "
                Param p = get_param_at(params, i)
                result = result + format_type(p.param_type) + " " + p.param_name
                i = i + 1
            result = result + "):"
            result = result + format_block(body)
            return result
        case EIt():
            return "it"
        case EImplicitClosure(inner):
            return format_expr(*inner)
        case EArrayLiteral(elems):
            String result = "["
            int i = 0
            while i < elems.len():
                if i > 0:
                    result = result + ", "
                SpannedExpr e = get_sexpr_at(elems, i)
                result = result + format_expr(e)
                i = i + 1
            result = result + "]"
            return result
        case ETupleLiteral(elems):
            String result = "("
            int i = 0
            while i < elems.len():
                if i > 0:
                    result = result + ", "
                SpannedExpr e = get_sexpr_at(elems, i)
                result = result + format_expr(e)
                i = i + 1
            result = result + ")"
            return result
        case EDictLiteral(keys, vals):
            String open_b = r"{"
            String close_b = r"}"
            String result = open_b
            int i = 0
            while i < sexpr_vec_len(keys):
                if i > 0:
                    result = result + ", "
                SpannedExpr k = get_sexpr_at(keys, i)
                SpannedExpr v = get_sexpr_at(vals, i)
                result = result + format_expr(k) + ": " + format_expr(v)
                i = i + 1
            result = result + close_b
            return result
        case EStructLiteral(name, fields, vals):
            String result = name + "("
            int i = 0
            while i < sexpr_vec_len(vals):
                if i > 0:
                    result = result + ", "
                SpannedExpr v = get_sexpr_at(vals, i)
                result = result + format_expr(v)
                i = i + 1
            result = result + ")"
            return result
        case EDotShorthand(name, args):
            if sexpr_vec_len(args) == 0:
                return "." + name
            String result = "." + name + "("
            int i = 0
            while i < sexpr_vec_len(args):
                if i > 0:
                    result = result + ", "
                SpannedExpr a = get_sexpr_at(args, i)
                result = result + format_expr(a)
                i = i + 1
            result = result + ")"
            return result
        case ETry(inner):
            return format_expr(*inner) + "?"
        case EMove(inner):
            return "!" + format_expr(*inner)
        case EPropagate(inner):
            return format_expr(*inner) + "!"
        case EMutableBorrow(inner):
            return "&" + format_expr(*inner)
        case EDeref(inner):
            return "*" + format_expr(*inner)
        case EAs(inner, ty):
            return format_expr(*inner) + " as " + format_type(*ty)
        case EBlock(stmts):
            return "block:" + format_block(stmts)
        case EListComp(expr, var, iter, cond):
            String result = "[" + format_expr(*expr) + " for " + var + " in " + format_expr(*iter)
            if has_opt_boxed_expr(cond):
                result = result + " if " + format_expr(get_opt_boxed_expr(cond))
            result = result + "]"
            return result
        case ESetComp(expr, var, iter, cond):
            String lb = r"{"
            String rb = r"}"
            String sc_result = lb + format_expr(*expr) + " for " + var + " in " + format_expr(*iter)
            if has_opt_boxed_expr(cond):
                sc_result = sc_result + " if " + format_expr(get_opt_boxed_expr(cond))
            sc_result = sc_result + rb
            return sc_result
        case EDictComp(key, val, var, iter, cond):
            String lb = r"{"
            String rb = r"}"
            String dc_result = lb + format_expr(*key) + ": " + format_expr(*val) + " for " + var + " in " + format_expr(*iter)
            if has_opt_boxed_expr(cond):
                dc_result = dc_result + " if " + format_expr(get_opt_boxed_expr(cond))
            dc_result = dc_result + rb
            return dc_result
        case EDefaultOp(l, r):
            return "(" + format_expr(*l) + " ?? " + format_expr(*r) + ")"
        case EIs(expr, negated, pat):
            String es = format_expr(*expr)
            String ps = format_pattern(*pat)
            if negated:
                return "(" + es + " is not " + ps + ")"
            return "(" + es + " is " + ps + ")"
        case EDo(body):
            return "do:" + format_block(body)
        case EAwait(inner):
            return format_expr(*inner) + ".await()"
        case ESpawn(inner):
            return "spawn " + format_expr(*inner)
        case ESpawnBlocking(inner):
            return "spawn blocking " + format_expr(*inner)
        case ERethrow(expr, err_name, err_type, transform):
            String rhs = format_expr(*expr)
            match err_name:
                case Some(name):
                    SpannedType et = *err_type.unwrap()
                    rhs = rhs + " rethrow (" + format_type(et) + " " + name + "): "
                case None:
                    rhs = rhs + " rethrow "
            rhs = rhs + format_expr(*transform)
            return rhs
        case ECatch(expr, name, recovery):
            return format_expr(*expr) + " catch (" + name + "): " + format_expr(*recovery)
        case EFaultCatch(fc_expr, fc_pattern, fc_handler):
            String fc_pat = ""
            match fc_pattern:
                case FcpVariant(fc_qual, fc_var):
                    fc_pat = fc_qual + "." + fc_var
                case FcpBinding(fc_name):
                    fc_pat = fc_name
            return format_expr(*fc_expr) + " catch " + fc_pat + ": " + format_expr(*fc_handler)
        else:
            return "?"

# ── Statement formatting ─────────────────────────────────────

String format_stmt(Stmt s):
    match s:
        case SVarDecl(ty, name, init, own, sk, name_span):
            String ts = format_type(ty)
            String is_ = format_expr(init)
            return ts + " " + name + " = " + is_
        case SAssign(lhs, rhs):
            return format_expr(lhs) + " = " + format_expr(rhs)
        case SCompoundAssign(lhs, op, rhs):
            return format_expr(lhs) + " " + op + " " + format_expr(rhs)
        case SExpr(expr):
            return format_expr(expr)
        case SReturn(val):
            match val:
                case Some(v):
                    return "return " + format_expr(v)
                else:
                    return "return"
        case SThrow(val):
            return "throw " + format_expr(val)
        case SBreak():
            return "break"
        case SContinue:
            return "continue"
        case SPass:
            return "pass"
        case SMeta:
            return "meta"
        case SMetaConst(mc_name, mc_val):
            return "meta"
        case SMetaFor(mf_vars, mf_iter, body):
            return "meta"
        case SMetaIf(meta_cond, then_body, branches):
            return "meta"
        case SFor(pat, iter, body, own, _):
            return "for " + format_pattern(pat) + " in " + format_expr(iter) + ":" + format_block(body)
        case SWhile(cond, body):
            return "while " + format_expr(cond) + ":" + format_block(body)
        case SLoop(body):
            return "loop:" + format_block(body)
        case SIf(cond, body, branches):
            String result = "if " + format_expr(cond) + ":" + format_block(body)
            int i = 0
            while i < branches.len():
                ElseBranch br = get_else_at(branches, i)
                match br.condition:
                    case Some(c):
                        result = result + " elif " + format_expr(c) + ":"
                    else:
                        result = result + " else:"
                result = result + format_block(br.body)
                i = i + 1
            return result
        case SMatch(subject, arms):
            String result = "match " + format_expr(subject) + ":"
            int i = 0
            while i < arms.len():
                MatchArm arm = get_arm_at(arms, i)
                String arm_str = " case " + format_pattern(arm.pattern)
                result = result + arm_str + ":"
                result = result + format_block(arm.body)
                i = i + 1
            return result
        case SWith(resource, name, body):
            return "with " + format_expr(resource) + " as " + name + ":" + format_block(body)
        case SNamedScope(label, body):
            return label + ":" + format_block(body)
        case SSelect(arms):
            String result = "select:"
            int i = 0
            while i < arms.len():
                SelectArm arm = arms.get(i).unwrap()
                match arm.op:
                    case SORecv(name, _, channel):
                        result = result + " case " + name + " = " + format_expr(channel) + ".recv():"
                    case SOSend(channel, value):
                        result = result + " case " + format_expr(channel) + ".send(" + format_expr(value) + "):"
                result = result + format_block(arm.body)
                i = i + 1
            return result
        case SOnError(body):
            return "on error:" + format_block(body)
        case SAssert(cond, msg):
            String result = "assert " + format_expr(cond)
            match msg:
                case Some(m):
                    result = result + ", \"" + m + "\""
                else:
                    pass
            return result
        case SAssertReturn(cond, msg):
            String result = "assert return " + format_expr(cond)
            match msg:
                case Some(m):
                    result = result + ", \"" + m + "\""
                else:
                    pass
            return result
        case SItem(item):
            return format_item(item)
        case SSnapshot(name, _, value):
            return "snapshot \"" + name + "\" " + format_expr(value)
        else:
            return "?"

String format_block(Vector[Stmt] stmts):
    if stmts.len() == 0:
        return " pass"
    String result = ""
    int i = 0
    while i < stmts.len():
        Stmt s = stmts.get(i).unwrap()
        result = result + " " + format_stmt(s) + ";"
        i = i + 1
    return result

# ── Item formatting ──────────────────────────────────────────

String format_item(Item item):
    match item:
        case IFunction(fd):
            return format_function(fd)
        case IStruct(sd):
            return format_struct(sd)
        case IEnum(ed):
            return format_enum(ed)
        case ITrait(td):
            return format_trait(td)
        case IEquip(eq):
            return format_equip(eq)
        case IImport(imp):
            return format_import(imp)
        case IDirective(name, value):
            if value == "":
                return "directive " + name
            return "directive " + name + " " + value
        case ITypeAlias(name, tps, ty):
            String result = "type " + name
            if tps.len() > 0:
                result = result + "["
                int i = 0
                while i < tps.len():
                    if i > 0:
                        result = result + ", "
                    String tp = tps.get(i).unwrap()
                    result = result + tp
                    i = i + 1
                result = result + "]"
            result = result + " = " + format_type(ty)
            return result
        case INewtype(name, inner):
            return "newtype " + name + "(" + format_type(inner) + ")"
        case IConstDecl(ty, name, val):
            return "const " + format_type(ty) + " " + name + " = " + format_expr(val)
        case IMetaConst(ty, name, val):
            return "meta " + format_type(ty) + " " + name + " = " + format_expr(val)
        case IMetaType(name, rhs):
            return "meta type " + name + " = <rhs>"
        case IMetaTypeFunc(name):
            return "meta type " + name + "(...)"
        case IMetaAssert():
            return "meta assert ..."
        case IMetaIf():
            return "meta if ..."
        case IMetaLog():
            return "meta log ..."
        case IStaticDecl(ty, name, val):
            return "static " + format_type(ty) + " " + name + " = " + format_expr(val)
        case IExternBlock(fns):
            String result = "extern:"
            int i = 0
            while i < fns.len():
                FunctionDef f = fns.get(i).unwrap()
                result = result + " " + format_function(f) + ";"
                i = i + 1
            return result
        case ITest(name, _, _, body):
            return "test \"" + name + "\":" + format_block(body)
        case IBench(name, body):
            return "bench \"" + name + "\":" + format_block(body)
        case ISuiteSetup(body):
            return "suite_setup:" + format_block(body)
        case ISuiteTeardown(body):
            return "suite_teardown:" + format_block(body)
        else:
            return "?"

String format_function(FunctionDef fd):
    String result = format_type(fd.return_type) + " " + fd.name
    if fd.type_params.len() > 0:
        result = result + "["
        int i = 0
        while i < fd.type_params.len():
            if i > 0:
                result = result + ", "
            String tp = fd.type_params.get(i).unwrap()
            result = result + tp
            i = i + 1
        result = result + "]"
    result = result + "("
    int i = 0
    while i < fd.params.len():
        if i > 0:
            result = result + ", "
        Param p = fd.params.get(i).unwrap()
        if p.param_name == "self":
            if p.ownership == 1:
                result = result + "&self"
            elif p.ownership == 2:
                result = result + "!self"
            else:
                result = result + "self"
        else:
            result = result + format_type(p.param_type) + " " + p.param_name
        i = i + 1
    result = result + ")"
    if fd.is_expr_body:
        if fd.body.len() > 0:
            Stmt first = fd.body.get(0).unwrap()
            match first:
                case SReturn(val):
                    match val:
                        case Some(v):
                            result = result + " = " + format_expr(v)
                        else:
                            pass
                else:
                    pass
    else:
        result = result + ":" + format_block(fd.body)
    return result

String format_struct(StructDef sd):
    String result = "struct " + sd.name
    if sd.type_params.len() > 0:
        result = result + "["
        int i = 0
        while i < sd.type_params.len():
            if i > 0:
                result = result + ", "
            String tp = sd.type_params.get(i).unwrap()
            result = result + tp
            i = i + 1
        result = result + "]"
    result = result + ":"
    int i = 0
    while i < sd.fields.len():
        Param f = sd.fields.get(i).unwrap()
        result = result + " " + format_type(f.param_type) + " " + f.param_name + ";"
        i = i + 1
    return result

String format_enum(EnumDef ed):
    String result = "enum " + ed.name
    if ed.type_params.len() > 0:
        result = result + "["
        int i = 0
        while i < ed.type_params.len():
            if i > 0:
                result = result + ", "
            String tp = ed.type_params.get(i).unwrap()
            result = result + tp
            i = i + 1
        result = result + "]"
    result = result + ":"
    int i = 0
    while i < ed.variants.len():
        EnumVariant v = ed.variants.get(i).unwrap()
        result = result + " " + v.name
        if v.fields.len() > 0:
            result = result + "("
            int j = 0
            while j < v.fields.len():
                if j > 0:
                    result = result + ", "
                SpannedType ft = v.fields.get(j).unwrap()
                result = result + format_type(ft)
                j = j + 1
            result = result + ")"
        result = result + ";"
        i = i + 1
    return result

String format_trait(TraitDef td):
    String result = "trait " + td.name
    if td.type_params.len() > 0:
        result = result + "["
        int i = 0
        while i < td.type_params.len():
            if i > 0:
                result = result + ", "
            String tp = td.type_params.get(i).unwrap()
            result = result + tp
            i = i + 1
        result = result + "]"
    if td.parent_traits.len() > 0:
        result = result + " extends "
        int i = 0
        while i < td.parent_traits.len():
            if i > 0:
                result = result + ", "
            String e = td.parent_traits.get(i).unwrap()
            result = result + e
            i = i + 1
    result = result + ":"
    int i = 0
    while i < td.methods.len():
        FunctionDef m = td.methods.get(i).unwrap()
        result = result + " " + format_function(m) + ";"
        i = i + 1
    return result

String format_equip(EquipBlock eq):
    String result = "equip " + format_type(eq.target)
    match eq.trait_name:
        case Some(tn):
            result = result + " via " + tn
        else:
            pass
    result = result + ":"
    int i = 0
    while i < eq.methods.len():
        FunctionDef m = eq.methods.get(i).unwrap()
        result = result + " " + format_function(m) + ";"
        i = i + 1
    return result

String format_import(ImportStmt imp):
    if imp.names.len() > 0:
        String result = "from " + imp.module_path + " import "
        int i = 0
        while i < imp.names.len():
            if i > 0:
                result = result + ", "
            String n = imp.names.get(i).unwrap()
            result = result + n
            i = i + 1
        return result
    return "import " + imp.module_path

# ── Module formatting ────────────────────────────────────────

String format_module(Module m):
    String result = ""
    int i = 0
    while i < m.items.len():
        if i > 0:
            result = result + "\n"
        Item item = m.items.get(i).unwrap()
        result = result + format_item(item)
        i = i + 1
    return result
