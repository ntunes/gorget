# CoW view-materialization on the STATIC TRAIT METHOD body-lowering path.
#
# AXIS CELL — path = `lower_static_trait_method` (src/ir/lowering/traits.rs).
# One of eleven function-body-lowering paths, and the one the fix's original
# path enumeration listed as provably unprescanned but UNWITNESSED — no program
# made it observable. This is that witness. A static trait method (no `self`)
# used to lower with an EMPTY `cow_reassigned_after`, so the element view stayed
# a lazy borrow and the 64 pushes reallocated it away.
#
# THE REALLOC IS LOAD-BEARING (64 pushes), and the payload is heap-FORCED via
# `mk` so ASan reports a legible heap-use-after-free, not a bare SIGSEGV.
#
# RED-VERIFIED against the pre-fix compiler: rc 139 SIGSEGV on C AND LLVM.
String mk(String a, String b):
    return a + b

trait Maker:
    String make()

struct Cell:
    int n

equip Cell with Maker:
    String make():
        Vector[String] v = [mk("hello", "world")]
        String s = v.get(0).unwrap()
        int i = 0
        while i < 64:
            v.push(mk("xxxxxxxxxxxxxxxx", "yyyyyyyyyyyyyyyy"))
            i = i + 1
        return s

void main():
    print(Cell.make())
