struct Collector:
    Vector[int] items

equip Collector:
    int total(self):
        int sum = 0
        int i = 0
        while i < self.items.len():
            sum = sum + self.items.get(i).unwrap()
            i = i + 1
        return sum

void main():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(20)
    v.push(30)
    Collector c = Collector(v)
    int t = c.total()
    print(t)
