# Negative test: outlives violation — group a's source moved while group b's source is alive.

String pick_first(live(a) String x, live(b) String y) where a outlives b:
    return x

void main():
    String s1 = "hello" + ""
    String s2 = "world" + ""
    String r = pick_first(s1.as_str(), s2.as_str())
    String moved = !s1
    print(s2)
