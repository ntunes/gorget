#!parity-excluded allocator: prints a mem_live() delta against a baseline — live-heap bytes differ per lane
from std.os import mem_live
from std.collections import Vector, Dict, Set

# Stress test: mixed allocation patterns.
# Combines strings, vectors, dicts, sets, nested types, function returns,
# reassignment, option/result wrapping — all in tight loops.

struct Record:
    String name
    Dict[String, int] fields

Record make_record(int id):
    Dict[String, int] d = Dict[String, int]()
    d["score"] = id * 10
    d["rank"] = id
    return Record(f"record-{id}", d)

Option[Vector[int]] maybe_data(int n):
    if n > 0:
        Vector[int] v = Vector[int]()
        int i = 0
        while i < n:
            v.push(i)
            i = i + 1
        return Some(v)
    return None()

void main():
    int baseline = mem_live()

    # --- Section 1: Struct with Dict field, create/drop loop ---
    int i = 0
    while i < 300:
        Record r = make_record(i)
        i = i + 1

    # --- Section 2: Option[Vector[int]] — Some and None paths ---
    i = 0
    while i < 500:
        Option[Vector[int]] opt = maybe_data(i % 2 * 10)
        i = i + 1

    # --- Section 3: Set[int] create/add/drop ---
    i = 0
    while i < 500:
        Set[int] s = Set[int]()
        int j = 0
        while j < 50:
            s.add(j)
            j = j + 1
        i = i + 1

    # --- Section 4: Set[String] with owned string elements ---
    i = 0
    while i < 200:
        Set[String] s = Set[String]()
        int j = 0
        while j < 20:
            s.add(f"tag-{j}")
            j = j + 1
        i = i + 1

    # --- Section 5: Vector reassignment in loop (old dropped) ---
    Vector[int] v = Vector[int]()
    v.push(0)
    i = 0
    while i < 500:
        Vector[int] new_v = Vector[int]()
        int j = 0
        while j < 20:
            new_v.push(j + i)
            j = j + 1
        v = !new_v
        i = i + 1

    # --- Section 6: Dict reassignment in loop ---
    Dict[String, int] d = Dict[String, int]()
    d["init"] = 0
    i = 0
    while i < 500:
        Dict[String, int] new_d = Dict[String, int]()
        new_d[f"key-{i}"] = i
        d = !new_d
        i = i + 1

    # --- Section 7: Mixed types in one scope ---
    i = 0
    while i < 200:
        String name = f"user-{i}"
        Vector[int] scores = Vector[int]()
        scores.push(90)
        scores.push(85)
        Dict[String, int] attrs = Dict[String, int]()
        attrs["age"] = 20 + i
        Set[int] tags = Set[int]()
        tags.add(i)
        tags.add(i + 1)
        i = i + 1

    # --- Section 8: Deeply nested — Vector[Dict[String, Vector[int]]] ---
    i = 0
    while i < 50:
        Vector[Dict[String, Vector[int]]] data = Vector[Dict[String, Vector[int]]]()
        int j = 0
        while j < 5:
            Dict[String, Vector[int]] entry = Dict[String, Vector[int]]()
            Vector[int] vals = Vector[int]()
            vals.push(j)
            vals.push(j + 1)
            entry[f"k{j}"] = !vals
            data.push(entry)
            j = j + 1
        i = i + 1

    int leaked = mem_live() - baseline
    print(f"leaked={leaked > 0}")
    print("done")
