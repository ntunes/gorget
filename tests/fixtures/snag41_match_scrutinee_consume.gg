enum V:
    StringV(String)

enum C:
    Normal(V)
    ThrowC(V)

V make_v() throws String:
    return V.StringV("x")

C make() throws String:
    Result[V, String] __d29_r3 = make_v()
    V v = match __d29_r3:
        case Ok(x):
            x
        case Error(e):
            throw e
    return C.Normal(v)

bool to_b(V v):
    match v:
        case V.StringV(s):
            return s.len() > 0

C e_if() throws String:
    Result[C, String] __d29_r2 = make()
    C cc = match __d29_r2:
        case Ok(x):
            !x
        case Error(e):
            throw e
    V cv = match cc:
        case C.Normal(v):
            !v
        else:
            return !cc
    if to_b(cv):
        return C.Normal(V.StringV("then"))
    return C.Normal(V.StringV("end"))

void main():
    Result[C, String] __d29_r1 = e_if()
    match __d29_r1:
        case Ok(_):
            print("ok")
        case Error(_):
            print("err")
