from gg.json import Json, json_parse, json_stringify, json_pretty
from std.collections import Vector, Dict

void main():
    # Build an object using Dict (avoids string interpolation issues with JSON braces)
    Dict[String, Json] obj_dict = Dict[String, Json]()
    obj_dict.put("name", Str("Alice"))
    obj_dict.put("age", Int(30))
    obj_dict.put("active", Bool(true))
    Json parsed_obj = Obj(obj_dict)
    String name_val = parsed_obj.get("name").as_str()
    int age_val = parsed_obj.get("age").as_int()
    bool active_val = parsed_obj.get("active").as_bool()
    print(name_val)
    print(f"{age_val}")
    print(f"{active_val}")
    # Type checks
    bool is_obj = parsed_obj.is_object()
    bool is_arr_check = parsed_obj.is_array()
    print(f"{is_obj}")
    print(f"{is_arr_check}")
    # Parse an array (no braces, no interpolation issue)
    Json parsed_arr = json_parse("[10, 20, 30]").unwrap()
    int first_elem = parsed_arr.at(0).as_int()
    int second_elem = parsed_arr.at(1).as_int()
    int third_elem = parsed_arr.at(2).as_int()
    int arr_length = parsed_arr.len()
    bool arr_is_arr = parsed_arr.is_array()
    print(f"{first_elem}")
    print(f"{second_elem}")
    print(f"{third_elem}")
    print(f"{arr_length}")
    print(f"{arr_is_arr}")
    # Stringify
    auto json_str = json_stringify(parsed_arr)
    print(json_str)
    # Null/missing access returns defaults
    Json missing_val = parsed_obj.get("nonexistent")
    bool is_null_val = missing_val.is_null()
    int zero_val = missing_val.as_int()
    print(f"{is_null_val}")
    print(f"{zero_val}")
    # has() distinguishes missing keys from null values
    Dict[String, Json] null_dict = Dict[String, Json]()
    null_dict.put("present", Null())
    Json null_obj = Obj(null_dict)
    bool has_present = null_obj.has("present")
    bool has_missing = null_obj.has("missing")
    print(f"{has_present}")
    print(f"{has_missing}")
    # has_index() for arrays
    bool has_idx0 = parsed_arr.has_index(0)
    bool has_idx3 = parsed_arr.has_index(3)
    bool has_neg = parsed_arr.has_index(-1)
    print(f"{has_idx0}")
    print(f"{has_idx3}")
    print(f"{has_neg}")
    # has/has_index on wrong types return false
    bool has_on_str = Int(5).has("key")
    bool has_idx_on_obj = parsed_obj.has_index(0)
    print(f"{has_on_str}")
    print(f"{has_idx_on_obj}")
    # Parse error
    Result[Json, String] bad_result = json_parse("not json")
    bool is_err_val = bad_result.is_error()
    print(f"{is_err_val}")
    # Unicode escapes
    String json_uni = "[\"\\u0041\", \"\\u0048\\u0069\", \"\\u0041bc\"]"
    Json parsed_uni = json_parse(json_uni).unwrap()
    print(parsed_uni.at(0).as_str())
    print(parsed_uni.at(1).as_str())
    print(parsed_uni.at(2).as_str())
    print("done")
