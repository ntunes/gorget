from std.json import Json, json_parse, json_stringify, json_pretty
from std.collections import Vector, Dict

void main():
    # Build an object using Dict (avoids string interpolation issues with JSON braces)
    Dict[str, Json] obj_dict = Dict[str, Json]()
    obj_dict.put("name", Str("Alice"))
    obj_dict.put("age", Int(30))
    obj_dict.put("active", Bool(true))
    Json parsed_obj = Obj(obj_dict)
    str name_val = parsed_obj.get("name").as_str()
    int age_val = parsed_obj.get("age").as_int()
    bool active_val = parsed_obj.get("active").as_bool()
    print(name_val)
    print("{age_val}")
    print("{active_val}")
    # Type checks
    bool is_obj = parsed_obj.is_object()
    bool is_arr_check = parsed_obj.is_array()
    print("{is_obj}")
    print("{is_arr_check}")
    # Parse an array (no braces, no interpolation issue)
    Json parsed_arr = json_parse("[10, 20, 30]").unwrap()
    int first_elem = parsed_arr.at(0).as_int()
    int second_elem = parsed_arr.at(1).as_int()
    int third_elem = parsed_arr.at(2).as_int()
    int arr_length = parsed_arr.len()
    bool arr_is_arr = parsed_arr.is_array()
    print("{first_elem}")
    print("{second_elem}")
    print("{third_elem}")
    print("{arr_length}")
    print("{arr_is_arr}")
    # Stringify
    str json_str = json_stringify(parsed_arr)
    print(json_str)
    # Null/missing access returns defaults
    Json missing_val = parsed_obj.get("nonexistent")
    bool is_null_val = missing_val.is_null()
    int zero_val = missing_val.as_int()
    print("{is_null_val}")
    print("{zero_val}")
    # Parse error
    Result[Json, str] bad_result = json_parse("not json")
    bool is_err_val = bad_result.is_err()
    print("{is_err_val}")
    print("done")
