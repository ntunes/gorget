from std.json import JsonValue, json_parse, json_stringify
from std.json import json_object, json_array, json_string, json_number, json_float, json_bool, json_null

void main():
    # Build and stringify an object, then parse it back
    JsonValue src = json_object()
    src.set("name", json_string("Alice"))
    src.set("age", json_number(30))
    src.set("active", json_bool(true))
    str json_text = json_stringify(src).unwrap()
    JsonValue obj = json_parse(json_text).unwrap()
    str name = obj.get("name").as_string()
    int age = obj.get("age").as_int()
    bool active = obj.get("active").as_bool()
    print(name)
    print("{age}")
    print("{active}")
    # Type checks
    bool is_obj = obj.is_object()
    bool is_arr_check = obj.is_array()
    print("{is_obj}")
    print("{is_arr_check}")
    # Parse an array
    JsonValue arr = json_parse("[10, 20, 30]").unwrap()
    int first = arr.at(0).as_int()
    int second = arr.at(1).as_int()
    int third = arr.at(2).as_int()
    int length = arr.len()
    bool arr_is_arr = arr.is_array()
    print("{first}")
    print("{second}")
    print("{third}")
    print("{length}")
    print("{arr_is_arr}")
    # Build JSON
    JsonValue o = json_object()
    o.set("greeting", json_string("hello"))
    o.set("count", json_number(42))
    o.set("flag", json_bool(false))
    str s = json_stringify(o).unwrap()
    print(s)
    # Null/missing access returns defaults
    JsonValue missing = obj.get("nonexistent")
    bool is_null = missing.is_null()
    int zero = missing.as_int()
    print("{is_null}")
    print("{zero}")
    # Parse error
    Result[JsonValue, str] bad = json_parse("not json")
    bool is_err = bad.is_err()
    print("{is_err}")
    print("done")
