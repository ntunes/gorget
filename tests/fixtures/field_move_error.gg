# NEG — owner 2026-09-02: no partial moves. `consume(^p.first)` is
# E_PartialMove at the `^` (not a subsequent use-after-move). Axis cell:
# root=named-local × projection=field × position=free-fn call-arg.

struct Pair:
    Vector[int] first
    Vector[int] second

void consume(Vector[int] !v):
    print(v.len())

void main():
    Pair p = Pair(first=[1,2,3], second=[4,5,6])
    consume(!p.first)
    print(p.second.len())
