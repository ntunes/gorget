# Round XXIX Track B POS pin (fold: Round XXIX close chip) — Dict.has_key /
# .contains_key are now first-class protocol entries in DICT.methods at
# src/ir/lowering/builtins.rs (mirroring the existing .has / .contains
# aliases of gorget_map_contains). The pre-existing runtime "0" bug was
# closed by adding the missing protocol entries — resolve_builtin_method_
# return_type was returning None on aliases → UNIT_TYPE → call_void → C
# emit dropped the return. Aliases now type + return correctly on both
# backends.

void main():
    Dict[String, int] m = {"a": 1, "b": 2}
    print(m.has("a"))           # true
    print(m.has_key("a"))       # true (was "0" pre-fix)
    print(m.contains("b"))      # true
    print(m.contains_key("b"))  # true (was "0" pre-fix)
