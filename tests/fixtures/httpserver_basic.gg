#!parity-excluded network: runs a real HTTP server over a bound TCP socket with a concurrent client; connection timing
#!  decides the output
from xtd.httpserver import HttpServerResponse, HttpRequest
from xtd.httpserver import http_server_parse_request, http_server_write_response
from std.net.socket import ServerSocket, Socket, server_socket_bind, socket_connect
from std.signal import signal_ignore, SIGPIPE
from std.time import sleep

HttpServerResponse handle(HttpRequest req):
    if req.path == "/hello":
        return HttpServerResponse.ok("world")
    return HttpServerResponse.not_found()

async void serve_once(ServerSocket !srv):
    Socket client = srv.accept().unwrap()
    srv.close()
    Result[HttpRequest, String] r = http_server_parse_request(&client)
    match r:
        case Ok(req):
            http_server_write_response(&client, handle(req))
        case Error(e):
            http_server_write_response(&client, HttpServerResponse.bad_request(e))
    client.close()

async void main():
    signal_ignore(SIGPIPE)
    ServerSocket srv = server_socket_bind("127.0.0.1", 0).unwrap()
    int port = srv.local_port()
    Task[void] t = spawn serve_once(!srv)
    sleep(0.5).await()

    Socket c = socket_connect("127.0.0.1", port).unwrap()
    c.write_str("GET /hello HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
    String status_line = c.read_line().unwrap()
    c.close()

    t.await()

    print(status_line.starts_with("HTTP/1.1 200"))
    print("done")
