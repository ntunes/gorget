# POSITIVE control for the CLASS check in scripts/sanitize_sweep.sh, and the
# one that makes the check falsifiable on its own class.
#
# Two deliberate allocations at two distinct sites leak TWO records of the SAME
# class as selftest_leak.gg's one. The self-test allowlists this fixture for
# ONE record of exactly that class and requires the gate to fail on the second.
# A signature-SET scheme cannot fire on that — the class is already tolerated —
# which is why the rows carry per-class COUNTS.
#
# ⭐ Two distinct CALL SITES, not a loop: LeakSanitizer groups records by
# allocation stack, so two calls on one line would merge into a single record
# of two objects and the `*2` this control exists to produce would read `*1`.
extern int leak_one_block(int n) = "malloc"

int main():
    int p = leak_one_block(32)
    int q = leak_one_block(32)
    if p == 0 or q == 0:
        print(0)
    else:
        print(2)
    return 0
