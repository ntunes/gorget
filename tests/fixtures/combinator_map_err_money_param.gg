# CELL: `.map_err()` x bare-param recv x Result[int, Money]
# COMMITTED Round XIV (74f566c6+) — receiver-readback regression pin.
# PRE-FIX (RED-verified at HEAD 6171d564 with methods.rs reverted): prints
#   `10\n0` (want `10\n10`) once the receiver is actually read back —
#   Edit A + Edit B territory. See combinator_map_err_money_local.gg header
#   for the finding that scout probes appeared to make map_err "the only
#   green combinator" only because they did not sample this axis.
# TODO: delete this file when the class-retirement guard (Core #6 follow-up)
# lands — the guard subsumes this axis cell. See TODO.md §Guards.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Result[int, Money] make_err(int n):
    return Error(Money(heap_cents(n)))

void call_it(Result[int, Money] p):
    Result[int, int] r2 = p.map_err((Money e): size_of(e))
    if r2 is Error(e):
        print(e)
    if p is Error(e2):
        print(size_of(e2))

void main():
    call_it(make_err(10))
