from std.collections import Vector

void main():
    Vector[int] v = Vector[int]()
    v.push(1)
    v.push(2)
    v.push(3)
    print(v.len())
    print(v[0])
    v.push(4)
    print(v.len())
    print(v[3])
    # v still usable after all mutations
    int sum = 0
    for x in v:
        sum = sum + x
    print(sum)
