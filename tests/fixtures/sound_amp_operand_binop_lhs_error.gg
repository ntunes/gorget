# Round XXIII Track β — `&`-of-a-place on the LHS of a binary op.
# One costume of the operand-position class; retired by the ONE-PRODUCER
# chokepoint at the `check_expr::Expr::MutableBorrow` arm.
#
# Pre-fix (measured at HEAD): `gg check` clean; C build FAILS with `invalid
# operands to binary + (void */void *)` — the LUCKY spelling in the
# operand-order axis (the RHS mirror silently miscompiles, see
# `sound_amp_operand_binop_rhs_error.gg`). LLVM `llc` fails first.
# INTENDED: reject uniformly at `gg check` regardless of operand order.
# The chokepoint reject removes the whole axis.

struct Counter:
    int fd

int seed():
    return 10

void main():
    Counter c = Counter(seed())
    int y = &c.fd + 1
    print(y)
