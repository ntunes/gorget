int risky(int x) throws String:
    if x < 0:
        throw "negative"
    return x * 2

int with_cleanup(int x) throws String:
    print("enter")
    on error print("cleanup")
    int val = risky(x)!
    print("success")
    return val

void main():
    int a = with_cleanup(5)! catch (e): -1
    print(f"{a}")

    int b = with_cleanup(-1)! catch (e): -1
    print(f"{b}")

    print("done")
