# Cycle-breaking proof (shape A — interior-mutability cycle).
#
# POSITIVE CASE: same topology as the negative control, but b's back-edge
# is a `Weak[Node]` instead of a `Shared[Node]`. The weak edge doesn't
# bump the strong count, so when scope exits, a's refcount drops to 0,
# drops a's cell which drops a's Some(b), b's strong count drops to 0,
# both control blocks freed. No leak.
#
# Status: BLOCKED on missing `Cell[T]` runtime type. `Cell` is documented
# in docs/book/16-smart-pointers.md but not implemented; the resolver
# rejects it. See TODO.md "Weak[T] cycle-breaking — missing primitives".
#
# When the primitive lands, this fixture must produce:
#     leaked=false
#     done
# That is the cycle-breaking proof: swapping one Shared edge for Weak
# turns the leak (negative control) into clean termination.

from std.os import mem_live

struct Node:
    int id
    Cell[Option[Shared[Node]]] next_strong
    Cell[Option[Weak[Node]]] next_weak

void main():
    int baseline = mem_live()
    int i = 0
    while i < 100:
        Shared[Node] a = Shared[Node](Node(1, Cell[Option[Shared[Node]]](None), Cell[Option[Weak[Node]]](None)))
        Shared[Node] b = Shared[Node](Node(2, Cell[Option[Shared[Node]]](None), Cell[Option[Weak[Node]]](None)))
        # a -> b is strong (a.next_strong = Some(Shared[Node] of b))
        a.next_strong.set(Some(b.clone()))
        # b -> a is WEAK (b.next_weak = Some(Weak[Node] of a))
        b.next_weak.set(Some(a.downgrade()))
        # At scope exit: only a's outer ref holds b strong, so b drops first;
        # then a's outer ref drops, a's strong count is 1 -> 0, drop a's
        # cell. The weak b had to a is dangling but harmless. No leak.
        i = i + 1
    int delta = mem_live() - baseline
    print(f"leaked={delta > 0}")
    print("done")
