void main():
    Result[int, String] ok = Ok(10)
    Result[int, String] err = Error("fail")
    print(f"{ok.unwrap()}")
    print(f"{ok.unwrap_or(0)}")
    print(f"{err.unwrap_or(99)}")
    if ok.is_ok():
        print("ok is ok")
    if err.is_error():
        print("err is err")
    if err.is_error():
        print("err is error")
    if not ok.is_error():
        print("ok is not error")
