from std.collections import Dict

void main():
    Dict[String, int] d = Dict[String, int]()
    d["x"] = 1
    d["y"] = 2
    d["z"] = 3
    print(d.len())
    print(d["x"])

    # Overwrite
    d["x"] = 10
    print(d["x"])
    print(d.len())

    # Get with Option
    print(d.get("y").unwrap())
    print(d.get("w").is_none())
