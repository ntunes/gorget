# CELL: successive combinator calls (`.map(); .filter()`) on the SAME
#       receiver x bare-param recv x Option[Money] — receiver-preservation
#       across producer calls.
# COMMITTED Round XIV (74f566c6+) — combinator-receiver ownership class-fix.
# Each combinator call in this fixture uses `p` as the receiver: if the
# first call consumes p, the second call sees an empty Money and its own
# read shows a zero. Tests that bare-param (Ptr-unwrap Edit A) receivers
# survive sequential producer calls (Core #12 axis: multi-call sequence
# on the Ptr(T) receiver-shape). Bare-param recv chosen deliberately —
# plain-local shape works even pre-fix and would not RED-verify a chain.
# PRE-FIX (RED-verified at HEAD 6171d564 with methods.rs reverted): exits
#   139 (SIGSEGV) — first `p.map(...)` succeeds and prints `42`, but by
#   then the receiver's storage has been aliased and the SECOND call
#   (`p.filter(...)`) crashes when the adapter re-enters through the same
#   corrupted Ptr. Worse than a wrong-output because the receiver is
#   destructively read TWICE in sequence.
# POST-FIX: prints `42\n10\n10\nchain-end`.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[int] mapped = p.map((Money m): size_of(m) + 32)
    if mapped is Some(v):
        print(v)
    Option[Money] filtered = p.filter((Money m): size_of(m) > 0)
    if filtered is Some(m):
        print(size_of(m))
    if p is Some(m2):
        print(size_of(m2))
    print("chain-end")

void main():
    call_it(make_opt(10))
