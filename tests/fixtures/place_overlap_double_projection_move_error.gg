# D10(b) x E_PartialMove: `f(!n, !n.field)` — a whole-place move and a
# field-move of the same root. The field `^` is E_PartialMove (owner
# 2026-09-02: no partial moves). D10(b) keeps (Move, Move) OUT of the
# place-overlap check; this fixture guards that the interaction still rejects.
struct N:
    Vector[int] field
    int m

void f(N !whole, Vector[int] !part):
    pass

void main():
    N n = N([1, 2], 0)
    f(!n, !n.field)
