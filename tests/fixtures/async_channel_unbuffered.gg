from std.channel import Channel

async void producer(Channel[int] ch):
    ch.send(10)
    ch.send(20)
    ch.send(30)

async void main():
    Channel[int] ch = Channel[int](0)
    Task[void] t = spawn producer(ch)
    int a = ch.recv()
    int b = ch.recv()
    int c = ch.recv()
    t.await()
    ch.close()
    print(a)
    print(b)
    print(c)
