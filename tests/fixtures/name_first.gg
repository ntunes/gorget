directive name-first
from std.collections import Vector

struct Point:
    x: int
    y: int

fn add(a: int, b: int) -> int:
    return a + b

fn double(x: int) -> int = x * 2

fn main():
    result: int = add(3, 4)
    print("{result}")
    d: int = double(5)
    print("{d}")
    const PI: float = 3.14
    print("3")
    v: auto = "gorget"
    print("{v}")
    mutable count: int = 0
    count = count + 1
    print("{count}")
    print("done")
