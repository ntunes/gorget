from std.async import async_sleep
from std.fs import read_file, write_file

# This function has BOTH an await (sleep) and a blocking call (read_file).
# The sleep makes it a coroutine; the read_file gets enter/exit guards.
async String read_after_sleep(String path, int delay_ms):
    async_sleep(delay_ms)
    String content = read_file(path)
    return content

async void main():
    write_file("/tmp/gorget_bc_test.txt", "coroutine+blocking")

    Task[String] t = spawn read_after_sleep("/tmp/gorget_bc_test.txt", 20)
    String result = t.await()
    print(result)
