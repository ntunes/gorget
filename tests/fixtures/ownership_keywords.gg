struct Point:
    int x
    int y

void consume(String move s):
    print(f"{s}")

void borrow_it(String mutable s):
    print(f"{s}")

void look(int x):
    print(f"{x}")

void main():
    # Primitives are Copy — no move needed
    int a = 42
    int b = a
    print(f"{a}")
    print(f"{b}")

    # Structs use move semantics with `move` keyword
    Point p = Point(1, 2)
    Point q = move p
    print(f"{q.x}")
    print(f"{q.y}")

    # Move ownership with keyword
    String s1 = "moved"
    consume(move s1)

    # Mutable borrow with keyword
    String s2 = "borrowed"
    borrow_it(mutable s2)

    # Bare borrow of copy type
    int n = 99
    look(n)

    print("done")
