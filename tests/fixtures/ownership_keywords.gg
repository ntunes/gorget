struct Point:
    int x
    int y

void consume(String consuming s):
    print("{s}")

void borrow_it(String mutable s):
    print("{s}")

void look(int x):
    print("{x}")

void main():
    # Primitives are Copy — no move needed
    int a = 42
    int b = a
    print("{a}")
    print("{b}")

    # Structs use move semantics with `consuming` keyword
    Point p = Point(1, 2)
    Point q = consuming p
    print("{q.x}")
    print("{q.y}")

    # Move ownership with keyword
    String s1 = "moved"
    consume(consuming s1)

    # Mutable borrow with keyword
    String s2 = "borrowed"
    borrow_it(mutable s2)

    # Bare borrow of copy type
    int n = 99
    look(n)

    print("done")
