from std.http.client import get, post, Response
from std.json import JsonValue, json_parse, json_stringify, json_object, json_string
from std.collections import Dict

void main():
    # GET with custom headers
    Dict[str, str] hdrs = Dict[str, str]()
    hdrs.put("X-Custom-Header", "gorget-test")
    hdrs.put("Accept", "application/json")
    Result[Response, str] result = get("https://httpbin.org/get", headers=hdrs)
    if result.is_ok():
        Response resp = result.unwrap()
        int status = resp.status()
        print("{status}")
        # httpbin echoes headers back in the JSON response
        Result[JsonValue, str] json_result = resp.json()
        if json_result.is_ok():
            JsonValue data = json_result.unwrap()
            JsonValue headers_obj = data.get("headers")
            str custom = headers_obj.get("X-Custom-Header").as_string()
            print(custom)
        else:
            print("json parse failed")
    else:
        print("request failed")

    # POST with body and headers
    Dict[str, str] post_hdrs = Dict[str, str]()
    post_hdrs.put("Content-Type", "application/json")
    str body = json_stringify(json_object()).unwrap()
    Result[Response, str] post_result = post("https://httpbin.org/post", body=body, headers=post_hdrs)
    if post_result.is_ok():
        Response post_resp = post_result.unwrap()
        int post_status = post_resp.status()
        print("{post_status}")
    else:
        print("post failed")

    print("done")
