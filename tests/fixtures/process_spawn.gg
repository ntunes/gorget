#!parity-excluded host: spawns an external `echo` binary via std.process and reads getpid(); needs that binary on the
#!  host
from std.process import process_spawn, getpid

void main():
    Vector[String] args = Vector[String]()
    args.push("hello")
    args.push("world")
    Result[Process, String] r = process_spawn("echo", args)
    match r:
        case Ok(proc):
            String out = proc.read_stdout()
            int code = proc.wait()
            print(out)
            print(f"{code}")
        case Error(msg):
            print(f"spawn failed: {msg}")
    int mypid = getpid()
    print(f"{mypid > 0}")
