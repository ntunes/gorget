from std.http.client import get, post, Response, Client

from std.json import JsonValue, json_parse

void main():
    # Simple GET request
    Result[Response, str] result = get("https://httpbin.org/get")
    if result.is_ok():
        Response resp = result.unwrap()
        int status = resp.status()
        print("{status}")
        # Parse JSON response
        Result[JsonValue, str] json_result = resp.json()
        if json_result.is_ok():
            JsonValue data = json_result.unwrap()
            str url = data.get("url").as_string()
            print(url)
        else:
            print("json parse failed")
    else:
        print("request failed")
    print("done")
