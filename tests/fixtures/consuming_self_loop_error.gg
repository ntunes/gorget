# ERROR: !self method call on named var inside loop

struct Config:
    int width
    String title

equip Config:
    Config with_width(!self, int w):
        return Config(w, self.title)

void main():
    Config c = Config(800, "game")
    int i = 0
    while i < 3:
        Config c2 = c.with_width(i)
        print(c2.width)
        i = i + 1
