from std.collections import Dict, Vector

void main():
    Dict[str, int] ages = Dict[str, int]()
    ages.put("alice", 30)
    ages.put("bob", 25)
    ages.put("carol", 35)

    # keys — insertion order preserved
    Vector[str] ks = ages.keys()
    int i = 0
    while i < ks.len():
        str k = ks.get(i).unwrap()
        print(k)
        i = i + 1

    # values — insertion order preserved
    Vector[int] vs = ages.values()
    print(f"{vs.get(0).unwrap()}")
    print(f"{vs.get(1).unwrap()}")
    print(f"{vs.get(2).unwrap()}")

    # fold
    int total = ages.fold(0, (int acc, str k, int v): acc + v)
    print(f"{total}")
    print(f"{ks.len()}")
