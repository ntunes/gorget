# Cross-frame MIXED-category callee, caught by `catch Fault.Bounds:` ONLY
# (error-model.md §11, Increment 2.1d — the uncaught-category re-panic guard).
# `mixed` can raise BOTH a Bounds (`xs[i]`) and an Overflow (`a * b`); the call
# site catches Bounds ONLY. The first call's OOB is CAUGHT (777); the second
# call OVERFLOWS, a category this scope does NOT catch → the caller re-dispatches
# to the always-Some panic block → "integer overflow", exit 1 (NOT swallowed).
int mixed(Vector[int] xs, int i, int a, int b): xs[i] + a * b

void main():
    Vector[int] xs = [10, 20, 30]
    int caught = mixed(xs, 99, 2, 3) catch Fault.Bounds: 777    # OOB caught → 777
    print(f"{caught}")
    int big = 4611686018427387904                              # 2^62; big*big overflows
    int r = mixed(xs, 1, big, big) catch Fault.Bounds: 777     # overflow NOT caught → re-panic
    print(f"{r}")                                              # never reached
