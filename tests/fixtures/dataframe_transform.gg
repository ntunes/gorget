from gg.dataframe import DataFrame, Column, col_from_ints, col_from_strs, col_from_floats, df_from_columns

void main():
    Vector[int] ages = Vector[int]()
    ages.push(30)
    ages.push(20)
    ages.push(25)

    Vector[str] names = Vector[str]()
    names.push("Bob")
    names.push("Alice")
    names.push("Charlie")

    Vector[str] col_names = Vector[str]()
    col_names.push("name")
    col_names.push("age")

    Vector[Column] cols = Vector[Column]()
    cols.push(col_from_strs(names))
    cols.push(col_from_ints(ages))

    DataFrame df = df_from_columns(col_names, cols)

    # sort_by ascending
    str age_col = "age"
    str name_col = "name"
    DataFrame sorted = df.sort_by(age_col, true)
    Column sc = sorted.get_column(age_col)
    print(f"{sc.value_as_str(0)}")
    print(f"{sc.value_as_str(1)}")
    print(f"{sc.value_as_str(2)}")

    # sort_by descending
    DataFrame sorted_desc = df.sort_by(age_col, false)
    Column sc2 = sorted_desc.get_column(age_col)
    print(f"{sc2.value_as_str(0)}")

    # add_column
    Vector[float] scores = Vector[float]()
    scores.push(8.5)
    scores.push(9.0)
    scores.push(7.5)
    str score_col = "score"
    DataFrame df2 = df.add_column(score_col, col_from_floats(scores))
    print(f"{df2.ncols()}")

    # apply_int: double the ages
    int(int) double_fn = (int x): x * 2
    DataFrame df3 = df.apply_int(age_col, double_fn)
    Column ac = df3.get_column(age_col)
    print(f"{ac.value_as_str(0)}")

    # dropna (no nulls, same size)
    DataFrame df4 = df.dropna()
    print(f"{df4.nrows()}")
