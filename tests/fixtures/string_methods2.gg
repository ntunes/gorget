from std.collections import Vector

void main():
    str s = "hello world"

    # substring
    print(s.substring(0, 5))
    print(s.substring(6, 11))

    # char_at
    char c = s.char_at(0)
    print(f"{c}")

    # index_of
    int idx = s.index_of("world").unwrap()
    print(f"{idx}")
    bool not_found = s.index_of("xyz").is_none()
    print(f"{not_found}")

    # count
    str s2 = "abcabcabc"
    print(f"{s2.count("abc")}")
    print(f"{s2.count("x")}")

    # repeat
    print("ha".repeat(3))
    print("!".repeat(0))

    # join
    Vector[str] parts = Vector[str]()
    parts.push("a")
    parts.push("b")
    parts.push("c")
    print(", ".join(parts))
    print("-".join(parts))
