from std.collections import Vector

void main():
    str s = "Hello, World!"

    # starts_with / ends_with via interpolation
    print(f"{s.starts_with("Hello")}")
    print(f"{s.ends_with("World!")}")
    print(f"{s.starts_with("World")}")

    # is_empty
    str empty = ""
    print(f"{empty.is_empty()}")
    print(f"{s.is_empty()}")

    # contains
    print(f"{s.contains("World")}")

    # trim — print method call result directly
    str padded = "  hi  "
    print(padded.trim())

    # to_upper / to_lower
    print(s.to_upper())
    print(s.to_lower())

    # replace
    String replaced = s.replace("World", "Gorget")
    print(replaced)

    # split
    str csv = "a,b,c"
    Vector[str] parts = csv.split(",")
    print(f"{parts.len()}")
