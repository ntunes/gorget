#
# INTENDED: `error[E_NotIndexable]` here too. Graduate when the interp walker
# is gated. A no-new-holes guard (an arm/site count over the positions that
# must consult the Index gate) is what retires the class.
struct Pair:
    int a
    int b

int main():
    Pair p = Pair(11, 22)
    print(f"{p[0]} {p[1]} {p[5]}")
    return 0
