from std.fs import read_file, write_file

# Spawned coroutine that reads a file (blocking I/O → offloaded to blocking pool).
async String do_read(String path):
    String content = read_file(path)
    return content

async void main():
    write_file("/tmp/gorget_blocking_test.txt", "hello from blocking io")

    Task[String] t = spawn do_read("/tmp/gorget_blocking_test.txt")
    String result = t.await()
    print(result)
