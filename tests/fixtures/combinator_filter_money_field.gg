# CELL: `.filter()` x field-access recv (`h.slot.filter(...)`) x Option[Money]
# COMMITTED Round XIV (74f566c6+) — combinator-receiver ownership class-fix.
# PRE-FIX (RED-verified at HEAD 6171d564): print 0 (want 11). Field-access
#   PLACE had non-empty projections, so the pre-fix `p.projections.is_empty()`
#   gate excluded it from the clone path and it fell through to plain Copy —
#   a shallow alias that enum_field_load_move destroyed on read. Edit B
#   (uniform materialization) covers this cell.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

struct Holder:
    Option[Money] slot

void main():
    Holder h = Holder(make_opt(11))
    Option[Money] r = h.slot.filter((Money m): size_of(m) > 0)
    if r is Some(m):
        print(size_of(m))
