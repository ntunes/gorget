# Tests for f-string (Format string) opt-in interpolation.
#
# Key behaviours:
#   - Plain "..."  strings: { is a literal character, no interpolation
#   - f"..." strings: {expr} interpolates (produces String / GorgetString)
#   - r"..." strings: raw, no escapes, no interpolation (unchanged)
#   - Single-quoted 'hello' strings: literal str, no interpolation
#   - f'hello {x}' single-quoted format strings: interpolate
#
# Expected output:
#   {name}
#   Hello, Alice!
#   \n stays
#   hello world
#   Hi, Bob!

void main():
    str name = "Alice"

    # Plain string: { is literal, no interpolation
    print("{name}")

    # f-string: interpolation ON
    print(f"Hello, {name}!")

    # Raw string: no escape processing (unchanged behaviour)
    print(r"\n stays")

    # Single-quoted string: raw str, no interpolation
    print('hello world')

    # Single-quoted f-string: interpolation ON
    str who = "Bob"
    print(f'Hi, {who}!')
