# Comprehensive string method tests: edge cases, roundtrips, comparisons
from std.collections import Vector

void main():
    # === Split / Join roundtrip ===
    String csv = "one,two,three"
    Vector[String] parts = csv.split(",")
    print(f"{parts.len()}")
    String rejoined = ",".join(parts)
    print(rejoined)

    # Split on multi-char delimiter
    String spaced = "a--b--c"
    Vector[String] sp2 = spaced.split("--")
    print(f"{sp2.len()}")
    String rej2 = "--".join(sp2)
    print(rej2)

    # Split single element (no delimiter present)
    String nosep = "hello"
    Vector[String] sp3 = nosep.split(",")
    print(f"{sp3.len()}")
    print(sp3.get(0).unwrap())

    # Join with different separator
    String piped = "|".join(parts)
    print(piped)

    # === Replace with multiple occurrences ===
    String rep = "abcabcabc"
    String replaced = rep.replace("abc", "x")
    print(replaced)

    String dots = "a.b.c.d"
    String nodots = dots.replace(".", "-")
    print(nodots)

    # Replace with empty string (deletion)
    String del = "hello world".replace("o", "")
    print(del)

    # Replace where replacement contains search string
    String grow = "aa".replace("a", "ba")
    print(grow)

    # === Repeat ===
    print("abc".repeat(3))
    print("x".repeat(5))
    print("hi".repeat(0))
    print("".repeat(10))

    # === String concatenation ===
    String a = "hello"
    String b = " world"
    String c = a + b
    print(c)

    String d = "" + "nonempty"
    print(d)

    String e = "left" + ""
    print(e)

    # === String comparison ===
    print(f"{"abc" == "abc"}")
    print(f"{"abc" != "def"}")
    print(f"{"abc" != "abc"}")
    print(f"{"abc" < "def"}")
    print(f"{"def" > "abc"}")
    print(f"{"abc" < "abd"}")
    print(f"{"a" < "aa"}")

    # === Empty string edge cases ===
    String empty = ""
    print(f"{empty.len()}")
    print(f"{empty.is_empty()}")
    print(f"{empty.contains("")}")
    print(f"{empty.starts_with("")}")
    print(f"{empty.ends_with("")}")
    print(empty.to_upper())
    print(empty.to_lower())
    print(empty.trim())
    print(f"{empty.count("x")}")

    # Split empty string
    Vector[String] emp_parts = empty.split(",")
    print(f"{emp_parts.len()}")

    # === Substring / slicing ===
    String hw = "hello world"
    String sub1 = hw.substring(0, 5)
    print(sub1)

    String sub2 = hw.substring(6, 11)
    print(sub2)

    # Single character index
    String ch = hw[0]
    print(ch)
    String ch2 = hw[10]
    print(ch2)

    # byte_slice
    String bs = hw.byte_slice(0, 5)
    print(bs)

    # === String interpolation edge cases ===
    int x = 42
    String name = "gorget"
    print(f"{x}")
    print(f"value={x}")
    print(f"hello {name}!")
    print(f"{x + 1}")
    print(f"{name.len()}")

    # Multiple interpolations in one string
    int y = 10
    print(f"{x} and {y}")

    # Interpolation with method call
    print(f"{"hello".to_upper()}")

    # === Escape sequences ===
    String nl = "line1\nline2"
    print(nl)
    String tab = "col1\tcol2"
    print(tab)
    String bs2 = "back\\slash"
    print(bs2)

    # === Multi-word split and rejoin ===
    String sentence = "the quick brown fox"
    Vector[String] words = sentence.split(" ")
    print(f"{words.len()}")

    # Join with different separator
    String hyphen = "-".join(words)
    print(hyphen)

    # === Chained operations ===
    String upper_trimmed = "  hello  ".trim().to_upper()
    print(upper_trimmed)

    String result = "abc def".replace("abc", "xyz").to_upper()
    print(result)

    # === count with multiple occurrences ===
    print(f"{"banana".count("a")}")
    print(f"{"banana".count("na")}")
    print(f"{"banana".count("x")}")

    # === starts_with / ends_with edge cases ===
    print(f"{"hello".starts_with("")}")
    print(f"{"hello".ends_with("")}")
    print(f"{"hello".starts_with("hello")}")
    print(f"{"hello".ends_with("hello")}")
    print(f"{"hi".starts_with("hello")}")
