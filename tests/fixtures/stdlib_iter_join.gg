# Exercise the `.join(sep)` Displayable-bounded terminal on
# `Iterator[T]`. Displaces the legacy `String.join(vec)` pattern;
# the previous `join_iter[Iter, Displayable T]` free function was
# eliminated as a pure alias once the trait default shipped
# (2026-04-27).

from std.collections import Vector

int main():
    # Int iterator — int is Displayable.
    Vector[int] nums = Vector[int]()
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(42)
    String a = nums.iter().join(", ")
    print(a)

    # Single element — no separator emitted.
    Vector[int] one = Vector[int]()
    one.push(7)
    String b = one.iter().join("|")
    print(b)

    # Empty iterator — empty string.
    Vector[int] empty = Vector[int]()
    String c = empty.iter().join("-")
    print(f"[{c}]")

    # String iterator is deferred — VectorIter[String] trips the Ptr-
    # ABI codegen panic (tracked in TODO.md; `for x in v.iter():`
    # hits the same path for any resource-type T). Int works below.

    # Chained with an adapter (take) — exercise composition.
    Vector[int] big = Vector[int]()
    big.push(10)
    big.push(20)
    big.push(30)
    big.push(40)
    big.push(50)
    String e = big.iter().take(3).join("+")
    print(e)

    return 0
