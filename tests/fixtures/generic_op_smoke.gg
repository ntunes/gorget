from std.collections import Vector

struct Wrapper[T]:
    T val

equip Wrapper[int] with Add[Wrapper[int]]:
    Wrapper[int] add(self, Wrapper[int] rhs):
        return Wrapper[int](self.val + rhs.val)

equip Wrapper[int] with Sub[Wrapper[int]]:
    Wrapper[int] sub(self, Wrapper[int] rhs):
        return Wrapper[int](self.val - rhs.val)

equip Wrapper[int] with Mul[Wrapper[int]]:
    Wrapper[int] mul(self, Wrapper[int] rhs):
        return Wrapper[int](self.val * rhs.val)

void main():
    Wrapper[int] a = Wrapper[int](10)
    Wrapper[int] b = Wrapper[int](3)
    Wrapper[int] c = a + b
    print(f"{c.val}")
    Wrapper[int] d = a - b
    print(f"{d.val}")
    Wrapper[int] e = a * b
    print(f"{e.val}")
    a += Wrapper[int](5)
    print(f"{a.val}")
