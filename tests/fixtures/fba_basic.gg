from std.alloc import FixedBufferAllocator
from std.collections import Vector

void main():
    with FixedBufferAllocator(4096) as fba:
        Vector[int] v = Vector[int]()
        v.push(1)
        v.push(2)
        v.push(3)
        assert fba.bytes_used() > 0, "fba should have used bytes"
        print("bytes_used > 0: true")
        print(f"capacity: {fba.capacity()}")
        fba.reset()
        assert fba.bytes_used() == 0, "after reset bytes should be 0"
        print("after reset: 0")
    print("done")
