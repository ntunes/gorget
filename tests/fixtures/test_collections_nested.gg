# Nested collections: structs in collections, basic nesting
from std.collections import Vector, Dict

struct Point:
    int x
    int y

void main():
    # --- Vector of struct ---
    Vector[Point] points = Vector[Point]()
    points.push(Point(1, 2))
    points.push(Point(3, 4))
    print(f"{points.len()}")
    Point p0 = points.get(0).unwrap()
    print(f"{p0.x}")
    print(f"{p0.y}")
    Point p1 = points.get(1).unwrap()
    print(f"{p1.x}")
    print(f"{p1.y}")

    # --- Dict[str, Point] ---
    Dict[str, Point] named_points = Dict[str, Point]()
    named_points.put("origin", Point(0, 0))
    named_points.put("unit", Point(1, 1))
    Point origin = named_points.get("origin").unwrap()
    print(f"{origin.x}")
    print(f"{origin.y}")
    Point unit = named_points.get("unit").unwrap()
    print(f"{unit.x}")
    print(f"{unit.y}")

    # --- Dict[str, int] iteration ---
    Dict[str, int] scores = Dict[str, int]()
    scores.put("a", 10)
    scores.put("b", 20)
    scores.put("c", 30)
    Vector[str] keys = scores.keys()
    print(f"{keys.len()}")
    Vector[int] vals = scores.values()
    int total = vals.fold(0, (int acc, int x): acc + x)
    print(f"{total}")

    # --- Option with struct ---
    Option[Point] some_pt = Some(Point(5, 6))
    print(f"{some_pt.is_some()}")
    Point pt = some_pt.unwrap()
    print(f"{pt.x}")
    print(f"{pt.y}")
    Option[Point] no_pt = None()
    print(f"{no_pt.is_none()}")

    # --- Vector[Vector[int]] ---
    Vector[Vector[int]] grid = Vector[Vector[int]]()
    Vector[int] row1 = Vector[int]()
    row1.push(1)
    row1.push(2)
    Vector[int] row2 = Vector[int]()
    row2.push(3)
    row2.push(4)
    grid.push(row1)
    grid.push(row2)
    print(f"{grid.len()}")
    Vector[int] got_row = grid.get(0).unwrap()
    print(f"{got_row.len()}")
    print(f"{got_row.get(0).unwrap()}")
    print(f"{got_row.get(1).unwrap()}")
    Vector[int] got_row2 = grid.get(1).unwrap()
    print(f"{got_row2.get(0).unwrap()}")

    # --- Dict[str, Vector[int]] ---
    Dict[str, Vector[int]] groups = Dict[str, Vector[int]]()
    Vector[int] evens = Vector[int]()
    evens.push(2)
    evens.push(4)
    Vector[int] odds = Vector[int]()
    odds.push(1)
    odds.push(3)
    odds.push(5)
    groups.put("even", evens)
    groups.put("odd", odds)
    print(f"{groups.len()}")
    Vector[int] got_evens = groups.get("even").unwrap()
    print(f"{got_evens.len()}")
    print(f"{got_evens.get(0).unwrap()}")
    Vector[int] got_odds = groups.get("odd").unwrap()
    print(f"{got_odds.len()}")
    print(f"{got_odds.get(0).unwrap()}")
    print(f"{groups.get("missing").is_none()}")

    # --- Vector clear (drop correctness) ---
    Vector[Point] pts = Vector[Point]()
    pts.push(Point(1, 1))
    pts.push(Point(2, 2))
    pts.clear()
    print(f"{pts.len()}")
    print("done")
