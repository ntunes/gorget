# Nested collection types: Vector[Vector[int]], Dict[str, Vector[int]],
# Vector[Option[int]], Option[Vector[int]], Dict[str, Option[int]]
from std.collections import Vector, Dict

void main():
    # === 1. Vector[Vector[int]] ===
    print("--- vec_of_vec ---")
    Vector[Vector[int]] vv = Vector[Vector[int]]()
    Vector[int] inner1 = Vector[int]()
    inner1.push(10)
    inner1.push(20)
    inner1.push(30)
    Vector[int] inner2 = Vector[int]()
    inner2.push(40)
    inner2.push(50)
    vv.push(inner1)
    vv.push(inner2)
    print(vv.len())                            # 2

    # access v[0] then element [1]
    Vector[int] row0 = vv.get(0).unwrap()
    print(row0[1])                             # 20

    # access v[1] then element [0]
    Vector[int] row1 = vv.get(1).unwrap()
    print(row1[0])                             # 40

    # modify inner and verify independence after clone
    Vector[int] orig = Vector[int]()
    orig.push(1)
    orig.push(2)
    orig.push(3)
    Vector[int] cloned = orig.clone()
    orig.set(0, 99)
    print(orig[0])                             # 99
    print(cloned[0])                           # 1 (independent)
    print(cloned.len())                        # 3

    # === 2. Dict[str, Vector[int]] ===
    print("--- dict_str_vec ---")
    Dict[str, Vector[int]] groups = Dict[str, Vector[int]]()
    Vector[int] evens = Vector[int]()
    evens.push(2)
    evens.push(4)
    evens.push(6)
    Vector[int] odds = Vector[int]()
    odds.push(1)
    odds.push(3)
    groups.put("even", evens)
    groups.put("odd", odds)
    print(groups.len())                        # 2
    print(groups.contains("even"))             # true
    print(groups.contains("odd"))              # true
    print(groups.contains("prime"))            # false

    # get and verify inner contents via len
    Vector[int] got_evens = groups.get("even").unwrap()
    print(got_evens.len())                     # 3
    Vector[int] got_odds = groups.get("odd").unwrap()
    print(got_odds.len())                      # 2

    # fold over inner vector values
    int even_sum = got_evens.fold(0, (int a, int x): a + x)
    print(even_sum)                            # 12
    int odd_sum = got_odds.fold(0, (int a, int x): a + x)
    print(odd_sum)                             # 4

    # missing key
    print(groups.get("prime").is_none())       # true

    # === 3. Vector[Option[int]] ===
    print("--- vec_of_option ---")
    Vector[Option[int]] opts = Vector[Option[int]]()
    opts.push(Some(10))
    Option[int] none1 = None()
    opts.push(none1)
    opts.push(Some(30))
    Option[int] none2 = None()
    opts.push(none2)
    opts.push(Some(50))
    print(opts.len())                          # 5

    # verify is_some / is_none / unwrap
    print(opts[0].is_some())                   # true
    print(opts[0].unwrap())                    # 10
    print(opts[1].is_none())                   # true
    print(opts[2].unwrap())                    # 30
    print(opts[3].is_none())                   # true
    print(opts[4].is_some())                   # true
    print(opts[4].unwrap())                    # 50

    # === 4. Option[Vector[int]] ===
    print("--- option_of_vec ---")
    Vector[int] inner_vec = Vector[int]()
    inner_vec.push(100)
    inner_vec.push(200)
    inner_vec.push(300)
    Option[Vector[int]] some_vec = Some(inner_vec)
    print(some_vec.is_some())                  # true

    # unwrap and access elements
    Vector[int] unwrapped = some_vec.unwrap()
    print(unwrapped.len())                     # 3
    print(unwrapped[0])                        # 100
    print(unwrapped[1])                        # 200
    print(unwrapped[2])                        # 300

    # None case
    Option[Vector[int]] none_vec = None()
    print(none_vec.is_none())                  # true

    # === 5. Dict[str, Option[int]] ===
    print("--- dict_str_option ---")
    Dict[str, Option[int]] scores = Dict[str, Option[int]]()
    scores.put("alice", Some(95))
    Option[int] no_score = None()
    scores.put("bob", no_score)
    scores.put("carol", Some(88))
    print(scores.len())                        # 3
    print(scores.contains("alice"))            # true
    print(scores.contains("bob"))              # true
    print(scores.contains("dave"))             # false

    # get returns Option[Option[int]]
    Option[Option[int]] alice_score = scores.get("alice")
    print(alice_score.unwrap().unwrap())       # 95

    Option[Option[int]] bob_score = scores.get("bob")
    print(bob_score.unwrap().is_none())        # true

    Option[Option[int]] carol_score = scores.get("carol")
    print(carol_score.unwrap().unwrap())       # 88

    Option[Option[int]] missing = scores.get("dave")
    print(missing.is_none())                   # true

    print("done")
