# Gorget-js snag #11 repro: cross-error-type auto-propagation miscompiles.
# `inner` throws String (a 32-byte error). `outer` throws BigErr (larger).
# Calling inner() inside outer() auto-propagates inner's String error into
# outer's BigErr error slot. Expected: a COMPILE error (String is not
# convertible to BigErr). Actual: it compiles and memcpy's a String into a
# BigErr-sized slot — a type-confused over-read.

struct BigErr:
    String msg
    int a
    int b
    int c
    int d

bool inner(int x) throws String:
    if x < 0:
        throw "the-string-error"
    return x > 0

int outer(int x) throws BigErr:
    bool b = inner(x)!        # <-- String error propagated into BigErr channel
    if b:
        return 1
    return 0

void main():
    # exercise the throwing path so the over-read is live
    match try_outer(-5):
        case Ok(v):
            print(f"ok: {v}")
        case Error(e):
            print(f"caught BigErr: msg='{e.msg}' a={e.a} b={e.b} c={e.c} d={e.d}")

Result[int, BigErr] try_outer(int x):
    int r = outer(x)!
    return Ok(r)
