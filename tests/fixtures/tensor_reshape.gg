from xtd.tensor import Tensor, tensor_arange, tensor_display, tensor_linspace, vec_int_copy

void main():
    # reshape: 1D [6] → 2D [2,3]
    Tensor[int] a = tensor_arange(0, 6)
    Vector[int] sh23 = Vector[int]()
    sh23.push(2)
    sh23.push(3)
    Tensor[int] c = a.reshape(sh23)
    print(tensor_display[int](c))

    # element access on reshaped
    Vector[int] idx = Vector[int]()
    idx.push(1)
    idx.push(2)
    print(f"{c.at(idx)}")

    # transpose: [2,3] → [3,2]
    Tensor[int] t = c.transpose()
    print(f"{t.ndim()}")
    print(f"{t.shape.get(0).unwrap()}")
    print(f"{t.shape.get(1).unwrap()}")

    # element access on transposed: t[0,1] = c[1,0] = 3
    Vector[int] ti = Vector[int]()
    ti.push(0)
    ti.push(1)
    print(f"{t.at(ti)}")

    # tensor_slice: slice axis=0, rows 0..1 of c → [1,3]
    Tensor[int] s = c.tensor_slice(0, 0, 1)
    print(f"{s.ndim()}")
    print(f"{s.shape.get(0).unwrap()}")
    print(f"{s.shape.get(1).unwrap()}")

    # view aliasing: mutate c, verify a sees it (shared storage)
    Vector[int] mi = Vector[int]()
    mi.push(0)
    mi.push(0)
    c.set_at(mi, 42)
    print(f"{a.flat_get(0)}")

    # float reshape
    Tensor[float] fl = tensor_linspace(0.0, 5.0, 6)
    Vector[int] fsh = Vector[int]()
    fsh.push(2)
    fsh.push(3)
    Tensor[float] fc = fl.reshape(fsh)
    print(tensor_display[float](fc))
