# Test: parse_url edge cases.
#
# Validates:
#   - URL with query string — query stays in path
#   - URL with no scheme — treated as https, port 443
#   - Port parse failure (http://host:abc/) — falls back to default (80)
#   - Empty path (http://host.com) — defaults to "/"

from xtd.http import parse_url

void main():
    # URL with query string — query stays in path
    auto (h1, p1, path1, tls1) = parse_url("http://host.com/search?q=test&page=2")
    print(h1)
    print(f"{p1}")
    print(path1)

    # URL with no scheme — treated as https, default port 443
    auto (h2, p2, path2, tls2) = parse_url("example.com/path")
    print(h2)
    print(f"{p2}")
    print(path2)

    # Port parse failure — falls back to http default (80)
    auto (h3, p3, path3, tls3) = parse_url("http://host:abc/")
    print(h3)
    print(f"{p3}")
    print(path3)

    # Empty path — defaults to "/"
    auto (h4, p4, path4, tls4) = parse_url("http://host.com")
    print(h4)
    print(f"{p4}")
    print(path4)

    print("done")
