# R2 F1: plain binary `+` with an INLINE resource-ctor RHS.
# Pre-fix: bare `builder.call` on the overload left the Acc(...) temp
# unregistered → LSan heap leak. Post-fix: emit_operator_overload_call
# re-homes the unregistered owning temp and drops it after the call.
from std.collections import Vector

struct Acc:
    int total
    Vector[int] buf

equip Acc with Drop:
    void drop(!self):
        print(f"drop Acc {self.total}")

equip Acc with Add[Acc]:
    Acc add(self, Acc other):
        Vector[int] b = []
        b.push(self.total + other.total)
        return Acc(self.total + other.total, b)

void main():
    Acc a = Acc(1, [1])
    Acc c = a + Acc(5, [5])
    print(f"sum {c.total}")
