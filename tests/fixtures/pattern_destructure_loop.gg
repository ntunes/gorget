# Test pattern destructuring in for-loops

from std.collections import Dict

void main():
    # For-loop tuple destructuring over Dict
    Dict[String, int] scores = Dict[String, int]()
    scores.put("a", 10)
    scores.put("b", 20)
    int total = 0
    for (k, v) in scores:
        total = total + v
    print(f"{total}")

    # For-loop with enumerate still works
    Vector[String] words = ["hello", "world"]
    for (i, w) in words.enumerate():
        print(f"{i} {w}")
