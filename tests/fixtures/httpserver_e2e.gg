#!parity-excluded network: runs a real HTTP server over a bound TCP socket with a concurrent client; connection timing
#!  decides the output
# End-to-end test: gg.http client against gg.httpserver server.
#
# This is the only test that exercises both stacks over a real TCP socket.
# It verifies that gg.http's response parser (status code, headers, body,
# Content-Length reading) is wire-compatible with gg.httpserver's writer.
#
# Checks:
#   1. GET → 200 + body
#   2. GET → correct Content-Type header
#   3. POST with body → body echoed back
#   4. Unknown path → 404
#   5. Custom response header propagated to client
#   6. URL path parameter via query_string + parse_query_string

from xtd.httpserver import HttpRequest, HttpServerResponse, parse_query_string, http_server_handle_conn_ka
from xtd.http import get, post, HttpResponse
from std.net.socket import ServerSocket, Socket, server_socket_bind
from std.collections import Dict
from std.conv import int_to_str
from std.time import sleep
from std.signal import signal_ignore, SIGPIPE

# ── Top-level handler (no closure capture needed) ─────────────

HttpServerResponse handle(HttpRequest req):
    if req.method == "GET" and req.path == "/hello":
        return HttpServerResponse.ok("world")
    elif req.method == "GET" and req.path == "/json":
        return HttpServerResponse.json("[true]")
    elif req.method == "POST" and req.path == "/echo":
        return HttpServerResponse.ok(req.body)
    elif req.method == "GET" and req.path == "/powered":
        return HttpServerResponse.ok("ok").with_header("x-powered-by", "gorget")
    elif req.method == "GET" and req.path == "/search":
        Dict[String, String] qp = parse_query_string(req.query_string)
        if qp.contains("q"):
            return HttpServerResponse.ok("q=" + qp["q"])
        return HttpServerResponse.ok("no-q")
    return HttpServerResponse.not_found()

# ── Server: accept exactly n connections then exit ─────────────

async void serve_n(ServerSocket !srv, int n):
    TaskGroup group = TaskGroup()
    int i = 0
    while i < n:
        Result[Socket, String] ar = srv.accept()
        if ar.is_ok():
            Socket client = ar.unwrap()
            group.spawn(spawn http_server_handle_conn_ka(!client, handle, 500))
            i = i + 1
    group.join()
    srv.close()

# ── Test helper ───────────────────────────────────────────────

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

async void main():
    signal_ignore(SIGPIPE)
    ServerSocket srv = server_socket_bind("127.0.0.1", 0).unwrap()
    int port = srv.local_port()

    # 6 requests → 6 connections (each get/post sends Connection: close)
    Task[void] server = spawn serve_n(!srv, 6)
    sleep(0.5).await()

    String base = "http://127.0.0.1:" + int_to_str(port)

    # 1. GET /hello → 200 "world"
    Result[HttpResponse, String] r1 = get(base + "/hello")
    if r1.is_ok():
        HttpResponse resp1 = r1.unwrap()
        check("status 200", resp1.status_code == 200)
        check("body world", resp1.body_text == "world")
    else:
        print("FAIL: " + r1.unwrap_error())
        print("FAIL: body")

    # 2. GET /json → correct Content-Type in response headers
    Result[HttpResponse, String] r2 = get(base + "/json")
    if r2.is_ok():
        HttpResponse resp2 = r2.unwrap()
        check("json status", resp2.status_code == 200)
        check("json content-type", resp2.headers["content-type"] == "application/json")
    else:
        print("FAIL: " + r2.unwrap_error())
        print("FAIL: content-type")

    # 3. POST /echo with body → body echoed
    Dict[String, String] empty_hdrs = Dict[String, String]()
    Result[HttpResponse, String] r3 = post(base + "/echo", "hello body", empty_hdrs)
    if r3.is_ok():
        HttpResponse resp3 = r3.unwrap()
        check("echo status", resp3.status_code == 200)
        check("echo body", resp3.body_text == "hello body")
    else:
        print("FAIL: " + r3.unwrap_error())
        print("FAIL: echo body")

    # 4. Unknown path → 404
    Result[HttpResponse, String] r4 = get(base + "/unknown")
    if r4.is_ok():
        HttpResponse resp4 = r4.unwrap()
        check("404", resp4.status_code == 404)
    else:
        print("FAIL: " + r4.unwrap_error())

    # 5. Custom response header propagated to client
    Result[HttpResponse, String] r5 = get(base + "/powered")
    if r5.is_ok():
        HttpResponse resp5 = r5.unwrap()
        check("custom header status", resp5.status_code == 200)
        check("custom header value", resp5.headers["x-powered-by"] == "gorget")
    else:
        print("FAIL: " + r5.unwrap_error())
        print("FAIL: custom header")

    # 6. Query string parsed by handler (path + ?q=gorget)
    Result[HttpResponse, String] r6 = get(base + "/search?q=gorget")
    if r6.is_ok():
        HttpResponse resp6 = r6.unwrap()
        check("query status", resp6.status_code == 200)
        check("query body", resp6.body_text == "q=gorget")
    else:
        print("FAIL: " + r6.unwrap_error())
        print("FAIL: query body")

    server.await()
