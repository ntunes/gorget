from std.fmt import str_truncate, join, repeat
from std.collections import Vector

void main():
    # str_truncate: max == suffix.len() → return suffix itself
    print(str_truncate("hello world", 3, "..."))

    # join: empty vector → empty string
    Vector[String] empty = Vector[String]()
    print(join(empty, ","))

    # str_truncate: text fits within max → unchanged
    print(str_truncate("x", 3, "..."))

    # join: two elements, empty separator
    Vector[String] pair = Vector[String]()
    pair.push("a")
    pair.push("b")
    print(join(pair, ""))

    # str_truncate: max == suffix.len() (2) → return suffix
    print(str_truncate("hello world", 2, ".."))

    # str_truncate: max = 0 → ""
    int t0 = str_truncate("hello", 0, "...").len()
    print(f"{t0}")

    # repeat: 0 times → "" → len = 0
    int r0 = repeat("x", 0).len()
    print(f"{r0}")

    # join: single element (no separator applied)
    Vector[String] single = Vector[String]()
    single.push("only")
    print(join(single, ","))

    print("done")
