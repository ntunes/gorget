# lands — the guard subsumes this axis cell. See TODO.md §Guards.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

struct Holder:
    Option[Money] slot

void main():
    Holder h = Holder(make_opt(11))
    Option[int] r = h.slot.flat_map((Money m): Some(size_of(m)))
    if r is Some(v):
        print(v)
