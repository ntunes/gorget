# Leak test: strings extracted from Result/Option via match destructuring.
# String fields in enum variants are cloned/registered for drop correctly.
from std.os import mem_live

Result[String, String] make_name(int i):
    if i > 0:
        return Ok(f"name_{i}")
    return Error(f"err_{i}")

Option[String] maybe_name(int i):
    if i > 0:
        return Some(f"item_{i}")
    return None

void main():
    int baseline = mem_live()

    # Section 1: Ok(String) in loop
    int i = 0
    while i < 200:
        Result[String, String] r = make_name(i)
        match r:
            case Ok(v):
                int _len = v.len()
            case Error(e):
                pass
        i = i + 1

    # Section 2: Error(String) in loop
    i = 0
    while i < 200:
        Result[String, String] r = make_name(0)
        match r:
            case Ok(v):
                pass
            case Error(e):
                int _len = e.len()
        i = i + 1

    # Section 3: Some(String) in loop
    i = 0
    while i < 200:
        Option[String] opt = maybe_name(i)
        match opt:
            case Some(s):
                int _len = s.len()
            case None:
                pass
        i = i + 1

    # Section 4: None branch in loop
    i = 0
    while i < 200:
        Option[String] opt = maybe_name(0)
        match opt:
            case Some(s):
                pass
            case None:
                pass
        i = i + 1

    int leaked = mem_live() - baseline
    print(f"leaked={leaked > 0}")
    print("done")
