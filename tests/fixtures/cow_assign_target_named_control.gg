String mk(String a, String b):
    return a + b

void main():
    Vector[Vector[String]] outer = []
    Vector[String] inner = []
    inner.push(mk("hel", "lo"))
    outer.push(inner)
    Vector[String] first = outer.get(0).unwrap()
    String s = first.get(0).unwrap()
    first[0] = mk("zappedzappedzapped", "zappedzappedzapped")
    print(s)
