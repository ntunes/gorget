from std.async import sleep

async int test_chains():
    sleep(1)

    # Vector chain: filter → map → fold
    Vector[int] v = Vector[int]()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)

    int sum_even = v.filter((int x): x % 2 == 0).fold(0, (int a, int x): a + x)
    print(sum_even)

    # Option chain: map → filter → unwrap_or
    Option[int] opt = Some(10)
    int r1 = opt.map((int x): x * 2).filter((int x): x > 15).unwrap_or(0)
    print(r1)

    int r2 = opt.map((int x): x * 2).filter((int x): x > 25).unwrap_or(-1)
    print(r2)

    # Result chain: map → unwrap_or
    Result[int, String] ok = Ok(5)
    int r3 = ok.map((int x): x * 10).unwrap_or(0)
    print(r3)

    Result[int, String] err = Error("fail")
    int r4 = err.map((int x): x * 10).unwrap_or(-1)
    print(r4)

    # Vector: sorted → filter → len
    Vector[int] v2 = Vector[int]()
    v2.push(5)
    v2.push(3)
    v2.push(1)
    v2.push(4)
    v2.push(2)
    int big_count = v2.sorted().filter((int x): x > 3).len()
    print(big_count)

    return 0

async void main():
    Task[int] t = spawn test_chains()
    int r = t.await()
    print(r)
