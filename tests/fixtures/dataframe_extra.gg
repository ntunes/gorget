from xtd.dataframe import DataFrame, df_from_records
from std.collections import Vector, Dict

void main():
    # df_from_records: build from string headers + rows
    Vector[String] headers = Vector[String]()
    headers.push("name")
    headers.push("score")

    Vector[String] row0 = Vector[String]()
    row0.push("Alice")
    row0.push("90")
    Vector[String] row1 = Vector[String]()
    row1.push("Bob")
    row1.push("80")
    Vector[Vector[String]] rows = Vector[Vector[String]]()
    rows.push(row0)
    rows.push(row1)

    DataFrame df = df_from_records(headers, rows)
    int nr = df.nrows()
    int nc = df.ncols()
    print(f"{nr}")
    print(f"{nc}")

    # row_as_dict: returns Dict[String, String] for a row
    Dict[String, String] r0d = df.row_as_dict(0)
    String name0 = r0d["name"]
    String score0 = r0d["score"]
    print(name0)
    print(score0)

    # value_counts: count occurrences in a column
    Vector[String] cat_headers = Vector[String]()
    cat_headers.push("color")
    Vector[String] c0 = Vector[String]()
    c0.push("red")
    Vector[String] c1 = Vector[String]()
    c1.push("blue")
    Vector[String] c2 = Vector[String]()
    c2.push("red")
    Vector[Vector[String]] cat_rows = Vector[Vector[String]]()
    cat_rows.push(c0)
    cat_rows.push(c1)
    cat_rows.push(c2)

    DataFrame cat_df = df_from_records(cat_headers, cat_rows)
    DataFrame vc = cat_df.value_counts("color")
    int vc_rows = vc.nrows()
    print(f"{vc_rows}")
    bool has_color = vc.has_column("color")
    bool has_count = vc.has_column("count")
    print(f"{has_color}")
    print(f"{has_count}")

    print("done")
