from gg.dataframe import DataFrame, df_from_records
from std.collections import Vector, Dict

void main():
    # df_from_records: build from string headers + rows
    Vector[str] headers = Vector[str]()
    headers.push("name")
    headers.push("score")

    Vector[str] row0 = Vector[str]()
    row0.push("Alice")
    row0.push("90")
    Vector[str] row1 = Vector[str]()
    row1.push("Bob")
    row1.push("80")
    Vector[Vector[str]] rows = Vector[Vector[str]]()
    rows.push(row0)
    rows.push(row1)

    DataFrame df = df_from_records(headers, rows)
    int nr = df.nrows()
    int nc = df.ncols()
    print("{nr}")
    print("{nc}")

    # row_as_dict: returns Dict[str, str] for a row
    Dict[str, str] r0d = df.row_as_dict(0)
    str name0 = r0d["name"]
    str score0 = r0d["score"]
    print(name0)
    print(score0)

    # value_counts: count occurrences in a column
    Vector[str] cat_headers = Vector[str]()
    cat_headers.push("color")
    Vector[str] c0 = Vector[str]()
    c0.push("red")
    Vector[str] c1 = Vector[str]()
    c1.push("blue")
    Vector[str] c2 = Vector[str]()
    c2.push("red")
    Vector[Vector[str]] cat_rows = Vector[Vector[str]]()
    cat_rows.push(c0)
    cat_rows.push(c1)
    cat_rows.push(c2)

    DataFrame cat_df = df_from_records(cat_headers, cat_rows)
    DataFrame vc = cat_df.value_counts("color")
    int vc_rows = vc.nrows()
    print("{vc_rows}")
    bool has_color = vc.has_column("color")
    bool has_count = vc.has_column("count")
    print("{has_color}")
    print("{has_count}")

    print("done")
