# Planner consumer #1 — bare-param mutation in an `else` branch. Same scope
# pre-header materialize class as `cow_loop_bare_param_if_branch`, exercised via
# the else body instead of the then body: the pre-scope hoist unions all branch
# bodies, so the else-only mutation is materialized before the branch dispatch.
# Pre-fix printed 4,4; ggdef-adjudicated 3,4.
void f(Vector[int] xs):
    if xs.len() < 2:
        print(0)
    else:
        xs.pop()
    print(xs.len())

void main():
    Vector[int] a = [1, 2, 3, 4]
    f(a)
    print(a.len())
