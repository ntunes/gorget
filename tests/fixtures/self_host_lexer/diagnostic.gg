# Typed diagnostic record produced by the resolution / type-checking
# / lowering / validation passes.
#
# Replaces the free-form `Vector[String] errors` accumulator pattern.
# Span / severity / category are first-class fields rather than baked
# into the message text, so consumers (drivers, CLIs, IDEs) can filter,
# group, render, and emit JSON without re-parsing strings.
#
# Lexer migration (2026-05-18): the lexer populates `DkLexError`
# diagnostics at malformed-literal sites (unterminated string, escape,
# char literal; unexpected character). Mirrors the resolver POC and
# parser migration patterns — kept per-stage while the cross-directory
# shared-module strategy is settled. The lexer dir doesn't have an
# `ast` module so Span is defined inline here (it's a trivial pair of
# byte offsets, identical to ast.Span in the other stages).

from std.collections import Vector
from std.conv import int_to_str

# ── Span ────────────────────────────────────────────────────
#
# Inlined here (not imported from ast) because the lexer driver has
# no ast.gg. Other stages import the equivalent struct from ast.

struct Span:
    int start
    int end

# ── Severity ────────────────────────────────────────────────

enum Severity:
    SevError
    SevWarning
    SevSuggestion  # for lints / hints

# ── Diagnostic category ─────────────────────────────────────
#
# One variant per category currently emitted by a stage on the
# accumulator. The lexer populates `DkLexError` exclusively today;
# the other variants are reserved for upstream / downstream stages
# (parser → DkParseError; resolver → DkUndefinedName / DkDuplicateDefinition;
# typechecker → DkTypeMismatch / DkNotAType; lowerer → DkUnreachable).

enum DiagKind:
    # Resolver kinds
    DkUndefinedName        # EIdentifier / EStructLiteral lookup miss
    DkDuplicateDefinition  # `define` rejected — name already bound

    # Parser kinds
    DkParseError           # expect_tok / expect_kw / expected-* sites

    # Lexer kinds (active in this stage)
    DkLexError             # unterminated string / char / escape; unexpected char

    # Reserved for future migrators (kept so the type doesn't churn
    # when typechecker / lowerer sites migrate).
    DkNotAType
    DkTypeMismatch
    DkControlFlow
    DkUnreachable

# ── Diagnostic ──────────────────────────────────────────────

struct Diagnostic:
    Span span
    Severity sev
    DiagKind kind
    String message

# ── Constructors ────────────────────────────────────────────
#
# Prefer the helpers (`Diagnostic.error(...)` etc.) over inline
# struct literals so call sites read like prose and we have one
# place to evolve the shape.

equip Diagnostic:

    Diagnostic error(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevError(), kind, message)

    Diagnostic warn(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevWarning(), kind, message)

    Diagnostic suggest(Span span, DiagKind kind, String message):
        return Diagnostic(span, SevSuggestion(), kind, message)

# ── Rendering ───────────────────────────────────────────────

String severity_str(Severity sev):
    match sev:
        case SevError():
            return "error"
        case SevWarning():
            return "warning"
        case SevSuggestion():
            return "suggestion"

String diag_kind_str(DiagKind kind):
    match kind:
        case DkUndefinedName():
            return "undefined-name"
        case DkDuplicateDefinition():
            return "duplicate-definition"
        case DkParseError():
            return "parse-error"
        case DkLexError():
            return "lex-error"
        case DkNotAType():
            return "not-a-type"
        case DkTypeMismatch():
            return "type-mismatch"
        case DkControlFlow():
            return "control-flow"
        case DkUnreachable():
            return "unreachable"

# Canonical one-line rendering used by the lexer comparison test driver.
# Format: `DIAG <severity> <kind> <span_start>:<span_end> <message>`.
# Stderr-routed so the stdout comparison contract (one canonical token
# per line) stays byte-stable; lexer_comparison reads only stdout.
String format_diagnostic(Diagnostic d):
    return "DIAG " + severity_str(d.sev) + " " + diag_kind_str(d.kind) + " " + int_to_str(d.span.start) + ":" + int_to_str(d.span.end) + " " + d.message
