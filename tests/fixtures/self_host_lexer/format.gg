# Canonical token formatting for lexer comparison testing.
# Exports describe_token_canonical(Token) -> String with identical format
# to the Rust-side describe_token_canonical_rust().

from lexer import Token, Keyword, StringLiteral, StringSegment, StringKind
from std.conv import int_to_str, float_to_str

String escape_char_canonical(String c):
    if c == "\n":
        return "\\n"
    if c == "\r":
        return "\\r"
    if c == "\t":
        return "\\t"
    if c == "\0":
        return "\\0"
    if c == "\\":
        return "\\\\"
    return c

String escape_canonical(String s):
    String result = ""
    int i = 0
    while i < s.byte_len():
        String c = s.byte_slice(i, i + 1)
        result = result + escape_char_canonical(c)
        i = i + 1
    return result

String describe_keyword_canonical(Keyword kw):
    match kw:
        case KwInt():
            return "kw:int"
        case KwInt8():
            return "kw:int8"
        case KwInt16():
            return "kw:int16"
        case KwInt32():
            return "kw:int32"
        case KwInt64():
            return "kw:int64"
        case KwUint():
            return "kw:uint"
        case KwUint8():
            return "kw:uint8"
        case KwUint16():
            return "kw:uint16"
        case KwUint32():
            return "kw:uint32"
        case KwUint64():
            return "kw:uint64"
        case KwFloat():
            return "kw:float"
        case KwFloat32():
            return "kw:float32"
        case KwFloat64():
            return "kw:float64"
        case KwBool():
            return "kw:bool"
        case KwStringType():
            return "kw:String"
        case KwVoid():
            return "kw:void"
        case KwAuto():
            return "kw:auto"
        case KwConst():
            return "kw:const"
        case KwStruct():
            return "kw:struct"
        case KwEnum():
            return "kw:enum"
        case KwTrait():
            return "kw:trait"
        case KwEquip():
            return "kw:equip"
        case KwPublic():
            return "kw:public"
        case KwStatic():
            return "kw:static"
        case KwType():
            return "kw:type"
        case KwNewtype():
            return "kw:newtype"
        case KwIf():
            return "kw:if"
        case KwElif():
            return "kw:elif"
        case KwElse():
            return "kw:else"
        case KwFor():
            return "kw:for"
        case KwWhile():
            return "kw:while"
        case KwLoop():
            return "kw:loop"
        case KwIn():
            return "kw:in"
        case KwMatch():
            return "kw:match"
        case KwCase():
            return "kw:case"
        case KwBreak():
            return "kw:break"
        case KwContinue():
            return "kw:continue"
        case KwReturn():
            return "kw:return"
        case KwDo():
            return "kw:do"
        case KwPass():
            return "kw:pass"
        case KwAnd():
            return "kw:and"
        case KwOr():
            return "kw:or"
        case KwNot():
            return "kw:not"
        case KwIs():
            return "kw:is"
        case KwTrue():
            return "kw:true"
        case KwFalse():
            return "kw:false"
        case KwThrow():
            return "kw:throw"
        case KwThrows():
            return "kw:throws"
        case KwImport():
            return "kw:import"
        case KwFrom():
            return "kw:from"
        case KwDirective():
            return "kw:directive"
        case KwWith():
            return "kw:with"
        case KwAs():
            return "kw:as"
        case KwVia():
            return "kw:via"
        case KwWhere():
            return "kw:where"
        case KwExtends():
            return "kw:extends"
        case KwAsync():
            return "kw:async"
        case KwAwait():
            return "kw:await"
        case KwSpawn():
            return "kw:spawn"
        case KwExtern():
            return "kw:extern"
        case KwSelfLower():
            return "kw:self"
        case KwSelfUpper():
            return "kw:Self"
        case KwMove():
            return "kw:move"
        case KwTest():
            return "kw:test"
        case KwSuite():
            return "kw:suite"
        case KwBench():
            return "kw:bench"
        case KwIt():
            return "kw:it"
        case KwAssert():
            return "kw:assert"
        case KwShared():
            return "kw:shared"
        case KwMeta():
            return "kw:meta"
        case KwSelect():
            return "kw:select"
        case KwRethrow():
            return "kw:rethrow"
        case KwCatch():
            return "kw:catch"
        case KwSnapshot():
            return "kw:snapshot"
        case KwBlocking():
            return "kw:blocking"
        case KwUnchecked():
            return "kw:unchecked"
        case KwPrivate():
            return "kw:private"
        case KwNoreturn():
            return "kw:noreturn"
    return "kw:unknown"

String describe_string_canonical(StringLiteral slit):
    String prefix = "str:"
    match slit.lex_kind:
        case SkRaw():
            prefix = "rstr:"
        case SkMultiLine():
            prefix = "mstr:"
        case SkByte():
            prefix = "bstr:"
        case SkFormat():
            prefix = "fstr:"
        case SkCStr():
            prefix = "cstr:"
        else:
            pass
    String result = prefix
    int i = 0
    while i < slit.lex_segments.len():
        StringSegment seg = slit.lex_segments.get(i).unwrap()
        match seg:
            case SegLiteral(text):
                result = result + escape_canonical(text)
            case SegInterpolation(expr, _):
                result = result + f"\{" + expr + "\}"
        i = i + 1
    return result

String describe_token_canonical(Token t):
    match t:
        case TkKeyword(kw):
            return describe_keyword_canonical(kw)
        case TkIdentifier(name):
            return "ident:" + name
        case TkInt(n):
            return "int:" + int_to_str(n)
        case TkFloat(f):
            return "float:" + float_to_str(f)
        case TkString(slit):
            return describe_string_canonical(slit)
        case TkBool(b):
            if b:
                return "bool:true"
            return "bool:false"
        case TkPlus():
            return "+"
        case TkMinus():
            return "-"
        case TkStar():
            return "*"
        case TkSlash():
            return "/"
        case TkPercent():
            return "%"
        case TkEq():
            return "="
        case TkLt():
            return "<"
        case TkGt():
            return ">"
        case TkBang():
            return "!"
        case TkAmpersand():
            return "&"
        case TkPipe():
            return "|"
        case TkCaret():
            return "^"
        case TkTilde():
            return "~"
        case TkDot():
            return "."
        case TkQuestion():
            return "?"
        case TkAt():
            return "@"
        case TkUnderscore():
            return "_"
        case TkEqEq():
            return "=="
        case TkBangEq():
            return "!="
        case TkLtEq():
            return "<="
        case TkGtEq():
            return ">="
        case TkLtLt():
            return "<<"
        case TkGtGt():
            return ">>"
        case TkLtLtEq():
            return "<<="
        case TkGtGtEq():
            return ">>="
        case TkAmpEq():
            return "&="
        case TkPipeEq():
            return "|="
        case TkCaretEq():
            return "^="
        case TkPlusEq():
            return "+="
        case TkArrow():
            return "->"
        case TkMinusEq():
            return "-="
        case TkStarEq():
            return "*="
        case TkSlashEq():
            return "/="
        case TkPercentEq():
            return "%="
        case TkPlusPercent():
            return "+%"
        case TkMinusPercent():
            return "-%"
        case TkStarPercent():
            return "*%"
        case TkPlusPercentEq():
            return "+%="
        case TkMinusPercentEq():
            return "-%="
        case TkStarPercentEq():
            return "*%="
        case TkDotDot():
            return ".."
        case TkDotDotEq():
            return "..="
        case TkQuestionDot():
            return "?."
        case TkDoubleQuestion():
            return "??"
        case TkLParen():
            return "("
        case TkRParen():
            return ")"
        case TkLBracket():
            return "["
        case TkRBracket():
            return "]"
        case TkLBrace():
            return "lbrace"
        case TkRBrace():
            return "rbrace"
        case TkColon():
            return ":"
        case TkComma():
            return ","
        case TkIndent():
            return "INDENT"
        case TkDedent():
            return "DEDENT"
        case TkNewline():
            return "NL"
        case TkDocComment(text):
            return "doc:" + text
        case TkComment(text):
            return "comment:" + text
        case TkEof():
            return "EOF"
        case TkError(msg):
            return "error:" + msg
    return "?"
