# Self-hosting lexer for the Gorget programming language.
# Produces a stream of tokens from source text, including synthetic
# INDENT/DEDENT/NEWLINE tokens based on indentation changes.

from std.collections import Vector
from std.conv import parse_int, parse_float, chr
from diagnostic import Diagnostic, DkLexError, Span

# Owned byte_slice — allocates a copy so the result survives source deallocation.
# Required because byte_slice returns a view into the source string, which is
# freed when the Lexer is dropped at the end of lex_tokenize.
String owned_slice(String s, int start, int end):
    return s.byte_slice(start, end).clone()

# ── Keyword enum ──────────────────────────────────────────────

enum Keyword:
    KwInt  KwInt8  KwInt16  KwInt32  KwInt64
    KwUint  KwUint8  KwUint16  KwUint32  KwUint64
    KwFloat  KwFloat32  KwFloat64
    KwBool  KwStringType  KwVoid  KwAuto
    KwConst  KwStruct  KwEnum  KwTrait  KwEquip  KwPublic  KwStatic  KwType  KwNewtype
    KwIf  KwElif  KwElse  KwFor  KwWhile  KwLoop  KwIn  KwMatch  KwCase
    KwBreak  KwContinue  KwReturn  KwDo  KwPass
    KwAnd  KwOr  KwNot  KwIs
    KwTrue  KwFalse
    KwThrow  KwThrows
    KwImport  KwFrom  KwDirective
    KwWith  KwAs  KwVia
    KwWhere  KwExtends
    KwAsync  KwAwait  KwSpawn
    KwUnsafe  KwExtern
    KwSelfLower  KwSelfUpper
    KwMove  KwMutable
    KwTest  KwSuite  KwBench  KwIt  KwAssert
    KwShared  KwMeta  KwSelect  KwRethrow  KwCatch  KwSnapshot
    KwBlocking  KwUnchecked  KwPrivate  KwNoreturn

# ── String literal types ──────────────────────────────────────

enum StringKind:
    SkNormal  SkRaw  SkMultiLine  SkByte  SkFormat  SkCStr

enum StringSegment:
    SegLiteral(String)
    SegInterpolation(String, Option[String])

struct StringLiteral:
    StringKind lex_kind
    Vector[StringSegment] lex_segments

# ── Token enum ────────────────────────────────────────────────

enum Token:
    # Identifiers and keywords
    TkKeyword(Keyword)
    TkIdentifier(String)
    # Literals
    TkInt(int)
    TkFloat(float)
    TkString(StringLiteral)
    TkBool(bool)
    # Single-char operators
    TkPlus  TkMinus  TkStar  TkSlash  TkPercent
    TkEq  TkLt  TkGt  TkBang  TkAmpersand  TkPipe
    TkCaret  TkTilde  TkDot  TkQuestion  TkAt  TkUnderscore
    # Multi-char operators
    TkEqEq  TkBangEq  TkLtEq  TkGtEq
    TkLtLt  TkGtGt  TkLtLtEq  TkGtGtEq
    TkAmpEq  TkPipeEq  TkCaretEq
    TkPlusEq  TkArrow  TkMinusEq  TkStarEq  TkSlashEq  TkPercentEq
    TkPlusPercent  TkMinusPercent  TkStarPercent
    TkPlusPercentEq  TkMinusPercentEq  TkStarPercentEq
    TkDotDot  TkDotDotEq  TkQuestionDot  TkDoubleQuestion
    # Delimiters
    TkLParen  TkRParen  TkLBracket  TkRBracket  TkLBrace  TkRBrace
    TkColon  TkComma
    # Indentation
    TkIndent  TkDedent  TkNewline
    # Special
    TkDocComment(String)  TkComment(String)
    TkEof
    TkError(String)

# ── Spanned token ─────────────────────────────────────────────

struct SpannedToken:
    Token lex_token
    int lex_start
    int lex_end

# ── Lexer struct ──────────────────────────────────────────────

struct Lexer:
    String lex_source
    int lex_pos
    Vector[int] lex_indent_stack
    int lex_bracket_depth
    Vector[SpannedToken] lex_tokens
    bool lex_finished
    bool lex_need_newline
    # Typed diagnostics accumulator. Replaces the old `String lex_error`
    # single-slot field — that was write-only and lost all but the last
    # message. Mirrors the parser's `Vector[Diagnostic] diagnostics`
    # field (self_host_parser/parser.gg) and the resolver's
    # ResolveContext.diagnostics. Drained via `lex_with_diagnostics`.
    Vector[Diagnostic] lex_diagnostics

# ── Keyword lookup ────────────────────────────────────────────

Option[Keyword] keyword_from_str(String s):
    if s == "int":
        return Some(KwInt())
    elif s == "int8":
        return Some(KwInt8())
    elif s == "int16":
        return Some(KwInt16())
    elif s == "int32":
        return Some(KwInt32())
    elif s == "int64":
        return Some(KwInt64())
    elif s == "uint":
        return Some(KwUint())
    elif s == "uint8":
        return Some(KwUint8())
    elif s == "byte":
        # User-facing alias for uint8 — match Rust lexer at token level
        # so all downstream stages see a single primitive name.
        return Some(KwUint8())
    elif s == "uint16":
        return Some(KwUint16())
    elif s == "uint32":
        return Some(KwUint32())
    elif s == "uint64":
        return Some(KwUint64())
    elif s == "float":
        return Some(KwFloat())
    elif s == "float32":
        return Some(KwFloat32())
    elif s == "float64":
        return Some(KwFloat64())
    elif s == "bool":
        return Some(KwBool())
    elif s == "String":
        return Some(KwStringType())
    elif s == "void":
        return Some(KwVoid())
    elif s == "auto":
        return Some(KwAuto())
    elif s == "const":
        return Some(KwConst())
    elif s == "struct":
        return Some(KwStruct())
    elif s == "enum":
        return Some(KwEnum())
    elif s == "trait":
        return Some(KwTrait())
    elif s == "equip":
        return Some(KwEquip())
    elif s == "public":
        return Some(KwPublic())
    elif s == "static":
        return Some(KwStatic())
    elif s == "type":
        return Some(KwType())
    elif s == "newtype":
        return Some(KwNewtype())
    elif s == "if":
        return Some(KwIf())
    elif s == "elif":
        return Some(KwElif())
    elif s == "else":
        return Some(KwElse())
    elif s == "for":
        return Some(KwFor())
    elif s == "while":
        return Some(KwWhile())
    elif s == "loop":
        return Some(KwLoop())
    elif s == "in":
        return Some(KwIn())
    elif s == "match":
        return Some(KwMatch())
    elif s == "case":
        return Some(KwCase())
    elif s == "break":
        return Some(KwBreak())
    elif s == "continue":
        return Some(KwContinue())
    elif s == "return":
        return Some(KwReturn())
    elif s == "do":
        return Some(KwDo())
    elif s == "pass":
        return Some(KwPass())
    elif s == "and":
        return Some(KwAnd())
    elif s == "or":
        return Some(KwOr())
    elif s == "not":
        return Some(KwNot())
    elif s == "is":
        return Some(KwIs())
    elif s == "true":
        return Some(KwTrue())
    elif s == "false":
        return Some(KwFalse())
    elif s == "throw":
        return Some(KwThrow())
    elif s == "throws":
        return Some(KwThrows())
    elif s == "import":
        return Some(KwImport())
    elif s == "from":
        return Some(KwFrom())
    elif s == "directive":
        return Some(KwDirective())
    elif s == "with":
        return Some(KwWith())
    elif s == "as":
        return Some(KwAs())
    elif s == "via":
        return Some(KwVia())
    elif s == "where":
        return Some(KwWhere())
    elif s == "extends":
        return Some(KwExtends())
    elif s == "async":
        return Some(KwAsync())
    elif s == "await":
        return Some(KwAwait())
    elif s == "spawn":
        return Some(KwSpawn())
    elif s == "unsafe":
        return Some(KwUnsafe())
    elif s == "extern":
        return Some(KwExtern())
    elif s == "self":
        return Some(KwSelfLower())
    elif s == "Self":
        return Some(KwSelfUpper())
    elif s == "move":
        return Some(KwMove())
    elif s == "mutable":
        return Some(KwMutable())
    elif s == "test":
        return Some(KwTest())
    elif s == "suite":
        return Some(KwSuite())
    elif s == "bench":
        return Some(KwBench())
    elif s == "it":
        return Some(KwIt())
    elif s == "assert":
        return Some(KwAssert())
    elif s == "shared":
        return Some(KwShared())
    elif s == "meta":
        return Some(KwMeta())
    elif s == "select":
        return Some(KwSelect())
    elif s == "rethrow":
        return Some(KwRethrow())
    elif s == "catch":
        return Some(KwCatch())
    elif s == "snapshot":
        return Some(KwSnapshot())
    elif s == "blocking":
        return Some(KwBlocking())
    elif s == "unchecked":
        return Some(KwUnchecked())
    elif s == "private":
        return Some(KwPrivate())
    elif s == "noreturn":
        return Some(KwNoreturn())
    return None

# ── Lexer methods ─────────────────────────────────────────────

equip Lexer:

    # ── Primitives ────────────────────────────────────────────

    bool lex_at_end(self): self.lex_pos >= self.lex_source.byte_len()

    byte lex_peek(self):
        return self.lex_source.byte_at(self.lex_pos)

    byte lex_peek_at(self, int offset):
        return self.lex_source.byte_at(self.lex_pos + offset)

    void lex_advance(&self):
        self.lex_pos = self.lex_pos + 1

    void lex_emit(&self, Token !tok, int start, int end):
        self.lex_tokens.push(SpannedToken(!tok, start, end))

    # True when the most recently emitted token is a `.` — the signal that a
    # following number is a tuple-index (`tup.1.0`), not a real float. Mirrors
    # the Rust lexer's tuple-index disambiguation (src/lexer/mod.rs): a `D.D`
    # immediately after a Dot must scan as Int (then the trailing `.D` is a
    # separate Dot + Int), so nested tuple access composes (`a.1.2.3`).
    bool lex_prev_is_dot(self):
        int n = self.lex_tokens.len()
        if n == 0:
            return false
        Token prev = self.lex_tokens.get(n - 1).unwrap().lex_token
        match prev:
            case TkDot:
                return true
            else:
                return false

    # ── Indentation helpers ───────────────────────────────────

    int lex_count_leading_spaces(&self):
        int count = 0
        while self.lex_pos < self.lex_source.byte_len():
            byte c = self.lex_source.byte_at(self.lex_pos)
            if c == b' ':
                count = count + 1
                self.lex_pos = self.lex_pos + 1
            elif c == b'\t':
                count = count + 4
                self.lex_pos = self.lex_pos + 1
            else:
                return count
        return count

    void lex_emit_newline_if_needed(&self, int line_start):
        if self.lex_need_newline:
            self.lex_emit(!TkNewline(), line_start, line_start)
            self.lex_need_newline = false

    void lex_process_indentation(&self, int spaces, int line_start):
        int current = self.lex_indent_stack.get(self.lex_indent_stack.len() - 1).unwrap()
        if spaces > current:
            self.lex_indent_stack.push(spaces)
            self.lex_emit(!TkIndent(), line_start, line_start)
        elif spaces < current:
            while self.lex_indent_stack.len() > 1:
                int top = self.lex_indent_stack.get(self.lex_indent_stack.len() - 1).unwrap()
                if top <= spaces:
                    break
                self.lex_indent_stack.pop()
                self.lex_emit(!TkDedent(), line_start, line_start)

    void lex_emit_eof(&self):
        if self.lex_finished:
            return
        self.lex_finished = true
        int pos = self.lex_source.byte_len()
        if self.lex_need_newline:
            self.lex_emit(!TkNewline(), pos, pos)
        while self.lex_indent_stack.len() > 1:
            self.lex_indent_stack.pop()
            self.lex_emit(!TkDedent(), pos, pos)
        self.lex_emit(!TkEof(), pos, pos)

    # ── Skip helpers ──────────────────────────────────────────

    void lex_skip_to_eol(&self):
        while self.lex_pos < self.lex_source.byte_len() and self.lex_source.byte_at(self.lex_pos) != b'\n':
            self.lex_pos = self.lex_pos + 1

    # ── Escape sequence parsing ───────────────────────────────

    Option[String] lex_parse_escape(&self):
        if self.lex_at_end():
            return None
        byte c = self.lex_peek()
        if c == b'n':
            self.lex_advance()
            return Some("\n")
        elif c == b't':
            self.lex_advance()
            return Some("\t")
        elif c == b'r':
            self.lex_advance()
            return Some("\r")
        elif c == b'\\':
            self.lex_advance()
            return Some("\\")
        elif c == b'0':
            self.lex_advance()
            return Some("\0")
        elif c == b'"':
            self.lex_advance()
            return Some("\"")
        elif c == b'\'':
            self.lex_advance()
            return Some("'")
        elif c == b'{':
            self.lex_advance()
            return Some("{")
        elif c == b'}':
            self.lex_advance()
            return Some("}")
        elif c == b'u' and self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'{':
            self.lex_pos = self.lex_pos + 2
            int hex_start = self.lex_pos
            while self.lex_pos < self.lex_source.byte_len() and self.lex_peek() != b'}':
                self.lex_advance()
            String hex_str = owned_slice(self.lex_source, hex_start, self.lex_pos)
            if self.lex_pos < self.lex_source.byte_len():
                self.lex_advance()
            int code = lex_parse_int_radix(hex_str, 16)
            return Some(chr(code))
        elif c == b'u':
            # \uXXXX — 4-hex-digit BMP shorthand (JS/Rust/Java shape).
            # The braced \u{...} form is handled above; this is the bare form.
            self.lex_advance()
            int u_hex_start = self.lex_pos
            int u_read = 0
            while u_read < 4 and self.lex_pos < self.lex_source.byte_len() and self.lex_peek().is_hex_digit():
                self.lex_advance()
                u_read = u_read + 1
            String u_hex = owned_slice(self.lex_source, u_hex_start, self.lex_pos)
            int u_code = lex_parse_int_radix(u_hex, 16)
            return Some(chr(u_code))
        else:
            self.lex_advance()
            return Some(owned_slice(self.lex_source, self.lex_pos - 1, self.lex_pos))

    # ── Identifier scanning ───────────────────────────────────

    void lex_scan_identifier(&self):
        int start = self.lex_pos
        while self.lex_pos < self.lex_source.byte_len():
            byte c = self.lex_source.byte_at(self.lex_pos)
            if c.is_alphanumeric() or c == b'_':
                self.lex_pos = self.lex_pos + 1
            else:
                break
        String word = owned_slice(self.lex_source, start, self.lex_pos)
        Option[Keyword] kw = keyword_from_str(word)
        match kw:
            case Some(k):
                self.lex_emit(!TkKeyword(k), start, self.lex_pos)
            else:
                if word == "_":
                    self.lex_emit(!TkUnderscore(), start, self.lex_pos)
                else:
                    self.lex_emit(!TkIdentifier(word), start, self.lex_pos)

    # ── Number scanning ───────────────────────────────────────

    void lex_scan_number(&self):
        int start = self.lex_pos
        byte first = self.lex_peek()

        # Check for 0x, 0o, 0b prefixes
        if first == b'0' and self.lex_pos + 1 < self.lex_source.byte_len():
            byte prefix = self.lex_peek_at(1)
            if prefix == b'x' or prefix == b'X':
                self.lex_pos = self.lex_pos + 2
                while self.lex_pos < self.lex_source.byte_len():
                    byte c = self.lex_source.byte_at(self.lex_pos)
                    if c.is_hex_digit() or c == b'_':
                        self.lex_pos = self.lex_pos + 1
                    else:
                        break
                String hex_body = owned_slice(self.lex_source, start + 2, self.lex_pos)
                String clean = str_remove_char(hex_body, b'_')
                int val = lex_parse_int_radix(clean, 16)
                self.lex_emit(!TkInt(val), start, self.lex_pos)
                return
            elif prefix == b'o' or prefix == b'O':
                self.lex_pos = self.lex_pos + 2
                while self.lex_pos < self.lex_source.byte_len():
                    byte c = self.lex_source.byte_at(self.lex_pos)
                    if c >= b'0' and c <= b'7' or c == b'_':
                        self.lex_pos = self.lex_pos + 1
                    else:
                        break
                String oct_body = owned_slice(self.lex_source, start + 2, self.lex_pos)
                String clean = str_remove_char(oct_body, b'_')
                int val = lex_parse_int_radix(clean, 8)
                self.lex_emit(!TkInt(val), start, self.lex_pos)
                return
            elif prefix == b'b' or prefix == b'B':
                self.lex_pos = self.lex_pos + 2
                while self.lex_pos < self.lex_source.byte_len():
                    byte c = self.lex_source.byte_at(self.lex_pos)
                    if c == b'0' or c == b'1' or c == b'_':
                        self.lex_pos = self.lex_pos + 1
                    else:
                        break
                String bin_body = owned_slice(self.lex_source, start + 2, self.lex_pos)
                String clean = str_remove_char(bin_body, b'_')
                int val = lex_parse_int_radix(clean, 2)
                self.lex_emit(!TkInt(val), start, self.lex_pos)
                return

        # Decimal digits
        while self.lex_pos < self.lex_source.byte_len():
            byte c = self.lex_source.byte_at(self.lex_pos)
            if c.is_digit() or c == b'_':
                self.lex_pos = self.lex_pos + 1
            else:
                break

        # Check for float (decimal point followed by digit). Suppressed when
        # the previous token is a `.` — then `tup.1.0`'s `1.0` is a tuple-index
        # pair (Int Dot Int), not a float (see lex_prev_is_dot).
        bool is_float = false
        bool prev_dot = self.lex_prev_is_dot()
        if not prev_dot and self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b'.':
            if self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1).is_digit():
                is_float = true
                self.lex_pos = self.lex_pos + 1
                while self.lex_pos < self.lex_source.byte_len():
                    byte c = self.lex_source.byte_at(self.lex_pos)
                    if c.is_digit() or c == b'_':
                        self.lex_pos = self.lex_pos + 1
                    else:
                        break

        # Check for exponent
        if self.lex_pos < self.lex_source.byte_len():
            byte ec = self.lex_peek()
            if ec == b'e' or ec == b'E':
                is_float = true
                self.lex_pos = self.lex_pos + 1
                if self.lex_pos < self.lex_source.byte_len():
                    byte sign = self.lex_peek()
                    if sign == b'+' or sign == b'-':
                        self.lex_pos = self.lex_pos + 1
                while self.lex_pos < self.lex_source.byte_len():
                    byte exp_d = self.lex_source.byte_at(self.lex_pos)
                    if not exp_d.is_digit():
                        break
                    self.lex_pos = self.lex_pos + 1

        String num_str = owned_slice(self.lex_source, start, self.lex_pos)
        String clean = str_remove_char(num_str, b'_')
        if is_float:
            float fval = parse_float(clean).unwrap_or(0.0)
            self.lex_emit(!TkFloat(fval), start, self.lex_pos)
        else:
            int ival = parse_int(clean).unwrap_or(0)
            self.lex_emit(!TkInt(ival), start, self.lex_pos)

    # ── String scanning ───────────────────────────────────────

    void lex_scan_string(&self):
        int start = self.lex_pos

        # Detect prefix using booleans
        bool is_raw = false
        bool is_byte = false
        bool is_format = false
        bool is_cstr = false
        if self.lex_peek() == b'r':
            is_raw = true
            self.lex_advance()
        elif self.lex_peek() == b'b':
            is_byte = true
            self.lex_advance()
        elif self.lex_peek() == b'f':
            is_format = true
            self.lex_advance()
        elif self.lex_peek() == b'c':
            is_cstr = true
            self.lex_advance()

        # Capture and skip opening quote (may be " or ')
        byte quote_char = self.lex_peek()
        self.lex_advance()

        # Check for triple-quote
        bool triple = false
        if quote_char == b'"' and self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek() == b'"' and self.lex_peek_at(1) == b'"':
            triple = true
            self.lex_pos = self.lex_pos + 2

        Vector[StringSegment] segments = Vector[StringSegment]()
        String current_lit = ""

        while self.lex_pos < self.lex_source.byte_len():
            # Check for closing quote(s)
            if triple:
                if self.lex_pos + 2 < self.lex_source.byte_len() and self.lex_peek() == b'"' and self.lex_peek_at(1) == b'"' and self.lex_peek_at(2) == b'"':
                    self.lex_pos = self.lex_pos + 3
                    break
            else:
                if self.lex_peek() == quote_char:
                    self.lex_advance()
                    break

            # Newline in non-triple string is an error
            if self.lex_peek() == b'\n' and not triple:
                self.lex_diagnostics.push(Diagnostic.error(Span(start, self.lex_pos), DkLexError(), "unterminated string"))
                break

            # Escape sequences (not in raw strings)
            if self.lex_peek() == b'\\' and not is_raw:
                self.lex_advance()
                Option[String] esc = self.lex_parse_escape()
                match esc:
                    case Some(c):
                        current_lit = current_lit + c
                    else:
                        self.lex_diagnostics.push(Diagnostic.error(Span(start, self.lex_pos), DkLexError(), "unterminated string"))
                        break
                continue

            # String interpolation: {expr} — only in f-strings
            if self.lex_peek() == b'{' and is_format:
                # Check for escaped brace: {{
                if self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'{':
                    current_lit = current_lit + "{"
                    self.lex_pos = self.lex_pos + 2
                    continue

                # Flush current literal
                if current_lit.len() > 0:
                    segments.push(SegLiteral(current_lit))
                    current_lit = ""

                # Scan interpolation expression
                self.lex_advance()
                int expr_start = self.lex_pos
                int brace_depth = 1
                while self.lex_pos < self.lex_source.byte_len() and brace_depth > 0:
                    byte bc = self.lex_peek()
                    if bc == b'{':
                        brace_depth = brace_depth + 1
                    elif bc == b'}':
                        brace_depth = brace_depth - 1
                        if brace_depth == 0:
                            break
                    elif bc == b'"':
                        # Skip nested string
                        self.lex_advance()
                        while self.lex_pos < self.lex_source.byte_len() and self.lex_peek() != b'"':
                            if self.lex_peek() == b'\\':
                                self.lex_advance()
                            self.lex_advance()
                    self.lex_advance()

                String expr_text = owned_slice(self.lex_source, expr_start, self.lex_pos)
                String expr_only = split_interpolation_expr(expr_text)
                Option[String] spec_opt = split_interpolation_spec_part(expr_text)
                segments.push(SegInterpolation(expr_only, spec_opt))
                if self.lex_pos < self.lex_source.byte_len():
                    self.lex_advance()
                continue

            # Escaped brace: }} — only in f-strings
            if self.lex_peek() == b'}' and is_format:
                if self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'}':
                    current_lit = current_lit + "}"
                    self.lex_pos = self.lex_pos + 2
                    continue

            # Regular character
            current_lit = current_lit + owned_slice(self.lex_source, self.lex_pos, self.lex_pos + 1)
            self.lex_advance()

        if current_lit.len() > 0:
            segments.push(SegLiteral(current_lit))

        StringKind final_kind = SkNormal()
        if is_raw:
            final_kind = SkRaw()
        elif is_byte:
            final_kind = SkByte()
        elif is_cstr:
            final_kind = SkCStr()
        elif is_format:
            final_kind = SkFormat()
        elif triple:
            final_kind = SkMultiLine()
        auto slit = StringLiteral(final_kind, segments)
        self.lex_emit(!TkString(slit), start, self.lex_pos)

    # ── Single-quoted literal scanning ────────────────────────
    # Single-quoted literals are just strings in Gorget (same as Rust lexer).

    void lex_scan_char_lit(&self):
        int start = self.lex_pos
        self.lex_advance()  # skip opening '

        String lit = ""
        while not self.lex_at_end() and self.lex_peek() != b'\'' and self.lex_peek() != b'\n':
            if self.lex_peek() == b'\\':
                self.lex_advance()
                Option[String] esc = self.lex_parse_escape()
                match esc:
                    case Some(c):
                        lit = lit + c
                    else:
                        self.lex_diagnostics.push(Diagnostic.error(Span(start, self.lex_pos), DkLexError(), "unterminated char literal"))
                        self.lex_emit(!TkError("unterminated char"), start, self.lex_pos)
                        return
            else:
                lit = lit + owned_slice(self.lex_source, self.lex_pos, self.lex_pos + 1)
                self.lex_advance()

        if self.lex_at_end() or self.lex_peek() == b'\n':
            self.lex_diagnostics.push(Diagnostic.error(Span(start, self.lex_pos), DkLexError(), "unterminated char literal"))
            self.lex_emit(!TkError("unterminated char"), start, self.lex_pos)
            return

        self.lex_advance()  # skip closing '

        Vector[StringSegment] segs = Vector[StringSegment]()
        segs.push(SegLiteral(lit))
        auto slit = StringLiteral(SkNormal(), segs)
        self.lex_emit(!TkString(slit), start, self.lex_pos)

    # ── Operator scanning ─────────────────────────────────────

    void lex_scan_operator(&self):
        int start = self.lex_pos
        byte c = self.lex_peek()
        int remaining = self.lex_source.byte_len() - self.lex_pos

        # Three-char operators
        if remaining >= 3:
            byte c2 = self.lex_peek_at(1)
            byte c3 = self.lex_peek_at(2)
            if c == b'.' and c2 == b'.' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkDotDotEq(), start, self.lex_pos)
                return
            elif c == b'<' and c2 == b'<' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkLtLtEq(), start, self.lex_pos)
                return
            elif c == b'>' and c2 == b'>' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkGtGtEq(), start, self.lex_pos)
                return
            elif c == b'+' and c2 == b'%' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkPlusPercentEq(), start, self.lex_pos)
                return
            elif c == b'-' and c2 == b'%' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkMinusPercentEq(), start, self.lex_pos)
                return
            elif c == b'*' and c2 == b'%' and c3 == b'=':
                self.lex_pos = self.lex_pos + 3
                self.lex_emit(!TkStarPercentEq(), start, self.lex_pos)
                return

        # Two-char operators
        if remaining >= 2:
            byte c2 = self.lex_peek_at(1)
            if c == b'.' and c2 == b'.':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkDotDot(), start, self.lex_pos)
                return
            elif c == b'?' and c2 == b'.':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkQuestionDot(), start, self.lex_pos)
                return
            elif c == b'?' and c2 == b'?':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkDoubleQuestion(), start, self.lex_pos)
                return
            elif c == b'=' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkEqEq(), start, self.lex_pos)
                return
            elif c == b'!' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkBangEq(), start, self.lex_pos)
                return
            elif c == b'<' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkLtEq(), start, self.lex_pos)
                return
            elif c == b'>' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkGtEq(), start, self.lex_pos)
                return
            elif c == b'<' and c2 == b'<':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkLtLt(), start, self.lex_pos)
                return
            elif c == b'>' and c2 == b'>':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkGtGt(), start, self.lex_pos)
                return
            elif c == b'+' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkPlusEq(), start, self.lex_pos)
                return
            elif c == b'-' and c2 == b'>':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkArrow(), start, self.lex_pos)
                return
            elif c == b'-' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkMinusEq(), start, self.lex_pos)
                return
            elif c == b'*' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkStarEq(), start, self.lex_pos)
                return
            elif c == b'/' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkSlashEq(), start, self.lex_pos)
                return
            elif c == b'%' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkPercentEq(), start, self.lex_pos)
                return
            elif c == b'+' and c2 == b'%':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkPlusPercent(), start, self.lex_pos)
                return
            elif c == b'-' and c2 == b'%':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkMinusPercent(), start, self.lex_pos)
                return
            elif c == b'*' and c2 == b'%':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkStarPercent(), start, self.lex_pos)
                return
            elif c == b'&' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkAmpEq(), start, self.lex_pos)
                return
            elif c == b'|' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkPipeEq(), start, self.lex_pos)
                return
            elif c == b'^' and c2 == b'=':
                self.lex_pos = self.lex_pos + 2
                self.lex_emit(!TkCaretEq(), start, self.lex_pos)
                return

        # Single-char operators and delimiters
        self.lex_advance()
        if c == b'+':
            self.lex_emit(!TkPlus(), start, self.lex_pos)
        elif c == b'-':
            self.lex_emit(!TkMinus(), start, self.lex_pos)
        elif c == b'*':
            self.lex_emit(!TkStar(), start, self.lex_pos)
        elif c == b'/':
            self.lex_emit(!TkSlash(), start, self.lex_pos)
        elif c == b'%':
            self.lex_emit(!TkPercent(), start, self.lex_pos)
        elif c == b'=':
            self.lex_emit(!TkEq(), start, self.lex_pos)
        elif c == b'<':
            self.lex_emit(!TkLt(), start, self.lex_pos)
        elif c == b'>':
            self.lex_emit(!TkGt(), start, self.lex_pos)
        elif c == b'!':
            self.lex_emit(!TkBang(), start, self.lex_pos)
        elif c == b'&':
            self.lex_emit(!TkAmpersand(), start, self.lex_pos)
        elif c == b'|':
            self.lex_emit(!TkPipe(), start, self.lex_pos)
        elif c == b'^':
            self.lex_emit(!TkCaret(), start, self.lex_pos)
        elif c == b'~':
            self.lex_emit(!TkTilde(), start, self.lex_pos)
        elif c == b'.':
            self.lex_emit(!TkDot(), start, self.lex_pos)
        elif c == b'?':
            self.lex_emit(!TkQuestion(), start, self.lex_pos)
        elif c == b'@':
            self.lex_emit(!TkAt(), start, self.lex_pos)
        elif c == b'(':
            self.lex_bracket_depth = self.lex_bracket_depth + 1
            self.lex_emit(!TkLParen(), start, self.lex_pos)
        elif c == b')':
            if self.lex_bracket_depth > 0:
                self.lex_bracket_depth = self.lex_bracket_depth - 1
            self.lex_emit(!TkRParen(), start, self.lex_pos)
        elif c == b'[':
            self.lex_bracket_depth = self.lex_bracket_depth + 1
            self.lex_emit(!TkLBracket(), start, self.lex_pos)
        elif c == b']':
            if self.lex_bracket_depth > 0:
                self.lex_bracket_depth = self.lex_bracket_depth - 1
            self.lex_emit(!TkRBracket(), start, self.lex_pos)
        elif c == b'{':
            self.lex_bracket_depth = self.lex_bracket_depth + 1
            self.lex_emit(!TkLBrace(), start, self.lex_pos)
        elif c == b'}':
            if self.lex_bracket_depth > 0:
                self.lex_bracket_depth = self.lex_bracket_depth - 1
            self.lex_emit(!TkRBrace(), start, self.lex_pos)
        elif c == b':':
            self.lex_emit(!TkColon(), start, self.lex_pos)
        elif c == b',':
            self.lex_emit(!TkComma(), start, self.lex_pos)
        else:
            self.lex_diagnostics.push(Diagnostic.error(Span(start, self.lex_pos), DkLexError(), "unexpected character"))
            self.lex_emit(!TkError("unexpected character"), start, self.lex_pos)

    # ── Comment scanning ──────────────────────────────────────

    void lex_scan_comment(&self):
        int start = self.lex_pos
        self.lex_advance()

        # Check for doc comment (## ...)
        if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b'#':
            self.lex_advance()
            # Skip leading space
            if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b' ':
                self.lex_advance()
            int content_start = self.lex_pos
            self.lex_skip_to_eol()
            String content = owned_slice(self.lex_source, content_start, self.lex_pos)
            self.lex_emit(!TkDocComment(content), start, self.lex_pos)
            return

        # Regular comment: skip leading space
        if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b' ':
            self.lex_advance()
        int content_start = self.lex_pos
        self.lex_skip_to_eol()
        String content = owned_slice(self.lex_source, content_start, self.lex_pos)
        self.lex_emit(!TkComment(content), start, self.lex_pos)

    # ── Tokenize one line's content ───────────────────────────

    void lex_tokenize_line(&self):
        while self.lex_pos < self.lex_source.byte_len():
            byte c = self.lex_source.byte_at(self.lex_pos)

            # End of line
            if c == b'\n':
                return

            # Skip whitespace within line
            if c == b' ' or c == b'\t':
                self.lex_pos = self.lex_pos + 1
                continue

            # Comment
            if c == b'#':
                self.lex_scan_comment()
                return

            # String literals (including r"..." and b"...")
            if c == b'"':
                self.lex_scan_string()
                continue
            if c == b'r' and self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'"':
                self.lex_scan_string()
                continue
            if c == b'b' and self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'"':
                self.lex_scan_string()
                continue

            # f-string: f"..." or f'...'
            if c == b'f' and self.lex_pos + 1 < self.lex_source.byte_len():
                byte next_c = self.lex_peek_at(1)
                if next_c == b'"' or next_c == b'\'':
                    self.lex_scan_string()
                    continue

            # c-string: c"..."
            if c == b'c' and self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'"':
                self.lex_scan_string()
                continue

            # Single-quoted literal (becomes TkString)
            if c == b'\'':
                self.lex_scan_char_lit()
                continue

            # Identifier or keyword
            if c.is_alpha() or c == b'_':
                self.lex_scan_identifier()
                continue

            # Number
            if c.is_digit():
                self.lex_scan_number()
                continue

            # Operator or delimiter
            self.lex_scan_operator()

    # ── Main loop: scan line by line ──────────────────────────

    void lex_scan_next_line(&self):
        if self.lex_pos >= self.lex_source.byte_len():
            self.lex_emit_eof()
            return

        # Skip blank lines and comment-only lines
        while self.lex_pos < self.lex_source.byte_len():
            int line_start = self.lex_pos
            int spaces = self.lex_count_leading_spaces()

            if self.lex_pos >= self.lex_source.byte_len():
                self.lex_emit_eof()
                return

            byte c = self.lex_source.byte_at(self.lex_pos)

            # Blank line
            if c == b'\n':
                self.lex_pos = self.lex_pos + 1
                continue

            # Comment-only line (not doc comment)
            if c == b'#':
                if self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) == b'#':
                    # Doc comment — treat as content
                    pass
                else:
                    # Regular comment — emit and skip line
                    self.lex_scan_comment()
                    if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b'\n':
                        self.lex_pos = self.lex_pos + 1
                    continue

            # Leading dot continuation (suppress indentation processing)
            if c == b'.' and self.lex_bracket_depth == 0:
                if self.lex_pos + 1 < self.lex_source.byte_len() and self.lex_peek_at(1) != b'.':
                    self.lex_emit_newline_if_needed(line_start)
                    self.lex_tokenize_line()
                    if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b'\n':
                        self.lex_pos = self.lex_pos + 1
                    self.lex_need_newline = true
                    return

            # Process indentation (only when not inside brackets)
            if self.lex_bracket_depth == 0:
                self.lex_emit_newline_if_needed(line_start)
                self.lex_process_indentation(spaces, line_start)

            # Tokenize the line content
            self.lex_tokenize_line()
            if self.lex_pos < self.lex_source.byte_len() and self.lex_peek() == b'\n':
                self.lex_pos = self.lex_pos + 1
            self.lex_need_newline = true
            return

        self.lex_emit_eof()

    void lex_all(&self):
        while not self.lex_finished:
            self.lex_scan_next_line()

# ── Helper functions ──────────────────────────────────────────

String str_remove_char(String s, byte target):
    String result = ""
    int i = 0
    while i < s.byte_len():
        byte c = s.byte_at(i)
        if c != target:
            result = result + s.byte_slice(i, i + 1)
        i = i + 1
    return result

# Strip an f-string interpolation's trailing format spec, mirroring Rust
# `split_interpolation_spec` (src/lexer/mod.rs:940). Splits on the LAST `:`
# at paren+bracket+brace depth 0, outside quoted strings, and only when the
# spec (everything after the colon) is non-empty. Returns the expr text with
# the spec removed: `x:x` → `x`, `d[1:3]` → `d[1:3]` (unchanged).
String split_interpolation_expr(String text):
    int n = text.byte_len()
    int last_colon = -1
    int paren_depth = 0
    int bracket_depth = 0
    int brace_depth = 0
    int i = 0
    while i < n:
        byte c = text.byte_at(i)
        if c == b'(':
            paren_depth = paren_depth + 1
        elif c == b')':
            if paren_depth > 0:
                paren_depth = paren_depth - 1
        elif c == b'[':
            bracket_depth = bracket_depth + 1
        elif c == b']':
            if bracket_depth > 0:
                bracket_depth = bracket_depth - 1
        elif c == b'{':
            brace_depth = brace_depth + 1
        elif c == b'}':
            if brace_depth > 0:
                brace_depth = brace_depth - 1
        elif c == b'"' or c == b'\'':
            # Skip the quoted string (honoring backslash escapes).
            byte quote = c
            i = i + 1
            while i < n and text.byte_at(i) != quote:
                if text.byte_at(i) == b'\\':
                    i = i + 1
                i = i + 1
            # Advance past the closing quote (loop's i+1 below).
        elif c == b':' and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
            last_colon = i
        i = i + 1
    if last_colon >= 0 and last_colon + 1 < n:
        # Non-empty spec → keep only the text before the colon.
        return owned_slice(text, 0, last_colon)
    return text

# Sibling of `split_interpolation_expr`: returns the depth-0 format SPEC
# (everything after the last depth-0 `:`), or `None` if there is no depth-0
# colon or the spec is empty. Mirrors Rust `split_interpolation_spec`'s
# `Option<String>` return (src/lexer/mod.rs:997). The self-host has no tuple
# returns, so this re-walks the text rather than returning a pair from the
# expr splitter; the two share the exact same depth-0 scan logic.
Option[String] split_interpolation_spec_part(String text):
    int n = text.byte_len()
    int last_colon = -1
    int paren_depth = 0
    int bracket_depth = 0
    int brace_depth = 0
    int i = 0
    while i < n:
        byte c = text.byte_at(i)
        if c == b'(':
            paren_depth = paren_depth + 1
        elif c == b')':
            if paren_depth > 0:
                paren_depth = paren_depth - 1
        elif c == b'[':
            bracket_depth = bracket_depth + 1
        elif c == b']':
            if bracket_depth > 0:
                bracket_depth = bracket_depth - 1
        elif c == b'{':
            brace_depth = brace_depth + 1
        elif c == b'}':
            if brace_depth > 0:
                brace_depth = brace_depth - 1
        elif c == b'"' or c == b'\'':
            byte quote = c
            i = i + 1
            while i < n and text.byte_at(i) != quote:
                if text.byte_at(i) == b'\\':
                    i = i + 1
                i = i + 1
        elif c == b':' and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0:
            last_colon = i
        i = i + 1
    if last_colon >= 0 and last_colon + 1 < n:
        return Some(owned_slice(text, last_colon + 1, n))
    return None()

int lex_parse_int_radix(String s, int radix):
    int result = 0
    int i = 0
    while i < s.byte_len():
        byte c = s.byte_at(i)
        int digit = 0
        if c >= b'0' and c <= b'9':
            digit = c as int - b'0'
        elif c >= b'a' and c <= b'f':
            digit = c as int - b'a' + 10
        elif c >= b'A' and c <= b'F':
            digit = c as int - b'A' + 10
        result = result * radix + digit
        i = i + 1
    return result

# ── Public API ────────────────────────────────────────────────

# Result of lexing: the token stream plus any diagnostics gathered
# along the way. Malformed-literal sites (unterminated string / char /
# escape; unexpected character) don't abort — they get recorded as
# typed Diagnostics so downstream stages can still run on a best-
# effort token stream. Mirrors the parser's `ParseResult` shape.
struct LexResult:
    Vector[SpannedToken] tokens
    Vector[Diagnostic] diagnostics

# Tokenize `source` and return both the token stream and the collected
# diagnostics. Comparison drivers / CLIs use this entry point when they
# need to surface lexer errors; the older `lex_tokenize` keeps a
# tokens-only signature for callers (e.g. main.gg, the parser's
# `parse_source`) that don't consume the diagnostic stream.
LexResult lex_with_diagnostics(String source):
    Vector[int] indent = Vector[int]()
    indent.push(0)
    Lexer l = Lexer(source, 0, indent, 0, Vector[SpannedToken](), false, false, Vector[Diagnostic]())
    l.lex_all()
    return LexResult(l.lex_tokens, l.lex_diagnostics)

Vector[SpannedToken] lex_tokenize(String source):
    LexResult r = lex_with_diagnostics(source)
    return r.tokens
