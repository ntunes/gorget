#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; its own header says "(no TCP)"
# Test: Router dispatch edge cases (no TCP).
#
# Validates:
#   - Method mismatch: POST /hello (only GET registered) → 405 Method Not Allowed
#   - Param route with wrong segment count → 404
#   - Trailing slash: GET /hello/ vs GET /hello → different keys
#   - Dispatch with no routes → 404
#   - Correct param route selected (POST param route)
#   - Middleware execution order: 3 middlewares, applied in registration order
#
# Expected output:
#   405\n404\n404\n404\npost:7\nbase-mw1-mw2-mw3

from xtd.httpserver import Router, HttpRequest, HttpServerResponse
from std.collections import Dict

HttpServerResponse handle_hello(HttpRequest req):
    return HttpServerResponse.ok("hello")

HttpServerResponse handle_user(HttpRequest req):
    return HttpServerResponse.ok("user:" + req.params["id"])

HttpServerResponse handle_post_item(HttpRequest req):
    return HttpServerResponse.ok("post:" + req.params["id"])

HttpServerResponse mw1(HttpRequest req, HttpServerResponse resp):
    return HttpServerResponse(resp.status_code, resp.body + "-mw1", resp.content_type, resp.headers.clone())

HttpServerResponse mw2(HttpRequest req, HttpServerResponse resp):
    return HttpServerResponse(resp.status_code, resp.body + "-mw2", resp.content_type, resp.headers.clone())

HttpServerResponse mw3(HttpRequest req, HttpServerResponse resp):
    return HttpServerResponse(resp.status_code, resp.body + "-mw3", resp.content_type, resp.headers.clone())

void main():
    Router router = Router.new()
    router.get("/hello", handle_hello)
    router.get("/users/:id", handle_user)
    router.post("/posts/:id", handle_post_item)

    # 1. Method mismatch: POST /hello (only GET registered) → 405
    HttpRequest req1 = HttpRequest("POST", "/hello", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp1 = router.dispatch(req1)
    print(f"{resp1.status_code}")

    # 2. Param route with wrong segment count → 404
    HttpRequest req2 = HttpRequest("GET", "/users/42/extra", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp2 = router.dispatch(req2)
    print(f"{resp2.status_code}")

    # 3. Trailing slash: GET /hello/ → 404 (registered as /hello, not /hello/)
    HttpRequest req3 = HttpRequest("GET", "/hello/", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp3 = router.dispatch(req3)
    print(f"{resp3.status_code}")

    # 4. Empty router → 404
    Router empty_router = Router.new()
    HttpRequest req4 = HttpRequest("GET", "/anything", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp4 = empty_router.dispatch(req4)
    print(f"{resp4.status_code}")

    # 5. POST param route correctly selected
    HttpRequest req5 = HttpRequest("POST", "/posts/7", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp5 = router.dispatch(req5)
    print(resp5.body)

    # 6. Middleware execution order: 3 middlewares, body accumulates suffixes
    Router mw_router = Router.new()
    mw_router.get("/base", (r): HttpServerResponse.ok("base"))
    mw_router.use(mw1)
    mw_router.use(mw2)
    mw_router.use(mw3)
    HttpRequest req6 = HttpRequest("GET", "/base", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse resp6 = mw_router.dispatch(req6)
    print(resp6.body)
