# CORE #11/#12 REGRESSION — `Deque[S]` where `S` has ≥2 fields silently
# TRUNCATES to 8 bytes per element on both C and LLVM.
#
# AXIS PIN: Deque[S] multi-field struct payload · push + `d[i].fd` index
# read · elem-size derivation via `elem_size_from_monomorphized`
# (src/lir/lower/types.rs). Pre-Round XXVI Track D this fn had no
# `Deque__` arm, so the caller at `insts.rs:3857` fell to
# `.unwrap_or(8)` and `gorget_array_new(8)` — every slot 8 bytes for a
# 24-byte struct.
#
# RED-VERIFIED PRE-FIX (Round XXVI Track D scout 2026-08-02): printed
# `1 / 0 / 0` and `2 / 0 / 0` (or garbage in y/z from the following
# push's `x`) on BOTH C and LLVM. Single-int-field `struct S: int fd`
# was accidentally correct via the 8-byte fallback (Core #15e Q6);
# multi-field structs are the axis cell that exposes the truncation.
#
# INTENDED post-fix: `1 / 2 / 3` then `4 / 5 / 6`.
from std.collections import Deque

struct Point:
    int x
    int y
    int z

void main():
    Deque[Point] d = Deque[Point]()
    d.push(Point(1, 2, 3))
    d.push(Point(4, 5, 6))
    print(d[0].x)
    print(d[0].y)
    print(d[0].z)
    print(d[1].x)
    print(d[1].y)
    print(d[1].z)
