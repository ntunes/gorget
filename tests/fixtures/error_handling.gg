int risky(int x) throws String:
    if x < 0:
        throw "negative input"
    return x * 2

int throw_var(String msg) throws String:
    throw msg
    return 0

int propagate(int x) throws String:
    int val = risky(x)!
    return val + 1

void main():
    # catch — success passes through
    int a = risky(5)! catch (e): -1
    print(f"{a}")

    # catch — error uses fallback
    int b = risky(-1)! catch (e): -1
    print(f"{b}")

    # catch on a function that always throws
    int c = throw_var("variable error")! catch (e): -1
    print(f"{c}")

    # catch on propagated success
    int d = propagate(5)! catch (e): -1
    print(f"{d}")

    # Result capture for full control
    Result[int, String] r = propagate(-1)
    match r:
        case Ok(v): print(f"{v}")
        case Error(e): print(f"caught: {e}")

    print("done")
