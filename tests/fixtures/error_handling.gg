int risky(int x) throws str:
    if x < 0:
        throw "negative input"
    return x * 2

int throw_var(str msg) throws str:
    throw msg
    return 0

int propagate(int x) throws str:
    int val = risky(x)
    return val + 1

void main():
    # raw capture — success case
    int a = raw risky(5)
    print(f"{a}")

    # raw capture — error case (returns zero-default)
    int b = raw risky(-1)
    print(f"{b}")

    # throw with a str variable (not a literal)
    int c = raw throw_var("variable error")
    print(f"{c}")

    # ? operator propagates errors through wrapper
    int d = raw propagate(5)
    print(f"{d}")

    int e = raw propagate(-1)
    print(f"{e}")

    print("done")
