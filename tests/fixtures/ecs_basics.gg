from std.collections import Vector
from xtd.ecs import EntityPool, SparseSet

struct Health:
    int hp
    int max_hp

void main():
    # EntityPool.new() factory
    EntityPool pool = EntityPool.new()
    Entity e1 = pool.create()
    Entity e2 = pool.create()
    print(e1.id)
    print(e2.id)
    print(pool.count())
    print(pool.max_id())

    # Destroy and recycle — generation bumped on recycle
    pool.destroy(e1)
    Entity e3 = pool.create()
    print(e3.id)
    print(pool.count())

    # Destroy out-of-range or stale — should be ignored
    pool.destroy(Entity(-1, 0))
    pool.destroy(Entity(999, 0))
    print(pool.count())

    # SparseSet basics
    SparseSet[Health] health = SparseSet[Health].new()
    health.insert(e2, Health(100, 100))
    health.insert(e3, Health(80, 80))
    print(health.len())
    print(health.has(e2))
    print(health.has(e1))

    # get
    Health h = health.get(e2)
    print(h.hp)

    # has with negative ID — should return false
    print(health.has(Entity(-5, 0)))

    # set with bounds check
    health.set(e2, Health(50, 100))
    Health h2 = health.get(e2)
    print(h2.hp)

    # set on missing entity — should silently no-op
    health.set(Entity(999, 0), Health(1, 1))
    print(health.len())

    # insert updates existing
    health.insert(e2, Health(75, 100))
    Health h3 = health.get(e2)
    print(h3.hp)

    # remove
    health.remove(e2)
    print(health.len())
    print(health.has(e2))

    # iteration via for-in
    SparseSet[Health] store = SparseSet[Health].new()
    Entity se1 = Entity(10, 0)
    Entity se2 = Entity(20, 0)
    Entity se3 = Entity(30, 0)
    store.insert(se1, Health(100, 100))
    store.insert(se2, Health(200, 200))
    store.insert(se3, Health(300, 300))
    for e in store:
        Health s = store.get(e)
        print(f"{e.id}:{s.hp}")

    # entity_at / data_at
    print(store.entity_at(0).id)
    Health d = store.data_at(1)
    print(d.hp)

    # Generational safety: stale handle detection
    print(pool.is_alive(e3))
    print(pool.is_alive(e1))

    # Double-destroy is idempotent — count stays correct
    pool.destroy(e2)
    pool.destroy(e2)
    print(pool.count())

    # SparseSet.new() factory
    SparseSet[Health] ns = SparseSet[Health].new()
    ns.insert(e3, Health(50, 100))
    print(ns.len())

    # try_get — present
    Option[Health] got = ns.try_get(e3)
    match got:
        case Some(h):
            print(h.hp)
        case None:
            print("none")

    # try_get — absent (e2 was removed earlier)
    Option[Health] miss = ns.try_get(e2)
    match miss:
        case Some(h):
            print(h.hp)
        case None:
            print("none")

    # each()
    ns.insert(Entity(5, 0), Health(99, 100))
    ns.each((Entity e, Health h): print(f"{e.id}:{h.hp}"))
