from std.yaml import Yaml, yaml_parse, yaml_parse_all, yaml_stringify, yaml_stringify_all, yaml_pretty, yaml_pretty_all
from std.collections import Vector, Dict

void main():
    # ── Block mapping ────────────────────────────────────────
    str yaml_block_map = "name: Alice\nage: 30\nactive: true\n"
    Yaml yaml_bm = yaml_parse(yaml_block_map).unwrap()
    print(yaml_bm.get("name").as_str())
    int yaml_age = yaml_bm.get("age").as_int()
    print("{yaml_age}")
    bool yaml_active = yaml_bm.get("active").as_bool()
    print("{yaml_active}")

    # ── Block sequence ───────────────────────────────────────
    str yaml_block_seq = "- apple\n- banana\n- cherry\n"
    Yaml yaml_bs = yaml_parse(yaml_block_seq).unwrap()
    print(yaml_bs.at(0).as_str())
    print(yaml_bs.at(1).as_str())
    print(yaml_bs.at(2).as_str())
    int yaml_seq_len = yaml_bs.len()
    print("{yaml_seq_len}")

    # ── Nested mapping/sequence ──────────────────────────────
    str yaml_nested = "server:\n  host: localhost\n  port: 8080\nitems:\n  - one\n  - two\n"
    Yaml yaml_n = yaml_parse(yaml_nested).unwrap()
    print(yaml_n.get("server").get("host").as_str())
    int yaml_port = yaml_n.get("server").get("port").as_int()
    print("{yaml_port}")
    print(yaml_n.get("items").at(0).as_str())
    print(yaml_n.get("items").at(1).as_str())

    # ── Flow mapping ─────────────────────────────────────────
    str yaml_flow_map_str = r"{a: 1, b: 2}"
    Yaml yaml_fm = yaml_parse(yaml_flow_map_str).unwrap()
    int yaml_fa = yaml_fm.get("a").as_int()
    int yaml_fb = yaml_fm.get("b").as_int()
    print("{yaml_fa}")
    print("{yaml_fb}")

    # ── Flow sequence ────────────────────────────────────────
    str yaml_flow_seq_str = "[10, 20, 30]"
    Yaml yaml_fs = yaml_parse(yaml_flow_seq_str).unwrap()
    int yaml_f0 = yaml_fs.at(0).as_int()
    int yaml_f1 = yaml_fs.at(1).as_int()
    int yaml_f2 = yaml_fs.at(2).as_int()
    print("{yaml_f0}")
    print("{yaml_f1}")
    print("{yaml_f2}")

    # ── Quoted scalars ───────────────────────────────────────
    str yaml_quoted = "dq: \"hello world\"\nsq: 'it''s fine'\n"
    Yaml yaml_q = yaml_parse(yaml_quoted).unwrap()
    print(yaml_q.get("dq").as_str())
    print(yaml_q.get("sq").as_str())

    # ── Scalar resolution ────────────────────────────────────
    str yaml_scalars = "n1: null\nn2: ~\nb1: true\nb2: false\ni1: 42\ni2: -7\nf1: 3.14\ns1: just a string\n"
    Yaml yaml_sc = yaml_parse(yaml_scalars).unwrap()
    bool yaml_n1_null = yaml_sc.get("n1").is_null()
    bool yaml_n2_null = yaml_sc.get("n2").is_null()
    print("{yaml_n1_null}")
    print("{yaml_n2_null}")
    bool yaml_b1 = yaml_sc.get("b1").as_bool()
    bool yaml_b2 = yaml_sc.get("b2").as_bool()
    print("{yaml_b1}")
    print("{yaml_b2}")
    int yaml_i1 = yaml_sc.get("i1").as_int()
    int yaml_i2 = yaml_sc.get("i2").as_int()
    print("{yaml_i1}")
    print("{yaml_i2}")
    float yaml_f1v = yaml_sc.get("f1").as_float()
    print("{yaml_f1v}")
    print(yaml_sc.get("s1").as_str())

    # ── Comments ─────────────────────────────────────────────
    str yaml_comments = "# This is a comment\nkey: value # inline comment\n"
    Yaml yaml_c = yaml_parse(yaml_comments).unwrap()
    print(yaml_c.get("key").as_str())

    # ── Document markers ─────────────────────────────────────
    str yaml_doc_markers = "---\ntitle: Hello\n..."
    Yaml yaml_dm = yaml_parse(yaml_doc_markers).unwrap()
    print(yaml_dm.get("title").as_str())

    # ── Stringify round-trip ─────────────────────────────────
    str yaml_rt_str = yaml_stringify(yaml_fs)
    print(yaml_rt_str)

    # ── Pretty print ─────────────────────────────────────────
    str yaml_pp = yaml_pretty(yaml_bm)
    print(yaml_pp)

    # ── Accessor methods ─────────────────────────────────────
    bool yaml_has_name = yaml_bm.has("name")
    bool yaml_has_missing = yaml_bm.has("missing")
    print("{yaml_has_name}")
    print("{yaml_has_missing}")

    bool yaml_has_idx0 = yaml_bs.has_index(0)
    bool yaml_has_idx5 = yaml_bs.has_index(5)
    print("{yaml_has_idx0}")
    print("{yaml_has_idx5}")

    bool yaml_is_obj = yaml_bm.is_object()
    bool yaml_is_arr = yaml_bs.is_array()
    bool yaml_is_str = yaml_bm.get("name").is_string()
    bool yaml_is_num = yaml_bm.get("age").is_number()
    bool yaml_is_bval = yaml_bm.get("active").is_bool()
    print("{yaml_is_obj}")
    print("{yaml_is_arr}")
    print("{yaml_is_str}")
    print("{yaml_is_num}")
    print("{yaml_is_bval}")

    int yaml_map_len = yaml_bm.len()
    print("{yaml_map_len}")

    Vector[str] yaml_ks = yaml_bm.keys()
    print(yaml_ks.get(0).unwrap())

    # ── Error case ───────────────────────────────────────────
    str yaml_bad_input = r"{unclosed: true"
    Result[Yaml, str] yaml_bad = yaml_parse(yaml_bad_input)
    bool yaml_is_err = yaml_bad.is_err()
    print("{yaml_is_err}")

    # ── Phase 2: Literal block scalar ─────────────────────
    str yaml_lit_src = "text: |\n  line 1\n  line 2\n  line 3\n"
    Yaml yaml_lit = yaml_parse(yaml_lit_src).unwrap()
    str yaml_lit_val = yaml_lit.get("text").as_str()
    print("literal:")
    print(yaml_lit_val)

    # ── Phase 2: Folded block scalar ──────────────────────
    str yaml_fold_src = "text: >\n  This is\n  a paragraph.\n\n  Another one.\n"
    Yaml yaml_fold = yaml_parse(yaml_fold_src).unwrap()
    str yaml_fold_val = yaml_fold.get("text").as_str()
    print("folded:")
    print(yaml_fold_val)

    # ── Phase 2: Chomping: strip ──────────────────────────
    str yaml_strip_src = "text: |-\n  no trailing\n"
    Yaml yaml_strip = yaml_parse(yaml_strip_src).unwrap()
    str yaml_strip_val = yaml_strip.get("text").as_str()
    print("strip:")
    print(yaml_strip_val)
    print("end-strip")

    # ── Phase 2: Chomping: keep ───────────────────────────
    str yaml_keep_src = "text: |+\n  keep trailing\n\n\n"
    Yaml yaml_keep = yaml_parse(yaml_keep_src).unwrap()
    str yaml_keep_val = yaml_keep.get("text").as_str()
    print("keep:")
    print(yaml_keep_val)
    print("end-keep")

    # ── Phase 2: Multi-line plain scalar ──────────────────
    str yaml_mlp_src = "desc: This is\n  a multi-line\n  plain scalar.\nother: val\n"
    Yaml yaml_mlp = yaml_parse(yaml_mlp_src).unwrap()
    print(yaml_mlp.get("desc").as_str())
    print(yaml_mlp.get("other").as_str())

    # ── Phase 2: Block scalar in sequence ─────────────────
    str yaml_seq_bs = "items:\n  - |\n    first item\n    multi line\n  - second\n"
    Yaml yaml_seq_bs_v = yaml_parse(yaml_seq_bs).unwrap()
    print(yaml_seq_bs_v.get("items").at(0).as_str())
    print(yaml_seq_bs_v.get("items").at(1).as_str())

    # ── Phase 2: Folded with more-indented lines ──────────
    str yaml_fold_mi = "text: >\n  paragraph\n    indented line\n  back to normal\n"
    Yaml yaml_fold_mi_v = yaml_parse(yaml_fold_mi).unwrap()
    str yaml_fold_mi_val = yaml_fold_mi_v.get("text").as_str()
    print("folded-indent:")
    print(yaml_fold_mi_val)

    # ── Phase 2: Pretty-print with block scalar ──────────
    str yaml_pp_bs = "desc: |\n  multi\n  line\nname: test\n"
    Yaml yaml_pp_bs_v = yaml_parse(yaml_pp_bs).unwrap()
    str yaml_pp_bs_out = yaml_pretty(yaml_pp_bs_v)
    print("pretty-block:")
    print(yaml_pp_bs_out)

    # ── Phase 3: Multi-document parsing ─────────────────────
    str yaml_multi = "---\nfirst: 1\n---\nsecond: 2\n"
    Vector[Yaml] yaml_all = yaml_parse_all(yaml_multi).unwrap()
    int yaml_ndocs = yaml_all.len()
    print("{yaml_ndocs}")
    int yaml_d1v = yaml_all.get(0).unwrap().get("first").as_int()
    print("{yaml_d1v}")
    int yaml_d2v = yaml_all.get(1).unwrap().get("second").as_int()
    print("{yaml_d2v}")

    # ── Phase 3: Multi-doc with ... separator ─────────────
    str yaml_dots = "---\nalpha: a\n...\n---\nbeta: b\n"
    Vector[Yaml] yaml_dot_docs = yaml_parse_all(yaml_dots).unwrap()
    int yaml_ddocs = yaml_dot_docs.len()
    print("{yaml_ddocs}")
    print(yaml_dot_docs.get(0).unwrap().get("alpha").as_str())
    print(yaml_dot_docs.get(1).unwrap().get("beta").as_str())

    # ── Phase 3: Single doc via parse_all ─────────────────
    str yaml_single = "key: value\n"
    Vector[Yaml] yaml_single_docs = yaml_parse_all(yaml_single).unwrap()
    int yaml_sdocs = yaml_single_docs.len()
    print("{yaml_sdocs}")
    print(yaml_single_docs.get(0).unwrap().get("key").as_str())

    # ── Phase 3: stringify_all ────────────────────────────
    print(yaml_stringify_all(yaml_all))

    # ── Phase 3: pretty_all ──────────────────────────────
    print(yaml_pretty_all(yaml_all))

    print("done")
