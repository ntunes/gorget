# Post-D25: any `catch <Ident>(.<Ident>)?:` shape (including the former
# `Fault.Overflow` and any user-invented qualifier like `Bogus.Overflow`) is
# rejected at parse-time with `E_FaultCatchRemoved`. NEG fixture.
void main():
    int big = 9223372036854775807
    int r = (big * 2) catch Bogus.Overflow: -1
    print(f"{r}")
