# Post-D25: capture div-by-zero via D26 `/!` and `%!` (Route B) — axis:
# division fault categories.
void main():
    int z = 0
    Result[int, ArithError] r = 10 /! z
    match r:
        case Ok(v):    print(f"{v}")
        case Error(_): print("999")
    Result[int, ArithError] ok = 20 /! 4
    match ok:
        case Ok(v):    print(f"{v}")
        case Error(_): print("999")
    Result[int, ArithError] m = 10 %! z
    match m:
        case Ok(v):    print(f"{v}")
        case Error(_): print("777")
