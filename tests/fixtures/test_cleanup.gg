from std.collections import Box

struct Resource:
    String name

equip Resource with Drop:
    void drop(!self):
        String n = self.name
        print(f"dropping {n}")

test "cleanup on failure":
    Resource r = Resource("alpha")
    Box[int] b = Box(42)
    assert 1 == 2

test "cleanup on success":
    Resource r = Resource("beta")
    print("ok")
