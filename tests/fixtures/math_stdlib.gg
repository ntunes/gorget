from std.math import abs, min, max, sqrt, floor, ceil, round, sin, cos, log2, log10

void main():
    # Integer math
    print(f"{abs(-42)}")
    print(f"{abs(10)}")
    print(f"{min(3, 7)}")
    print(f"{max(3, 7)}")

    # Float math
    print(f"{sqrt(4.0)}")
    print(f"{2.0 ** 10.0}")
    print(f"{floor(3.7)}")
    print(f"{ceil(3.2)}")
    print(f"{round(3.5)}")
    print(f"{round(3.4)}")

    # Trig (sin(0) = 0, cos(0) = 1)
    print(f"{sin(0.0)}")
    print(f"{cos(0.0)}")

    # Log
    print(f"{log2(8.0)}")
    print(f"{log10(1000.0)}")

    # abs/min/max with floats (dispatches to fabs/fmin/fmax)
    print(f"{abs(-2.5)}")
    print(f"{min(1.5, 2.5)}")
    print(f"{max(1.5, 2.5)}")
