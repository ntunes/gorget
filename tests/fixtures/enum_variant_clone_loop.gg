enum Segment:
    Literal(String)
    Interp(String)

void main():
    Vector[Segment] segments = []
    String current = ""
    int i = 0
    while i < 3:
        current = current + "x"
        segments.push(Segment.Literal(current))
        i = i + 1
    int j = 0
    while j < segments.len():
        Segment seg = segments.get(j).unwrap()
        match seg:
            case Literal(s):
                print(s)
            case Interp(s):
                print(s)
        j = j + 1
