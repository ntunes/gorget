int sum_to(int n):
    int total = 0
    int i = 0
    while i < n:
        total = total + i + 1
        i = i + 1
    return total

int count_digits(int n):
    int count = 0
    while n > 0:
        n = n / 10
        count = count + 1
    return count

meta int SUM100 = sum_to(100)
meta int DIGITS = count_digits(123456)

void main():
    print(SUM100)
    print(DIGITS)
