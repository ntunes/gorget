# Test Callable, MutCallable, and MoveCallable trait types

int apply(Callable[int(int)] f, int x):
    return f(x)

int apply_mut(MutCallable[int(int)] f, int x):
    return f(x)

int apply_once(MoveCallable[int(int)] f, int x):
    return f(x)

void main():
    # Basic Callable — non-capturing closure
    int r1 = apply((n): n * 2, 5)
    print("{r1}")

    # Callable — capturing closure (immutable capture)
    int factor = 3
    int r2 = apply((n): n * factor, 7)
    print("{r2}")

    # Callable-typed local variable
    Callable[int(int)] triple = (n): n * 3
    int r3 = triple(4)
    print("{r3}")

    # MutCallable — accepts Callable closures (hierarchy coercion)
    int r4 = apply_mut((n): n + 10, 5)
    print("{r4}")

    # MutCallable — capturing closure
    int offset = 100
    int r5 = apply_mut((n): n + offset, 7)
    print("{r5}")

    # MoveCallable — accepts any closure (top of hierarchy)
    int r6 = apply_once((n): n * n, 6)
    print("{r6}")

    # Named function passed to Callable param
    int r7 = apply(double, 8)
    print("{r7}")

    # Named function passed to MutCallable (coercion)
    int r8 = apply_mut(double, 9)
    print("{r8}")

    print("done")

int double(int x):
    return x * 2
