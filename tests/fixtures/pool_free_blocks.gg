from std.alloc import PoolAllocator
from std.collections import Vector

void main():
    with PoolAllocator(64, 16) as pool:
        int initial_free = pool.free_blocks()
        print(f"initial free: {initial_free}")
        Vector[int] v = Vector[int]()
        v.push(1)
        v.push(2)
        v.push(3)
        print(f"free decreased: {pool.free_blocks() < initial_free}")
        print(f"invariant: {pool.free_blocks() + pool.used_blocks() == pool.total_blocks()}")
    print("done")
