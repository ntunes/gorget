# Fault.Bounds: an out-of-bounds array index read branches to the local
# handler instead of panicking (error-model.md §11, Increment 2). Pattern form,
# in-bounds read, and binding form `catch f: match f` reading Fault.Bounds().
void main():
    Vector[int] xs = [10, 20, 30]
    # Out-of-bounds → caught, yields the fallback.
    int r = (xs[10]) catch Fault.Bounds: -1
    print(f"{r}")
    # In-bounds → the element itself (no fault).
    int ok = (xs[1]) catch Fault.Bounds: -1
    print(f"{ok}")
    # Binding form reads which fault occurred.
    int b = (xs[99]) catch f: match f:
        case Fault.Bounds(): 7
        case Fault.Overflow(): 8
        case Fault.DivByZero(): 9
    print(f"{b}")
