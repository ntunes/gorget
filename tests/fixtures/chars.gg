void main():
    str c = "A"
    print(f"{c}")

    # str comparison (single-char strings compare lexicographically)
    if "A" < "B":
        print("A < B")

    if c == "A":
        print("equal")

    # escape sequences work in str
    str backslash = "\\"
    print(f"{backslash}")

    str tab = "\t"
    str zero = "\0"

    # str ordering for single chars
    bool is_upper = c >= "A" and c <= "Z"
    print(f"{is_upper}")
