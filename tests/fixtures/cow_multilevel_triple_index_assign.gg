# CoW G1 memory-safety gate (round-33): a TRIPLE plain index-ASSIGN
# (`m[i][j][k] = x`, the lower_index_assign path) + same-collection push. Locks
# the multi-level untrack for the index-assign sibling too.
from std.collections import Vector

void f(Vector[Vector[Vector[int]]] m):
    m[0][0][0] = 99
    int i = 0
    while i < 6:
        m.push([[1]])
        i = i + 1
    print(m.len())               # 7
    print(m[0][0][0])            # 99

void main():
    Vector[Vector[Vector[int]]] a = [[[1]]]
    f(a)
    print(a.len())               # 1  (caller untouched)
    print(a[0][0][0])            # 1
    print("done")
