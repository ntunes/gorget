void main():
    str s = "Hello123"

    # str methods on string subscript expression
    print(f"{s[0].is_alpha()}")
    print(f"{s[4].is_digit()}")
    print(f"{s[5].is_digit()}")
    print(f"{s[0].is_upper()}")
    print(f"{s[1].is_lower()}")
    print(f"{s[5].to_upper()}")
    print(f"{s[0].to_lower()}")

    # method on index variable (should also work)
    int i = 0
    print(f"{s[i].is_alpha()}")

    # chained on a local works (baseline)
    str c = s[0]
    print(f"{c.is_alpha()}")
