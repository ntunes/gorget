void main():
    str s = "Hello123"

    # char methods on string index expression
    print("{s.char_at(0).is_alpha()}")
    print("{s.char_at(4).is_digit()}")
    print("{s.char_at(5).is_digit()}")
    print("{s.char_at(0).is_upper()}")
    print("{s.char_at(1).is_lower()}")
    print("{s.char_at(5).to_upper()}")
    print("{s.char_at(0).to_lower()}")

    # method on index variable (should also work)
    int i = 0
    print("{s.char_at(i).is_alpha()}")

    # chained on a local works (baseline)
    char c = s.char_at(0)
    print("{c.is_alpha()}")
