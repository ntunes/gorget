from xtd.csv import parse, parse_table, stringify, CsvTable
from std.collections import Vector

void main():
    # ── Error: unterminated quoted field ──
    Result[Vector[Vector[String]], String] r_err = parse("\"unclosed")
    bool csv_is_err = r_err.is_error()
    print(f"{csv_is_err}")

    # ── has_column / column_index ──
    CsvTable tbl = parse_table("name,age,city\nAlice,30,NYC\nBob,25,LA").unwrap()
    print(tbl.has_column("age"))
    print(tbl.has_column("zip"))
    int city_idx = tbl.column_index("city")
    print(f"{city_idx}")
    int missing_idx = tbl.column_index("missing")
    print(f"{missing_idx}")
    int nrows = tbl.row_count()
    print(f"{nrows}")

    # ── Roundtrip: field with embedded delimiter and escaped double-quote ──
    String tricky = "\"hello, world\",plain\n\"say \"\"hi\"\"\",end"
    Vector[Vector[String]] rows = parse(tricky).unwrap()
    String serialized = stringify(rows)
    Vector[Vector[String]] rows2 = parse(serialized).unwrap()
    auto r0 = rows2.get(0).unwrap()
    print(r0.get(0).unwrap())
    print(r0.get(1).unwrap())
    auto r1 = rows2.get(1).unwrap()
    print(r1.get(0).unwrap())
    print(r1.get(1).unwrap())

    # ── Empty input → Ok with 0 rows ──
    Vector[Vector[String]] empty_rows = parse("").unwrap()
    int empty_len = empty_rows.len()
    print(f"{empty_len}")

    print("done")
