# R42 tail-reserve boundary cell.
#
# C10 · the method chain's GROUP-LEVEL consumption, as distinct from the
# per-segment install in `c10_method_chain_segment.gg`. `format_method_chain`
# hands the whole chain to `write_doc` as one `Doc::Group`, and it is that
# group's FLAT fit test that has to charge the caller's committed tail — here
# the `if` header's `:`. Neutralise it (render the group with the reserve
# forced to 0) and the 121 half stops breaking. The two cells are independent:
# neither can see the other's value, so each needs its own boundary pair.
# Distinct from family P's `p_postfix_chained.gg`, which is a FieldAccess
# chain and never reaches `format_method_chain`.
#
# The two width markers ride the CHAIN, as undeclared identifier arguments
# (`gg fmt` never typechecks), one per half — NOT in the function name. A
# marker in the signature would land both harness assertions on the
# `format_function` header line, which is family A1's carrier, and the chain
# would never be measured at all. (They are spelled out only in the code
# below: the harness counts marker-bearing LINES, so a header that quotes the
# marker verbatim would itself be counted.)
#
# BOUNDARY PAIR. The two chains below are the SAME shape one column apart:
# the first is exactly 120 columns wide with the header's `:` counted, the
# second exactly 121.
#
# RED, recorded against the PRE-FIX binary built from this track's own base
# commit: the 121 chain formats FLAT to a single 121-column line — the group's
# fit test measured the chain without the caller's `:`.
#
# RED, re-recorded against a build with ONLY this cell's carrier neutralised
# (`self.write_doc(&chain_doc)` in `format_method_chain` wrapped in
# `with_exact_tail_reserve(0, …)`): the 121 chain goes back to a flat
# 121-column line while the segment cell stays GREEN — so the red is
# attributable to the GROUP-level consumption and to nothing else.
#
# GREEN: the 121 chain breaks and nothing in this file exceeds 120, AND the
# 120 twin still formats FLAT at exactly 120 columns. That second half is the
# OVER-reserve guard — the one a careless net omits — and it is green on both
# binaries by construction, so its own red comes from breaking the mechanism:
# add 1 to the reserve this cell installs and the 120 half breaks.

struct ProbeChain:
    int f

equip ProbeChain:
    ProbeChain step_with_a_long_method_name(self, int x): self

    bool terminal_predicate_method(self): self.f == 0

void probe_group_a():
    ProbeChain pc = ProbeChain(1)
    if pc.step_with_a_long_method_name(at120_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).terminal_predicate_method():
        print(1)

void probe_group_b():
    ProbeChain pc = ProbeChain(1)
    if pc.step_with_a_long_method_name(at121_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).terminal_predicate_method():
        print(1)
