# R42 tail-reserve boundary cell.
#
# C10 · the METHOD-CHAIN carrier — a `Doc::Group`-clothed sub-render, and
# the one at the centre of this track's C10 deviation. The `if` header
# installs its reserve of 1 around the chain's group render, so the
# group's flat test and the LAST segment's inherited reserve are both
# exercised. Distinct from family P's `p_postfix_chained.gg`, which is a
# FieldAccess chain and never reaches `format_method_chain`.
#
# BOUNDARY PAIR. The two declarations below are the SAME shape one column
# apart: the first is exactly 120 columns wide with its caller-emitted
# suffix counted, the second exactly 121.
#
# RED, recorded against the PRE-FIX binary built from this track's own
# base commit: the 121 declaration formats to a SINGLE 121-column line —
# the packer measured its list without the caller's suffix.
#
# GREEN: the 121 declaration breaks and nothing in this file exceeds 120,
# AND the 120 twin still formats FLAT at exactly 120 columns. That second
# half is the OVER-reserve guard — the one a careless net omits — and it
# is green on both binaries by construction, so its own red comes from
# breaking the mechanism: add 1 to the reserve this cell installs and the
# 120 half breaks.

struct ProbeChain:
    int f

equip ProbeChain:
    ProbeChain step_with_a_long_method_name(self, int x): self

    bool terminal_predicate_method(self): self.f == 0

void probe_at120_(int axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx):
    ProbeChain pc = ProbeChain(1)
    if pc.step_with_a_long_method_name(axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).step_with_a_long_method_name(2).terminal_predicate_method():
        print(1)

void probe_at121_(int axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx):
    ProbeChain pc = ProbeChain(1)
    if pc.step_with_a_long_method_name(axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).step_with_a_long_method_name(2).terminal_predicate_method():
        print(1)
