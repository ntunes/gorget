int risky(int x) throws String:
    if x < 0:
        throw "negative"
    return x * 2

int process(int x) throws String:
    on error:
        print("cleanup")
    int val = risky(x)! rethrow (String e): f"process: {e}"
    return val + 1

void main():
    Result[int, String] r1 = process(5)
    match r1:
        case Ok(v):
            print(f"ok:{v}")
        case Error(e):
            print(f"err:{e}")

    Result[int, String] r2 = process(-1)
    match r2:
        case Ok(v):
            print(f"ok:{v}")
        case Error(e):
            print(f"err:{e}")

    print("done")
