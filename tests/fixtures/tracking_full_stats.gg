from std.alloc import TrackingAllocator
from std.collections import Vector

void main():
    with TrackingAllocator() as tracker:
        Vector[int] v = Vector[int]()
        int i = 0
        while i < 50:
            v.push(i)
            i = i + 1
        print("peak >= current: {tracker.peak_bytes() >= tracker.current_bytes()}")
        print("bytes_freed > 0: {tracker.bytes_freed() > 0}")
        print("free_count > 0: {tracker.free_count() > 0}")
    print("done")
