async int double(int x):
    return x * 2

async int add(int a, int b):
    return a + b

async void main():
    int x = double(5).await() + 1
    print(x)

    int y = double(3).await() + double(4).await()
    print(y)

    int z = add(double(2).await(), double(3).await()).await()
    print(z)

    int w = -double(5).await()
    print(w)

    int total = 0
    total = total + double(10).await()
    print(total)
