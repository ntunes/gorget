# Regression test for the (now-fixed 2026-06-04) index-load-on-global-struct-vector bug:
# `STATIC[i].field` on a static `Vector[struct]` used to return a ZEROED struct (the GlobalRef
# object fell through lower_index_access's Copy/Move place-guard to Constant::Unit and const-folded
# to 0), while `STATIC.get(i).unwrap().field` and `[i].field` on a LOCAL vector read correctly.
# Fixed by materializing the GlobalRef into a (borrowed) local before the place-guard. The
# integration test is ACTIVE; the expected stdout below is the correct element fields.

struct Item:
    String name
    int weight

public static Vector[Item] TABLE = [Item("alpha", 10), Item("beta", 20), Item("gamma", 30)]

void main():
    print(f"i0={TABLE[0].name}:{TABLE[0].weight}")
    print(f"i2={TABLE[2].name}:{TABLE[2].weight}")
