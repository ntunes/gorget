#!parity-excluded network: runs a real HTTP server over a bound TCP socket with a concurrent client; connection timing
#!  decides the output
# Tests that serve() handles multiple concurrent connections.
# A server accepts exactly 2 connections concurrently using TaskGroup.
# Both clients send requests simultaneously; both must get 200 responses.
from xtd.httpserver import HttpServerResponse, HttpRequest, http_server_parse_request, http_server_write_response
from std.net.socket import ServerSocket, Socket, server_socket_bind, socket_connect
from std.channel import Channel
from std.time import sleep
from std.signal import signal_ignore, SIGPIPE

HttpServerResponse handle(HttpRequest req):
    return HttpServerResponse.ok("hello")

async void handle_conn(Socket !conn):
    Result[HttpRequest, String] r = http_server_parse_request(&conn)
    match r:
        case Ok(req):
            http_server_write_response(&conn, handle(req))
        case Error(e):
            http_server_write_response(&conn, HttpServerResponse.bad_request(e))
    conn.close()

# Server that accepts exactly n connections concurrently, then exits.
async void serve_n(ServerSocket !srv, int n):
    TaskGroup group = TaskGroup()
    int i = 0
    while i < n:
        Socket client = srv.accept().unwrap()
        group.spawn(spawn handle_conn(!client))
        i = i + 1
    group.join()
    srv.close()

async void client_task(int port, Channel[int] results):
    sleep(0.5).await()
    Result[Socket, String] cr = socket_connect("127.0.0.1", port)
    if cr.is_error():
        results.send(0)
        return
    Socket c = cr.unwrap()
    c.write_str("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
    Result[String, String] line_r = c.read_line()
    c.close()
    if line_r.is_ok():
        String line = line_r.unwrap()
        if line.starts_with("HTTP/1.1 200"):
            results.send(1)
            return
    results.send(0)

async void main():
    signal_ignore(SIGPIPE)
    ServerSocket srv = server_socket_bind("127.0.0.1", 0).unwrap()
    int port = srv.local_port()
    Task[void] server = spawn serve_n(!srv, 2)

    Channel[int] results = Channel[int](2)
    TaskGroup clients = TaskGroup()
    clients.spawn(spawn client_task(port, results))
    clients.spawn(spawn client_task(port, results))
    clients.join()

    int a = results.recv()
    int b = results.recv()
    results.close()

    server.await()
    print(a + b)
