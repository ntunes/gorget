# Return-gate sibling of the §15.3 flagship: a fresh ctor result returned
# from inside `with Arena` materializes in the arena and dangles once the
# block destroys it at scope exit. Must reject.
from std.alloc import Arena
from std.collections import Vector

Vector[int] make():
    with Arena(4096) as a:
        return Vector[int]()

void main():
    Vector[int] v = make()
    print(v.len())
