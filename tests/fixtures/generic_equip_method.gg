from std.collections import Vector

struct Stack[T]:
    Vector[T] items

equip Stack[T]:
    # `&self` (write-through): under 2E (D2) a plain-`self` mutator materialises
    # a private copy, so the pushes would not reach the caller's `s` (and the
    # D2-rider would flag the dead write). A read-only method keeps plain `self`.
    void push(&self, T item):
        self.items.push(item)

    int size(self):
        return self.items.len()

void main():
    Stack[int] s = Stack[int](Vector[int]())
    s.push(10)
    s.push(20)
    s.push(30)
    print(s.size())
