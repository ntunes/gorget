void main():
    # .bytes() on ASCII
    str hello = "abc"
    Vector[uint8] bs = hello.bytes()
    print(bs.len())
    print(bs[0])
    print(bs[1])
    print(bs[2])

    # .bytes() on multi-byte (café: c=0x63, a=0x61, f=0x66, é=0xC3 0xA9)
    str cafe = f"caf\u{E9}"
    Vector[uint8] cafe_bytes = cafe.bytes()
    print(cafe_bytes.len())
    print(cafe_bytes[4])

    # .codepoints() on ASCII
    Vector[int] cps = hello.codepoints()
    print(cps.len())
    print(cps[0])
    print(cps[1])
    print(cps[2])

    # .codepoints() on multi-byte
    Vector[int] cafe_cps = cafe.codepoints()
    print(cafe_cps.len())
    print(cafe_cps[3])

    # .chars() on ASCII
    Vector[str] chs = hello.chars()
    print(chs.len())
    print(chs[0])
    print(chs[1])
    print(chs[2])

    # .chars() on multi-byte
    Vector[str] cafe_chs = cafe.chars()
    print(cafe_chs.len())
    print(cafe_chs[3])

    # .chars() iteration
    String result = ""
    for ch in cafe_chs:
        result = result + ch + "-"
    print(result)
