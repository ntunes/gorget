# REGRESSION — the DICT literal arm of the container-literal element-type mint.
#
# AXIS CELL: container kind = DICT literal; borrow source = `.get(i).unwrap()`
# on a local `Vector[T]`; BOTH the KEY position and the VALUE position, which
# are separate mint sites (`Dict__K__V` is minted from both operands, and each
# was inferred pre-materialization). Element TYPE covers String, int, a plain
# value struct and a resource-carrying struct.
#
# THE MECHANISM, and why it is the dict's own fixture rather than a line in the
# array's: the dict's materializer used to live INSIDE `stage_dict_arg`, which
# runs AFTER `Dict__K__V` is minted. So the mint saw `Ptr(T)` for a borrowed key
# or value and produced 8-byte slots with no key/val vtable. The fix hoists the
# materializer OUT of `stage_dict_arg` to both `insert_pair` call sites, above
# the mint.
#
# RED-VERIFIED against the pre-fix compiler (both backends):
#   borrowed VALUE (String) -> `1` then an EMPTY line       (want `bb`)
#   borrowed KEY   (String) -> trap[T_UnwrapNone] — the key hashed as a pointer,
#                              so the lookup missed entirely (want `7`)
# The KEY cell is the sharper one: a wrong key slot does not merely return a
# wrong value, it makes the entry unreachable.
#
# ⭐ POSITION AXIS, CROSSED WITH THE KEY/VALUE AXIS. The K and V types are minted
# from PAIR 0 and pairs 1..N land in the slots it minted, so the two groups take
# DIFFERENT code paths. A net that only ever puts the borrow in pair 0 leaves the
# second path unguarded: deleting the 1..N materialization leaves every pair-0
# fixture GREEN while both crossed cells below ICE the compiler.
#
# ⚠ THE TWO CROSSED CELLS ARE GREEN ON THE PRE-FIX COMPILER, and that is not a
# defect in them — it is the whole reason they are here. Pre-fix, the dict
# materialized pairs 1..N inside `stage_dict_arg`; only the pair-0 MINT was
# wrong. So a pair-1 borrow was already handled, and no pre-fix red is possible
# for this cell. Their red is obtained the other way (Core #12): BREAK the
# mechanism they guard — delete the 1..N materialization — and they ICE.
#
# ⚠ Chosen by MEASUREMENT. Under that deletion, at pair 1:
#   String KEY   -> ICE   -- DISCRIMINATES
#   String VALUE -> ICE   -- DISCRIMINATES
#   int VALUE    -> correct, green on arrival -- NOT claimed as coverage
# The ICE is a `Tier 2a consume-site violation` at `src/ir/lowering/mod.rs:2114`
# ("untracked source consumed (ownership not decided)") — a compiler panic, not a
# wrong answer, which is why these two cells are worth their own functions.

struct Pt:
    int x
    int y

struct Named:
    String name
    int n

void borrowed_value_string():
    Vector[String] v = ["aa", "bb"]
    auto s = v.get(1).unwrap()
    Dict[String, String] out = {"k": s}
    print(out.len())
    print(out.get("k").unwrap())

void borrowed_key_string():
    Vector[String] v = ["aa", "bb"]
    auto s = v.get(1).unwrap()
    Dict[String, int] out = {s: 7}
    print(out.get("bb").unwrap())

# ⭐ CROSSED CELL: borrowed String VALUE at PAIR 1 (not pair 0). Pair 0 is fully
# static, so the Dict__K__V slot is minted from it and the borrow lands in an
# already-minted slot. RED under a 1..N-materialization deletion: compiler ICE.
void borrowed_value_string_at_pair_1():
    Vector[String] v = ["aa", "bb"]
    auto s = v.get(1).unwrap()
    Dict[String, String] out = {"k0": "zz", "k1": s}
    print(out.get("k1").unwrap())

# ⭐ CROSSED CELL: borrowed String KEY at PAIR 1. Same path, the key channel.
void borrowed_key_string_at_pair_1():
    Vector[String] v = ["aa", "bb"]
    auto s = v.get(1).unwrap()
    Dict[String, int] out = {"k0": 1, s: 7}
    print(out.get("bb").unwrap())

void borrowed_value_int():
    Vector[int] v = [10, 20]
    auto s = v.get(1).unwrap()
    Dict[String, int] out = {"k": s}
    print(out.get("k").unwrap())

void borrowed_value_struct():
    Vector[Pt] v = [Pt(1, 2), Pt(3, 4)]
    auto s = v.get(1).unwrap()
    Dict[String, Pt] out = {"k": s}
    auto p = out.get("k").unwrap()
    print(p.x)
    print(p.y)

void borrowed_value_resource_struct():
    Vector[Named] v = [Named("aa", 1), Named("bb", 2)]
    auto s = v.get(1).unwrap()
    Dict[String, Named] out = {"k": s}
    auto p = out.get("k").unwrap()
    print(p.name)
    print(p.n)

void main():
    borrowed_value_string()
    borrowed_key_string()
    borrowed_value_string_at_pair_1()
    borrowed_key_string_at_pair_1()
    borrowed_value_int()
    borrowed_value_struct()
    borrowed_value_resource_struct()
