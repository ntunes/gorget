# Iterator sugar over Set — `s.iter()` returns a `VectorIter[T]`
# wrapping the materialised `.items()`. Callers get the full
# VectorIter adapter chain (`take` / `skip` / `chain` / terminals) and
# the convenience wrappers (`any` / `all` / `find` / `fold` / etc.)
# via the `equip [T] Set[T]:` block in `lib/std/iter.gg`.
#
# Eager up-front; a lazy bucket-walk variant waits on Phase 2c.

from std.iter import TakeIter, SkipIter, ChainIter, VectorIter

int main():
    Set[int] s = Set[int]()
    s.add(10)
    s.add(20)
    s.add(30)
    s.add(40)

    # Inline for-loop through `.iter()`.
    for x in s.iter():
        print(x)

    print("--")

    # take on VectorIter (returned by .iter()) yields TakeIter[VectorIter[T], T].
    TakeIter[VectorIter[int], int] t = s.iter().take(2)
    for x in t:
        print(x)

    print("--")

    # skip on VectorIter yields SkipIter[VectorIter[T], T].
    SkipIter[VectorIter[int], int] k = s.iter().skip(2)
    for x in k:
        print(x)

    print("--")

    # chain concatenates two VectorIters.
    Set[int] s2 = Set[int]()
    s2.add(100)
    s2.add(200)
    ChainIter[VectorIter[int], VectorIter[int], int] c = s.iter().chain(s2.iter())
    for x in c:
        print(x)

    return 0
