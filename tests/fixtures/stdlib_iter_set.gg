# Iterator sugar over Set — `set_iter[T](s)` returns a `VectorIter[T]`
# wrapping the materialized elements. Callers get the full VectorIter
# adapter chain (`take` / `skip` / `chain`) for free.
#
# Eager up-front; a lazy bucket-walk variant waits on Phase 2c.
#
# Dict key/value iteration via `VectorIter[K](d.keys(), 0)` is the same
# shape, but currently trips a codegen panic for resource-type keys
# (String). Use `d.keys()` / `d.values()` / `d.items()` + Vector
# iteration directly until that lands.

from std.iter import set_iter, TakeIter, SkipIter, ChainIter, VectorIter

int main():
    Set[int] s = Set[int]()
    s.add(10)
    s.add(20)
    s.add(30)
    s.add(40)

    # Inline for-loop through `set_iter`.
    for x in set_iter[int](s):
        print(x)

    print("--")

    # take on VectorIter (returned by set_iter) yields TakeIter[VectorIter[T], T].
    TakeIter[VectorIter[int], int] t = set_iter[int](s).take(2)
    for x in t:
        print(x)

    print("--")

    # skip on VectorIter yields SkipIter[VectorIter[T], T].
    SkipIter[VectorIter[int], int] k = set_iter[int](s).skip(2)
    for x in k:
        print(x)

    print("--")

    # chain concatenates two VectorIters.
    Set[int] s2 = Set[int]()
    s2.add(100)
    s2.add(200)
    ChainIter[int] c = set_iter[int](s).chain(set_iter[int](s2))
    for x in c:
        print(x)

    return 0
