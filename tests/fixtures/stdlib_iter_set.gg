# Iterator sugar over Set — `s.iter()` returns a lazy `SetIter[T]`
# walking the underlying GorgetMap bucket array in place. Callers get
# the full Iterator[T] adapter chain (`take` / `skip` / terminals) and
# the convenience wrappers (`any` / `all` / `find` / `fold` / etc.)
# via the `equip [T] Set[T]:` block in `lib/std/iter.gg`.
#
# `chain` lives on VectorIter only (it expects a VectorIter[T] for
# `other`); test it on Vector inputs in stdlib_vector_iter.gg.

from std.iter import TakeIter, SkipIter, SetIter

int main():
    Set[int] s = Set[int]()
    s.add(10)
    s.add(20)
    s.add(30)
    s.add(40)

    # Inline for-loop through `.iter()` — yields lazily with no
    # `.items()` materialisation.
    for x in s.iter():
        print(x)

    print("--")

    # take on SetIter yields TakeIter[SetIter[T], T].
    TakeIter[SetIter[int], int] t = s.iter().take(2)
    for x in t:
        print(x)

    print("--")

    # skip on SetIter yields SkipIter[SetIter[T], T].
    SkipIter[SetIter[int], int] k = s.iter().skip(2)
    for x in k:
        print(x)

    return 0
