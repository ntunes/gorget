trait Greeter:
    String name(self)
    String greeting(self):
        return "hello"

struct English:
    String person

struct French:
    String person

equip English with Greeter:
    String name(self):
        return self.person

equip French with Greeter:
    String name(self):
        return self.person
    String greeting(self):
        return "bonjour"

void main():
    English e = English("Alice")
    French f = French("Bob")
    String g1 = e.greeting()
    String n1 = e.name()
    String g2 = f.greeting()
    String n2 = f.name()
    print(f"{g1} {n1}")
    print(f"{g2} {n2}")
