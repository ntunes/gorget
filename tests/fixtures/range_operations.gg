void main():
    # half-open range in for loop
    for i in 0..5:
        print(f"{i}")

    # inclusive range
    for i in 0..=3:
        print(f"inc:{i}")

    # range used with conditions
    int x = 5
    if x >= 1 and x < 10:
        print("in range")
    if x >= 1 and x <= 5:
        print("in inclusive")

    # range with negative bounds
    for i in -2..2:
        print(f"neg:{i}")

    # range with step-like patterns (manual)
    int count = 0
    for i in 0..10:
        if i % 3 == 0:
            count += 1
    print(f"multiples: {count}")
