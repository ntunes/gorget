# 2T get-chain materialize (site 2, CompoundAssign): `…get(0).unwrap().n += 1`
# on a bare drop-tainted param materialises the same root the plain-assign chain
# does → REJECTED identically. Fix: `&h`.
from std.collections import Vector
struct R:
    int n
equip R with Drop:
    void drop(!self):
        print("bye")
struct H:
    Vector[R] items
void f_compound(H h):
    h.items.get(0).unwrap().n += 1
void main():
    H h = H([R(1)])
    f_compound(h)
    print("done")
