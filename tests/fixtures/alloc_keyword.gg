from std.alloc import Arena
from std.collections import Vector

void main():
    with Arena(4096) as pool:
        Vector[int] v = Vector[int](alloc=pool)
        v.push(1)
        v.push(2)
        print(f"len: {v.len()}")
        int used = pool.bytes_used()
        assert used > 0, "alloc= should use arena"
        print("used > 0: true")
    print("done")
