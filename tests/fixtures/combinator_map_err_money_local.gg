# CELL: `.map_err()` x plain-local recv x Result[int, Money]
# COMMITTED Round XIV (74f566c6+) — receiver-readback CONTROL that turned
#   out to be a REGRESSION cell (Core #12 finding: what looked like a green
#   control was actually the scout's probe not sampling the receiver-ownership
#   axis).
# PRE-FIX (RED-verified at HEAD 6171d564 with methods.rs reverted): the
#   scout's original map_err_money_local probe printed `10` (just the mapped
#   err) and looked GREEN — but that probe only read the RESULT VALUE. This
#   fixture also reads back the receiver (`if p is Error(e2): print(size_of(e2))`)
#   and prints `10\n0` pre-fix (want `10\n10`) — SAME silent write-drop mode
#   as the map/filter/or_else siblings. The producer path is shared; the
#   receiver-emptying class was ALSO firing for map_err all along, just
#   invisible when the fixture only inspected the return value. Edit B covers
#   this cell.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Result[int, Money] make_err(int n):
    return Error(Money(heap_cents(n)))

void main():
    Result[int, Money] p = make_err(10)
    Result[int, int] r2 = p.map_err((Money e): size_of(e))
    if r2 is Error(e):
        print(e)
    if p is Error(e2):
        print(size_of(e2))
