# Comprehensive Set[int] method coverage
from std.collections import Set

void main():
    # ===== Construction =====
    Set[int] s = Set[int]()
    print(f"{s.len()}")
    print(f"{s.is_empty()}")

    # ===== add =====
    s.add(1)
    s.add(2)
    s.add(3)
    print(f"{s.len()}")
    print(f"{s.contains(1)}")
    print(f"{s.contains(2)}")
    print(f"{s.contains(3)}")
    # duplicate add — len unchanged
    s.add(2)
    print(f"{s.len()}")
    # add after duplicate — still works
    s.add(4)
    print(f"{s.len()}")

    # ===== contains =====
    print(f"{s.contains(1)}")
    print(f"{s.contains(4)}")
    print(f"{s.contains(99)}")
    print(f"{s.contains(0)}")
    # contains on empty set
    Set[int] mt = Set[int]()
    print(f"{mt.contains(1)}")

    # ===== remove =====
    bool rem1 = s.remove(2)
    print(f"{rem1}")
    print(f"{s.len()}")
    print(f"{s.contains(2)}")
    # remove non-existent
    bool rem2 = s.remove(99)
    print(f"{rem2}")
    print(f"{s.len()}")
    # remove from empty set
    bool rem3 = mt.remove(5)
    print(f"{rem3}")
    # remove same element twice
    bool rem4 = s.remove(4)
    print(f"{rem4}")
    bool rem5 = s.remove(4)
    print(f"{rem5}")
    print(f"{s.len()}")
    # s now has {1, 3}

    # ===== clear =====
    Set[int] sc = Set[int]()
    sc.add(10)
    sc.add(20)
    sc.add(30)
    print(f"{sc.len()}")
    sc.clear()
    print(f"{sc.len()}")
    print(f"{sc.is_empty()}")
    print(f"{sc.contains(10)}")
    # clear empty set (no-op)
    sc.clear()
    print(f"{sc.len()}")
    # add after clear
    sc.add(99)
    print(f"{sc.len()}")
    print(f"{sc.contains(99)}")

    # ===== is_empty =====
    Set[int] e1 = Set[int]()
    print(f"{e1.is_empty()}")
    e1.add(1)
    print(f"{e1.is_empty()}")
    e1.remove(1)
    print(f"{e1.is_empty()}")

    # ===== Set algebra setup =====
    Set[int] a = Set[int]()
    a.add(1)
    a.add(2)
    a.add(3)
    Set[int] b = Set[int]()
    b.add(2)
    b.add(3)
    b.add(4)

    # ===== union =====
    Set[int] u = a.union(b)
    print(f"{u.len()}")
    print(f"{u.contains(1)}")
    print(f"{u.contains(2)}")
    print(f"{u.contains(3)}")
    print(f"{u.contains(4)}")
    # union with empty
    Set[int] empty = Set[int]()
    Set[int] u_empty = a.union(empty)
    print(f"{u_empty.len()}")
    Set[int] u_empty2 = empty.union(a)
    print(f"{u_empty2.len()}")
    # union with self
    Set[int] u_self = a.union(a)
    print(f"{u_self.len()}")
    # union of two empty
    Set[int] empty2 = Set[int]()
    Set[int] u_mt = empty.union(empty2)
    print(f"{u_mt.len()}")

    # ===== intersection =====
    Set[int] inter = a.intersection(b)
    print(f"{inter.len()}")
    print(f"{inter.contains(2)}")
    print(f"{inter.contains(3)}")
    print(f"{inter.contains(1)}")
    # intersection with empty
    Set[int] i_empty = a.intersection(empty)
    print(f"{i_empty.len()}")
    # intersection with disjoint
    Set[int] disjoint = Set[int]()
    disjoint.add(10)
    disjoint.add(20)
    Set[int] i_dis = a.intersection(disjoint)
    print(f"{i_dis.len()}")
    # intersection with self
    Set[int] i_self = a.intersection(a)
    print(f"{i_self.len()}")

    # ===== difference =====
    Set[int] diff_ab = a.difference(b)
    print(f"{diff_ab.len()}")
    print(f"{diff_ab.contains(1)}")
    Set[int] diff_ba = b.difference(a)
    print(f"{diff_ba.len()}")
    print(f"{diff_ba.contains(4)}")
    # difference with empty
    Set[int] diff_e = a.difference(empty)
    print(f"{diff_e.len()}")
    Set[int] diff_e2 = empty.difference(a)
    print(f"{diff_e2.len()}")
    # difference with self
    Set[int] diff_self = a.difference(a)
    print(f"{diff_self.len()}")

    # ===== symmetric_difference =====
    Set[int] sym = a.symmetric_difference(b)
    print(f"{sym.len()}")
    print(f"{sym.contains(1)}")
    print(f"{sym.contains(4)}")
    print(f"{sym.contains(2)}")
    print(f"{sym.contains(3)}")
    # symmetric_difference with empty
    Set[int] sym_e = a.symmetric_difference(empty)
    print(f"{sym_e.len()}")
    # symmetric_difference with self
    Set[int] sym_self = a.symmetric_difference(a)
    print(f"{sym_self.len()}")

    # ===== is_subset =====
    Set[int] sub = Set[int]()
    sub.add(1)
    sub.add(2)
    print(f"{sub.is_subset(a)}")
    print(f"{a.is_subset(sub)}")
    # reflexive
    print(f"{a.is_subset(a)}")
    # empty is subset of everything
    print(f"{empty.is_subset(a)}")
    print(f"{empty.is_subset(empty2)}")
    # disjoint
    print(f"{disjoint.is_subset(a)}")

    # ===== is_superset =====
    print(f"{a.is_superset(sub)}")
    print(f"{sub.is_superset(a)}")
    # reflexive
    print(f"{a.is_superset(a)}")
    # everything is superset of empty
    print(f"{a.is_superset(empty)}")
    print(f"{empty.is_superset(empty2)}")
    # disjoint
    print(f"{a.is_superset(disjoint)}")

    # ===== filter =====
    Set[int] nums = Set[int]()
    nums.add(1)
    nums.add(2)
    nums.add(3)
    nums.add(4)
    nums.add(5)
    nums.add(6)
    # filter evens
    Set[int] evens = nums.filter((int x): x % 2 == 0)
    print(f"{evens.len()}")
    print(f"{evens.contains(2)}")
    print(f"{evens.contains(4)}")
    print(f"{evens.contains(6)}")
    print(f"{evens.contains(1)}")
    # filter none match
    Set[int] big = nums.filter((int x): x > 100)
    print(f"{big.len()}")
    # filter all match
    Set[int] all_pass = nums.filter((int x): x > 0)
    print(f"{all_pass.len()}")
    # filter on empty set
    Set[int] f_empty = empty.filter((int x): x > 0)
    print(f"{f_empty.len()}")

    # ===== fold =====
    int total = nums.fold(0, (int acc, int x): acc + x)
    print(f"{total}")
    # fold with different init
    int prod = nums.fold(1, (int acc, int x): acc * x)
    print(f"{prod}")
    # fold on empty set
    int fold_mt = empty.fold(42, (int acc, int x): acc + x)
    print(f"{fold_mt}")
    # fold counting
    int count = nums.fold(0, (int acc, int x): acc + 1)
    print(f"{count}")

    # ===== Combined operations =====
    # filter then fold
    Set[int] odds = nums.filter((int x): x % 2 == 1)
    int odd_sum = odds.fold(0, (int acc, int x): acc + x)
    print(f"{odds.len()}")
    print(f"{odd_sum}")

    # union then filter
    Set[int] c = Set[int]()
    c.add(7)
    c.add(8)
    Set[int] merged = nums.union(c)
    Set[int] gt5 = merged.filter((int x): x > 5)
    print(f"{gt5.len()}")
    print(f"{gt5.contains(6)}")
    print(f"{gt5.contains(7)}")
    print(f"{gt5.contains(8)}")

    # intersection then len
    Set[int] d = Set[int]()
    d.add(2)
    d.add(4)
    d.add(6)
    d.add(8)
    Set[int] common = nums.intersection(d)
    print(f"{common.len()}")

    print("done")
