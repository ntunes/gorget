# `Deque[T].fill` — the SECOND surface member of the class (todo/t1407).
#
# `fill` is one runtime function with two spellings: `DEQUE.methods =
# VECTOR.methods`, so `Deque.fill` reaches `gorget_array_fill` too and
# double-freed identically. The method table lists `fill` once, which is why an
# enumeration over that table alone undercounted the surface.
#
# ⚠ OBSERVATION CHANNEL: `Deque[T].get(i)` loses the element type for aggregate
# `T` and binds the payload as `int` (todo/t1087), destroying the value before
# anything can read it — a Deque cell read through `.get` is green for reasons
# unrelated to what it tests. Every read below uses the INDEX form `d[i]` or
# iteration, never `.get`.

from std.collections import Deque

String mk(String a, String b):
    return a + b

int main():
    # heap String element, read both ways
    Deque[String] a = Deque[String]()
    a.fill(3, mk("ab", "cd"))
    print(a.len())
    print(a[0])
    print(a[1])
    print(a[2])
    for s in a:
        print(s)

    # named local, LIVE past the call: clone, source survives
    Deque[String] b = Deque[String]()
    String live = mk("ef", "gh")
    b.fill(3, live)
    print(b.len())
    for s in b:
        print(s)
    print(live)

    # Option element with a payload: the Deque row must consume, exactly like
    # the Vector one
    Deque[Option[String]] c = Deque[Option[String]]()
    c.fill(3, Some(mk("ij", "kl")))
    print(c.len())
    for e in c:
        if e is Some(s):
            print(s)
        else:
            print("none")
    return 0
