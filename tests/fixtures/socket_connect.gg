from std.net.socket import Socket, socket_connect

void main():
    # Test 1: connection to a non-existent address should return an error
    Result[Socket, str] r = socket_connect("127.0.0.1", 1)
    if r.is_err():
        print("error handled")
    else:
        Socket s = r.unwrap()
        s.close()
        print("unexpected success")

    print("done")
