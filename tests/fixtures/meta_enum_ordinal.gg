enum Direction:
    North
    East
    South
    West

enum Color:
    Red
    Green
    Blue

# Compile-time ordinal lookup via meta const
void print_ordinals[T]():
    meta for vname in variant_names(T):
        meta const idx = enum_ordinal(T, vname)
        print(f"{vname}={idx}")

# Compile-time name lookup via meta const inside integer-range meta for
void print_names[T]():
    meta for i in 0..variant_count(T):
        meta const vname = enum_from_ordinal(T, i)
        print(f"{vname}")

void main():
    print_ordinals[Direction]()
    print_ordinals[Color]()
    print_names[Color]()
    print("done")
