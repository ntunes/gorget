# Test emission ordering: Option[UserStruct] as a struct field
# requires the generic enum to be emitted between the user struct and the containing struct.

struct Color:
    int r
    int g
    int b

struct Pixel:
    int x
    int y
    Option[Color] color

str main():
    Color red = Color(255, 0, 0)
    Pixel p1 = Pixel(10, 20, Some(red))
    match p1.color:
        case Some(c):
            print(f"{c.r}")
    Pixel p2 = Pixel(0, 0, None)
    match p2.color:
        case Some(c):
            print("unexpected")
        else:
            print("no color")
