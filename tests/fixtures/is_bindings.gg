enum Outcome:
    Success(int)
    Failure(str)

enum Maybe:
    Just(int)
    Nothing

void main():
    # Basic if-is with binding
    Outcome r = Success(42)
    if r is Success(value):
        print("{value}")

    # elif-is with binding
    Outcome r2 = Failure("oops")
    if r2 is Success(v):
        print("should not print")
    elif r2 is Failure(msg):
        print("{msg}")

    # is not — no binding, just boolean
    if r is not Failure:
        print("not failure")

    # Binding with else branch
    Outcome r3 = Success(99)
    if r3 is Success(x):
        int y = x + 1
        print("{y}")
    else:
        print("should not print")

    # while-is with binding
    int count = 0
    Maybe opt = Just(10)
    while opt is Just(n):
        print("{n}")
        count = count + 1
        if count >= 3:
            opt = Nothing()
        else:
            opt = Just(n + 1)

    print("done")

    # Compound is + guard
    Option[int] cval = Some(42)
    if cval is Some(cv) and cv > 10:
        print("compound_guard:{cv}")

    if cval is Some(cv2) and cv2 > 100:
        print("should_not_print")
    else:
        print("guard_failed")

    Option[int] cnone = None()
    if cnone is Some(cv3) and cv3 > 0:
        print("should_not_print")
    else:
        print("none_compound")

    # Multiple is patterns
    Option[int] mx = Some(5)
    Option[int] my = Some(10)
    if mx is Some(mvx) and my is Some(mvy) and mvx + mvy == 15:
        print("multi_is:{mvx}:{mvy}")
