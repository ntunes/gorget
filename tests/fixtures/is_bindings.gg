enum Outcome:
    Success(int)
    Failure(str)

enum Maybe:
    Just(int)
    Nothing

void main():
    # Basic if-is with binding
    Outcome r = Success(42)
    if r is Success(value):
        print("{value}")

    # elif-is with binding
    Outcome r2 = Failure("oops")
    if r2 is Success(v):
        print("should not print")
    elif r2 is Failure(msg):
        print("{msg}")

    # is not — no binding, just boolean
    if r is not Failure:
        print("not failure")

    # Binding with else branch
    Outcome r3 = Success(99)
    if r3 is Success(x):
        int y = x + 1
        print("{y}")
    else:
        print("should not print")

    # while-is with binding
    int count = 0
    Maybe opt = Just(10)
    while opt is Just(n):
        print("{n}")
        count = count + 1
        if count >= 3:
            opt = Nothing()
        else:
            opt = Just(n + 1)

    print("done")

    # Compound is + guard
    Option[int] cval = Some(42)
    if cval is Some(cv) and cv > 10:
        print("compound_guard:{cv}")

    if cval is Some(cv2) and cv2 > 100:
        print("should_not_print")
    else:
        print("guard_failed")

    Option[int] cnone = None()
    if cnone is Some(cv3) and cv3 > 0:
        print("should_not_print")
    else:
        print("none_compound")

    # Multiple is patterns
    Option[int] mx = Some(5)
    Option[int] my = Some(10)
    if mx is Some(mvx) and my is Some(mvy) and mvx + mvy == 15:
        print("multi_is:{mvx}:{mvy}")

    # elif-is + else (the bug: generated invalid C before the fix)
    Outcome r4 = Failure("bad")
    if r4 is Success(v4):
        print("should_not_print")
    elif r4 is Failure(msg4):
        print("elif_else:{msg4}")
    else:
        print("should_not_print")

    # Multiple elif-is in a row
    Outcome r5 = Failure("err")
    if r5 is Success(v5):
        print("should_not_print")
    elif r5 is Failure(m5):
        print("multi_elif:{m5}")
    elif r5 is Success(v5b):
        print("should_not_print")
    else:
        print("should_not_print")

    # Mixed plain elif + elif-is + else
    Outcome r6 = Failure("mixed")
    int flag = 0
    if flag == 1:
        print("should_not_print")
    elif r6 is Success(v6):
        print("should_not_print")
    elif r6 is Failure(m6):
        print("mixed_chain:{m6}")
    else:
        print("should_not_print")

    # elif-is after plain elif, hitting else
    Outcome r7 = Failure("fallthrough")
    int flag2 = 0
    if flag2 == 1:
        print("should_not_print")
    elif r7 is Success(v7):
        print("should_not_print")
    else:
        print("fallthrough_else")
