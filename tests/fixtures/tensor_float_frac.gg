from gg.tensor import Tensor, tensor_linspace, tensor_sum, scalar_div

void main():
    # linspace(1.0, 4.0, 4) = [1, 2, 3, 4]
    # / 2.0 = [0.5, 1.0, 1.5, 2.0], sum = 5.0
    Tensor[float] a = tensor_linspace(1.0, 4.0, 4)
    Tensor[float] b = scalar_div[float](a, 2.0)
    print(f"{tensor_sum[float](b)}")

    # flat_get directly — must preserve fractional value (not truncate to int)
    print(f"{b.flat_get(0)}")
    print(f"{b.flat_get(2)}")
