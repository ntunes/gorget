# Exercise the second wave of iterator terminals via the method form
# on `VectorIter[T]` (default-body trait methods on `Iterator[T]`).
# Replaces the previous `_iter` free-function calls; the free fns
# `find_index_iter` / `last_iter` / `nth_iter` were retired in the
# Phase 2c convenience-wrapper migration.
#
# Also covers the bound-needing terminals `min` / `max` / `sum` /
# `product` / `contains` — all shipped as default methods on
# `Iterator[T]`. The demand-gate (`all_return_nominals_registered`)
# only emits each per-impl monomorphisation when a call site
# actually reaches for it, so Iterator implementors with non-
# Comparable / non-Numeric / non-Equatable T's never have these
# specialised. `join` remains as a free function in `std.iter`
# for a separate reason — Displayable.display() dispatch through
# abstract `T` not yet threaded through default-method emission.
# See iter.gg; the remaining iterator-surface gaps (including this
# one) are filed in TODO.md as the iterator-surface residue.

from std.iter import VectorIter
from std.collections import Vector

bool is_even(int x):
    return x % 2 == 0

bool gt_hundred(int x):
    return x > 100

int main():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(11)
    v.push(12)
    v.push(13)
    v.push(14)

    # find_index — first even is at index 0 (10 is even).
    Option[int] idx0 = v.iter().find_index(is_even)
    match idx0:
        case Some(i):
            print(f"idx_even={i}")
        case None:
            print("idx_even=none")

    # find_index — no match.
    Option[int] idx_none = v.iter().find_index(gt_hundred)
    match idx_none:
        case Some(i):
            print(f"idx_big={i}")
        case None:
            print("idx_big=none")

    # last — tail of the vector.
    Option[int] tail = v.iter().last()
    match tail:
        case Some(x):
            print(f"last={x}")
        case None:
            print("last=none")

    # last on empty — None.
    Vector[int] empty = Vector[int]()
    Option[int] empty_last = empty.iter().last()
    match empty_last:
        case Some(x):
            print(f"empty_last={x}")
        case None:
            print("empty_last=none")

    # nth — middle, first, out-of-range, negative.
    Option[int] n2 = v.iter().nth(2)
    match n2:
        case Some(x):
            print(f"nth2={x}")
        case None:
            print("nth2=none")

    Option[int] n0 = v.iter().nth(0)
    match n0:
        case Some(x):
            print(f"nth0={x}")
        case None:
            print("nth0=none")

    Option[int] n_past = v.iter().nth(99)
    match n_past:
        case Some(x):
            print(f"nth99={x}")
        case None:
            print("nth99=none")

    Option[int] n_neg = v.iter().nth(-1)
    match n_neg:
        case Some(x):
            print(f"nth_neg={x}")
        case None:
            print("nth_neg=none")

    # min — Comparable-bounded default. Returns smallest int.
    Option[int] lo = v.iter().min()
    match lo:
        case Some(x):
            print(f"min={x}")
        case None:
            print("min=none")

    # max — Comparable-bounded default. Returns largest int.
    Option[int] hi = v.iter().max()
    match hi:
        case Some(x):
            print(f"max={x}")
        case None:
            print("max=none")

    # min on empty — None.
    Option[int] empty_min = empty.iter().min()
    match empty_min:
        case Some(x):
            print(f"empty_min={x}")
        case None:
            print("empty_min=none")

    # contains — Equatable-bounded default. Hit and miss.
    bool has12 = v.iter().contains(12)
    bool has99 = v.iter().contains(99)
    print(f"has12={has12}")
    print(f"has99={has99}")

    # sum — Numeric-bounded default. T.default() is the additive
    # identity (0 for int).
    int total = v.iter().sum()
    print(f"sum={total}")
    int empty_sum = empty.iter().sum()
    print(f"empty_sum={empty_sum}")

    # product — Numeric-bounded default. T.one() is the
    # multiplicative identity (1 for int).
    Vector[int] small = Vector[int]()
    small.push(2)
    small.push(3)
    small.push(4)
    int prod = small.iter().product()
    print(f"product={prod}")
    int empty_product = empty.iter().product()
    print(f"empty_product={empty_product}")

    # join — Displayable-bounded default. `int` has Displayable
    # via the prelude derive.
    String joined = small.iter().join(", ")
    print(f"joined=[{joined}]")
    String empty_joined = empty.iter().join("|")
    print(f"empty_joined=[{empty_joined}]")

    return 0
