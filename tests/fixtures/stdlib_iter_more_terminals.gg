# Exercise the second wave of iterator terminals via the method form
# on `VectorIter[T]` (default-body trait methods on `Iterator[T]`).
# Replaces the previous `_iter` free-function calls; the free fns
# `find_index_iter` / `last_iter` / `nth_iter` were retired in the
# Phase 2c convenience-wrapper migration.
#
# Also covers the bound-needing terminals `min` / `max` / `contains`
# — shipped as default methods on `Iterator[T]`. The demand-gate
# (`all_return_nominals_registered`) only emits each per-impl
# monomorphisation when a call site actually reaches for it, so
# Iterator implementors with non-Comparable / non-Equatable T's
# never have these specialised. `sum` / `product` / `join` remain
# as free functions in `std.iter` for separate compiler reasons —
# see iter.gg and stdlib-design.md §10.

from std.iter import VectorIter
from std.collections import Vector

bool is_even(int x):
    return x % 2 == 0

bool gt_hundred(int x):
    return x > 100

int main():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(11)
    v.push(12)
    v.push(13)
    v.push(14)

    # find_index — first even is at index 0 (10 is even).
    Option[int] idx0 = v.iter().find_index(is_even)
    match idx0:
        case Some(i):
            print(f"idx_even={i}")
        case None:
            print("idx_even=none")

    # find_index — no match.
    Option[int] idx_none = v.iter().find_index(gt_hundred)
    match idx_none:
        case Some(i):
            print(f"idx_big={i}")
        case None:
            print("idx_big=none")

    # last — tail of the vector.
    Option[int] tail = v.iter().last()
    match tail:
        case Some(x):
            print(f"last={x}")
        case None:
            print("last=none")

    # last on empty — None.
    Vector[int] empty = Vector[int]()
    Option[int] empty_last = empty.iter().last()
    match empty_last:
        case Some(x):
            print(f"empty_last={x}")
        case None:
            print("empty_last=none")

    # nth — middle, first, out-of-range, negative.
    Option[int] n2 = v.iter().nth(2)
    match n2:
        case Some(x):
            print(f"nth2={x}")
        case None:
            print("nth2=none")

    Option[int] n0 = v.iter().nth(0)
    match n0:
        case Some(x):
            print(f"nth0={x}")
        case None:
            print("nth0=none")

    Option[int] n_past = v.iter().nth(99)
    match n_past:
        case Some(x):
            print(f"nth99={x}")
        case None:
            print("nth99=none")

    Option[int] n_neg = v.iter().nth(-1)
    match n_neg:
        case Some(x):
            print(f"nth_neg={x}")
        case None:
            print("nth_neg=none")

    # min — Comparable-bounded default. Returns smallest int.
    Option[int] lo = v.iter().min()
    match lo:
        case Some(x):
            print(f"min={x}")
        case None:
            print("min=none")

    # max — Comparable-bounded default. Returns largest int.
    Option[int] hi = v.iter().max()
    match hi:
        case Some(x):
            print(f"max={x}")
        case None:
            print("max=none")

    # min on empty — None.
    Option[int] empty_min = empty.iter().min()
    match empty_min:
        case Some(x):
            print(f"empty_min={x}")
        case None:
            print("empty_min=none")

    # contains — Equatable-bounded default. Hit and miss.
    bool has12 = v.iter().contains(12)
    bool has99 = v.iter().contains(99)
    print(f"has12={has12}")
    print(f"has99={has99}")

    return 0
