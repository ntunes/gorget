# CoW G1 memory-safety gate (round-33): a 3-LEVEL index + field-ASSIGN
# (`m[i][j][k].field = x`) — three transient element handles in the chain, all
# must be untracked before the same-collection push reallocs the private copy.
from std.collections import Vector

struct Res:
    String name

void f(Vector[Vector[Vector[Res]]] m):
    m[0][0][0].name = "X"
    int i = 0
    while i < 6:
        m.push([[Res("z")]])
        i = i + 1
    print(m.len())               # 7
    print(m[0][0][0].name)       # X

void main():
    Vector[Vector[Vector[Res]]] a = [[[Res("orig")]]]
    f(a)
    print(a.len())               # 1  (caller untouched)
    print(a[0][0][0].name)       # orig
    print("done")
