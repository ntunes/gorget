from xtd.dataframe import DataFrame, Column, df_from_columns, col_from_ints, col_from_strs, col_from_floats, col_from_bools, col_ints_null, col_strs_null, col_floats_null

void main():
    # ── BoolColumn ─────────────────────────────────────────────
    Vector[bool] bools = Vector[bool]()
    bools.push(true)
    bools.push(false)
    bools.push(true)
    Column bc = col_from_bools(bools)
    print(f"{bc.dtype_name()}")
    print(f"{bc.value_as_str(0)}")

    # ── Null handling via col_ints_null ─────────────────────────
    # age col: [25, 0, 35] with mask [true, false, true] → row 1 is null
    Vector[int] ages = Vector[int]()
    ages.push(25)
    ages.push(0)
    ages.push(35)
    Vector[bool] mask = Vector[bool]()
    mask.push(true)
    mask.push(false)
    mask.push(true)
    Column age_col = col_ints_null(ages, mask)
    print(f"{age_col.is_null_at(1)}")
    print(f"{age_col.null_count()}")

    # ── col_strs_null ───────────────────────────────────────────
    Vector[String] names = Vector[String]()
    names.push("Alice")
    names.push("")
    names.push("Bob")
    Vector[bool] smask = Vector[bool]()
    smask.push(true)
    smask.push(false)
    smask.push(true)
    Column name_col = col_strs_null(names, smask)
    print(f"{name_col.is_null_at(1)}")

    # ── fillna_int ──────────────────────────────────────────────
    Vector[String] col_names = Vector[String]()
    col_names.push("age")
    Vector[Column] cols = Vector[Column]()
    cols.push(age_col)
    DataFrame df = df_from_columns(col_names, cols)
    DataFrame filled = df.fillna_int("age", 0)
    Column filled_col = filled.get_column("age")
    print(f"{filled_col.is_null_at(1)}")
    print(f"{filled_col.null_count()}")

    # ── dropna ──────────────────────────────────────────────────
    DataFrame dropped = df.dropna()
    print(f"{dropped.nrows()}")

    # ── column_names ────────────────────────────────────────────
    Vector[String] cn2 = Vector[String]()
    cn2.push("x")
    cn2.push("y")
    cn2.push("z")
    Vector[int] xd = Vector[int]()
    xd.push(1)
    xd.push(2)
    xd.push(3)
    Vector[Column] cols2 = Vector[Column]()
    cols2.push(col_from_ints(xd))
    cols2.push(col_from_ints(xd))
    cols2.push(col_from_ints(xd))
    DataFrame df2 = df_from_columns(cn2, cols2)
    Vector[String] cnames = df2.column_names()
    print(f"{cnames.len()}")
    print(f"{cnames.get(0).unwrap()}")

    # ── apply_float ─────────────────────────────────────────────
    Vector[String] fcols = Vector[String]()
    fcols.push("score")
    Vector[float] scores = Vector[float]()
    scores.push(1.0)
    scores.push(2.0)
    scores.push(3.0)
    Vector[Column] fc = Vector[Column]()
    fc.push(col_from_floats(scores))
    DataFrame dff = df_from_columns(fcols, fc)
    float(float) double_fn = (float x): x * 2.0
    DataFrame dff2 = dff.apply_float("score", double_fn)
    # verify the transformation ran (nrows/ncols unchanged)
    print(f"{dff2.nrows()}")
    print(f"{dff2.ncols()}")

    # ── apply_str ───────────────────────────────────────────────
    Vector[String] scols = Vector[String]()
    scols.push("name")
    Vector[String] sdata = Vector[String]()
    sdata.push("hello")
    sdata.push("world")
    Vector[Column] sc2 = Vector[Column]()
    sc2.push(col_from_strs(sdata))
    DataFrame dfs = df_from_columns(scols, sc2)
    str(String) identity_fn = (String s): s
    DataFrame dfs2 = dfs.apply_str("name", identity_fn)
    Column nc = dfs2.get_column("name")
    print(f"{nc.value_as_str(0)}")

    # ── display() smoke test ─────────────────────────────────────
    String disp = df2.display()
    print(f"{disp.byte_len() > 0}")

    # ── fillna_float ─────────────────────────────────────────────
    Vector[float] fv = Vector[float]()
    fv.push(1.5)
    fv.push(0.0)
    Vector[bool] fm = Vector[bool]()
    fm.push(true)
    fm.push(false)
    Column float_col = col_floats_null(fv, fm)
    Vector[String] fn_names = Vector[String]()
    fn_names.push("flt")
    Vector[Column] fn_cols = Vector[Column]()
    fn_cols.push(float_col)
    DataFrame df_flt = df_from_columns(fn_names, fn_cols)
    DataFrame df_flt2 = df_flt.fillna_float("flt", 9.9)
    Column flt_col = df_flt2.get_column("flt")
    print(f"{flt_col.value_as_str(0)}")
    print(f"{flt_col.value_as_str(1)}")

    # ── fillna_str ────────────────────────────────────────────────
    Vector[String] sv2 = Vector[String]()
    sv2.push("hello")
    sv2.push("")
    Vector[bool] sm2 = Vector[bool]()
    sm2.push(true)
    sm2.push(false)
    Column str_col2 = col_strs_null(sv2, sm2)
    Vector[String] sn_names = Vector[String]()
    sn_names.push("msg")
    Vector[Column] sn_cols = Vector[Column]()
    sn_cols.push(str_col2)
    DataFrame df_msg = df_from_columns(sn_names, sn_cols)
    DataFrame df_msg2 = df_msg.fillna_str("msg", "default")
    Column msg_col = df_msg2.get_column("msg")
    print(f"{msg_col.value_as_str(0)}")
    print(f"{msg_col.value_as_str(1)}")
