# Test: stale-condition warning through function call.
# int val = some_fn(x) should be tainted by shared x,
# and using val in a condition after await should warn.

directive scheduler=single

int double(int n):
    return n * 2

async void worker(int &counter):
    counter = counter + 1

async void main():
    shared int x = 0
    Task[void] t = spawn worker(&x)
    int val = double(x)
    t.await()
    if val == 0:
        print("stale call fired")
    print(x)
