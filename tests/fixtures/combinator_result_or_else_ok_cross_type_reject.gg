# NEG (Round XXIII Track α): Result[T, E].or_else(closure -> Result[T', E'])
# where T' ≠ T must be REJECTED at typecheck (Ok-unify: the recovery axis is
# the Error side; the Ok payload must be a passthrough).
#
# Pre-fix: this shape was ACCEPTED at typecheck; the lowerer's missing `or_else`
# arm (`_ => recv_type`) then birthed `result_local` as `Result[int, int]` (recv
# size 16) while the closure's Result[Money, int] returned into it → stack-
# buffer-overflow READ of 80 bytes at the merge memcpy (scout probe
# `/tmp/probe_or_else_ok_cross.gg`, RED-verified pre-fix).
#
# Post-fix: `unify_closure_ret_axis(ClosureCombinatorCell::ResultOrElse)` in
# `src/semantic/typecheck.rs` rejects at check time with `E_TypeMismatch`
# — the lowerer never sees the ill-typed shape.
#
# Reject-fixtures may live in `tests/fixtures/` directly (they are `check`-only
# and never enter the runtime-diff corpus).

struct Money:
    Vector[int] cents

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

# Closure return: Result[Money, int]. Receiver has Ok payload = int.
# T'=Money, T=int → T' ≠ T → REJECT.
Result[Money, int] promote(int e):
    return Ok(Money(heap_cents(3)))

void via_param(Result[int, int] p):
    Result[Money, int] r = p.or_else((int e): promote(e))
    match r:
        case Ok(m):
            print(m.cents.len())
        case Error(e):
            print(-1)

void main():
    via_param(Error(1))
