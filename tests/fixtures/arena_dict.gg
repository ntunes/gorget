from std.alloc import Arena
from std.collections import Dict

void main():
    with Arena(8192) as pool:
        Dict[String, int] ages = Dict[String, int]()
        ages.put("alice", 30)
        ages.put("bob", 25)
        ages.put("carol", 35)
        print(f"len: {ages.len()}")
        print(f"alice: {ages.get("alice").unwrap()}")
        print(f"bytes_used > 0: {pool.bytes_used() > 0}")
    print("done")
