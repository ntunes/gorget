from std.alloc import FixedBufferAllocator
from std.collections import Vector

void leak_via_assign():
    Vector[int] outer = Vector[int]()
    with FixedBufferAllocator(4096) as fba:
        Vector[int] inner = Vector[int]()
        inner.push(42)
        outer = !inner

void main():
    print("done")
