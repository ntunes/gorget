# ==== T-FMT-C · nesting and width
#
# AXIS (2 cells):
#   * match-in-match — an inline arm holding a block-form match holding an
#     inline arm. Each suite keeps its own spelling regardless of depth,
#     because the layout is a property of the Block, not of the emitter's
#     recursion state.
#   * breakable inline HEADER — an inline suite whose header expression can
#     break. Width never re-decides the suite's FORM: the body still rides the
#     header's last line. What width DOES decide is whether the header itself
#     breaks, and under the tail reserve it does — the header is charged for
#     the `:`, the separating space, and the body's leading unbreakable text,
#     so this 153-column one-liner comes back INTO budget as a broken header
#     with the suite intact. If over-width ever started EXPLODING the suite,
#     `gg fmt` would silently rewrite a one-liner the author chose, and the
#     reason would be invisible in the source. The line overruns only when the
#     body's leading unbreakable text exceeds the budget — that residual is
#     the inline-BODY collision escape, and its own cell lives in
#     `tests/fixtures/fmt_tail_reserve/inline_body_escape.gg`.
#
# RED pre-fix (recorded 2026-08-11): both cells EXPLODED / collapsed and the
# nested cell gained blanks; the over-width cell exploded like every other
# inline `if`.
#
# RE-PINNED (R42 tail reserve): the second cell's AXIS VALUE dissolved. It used
# to read "over-width inline stays inline" and its pin was the unbroken
# 153-column line; the header now breaks, so the pin moved to the
# `.expected` sibling and the cell's subject is the sentence above.

int deep(int x):
    int r = match x:
        case 1: match x:
            case 1: 100
            case 2:
                200
            else: 300
        case 2:
            int inner = match x:
                case 1: 10
                else:
                    20
            inner
        else: 0
    return r

void over_width(int a_long_input_parameter_name_for_the_width_cell):
    if (a_long_input_parameter_name_for_the_width_cell
        == 1): int an_intentionally_long_local_binding_name = a_long_input_parameter_name_for_the_width_cell
    print(2)

void main():
    print(deep(1))
    over_width(1)
