# ==== T-FMT-C · the spurious-BLANK class — HOSTS
#
# The member axis (`blank_insertion.gg`) varies WHAT suite emits the extra
# newline; this file varies WHICH enclosing statement adds the second one.
# The host list is what proves the fix had to be at the producer: a swap
# driven by a list of `format_stmt` arms could not have covered
# `FunctionBody::Expression`, `format_const_decl` or `format_static_decl`,
# which are not `format_stmt` arms at all.
#
# HOST AXIS (7 cells): assign · compound-assign · return · throw · assert ·
#   expression-body function · top-level `const`.
#
# RED pre-fix (recorded 2026-08-11): every cell gained a blank; the four
# statement hosts also showed the `else:` collapse.

int assign_host(int x):
    int r = 0
    r = match x:
        case 1:
            10
        else:
            20
    return r

int compound_host(int x):
    int r = 0
    r += match x:
        case 1:
            10
        else:
            20
    return r

int return_host(int x):
    return match x:
        case 1:
            10
        else:
            20

String throw_host(int x):
    throw match x:
        case 1:
            "a"
        else:
            "b"

void assert_host(int x):
    assert match x:
        case 1:
            true
        else:
            false
    print(2)

int expr_body_host(int x): match x:
    case 1:
        1
    else:
        2

const int CONST_HOST = match 1:
    case 1:
        10
    else:
        20

void main():
    print(assign_host(1))
    print(compound_host(1))
    print(return_host(1))
    assert_host(1)
    print(expr_body_host(1))
    print(CONST_HOST)
