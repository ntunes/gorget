# ==== ORPHAN-PRE-CLOSE · one cell per author-visible ROUTED block kind (AXIS A)
#
# Every one of these suites reaches the flush through `format_block_stmts` —
# but that is an IMPLEMENTATION fact, and a fixture that assumes it stops being
# a net the moment a kind grows its own emitter. One cell per kind, derived
# from the dedent census's ROUTED rows.
#
# CELLS: loop · unsafe · named scope · `do:` · indented `on error` ·
#        `with … as …:` · `catch (…)` · `rethrow (…)` · statement `meta for` ·
#        `meta while` · `meta type f()`
#
# ⚠ The `meta while` cell is the DISCRIMINATOR for the `Block::header_start`
# field's meta-while row: that parser takes its block span AFTER consuming the
# colon, so `Block.span.start` is the NEWLINE on the BODY's own line — a
# header-indent test against it claims nothing. The cell stays RED with the
# flush wired but the field unwired.
#
# RED, observed on the pre-fix build: every `# tail in …` marker dedented one
# level out of its block (or to column 0 where the block was the function's
# last statement).

struct Res:
    int v

int fallible(int x) throws String:
    if x < 0:
        throw "negative"
    return x

void routed_kinds():
    loop:
        break
        # tail in loop body
    unsafe:
        print(1)
        # tail in unsafe body
    cleanup:
        print(2)
        # tail in named scope body
    int d = do:
        3
        # tail in do body
    on error:
        print(4)
        # tail in on error body
    Res r = Res(5)
    with r as held:
        print(held.v)
        # tail in with body
    print(d)

int catch_kinds(int x):
    int a = fallible(x) catch (e):
        print("recovered")
        0
        # tail in catch body
    return a

int rethrow_kind(int x) throws String:
    int b = fallible(x) rethrow (String e):
        print("wrapping")
        e
        # tail in rethrow body
    return b

void meta_kinds[T]():
    meta for i in 0..2:
        print(i)
        # tail in meta for body
    meta while bitwidth(T) > 128:
        print("impossible")
        # tail in meta while body
    print(1)

meta type Wrapped(Type t):
    return t
    # tail in meta type fn body

void main():
    routed_kinds()
    print(catch_kinds(1))
    meta_kinds[int]()
