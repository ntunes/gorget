struct RuntimeException:
    String msg

void define_own_property(int obj_id, String key) throws RuntimeException:
    print(f"set {key} on obj {obj_id}")

void main():
    Result[void, RuntimeException] __d29_r1 = define_own_property(1, "foo")
    match __d29_r1:
        case Ok(_):
            print("done")
        case Error(_):
            print("err")
