void main():
    # Option combinators
    Option[int] some = Some(42)
    Option[int] none = None()

    # unwrap_or_else
    print(f"{some.unwrap_or_else((): 0)}")
    print(f"{none.unwrap_or_else((): 99)}")

    # filter
    Option[int] filtered = some.filter((int x): x > 40)
    Option[int] rejected = some.filter((int x): x > 50)
    print(f"{filtered.unwrap()}")
    if rejected.is_none():
        print("true")

    # or
    Option[int] alt_opt = Some(77)
    Option[int] or_some = some.or(alt_opt)
    Option[int] or_none = none.or(alt_opt)
    print(f"{or_some.unwrap()}")
    print(f"{or_none.unwrap()}")

    # map (verify type checker integration)
    Option[int] doubled = some.map((int x): x * 2)
    print(f"{doubled.unwrap()}")

    # and_then chaining
    Option[int] chained = some.and_then((int x): Some(x + 1))
    print(f"{chained.unwrap()}")

    # flatten
    Option[Option[int]] nested = Some(Some(100))
    Option[int] flat = nested.flatten()
    print(f"{flat.unwrap()}")

    Option[Option[int]] none_outer = None()
    Option[int] flat_none = none_outer.flatten()
    bool is_none1 = flat_none.is_none()
    print(f"{is_none1}")

    Option[Option[int]] some_none = Some(None())
    Option[int] flat_some_none = some_none.flatten()
    bool is_none2 = flat_some_none.is_none()
    print(f"{is_none2}")

    # Result combinators
    Result[int, String] ok = Ok(10)
    Result[int, String] err = Error("fail")

    # unwrap_or_else
    print(f"{ok.unwrap_or_else((String e): 0)}")
    print(f"{err.unwrap_or_else((String e): 99)}")

    # unwrap_error
    print(err.unwrap_error())

    # map_err
    Result[int, String] mapped_err = err.map_err((String e): "mapped")
    print(mapped_err.unwrap_error())

    # or
    Result[int, String] alt_ok = Ok(77)
    Result[int, String] or_ok = ok.or(alt_ok)
    Result[int, String] or_err = err.or(alt_ok)
    print(f"{or_ok.unwrap()}")
    print(f"{or_err.unwrap()}")

    # map (verify type checker integration)
    Result[int, String] doubled_r = ok.map((int x): x * 2)
    print(f"{doubled_r.unwrap()}")
