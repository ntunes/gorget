#!parity-excluded allocator: prints a mem_live() delta against a baseline — live-heap bytes differ per lane
from std.os import mem_live
from std.collections import Vector

# Stress test: string allocation and deallocation.
# Every section creates owned strings in loops and lets them go out of scope.
# mem_live() at the end should be close to the baseline (within tolerance
# for runtime overhead / static allocations that don't get freed).

void main():
    int baseline = mem_live()

    # --- Section 1: f-string creation in a loop ---
    int i = 0
    while i < 1000:
        String s = f"iteration-{i}"
        i = i + 1

    # --- Section 2: String concatenation in a loop ---
    i = 0
    while i < 1000:
        String s = "hello" + " " + "world" + " " + f"{i}"
        i = i + 1

    # --- Section 3: String methods returning new strings ---
    i = 0
    while i < 500:
        String base = f"  Hello World {i}  "
        String trimmed = base.trim()
        String upper = base.to_upper()
        String lower = base.to_lower()
        String replaced = base.replace("World", "Gorget")
        i = i + 1

    # --- Section 4: String.split() returns Vector[String] ---
    i = 0
    while i < 500:
        String csv = f"a,b,c,d,{i}"
        Vector[String] parts = csv.split(",")
        i = i + 1

    # --- Section 5: String owned (String type) in a loop ---
    i = 0
    while i < 1000:
        String s = String()
        s.push("hello ")
        s.push(f"world {i}")
        i = i + 1

    # --- Section 6: Strings in Vector, pushed and dropped ---
    i = 0
    while i < 100:
        Vector[String] v = Vector[String]()
        int j = 0
        while j < 50:
            v.push(f"item-{i}-{j}")
            j = j + 1
        i = i + 1

    # --- Section 7: Function-returned strings ---
    i = 0
    while i < 1000:
        String s = make_greeting(i)
        i = i + 1

    int leaked = mem_live() - baseline
    print(f"leaked={leaked > 0}")
    print("done")

String make_greeting(int n):
    return f"Hello, user #{n}!"
