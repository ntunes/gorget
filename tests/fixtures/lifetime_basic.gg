# Lifetime inference — positive tests (should compile and run without errors)

# Returning a string literal is always safe (Static origin)
str get_greeting() = "hello"

# Returning a parameter directly is safe (Param origin)
str identity(str s) = s

# Chaining through multiple functions — origin propagates
str first(str a, str b) = a

str chain(str s) = identity(s)

# Using str views from string literals — always safe
void use_literal_views():
    str a = "hello"
    str b = "world"
    print(a)
    print(b)

# str from param forwarded through a local
str forward(str s):
    str local = s
    return local

# live annotation on parameter
str first_live(live str a, str b) = a

void main():
    print(get_greeting())
    print(identity("world"))
    print(first("a", "b"))
    print(chain("chained"))
    use_literal_views()
    print(forward("forwarded"))
    print(first_live("live_a", "live_b"))
    print("all lifetime checks passed")
