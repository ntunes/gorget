from std.collections import Vector

void main():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)

    # index_of
    int found_idx = v.index_of(20).unwrap()
    print(f"{found_idx}")
    bool not_found = v.index_of(99).is_none()
    print(f"{not_found}")

    # insert
    v.insert(1, 15)
    print(f"{v.get(1).unwrap()}")
    print(f"{v.len()}")

    # extend
    Vector[int] other = Vector[int]()
    other.push(50)
    other.push(60)
    v.extend(other)
    print(f"{v.len()}")
    print(f"{v.get(6).unwrap()}")

    # slice
    Vector[int] s = v[0:3]
    print(f"{s.len()}")
    print(f"{s.get(0).unwrap()}")
    print(f"{s.get(2).unwrap()}")

    # any
    bool has_big = v.any((int x): x > 50)
    print(f"{has_big}")
    bool has_neg = v.any((int x): x < 0)
    print(f"{has_neg}")

    # all
    bool all_pos = v.all((int x): x > 0)
    print(f"{all_pos}")
    bool all_small = v.all((int x): x < 30)
    print(f"{all_small}")

    # contains
    bool has20 = v.contains(20)
    print(f"{has20}")
    bool has99 = v.contains(99)
    print(f"{has99}")
