# Cross-frame Bounds, NO catch in the caller (error-model.md §11, Increment
# 2.1d): `deep_catcher` makes `getx` PARTICIPATE; `main`'s second call passes a
# NULL fault-slot, so the deep OOB takes the NULL branch → panic-by-default,
# exit 1. NEGATIVE fixture (non-zero exit).
int getx(Vector[int] xs, int i): xs[i]

void deep_catcher():
    Vector[int] xs = [10, 20, 30]
    int caught = getx(xs, 99) catch Fault.Bounds: 42
    print(f"{caught}")                      # prints 42 (OOB caught)

void main():
    deep_catcher()                          # prints 42
    Vector[int] ys = [1, 2]
    int r = getx(ys, 99)                    # NO catch → NULL slot → panic, exit 1
    print(f"{r}")                           # never reached
