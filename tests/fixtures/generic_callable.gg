T apply[T](Callable[T(int)] f, int x):
    return f(x)

int double(int n):
    return n * 2

String describe(int n):
    return "val"

void main():
    int r1 = apply[int]((int n): n * 2, 5)
    print(f"{r1}")
    String r2 = apply[String]((int n): "val", 3)
    print(r2)
    int r3 = apply[int](double, 7)
    print(f"{r3}")
    print("done")
