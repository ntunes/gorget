# Generic struct equipped with a custom trait
trait Describable:
    int code(self)

struct Container[T]:
    T value

equip Container[T] with Describable:
    int code(self):
        return 42

# Trait with a default method on a generic struct
trait Labeled:
    int label(self)
    int full_label(self):
        return self.label() * 10

struct Wrapper[T]:
    T inner

equip Wrapper[T] with Labeled:
    int label(self):
        return 7

void main():
    # Direct trait method calls with multiple instantiations
    Container[int] c1 = Container[int](100)
    Container[str] c2 = Container[str]("hello")
    print(c1.code())
    print(c2.code())

    # Default method on generic type
    Wrapper[int] w1 = Wrapper[int](10)
    Wrapper[str] w2 = Wrapper[str]("world")
    print(w1.label())
    print(w1.full_label())
    print(w2.label())
    print(w2.full_label())
