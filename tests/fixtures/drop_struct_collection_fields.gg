from std.collections import Vector

struct Container:
    str label
    Vector[int] data

equip Container with Drop:
    void drop(!self):
        print("drop {self.label} len={self.data.len()}")

struct Wrapper:
    Container inner
    int id

Container make_container(str label, int val):
    Container c = Container(label, Vector[int]())
    c.data.push(val)
    return c

void main():
    Vector[Container] items = Vector[Container]()

    Container c1 = Container("first", Vector[int]())
    c1.data.push(1)
    c1.data.push(2)
    items.push(c1)

    Container c2 = Container("second", Vector[int]())
    c2.data.push(3)
    items.push(c2)

    # Push from function return (non-Identifier argument)
    items.push(make_container("third", 42))

    print("len {items.len()}")

    # .get().unwrap() gives independent copy
    auto got = items.get(0).unwrap()
    print("got {got.label} len={got.data.len()}")

    # set() pre-drops old element before overwriting
    Container old_c = Container("old", Vector[int]())
    old_c.data.push(10)
    old_c.data.push(20)
    Vector[Container] v2 = Vector[Container]()
    v2.push(old_c)

    Container new_c = Container("new", Vector[int]())
    new_c.data.push(99)
    v2.set(0, new_c)

    auto after = v2.get(0).unwrap()
    print("after set: {after.label}")

    # deep-clone drops: Wrapper has no Drop, but Container field does
    Vector[Wrapper] wrappers = Vector[Wrapper]()
    Wrapper w1 = Wrapper(Container("wrapped", Vector[int]()), 1)
    w1.inner.data.push(100)
    wrappers.push(w1)

    auto w = wrappers.get(0).unwrap()
    print("wrapper id={w.id}")

    # deep-clone of direct collection type from nested .get()
    # Before fix: deep-cloned Vector[int] got no drops → buffer leaked.
    # After fix: ArrayFree registered → buffer properly freed.
    Vector[Vector[int]] nested = Vector[Vector[int]]()
    Vector[int] inner = Vector[int]()
    inner.push(42)
    inner.push(99)
    nested.push(inner)
    auto v = nested.get(0).unwrap()
    print("nested len={v.len()}")

    print("done")
