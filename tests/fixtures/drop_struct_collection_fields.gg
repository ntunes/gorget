from std.collections import Vector

struct Container:
    str label
    Vector[int] data

equip Container with Drop:
    void drop(!self):
        print("drop {self.label} len={self.data.len()}")

Container make_container(str label, int val):
    Container c = Container(label, Vector[int]())
    c.data.push(val)
    return c

void main():
    Vector[Container] items = Vector[Container]()

    Container c1 = Container("first", Vector[int]())
    c1.data.push(1)
    c1.data.push(2)
    items.push(c1)

    Container c2 = Container("second", Vector[int]())
    c2.data.push(3)
    items.push(c2)

    # Push from function return (non-Identifier argument)
    items.push(make_container("third", 42))

    print("len {items.len()}")

    # .get().unwrap() gives independent copy
    auto got = items.get(0).unwrap()
    print("got {got.label} len={got.data.len()}")

    print("done")
