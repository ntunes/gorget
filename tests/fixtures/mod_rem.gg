# Test % (remainder) and mod (modulo) operators

void main():
    # Remainder: sign matches dividend (left operand)
    int r1 = 7 % 3
    int r2 = -7 % 3
    int r3 = 7 % -3
    int r4 = -7 % -3
    print(f"{r1}")
    print(f"{r2}")
    print(f"{r3}")
    print(f"{r4}")

    # Modulo: sign matches divisor (right operand)
    int m1 = -7 mod 3
    int m2 = 7 mod -3
    int m3 = -7 mod -3
    print(f"{m1}")
    print(f"{m2}")
    print(f"{m3}")

    # Positive operands: remainder == modulo
    int m4 = 7 mod 3
    int m5 = 10 mod 4
    print(f"{m4}")
    print(f"{m5}")

    # Float modulo
    float fm = -7.0 mod 3.0
    print(f"{fm}")

    # Compound remainder assignment
    int x = 10
    x %= 3
    print(f"{x}")

    # Zero cases
    int z1 = 0 % 3
    int z2 = 0 mod 3
    print(f"{z1}")
    print(f"{z2}")
