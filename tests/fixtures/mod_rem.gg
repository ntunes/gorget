# Test % (remainder) and mod (modulo) operators

void main():
    # Remainder: sign matches dividend (left operand)
    int r1 = 7 % 3
    int r2 = -7 % 3
    int r3 = 7 % -3
    int r4 = -7 % -3
    print("{r1}")
    print("{r2}")
    print("{r3}")
    print("{r4}")

    # Modulo: sign matches divisor (right operand)
    int m1 = -7 mod 3
    int m2 = 7 mod -3
    int m3 = -7 mod -3
    print("{m1}")
    print("{m2}")
    print("{m3}")

    # Positive operands: remainder == modulo
    int m4 = 7 mod 3
    int m5 = 10 mod 4
    print("{m4}")
    print("{m5}")

    # Float modulo
    float fm = -7.0 mod 3.0
    print("{fm}")

    # Compound remainder assignment
    int x = 10
    x %= 3
    print("{x}")

    # Zero cases
    int z1 = 0 % 3
    int z2 = 0 mod 3
    print("{z1}")
    print("{z2}")
