# D10(a) NEGATIVE (decisions.md, ratified 2026-07-06): binding a mutable
# borrow of a projected place to a local name (`auto r = &b.data`) is
# rejected — same class as the bare form (`cow_amp_bind_ref`): one exclusive
# writer per place; a named `&`-binding would alias a second writable path.
# Expected: error[E_LocalBorrowBind] at the `&b.data` initializer.
struct Holder:
    Vector[int] data

void main():
    Vector[int] init = [1, 2, 3]
    Holder a = Holder(init)
    Holder b = a
    auto r = &b.data
    r.push(9)
    print(a.data.len())
    print(b.data.len())
    print("done")
