# Comprehensive HashMap method coverage (order-independent verification)
from std.collections import HashMap, Vector

void main():
    # ===== Construction =====
    HashMap[String, int] m = HashMap[String, int]()
    print(f"{m.len()}")
    print(f"{m.is_empty()}")

    # ===== Subscript assignment (put) =====
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    print(f"{m.len()}")
    print(f"{m.is_empty()}")

    # ===== Overwrite via subscript =====
    m["a"] = 10
    print(f"{m.get("a").unwrap()}")
    print(f"{m.len()}")

    # ===== get (returns Option) =====
    Option[int] present = m.get("b")
    print(f"{present.is_some()}")
    print(f"{present.unwrap()}")
    Option[int] absent = m.get("z")
    print(f"{absent.is_none()}")
    print(f"{absent.is_some()}")

    # ===== contains =====
    print(f"{m.contains("a")}")
    print(f"{m.contains("z")}")

    # ===== remove (returns Option[V]) =====
    Option[int] rem1 = m.remove("b")
    print(f"{rem1.unwrap()}")
    Option[int] rem2 = m.remove("nonexistent")
    print(f"{rem2.is_none()}")
    print(f"{m.len()}")
    print(f"{m.get("b").is_none()}")
    print(f"{m.contains("b")}")

    # ===== clear =====
    HashMap[String, int] m2 = HashMap[String, int]()
    m2["x"] = 100
    m2["y"] = 200
    print(f"{m2.len()}")
    m2.clear()
    print(f"{m2.len()}")
    print(f"{m2.is_empty()}")
    # Clear already-empty (no crash)
    m2.clear()
    print(f"{m2.len()}")

    # ===== keys (verify count via len) =====
    HashMap[String, int] m3 = HashMap[String, int]()
    m3["x"] = 10
    m3["y"] = 20
    m3["z"] = 30
    Vector[String] ks = m3.keys()
    print(f"{ks.len()}")

    # ===== values (verify sum via fold, order-independent) =====
    Vector[int] vs = m3.values()
    print(f"{vs.len()}")
    int val_sum = vs.fold(0, (int acc, int v): acc + v)
    print(f"{val_sum}")

    # ===== fold on map (order-independent sum) =====
    int total = m3.fold(0, (int acc, String k, int v): acc + v)
    print(f"{total}")

    # ===== fold on empty =====
    HashMap[String, int] empty_m = HashMap[String, int]()
    int zero = empty_m.fold(0, (int acc, String k, int v): acc + v)
    print(f"{zero}")

    # ===== get_or =====
    print(f"{m3.get_or("x", 99)}")
    print(f"{m3.get_or("missing", 99)}")

    # ===== update =====
    HashMap[String, int] u1 = HashMap[String, int]()
    u1["a"] = 1
    u1["b"] = 2
    HashMap[String, int] u2 = HashMap[String, int]()
    u2["b"] = 20
    u2["c"] = 30
    u1.update(u2)
    print(f"{u1.len()}")
    # Verify all values via fold sum: 1 + 20 + 30 = 51
    int update_sum = u1.fold(0, (int acc, String k, int v): acc + v)
    print(f"{update_sum}")
    # Verify specific keys
    print(f"{u1.get("a").unwrap()}")
    print(f"{u1.get("b").unwrap()}")
    print(f"{u1.get("c").unwrap()}")

    # ===== keys/values on empty =====
    print(f"{empty_m.keys().len()}")
    print(f"{empty_m.values().len()}")

    # ===== put then remove then re-add =====
    HashMap[String, int] cycle = HashMap[String, int]()
    cycle["k"] = 1
    cycle.remove("k")
    print(f"{cycle.is_empty()}")
    cycle["k"] = 2
    print(f"{cycle.get("k").unwrap()}")
    print(f"{cycle.len()}")

    # ===== Overwrite preserves len =====
    HashMap[String, int] ow = HashMap[String, int]()
    ow["x"] = 10
    ow["x"] = 20
    ow["x"] = 30
    print(f"{ow.len()}")
    print(f"{ow.get("x").unwrap()}")

    print("done")
