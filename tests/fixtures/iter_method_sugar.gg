# Iterator method sugar — `.take()` / `.skip()` / `.chain()` as equip
# methods on VectorIter.
#
# Each adapter method constructs the concrete state-machine struct
# (TakeIter / SkipIter / ChainIter) and returns it by value. No
# trait-object dispatch, no boxing — the chain fuses at the
# monomorphized layer.
#
# Method sugar with method-level generic params (`.map[U, F]` /
# `.filter[F]`) is not wired yet — see iter.gg.

from std.collections import Vector
from std.iter import VectorIter, TakeIter, SkipIter, ChainIter

int main():
    Vector[int] v = [1, 2, 3, 4, 5]

    # take(n)
    TakeIter[VectorIter[int], int] t = v.iter().take(3)
    for x in t:
        print(x)

    print("--")

    # skip(n)
    SkipIter[VectorIter[int], int] s = v.iter().skip(2)
    for x in s:
        print(x)

    print("--")

    # chain(other)
    Vector[int] w = [100, 200]
    ChainIter[VectorIter[int], VectorIter[int], int] c = v.iter().chain(w.iter())
    for x in c:
        print(x)

    return 0
