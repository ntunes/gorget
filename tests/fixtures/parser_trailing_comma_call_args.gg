# R39 Phase 2e per-shape regression fixture (Core #12 axis coverage) —
# cell: PAREN terminator × PURE-ITEM parse.  RED-verifies the
# trailing-comma-cascade fix at `parse_call_args` (parser.gg:2268 pre-fix
# line).  Mirrors `compiler/data/resources.gg`'s shape (the file that
# surfaced the defect originally).
#
# The long string arguments this fixture used to carry were a DODGE: they
# padded the call past the width budget so `gg fmt` would keep it multi-line
# and the trailing comma would survive. The 2026-08-16 magic-trailing-comma
# canon RETIRES that dodge — the comma itself is now the author's
# keep-this-exploded signal, at any width — so the arguments are short again
# and the shape holds on its own. Do not re-pad it.
String join3(String prefix_arg, String middle_arg, String suffix_arg):
    return prefix_arg + "|" + middle_arg + "|" + suffix_arg

void main():
    String r = join3(
        "first",
        "middle",
        "final",
    )
    print(r)
