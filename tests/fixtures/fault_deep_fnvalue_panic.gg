# Cross-frame fault, INDIRECT invocation of a participating fn (error-model.md §11,
# Increment 2.1a — memory-safety regression guard, Core #6). A participating callee
# (`faulty`, made participating by the direct catch below) taken as a FIRST-CLASS
# fn-value AND passed to a higher-order fn has a hidden trailing fault-slot param
# that is NOT part of its 2-arg callable type. The closure adapter (`__adapt_faulty`)
# is invoked through the 2-arg ABI, so it MUST pass NULL for the slot — forwarding a
# phantom slot arg would write a fault tag through a wild pointer (a SIGSEGV /
# ASan global-buffer-overflow before this guard). With NULL, the callee's fault arm
# panics by default: indirect fault propagation is deferred to 2.3b, so an
# indirectly-invoked overflow PANICS (exit 1) rather than corrupting memory.
# Run under ASan/UBSan: clean (no wild write).
int faulty(int a, int b): a * b
int apply(int(int,int) f, int x, int y): f(x, y)

void main():
    int big = 4611686018427387904               # 2^62
    # Direct catch → makes `faulty` PARTICIPATE (3-arg signature with the slot).
    int direct = faulty(big, big) catch Fault.Overflow: -1
    print(f"{direct}")                           # -1

    # Indirect, NO overflow: the fn-value / HOF happy path still returns correctly
    # (the NULL slot is benign on the no-fault path).
    int(int,int) fp = faulty
    print(f"{fp(6, 7)}")                          # 42
    print(f"{apply(faulty, 8, 9)}")               # 72

    # Indirect OVERFLOW: panics by default (NULL slot → callee's panic arm), exit 1.
    # No wild write. This print is never reached.
    print(f"{apply(faulty, big, big)}")
