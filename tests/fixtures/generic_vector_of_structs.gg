from std.collections import Vector

struct Score:
    String name
    int value

int sum_values(Vector[Score] scores):
    int total = 0
    for s in scores:
        total = total + s.value
    return total

void main():
    Vector[Score] scores = Vector[Score]()
    scores.push(Score("Alice", 90))
    scores.push(Score("Bob", 85))
    scores.push(Score("Charlie", 95))
    print(sum_values(scores))
