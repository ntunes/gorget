# Iterator sugar over Dict — `d.iter()` returns a lazy
# `DictIter[K, V]` walking the GorgetMap bucket array in place. The
# yielded `(K, V)` tuples come out of the `gorget_map_iter_key`
# / `_value` accessors which clone resource-typed K/V via the map's
# `key_clone` / `val_clone` hooks, so the caller may freely drop the
# pair without disturbing the source map.
#
# `.items()` stays as an eager alias for callers that want a
# materialised Vector.

from std.iter import TakeIter, DictIter

int sum_pair(int acc, (int, int) p):
    return acc + p.0 + p.1

int main():
    Dict[int, int] d = Dict[int, int]()
    d.put(1, 10)
    d.put(2, 20)
    d.put(3, 30)
    d.put(4, 40)

    # Inline for-loop through `.iter()` — yields `(K, V)` pairs.
    for p in d.iter():
        print(p.0)
        print(p.1)

    print("--")

    # take on DictIter[K, V] yields TakeIter[DictIter[K, V], (K, V)].
    TakeIter[DictIter[int, int], (int, int)] t = d.iter().take(2)
    for p in t:
        print(p.0)
        print(p.1)

    print("--")

    # fold terminal over (K, V) pairs — sum keys + values.
    int total = d.iter().fold(0, sum_pair)
    print(total)

    return 0
