struct Item:
    String label
    int count

void main():
    Vector[Item] items = [Item("apples", 3), Item("bananas", 5), Item("cherries", 2)]
    # Index-based loop over vector of structs with String fields
    int i = 0
    int total = 0
    while i < items.len():
        Item item = items.get(i).unwrap()
        print(f"{item.label}: {item.count}")
        total = total + item.count
        i = i + 1
    print(f"total: {total}")
