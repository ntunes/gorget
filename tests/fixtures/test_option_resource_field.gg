struct Wrapper:
    Option[String] name
    Option[Vector[int]] items

enum WResult:
    OkW(Wrapper)
    ErrW(String)

WResult make_w(String s):
    return WResult.OkW(Wrapper(Some(s), None()))

test "option_string_field_is_some":
    Wrapper w = Wrapper(Some("hello"), None())
    assert w.name.is_some()

test "option_string_field_is_none":
    Wrapper w = Wrapper(None(), None())
    assert w.name.is_none()

test "option_string_field_unwrap":
    Wrapper w = Wrapper(Some("world"), None())
    assert w.name.unwrap() == "world"

test "option_vector_field_is_some":
    Vector[int] v = [1, 2, 3]
    Wrapper w = Wrapper(None(), Some(v))
    assert w.items.is_some()

test "option_vector_field_is_none":
    Wrapper w = Wrapper(None(), None())
    assert w.items.is_none()

test "option_vector_literal_into_some":
    Option[Vector[int]] x = Some([1, 2, 3])
    assert x.is_some()
    Vector[int] tags = x.unwrap()
    assert tags.len() == 3

# Snag #25d regression: matching a named local (auto r = ...) and
# unwrapping a struct-field Option in the arm previously double-freed
# the inner String. Direct match (`match make_w("..."):`) always
# worked because the scrutinee was an unnamed temp; only the bind-then-
# match path triggered the aliasing. Both must pass.
test "match_direct_arm_unwrap":
    match make_w("hello"):
        case WResult.OkW(w):
            assert w.name.unwrap() == "hello"
        case WResult.ErrW(_):
            assert false

test "match_bound_arm_unwrap":
    auto r = make_w("hello")
    match r:
        case WResult.OkW(w):
            assert w.name.unwrap() == "hello"
        case WResult.ErrW(_):
            assert false
