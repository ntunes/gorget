from std.collections import Vector

struct T:
    String text

struct E:
    String msg

T sub() throws E:
    return T("hello")

Vector[T] outer() throws E:
    Vector[T] v = Vector[T]()
    v.push(sub()!)
    return v

void main():
    Result[Vector[T], E] __d29_r1 = outer()
    match __d29_r1:
        case Ok(ts):
            print(f"text: '{ts.get(0).unwrap().text}'")
        case Error(_):
            print("err")
