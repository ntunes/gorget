enum Op:
    Add(int)
    Mul(int)

async int compute(int x):
    return x * 3

async int process_literal(int code):
    match code:
        case 1:
            int v = compute(10).await()
            return v
        case 2:
            int v = compute(20).await()
            return v
        else:
            int v = compute(code).await()
            return v

async int process_enum(Op op):
    match op:
        case Add(x):
            int base = compute(x).await()
            return base + x
        case Mul(x):
            int base = compute(x).await()
            return base * x

async int double_match(int a, int b):
    int x = 0
    match a:
        case 1:
            x = compute(1).await()
        else:
            x = compute(a).await()
    int y = 0
    match b:
        case 1:
            y = compute(1).await()
        else:
            y = compute(b).await()
    return x + y

async void main():
    int r1 = process_literal(1).await()
    print(r1)
    int r2 = process_literal(2).await()
    print(r2)
    int r3 = process_literal(5).await()
    print(r3)
    Op add = Add(4)
    int r4 = process_enum(add).await()
    print(r4)
    Op mul = Mul(2)
    int r5 = process_enum(mul).await()
    print(r5)
    int r6 = double_match(1, 2).await()
    print(r6)
