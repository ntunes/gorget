# Fix-2 collision pin: a top-level `struct E` colliding with the trait's
# generic param name must NOT divert the throws resolution (pre-fix:
# spurious E_UnconvertibleErrorPropagation `E` vs `String`).
struct E:
    int code

trait Risky[E]:
    int base(self)
    int risky(self, int x) throws E:
        if x < 0:
            throw "negative"
        return self.base() + x

struct S:
    int v

equip S with Risky[String]:
    int base(self):
        return self.v

int use(S s) throws String:
    return s.risky(5)

void main():
    S s = S(1)
    int y = use(s) catch (e): -1
    print(y)
