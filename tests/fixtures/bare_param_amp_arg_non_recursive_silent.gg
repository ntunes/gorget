# Track I diagnostic control (NEGATIVE 2) — the LOAD-BEARING negative: an
# `&`-formation on a bare (Borrow) Res param WITHOUT self-recursion is a
# Charter-accepted one-shot materialize. `bare_param_mutated` fires but
# `bare_param_recursed_bare` does NOT (rule 5), so the emit block's set-
# intersection is empty and the diagnostic stays silent. Losing this negative
# would make W_RecursiveBareParamMaterialize a de-facto reject on every
# one-shot `&b` — which the owner explicitly ruled out (2026-07-28).
struct Big:
    Vector[int] data

void nudge(Big &x, int n):
    x.data.push(n)

void once(Big b):                  # bare, non-recursive
    nudge(&b, 42)                  # one-shot `&`-formation — silent by design

void main():
    Vector[int] v = [1]
    Big w = Big(!v)
    once(w)
    print(w.data.len())            # 1 — materialize local to `once`
