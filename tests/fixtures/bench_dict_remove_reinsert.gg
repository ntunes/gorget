# D39 Phase A.3 bench: mixed remove + reinsert workload — exercises the
# order-preserving `remove` (O(n) memmove + indices decrement) alongside
# repeated `put` to force dense-map growth cycles. Compare against
# `swap_remove` numbers by delta.

void main():
    Dict[int, int] d = Dict[int, int]()
    int i = 0
    while i < 2000:
        d.put(i, i * 3)
        i += 1

    int iter = 0
    int hits = 0
    while iter < 10:
        int k = 0
        while k < 500:
            Option[int] r = d.remove(k)
            if r.is_some():
                hits += 1
            k += 1

        int j = 0
        while j < 500:
            d.put(j, j * 3)
            j += 1
        iter += 1

    print(f"hits={hits}")
    print(f"len={d.len()}")
