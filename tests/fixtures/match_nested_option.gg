void describe(Option[Option[int]] x):
    match x:
        case Some(inner):
            match inner:
                case Some(v):
                    print(f"value: {v}")
                case None:
                    print("inner none")
        case None:
            print("outer none")

void main():
    Option[Option[int]] a = Some(Some(42))
    Option[Option[int]] b = Some(None)
    Option[Option[int]] c = None
    describe(a)
    describe(b)
    describe(c)
