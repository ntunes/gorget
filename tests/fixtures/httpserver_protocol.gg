#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; it checks URL decoding and status codes in-process; no socket
#!  module is imported
# Test: Protocol correctness — URL decoding, 405 Method Not Allowed, 404.
#
# Tests Router dispatch directly (no TCP) to verify:
#   1. URL-decoded query string: parse_query_string decodes %20 → space
#   2. URL-decoded path: request path decoded before routing (via parse_query_string)
#   3. 405 Method Not Allowed: path exists under different method
#   4. Plain 404: path does not exist at all
#
# Expected output:
#   ok\nok\nok\nok

from xtd.httpserver import HttpRequest, HttpServerResponse, Router, parse_query_string
from std.collections import Dict

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

HttpServerResponse handle_hello(HttpRequest req):
    return HttpServerResponse.ok("hello")

HttpServerResponse handle_data(HttpRequest req):
    return HttpServerResponse.ok("data")

void main():
    # 1. URL-decoded query string: %20 → space
    Dict[String, String] qp = parse_query_string("q=hello%20world&name=John%20Doe")
    check("query_decode_q", qp["q"] == "hello world")

    # 2. URL-decoded path test via a raw path through parse_query_string
    #    (parse_query_string now decodes, test that + stays as + in url_decode)
    Dict[String, String] qp2 = parse_query_string("tag=hello%2Bworld")
    check("query_decode_plus", qp2["tag"] == "hello+world")

    # 3. 405: POST /data when only GET /data is registered
    Router router = Router.new()
    router.get("/data", handle_data)
    HttpRequest post_req = HttpRequest("POST", "/data", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r405 = router.dispatch(post_req)
    check("405_status", r405.status_code == 405)

    # 4. 404: unknown path
    HttpRequest miss_req = HttpRequest("GET", "/missing", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r404 = router.dispatch(miss_req)
    check("404_status", r404.status_code == 404)
