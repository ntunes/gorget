# D10(b) self-root: `g(&self.a, &self.a.b)` inside a method passes two writers
# into OVERLAPPING `self`-rooted places (root `self`, paths `["a"]` and
# `["a","b"]`) — REJECTED (E_BorrowConflict) exactly like the identifier-rooted
# `f(&n,&n.f)`. The `Expr::SelfExpr`→`self`-param-DefId resolver write-site fix
# gives self-rooted places a real root through `find_root_def_id_with_path`, so
# check_call_aliasing sees them. Expected output = REJECTION.
struct Inner:
    Vector[int] b

struct Holder:
    Inner a

void g(Inner &x, Vector[int] &y):
    y.push(9)

equip Holder:
    void oops(&self):
        g(&self.a, &self.a.b)

void main():
    Holder h = Holder(Inner([1, 2]))
    h.oops()
    print(h.a.b.len())
