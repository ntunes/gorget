struct Pair[T, U]:
    T first
    U second

equip Pair[T, U]:
    T get_first(self):
        return self.first

    U get_second(self):
        return self.second

void main():
    Pair[int, String] p1 = Pair[int, String](42, "hello")
    print(p1.first)
    print(p1.second)
    print(p1.get_first())
    print(p1.get_second())

    Pair[String, bool] p2 = Pair[String, bool]("test", true)
    print(p2.first)
    print(p2.second)

    # Nested generic
    Pair[int, Pair[String, int]] nested = Pair[int, Pair[String, int]](1, Pair[String, int]("inner", 99))
    print(nested.first)
    print(nested.second.first)
    print(nested.second.second)

    # Vector of generic structs
    Vector[Pair[int, int]] pairs = Vector[Pair[int, int]]()
    pairs.push(Pair[int, int](1, 10))
    pairs.push(Pair[int, int](2, 20))
    pairs.push(Pair[int, int](3, 30))
    print(pairs.len())
    print(pairs[0].first)
    print(pairs[1].second)

    # Option of generic struct
    Option[Pair[int, String]] maybe = Some(Pair[int, String](7, "seven"))
    print(maybe.is_some())
    Pair[int, String] unwrapped = maybe.unwrap()
    print(unwrapped.first)
    print(unwrapped.second)
