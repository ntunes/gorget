# Advanced nested collection combinations
from std.collections import Vector, Dict

void main():
    # --- 1. Vector[Option[int]] with Some and None ---
    print("--- Vector[Option[int]] ---")
    Vector[Option[int]] opts = Vector[Option[int]]()
    opts.push(Some(10))
    Option[int] n1 = None()
    opts.push(n1)
    opts.push(Some(20))
    Option[int] n2 = None()
    opts.push(n2)
    opts.push(Some(30))
    print(f"{opts.len()}")

    # iterate and match on each element
    for val in opts:
        match val:
            case Some(x):
                print(f"some:{x}")
            case None:
                print("none")

    # filter to keep only Some values
    Vector[Option[int]] somes = opts.filter((Option[int] o): o.is_some())
    print(f"{somes.len()}")
    Option[int] first_some = somes.get(0).unwrap()
    print(f"{first_some.unwrap()}")

    # --- 2. Vector[Result[int, String]] ---
    print("--- Vector[Result[int, str]] ---")
    Vector[Result[int, String]] res_list = Vector[Result[int, String]]()
    Result[int, String] r1 = Ok(1)
    res_list.push(r1)
    res_list.push(Error("bad"))
    Result[int, String] r2 = Ok(2)
    res_list.push(r2)
    res_list.push(Error("worse"))
    print(f"{res_list.len()}")

    # check is_ok/is_err on each
    for r in res_list:
        print(f"{r.is_ok()},{r.is_error()}")

    # count successes and failures via filter
    Vector[Result[int, String]] oks = res_list.filter((Result[int, String] r): r.is_ok())
    print(f"ok_count:{oks.len()}")
    Vector[Result[int, String]] errs = res_list.filter((Result[int, String] r): r.is_error())
    print(f"err_count:{errs.len()}")

    # --- 3. Dict[String, Option[int]] ---
    print("--- Dict[str, Option[int]] ---")
    Dict[String, Option[int]] scores = Dict[String, Option[int]]()
    scores.put("alice", Some(95))
    Option[int] no_score = None()
    scores.put("bob", no_score)
    scores.put("carol", Some(88))
    # NOTE: this used to be a keys().len() workaround for a Dict.len()
    # codegen bug on Option-typed values; the bug appears fixed as of
    # 2026-05-04 (see dict_len_option_value.gg for direct .len() coverage).
    # Kept as keys().len() here to also exercise the keys() path.
    Vector[String] sk = scores.keys()
    print(f"{sk.len()}")

    Option[Option[int]] alice = scores.get("alice")
    print(f"{alice.unwrap().unwrap()}")

    Option[Option[int]] bob = scores.get("bob")
    print(f"{bob.unwrap().is_none()}")

    Option[Option[int]] carol = scores.get("carol")
    print(f"{carol.unwrap().unwrap()}")

    Option[Option[int]] missing = scores.get("dave")
    print(f"{missing.is_none()}")

    # --- 4. Vector[Vector[Vector[int]]] — 3-level nesting ---
    # NOTE: Skipped — runtime double-free bug in drop insertion for 3-level
    # nested Vector[Vector[Vector[int]]].

    # --- 5. Result[Vector[int], String] — Ok containing a vector ---
    print("--- Result[Vector[int], str] ---")
    Vector[int] data = Vector[int]()
    data.push(100)
    data.push(200)
    data.push(300)
    Result[Vector[int], String] ok_vec = Ok(data)
    print(f"{ok_vec.is_ok()}")

    Vector[int] unwrapped = ok_vec.unwrap()
    print(f"{unwrapped.len()}")
    print(f"{unwrapped.get(0).unwrap()}")
    print(f"{unwrapped.get(1).unwrap()}")
    print(f"{unwrapped.get(2).unwrap()}")

    Result[Vector[int], String] err_vec = Error("no data")
    print(f"{err_vec.is_error()}")
    # NOTE: unwrap_error() skipped — codegen bug assigns Str to int64_t

    print("done")
