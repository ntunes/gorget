meta int INT_SIZE = sizeof(int)
meta int BOOL_SIZE = sizeof(bool)
meta int STR_SIZE = sizeof(str)
meta int CSTR_SIZE = sizeof(cstr)
meta int I8_SIZE = sizeof(int8)
meta int I16_SIZE = sizeof(int16)
meta int I32_SIZE = sizeof(int32)
meta int F32_SIZE = sizeof(float32)

meta int INT_ALIGN = alignof(int)
meta int BOOL_ALIGN = alignof(bool)
meta int STR_ALIGN = alignof(str)

meta str INT_NAME = typename(int)
meta str BOOL_NAME = typename(bool)
meta str VEC_NAME = typename(Vector[int])
meta str STR_NAME = typename(str)

void main():
    print(INT_SIZE)
    print(BOOL_SIZE)
    print(STR_SIZE)
    print(CSTR_SIZE)
    print(I8_SIZE)
    print(I16_SIZE)
    print(I32_SIZE)
    print(F32_SIZE)
    print(INT_ALIGN)
    print(BOOL_ALIGN)
    print(STR_ALIGN)
    print(INT_NAME)
    print(BOOL_NAME)
    print(VEC_NAME)
    print(STR_NAME)
