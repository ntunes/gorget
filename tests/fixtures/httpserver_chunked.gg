#!parity-excluded network: runs a real HTTP server over a bound TCP socket with a concurrent client; connection timing
#!  decides the output
# Test: Chunked Transfer-Encoding body reading on the server side.
#
# Sends a raw chunked POST request over TCP using a raw socket.
# The server must reassemble chunks "hell" + "o" = "hello".
#
# Chunked format: <hex-size>\r\n<data>\r\n ... 0\r\n\r\n
#
# Expected output:
#   ok\nok

from xtd.httpserver import HttpRequest, HttpServerResponse, http_server_handle_conn_ka
from std.net.socket import ServerSocket, Socket, server_socket_bind, socket_connect
from std.bytes import bytes_to_str
from std.io import IoError
from std.conv import int_to_str
from std.time import sleep
from std.signal import signal_ignore, SIGPIPE

HttpServerResponse handle(HttpRequest req):
    if req.method == "POST" and req.path == "/echo":
        return HttpServerResponse.ok(req.body)
    return HttpServerResponse.not_found()

async void serve_n(ServerSocket !srv, int n):
    int i = 0
    while i < n:
        Result[Socket, String] ar = srv.accept()
        if ar.is_ok():
            Socket client = ar.unwrap()
            http_server_handle_conn_ka(!client, handle, 2000).await()
            i = i + 1
    srv.close()

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

async void main():
    signal_ignore(SIGPIPE)
    ServerSocket srv = server_socket_bind("127.0.0.1", 0).unwrap()
    int port = srv.local_port()
    Task[void] server = spawn serve_n(!srv, 1)
    sleep(0.5).await()

    # Open a raw socket and send a chunked POST manually
    Result[Socket, String] cr = socket_connect("127.0.0.1", port)
    if cr.is_error():
        print("FAIL: connect: " + cr.unwrap_error())
        print("FAIL: body")
        server.await()
        return
    Socket conn = cr.unwrap()

    # Body = "hello" split into chunk "hell" (4 bytes) and "o" (1 byte)
    String req ="POST /echo HTTP/1.1\r\n"
    req = req +"Host: 127.0.0.1\r\n"
    req = req +"Transfer-Encoding: chunked\r\n"
    req = req +"Connection: close\r\n"
    req = req +"\r\n"
    req = req +"4\r\nhell\r\n"
    req = req +"1\r\no\r\n"
    req = req +"0\r\n\r\n"
    conn.write_str(req)

    # Read response status line
    bool ok_status = false
    Result[String, String] sl_r = conn.read_line()
    if sl_r.is_ok():
        String sl = sl_r.unwrap()
        ok_status = sl.contains("200")

    # Read headers, collect Content-Length
    int content_length = 0
    bool reading_hdrs = true
    while reading_hdrs:
        Result[String, String] hl_r = conn.read_line()
        if hl_r.is_error():
            reading_hdrs = false
        else:
            String hl = hl_r.unwrap()
            if hl == "":
                reading_hdrs = false
            else:
                Option[int] colon_opt = hl.index_of(":")
                if colon_opt.is_some():
                    int colon = colon_opt.unwrap()
                    String hname = hl.byte_slice(0, colon).trim().to_lower()
                    String hval = hl.byte_slice(colon + 1, hl.byte_len()).trim()
                    if hname == "content-length":
                        Option[int] clv = int.parse(hval)
                        if clv.is_some():
                            content_length = clv.unwrap()

    # Read body using Content-Length
    String resp_body = ""
    if content_length > 0:
        Vector[uint8] raw_body = conn.read_exact(content_length)
        Result[String, IoError] sr = bytes_to_str(raw_body)
        if sr.is_ok():
            resp_body = sr.unwrap()
    conn.close()

    check("status", ok_status)
    check("body", resp_body == "hello")

    server.await()
