# Control for the two sibling-prefix cells: the same escaped-closure call and
# the same direct call, ordinary name. Green before and after.
int helper_1(int a, int b):
    return a + b

int(int) make_doubler(int n):
    return (int y): y * n

void main():
    auto d = make_doubler(2)
    print(d(21))
    print(helper_1(40, 2))
