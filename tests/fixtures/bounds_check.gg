from std.collections import Vector

void main():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(20)
    v.push(30)

    # In-bounds get returns Some
    Option[int] r = v.get(1)
    print("{r.is_some()}")
    print("{r.unwrap()}")

    # Out-of-bounds get returns None
    Option[int] oob = v.get(5)
    print("{oob.is_none()}")

    # Negative index returns None
    Option[int] neg = v.get(-1)
    print("{neg.is_none()}")
