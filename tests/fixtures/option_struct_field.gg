# Test Option[T] as struct field — constructor mangling + None codegen

struct Greeting:
    Option[String] message
    Option[int] priority

String describe(Greeting g):
    String msg = "no message"
    match g.message:
        case Some(m):
            msg = m
    String pri = "no priority"
    match g.priority:
        case Some(p):
            pri = f"{p}"
    return f"{msg} ({pri})"

String main():
    Greeting a = Greeting(Some("hello"), Some(1))
    print(describe(a))
    Greeting b = Greeting(None, None)
    print(describe(b))
    Greeting c = Greeting(Some("world"), None)
    print(describe(c))
