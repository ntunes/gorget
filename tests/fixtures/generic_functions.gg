T identity[T](T x) = x

T first[T](T a, T b):
    T result = a
    return result

T larger[T](T a, T b):
    if a > b:
        return a
    return b

void main():
    int a = identity[int](42)
    print(f"{a}")
    float b = identity[float](3.14)
    print(f"{b}")
    str c = identity[str]("hello")
    print(f"{c}")
    int d = first[int](10, 20)
    print(f"{d}")
    int e = larger[int](7, 3)
    print(f"{e}")
