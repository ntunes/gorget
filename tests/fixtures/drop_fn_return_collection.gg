from std.collections import Vector, Dict

Vector[int] make_nums():
    Vector[int] v = Vector[int]()
    v.push(10)
    v.push(20)
    return v

Dict[String, int] make_scores():
    Dict[String, int] d = Dict[String, int]()
    d["alice"] = 100
    return d

int sum_vec(Vector[int] v):
    int total = 0
    int i = 0
    while i < v.len():
        total = total + v.get(i).unwrap()
        i = i + 1
    return total

void main():
    # Function-returned Vector — buffer freed at scope exit
    Vector[int] nums = make_nums()
    print(f"{nums.len()}")

    # Function-returned Dict — buffer freed at scope exit
    Dict[String, int] scores = make_scores()
    print(f"{scores.len()}")

    # Method-returned Vector — .keys() returns fresh buffer
    Vector[String] ks = scores.keys()
    print(f"{ks.len()}")

    # Chained: function return used then freed
    int s = sum_vec(make_nums())
    print(f"{s}")

    print("done")
