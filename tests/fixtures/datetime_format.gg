#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("datetime_")`; it setenv()s TZ=UTC first so format() is deterministic (its own
#!  header says so)
from std.datetime import DateTime
from std.os import setenv

void main():
    # Force UTC so format() is deterministic across environments
    setenv("TZ", "UTC")

    DateTime dt2000 = DateTime(2000, 1, 1, 0, 0, 0, 0)

    String date_str = dt2000.format("%Y-%m-%d")
    print(date_str)

    String time_str = dt2000.format("%H:%M:%S")
    print(time_str)

    DateTime dt2024 = DateTime(2024, 7, 15, 14, 30, 45, 0)
    String datetime_str = dt2024.format("%Y/%m/%d %H:%M")
    print(datetime_str)

    # 1970-01-01 was a Thursday
    DateTime dt1970 = DateTime(1970, 1, 1, 0, 0, 0, 0)
    String weekday_str = dt1970.format("%A")
    print(weekday_str)

    print("done")
