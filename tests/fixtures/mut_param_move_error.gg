# Tests that the borrow checker rejects moving from a mutably borrowed param.
# Only the owner (! param) can move — & params borrow, they don't own.

struct Data:
    String label
    int value

void consume(Data !d):
    print(f"{d.value}")

void bad(Data &d):
    consume(!d)

void main():
    Data d = Data(label="x", value=42)
    bad(&d)
    print(f"{d.value}")
