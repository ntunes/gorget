# Cross-frame fault, NO catch in the caller (error-model.md §11, Increment 2.1a):
# `main` calls `faulty` WITHOUT a `catch`, so `faulty` is a participating callee but
# this call site passes a NULL fault-slot. On the deep overflow the callee's fault
# arm takes the NULL branch → panics by default → process exit(1). This preserves
# panic-by-default for an uncaught deep fault (a NEGATIVE fixture: non-zero exit).
int faulty(int a, int b): a * b           # NB: also reachable from a deep catch

void deep_catcher():
    # A catch site elsewhere in the module makes `faulty` PARTICIPATE (so its
    # signature gets the trailing slot), exercising the uniform-signature path.
    int caught = faulty(2, 3) catch Fault.Overflow: -1
    print(f"{caught}")

void main():
    deep_catcher()                          # prints 6 (no overflow)
    int big = 4611686018427387904           # 2^62
    int r = faulty(big, big)                # NO catch → NULL slot → panic, exit 1
    print(f"{r}")                           # never reached
