from gg.dataframe import DataFrame, Column, df_from_columns, df_group_by_multi, df_from_records_typed, col_from_ints, col_from_strs

void main():
    # Setup
    Vector[String] depts = Vector[String]()
    depts.push("eng")
    depts.push("eng")
    depts.push("sales")
    depts.push("sales")
    depts.push("eng")

    Vector[String] levels = Vector[String]()
    levels.push("jr")
    levels.push("sr")
    levels.push("jr")
    levels.push("sr")
    levels.push("jr")

    Vector[int] salaries = Vector[int]()
    salaries.push(50)
    salaries.push(100)
    salaries.push(40)
    salaries.push(80)
    salaries.push(55)

    Vector[String] col_names = Vector[String]()
    col_names.push("dept")
    col_names.push("level")
    col_names.push("salary")

    Vector[Column] cols = Vector[Column]()
    cols.push(col_from_strs(depts))
    cols.push(col_from_strs(levels))
    cols.push(col_from_ints(salaries))

    DataFrame df = df_from_columns(col_names, cols)

    # ── multi-column groupby ──
    Vector[String] group_cols = Vector[String]()
    group_cols.push("dept")
    group_cols.push("level")

    DataFrame agg_sum = df_group_by_multi(df, group_cols).agg("salary", "sum")
    print(f"{agg_sum.nrows()}")
    # eng+jr: 50+55=105, eng+sr: 100, sales+jr: 40, sales+sr: 80
    print(f"{agg_sum.ncols()}")

    DataFrame agg_count = df_group_by_multi(df, group_cols).agg("salary", "count")
    Column cnt_col = agg_count.get_column("salary_count")
    # eng+jr has 2 rows
    print(f"{cnt_col.value_as_str(0)}")

    # ── df_from_records_typed (type inference) ──
    Vector[String] headers = Vector[String]()
    headers.push("id")
    headers.push("score")
    headers.push("name")
    headers.push("active")

    Vector[String] r1 = Vector[String]()
    r1.push("1")
    r1.push("9.5")
    r1.push("Alice")
    r1.push("true")
    Vector[String] r2 = Vector[String]()
    r2.push("2")
    r2.push("8.0")
    r2.push("Bob")
    r2.push("false")
    Vector[Vector[String]] rows = Vector[Vector[String]]()
    rows.push(r1)
    rows.push(r2)

    DataFrame typed = df_from_records_typed(headers, rows)
    print(f"{typed.nrows()}")
    Column id_col = typed.get_column("id")
    print(f"{id_col.dtype_name()}")
    Column score_col = typed.get_column("score")
    print(f"{score_col.dtype_name()}")
    Column name_col = typed.get_column("name")
    print(f"{name_col.dtype_name()}")
    Column active_col = typed.get_column("active")
    print(f"{active_col.dtype_name()}")

    print("done")
