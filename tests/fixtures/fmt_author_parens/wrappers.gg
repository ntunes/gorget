# AUTHOR-PAREN PRESERVATION — the SHARED-SPAN (transparent wrapper) axis.
#
# The table is keyed by SPAN, and the author layer belongs to exactly ONE node
# per key. Some AST nodes REUSE a child's span, so two nodes answer to the same
# key; if both emit the layer, the parens double on every pass — and none of
# these shapes appears parenthesised anywhere in the corpus, so the corpus-wide
# round-trip gate cannot see it.
#
# The shared-span class is enumerated MECHANICALLY (every corpus file parsed,
# every parent/child expression pair with equal spans reported). Its members:
#     Closure         -> Block
#     Catch           -> Do
#     Rethrow         -> Do
#     Block           -> BinaryOp / IntLiteral / StringLiteral
#     TupleFieldAccess-> Identifier
# One cell per member below, and TWO for `Closure -> Block`: an ARGUMENT-
# position closure and a BINDING-position one, because the paren-suppression
# decision is made per call site and one position cannot vouch for the other.
# Every member was MEASURED not to double, because the wrapper does not route
# its same-span child back through `format_expr`.
#
# The cells are POS pins: they are green on a paren-deleting build for the
# ordinary reason (the paren is deleted there too — so they are red pre-fix as
# preservation cells) and their point here is the STABILITY assertion over
# three passes.

int closure_arg(Vector[int] xs):
    Vector[int] ys = xs.map((int x): (x * 2))
    return ys[0]

int arm_body(int n):
    match n:
        case 1:
            return (n + 2)
        else:
            return (n * 3)

int branch_body(int a, int b):
    if a > b:
        return (a + b)
    return (a - b)

int parse_it(String s) throws String:
    if s == "":
        throw "empty"
    return s.len()

int catch_body(String s):
    return parse_it(s)! catch (e): (0 - 1)

int rethrow_body(String s) throws String:
    return parse_it(s)! rethrow (String e): (e + "!")

int closure_body(int n):
    Callable[int(int)] g = (int x): (x + n)
    return g(1)

int tuple_field(int a, int b):
    (int, int) t = (a, b)
    return (t).0

void main():
    Vector[int] xs = [1, 2, 3]
    print(closure_arg(xs))
    print(arm_body(1))
    print(branch_body(3, 1))
    print(catch_body(""))
    print(closure_body(2))
    print(tuple_field(4, 5))
