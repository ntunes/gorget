meta type sized_int(int bits):
    if bits <= 8:
        return int8
    elif bits <= 16:
        return int16
    elif bits <= 32:
        return int32
    else:
        return int64

meta type Small = sized_int(8)
meta type Medium = sized_int(16)
meta type Word = sized_int(arch_word_bits())

void main():
    Small s = 7
    Medium m = 1000
    Word w = 42
    print(s)
    print(m)
    print(w)
