# Leak test: string payloads in various Result/Option match patterns.
from std.os import mem_live

Result[String, String] make_greeting(int id):
    if id > 0:
        return Ok(f"hello_{id}")
    return Error(f"bad id: {id}")

void main():
    int baseline = mem_live()

    # Section 1: Result[String, String] — both Ok and Error variants
    int i = 0
    while i < 200:
        Result[String, String] r = make_greeting(i)
        match r:
            case Ok(msg):
                int _len = msg.len()
            case Error(e):
                int _len = e.len()
        i = i + 1

    # Section 2: Nested — Ok(String) from function
    i = 0
    while i < 200:
        Result[String, String] r = Ok(f"value_{i}")
        match r:
            case Ok(v):
                int _len = v.len()
            case Error(e):
                pass
        i = i + 1

    # Section 3: Option[String] with Some and None
    i = 0
    while i < 200:
        Option[String] opt = Some(f"opt_{i}")
        match opt:
            case Some(s):
                int _len = s.len()
            case None:
                pass
        i = i + 1

    int leaked = mem_live() - baseline
    print(f"leaked={leaked > 0}")
    print("done")
