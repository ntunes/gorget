# Cross-frame Bounds drop-correctness (error-model.md §11, Increment 2.1d, Q9):
# the callee `getx`'s frame holds a LIVE Drop-bearing local (`g`) when the OOB
# happens. The fault propagates to `main`'s catch one frame up; the callee's
# early-exit drops run on the fault path, so `g` is dropped EXACTLY ONCE. The
# deterministic "drop guard N" print proves exactly-once on BOTH the fault path
# AND the no-fault path. Run under ASan/UBSan: clean.
struct Guard:
    int id

equip Guard with Drop:
    void drop(!self):
        print(f"drop guard {self.id}")

int getx(Vector[int] xs, int i, int gid):
    Guard g = Guard(gid)
    int r = xs[i] + g.id
    return r

void main():
    Vector[int] xs = [10, 20, 30]
    int caught = getx(xs, 99, 1) catch Fault.Bounds: -1
    print(f"{caught}")                       # fault path → -1 (after "drop guard 1")
    int ok = getx(xs, 1, 2) catch Fault.Bounds: -1
    print(f"{ok}")                           # no-fault path → 20 + 2 = 22 (drop guard 2)
