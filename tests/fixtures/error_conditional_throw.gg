String classify(int n) throws String:
    if n < 0:
        throw "negative"
    if n == 0:
        return "zero"
    if n % 2 == 0:
        return "even"
    return "odd"

void main():
    print(classify(0)! catch (e): "err")
    print(classify(4)! catch (e): "err")
    print(classify(7)! catch (e): "err")
    print(classify(-3)! catch (e): "err")
