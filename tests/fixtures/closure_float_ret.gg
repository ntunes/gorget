from gg.dataframe import DataFrame, Column, col_from_floats, df_from_columns

void main():
    Vector[float] vals = Vector[float]()
    vals.push(1.0)
    vals.push(2.0)
    vals.push(4.0)

    Vector[str] col_names = Vector[str]()
    col_names.push("val")

    Vector[Column] cols = Vector[Column]()
    cols.push(col_from_floats(vals))

    DataFrame df = df_from_columns(col_names, cols)

    # apply_float with a fractional multiplier — requires correct float(float) closure return type
    float(float) scale_fn = (float x): x * 2.5
    str val_col = "val"
    DataFrame df2 = df.apply_float(val_col, scale_fn)
    Column c = df2.get_column(val_col)
    print(f"{c.value_as_str(0)}")
    print(f"{c.value_as_str(1)}")
    print(f"{c.value_as_str(2)}")
