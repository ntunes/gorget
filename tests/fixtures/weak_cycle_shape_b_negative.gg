# Cycle-breaking proof (shape B — parent/child).
#
# NEGATIVE CONTROL: a Parent owns a Vector[Shared[Child]]; each Child
# holds a Shared[Parent] back. Both directions strong = cycle = leak.
#
# Status: BLOCKED on absent mutability path for `Shared[T]` field. We
# need either `Shared[T].mutate(closure)`, `Shared[Mutex[T]].lock()`
# (which compiles but `Guard[T]` field-assignment codegens broken C),
# OR Cell/RefCell. Cannot pre-build the children vector before the
# Parent's Shared exists, because each Child needs a Shared/Weak handle
# to that Parent — chicken-and-egg.
#
# See TODO.md "Weak[T] cycle-breaking — missing primitives".
#
# When the primitive lands, this fixture must produce:
#     leaked=true
#     done

from std.os import mem_live
from std.collections import Vector

struct Child:
    int id
    Shared[Parent] parent_strong

struct Parent:
    int id
    Vector[Shared[Child]] children

void main():
    int baseline = mem_live()
    int outer = 0
    while outer < 50:
        # Build the parent first with an empty children vector.
        Shared[Parent] p = Shared[Parent](Parent(99, Vector[Shared[Child]]()))
        # Build children, each holding a Shared[Parent] back — STRONG.
        int i = 0
        while i < 3:
            Shared[Child] c = Shared[Child](Child(i, p.clone()))
            # NB: this is the line that requires shared-field mutation,
            # which is currently a silent no-op for `Shared[Parent]`.
            p.children.push(c)
            i = i + 1
        # At scope exit: p's refcount is 1 + 3 (one for `p`, three from
        # the children's parent_strong). Children's refcount is 1 each
        # (from `p.children`). Cycle: p -> children, child -> p. Both
        # strong; nothing frees.
        outer = outer + 1
    int delta = mem_live() - baseline
    print(f"leaked={delta > 0}")
    print("done")
