# `!self`-consuming method with NO post-use of the receiver (legal): the receiver
# is consumed and never read again. The over-rejection guard for the `!self`
# consume — proves the consume does not fire on a legal call.
struct Config:
    int width
    String title

equip Config:
    Config with_width(!self, int w):
        return Config(w, self.title)

void main():
    Config c = Config(800, "game")
    Config c2 = c.with_width(1920)
    print(c2.title)
