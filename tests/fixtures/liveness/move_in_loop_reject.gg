# PART C MoveInLoop: moving an ENCLOSING-scope place inside a loop re-moves it on
# the next iteration. The 2-element iterable makes this a GENUINE multi-iteration
# re-move (ggdef ALSO IllFormeds on the 2nd iteration's re-move — consistent with
# the dynamic oracle, per the brief's Phase-2 caveat: never a run-once loop).
# Mirrors production consuming_self_loop_error / the MoveInLoop static reject.
void consume(String !s):
    pass

void main():
    String n = "outer"
    Vector[int] items = [1, 2]
    for i in items:
        consume(!n)
