# Re-init (legal): a moved binding is made live again by a whole rebind before
# the next use (Rust mark_live). `x` is moved, re-assigned, then read.
# All lanes ACCEPT: production, self-host, AND ggdef (whose eval revives the slot
# on the whole-local reassignment). Asserted vs the self-host driver; the
# cross-lane conformance twin is spectests/run/reinit_accept.gg.
void sink(String !s):
    pass

String fresh():
    return "new"

void main():
    String x = "hi"
    sink(!x)
    x = fresh()
    print(x)
