# Liveness use-after-move across a branch join: a move in one arm of an
# if-without-else makes the place moved-in-any after the join, so the later read
# is use-after-move. Mirrors production use_after_move_branch_error.gg.
void consume(String !s):
    pass

void main():
    String s = "hello"
    bool flag = true
    if flag:
        consume(!s)
    print(s)
