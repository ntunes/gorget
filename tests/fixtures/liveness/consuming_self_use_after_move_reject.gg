# Liveness use-after-move via a `!self`-consuming method: the receiver is moved
# by the call, so a later read of it is use-after-move. Mirrors production
# consuming_self_use_after_move_error.gg (E_UseAfterMove).
struct Config:
    int width
    String title

equip Config:
    Config with_width(!self, int w):
        return Config(w, self.title)

void main():
    Config c = Config(800, "game")
    Config c2 = c.with_width(1920)
    print(c.title)
