# Compiled fixture binaries and generated C files
# Keep only .gg source, .expected files, and self-host subdirectories
*
!*.gg
!*.expected
!*.md
!.gitignore
!self_host_*/
!self_host_*/**
!modules_pkg*/
!modules_pkg*/**
!fstring_cross_module/
!fstring_cross_module/**
!imported_call_arg_type_check/
!imported_call_arg_type_check/**
!mutarg_import_probe/
!mutarg_import_probe/*.gg
!stack_guard_concat_chain/
!stack_guard_concat_chain/*.gg
# Multi-module regression net for the GIR EnumInit struct-id collision
# (type-aware enum-variant resolution); keep only the .gg sources.
!enum_variant_name_collision/
!enum_variant_name_collision/*.gg
# Parse-time expr-depth-limit fixtures (B-rust): long flat `1 + 1 + ... + 1`
# chains kept in subdirs so the corpus-wide `fmt_idempotent` test (top-level
# tests/fixtures/*.gg only) doesn't reflow them (`gg fmt` corrupts long chains).
!expr_nesting_too_deep_error/
!expr_nesting_too_deep_error/*.gg
# D19 `break <value>` removal negative fixture: unparseable BY DESIGN, kept in
# a subdir so the top-level sweeps (fmt_idempotent, *_comparison, runtime_diff)
# never feed it to the formatter/self-host drivers.
!break_value_removed_error/
!break_value_removed_error/*.gg
!expr_nesting_max_depth/
!expr_nesting_max_depth/*.gg
!imported_nonexhaustive_match/
!imported_nonexhaustive_match/**
!imported_body_type_error/
!imported_body_type_error/**
!equip_method_no_shadow_extern/
!equip_method_no_shadow_extern/**
!type_alias_struct_dir/
!type_alias_struct_dir/*.gg
# D23 throws-totality cross-module negative fixture (a `throws` equip method
# imported across a module boundary, called unhandled → E_UnhandledThrows).
!d23_unhandled_method_xmod/
!d23_unhandled_method_xmod/*.gg
# D23 trait-registry keying (Fix 1) cross-module fixtures: trait-DEFAULT
# throws negative + handled/propagated positive twin; E_MissingTraitMethod
# extends-coupling pin + provided twin. Sources only — compiled main/main.c
# stay ignored.
!d23_unhandled_method_traitdefault_xmod/
!d23_unhandled_method_traitdefault_xmod/*.gg
!d23_traitdefault_xmod_handled/
!d23_traitdefault_xmod_handled/*.gg
!d23_traitkey_extends_missing_method/
!d23_traitkey_extends_missing_method/*.gg
!d23_traitkey_extends_provided/
!d23_traitkey_extends_provided/*.gg
# Known self-host gaps parked OUT of the top-level runtime_diff corpus (the
# corpus reads tests/fixtures/*.gg non-recursively, so a subdir fixture is not
# counted): the #[ignore]d negative fixtures documenting a filed residual
# (R38 generic-equip &self-mutator write-through). Keep only the .gg sources.
!known_gaps/
!known_gaps/*.gg
!security/
!security/*.gg
!security/*.expected
!security/*.md
# Chain 3 runtime-parity lock-in net: committed Rust `gg run` stdout snapshots,
# the oracle for the self_host_runtime test (regen via GG_REGEN_RUNTIME_SNAPSHOT=1).
!runtime_snapshots/
!runtime_snapshots/*.out

# Re-ignore compiled/generated artifacts inside self-host subdirs
self_host_*/driver
self_host_*/driver.c
self_host_*/main
self_host_*/main.c

# LLVM backend intermediate artifacts (per-fixture runtime/user .c/.o + IR).
# Generated by `gg build --backend=llvm` and the LLVM CI job.
self_host_*/__gorget_runtime*.c
self_host_*/__gorget_runtime*.o
self_host_*/__gorget_user*.o
self_host_*/*.ll
modules_pkg*/*.ll

# Catch-all: re-ignore compiled/generated artifacts in ANY un-ignored fixture
# subdir. The `!dir/**` exceptions above otherwise re-include a generated
# main.ll / main.c / __gorget_*.o whenever such a fixture is built (the LLVM
# backend emits .ll into the fixture dir). These are never tracked — keep this
# block LAST so it wins over the exceptions, and it auto-covers future dirs.
**/*.ll
**/main.c
**/__gorget_runtime*.c
**/__gorget_runtime*.o
**/__gorget_user*.o
