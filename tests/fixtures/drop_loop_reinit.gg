# The case the audit flagged: re-initialize after move across loop
# iterations.
#
# Iteration N: move-out via consume(!r). Drop-flag goes false.
# Iteration N+1: re-initialize r via SlotStore at top of body.
#                Phase 3 of drop_elab does NOT instrument SlotStore,
#                so the flag stays false.
# At end-of-body drop guard for the non-move path: flag=false → drop
# is skipped, but the slot is alive → potential leak with NO observable
# stdout (Drop's print is the only signal).
#
# Pattern: alternating iterations move (i%2==0) and don't (i%2==1).
# Expected: 5 iterations, 3 consume "iter-N", 2 drop "iter-N".

struct R:
    String name

equip R with Drop:
    void drop(!self):
        String n = self.name
        print(f"drop {n}")

void consume(R !r):
    print(f"consume {r.name}")

void main():
    int i = 0
    while i < 5:
        R r = R(f"iter-{i}")
        if i % 2 == 0:
            consume(!r)
        i = i + 1
    print("done")
