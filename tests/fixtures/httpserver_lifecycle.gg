#!parity-excluded network: runs a real HTTP server over a bound TCP socket with a concurrent client; connection timing
#!  decides the output
# Test: Server lifecycle — serve_n and max_requests_per_conn.
#
# Validates:
#   1. Server accepts exactly n connections and returns cleanly.
#      Two GET requests succeed (both 200).
#   2. max_requests_per_conn = 1: server closes the connection after the first
#      request even when the client sent Connection: keep-alive. A second read
#      on the same socket fails (connection closed by server).
#   3. serve_n + max_requests_per_conn: combined, server is properly bounded.
#
# Expected output:
#   ok\nok\nok

from xtd.httpserver import HttpRequest, HttpServerResponse, http_server_handle_conn_ka, http_server_handle_conn_ka_limited
from xtd.http import get, HttpResponse
from std.net.socket import ServerSocket, Socket, server_socket_bind, socket_connect
from std.bytes import bytes_to_str
from std.conv import int_to_str
from std.time import sleep
from std.signal import signal_ignore, SIGPIPE

HttpServerResponse handle(HttpRequest req):
    return HttpServerResponse.ok("pong")

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

async void serve_n(ServerSocket !srv, int n):
    TaskGroup group = TaskGroup()
    int i = 0
    while i < n:
        Result[Socket, String] ar = srv.accept()
        if ar.is_ok():
            Socket client = ar.unwrap()
            group.spawn(spawn http_server_handle_conn_ka(!client, handle, 500))
            i = i + 1
    group.join()
    srv.close()

async void serve_n_limited(ServerSocket !srv, int n, int max_req):
    TaskGroup group = TaskGroup()
    int i = 0
    while i < n:
        Result[Socket, String] ar = srv.accept()
        if ar.is_ok():
            Socket client = ar.unwrap()
            group.spawn(spawn http_server_handle_conn_ka_limited(!client, handle, 5000, max_req))
            i = i + 1
    group.join()
    srv.close()

async void main():
    signal_ignore(SIGPIPE)
    # ── Test 1 & 2: serve_n with 2 normal connections ──────────
    ServerSocket srv1 = server_socket_bind("127.0.0.1", 0).unwrap()
    int port1 = srv1.local_port()
    Task[void] server1 = spawn serve_n(!srv1, 2)
    sleep(0.5).await()

    # Both get requests use Connection: close → 2 separate connections
    String base1 = "http://127.0.0.1:" + int_to_str(port1)
    Result[HttpResponse, String] r1a = get(base1 + "/ping")
    check("serve_n_req1", r1a.is_ok() and r1a.unwrap().status_code == 200)

    Result[HttpResponse, String] r1b = get(base1 + "/ping")
    check("serve_n_req2", r1b.is_ok() and r1b.unwrap().status_code == 200)

    server1.await()

    # ── Test 3: max_requests_per_conn = 1 closes after 1st ─────
    # Server accepts 1 connection, closes after 1 request (max_requests=1)
    ServerSocket srv2 = server_socket_bind("127.0.0.1", 0).unwrap()
    int port2 = srv2.local_port()
    Task[void] server2 = spawn serve_n_limited(!srv2, 1, 1)
    sleep(0.5).await()

    Result[Socket, String] cr = socket_connect("127.0.0.1", port2)
    if cr.is_error():
        print("FAIL: connect")
        server2.await()
        return
    Socket conn = cr.unwrap()

    # Send req1 with Connection: keep-alive (server should close anyway after max_requests=1)
    String req_str = "GET /ping HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: keep-alive\r\n\r\n"
    conn.write_str(req_str)

    # Drain status line + headers, collect Content-Length
    int content_length = 0
    bool reading_hdrs = true
    while reading_hdrs:
        Result[String, String] line_r = conn.read_line()
        if line_r.is_error():
            reading_hdrs = false
        else:
            String line = line_r.unwrap()
            if line == "":
                reading_hdrs = false
            else:
                Option[int] colon_opt = line.index_of(":")
                if colon_opt.is_some():
                    int colon = colon_opt.unwrap()
                    String hname = line.byte_slice(0, colon).trim().to_lower()
                    String hval = line.byte_slice(colon + 1, line.byte_len()).trim()
                    if hname == "content-length":
                        Option[int] clv = int.parse(hval)
                        if clv.is_some():
                            content_length = clv.unwrap()

    # Drain the body
    if content_length > 0:
        Vector[uint8] body_bytes = conn.read_exact(content_length)

    # Server has sent Connection: close and closed the connection.
    # Set a short timeout so we don't hang if there's a bug.
    conn.set_timeout(500)
    # Attempt to read — should get EOF (Ok("")) because server closed the connection.
    Result[String, String] resp2_r = conn.read_line()
    bool closed = false
    if resp2_r.is_error():
        closed = true
    else:
        String resp2_line = resp2_r.unwrap()
        if resp2_line == "":
            closed = true
    check("max_req_closes", closed)

    conn.close()
    server2.await()
