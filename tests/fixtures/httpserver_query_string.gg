#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; its own header says "(no TCP)"
# Test: parse_query_string edge cases (no TCP).
#
# Validates:
#   - Empty string → empty dict
#   - Single key no value "key" → {"key": ""}
#   - Single pair "key=value"
#   - Multiple pairs "a=1&b=2&c=3"
#   - Value with equals sign "key=a=b" → {"key": "a=b"} (first = splits)
#   - Key with empty value "key=" → {"key": ""}
#   - HttpRequest.query_params() convenience method
#
# Expected output:
#   0\nempty\nvalue\n1\n2\n3\na=b\nempty\nhello\n2

from xtd.httpserver import parse_query_string, HttpRequest, HttpServerResponse
from std.collections import Dict

void main():
    # Empty string → empty dict (size 0)
    Dict[String, String] d1 = parse_query_string("")
    int size1 = d1.keys().len()
    print(f"{size1}")

    # "key" → {"key": ""}
    Dict[String, String] d2 = parse_query_string("key")
    if d2.contains("key"):
        String v2 = d2["key"]
        if v2 == "":
            print("empty")
        else:
            print(v2)

    # "key=value" → value
    Dict[String, String] d3 = parse_query_string("key=value")
    print(d3["key"])

    # "a=1&b=2&c=3"
    Dict[String, String] d4 = parse_query_string("a=1&b=2&c=3")
    print(d4["a"])
    print(d4["b"])
    print(d4["c"])

    # "key=a=b" — first = splits, rest is value
    Dict[String, String] d5 = parse_query_string("key=a=b")
    print(d5["key"])

    # "key=" → {"key": ""}
    Dict[String, String] d6 = parse_query_string("key=")
    String v6 = d6["key"]
    if v6 == "":
        print("empty")
    else:
        print(v6)

    # HttpRequest.query_params() convenience method
    HttpRequest req = HttpRequest("GET", "/search", "q=hello&page=2", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    Dict[String, String] qp = req.query_params()
    print(qp["q"])
    print(qp["page"])
