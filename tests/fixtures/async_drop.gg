struct Tracked:
    str label

equip Tracked with Drop:
    void drop(!self):
        str l = self.label
        print("drop {l}")

async int compute(int x):
    Tracked t = Tracked("compute-local")
    return x * 2

async void main():
    int val = compute(21).await()
    print(val)
    Tracked main_t = Tracked("main-local")
    print("done")
