# Import TYPE aliasing used inside a `Box`-WRAPPING container type — a function
# type `Callable[DT(...)]`, whose return position the type-axis rewrite must
# rename `DT` -> `DateTime` inside. Exercises the `TFunction`/`TArray`/`TSlice`
# recursion arms of `rename_aliases_type`, which reconstruct a `Box[SpannedType]`
# for the inner `Type`. Both Rust `gg` and the self-host produce `2000`.

from std.datetime import DateTime as DT

# `DT` nested inside a function type's RETURN position (`TFunction` -> Box).
DT apply_stamp(Callable[DT(int)] f, int year):
    return f(year)

DT make_year(int year):
    return DT(year, 1, 1, 0, 0, 0, 0)

void main():
    DT d = apply_stamp(make_year, 2000)
    print(f"{d.dt_year}")
