from std.collections import Dict

void main():
    Dict[String, int] m = Dict[String, int]()
    String key1 = "hello"
    String key2 = "hello"
    m.put(key1, 42)
    int val = m.get(key2).unwrap()
    print(f"{val}")
    if m.contains(key2):
        print("found")
    m.remove(key2)
    if m.is_empty():
        print("empty")
