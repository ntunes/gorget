# gorget-js snag 15e (owner 2026-08-09): when gg fmt INLINES a single-stmt
# `else:`/`case P:` arm whose body has a trailing comment, the comment was
# orphaned onto a leading line at indent 2 (the enclosing scope's indent),
# detached from the return/expression it documented. User-reported repro:
#     else:
#         return cc   # propagate Throw
# Post-fix expected:
#     else: return cc  # propagate Throw
#
# Wired: `fmt_inlined_arm_trailing_comment_preserved` in tests/integration.rs
# asserts the `# propagate Throw` sentinel appears on the SAME line as
# `else: return`, not orphaned on a standalone comment line.
int compute(int cc):
    int cv = match cc:
        case 1:
            42
        else: return cc + 1000  # propagate throw sentinel

    if cv > 0:
        return cv
    return 0

int main():
    print(compute(5))
    print(compute(1))
    return 0
