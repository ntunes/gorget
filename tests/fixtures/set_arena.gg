from std.alloc import Arena
from std.collections import Set

void main():
    with Arena(8192) as pool:
        Set[int] s = Set[int]()
        s.add(10)
        s.add(20)
        s.add(30)
        s.add(10)
        print("len: {s.len()}")
        print("has 20: {s.contains(20)}")
        print("bytes_used > 0: {pool.bytes_used() > 0}")
    print("done")
