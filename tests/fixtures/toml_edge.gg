from gg.toml import TomlValue, toml_parse, toml_stringify_value

void main():
    # ── Multiline basic strings ──
    str ml = "msg = \"\"\"\nhello\nworld\"\"\""
    auto r1 = toml_parse(ml)
    match r1:
        case Ok(doc1):
            print(doc1.get("msg").as_str())
        case Error(e1):
            print(e1)

    # ── Literal strings (no escapes) ──
    str lit = "path = 'C:\\Users\\me'"
    auto r2 = toml_parse(lit)
    match r2:
        case Ok(doc2):
            print(doc2.get("path").as_str())
        case Error(e2):
            print(e2)

    # ── Multiline literal strings ──
    str mllit = "text = '''\nline1\nline2'''"
    auto r3 = toml_parse(mllit)
    match r3:
        case Ok(doc3):
            print(doc3.get("text").as_str())
        case Error(e3):
            print(e3)

    # ── Inline table ──
    str inl = "point = {{x = 1, y = 2}}"
    auto r4 = toml_parse(inl)
    match r4:
        case Ok(doc4):
            int px = doc4.get("point").get("x").as_int()
            int py = doc4.get("point").get("y").as_int()
            print("{px}")
            print("{py}")
        case Error(e4):
            print(e4)

    # ── Negative integer ──
    str neg = "val = -42"
    auto r5 = toml_parse(neg)
    match r5:
        case Ok(doc5):
            int nv = doc5.get("val").as_int()
            print("{nv}")
        case Error(e5):
            print(e5)

    # ── Negative float ──
    str negf = "temp = -3.5"
    auto r6 = toml_parse(negf)
    match r6:
        case Ok(doc6):
            float fv = doc6.get("temp").as_float()
            print("{fv}")
        case Error(e6):
            print(e6)

    # ── inf and nan ──
    str specials = "pos_inf = inf\nneg_inf = -inf\nnan_val = nan"
    auto r7 = toml_parse(specials)
    match r7:
        case Ok(doc7):
            float pinf = doc7.get("pos_inf").as_float()
            float ninf = doc7.get("neg_inf").as_float()
            print(pinf > 999999.0)
            print(ninf < -999999.0)
            bool is_flt = doc7.get("nan_val").is_float()
            print("{is_flt}")
        case Error(e7):
            print(e7)

    # ── Empty array ──
    str earr = "list = []"
    auto r8 = toml_parse(earr)
    match r8:
        case Ok(doc8):
            int alen = doc8.get("list").len()
            print("{alen}")
        case Error(e8):
            print(e8)

    # ── Boolean keys ──
    str bools = "yes = true\nno = false"
    auto r9 = toml_parse(bools)
    match r9:
        case Ok(doc9):
            print(doc9.get("yes").as_bool())
            print(doc9.get("no").as_bool())
        case Error(e9):
            print(e9)

    # ── Escape sequences in basic strings ──
    str esc = "tab = \"a\\tb\"\nnl = \"a\\nb\""
    auto r10 = toml_parse(esc)
    match r10:
        case Ok(doc10):
            str tab_s = doc10.get("tab").as_str()
            int tab_len = tab_s.byte_len()
            print("{tab_len}")
            str nl_s = doc10.get("nl").as_str()
            int nl_len = nl_s.byte_len()
            print("{nl_len}")
        case Error(e10):
            print(e10)

    print("done")
