#!parity-excluded scheduling: spawned tasks async_sleep around a shared counter; the interleaving decides the value
# Test: async_sleep inside a loop with shared params.
# Exercises the coroutine state machine with mixed yield kinds
# (Sleep + MutexLock reacquire) inside a loop body.

from std.async import async_sleep
from std.conv import int_to_str

async void worker(int &counter, int n):
    int i = 0
    while i < n:
        counter = counter + 1
        async_sleep(1)
        i = i + 1

async void main():
    shared int x = 0
    Task[void] t = spawn worker(&x, 5)
    t.await()
    print(int_to_str(x))
