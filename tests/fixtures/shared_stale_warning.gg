# Test: stale-condition warning (§3.4).
# Reading a shared variable into a local before an await, then using
# the local in a branch condition after the await, should warn.
# The warning is non-fatal — program still compiles and runs.

from std.async import sleep

async void worker(int &counter):
    counter = counter + 1

async void main():
    shared int x = 0
    Task[void] t = spawn worker(&x)
    int val = x
    t.await()
    if val == 0:
        print("was zero before await")
    print(x)
