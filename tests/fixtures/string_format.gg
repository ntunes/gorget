void main():
    # Basic string interpolation — format() now returns String
    String name = "world"
    String greeting = format(f"hello {name}")
    print(greeting)

    # Plain string (no interpolation) — format() still returns String
    String plain = format("no interp")
    print(plain)

    # Numeric formatting
    int x = 42
    String num_str = format(f"{x}")
    print(num_str)

    # Multiple interpolations
    int a = 10
    int b = 20
    String expr_str = format(f"{a} + {b} = 30")
    print(expr_str)

    # Using format result in further string ops
    String hello = format("hello")
    String upper = hello.to_upper()
    print(upper)

    # Interpolation in assignment — auto resolves to String
    int v = 99
    auto assigned = f"value is {v}"
    print(assigned)

    # Interpolation in function argument (coerced to String for concat)
    String who = "gorget"
    print("hello " + f"from {who}")

    # Direct String assignment from interpolated literal
    String direct = f"hi {name}"
    print(direct)

    # Plain string literal stays String
    String plain_str = "no interp here"
    print(plain_str)

    # String variable from format — coercion String → String
    String coerced = format(f"coerced {x}")
    print(coerced)
