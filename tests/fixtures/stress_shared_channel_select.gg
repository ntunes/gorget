#!parity-excluded scheduling: spawned producers race a channel select; the per-arm counts are the scheduler's
# Stress: select over 3 producers; shared per-channel counters track provenance.
# Producers A, B, C each send 20 values (A: 1..20, B: 101..120, C: 201..220).
# A drain task uses select to consume from all three and accumulates a global sum
# and per-channel counts in shared variables.
# Expected:
#   sum   = (1+..+20) + (101+..+120) + (201+..+220)
#         = 210 + 2210 + 4210 = 6630
#   count_a = 20, count_b = 20, count_c = 20
#
# Tests: select (non-deterministic mux) + shared (per-source observability)
#        + deterministic aggregate despite non-deterministic scheduling

from std.channel import Channel

async void producer(Channel[int] ch, int start, int count):
    int i = 0
    while i < count:
        ch.send(start + i)
        i += 1

async void drain(Channel[int] a, Channel[int] b, Channel[int] c,
                 int &sum, int &ca, int &cb, int &cc):
    int total = 60
    int i = 0
    while i < total:
        select:
            case int v = a.recv():
                sum += v
                ca += 1
            case int v = b.recv():
                sum += v
                cb += 1
            case int v = c.recv():
                sum += v
                cc += 1
        i += 1

async void main():
    shared int total_sum = 0
    shared int count_a = 0
    shared int count_b = 0
    shared int count_c = 0

    Channel[int] ca = Channel[int](8)
    Channel[int] cb = Channel[int](8)
    Channel[int] cc = Channel[int](8)

    Task[void] pa = spawn producer(ca, 1, 20)
    Task[void] pb = spawn producer(cb, 101, 20)
    Task[void] pc = spawn producer(cc, 201, 20)

    Task[void] d = spawn drain(ca, cb, cc, &total_sum, &count_a, &count_b, &count_c)

    pa.await()
    pb.await()
    pc.await()
    d.await()

    ca.close()
    cb.close()
    cc.close()

    print(total_sum)
    print(count_a)
    print(count_b)
    print(count_c)
