# Stack-cliff guard fixture (#37 flip, Fix B — see the stack_guard_*
# tests in tests/integration.rs): lowering this single 200-term concat
# chain drives ~200 levels of lower_expr <-> lower_expr_inner recursion
# in the COMPILER (~180-220KB per frame at -O0), far past a stock 8MB
# main-thread stack. The pthread main runner (64MB explicit reserve) is
# what makes compiling this fixture host-ulimit-independent.
#
# Lives as a DIR fixture (main.gg) rather than a root .gg: `gg fmt`
# DESTROYS long binary chains (it reflows them into a `+`-continuation
# form the parser REJECTS, and a second fmt pass silently drops the
# orphaned lines — code loss), so a root-level copy fails the corpus-wide
# fmt_idempotent test. That formatter bug is filed HIGH in TODO; when it
# is fixed, this can move back to the root corpus.
void main():
    String a = "x"
    String s = a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a
    print(s.len())
