struct Buffer:
    int size

equip Buffer with Measurable:
    int len(self):
        return self.size

void main():
    # len() on built-in types via free function
    Vector[int] nums = Vector[int]()
    nums.push(10)
    nums.push(20)
    nums.push(30)
    print(f"{len(nums)}")

    String greeting = "hello"
    print(f"{len(greeting)}")

    # len() on user type equipped with Measurable
    Buffer buf = Buffer(42)
    print(f"{len(buf)}")

    # .len() method still works directly
    print(f"{nums.len()}")
    print(f"{greeting.len()}")
    print(f"{buf.len()}")
