from std.conv import parse_float, int_to_str, float_to_str, bool_to_str, char_to_str

void main():
    # parse_float
    float pi = parse_float("3.14")
    print("{pi}")

    float neg = parse_float("-0.5")
    print("{neg}")

    # int_to_str
    str s1 = int_to_str(42)
    print(s1)
    str s2 = int_to_str(-100)
    print(s2)

    # float_to_str
    str s3 = float_to_str(2.5)
    print(s3)
    str s4 = float_to_str(1000.0)
    print(s4)

    # bool_to_str
    print(bool_to_str(true))
    print(bool_to_str(false))

    # char_to_str
    str s5 = char_to_str('A')
    print(s5)

    # Parseable trait — int.parse()
    Option[int] n = int.parse("42")
    if n is Some(val):
        print("{val}")

    Option[int] bad = int.parse("hello")
    if bad is None:
        print("none")

    # Parseable trait — float.parse()
    Option[float] f = float.parse("3.14")
    if f is Some(fval):
        print("{fval}")

    Option[float] fbad = float.parse("xyz")
    if fbad is None:
        print("none")

    # int.default() now works (parser fix)
    int d = int.default()
    print("{d}")

    # ── Edge cases ──────────────────────────────────────────
    Option[int] empty = int.parse("")
    if empty is None:
        print("empty_none")

    Option[int] overflow = int.parse("99999999999999999999")
    if overflow is None:
        print("overflow_none")

    # ── Integer type variants ───────────────────────────────
    Option[int8] i8v = int8.parse("127")
    if i8v is Some(v8):
        print("{v8}")

    Option[uint16] u16v = uint16.parse("65535")
    if u16v is Some(v16):
        print("{v16}")

    # ── Float edge cases ────────────────────────────────────
    Option[float] fneg0 = float.parse("-0.0")
    if fneg0 is Some(fn0):
        print("neg0_ok")

    Option[float] fsci = float.parse("1.5e2")
    if fsci is Some(fsc):
        print("{fsc}")

    # ── Auto inference ──────────────────────────────────────
    auto auto_n = int.parse("99")
    if auto_n is Some(av):
        print("{av}")

    # ── Method chaining ─────────────────────────────────────
    int chained = int.parse("77").unwrap_or(0)
    print("{chained}")

    # ── More .default() coverage ────────────────────────────
    float fd = float.default()
    print("{fd}")

    bool bd = bool.default()
    print("{bd}")

    str sd = str.default()
    print("str_default:{sd}:")
