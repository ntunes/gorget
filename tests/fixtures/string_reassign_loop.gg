String join_lines(Vector[String] lines):
    if lines.len() == 0:
        return ""
    String result = lines.get(0).unwrap()
    int i = 1
    while i < lines.len():
        String next = lines.get(i).unwrap()
        result = result + "\n" + next
        i = i + 1
    return result

void main():
    Vector[String] lines = ["aaa", "bbb", "ccc"]
    print(join_lines(lines))
