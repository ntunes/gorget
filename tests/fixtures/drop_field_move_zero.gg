from std.collections import Vector

struct Holder:
    String label
    Vector[int] data

# Test 3: self.field zeroing in equip method (mutable borrow)
struct DataHolder:
    String name
    Vector[int] payload

equip DataHolder:
    Vector[int] take_payload(&self):
        Vector[int] result = self.payload
        return result

# Test 4: chained field access (obj.nested.items)
struct Inner:
    Vector[int] items

struct Outer:
    Inner nested

void main():
    # Test 1: push field into collection (was double-free without fix)
    Vector[Vector[int]] items = Vector[Vector[int]]()

    Holder h1 = Holder("h1", Vector[int]())
    h1.data.push(10)
    h1.data.push(20)
    items.push(h1.data)

    auto inner = items.get(0).unwrap()
    print(f"pushed {inner.len()}")

    # Test 2: assign field to new variable (enables ownership transfer)
    Holder h2 = Holder("h2", Vector[int]())
    h2.data.push(30)
    h2.data.push(40)
    h2.data.push(50)
    Vector[int] extracted = h2.data
    print(f"extracted {extracted.len()}")

    # Test 3: self.field
    DataHolder dh = DataHolder("test", Vector[int]())
    dh.payload.push(100)
    dh.payload.push(200)
    dh.payload.push(300)
    Vector[int] taken = dh.take_payload()
    print(f"taken {taken.len()}")

    # Test 4: chained access
    Outer o = Outer(Inner(Vector[int]()))
    o.nested.items.push(42)
    Vector[int] chained = o.nested.items
    print(f"chained {chained.len()}")

    print("done")
