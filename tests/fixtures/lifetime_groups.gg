# Named borrow groups: live(name) + where X outlives Y

String pick_first(live(a) String x, live(b) String y) where a outlives b:
    return x

String pick_second(live(a) String x, live(b) String y) where a outlives b:
    return y

void main():
    # Basic usage: both sources alive for the entire function
    String s1 = "hello"
    String s2 = "world"
    String r = pick_first(s1, s2)
    print(r)

    # pick_second also works (borrows from group a still, per where clause)
    String r2 = pick_second(s1, s2)
    print(r2)

    # Bare live (no group name) still works
    print("done")
