# Exercises std.io — the byte-shaped Writer trait + typed IoError.
#
# Phase 3 of the stdlib narrow-waist. A user-defined ByteSink satisfies
# Writer; write_all and write_display are generic free functions so the
# same helpers compose over any concrete Writer without trait-object
# dispatch.

from std.io import Writer, IoError, write_all, write_display

struct ByteSink:
    Vector[byte] buf

equip ByteSink with Writer:
    Result[int, IoError] write_bytes(&self, Vector[byte] buf):
        self.buf.extend(buf.clone())
        return Ok(buf.len())

int main():
    # Direct Writer.write_bytes on the sink.
    ByteSink s = ByteSink(Vector[byte]())
    Vector[byte] hi = "hello ".bytes()
    Result[int, IoError] r = s.write_bytes(hi)
    match r:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s.buf.len())

    # Generic write_all with short-write loop (ByteSink is eager, so
    # this just exercises the Ok path through the loop).
    ByteSink s2 = ByteSink(Vector[byte]())
    Vector[byte] world = "world".bytes()
    Result[int, IoError] r2 = write_all[ByteSink](&s2, world)
    match r2:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s2.buf.len())

    # write_display routes through Displayable.display().bytes().
    ByteSink s3 = ByteSink(Vector[byte]())
    Result[int, IoError] r3 = write_display[ByteSink, int](&s3, 42)
    match r3:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s3.buf.len())

    # IoError Displayable surface.
    print(IoError.NotFound().display())
    print(IoError.Utf8Invalid(7).display())
    print(IoError.Other("disk full").display())
    return 0
