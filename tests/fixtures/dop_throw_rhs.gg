enum JsValue:
    Undefined
    StringV(String)
    NumberV(float)

JsValue inner(Option[JsValue] o) throws String:
    JsValue v = o ?? throw "no value"
    return v

int int_inner(Option[int] o) throws String:
    int v = o ?? throw "no int"
    return v

void main():
    Result[JsValue, String] __d29_r4 = inner(Some(JsValue.StringV("hello")))
    match __d29_r4:
        case Ok(v):
            match v:
                case JsValue.StringV(s):
                    print(f"got: {s}")
                case _:
                    print("other")
        case Error(e):
            print(f"err: {e}")
    Result[JsValue, String] __d29_r3 = inner(None)
    match __d29_r3:
        case Ok(_):
            print("ok")
        case Error(e):
            print(f"err: {e}")
    Result[int, String] __d29_r2 = int_inner(Some(42))
    match __d29_r2:
        case Ok(v):
            print(f"i: {v}")
        case Error(e):
            print(f"err: {e}")
    Result[int, String] __d29_r1 = int_inner(None)
    match __d29_r1:
        case Ok(v):
            print(f"i: {v}")
        case Error(e):
            print(f"err: {e}")
