# CELL: `.or_else()` x bare-param recv x Option[Money]
# COMMITTED Round XIV (74f566c6+) — combinator-receiver ownership class-fix.
# PRE-FIX (RED-verified at HEAD 6171d564): print 0 (want 10). The Some(m)
#   receiver was consumed by the or_else adapter even though a bare receiver
#   is a borrow — reads from the return value `r` show the payload zeroed out.
#   Pair with combinator_or_else_money_field.gg (graduated known_gap) to
#   cover both projected and Ptr-unwrap Edit A + Edit B axis cells.
# TODO: delete this file when the class-retirement guard (Core #6 follow-up)
# lands — the guard subsumes this axis cell. See TODO.md §Guards.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[Money] r = p.or_else((): make_opt(99))
    if r is Some(m):
        print(size_of(m))

void main():
    call_it(make_opt(10))
