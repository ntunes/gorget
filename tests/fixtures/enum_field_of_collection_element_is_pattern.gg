# is-pattern on an enum-typed field of a collection ELEMENT (round-33
# DEEP-1 §3 bonus — a real MISCOMPILE the field-of-CoW-element borrow-
# provenance fix corrects).
#
# `(v.get(0).unwrap().tag) is Some(inner)` where `tag` is an
# `Option[String]` field of a collection element, when PRECEDED by a read
# of the same field (`v.get(0).unwrap().tag.unwrap()`). BEFORE the fix,
# the first field-load tagged the Ptr(tag) with a dead-end unnamed-temp
# `BorrowOrigin::Field { base }`; the subsequent `is`-lowering's enum
# scrutinee (`build_enum_recv_ptr`) then read the WRONG bytes and the
# match took the WRONG branch — `Some("hello")` fell through to the
# `else` arm (printed "none"). The `set_field_or_elem_borrow` chokepoint
# retags the load to borrow out of the SAME collection, so the enum
# scrutinee derefs correctly, the Some-arm matches, and `inner` binds the
# real payload (not garbage). This is the ONLY behavioral change vs
# baseline — everything else the fix touches is byte-identical.
# Output must be correct on BOTH backends.

struct Item:
    int x
    Option[String] tag

void main():
    Vector[Item] v = [Item(1, Some("hello"))]

    # Preceding read of the same field — establishes the borrow-origin
    # state that (pre-fix) corrupts the following is-pattern scrutinee.
    String pre = v.get(0).unwrap().tag.unwrap()
    print(pre)

    # is-pattern on the enum field of the collection element.
    # BASELINE takes the WRONG (else) branch here; the fix matches Some
    # and binds `inner` to the real payload.
    if (v.get(0).unwrap().tag) is Some(inner):
        print("some")
        print(inner)
    else:
        print("none")

    # A genuine None element still matches the else arm (fix does not
    # over-correct).
    Vector[Item] w = [Item(2, None)]
    if (w.get(0).unwrap().tag) is Some(inner2):
        print("some2")
        print(inner2)
    else:
        print("none2")

    print("done")
