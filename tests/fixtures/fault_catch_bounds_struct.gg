# Fault.Bounds on a Vector of PLAIN STRUCT elements (error-model.md §11
# Increment 2 (A), case (c)). The element is a by-value non-resource struct,
# so the OUT-OF-BOUNDS read must take the `Fault.Bounds` handler and yield the
# fallback struct — exactly like the scalar/resource element cases.
#
# CASE (c) IS NOW HANDLED on the self-host (the last Inc2 gap, closed): the
# faultable `gorget_array_safe_get` route is gated to scalar (a) + resource (b)
# + struct (c) element dsts. The in-bounds continuation derefs the raw element
# pointer with the SAME `GIDeref` the scalar case uses — its LIR lowering
# IMemcpy's `sizeof(inner)`, so it copies the whole aggregate out (no new
# instruction, no typed marker, no name-matching, and `eindex_raw_getter`'s
# aggregate copy-out is untouched — the faultable path never routes through it).
# Wired into the self-host lock-in (`self_host_runtime`) via the committed
# `runtime_snapshots/fault_catch_bounds_struct.out` snapshot. The `.get()`
# Option path is proved uncrossed by the `vec_struct_get` regression fixture.
struct Point:
    int x
    int y

void main():
    Vector[Point] pts = [Point(1, 2), Point(3, 4)]
    # In-bounds → the element itself (no fault).
    Point ok = (pts[1]) catch Fault.Bounds: Point(-1, -1)
    print(f"{ok.x},{ok.y}")
    # Out-of-bounds → caught, yields the fallback struct.
    Point oob = (pts[9]) catch Fault.Bounds: Point(-1, -1)
    print(f"{oob.x},{oob.y}")
