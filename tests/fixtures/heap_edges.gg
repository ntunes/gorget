from std.heap import Heap

void main():
    # Heap[int].new() static constructor
    Heap[int] h = Heap[int].new()
    bool initially_empty = h.is_empty()
    print(f"{initially_empty}")

    # peek on empty heap → None
    Option[int] empty_peek = h.peek()
    bool peek_none = empty_peek.is_none()
    print(f"{peek_none}")

    # push duplicates and pop in sorted order
    Heap[int] dups = Heap[int].new()
    dups.push(5)
    dups.push(3)
    dups.push(3)
    dups.push(1)
    int d1 = dups.pop().unwrap()
    int d2 = dups.pop().unwrap()
    int d3 = dups.pop().unwrap()
    int d4 = dups.pop().unwrap()
    print(f"{d1}")
    print(f"{d2}")
    print(f"{d3}")
    print(f"{d4}")

    # Interleaved push/pop
    Heap[int] mix = Heap[int].new()
    mix.push(10)
    mix.push(20)
    int m1 = mix.pop().unwrap()
    print(f"{m1}")
    mix.push(5)
    int m2 = mix.pop().unwrap()
    print(f"{m2}")
    int m3 = mix.pop().unwrap()
    print(f"{m3}")

    # is_empty transitions
    Heap[int] trans = Heap[int].new()
    bool e1 = trans.is_empty()
    print(f"{e1}")
    trans.push(42)
    bool e2 = trans.is_empty()
    print(f"{e2}")
    trans.pop()
    bool e3 = trans.is_empty()
    print(f"{e3}")

    print("done")
