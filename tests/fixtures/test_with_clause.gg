struct Resource:
    String name

equip Resource with Drop:
    void drop(!self):
        String n = self.name
        print(f"dropping {n}")

test "single with":
    with Resource("alpha") as r:
        assert r.name == "alpha"

test "with cleanup on failure":
    with Resource("beta") as r:
        assert 1 == 2

test "multiple with":
    with Resource("gamma") as a:
        with Resource("delta") as b:
            assert a.name == "gamma"
            assert b.name == "delta"
