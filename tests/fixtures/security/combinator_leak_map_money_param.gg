# CELL: `.map()` × bare-param recv × Option[Money] × mapped-away return type
# Round XXII Track β — closes the ASan-leak class where the combinator
# adapter's extracted payload had no owner registered → scope-exit
# `DropIfAlive` never fired → the payload's heap bytes leaked when the
# closure only BORROWED the payload (any mapped return type ≠ the payload
# type). Scout: `/tmp/round_xxii_trackBeta_scout_79000.md`.
#
# RED-VERIFIED against the pre-fix compiler (Track β executor RED-verify,
# 2026-08-01, HEAD 0aa3f5a6 with methods.rs helper reverted): pre-fix
# LSan report of the Money payload's `heap_cents` Vector[int] buffer;
# EXIT: 99. Post-fix: EXIT: 0, ASan-clean.
#
# AXIS SAMPLE: payload=Money (resource, Vector[int] field, heap-forced) ·
# combinator=map · closure return type=int (≠ Money) · recv=bare-param.
# The payload is HEAP-FORCED (a built Vector[int], not a literal), so the
# leak is observable rather than const-folded away.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[int] r = p.map((Money m): size_of(m))
    if r is Some(v):
        print(v)

void main():
    call_it(make_opt(3))
