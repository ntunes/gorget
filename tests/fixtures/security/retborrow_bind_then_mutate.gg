# The alias-at-bind's WHOLE correctness obligation: materialize-on-mutation.
# Binding a `&`-param is a zero-cost CoW Ptr alias; the first mutation of the
# bind must clone into a private buffer, so the CALLER's value is UNCHANGED.
#
# Without this fixture the alias could degenerate into a silent write-through
# miscompile — strictly worse than the double-free it replaced, because it is
# invisible to the sanitizer. Two receiver shapes; both assert the caller.
struct Holder:
    Vector[int] items
    String tag

Vector[int] build_at_runtime(int n):
    Vector[int] out = []
    int i = 0
    while i < n:
        out.push(i * 7)
        i = i + 1
    return out

void bind_then_mutate_vector(Vector[int] &v):
    Vector[int] local = v
    local.push(999)
    print(local.len())
    print(v.len())

void bind_then_mutate_struct(Holder &h):
    Holder local = h
    local.items.push(999)
    print(local.items.len())
    print(h.items.len())

void main():
    Vector[int] xs = build_at_runtime(4)
    bind_then_mutate_vector(&xs)
    print(xs.len())

    Holder h = Holder(build_at_runtime(3), "tag")
    bind_then_mutate_struct(&h)
    print(h.items.len())
