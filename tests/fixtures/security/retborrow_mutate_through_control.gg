# CONTROL for retborrow_bind_then_mutate: mutating the `&`-param ITSELF must
# still WRITE THROUGH to the caller. Without this control, "fixing" the aliasing
# by always cloning would pass every other fixture in the family while silently
# breaking the entire point of `&`.
Vector[int] build_at_runtime(int n):
    Vector[int] out = []
    int i = 0
    while i < n:
        out.push(i * 7)
        i = i + 1
    return out

void mutate_through(Vector[int] &v):
    v.push(999)

void main():
    Vector[int] xs = build_at_runtime(4)
    mutate_through(&xs)
    print(xs.len())
    print(xs.get(4).unwrap())
