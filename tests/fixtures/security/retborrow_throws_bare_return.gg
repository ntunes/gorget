# CONTROL — the THROWS bare `return v` leg of a `&`-param. This leg was already
# clean (the throws return's by-value `needs_drop` arm keeps it so) and the
# non-throws routing must not disturb it. Pinned as a committed fixture because
# the throws branch is adjacent to the code this family changed.
Vector[int] build_at_runtime(int n):
    Vector[int] out = []
    int i = 0
    while i < n:
        out.push(i * 7)
        i = i + 1
    return out

Vector[int] pass_through(Vector[int] &v) throws String:
    return v

void main():
    Vector[int] xs = build_at_runtime(4)
    Vector[int] r = pass_through(&xs)! catch (e): []
    print(r.len())
    print(xs.len())
