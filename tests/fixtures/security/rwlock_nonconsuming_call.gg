# D53 POS — plain non-consuming call borrows the unique lock; no operator.
# CELL: lock=RWLock · position=plain-call · source=named place.
# ggdef: ABSTAIN (Mutex/RWLock out of subset; owner: ggdef stays simple).

from std.sync import RWLock

void peek(RWLock[int] x):
    print(x.read().get())

void main():
    RWLock[int] r = RWLock[int](5)
    peek(r)
    print(r.read().get())
