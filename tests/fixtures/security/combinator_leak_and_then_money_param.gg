# CELL: `.and_then()` × bare-param recv × Option[Money] × mapped-away
# return type. Sibling of `combinator_leak_map_money_param.gg`; same
# leak class, `and_then` arm (closure returns `Option[int]`, cross-type
# from `Option[Money]`). See sibling header for RED-verify + Track β
# class-fix narrative.
#
# AXIS SAMPLE: payload=Money · combinator=and_then · closure return=Option[int]
# · recv=bare-param.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[int] r = p.and_then((Money m): Some(size_of(m)))
    if r is Some(v):
        print(v)

void main():
    call_it(make_opt(5))
