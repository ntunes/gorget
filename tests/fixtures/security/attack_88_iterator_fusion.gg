# Probe: iterator adapter chain must produce correct count — lazy
# fusion semantics. filter → map → take(3) → collect should stop
# after 3 elements even though the underlying vector has many more.

void main():
    Vector[int] big = []
    int i = 0
    while i < 100:
        big.push(i)
        i += 1
    Vector[int] result = big.iter().filter((int x): x % 7 == 0).map((int x): x * 2).take(3).collect()
    print(result.len())
    int j = 0
    while j < result.len():
        print(result.get(j).unwrap())
        j += 1
