# R47 Track B — INDIRECT-DISPATCH CALL RESULT NEVER REGISTERED FOR DROP,
# MEASURED ON THE RECEIVER-ROOT AXIS.
#
# CELL: arm = `Box[Trait]` vtable dispatch · receiver root = STRUCT FIELD
# (`holder.b.speak()`), not a bare local · position = discarded temp ·
# payload = String.
#
# ⚠ WHY THIS CELL EXISTS. The receiver's ROOT decides which lowering path
# materialises the `self` pointer, and only the bare-local root is exercised
# by the other vtable cells. A fix keyed on the receiver shape rather than on
# the call producer would leave this one leaking.
#
# INSTRUMENT: `security_safe_no_leak`, C lane only (ASan is a no-op under
# `--backend=llvm`).
#
# RED-VERIFIED at pristine `f3feea79`: LEAK 4 byte(s) / 1 allocation, 3/3 runs.
from std.collections import Box

trait Speaker:
    String speak(self)

struct Robot:
    String id

equip Robot with Speaker:
    String speak(self):
        return self.id + "!"

struct Holder:
    Box[Speaker] b

void main():
    Holder h = Holder(Box.new(Robot("R2")))
    print(h.b.speak())
