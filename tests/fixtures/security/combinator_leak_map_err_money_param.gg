# CELL: `.map_err()` × bare-param recv × Result[int, Money] × mapped-away
# return type. Error-branch sibling of the Some/Ok leak class — the Error
# err_val extraction had the same missing-registration hole; the class-fix
# routes both branches through the shared `extract_enum_payload_owned`
# helper. See `combinator_leak_map_money_param.gg` header for the class
# narrative.
#
# AXIS SAMPLE: payload=Money (in Error variant) · combinator=map_err ·
# closure return=int (≠ Money) · recv=bare-param.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Result[int, Money] make_err(int n):
    return Error(Money(heap_cents(n)))

void call_it(Result[int, Money] p):
    Result[int, int] r = p.map_err((Money m): size_of(m))
    if r is Error(e):
        print(e)

void main():
    call_it(make_err(6))
