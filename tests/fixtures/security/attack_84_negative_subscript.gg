# Probe: v[-1] — Python semantics (last element) or OOB?  Gorget is
# Python-shaped but statically typed; the behavior isn't obvious from
# the language spec.

void main():
    Vector[int] v = [10, 20, 30]
    # v.get(-1) is Option-returning — safe.
    Option[int] safe_neg = v.get(-1)
    match safe_neg:
        case Some(x): print(x)
        case None(): print("none")
    # v[-1] direct subscript — does it wrap or trap?
    print(v[-1])
