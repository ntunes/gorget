# Struct with a Vector field. Extract a borrow of the field, move/drop the struct,
# keep the borrow.

struct Holder:
    Vector[int] data

void main():
    Holder h = Holder([1, 2, 3, 4, 5])
    Option[int] peek = h.data.get(2)
    # Consume h completely.
    Holder h2 = h
    # If peek is a borrow into h.data, and h.data was moved into h2, the borrow is dangling.
    match peek:
        case Some(v): print(v)
        case None(): print(-1)
    print(h2.data.get(2).unwrap())
