# Arena borrow-escape: bind a non-Copy `.get()` borrow of an arena-scoped Vector
# to an OUTER-scope variable. The borrow aliases into the arena's backing buffer,
# which `gorget_arena_destroy` frees at `with`-scope exit, so `peek` dangles —
# a heap-use-after-free at `print(peek)`. `gg check` must REJECT this.

from std.alloc import Arena
from std.collections import Vector
void main():
    String peek = "init"
    with Arena(4096) as pool:
        Vector[String] v = ["payload-in-arena-memory"]
        peek = v.get(0).unwrap()
    print(peek)
