# Attack: `Shared[T] !s` where T is a trivial-only struct (no resource fields
# in T itself) — same shape as attack_22 but with Cell(int) instead of
# Big(Vector[int]). attack_22 prints "-1" (None, strong count was properly
# decremented). This one prints "1" (Some — the control block stayed alive).
# Separate pre-existing bug in the refcount metadata for Shared-over-trivial
# structs. No UAF — the program exits cleanly under ASan — but the drop
# isn't complete, and `w.upgrade()` finds the strong count still > 0.
# Tracks the bug so when it's fixed, this fixture flips to printing "0" and
# the harness prompts reclassification.

struct Cell:
    int val

void take_and_drop(Shared[Cell] !s):
    pass

void main():
    Shared[Cell] s = Shared[Cell](Cell(42))
    Weak[Cell] w = s.downgrade()
    take_and_drop(!s)
    match w.upgrade():
        case Some(alive): print(1)
        case None(): print(0)
