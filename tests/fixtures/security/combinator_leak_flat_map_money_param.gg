# CELL: `.flat_map()` × bare-param recv × Option[Money] × mapped-away return
# type. Sibling of `combinator_leak_map_money_param.gg`; same leak class,
# different arm — the closure returns `Option[int]` (≠ payload type).
# See sibling header for RED-verify + Track β class-fix narrative.
#
# AXIS SAMPLE: payload=Money · combinator=flat_map · closure return=Option[int]
# · recv=bare-param.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Option[int] r = p.flat_map((Money m): Some(size_of(m)))
    if r is Some(v):
        print(v)

void main():
    call_it(make_opt(4))
