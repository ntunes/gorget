# REGRESSION — A2 cell of the callable-indirection axis: a PROJECTION arg
# through a `Callable`-typed PARAMETER writes through on indirect call.
#
# AXIS / CELL (root x callable-provenance x arg-spelling):
#   struct-`&`-param projection root  x  PARAM callable  x  `&`-spelled arg
# Sibling: `sound_callable_amp_param_indirect_call.gg` covers the LOCAL-callable
# + plain-local-int-root cell of the same axis.
#
# Pre-Track-B1 (measured on gorget-1 base): `gg check` OK, `gg build` OK, binary
# exit 139 (SIGSEGV). The UNIT_TYPE indirect-call arm in
# `src/ir/lowering/exprs/calls.rs` (Callable-PARAMETER, emits `__callable_N`)
# decided pointer-vs-value from the argument's provenance
# (`is_param_borrow_unique`) rather than the callee's declared param types, so
# `&c.fd` was lowered as a value copy of the int and handed to a callee
# expecting a pointer. Fix populates `callable_param_types` +
# `callable_param_ownerships` for the parameter and routes each user arg through
# `lower_call_arg`.
#
# ⚠ `gg run` masks the pre-fix crash as exit 1 with no output — it does not
# propagate the child's signal status. Reproduce a regression by BUILDING and
# running the binary directly, or the failure looks like an ordinary build
# error.
#
# INTENDED: the indirect call is an ordinary write-through call, so `bumpret`
# increments the caller's `c.fd` and the program prints 11 then 11. The seed is
# COMPUTED, not a literal, so no const-fold can elide the call.
#
# ORACLE (ggdef): OUT OF SUBSET — ggdef does not reify a named function into a
# `Callable` value ("unresolved local"). Recorded explicitly per Core #9.

struct Counter:
    int fd

int seed():
    return 10

int bumpret(int &n):
    n = n + 1
    return n

int with_it(Callable[int(int &)] f, Counter &c):
    return f(&c.fd)

void main():
    Counter c = Counter(seed())
    print(with_it(bumpret, &c))
    print(c.fd)
