# SOUND (memory safety only) — the `Deque[String]` × `&` cell.
#
# The fourth cell of the mode × collection axis
# ({bare, `&`} × {`Vector`, `Deque`}). Same disposition as
# `sound_for_string_elem_rebind_vector_amp.gg`: this pins MEMORY SAFETY, not
# the ratified value. `for x in &coll` is ratified WRITE-THROUGH, so the
# language-correct stdout is `zz` / `zz`; the write is lost (`todo/t1404`).
# What used to happen here was a double free (rc 134), which is strictly worse.
#
# PINS the `insts.rs` view half. RED-verified against the pre-fix compiler:
# rc 134 double free.
from std.collections import Deque

void main():
    Deque[String] d = Deque[String]()
    d.push("aa")
    d.push("bb")
    for s in &d:
        s = "zz"
    for s in d:
        print(s)
