# matcluster #1 POSITIVE (planner round 3, D6 mutation-audit gap): a BARE-param
# COMPOUND write must MATERIALIZE the root so the caller is UNCHANGED — the
# positive sibling of cow_amp_compound_writethrough's `&` negative control. The
# mutation audit found the compound-assign root-materialize site had only the
# structural `compound_assign_root_materialize_arms_count` lint and no RUNTIME
# pin: cow_amp_compound_writethrough exercises the `&` (write-through) path and
# cow_taint_compound_projected rejects at check time (2T taint), so neither pins
# the bare-param compound materialize. Pre-#1 these wrote THROUGH (printing 11);
# now the bare param materializes a private copy and the caller keeps 10.
# Exercises BOTH arms of materialize_assign_target_root in the compound position:
# `xs[0] += 1` (identifier root) and `c.counts[0] += 1` (projected root).
from std.collections import Vector

struct Counter:
    Vector[int] counts

void bump_index(Vector[int] xs):
    xs[0] += 1

void bump_field(Counter c):
    c.counts[0] += 1

void main():
    Vector[int] a = [10]
    bump_index(a)
    print(a[0])            # 10  (caller UNCHANGED — bare param materialized)

    Counter c = Counter([10])
    bump_field(c)
    print(c.counts[0])     # 10  (caller UNCHANGED)
    print("done")
