void main():
    String s = "hello"

    # codepoint indexing — returns String
    String first = s[0]
    print(first)

    String last = s[4]
    print(last)

    # codepoint slicing
    String sub = s[1..3]
    print(sub)

    String prefix = s[0..2]
    print(prefix)

    # for-in iteration — yields String
    String word = "abc"
    for ch in word:
        print(ch)

    # multi-byte UTF-8
    String cafe = "café"
    print(cafe[3])
    print(cafe.len())
    print(cafe[0..3])

    # negative indexing
    print(s[-1])
