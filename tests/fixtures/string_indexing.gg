void main():
    str s = "hello"

    # char access
    char first = s.char_at(0)
    print("{first}")

    char last = s.char_at(4)
    print("{last}")

    # slicing
    str sub = s.byte_slice(1, 3)
    print(sub)

    # slice from start
    str prefix = s.byte_slice(0, 2)
    print(prefix)

    # for-in iteration
    str word = "abc"
    for ch in word:
        print("{ch}")
