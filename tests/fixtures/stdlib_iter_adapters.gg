# Exercises the Take / Skip / Chain adapter iterators from std.iter.
#
# Chaining via `.take()` / `.skip()` methods on VectorIter requires
# generic monomorphization of nested iterator types before the parent
# Vector__T__iter lowers, which currently trips a forward-reference.
# For now adapters are constructed directly via their struct literal.

from std.iter import VectorIter, TakeIter, SkipIter, ChainIter

int main():
    Vector[int] v = [10, 20, 30, 40, 50]

    print("--take(2)--")
    VectorIter[int] vit_t = v.iter()
    TakeIter[VectorIter[int], int] t = TakeIter[VectorIter[int], int](vit_t, 2)
    for x in t:
        print(x)

    print("--skip(2)--")
    VectorIter[int] vit_s = v.iter()
    SkipIter[VectorIter[int], int] s = SkipIter[VectorIter[int], int](vit_s, 2)
    for x in s:
        print(x)

    print("--chain--")
    Vector[int] a = [1, 2, 3]
    Vector[int] b = [100, 200]
    VectorIter[int] ia = a.iter()
    VectorIter[int] ib = b.iter()
    ChainIter[VectorIter[int], VectorIter[int], int] c = ChainIter[VectorIter[int], VectorIter[int], int](ia, ib, true)
    for x in c:
        print(x)

    return 0
