# Ch3: `match` as an EXPRESSION with guards — the book teaches both features.
# score is 85, so the first guard (>= 90) is FALSE and the second must win.
# Expected: B
void main():
    int score = 85
    String g = match score:
        case s if s >= 90: "A"
        case s if s >= 80: "B"
        else: "F"
    print(g)
