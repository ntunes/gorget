# docs/language-design.md:2605 § "Stdlib Design: Option Over Panic" (verbatim)
# The doc's own annotations: v.get(5) is None, v.get(1).unwrap() is 20,
# m.get("z") is None, and `m.get("z") ?? 0` is 0.
# Expected: None-safe: 0 / 20
void main():
    Vector[int] v = [10, 20, 30]
    Option[int] x = v.get(5)            # None (not a panic)
    int y = v.get(1).unwrap()           # 20

    Dict[String, int] m = {"a": 1}
    Option[int] val = m.get("z")        # None (not a panic)
    int fallback = m.get("z") ?? 0      # 0 via default operator
    print(f"None-safe: {fallback}")
    print(f"{y}")
