# docs/book/06-structs-enums.md:12 § "Definition" + :27 "Construction" + :34 "Field Access"
# Expected: Alice is 30 / 1.000000
struct Point:
    float x
    float y

struct Person:
    String name
    int age
    bool active

void main():
    Point p = Point(1.0, 2.0)
    Person alice = Person("Alice", 30, true)
    float x = p.x
    String name = alice.name
    print(f"{alice.name} is {alice.age}")
    print(f"{x}")
