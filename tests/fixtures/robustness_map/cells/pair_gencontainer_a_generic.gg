String mk(String a, String b):
    return a + b


# pair:gen_container (a) generic struct at two types.
# Expected: 42 / alpha
struct Container[T]:
    T value

void main():
    Container[int] a = Container[int](42)
    Container[String] b = Container[String](mk("al", "pha"))
    print(f"{a.value}")
    print(b.value)
