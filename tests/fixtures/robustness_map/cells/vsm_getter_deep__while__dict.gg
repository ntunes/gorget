struct Inner:
    Dict[String,int] f
struct Outer:
    Inner i
equip Outer:
    Dict[String,int] getf(&self):
        return self.i.f
void main():
    Dict[String,int] __p = {"k": 10}
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    Dict[String,int] c = o.getf()
    int __w = 0
    while __w < 1:
        o.i.f.put("k2", 777)
        __w += 1
    print(f"{c.len()}")
