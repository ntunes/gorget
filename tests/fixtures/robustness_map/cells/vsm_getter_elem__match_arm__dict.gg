struct Store:
    Vector[Dict[String,int]] f
equip Store:
    Dict[String,int] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Dict[String,int]] __p = [{"k": 10}]
    Store s = Store(__p)
    Dict[String,int] c = s.getf()
    match 1:
        case 1:
            s.f.get(0).unwrap().put("k2", 777)
        else:
            pass
    print(f"{c.len()}")
