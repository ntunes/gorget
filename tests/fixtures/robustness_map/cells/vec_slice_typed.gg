# Ch5: the book's exact slice example, with the explicit Vector[int] spelling.
# Expected: 3 / 2,3,4 / 5 / 0
void main():
    Vector[int] v = [1, 2, 3, 4, 5]
    Vector[int] mid = v[1:4]
    print(f"{mid.len()}")
    print(f"{mid[0]},{mid[1]},{mid[2]}")
    Vector[int] safe = v[0:1000]
    print(f"{safe.len()}")
    Vector[int] empty = v[3:1]
    print(f"{empty.len()}")
