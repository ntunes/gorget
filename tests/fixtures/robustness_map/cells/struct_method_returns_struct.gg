# Ch6: a method returning a new instance.
# Expected: 4 / 6
struct Point:
    int x
    int y

equip Point:
    Point translate(self, int dx, int dy):
        return Point(self.x + dx, self.y + dy)

void main():
    Point p = Point(3, 5)
    Point q = p.translate(1, 1)
    print(f"{q.x}")
    print(f"{q.y}")
