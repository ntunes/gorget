struct Inner:
    Set[int] f
struct Outer:
    Inner i
equip Outer:
    Set[int] getf(&self):
        return self.i.f
void main():
    Set[int] __p = {10}
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    Set[int] c = o.getf()
    Vector[int] __xs = [1]
    for __x in __xs:
        o.i.f.add(777)
    print(f"{c.len()}")
