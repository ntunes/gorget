# Ch5: `sum` over nothing is the additive identity 0; `min`/`max` have no answer
# so they are Option and must be None.
# Expected: 0 / none / none
from std.iter import Iterator

void main():
    Vector[int] v = Vector[int]()
    print(f"{v.iter().sum()}")
    match v.iter().min():
        case Some(x):
            print(f"{x}")
        case None:
            print("none")
    match v.iter().max():
        case Some(x):
            print(f"{x}")
        case None:
            print("none")
