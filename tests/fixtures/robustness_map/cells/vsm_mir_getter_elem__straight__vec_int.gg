struct Store:
    Vector[Vector[int]] f
equip Store:
    Vector[int] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Vector[int]] __p = [[10, 20]]
    Store s = Store(__p)
    Vector[int] c = s.getf()
    c.set(0, 777)
    print(f"{s.f.get(0).unwrap().get(0).unwrap()}")
    print(f"{c.get(0).unwrap()}")
