String mk(String a, String b):
    return a + b


# Ch5: `enumerate(c)` as the book spells it (a free function).
# Expected: 0:alpha / 1:beta
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("al", "pha"))
    v.push(mk("be", "ta"))
    for i, s in enumerate(v):
        print(f"{i}:{s}")
