String mk(String a, String b):
    return a + b


# Ch5: iterate a dict in insertion order.
# Expected: Alice: 30 / Bob: 25
void main():
    Dict[String, int] ages = Dict[String, int]()
    ages.put(mk("Al", "ice"), 30)
    ages.put(mk("B", "ob"), 25)
    for k, v in ages:
        print(f"{k}: {v}")
