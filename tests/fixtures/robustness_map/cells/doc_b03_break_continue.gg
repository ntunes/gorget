# docs/book/03-control-flow.md:120 § "Break and Continue" (verbatim)
# Expected: 1 / 3 / 5 / 7   (the doc's own annotation)
void main():
    for i in 0..10:
        if i % 2 == 0:
            continue           # skip even numbers
        if i > 7:
            break              # stop at 7
        print(f"{i}")           # prints 1, 3, 5, 7
