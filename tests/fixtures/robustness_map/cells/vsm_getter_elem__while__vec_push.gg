struct Store:
    Vector[Vector[int]] f
equip Store:
    Vector[int] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Vector[int]] __p = [[10, 20]]
    Store s = Store(__p)
    Vector[int] c = s.getf()
    int __w = 0
    while __w < 1:
        s.f.get(0).unwrap().push(777)
        __w += 1
    print(f"{c.len()}")
