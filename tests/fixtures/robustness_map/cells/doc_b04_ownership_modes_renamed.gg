# docs/book/04-functions.md:74 § "Ownership Modes" -- sibling with `read` renamed
# to `peek`, so the three ownership modes are measured on their own rather than
# through the already-filed unmangled-libc-name collision.
# Expected: hi / 5 / archived: hi
struct Message:
    String subject
    int priority

void archive(Message m):
    print(f"archived: {m.subject}")

void peek(Message msg):         # immutable borrow (default)
    print(msg.subject)

void modify(Message &msg):      # mutable borrow
    msg.priority = 5

void consume(Message !msg):     # move - caller gives up ownership
    archive(msg)

void main():
    Message msg = Message("hi", 1)
    peek(msg)
    modify(&msg)
    print(f"{msg.priority}")
    consume(^msg)
