String mk(String a, String b):
    return a + b


# pair:struct_sum (b) fold over the struct vector. Expected: 55
struct Person:
    String name
    int age

void main():
    Vector[Person] ps = Vector[Person]()
    ps.push(Person(mk("Al", "ice"), 30))
    ps.push(Person(mk("B", "ob"), 25))
    print(f"{ps.fold(0, (int acc, Person p): acc + p.age)}")
