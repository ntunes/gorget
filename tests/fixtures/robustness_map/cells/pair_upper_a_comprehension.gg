String mk(String a, String b):
    return a + b


# pair:upper_strings (a) comprehension over RUNTIME-BUILT strings. Expected: ALPHA/BETA
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("al", "pha"))
    v.push(mk("be", "ta"))
    Vector[String] out = [s.to_upper() for s in v]
    print(out[0])
    print(out[1])
