struct Store:
    Vector[int] f
equip Store:
    Vector[int] getf(&self):
        return self.f
void main():
    Vector[int] __p = [10, 20]
    Store s = Store(__p)
    Vector[int] c = s.getf()
    match 1:
        case 1:
            s.f.push(777)
        else:
            pass
    print(f"{c.len()}")
