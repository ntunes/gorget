struct Store:
    Vector[Vector[int]] f
equip Store:
    Vector[int] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Vector[int]] __p = [[10, 20]]
    Store s = Store(__p)
    Vector[int] c = s.getf()
    loop:
        s.f.get(0).unwrap().push(777)
        break
    print(f"{c.len()}")
