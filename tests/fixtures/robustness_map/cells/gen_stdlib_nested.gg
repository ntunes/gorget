String mk(String a, String b):
    return a + b


# Ch8: nested stdlib generics -- Dict[String, Vector[int]].
# Expected: 2 / 20
void main():
    Dict[String, Vector[int]] groups = Dict[String, Vector[int]]()
    Vector[int] xs = [10, 20]
    groups.put(mk("a", ""), xs)
    Vector[int] got = groups.get(mk("a", "")).unwrap_or([])
    print(f"{got.len()}")
    print(f"{got[1]}")
