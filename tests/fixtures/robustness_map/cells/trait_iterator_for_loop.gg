# Ch7: equipping Iterator[int] makes a struct usable in a for loop.
# Expected: 0 / 1 / 2 / 3 / 4
struct Counter:
    int current
    int max

equip Counter with Iterator[int]:
    Option[int] next(&self):
        if self.current < self.max:
            int val = self.current
            self.current += 1
            return Some(val)
        return None()

void main():
    for i in Counter(0, 5):
        print(f"{i}")
