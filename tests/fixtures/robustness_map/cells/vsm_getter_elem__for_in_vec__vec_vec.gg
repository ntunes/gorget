struct Store:
    Vector[Vector[Vector[int]]] f
equip Store:
    Vector[Vector[int]] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Vector[Vector[int]]] __p = [[[10], [20]]]
    Store s = Store(__p)
    Vector[Vector[int]] c = s.getf()
    Vector[int] __xs = [1]
    for __x in __xs:
        s.f.get(0).unwrap().set(0, [777])
    print(f"{c.get(0).unwrap().get(0).unwrap()}")
