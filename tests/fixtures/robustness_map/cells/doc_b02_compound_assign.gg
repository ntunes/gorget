# docs/book/02-types.md:191 § "Compound Assignment" (arithmetic forms, x starts at 10)
# Expected: 11 / 10 / 20 / 10 / 0
void main():
    int x = 10
    x += 1         # x = x + 1
    print(f"{x}")
    x -= 1
    print(f"{x}")
    x *= 2
    print(f"{x}")
    x /= 2
    print(f"{x}")
    x %= 5
    print(f"{x}")
