String mk(String a, String b):
    return a + b


# pair:dictbuild (c) subscript writes. Expected: 1 / 2
void main():
    Dict[String, int] d = Dict[String, int]()
    d[mk("a", "")] = 1
    d[mk("b", "")] = 2
    print(f"{d.get(mk("a", "")).unwrap_or(0)}")
    print(f"{d.get(mk("b", "")).unwrap_or(0)}")
