# docs/language-design.md:261 § "Multiple Return Values" (verbatim)
# NOTE the return-type spelling here is PARENTHESIZED -- `(int, int)` -- while
# docs/book/04-functions.md:105 writes the same feature as `String, int parse(...)`.
# Expected: 3 / 2   (17 / 5 = 3 remainder 2)
(int, int) divmod(int a, int b):
    return (a / b, a % b)

void main():
    auto (quotient, remainder) = divmod(17, 5)
    print(f"{quotient}")
    print(f"{remainder}")
