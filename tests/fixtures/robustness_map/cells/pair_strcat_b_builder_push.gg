String mk(String a, String b):
    return a + b


# pair:strcat (b) String builder push. Expected: abc
void main():
    Vector[String] parts = Vector[String]()
    parts.push(mk("", "a"))
    parts.push(mk("", "b"))
    parts.push(mk("", "c"))
    String out = String()
    for p in parts:
        out.push(p)
    print(out)
