String mk(String a, String b):
    return a + b


# pair:sortbylen (c) hand-written selection sort. Expected: a / bb / ccc
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("cc", "c"))
    v.push(mk("a", ""))
    v.push(mk("b", "b"))
    for i in 0..v.len():
        int best = i
        for j in (i + 1)..v.len():
            if v[j].len() < v[best].len():
                best = j
        String t = v[i]
        v[i] = v[best]
        v[best] = t
    print(v[0])
    print(v[1])
    print(v[2])
