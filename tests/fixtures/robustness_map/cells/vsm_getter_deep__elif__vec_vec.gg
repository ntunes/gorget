struct Inner:
    Vector[Vector[int]] f
struct Outer:
    Inner i
equip Outer:
    Vector[Vector[int]] getf(&self):
        return self.i.f
void main():
    Vector[Vector[int]] __p = [[10], [20]]
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    Vector[Vector[int]] c = o.getf()
    if 1 == 2:
        pass
    elif 1 == 1:
        o.i.f.set(0, [777])
    print(f"{c.get(0).unwrap().get(0).unwrap()}")
