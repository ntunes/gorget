String mk(String a, String b):
    return a + b


# pair:sortbylen (b) sort with a length comparator. Expected: a / bb / ccc
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("cc", "c"))
    v.push(mk("a", ""))
    v.push(mk("b", "b"))
    v.sort((String a, String b): a.len() - b.len())
    print(v[0])
    print(v[1])
    print(v[2])
