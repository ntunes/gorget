# std.math.round follows C's round(): halfway cases go AWAY from zero, so 2.5
# rounds to 3 and -2.5 to -3 (this is NOT banker's rounding).
# Expected: 3.000000 / -3.000000 / 2.000000
from std.math import round

float x():
    return 2.5

float y():
    return -2.5

float z():
    return 2.4

void main():
    print(f"{round(x())}")
    print(f"{round(y())}")
    print(f"{round(z())}")
