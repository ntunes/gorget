String mk(String a, String b):
    return a + b


# pair:dictbuild (a) put in a loop over parallel vectors. Expected: 1 / 2
void main():
    Dict[String, int] d = Dict[String, int]()
    Vector[String] keys = Vector[String]()
    keys.push(mk("a", ""))
    keys.push(mk("b", ""))
    for i in 0..keys.len():
        d.put(keys[i], i + 1)
    print(f"{d.get(mk("a", "")).unwrap_or(0)}")
    print(f"{d.get(mk("b", "")).unwrap_or(0)}")
