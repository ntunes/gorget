# docs/book/05-collections.md:115 § "Sort" -- .sorted() returns a new vector.
# Expected: sorted copy first, then the ORIGINAL still in its original order.
void main():
    auto v = [3, 1, 4, 1, 5, 9, 2, 6]
    Vector[int] s = v.sorted()          # returns new sorted vector
    print(f"{s[0]},{s[1]},{s[2]},{s[3]},{s[4]},{s[5]},{s[6]},{s[7]}")
    print(f"{v[0]},{v[1]},{v[2]},{v[3]},{v[4]},{v[5]},{v[6]},{v[7]}")
