# Classic: merge two sorted lists.
# Expected: 1,2,3,4,5,6
void main():
    Vector[int] a = [1, 3, 5]
    Vector[int] b = [2, 4, 6]
    Vector[int] out = Vector[int]()
    int i = 0
    int j = 0
    while i < a.len() and j < b.len():
        if a[i] <= b[j]:
            out.push(a[i])
            i += 1
        else:
            out.push(b[j])
            j += 1
    while i < a.len():
        out.push(a[i])
        i += 1
    while j < b.len():
        out.push(b[j])
        j += 1
    print(f"{out[0]},{out[1]},{out[2]},{out[3]},{out[4]},{out[5]}")
