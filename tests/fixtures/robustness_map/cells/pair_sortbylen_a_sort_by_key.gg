String mk(String a, String b):
    return a + b


# pair:sortbylen (a) sort_by_key on length. Expected: a / bb / ccc
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("cc", "c"))
    v.push(mk("a", ""))
    v.push(mk("b", "b"))
    v.sort_by_key((String s): s.len())
    print(v[0])
    print(v[1])
    print(v[2])
