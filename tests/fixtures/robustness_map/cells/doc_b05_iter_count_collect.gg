# docs/book/05-collections.md:238 § "Iteration with Adapters" -- count / collect.
# Expected: 5 / 3   (the doc annotates "# 5" and "# [10, 20, 30]")
void main():
    Vector[int] v = [10, 20, 30, 40, 50]
    int n          = v.iter().count()                    # 5
    Vector[int] xs = v.iter().take(3).collect()          # [10, 20, 30]
    print(f"{n}")
    print(f"{xs.len()}")
