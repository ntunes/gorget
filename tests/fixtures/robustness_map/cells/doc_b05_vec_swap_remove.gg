# docs/book/05-collections.md:145 § "Swap and Fill" -- swap_remove(i).
# Expected: 50,10,30,40   (the doc's own annotation)
void main():
    Vector[int] v = [10, 20, 30, 40, 50]
    v.swap(0, 4)                # [50, 20, 30, 40, 10]
    v.swap_remove(1)            # [50, 10, 30, 40] (10 filled the hole)
    print(f"{v[0]},{v[1]},{v[2]},{v[3]}")
