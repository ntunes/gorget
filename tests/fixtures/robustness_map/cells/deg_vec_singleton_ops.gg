# One element: sorting, reversing and aggregating must all leave it alone.
# Expected: 5 / 5 / 5 / 5
from std.iter import Iterator

void main():
    Vector[int] v = [5]
    v.sort()
    print(f"{v[0]}")
    v.reverse()
    print(f"{v[0]}")
    print(f"{v.iter().sum()}")
    print(f"{v.iter().max().unwrap()}")
