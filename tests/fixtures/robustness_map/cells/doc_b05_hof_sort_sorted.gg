# docs/book/05-collections.md:586 § "Vector: sort, sorted" (verbatim)
# Expected: 1,1,3,4,5   (the doc's own annotation)
void main():
    auto v = [3, 1, 4, 1, 5]

    v.sort()                       # in-place: [1, 1, 3, 4, 5]
    auto copy = v.sorted()         # new sorted copy, original unchanged
    print(f"{v[0]},{v[1]},{v[2]},{v[3]},{v[4]}")
