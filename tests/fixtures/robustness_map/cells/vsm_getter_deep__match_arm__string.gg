struct Inner:
    String f
struct Outer:
    Inner i
equip Outer:
    String getf(&self):
        return self.i.f
void main():
    String __p = "ab"
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    String c = o.getf()
    match 1:
        case 1:
            o.i.f.push("Z")
        else:
            pass
    print(c)
