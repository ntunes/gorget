String mk(String a, String b):
    return a + b


# Ch5+Ch9: `??` supplies a default when the lookup misses.
# Expected: 30 / 0
void main():
    Dict[String, int] ages = Dict[String, int]()
    ages.put(mk("Al", "ice"), 30)
    int a = ages.get("Alice") ?? 0
    int b = ages.get("Eve") ?? 0
    print(f"{a}")
    print(f"{b}")
