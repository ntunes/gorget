# std.datetime decomposes an epoch integer into calendar fields. Epoch 0 in UTC
# is 1970-01-01T00:00:00 by definition -- a fixed, checkable answer.
# Expected: 1970 / 1 / 1
from std.datetime import __dt_decompose

void main():
    Vector[int] parts = __dt_decompose(0, true)
    print(f"{parts.get(0).unwrap()}")
    print(f"{parts.get(1).unwrap()}")
    print(f"{parts.get(2).unwrap()}")
