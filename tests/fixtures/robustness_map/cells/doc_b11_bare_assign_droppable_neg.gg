# docs/book/11-ownership.md:99 § "When `!` is still required" (verbatim; the
# doc spells the drop receiver `^self` here and `!self` at :24)
# The doc says `R b = a` is a COMPILE ERROR. Expected: REJECTED.
struct R:
    int id

equip R with Drop:
    void drop(^self):
        print(f"drop {self.id}")

void main():
    R a = R(1)
    R b = a            # COMPILE ERROR: would run R's drop twice
    print(f"{b.id}")
