String mk(String a, String b):
    return a + b


# Classic: palindrome check on RUNTIME-BUILT strings.
# Expected: true / false
bool is_palindrome(String s):
    int n = s.len()
    for i in 0..n / 2:
        if s[i] != s[n - 1 - i]:
            return false
    return true

void main():
    bool a = is_palindrome(mk("ra", "cecar"))
    bool b = is_palindrome(mk("hel", "lo"))
    print(f"{a}")
    print(f"{b}")
