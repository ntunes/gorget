String mk(String a, String b):
    return a + b


# Classic: count the vowels in a RUNTIME-BUILT string.
# Expected: 3
void main():
    String s = mk("prog", "ramming")
    int count = 0
    for ch in s:
        if ch == "a" or ch == "e" or ch == "i" or ch == "o" or ch == "u":
            count += 1
    print(f"{count}")
