# Ch7: Comparable enables < and > via compare().
# Expected: true / false
struct Money:
    int cents

equip Money with Comparable:
    int compare(self, Money other):
        if self.cents < other.cents:
            return -1
        elif self.cents > other.cents:
            return 1
        return 0

void main():
    Money a = Money(100)
    Money b = Money(250)
    print(f"{a < b}")
    print(f"{a > b}")
