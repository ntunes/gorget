struct Store:
    Vector[String] f
equip Store:
    Vector[String] getf(&self):
        return self.f
void main():
    Vector[String] __p = ["aa", "bb"]
    Store s = Store(__p)
    Vector[String] c = s.getf()
    if 1 == 2:
        pass
    elif 1 == 1:
        s.f.set(0, "ZZ")
    print(c.get(0).unwrap())
