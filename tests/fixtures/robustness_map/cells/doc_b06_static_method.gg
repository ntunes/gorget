# docs/book/06-structs-enums.md:89 § "Static Methods" (verbatim, prints added)
# Expected: 0.000000 / 0.000000
struct Point:
    float x
    float y

equip Point:
    static Point origin():
        return Point(0.0, 0.0)

void main():
    Point o = Point.origin()
    print(f"{o.x}")
    print(f"{o.y}")
