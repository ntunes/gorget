# Ch10: `throws` sugar — a throwing function, caught at the call site.
# Expected: 5 / -1
int parse_positive(int n) throws String:
    if n < 0:
        throw "negative"
    return n

void main():
    int a = parse_positive(5)! catch (e): -1
    print(f"{a}")
    int b = parse_positive(-3)! catch (e): -1
    print(f"{b}")
