struct Store:
    Dict[String,int] f
equip Store:
    Dict[String,int] getf(&self):
        return self.f
void main():
    Dict[String,int] __p = {"k": 10}
    Store s = Store(__p)
    Dict[String,int] c = s.getf()
    Vector[int] __xs = [1]
    for __x in __xs:
        s.f.put("k2", 777)
    print(f"{c.len()}")
