# Classic: prime check + print primes below 20.
# Expected: 2 3 5 7 11 13 17 19
bool is_prime(int n):
    if n < 2:
        return false
    int i = 2
    while i * i <= n:
        if n % i == 0:
            return false
        i += 1
    return true

void main():
    for n in 0..20:
        if is_prime(n):
            print(f"{n}")
