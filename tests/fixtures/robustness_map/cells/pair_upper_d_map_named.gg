String mk(String a, String b):
    return a + b


# pair:upper_strings (d) .map with a NAMED function. Expected: ALPHA/BETA
String shout(String s): s.to_upper()

void main():
    Vector[String] v = Vector[String]()
    v.push(mk("al", "pha"))
    v.push(mk("be", "ta"))
    Vector[String] out = v.map(shout)
    print(out[0])
    print(out[1])
