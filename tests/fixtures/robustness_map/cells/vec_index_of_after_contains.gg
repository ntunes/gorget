# Ch5: check membership, then ask WHERE — the two-step beginner shape.
# Expected: true / 1
void main():
    Vector[int] v = [10, 20, 30]
    bool has = v.contains(20)
    print(f"{has}")
    match v.index_of(20):
        case Some(i):
            print(f"{i}")
        case None:
            print("missing")
