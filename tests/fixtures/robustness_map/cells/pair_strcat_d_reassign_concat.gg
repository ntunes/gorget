String mk(String a, String b):
    return a + b


# pair:strcat (d) `out = out + p` rather than `+=`. Expected: abc
void main():
    Vector[String] parts = Vector[String]()
    parts.push(mk("", "a"))
    parts.push(mk("", "b"))
    parts.push(mk("", "c"))
    String out = ""
    for p in parts:
        out = out + p
    print(out)
