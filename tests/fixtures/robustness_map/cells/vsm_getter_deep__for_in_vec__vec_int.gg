struct Inner:
    Vector[int] f
struct Outer:
    Inner i
equip Outer:
    Vector[int] getf(&self):
        return self.i.f
void main():
    Vector[int] __p = [10, 20]
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    Vector[int] c = o.getf()
    Vector[int] __xs = [1]
    for __x in __xs:
        o.i.f.set(0, 777)
    print(f"{c.get(0).unwrap()}")
