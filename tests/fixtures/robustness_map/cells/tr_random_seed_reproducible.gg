# std.random: seeding is the whole contract. The same seed must produce the same
# sequence, or nothing built on it is reproducible.
# Expected: true / true
from std.random import rand, seed

void main():
    seed(42)
    int a1 = rand()
    int a2 = rand()
    seed(42)
    int b1 = rand()
    int b2 = rand()
    print(f"{a1 == b1}")
    print(f"{a2 == b2}")
