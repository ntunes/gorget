# docs/book/06-structs-enums.md:67 § "Mutable Methods" (verbatim)
# Expected: 2   (the doc's own annotation)
struct Counter:
    int value

equip Counter:
    void increment(&self):
        self.value += 1

    int get(self):
        return self.value

void main():
    Counter c = Counter(0)
    c.increment()
    c.increment()
    print(f"{c.get()}")    # 2
