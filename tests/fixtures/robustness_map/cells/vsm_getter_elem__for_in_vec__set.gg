struct Store:
    Vector[Set[int]] f
equip Store:
    Set[int] getf(&self):
        return self.f.get(0).unwrap()
void main():
    Vector[Set[int]] __p = [{10}]
    Store s = Store(__p)
    Set[int] c = s.getf()
    Vector[int] __xs = [1]
    for __x in __xs:
        s.f.get(0).unwrap().add(777)
    print(f"{c.len()}")
