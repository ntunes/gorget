# docs/language-design.md:2605 § "Stdlib Design: Option Over Panic" -- the Option
# half alone (no `??`), so it is not masked by the default-operator cell.
# Expected: true / 20
void main():
    Vector[int] v = [10, 20, 30]
    Option[int] x = v.get(5)            # None (not a panic)
    int y = v.get(1).unwrap()           # 20
    print(f"{x.is_none()}")
    print(f"{y}")
