String mk(String a, String b):
    return a + b


# pair:dict_count (b) contains() then subscript. Expected: a=2 / b=1
void main():
    Vector[String] ws = Vector[String]()
    ws.push(mk("", "a"))
    ws.push(mk("", "b"))
    ws.push(mk("", "a"))
    Dict[String, int] c = Dict[String, int]()
    for w in ws:
        if c.contains(w):
            c[w] = c[w] + 1
        else:
            c[w] = 1
    for k, v in c:
        print(f"{k}={v}")
