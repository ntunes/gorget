struct Store:
    Vector[Vector[int]] f
void main():
    Vector[Vector[int]] __p = [[10], [20]]
    Store s = Store(__p)
    Vector[Vector[int]] c = s.f
    int __w = 0
    while __w < 1:
        c.set(0, [777])
        __w += 1
    print(f"{s.f.get(0).unwrap().get(0).unwrap()}")
    print(f"{c.get(0).unwrap().get(0).unwrap()}")
