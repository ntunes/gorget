# docs/book/05-collections.md:238 § "Iteration with Adapters" -- count / collect / fold.
# fold(1, acc*x) over [10,20,30,40,50] = 12000000.
# Expected: 5 / 3 / 12000000
void main():
    Vector[int] v = [10, 20, 30, 40, 50]
    int n          = v.iter().count()                    # 5
    Vector[int] xs = v.iter().take(3).collect()          # [10, 20, 30]
    int folded     = v.iter().fold(1, (acc, x): acc * x) # product via fold
    print(f"{n}")
    print(f"{xs.len()}")
    print(f"{folded}")
