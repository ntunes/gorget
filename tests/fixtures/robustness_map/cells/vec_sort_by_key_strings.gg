String mk(String a, String b):
    return a + b


# Ch5: sort_by_key on RUNTIME-BUILT strings — minimal form.
# Expected: fig / apple
void main():
    Vector[String] words = Vector[String]()
    words.push(mk("ap", "ple"))
    words.push(mk("f", "ig"))
    words.sort_by_key((s): s.len())
    for w in words:
        print(w)
