String mk(String a, String b):
    return a + b


# Ch5: contains / remove.
# Expected: true / false / 30 / 0
void main():
    Dict[String, int] ages = Dict[String, int]()
    ages.put(mk("Al", "ice"), 30)
    bool has = ages.contains("Alice")
    bool no = ages.contains("Eve")
    print(f"{has}")
    print(f"{no}")
    print(f"{ages.remove("Alice").unwrap()}")
    print(f"{ages.len()}")
