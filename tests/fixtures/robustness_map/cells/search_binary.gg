# Classic exercise: binary search over a sorted vector.
# Expected: 3 / -1
int binary_search(Vector[int] v, int target):
    int lo = 0
    int hi = v.len() - 1
    while lo <= hi:
        int mid = (lo + hi) / 2
        if v[mid] == target:
            return mid
        elif v[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

void main():
    Vector[int] v = [1, 3, 5, 7, 9]
    print(f"{binary_search(v, 7)}")
    print(f"{binary_search(v, 4)}")
