String mk(String a, String b):
    return a + b


# pair:joinwords (c) fold. Expected: alpha-beta-gamma
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("al", "pha"))
    v.push(mk("be", "ta"))
    v.push(mk("gam", "ma"))
    String out = v[0]
    Vector[String] rest = v[1:3]
    for s in rest:
        out = out + "-" + s
    print(out)
