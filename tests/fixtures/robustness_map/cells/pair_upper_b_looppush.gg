String mk(String a, String b):
    return a + b


# pair:upper_strings (b) explicit loop and push. Expected: ALPHA/BETA
void main():
    Vector[String] v = Vector[String]()
    v.push(mk("al", "pha"))
    v.push(mk("be", "ta"))
    Vector[String] out = Vector[String]()
    for s in v:
        out.push(s.to_upper())
    print(out[0])
    print(out[1])
