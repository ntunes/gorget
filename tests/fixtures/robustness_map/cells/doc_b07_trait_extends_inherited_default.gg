# docs/book/07-traits.md:152 § "Trait Inheritance" (verbatim, calls added)
# Thing(42): doubled() = 84, extra() = 142.
# Expected: 84 / 142
trait Base:
    int value(self)
    int doubled(self):
        return self.value() * 2

trait Extended extends Base:
    int extra(self)

struct Thing:
    int x

equip Thing with Extended:
    int value(self):
        return self.x
    int extra(self):
        return self.x + 100
    # doubled() inherited from Base - returns self.value() * 2

void main():
    Thing t = Thing(42)
    print(f"{t.doubled()}")
    print(f"{t.extra()}")
