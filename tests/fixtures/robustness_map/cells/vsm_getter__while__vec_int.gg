struct Store:
    Vector[int] f
equip Store:
    Vector[int] getf(&self):
        return self.f
void main():
    Vector[int] __p = [10, 20]
    Store s = Store(__p)
    Vector[int] c = s.getf()
    int __w = 0
    while __w < 1:
        s.f.set(0, 777)
        __w += 1
    print(f"{c.get(0).unwrap()}")
