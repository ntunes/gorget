String mk(String a, String b):
    return a + b


# Classic: total a cart of items (companion to ex_shopping_cart, which
# names the loop variable `it` and hits a reserved word).
# Expected: apple x2 = 300 / bread x1 = 250 / total 550
struct Item:
    String name
    int price
    int qty

void main():
    Vector[Item] cart = Vector[Item]()
    cart.push(Item(mk("ap", "ple"), 150, 2))
    cart.push(Item(mk("bre", "ad"), 250, 1))
    int total = 0
    for entry in cart:
        int line = entry.price * entry.qty
        total += line
        print(f"{entry.name} x{entry.qty} = {line}")
    print(f"total {total}")
