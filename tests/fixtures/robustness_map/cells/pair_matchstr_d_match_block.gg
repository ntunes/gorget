String mk(String a, String b):
    return a + b


# pair:matchstr (d) match statement, block arms. Expected: greeting
void main():
    String s = mk("hel", "lo")
    String kind = "other"
    match s:
        case "hello":
            kind = "greeting"
        case "bye":
            kind = "farewell"
        else:
            kind = "other"
    print(kind)
