String mk(String a, String b):
    return a + b


# Classic exercise: count occurrences into a dict (the get-or-zero idiom).
# Expected: a=2 / b=1
void main():
    Vector[String] words = Vector[String]()
    words.push(mk("", "a"))
    words.push(mk("", "b"))
    words.push(mk("", "a"))
    Dict[String, int] counts = Dict[String, int]()
    for w in words:
        int c = counts.get(w) ?? 0
        counts.put(w, c + 1)
    for k, v in counts:
        print(f"{k}={v}")
