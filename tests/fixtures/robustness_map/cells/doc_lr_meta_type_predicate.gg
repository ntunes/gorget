# docs/language-reference.md:6272 § "19.14 Type Predicate `T is Category`" (verbatim shape)
# Expected: 5 / 5.000000   (both clamp 9 into [0, 5])
T clamp_to[T](T val, T lo, T hi):
    meta if T is float:
        if val > hi:
            return hi
        if val < lo:
            return lo
        return val
    else:
        if val > hi:
            return hi
        if val < lo:
            return lo
        return val

void main():
    print(f"{clamp_to[int](9, 0, 5)}")
    print(f"{clamp_to[float](9.0, 0.0, 5.0)}")
