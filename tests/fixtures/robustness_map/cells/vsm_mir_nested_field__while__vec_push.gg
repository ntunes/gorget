struct Inner:
    Vector[int] f
struct Outer:
    Inner i
void main():
    Vector[int] __p = [10, 20]
    Inner __in = Inner(__p)
    Outer o = Outer(__in)
    Vector[int] c = o.i.f
    int __w = 0
    while __w < 1:
        c.push(777)
        __w += 1
    print(f"{o.i.f.len()}")
    print(f"{c.len()}")
