String mk(String a, String b):
    return a + b


# Ch7: `equip Outer with Showable via inner` -- no block.
# Expected: inner-label
trait Showable:
    String show(self)

struct Inner:
    String label

equip Inner with Showable:
    String show(self):
        return self.label

struct Outer:
    Inner inner

equip Outer with Showable via inner

void main():
    Outer o = Outer(Inner(mk("inner", "-label")))
    print(o.show())
