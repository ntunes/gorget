bool set_in_nested_branch(int limit):
    bool found = false
    int i = 0
    while i < limit:
        if i == 3:
            found = true
        i += 1
    return found

void main():
    bool a = set_in_nested_branch(5)
    bool b = set_in_nested_branch(2)
    if a:
        print("a: yes")
    else:
        print("a: no")
    if b:
        print("b: yes")
    else:
        print("b: no")
