from xtd.tensor import Tensor, tensor_zeros, tensor_ones, tensor_arange, tensor_from, tensor_display, tensor_linspace, vec_int_copy, tensor_compute_strides

void main():
    # 1D int tensor from arange [0..6)
    Tensor[int] a = tensor_arange(0, 6)
    print(tensor_display[int](a))

    # Reshape to 2x3
    Vector[int] shape2d = Vector[int]()
    shape2d.push(2)
    shape2d.push(3)
    Tensor[int] c = a.reshape(shape2d)
    print(tensor_display[int](c))

    # Element access via at
    Vector[int] idx = Vector[int]()
    idx.push(0)
    idx.push(2)
    print(f"{c.at(idx)}")

    # zeros and ones
    Vector[int] sh = Vector[int]()
    sh.push(3)
    Tensor[int] z = tensor_zeros[int](sh)
    print(tensor_display[int](z))
    Tensor[int] o = tensor_ones[int](sh)
    print(tensor_display[int](o))

    # size and ndim
    print(f"{c.size()}")
    print(f"{c.ndim()}")

    # linspace float
    Tensor[float] ls = tensor_linspace(0.0, 1.0, 5)
    print(f"{ls.size()}")
    print(f"{ls.ndim()}")

    # set_at
    Vector[int] idx2 = Vector[int]()
    idx2.push(1)
    idx2.push(1)
    c.set_at(idx2, 99)
    print(f"{c.at(idx2)}")
