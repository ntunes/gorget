from gg.tensor import Tensor, tensor_zeros_int, tensor_ones_int, tensor_arange, tensor_from_int, tensor_display_int, tensor_zeros_float, tensor_linspace, tensor_display_float, vec_int_copy, tensor_compute_strides

void main():
    # 1D int tensor from arange [0..6)
    Tensor[int] a = tensor_arange(0, 6)
    print(tensor_display_int(a))

    # Reshape to 2x3
    Vector[int] shape2d = Vector[int]()
    shape2d.push(2)
    shape2d.push(3)
    Tensor[int] c = a.reshape(shape2d)
    print(tensor_display_int(c))

    # Element access via at
    Vector[int] idx = Vector[int]()
    idx.push(0)
    idx.push(2)
    print("{c.at(idx)}")

    # zeros and ones
    Vector[int] sh = Vector[int]()
    sh.push(3)
    Tensor[int] z = tensor_zeros_int(sh)
    print(tensor_display_int(z))
    Tensor[int] o = tensor_ones_int(sh)
    print(tensor_display_int(o))

    # size and ndim
    print("{c.size()}")
    print("{c.ndim()}")

    # linspace float
    Tensor[float] ls = tensor_linspace(0.0, 1.0, 5)
    print("{ls.size()}")
    print("{ls.ndim()}")

    # set_at
    Vector[int] idx2 = Vector[int]()
    idx2.push(1)
    idx2.push(1)
    c.set_at(idx2, 99)
    print("{c.at(idx2)}")
