# R39 Phase 2e per-shape regression fixture (Core #12 axis coverage) —
# cell: BRACKET terminator × generic type args (parse_type_args).
# RED-verifies the trailing-comma-cascade fix.  Uses many type params
# with long names so `gg fmt --in-place` keeps the type-args list in
# its multi-line form with the trailing comma preserved (fixture is
# stable under formatter canonicalization).
struct Quintuple[
    LongTypeArgAlpha,
    LongTypeArgBeta,
    LongTypeArgGamma,
    LongTypeArgDelta,
    LongTypeArgEpsilon,
]:
    LongTypeArgAlpha first
    LongTypeArgBeta second
    LongTypeArgGamma third
    LongTypeArgDelta fourth
    LongTypeArgEpsilon fifth

void main():
    Quintuple[int, int, int, int, int] v = Quintuple[int, int, int, int, int](10, 20, 30, 40, 50)
    print(f"{v.first} {v.second} {v.third} {v.fourth} {v.fifth}")
