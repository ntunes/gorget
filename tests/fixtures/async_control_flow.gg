async int double(int x):
    return x * 2

async int sum_loop(int n):
    int total = 0
    int i = 0
    while i < n:
        int val = await double(i)
        total = total + val
        i = i + 1
    return total

async int pick(bool flag, int a, int b):
    if flag:
        int va = await double(a)
        return va
    else:
        int vb = await double(b)
        return vb

async int even_sum(int n):
    int total = 0
    int i = 0
    while i < n:
        if i % 2 == 0:
            int val = await double(i)
            total = total + val
        i = i + 1
    return total

async void main():
    int s = await sum_loop(5)
    print(s)
    int p1 = await pick(true, 3, 7)
    print(p1)
    int p2 = await pick(false, 3, 7)
    print(p2)
    int e = await even_sum(6)
    print(e)
