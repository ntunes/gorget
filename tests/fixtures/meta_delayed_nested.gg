String describe[T]():
    meta if typename(T) == "int":
        meta if sizeof(T) == 8:
            return "int64"
        else:
            return "small-int"
    elif typename(T) == "float":
        meta if sizeof(T) == 8:
            return "float64"
        else:
            return "small-float"
    else:
        return "other"

void multi_branch[T]():
    meta if typename(T) == "int":
        print("is int")
        meta if sizeof(T) == 8:
            print("8 bytes")
        else:
            print("not 8 bytes")
    elif typename(T) == "String":
        print("is str")
        meta if sizeof(T) == 32:
            print("32 bytes")
        else:
            print("not 16 bytes")
    else:
        print("other type")

void main():
    String r1 = describe[int]()
    String r2 = describe[float]()
    String r3 = describe[bool]()
    print(f"{r1}")
    print(f"{r2}")
    print(f"{r3}")
    multi_branch[int]()
    multi_branch[String]()
    multi_branch[bool]()
