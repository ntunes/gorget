str describe[T]():
    meta if typename(T) == "int":
        meta if sizeof(T) == 8:
            return "int64"
        else:
            return "small-int"
    elif typename(T) == "float":
        meta if sizeof(T) == 8:
            return "float64"
        else:
            return "small-float"
    else:
        return "other"

void multi_branch[T]():
    meta if typename(T) == "int":
        print("is int")
        meta if sizeof(T) == 8:
            print("8 bytes")
        else:
            print("not 8 bytes")
    elif typename(T) == "str":
        print("is str")
        meta if sizeof(T) == 16:
            print("16 bytes")
        else:
            print("not 16 bytes")
    else:
        print("other type")

void main():
    str r1 = describe[int]()
    str r2 = describe[float]()
    str r3 = describe[bool]()
    print("{r1}")
    print("{r2}")
    print("{r3}")
    multi_branch[int]()
    multi_branch[str]()
    multi_branch[bool]()
