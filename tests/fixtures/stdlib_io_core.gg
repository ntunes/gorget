# Exercises std.io_core — the byte-shaped Writer trait + typed IoError.
#
# Phase 3 of the stdlib narrow-waist. A user-defined Sink satisfies
# Writer; write_all and write_display are generic free functions so the
# same helpers compose over any concrete Writer without trait-object
# dispatch.

from std.io_core import Writer, IoError, write_all, write_display

struct Sink:
    String buf

equip Sink with Writer:
    Result[int, IoError] write_bytes(&self, String bytes):
        self.buf.push(bytes)
        return Ok(bytes.len())

int main():
    # Direct Writer.write_bytes on the Sink.
    Sink s = Sink("")
    Result[int, IoError] r = s.write_bytes("hello ")
    match r:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s.buf)

    # Generic write_all with short-write loop (Sink is eager, so this
    # just exercises the Ok path through the loop).
    Sink s2 = Sink("")
    Result[int, IoError] r2 = write_all[Sink](&s2, "world")
    match r2:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s2.buf)

    # write_display routes through Displayable.display().
    Sink s3 = Sink("")
    Result[int, IoError] r3 = write_display[Sink, int](&s3, 42)
    match r3:
        case Ok(n):
            print(n)
        case Error(e):
            print(e.display())
    print(s3.buf)

    # IoError Displayable surface.
    print(IoError.NotFound().display())
    print(IoError.Utf8Invalid(7).display())
    print(IoError.Other("disk full").display())
    return 0
