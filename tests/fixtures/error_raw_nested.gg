String safe_divide(int a, int b) throws String:
    if b == 0:
        throw "division by zero"
    return f"{a / b}"

void main():
    Result[String, String] r1 = safe_divide(10, 2)
    Result[String, String] r2 = safe_divide(10, 0)
    match r1:
        case Ok(v): print(v)
        case Error(e): print(e)
    match r2:
        case Ok(v): print(v)
        case Error(e): print(e)
