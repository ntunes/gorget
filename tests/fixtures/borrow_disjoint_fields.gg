# Test borrowing different struct fields independently
struct Pair:
    int x
    int y

void main():
    Pair p = Pair(10, 20)

    # Access different fields — no conflict
    int a = p.x
    int b = p.y
    print(f"{a}")
    print(f"{b}")

    # Use both fields in expressions
    int sum = p.x + p.y
    print(f"{sum}")

    # Use field multiple times
    int doubled = p.x + p.x
    print(f"{doubled}")

    print("done")
