# Fault-catch binding form: `catch f: match f` binds the constructed Fault
# value so the handler reads which fault occurred (error-model.md §11.2).
void main():
    int big = 9223372036854775807
    int r = (big * 2) catch f: match f:
        case Fault.Overflow(): 111
        case Fault.DivByZero(): 222
    print(f"{r}")
    int z = 0
    int d = (10 / z) catch f: match f:
        case Fault.Overflow(): 111
        case Fault.DivByZero(): 222
    print(f"{d}")
