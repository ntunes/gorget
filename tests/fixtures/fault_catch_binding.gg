# Post-D25: match on the ArithError variant via D26 `*!` and `/!`. Axis: D26
# error-variant binding stands in for the removed fault-catch binding form.
void main():
    int big = 9223372036854775807
    Result[int, ArithError] r = big *! 2
    match r:
        case Ok(_):                        print("0")
        case Error(ArithError.Overflow):   print("111")
        case Error(ArithError.DivByZero):  print("222")
    int z = 0
    Result[int, ArithError] d = 10 /! z
    match d:
        case Ok(_):                        print("0")
        case Error(ArithError.Overflow):   print("111")
        case Error(ArithError.DivByZero):  print("222")
