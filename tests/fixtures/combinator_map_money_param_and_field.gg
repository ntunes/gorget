# CELL: `.map()` × {bare-param, field-access, plain-local} × Option[Money]
# GRADUATED Round XIV (74f566c6) — combinator-receiver ownership class-fix at
# producer `try_lower_option_result_combinator` (Edits A + B).
# PRE-FIX (RED-verified at HEAD 6171d564, C and LLVM byte-identical):
#   bare-param receiver   `p.map(...)`      then read `p`  -> 10 then **0**  (want 10 then 10)
#   field-access receiver `h.slot.map(...)` then read it   -> 11 then **0**  (want 11 then 11)
#   plain-local receiver  (the loop below)                 -> 39 then 13     PASS (live control)
# The plain-local row was and is a live control — it passes today and must keep
# passing; it is also why this went unnoticed for months: a plain-local receiver
# is the shape fixtures happened to use, and it was the one shape that worked.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.
#
# PRE-FIX MECHANISM (localized, `src/ir/lowering/exprs/methods.rs` before the
# graduating commit): the receiver-clone path was gated on
# `p.projections.is_empty()`, so a FIELD-ACCESS place was not recognised as a
# place at all and fell to the `else` branch commented "Non-place operand
# (constants, etc.) — Copy is safe" (FALSE for a field place). The bare-param
# row took the adjacent "no clone fn registered — fall back to plain Copy"
# branch, whose own comment conceded "validator may flag". The class-fix at
# 74f566c6 unifies materialization across all place shapes and unwraps the Ptr
# for bare-borrow parameter recvs (Edits A + B).
#
# INTENDED (what this fixture asserts):
#     10 / 10 / param-end / 11 / 11 / field-end / 39 / 13 / loop-end
#
# ORACLE: ggdef subset extended by Round XIV (Increment B3) to cover the
# combinator family; if this fixture lands in-subset, corpus_b adjudicates it.
#
# The payloads are HEAP-FORCED (a built `Vector[int]`, not a literal), so the
# emptying is observable rather than const-folded away.

struct Money:
    Vector[int] cents

struct Holder:
    Option[Money] slot

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

# BROKEN CELL 1 — bare (borrow) param receiver, read back after the combinator.
void via_param(Option[Money] p):
    Option[int] r = p.map((Money m): size_of(m))
    if r is Some(v):
        print(v)
    if p is Some(m2):
        print(size_of(m2))
    print("param-end")

# BROKEN CELL 2 — field-access receiver, read back after the combinator.
void via_field():
    Holder h = Holder(make_opt(11))
    Option[int] r = h.slot.map((Money m): size_of(m))
    if r is Some(v):
        print(v)
    if h.slot is Some(m2):
        print(size_of(m2))
    print("field-end")

# LIVE CONTROL — plain-local receiver, combinator'd repeatedly. Correct today.
void via_loop():
    Option[Money] o = make_opt(13)
    int i = 0
    int acc = 0
    while i < 3:
        Option[int] r = o.map((Money m): size_of(m))
        if r is Some(v):
            acc = acc + v
        i = i + 1
    print(acc)
    if o is Some(m2):
        print(size_of(m2))
    print("loop-end")

void main():
    via_param(make_opt(10))
    via_field()
    via_loop()
