# Test: stale-condition warning in match scrutinee.
# Reading a shared variable into a local before an await, then using
# the local as a match scrutinee after the await, should warn.
# The warning is non-fatal — program still compiles and runs.

async void worker(int &counter):
    counter = counter + 1

async void main():
    shared int x = 0
    Task[void] t = spawn worker(&x)
    int val = x
    t.await()
    match val:
        case 0:
            print("stale match fired")
        else:
            print("updated")
    print(x)
