# `Drainable[(K, V)]` for `Dict[K, V]` — `d.drain()` consumes the
# dict and yields owned `(K, V)` pairs in insertion order.
#
# Source is unusable after drain returns; the underlying map's drop
# sees tombstoned slots for every drained entry and skips them.

from std.iter import DictDrain

int main():
    Dict[int, int] d = Dict[int, int]()
    d.put(10, 100)
    d.put(20, 200)
    d.put(30, 300)
    d.put(40, 400)

    int total_k = 0
    int total_v = 0
    for p in d.drain():
        total_k = total_k + p.0
        total_v = total_v + p.1
    print(total_k)                                  # 100
    print(total_v)                                  # 1000

    # Verify drain count matches via a fresh dict.
    Dict[int, int] d2 = Dict[int, int]()
    d2.put(1, 10)
    d2.put(2, 20)
    d2.put(3, 30)
    int n = 0
    for _ in d2.drain():
        n = n + 1
    print(n)                                        # 3

    return 0
