#!parity-excluded network: imports std.net.socket and binds/connects a real TCP socket; port + peer timing decide the
#!  output
# Test: basic async socket echo — server reads a line and echoes it back.
from std.net.socket import ServerSocket, Socket, server_socket_bind, socket_connect
from std.time import sleep

async void echo_server(ServerSocket !srv):
    Socket conn = srv.accept().unwrap()
    srv.close()
    conn.set_timeout(2000)
    String line = conn.read_line().unwrap()
    conn.write_str(line + "\n")
    conn.close()

async void main():
    ServerSocket srv = server_socket_bind("127.0.0.1", 0).unwrap()
    int port = srv.local_port()
    Task[void] server = spawn echo_server(!srv)
    sleep(0.05).await()

    Socket c = socket_connect("127.0.0.1", port).unwrap()
    c.write_str("hello\n")
    String reply = c.read_line().unwrap()
    int reply_len = reply.len()
    c.close()
    server.await()
    print(reply_len)
    print("got reply")
