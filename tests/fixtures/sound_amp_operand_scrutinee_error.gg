# Round XXIII Track β — `&`-of-a-place in a MATCH SCRUTINEE operand position.
# One costume of the operand-position class; produced by the ONE-PRODUCER
# chokepoint at the safety pass's `check_expr::Expr::MutableBorrow` arm.
#
# Pre-fix (measured at HEAD): `gg check` clean; C prints `0` (the address is
# NOT 10, so `else` runs); LLVM `llc` hard-fails with `%v8: i64 but expected
# ptr`. INTENDED: reject at `gg check` with `E_AmpInOperandPosition` — an
# operand is a READ, and `&` on a `&` parameter says "the callee writes
# through", which is meaningless in a read.
#
# Sibling graduation: `known_gaps/sound_amp_operand_position_scrutinee.gg`
# (kept in place, its test un-ignored + repointed to `check_gg_fails`).
#
# The seed is COMPUTED, not a literal, so no const-fold can elide it.

struct Counter:
    int fd

int seed():
    return 10

void main():
    Counter c = Counter(seed())
    match &c.fd:
        case 10:
            print(1)
        else:
            print(0)
