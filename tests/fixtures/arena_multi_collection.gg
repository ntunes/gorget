from std.alloc import Arena
from std.collections import Vector, Dict

void main():
    with Arena(16384) as pool:
        Vector[int] nums = Vector[int]()
        Vector[str] names = Vector[str]()
        Dict[str, int] scores = Dict[str, int]()
        nums.push(1)
        nums.push(2)
        nums.push(3)
        names.push("alice")
        names.push("bob")
        scores.put("alice", 100)
        scores.put("bob", 95)
        print("nums: {nums.len()}")
        print("names: {names.len()}")
        print("scores: {scores.len()}")
        print("alice: {scores.get("alice").unwrap()}")
        print("bytes_used > 0: {pool.bytes_used() > 0}")
    print("done")
