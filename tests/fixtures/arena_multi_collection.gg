from std.alloc import Arena
from std.collections import Vector, Dict

void main():
    with Arena(16384) as pool:
        Vector[int] nums = Vector[int]()
        Vector[String] names = Vector[String]()
        Dict[String, int] scores = Dict[String, int]()
        nums.push(1)
        nums.push(2)
        nums.push(3)
        names.push("alice")
        names.push("bob")
        scores.put("alice", 100)
        scores.put("bob", 95)
        print(f"nums: {nums.len()}")
        print(f"names: {names.len()}")
        print(f"scores: {scores.len()}")
        print(f"alice: {scores.get("alice").unwrap()}")
        print(f"bytes_used > 0: {pool.bytes_used() > 0}")
    print("done")
