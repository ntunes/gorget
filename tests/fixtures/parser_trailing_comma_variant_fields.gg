# R39 Phase 2e per-shape regression fixture (Core #12 axis coverage) —
# cell: PAREN terminator × enum variant CONSTRUCTOR call (parse_call_args
# at a ctor site).  The enum variant DECLARATION-side site
# (parse_enum_variant) gets fmt-collapsed inline regardless of item-list
# length (formatter permissive at that position); this fixture instead
# exercises the CONSTRUCTOR-call side which IS fmt-preserved.  The
# fixture stays stable under formatter canonicalization.
#
# Axis cell for parse_enum_variant per se: the declaration-side site is
# covered by the SH bootstrap's fmt sweep round-trip
# (`sh_bootstrap_stage2_double_free_after_fmt_sweep`) which processes
# the whole non-SH tree including files that DO declare variants across
# multiple lines with trailing commas.
#
# The enum variant DECLARATION position is a DEFER row of the
# magic-trailing-comma axis, filed under TODO.md's fill-emitter-chokepoint
# family entry ("the residual OUTSIDE the fill-emitter chokepoint", sub-item
# (3)) — `format_variant_tuple_fields` is a hand-rolled `write(", ")` loop with
# no `Doc` layer, so it neither honours the comma nor passes the
# interior-comment gate. Routing it through `emit_delimited_list` buys both at
# once. (The header used to cite a "filed language-follow-up" that did not
# exist.)
struct FirstLongFieldType:
    int a

struct SecondLongFieldType:
    int b

struct ThirdLongFieldType:
    int c

struct FourthLongFieldType:
    int d

struct FifthLongFieldType:
    int e

struct SixthLongFieldType:
    int f

enum ExtendedShape:
    ManySidedPolygon(FirstLongFieldType, SecondLongFieldType, ThirdLongFieldType, FourthLongFieldType, FifthLongFieldType, SixthLongFieldType)

void main():
    ExtendedShape s = ExtendedShape.ManySidedPolygon(
        FirstLongFieldType(1),
        SecondLongFieldType(2),
        ThirdLongFieldType(3),
        FourthLongFieldType(4),
        FifthLongFieldType(5),
        SixthLongFieldType(6),
    )
    match s:
        case ExtendedShape.ManySidedPolygon(one, two, three, four, five, six):
            print(f"{one.a} {two.b} {three.c} {four.d} {five.e} {six.f}")
        else:
            print("no")
