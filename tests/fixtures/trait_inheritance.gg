trait Named:
    String name(self)

trait Greeter extends Named:
    String greet(self)

struct Person:
    String first_name

equip Person with Greeter:
    String name(self):
        return self.first_name
    String greet(self):
        return "hi"

void main():
    Person p = Person("Alice")
    String n = p.name()
    String g = p.greet()
    print(n)
    print(g)
