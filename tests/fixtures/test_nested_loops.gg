void main():
    # 1. Nested for-for: multiplication table fragment (2x3)
    for i in 1..3:
        for j in 1..4:
            print(i * j)

    # 2. For inside while
    int w = 0
    while w < 3:
        int row_sum = 0
        for k in 0..3:
            row_sum = row_sum + k
        print(row_sum)
        w = w + 1

    # 3. While inside for
    for i in 0..3:
        int n = i
        int steps = 0
        while n > 0:
            n = n - 1
            steps = steps + 1
        print(steps)

    # 4. Triple-nested for
    int count3 = 0
    for a in 0..2:
        for b in 0..3:
            for c in 0..4:
                count3 = count3 + 1
    print(count3)

    # 5. Break from inner loop only
    for i in 0..3:
        int stopped = -1
        for j in 0..10:
            if j == 2:
                stopped = j
                break
        print(stopped)

    # 6. Continue in inner loop
    for i in 0..3:
        int inner_sum = 0
        for j in 0..5:
            if j % 2 == 0:
                continue
            inner_sum = inner_sum + j
        print(inner_sum)

    # 7. Nested loops with collections
    Vector[int] xs = Vector[int]()
    xs.push(1)
    xs.push(2)
    Vector[int] ys = Vector[int]()
    ys.push(10)
    ys.push(20)
    ys.push(30)
    for x in xs:
        for y in ys:
            print(x + y)

    # 8. Accumulator across nested loops
    int total = 0
    for i in 0..4:
        for j in 0..4:
            total = total + 1
    print(total)

    # 9. Early exit from outer loop with flag variable
    bool done = false
    int outer_count = 0
    for i in 0..100:
        if done:
            break
        for j in 0..100:
            if i == 2 and j == 3:
                done = true
                break
        outer_count = outer_count + 1
    print(outer_count)
