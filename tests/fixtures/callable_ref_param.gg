struct Counter:
    int value

equip Counter:
    void increment(&self):
        self.value = self.value + 1

    int get(self):
        return self.value

int with_counter(Callable[int(&Counter)] f, Counter &c):
    return f(&c)

int bump_and_read(Counter &c):
    c.increment()
    return c.get()

void main():
    Counter c = Counter(0)
    int r1 = with_counter(bump_and_read, &c)
    print(f"{r1}")
    int r2 = with_counter(bump_and_read, &c)
    print(f"{r2}")
    print(f"{c.get()}")
    print("done")
