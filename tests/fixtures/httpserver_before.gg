#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; its own header says pre-dispatch middleware only; no socket
#!  module is imported
# Test: Pre-dispatch middleware (router.before()) — short-circuit and ordering.
#
# Validates:
#   1. before() hook returning Some() short-circuits the handler → 401
#   2. Normal request (before() returns None()) reaches handler → 200
#   3. Post-dispatch middleware still runs on short-circuit response
#      (adds X-Logged header to ALL responses including 401s)
#   4. Multiple before hooks: first matching Some() wins
#   5. Second before hook only runs when first returns None()
#
# Expected output:
#   ok\nok\nok\nok\nok

from xtd.httpserver import Router, HttpRequest, HttpServerResponse
from std.collections import Dict

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

HttpServerResponse handle_hello(HttpRequest req):
    return HttpServerResponse.ok("hello")

# Pre-middleware: reject /admin paths with 401
Option[HttpServerResponse] auth_guard(HttpRequest req):
    if req.path.starts_with("/admin"):
        return Some(HttpServerResponse(401, "Unauthorized", "text/plain", Dict[String, String]()))
    return None()

# Pre-middleware 2: reject /blocked path
Option[HttpServerResponse] block_guard(HttpRequest req):
    if req.path == "/blocked":
        return Some(HttpServerResponse(403, "Forbidden", "text/plain", Dict[String, String]()))
    return None()

# Post-middleware: add X-Logged header to all responses
HttpServerResponse logging_mw(HttpRequest req, HttpServerResponse resp):
    return resp.with_header("X-Logged", "yes")

void main():
    Router router = Router.new()
    router.get("/hello", handle_hello)
    router.get("/admin/secret", handle_hello)
    router.get("/blocked", handle_hello)

    router.before(auth_guard)
    router.before(block_guard)
    router.use(logging_mw)

    # 1. /admin path → auth_guard returns Some(401), handler never called
    HttpRequest req1 = HttpRequest("GET", "/admin/secret", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r1 = router.dispatch(req1)
    check("admin_blocked", r1.status_code == 401)

    # 2. Normal path → before() returns None(), handler runs → 200
    HttpRequest req2 = HttpRequest("GET", "/hello", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r2 = router.dispatch(req2)
    check("hello_ok", r2.status_code == 200)

    # 3. Post-middleware runs even on short-circuit: /admin response has X-Logged header
    check("admin_logged", r1.headers.contains("X-Logged"))

    # 4. /blocked path → auth_guard returns None(), block_guard returns Some(403)
    HttpRequest req3 = HttpRequest("GET", "/blocked", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r3 = router.dispatch(req3)
    check("blocked_403", r3.status_code == 403)

    # 5. Post-middleware also ran on /blocked response
    check("blocked_logged", r3.headers.contains("X-Logged"))
