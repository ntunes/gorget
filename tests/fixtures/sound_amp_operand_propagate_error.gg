# Round XXV Track C — `&`-of-a-place inside a `!` (propagate) operand.
# One costume of the operand-position class; retired by the
# ONE-PRODUCER chokepoint at the `check_expr::Expr::MutableBorrow`
# arm. Propagate reaches the chokepoint via the `Expr::Propagate`
# arm recursing through `self.check_expr(inner)`.
#
# Pre-fix (measured at HEAD via scout probe): `gg check` clean.
# INTENDED: reject at check-time with `E_AmpInOperandPosition`.
# CO-EMITS (structural, unavoidable — `check_gg_fails` substring match
# is fine): `E_MissingFallibleMark`. `!` requires its immediate inner to
# be a fallible call; a `MutableBorrow`-wrapped call is not immediately-
# recognised so the missing-mark diagnostic fires alongside the
# operand-position reject.

Result[int, int] try_it():
    return Ok(10)

int main() throws int:
    int y = (&try_it())!
    print(y)
    return 0
