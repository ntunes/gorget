# D28 T1: integer `**` overflow traps T_Overflow (D30 narrow+wide uniform).
# fn-call operands defeat const-fold's overflow reject (which would produce
# a compile-time reject rather than a runtime trap).
int million():
    return 1000000

int four():
    return 4

void main():
    int r = million() ** four()
    print(r)
