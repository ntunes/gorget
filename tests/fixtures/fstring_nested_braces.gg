# f-string edge cases with braces and complex expressions
void main():
    int x = 42
    # basic
    print(f"{x}")

    # escaped braces
    print(f"{{literal braces}}")

    # expression with operators
    print(f"{x + 8}")

    # method call in f-string
    String s = "hello"
    print(f"len={s.len()}")

    # nested f-string in concatenation
    String name = "world"
    String msg = f"hello {name}"
    print(f"msg: {msg}")

    # multiple interpolations
    int a = 10
    int b = 20
    print(f"{a} + {b} = {a + b}")

    # bool in f-string
    bool flag = true
    print(f"flag: {flag}")
