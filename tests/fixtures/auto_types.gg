struct Vec2:
    float x
    float y

equip Vec2:
    float sum(self):
        return self.x + self.y

void main():
    auto n = 42
    auto greeting = "hello"
    auto pi = 3.14
    auto flag = true
    auto ch = 'A'

    print(f"{n}")
    print(f"{greeting}")
    print(f"{pi}")
    print(f"{flag}")
    print(f"{ch}")

    auto sum = n + 8
    print(f"{sum}")

    auto msg = "world"
    print(f"{greeting} {msg}")

    const auto limit = 100
    print(f"{limit}")

    auto v = Vec2(1.0, 2.0)
    float vsum = v.sum()
    print("auto struct")

    int base = 10
    auto add_base = (int y): base + y
    int result = add_base(5)
    print(f"{result}")
    print("auto closure")
