# TryFrom[T] trait: fallible type conversion

@derive(TryFrom)
struct Celsius:
    float value

struct Percentage:
    int value

equip Percentage with TryFrom[int]:
    Result[Percentage, String] try_from(int n):
        if n < 0:
            return Error("negative")
        if n > 100:
            return Error("over 100")
        return Ok(Percentage(n))

void main():
    # Derived TryFrom (newtype, always succeeds)
    Result[Celsius, String] c = Celsius.try_from(98.6)
    match c:
        case Ok(val):
            print(val.value)
        case Error(e):
            print(e)

    # Manual equip TryFrom with validation
    Result[Percentage, String] p1 = Percentage.try_from(50)
    match p1:
        case Ok(val):
            print(val.value)
        case Error(e):
            print(e)

    Result[Percentage, String] p2 = Percentage.try_from(150)
    match p2:
        case Ok(val):
            print(val.value)
        case Error(e):
            print(e)

    Result[Percentage, String] p3 = Percentage.try_from(-5)
    match p3:
        case Ok(val):
            print(val.value)
        case Error(e):
            print(e)
