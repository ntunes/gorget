# Tests that closures with Copy captures can be spawned via spawn c().
# The closure captures an int (Copy type) by value, which is safe to send
# across thread boundaries.

async void main():
    int val = 42

    # Spawn a closure variable capturing a Copy int
    auto printer = (): print(val)
    Task[void] t = spawn printer()
    t.await()

    # Also verify direct named-function spawn still works
    Task[int] t2 = spawn compute(val)
    int result = t2.await()
    print(result)

async int compute(int x):
    return x * 10
