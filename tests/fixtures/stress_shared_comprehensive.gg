#!parity-excluded scheduling: 500 spawned writers plus async_sleep over shared state; the interleaving is the
#!  scheduler's
# Comprehensive shared variable stress test — thousands of concurrent tasks.
#
# Exercises: multi-token ordering, nested spawns, with-refresh after async_sleep,
# mixed read/write, early return, await-based token release/reacquire,
# and high-contention concurrent mutation.
#
# Architecture (1300 tasks total):
#   - 500 writer tasks: each increments both a and b 10 times = 5000 each
#   - 500 reader tasks: each reads a and b inside `with` blocks after async_sleep(0)
#   - 200 nested tasks: each spawns an inner adder adding 5 to both = 1000 each
#   - 100 conditional tasks: half write 10 to both (do_write=true), half skip
#     = 50 * 10 = 500 each
#   - Total: a = 5000 + 1000 + 500 = 6500, b = 6500
#
# Final output: "6500\n6500\ndone"

from std.async import async_sleep

# --- Writer: increment both counters n times ---
async void writer(int &a, int &b, int n):
    int i = 0
    while i < n:
        a = a + 1
        b = b + 1
        i = i + 1

# --- Reader: uses `with` to get fresh reads after async_sleep ---
async void reader(int &a, int &b):
    with a:
        with b:
            int snap_a = a
            int snap_b = b
            async_sleep(0)
            # with auto-refreshes after async_sleep
            int fresh_a = a
            int fresh_b = b

# --- Nested inner: adds n to both counters ---
async void nested_adder(int &a, int &b, int n):
    int i = 0
    while i < n:
        a = a + 1
        b = b + 1
        i = i + 1

# --- Nested driver: spawns inner adder, awaits it (token release/reacquire) ---
async void nested_driver(int &a, int &b):
    Task[void] inner = spawn nested_adder(&a, &b, 5)
    inner.await()

# --- Conditional: adds n only if do_write is true, else early return ---
async void conditional_writer(int &a, int &b, int n, bool do_write):
    if do_write == false:
        return
    int i = 0
    while i < n:
        a = a + 1
        b = b + 1
        i = i + 1

async void main():
    shared int a = 0
    shared int b = 0

    # Phase 1: 500 writers via TaskGroup
    TaskGroup writers = TaskGroup()
    int i = 0
    while i < 500:
        writers.spawn(spawn writer(&a, &b, 10))
        i += 1
    writers.join()

    # Phase 2: 500 readers via TaskGroup
    TaskGroup readers = TaskGroup()
    i = 0
    while i < 500:
        readers.spawn(spawn reader(&a, &b))
        i += 1
    readers.join()

    # Phase 3: 200 nested drivers via TaskGroup
    TaskGroup nesters = TaskGroup()
    i = 0
    while i < 200:
        nesters.spawn(spawn nested_driver(&a, &b))
        i += 1
    nesters.join()

    # Phase 4: 100 conditional writers via TaskGroup
    TaskGroup conds = TaskGroup()
    i = 0
    while i < 100:
        bool should_write = i % 2 == 0
        conds.spawn(spawn conditional_writer(&a, &b, 10, should_write))
        i += 1
    conds.join()

    print(a)
    print(b)
    print("done")
