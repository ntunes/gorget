# Scope tree and definition table for name resolution.
# Uses flat parallel vectors for scope names to avoid non-Copy codegen issues.

from std.collections import Vector, Dict
from ast import Span
from ids import NO_DEF, NO_SCOPE

# ── Definition kinds ────────────────────────────────────────

enum DefKind:
    DkFunction
    DkStruct
    DkEnum
    DkVariant
    DkTrait
    DkTypeAlias
    DkNewtype
    DkVariable
    DkConst
    DkStatic
    DkGenericParam
    DkImport

# ── Definition info ─────────────────────────────────────────

struct DefInfo:
    String name
    DefKind kind
    Span span
    int scope_id
    int type_id
    bool is_mutable
    bool is_param

# ── Scope kinds ─────────────────────────────────────────────

enum ScopeKind:
    SkModule
    SkFunction
    SkBlock
    SkEquipBlock
    SkTraitDef
    SkForLoop

# ── Scope (Copy-friendly — no Dict) ────────────────────────

struct Scope:
    int parent
    ScopeKind kind

# ── Scope table ─────────────────────────────────────────────
# Flat parallel vectors for names avoid non-Copy type issues in codegen.

struct ScopeTable:
    Vector[Scope] scopes
    Vector[DefInfo] definitions
    # Flat scope → name → def_id mapping
    Vector[int] name_scope_ids
    Vector[String] name_keys
    Vector[int] name_def_ids
    int current
    # Variant name → def_ids. `alloc_def` (used for non-generic enum variants,
    # which are NOT in the value namespace nor the parallel name table) records
    # each variant here so `is_known_variant_name` is an O(K) lookup. Mirrors
    # Rust gg's `name_index` role for `is_known_variant_name`
    # (src/semantic/scope.rs:195/442).
    Dict[String, Vector[int]] variant_name_index

# ── Typed accessors (only for immutable self or standalone use) ────

DefInfo get_def_at(Vector[DefInfo] v, int i):
    return v.get(i).unwrap()

Scope get_scope_at(Vector[Scope] v, int i):
    return v.get(i).unwrap()

bool def_kind_is_import(DefKind k):
    match k:
        case DkImport():
            return true
        else:
            return false

bool def_kind_is_trait(DefKind k):
    match k:
        case DkTrait():
            return true
        else:
            return false

bool def_kind_is_variant(DefKind k):
    match k:
        case DkVariant():
            return true
        else:
            return false

# Is `name` a known (non-generic) enum variant anywhere in the module?
# Non-generic variants are `alloc_def`'d (no value-namespace entry), so a
# plain lookup misses them; this O(K) query lets the resolver stay silent for
# bare variant refs. Mirrors Rust gg `ScopeTable::is_known_variant_name`
# (src/semantic/scope.rs:442). Kept in sync with the typechecker/lowerer copy
# per CLAUDE.md "fix the class, not the instance".
bool is_known_variant_name(ScopeTable scopes, String name):
    if scopes.variant_name_index.contains(name):
        Vector[int] ids = scopes.variant_name_index.get(name).unwrap()
        int j = 0
        while j < ids.len():
            int def_id = ids.get(j).unwrap()
            DefInfo d = get_def_at(scopes.definitions, def_id)
            if def_kind_is_variant(d.kind):
                return true
            j += 1
    return false

# ── ScopeTable methods ──────────────────────────────────────

equip ScopeTable:

    ScopeTable new_scope_table(): ScopeTable(
        Vector[Scope](),
        Vector[DefInfo](),
        Vector[int](),
        Vector[String](),
        Vector[int](),
        NO_SCOPE,
        Dict[String, Vector[int]]()
    )

    void init(&self):
        Scope root = Scope(NO_SCOPE, SkModule())
        self.scopes.push(root)
        self.current = 0

    int push_scope(&self, ScopeKind kind):
        int id = self.scopes.len()
        Scope s = Scope(self.current, kind)
        self.scopes.push(s)
        self.current = id
        return id

    void pop_scope(&self):
        int parent = self.scope_parent_of(self.current)
        if parent >= 0:
            self.current = parent

    # Convenience reader for a scope's parent id.
    int scope_parent_of(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    int define(&self, String name, DefKind kind, Span !span):
        return self.define_with_mutability(name, kind, !span, false)

    int define_with_mutability(&self, String name, DefKind kind, Span !span, bool is_mutable):
        # Check for existing definition in current scope using name table
        int ni = self.find_name_entry(self.current, name.clone())
        if ni >= 0:
            return self.define_replace_or_fail(ni, name, kind, !span, is_mutable)
        int def_id = self.definitions.len()
        DefInfo info = DefInfo(name.clone(), kind, span, self.current, NO_DEF, is_mutable, false)
        self.definitions.push(info)
        # Add new name entry
        self.name_scope_ids.push(self.current)
        self.name_keys.push(name)
        self.name_def_ids.push(def_id)
        return def_id

    # Try to replace or fail for duplicate definition (extracted for borrow checker)
    int define_replace_or_fail(&self, int ni, String name, DefKind kind, Span !span, bool is_mutable):
        int existing_def_id = self.name_def_ids.get(ni).unwrap()
        DefInfo existing = get_def_at(self.definitions, existing_def_id)
        bool existing_is_import = def_kind_is_import(existing.kind)
        bool existing_is_trait = def_kind_is_trait(existing.kind)
        bool existing_is_dummy = existing.span.start == 0 and existing.span.end == 0

        bool new_is_import = def_kind_is_import(kind)
        bool new_is_trait = def_kind_is_trait(kind)

        bool allow_replace = false
        if existing_is_import and not new_is_import:
            allow_replace = true
        if existing_is_import and existing_is_dummy:
            allow_replace = true
        if existing_is_trait and existing_is_dummy:
            allow_replace = true

        if allow_replace:
            int def_id = self.definitions.len()
            DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, is_mutable, false)
            self.definitions.push(info)
            # Update existing name entry to point to new def
            self.name_def_ids.set(ni, def_id)
            return def_id
        # Duplicate definition error — return NO_DEF to signal failure
        return NO_DEF

    # Allocate a definition without inserting into the current scope's name table.
    # Used for non-generic enum variants which have def_ids but aren't in scope.
    int alloc_def(&self, String name, DefKind kind, Span !span):
        int def_id = self.definitions.len()
        String vkey = name.clone()
        bool is_variant = def_kind_is_variant(kind)
        DefInfo info = DefInfo(name, kind, span, self.current, NO_DEF, false, false)
        self.definitions.push(info)
        if is_variant:
            if self.variant_name_index.contains(vkey):
                self.variant_name_index.get(vkey).unwrap().push(def_id)
            else:
                Vector[int] v = [def_id]
                self.variant_name_index.put(vkey, !v)
        return def_id

    # Find name entry index in flat table (returns -1 if not found)
    int find_name_entry(self, int scope_id, String name):
        int i = self.name_scope_ids.len() - 1
        while i >= 0:
            if self.name_scope_ids.get(i).unwrap() == scope_id:
                if self.name_keys.get(i).unwrap() == name:
                    return i
            i = i - 1
        return NO_DEF

    int lookup(self, String name):
        int scope_id = self.current
        while scope_id >= 0:
            int ni = self.find_name_entry(scope_id, name)
            if ni >= 0:
                return self.name_def_ids.get(ni).unwrap()
            Scope s = get_scope_at(self.scopes, scope_id)
            scope_id = s.parent
        return NO_DEF

    int lookup_from_scope(self, int scope_id, String name):
        int sid = scope_id
        while sid >= 0:
            int ni = self.find_name_entry(sid, name)
            if ni >= 0:
                return self.name_def_ids.get(ni).unwrap()
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return NO_DEF

    int lookup_in_scope(self, int scope_id, String name):
        int ni = self.find_name_entry(scope_id, name)
        if ni >= 0:
            return self.name_def_ids.get(ni).unwrap()
        return NO_DEF

    DefInfo get_def(self, int id):
        return get_def_at(self.definitions, id)

    void set_def_param(&self, int id, bool is_param):
        # Use direct field assignment on definition
        # Vector elements aren't mutable in place via .get(); copy, mutate, write back.
        DefInfo d = self.definitions.get(id).unwrap()
        d.is_param = is_param
        self.definitions.set(id, d)

    void set_def_type(&self, int id, int type_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.type_id = type_id
        self.definitions.set(id, d)

    void set_def_scope_id(&self, int id, int scope_id):
        DefInfo d = self.definitions.get(id).unwrap()
        d.scope_id = scope_id
        self.definitions.set(id, d)

    int current_scope(self):
        return self.current

    void set_current(&self, int id):
        self.current = id

    int def_count(self):
        return self.definitions.len()

    int scope_count(self):
        return self.scopes.len()

    ScopeKind scope_kind(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.kind

    int scope_parent(self, int id):
        Scope s = get_scope_at(self.scopes, id)
        return s.parent

    bool is_descendant_of(self, int child, int parent):
        int sid = child
        while sid >= 0:
            if sid == parent:
                return true
            Scope s = get_scope_at(self.scopes, sid)
            sid = s.parent
        return false

    int lookup_def_by_span(self, String name, Span span):
        int i = 0
        while i < self.definitions.len():
            DefInfo d = get_def_at(self.definitions, i)
            if d.name == name and d.span.start == span.start and d.span.end == span.end:
                return i
            i = i + 1
        return NO_DEF
