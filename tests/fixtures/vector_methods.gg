from std.collections import Vector

void main():
    Vector[int] v = Vector[int]()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    print(f"{v.len()}")
    print(f"{v.get(0).unwrap()}")
    int last = v.pop().unwrap()
    print(f"{last}")
    print(f"{v.len()}")
    v.set(0, 99)
    print(f"{v.get(0).unwrap()}")
    int removed = v.remove(1).unwrap()
    print(f"{removed}")
    print(f"{v.len()}")
    v.clear()
    print(f"{v.len()}")
    if v.is_empty():
        print("empty")
