# Fault-catch drop-correctness (error-model.md §11.2, the subtlest property):
# a faultable op whose operand is a Drop-bearing OWNED temporary. The handler
# branch lives in the GIR/LIR CFG, so drop-insertion runs over it and the live
# temporary is dropped EXACTLY ONCE on the handler path (and on the no-fault
# path). The fixture proves "exactly once" via the deterministic drop print.
struct Counter:
    int n

equip Counter with Drop:
    void drop(!self):
        print("drop counter")

Counter make(int v):
    return Counter(v)

# Fault path: make()'s temporary is live when the multiply overflows. No-fault
# path: same shape, temporary dropped exactly once. The drop print proves both.
void main():
    int big = 9223372036854775807
    int r = (make(big).n * 2) catch Fault.Overflow: -1
    print(f"{r}")
    int ok = (make(5).n * 2) catch Fault.Overflow: -1
    print(f"{ok}")
