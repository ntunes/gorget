from gg.dataframe import DataFrame, Column, df_from_columns, col_from_ints, col_from_floats, col_from_strs, col_ints_null, df_clip

void main():
    # ── clip int column ──
    Vector[int] iv = Vector[int]()
    iv.push(-10)
    iv.push(0)
    iv.push(50)
    iv.push(150)
    Vector[str] n1 = Vector[str]()
    n1.push("v")
    Vector[Column] c1 = Vector[Column]()
    c1.push(col_from_ints(iv))
    DataFrame df1 = df_from_columns(n1, c1)
    DataFrame df1c = df_clip(df1, "v", 0.0, 100.0)
    Column vc = df1c.get_column("v")
    print("{vc.value_as_str(0)}")
    print("{vc.value_as_str(1)}")
    print("{vc.value_as_str(2)}")
    print("{vc.value_as_str(3)}")

    # ── clip float column ──
    Vector[float] fv = Vector[float]()
    fv.push(-1.5)
    fv.push(5.5)
    fv.push(12.0)
    Vector[str] n2 = Vector[str]()
    n2.push("f")
    Vector[Column] c2 = Vector[Column]()
    c2.push(col_from_floats(fv))
    DataFrame df2 = df_from_columns(n2, c2)
    DataFrame df2c = df_clip(df2, "f", 0.0, 10.0)
    Column fc = df2c.get_column("f")
    print("{fc.value_as_str(0)}")
    print("{fc.value_as_str(1)}")
    print("{fc.value_as_str(2)}")

    # ── non-numeric column: unchanged ──
    Vector[str] sv = Vector[str]()
    sv.push("hello")
    sv.push("world")
    Vector[str] n3 = Vector[str]()
    n3.push("s")
    Vector[Column] c3 = Vector[Column]()
    c3.push(col_from_strs(sv))
    DataFrame df3 = df_from_columns(n3, c3)
    DataFrame df3c = df_clip(df3, "s", 0.0, 10.0)
    Column sc = df3c.get_column("s")
    print("{sc.value_as_str(0)}")
    print("{sc.value_as_str(1)}")

    # ── missing column: df unchanged ──
    DataFrame df4c = df_clip(df1, "missing", 0.0, 100.0)
    print("{df4c.nrows()}")

    # ── nulls preserved in int column ──
    Vector[int] ndata = Vector[int]()
    ndata.push(-5)
    ndata.push(0)
    ndata.push(200)
    Vector[bool] nmask = Vector[bool]()
    nmask.push(true)
    nmask.push(false)
    nmask.push(true)
    Vector[str] n5 = Vector[str]()
    n5.push("w")
    Vector[Column] c5 = Vector[Column]()
    c5.push(col_ints_null(ndata, nmask))
    DataFrame df5 = df_from_columns(n5, c5)
    DataFrame df5c = df_clip(df5, "w", 0.0, 100.0)
    Column wc = df5c.get_column("w")
    print("{wc.value_as_str(0)}")
    print("{wc.value_as_str(1)}")
    print("{wc.value_as_str(2)}")

    # ── clip at exact boundary (values equal to lo/hi unchanged) ──
    Vector[int] bv = Vector[int]()
    bv.push(0)
    bv.push(100)
    bv.push(50)
    Vector[str] n6 = Vector[str]()
    n6.push("b")
    Vector[Column] c6 = Vector[Column]()
    c6.push(col_from_ints(bv))
    DataFrame df6 = df_from_columns(n6, c6)
    DataFrame df6c = df_clip(df6, "b", 0.0, 100.0)
    Column bc = df6c.get_column("b")
    print("{bc.value_as_str(0)}")
    print("{bc.value_as_str(1)}")
    print("{bc.value_as_str(2)}")

    print("done")
