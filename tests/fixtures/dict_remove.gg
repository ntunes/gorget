# Test Dict.remove() returns Option[V] and correctly removes entries.
from std.conv import int_to_str

void main():
    Dict[String, int] d = Dict[String, int]()
    d.put("a", 1)
    d.put("b", 2)
    d.put("c", 3)
    print(int_to_str(d.len()))
    Option[int] removed = d.remove("b")
    print(int_to_str(removed.unwrap()))
    print(int_to_str(d.len()))
    Option[int] not_found = d.remove("z")
    print(int_to_str(not_found.is_some() as int))
    print(int_to_str(d.len()))
