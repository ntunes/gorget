from std.collections import Vector, Dict, Set, Box

struct Tracked:
    str label

equip Tracked with Drop:
    void drop(!self):
        str l = self.label
        print(f"drop {l}")

void main():
    # Vector buffer cleanup (no crash = success)
    Vector[int] nums = Vector[int]()
    nums.push(1)
    nums.push(2)

    # Dict buffer cleanup
    Dict[str, int] scores = Dict[str, int]()
    scores["alice"] = 100

    # Set buffer cleanup
    Set[int] ids = Set[int]()
    ids.add(42)

    # Nested: push vector into vector (move-zeroed, no double-free)
    Vector[Vector[int]] grid = Vector[Vector[int]]()
    Vector[int] row = Vector[int]()
    row.push(10)
    grid.push(row)

    # Collection in enum variant (move-zeroed, no double-free)
    Vector[int] items = Vector[int]()
    items.push(99)
    Option[Vector[int]] opt = Some(items)

    # Vector element drops — Tracked destructor proves drops fire
    Vector[Tracked] tracked_items = Vector[Tracked]()
    tracked_items.push(Tracked("elem-a"))
    tracked_items.push(Tracked("elem-b"))

    # String element drops (silent — validates no crash/leak)
    Vector[String] string_vec = Vector[String]()
    string_vec.push(String("hello"))
    string_vec.push(String("world"))

    # Dict value drops (silent)
    Dict[str, String] string_dict = Dict[str, String]()
    string_dict["x"] = String("one")

    # Nested: Vector[Vector[String]]
    Vector[Vector[String]] nested_strings = Vector[Vector[String]]()
    Vector[String] inner_strs = Vector[String]()
    inner_strs.push(String("deep"))
    nested_strings.push(inner_strs)

    # Box deep drop — inner struct's Drop runs before free
    Box[Tracked] b = Box(Tracked("boxed"))

    print("done")
