from std.collections import Vector, Dict, Set, Box

struct Tracked:
    str label

equip Tracked with Drop:
    void drop(!self):
        str l = self.label
        print("drop {l}")

void main():
    # Vector buffer cleanup (no crash = success)
    Vector[int] nums = Vector[int]()
    nums.push(1)
    nums.push(2)

    # Dict buffer cleanup
    Dict[str, int] scores = Dict[str, int]()
    scores["alice"] = 100

    # Set buffer cleanup
    Set[int] ids = Set[int]()
    ids.add(42)

    # Nested: push vector into vector (move-zeroed, no double-free)
    Vector[Vector[int]] grid = Vector[Vector[int]]()
    Vector[int] row = Vector[int]()
    row.push(10)
    grid.push(row)

    # Collection in enum variant (move-zeroed, no double-free)
    Vector[int] items = Vector[int]()
    items.push(99)
    Option[Vector[int]] opt = Some(items)

    # Box deep drop — inner struct's Drop runs before free
    Box[Tracked] b = Box(Tracked("boxed"))

    print("done")
