from std.collections import Box

trait Describer:
    String describe(self)
    int count(self)
    float ratio(self)
    bool active(self)

struct Widget:
    String name
    int n
    float r
    bool on

equip Widget with Describer:
    String describe(self):
        return self.name

    int count(self):
        return self.n

    float ratio(self):
        return self.r

    bool active(self):
        return self.on

void main():
    Box[Describer] obj = Box.new(Widget("gear", 7, 3.14, true))
    print(obj.describe())
    print(obj.count())
    print(obj.ratio())
    print(obj.active())
