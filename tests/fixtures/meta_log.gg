meta String VERSION = "1.0"
meta int COUNT = 3

# File-scope meta log
meta log "starting compilation"
meta log "version:", VERSION, "count:", COUNT

String describe[T]():
    meta log "describe called for type:", typename(T)
    meta if typename(T) == "int":
        return "integer"
    elif typename(T) == "String":
        return "string"
    elif typename(T) == "bool":
        return "boolean"
    else:
        return "other"

void main():
    print(describe[int]())
    print(describe[String]())
    print(describe[bool]())
    print("done")
