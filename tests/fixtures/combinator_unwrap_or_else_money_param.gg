# CELL: `.unwrap_or_else()` x bare-param recv x Option[Money]
# COMMITTED Round XIV (74f566c6+) — combinator-receiver ownership class-fix.
# PRE-FIX (RED-verified at HEAD 6171d564): ICE (same Tier 2a violation as
#   plain-local). Bare-param exercises Edit A (Ptr-unwrap) + Edit D
#   (closure-result Owned tag) simultaneously.
# Pinned by Core #6 guard (`combinator_adapter_ownership_invariants` +
# `assert_scrut_is_value_enum`) AND this runtime fixture; fixtures stay
# (Core #11/#12). The guard does not retire this axis cell.

struct Money:
    Vector[int] cents

int size_of(Money m):
    return m.cents.len()

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

Option[Money] make_opt(int n):
    return Some(Money(heap_cents(n)))

void call_it(Option[Money] p):
    Money r = p.unwrap_or_else((): Money(heap_cents(99)))
    print(size_of(r))

void main():
    call_it(make_opt(10))
