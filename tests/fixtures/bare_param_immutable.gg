# Tests that bare struct params are read-only: field reads, passing to other
# bare-param functions, and printing all work without mutation.

struct Point:
    int x
    int y

struct Rect:
    Point origin
    int width
    int height

int area(Rect r):
    return r.width * r.height

str describe(Point p):
    return f"{p.x},{p.y}"

str rect_info(Rect r):
    str origin = describe(r.origin)
    int a = area(r)
    return f"{origin} {a}"

void main():
    Point p1 = Point(x=3, y=4)
    print(describe(p1))
    Point p2 = Point(x=3, y=4)
    Rect r = Rect(origin=p2, width=10, height=5)
    print(area(r))
    print(rect_info(r))
