# D22 step-syntax reject: `v[a:b:c]` rejected at parse-time with
# `E_SliceStepDeferred`. Step is deferred (D22): its real use is
# `.reversed()`'s job and a stride breaks the future offset+len CoW-share
# view representation.
void main():
    Vector[int] v = [1, 2, 3, 4, 5]
    Vector[int] s = v[0:5:2]
    print(s.len().to_string())
