# Exercises `.collect()` and `.count()` on TakeIter — both terminals
# live as Iterator[T] default-method bodies, so any iterator that
# `equip`s the trait inherits them. Replaces the previous
# `collect_vec` / `count_iter` free-function calls (retired in the
# Phase 2c convenience-wrapper migration).

from std.iter import VectorIter, TakeIter

int main():
    Vector[int] v = [10, 20, 30, 40, 50]
    VectorIter[int] vit = v.iter()
    TakeIter[VectorIter[int], int] t = TakeIter[VectorIter[int], int](vit, 3)
    Vector[int] result = t.collect()
    for x in result:
        print(x)

    VectorIter[int] vit2 = v.iter()
    TakeIter[VectorIter[int], int] t2 = TakeIter[VectorIter[int], int](vit2, 4)
    int n = t2.count()
    print(n)

    return 0
