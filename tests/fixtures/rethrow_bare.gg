int parse_number(String s) throws String:
    if s == "bad":
        throw "invalid number"
    return 42

int load_value(String input) throws int:
    int n = parse_number(input)! rethrow 1
    return n

int load_with_context(String input) throws String:
    int n = parse_number(input)! rethrow (String e): f"wrapped: {e}"
    return n

void main():
    Result[int, int] r1 = load_value("ok")
    match r1:
        case Ok(v):
            print(f"ok:{v}")
        case Error(code):
            print(f"exit:{code}")

    Result[int, int] r2 = load_value("bad")
    match r2:
        case Ok(v):
            print(f"ok:{v}")
        case Error(code):
            print(f"exit:{code}")

    Result[int, String] r3 = load_with_context("bad")
    match r3:
        case Ok(v):
            print(f"ok:{v}")
        case Error(e):
            print(f"err:{e}")

    print("done")
