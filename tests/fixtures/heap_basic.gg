from std.heap import Heap
from std.collections import Vector

void main():
    # Basic min-heap with integers
    Heap[int] pq = Heap[int](Vector[int]())
    pq.push(30)
    pq.push(10)
    pq.push(20)
    pq.push(5)
    pq.push(15)

    # peek returns minimum without removing
    int top = pq.peek().unwrap()
    print(f"{top}")

    # len
    int n = pq.len()
    print(f"{n}")

    # is_empty
    bool empty = pq.is_empty()
    print(f"{empty}")

    # pop returns minimum elements in sorted order
    int p1 = pq.pop().unwrap()
    int p2 = pq.pop().unwrap()
    int p3 = pq.pop().unwrap()
    int p4 = pq.pop().unwrap()
    int p5 = pq.pop().unwrap()
    print(f"{p1}")
    print(f"{p2}")
    print(f"{p3}")
    print(f"{p4}")
    print(f"{p5}")

    # Now empty
    bool now_empty = pq.is_empty()
    print(f"{now_empty}")

    # pop on empty returns None
    Option[int] none_val = pq.pop()
    bool is_none = none_val.is_none()
    print(f"{is_none}")

    # Single element heap
    Heap[int] single = Heap[int](Vector[int]())
    single.push(42)
    int sv = single.pop().unwrap()
    print(f"{sv}")

    # float heap
    Heap[float] fpq = Heap[float](Vector[float]())
    fpq.push(3.14)
    fpq.push(1.0)
    fpq.push(2.72)
    float fmin = fpq.pop().unwrap()
    print(f"{fmin}")

    print("done")
