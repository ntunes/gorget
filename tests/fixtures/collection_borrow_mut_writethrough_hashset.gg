from std.collections import HashSet

void mutate(HashSet[String] &env):
    env.add("a")
    env.add("b")
    env.add("c")
    print(env.len())      # 4  (seed + a + b + c)

void main():
    HashSet[String] hs = HashSet[String]()
    hs.add("seed")
    mutate(&hs)
    print(hs.len())       # 4
    print(hs.contains("a"))
    print(hs.contains("b"))
    print(hs.contains("c"))
    print(hs.contains("seed"))
