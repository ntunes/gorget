# D53 self-host axis NEG — FIELD sub-place of a PARAM struct at a collection put
# CELL: lock=Mutex · place-shape=field · source=param · position=push.
# ggdef: ABSTAIN (Mutex/RWLock out of subset; owner: ggdef stays simple).
# Both lanes MUST emit E_MoveWithoutOperator: the destination must own, D53
# forbids a clone path and D10(a) forbids a field/index partial move.


struct Holder:
    Mutex[int] lock

void stash(Holder h):
    Vector[Mutex[int]] v = Vector[Mutex[int]]()
    v.push(h.lock)
    print(v.len())

void main():
    stash(Holder(Mutex[int](5)))
