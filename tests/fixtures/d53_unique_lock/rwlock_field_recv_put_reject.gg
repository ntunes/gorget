# D53 NEG — TYPE axis at a field receiver: the RWLock half of the unique-lock
# family, at `Dict.put` through a struct field.
# CELL: lock=RWLock · position=put · receiver=field of a local · source=named place.
# RED at 3c3ea3f0b: `gg check` ACCEPTED.
# ggdef: ABSTAIN (RWLock out of subset; owner: ggdef stays simple).

from std.sync import RWLock

struct Registry:
    Dict[int, RWLock[int]] slots

void main():
    RWLock[int] r = RWLock[int](5)
    Registry reg = Registry({})
    reg.slots.put(1, r)
    print(reg.slots.len())
