# D53 self-host axis NEG — SELF-rooted field sub-place at a collection put
# CELL: lock=RWLock · place-shape=self.field · source=self · position=push.
# ggdef: ABSTAIN (Mutex/RWLock out of subset; owner: ggdef stays simple).
# Both lanes MUST emit E_MoveWithoutOperator: the destination must own, D53
# forbids a clone path and D10(a) forbids a field/index partial move.

from std.sync import RWLock

# `self` is the place-chain BASE here. A BARE `self` of unique-lock type is a
# VACUOUS cell — `equip Mutex[int]:` / `equip RWLock[int]:` cannot be written,
# so no `self` can itself be a lock.
struct Holder:
    RWLock[int] lock

equip Holder:
    void stash(self, Vector[RWLock[int]] &v):
        v.push(self.lock)

void main():
    Holder h = Holder(RWLock[int](5))
    Vector[RWLock[int]] v = Vector[RWLock[int]]()
    h.stash(&v)
    print(v.len())
