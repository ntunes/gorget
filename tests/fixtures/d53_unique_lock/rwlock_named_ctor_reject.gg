# D53 NEG — named RWLock at struct-ctor / field-init.
# CELL: lock=RWLock · position=ctor · source=named place.
# ggdef: ABSTAIN (Mutex/RWLock out of subset; owner: ggdef stays simple).

from std.sync import RWLock

struct Wrap:
    RWLock[int] lock

void main():
    RWLock[int] r = RWLock[int](5)
    Wrap w = Wrap(r)
    print(w.lock.read().get())
