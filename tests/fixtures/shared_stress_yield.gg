# Stress test with yield points: 50 batches of 10 workers, each increment
# twice with a yield (sub-task await) between. Lock is released at each
# await and reacquired after — exercises release/reacquire under heavy
# contention. Final value must be exactly 1000.

from std.conv import int_to_str

async int noop():
    return 0

async void increment_yield(int &counter):
    counter = counter + 1
    int dummy = noop().await()
    counter = counter + 1

async void main():
    shared int counter = 0
    int batch = 0
    while batch < 50:
        Vector[Task[void]] tasks = Vector[Task[void]]()
        int i = 0
        while i < 10:
            tasks.push(!spawn increment_yield(&counter))
            i = i + 1
        int j = 0
        while j < 10:
            Task[void] t = tasks.remove(0).unwrap()
            t.await()
            j = j + 1
        batch = batch + 1
    print(int_to_str(counter))
