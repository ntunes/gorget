# Stress test with yield points: 50 batches of 10 workers, each increment
# twice with a yield (sub-task await) between. Lock is released at each
# await and reacquired after — exercises release/reacquire under heavy
# contention. Final value must be exactly 1000.

from std.conv import int_to_str

async int noop():
    return 0

async void increment_yield(int &counter):
    counter = counter + 1
    int dummy = noop().await()
    counter = counter + 1

async void main():
    shared int counter = 0
    int batch = 0
    while batch < 50:
        Task[void] t0 = spawn increment_yield(&counter)
        Task[void] t1 = spawn increment_yield(&counter)
        Task[void] t2 = spawn increment_yield(&counter)
        Task[void] t3 = spawn increment_yield(&counter)
        Task[void] t4 = spawn increment_yield(&counter)
        Task[void] t5 = spawn increment_yield(&counter)
        Task[void] t6 = spawn increment_yield(&counter)
        Task[void] t7 = spawn increment_yield(&counter)
        Task[void] t8 = spawn increment_yield(&counter)
        Task[void] t9 = spawn increment_yield(&counter)
        t0.await()
        t1.await()
        t2.await()
        t3.await()
        t4.await()
        t5.await()
        t6.await()
        t7.await()
        t8.await()
        t9.await()
        batch = batch + 1
    print(int_to_str(counter))
