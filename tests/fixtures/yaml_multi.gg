from xtd.yaml import Yaml, parse, parse_all, stringify_all, pretty
from std.collections import Vector

void main():
    # parse_all: two documents separated by ---
    String multi = "name: Alice\nage: 30\n---\nname: Bob\nage: 25\n"
    Vector[Yaml] docs = parse_all(multi).unwrap()
    int n = docs.len()
    print(f"{n}")
    Yaml doc0 = docs.get(0).unwrap()
    print(doc0.get("name").as_str())
    Yaml doc1 = docs.get(1).unwrap()
    print(doc1.get("name").as_str())

    # stringify_all: verify output is non-empty
    String sa = stringify_all(docs)
    bool has_content = sa.len() > 0
    print(f"{has_content}")

    # pretty: block-style output of a mapping
    Yaml y = parse("x: 1\ny: 2\n").unwrap()
    String pretty = pretty(y)
    bool pretty_ok = pretty.len() > 0
    print(f"{pretty_ok}")

    print("done")
