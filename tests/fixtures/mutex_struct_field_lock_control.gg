# CONTROL cell: Mutex[int] · struct-field · Mutex.lock(). Green pre AND
# post-fix -- accidentally correct pre-fix because Guard[int] is a struct
# return, which routes lock() through the struct-return rewrite
# (`gorget_mutex_lock_to(m, out)`) that already emits the deref. Kept as a
# regression pin: the chokepoint fix must not break this shape.
#
# LANDED 2026-08-06 (Round XXXII, opaque-handle receiver-ABI class fix).

from std.sync import Mutex, Guard

struct Bag:
    Mutex[int] m

void bump(Bag b):
    Guard[int] g = b.m.lock()
    int v = g.get()
    g.set(v + 1)

void main():
    Bag b = Bag(Mutex[int](40))
    bump(b)
    bump(b)
    Guard[int] g = b.m.lock()
    print(g.get())
