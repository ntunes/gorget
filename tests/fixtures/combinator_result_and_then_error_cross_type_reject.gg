# NEG (Round XXIII Track α, class-fix sibling): Result[T, E].and_then(closure
# -> Result[U, E']) where E' ≠ E must be REJECTED at typecheck (Err-unify: the
# passthrough axis is Error; only the Ok side is mapped).
#
# Pre-fix: typecheck at `src/semantic/typecheck.rs::infer_closure_method_type`
# accepted any Result[U, E'] closure return. Under a receiver Result[int, Money]
# with a closure returning Result[bool, int], the never-taken Error branch's
# Money payload was left un-freed (LSan leak, see Round XXIII scout
# `/tmp/xxiii_alpha_probes/cell1b_result_and_then_heap.gg`).
#
# Post-fix: `unify_closure_ret_axis(ClosureCombinatorCell::ResultAndThen)` in
# `src/semantic/typecheck.rs` rejects at check time with `E_TypeMismatch` when
# `E' ≠ E`, so the ill-typed cross-E shape never reaches the lowerer.

struct Money:
    Vector[int] cents

Vector[int] heap_cents(int n):
    Vector[int] c = Vector[int]()
    int i = 0
    while i < n:
        c.push(i)
        i = i + 1
    return c

# Closure return: Result[bool, int]. Receiver has Error payload = Money.
# E'=int, E=Money → E' ≠ E → REJECT.
Result[bool, int] recover_result(int i):
    return Ok(i > 0)

void via_param(Result[int, Money] p):
    Result[bool, int] r = p.and_then((int i): recover_result(i))
    match r:
        case Ok(v):
            print(1)
        case Error(e):
            print(-1)

void main():
    via_param(Error(Money(heap_cents(5))))
