from gg.csv import csv_parse, csv_parse_delim, csv_parse_table, csv_parse_table_delim, csv_stringify_delim, csv_stringify_table_delim, CsvTable
from std.collections import Vector

void main():
    # ── Test 1: csv_parse_table_delim (tab-delimited) ────────
    str tsv = "name\tage\tcity\nAlice\t30\tNYC\nBob\t25\tLA\n"
    auto r1 = csv_parse_table_delim(tsv, "\t")
    match r1:
        case Ok(tbl1):
            int row_cnt = tbl1.row_count()
            int col_cnt = tbl1.col_count()
            print("{row_cnt}")
            print("{col_cnt}")
            print(tbl1.get_named(0, "name"))
            print(tbl1.get_named(1, "city"))
            print(tbl1.has_column("age"))
        case Error(e1):
            print("error")

    # ── Test 2: csv_stringify_delim (pipe-delimited) ──────────
    Vector[Vector[str]] rows2 = Vector[Vector[str]]()
    Vector[str] r2a = Vector[str]()
    r2a.push("x")
    r2a.push("y")
    rows2.push(r2a)
    Vector[str] r2b = Vector[str]()
    r2b.push("1")
    r2b.push("2")
    rows2.push(r2b)
    str out2 = csv_stringify_delim(rows2, "|")
    print(out2 == "x|y\r\n1|2\r\n")

    # ── Test 3: csv_stringify_table_delim (semicolon) ─────────
    Vector[str] hdr3 = Vector[str]()
    hdr3.push("a")
    hdr3.push("b")
    Vector[Vector[str]] rows3 = Vector[Vector[str]]()
    Vector[str] r3a = Vector[str]()
    r3a.push("hello")
    r3a.push("world")
    rows3.push(r3a)
    CsvTable tbl3 = CsvTable(hdr3, rows3)
    str out3 = csv_stringify_table_delim(tbl3, ";")
    print(out3 == "a;b\r\nhello;world\r\n")

    # ── Test 4: Tab-delimited roundtrip ──────────────────────
    str tsv4 = "p\tq\n10\t20\n30\t40\n"
    auto r4 = csv_parse_table_delim(tsv4, "\t")
    match r4:
        case Ok(tbl4):
            Vector[str] hdr4 = Vector[str]()
            hdr4.push("p")
            hdr4.push("q")
            Vector[Vector[str]] rows4 = Vector[Vector[str]]()
            int ri = 0
            while ri < tbl4.row_count():
                rows4.push(tbl4.row(ri))
                ri = ri + 1
            CsvTable rebuilt4 = CsvTable(hdr4, rows4)
            str out4 = csv_stringify_table_delim(rebuilt4, "\t")
            auto r4b = csv_parse_table_delim(out4, "\t")
            match r4b:
                case Ok(tbl4b):
                    print(tbl4b.row_count())
                    print(tbl4b.get_named(0, "p"))
                    print(tbl4b.get_named(1, "q"))
                case Error(_):
                    print("error")
        case Error(_):
            print("error")

    # ── Test 5: Single-column CSV ─────────────────────────────
    str single = "val\nalpha\nbeta\n"
    auto r5 = csv_parse_table_delim(single, ",")
    match r5:
        case Ok(tbl5):
            int sc_rows = tbl5.row_count()
            int sc_cols = tbl5.col_count()
            print("{sc_rows}")
            print("{sc_cols}")
            print(tbl5.get_named(0, "val"))
        case Error(e5):
            print("error")

    # ── Test 6: Header-only CSV (0 data rows) ─────────────────
    str header_only = "col1,col2\n"
    auto r6 = csv_parse_table_delim(header_only, ",")
    match r6:
        case Ok(tbl6):
            int ho_rows = tbl6.row_count()
            int ho_cols = tbl6.col_count()
            print("{ho_rows}")
            print("{ho_cols}")
        case Error(e6):
            print("error")

    print("done")
