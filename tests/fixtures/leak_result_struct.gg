# Leak test: string and collection payloads in Result/Option via match.
from std.os import mem_live

Result[String, String] get_value(int id):
    if id > 0:
        return Ok(f"value_{id}")
    return Error("not found")

Option[String] maybe_name(int id):
    if id > 0:
        return Some(f"name_{id}")
    return None

void main():
    int baseline = mem_live()

    # Section 1: Ok(String) in loop
    int i = 0
    while i < 200:
        Result[String, String] r = get_value(i)
        match r:
            case Ok(v):
                int _len = v.len()
            case Error(e):
                pass
        i = i + 1

    # Section 2: Some(String) in loop
    i = 0
    while i < 200:
        Option[String] opt = maybe_name(i)
        match opt:
            case Some(s):
                int _len = s.len()
            case None:
                pass
        i = i + 1

    int leaked = mem_live() - baseline
    print(f"leaked={leaked > 0}")
    print("done")
