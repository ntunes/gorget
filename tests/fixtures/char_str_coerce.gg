# Tests for single-char str literals.
# Single-quoted literals 'A' are now str (same as "A").
#
# Expected output:
#   A
#   true
#   A

void main():
    # single-char literal assigned to str variable
    str s = 'A'
    print(s)

    # single-char literal compared with double-quoted str
    str t = 'A'
    print(t == "A")

    # single-char literal is a str
    str result = 'A'
    print(result)
