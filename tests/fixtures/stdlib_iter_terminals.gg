# Iterator terminals via the method form on `VectorIter[T]` (default-
# body methods on `Iterator[T]`). Replaces the previous `find_iter` /
# `for_each_iter` / `any_iter` / `all_iter` / `count_iter` /
# `fold_iter` free-function calls — those were retired in the Phase
# 2c convenience-wrapper migration. Bound-needing terminals
# (`product` / `min` / `max` / `sum`) shipped as `Iterator[T]`
# defaults 2026-04-27 too — the previous free-fn variants
# (`product_iter` / `min_iter` / `max_iter` / `sum_iter`) were
# eliminated as pure aliases.

from std.collections import Vector

bool is_even(int x):
    return x % 2 == 0

bool gt_five(int x):
    return x > 5

int add(int a, int b):
    return a + b

void print_int(int x):
    print(x)

int main():
    Vector[int] v = Vector[int]()
    v.push(3)
    v.push(1)
    v.push(4)
    v.push(1)
    v.push(5)
    v.push(9)
    v.push(2)
    v.push(6)

    # find — first even, first > 5, none-match.
    Option[int] first_even = v.iter().find(is_even)
    match first_even:
        case Some(n):
            print(f"first_even={n}")
        case None:
            print("first_even=none")

    Option[int] first_gt5 = v.iter().find(gt_five)
    match first_gt5:
        case Some(n):
            print(f"first_gt5={n}")
        case None:
            print("first_gt5=none")

    Vector[int] empty = Vector[int]()
    Option[int] none_hit = empty.iter().find(is_even)
    match none_hit:
        case Some(n):
            print(f"none_hit={n}")
        case None:
            print("none_hit=none")

    # for_each — side-effecting iteration.
    print("each:")
    v.iter().for_each(print_int)

    # product — bound-needing default on Iterator[T].
    Vector[int] pv = Vector[int]()
    pv.push(2)
    pv.push(3)
    pv.push(5)
    pv.push(7)
    int prod = pv.iter().product()
    print(f"product={prod}")

    int empty_prod = empty.iter().product()
    print(f"empty_product={empty_prod}")

    # min / max — bound-needing defaults on Iterator[T].
    Option[int] lo = v.iter().min()
    match lo:
        case Some(n):
            print(f"min={n}")
        case None:
            print("min=none")

    Option[int] hi = v.iter().max()
    match hi:
        case Some(n):
            print(f"max={n}")
        case None:
            print("max=none")

    Option[int] empty_min = empty.iter().min()
    match empty_min:
        case Some(n):
            print(f"empty_min={n}")
        case None:
            print("empty_min=none")

    # any / all / count / sum / fold via method form.
    # ⚠ BOUND TO LOCALS DELIBERATELY — a LANE GAP, not a style choice.
    # Rust gg compiles these inlined inside the interpolation fine
    # (`fstring_method_chain.gg` covers that shape). The SELF-HOST does not:
    # it emits `__gg_VectorIter__int64_t` assigned from `int` and the C
    # fails to compile, tripping `self_host_runtime`. Filed in TODO.md.
    # Re-inline only once the self-host lane handles it.
    bool any_gt5 = v.iter().any(gt_five)
    bool all_gt5 = v.iter().all(gt_five)
    int count_v = v.iter().count()
    int fold_v = v.iter().fold(0, add)
    int sum_v = v.iter().sum()
    print(f"any_gt5={any_gt5}")
    print(f"all_gt5={all_gt5}")
    print(f"count={count_v}")
    print(f"sum={sum_v}")
    print(f"fold={fold_v}")

    return 0
