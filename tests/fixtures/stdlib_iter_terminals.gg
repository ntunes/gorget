# Iterator terminals via the method form on `VectorIter[T]` (default-
# body methods on `Iterator[T]`). Replaces the previous `find_iter` /
# `for_each_iter` / `any_iter` / `all_iter` / `count_iter` /
# `fold_iter` free-function calls — those were retired in the Phase
# 2c convenience-wrapper migration.
#
# Bound-needing terminals (`product_iter` / `min_iter` / `max_iter`
# / `sum_iter`) keep their free-function form for now — promotion to
# Iterator defaults blocks on per-method trait bounds (see
# stdlib-design.md §10 row 3).

from std.iter import product_iter, min_iter, max_iter, sum_iter
from std.collections import Vector

bool is_even(int x):
    return x % 2 == 0

bool gt_five(int x):
    return x > 5

int add(int a, int b):
    return a + b

void print_int(int x):
    print(x)

int main():
    Vector[int] v = Vector[int]()
    v.push(3)
    v.push(1)
    v.push(4)
    v.push(1)
    v.push(5)
    v.push(9)
    v.push(2)
    v.push(6)

    # find — first even, first > 5, none-match.
    Option[int] first_even = v.iter().find(is_even)
    match first_even:
        case Some(n):
            print(f"first_even={n}")
        case None:
            print("first_even=none")

    Option[int] first_gt5 = v.iter().find(gt_five)
    match first_gt5:
        case Some(n):
            print(f"first_gt5={n}")
        case None:
            print("first_gt5=none")

    Vector[int] empty = Vector[int]()
    Option[int] none_hit = empty.iter().find(is_even)
    match none_hit:
        case Some(n):
            print(f"none_hit={n}")
        case None:
            print("none_hit=none")

    # for_each — side-effecting iteration.
    print("each:")
    v.iter().for_each(print_int)

    # product_iter — bound-needing, stays as a free function.
    Vector[int] pv = Vector[int]()
    pv.push(2)
    pv.push(3)
    pv.push(5)
    pv.push(7)
    int prod = product_iter[VectorIter[int]](pv.iter())
    print(f"product={prod}")

    int empty_prod = product_iter[VectorIter[int]](empty.iter())
    print(f"empty_product={empty_prod}")

    # min_iter / max_iter — bound-needing, stay as free functions.
    Option[int] lo = min_iter[VectorIter[int]](v.iter())
    match lo:
        case Some(n):
            print(f"min={n}")
        case None:
            print("min=none")

    Option[int] hi = max_iter[VectorIter[int]](v.iter())
    match hi:
        case Some(n):
            print(f"max={n}")
        case None:
            print("max=none")

    Option[int] empty_min = min_iter[VectorIter[int]](empty.iter())
    match empty_min:
        case Some(n):
            print(f"empty_min={n}")
        case None:
            print("empty_min=none")

    # any / all / count via method form; sum_iter stays a free fn.
    # NOTE: bind to locals first — f-string interpolation re-parses
    # the segment text at IR-lowering time, bypassing the typecheck-
    # side AST rewriter that syncs inferred method-targs into the AST.
    # Inlining `v.iter().any(p)` inside `f"…={…}"` would link-fail
    # against the un-mangled `VectorIter__T__any` symbol.
    bool any_gt5 = v.iter().any(gt_five)
    bool all_gt5 = v.iter().all(gt_five)
    int count_v = v.iter().count()
    int fold_v = v.iter().fold(0, add)
    int sum_v = sum_iter[VectorIter[int]](v.iter())
    print(f"any_gt5={any_gt5}")
    print(f"all_gt5={all_gt5}")
    print(f"count={count_v}")
    print(f"sum={sum_v}")
    print(f"fold={fold_v}")

    return 0
