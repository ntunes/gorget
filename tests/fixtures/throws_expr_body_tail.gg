# Expression-body `throws` fn: the tail value must be wrapped in `Ok(...)` so
# it matches the function's `Result[T, E]` return slot. Before the fix the
# bare `T` was assigned straight into the `Result` slot, emitting ill-typed C
# (the block-body equivalent compiled fine — the expr-body path didn't wrap).

# Plain expr-body throws fn with an arithmetic tail value.
int inc(int x) throws String: x + 1

# Expr-body throws fn that throws on the error path (block body for the throw).
int risky(int x) throws String:
    if x < 0:
        throw "negative"
    return x * 2

# Expr-body throws fn that FORWARDS another throws call. The inner call
# auto-propagates (unwrapping to the inner `T`); this arm must re-wrap the
# unwrapped value exactly ONCE — never double-`Ok`.
int forward(int x) throws String: risky(x)!

# Expr-body throws fn returning a resource type (String) — exercises the
# Move-mode return-slot assign on the wrapped Ok value.
String greet(String name) throws String: "Hi, " + name

# T = Result — the declared success type is *itself* a Result. The synthesized
# return slot is the double `Result[Result[int, String], String]`. The user's
# tail value is the INNER `Result[int, String]`; the throws machinery must wrap
# it in the outer `Ok` exactly once (B1). Before the fix the expr-body tail
# never set `expected_type` to the declared `T`, so auto-prop over-unwrapped the
# inner Result and the Ok-wrap re-wrapped at the wrong layer → a SILENT
# MISCOMPILE (the binary built but `r` was corrupt and printed nothing).
#
# `mk` is a plain (non-throws) Result-returning fn, so the tail is a clean
# `Result[int, String]` value with no nested-throws ambiguity.
Result[int, String] mk(int x):
    if x < 0:
        return Error("neg")
    return Ok(x * 3)

# Expr-body form: tail `mk(x)` is a `Result[int, String]` value.
Result[int, String] wrap_result_expr(int x) throws String: mk(x)

# Block-body form: `return mk(x)` — same inner value, explicit return.
Result[int, String] wrap_result_block(int x) throws String:
    return mk(x)

# `return Ok(...)` form: `Ok(x * 4)` builds the INNER `Result[int, String]`
# (resolved against the declared `T`, not the slot), then the outer Ok-wrap
# fires. The throw path exercises the outer Error layer.
Result[int, String] wrap_result_ok(int x) throws String:
    if x < 0:
        throw "neg"
    return Ok(x * 4)

# T = Option — the declared success type is *itself* an `Option`. Same
# double-wrap shape as the T=Result case: the synthesized slot is
# `Result[Option[int], String]`, so the user's tail value is the INNER
# `Option[int]` and the outer Ok-wrap must fire exactly once. Before the Option
# fold the `declared_t_is_*` gate matched only `Result`, so a `Some(...)`/`None`
# tail kept the explicit-variant shortcut ON and the 16-byte inner `Option` was
# direct-assigned into the larger outer `Result` slot — a stack-buffer overflow
# (`-Wstringop-overread`) + silently dropped value. (Non-resource int inner; the
# resource-inner case is a separately-filed known defect.)
Option[int] maybe(int x):
    if x < 0:
        return None
    return Some(x * 7)

# Expr-body form: tail `maybe(x)` is an `Option[int]` value.
Option[int] wrap_opt_expr(int x) throws String: maybe(x)

# Block-body form: `return maybe(x)` — same inner value, explicit return.
Option[int] wrap_opt_block(int x) throws String:
    return maybe(x)

# `return Some(...)` form: `Some(x + 50)` builds the INNER `Option[int]`
# (resolved against the declared `T`, not the slot), then the outer Ok-wrap
# fires. The throw path exercises the outer Error layer.
Option[int] wrap_opt_some(int x) throws String:
    if x < 0:
        throw "neg"
    return Some(x + 50)

void main():
    int a = inc(10)! catch (e): -1
    print(a)

    int b = forward(5)! catch (e): -1
    print(b)

    int c = forward(-3)! catch (e): -1
    print(c)

    String g = greet("Bee")! catch (e): "err"
    print(g)

    # T = Result, expr-body tail: catch peels the outer throws-Result, leaving
    # the inner `Result[int, String]` = Ok(12).
    Result[int, String] r1 = wrap_result_expr(4)! catch (e): Error("boom")
    match r1:
        case Ok(v):
            print("ok")
            print(v)
        case Error(m):
            print("err")
            print(m)

    # T = Result, block-body tail (return mk(x)).
    Result[int, String] r2 = wrap_result_block(5)! catch (e): Error("boom")
    match r2:
        case Ok(v):
            print(v)
        case Error(m):
            print(m)

    # T = Result, `return Ok(inner)` success path (Ok(24)).
    Result[int, String] r3 = wrap_result_ok(6)! catch (e): Error("boom")
    match r3:
        case Ok(v):
            print(v)
        case Error(m):
            print(m)

    # T = Result, throw path: the outer Error propagates, caught at the call
    # site, leaving the inner Error("from-throw").
    Result[int, String] r4 = wrap_result_ok(-1)! catch (e): Error("from-throw")
    match r4:
        case Ok(v):
            print(v)
        case Error(m):
            print(m)

    # T = Option, expr-body tail: catch peels the outer throws-Result, leaving
    # the inner `Option[int]` = Some(21).
    Option[int] o1 = wrap_opt_expr(3)! catch (e): None
    match o1:
        case Some(v):
            print(v)
        case None:
            print(-1)

    # T = Option, block-body tail (return maybe(x)): maybe(-1) returns None.
    Option[int] o2 = wrap_opt_block(-1)! catch (e): None
    match o2:
        case Some(v):
            print(v)
        case None:
            print(-2)

    # T = Option, `return Some(inner)` success path (Some(56)).
    Option[int] o3 = wrap_opt_some(6)! catch (e): None
    match o3:
        case Some(v):
            print(v)
        case None:
            print(-3)

    # T = Option, throw path: the outer Error propagates, caught at the call
    # site, leaving the catch default None.
    Option[int] o4 = wrap_opt_some(-1)! catch (e): None
    match o4:
        case Some(v):
            print(v)
        case None:
            print(-4)
