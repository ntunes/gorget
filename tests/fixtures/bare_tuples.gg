# Bare tuple syntax: return types, return stmts, auto destructuring, for patterns

# Bare tuple return type: `int, int` instead of `(int, int)`
int, int get_pair():
    return 10, 20

# Three-element bare tuple return type
str, int, bool parse_info():
    return "hello", 42, true

# Single-element return (regression: should not create tuple)
int identity(int x):
    return x

void main():
    # Bare auto destructuring
    auto a, b = get_pair()
    print("{a}")
    print("{b}")

    # Three-element bare auto destructuring
    auto name, value, flag = parse_info()
    print("{name}")
    print("{value}")
    print("{flag}")

    # Parenthesized forms still work (regression)
    auto (x, y) = get_pair()
    print("{x}")
    print("{y}")

    # Bare for-loop pattern
    Vector[(int, int)] pairs = Vector[(int, int)]()
    pairs.push((1, 10))
    pairs.push((2, 20))
    pairs.push((3, 30))
    for first, second in pairs:
        print("{first}")
        print("{second}")

    # Single return regression
    int r = identity(99)
    print("{r}")
