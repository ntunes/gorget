# Cross-frame Bounds — the BINDING form (error-model.md §11, Increment 2.1d).
# The tag-dispatch regression guard: `catch f: match f` catches MULTIPLE
# categories, so the caller dispatches on the slot TAG VALUE. The callee's Bounds
# tag must select the Bounds arm (not Overflow/DivByZero). Expected stdout: 7.
int getx(Vector[int] xs, int i): xs[i]    # may OOB; NO local catch

void main():
    Vector[int] xs = [10, 20, 30]
    int r = getx(xs, 99) catch f: match f:
        case Fault.Overflow():  1
        case Fault.DivByZero(): 2
        case Fault.Bounds():    7
    print(f"{r}")
