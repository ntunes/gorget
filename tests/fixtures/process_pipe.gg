from std.process import process_spawn

void main():
    Vector[String] args = Vector[String]()
    Result[Process, String] r = process_spawn("cat", args)
    match r:
        case Ok(proc):
            proc.write_stdin("hello from gorget\n")
            proc.close_stdin()
            String out = proc.read_stdout()
            int code = proc.wait()
            print(out)
            print(f"{code}")
        case Error(msg):
            print(f"spawn failed: {msg}")
