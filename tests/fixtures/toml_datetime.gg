from gg.toml import toml_parse, TomlValue

void main():
    str src = "ts = 2024-01-15T10:30:00Z\nname = \"test\"\n"
    Result[TomlValue, str] r = toml_parse(src)
    match r:
        case Ok(root):
            TomlValue ts = root.get("ts")
            bool is_dt = ts.is_datetime()
            print("{is_dt}")

            bool is_str_type = ts.is_string()
            print("{is_str_type}")

            str raw = ts.as_str()
            bool has_val = raw.len() > 0
            print("{has_val}")

            TomlValue name_val = root.get("name")
            bool name_is_dt = name_val.is_datetime()
            print("{name_is_dt}")
        case Error(e):
            print("error")
    print("done")
