#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem == "toml_datetime"`; it parses a TOML datetime literal and reads no clock
from xtd.toml import parse, TomlValue

void main():
    String src = "ts = 2024-01-15T10:30:00Z\nname = \"test\"\n"
    Result[TomlValue, ParseError] r = parse(src)
    match r:
        case Ok(root):
            TomlValue ts = root.get("ts")
            bool is_dt = ts.is_datetime()
            print(f"{is_dt}")

            bool is_str_type = ts.is_string()
            print(f"{is_str_type}")

            String raw_val =ts.as_str()
            bool has_val = raw_val.len() > 0
            print(f"{has_val}")

            TomlValue name_val = root.get("name")
            bool name_is_dt = name_val.is_datetime()
            print(f"{name_is_dt}")
        case Error(e):
            print("error")
    print("done")
