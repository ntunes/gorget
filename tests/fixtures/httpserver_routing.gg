#!parity-excluded untriaged: DEBT (todo/t0828) — no cause established. Excluded only because the RETIRED filename
#!  heuristic matched `stem.starts_with("httpserver_")`; its own header says "direct Router dispatch (no TCP)"
# Test: Wildcard routes and prefix mounting — direct Router dispatch (no TCP).
#
# Validates:
#   1. Wildcard GET /files/*rest: dispatch /files/img/logo.png → params["rest"] = "img/logo.png"
#   2. Wildcard wrong prefix: /other/img/logo.png → 404
#   3. Prefix mount: sub-router routes mounted at /api/v1 dispatch correctly
#   4. Prefix mount: unmounted path /api/v2/users → 404
#   5. Wildcard captures multi-segment rest including slashes
#
# Expected output:
#   ok\nok\nok\nok\nok

from xtd.httpserver import Router, HttpRequest, HttpServerResponse
from std.collections import Dict

HttpServerResponse handle_files(HttpRequest req):
    return HttpServerResponse.ok("file:" + req.params["rest"])

HttpServerResponse handle_users(HttpRequest req):
    return HttpServerResponse.ok("users")

HttpServerResponse handle_posts(HttpRequest req):
    return HttpServerResponse.ok("posts:" + req.params["id"])

void check(String label, bool ok):
    if not ok:
        print("FAIL: " + label)
    else:
        print("ok")

void main():
    # Wildcard routes
    Router router = Router.new()
    router.get("/files/*rest", handle_files)

    # 1. Wildcard matches multi-segment path
    HttpRequest req1 = HttpRequest("GET", "/files/img/logo.png", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r1 = router.dispatch(req1)
    check("wildcard_match", r1.status_code == 200 and r1.body == "file:img/logo.png")

    # 2. Wildcard does not match different prefix
    HttpRequest req2 = HttpRequest("GET", "/other/img/logo.png", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r2 = router.dispatch(req2)
    check("wildcard_no_match", r2.status_code == 404)

    # Prefix mount
    Router sub = Router.new()
    sub.get("/users", handle_users)
    sub.get("/posts/:id", handle_posts)

    Router parent = Router.new()
    parent.prefix_mount("/api/v1", sub)

    # 3. Mounted exact route dispatches correctly
    HttpRequest req3 = HttpRequest("GET", "/api/v1/users", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r3 = parent.dispatch(req3)
    check("prefix_exact", r3.status_code == 200 and r3.body == "users")

    # 4. Mounted param route dispatches correctly
    HttpRequest req4 = HttpRequest("GET", "/api/v1/posts/42", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r4 = parent.dispatch(req4)
    check("prefix_param", r4.status_code == 200 and r4.body == "posts:42")

    # 5. Unmounted path returns 404
    HttpRequest req5 = HttpRequest("GET", "/api/v2/users", "", "HTTP/1.1", Dict[String, String](), "", Dict[String, String]())
    HttpServerResponse r5 = parent.dispatch(req5)
    check("prefix_not_mounted", r5.status_code == 404)
