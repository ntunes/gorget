void main():
    String sb = String()
    sb.push("hello")
    sb.push(" world")
    print(sb.str())
    print(f"{sb.len()}")
    print(f"{sb.is_empty()}")
    sb.clear()
    print(f"{sb.is_empty()}")
    sb.push_line("first")
    sb.push("second")
    print(sb.str())
    sb.clear()
    sb.push(42)
    sb.push('!')
    print(sb.str())
    String sb2 = String(256)
    sb2.push(3.14)
    print(sb2.str())
    print(f"{sb2.capacity()}")
    sb2.clear()
    sb2.push(true)
    sb2.push(' ')
    sb2.push(false)
    print(sb2.str())
    sb2.clear()
    sb2.push_line(100)
    sb2.push_line(2.72)
    sb2.push_line(true)
    sb2.push_line('z')
