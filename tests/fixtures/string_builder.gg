void main():
    String sb = String()
    sb.push("hello")
    sb.push(" world")
    print(sb.str())
    print("{sb.len()}")
    print("{sb.is_empty()}")
    sb.clear()
    print("{sb.is_empty()}")
    sb.push_line("first")
    sb.push("second")
    print(sb.str())
    sb.clear()
    sb.push_int(42)
    sb.push_char('!')
    print(sb.str())
    String sb2 = String(256)
    sb2.push_float(3.14)
    print(sb2.str())
    print("{sb2.capacity()}")
