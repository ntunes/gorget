void main():
    # Basic bitwise operations
    print(f"{5 & 3}")
    print(f"{5 | 3}")
    print(f"{5 ^ 3}")
    print(f"{~0}")
    print(f"{1 << 4}")
    print(f"{16 >> 2}")

    # Compound assignment
    int x = 255
    x &= 15
    print(f"{x}")
    x |= 48
    print(f"{x}")
    x ^= 33
    print(f"{x}")
    x <<= 2
    print(f"{x}")
    x >>= 3
    print(f"{x}")

    # Precedence: bitwise AND binds tighter than OR
    print(f"{3 | 4 & 6}")

    # Combining with arithmetic
    print(f"{1 << 3 + 1}")
