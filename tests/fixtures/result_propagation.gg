int parse_int(str s) throws str:
    if s == "42":
        return 42
    throw "not 42"

int double_parsed(str s) throws str:
    int val = parse_int(s)
    return val * 2

int add_ten(str s) throws str:
    int val = parse_int(s)
    return val + 10

int chain(str s) throws str:
    int a = parse_int(s)
    int b = double_parsed(s)
    return a + b

void main():
    # Success: auto-propagation through double_parsed
    int r1 = raw double_parsed("42")
    print(f"{r1}")

    # Error: propagated through double_parsed, try zero-defaults
    int r2 = raw double_parsed("abc")
    print(f"{r2}")

    # Success: auto-propagation through add_ten
    int r3 = raw add_ten("42")
    print(f"{r3}")

    # Multi-step: chain calls two throws functions
    int r4 = raw chain("42")
    print(f"{r4}")

    print("done")
