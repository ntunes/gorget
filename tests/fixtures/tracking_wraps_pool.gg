from std.alloc import PoolAllocator, TrackingAllocator
from std.collections import Vector

void main():
    with PoolAllocator(128, 64) as pool:
        with TrackingAllocator() as tracker:
            Vector[int] v = Vector[int]()
            v.push(1)
            v.push(2)
            v.push(3)
            print(f"allocs > 0: {tracker.alloc_count() > 0}")
            print(f"bytes > 0: {tracker.bytes_allocated() > 0}")
            print(f"pool used > 0: {pool.used_blocks() > 0}")
    print("done")
