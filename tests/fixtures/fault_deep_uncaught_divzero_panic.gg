# Cross-frame DivByZero, NO catch in the caller (error-model.md §11, Increment
# 2.1c): `main` calls `q` WITHOUT a `catch`, so `q` is a participating callee but
# this call site passes a NULL fault-slot. On the deep div0 the callee's fault
# arm takes the NULL branch → panics by default → process exit(1). This preserves
# panic-by-default for an uncaught deep div0 (a NEGATIVE fixture: non-zero exit).
int q(int a, int b): a / b                # NB: also reachable from a deep catch

void deep_catcher():
    # A catch site elsewhere in the module makes `q` PARTICIPATE (so its
    # signature gets the trailing slot), exercising the uniform-signature path.
    int z = 0
    int caught = q(10, z) catch Fault.DivByZero: 999
    print(f"{caught}")                      # prints 999 (div0 caught)

void main():
    deep_catcher()                          # prints 999 (caught div0)
    int zero = 0
    int r = q(10, zero)                     # NO catch → NULL slot → panic, exit 1
    print(f"{r}")                           # never reached
