# Snag #55: `Dict.get_or` inside a callee with a String key param mis-reads
# (always returned the default). Same root as snag #54 — `try_emit_dict_get_or`
# AddressOf'd an already-pointer key. Caller-side get_or and callee `.get` /
# index were fine.

from std.conv import parse_float

Result[float, String] cell_value(Dict[String, String] raw, String addr):
    String text = raw.get_or(addr, "")
    if text.is_empty():
        return Error("empty")
    match parse_float(text):
        case Ok(v):
            return Ok(v)
        case Error(_):
            return Error("bad")

void main():
    Dict[String, String] raw = Dict[String, String]()
    raw["A1"] = "3"
    print(raw.get_or("A1", ""))
    match cell_value(raw, "A1"):
        case Ok(v):
            print(v)
        case Error(e):
            print(e)
