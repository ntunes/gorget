from xtd.dataframe import DataFrame, Column, df_from_columns, col_from_ints, col_from_strs, col_from_floats, df_from_records

void main():
    # Build a 3-row DataFrame: name (String), age (int), score (float)
    Vector[int] ages = Vector[int]()
    ages.push(25)
    ages.push(30)
    ages.push(35)

    Vector[String] names = Vector[String]()
    names.push("Alice")
    names.push("Bob")
    names.push("Charlie")

    Vector[float] scores = Vector[float]()
    scores.push(8.5)
    scores.push(9.0)
    scores.push(7.5)

    Vector[String] col_names = Vector[String]()
    col_names.push("name")
    col_names.push("age")
    col_names.push("score")

    Vector[Column] cols = Vector[Column]()
    cols.push(col_from_strs(names))
    cols.push(col_from_ints(ages))
    cols.push(col_from_floats(scores))

    DataFrame df = df_from_columns(col_names, cols)

    # Basic properties
    print(f"{df.nrows()}")
    print(f"{df.ncols()}")
    print(f"{df.has_column("age")}")
    print(f"{df.has_column("missing")}")

    # Column value access
    Column age_col = df.get_column("age")
    print(f"{age_col.value_as_str(0)}")
    print(f"{age_col.value_as_str(2)}")
    print(f"{age_col.dtype_name()}")

    Column name_col = df.get_column("name")
    print(f"{name_col.value_as_str(1)}")

    # head / tail
    DataFrame h = df.head(2)
    print(f"{h.nrows()}")
    DataFrame t = df.tail(1)
    print(f"{t.nrows()}")
    Column tc = t.get_column("name")
    print(f"{tc.value_as_str(0)}")

    # df_from_records
    Vector[String] hdrs = Vector[String]()
    hdrs.push("x")
    hdrs.push("y")
    Vector[Vector[String]] rows = Vector[Vector[String]]()
    Vector[String] r1 = Vector[String]()
    r1.push("1")
    r1.push("2")
    rows.push(r1)
    DataFrame dr = df_from_records(hdrs, rows)
    print(f"{dr.nrows()}")
    print(f"{dr.ncols()}")
