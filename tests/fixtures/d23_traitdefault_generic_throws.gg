# Fix-2 pin: `throws E` in a trait-default resolves through the SAME
# Self/trait-param bindings as the default sig's return/params. Valid
# propagation (equip binds E := String, caller throws String) must be
# accepted -- pre-fix `E` resolved in the CALLER's scope.
trait Risky[E]:
    int base(self)
    int risky(self, int x) throws E:
        if x < 0:
            throw "negative"
        return self.base() + x

struct S:
    int v

equip S with Risky[String]:
    int base(self):
        return self.v

int use(S s) throws String:
    return s.risky(5)

void main():
    S s = S(1)
    int y = use(s) catch (e): -1
    print(y)
