# Snag #35-followup: a throwing call as a list-literal element inside a
# propagating function. The element `to_n(sel)` peels to `int`, so the
# literal types as `Vector[int]`.
from std.collections import Vector

struct PErr:
    String msg

int to_n(int x) throws PErr:
    if x < 0:
        throw PErr("neg")
    return x

Vector[int] dispatch(int sel) throws PErr:
    Vector[int] xs = [to_n(sel)!, 5]
    return xs

void main():
    Vector[int] ok = dispatch(3)! catch (e): Vector[int]()
    print(ok.get(0).unwrap())
    print(ok.get(1).unwrap())
    Vector[int] err = dispatch(-1)! catch (e): Vector[int]()
    print(err.len())
