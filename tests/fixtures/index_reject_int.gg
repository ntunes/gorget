# Round XXIX Track A: `x[0]` on a primitive `int` REJECTS at check-time
# with `E_NotIndexable`. `int` is a scalar — indexing is nonsensical.
#
# Pre-fix: silent-accept + unchecked read.
# Post-fix: rejects — `is_indexable_intrinsic("int")` is false; the
# trait-registry gate has the final say.
int main():
    int x = 42
    int y = x[0]
    print(y)
    return 0
