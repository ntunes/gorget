from std.collections import Dict, Vector

void main():
    Dict[String, int] d1 = Dict[String, int]()
    d1.put("a", 1)
    d1.put("b", 2)

    Dict[String, int] d2 = Dict[String, int]()
    d2.put("b", 20)
    d2.put("c", 30)

    d1.update(d2)
    print(f"{d1.len()}")
    print(f"{d1.get("a").unwrap()}")
    print(f"{d1.get("b").unwrap()}")
    print(f"{d1.get("c").unwrap()}")

    # get_or
    int val = d1.get_or("a", 0)
    print(f"{val}")
    int missing = d1.get_or("z", 99)
    print(f"{missing}")
