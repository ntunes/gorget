# Test: async mutex contention — multiple tasks contending on the same mutex.
# Exercises the waiter queue in gorget_guard_release: when one task releases
# the lock, the next waiter is woken.

async void add_many(int &counter, int n):
    int i = 0
    while i < n:
        counter = counter + 1
        i = i + 1

async void main():
    shared int x = 0
    Task[void] t1 = spawn add_many(&x, 100)
    Task[void] t2 = spawn add_many(&x, 100)
    Task[void] t3 = spawn add_many(&x, 100)
    Task[void] t4 = spawn add_many(&x, 100)
    t1.await()
    t2.await()
    t3.await()
    t4.await()
    print(x)
