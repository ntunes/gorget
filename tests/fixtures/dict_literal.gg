from std.collections import Dict

void main():
    auto d = {"alice": 30, "bob": 25, "carol": 35}
    print("{d.len()}")
    print("{d.get("alice")}")
    print("{d.get("bob")}")
    print("{d.get("carol")}")

    # Empty dict with type hint
    Dict[str, int] empty = {}
    print("{empty.len()}")

    # Integer keys
    auto nums = {1: 100, 2: 200, 3: 300}
    print("{nums.get(2)}")
    print("{nums.len()}")
