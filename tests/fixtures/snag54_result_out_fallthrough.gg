# Snag #54: `Result` assigned in if/elif branches then `return out` — originally
# misdiagnosed as an exit-phi bug. Root cause was `Dict.get_or` with a String
# key already-typed as Ptr (callee param): `try_emit_dict_get_or` always
# AddressOf'd the key, producing **String for MapGet so the lookup missed and
# `if text.is_empty(): out = Ok(0.0)` fired. Fix: pass already-pointer keys
# through (same as Dict index / `.get`).

from std.conv import parse_float

enum E:
    Parse(String)

Result[float, E] eval_cell(Dict[String, String] raw, String addr):
    String text = raw.get_or(addr, "")
    Result[float, E] out = Error(E.Parse("empty"))
    if text.is_empty():
        out = Ok(0.0)
    else:
        match parse_float(text):
            case Ok(v):
                out = Ok(v)
            case Error(_):
                out = Error(E.Parse("bad"))
    return out

void main():
    Dict[String, String] raw = Dict[String, String]()
    raw["A1"] = "3"
    match eval_cell(raw, "A1"):
        case Ok(v):
            print(v)
        case Error(_):
            print("err")
