# Post-D25 panic-by-default: `INT_MIN / -1` panics `integer overflow`
# uncatchably (no fault-catch form remains; the D26 `/!` form would capture,
# but this fixture pins the plain `/` panic behavior).
void main():
    int imin = -9223372036854775807 - 1
    int neg1 = -1
    int r = imin / neg1
    print(f"{r}")
