enum Shape:
    Circle(float)
    Rect(float, float)
    Point()

float area(Shape s):
    match s:
        case Circle(r):
            return 3.14159 * r * r
        case Rect(w, h):
            return w * h
        case Point():
            return 0.0

void main():
    Shape c = Circle(2.0)
    Shape r = Rect(3.0, 4.0)
    Shape p = Point()
    print("{area(c)}")
    print("{area(r)}")
    print("{area(p)}")
