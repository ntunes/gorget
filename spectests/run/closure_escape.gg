#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/closure_escape.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "15\n8\n21\n12\n"
#!end
int(int) make_adder(int x):
    return (int y): x + y

int(int) make_multiplier(int x):
    auto f = (int y): x * y
    return f

void main():
    auto add5 = make_adder(5)
    print(f"{add5(10)}")
    print(f"{add5(3)}")
    auto mul3 = make_multiplier(3)
    print(f"{mul3(7)}")
    print(f"{mul3(4)}")
