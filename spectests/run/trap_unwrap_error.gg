#!spectest
# mode: run
# adjudicator: ggdef
# since: spec-v0.1
# features: [trap]
# doc: |
#   Trap registry (D11): `.unwrap()` on an `Error` Traps `T_UnwrapError` (an
#   UNcatchable trap) and exits 101. Output before the trap is preserved.
# expect:
#   exit: 101
#   stdout: "unwrapping\n"
#   trap: T_UnwrapError
#!end

void main():
    print("unwrapping")
    Result[int, String] r = Error("bad")
    print(r.unwrap())
