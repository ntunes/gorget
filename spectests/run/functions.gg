#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/functions.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "7\n10\n120\n"
#!end
int add(int a, int b):
    return a + b

int double(int x): x * 2

int factorial(int n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

void main():
    int result = add(3, 4)
    print(f"{result}")
    int d = double(5)
    print(f"{d}")
    int f = factorial(5)
    print(f"{f}")
