#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/string_reassign_loop.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "aaa\nbbb\nccc\n"
#!end
String join_lines(Vector[String] lines):
    if lines.len() == 0:
        return ""
    String result = lines.get(0).unwrap()
    int i = 1
    while i < lines.len():
        String next = lines.get(i).unwrap()
        result = result + "\n" + next
        i = i + 1
    return result

void main():
    Vector[String] lines = ["aaa", "bbb", "ccc"]
    print(join_lines(lines))
