#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/print_temp_loop_accumulation.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "4500\ntrue\nfalse\ntrue\n"
#!end
# Print-temp leak class, loop-accumulation shape: each iteration
# synthesizes a bool-str temp (format-assign path) — pre-fix the leak grew
# linearly with the iteration count; post-fix every temp is freed after
# its consuming call. The trailing print loop covers the printf path
# inside a loop as well.
void main():
    int i = 0
    int total = 0
    while i < 1000:
        bool even = i % 2 == 0
        String t = f"{even}"
        total = total + t.len()
        i = i + 1
    print(total)
    int j = 0
    while j < 3:
        print(j % 2 == 0)
        j = j + 1
