#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/tuple_index_fstring.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "1\n2\n3\na=2\n40\n"
#!end
# Nested tuple-index access inside f-string interpolation.
#
# F-string interpolation re-parses the `{...}` body through the same parser
# path (parse_format_string_interp_exprs), so it shares the same lexer. Before
# the fix, `f"{nested.1.0}"` re-parsed `1.0` as a float, the tuple-access parse
# errored, and the literal-fallback silently printed the text verbatim. With
# the lexer split, the interpolated nested index now evaluates correctly.
void main():
    auto nested = (1, (2, 3))
    print(f"{nested.0}")        # 1
    print(f"{nested.1.0}")      # 2
    print(f"{nested.1.1}")      # 3

    # The hazard from the brief: a `.N.0` whose last index is 0 (looks most
    # float-like). Must print 2, not the verbatim text.
    print(f"a={nested.1.0}")    # a=2

    # 3-deep inside an f-string composes too.
    auto deep = (0, (0, (40, 41)))
    print(f"{deep.1.1.0}")      # 40
