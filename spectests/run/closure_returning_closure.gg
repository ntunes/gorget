#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/closure_returning_closure.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "8\n13\n"
#!end
int(int) make_adder(int n):
    return (int x): x + n

void main():
    auto add5 = make_adder(5)
    auto add10 = make_adder(10)
    print(add5(3))
    print(add10(3))
