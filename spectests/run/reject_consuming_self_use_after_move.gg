#!spectest
# mode: run
# adjudicator: ggdef
# since: spec-v0.1
# features: [move, liveness]
# doc: |
#   Static use-after-move via a `!self`-consuming method (verdict = elaborate ∘ eval).
#   `c.with_width(1920)` consumes the receiver `c` (the method takes `!self`), so the
#   later `print(c.title)` reads a moved-out place. The flow-sensitive liveness gate
#   rejects BEFORE eval with E_UseAfterMove — stdout stays EXACTLY empty (the program
#   never ran, which IS the verdict), exit 1. This is the consuming-self sibling of
#   reject_use_after_move.gg; flipping the expected `reject:` code must make every
#   lane MISMATCH (Core #6/#8).
# expect:
#   exit: 1
#   stdout: ""
#   reject: E_UseAfterMove
#!end

struct Config:
    int width
    String title

equip Config:
    Config with_width(!self, int w):
        return Config(w, self.title)

void main():
    Config c = Config(800, "game")
    Config c2 = c.with_width(1920)
    print(c.title)
