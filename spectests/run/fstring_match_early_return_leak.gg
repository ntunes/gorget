#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/fstring_match_early_return_leak.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "first: alpha\nsecond: beta\nlen: 2\n"
#!end
# Print-temp leak class, match-arm-early-return shape: an f-string interp
# temp born inside a match arm that returns must be dropped exactly once on
# the early-return path — registration at birth + drop elaboration handle
# the divergent control flow, no per-arm special case.
String classify(Vector[String] v, int n):
    match n:
        case 0:
            return f"first: {v.get(0).unwrap()}"
        case 1:
            return f"second: {v.get(1).unwrap()}"
        else:
            return f"len: {v.len()}"

void main():
    Vector[String] v = ["alpha", "beta"]
    print(classify(v, 0))
    print(classify(v, 1))
    print(classify(v, 7))
