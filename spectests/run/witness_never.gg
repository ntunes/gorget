#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/witness_never.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "s = hello\nv.len() = 2\n"
#!end
# WITNESS: loop-body conditional source-mutation, DEAD branch.
# `s` borrows v[0]; the push is gated on a condition that is NEVER true.
# Eager-clone today: 1 clone in the bind block (before the loop). LAZY target: 0.
# Output must be unchanged: s = hello, v.len() = 2.
void main():
    Vector[String] v = ["hello", "world"]
    String s = v.get(0).unwrap()
    int i = 0
    while i < 2:
        if i == 999999:
            v.push("filler")
        i = i + 1
    print(f"s = {s}")
    print(f"v.len() = {v.len()}")
