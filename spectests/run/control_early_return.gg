from std.collections import Vector

int find_first_even(Vector[int] nums):
    for n in nums:
        if n % 2 == 0:
            return n
    return -1

void main():
    Vector[int] a = [1, 3, 5, 4, 6]
    Vector[int] b = [1, 3, 5, 7]
    print(find_first_even(a))
    print(find_first_even(b))
