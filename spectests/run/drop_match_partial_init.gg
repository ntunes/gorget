#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/drop_match_partial_init.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "consume r1\ndrop r1\nafter-match\n---\nkeep r2\nafter-match\ndrop r2\n---\ndefault r3\nafter-match\ndrop r3\n"
#!end
# Match where some arms move-out the local resource and others don't —
# the post-match drop sees a per-path view of initialization.
#
# Arm semantics:
#   case 1: consume(!r) — slot ends Uninit
#   case 2: read r      — slot stays Init
#   else:   ignore r    — slot stays Init
# At post-match drop, the dataflow joins → MaybeInit → flag-based drop.

struct R:
    String name

equip R with Drop:
    void drop(!self):
        String n = self.name
        print(f"drop {n}")

void consume(R !r):
    print(f"consume {r.name}")

void process(int code):
    R r = R(f"r{code}")
    match code:
        case 1:
            consume(!r)
        case 2:
            print(f"keep {r.name}")
        else:
            print(f"default {r.name}")
    print("after-match")

void main():
    process(1)
    print("---")
    process(2)
    print("---")
    process(3)
