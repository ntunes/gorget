#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/match_string_literal.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "greeting\nfarewell\nempty\nother: world\n"
#!end
void classify(String s):
    match s:
        case "hello":
            print("greeting")
        case "bye":
            print("farewell")
        case "":
            print("empty")
        else:
            print(f"other: {s}")

void main():
    classify("hello")
    classify("bye")
    classify("")
    classify("world")
