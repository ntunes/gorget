#!spectest
# mode: run
# adjudicator: ggdef
# since: spec-v0.1
# features: [trap]
# doc: |
#   Trap registry (D11): `.unwrap()` on a `None` Traps `T_UnwrapNone` (an
#   UNcatchable trap) and exits 101. Output before the trap is preserved.
# expect:
#   exit: 101
#   stdout: "unwrapping\n"
#   trap: T_UnwrapNone
#!end

void main():
    print("unwrapping")
    Option[int] b = None
    print(b.unwrap())
