#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/control_flow.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "positive\n0\n1\n2\n0\n1\n2\n3\n4\n"
#!end
void main():
    int x = 5

    if x > 0:
        print("positive")
    elif x < 0:
        print("negative")
    else:
        print("zero")

    int i = 0
    while i < 3:
        print(f"{i}")
        i += 1

    for j in 0..5:
        print(f"{j}")
