#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/borrow_field_basic.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "99\n42\n"
#!end
# Phase 1 of borrow-fields: Ref[T] as a struct field type.
# Tests that Ref[T] fields are 8-byte pointers at the IR/LIR level,
# that construction coerces a pattern-extracted Ref to the field, and
# that reading the field auto-derefs to the pointee value for printing.
# No borrow checking yet — Phase 1 is unsafe-valid.

struct Holder[T]:
    Ref[T] target
    int cursor

int main():
    Vector[int] v = [42, 2, 3]
    Option[Ref[int]] got = v.get(0)
    match got:
        case Some(r):
            Holder[int] h = Holder[int](r, 99)
            print(h.cursor)
            print(h.target)
        case None():
            print(-1)
    return 0
