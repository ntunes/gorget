#   exit: 0
#   stdout: "11\nsay \"hi\"\nback\\slash\n11\n"
#!end
void main():
    String s = "hello\tworld"
    print(s.len())
    String q = "say \"hi\""
    print(q)
    String bs = "back\\slash"
    print(bs)
    String nl = "line1\nline2"
    print(nl.len())
