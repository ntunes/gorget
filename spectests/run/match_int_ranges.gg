#!spectest
# mode: run
# adjudicator: ggdef
# doc: migrated from tests/fixtures/match_int_ranges.gg (run_gg pair)
# expect:
#   exit: 0
#   stdout: "perfect\nA\nB\nother\n"
#!end
String grade(int score):
    match score:
        case 100:
            return "perfect"
        case 90:
            return "A"
        case 80:
            return "B"
        else:
            return "other"

void main():
    print(grade(100))
    print(grade(90))
    print(grade(80))
    print(grade(50))
