+/// THROWAWAY SCOUT PROBE — print per-function decl-count savings to stderr.
+fn coalesce_probe(
+    func: &LirFunction,
+    val_types: &[Option<LirType>],
+    v_used: &[bool],
+    sn: &HashMap<u32, String>,
+    val_c_type_override: &[Option<String>],
+) {
+    let nblocks = func.blocks.len();
+    if nblocks == 0 { return; }
+    // block index by BlockId.0
+    let mut idx_of: HashMap<u32, usize> = HashMap::new();
+    for (i, b) in func.blocks.iter().enumerate() { idx_of.insert(b.id.0, i); }
+
+    // succ/pred adjacency
+    let mut succ: Vec<Vec<usize>> = vec![Vec::new(); nblocks];
+    for (i, b) in func.blocks.iter().enumerate() {
+        for s in b.terminator.successors() {
+            if let Some(&j) = idx_of.get(&s.0) { succ[i].push(j); }
+        }
+    }
+
+    // Per-block use/def sets at value granularity, plus phi handling.
+    // def[b] = block params defined in b + inst dsts in b.
+    // use[b] (upward-exposed) = values used before any def in b (within b),
+    //   PLUS terminator block-args are treated as used at end of b (phi).
+    let nval = v_used.len();
+    let mut def: Vec<Vec<bool>> = vec![vec![false; nval]; nblocks];
+    let mut upward_use: Vec<Vec<bool>> = vec![vec![false; nval]; nblocks];
+
+    for (i, b) in func.blocks.iter().enumerate() {
+        let d = &mut def[i];
+        let u = &mut upward_use[i];
+        // block params are defs at the very top
+        for (vid, _) in &b.params {
+            if (vid.0 as usize) < nval { d[vid.0 as usize] = true; }
+        }
+        for inst in &b.insts {
+            for used in inst.uses() {
+                let k = used.0 as usize;
+                if k < nval && !d[k] { u[k] = true; }
+            }
+            if let Some(dst) = inst.dst() {
+                let k = dst.0 as usize;
+                if k < nval { d[k] = true; }
+            }
+        }
+        // terminator uses (incl. block-args): used at end, after all defs
+        for used in b.terminator.uses() {
+            let k = used.0 as usize;
+            if k < nval && !d[k] { u[k] = true; }
+        }
+    }
+
+    // live_in/live_out fixpoint (backward)
+    let mut live_in: Vec<Vec<bool>> = vec![vec![false; nval]; nblocks];
+    let mut live_out: Vec<Vec<bool>> = vec![vec![false; nval]; nblocks];
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for i in (0..nblocks).rev() {
+            // live_out = union of live_in of successors
+            let mut new_out = vec![false; nval];
+            for &s in &succ[i] {
+                for k in 0..nval { if live_in[s][k] { new_out[k] = true; } }
+            }
+            // live_in = use ∪ (live_out − def)
+            let mut new_in = vec![false; nval];
+            for k in 0..nval {
+                if upward_use[i][k] || (new_out[k] && !def[i][k]) { new_in[k] = true; }
+            }
+            if new_out != live_out[i] { live_out[i] = new_out; changed = true; }
+            if new_in != live_in[i] { live_in[i] = new_in; changed = true; }
+        }
+    }
+
+    // Compute a global "live range" per value as the SET OF BLOCKS where it is
+    // live (live_in OR defined-in OR used-in OR live_out). Two values may share
+    // a C slot only if their block-live-sets are DISJOINT and their C types
+    // match. This is a COARSE (per-block) approximation — finer (per-inst)
+    // coalescing would save more, so this is a LOWER BOUND on the real yield.
+    let mut live_blocks: Vec<Vec<usize>> = vec![Vec::new(); nval];
+    for i in 0..nblocks {
+        for k in 0..nval {
+            if !v_used[k] { continue; }
+            if live_in[i][k] || live_out[i][k] || def[i][k] || upward_use[i][k] {
+                live_blocks[k].push(i);
+            }
+        }
+    }
+
+    // C type string per value (mirrors the real decl logic, coarsely).
+    let ctype_of = |k: usize| -> String {
+        if let Some(Some(ovr)) = val_c_type_override.get(k) { return ovr.clone(); }
+        match val_types.get(k).and_then(|t| t.as_ref()) {
+            Some(ty) => { let ts = c_type_named(ty, sn); if ts == "void" { "void*".to_string() } else { ts } }
+            None => "void*".to_string(),
+        }
+    };
+
+    // Greedy interval-graph coloring per C type: a value reuses an existing
+    // slot iff its block-live-set is disjoint from every value already in it.
+    let mut total_used = 0usize;
+    let mut by_type: HashMap<String, Vec<usize>> = HashMap::new();
+    for k in 0..nval {
+        if !v_used[k] { continue; }
+        total_used += 1;
+        by_type.entry(ctype_of(k)).or_default().push(k);
+    }
+    let mut coalesced_decls = 0usize;
+    for (_ty, vals) in &by_type {
+        // each "slot" holds a union of block-indices already assigned
+        let mut slots: Vec<std::collections::HashSet<usize>> = Vec::new();
+        for &k in vals {
+            let lb: std::collections::HashSet<usize> = live_blocks[k].iter().copied().collect();
+            let mut placed = false;
+            for slot in &mut slots {
+                if slot.is_disjoint(&lb) {
+                    slot.extend(lb.iter().copied());
+                    placed = true;
+                    break;
+                }
+            }
+            if !placed { slots.push(lb); }
+        }
+        coalesced_decls += slots.len();
+    }
+
+    if total_used >= 200 {
+        eprintln!(
+            "[coalesce] {} : used_locals={} coalesced_locals={} saved={} ({:.0}%)",
+            func.name, total_used, coalesced_decls,
+            total_used.saturating_sub(coalesced_decls),
+            if total_used > 0 { 100.0 * (total_used - coalesced_decls) as f64 / total_used as f64 } else { 0.0 },
+        );
+    }
+}
