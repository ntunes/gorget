+/// THROWAWAY SCOUT — liveness-based value-slot coalescing.
+/// Computes standard SSA value liveness (backward dataflow over the block CFG,
+/// block-args modelled as phi: arg live at end of pred, param live at start of
+/// successor), then greedily reuses one C local per (C-type) for values whose
+/// block-live-sets are disjoint. Returns, per value id, the coalesced slot
+/// index it maps to (None for unused), plus the per-slot (ctype, repr-value).
+/// COARSE per-block granularity = a LOWER BOUND on the real yield.
+fn coalesce_assign(
+    func: &LirFunction,
+    val_types: &[Option<LirType>],
+    v_used: &[bool],
+    sn: &HashMap<u32, String>,
+    val_c_type_override: &[Option<String>],
+) -> (Vec<Option<usize>>, Vec<(String, usize)>) {
+    let nval = v_used.len();
+    let nblocks = func.blocks.len();
+    let mut assign: Vec<Option<usize>> = vec![None; nval];
+    let mut slot_meta: Vec<(String, usize)> = Vec::new();
+    if nblocks == 0 { return (assign, slot_meta); }
+    let live_blocks = compute_live_blocks(func, v_used);
+    let ctype_of = |k: usize| -> String {
+        if let Some(Some(ovr)) = val_c_type_override.get(k) { return ovr.clone(); }
+        match val_types.get(k).and_then(|t| t.as_ref()) {
+            Some(ty) => { let ts = c_type_named(ty, sn); if ts == "void" { "void*".to_string() } else { ts } }
+            None => "void*".to_string(),
+        }
+    };
+    // Group by C type, greedily color within each group.
+    let mut by_type: HashMap<String, Vec<usize>> = HashMap::new();
+    for k in 0..nval {
+        if !v_used[k] { continue; }
+        by_type.entry(ctype_of(k)).or_default().push(k);
+    }
+    for (ty, vals) in &by_type {
+        let mut slots: Vec<(std::collections::HashSet<usize>, usize)> = Vec::new(); // (live-set, global slot idx)
+        for &k in vals {
+            let lb: std::collections::HashSet<usize> = live_blocks[k].iter().copied().collect();
+            let mut placed = None;
+            for (sl, gidx) in &mut slots {
+                if sl.is_disjoint(&lb) { sl.extend(lb.iter().copied()); placed = Some(*gidx); break; }
+            }
+            let gidx = match placed {
+                Some(g) => g,
+                None => {
+                    let g = slot_meta.len();
+                    slot_meta.push((ty.clone(), k));
+                    slots.push((lb, g));
+                    g
+                }
+            };
+            assign[k] = Some(gidx);
+        }
+    }
+    (assign, slot_meta)
+}
