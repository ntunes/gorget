+# Two projection paths under the SAME root OVERLAP iff one is a prefix of the
+# other (zip stops at the shorter). Disjoint siblings (`a` vs `b`) do NOT
+# overlap; an empty path (the whole binding) overlaps every sub-place.
+bool paths_overlap_vec(Vector[String] a, Vector[String] b):
+    int m = a.len()
+    if b.len() < m:
+        m = b.len()
+    int i = 0
+    while i < m:
+        if a.get(i).unwrap() != b.get(i).unwrap():
+            return false
+        i = i + 1
+    return true
