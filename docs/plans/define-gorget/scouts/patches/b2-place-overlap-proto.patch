+# The projection PATH (outer-to-inner field/tuple segments) of a place expr, or
+# None for a non-place (fresh temp, literal, `.clone()`, `.get()`). Tuple fields
+# parse as EFieldAccess with numeric-string names ("0"), so no special case is
+# needed. EIndex COLLAPSES to the collection root (an index borrow is from the
+# collection itself — conservative); `x[a..b]` (a slice) is NOT a place. Mirrors
+# ggdef `ast_place` / Rust `find_root_def_id_with_path`.
+Option[Vector[String]] place_projection_path(Expr e):
+    match e:
+        case EIdentifier(_):
+            return Some(Vector[String]())
+        case ESelfExpr():
+            return Some(Vector[String]())
+        case EFieldAccess(obj, fname):
+            match place_projection_path((*obj).expr):
+                case Some(inner):
+                    Vector[String] path = Vector[String]()
+                    for s in inner:
+                        path.push(s)
+                    path.push(fname)
+                    return Some(path)
+                else:
+                    return None()
+        case EIndex(obj, index):
