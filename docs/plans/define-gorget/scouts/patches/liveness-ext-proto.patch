+# ═══════════════════════════════════════════════════════════════════════════
+# LIVENESS / USE-AFTER-MOVE pass (scout prototype) — mirrors Rust
+# src/semantic/safety/origins.rs check_move(468)/check_use(25) + the
+# merge_branch_states(568) join logic. The self-host had NO move-tracker, so it
+# accepted every use-after-move / double-move that Rust gg + ggdef reject
+# (ggdef `Slot::Moved`→IllFormed, eval.rs:745). Closes the divergence for the
+# two primary move shapes:
+#   • CallArg.ownership == OWN_MOVE  (`f(!x)`)               — ast.gg CallArg
+#   • EMove wrapping a place         (`S y = !x`, `return !x`) — parser.gg:2496
+# Move-state is NAME-keyed (B2: `self` is not resolved; place_root_name returns
+# "self"). moved[root] = the move site's span.start; presence = moved (Rust
+# VarState::Moved). NOT modeled (under-detect, never a false positive):
+# `!self`-consuming method receivers, ConsumeCallable vars, closure captures.
+
+# Rust check_use (origins.rs:25): a read of a moved place is use-after-move.
+void live_check_use(String name, Span span, Dict[String, int] &moved, ResolveContext &ctx):
+    if moved.contains(name):
+        ctx.diagnostics.push(Diagnostic.error(span, DkUseAfterMove(), f"use of `{name}` after it was moved"))
+
+# Re-init a binding to Live (Rust mark_live): a fresh `SVarDecl`/`SAssign` of the
+# whole binding makes it usable again. Isolated in a SMALL helper on purpose —
+# the discarded `Dict[_,int].remove` result is an `Option[int]`, and threading it
+# through the large `check_liveness_stmt` frame tripped a latent Rust-gg
+# C-backend coalesce miscompile (Option[int] slot stored an int32 0). Keeping the
+# discard in a tiny function sidesteps the coalesce path. (Bug filed as a finding.)
+void live_reinit(Dict[String, int] &moved, String name):
+    if moved.contains(name):
+        moved.remove(name)
+
+# Rust check_move (origins.rs:468): mark a move site; a second move of an
+# already-moved place is a double move. Only whole-binding locals/params/self
+# are tracked (Rust's DkVariable filter); a non-place move (`!f()`) has no root.
+void live_mark_move(SpannedExpr place, Dict[String, int] &moved, ScopeTable &scopes, ResolveContext &ctx):
+    String root = place_root_name(place.expr)
+    if root == "<place>":
+        return
+    bool trackable = root == "self"
+    if not trackable:
+        if place_root_def_spanned(place, scopes, ctx) is Some(rdid):
+            match scopes.get_def(rdid).kind:
+                case DkVariable():
+                    trackable = true
+                else:
+                    pass
+    if not trackable:
+        return
+    if moved.contains(root):
+        ctx.diagnostics.push(Diagnostic.error(place.span, DkUseAfterMove(), f"`{root}` moved more than once (double move)"))
+        return
+    moved.set(root, place.span.start)
+
+# A branch whose last stmt is a control-flow exit never reaches the join, so its
+# move-state is excluded from the merge (Rust merge_branch_states filters
+# `s.diverges`, origins.rs:574). Divergence is RECURSIVE: an `if`/`match` whose
+# every arm diverges also diverges (Rust sets BranchState.diverges when all
+# merged branches diverge). Over-reporting divergence only under-detects (never
+# a false positive), so this is purely anti-over-rejection.
+bool live_stmts_diverge(Vector[Stmt] stmts):
+    if stmts.len() == 0:
+        return false
+    return live_stmt_diverges(stmts.get(stmts.len() - 1).unwrap())
+
+bool live_stmt_diverges(Stmt s):
+    match s:
+        case SReturn(_):
+            return true
+        case SThrow(_):
+            return true
+        case SBreak():
+            return true
+        case SContinue():
+            return true
+        case SIf(_cond, body, else_branches):
+            # Diverges iff the then-body AND every else-branch body diverge AND
+            # there is an unconditional else (else the no-branch path falls through).
+            if not live_stmts_diverge(body):
+                return false
+            bool has_unconditional_else = false
+            for eb in else_branches:
+                if not live_stmts_diverge(eb.body):
+                    return false
+                if eb.condition is None:
+                    has_unconditional_else = true
+            return has_unconditional_else
+        case SMatch(_scrut, arms):
+            # A match is exhaustive (typecheck enforces it), so it diverges iff
+            # every arm body diverges.
+            if arms.len() == 0:
+                return false
+            for arm in arms:
+                if not live_stmts_diverge(arm.body):
+                    return false
+            return true
+        else:
+            return false
+
+# Walk one alternative branch on a fresh copy of the pre-branch state (`moved`);
+# if it reaches the join, fold its NEW moves into `acc`. The union across
+# branches is "moved in any branch → moved after" (Rust merge, origins.rs:609).
+void live_branch(Vector[Stmt] body, Dict[String, int] &moved, Dict[String, int] &acc, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
+    Dict[String, int] b = moved.clone()
+    check_liveness_stmts(body, &b, &scopes, &types, &ctx)
+    if live_stmts_diverge(body):
+        return
+    for k in b.keys():
+        if not acc.contains(k):
+            acc.set(k, b.get(k).unwrap())
+
+# Commit an accumulated branch-union into the live state (moved-in-any).
+void live_commit(Dict[String, int] acc, Dict[String, int] &moved):
+    for k in acc.keys():
+        if not moved.contains(k):
+            moved.set(k, acc.get(k).unwrap())
+
+void check_liveness_stmts(Vector[Stmt] stmts, Dict[String, int] &moved, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
+    for s in stmts:
+        check_liveness_stmt(s, &moved, &scopes, &types, &ctx)
+
+void check_liveness_stmt(Stmt s, Dict[String, int] &moved, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
+    match s:
+        case SVarDecl(_stype, name, init_expr, _line, _col, _flags):
+            check_liveness_expr(init_expr, &moved, &scopes, &types, &ctx)
+            # Re-init: a fresh binding of `name` makes it live again (Rust mark_live).
+            live_reinit(&moved, name)
+        case SAssign(target, value):
+            check_liveness_expr(value, &moved, &scopes, &types, &ctx)
+            match target.expr:
+                case EIdentifier(nm):
+                    # Whole-binding rebind → live again.
+                    live_reinit(&moved, nm)
+                else:
+                    # Field/index write (`p.f = ...`) reads the root.
+                    check_liveness_expr(target, &moved, &scopes, &types, &ctx)
+        case SCompoundAssign(target, _op, value):
+            check_liveness_expr(target, &moved, &scopes, &types, &ctx)
+            check_liveness_expr(value, &moved, &scopes, &types, &ctx)
+        case SExpr(sexpr):
+            check_liveness_expr(sexpr, &moved, &scopes, &types, &ctx)
+        case SReturn(opt_expr):
+            if opt_expr is Some(sexpr):
+                check_liveness_expr(sexpr, &moved, &scopes, &types, &ctx)
+        case SThrow(sexpr):
+            check_liveness_expr(sexpr, &moved, &scopes, &types, &ctx)
+        case SBreak():
+            pass
+        case SContinue():
+            pass
+        case SPass():
+            pass
+        case SMeta():
+            pass
+        case SMetaFor(_vars, iter_e, body):
+            check_liveness_expr(iter_e, &moved, &scopes, &types, &ctx)
+            Dict[String, int] mfc = moved.clone()
+            check_liveness_stmts(body, &mfc, &scopes, &types, &ctx)
+        case SMetaIf(cond, body, else_branches):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+            Dict[String, int] mi_acc = Dict[String, int]()
+            live_branch(body, &moved, &mi_acc, &scopes, &types, &ctx)
+            for eb in else_branches:
+                if eb.condition is Some(c):
+                    check_liveness_expr(c, &moved, &scopes, &types, &ctx)
+                live_branch(eb.body, &moved, &mi_acc, &scopes, &types, &ctx)
+            live_commit(mi_acc, &moved)
+        case SMetaConst(_name, value):
+            check_liveness_expr(value, &moved, &scopes, &types, &ctx)
+        case SMetaForMatch(_vars, scrut, arms):
+            check_liveness_expr(scrut, &moved, &scopes, &types, &ctx)
+            for arm in arms:
+                Dict[String, int] mfm = moved.clone()
+                check_liveness_stmts(arm.body, &mfm, &scopes, &types, &ctx)
+        case SMetaMatch(scrut, meta_arms, default_body):
+            check_liveness_expr(scrut, &moved, &scopes, &types, &ctx)
+            for ma in meta_arms:
+                check_liveness_expr(ma.case_value, &moved, &scopes, &types, &ctx)
+                Dict[String, int] mmc = moved.clone()
+                check_liveness_stmts(ma.body, &mmc, &scopes, &types, &ctx)
+            Dict[String, int] mmd = moved.clone()
+            check_liveness_stmts(default_body, &mmd, &scopes, &types, &ctx)
+        case SMetaWhile(cond, body):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+            Dict[String, int] mwc = moved.clone()
+            check_liveness_stmts(body, &mwc, &scopes, &types, &ctx)
+        case SFor(_pat, iter_e, body, _flags, else_body):
+            check_liveness_expr(iter_e, &moved, &scopes, &types, &ctx)
+            # Loop body: walk on a discarded clone (catches intra-iteration
+            # UAM/double-move; loop-body moves do not escape to after the loop).
+            Dict[String, int] for_body = moved.clone()
+            check_liveness_stmts(body, &for_body, &scopes, &types, &ctx)
+            check_liveness_stmts(else_body, &moved, &scopes, &types, &ctx)
+        case SWhile(cond, body, else_body):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+            Dict[String, int] wh_body = moved.clone()
+            check_liveness_stmts(body, &wh_body, &scopes, &types, &ctx)
+            check_liveness_stmts(else_body, &moved, &scopes, &types, &ctx)
+        case SLoop(body):
+            Dict[String, int] lo_body = moved.clone()
+            check_liveness_stmts(body, &lo_body, &scopes, &types, &ctx)
+        case SIf(cond, body, else_branches):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+            Dict[String, int] if_acc = Dict[String, int]()
+            live_branch(body, &moved, &if_acc, &scopes, &types, &ctx)
+            for eb in else_branches:
+                if eb.condition is Some(c):
+                    check_liveness_expr(c, &moved, &scopes, &types, &ctx)
+                live_branch(eb.body, &moved, &if_acc, &scopes, &types, &ctx)
+            live_commit(if_acc, &moved)
+        case SMatch(scrut, arms):
+            check_liveness_expr(scrut, &moved, &scopes, &types, &ctx)
+            Dict[String, int] m_acc = Dict[String, int]()
+            for arm in arms:
+                if arm.guard is Some(g):
+                    check_liveness_expr(g, &moved, &scopes, &types, &ctx)
+                live_branch(arm.body, &moved, &m_acc, &scopes, &types, &ctx)
+            live_commit(m_acc, &moved)
+        case SWith(e, _name, body):
+            check_liveness_expr(e, &moved, &scopes, &types, &ctx)
+            check_liveness_stmts(body, &moved, &scopes, &types, &ctx)
+        case SAssert(cond, _msg):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+        case SAssertReturn(cond, _msg):
+            check_liveness_expr(cond, &moved, &scopes, &types, &ctx)
+        case SNamedScope(_name, body):
+            check_liveness_stmts(body, &moved, &scopes, &types, &ctx)
+        case SSelect(arms):
+            for sa in arms:
+                match sa.op:
+                    case SORecv(_n, _i, e):
+                        check_liveness_expr(e, &moved, &scopes, &types, &ctx)
+                    case SOSend(chan, val):
+                        check_liveness_expr(chan, &moved, &scopes, &types, &ctx)
+                        check_liveness_expr(val, &moved, &scopes, &types, &ctx)
+                Dict[String, int] sel = moved.clone()
+                check_liveness_stmts(sa.body, &sel, &scopes, &types, &ctx)
+        case SOnError(body):
+            check_liveness_stmts(body, &moved, &scopes, &types, &ctx)
+        case SItem(_item):
+            pass
+        case SSnapshot(_name, _kind, e):
+            check_liveness_expr(e, &moved, &scopes, &types, &ctx)
+
+# A move consumes the whole place; do not also count it as a read. `!f()` (a
+# non-place move) has no root — walk its sub-exprs for nested uses instead.
+void live_move_operand(SpannedExpr place, Dict[String, int] &moved, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
+    if place_root_name(place.expr) == "<place>":
+        check_liveness_expr(place, &moved, &scopes, &types, &ctx)
+    else:
+        live_mark_move(place, &moved, &scopes, &ctx)
+
+# PART B: is `e` a ConsumeCallable-typed value? A call `f()` where `f` is
+# ConsumeCallable CONSUMES `f` (single-owner-by-design carve-out — no clone
+# path). Mirrors Rust `is_consume_callable_var` (helpers.rs:423). Typed axis
+# (layering rule 2): matches the RTConsumeCallableTrait / boxed-ConsumeCallable
+# ResolvedType — never a name/shape heuristic.
+bool live_is_consume_callable(SpannedExpr e, ScopeTable scopes, TypeTable &types, ResolveContext &ctx):
+    int t = infer_expr_type(e, scopes, &types, &ctx)
+    if t < 0 or t >= types.types.len():
+        return false
+    ResolvedType rt = get_rtype_at(types.types, t)
+    match rt:
+        case RTConsumeCallableTrait(_):
+            return true
+        case RTBoxedCallable(kind_name, _):
+            return kind_name == "ConsumeCallable"
+        else:
+            return false
+
+void check_liveness_expr(SpannedExpr expr, Dict[String, int] &moved, ScopeTable &scopes, TypeTable &types, ResolveContext &ctx):
+    match expr.expr:
+        case EIntLiteral(_):
+            pass
+        case EFloatLiteral(_):
+            pass
+        case EBoolLiteral(_):
+            pass
+        case EStringLiteral(_, _):
+            pass
+        case ECharLiteral(_):
+            pass
+        case ENoneLiteral():
+            pass
+        case EIdentifier(name):
+            live_check_use(name, expr.span, &moved, &ctx)
+        case ESelfExpr():
+            live_check_use("self", expr.span, &moved, &ctx)
+        case EIt():
+            pass
+        case EBinaryOp(left, _op, right):
+            check_liveness_expr(*left, &moved, &scopes, &types, &ctx)
+            check_liveness_expr(*right, &moved, &scopes, &types, &ctx)
+        case EUnaryOp(_op, operand):
+            check_liveness_expr(*operand, &moved, &scopes, &types, &ctx)
+        case ECall(callee, args, _targs):
+            # PART B: a call to a ConsumeCallable-typed variable consumes it (the
+            # call IS the terminal use — mirror Rust check_expr.rs:186-200). Marking
+            # via live_mark_move both records the move AND catches a second call
+            # (`f(); f()`) as a double-move, so we skip the plain use-read when
+            # consumed (else the double call would double-report).
+            bool live_consumed = false
+            match (*callee).expr:
+                case EIdentifier(_):
+                    if live_is_consume_callable(*callee, scopes, &types, &ctx):
+                        live_mark_move(*callee, &moved, &scopes, &ctx)
+                        live_consumed = true
+                else:
+                    pass
+            if not live_consumed:
+                check_liveness_expr(*callee, &moved, &scopes, &types, &ctx)
+            for a in args:
+                if a.ownership == OWN_MOVE:
+                    live_move_operand(a.value, &moved, &scopes, &types, &ctx)
+                else:
+                    check_liveness_expr(a.value, &moved, &scopes, &types, &ctx)
+        case EMethodCall(receiver, method_name, args, _targs):
+            check_liveness_expr(*receiver, &moved, &scopes, &types, &ctx)
+            for a in args:
+                if a.ownership == OWN_MOVE:
+                    live_move_operand(a.value, &moved, &scopes, &types, &ctx)
+                else:
+                    check_liveness_expr(a.value, &moved, &scopes, &types, &ctx)
+            # PART B: a `!self`-consuming method consumes the receiver root. Resolve
+            # the callee method's self-sigil (self_ownership == OWN_MOVE == !self)
+            # and mark the receiver moved AFTER the receiver read (method reads self,
+            # then consumes it — a later use is a use-after-move). Mirror Rust
+            # check_expr.rs:387-403: only a bare-place receiver participates (a temp
+            # method-chain receiver has no trackable root). Reuses the same
+            # resolve_method_full path as reject_amp_self_mutator (typecheck.gg:936).
+            if place_root_name((*receiver).expr) != "<place>":
+                int live_recv_ty = infer_expr_type(*receiver, scopes, &types, &ctx)
+                MethodResolution live_mr = resolve_method_full(live_recv_ty, method_name, scopes, &types)
+                if live_mr.found and live_mr.sig.self_ownership == OWN_MOVE:
+                    live_mark_move(*receiver, &moved, &scopes, &ctx)
+        case EFieldAccess(object, _field):
+            check_liveness_expr(*object, &moved, &scopes, &types, &ctx)
+        case EIndex(object, index):
+            check_liveness_expr(*object, &moved, &scopes, &types, &ctx)
+            check_liveness_expr(*index, &moved, &scopes, &types, &ctx)
+        case ERange(opt_start, opt_end, _incl):
+            if opt_start is Some(b):
+                check_liveness_expr(*b, &moved, &scopes, &types, &ctx)
+            if opt_end is Some(b):
+                check_liveness_expr(*b, &moved, &scopes, &types, &ctx)
+        case EIf(cond, then_body, elif_branches):
+            check_liveness_expr(*cond, &moved, &scopes, &types, &ctx)
+            Dict[String, int] eif_acc = Dict[String, int]()
+            live_branch(then_body, &moved, &eif_acc, &scopes, &types, &ctx)
+            for br in elif_branches:
+                if br.condition is Some(c):
+                    check_liveness_expr(c, &moved, &scopes, &types, &ctx)
+                live_branch(br.body, &moved, &eif_acc, &scopes, &types, &ctx)
+            live_commit(eif_acc, &moved)
+        case EMatch(scrutinee, arms):
+            check_liveness_expr(*scrutinee, &moved, &scopes, &types, &ctx)
+            Dict[String, int] em_acc = Dict[String, int]()
+            for arm in arms:
+                if arm.guard is Some(g):
+                    check_liveness_expr(g, &moved, &scopes, &types, &ctx)
+                live_branch(arm.body, &moved, &em_acc, &scopes, &types, &ctx)
+            live_commit(em_acc, &moved)
+        case EClosure(_params, body):
+            Dict[String, int] cl = Dict[String, int]()
+            check_liveness_stmts(body, &cl, &scopes, &types, &ctx)
+        case EImplicitClosure(inner):
+            check_liveness_expr(*inner, &moved, &scopes, &types, &ctx)
+        case EArrayLiteral(elements):
+            for e in elements:
+                check_liveness_expr(e, &moved, &scopes, &types, &ctx)
+        case ETupleLiteral(elements):
+            for e in elements:
+                check_liveness_expr(e, &moved, &scopes, &types, &ctx)
