diff --git a/examples/d29_census.rs b/examples/d29_census.rs
new file mode 100644
index 00000000..b8ad355d
--- /dev/null
+++ b/examples/d29_census.rs
@@ -0,0 +1,114 @@
+// D29 CENSUS (throwaway): count throws-function DECLARATIONS per corpus by
+// parsing every .gg file with the real parser and walking the AST. Exact (no
+// double-counting), tolerant of parse failures (counts what parses; reports the
+// rest). Propagation-site counts come from the separate env-gated `gg check`
+// instrument (GG_D29_CENSUS) — declarations are purely syntactic and live here.
+//
+// Usage: cargo run --example d29_census -- <label>=<dir> [<label>=<dir> ...]
+
+use gorget::parser::ast::{Expr, FunctionBody, FunctionDef, Item, TraitItem, Type};
+use gorget::parser::Parser;
+use std::path::{Path, PathBuf};
+
+#[derive(Default)]
+struct Counts {
+    files: usize,
+    parse_fail: usize,
+    throws_decls: usize,     // functions with any throws clause (`throws`/`!`/`!:`)
+    throws_inferred: usize,  // subset: bare `!:` inferred-set spelling
+    fn_defs: usize,          // total function definitions (denominator)
+}
+
+fn is_inferred(t: &Type) -> bool {
+    matches!(t, Type::Named { name, .. } if name.node == "!inferred")
+}
+
+fn count_fn(f: &FunctionDef, c: &mut Counts) {
+    c.fn_defs += 1;
+    if let Some(t) = &f.throws {
+        c.throws_decls += 1;
+        if is_inferred(&t.node) {
+            c.throws_inferred += 1;
+        }
+    }
+    // Recurse into bodies is unnecessary for declaration counting (Gorget has no
+    // nested named fn items), but closures never carry throws so nothing to add.
+    let _ = &f.body;
+}
+
+fn walk_items(items: &[gorget::span::Spanned<Item>], c: &mut Counts) {
+    for it in items {
+        match &it.node {
+            Item::Function(f) => count_fn(f, c),
+            Item::Equip(eq) => {
+                for m in &eq.items {
+                    count_fn(&m.node, c);
+                }
+            }
+            Item::Trait(tr) => {
+                for ti in &tr.items {
+                    if let TraitItem::Method(f) = &ti.node {
+                        count_fn(f, c);
+                    }
+                }
+            }
+            Item::ExternBlock(eb) => {
+                for m in &eb.items {
+                    count_fn(&m.node, c);
+                }
+            }
+            Item::Module { items, .. } => walk_items(items, c),
+            _ => {}
+        }
+    }
+}
+
+fn gg_files(dir: &Path, out: &mut Vec<PathBuf>) {
+    if let Ok(rd) = std::fs::read_dir(dir) {
+        for e in rd.flatten() {
+            let p = e.path();
+            if p.is_dir() {
+                gg_files(&p, out);
+            } else if p.extension().map_or(false, |x| x == "gg") {
+                out.push(p);
+            }
+        }
+    }
+}
+
+fn main() {
+    // Silence the FunctionBody import so the module compiles cleanly.
+    let _ = FunctionBody::Declaration;
+    let _ = Expr::It;
+    for arg in std::env::args().skip(1) {
+        let (label, dir) = match arg.split_once('=') {
+            Some(x) => x,
+            None => continue,
+        };
+        let mut files = Vec::new();
+        gg_files(Path::new(dir), &mut files);
+        files.sort();
+        let mut c = Counts::default();
+        for f in &files {
+            c.files += 1;
+            let src = match std::fs::read_to_string(f) {
+                Ok(s) => s,
+                Err(_) => {
+                    c.parse_fail += 1;
+                    continue;
+                }
+            };
+            let mut parser = Parser::new(&src);
+            let module = parser.parse_module();
+            if !parser.errors.is_empty() {
+                c.parse_fail += 1;
+                // still walk what parsed
+            }
+            walk_items(&module.items, &mut c);
+        }
+        println!(
+            "[census] {:<22} files={:<5} parse_fail={:<4} fn_defs={:<6} throws_decls={:<5} (inferred={})",
+            label, c.files, c.parse_fail, c.fn_defs, c.throws_decls, c.throws_inferred
+        );
+    }
+}
diff --git a/examples/d29_corners.rs b/examples/d29_corners.rs
new file mode 100644
index 00000000..6252905c
--- /dev/null
+++ b/examples/d29_corners.rs
@@ -0,0 +1,151 @@
+// D29 collision-corner harness (throwaway). Parses each corner snippet with the
+// real parser and prints a compact AST sketch so each maximal-munch / lookahead
+// disposition is settled EMPIRICALLY. Expr snippets are wrapped in a function
+// body; def/type snippets are parsed as whole items.
+
+use gorget::parser::ast::{Expr, FunctionBody, Item, Module, Stmt, Type};
+use gorget::parser::Parser;
+use gorget::span::Spanned;
+
+fn sketch_expr(e: &Expr) -> String {
+    match e {
+        Expr::IntLiteral(n) => format!("{n}"),
+        Expr::Identifier(s) => s.clone(),
+        Expr::SelfExpr => "self".into(),
+        Expr::NoneLiteral => "None".into(),
+        Expr::Propagate { expr } => format!("Prop({})", sketch_expr(&expr.node)),
+        Expr::Move { expr } => format!("Move({})", sketch_expr(&expr.node)),
+        Expr::MutableBorrow { expr } => format!("Borrow({})", sketch_expr(&expr.node)),
+        Expr::Deref { expr } => format!("Deref({})", sketch_expr(&expr.node)),
+        Expr::Call { callee, args, .. } => format!(
+            "Call({},[{}])",
+            sketch_expr(&callee.node),
+            args.iter().map(|a| sketch_expr(&a.node.value.node)).collect::<Vec<_>>().join(",")
+        ),
+        Expr::MethodCall { receiver, method, args, .. } => format!(
+            "MCall({}.{}[{}])",
+            sketch_expr(&receiver.node),
+            method.node,
+            args.iter().map(|a| sketch_expr(&a.node.value.node)).collect::<Vec<_>>().join(",")
+        ),
+        Expr::FieldAccess { object, field } => {
+            format!("Field({}.{})", sketch_expr(&object.node), field.node)
+        }
+        Expr::OptionalChain { object, field } => {
+            format!("OptChain({}?.{})", sketch_expr(&object.node), field.node)
+        }
+        Expr::Index { object, index } => {
+            format!("Index({}[{}])", sketch_expr(&object.node), sketch_expr(&index.node))
+        }
+        Expr::BinaryOp { op, left, right } => {
+            format!("{:?}({},{})", op, sketch_expr(&left.node), sketch_expr(&right.node))
+        }
+        Expr::UnaryOp { op, operand } => format!("{:?}({})", op, sketch_expr(&operand.node)),
+        Expr::DefaultOp { lhs, rhs } => {
+            format!("Default({},{})", sketch_expr(&lhs.node), sketch_expr(&rhs.node))
+        }
+        Expr::Catch { .. } => "Catch(..)".into(),
+        Expr::Rethrow { .. } => "Rethrow(..)".into(),
+        other => format!("{:?}", std::mem::discriminant(other)),
+    }
+}
+
+fn first_tail_expr(m: &Module) -> Option<String> {
+    // Find `g` and return the sketch of its body's last return/expr.
+    for it in &m.items {
+        if let Item::Function(f) = &it.node {
+            match &f.body {
+                FunctionBody::Expression(e) => return Some(sketch_expr(&e.node)),
+                FunctionBody::Block(b) => {
+                    if let Some(Spanned { node: Stmt::Return(Some(e)), .. }) = b.stmts.last() {
+                        return Some(sketch_expr(&e.node));
+                    }
+                    if let Some(last) = b.stmts.last() {
+                        return Some(format!("stmt:{:?}", std::mem::discriminant(&last.node)));
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    None
+}
+
+fn parse_expr_corner(label: &str, expr_src: &str) {
+    let src = format!("int g() ! E:\n    return {expr_src}\n");
+    let mut p = Parser::new(&src);
+    let m = p.parse_module();
+    let errs = p.errors.len();
+    let sketch = first_tail_expr(&m).unwrap_or_else(|| "<none>".into());
+    println!(
+        "  {:<16} `{}`  =>  {}{}",
+        label, expr_src, sketch,
+        if errs > 0 { format!("   [PARSE-ERR x{errs}]") } else { String::new() }
+    );
+}
+
+fn throws_desc(t: &Option<Spanned<Type>>) -> String {
+    match t {
+        None => "throws=None".into(),
+        Some(Spanned { node: Type::Named { name, .. }, .. }) if name.node == "!inferred" => {
+            "throws=INFERRED(!:)".into()
+        }
+        Some(Spanned { node: Type::Named { name, .. }, .. }) => {
+            format!("throws=Explicit({})", name.node)
+        }
+        Some(_) => "throws=Explicit(<complex>)".into(),
+    }
+}
+
+fn parse_def_corner(label: &str, src: &str) {
+    let mut p = Parser::new(src);
+    let m = p.parse_module();
+    let errs = p.errors.len();
+    let mut desc = String::from("<no-fn>");
+    for it in &m.items {
+        if let Item::Function(f) = &it.node {
+            desc = format!("{} ({})", throws_desc(&f.throws), f.name.node);
+            break;
+        }
+    }
+    println!(
+        "  {:<20} `{}`  =>  {}{}",
+        label, src.replace('\n', "\\n"), desc,
+        if errs > 0 { format!("   [PARSE-ERR x{errs}]") } else { String::new() }
+    );
+}
+
+fn main() {
+    println!("== EXPRESSION collision corners ==");
+    parse_expr_corner("neq-munch", "a()!=b");
+    parse_expr_corner("neq-eqeq", "a()!==b");
+    parse_expr_corner("prop-then-neq", "a()! != b");
+    parse_expr_corner("prop-then-eq", "a()! == b");
+    parse_expr_corner("chain", "f()!.m()!");
+    parse_expr_corner("chain-field", "a.b()!.c");
+    parse_expr_corner("index-call", "v[i]()!");
+    parse_expr_corner("prop-default", "f()! ?? d");
+    parse_expr_corner("prop-optchain", "f()!?.field");
+    parse_expr_corner("nested-arg", "g(f()!)!");
+    parse_expr_corner("neg", "-f()!");
+    parse_expr_corner("prefix-move-post", "!x!");
+    parse_expr_corner("prop-call", "foo!(x)");
+    parse_expr_corner("plain-prop", "f()!");
+    parse_expr_corner("add-then-prop", "a + f()!");
+
+    println!("\n== SIGNATURE collision corners ==");
+    parse_def_corner("explicit-!E", "int f() ! E:\n    return 1\n");
+    parse_def_corner("inferred-!:", "int f()!:\n    return 1\n");
+    parse_def_corner("inferred-expr-body", "int f()!: 1 + 1\n");
+    parse_def_corner("legacy-throws", "int f() throws E:\n    return 1\n");
+    parse_def_corner("main-!int", "void main() ! int:\n    return 0\n");
+    parse_def_corner("explicit-expr-body", "int f() ! E: 1 + 1\n");
+    parse_def_corner("nonthrows", "int f():\n    return 1\n");
+    parse_def_corner("explicit-generic-err", "int f() ! AppError[int]:\n    return 1\n");
+
+    println!("\n== FUNCTION-TYPE collision corners ==");
+    parse_def_corner("throwing-callable", "void h(Callable[int(int)!] cb):\n    return\n");
+    parse_def_corner("throwing-fntype-param", "void h(int(int)! cb):\n    return\n");
+    parse_def_corner("throwing-fntype-expl", "void h(Callable[int(int)! E] cb):\n    return\n");
+    parse_def_corner("nonthrow-fntype", "void h(int(int) cb):\n    return\n");
+}
