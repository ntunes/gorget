+                // Drop Copy bare readers (value snapshots).
+                let x_copy_reader = x.own == ast::Ownership::Borrow && x.is_copy;
+                let y_copy_reader = y.own == ast::Ownership::Borrow && y.is_copy;
+                if x_copy_reader || y_copy_reader {
