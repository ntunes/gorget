+            if d.is_drop_tainted:
+                return true
+            # Handle types: copying the handle never duplicates a drop.
+            if d.name == "Channel" or d.name == "Shared" or d.name == "Weak" or d.name == "Mutex":
+                return false
+            for a in args:
+                if is_drop_tainted_type(a, scopes, types):
+                    return true
+            return false
+        case RTTuple(elems):
+            for e in elems:
+                if is_drop_tainted_type(e, scopes, types):
+                    return true
+            return false
+        case RTArray(elem, _size):
+            return is_drop_tainted_type(elem, scopes, types)
+        case RTSlice(elem):
+            return is_drop_tainted_type(elem, scopes, types)
