from std.collections import Vector

struct Acc:
    int total
    Vector[int] buf

equip Acc with Drop:
    void drop(!self):
        print(f"drop Acc {self.total}")

equip Acc with Add[Acc]:
    Acc add(self, Acc other):
        Vector[int] b = []
        b.push(self.total + other.total)
        return Acc(self.total + other.total, b)

Acc mk(int n):
    Vector[int] b = []
    b.push(n)
    return Acc(n, b)

Acc grow(Vector[Acc] &v):
    int i = 0
    while i < 200:
        v.push(mk(1000 + i))
        i += 1
    return mk(5)

void main():
    Vector[Acc] v = [mk(1), mk(2)]
    v[0] += grow(&v)
    print(f"{v[0].total}")
