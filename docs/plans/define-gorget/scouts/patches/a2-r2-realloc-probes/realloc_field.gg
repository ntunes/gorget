from std.collections import Vector

struct Acc:
    int total
    Vector[int] buf

equip Acc with Drop:
    void drop(!self):
        print(f"drop Acc {self.total}")

equip Acc with Add[Acc]:
    Acc add(self, Acc other):
        Vector[int] b = []
        b.push(self.total + other.total)
        return Acc(self.total + other.total, b)

Acc mk(int n):
    Vector[int] b = []
    b.push(n)
    return Acc(n, b)

struct Holder:
    Vector[Acc] v

Acc grow(Holder &h):
    int i = 0
    while i < 200:
        h.v.push(mk(1000 + i))
        i += 1
    return mk(5)

void main():
    Holder h = Holder([mk(1), mk(2)])
    h.v[0] += grow(&h)
    print(f"{h.v[0].total}")
