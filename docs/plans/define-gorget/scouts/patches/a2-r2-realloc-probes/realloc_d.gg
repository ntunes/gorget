from std.collections import Dict, Vector

struct Acc:
    int total
    Vector[int] buf

equip Acc with Drop:
    void drop(!self):
        print(f"drop Acc {self.total}")

equip Acc with Add[Acc]:
    Acc add(self, Acc other):
        Vector[int] b = []
        b.push(self.total + other.total)
        return Acc(self.total + other.total, b)

Acc mk(int n):
    Vector[int] b = []
    b.push(n)
    return Acc(n, b)

Acc growd(Dict[String, Acc] &d):
    int i = 0
    while i < 200:
        d[f"k{1000 + i}"] = mk(1000 + i)
        i += 1
    return mk(5)

void main():
    Dict[String, Acc] d = {}
    d["a"] = mk(1)
    d["b"] = mk(2)
    d["a"] += growd(&d)
    print(f"{d["a"].total}")
