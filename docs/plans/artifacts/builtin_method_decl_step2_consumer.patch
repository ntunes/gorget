+# Does `mname` on a `type_name` receiver return a non-owning VIEW (cap==0)
+# aliasing the receiver's buffer? Reads the typed `returns_view` flag from
+# BUILTIN_METHODS (single source of truth, mirrors Rust's `returns_view`).
+# Only the String family carries returns_view=true rows, so the prior
+# `recv_is_string` gate is subsumed — a non-String receiver matches no
+# view method. The result local MUST be tagged LoView so `op_consume`
+# materializes (OpClone) it at any owning consume position; otherwise the
+# view is stored by value and dangles once the receiver buffer is freed.
+bool builtin_view_method(String type_name, String mname):
+    match builtin_method_decl(type_name, mname):
+        case Some(d):
+            return d.returns_view
+        case None:
+            return false
