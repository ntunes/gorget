struct Item:
    String name

public static Vector[Item] TABLE = [Item("alpha"), Item("beta")]

void main():
    int n = TABLE.len()
    if n == 0:
        print("EMPTY-BUG")     # <-- Rust gg prints this: static array-init dropped
    else:
        print("OK")
    for item in TABLE:
        print(item.name)        # <-- never runs (TABLE is empty)
