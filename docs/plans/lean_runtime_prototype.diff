diff --git a/src/backend/c/runtime/runtime_preamble.c b/src/backend/c/runtime/runtime_preamble.c
index c62a581f..c8773497 100644
--- a/src/backend/c/runtime/runtime_preamble.c
+++ b/src/backend/c/runtime/runtime_preamble.c
@@ -355,6 +355,51 @@ typedef struct {
     void* env;
 } GorgetClosure;
 
+// ── Opt-in big-stack runner (lean-runtime: the 64MB stack need stays IN
+// THE PROGRAM SOURCE — only deep-recursion programs like the self-host
+// compiler pay for it; everyone else gets a plain thread-0 main). The
+// Gorget binding is `extern int run_with_stack(int bytes,
+// Callable[int()] work)` (std.thread). `work` is a no-arg int-returning
+// closure value — its 16-byte {fn_ptr, env} representation is passed by
+// pointer (the closure-param extern ABI pins Ptr: a `void*` to a
+// GorgetClosure; see is_closure_param in ir/lowering/mod.rs). The caller
+// must bind the closure to a `Callable[int()]` LOCAL first so its fn_ptr
+// is materialized (a closure literal passed directly is an empty struct —
+// its call target is resolved statically, not stored in fn_ptr). We
+// pthread_create with the requested stack (mmap'd, NOT RLIMIT_STACK-
+// bound), run the closure on it, join, and return its int result. On any
+// pthread setup failure we fall back to running on the current stack. ──
+typedef struct {
+    void* fn_ptr;
+    void* env;
+    int64_t ret;
+} __gorget_run_with_stack_ctx;
+
+static void* __gorget_run_with_stack_entry(void* arg) {
+    __gorget_run_with_stack_ctx* c = (__gorget_run_with_stack_ctx*)arg;
+    c->ret = ((int64_t(*)(void*))c->fn_ptr)(c->env);
+    return NULL;
+}
+
+static inline int64_t gorget_run_with_stack(int64_t bytes, void* work) {
+    GorgetClosure* cl = (GorgetClosure*)work;
+    __gorget_run_with_stack_ctx ctx;
+    ctx.fn_ptr = cl->fn_ptr;
+    ctx.env    = cl->env;
+    ctx.ret    = 0;
+    pthread_attr_t attr;
+    pthread_t tid;
+    size_t want = bytes > 0 ? (size_t)bytes : (size_t)0;
+    if (pthread_attr_init(&attr) != 0 ||
+        pthread_attr_setstacksize(&attr, want) != 0 ||
+        pthread_create(&tid, &attr, __gorget_run_with_stack_entry, &ctx) != 0) {
+        // Best-effort fallback: run on the current stack.
+        return ((int64_t(*)(void*))ctx.fn_ptr)(ctx.env);
+    }
+    pthread_join(tid, NULL);
+    return ctx.ret;
+}
+
