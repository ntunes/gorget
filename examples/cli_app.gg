from xtd.cli import CliParser
from std.collections import Vector

void main():
    CliParser cli = CliParser.new("myapp", "A sample CLI application")
    cli.add_flag("--verbose", "-v", "Enable verbose output")
    cli.add_option("--output", "-o", "Output file path", "out.txt")
    cli.add_positional("input", "Input file")

    # Simulate args: --verbose -o report.txt input.csv
    Vector[String] argv = Vector[String]()
    argv.push("--verbose")
    argv.push("-o")
    argv.push("report.txt")
    argv.push("input.csv")

    Result[bool, String] parsed = cli.parse(argv)
    match parsed:
        case Ok(_):
            if cli.has("verbose"):
                print("Verbose mode enabled")
            print(f"Output: {cli.get("output")}")
            Vector[String] pos = cli.positionals()
            if pos.len() > 0:
                print(f"Input: {pos[0]}")
        case Error(e):
            print(f"Parse error: {e}")
