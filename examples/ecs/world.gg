# World — game world composing ECS building blocks
#
# Demonstrates: user-defined World struct with typed component storage,
# EntityPool + SparseSet composition, multi-component spawn/kill,
# game systems as methods operating on World via &self.

from std.collections import Vector
from gg.ecs import Entity, EntityPool, SparseSet
from components import Health
from components import Attack

struct World:
    EntityPool entities
    SparseSet[Health] health
    SparseSet[Attack] attacks
    SparseSet[int] teams
    SparseSet[str] names

equip World:
    Entity add(&self, str name, int hp, int damage, int team):
        Entity e = self.entities.create()
        self.health.insert(e, Health(hp, hp))
        self.attacks.insert(e, Attack(damage))
        self.teams.insert(e, team)
        self.names.insert(e, name)
        return e

    void kill(&self, Entity e):
        self.health.remove(e)
        self.attacks.remove(e)
        self.teams.remove(e)
        self.names.remove(e)
        self.entities.destroy(e)

    bool is_alive(self, Entity e):
        if self.health.has(e) == false:
            return false
        Health h = self.health.get(e)
        return h.hp > 0

    int team_alive_count(self, int team):
        int n = 0
        for e in self.health:
            Health h = self.health.get(e)
            if h.hp > 0 and self.teams.get(e) == team:
                n = n + 1
        return n

    void combat_round(&self):
        int max_id = self.entities.max_id()
        for i in 0..max_id:
            Entity ei = Entity(i, 0)
            if self.is_alive(ei) == false:
                continue
            if self.attacks.has(ei) == false:
                continue
            Attack atk = self.attacks.get(ei)
            str attacker_name = self.names.get(ei)
            int attacker_team = self.teams.get(ei)
            # Find target: living enemy with highest HP, tie-break: lowest ID
            int target_id = -1
            int best_hp = -1
            for j in 0..max_id:
                if j == i:
                    continue
                Entity ej = Entity(j, 0)
                if self.is_alive(ej) == false:
                    continue
                if self.teams.has(ej) == false:
                    continue
                if self.teams.get(ej) == attacker_team:
                    continue
                Health h = self.health.get(ej)
                if h.hp > best_hp:
                    best_hp = h.hp
                    target_id = j
            if target_id == -1:
                continue
            Entity target = Entity(target_id, 0)
            # Apply damage
            Health target_health = self.health.get(target)
            int new_hp = target_health.hp - atk.damage
            self.health.set(target, Health(new_hp, target_health.max_hp))
            str target_name = self.names.get(target)
            if new_hp <= 0:
                print("{attacker_name} attacks {target_name} for {atk.damage} damage (defeated)")
            else:
                print("{attacker_name} attacks {target_name} for {atk.damage} damage ({new_hp} HP left)")

    void remove_dead(&self):
        Vector[Entity] dead = Vector[Entity]()
        for e in self.health:
            Health h = self.health.get(e)
            if h.hp <= 0:
                dead.push(e)
        for i in 0..dead.len():
            Entity e = dead.get(i).unwrap()
            self.kill(e)

    void print_state(self):
        for e in self.health:
            str name = self.names.get(e)
            Health h = self.health.get(e)
            print("{name}: {h.hp}/{h.max_hp} HP")
