# Arena-backed Linked List with Iterable Support
#
# This example demonstrates:
#   - Struct field access and mutation via &self
#   - Parallel-array arena (no nested generics needed)
#   - Iterable[T] / Iterator[T] trait split
#   - For-loop desugaring over custom types
#   - Iterator adapters: .fold(), .map()
#
# The arena uses two parallel vectors:
#   values[i] = the data stored at node i
#   nexts[i]  = the index of the next node (-1 = null)
# This avoids Option[Box[Node[T]]] which requires nested generics.

from std.collections import Vector

struct LinkedList:
    Vector[int] values
    Vector[int] nexts
    int head
    int len

struct LinkedListIter:
    Vector[int] collected
    int cursor

equip LinkedList:
    # Prepend a value at the front of the list.
    # Allocates a new arena slot, links it before the current head.
    void push_front(&self, int val):
        int idx = self.values.len()
        self.values.push(val)
        self.nexts.push(self.head)
        self.head = idx
        self.len = self.len + 1

    # Return the number of elements.
    int length(self):
        return self.len

    # Read the value at the head of the list.
    int peek(self):
        return self.values[self.head]

# Iterator collects values into a fresh vector (avoids aliased non-Copy arena copies).
equip LinkedListIter with Iterator[int]:
    Option[int] next(&self):
        if self.cursor >= self.collected.len():
            return None
        int val = self.collected[self.cursor]
        self.cursor = self.cursor + 1
        return Some(val)

# Iterable creates a fresh iterator each time by traversing the arena.
equip LinkedList with Iterable[int]:
    LinkedListIter iter(&self):
        Vector[int] ll_vals = Vector[int]()
        int cur = self.head
        while cur != -1:
            ll_vals.push(self.values[cur])
            cur = self.nexts[cur]
        return LinkedListIter(ll_vals, 0)

void main():
    # Construct an empty list (head=-1)
    LinkedList list = LinkedList(Vector[int](), Vector[int](), -1, 0)

    # Build list: 10 -> 20 -> 30
    list.push_front(30)
    list.push_front(20)
    list.push_front(10)

    print(list.length())
    print(list.peek())

    # Iterate with a for-loop (uses Iterable[int].iter → Iterator[int].next)
    for x in list:
        print(x)

    # Sum all elements using fold
    int total = list.iter().fold(0, (int acc, int x): acc + x)
    print(total)

    # Double each element using map
    Vector[int] doubled = list.iter().map((int x): x * 2)
    print(doubled.get(0).unwrap())
    print(doubled.get(1).unwrap())
    print(doubled.get(2).unwrap())
