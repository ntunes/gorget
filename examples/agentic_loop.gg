# Agentic loop -- interactive chat with Anthropic or OpenAI-compatible APIs
#
# Provider detection via environment variables:
#   ANTHROPIC_API_KEY          -> Anthropic Messages API
#   OPENAI_API_KEY             -> OpenAI Chat Completions API
#   OPENAI_BASE_URL + OPENAI_API_KEY -> any OpenAI-compatible endpoint
#
# Optional:
#   MODEL  -> override the default model name

from gg.http import http_post, HttpResponse
from gg.json import Json, json_parse, json_stringify
from std.collections import Vector, Dict
from std.os import getenv
from std.conv import int_to_str
from std.io import input, stdin_eof

# Build the JSON messages array from parallel role/content vectors.
Json build_messages(Vector[str] loop_roles, Vector[str] loop_contents):
    Vector[Json] loop_msgs = Vector[Json]()
    int loop_mi = 0
    while loop_mi < loop_roles.len():
        Dict[str, Json] loop_msg = Dict[str, Json]()
        loop_msg.put("role", Str(loop_roles.get(loop_mi).unwrap()))
        loop_msg.put("content", Str(loop_contents.get(loop_mi).unwrap()))
        loop_msgs.push(Obj(loop_msg))
        loop_mi = loop_mi + 1
    return Arr(loop_msgs)

void main():
    # ── Detect provider ──────────────────────────────────────
    str anthropic_key = getenv("ANTHROPIC_API_KEY")
    str openai_key = getenv("OPENAI_API_KEY")
    str openai_base = getenv("OPENAI_BASE_URL")
    str model_override = getenv("MODEL")

    bool use_anthropic = anthropic_key != ""
    bool have_provider = use_anthropic or openai_key != ""

    if not have_provider:
        print("Set ANTHROPIC_API_KEY or OPENAI_API_KEY to begin.")
    else:
        # ── Configure endpoint and headers ───────────────────
        str api_url = ""
        str model = ""
        Dict[str, str] api_headers = Dict[str, str]()

        if use_anthropic:
            api_url = "https://api.anthropic.com/v1/messages"
            model = "claude-sonnet-4-5-20250929"
            if model_override != "":
                model = model_override
            api_headers.put("x-api-key", anthropic_key)
            api_headers.put("anthropic-version", "2023-06-01")
            api_headers.put("content-type", "application/json")
        else:
            if openai_base != "":
                str oai_url = openai_base + "/chat/completions"
                api_url = oai_url
            else:
                api_url = "https://api.openai.com/v1/chat/completions"
            model = "gpt-4o"
            if model_override != "":
                model = model_override
            str auth_val = "Bearer " + openai_key
            api_headers.put("Authorization", auth_val)
            api_headers.put("content-type", "application/json")

        # ── Conversation state ───────────────────────────────
        Vector[str] roles = Vector[str]()
        Vector[str] contents = Vector[str]()

        if use_anthropic:
            str banner = "Connected to Anthropic (" + model + ")"
            print(banner)
        else:
            str banner = "Connected to OpenAI-compatible (" + model + ")"
            print(banner)
        print("Type 'quit' to exit.\n")

        # ── Main loop ────────────────────────────────────────
        loop:
            str user_input = input("> ")
            if user_input == "quit" or user_input == "exit" or stdin_eof():
                break
            if user_input == "":
                continue

            roles.push("user")
            contents.push(user_input)

            # Build request body
            Dict[str, Json] req_body = Dict[str, Json]()
            req_body.put("model", Str(model))
            req_body.put("max_tokens", Int(4096))
            req_body.put("messages", build_messages(roles, contents))

            str body_json = json_stringify(Obj(req_body))

            Result[HttpResponse, str] resp = http_post(api_url, body_json, api_headers)

            if resp.is_err():
                str err_msg = "Connection error: " + resp.unwrap_err()
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            HttpResponse http_resp = resp.unwrap()

            if http_resp.status_code != 200:
                str err_msg = "API error " + int_to_str(http_resp.status_code) + ": " + http_resp.body_text
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            Result[Json, str] parsed = json_parse(http_resp.body_text)
            if parsed.is_err():
                str err_msg = "JSON error: " + parsed.unwrap_err()
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            Json resp_json = parsed.unwrap()

            # Extract assistant text (different response shapes)
            str assistant_text = ""
            if use_anthropic:
                # Anthropic: { "content": [{ "text": "..." }] }
                assistant_text = resp_json.get("content").at(0).get("text").as_str()
            else:
                # OpenAI: { "choices": [{ "message": { "content": "..." } }] }
                assistant_text = resp_json.get("choices").at(0).get("message").get("content").as_str()

            str display = "\n" + assistant_text + "\n"
            print(display)

            roles.push("assistant")
            contents.push(assistant_text)
