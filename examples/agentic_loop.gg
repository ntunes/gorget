# Agentic loop -- interactive chat with Anthropic or OpenAI-compatible APIs
#
# Provider detection via environment variables:
#   ANTHROPIC_API_KEY          -> Anthropic Messages API
#   OPENAI_API_KEY             -> OpenAI Chat Completions API
#   OPENAI_BASE_URL + OPENAI_API_KEY -> any OpenAI-compatible endpoint
#
# Optional:
#   MODEL  -> override the default model name

from xtd.http import post, HttpResponse
from xtd.json import Json, json_parse, json_stringify
from std.collections import Vector, Dict
from std.os import getenv
from std.conv import int_to_str, ParseError
from std.io import input, stdin_eof

# Navigate an optional JSON node. `get`/`at` return `Option[Json]` because a
# key or index may be absent, and the two providers below answer with
# different shapes -- a missing branch is expected, not exceptional, so it
# degrades to `Null` (whose `as_str()` is the empty string).
Json or_null(Option[Json] node):
    return node.unwrap_or(Json.Null())

# Build the JSON messages array from parallel role/content vectors.
Json build_messages(Vector[String] loop_roles, Vector[String] loop_contents):
    Vector[Json] loop_msgs = Vector[Json]()
    int loop_mi = 0
    while loop_mi < loop_roles.len():
        Dict[String, Json] loop_msg = Dict[String, Json]()
        loop_msg.put("role", Str(loop_roles.get(loop_mi).unwrap()))
        loop_msg.put("content", Str(loop_contents.get(loop_mi).unwrap()))
        loop_msgs.push(Obj(loop_msg))
        loop_mi = loop_mi + 1
    return Arr(loop_msgs)

void main():
    # ── Detect provider ──────────────────────────────────────
    String anthropic_key = getenv("ANTHROPIC_API_KEY")
    String openai_key = getenv("OPENAI_API_KEY")
    String openai_base = getenv("OPENAI_BASE_URL")
    String model_override = getenv("MODEL")

    bool use_anthropic = anthropic_key != ""
    bool have_provider = use_anthropic or openai_key != ""

    if not have_provider:
        print("Set ANTHROPIC_API_KEY or OPENAI_API_KEY to begin.")
    else:
        # ── Configure endpoint and headers ───────────────────
        String api_url = ""
        String model = ""
        Dict[String, String] api_headers = Dict[String, String]()

        if use_anthropic:
            api_url = "https://api.anthropic.com/v1/messages"
            model = "claude-sonnet-4-5-20250929"
            if model_override != "":
                model = model_override
            api_headers.put("x-api-key", anthropic_key)
            api_headers.put("anthropic-version", "2023-06-01")
            api_headers.put("content-type", "application/json")
        else:
            if openai_base != "":
                String oai_url = openai_base + "/chat/completions"
                api_url = oai_url
            else:
                api_url = "https://api.openai.com/v1/chat/completions"
            model = "gpt-4o"
            if model_override != "":
                model = model_override
            String auth_val = "Bearer " + openai_key
            api_headers.put("Authorization", auth_val)
            api_headers.put("content-type", "application/json")

        # ── Conversation state ───────────────────────────────
        Vector[String] roles = Vector[String]()
        Vector[String] contents = Vector[String]()

        if use_anthropic:
            String banner = "Connected to Anthropic (" + model + ")"
            print(banner)
        else:
            String banner = "Connected to OpenAI-compatible (" + model + ")"
            print(banner)
        print("Type 'quit' to exit.\n")

        # ── Main loop ────────────────────────────────────────
        loop:
            String user_input = input("> ")
            if user_input == "quit" or user_input == "exit" or stdin_eof():
                break
            if user_input == "":
                continue

            roles.push("user")
            contents.push(user_input)

            # Build request body
            Dict[String, Json] req_body = Dict[String, Json]()
            req_body.put("model", Str(model))
            req_body.put("max_tokens", Int(4096))
            req_body.put("messages", build_messages(roles, contents))

            String body_json = json_stringify(Obj(req_body))

            Result[HttpResponse, String] resp = post(api_url, body_json, api_headers)

            if resp.is_error():
                String err_msg = "Connection error: " + resp.unwrap_error()
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            HttpResponse http_resp = resp.unwrap()

            if http_resp.status_code != 200:
                String err_msg = "API error " + int_to_str(http_resp.status_code) + ": " + http_resp.body_text
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            Result[Json, ParseError] parsed = json_parse(http_resp.body_text)
            if parsed.is_error():
                String err_msg = "JSON error: " + parsed.unwrap_error().display()
                print(err_msg)
                roles.pop()
                contents.pop()
                continue

            Json resp_json = parsed.unwrap()

            # Extract assistant text (different response shapes)
            String assistant_text = ""
            if use_anthropic:
                # Anthropic: { "content": [{ "text": "..." }] }
                Json content = or_null(resp_json.get("content"))
                Json block = or_null(content.at(0))
                assistant_text = or_null(block.get("text")).as_str()
            else:
                # OpenAI: { "choices": [{ "message": { "content": "..." } }] }
                Json choices = or_null(resp_json.get("choices"))
                Json choice = or_null(choices.at(0))
                Json message = or_null(choice.get("message"))
                assistant_text = or_null(message.get("content")).as_str()

            String display = "\n" + assistant_text + "\n"
            print(display)

            roles.push("assistant")
            contents.push(assistant_text)
