from std.fs import read_file, write_file
from std.os import args
from std.collections import Vector

String escape_html(String text):
    String r = text.replace("&", "&amp;")
    r = r.replace("<", "&lt;")
    r = r.replace(">", "&gt;")
    r = r.replace("\"", "&quot;")
    return r

String render_inline(String text):
    Vector[String] parts = Vector[String]()
    int i = 0
    int n = text.len()
    int seg_start = 0
    while i < n:
        String c = text.substring(i, i + 1)
        if c == "`":
            if seg_start < i:
                parts.push(escape_html(text.substring(seg_start, i)))
            Option[int] close_opt = text.substring(i + 1, n).index_of("`")
            if close_opt.is_none():
                parts.push("`")
                seg_start = i + 1
                i = i + 1
                continue
            int close = close_opt.unwrap()
            String code = text.substring(i + 1, i + 1 + close)
            parts.push("<code>" + escape_html(code) + "</code>")
            i = i + 1 + close + 1
            seg_start = i
            continue
        if c == "*" and i + 1 < n and text.substring(i + 1, i + 2) == "*":
            if seg_start < i:
                parts.push(escape_html(text.substring(seg_start, i)))
            Option[int] close_opt = text.substring(i + 2, n).index_of("**")
            if close_opt.is_none():
                parts.push("**")
                seg_start = i + 2
                i = i + 2
                continue
            int close = close_opt.unwrap()
            String bold = text.substring(i + 2, i + 2 + close)
            parts.push("<strong>" + render_inline(bold) + "</strong>")
            i = i + 2 + close + 2
            seg_start = i
            continue
        if c == "*":
            if seg_start < i:
                parts.push(escape_html(text.substring(seg_start, i)))
            Option[int] close_opt = text.substring(i + 1, n).index_of("*")
            if close_opt.is_none():
                parts.push("*")
                seg_start = i + 1
                i = i + 1
                continue
            int close = close_opt.unwrap()
            String em = text.substring(i + 1, i + 1 + close)
            parts.push("<em>" + render_inline(em) + "</em>")
            i = i + 1 + close + 1
            seg_start = i
            continue
        if c == "[":
            Option[int] close_bracket_opt = text.substring(i + 1, n).index_of("]")
            if close_bracket_opt.is_some():
                int close_bracket = close_bracket_opt.unwrap()
                int abs_cb = i + 1 + close_bracket
                if abs_cb + 1 < n and text.substring(abs_cb + 1, abs_cb + 2) == "(":
                    Option[int] close_paren_opt = text.substring(abs_cb + 2, n).index_of(")")
                    if close_paren_opt.is_some():
                        int close_paren = close_paren_opt.unwrap()
                        if seg_start < i:
                            parts.push(escape_html(text.substring(seg_start, i)))
                        String link_text = text.substring(i + 1, abs_cb)
                        String url = text.substring(abs_cb + 2, abs_cb + 2 + close_paren)
                        parts.push("<a href=\"" + escape_html(url) + "\">" + render_inline(link_text) + "</a>")
                        i = abs_cb + 2 + close_paren + 1
                        seg_start = i
                        continue
        i = i + 1
    if seg_start < n:
        parts.push(escape_html(text.substring(seg_start, n)))
    return "".join(parts)

bool is_table_separator(String line):
    String t = line.trim()
    if not t.starts_with("|"):
        return false
    int j = 0
    while j < t.len():
        String ch = t.substring(j, j + 1)
        if ch != "|" and ch != "-" and ch != ":" and ch != " ":
            return false
        j = j + 1
    return t.contains("-")

Vector[String] split_table_cells(String line):
    String t = line.trim()
    if t.starts_with("|"):
        t = t.substring(1, t.len())
    if t.ends_with("|"):
        t = t.substring(0, t.len() - 1)
    Vector[String] raw = t.split("|")
    Vector[String] cells = Vector[String]()
    int j = 0
    while j < raw.len():
        String cell = raw.get(j).unwrap()
        cells.push(cell.trim())
        j = j + 1
    return cells

Vector[String] parse_alignments(String sep_line):
    Vector[String] cells = split_table_cells(sep_line)
    Vector[String] aligns = Vector[String]()
    int j = 0
    while j < cells.len():
        String c = cells.get(j).unwrap()
        String ct = c.trim()
        bool left_colon = ct.starts_with(":")
        bool right_colon = ct.ends_with(":")
        if left_colon and right_colon:
            aligns.push("center")
        elif right_colon:
            aligns.push("right")
        else:
            aligns.push("left")
        j = j + 1
    return aligns

String table_cell(String tag, String content, String align):
    if align == "left":
        return "<" + tag + ">" + render_inline(content) + "</" + tag + ">"
    return "<" + tag + " style=\"text-align: " + align + "\">" + render_inline(content) + "</" + tag + ">"

(String, int) parse_table(Vector[String] lines, int start):
    Vector[String] out = Vector[String]()
    String sep = lines.get(start + 1).unwrap()
    Vector[String] aligns = parse_alignments(sep)
    String hdr_line = lines.get(start).unwrap()
    Vector[String] headers = split_table_cells(hdr_line)
    out.push("<table>")
    out.push("<thead><tr>")
    int h = 0
    while h < headers.len():
        String al = "left"
        if h < aligns.len():
            al = aligns.get(h).unwrap()
        String hcell = headers.get(h).unwrap()
        out.push(table_cell("th", hcell, al))
        h = h + 1
    out.push("</tr></thead>")
    out.push("<tbody>")
    int row = start + 2
    while row < lines.len():
        String rline = lines.get(row).unwrap()
        if not rline.contains("|"):
            break
        Vector[String] cells = split_table_cells(rline)
        out.push("<tr>")
        int ci = 0
        while ci < cells.len():
            String al = "left"
            if ci < aligns.len():
                al = aligns.get(ci).unwrap()
            String dcell = cells.get(ci).unwrap()
            out.push(table_cell("td", dcell, al))
            ci = ci + 1
        out.push("</tr>")
        row = row + 1
    out.push("</tbody></table>")
    String html = "\n".join(out)
    int consumed = row - start
    return (html, consumed)

String flush_paragraph(Vector[String] para_lines):
    if para_lines.is_empty():
        return ""
    String text = " ".join(para_lines)
    return "<p>" + render_inline(text) + "</p>"

bool is_hr_line(String line):
    String t = line.trim()
    if t.len() < 3:
        return false
    String first = t.substring(0, 1)
    if first != "-" and first != "*" and first != "_":
        return false
    int j = 0
    while j < t.len():
        String ch = t.substring(j, j + 1)
        if ch != first and ch != " ":
            return false
        j = j + 1
    return true

bool is_digit_str(String c):
    if c == "0":
        return true
    if c == "1":
        return true
    if c == "2":
        return true
    if c == "3":
        return true
    if c == "4":
        return true
    if c == "5":
        return true
    if c == "6":
        return true
    if c == "7":
        return true
    if c == "8":
        return true
    if c == "9":
        return true
    return false

bool all_digits(String s):
    if s.is_empty():
        return false
    int j = 0
    while j < s.len():
        String ch = s.substring(j, j + 1)
        if not is_digit_str(ch):
            return false
        j = j + 1
    return true

String level_str(int level):
    if level == 1:
        return "1"
    if level == 2:
        return "2"
    if level == 3:
        return "3"
    if level == 4:
        return "4"
    if level == 5:
        return "5"
    return "6"

String convert(String markdown):
    Vector[String] lines = markdown.split("\n")
    Vector[String] out = Vector[String]()
    Vector[String] para_lines = Vector[String]()
    bool in_code = false
    String code_lang = ""
    Vector[String] code_lines = Vector[String]()
    bool in_ul = false
    bool in_ol = false
    int i = 0
    while i < lines.len():
        String line = lines.get(i).unwrap()
        if in_code:
            String trimmed = line.trim()
            if trimmed.starts_with("```"):
                if code_lang.is_empty():
                    out.push("<pre><code>" + escape_html("\n".join(code_lines)) + "</code></pre>")
                else:
                    out.push("<pre><code class=\"language-" + code_lang + "\">" + escape_html("\n".join(code_lines)) + "</code></pre>")
                in_code = false
                code_lang = ""
                code_lines = Vector[String]()
            else:
                code_lines.push(line)
            i = i + 1
            continue
        if line.starts_with("```"):
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ul:
                out.push("</ul>")
                in_ul = false
            if in_ol:
                out.push("</ol>")
                in_ol = false
            in_code = true
            code_lang = line.substring(3, line.len()).trim()
            i = i + 1
            continue
        String trimmed = line.trim()
        if trimmed.is_empty():
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ul:
                out.push("</ul>")
                in_ul = false
            if in_ol:
                out.push("</ol>")
                in_ol = false
            i = i + 1
            continue
        if is_hr_line(line) and not line.starts_with("|"):
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ul:
                out.push("</ul>")
                in_ul = false
            if in_ol:
                out.push("</ol>")
                in_ol = false
            out.push("<hr>")
            i = i + 1
            continue
        if line.starts_with("#"):
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ul:
                out.push("</ul>")
                in_ul = false
            if in_ol:
                out.push("</ol>")
                in_ol = false
            int level = 0
            while level < line.len() and line.substring(level, level + 1) == "#":
                level = level + 1
            if level > 6:
                level = 6
            String heading = line.substring(level, line.len()).trim()
            String lvl = level_str(level)
            out.push("<h" + lvl + ">" + render_inline(heading) + "</h" + lvl + ">")
            i = i + 1
            continue
        if line.contains("|") and i + 1 < lines.len():
            String next_line = lines.get(i + 1).unwrap()
            if is_table_separator(next_line):
                String p = flush_paragraph(para_lines)
                if not p.is_empty():
                    out.push(p)
                para_lines = Vector[String]()
                if in_ul:
                    out.push("</ul>")
                    in_ul = false
                if in_ol:
                    out.push("</ol>")
                    in_ol = false
                (String, int) result = parse_table(lines, i)
                out.push(result._0)
                i = i + result._1
                continue
        if line.starts_with("- "):
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ol:
                out.push("</ol>")
                in_ol = false
            if not in_ul:
                out.push("<ul>")
                in_ul = true
            String item = line.substring(2, line.len())
            out.push("<li>" + render_inline(item) + "</li>")
            i = i + 1
            continue
        if line.len() >= 3:
            String first_ch = line.substring(0, 1)
            if is_digit_str(first_ch):
                Option[int] dot_pos_opt = line.index_of(". ")
                if dot_pos_opt.is_some():
                    int dot_pos = dot_pos_opt.unwrap()
                    String before_dot = line.substring(0, dot_pos)
                    if all_digits(before_dot):
                        String p = flush_paragraph(para_lines)
                        if not p.is_empty():
                            out.push(p)
                        para_lines = Vector[String]()
                        if in_ul:
                            out.push("</ul>")
                            in_ul = false
                        if not in_ol:
                            out.push("<ol>")
                            in_ol = true
                        String item = line.substring(dot_pos + 2, line.len())
                        out.push("<li>" + render_inline(item) + "</li>")
                        i = i + 1
                        continue
        if line.starts_with("> "):
            String p = flush_paragraph(para_lines)
            if not p.is_empty():
                out.push(p)
            para_lines = Vector[String]()
            if in_ul:
                out.push("</ul>")
                in_ul = false
            if in_ol:
                out.push("</ol>")
                in_ol = false
            String quote_text = line.substring(2, line.len())
            out.push("<blockquote><p>" + render_inline(quote_text) + "</p></blockquote>")
            i = i + 1
            continue
        if in_ul:
            out.push("</ul>")
            in_ul = false
        if in_ol:
            out.push("</ol>")
            in_ol = false
        para_lines.push(line)
        i = i + 1
    String p = flush_paragraph(para_lines)
    if not p.is_empty():
        out.push(p)
    if in_ul:
        out.push("</ul>")
    if in_ol:
        out.push("</ol>")
    if in_code:
        out.push("<pre><code>" + escape_html("\n".join(code_lines)) + "</code></pre>")
    return "\n".join(out)

void main():
    Vector[String] cli = args()
    if cli.len() < 2:
        print("Usage: md2html <input.md> [output.html]")
        print("  Converts Markdown to HTML")
    else:
        String input_path = cli.get(1).unwrap()
        String markdown = read_file(input_path)
        String html = convert(markdown)
        if cli.len() >= 3:
            String out_path = cli.get(2).unwrap()
            write_file(out_path, html)
            print(f"Wrote {out_path}")
        else:
            print(html)

test "escape_html handles entities":
    assert escape_html("<b>R&D</b>") == "&lt;b&gt;R&amp;D&lt;/b&gt;"
    assert escape_html("a\"b") == "a&quot;b"
    assert escape_html("plain") == "plain"

test "render_inline bold":
    assert render_inline("a **bold** b") == "a <strong>bold</strong> b"

test "render_inline italic":
    assert render_inline("an *italic* word") == "an <em>italic</em> word"

test "render_inline code":
    assert render_inline("use `fmt` here") == "use <code>fmt</code> here"

test "render_inline link":
    assert render_inline("[Go](https://go.dev)") == "<a href=\"https://go.dev\">Go</a>"

test "convert headings":
    assert convert("# Title") == "<h1>Title</h1>"
    assert convert("## Sub") == "<h2>Sub</h2>"
    assert convert("### Third") == "<h3>Third</h3>"

test "convert paragraph":
    String result = convert("Hello world")
    assert result == "<p>Hello world</p>"

test "convert code block":
    String md = "```python\nprint(1)\n```"
    String html = convert(md)
    assert html.contains("<pre><code class=\"language-python\">")
    assert html.contains("print(1)")

test "convert unordered list":
    String md = "- one\n- two\n- three"
    String html = convert(md)
    assert html.contains("<ul>")
    assert html.contains("<li>one</li>")
    assert html.contains("</ul>")

test "convert ordered list":
    String md = "1. first\n2. second"
    String html = convert(md)
    assert html.contains("<ol>")
    assert html.contains("<li>first</li>")
    assert html.contains("</ol>")

test "convert table":
    String md = "| A | B |\n|---|---|\n| 1 | 2 |"
    String html = convert(md)
    assert html.contains("<table>")
    assert html.contains("<th>A</th>")
    assert html.contains("<td>1</td>")
    assert html.contains("</table>")

test "convert horizontal rule":
    String html = convert("---")
    assert html == "<hr>"

test "convert blockquote":
    String html = convert("> Note this")
    assert html.contains("<blockquote>")
    assert html.contains("Note this")
