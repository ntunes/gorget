from gg.http import get, HttpResponse

void main():
    Result[HttpResponse, str] result = get("https://httpbin.org/get")
    match result:
        case Ok(resp):
            print(f"Status: {resp.status_code}")
            print(f"Body length: {resp.body_text.len()}")
        case Error(e):
            print(f"Error: {e}")
