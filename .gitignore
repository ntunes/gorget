.DS_Store
/target
# Generated C files and compiled binaries from `gg build`
tests/fixtures/*.c
# `**` not `*`: discovery accepts `examples/**/main.gg` at ANY depth, so a
# nested package's artifacts must be ignored at any depth too. (`examples/*/…`
# alone left `examples/a/b/main` visible while `examples/a/b/main.gg` was a
# perfectly legal entry point.)
examples/**/main.c
examples/**/main
# ...and the TOP-LEVEL half of the same thing. `gg build` has no output flag
# for a linked executable and writes beside the SOURCE, so `examples/foo.gg`
# builds to `examples/foo` + `examples/foo.c`. Expressed as a PROPERTY, not a
# name list: there is no non-broad glob for an EXTENSIONLESS binary, so a hand
# list would need one line per example and would silently miss the next one's
# binary — exactly the rot `examples_build_on_every_lane` exists to retire.
# The negations are load-bearing: a bare `examples/*` makes `git add
# examples/<new>.gg` REFUSE, and the new example then never enters the corpus.
# Placed here, ABOVE the LLVM-artifact patterns below, so those still win for
# `*.ll` / `__gorget_*` (last matching pattern wins in .gitignore).
examples/*
!examples/*.*
!examples/*/
examples/*.c
tests/fixtures/*_error
tests/fixtures/*_asan
tests/fixtures/*_dbg
tests/fixtures/yaml_parse
tests/fixtures/xml_roundtrip
tests/fixtures/test_traced
tests/fixtures/test_traced.trace.jsonl
tests/fixtures/test_traced.report.html
tests/fixtures/self_host_*/main
tests/fixtures/self_host_*/main.c
tests/fixtures/self_host_*/driver
tests/fixtures/self_host_*/driver.c
.gorget/
.claude/
.worktrees/
benchmarks/
fuzz/artifacts/
fuzz/corpus/
fuzz/target/
_test_output*

# Process core dumps
core
core.*

# Profiler outputs
callgrind.out.*
perf.data*

# LLVM backend intermediate artifacts (per-fixture runtime/user objects + IR)
**/__gorget_runtime*.c
**/__gorget_runtime*.o
**/__gorget_user*.o
*.ll

# LLVM backend emits *.ll into fixture dirs on manual --emit-llvm runs; never tracked.
tests/fixtures/**/*.ll

# `scripts/robustness_map.py` now imports `scripts/verdict.py` (one classifier,
# not three copies), so Python writes a bytecode cache beside them.
scripts/__pycache__/
