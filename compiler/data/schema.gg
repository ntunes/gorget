# compiler.data.schema — type definitions for the canonical resource +
# runtime-function table.
#
# Consumed by:
# - Self-host directly via `from compiler.data.schema import …`.
# - Rust via a hand-written mirror at `src/resource_schema.rs`. Any
#   field change to the RUST-PARSED surface — the `ResourceMetadata`
#   (`RESOURCES`) and `RuntimeFnDecl` (`RUNTIME_FNS`) rows that
#   `src/resources.rs` deserializes — MUST bump SCHEMA_VERSION in
#   resources.gg (and the matching `SCHEMA_VERSION_EXPECTED` in
#   `src/resources.rs`), or the Rust loader panics on the version
#   mismatch.
#
#   SELF-HOST-ONLY types are OUTSIDE this rule. `BuiltinMethodDecl` /
#   `BuiltinMethodEntry` and the `*_BUILTIN_METHODS` statics in
#   resources.gg are consumed only by the self-host lowerer
#   (`tests/fixtures/self_host_lowerer/lower.gg`); `src/resource_schema.rs`
#   has no mirror for them and `src/resources.rs` never parses them. Adding
#   or changing a field on these does NOT reach the Rust loader, so it must
#   NOT bump SCHEMA_VERSION — a one-sided bump would PANIC the otherwise-
#   unaffected Rust loader. (`is_mutating` on `BuiltinMethodDecl` was added
#   this way: self-host-only, no version bump. See `resources_load_clean`.)
#
# Scope discipline: every type in this file describes the static shape of
# a resource or runtime-function entry. No expression-level helpers, no
# operations — those belong in the consumer code. Keeping this file shaped
# as pure data definitions keeps the canonical surface small enough to
# audit at a glance.
#
# See `docs/devbook/13-ownership-in-ir.md` (Phase A, type axis) and
# `docs/devbook/18-runtime-abi.md` (the resource table) for the design.


# ── Lookup-key strategy ─────────────────────────────────────────────
#
# Resource entries are keyed by name patterns. Exact + Prefix is the
# closed set today; freeze on these two until a real consumer needs
# something more. Composite predicates (regex, suffix, conjunctions)
# are deliberately not supported — when a new consumer wants them, the
# discipline is to surface the gap, not to expand the schema speculatively.

enum MatchKind:
    MkExact(String)         # exact name match: "GorgetString"
    MkPrefix(String)        # starts_with match: "Vector__"


# ── Resource-metadata axes ──────────────────────────────────────────

enum CopySemantics:
    CsTrivial               # primitives / POD — no drop, bitwise copy
    CsResource              # owns heap data; needs drop + clone
    CsRefCounted            # ref-counted (Shared / Mutex / Channel / …)

enum CollectionKind:
    CkNotCollection
    CkVector                # Vector — push/pop at tail
    CkDeque                 # Deque — push/pop both ends; same GorgetArray runtime
    CkHeap                  # Heap — priority queue; same GorgetArray runtime
    CkDict                  # Dict / HashMap / GorgetMap
    CkOrderedSet            # Set — ORDERED unique elements (insertion-order preserving)
    CkHashSet               # HashSet / GorgetSet — UNORDERED unique elements
    # NOTE: the former single `CkSet` was split into the two typed variants
    # above so the ordered-vs-unordered decision reads a typed discriminator,
    # never a `starts_with("Set__")` name prefix (CLAUDE.md "No name matching").
    # Mirrors Rust's IR-level `CollectionKind::OrderedSet`/`Set` split
    # (src/ir/types.rs:162/164, assigned at the single producer
    # src/ir/lowering/builtins.rs:453/503). Both back the same `GorgetSet`
    # runtime; the variant only steers iteration order + the ctor fn.

enum BoxKind:
    BkNotBox
    BkRegularBox            # Box[T] for owned T
    BkTraitBox              # trait-object Box[dyn Trait]

# Closed set. Every variant must correspond to a LirType that an actual
# resource entry lowers to. Add only when a new resource appears that
# can't fit existing variants.
enum LirType:
    LtStructBase            # 16+ byte struct-by-value (GorgetString, GorgetArray, …)
    LtPtr                   # 8-byte pointer / opaque handle (Box, Mutex, …)

struct ResourceMetadata:
    String runtime_name              # C struct name; collection types
                                     # collapse to the backing runtime
                                     # ("GorgetArray" for Vector/Deque/Heap).
    int size_bytes                   # C ABI byte size of the runtime_name struct.
    LirType lir_type                 # LirType this resource lowers to.
    Option[String] drop_fn           # runtime symbol; None for trivial / non-droppable.
    Option[String] clone_fn          # runtime symbol; None for trivial / not cloneable.
    Option[String] materialize_fn    # CoW view→owned; None when no view distinction.
    CopySemantics copy_semantics
    CollectionKind collection_kind
    BoxKind box_kind
    bool opaque_handle               # Mutex / Channel / Thread / etc.
    Option[String] method_prefix     # C method-prefix for opaque / guard families
                                     # ("gorget_mutex", "gorget_channel", …).
                                     # None for collections that route via runtime_name.
    Option[String] c_typedef_name    # C typedef target when it diverges from
                                     # runtime_name; None means "use runtime_name".
                                     # Used at the C-emit boundary in
                                     # `emit_wrapper_typedef` for opaque-handle
                                     # families whose C spelling is `GorgetMutex*`,
                                     # `gorget_guard_t`, etc. — names the schema's
                                     # `runtime_name` ("Mutex", "Guard") does not
                                     # carry. See unified-resource-model.md §3.6.
    bool is_typed_constructor        # true for parameterized families with
                                     # `T(args)` user-code constructor shape
                                     # (Vector__T, Mutex__T, …). false for
                                     # runtime singletons, Heap__ (factory shape),
                                     # Box__ (uses runtime alloc helper), and
                                     # opaque types constructed via `T.new()`.

struct ResourceEntry:
    Vector[MatchKind] match_on       # any key in this list hits this entry;
                                     # supports aliases like ["String","Str","GorgetString"]
                                     # sharing one metadata payload.
    ResourceMetadata metadata


# ── Runtime-function axes ───────────────────────────────────────────
#
# Mirrors the typed shape already in `src/lir/runtime.rs` (CRuntimeType,
# AbiKind, SideEffects, RuntimeSig). Deliberately duplicated here rather
# than imported FROM `lir/runtime.rs` — the schema is upstream of the IR
# layer that consumes it; a schema that depended on its own consumer
# would be a layering inversion. The duplication retires when self-host
# replaces Rust (the LIR will read from compiler.data.schema directly).

enum CRuntimeType:
    TVoid
    TBool
    TI8
    TI16
    TI32
    TI64
    TU8
    TU16
    TU32
    TU64
    TF32
    TF64
    TSize                            # size_t — passed as i64; kept distinct from TI64 for clarity
    TPtr                             # opaque void*
    TVoidElem                        # pointer to a single collection element (same wire as TPtr)
    TCStr                            # const char* (same wire as TPtr)
    TStr                             # GorgetString by value (32 bytes)
    TArray                           # GorgetArray struct (64 bytes)
    TMap                             # GorgetMap struct
    TSet                             # GorgetSet struct
    TRegex                           # Regex handle struct
    TMatch                           # RegexMatch struct

enum AbiKind:
    AAuto                            # let the backend infer
    AScalar                          # int / float / bool by value
    APtr                             # raw pointer
    AOpaque                          # opaque handle (Mutex, Channel, …)
    AGorgetString                    # 32-byte struct, byval on x86_64
    AVoidElem                        # collection-element ABI marker
    ACStr                            # const char* (param expects null-terminated)
    AByValue                         # generic struct-by-value

enum SideEffects:
    FxPure                           # no reads / writes — CSE / DCE / fold-eligible
    FxReadOnly                       # reads heap or globals; cannot hoist past Mutates
    FxAllocates                      # may extend heap / arena
    FxMutates                        # mutates ≥ 1 argument
    FxIo                             # file / socket / stdio
    FxAborts                         # may abort or unwind; CF boundary
    FxConcurrent                     # locks / channels / atomics / threads
    FxUnknown                        # unclassified; treated as Mutates

struct RuntimeParam:
    CRuntimeType ty
    AbiKind abi

struct RuntimeFn:
    String c_name                    # exact C symbol; primary lookup key
    Vector[RuntimeParam] params
    CRuntimeType ret
    SideEffects side_effects
    bool returns_fresh               # true iff ALWAYS returns a fresh, independently
                                     # heap-allocated buffer not aliasing any input
                                     # (gorget_str_cat, gorget_int_to_str, …).
                                     # Distinct from FxAllocates which is coarse
                                     # may-allocate.


# ── Builtin-method axes ─────────────────────────────────────────────
#
# Typed declarations for the builtin methods that the lowerer's
# heuristic classifiers used to recognise by raw name-match lists
# (the CLAUDE.md "No name matching" item). Each declaration carries the
# semantic facts a name-match list used to imply, as typed columns:
#   - returns_view: the result is a non-owning VIEW into the receiver's
#     buffer (String slice/trim/…); the lowerer must tag the result
#     LoView so op_consume materialises (clones) it at an owning consume.
#   - owning_arg_positions: the argument indices (0-based, non-receiver)
#     that a collection mutator takes OWNERSHIP of. Per-(kind, method):
#     Vector set/insert own only idx 1 (idx 0 is the index arg); Dict
#     put/set own both 0 (key) and 1 (value); Set add owns idx 0.
#   - ret_kind: the builtin's return type category, for the lowerer's
#     name-based return-type inference fall-through.
#
# Two-table consumption (see compiler/data/resources.gg): the String
# builtins (keyed by name only, under a String-receiver gate) and the
# collection builtins (keyed by (CollectionKind, name)). The receiver
# class is the resolved CollectionKind from the resource table — NEVER a
# re-listed type-name alias set.

# Return-type category of a builtin method. Closed set; a tag the lowerer
# dispatches on instead of inlining the type-id construction. Only the
# categories the migrated String-return block needs are populated today
# (BrkString); the rest are reserved so a future port of the int/bool/
# collection arms has a home without re-shaping the enum.
enum BuiltinRetKind:
    BrkVoid
    BrkInt
    BrkBool
    BrkF64
    BrkU8
    BrkString               # GorgetString (slice/trim/upper/replace/format/…)
    BrkArray                # GorgetArray (split/keys/map/…)
    BrkSelf                 # receiver type (clone)
    BrkElem                 # collection element type
    BrkOptionElem           # Option[elem] (owned getter — pop/remove)
    BrkOptionRefElem        # Option[Ref[elem]] (borrowing getter — get/first/…)
    BrkInfer                # not classified here; fall through to other paths

struct BuiltinMethodDecl:
    String name
    bool returns_view                # result aliases receiver buffer (cap==0).
    Vector[int] owning_arg_positions # non-receiver arg indices the method owns.
    BuiltinRetKind ret_kind
    # True iff the call mutates its receiver in place (mirrors Rust's
    # authoritative `is_mutating` on the same struct, `src/ir/lowering/
    # builtins.rs:67`). Read via `method_mutates_receiver` in the lowerer;
    # drives the CoW resource-bind forward-scan's mutation set. Distinct
    # from `self_conv` (a `MutBorrow`-self `len` is `is_mutating: false`).
    bool is_mutating

# A per-CollectionKind group of builtin method declarations. The
# `collection_kind` field is the lookup discriminator for
# `collection_builtin_method(kind, mname)` — a resolved CollectionKind,
# matched variant-to-variant, never an int code or type-name string.
struct BuiltinMethodEntry:
    CollectionKind collection_kind
    Vector[BuiltinMethodDecl] methods
