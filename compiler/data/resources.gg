# ── STRING_BUILTIN_METHODS ──────────────────────────────────────────
#
# Typed declarations for the String (GorgetString) builtin methods that
# the lowerer used to recognise via two independent name-match lists:
#   - returns_view: the result is a non-owning view into the receiver's
#     buffer (was `is_string_view_method`); read under the String-receiver
#     gate at the lowerer's view-tag site.
#   - ret_kind=BrkString: the result is a freshly-allocated GorgetString
#     (was the String-return arm of `infer_method_return_type`).
#
# These two columns are INDEPENDENT membership sets — a method may be a
# view but not a fresh String (str/as_str/trim_left/trim_right →
# returns_view only, ret_kind=BrkInfer so the lowerer's return-type path
# falls through to the receiver/I64 default exactly as before), or a
# fresh String but not a view (upper/lower/replace/… → BrkString only).
# Methods that are both (slice/substring/trim/strip/… → an aliasing view
# that is also typed GorgetString) carry both columns.
#
# `reverse` is deliberately ABSENT: it is classified UNIT-returning by an
# earlier arm of `infer_method_return_type` (first-match wins), so it must
# NOT carry BrkString here. The lowerer keeps that earlier UNIT arm ahead
# of the String-table consult to preserve the ordering.
# NOTE: the trailing `false` on every row is `is_mutating` — every String
# builtin here is a pure read / fresh-allocate (Borrow/ByValue self in
# Rust's table), so NONE mutate the receiver. Mirrors `is_mutating: false`
# for these names in `src/ir/lowering/builtins.rs`.
public static Vector[BuiltinMethodDecl] STRING_BUILTIN_METHODS = [
    # Both view AND fresh-String (the aliasing slice/substring family).
    BuiltinMethodDecl("slice", true, [], BrkString(), false),
    BuiltinMethodDecl("substring", true, [], BrkString(), false),
    BuiltinMethodDecl("byte_slice", true, [], BrkString(), false),
    BuiltinMethodDecl("char_at", true, [], BrkString(), false),
    BuiltinMethodDecl("trim", true, [], BrkString(), false),
    BuiltinMethodDecl("strip", true, [], BrkString(), false),
    BuiltinMethodDecl("lstrip", true, [], BrkString(), false),
    BuiltinMethodDecl("rstrip", true, [], BrkString(), false),
    BuiltinMethodDecl("removeprefix", true, [], BrkString(), false),
    BuiltinMethodDecl("removesuffix", true, [], BrkString(), false),
    # View only (NOT a fresh String — falls through the return-type path).
    BuiltinMethodDecl("trim_left", true, [], BrkInfer(), false),
    BuiltinMethodDecl("trim_right", true, [], BrkInfer(), false),
    # round-31: the no-op `str`/`as_str` self-view accessors were removed —
    # bare `String v = sb` is already a zero-cost CoW borrow.
    # Fresh String only (NOT a view).
    BuiltinMethodDecl("upper", false, [], BrkString(), false),
    BuiltinMethodDecl("lower", false, [], BrkString(), false),
    BuiltinMethodDecl("to_lower", false, [], BrkString(), false),
    BuiltinMethodDecl("to_upper", false, [], BrkString(), false),
    BuiltinMethodDecl("replace", false, [], BrkString(), false),
    BuiltinMethodDecl("repeat", false, [], BrkString(), false),
    BuiltinMethodDecl("join", false, [], BrkString(), false),
    BuiltinMethodDecl("center", false, [], BrkString(), false),
    BuiltinMethodDecl("ljust", false, [], BrkString(), false),
    BuiltinMethodDecl("rjust", false, [], BrkString(), false),
    BuiltinMethodDecl("zfill", false, [], BrkString(), false),
    BuiltinMethodDecl("pad_left", false, [], BrkString(), false),
    BuiltinMethodDecl("pad_right", false, [], BrkString(), false),
    BuiltinMethodDecl("to_string", false, [], BrkString(), false),
    BuiltinMethodDecl("to_str", false, [], BrkString(), false),
    BuiltinMethodDecl("format", false, [], BrkString(), false),
]


# ── COLLECTION_BUILTIN_METHODS ──────────────────────────────────────
#
# Typed declarations for the collection mutators whose argument-ownership
# truth the lowerer used to encode as a per-CollectionKind name+index
# match (was `is_owning_mutator_arg`). `owning_arg_positions` lists the
# non-receiver argument indices that the mutator takes OWNERSHIP of, per
# (kind, method): Vector/Deque `set`/`insert` own only idx 1 (idx 0 is the
# index arg); Dict `put`/`set` own both 0 (key) + 1 (value); Set `add`/
# `insert` own idx 0; Vector/Deque/Heap `push` owns idx 0.
#
# returns_view / ret_kind are not consulted for these rows (the only
# consumer reads owning_arg_positions); they carry default false / BrkInfer.
# Keyed per CollectionKind — looked up by the RESOLVED kind from the
# resource table, never by re-listing receiver type-name aliases.
# NOTE: the trailing `true` on every row is `is_mutating` — every entry
# here is an owning mutator (push/set/insert/put/add), all `is_mutating:
# true` in `src/ir/lowering/builtins.rs`.
public static Vector[BuiltinMethodEntry] COLLECTION_BUILTIN_METHODS = [
    BuiltinMethodEntry(CkVector(), [
        BuiltinMethodDecl("push", false, [0], BrkInfer(), true),
        BuiltinMethodDecl("set", false, [1], BrkInfer(), true),
        BuiltinMethodDecl("insert", false, [1], BrkInfer(), true),
        # `fill(n, val)` — HINT-ONLY (EMPTY owning_arg_positions): the value is
        # cloned into every slot, so consuming it (clone + move-zero) would
        # double-free a live source. The lowerer derives the value-arg
        # element-type HINT position from the LAST arg (not from
        # owning_arg_positions), so membership in this table alone makes a bare
        # `None` in `Vector[Option[T]].fill(n, None)` materialize TAGGED (not
        # int32 0 == bogus Some(0)). Empty owning list ⇒ hint-WITHOUT-consume,
        # mirroring Rust gg's split of the value-arg hint from the consume set.
        BuiltinMethodDecl("fill", false, [], BrkInfer(), true),
    ]),
    BuiltinMethodEntry(CkDeque(), [
        BuiltinMethodDecl("push", false, [0], BrkInfer(), true),
        BuiltinMethodDecl("set", false, [1], BrkInfer(), true),
        BuiltinMethodDecl("insert", false, [1], BrkInfer(), true),
    ]),
    BuiltinMethodEntry(CkHeap(), [
        BuiltinMethodDecl("push", false, [0], BrkInfer(), true),
    ]),
    BuiltinMethodEntry(CkDict(), [
        BuiltinMethodDecl("put", false, [0, 1], BrkInfer(), true),
        BuiltinMethodDecl("set", false, [0, 1], BrkInfer(), true),
        # `get_or_put(k, default)` — HINT-ONLY (EMPTY owning_arg_positions): the
        # default is BORROWED (inserted only on a miss), so consuming it would
        # double-free. Hint the LAST-arg (value) element type so a bare `None`
        # default materializes TAGGED, same hint-without-consume split as fill.
        # (The flip is LATENT: get_or_put(k, None) still CC-FAILs on a deeper
        # `__gg_Option__int64_t` type-registration bug — the row is forward-
        # correct and harmless, but only the fill flip is claimed for now.)
        BuiltinMethodDecl("get_or_put", false, [], BrkInfer(), true),
    ]),
    # Set add/insert own their single element arg (idx 0). Both the ordered
    # (Set) and unordered (HashSet) kinds share the same mutator surface, so
    # the typed split lists identical rows under each variant.
    BuiltinMethodEntry(CkOrderedSet(), [
        BuiltinMethodDecl("add", false, [0], BrkInfer(), true),
        BuiltinMethodDecl("insert", false, [0], BrkInfer(), true),
    ]),
    BuiltinMethodEntry(CkHashSet(), [
        BuiltinMethodDecl("add", false, [0], BrkInfer(), true),
        BuiltinMethodDecl("insert", false, [0], BrkInfer(), true),
    ]),
]


# ── BUILTIN_METHOD_MUTATES ──────────────────────────────────────────
#
# Complete, name-keyed mutation table for builtin methods — the typed
# source of truth behind `method_mutates_receiver` (lower.gg). Mirrors
# Rust's authoritative `is_mutating` column on `BuiltinMethodDecl`
# (`src/ir/lowering/builtins.rs`) one-for-one: every builtin method name
# that appears in that table is here with the SAME truth value, so the
# self-host CoW resource-bind forward-scan classifies receiver mutation
# identically to Rust.
#
# This is a FLAT name→is_mutating set (the other two statics are keyed by
# String-receiver / CollectionKind and list only a slice of the surface;
# the CoW scan sees a bare method NAME with no resolved receiver kind, so
# it needs the whole table). Only the `name` + `is_mutating` columns are
# meaningful here; the rest carry defaults (returns_view=false,
# owning_arg_positions=[], ret_kind=BrkInfer).
#
# CONSERVATIVE DEFAULT (see `method_mutates_receiver`): a builtin name
# ABSENT from this table is treated as MUTATING — over-clones, never
# UAFs. So only rows present-and-false enable the borrow-flip; the
# read-only rows (get/unwrap/len/iter/keys/values/first/last/contains/
# is_empty/clone/…) are load-bearing — without them the bind's own
# `coll.get(i).unwrap()` chain would mark the source mutated and the flip
# would silently never fire.
#
# Where Rust lists a name under two self-conventions with DIFFERENT
# is_mutating values (`add`/`swap` = ByValue:false + MutBorrow:true,
# `get` = always false), the conservative choice for a name-keyed lookup
# is the MUTATING one (the borrow-flip suppressed = safe over-clone).
# -- RUST_PRESCAN_MUTATOR_FALLBACK (bootstrap-hotfix 2026-07-18) ---------
# Mirror of Rust's MUTATING_METHODS hand-list (src/ir/lowering/functions.rs)
# -- the conservative name fallback its untyped prescan layers UNDER the
# typed builtin table for USER methods it cannot resolve. This is the
# LANE-SYMMETRY predicate for the scope-hoist channel
# (rust_prescan_marks_method): the branch/scope pre-header hoist must fire
# on exactly the shapes RUST's collector marks, or the SH hoists where Rust
# does not (measured: the typechecker's bare ScopeTable params, mutated via
# user &self methods the SH's TYPED scan sees but Rust's prescan is blind
# to, drew a deep clone per recursive stmt visit -- 7x runtime clones, the
# stage-1 bootstrap blowout). The user-&self-mutator-in-scope throwaway
# stays the SHARED filed gap on BOTH lanes
# (known_gaps/cow_loop_bare_param_user_mutator); when the Rust prescan
# learns typed user receivers, delete this list on both sides together.
public static Vector[String] RUST_PRESCAN_MUTATOR_FALLBACK = [
    "push", "pop", "set", "insert", "remove", "clear", "sort", "sorted",
    "reverse", "swap", "swap_remove", "extend", "append", "truncate",
    "retain", "dedup", "resize", "reserve", "replace", "drain", "fill",
    "put", "remove_key", "sort_by", "sort_by_key",
]

public static Vector[BuiltinMethodDecl] BUILTIN_METHOD_MUTATES = [
    # ── Mutating (is_mutating = true) — mirror Rust's `true` rows ──────
    BuiltinMethodDecl("push", false, [], BrkInfer(), true),
