# compiler.data.resources — canonical resource + runtime-function table.
#
# Source of truth. Edit here only.
#
# Consumed by:
# - Self-host directly via `from compiler.data.resources import …`.
# - Rust via `src/ir/resources.rs` (include_str! + parser + AST walker).
#
# Bump SCHEMA_VERSION on every breaking field change in compiler/data/schema.gg.
# Consumers refuse mismatched versions at load time.
#
# ── STATUS (2026-05-19) ─────────────────────────────────────────────
# Filled in to the full table per item 8 of the resources.toml plan
# (TODO.md). Spike's 9 ResourceEntry + 9 RuntimeFn entries (chosen to
# exercise every enum variant) are at the top of each section; the rest
# are mechanically lifted from `tests/fixtures/self_host_lowerer/lir_lower.gg`
# (`build_resource_metadata`) and `src/lir/runtime.rs::REGISTRY`. Loader
# validates on first call.
#
# Per `docs/devbook/18-runtime-abi.md` (the resource table — data-driven, in
# Gorget): the spike proved the schema; this fill-in is the mechanical extension.

from compiler.data.schema import ResourceEntry, ResourceMetadata
from compiler.data.schema import MatchKind, MkExact, MkPrefix
from compiler.data.schema import CopySemantics, CsResource, CsRefCounted
from compiler.data.schema import CollectionKind, CkNotCollection, CkVector, CkDeque, CkHeap, CkDict, CkSet
from compiler.data.schema import BoxKind, BkNotBox, BkRegularBox, BkTraitBox
from compiler.data.schema import LirType, LtStructBase, LtPtr
from compiler.data.schema import RuntimeFn, RuntimeParam
from compiler.data.schema import CRuntimeType
from compiler.data.schema import TVoid, TBool, TI32, TI64, TU8, TF64, TPtr, TStr, TArray, TMap, TSet
from compiler.data.schema import AbiKind, AAuto, AScalar, APtr, AOpaque, AGorgetString, AVoidElem, ACStr, AByValue
from compiler.data.schema import SideEffects, FxPure, FxReadOnly, FxAllocates, FxMutates, FxIo, FxAborts, FxConcurrent


public static int SCHEMA_VERSION = 1


# ── RESOURCES ───────────────────────────────────────────────────────
#
# Spike entries lead (each chosen to exercise ≥ 1 unique enum variant /
# field combination); the remaining mechanical lifts follow, grouped by
# family in declaration order matching lir_lower.gg's build_resource_metadata.
#
# Coverage matrix (spike):
#   match_on:           Exact alias-cluster, Exact singleton, Prefix singleton,
#                       Prefix alias-cluster
#   collection_kind:    all 6 variants (NotCollection, Vector, Deque, Heap, Dict, Set)
#   box_kind:           all 3 variants (NotBox, RegularBox, TraitBox)
#   copy_semantics:     Resource, RefCounted (CsTrivial does not appear — primitives
#                       are LirType-routed, not in the resource table)
#   opaque_handle:      true, false
#   drop_fn / clone_fn / materialize_fn:   both Some and None states
#   method_prefix:      both Some and None states
#   is_typed_constructor: true, false

public static Vector[ResourceEntry] RESOURCES = [

    # GorgetString — multi-alias Exact cluster + MkPrefix for mangled methods
    # (GorgetString__upper, GorgetString__slice, …); CoW materialize_fn=Some;
    # the only resource with a view discriminator today.
    # method_prefix="gorget_str" routes map_monomorphized_to_runtime's
    # GorgetString__method → gorget_str_method dispatch.
    ResourceEntry(
        [MkExact("GorgetString"), MkExact("String"), MkExact("Str"),
         MkPrefix("GorgetString__")],
        ResourceMetadata(
            "GorgetString", 32, LtStructBase(),
            Some("gorget_string_free"),
            Some("gorget_string_clone"),
            Some("gorget_string_materialize_inplace"),
            CsResource(), CkNotCollection(), BkNotBox(),
            false, Some("gorget_str"), None, false)),

    # GorgetArray — Exact singleton; the runtime backing for Vector/Deque/Heap.
    # method_prefix="gorget_array" routes the non-generic
    # GorgetArray__method form (parallel to Vector__T__method).
    ResourceEntry(
        [MkExact("GorgetArray")],
        ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"),
            Some("gorget_array_clone"),
            None,
            CsResource(), CkVector(), BkNotBox(),
            false, Some("gorget_array"), None, false)),

    # Vector__T — Prefix; typed_constructor=true (T(args) user shape).
    # GorgetArray__ shares the Vector family classification axis in
    # map_monomorphized_to_runtime (both → gorget_array_method).
    ResourceEntry(
        [MkPrefix("Vector__"), MkPrefix("GorgetArray__")],
        ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"),
            Some("gorget_array_clone"),
            None,
            CsResource(), CkVector(), BkNotBox(),
            false, Some("gorget_array"), None, true)),

    # Deque__T — Prefix; CkDeque (distinct kind, same runtime).
    # NOTE: method_prefix left None — map_monomorphized_to_runtime does NOT
    # have a Deque__ arm today (Deque method dispatch goes through different
    # paths, e.g. insts.rs's strip_prefix). Routing Deque__ through the
    # array-family arm would change observable behaviour; out of scope here.
    ResourceEntry(
        [MkPrefix("Deque__")],
        ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"),
            Some("gorget_array_clone"),
            None,
            CsResource(), CkDeque(), BkNotBox(),
            false, None, None, true)),

    # Heap__T — Prefix; CkHeap; typed_constructor=false (factory shape, Heap.new()).
    # method_prefix="gorget_heap" routes Heap__T__method → gorget_heap_method.
    # CkHeap distinguishes from Vector/GorgetArray (same runtime_name but
    # different dispatch family).
    ResourceEntry(
        [MkPrefix("Heap__")],
        ResourceMetadata(
            "GorgetArray", 64, LtStructBase(),
            Some("gorget_array_free"),
            Some("gorget_array_clone"),
            None,
            CsResource(), CkHeap(), BkNotBox(),
            false, Some("gorget_heap"), None, false)),

    # Dict__K__V / HashMap__K__V / GorgetDict__K__V — multi-alias Prefix cluster;
    # CkDict. method_prefix="gorget_map" routes Dict/HashMap/GorgetDict
    # families through the gorget_map_* runtime. Dict__-specific overrides
    # (Dict.new() → gorget_dict_new for ordered semantics) stay inside the
    # dispatch arm.
    ResourceEntry(
        [MkPrefix("Dict__"), MkPrefix("HashMap__"), MkPrefix("GorgetDict__")],
        ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"),
            Some("gorget_map_clone"),
            None,
            CsResource(), CkDict(), BkNotBox(),
            false, Some("gorget_map"), None, true)),

    # Set__T / HashSet__T — Prefix alias cluster; CkSet.
    # method_prefix="gorget_set" routes Set/HashSet through the gorget_set_*
    # runtime. Set__-specific overrides (Set.new()/new_str() → gorget_ordered_set_*
    # for ordered semantics) stay inside the dispatch arm.
    ResourceEntry(
        [MkPrefix("Set__"), MkPrefix("HashSet__")],
        ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"),
            Some("gorget_set_clone"),
            None,
            CsResource(), CkSet(), BkNotBox(),
            false, Some("gorget_set"), None, true)),

    # Box__T — Prefix; BkRegularBox; LtPtr (8-byte pointer, not struct).
    ResourceEntry(
        [MkPrefix("Box__")],
        ResourceMetadata(
            "Box", 8, LtPtr(),
            None,
            None,
            None,
            CsResource(), CkNotCollection(), BkRegularBox(),
            false, None, None, false)),

    # Mutex__T — Prefix; opaque_handle=true; method_prefix=Some;
    # CsRefCounted; clone_fn=None (handles aren't deep-cloned).
    # c_typedef_name="GorgetMutex*" — schema runtime_name="Mutex" diverges
    # from the C typedef target at the emit_wrapper_typedef boundary.
    ResourceEntry(
        [MkPrefix("Mutex__")],
        ResourceMetadata(
            "Mutex", 8, LtPtr(),
            Some("gorget_mutex_free"),
            None,
            None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_mutex"), Some("GorgetMutex*"), true)),

    # bare "Box" — Exact singleton; BkTraitBox (trait-object box, distinct
    # from the parameterized Box__T regular form above).
    ResourceEntry(
        [MkExact("Box")],
        ResourceMetadata(
            "Box", 16, LtStructBase(),
            None,
            None,
            None,
            CsResource(), CkNotCollection(), BkTraitBox(),
            false, None, None, false)),

    # ── Mechanical fill-in from lir_lower.gg::build_resource_metadata ──

    # GorgetMap — Exact singleton; backing runtime for Dict/HashMap.
    # method_prefix="gorget_map" matches the Dict__/HashMap__ family.
    ResourceEntry(
        [MkExact("GorgetMap")],
        ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"),
            Some("gorget_map_clone"),
            None,
            CsResource(), CkDict(), BkNotBox(),
            false, Some("gorget_map"), None, false)),

    # GorgetSet — Exact singleton; backing runtime for Set/HashSet.
    # method_prefix="gorget_set" matches the Set__/HashSet__ family.
    ResourceEntry(
        [MkExact("GorgetSet")],
        ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"),
            Some("gorget_set_clone"),
            None,
            CsResource(), CkSet(), BkNotBox(),
            false, Some("gorget_set"), None, false)),

    # GorgetClosure — Exact singleton; 16-byte closure struct.
    ResourceEntry(
        [MkExact("GorgetClosure")],
        ResourceMetadata(
            "GorgetClosure", 16, LtStructBase(),
            Some("gorget_closure_free"),
            Some("gorget_closure_clone"),
            None,
            CsResource(), CkNotCollection(), BkNotBox(),
            false, None, None, false)),

    # GorgetMap__ — self-host mangled monomorphised form;
    # is_typed_constructor=false (distinguishes from user-visible Dict__).
    # NOTE: GorgetDict__ is part of the spike cluster above with
    # is_typed_constructor=true; lir_lower.gg actually groups it with
    # GorgetMap__ at false. Drift surfaced during item-8 fill-in;
    # leaving spike untouched per scope discipline.
    # method_prefix="gorget_map" matches the Dict family.
    ResourceEntry(
        [MkPrefix("GorgetMap__")],
        ResourceMetadata(
            "GorgetMap", 184, LtStructBase(),
            Some("gorget_map_free"),
            Some("gorget_map_clone"),
            None,
            CsResource(), CkDict(), BkNotBox(),
            false, Some("gorget_map"), None, false)),

    # GorgetSet__ — self-host mangled monomorphised form.
    # method_prefix="gorget_set" matches the Set family.
    ResourceEntry(
        [MkPrefix("GorgetSet__")],
        ResourceMetadata(
            "GorgetSet", 184, LtStructBase(),
            Some("gorget_set_free"),
            Some("gorget_set_clone"),
            None,
            CsResource(), CkSet(), BkNotBox(),
            false, Some("gorget_set"), None, false)),

    # RWLock__ — opaque, ref-counted, typed_constructor.
    # c_typedef_name="GorgetRWLock*" (diverges from runtime_name="Ptr").
    ResourceEntry(
        [MkPrefix("RWLock__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_rwlock"), Some("GorgetRWLock*"), true)),

    # Channel__ — opaque, ref-counted, typed_constructor.
    # c_typedef_name="GorgetChannel*" (diverges from runtime_name="Ptr").
    ResourceEntry(
        [MkPrefix("Channel__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_channel"), Some("GorgetChannel*"), true)),

    # Shared__ — opaque, ref-counted, typed_constructor.
    # c_typedef_name="GorgetShared*" (diverges from runtime_name="Ptr").
    ResourceEntry(
        [MkPrefix("Shared__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_shared"), Some("GorgetShared*"), true)),

    # Weak__ — opaque, ref-counted, factory shape (typed_constructor=false).
    # c_typedef_name="GorgetShared*" — Weak and Shared share the C wire
    # type; the strong/weak distinction lives in the runtime's
    # bookkeeping, not the typedef.
    ResourceEntry(
        [MkPrefix("Weak__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_weak"), Some("GorgetShared*"), false)),

    # AtomicInt__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("AtomicInt__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_atomic_int"), None, false)),

    # AtomicBool__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("AtomicBool__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_atomic_bool"), None, false)),

    # Semaphore__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("Semaphore__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_semaphore"), None, false)),

    # Barrier__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("Barrier__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_barrier"), None, false)),

    # OnceFlag__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("OnceFlag__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_once_flag"), None, false)),

    # WaitGroup__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("WaitGroup__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_wait_group"), None, false)),

    # TaskGroup__ — opaque, ref-counted, factory.
    ResourceEntry(
        [MkPrefix("TaskGroup__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, Some("gorget_task_group"), None, false)),

    # Thread__ — opaque, ref-counted, factory; no method_prefix.
    ResourceEntry(
        [MkPrefix("Thread__")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, None, None, false)),

    # Bare-name opaque cluster — Barrier / CondVar / AtomicInt / AtomicBool /
    # Process / Thread / Semaphore / WaitGroup / OnceFlag. Method-prefix
    # wiring for these went through direct method-name dispatch (no prefix).
    ResourceEntry(
        [MkExact("Barrier"), MkExact("CondVar"), MkExact("AtomicInt"),
         MkExact("AtomicBool"), MkExact("Process"), MkExact("Thread"),
         MkExact("Semaphore"), MkExact("WaitGroup"), MkExact("OnceFlag")],
        ResourceMetadata(
            "Ptr", 8, LtPtr(),
            None, None, None,
            CsRefCounted(), CkNotCollection(), BkNotBox(),
            true, None, None, false)),

    # ReadGuard__ — Guard family (LtStructBase, 16 bytes); read-side prefix.
    # c_typedef_name="gorget_read_guard_t" (diverges from runtime_name="Guard").
    ResourceEntry(
        [MkPrefix("ReadGuard__")],
        ResourceMetadata(
            "Guard", 16, LtStructBase(),
            None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(),
            false, Some("gorget_read_guard"), Some("gorget_read_guard_t"), false)),

    # WriteGuard__ — Guard family; write-side prefix.
    # c_typedef_name="gorget_write_guard_t" (diverges from runtime_name="Guard").
    ResourceEntry(
        [MkPrefix("WriteGuard__")],
        ResourceMetadata(
            "Guard", 16, LtStructBase(),
            None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(),
            false, Some("gorget_write_guard"), Some("gorget_write_guard_t"), false)),

    # Guard__ — bare Guard prefix; default method routing.
    # c_typedef_name="gorget_guard_t" (diverges from runtime_name="Guard").
    ResourceEntry(
        [MkPrefix("Guard__")],
        ResourceMetadata(
            "Guard", 16, LtStructBase(),
            None, None, None,
            CsResource(), CkNotCollection(), BkNotBox(),
            false, Some("gorget_guard"), Some("gorget_guard_t"), false)),

]


# ── RUNTIME_FNS ─────────────────────────────────────────────────────
#
# Spike entries lead (each chosen to exercise ≥ 1 unique enum variant /
# ABI / side-effect combination); the rest is mechanically lifted from
# `src/lir/runtime.rs::REGISTRY` in declaration order.
#
# Coverage matrix (spike):
#   side_effects:       FxPure, FxAllocates, FxMutates, FxIo, FxConcurrent
#                       (FxReadOnly / FxAborts surface in the fill-in below;
#                        FxUnknown is reserved — no registry entry uses it)
#   returns_fresh:      true, false
#   AbiKind:            AScalar, APtr, AOpaque, AGorgetString, AVoidElem, ACStr
#                       (AAuto / AByValue surface in the fill-in below)
#   CRuntimeType:       TVoid, TI64, TU8, TF64, TPtr, TStr, TArray
#                       (TBool / TI32 / TMap / TSet surface in the fill-in below)
#   param counts:       0, 1, 2 (the 3+ case is mechanical fill-in)

public static Vector[RuntimeFn] RUNTIME_FNS = [

    # Math — Pure, single scalar in/out.
    RuntimeFn(
        "gorget_sqrt",
        [RuntimeParam(TF64(), AScalar())],
        TF64(),
        FxPure(),
        false),

    # Allocator hook — Opaque ABI; single Ptr in, Ptr out.
    RuntimeFn(
        "__gorget_alloc",
        [RuntimeParam(TPtr(), AOpaque())],
        TPtr(),
        FxAllocates(),
        false),

    # String concat — 2× GorgetString byval; returns_fresh=true
    # (independently allocated result buffer).
    RuntimeFn(
        "gorget_str_cat",
        [RuntimeParam(TStr(), AGorgetString()),
         RuntimeParam(TStr(), AGorgetString())],
        TStr(),
        FxAllocates(),
        true),

    # String→cstr — CStr ABI on return wire; Ptr return.
    RuntimeFn(
        "gorget_str_to_cstr",
        [RuntimeParam(TStr(), AGorgetString())],
        TPtr(),
        FxAllocates(),
        false),

    # Array push — Mutates; VoidElem ABI on the value arg;
    # void return; mixes APtr (self) + AVoidElem (elem).
    RuntimeFn(
        "gorget_array_push",
        [RuntimeParam(TPtr(), APtr()),
         RuntimeParam(TPtr(), AVoidElem())],
        TVoid(),
        FxMutates(),
        false),

    # Mutex lock — Concurrent; Opaque ABI; Ptr in, Ptr out.
    RuntimeFn(
        "gorget_mutex_lock",
        [RuntimeParam(TPtr(), AOpaque())],
        TPtr(),
        FxConcurrent(),
        false),

    # File read — Io; CStr ABI for the path arg; returns Str struct.
    RuntimeFn(
        "gorget_read_file",
        [RuntimeParam(TPtr(), ACStr())],
        TStr(),
        FxIo(),
        true),

    # Array constructor — Allocates; Scalar arg; struct return (TArray);
    # returns_fresh=true.
    RuntimeFn(
        "gorget_array_new",
        [RuntimeParam(TI64(), AScalar())],
        TArray(),
        FxAllocates(),
        true),

    # Byte access — Pure; mixed param types (Str + I64); narrow scalar return.
    RuntimeFn(
        "gorget_str_byte_at",
        [RuntimeParam(TStr(), AGorgetString()),
         RuntimeParam(TI64(), AScalar())],
        TU8(),
        FxPure(),
        false),


    # ── Mechanical fill-in from src/lir/runtime.rs::REGISTRY ──

    RuntimeFn(
        "__gorget_alloc_array",
        [RuntimeParam(TI64(), AScalar()),
         RuntimeParam(TPtr(), AOpaque())],
        TPtr(),
        FxAllocates(),
        false),

    RuntimeFn(
        "__gorget_dealloc",
        [RuntimeParam(TPtr(), AOpaque()),
         RuntimeParam(TPtr(), AOpaque())],
        TVoid(),
        FxMutates(),
        false),

    RuntimeFn(
        "__gorget_pop_allocator",
        [],
        TVoid(),
        FxMutates(),
        false),

    RuntimeFn(
        "__gorget_push_allocator",
        [RuntimeParam(TPtr(), AOpaque())],
        TVoid(),
        FxMutates(),
        false),

    RuntimeFn(
        "free",
        [RuntimeParam(TPtr(), AOpaque())],
        TVoid(),
        FxMutates(),
        false),

    RuntimeFn(
        "malloc",
        [RuntimeParam(TI64(), AScalar())],
        TPtr(),
        FxAllocates(),
        false),

    RuntimeFn(
        "memcmp",
        [RuntimeParam(TPtr(), AOpaque()),
         RuntimeParam(TPtr(), AOpaque()),
         RuntimeParam(TI64(), AScalar())],
        TI32(),
        FxReadOnly(),
        false),

    RuntimeFn(
        "memset",
