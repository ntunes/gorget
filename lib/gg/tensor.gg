# gg.tensor — N-dimensional numeric tensor library for Gorget
#
# Architecture: view-based, zero-copy reshape/transpose/slice via Shared[Vector[T]]
# storage. Multiple Tensor values can share the same backing buffer.
#
# Key types:
#   Tensor[T]   — N-dimensional array with shape, strides, and shared storage
#
# Generic constructors (Numeric T):
#   tensor_zeros[T] / tensor_ones[T] / tensor_from[T] / tensor_clone[T]
#
# Type-specific constructors:
#   tensor_arange (int-only), tensor_linspace (float-only)
#
# Views (O(1), share backing storage, mutations alias):
#   Methods: reshape, transpose, permute, tensor_slice
#   Deep copy: tensor_clone[T]
#
# Arithmetic (element-wise generic free functions, Numeric T):
#   tensor_add[T], tensor_sub[T], tensor_mul[T], tensor_div[T], tensor_neg[T]
#   scalar_add[T], scalar_sub[T], scalar_mul[T], scalar_div[T]
#
# Broadcasting: tensor_broadcast_shape, tensor_bc_elem[T],
#   tensor_badd[T], tensor_bsub[T], tensor_bmul[T]
#
# Reductions: tensor_sum[T], tensor_min[T], tensor_max[T]
#   tensor_mean_all, tensor_std_all (float-only)
#   tensor_sum_axis[T], tensor_mean_axis (float-only)
#
# Linear algebra: tensor_matmul[T], tensor_dot[T]
# Comparisons: tensor_eq[T], tensor_lt[T], tensor_gt[T], tensor_le[T], tensor_ge[T], tensor_ne[T]
#
# Display: tensor_display[T]

from std.collections import Vector
from std.conv import int_to_str, float_to_str, parse_float
from std.math import sqrt

# Convert int to float (Gorget has no implicit int→float promotion)
float int_to_float(int n):
    return parse_float(int_to_str(n)).unwrap()

# ── Core Struct ──────────────────────────────────────────────

struct Tensor[T]:
    Shared[Vector[T]] storage   # shared ref-counted flat data
    Vector[int] shape           # dimensions [d0, d1, ..., dn-1]
    Vector[int] strides         # element strides per dimension (row-major)
    int offset                  # view offset into storage

# ── Helpers ──────────────────────────────────────────────────

# Row-major stride computation: strides[n-1]=1, strides[i]=strides[i+1]*shape[i+1]
Vector[int] tensor_compute_strides(Vector[int] shape):
    int n = shape.len()
    Vector[int] st = Vector[int]()
    int i = 0
    while i < n:
        st.push(0)
        i = i + 1
    if n == 0:
        return st
    st.set(n - 1, 1)
    int j = n - 2
    while j >= 0:
        st.set(j, st.get(j + 1).unwrap() * shape.get(j + 1).unwrap())
        j = j - 1
    return st

# Product of all elements (total number of elements)
int tensor_product(Vector[int] v):
    int p = 1
    int i = 0
    while i < v.len():
        p = p * v.get(i).unwrap()
        i = i + 1
    return p

# Deep-copy a Vector[int]
Vector[int] vec_int_copy(Vector[int] v):
    Vector[int] out = Vector[int]()
    int i = 0
    while i < v.len():
        out.push(v.get(i).unwrap())
        i = i + 1
    return out

# Odometer-style multi-index increment. Returns true if successful, false if wrapped around.
bool tensor_increment_index(Vector[int] indices, Vector[int] shape):
    int n = indices.len()
    int i = n - 1
    while i >= 0:
        int cur = indices.get(i).unwrap()
        int dim = shape.get(i).unwrap()
        if cur + 1 < dim:
            indices.set(i, cur + 1)
            return true
        indices.set(i, 0)
        i = i - 1
    return false

# Compute flat storage address from multi-index considering strides and offset.
int tensor_flat_addr(Vector[int] strides, int offset, Vector[int] indices):
    int flat = offset
    int i = 0
    while i < indices.len():
        flat = flat + indices.get(i).unwrap() * strides.get(i).unwrap()
        i = i + 1
    return flat

# Compute strided flat index from sequential logical index i.
int tensor_flat_to_addr(Vector[int] strides, int offset, Vector[int] shape, int i):
    int n = shape.len()
    int remaining = i
    int addr = offset
    int dim = 0
    while dim < n:
        int sub_size = 1
        int k = dim + 1
        while k < n:
            sub_size = sub_size * shape.get(k).unwrap()
            k = k + 1
        int dim_idx = remaining / sub_size
        remaining = remaining - dim_idx * sub_size
        addr = addr + dim_idx * strides.get(dim).unwrap()
        dim = dim + 1
    return addr

# ── Generic Tensor Methods ────────────────────────────────────
# ONE equip block for Tensor[T]. This is the only equip block for this generic
# struct. Having multiple concrete equip blocks causes the compiler to merge them
# all into a generic template applied to all T, producing duplicate symbols.

equip Tensor[T]:
    # Shape and metadata
    int ndim(self) = self.shape.len()
    int size(self) = tensor_product(self.shape)
    int storage_len(self) = self.storage.slen()

    bool is_contiguous(self):
        if self.offset != 0:
            return false
        Vector[int] expected = tensor_compute_strides(self.shape)
        int i = 0
        while i < self.shape.len():
            if self.strides.get(i).unwrap() != expected.get(i).unwrap():
                return false
            i = i + 1
        return true

    # O(1) views — return new Tensor sharing the same storage
    Tensor[T] reshape(self, Vector[int] new_shape):
        Vector[int] s = vec_int_copy(new_shape)
        Vector[int] ns = tensor_compute_strides(s)
        return Tensor[T](self.storage.clone(), s, ns, self.offset)

    Tensor[T] transpose(self):
        if self.shape.len() < 2:
            return Tensor[T](self.storage.clone(), vec_int_copy(self.shape), vec_int_copy(self.strides), self.offset)
        Vector[int] new_shape = Vector[int]()
        Vector[int] new_strides = Vector[int]()
        new_shape.push(self.shape.get(1).unwrap())
        new_shape.push(self.shape.get(0).unwrap())
        new_strides.push(self.strides.get(1).unwrap())
        new_strides.push(self.strides.get(0).unwrap())
        int i = 2
        while i < self.shape.len():
            new_shape.push(self.shape.get(i).unwrap())
            new_strides.push(self.strides.get(i).unwrap())
            i = i + 1
        return Tensor[T](self.storage.clone(), new_shape, new_strides, self.offset)

    Tensor[T] permute(self, Vector[int] axes):
        Vector[int] new_shape = Vector[int]()
        Vector[int] new_strides = Vector[int]()
        int i = 0
        while i < axes.len():
            int axis = axes.get(i).unwrap()
            new_shape.push(self.shape.get(axis).unwrap())
            new_strides.push(self.strides.get(axis).unwrap())
            i = i + 1
        return Tensor[T](self.storage.clone(), new_shape, new_strides, self.offset)

    Tensor[T] tensor_slice(self, int axis, int start, int end):
        int new_offset = self.offset + start * self.strides.get(axis).unwrap()
        Vector[int] new_shape = vec_int_copy(self.shape)
        new_shape.set(axis, end - start)
        return Tensor[T](self.storage.clone(), new_shape, vec_int_copy(self.strides), new_offset)

    # Element access — dispatches to Shared[Vector[T]].at/set_at (Phase 0a)
    T at(self, Vector[int] indices):
        return self.storage.at(tensor_flat_addr(self.strides, self.offset, indices))

    void set_at(&self, Vector[int] indices, T val):
        self.storage.set_at(tensor_flat_addr(self.strides, self.offset, indices), val)

    T flat_get(self, int i):
        if self.is_contiguous():
            return self.storage.at(self.offset + i)
        return self.storage.at(tensor_flat_to_addr(self.strides, self.offset, self.shape, i))

    void flat_set(&self, int i, T val):
        if self.is_contiguous():
            self.storage.set_at(self.offset + i, val)
        else:
            self.storage.set_at(tensor_flat_to_addr(self.strides, self.offset, self.shape, i), val)

# ── Generic Constructors ─────────────────────────────────────

Tensor[T] tensor_zeros[Numeric T](Vector[int] shape):
    int sz = tensor_product(shape)
    Vector[T] data = Vector[T]()
    int i = 0
    while i < sz:
        data.push(T.default())
        i = i + 1
    Vector[int] s = vec_int_copy(shape)
    Vector[int] strides = tensor_compute_strides(s)
    return Tensor[T](Shared[Vector[T]](data), s, strides, 0)

Tensor[T] tensor_ones[Numeric T](Vector[int] shape):
    int sz = tensor_product(shape)
    Vector[T] data = Vector[T]()
    int i = 0
    while i < sz:
        data.push(T.one())
        i = i + 1
    Vector[int] s = vec_int_copy(shape)
    Vector[int] strides = tensor_compute_strides(s)
    return Tensor[T](Shared[Vector[T]](data), s, strides, 0)

Tensor[int] tensor_arange(int start, int stop):
    Vector[int] shape = Vector[int]()
    shape.push(stop - start)
    Vector[int] data = Vector[int]()
    int i = start
    while i < stop:
        data.push(i)
        i = i + 1
    Vector[int] strides = tensor_compute_strides(shape)
    return Tensor[int](Shared[Vector[int]](data), shape, strides, 0)

Tensor[T] tensor_from[Numeric T](Vector[T] data, Vector[int] shape):
    Vector[int] s = vec_int_copy(shape)
    Vector[int] strides = tensor_compute_strides(s)
    return Tensor[T](Shared[Vector[T]](data), s, strides, 0)

Tensor[float] tensor_linspace(float start, float stop, int num):
    Vector[int] shape = Vector[int]()
    shape.push(num)
    Vector[float] data = Vector[float]()
    if num <= 1:
        data.push(start)
    else:
        float step = (stop - start) / int_to_float(num - 1)
        float cur = start
        int i = 0
        while i < num:
            data.push(cur)
            cur = cur + step
            i = i + 1
    Vector[int] strides = tensor_compute_strides(shape)
    return Tensor[float](Shared[Vector[float]](data), shape, strides, 0)

# Deep copy (generic)
Tensor[T] tensor_clone[Numeric T](Tensor[T] t):
    int sz = t.size()
    Vector[T] new_data = Vector[T]()
    Vector[int] indices = Vector[int]()
    int d = 0
    while d < t.shape.len():
        indices.push(0)
        d = d + 1
    int k = 0
    while k < sz:
        new_data.push(t.at(indices))
        if k < sz - 1:
            tensor_increment_index(indices, t.shape)
        k = k + 1
    Vector[int] new_shape = vec_int_copy(t.shape)
    Vector[int] new_strides = tensor_compute_strides(new_shape)
    return Tensor[T](Shared[Vector[T]](new_data), new_shape, new_strides, 0)

# ── Display ───────────────────────────────────────────────────

str tensor_display[Numeric T](Tensor[T] t):
    str out = "Tensor(shape=["
    int i = 0
    while i < t.shape.len():
        if i > 0:
            out = out + ","
        out = out + int_to_str(t.shape.get(i).unwrap())
        i = i + 1
    out = out + "], ["
    int sz = t.size()
    int j = 0
    while j < sz:
        if j > 0:
            out = out + ", "
        meta if T is float:
            out = out + float_to_str(t.flat_get(j))
        else:
            out = out + int_to_str(t.flat_get(j))
        j = j + 1
    out = out + "])"
    return out

# ── Element-wise Arithmetic (generic free functions) ──────────

Tensor[T] tensor_add[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(a.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, a.flat_get(i) + b.flat_get(i))
        i = i + 1
    return out

Tensor[T] tensor_sub[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(a.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, a.flat_get(i) - b.flat_get(i))
        i = i + 1
    return out

Tensor[T] tensor_mul[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(a.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, a.flat_get(i) * b.flat_get(i))
        i = i + 1
    return out

Tensor[T] tensor_div[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(a.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, a.flat_get(i) / b.flat_get(i))
        i = i + 1
    return out

Tensor[T] tensor_neg[Numeric T](Tensor[T] a):
    int sz = a.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(a.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, -a.flat_get(i))
        i = i + 1
    return out

# ── Scalar Operations (generic free functions) ────────────────

Tensor[T] scalar_add[Numeric T](Tensor[T] t, T val):
    int sz = t.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(t.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, t.flat_get(i) + val)
        i = i + 1
    return out

Tensor[T] scalar_sub[Numeric T](Tensor[T] t, T val):
    int sz = t.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(t.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, t.flat_get(i) - val)
        i = i + 1
    return out

Tensor[T] scalar_mul[Numeric T](Tensor[T] t, T val):
    int sz = t.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(t.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, t.flat_get(i) * val)
        i = i + 1
    return out

Tensor[T] scalar_div[Numeric T](Tensor[T] t, T val):
    int sz = t.size()
    Tensor[T] out = tensor_zeros[T](vec_int_copy(t.shape))
    int i = 0
    while i < sz:
        out.storage.set_at(i, t.flat_get(i) / val)
        i = i + 1
    return out

# ── Broadcasting ──────────────────────────────────────────────

# Broadcast shape: left-pad shorter with 1s, per-dim must match or one must be 1.
Result[Vector[int], str] tensor_broadcast_shape(Vector[int] a, Vector[int] b):
    int na = a.len()
    int nb = b.len()
    int n = na
    if nb > n:
        n = nb
    Vector[int] out = Vector[int]()
    int i = 0
    while i < n:
        int ai = 1
        int bi = 1
        int da = na - n + i
        int db = nb - n + i
        if da >= 0:
            ai = a.get(da).unwrap()
        if db >= 0:
            bi = b.get(db).unwrap()
        if ai == bi:
            out.push(ai)
        elif ai == 1:
            out.push(bi)
        elif bi == 1:
            out.push(ai)
        else:
            return Error("incompatible broadcast shapes")
        i = i + 1
    return Ok(out)

# Generic broadcast element read.
T tensor_bc_elem[Numeric T](Tensor[T] t, Vector[int] bc_shape, Vector[int] idx):
    int n_bc = bc_shape.len()
    int n_t = t.shape.len()
    int flat = t.offset
    int i = 0
    while i < n_t:
        int bc_i = n_bc - n_t + i
        int stride = t.strides.get(i).unwrap()
        int dim = t.shape.get(i).unwrap()
        int oi = idx.get(bc_i).unwrap()
        if dim == 1:
            oi = 0
        flat = flat + oi * stride
        i = i + 1
    return t.storage.at(flat)

Tensor[T] tensor_badd[Numeric T](Tensor[T] a, Tensor[T] b):
    Vector[int] bc_shape = tensor_broadcast_shape(a.shape, b.shape).unwrap()
    int sz = tensor_product(bc_shape)
    Tensor[T] out = tensor_zeros[T](vec_int_copy(bc_shape))
    Vector[int] idx = Vector[int]()
    int di = 0
    while di < bc_shape.len():
        idx.push(0)
        di = di + 1
    int k = 0
    while k < sz:
        T av = tensor_bc_elem[T](a, bc_shape, idx)
        T bv = tensor_bc_elem[T](b, bc_shape, idx)
        out.storage.set_at(k, av + bv)
        if k < sz - 1:
            tensor_increment_index(idx, bc_shape)
        k = k + 1
    return out

Tensor[T] tensor_bsub[Numeric T](Tensor[T] a, Tensor[T] b):
    Vector[int] bc_shape = tensor_broadcast_shape(a.shape, b.shape).unwrap()
    int sz = tensor_product(bc_shape)
    Tensor[T] out = tensor_zeros[T](vec_int_copy(bc_shape))
    Vector[int] idx = Vector[int]()
    int di = 0
    while di < bc_shape.len():
        idx.push(0)
        di = di + 1
    int k = 0
    while k < sz:
        T av = tensor_bc_elem[T](a, bc_shape, idx)
        T bv = tensor_bc_elem[T](b, bc_shape, idx)
        out.storage.set_at(k, av - bv)
        if k < sz - 1:
            tensor_increment_index(idx, bc_shape)
        k = k + 1
    return out

Tensor[T] tensor_bmul[Numeric T](Tensor[T] a, Tensor[T] b):
    Vector[int] bc_shape = tensor_broadcast_shape(a.shape, b.shape).unwrap()
    int sz = tensor_product(bc_shape)
    Tensor[T] out = tensor_zeros[T](vec_int_copy(bc_shape))
    Vector[int] idx = Vector[int]()
    int di = 0
    while di < bc_shape.len():
        idx.push(0)
        di = di + 1
    int k = 0
    while k < sz:
        T av = tensor_bc_elem[T](a, bc_shape, idx)
        T bv = tensor_bc_elem[T](b, bc_shape, idx)
        out.storage.set_at(k, av * bv)
        if k < sz - 1:
            tensor_increment_index(idx, bc_shape)
        k = k + 1
    return out

# ── Reductions ────────────────────────────────────────────────

T tensor_sum[Numeric T](Tensor[T] t):
    T acc = T.default()
    int sz = t.size()
    int i = 0
    while i < sz:
        acc = acc + t.flat_get(i)
        i = i + 1
    return acc

T tensor_min[Numeric T](Tensor[T] t):
    int sz = t.size()
    T m = t.flat_get(0)
    int i = 1
    while i < sz:
        T v = t.flat_get(i)
        if v < m:
            m = v
        i = i + 1
    return m

T tensor_max[Numeric T](Tensor[T] t):
    int sz = t.size()
    T m = t.flat_get(0)
    int i = 1
    while i < sz:
        T v = t.flat_get(i)
        if v > m:
            m = v
        i = i + 1
    return m

float tensor_mean_all(Tensor[float] t):
    int sz = t.size()
    if sz == 0:
        return 0.0
    float fcnt = 0.0
    int i = 0
    while i < sz:
        fcnt = fcnt + 1.0
        i = i + 1
    return tensor_sum[float](t) / fcnt

float tensor_std_all(Tensor[float] t):
    int sz = t.size()
    if sz == 0:
        return 0.0
    float mean = tensor_mean_all(t)
    float var = 0.0
    float fcnt = 0.0
    int i = 0
    while i < sz:
        float diff = t.flat_get(i) - mean
        var = var + diff * diff
        fcnt = fcnt + 1.0
        i = i + 1
    return sqrt(var / fcnt)

# Axis reduction: sum along one axis, returns tensor with ndim-1 dimensions
Tensor[T] tensor_sum_axis[Numeric T](Tensor[T] t, int axis):
    int n = t.shape.len()
    int axis_size = t.shape.get(axis).unwrap()
    Vector[int] out_shape = Vector[int]()
    int i = 0
    while i < n:
        if i != axis:
            out_shape.push(t.shape.get(i).unwrap())
        i = i + 1
    Tensor[T] out = tensor_zeros[T](out_shape)
    int out_sz = out.size()
    Vector[int] out_idx = Vector[int]()
    i = 0
    while i < out_shape.len():
        out_idx.push(0)
        i = i + 1
    int k = 0
    while k < out_sz:
        T acc = T.default()
        int aj = 0
        while aj < axis_size:
            Vector[int] in_idx = Vector[int]()
            int oi = 0
            int ni = 0
            while ni < n:
                if ni == axis:
                    in_idx.push(aj)
                else:
                    in_idx.push(out_idx.get(oi).unwrap())
                    oi = oi + 1
                ni = ni + 1
            acc = acc + t.at(in_idx)
            aj = aj + 1
        out.set_at(out_idx, acc)
        if k < out_sz - 1:
            tensor_increment_index(out_idx, out_shape)
        k = k + 1
    return out

Tensor[float] tensor_mean_axis(Tensor[float] t, int axis):
    int axis_size = t.shape.get(axis).unwrap()
    Tensor[float] sums = tensor_sum_axis[float](t, axis)
    float fdiv = 0.0
    int i = 0
    while i < axis_size:
        fdiv = fdiv + 1.0
        i = i + 1
    return scalar_div[float](sums, fdiv)

# ── Linear Algebra ────────────────────────────────────────────

# matmul: [m,k] @ [k,n] → [m,n]
Tensor[T] tensor_matmul[Numeric T](Tensor[T] a, Tensor[T] b):
    int m = a.shape.get(0).unwrap()
    int k = a.shape.get(1).unwrap()
    int n = b.shape.get(1).unwrap()
    Vector[int] out_shape = Vector[int]()
    out_shape.push(m)
    out_shape.push(n)
    Tensor[T] out = tensor_zeros[T](out_shape)
    int i = 0
    while i < m:
        int j = 0
        while j < n:
            T acc = T.default()
            int p = 0
            while p < k:
                Vector[int] ai = Vector[int]()
                ai.push(i)
                ai.push(p)
                Vector[int] bi = Vector[int]()
                bi.push(p)
                bi.push(j)
                acc = acc + a.at(ai) * b.at(bi)
                p = p + 1
            Vector[int] oi = Vector[int]()
            oi.push(i)
            oi.push(j)
            out.set_at(oi, acc)
            j = j + 1
        i = i + 1
    return out

# dot product: 1D tensors
T tensor_dot[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    T acc = T.default()
    int i = 0
    while i < sz:
        acc = acc + a.flat_get(i) * b.flat_get(i)
        i = i + 1
    return acc

# ── Comparisons ───────────────────────────────────────────────

Tensor[bool] tensor_eq[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Vector[int] sh = vec_int_copy(a.shape)
    Vector[bool] data = Vector[bool]()
    int i = 0
    while i < sz:
        data.push(a.flat_get(i) == b.flat_get(i))
        i = i + 1
    Vector[int] strides = tensor_compute_strides(sh)
    return Tensor[bool](Shared[Vector[bool]](data), sh, strides, 0)

Tensor[bool] tensor_lt[Numeric T](Tensor[T] a, Tensor[T] b):
    int sz = a.size()
    Vector[int] sh = vec_int_copy(a.shape)
    Vector[bool] data = Vector[bool]()
    int i = 0
    while i < sz:
        data.push(a.flat_get(i) < b.flat_get(i))
        i = i + 1
    Vector[int] strides = tensor_compute_strides(sh)
