# gg.cli — Command-line argument parsing
#
# Provides CliParser for declarative CLI argument definition and parsing.
# Supports flags (--verbose), options (--output file), and positional args.

from std.collections import Vector, Dict
from std.conv import int_to_str

# ── Helpers ──────────────────────────────────────────────────

private str strip_dashes(str s):
    int i = 0
    int slen = s.byte_len()
    while i < slen and s.char_at(i) == '-':
        i = i + 1
    return s.byte_slice(i, slen)

# ── Arg descriptor ───────────────────────────────────────────

struct CliArg:
    str long_name       # e.g., "--verbose" or "" for positionals
    str short_name      # e.g., "-v" or ""
    str help
    str default_val     # default value for options; "" for flags
    bool is_flag        # true = flag (no value), false = option or positional
    bool positional
    str pos_name        # display name for positional args

# ── Parser ───────────────────────────────────────────────────

struct CliParser:
    str app_name
    str app_desc
    Vector[CliArg] args
    Dict[str, str] parsed
    Vector[str] positional_vals
    Vector[str] pos_spec_names

equip CliParser:
    CliParser new(str name, str desc):
        return CliParser(name, desc, Vector[CliArg](), Dict[str, str](), Vector[str](), Vector[str]())

    void add_flag(&self, str long, str short, str help):
        self.args.push(CliArg(long, short, help, "", true, false, ""))

    void add_option(&self, str long, str short, str help, str default):
        str key = strip_dashes(long)
        self.args.push(CliArg(long, short, help, default, false, false, ""))
        self.parsed.put(key, default)

    void add_positional(&self, str name, str help):
        self.pos_spec_names.push(name)
        self.args.push(CliArg("", "", help, "", false, true, name))

    Result[bool, str] parse(&self, Vector[str] argv):
        int i = 0
        while i < argv.len():
            str tok = argv.get(i).unwrap()
            if tok.byte_len() >= 2 and tok.char_at(0) == '-':
                # Named argument: find matching CliArg
                bool found = false
                int ai = 0
                while ai < self.args.len():
                    CliArg a = self.args.get(ai).unwrap()
                    bool matches_tok = tok == a.long_name or tok == a.short_name
                    if not a.positional and matches_tok:
                        str key = strip_dashes(a.long_name)
                        if a.is_flag:
                            self.parsed.put(key, "true")
                        else:
                            i = i + 1
                            if i >= argv.len():
                                return Error("option requires a value")
                            self.parsed.put(key, argv.get(i).unwrap())
                        found = true
                        break
                    ai = ai + 1
                if not found:
                    return Error("unknown option")
            else:
                # Positional argument
                self.positional_vals.push(tok)
            i = i + 1
        return Ok(true)

    bool has(self, str name):
        if not self.parsed.contains(name):
            return false
        str val = self.parsed[name]
        return val != ""

    str get(self, str name):
        if self.parsed.contains(name):
            return self.parsed[name]
        return ""

    Vector[str] positionals(self):
        return self.positional_vals

    void print_help(self):
        print("Usage: " + self.app_name)
        if self.app_desc != "":
            print(self.app_desc)
        int pos_count = 0
        int ai = 0
        while ai < self.args.len():
            CliArg a = self.args.get(ai).unwrap()
            if a.positional:
                pos_count = pos_count + 1
            ai = ai + 1
        if pos_count > 0:
            print("Arguments:")
            ai = 0
            while ai < self.args.len():
                CliArg a = self.args.get(ai).unwrap()
                if a.positional:
                    print("  " + a.pos_name + "  " + a.help)
                ai = ai + 1
        print("Options:")
        ai = 0
        while ai < self.args.len():
            CliArg a = self.args.get(ai).unwrap()
            if not a.positional:
                String line = "  " + a.long_name
                if a.short_name != "":
                    line = line + ", " + a.short_name
                line = line + "  " + a.help
                if not a.is_flag and a.default_val != "":
                    line = line + " (default: " + a.default_val + ")"
                print(line)
            ai = ai + 1
