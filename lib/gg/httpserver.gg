# gg.httpserver — HTTP/1.1 server (V2: concurrent connections, keep-alive)
#
# Quick start:
#
#   from gg.httpserver import HttpServer, HttpRequest, HttpServerResponse
#
#   HttpServerResponse handle(HttpRequest req):
#       if req.method == "GET" and req.path == "/hello":
#           return HttpServerResponse.ok("Hello, World!")
#       return HttpServerResponse.not_found()
#
#   async void main():
#       HttpServer server = HttpServer.new("0.0.0.0", 8080)
#       server.serve(handle).await()
#

from std.net.socket import ServerSocket, Socket, server_socket_bind
from std.net.tls import TlsSocket, TlsServerSocket, tls_server_bind
from std.collections import Vector, Dict
from std.conv import int_to_str
from std.bytes import bytes_to_str
from std.fs import read_file, file_exists, is_dir
from std.path import path_join, path_extension

# ── Request and response types ────────────────────────────────

struct HttpRequest:
    str method          # "GET", "POST", ...
    str path            # "/api/users"
    str query_string    # raw query string without leading "?"
    str http_version    # "HTTP/1.1"
    Dict[str, str] headers   # lowercase header names
    str body
    Dict[str, str] params    # URL path parameters (populated by Router)

struct HttpServerResponse:
    int status_code
    str body
    str content_type
    Dict[str, str] headers   # additional response headers (e.g. Set-Cookie, CORS)

equip HttpServerResponse:
    HttpServerResponse ok(str body) = HttpServerResponse(200, body, "text/plain", Dict[str, str]())
    HttpServerResponse html(str body) = HttpServerResponse(200, body, "text/html", Dict[str, str]())
    HttpServerResponse json(str body) = HttpServerResponse(200, body, "application/json", Dict[str, str]())
    HttpServerResponse not_found() = HttpServerResponse(404, "Not Found", "text/plain", Dict[str, str]())
    HttpServerResponse bad_request(str msg) = HttpServerResponse(400, msg, "text/plain", Dict[str, str]())
    HttpServerResponse internal_error(str msg) = HttpServerResponse(500, msg, "text/plain", Dict[str, str]())

    HttpServerResponse with_header(self, str name, str value):
        Dict[str, str] new_headers = self.headers
        new_headers.put(name, value)
        return HttpServerResponse(self.status_code, self.body, self.content_type, new_headers)

    HttpServerResponse redirect(str location):
        Dict[str, str] hdrs = Dict[str, str]()
        hdrs.put("Location", location)
        return HttpServerResponse(302, "", "text/plain", hdrs)

    str status_text(self):
        int sc = self.status_code
        if sc == 200:
            return "OK"
        elif sc == 201:
            return "Created"
        elif sc == 204:
            return "No Content"
        elif sc == 301:
            return "Moved Permanently"
        elif sc == 302:
            return "Found"
        elif sc == 400:
            return "Bad Request"
        elif sc == 401:
            return "Unauthorized"
        elif sc == 403:
            return "Forbidden"
        elif sc == 404:
            return "Not Found"
        elif sc == 405:
            return "Method Not Allowed"
        elif sc == 500:
            return "Internal Server Error"
        elif sc == 502:
            return "Bad Gateway"
        elif sc == 503:
            return "Service Unavailable"
        return "Unknown"

# ── Request parser ────────────────────────────────────────────

Result[HttpRequest, str] http_server_parse_request(Socket &conn):
    # Request line: "METHOD /path?query HTTP/1.1"
    str req_line = conn.read_line()?

    Option[int] sp1_opt = req_line.index_of(" ")
    if sp1_opt.is_none():
        return Error("malformed request line")
    int sp1 = sp1_opt.unwrap()
    str req_method = req_line.byte_slice(0, sp1)
    str req_rest = req_line.byte_slice(sp1 + 1, req_line.byte_len())

    Option[int] sp2_opt = req_rest.index_of(" ")
    if sp2_opt.is_none():
        return Error("malformed request line")
    int sp2 = sp2_opt.unwrap()
    str raw_path = req_rest.byte_slice(0, sp2)
    str req_version = req_rest.byte_slice(sp2 + 1, req_rest.byte_len())

    # Split path at "?"
    str req_path = raw_path
    str req_query = ""
    Option[int] qm_opt = raw_path.index_of("?")
    if qm_opt.is_some():
        int qm = qm_opt.unwrap()
        req_path = raw_path.byte_slice(0, qm)
        req_query = raw_path.byte_slice(qm + 1, raw_path.byte_len())

    # Headers (read until blank line)
    Dict[str, str] req_headers = Dict[str, str]()
    bool reading_headers = true
    while reading_headers:
        str hdr_line = conn.read_line()?
        if hdr_line == "":
            reading_headers = false
        else:
            Option[int] colon_opt = hdr_line.index_of(":")
            if colon_opt.is_some():
                int colon = colon_opt.unwrap()
                str hdr_name = hdr_line.byte_slice(0, colon).trim().to_lower()
                str hdr_val = hdr_line.byte_slice(colon + 1, hdr_line.byte_len()).trim()
                req_headers.put(hdr_name, hdr_val)

    # Body (only if Content-Length present)
    str req_body = ""
    if req_headers.contains("content-length"):
        str cl_str = req_headers["content-length"]
        Option[int] cl_opt = int.parse(cl_str)
        if cl_opt is Some(cl_v):
            if cl_v > 0:
                Vector[uint8] body_bytes = conn.read_exact(cl_v)
                Result[str, str] body_r = bytes_to_str(body_bytes)
                if body_r.is_ok():
                    req_body = body_r.unwrap()

    return Ok(HttpRequest(req_method, req_path, req_query, req_version, req_headers, req_body, Dict[str, str]()))

# ── Response writers ──────────────────────────────────────────

# Write response with "Connection: close" (legacy/single-request).
void http_server_write_response(Socket &conn, HttpServerResponse resp):
    str status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    str body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    # Emit any custom headers
    Vector[str] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        str hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# Write response with Connection header based on keep_alive flag.
void http_server_write_response_ka(Socket &conn, HttpServerResponse resp, bool keep_alive):
    str status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    str body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    # Emit any custom headers
    Vector[str] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        str hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    if keep_alive:
        conn.write_str("Connection: keep-alive\r\n\r\n")
    else:
        conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# ── Connection handlers ───────────────────────────────────────

# Legacy single-request handler (kept for backward compat — httpserver_basic uses it directly).
void http_server_handle_conn(Socket conn, Callable[HttpServerResponse(HttpRequest)] handler):
    Result[HttpRequest, str] r = http_server_parse_request(&conn)
    match r:
        case Ok(req):
            HttpServerResponse resp = handler(req)
            http_server_write_response(&conn, resp)
        case Error(e):
            http_server_write_response(&conn, HttpServerResponse.bad_request(e))
    conn.close()

# Keep-alive connection handler: loop parse→handle→write on the same socket.
# Exits when:
#   - client sends "Connection: close"
#   - read times out (SO_RCVTIMEO set via timeout_ms)
#   - parse error (malformed request, EOF)
async void http_server_handle_conn_ka(Socket conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms):
    conn.set_timeout(timeout_ms)
    bool alive = true
    while alive:
        Result[HttpRequest, str] r = http_server_parse_request(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                http_server_write_response_ka(&conn, resp, not client_wants_close)
                if client_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# ── TLS connection handlers ───────────────────────────────────

# Parse an HTTP/1.1 request from a TLS socket (identical logic to plain-TCP version).
Result[HttpRequest, str] http_server_parse_request_tls(TlsSocket &conn):
    str req_line = conn.read_line()?

    Option[int] sp1_opt = req_line.index_of(" ")
    if sp1_opt.is_none():
        return Error("malformed request line")
    int sp1 = sp1_opt.unwrap()
    str req_method = req_line.byte_slice(0, sp1)
    str req_rest = req_line.byte_slice(sp1 + 1, req_line.byte_len())

    Option[int] sp2_opt = req_rest.index_of(" ")
    if sp2_opt.is_none():
        return Error("malformed request line")
    int sp2 = sp2_opt.unwrap()
    str raw_path = req_rest.byte_slice(0, sp2)
    str req_version = req_rest.byte_slice(sp2 + 1, req_rest.byte_len())

    str req_path = raw_path
    str req_query = ""
    Option[int] qm_opt = raw_path.index_of("?")
    if qm_opt.is_some():
        int qm = qm_opt.unwrap()
        req_path = raw_path.byte_slice(0, qm)
        req_query = raw_path.byte_slice(qm + 1, raw_path.byte_len())

    Dict[str, str] req_headers = Dict[str, str]()
    bool reading_headers = true
    while reading_headers:
        str hdr_line = conn.read_line()?
        if hdr_line == "":
            reading_headers = false
        else:
            Option[int] colon_opt = hdr_line.index_of(":")
            if colon_opt.is_some():
                int colon = colon_opt.unwrap()
                str hdr_name = hdr_line.byte_slice(0, colon).trim().to_lower()
                str hdr_val = hdr_line.byte_slice(colon + 1, hdr_line.byte_len()).trim()
                req_headers.put(hdr_name, hdr_val)

    str req_body = ""
    if req_headers.contains("content-length"):
        str cl_str = req_headers["content-length"]
        Option[int] cl_opt = int.parse(cl_str)
        if cl_opt is Some(cl_v):
            if cl_v > 0:
                Vector[uint8] body_bytes = conn.read_exact(cl_v)
                Result[str, str] body_r = bytes_to_str(body_bytes)
                if body_r.is_ok():
                    req_body = body_r.unwrap()

    return Ok(HttpRequest(req_method, req_path, req_query, req_version, req_headers, req_body, Dict[str, str]()))

# Write a keep-alive HTTP response over a TLS socket.
void http_server_write_response_tls_ka(TlsSocket &conn, HttpServerResponse resp, bool keep_alive):
    str status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    str body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    Vector[str] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        str hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    if keep_alive:
        conn.write_str("Connection: keep-alive\r\n\r\n")
    else:
        conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# Keep-alive connection handler for TLS sockets.
async void http_server_handle_conn_tls_ka(TlsSocket conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms):
    conn.set_timeout(timeout_ms)
    bool alive = true
    while alive:
        Result[HttpRequest, str] r = http_server_parse_request_tls(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                http_server_write_response_tls_ka(&conn, resp, not client_wants_close)
                if client_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# ── HttpServer ────────────────────────────────────────────────

struct HttpServer:
    str host
    int port
    int keep_alive_timeout_ms
    bool use_tls
    str cert_path
    str key_path

equip HttpServer:
    HttpServer new(str host, int port) = HttpServer(host, port, 5000, false, "", "")
    HttpServer with_timeout(str host, int port, int timeout_ms) = HttpServer(host, port, timeout_ms, false, "", "")

    # Construct a TLS-enabled server that will use the given PEM cert and key files.
    HttpServer new_tls(str host, int port, str cert_path, str key_path):
        return HttpServer(host, port, 5000, true, cert_path, key_path)

    # Bind and accept connections in a loop, calling handler for each.
    # Dispatches to serve_plain or serve_tls based on the use_tls flag.
    async void serve(self, Callable[HttpServerResponse(HttpRequest)] handler):
        if self.use_tls:
            self.serve_tls(handler).await()
        else:
            self.serve_plain(handler).await()

    # Plain TCP accept loop with per-connection keep-alive.
    async void serve_plain(self, Callable[HttpServerResponse(HttpRequest)] handler):
        Result[ServerSocket, str] bind_r = server_socket_bind(self.host, self.port)
        if bind_r.is_err():
            return
        ServerSocket srv = bind_r.unwrap()
        TaskGroup group = TaskGroup()
        loop:
            Result[Socket, str] ar = srv.accept()
            if ar.is_ok():
                Socket client = ar.unwrap()
                group.spawn(spawn http_server_handle_conn_ka(client, handler, self.keep_alive_timeout_ms))

    # TLS accept loop with per-connection keep-alive.
    async void serve_tls(self, Callable[HttpServerResponse(HttpRequest)] handler):
        Result[TlsServerSocket, str] bind_r = tls_server_bind(self.host, self.port, self.cert_path, self.key_path)
        if bind_r.is_err():
            return
        TlsServerSocket srv = bind_r.unwrap()
        TaskGroup group = TaskGroup()
        loop:
            Result[TlsSocket, str] ar = srv.accept()
            if ar.is_ok():
                TlsSocket client = ar.unwrap()
                group.spawn(spawn http_server_handle_conn_tls_ka(client, handler, self.keep_alive_timeout_ms))

# ── Query string parser ───────────────────────────────────────

Dict[str, str] parse_query_string(str qs):
    Dict[str, str] params = Dict[str, str]()
    if qs == "":
        return params
    Vector[str] pairs = qs.split("&")
    int i = 0
    while i < pairs.len():
        str pair = pairs[i]
        Option[int] eq_opt = pair.index_of("=")
        if eq_opt.is_some():
            int eq = eq_opt.unwrap()
            str key = pair.byte_slice(0, eq)
            str val = pair.byte_slice(eq + 1, pair.byte_len())
            params.put(key, val)
        else:
            params.put(pair, "")
        i = i + 1
    return params

equip HttpRequest:
    Dict[str, str] query_params(self):
        return parse_query_string(self.query_string)

# ── Router ────────────────────────────────────────────────────
#
# Registers handlers by "METHOD /path" key. Supports:
#  - Exact paths: "/api/users"
#  - Parameterized paths: "/users/:id" (colon-prefix denotes capture groups)
#
# Usage:
#   Router router = Router.new()
#   router.get("/hello", handle_hello)
#   router.get("/users/:id", handle_user)
#   server.serve((req): router.dispatch(req)).await()

# ── Path-parameter matching helper ────────────────────────────

# Match a URL path against a route pattern.
# Returns Ok(params_dict) on match, Error("") on miss.
# Pattern segments starting with ":" (e.g. ":id") capture the path segment.
Result[Dict[str, str], str] http_router_match_pattern(Vector[str] pattern, Vector[str] parts):
    if pattern.len() != parts.len():
        return Error("")
    Dict[str, str] params = Dict[str, str]()
    int i = 0
    while i < pattern.len():
        str seg = pattern[i]
        str part = parts[i]
        if seg.starts_with(":"):
            str param_name = seg.byte_slice(1, seg.byte_len())
            params.put(param_name, part)
        elif seg != part:
            return Error("")
        i = i + 1
    return Ok(params)

struct Router:
    Dict[str, Callable[HttpServerResponse(HttpRequest)]] exact_routes
    # Parameterized routes: key = "METHOD|/path/:param" (method + "|" + original path).
    # Segments are re-derived from the key at dispatch time by splitting on "/".
    # This avoids storing Vector[str] inside a Dict (which causes use-after-free when
    # the shallow-copied vector is freed while the dict still owns the data).
    Dict[str, Callable[HttpServerResponse(HttpRequest)]] param_routes
    # Middleware pipeline: each hook receives the original request and the handler's response,
    # and returns a (possibly modified) response. Applied in registration order after dispatch.
    # Signature: Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]
    # Use cases: add CORS headers, inject X-headers, log status codes, etc.
    Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]] middlewares

equip Router:
    Router new():
        Dict[str, Callable[HttpServerResponse(HttpRequest)]] ex = Dict[str, Callable[HttpServerResponse(HttpRequest)]]()
        Dict[str, Callable[HttpServerResponse(HttpRequest)]] pr = Dict[str, Callable[HttpServerResponse(HttpRequest)]]()
        Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]] mw = Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]]()
        return Router(ex, pr, mw)

    void route(&self, str method, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        Callable[HttpServerResponse(HttpRequest)] h = handler
        if path.contains(":"):
            str pkey = method + "|" + path
            self.param_routes.put(pkey, h)
        else:
            str key = method + " " + path
            self.exact_routes.put(key, h)

    void get(&self, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("GET", path, handler)

    void post(&self, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("POST", path, handler)

    void put(&self, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("PUT", path, handler)

    void delete(&self, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("DELETE", path, handler)

    void patch(&self, str path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("PATCH", path, handler)

    # Register a middleware hook. Each hook is called (in order) after the matched handler
    # returns, receiving the original request and the handler's response. The hook returns
    # the (possibly modified) response. Typical uses: CORS headers, security headers, logging.
    void use(&self, Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] hook):
        Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] h = hook
        self.middlewares.push(h)

    # Collect all HTTP methods registered for a given path (exact or matching param pattern).
    # Used by HEAD and OPTIONS auto-handling.
    Vector[str] allowed_methods(&self, str path):
        Vector[str] all_methods = Vector[str]()
        all_methods.push("GET")
        all_methods.push("POST")
        all_methods.push("PUT")
        all_methods.push("DELETE")
        all_methods.push("PATCH")
        Vector[str] found = Vector[str]()
        Vector[str] path_parts = path.split("/")
        int ai = 0
        while ai < all_methods.len():
            str m = all_methods[ai]
            str exact_key = m + " " + path
            if self.exact_routes.contains(exact_key):
                found.push(m)
                ai = ai + 1
                continue
            str mpfx = m + "|"
            int mpfx_len = m.byte_len() + 1
            Vector[str] pkeys = self.param_routes.keys()
            int pi = 0
            bool matched = false
            while pi < pkeys.len():
                str pkey = pkeys[pi]
                if pkey.starts_with(mpfx):
                    str route_path = pkey.byte_slice(mpfx_len, pkey.byte_len())
                    Vector[str] pattern = route_path.split("/")
                    Result[Dict[str, str], str] mr = http_router_match_pattern(pattern, path_parts)
                    if mr.is_ok():
                        matched = true
                pi = pi + 1
            if matched:
                found.push(m)
            ai = ai + 1
        return found

    # Inner dispatch: exact match → param match → HEAD/OPTIONS auto → 404. No middleware applied.
    HttpServerResponse dispatch_inner(&self, HttpRequest req):
        # 1. Exact-match first (O(1))
        str key = req.method + " " + req.path
        if self.exact_routes.contains(key):
            Callable[HttpServerResponse(HttpRequest)] h = self.exact_routes[key]
            return h(req)
        # 2. Parameterized match (linear scan over param_routes)
        Vector[str] path_parts = req.path.split("/")
        Vector[str] pkeys = self.param_routes.keys()
        str method_prefix = req.method + "|"
        int method_prefix_len = req.method.byte_len() + 1
        int pi = 0
        while pi < pkeys.len():
            str pkey = pkeys[pi]
            if pkey.starts_with(method_prefix):
                str route_path = pkey.byte_slice(method_prefix_len, pkey.byte_len())
                Vector[str] pattern = route_path.split("/")
                Result[Dict[str, str], str] m = http_router_match_pattern(pattern, path_parts)
                if m.is_ok():
                    Dict[str, str] extracted = m.unwrap()
                    HttpRequest matched_req = HttpRequest(req.method, req.path, req.query_string, req.http_version, req.headers, req.body, extracted)
                    Callable[HttpServerResponse(HttpRequest)] h = self.param_routes[pkey]
                    return h(matched_req)
            pi = pi + 1
        # 3. HEAD auto-handling: run the GET handler and strip the body.
        if req.method == "HEAD":
            HttpRequest get_req = HttpRequest("GET", req.path, req.query_string, req.http_version, req.headers, req.body, req.params)
            HttpServerResponse get_resp = self.dispatch_inner(get_req)
            return HttpServerResponse(get_resp.status_code, "", get_resp.content_type, get_resp.headers)
        # 4. OPTIONS auto-handling: respond with allowed methods for this path.
        if req.method == "OPTIONS":
            Vector[str] allowed = self.allowed_methods(req.path)
            if allowed.len() == 0:
                return HttpServerResponse.not_found()
            # Always include HEAD and OPTIONS in Allow header
            str allow_str = "OPTIONS, HEAD"
            int oi = 0
            while oi < allowed.len():
                allow_str = allow_str + ", " + allowed[oi]
                oi = oi + 1
            Dict[str, str] opts_hdrs = Dict[str, str]()
            opts_hdrs.put("Allow", allow_str)
            opts_hdrs.put("Content-Length", "0")
            return HttpServerResponse(200, "", "text/plain", opts_hdrs)
        # 5. Fallback: 404
        return HttpServerResponse.not_found()

    # Dispatch a request through the router: inner dispatch + middleware pipeline.
    HttpServerResponse dispatch(&self, HttpRequest req):
        HttpServerResponse resp = self.dispatch_inner(req)
        int mi = 0
        while mi < self.middlewares.len():
            Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] mw = self.middlewares[mi]
            resp = mw(req, resp)
            mi = mi + 1
        return resp

# ── Static file serving ───────────────────────────────────────

# Return the MIME type string for a file path based on its extension.
str http_mime_type(str path):
    str ext = path_extension(path)
    if ext == "html":
        return "text/html"
    elif ext == "htm":
        return "text/html"
    elif ext == "css":
        return "text/css"
    elif ext == "js":
        return "application/javascript"
    elif ext == "json":
        return "application/json"
    elif ext == "xml":
        return "text/xml"
    elif ext == "png":
        return "image/png"
    elif ext == "jpg":
        return "image/jpeg"
    elif ext == "jpeg":
        return "image/jpeg"
    elif ext == "gif":
        return "image/gif"
    elif ext == "svg":
        return "image/svg+xml"
    elif ext == "ico":
        return "image/x-icon"
    elif ext == "woff":
        return "font/woff"
    elif ext == "woff2":
        return "font/woff2"
    elif ext == "txt":
        return "text/plain"
    elif ext == "pdf":
        return "application/pdf"
    elif ext == "webp":
        return "image/webp"
    elif ext == "mp4":
        return "video/mp4"
    elif ext == "mp3":
        return "audio/mpeg"
    return "application/octet-stream"

# Serve a file from base_dir for the request path.
# - Rejects paths containing ".." (directory traversal protection).
# - Automatically serves index.html when the resolved path is a directory.
# - Returns 200 with file content + correct MIME type on success.
# - Returns 404 for missing files, 400 for invalid paths.
HttpServerResponse http_serve_file(str base_dir, HttpRequest req):
    if req.path.contains(".."):
        return HttpServerResponse.bad_request("invalid path")
    mutable str file_path = path_join(base_dir, req.path)
    if is_dir(file_path):
        file_path = path_join(file_path, "index.html")
    if not file_exists(file_path):
        return HttpServerResponse.not_found()
    str content = read_file(file_path)
    str mime = http_mime_type(file_path)
    return HttpServerResponse(200, content, mime, Dict[str, str]())
