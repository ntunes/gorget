# std.csv — RFC 4180 CSV parser and serializer
#
# Pure Gorget implementation. Supports quoted fields, embedded newlines,
# configurable delimiter, and header-based table access.

from std.collections import Vector

# ── CsvParser ────────────────────────────────────────────────

struct CsvParser:
    str input
    int pos
    str err
    str delim

equip CsvParser:
    bool failed(self): self.err != ""

    void fail(&self, str msg):
        if self.err == "":
            self.err = move msg

    bool at_end(self): self.pos >= self.input.byte_len()

    str peek(self): self.input.char_at(self.pos)

    void advance(&self):
        self.pos = self.pos + 1

    str parse_field(&self):
        if self.failed():
            return ""
        if self.at_end():
            return ""
        if self.peek() == '"':
            return self.parse_quoted()
        # Unquoted field — consume until delimiter, \r, \n, or EOF
        str val = ""
        while not self.at_end():
            str ch = self.peek()
            if ch == self.delim or ch == '\r' or ch == '\n':
                return val
            val = val + ch
            self.advance()
        return val

    str parse_quoted(&self):
        # Skip opening quote
        self.advance()
        str val = ""
        while not self.at_end():
            str ch = self.peek()
            if ch == '"':
                self.advance()
                # "" inside quoted field = literal "
                if not self.at_end() and self.peek() == '"':
                    val = val + "\""
                    self.advance()
                else:
                    return val
            else:
                val = val + ch
                self.advance()
        self.fail("unterminated quoted field")
        return ""

    Vector[str] parse_record(&self):
        Vector[str] fields = Vector[str]()
        if self.failed():
            return fields
        # Parse first field
        str fld = self.parse_field()
        if self.failed():
            return fields
        fields.push(fld)
        # Parse remaining fields separated by delimiter
        while not self.at_end() and not self.failed():
            str ch = self.peek()
            if ch == self.delim:
                self.advance()
                str next = self.parse_field()
                if self.failed():
                    return fields
                fields.push(next)
            else:
                # End of record — consume line ending
                if ch == '\r':
                    self.advance()
                    if not self.at_end() and self.peek() == '\n':
                        self.advance()
                elif ch == '\n':
                    self.advance()
                return fields
        return fields

    Vector[Vector[str]] parse_all(&self):
        Vector[Vector[str]] records = Vector[Vector[str]]()
        while not self.at_end() and not self.failed():
            # Skip bare trailing newlines
            if self.peek() == '\r' or self.peek() == '\n':
                if self.peek() == '\r':
                    self.advance()
                    if not self.at_end() and self.peek() == '\n':
                        self.advance()
                else:
                    self.advance()
                continue
            Vector[str] rec = self.parse_record()
            if self.failed():
                return records
            records.push(rec)
        return records

# ── CsvTable ─────────────────────────────────────────────────

struct CsvTable:
    Vector[str] headers_data
    Vector[Vector[str]] rows_data

equip CsvTable:
    int row_count(self): self.rows_data.len()

    int col_count(self): self.headers_data.len()

    Vector[str] headers(self): self.headers_data

    Vector[str] row(self, int n):
        return self.rows_data.get(n).unwrap()

    str get(self, int row_idx, int col_idx):
        Vector[str] r = self.rows_data.get(row_idx).unwrap()
        return r.get(col_idx).unwrap()

    str get_named(self, int row_idx, str col):
        int ci = self.column_index(col)
        if ci < 0:
            return ""
        Vector[str] r = self.rows_data.get(row_idx).unwrap()
        return r.get(ci).unwrap()

    bool has_column(self, str name):
        int k = 0
        while k < self.headers_data.len():
            if self.headers_data.get(k).unwrap() == name:
                return true
            k = k + 1
        return false

    int column_index(self, str name):
        int k = 0
        while k < self.headers_data.len():
            if self.headers_data.get(k).unwrap() == name:
                return k
            k = k + 1
        return -1

# ── Stringify helper ─────────────────────────────────────────

private str stringify_field(str field, str sep):
    # Check if quoting is needed
    bool need_quote = false
    int fi = 0
    while fi < field.byte_len():
        str fc = field.char_at(fi)
        if fc == sep or fc == '"' or fc == '\n' or fc == '\r':
            need_quote = true
        fi = fi + 1
    if not need_quote:
        return field
    # Quote: wrap in " and double any " chars
    str out = "\""
    int fj = 0
    while fj < field.byte_len():
        str qc = field.char_at(fj)
        if qc == '"':
            out = out + "\"\""
        else:
            out = out + qc
        fj = fj + 1
    return out + "\""

# ── Public API ───────────────────────────────────────────────

Result[Vector[Vector[str]], str] parse(str text):
    return parse_delim(text, ",")

Result[Vector[Vector[str]], str] parse_delim(str text, str sep):
    CsvParser p = CsvParser(text, 0, "", sep)
    Vector[Vector[str]] recs = p.parse_all()
    if p.failed():
        return Error(p.err)
    return Ok(recs)

Result[CsvTable, str] parse_table(str text):
    return parse_table_delim(text, ",")

Result[CsvTable, str] parse_table_delim(str text, str sep):
    CsvParser p = CsvParser(text, 0, "", sep)
    Vector[Vector[str]] all = p.parse_all()
    if p.failed():
        return Error(p.err)
    if all.len() == 0:
        Vector[str] empty_hdr = Vector[str]()
        Vector[Vector[str]] empty_rows = Vector[Vector[str]]()
        return Ok(CsvTable(empty_hdr, empty_rows))
    Vector[str] hdr = all.get(0).unwrap()
    Vector[Vector[str]] data = Vector[Vector[str]]()
    int ri = 1
    while ri < all.len():
        data.push(all.get(ri).unwrap())
        ri = ri + 1
    return Ok(CsvTable(hdr, data))

str stringify(Vector[Vector[str]] rows):
    return stringify_delim(rows, ",")

str stringify_delim(Vector[Vector[str]] rows, str sep):
    str out = ""
    int ri = 0
    while ri < rows.len():
        Vector[str] r = rows.get(ri).unwrap()
        int ci = 0
        while ci < r.len():
            if ci > 0:
                out = out + sep
            out = out + stringify_field(r.get(ci).unwrap(), sep)
            ci = ci + 1
        out = out + "\r\n"
        ri = ri + 1
    return out

str stringify_table(CsvTable tbl):
    return stringify_table_delim(tbl, ",")

str stringify_table_delim(CsvTable tbl, str sep):
    str out = ""
    # Headers
    int hi = 0
    while hi < tbl.headers_data.len():
        if hi > 0:
            out = out + sep
        out = out + stringify_field(tbl.headers_data.get(hi).unwrap(), sep)
        hi = hi + 1
    out = out + "\r\n"
    # Rows
    int ri = 0
    while ri < tbl.rows_data.len():
        Vector[str] r = tbl.rows_data.get(ri).unwrap()
        int ci = 0
        while ci < r.len():
            if ci > 0:
                out = out + sep
            out = out + stringify_field(r.get(ci).unwrap(), sep)
            ci = ci + 1
        out = out + "\r\n"
        ri = ri + 1
    return out
