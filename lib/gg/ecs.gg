# gg.ecs — Entity Component System primitives
#
# Provides EntityPool for entity ID management with generational recycling
# (fixes ABA problem and double-destroy), and SparseSet[T] for O(1)
# component storage and lookup.

from std.collections import Vector

struct Entity:
    int id
    int gen

equip Entity with Displayable:
    str display(self):
        return "Entity({self.id}:{self.gen})"

struct EntityPool:
    int next_id
    Vector[int] free_ids
    Vector[int] generations
    Vector[bool] alive

equip EntityPool:
    EntityPool new():
        return EntityPool(0, Vector[int](), Vector[int](), Vector[bool]())

    Entity create(&self):
        int id = -1
        if self.free_ids.len() > 0:
            id = self.free_ids.pop().unwrap()
        else:
            id = self.next_id
            self.next_id = self.next_id + 1
        while self.generations.len() <= id:
            self.generations.push(0)
            self.alive.push(false)
        self.alive.set(id, true)
        int gen = self.generations.get(id).unwrap()
        return Entity(id, gen)

    void destroy(&self, Entity e):
        if e.id < 0 or e.id >= self.next_id:
            return
        if self.alive.get(e.id).unwrap() == false:
            return
        if self.generations.get(e.id).unwrap() != e.gen:
            return
        self.alive.set(e.id, false)
        self.generations.set(e.id, e.gen + 1)
        self.free_ids.push(e.id)

    bool is_alive(self, Entity e):
        if e.id < 0 or e.id >= self.next_id:
            return false
        if self.alive.get(e.id).unwrap() == false:
            return false
        return self.generations.get(e.id).unwrap() == e.gen

    int count(self):
        return self.next_id - self.free_ids.len()

    int max_id(self):
        return self.next_id

struct SparseSet[T]:
    Vector[int] sparse
    Vector[Entity] entity_ids
    Vector[T] data
    int count

equip SparseSet[T]:
    void insert(&self, Entity e, T value):
        int id = e.id
        while self.sparse.len() <= id:
            self.sparse.push(-1)
        int idx = self.sparse.get(id).unwrap()
        if idx != -1:
            # Already present — update in place
            self.data.set(idx, value)
            return
        # Add new entry
        int new_idx = self.count
        self.sparse.set(id, new_idx)
        self.entity_ids.push(e)
        self.data.push(value)
        self.count = self.count + 1

    void remove(&self, Entity e):
        int id = e.id
        if id < 0 or id >= self.sparse.len():
            return
        int idx = self.sparse.get(id).unwrap()
        if idx == -1:
            return
        int last = self.count - 1
        if idx != last:
            # Swap with last element
            Entity last_entity = self.entity_ids.get(last).unwrap()
            T last_data = self.data.get(last).unwrap()
            self.entity_ids.set(idx, last_entity)
            self.data.set(idx, last_data)
            self.sparse.set(last_entity.id, idx)
        # Pop last element
        self.entity_ids.pop()
        self.data.pop()
        self.sparse.set(id, -1)
        self.count = self.count - 1

    bool has(self, Entity e):
        if e.id < 0 or e.id >= self.sparse.len():
            return false
        return self.sparse.get(e.id).unwrap() != -1

    T get(self, Entity e):
        int idx = self.sparse.get(e.id).unwrap()
        return self.data.get(idx).unwrap()

    void set(&self, Entity e, T value):
        int id = e.id
        if id < 0 or id >= self.sparse.len():
            return
        int idx = self.sparse.get(id).unwrap()
        if idx == -1:
            return
        self.data.set(idx, value)

    int len(self):
        return self.count

    Entity entity_at(self, int idx):
        return self.entity_ids.get(idx).unwrap()

    T data_at(self, int idx):
        return self.data.get(idx).unwrap()

struct SparseSetIter:
    Vector[Entity] entity_ids
    int idx
    int count

equip SparseSetIter with Iterator[Entity]:
    Option[Entity] next(&self):
        if self.idx >= self.count:
            return None
        Entity e = self.entity_ids.get(self.idx).unwrap()
        self.idx = self.idx + 1
        return Some(e)

equip SparseSet[T] with Iterable[Entity]:
    SparseSetIter iter(&self):
        Vector[Entity] ecs_eids = Vector[Entity]()
        int ecs_i = 0
        while ecs_i < self.count:
            ecs_eids.push(self.entity_ids.get(ecs_i).unwrap())
            ecs_i = ecs_i + 1
        return SparseSetIter(ecs_eids, 0, self.count)
