# gg.dataframe — Pandas-style DataFrame library for Gorget
#
# Core types:
#   TypedColumn[T] — generic typed column with null mask
#   Column — discriminated union of column types
#   DataFrame — ordered dict of named columns
#
# Construction:
#   df_from_columns(names, cols), df_from_records(headers, rows)
#   df_from_records_typed(headers, rows) — with type inference
#   df_from_csv(csv_text) → Result[DataFrame, str]
#
# Access:
#   df.get_column(name), df.nrows(), df.ncols(), df.head(n), df.tail(n)
#   df.dtypes(), df.column_names(), df.row_as_dict(idx), df.display()
#
# Selection & Filtering:
#   df.select(cols), df.drop(col), df.df_slice(start, end)
#   df.filter_mask(mask), df.filter_by(col, op, val)
#   df.df_unique(col), df.df_nunique(col)
#   df.isna(col), df.notna(col)
#
# Aggregation:
#   df.df_sum(col), df.df_mean(col), df.df_min(col), df.df_max(col)
#   df.df_count(col), df.df_std(col), df.df_var(col), df.df_median(col)
#   df.describe(), df.value_counts(col)
#   df.nlargest(n, col), df.nsmallest(n, col)
#
# Transformation:
#   df.sort_by(col, ascending), df.sort_by_multi(cols, ascending_list)
#   df.add_column(name, col), df.replace_column(name, col)
#   df.rename_column(old, new)
#   df.apply_int(col, fn), df.apply_float(col, fn), df.apply_str(col, fn)
#   df.fillna_int(col, val), df.fillna_float(col, val), df.fillna_str(col, val)
#   df.dropna()
#   df.col_add(a, b, result), df.col_sub(a, b, result), df.col_mul(a, b, result)
#   df.sample(n, seed), df.shuffle(seed)
#
# GroupBy & Joins:
#   df_group_by(df, col) → GroupBy, group.agg(target, op)
#   df_group_by_multi(df, cols) → MultiGroupBy, group.agg(target, op)
#   df_inner_join(left, right, on), df_left_join(left, right, on)
#   df_right_join(left, right, on), df_outer_join(left, right, on)
#   df_cross_join(left, right), df_concat(a, b)
#
# Column Helpers:
#   col_from_ints(data), col_from_floats(data), col_from_strs(data), col_from_bools(data)
#   col_ints_null(data, mask), col_floats_null(data, mask), col_strs_null(data, mask)
#   col_bools_null(data, mask)
#   col_gather(col, idxs), col_concat(a, b), col_slice(col, start, end)
#   col_filter(col, mask), col_gather_nullable(col, idxs)
#
# I/O:
#   df_from_csv(csv_text), df_to_csv(df)

from std.collections import Vector, Dict
from std.conv import int_to_str, float_to_str, bool_to_str, parse_int, parse_float, int_to_float
from std.math import sqrt, floor, ceil

# Returns true if s represents a valid integer (optional leading -, then digits)
bool str_is_int(str s):
    int n = s.byte_len()
    if n == 0:
        return false
    int start = 0
    if s.char_at(0) == '-':
        start = 1
    if start >= n:
        return false
    int i = start
    while i < n:
        if not s.char_at(i).is_digit():
            return false
        i = i + 1
    return true

# Returns true if s represents a valid float (integer or decimal)
bool str_is_float(str s):
    int n = s.byte_len()
    if n == 0:
        return false
    int start = 0
    if s.char_at(0) == '-':
        start = 1
    if start >= n:
        return false
    bool has_dot = false
    int i = start
    while i < n:
        str c = s.char_at(i)
        if c == '.':
            if has_dot:
                return false
            has_dot = true
        elif not c.is_digit():
            return false
        i = i + 1
    return true

# ── Column Types ─────────────────────────────────────────────

# Typed column: data array + null mask (true = present, false = null)
struct TypedColumn[T]:
    Vector[T] data
    Vector[bool] mask

enum Column:
    IntCol(TypedColumn[int])
    FloatCol(TypedColumn[float])
    StrCol(TypedColumn[str])
    BoolCol(TypedColumn[bool])

struct DataFrame:
    Dict[str, Column] columns
    Vector[str] col_names
    int num_rows

# ── GroupBy ──────────────────────────────────────────────────

struct GroupBy:
    DataFrame source
    str group_col
    Dict[str, Vector[int]] groups

# ── Column Access Helpers ────────────────────────────────────

equip TypedColumn[T]:
    int col_len(self) = self.data.len()
    bool is_null(self, int idx):
        Option[bool] m = self.mask.get(idx)
        if m.is_none():
            return true
        return not m.unwrap()
    T get_val(self, int idx) = self.data.get(idx).unwrap()
    int null_count(self):
        int cnt = 0
        int i = 0
        while i < self.mask.len():
            if not self.mask.get(i).unwrap():
                cnt = cnt + 1
            i = i + 1
        return cnt

# ── Column Dispatch ──────────────────────────────────────────

equip Column:
    int col_len(self):
        match self:
            case IntCol(c):
                return c.col_len()
            case FloatCol(c):
                return c.col_len()
            case StrCol(c):
                return c.col_len()
            case BoolCol(c):
                return c.col_len()

    bool is_null_at(self, int idx):
        match self:
            case IntCol(c):
                return c.is_null(idx)
            case FloatCol(c):
                return c.is_null(idx)
            case StrCol(c):
                return c.is_null(idx)
            case BoolCol(c):
                return c.is_null(idx)

    str value_as_str(self, int idx):
        match self:
            case IntCol(c):
                if c.is_null(idx):
                    return "null"
                return int_to_str(c.get_val(idx))
            case FloatCol(c):
                if c.is_null(idx):
                    return "null"
                return float_to_str(c.get_val(idx))
            case StrCol(c):
                if c.is_null(idx):
                    return "null"
                return c.get_val(idx)
            case BoolCol(c):
                if c.is_null(idx):
                    return "null"
                return bool_to_str(c.get_val(idx))

    str dtype_name(self):
        match self:
            case IntCol(_):
                return "int"
            case FloatCol(_):
                return "float"
            case StrCol(_):
                return "str"
            case BoolCol(_):
                return "bool"

    int null_count(self):
        match self:
            case IntCol(c):
                return c.null_count()
            case FloatCol(c):
                return c.null_count()
            case StrCol(c):
                return c.null_count()
            case BoolCol(c):
                return c.null_count()

# ── Column Constructors ──────────────────────────────────────

Column col_from_ints(Vector[int] data):
    Vector[int] d = vec_int_copy(data)
    Vector[bool] mask = Vector[bool]()
    int i = 0
    while i < data.len():
        mask.push(true)
        i = i + 1
    return IntCol(TypedColumn[int](d, mask))

Column col_from_floats(Vector[float] data):
    Vector[float] d = vec_float_copy(data)
    Vector[bool] mask = Vector[bool]()
    int i = 0
    while i < data.len():
        mask.push(true)
        i = i + 1
    return FloatCol(TypedColumn[float](d, mask))

Column col_from_strs(Vector[str] data):
    Vector[str] d = vec_str_copy(data)
    Vector[bool] mask = Vector[bool]()
    int i = 0
    while i < data.len():
        mask.push(true)
        i = i + 1
    return StrCol(TypedColumn[str](d, mask))

Column col_from_bools(Vector[bool] data):
    Vector[bool] d = vec_bool_copy(data)
    Vector[bool] mask = Vector[bool]()
    int i = 0
    while i < data.len():
        mask.push(true)
        i = i + 1
    return BoolCol(TypedColumn[bool](d, mask))

# Nullable column constructors — mask[i]=true means present, false means null
Column col_ints_null(Vector[int] data, Vector[bool] mask):
    return IntCol(TypedColumn[int](vec_int_copy(data), vec_bool_copy(mask)))

Column col_strs_null(Vector[str] data, Vector[bool] mask):
    return StrCol(TypedColumn[str](vec_str_copy(data), vec_bool_copy(mask)))

Column col_floats_null(Vector[float] data, Vector[bool] mask):
    return FloatCol(TypedColumn[float](vec_float_copy(data), vec_bool_copy(mask)))

Column col_bools_null(Vector[bool] data, Vector[bool] mask):
    return BoolCol(TypedColumn[bool](vec_bool_copy(data), vec_bool_copy(mask)))

# ── Generic Column Inner Helpers ─────────────────────────────
# These operate on TypedColumn[T] to eliminate 4-way dispatch boilerplate.

TypedColumn[T] col_slice_inner[T](TypedColumn[T] col, int start, int end):
    Vector[T] d = Vector[T]()
    Vector[bool] m = Vector[bool]()
    int i = start
    while i < end:
        d.push(col.data.get(i).unwrap())
        m.push(col.mask.get(i).unwrap())
        i = i + 1
    return TypedColumn[T](d, m)

TypedColumn[T] col_filter_inner[T](TypedColumn[T] col, Vector[bool] mask):
    Vector[T] d = Vector[T]()
    Vector[bool] m = Vector[bool]()
    int i = 0
    while i < mask.len():
        if mask.get(i).unwrap():
            d.push(col.data.get(i).unwrap())
            m.push(col.mask.get(i).unwrap())
        i = i + 1
    return TypedColumn[T](d, m)

TypedColumn[T] col_gather_inner[T](TypedColumn[T] col, Vector[int] idxs):
    Vector[T] d = Vector[T]()
    Vector[bool] m = Vector[bool]()
    int i = 0
    while i < idxs.len():
        int idx = idxs.get(i).unwrap()
        d.push(col.data.get(idx).unwrap())
        m.push(col.mask.get(idx).unwrap())
        i = i + 1
    return TypedColumn[T](d, m)

# null_val: the sentinel value to insert for -1 index (absent row in join)
TypedColumn[T] col_gather_nullable_inner[T](TypedColumn[T] col, Vector[int] idxs, T null_val):
    Vector[T] d = Vector[T]()
    Vector[bool] m = Vector[bool]()
    int i = 0
    while i < idxs.len():
        int idx = idxs.get(i).unwrap()
        if idx < 0:
            d.push(null_val)
            m.push(false)
        else:
            d.push(col.data.get(idx).unwrap())
            m.push(col.mask.get(idx).unwrap())
        i = i + 1
    return TypedColumn[T](d, m)

# Deep-copy a Column (for head/tail/slice)
Column col_slice(Column col, int start, int end):
    match col:
        case IntCol(c):
            return IntCol(col_slice_inner[int](c, start, end))
        case FloatCol(c):
            return FloatCol(col_slice_inner[float](c, start, end))
        case StrCol(c):
            return StrCol(col_slice_inner[str](c, start, end))
        case BoolCol(c):
            return BoolCol(col_slice_inner[bool](c, start, end))

# Filter column by boolean mask
Column col_filter(Column col, Vector[bool] mask):
    match col:
        case IntCol(c):
            return IntCol(col_filter_inner[int](c, mask))
        case FloatCol(c):
            return FloatCol(col_filter_inner[float](c, mask))
        case StrCol(c):
            return StrCol(col_filter_inner[str](c, mask))
        case BoolCol(c):
            return BoolCol(col_filter_inner[bool](c, mask))

# Gather (reorder) column by index array — preserves types and null masks
Column col_gather(Column col, Vector[int] idxs):
    match col:
        case IntCol(c):
            return IntCol(col_gather_inner[int](c, idxs))
        case FloatCol(c):
            return FloatCol(col_gather_inner[float](c, idxs))
        case StrCol(c):
            return StrCol(col_gather_inner[str](c, idxs))
        case BoolCol(c):
            return BoolCol(col_gather_inner[bool](c, idxs))

# Concatenate two typed columns (shared generic body)
TypedColumn[T] col_concat_inner[T](TypedColumn[T] a, TypedColumn[T] b):
    Vector[T] d = Vector[T]()
    Vector[bool] m = Vector[bool]()
    int i = 0
    while i < a.data.len():
        d.push(a.data.get(i).unwrap())
        m.push(a.mask.get(i).unwrap())
        i = i + 1
    i = 0
    while i < b.data.len():
        d.push(b.data.get(i).unwrap())
        m.push(b.mask.get(i).unwrap())
        i = i + 1
    return TypedColumn[T](d, m)

# Concatenate two columns of the same type — preserves types and null masks
Column col_concat(Column a, Column b):
    match a:
        case IntCol(ca):
            match b:
                case IntCol(cb):
                    return IntCol(col_concat_inner[int](ca, cb))
                else:
                    return a
        case FloatCol(ca):
            match b:
                case FloatCol(cb):
                    return FloatCol(col_concat_inner[float](ca, cb))
                else:
                    return a
        case StrCol(ca):
            match b:
                case StrCol(cb):
                    return StrCol(col_concat_inner[str](ca, cb))
                else:
                    return a
        case BoolCol(ca):
            match b:
                case BoolCol(cb):
                    return BoolCol(col_concat_inner[bool](ca, cb))
                else:
                    return a

# ── D1: DataFrame Core ───────────────────────────────────────

DataFrame df_from_columns(Vector[str] names, Vector[Column] cols):
    Dict[str, Column] columns = Dict[str, Column]()
    int nr = 0
    int i = 0
    while i < names.len():
        str name = names.get(i).unwrap()
        Column col = cols.get(i).unwrap()
        columns.set(name, col)
        if col.col_len() > nr:
            nr = col.col_len()
        i = i + 1
    return DataFrame(columns, vec_str_copy(names), nr)

equip DataFrame:
    Column get_column(self, str name):
        return self.columns.get(name).unwrap()

    bool has_column(self, str name):
        return self.columns.has(name)

    Vector[str] column_names(self):
        return vec_str_copy(self.col_names)

    int nrows(self) = self.num_rows

    int ncols(self) = self.col_names.len()

    DataFrame head(self, int n):
        int end = n
        if end > self.num_rows:
            end = self.num_rows
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            new_cols.push(col_slice(col, 0, end))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    DataFrame tail(self, int n):
        int start = self.num_rows - n
        if start < 0:
            start = 0
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            new_cols.push(col_slice(col, start, self.num_rows))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    # Display as aligned table
    str display(self):
        if self.col_names.len() == 0:
            return "DataFrame(empty)"
        # Collect max widths per column
        Vector[int] widths = Vector[int]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            int w = name.byte_len()
            Column col = self.columns.get(name).unwrap()
            int j = 0
            while j < self.num_rows:
                int vw = col.value_as_str(j).byte_len()
                if vw > w:
                    w = vw
                j = j + 1
            widths.push(w)
            i = i + 1
        # Header row
        str out = ""
        i = 0
        while i < self.col_names.len():
            if i > 0:
                out = out + "  "
            str name = self.col_names.get(i).unwrap()
            int w = widths.get(i).unwrap()
            out = out + name
            int pad = w - name.byte_len()
            int p = 0
            while p < pad:
                out = out + " "
                p = p + 1
            i = i + 1
        out = out + "\n"
        # Separator
        i = 0
        while i < self.col_names.len():
            if i > 0:
                out = out + "  "
            int w = widths.get(i).unwrap()
            int p = 0
            while p < w:
                out = out + "-"
                p = p + 1
            i = i + 1
        out = out + "\n"
        # Data rows
        int r = 0
        while r < self.num_rows:
            i = 0
            while i < self.col_names.len():
                if i > 0:
                    out = out + "  "
                str name = self.col_names.get(i).unwrap()
                Column col = self.columns.get(name).unwrap()
                str val = col.value_as_str(r)
                int w = widths.get(i).unwrap()
                out = out + val
                int pad = w - val.byte_len()
                int p = 0
                while p < pad:
                    out = out + " "
                    p = p + 1
                i = i + 1
            out = out + "\n"
            r = r + 1
        return out

# ── D2: Selection & Filtering ────────────────────────────────

equip DataFrame:
    DataFrame select(self, Vector[str] cols):
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < cols.len():
            str name = cols.get(i).unwrap()
            new_cols.push(self.columns.get(name).unwrap())
            i = i + 1
        return df_from_columns(cols, new_cols)

    DataFrame drop(self, str col_name):
        Vector[str] new_names = Vector[str]()
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            if name != col_name:
                new_names.push(name)
                new_cols.push(self.columns.get(name).unwrap())
            i = i + 1
        return df_from_columns(new_names, new_cols)

    DataFrame df_slice(self, int start, int end):
        int s = start
        int e = end
        if s < 0:
            s = 0
        if e > self.num_rows:
            e = self.num_rows
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            new_cols.push(col_slice(col, s, e))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    DataFrame filter_mask(self, Vector[bool] mask):
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            new_cols.push(col_filter(col, mask))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    # filter_by: filter rows where col op val (val as string)
    # op: "==", "!=", "<", ">", "<=", ">="
    DataFrame filter_by(self, str col_name, str op, str val):
        Column col = self.columns.get(col_name).unwrap()
        Vector[bool] mask = Vector[bool]()
        int i = 0
        match col:
            case IntCol(c):
                Result[int, str] parsed_int = parse_int(val)
                while i < self.num_rows:
                    bool keep = false
                    if c.is_null(i):
                        keep = false
                    elif parsed_int.is_ok():
                        int lv = c.data.get(i).unwrap()
                        int rv = parsed_int.unwrap()
                        if op == "==":
                            keep = lv == rv
                        elif op == "!=":
                            keep = lv != rv
                        elif op == "<":
                            keep = lv < rv
                        elif op == ">":
                            keep = lv > rv
                        elif op == "<=":
                            keep = lv <= rv
                        elif op == ">=":
                            keep = lv >= rv
                    mask.push(keep)
                    i = i + 1
            case FloatCol(c):
                Result[float, str] parsed_flt = parse_float(val)
                while i < self.num_rows:
                    bool keep = false
                    if c.is_null(i):
                        keep = false
                    elif parsed_flt.is_ok():
                        float lv = c.data.get(i).unwrap()
                        float rv = parsed_flt.unwrap()
                        if op == "==":
                            keep = lv == rv
                        elif op == "!=":
                            keep = lv != rv
                        elif op == "<":
                            keep = lv < rv
                        elif op == ">":
                            keep = lv > rv
                        elif op == "<=":
                            keep = lv <= rv
                        elif op == ">=":
                            keep = lv >= rv
                    mask.push(keep)
                    i = i + 1
            case StrCol(c):
                while i < self.num_rows:
                    bool keep = false
                    if not c.is_null(i):
                        str sv = c.data.get(i).unwrap()
                        if op == "==":
                            keep = sv == val
                        elif op == "!=":
                            keep = sv != val
                        elif op == "<":
                            keep = sv < val
                        elif op == ">":
                            keep = sv > val
                        elif op == "<=":
                            keep = sv <= val
                        elif op == ">=":
                            keep = sv >= val
                    mask.push(keep)
                    i = i + 1
            case BoolCol(c):
                while i < self.num_rows:
                    bool keep = false
                    if not c.is_null(i):
                        str sv = bool_to_str(c.data.get(i).unwrap())
                        if op == "==":
                            keep = sv == val
                        elif op == "!=":
                            keep = sv != val
                    mask.push(keep)
                    i = i + 1
        return self.filter_mask(mask)

    Dict[str, str] row_as_dict(self, int idx):
        Dict[str, str] d = Dict[str, str]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            d.set(name, col.value_as_str(idx))
            i = i + 1
        return d

# ── D3: Aggregation ──────────────────────────────────────────

equip DataFrame:
    str df_sum(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                int acc = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                    i = i + 1
                return int_to_str(acc)
            case FloatCol(c):
                float acc = 0.0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                    i = i + 1
                return float_to_str(acc)
            else:
                return "N/A"

    str df_mean(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                int acc = 0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                return float_to_str(int_to_float(acc) / int_to_float(cnt))
            case FloatCol(c):
                float acc = 0.0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                return float_to_str(acc / int_to_float(cnt))
            else:
                return "N/A"

    str df_min(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                bool found = false
                int m = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        int v = c.data.get(i).unwrap()
                        if not found or v < m:
                            m = v
                            found = true
                    i = i + 1
                if not found:
                    return "N/A"
                return int_to_str(m)
            case FloatCol(c):
                bool found = false
                float m = 0.0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float v = c.data.get(i).unwrap()
                        if not found or v < m:
                            m = v
                            found = true
                    i = i + 1
                if not found:
                    return "N/A"
                return float_to_str(m)
            else:
                return "N/A"

    str df_max(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                bool found = false
                int m = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        int v = c.data.get(i).unwrap()
                        if not found or v > m:
                            m = v
                            found = true
                    i = i + 1
                if not found:
                    return "N/A"
                return int_to_str(m)
            case FloatCol(c):
                bool found = false
                float m = 0.0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float v = c.data.get(i).unwrap()
                        if not found or v > m:
                            m = v
                            found = true
                    i = i + 1
                if not found:
                    return "N/A"
                return float_to_str(m)
            else:
                return "N/A"

    int df_count(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        return col.col_len() - col.null_count()

    str df_std(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case FloatCol(c):
                float acc = 0.0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                float mean = acc / int_to_float(cnt)
                float var = 0.0
                i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float diff = c.data.get(i).unwrap() - mean
                        var = var + diff * diff
                    i = i + 1
                return float_to_str(sqrt(var / int_to_float(cnt)))
            case IntCol(c):
                float acc = 0.0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + int_to_float(c.data.get(i).unwrap())
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                float mean = acc / int_to_float(cnt)
                float var = 0.0
                i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float v = int_to_float(c.data.get(i).unwrap())
                        float diff = v - mean
                        var = var + diff * diff
                    i = i + 1
                return float_to_str(sqrt(var / int_to_float(cnt)))
            else:
                return "N/A"

    # Describe: summary stats for numeric columns
    DataFrame describe(self):
        Vector[str] stat_names = Vector[str]()
        stat_names.push("stat")
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column col = self.columns.get(name).unwrap()
            str dt = col.dtype_name()
            if dt == "int" or dt == "float":
                stat_names.push(name)
            i = i + 1
        Vector[str] stat_labels = Vector[str]()
        stat_labels.push("count")
        stat_labels.push("sum")
        stat_labels.push("mean")
        stat_labels.push("min")
        stat_labels.push("max")
        stat_labels.push("std")
        Column label_col = col_from_strs(stat_labels)
        Vector[Column] out_cols = Vector[Column]()
        out_cols.push(label_col)
        i = 1
        while i < stat_names.len():
            str name = stat_names.get(i).unwrap()
            Vector[str] vals = Vector[str]()
            vals.push(int_to_str(self.df_count(name)))
            vals.push(self.df_sum(name))
            vals.push(self.df_mean(name))
            vals.push(self.df_min(name))
            vals.push(self.df_max(name))
            vals.push(self.df_std(name))
            out_cols.push(col_from_strs(vals))
            i = i + 1
        return df_from_columns(stat_names, out_cols)

    # value_counts: count occurrences of each unique value in a column (O(n) via Dict)
    DataFrame value_counts(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        Dict[str, int] count_map = Dict[str, int]()
        Vector[str] order = Vector[str]()
        int i = 0
        while i < self.num_rows:
            str sv = col.value_as_str(i)
            if count_map.has(sv):
                count_map.set(sv, count_map.get(sv).unwrap() + 1)
            else:
                count_map.set(sv, 1)
                order.push(sv)
            i = i + 1
        Vector[str] vals = Vector[str]()
        Vector[int] counts = Vector[int]()
        i = 0
        while i < order.len():
            str key = order.get(i).unwrap()
            vals.push(key)
            counts.push(count_map.get(key).unwrap())
            i = i + 1
        Vector[str] col_keys = Vector[str]()
        col_keys.push(col_name)
        col_keys.push("count")
        Vector[Column] out_cols = Vector[Column]()
        out_cols.push(col_from_strs(vals))
        out_cols.push(col_from_ints(counts))
        return df_from_columns(col_keys, out_cols)

# ── Sort Helpers ─────────────────────────────────────────────

# Compare two row indices in a column; returns -1, 0, or 1. Nulls sort last.
int col_compare(Column col, int ia, int ib):
    bool a_null = col.is_null_at(ia)
    bool b_null = col.is_null_at(ib)
    if a_null and b_null:
        return 0
    if a_null:
        return 1
    if b_null:
        return -1
    match col:
        case IntCol(c):
            int va = c.data.get(ia).unwrap()
            int vb = c.data.get(ib).unwrap()
            if va < vb:
                return -1
            if va > vb:
                return 1
            return 0
        case FloatCol(c):
            float va = c.data.get(ia).unwrap()
            float vb = c.data.get(ib).unwrap()
            if va < vb:
                return -1
            if va > vb:
                return 1
            return 0
        case StrCol(c):
            str va = c.data.get(ia).unwrap()
            str vb = c.data.get(ib).unwrap()
            # Try numeric comparison for string columns with numeric values
            Result[float, str] fa = parse_float(va)
            Result[float, str] fb = parse_float(vb)
            if fa.is_ok() and fb.is_ok():
                float fva = fa.unwrap()
                float fvb = fb.unwrap()
                if fva < fvb:
                    return -1
                if fva > fvb:
                    return 1
                return 0
            if va < vb:
                return -1
            if va > vb:
                return 1
            return 0
        case BoolCol(c):
            bool va = c.data.get(ia).unwrap()
            bool vb = c.data.get(ib).unwrap()
            if va == vb:
                return 0
            if not va:
                return -1
            return 1

# Bottom-up merge sort on index array with typed column comparison
Vector[int] merge_sort_idxs(Vector[int] idxs, Column col, bool ascending):
    int n = idxs.len()
    if n <= 1:
        return vec_int_copy(idxs)
    Vector[int] aux = Vector[int]()
    int i = 0
    while i < n:
        aux.push(0)
        i = i + 1
    int width = 1
    while width < n:
        int lo = 0
        while lo < n:
            int mid = lo + width
            if mid > n:
                mid = n
            int hi = lo + width * 2
            if hi > n:
                hi = n
            int li = lo
            int ri = mid
            int k = lo
            while k < hi:
                if li >= mid:
                    aux.set(k, idxs.get(ri).unwrap())
                    ri = ri + 1
                elif ri >= hi:
                    aux.set(k, idxs.get(li).unwrap())
                    li = li + 1
                else:
                    int cmp = col_compare(col, idxs.get(li).unwrap(), idxs.get(ri).unwrap())
                    bool take_left = false
                    if ascending:
                        take_left = cmp <= 0
                    else:
                        take_left = cmp >= 0
                    if take_left:
                        aux.set(k, idxs.get(li).unwrap())
                        li = li + 1
                    else:
                        aux.set(k, idxs.get(ri).unwrap())
                        ri = ri + 1
                k = k + 1
            lo = lo + width * 2
        i = 0
        while i < n:
            idxs.set(i, aux.get(i).unwrap())
            i = i + 1
        width = width * 2
    return vec_int_copy(idxs)

# ── D4: Transformation ───────────────────────────────────────

equip DataFrame:
    DataFrame sort_by(self, str col_name, bool ascending):
        Column col = self.columns.get(col_name).unwrap()
        Vector[int] idxs = Vector[int]()
        int i = 0
        while i < self.num_rows:
            idxs.push(i)
            i = i + 1
        Vector[int] sorted_idxs = merge_sort_idxs(idxs, col, ascending)
        Vector[Column] new_cols = Vector[Column]()
        i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column src = self.columns.get(name).unwrap()
            new_cols.push(col_gather(src, sorted_idxs))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    DataFrame add_column(self, str name, Column col):
        Vector[str] new_names = vec_str_copy(self.col_names)
        new_names.push(name)
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str n = self.col_names.get(i).unwrap()
            new_cols.push(self.columns.get(n).unwrap())
            i = i + 1
        new_cols.push(col)
        return df_from_columns(new_names, new_cols)

    # Replace a column at its original position (preserves column order)
    DataFrame replace_column(self, str name, Column col):
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str n = self.col_names.get(i).unwrap()
            if n == name:
                new_cols.push(col)
            else:
                new_cols.push(self.columns.get(n).unwrap())
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    DataFrame apply_int(self, str col_name, int(int) f):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                Vector[int] new_data = Vector[int]()
                Vector[bool] new_mask = Vector[bool]()
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        new_data.push(f(c.data.get(i).unwrap()))
                        new_mask.push(true)
                    else:
                        new_data.push(0)
                        new_mask.push(false)
                    i = i + 1
                return self.replace_column(col_name, IntCol(TypedColumn[int](new_data, new_mask)))
            else:
                return self.df_slice(0, self.num_rows)

    DataFrame apply_float(self, str col_name, float(float) f):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case FloatCol(c):
                Vector[float] new_data = Vector[float]()
                Vector[bool] new_mask = Vector[bool]()
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        new_data.push(f(c.data.get(i).unwrap()))
                        new_mask.push(true)
                    else:
                        new_data.push(0.0)
                        new_mask.push(false)
                    i = i + 1
                return self.replace_column(col_name, FloatCol(TypedColumn[float](new_data, new_mask)))
            else:
                return self.df_slice(0, self.num_rows)

    DataFrame apply_str(self, str col_name, str(str) f):
        Column col = self.columns.get(col_name).unwrap()
