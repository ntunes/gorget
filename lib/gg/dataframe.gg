# gg.dataframe — Pandas-style DataFrame library for Gorget
#
# Core types:
#   IntColumn / FloatColumn / StrColumn / BoolColumn — typed column with null mask
#   Column — discriminated union of column types
#   DataFrame — ordered dict of named columns
#
# Construction:
#   df_from_columns(names, cols), df_from_records(headers, rows)
#   df_from_csv(csv_text) → Result[DataFrame, str]
#
# Access:
#   df.get_column(name), df.nrows(), df.ncols(), df.head(n), df.tail(n)
#
# Selection & Filtering:
#   df.select(cols), df.drop(col), df.df_slice(start, end)
#   df.filter_mask(mask), df.filter_by(col, op, val)
#
# Aggregation:
#   df.df_sum(col), df.df_mean(col), df.df_min(col), df.df_max(col)
#   df.df_count(col), df.describe(), df.value_counts(col)
#
# Transformation:
#   df.sort_by(col, ascending), df.add_column(name, col)
#   df.apply_int(col, fn), df.apply_float(col, fn), df.apply_str(col, fn)
#   df.fillna_int(col, val), df.fillna_float(col, val), df.fillna_str(col, val)
#   df.dropna()
#
# GroupBy & Joins:
#   df_group_by(df, col) → GroupBy, group.agg(target, op)
#   df_inner_join(left, right, on), df_concat(a, b)
#
# I/O:
#   df_from_csv(csv_text), df_to_csv(df)

from std.collections import Vector, Dict
from std.conv import int_to_str, float_to_str, bool_to_str, parse_int, parse_float
from std.math import sqrt

# Convert int to float (Gorget has no implicit promotion)
float int_to_float(int n):
    return parse_float(int_to_str(n)).unwrap()

# Returns true if s represents a valid integer (optional leading -, then digits)
bool str_is_int(str s):
    int n = s.byte_len()
    if n == 0:
        return false
    int start = 0
    if s.char_at(0) == '-':
        start = 1
    if start >= n:
        return false
    int i = start
    while i < n:
        if not s.char_at(i).is_digit():
            return false
        i = i + 1
    return true

# Returns true if s represents a valid float (integer or decimal)
bool str_is_float(str s):
    int n = s.byte_len()
    if n == 0:
        return false
    int start = 0
    if s.char_at(0) == '-':
        start = 1
    if start >= n:
        return false
    bool has_dot = false
    int i = start
    while i < n:
        char c = s.char_at(i)
        if c == '.':
            if has_dot:
                return false
            has_dot = true
        elif not c.is_digit():
            return false
        i = i + 1
    return true

# ── Column Types ─────────────────────────────────────────────

struct IntColumn:
    Vector[int] data
    Vector[bool] mask    # true = present (not null), false = null

struct FloatColumn:
    Vector[float] data
    Vector[bool] mask

struct StrColumn:
    Vector[str] data
    Vector[bool] mask

struct BoolColumn:
    Vector[bool] data
    Vector[bool] mask

enum Column:
    IntCol(IntColumn)
    FloatCol(FloatColumn)
    StrCol(StrColumn)
    BoolCol(BoolColumn)

struct DataFrame:
    Dict[str, Column] columns
    Vector[str] col_names
    int num_rows

# ── GroupBy ──────────────────────────────────────────────────

struct GroupBy:
    DataFrame source
    str group_col
    Dict[str, Vector[int]] groups

# ── Column Access Helpers ────────────────────────────────────

equip IntColumn:
    int col_len(self) = self.data.len()
    bool is_null(self, int idx):
        Option[bool] m = self.mask.get(idx)
        if m.is_none():
            return true
        return not m.unwrap()
    int get_val(self, int idx) = self.data.get(idx).unwrap()
    int null_count(self):
        int cnt = 0
        int i = 0
        while i < self.mask.len():
            if not self.mask.get(i).unwrap():
                cnt = cnt + 1
            i = i + 1
        return cnt

equip FloatColumn:
    int col_len(self) = self.data.len()
    bool is_null(self, int idx):
        Option[bool] m = self.mask.get(idx)
        if m.is_none():
            return true
        return not m.unwrap()
    float get_val(self, int idx) = self.data.get(idx).unwrap()
    int null_count(self):
        int cnt = 0
        int i = 0
        while i < self.mask.len():
            if not self.mask.get(i).unwrap():
                cnt = cnt + 1
            i = i + 1
        return cnt

