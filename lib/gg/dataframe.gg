                    if c.mask.get(i).unwrap():
                        new_data.push(c.data.get(i).unwrap())
                    else:
                        new_data.push(val)
                    new_mask.push(true)
                    i = i + 1
                return self.replace_column(col_name, FloatCol(TypedColumn[float](new_data, new_mask)))
            else:
                return self.df_slice(0, self.num_rows)

    DataFrame fillna_str(self, str col_name, str val):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case StrCol(c):
                Vector[str] new_data = Vector[str]()
                Vector[bool] new_mask = Vector[bool]()
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        new_data.push(c.data.get(i).unwrap())
                    else:
                        new_data.push(val)
                    new_mask.push(true)
                    i = i + 1
                return self.replace_column(col_name, StrCol(TypedColumn[str](new_data, new_mask)))
            else:
                return self.df_slice(0, self.num_rows)

    DataFrame dropna(self):
        Vector[bool] mask = Vector[bool]()
        int i = 0
        while i < self.num_rows:
            bool row_ok = true
            int j = 0
            while j < self.col_names.len():
                str name = self.col_names.get(j).unwrap()
                Column col = self.columns.get(name).unwrap()
                if col.is_null_at(i):
                    row_ok = false
                    break
                j = j + 1
            mask.push(row_ok)
            i = i + 1
        return self.filter_mask(mask)

# ── D5: GroupBy & Joins ──────────────────────────────────────

GroupBy df_group_by(DataFrame df, str col):
    Dict[str, Vector[int]] groups = Dict[str, Vector[int]]()
    Column col_data = df.columns.get(col).unwrap()
    int i = 0
    while i < df.num_rows:
        str key = col_data.value_as_str(i)
        if groups.has(key):
            Vector[int] existing = groups.get(key).unwrap()
            existing.push(i)
            groups.set(key, existing)
        else:
            Vector[int] new_group = Vector[int]()
            new_group.push(i)
            groups.set(key, new_group)
        i = i + 1
    return GroupBy(df, col, groups)

equip GroupBy:
    # Aggregate a target column by op (sum/mean/count/min/max)
    # Produces typed output: count→int, sum/min/max→preserve source type, mean→float
    DataFrame agg(self, str target_col, str op):
        Vector[str] keys = self.groups.keys()
        Vector[str] key_vals = Vector[str]()
        Column src_col = self.source.columns.get(target_col).unwrap()
        str dt = src_col.dtype_name()
        # Collect aggregated values per group
        Vector[int] int_results = Vector[int]()
        Vector[float] float_results = Vector[float]()
        int i = 0
        while i < keys.len():
            str key = keys.get(i).unwrap()
            key_vals.push(key)
            Vector[int] row_idxs = self.groups.get(key).unwrap()
            if op == "count":
                int_results.push(row_idxs.len())
            elif dt == "int":
                match src_col:
                    case IntCol(c):
                        int i_acc = 0
                        int i_mn = 0
                        int i_mx = 0
                        bool first = true
                        int cnt = 0
                        int j = 0
                        while j < row_idxs.len():
                            int row = row_idxs.get(j).unwrap()
                            if c.mask.get(row).unwrap():
                                int v = c.data.get(row).unwrap()
                                i_acc = i_acc + v
                                if first or v < i_mn:
                                    i_mn = v
                                if first or v > i_mx:
                                    i_mx = v
                                first = false
                                cnt = cnt + 1
                            j = j + 1
                        if op == "sum":
                            int_results.push(i_acc)
                        elif op == "mean":
                            if cnt > 0:
                                float_results.push(int_to_float(i_acc) / int_to_float(cnt))
                            else:
                                float_results.push(0.0)
                        elif op == "min":
                            int_results.push(i_mn)
                        elif op == "max":
                            int_results.push(i_mx)
                    else:
                        int_results.push(0)
            elif dt == "float":
                match src_col:
                    case FloatCol(c):
                        float f_acc = 0.0
                        float f_mn = 0.0
                        float f_mx = 0.0
                        bool first = true
                        int cnt = 0
                        int j = 0
                        while j < row_idxs.len():
                            int row = row_idxs.get(j).unwrap()
                            if c.mask.get(row).unwrap():
                                float v = c.data.get(row).unwrap()
                                f_acc = f_acc + v
                                if first or v < f_mn:
                                    f_mn = v
                                if first or v > f_mx:
                                    f_mx = v
                                first = false
                                cnt = cnt + 1
                            j = j + 1
                        if op == "sum":
                            float_results.push(f_acc)
                        elif op == "mean":
                            if cnt > 0:
                                float_results.push(f_acc / int_to_float(cnt))
                            else:
                                float_results.push(0.0)
                        elif op == "min":
                            float_results.push(f_mn)
                        elif op == "max":
                            float_results.push(f_mx)
                    else:
                        float_results.push(0.0)
            i = i + 1
        Vector[str] names = Vector[str]()
        names.push(self.group_col)
        names.push(target_col + "_" + op)
        Vector[Column] cols = Vector[Column]()
        cols.push(col_from_strs(key_vals))
        if op == "count":
            cols.push(col_from_ints(int_results))
        elif op == "mean":
            cols.push(col_from_floats(float_results))
        elif dt == "int":
            cols.push(col_from_ints(int_results))
        else:
            cols.push(col_from_floats(float_results))
        return df_from_columns(names, cols)

DataFrame df_inner_join(DataFrame left, DataFrame right, str on):
    Column lc = left.columns.get(on).unwrap()
    Column rc = right.columns.get(on).unwrap()
    # Build right index: value → list of row indices
    Dict[str, Vector[int]] right_idx = Dict[str, Vector[int]]()
    int i = 0
    while i < right.num_rows:
        str key = rc.value_as_str(i)
        if right_idx.has(key):
            right_idx.get(key).unwrap().push(i)
        else:
            Vector[int] rows = Vector[int]()
            rows.push(i)
            right_idx.set(key, rows)
        i = i + 1
    # Collect matching rows
    Vector[int] left_rows = Vector[int]()
    Vector[int] right_rows = Vector[int]()
    i = 0
    while i < left.num_rows:
        str key = lc.value_as_str(i)
        if right_idx.has(key):
            Vector[int] rs = vec_int_copy(right_idx.get(key).unwrap())
            int j = 0
            while j < rs.len():
                left_rows.push(i)
                right_rows.push(rs.get(j).unwrap())
                j = j + 1
        i = i + 1
    # Build output columns using col_gather (preserves types and nulls)
    Vector[str] out_names = Vector[str]()
    Vector[Column] out_cols = Vector[Column]()
    # Left columns
    i = 0
    while i < left.col_names.len():
        str name = left.col_names.get(i).unwrap()
        out_names.push(name)
        Column src = left.columns.get(name).unwrap()
        out_cols.push(col_gather(src, left_rows))
        i = i + 1
    # Right columns (except join key)
    i = 0
    while i < right.col_names.len():
        str name = right.col_names.get(i).unwrap()
        if name != on:
            out_names.push(name)
            Column src = right.columns.get(name).unwrap()
            out_cols.push(col_gather(src, right_rows))
        i = i + 1
    return df_from_columns(out_names, out_cols)

DataFrame df_concat(DataFrame a, DataFrame b):
    Vector[Column] new_cols = Vector[Column]()
    int i = 0
    while i < a.col_names.len():
        str name = a.col_names.get(i).unwrap()
        Column ca = a.columns.get(name).unwrap()
        Column cb = b.columns.get(name).unwrap()
        new_cols.push(col_concat(ca, cb))
        i = i + 1
    return df_from_columns(a.col_names, new_cols)

# ── D6: I/O ──────────────────────────────────────────────────

DataFrame df_from_records(Vector[str] headers, Vector[Vector[str]] rows):
    int ncols = headers.len()
    int nrows = rows.len()
    Vector[Column] cols = Vector[Column]()
    int ci = 0
    while ci < ncols:
        Vector[str] col_vals = Vector[str]()
        int ri = 0
        while ri < nrows:
            Vector[str] row = rows.get(ri).unwrap()
            str val = ""
            if ci < row.len():
                val = row.get(ci).unwrap()
            col_vals.push(val)
            ri = ri + 1
        cols.push(col_from_strs(col_vals))
        ci = ci + 1
    return df_from_columns(headers, cols)

Result[DataFrame, str] df_from_csv(str csv_text):
    # Simple CSV parser: split by newlines then by commas
    Vector[str] lines = csv_text.split("\n")
    if lines.len() == 0:
        return Error("empty CSV")
    # Remove trailing empty lines
    while lines.len() > 0:
        str last = lines.get(lines.len() - 1).unwrap()
        if last == "" or last == "\r":
            lines.pop()
        else:
            break
    if lines.len() == 0:
        return Error("empty CSV after stripping")
    # Parse header
    str header_line = lines.get(0).unwrap()
    Vector[str] headers = header_line.split(",")
    # Trim whitespace from headers
    Vector[str] clean_headers = Vector[str]()
    int i = 0
    while i < headers.len():
        clean_headers.push(headers.get(i).unwrap().trim())
        i = i + 1
    # Parse data rows
    Vector[Vector[str]] rows = Vector[Vector[str]]()
    int r = 1
    while r < lines.len():
        str line = lines.get(r).unwrap().trim()
        if line != "":
            Vector[str] fields = line.split(",")
            Vector[str] clean_fields = Vector[str]()
            int fi = 0
            while fi < fields.len():
                clean_fields.push(fields.get(fi).unwrap().trim())
                fi = fi + 1
            rows.push(clean_fields)
        r = r + 1
    # Infer column types: try int, then float, default to str
    int ncols = clean_headers.len()
    int nrows = rows.len()
    Vector[Column] cols = Vector[Column]()
    i = 0
    while i < ncols:
        # Check if all values parse as int
        bool all_int = true
        bool all_float = true
        int ri = 0
        while ri < nrows:
            Vector[str] row = rows.get(ri).unwrap()
            str val = ""
            if i < row.len():
                val = row.get(i).unwrap()
            if val != "" and val != "null" and val != "N/A":
                if not str_is_int(val):
                    all_int = false
                if not str_is_float(val):
                    all_float = false
            ri = ri + 1
        if all_int and nrows > 0:
            Vector[int] data = Vector[int]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if i < row.len():
                    val = row.get(i).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push(0)
                    mask.push(false)
                else:
                    data.push(parse_int(val).unwrap())
                    mask.push(true)
                ri = ri + 1
            cols.push(IntCol(TypedColumn[int](data, mask)))
        elif all_float and nrows > 0:
            Vector[float] data = Vector[float]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if i < row.len():
                    val = row.get(i).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push(0.0)
                    mask.push(false)
                else:
                    data.push(parse_float(val).unwrap())
                    mask.push(true)
                ri = ri + 1
            cols.push(FloatCol(TypedColumn[float](data, mask)))
        else:
            Vector[str] data = Vector[str]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if i < row.len():
                    val = row.get(i).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push("")
                    mask.push(false)
                else:
                    data.push(val)
                    mask.push(true)
                ri = ri + 1
            cols.push(StrCol(TypedColumn[str](data, mask)))
        i = i + 1
    return Ok(df_from_columns(clean_headers, cols))

str df_to_csv(DataFrame df):
    str out = ""
    # Header
    int i = 0
    while i < df.col_names.len():
        if i > 0:
            out = out + ","
        out = out + df.col_names.get(i).unwrap()
        i = i + 1
    out = out + "\n"
    # Rows
    int r = 0
    while r < df.num_rows:
        i = 0
        while i < df.col_names.len():
            if i > 0:
                out = out + ","
            str name = df.col_names.get(i).unwrap()
            Column col = df.columns.get(name).unwrap()
            str val = col.value_as_str(r)
            if val == "null":
                val = ""
            out = out + val
            i = i + 1
        out = out + "\n"
        r = r + 1
    return out

# ── D7: Tier 2 Features ──────────────────────────────────────

equip DataFrame:
    # rename_column: rename a single column
    DataFrame rename_column(self, str old_name, str new_name):
        Vector[str] new_names = Vector[str]()
        Vector[Column] new_cols = Vector[Column]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            if name == old_name:
                new_names.push(new_name)
            else:
                new_names.push(name)
            new_cols.push(self.columns.get(name).unwrap())
            i = i + 1
        return df_from_columns(new_names, new_cols)

    # dtypes: return a DataFrame with columns "column" and "dtype"
    DataFrame dtypes(self):
        Vector[str] col_names_out = Vector[str]()
        Vector[str] dtype_vals = Vector[str]()
        int i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            col_names_out.push(name)
            Column col = self.columns.get(name).unwrap()
            dtype_vals.push(col.dtype_name())
            i = i + 1
        Vector[str] out_names = Vector[str]()
        out_names.push("column")
        out_names.push("dtype")
        Vector[Column] out_cols = Vector[Column]()
        out_cols.push(col_from_strs(col_names_out))
        out_cols.push(col_from_strs(dtype_vals))
        return df_from_columns(out_names, out_cols)

    # isna: boolean mask column where true means null
    DataFrame isna(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        Vector[bool] result = Vector[bool]()
        int i = 0
        while i < self.num_rows:
            result.push(col.is_null_at(i))
            i = i + 1
        Vector[str] out_names = Vector[str]()
        out_names.push(col_name + "_isna")
        Vector[Column] out_cols = Vector[Column]()
        out_cols.push(col_from_bools(result))
        return df_from_columns(out_names, out_cols)

    # notna: boolean mask column where true means not null
    DataFrame notna(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        Vector[bool] result = Vector[bool]()
        int i = 0
        while i < self.num_rows:
            result.push(not col.is_null_at(i))
            i = i + 1
        Vector[str] out_names = Vector[str]()
        out_names.push(col_name + "_notna")
        Vector[Column] out_cols = Vector[Column]()
        out_cols.push(col_from_bools(result))
        return df_from_columns(out_names, out_cols)

    # df_unique: return DataFrame with unique values of a column
    DataFrame df_unique(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        Dict[str, bool] seen = Dict[str, bool]()
        Vector[int] keep_idxs = Vector[int]()
        int i = 0
        while i < self.num_rows:
            str sv = col.value_as_str(i)
            if not seen.has(sv):
                seen.set(sv, true)
                keep_idxs.push(i)
            i = i + 1
        Vector[Column] new_cols = Vector[Column]()
        i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column src = self.columns.get(name).unwrap()
            new_cols.push(col_gather(src, keep_idxs))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    # df_nunique: count of unique values in a column
    int df_nunique(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        Dict[str, bool] seen = Dict[str, bool]()
        int i = 0
        while i < self.num_rows:
            str sv = col.value_as_str(i)
            if not seen.has(sv):
                seen.set(sv, true)
            i = i + 1
        return seen.keys().len()

    # median: middle value of a numeric column
    str df_median(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case IntCol(c):
                # Collect non-null values
                Vector[int] vals = Vector[int]()
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        vals.push(c.data.get(i).unwrap())
                    i = i + 1
                if vals.len() == 0:
                    return "N/A"
                # Sort using index array
                Vector[int] idxs = Vector[int]()
                i = 0
                while i < vals.len():
                    idxs.push(i)
                    i = i + 1
                Column temp = col_from_ints(vals)
                Vector[int] sorted = merge_sort_idxs(idxs, temp, true)
                int n = sorted.len()
                if n % 2 == 1:
                    int mid_idx = sorted.get(n / 2).unwrap()
                    return float_to_str(int_to_float(vals.get(mid_idx).unwrap()))
                else:
                    int lo_idx = sorted.get(n / 2 - 1).unwrap()
                    int hi_idx = sorted.get(n / 2).unwrap()
                    float lo = int_to_float(vals.get(lo_idx).unwrap())
                    float hi = int_to_float(vals.get(hi_idx).unwrap())
                    return float_to_str((lo + hi) / 2.0)
            case FloatCol(c):
                Vector[float] vals = Vector[float]()
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        vals.push(c.data.get(i).unwrap())
                    i = i + 1
                if vals.len() == 0:
                    return "N/A"
                Vector[int] idxs = Vector[int]()
                i = 0
                while i < vals.len():
                    idxs.push(i)
                    i = i + 1
                Column temp = col_from_floats(vals)
                Vector[int] sorted = merge_sort_idxs(idxs, temp, true)
                int n = sorted.len()
                if n % 2 == 1:
                    int mid_idx = sorted.get(n / 2).unwrap()
                    return float_to_str(vals.get(mid_idx).unwrap())
                else:
                    int lo_idx = sorted.get(n / 2 - 1).unwrap()
                    int hi_idx = sorted.get(n / 2).unwrap()
                    float lo = vals.get(lo_idx).unwrap()
                    float hi = vals.get(hi_idx).unwrap()
                    return float_to_str((lo + hi) / 2.0)
            else:
                return "N/A"

    # variance (population): var = sum((x - mean)^2) / n
    str df_var(self, str col_name):
        Column col = self.columns.get(col_name).unwrap()
        match col:
            case FloatCol(c):
                float acc = 0.0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + c.data.get(i).unwrap()
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                float mean = acc / int_to_float(cnt)
                float var = 0.0
                i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float diff = c.data.get(i).unwrap() - mean
                        var = var + diff * diff
                    i = i + 1
                return float_to_str(var / int_to_float(cnt))
            case IntCol(c):
                float acc = 0.0
                int cnt = 0
                int i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        acc = acc + int_to_float(c.data.get(i).unwrap())
                        cnt = cnt + 1
                    i = i + 1
                if cnt == 0:
                    return "N/A"
                float mean = acc / int_to_float(cnt)
                float var = 0.0
                i = 0
                while i < c.data.len():
                    if c.mask.get(i).unwrap():
                        float v = int_to_float(c.data.get(i).unwrap())
                        float diff = v - mean
                        var = var + diff * diff
                    i = i + 1
                return float_to_str(var / int_to_float(cnt))
            else:
                return "N/A"

    # nlargest: top n rows by column value
    DataFrame nlargest(self, int n, str col_name):
        DataFrame sorted_df = self.sort_by(col_name, false)
        return sorted_df.head(n)

    # nsmallest: bottom n rows by column value
    DataFrame nsmallest(self, int n, str col_name):
        DataFrame sorted_df = self.sort_by(col_name, true)
        return sorted_df.head(n)

    # sample: return n random rows (deterministic seed-based for reproducibility)
    DataFrame sample(self, int n, int seed):
        if n >= self.num_rows:
            return self.df_slice(0, self.num_rows)
        # Fisher-Yates partial shuffle using linear congruential generator
        Vector[int] idxs = Vector[int]()
        int i = 0
        while i < self.num_rows:
            idxs.push(i)
            i = i + 1
        int rng = seed
        i = 0
        while i < n:
            # LCG: next = (a * rng + c) mod m
            rng = (1103515245 * rng + 12345) % 2147483647
            int r_val = rng
            if r_val < 0:
                r_val = 0 - r_val
            int j = i + r_val % (self.num_rows - i)
            int tmp = idxs.get(i).unwrap()
            idxs.set(i, idxs.get(j).unwrap())
            idxs.set(j, tmp)
            i = i + 1
        Vector[int] sample_idxs = Vector[int]()
        i = 0
        while i < n:
            sample_idxs.push(idxs.get(i).unwrap())
            i = i + 1
        Vector[Column] new_cols = Vector[Column]()
        i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column src = self.columns.get(name).unwrap()
            new_cols.push(col_gather(src, sample_idxs))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    # shuffle: return all rows in random order
    DataFrame shuffle(self, int seed):
        return self.sample(self.num_rows, seed)

    # sort_by_multi: sort by multiple columns
    DataFrame sort_by_multi(self, Vector[str] col_names_list, Vector[bool] ascending_list):
        Vector[int] idxs = Vector[int]()
        int i = 0
        while i < self.num_rows:
            idxs.push(i)
            i = i + 1
        # Collect columns for multi-key comparison
        Vector[Column] sort_cols = Vector[Column]()
        i = 0
        while i < col_names_list.len():
            str cn = col_names_list.get(i).unwrap()
            sort_cols.push(self.columns.get(cn).unwrap())
            i = i + 1
        # Bottom-up merge sort with multi-key comparison
        int n = idxs.len()
        if n <= 1:
            return self.df_slice(0, self.num_rows)
        Vector[int] aux = Vector[int]()
        i = 0
        while i < n:
            aux.push(0)
            i = i + 1
        int width = 1
        while width < n:
            int lo = 0
            while lo < n:
                int mid = lo + width
                if mid > n:
                    mid = n
                int hi = lo + width * 2
                if hi > n:
                    hi = n
                int li = lo
                int ri = mid
                int k = lo
                while k < hi:
                    if li >= mid:
                        aux.set(k, idxs.get(ri).unwrap())
                        ri = ri + 1
                    elif ri >= hi:
                        aux.set(k, idxs.get(li).unwrap())
                        li = li + 1
                    else:
                        # Multi-key comparison
                        int cmp = 0
                        int ci = 0
                        while ci < sort_cols.len():
                            Column sc = sort_cols.get(ci).unwrap()
                            cmp = col_compare(sc, idxs.get(li).unwrap(), idxs.get(ri).unwrap())
                            if cmp != 0:
                                break
                            ci = ci + 1
                        bool asc = true
                        if ci < ascending_list.len():
                            asc = ascending_list.get(ci).unwrap()
                        bool take_left = false
                        if asc:
                            take_left = cmp <= 0
                        else:
                            take_left = cmp >= 0
                        if take_left:
                            aux.set(k, idxs.get(li).unwrap())
                            li = li + 1
                        else:
                            aux.set(k, idxs.get(ri).unwrap())
                            ri = ri + 1
                    k = k + 1
                lo = lo + width * 2
            i = 0
            while i < n:
                idxs.set(i, aux.get(i).unwrap())
                i = i + 1
            width = width * 2
        Vector[Column] new_cols = Vector[Column]()
        i = 0
        while i < self.col_names.len():
            str name = self.col_names.get(i).unwrap()
            Column src = self.columns.get(name).unwrap()
            new_cols.push(col_gather(src, idxs))
            i = i + 1
        return df_from_columns(self.col_names, new_cols)

    # Column arithmetic: add two numeric columns element-wise
    DataFrame col_add(self, str col_a, str col_b, str result_name):
        Column a = self.columns.get(col_a).unwrap()
        Column b = self.columns.get(col_b).unwrap()
        match a:
            case IntCol(ca):
                match b:
                    case IntCol(cb):
                        Vector[int] data = Vector[int]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() + cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, IntCol(TypedColumn[int](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            case FloatCol(ca):
                match b:
                    case FloatCol(cb):
                        Vector[float] data = Vector[float]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() + cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0.0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, FloatCol(TypedColumn[float](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            else:
                return self.df_slice(0, self.num_rows)

    # Column arithmetic: subtract two numeric columns element-wise
    DataFrame col_sub(self, str col_a, str col_b, str result_name):
        Column a = self.columns.get(col_a).unwrap()
        Column b = self.columns.get(col_b).unwrap()
        match a:
            case IntCol(ca):
                match b:
                    case IntCol(cb):
                        Vector[int] data = Vector[int]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() - cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, IntCol(TypedColumn[int](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            case FloatCol(ca):
                match b:
                    case FloatCol(cb):
                        Vector[float] data = Vector[float]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() - cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0.0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, FloatCol(TypedColumn[float](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            else:
                return self.df_slice(0, self.num_rows)

    # Column arithmetic: multiply two numeric columns element-wise
    DataFrame col_mul(self, str col_a, str col_b, str result_name):
        Column a = self.columns.get(col_a).unwrap()
        Column b = self.columns.get(col_b).unwrap()
        match a:
            case IntCol(ca):
                match b:
                    case IntCol(cb):
                        Vector[int] data = Vector[int]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() * cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, IntCol(TypedColumn[int](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            case FloatCol(ca):
                match b:
                    case FloatCol(cb):
                        Vector[float] data = Vector[float]()
                        Vector[bool] mask = Vector[bool]()
                        int i = 0
                        while i < ca.data.len():
                            bool a_ok = ca.mask.get(i).unwrap()
                            bool b_ok = cb.mask.get(i).unwrap()
                            if a_ok and b_ok:
                                data.push(ca.data.get(i).unwrap() * cb.data.get(i).unwrap())
                                mask.push(true)
                            else:
                                data.push(0.0)
                                mask.push(false)
                            i = i + 1
                        return self.add_column(result_name, FloatCol(TypedColumn[float](data, mask)))
                    else:
                        return self.df_slice(0, self.num_rows)
            else:
                return self.df_slice(0, self.num_rows)

# ── D8: Join Variants ────────────────────────────────────────

DataFrame df_left_join(DataFrame left, DataFrame right, str on):
    Column lc = left.columns.get(on).unwrap()
    Column rc = right.columns.get(on).unwrap()
    # Build right index
    Dict[str, Vector[int]] right_idx = Dict[str, Vector[int]]()
    int i = 0
    while i < right.num_rows:
        str key = rc.value_as_str(i)
        if right_idx.has(key):
            right_idx.get(key).unwrap().push(i)
        else:
            Vector[int] rows = Vector[int]()
            rows.push(i)
            right_idx.set(key, rows)
        i = i + 1
    # Collect matching rows; unmatched left rows get -1 for right
    Vector[int] left_rows = Vector[int]()
    Vector[int] right_rows = Vector[int]()
    i = 0
    while i < left.num_rows:
        str key = lc.value_as_str(i)
        if right_idx.has(key):
            Vector[int] rs = vec_int_copy(right_idx.get(key).unwrap())
            int j = 0
            while j < rs.len():
                left_rows.push(i)
                right_rows.push(rs.get(j).unwrap())
                j = j + 1
        else:
            left_rows.push(i)
            right_rows.push(-1)
        i = i + 1
    # Build output columns
    Vector[str] out_names = Vector[str]()
    Vector[Column] out_cols = Vector[Column]()
    # Left columns via gather
    i = 0
    while i < left.col_names.len():
        str name = left.col_names.get(i).unwrap()
        out_names.push(name)
        Column src = left.columns.get(name).unwrap()
        out_cols.push(col_gather(src, left_rows))
        i = i + 1
    # Right columns (except join key) — with null for unmatched
    i = 0
    while i < right.col_names.len():
        str name = right.col_names.get(i).unwrap()
        if name != on:
            out_names.push(name)
            Column src = right.columns.get(name).unwrap()
            out_cols.push(col_gather_nullable(src, right_rows))
        i = i + 1
    return df_from_columns(out_names, out_cols)

DataFrame df_right_join(DataFrame left, DataFrame right, str on):
    return df_left_join(right, left, on)

DataFrame df_outer_join(DataFrame left, DataFrame right, str on):
    Column lc = left.columns.get(on).unwrap()
    Column rc = right.columns.get(on).unwrap()
    # Build right index
    Dict[str, Vector[int]] right_idx = Dict[str, Vector[int]]()
    int i = 0
    while i < right.num_rows:
        str key = rc.value_as_str(i)
        if right_idx.has(key):
            right_idx.get(key).unwrap().push(i)
        else:
            Vector[int] rows = Vector[int]()
            rows.push(i)
            right_idx.set(key, rows)
        i = i + 1
    # Track which right rows were matched
    Dict[str, bool] right_matched = Dict[str, bool]()
    Vector[int] left_rows = Vector[int]()
    Vector[int] right_rows = Vector[int]()
    i = 0
    while i < left.num_rows:
        str key = lc.value_as_str(i)
        if right_idx.has(key):
            Vector[int] rs = vec_int_copy(right_idx.get(key).unwrap())
            int j = 0
            while j < rs.len():
                left_rows.push(i)
                right_rows.push(rs.get(j).unwrap())
                int r_idx = rs.get(j).unwrap()
                right_matched.set(int_to_str(r_idx), true)
                j = j + 1
        else:
            left_rows.push(i)
            right_rows.push(-1)
        i = i + 1
    # Add unmatched right rows
    i = 0
    while i < right.num_rows:
        if not right_matched.has(int_to_str(i)):
            left_rows.push(-1)
            right_rows.push(i)
        i = i + 1
    # Build output
    Vector[str] out_names = Vector[str]()
    Vector[Column] out_cols = Vector[Column]()
    i = 0
    while i < left.col_names.len():
        str name = left.col_names.get(i).unwrap()
        out_names.push(name)
        Column src = left.columns.get(name).unwrap()
        out_cols.push(col_gather_nullable(src, left_rows))
        i = i + 1
    i = 0
    while i < right.col_names.len():
        str name = right.col_names.get(i).unwrap()
        if name != on:
            out_names.push(name)
            Column src = right.columns.get(name).unwrap()
            out_cols.push(col_gather_nullable(src, right_rows))
        i = i + 1
    return df_from_columns(out_names, out_cols)

DataFrame df_cross_join(DataFrame left, DataFrame right):
    Vector[int] left_rows = Vector[int]()
    Vector[int] right_rows = Vector[int]()
    int i = 0
    while i < left.num_rows:
        int j = 0
        while j < right.num_rows:
            left_rows.push(i)
            right_rows.push(j)
            j = j + 1
        i = i + 1
    Vector[str] out_names = Vector[str]()
    Vector[Column] out_cols = Vector[Column]()
    i = 0
    while i < left.col_names.len():
        str name = left.col_names.get(i).unwrap()
        out_names.push(name)
        Column src = left.columns.get(name).unwrap()
        out_cols.push(col_gather(src, left_rows))
        i = i + 1
    i = 0
    while i < right.col_names.len():
        str name = right.col_names.get(i).unwrap()
        out_names.push(name)
        Column src = right.columns.get(name).unwrap()
        out_cols.push(col_gather(src, right_rows))
        i = i + 1
    return df_from_columns(out_names, out_cols)

# ── D9: Multi-column GroupBy ─────────────────────────────────

struct MultiGroupBy:
    DataFrame source
    Vector[str] group_cols
    Dict[str, Vector[int]] groups

MultiGroupBy df_group_by_multi(DataFrame df, Vector[str] cols):
    Dict[str, Vector[int]] groups = Dict[str, Vector[int]]()
    int i = 0
    while i < df.num_rows:
        # Build composite key from multiple columns
        str key = ""
        int ci = 0
        while ci < cols.len():
            str col_name = cols.get(ci).unwrap()
            Column col = df.columns.get(col_name).unwrap()
            if ci > 0:
                key = key + "~"
            key = key + col.value_as_str(i)
            ci = ci + 1
        if groups.has(key):
            groups.get(key).unwrap().push(i)
        else:
            Vector[int] new_group = Vector[int]()
            new_group.push(i)
            groups.set(key, new_group)
        i = i + 1
    return MultiGroupBy(df, cols, groups)

equip MultiGroupBy:
    DataFrame agg(self, str target_col, str op):
        Vector[str] keys = self.groups.keys()
        Column src_col = self.source.columns.get(target_col).unwrap()
        str dt = src_col.dtype_name()
        # Build group key columns
        int num_group_cols = self.group_cols.len()
        Vector[Vector[str]] key_columns = Vector[Vector[str]]()
        int gi = 0
        while gi < num_group_cols:
            key_columns.push(Vector[str]())
            gi = gi + 1
        Vector[int] int_results = Vector[int]()
        Vector[float] float_results = Vector[float]()
        int i = 0
        while i < keys.len():
            str composite_key = keys.get(i).unwrap()
            Vector[str] parts = composite_key.split("~")
            gi = 0
            while gi < num_group_cols:
                str part = ""
                if gi < parts.len():
                    part = parts.get(gi).unwrap()
                key_columns.get(gi).unwrap().push(part)
                gi = gi + 1
            Vector[int] row_idxs = self.groups.get(composite_key).unwrap()
            if op == "count":
                int_results.push(row_idxs.len())
            elif dt == "int":
                match src_col:
                    case IntCol(c):
                        int i_acc = 0
                        int i_mn = 0
                        int i_mx = 0
                        bool first = true
                        int cnt = 0
                        int j = 0
                        while j < row_idxs.len():
                            int row = row_idxs.get(j).unwrap()
                            if c.mask.get(row).unwrap():
                                int v = c.data.get(row).unwrap()
                                i_acc = i_acc + v
                                if first or v < i_mn:
                                    i_mn = v
                                if first or v > i_mx:
                                    i_mx = v
                                first = false
                                cnt = cnt + 1
                            j = j + 1
                        if op == "sum":
                            int_results.push(i_acc)
                        elif op == "mean":
                            if cnt > 0:
                                float_results.push(int_to_float(i_acc) / int_to_float(cnt))
                            else:
                                float_results.push(0.0)
                        elif op == "min":
                            int_results.push(i_mn)
                        elif op == "max":
                            int_results.push(i_mx)
                    else:
                        int_results.push(0)
            elif dt == "float":
                match src_col:
                    case FloatCol(c):
                        float f_acc = 0.0
                        float f_mn = 0.0
                        float f_mx = 0.0
                        bool first = true
                        int cnt = 0
                        int j = 0
                        while j < row_idxs.len():
                            int row = row_idxs.get(j).unwrap()
                            if c.mask.get(row).unwrap():
                                float v = c.data.get(row).unwrap()
                                f_acc = f_acc + v
                                if first or v < f_mn:
                                    f_mn = v
                                if first or v > f_mx:
                                    f_mx = v
                                first = false
                                cnt = cnt + 1
                            j = j + 1
                        if op == "sum":
                            float_results.push(f_acc)
                        elif op == "mean":
                            if cnt > 0:
                                float_results.push(f_acc / int_to_float(cnt))
                            else:
                                float_results.push(0.0)
                        elif op == "min":
                            float_results.push(f_mn)
                        elif op == "max":
                            float_results.push(f_mx)
                    else:
                        float_results.push(0.0)
            i = i + 1
        Vector[str] out_names = Vector[str]()
        Vector[Column] out_cols = Vector[Column]()
        gi = 0
        while gi < num_group_cols:
            out_names.push(self.group_cols.get(gi).unwrap())
            out_cols.push(col_from_strs(key_columns.get(gi).unwrap()))
            gi = gi + 1
        out_names.push(target_col + "_" + op)
        if op == "count":
            out_cols.push(col_from_ints(int_results))
        elif op == "mean":
            out_cols.push(col_from_floats(float_results))
        elif dt == "int":
            out_cols.push(col_from_ints(int_results))
        else:
            out_cols.push(col_from_floats(float_results))
        return df_from_columns(out_names, out_cols)

# ── D10: Type-inferring df_from_records ──────────────────────

DataFrame df_from_records_typed(Vector[str] headers, Vector[Vector[str]] rows):
    int ncols = headers.len()
    int nrows = rows.len()
    Vector[Column] cols = Vector[Column]()
    int ci = 0
    while ci < ncols:
        # Check if all values parse as int
        bool all_int = true
        bool all_float = true
        bool all_bool = true
        int ri = 0
        while ri < nrows:
            Vector[str] row = rows.get(ri).unwrap()
            str val = ""
            if ci < row.len():
                val = row.get(ci).unwrap()
            if val != "" and val != "null" and val != "N/A":
                if not str_is_int(val):
                    all_int = false
                if not str_is_float(val):
                    all_float = false
                if val != "true" and val != "false":
                    all_bool = false
            ri = ri + 1
        if all_int and nrows > 0:
            Vector[int] data = Vector[int]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if ci < row.len():
                    val = row.get(ci).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push(0)
                    mask.push(false)
                else:
                    data.push(parse_int(val).unwrap())
                    mask.push(true)
                ri = ri + 1
            cols.push(IntCol(TypedColumn[int](data, mask)))
        elif all_float and nrows > 0:
            Vector[float] data = Vector[float]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if ci < row.len():
                    val = row.get(ci).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push(0.0)
                    mask.push(false)
                else:
                    data.push(parse_float(val).unwrap())
                    mask.push(true)
                ri = ri + 1
            cols.push(FloatCol(TypedColumn[float](data, mask)))
        elif all_bool and nrows > 0:
            Vector[bool] data = Vector[bool]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if ci < row.len():
                    val = row.get(ci).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push(false)
                    mask.push(false)
                else:
                    data.push(val == "true")
                    mask.push(true)
                ri = ri + 1
            cols.push(BoolCol(TypedColumn[bool](data, mask)))
        else:
            Vector[str] data = Vector[str]()
            Vector[bool] mask = Vector[bool]()
            ri = 0
            while ri < nrows:
                Vector[str] row = rows.get(ri).unwrap()
                str val = ""
                if ci < row.len():
                    val = row.get(ci).unwrap()
                if val == "" or val == "null" or val == "N/A":
                    data.push("")
                    mask.push(false)
                else:
                    data.push(val)
                    mask.push(true)
                ri = ri + 1
            cols.push(StrCol(TypedColumn[str](data, mask)))
        ci = ci + 1
    return df_from_columns(headers, cols)

# ── Helpers ──────────────────────────────────────────────────

# Gather with -1 meaning null (for left/outer joins)
Column col_gather_nullable(Column col, Vector[int] idxs):
    match col:
        case IntCol(c):
            return IntCol(col_gather_nullable_inner[int](c, idxs, 0))
        case FloatCol(c):
            return FloatCol(col_gather_nullable_inner[float](c, idxs, 0.0))
        case StrCol(c):
            return StrCol(col_gather_nullable_inner[str](c, idxs, ""))
        case BoolCol(c):
            return BoolCol(col_gather_nullable_inner[bool](c, idxs, false))

Vector[str] vec_str_copy(Vector[str] v):
    Vector[str] out = Vector[str]()
    int i = 0
    while i < v.len():
        out.push(v.get(i).unwrap())
        i = i + 1
    return out

Vector[int] vec_int_copy(Vector[int] v):
    Vector[int] out = Vector[int]()
    int i = 0
    while i < v.len():
        out.push(v.get(i).unwrap())
        i = i + 1
    return out

Vector[float] vec_float_copy(Vector[float] v):
    Vector[float] out = Vector[float]()
    int i = 0
    while i < v.len():
        out.push(v.get(i).unwrap())
        i = i + 1
    return out

Vector[bool] vec_bool_copy(Vector[bool] v):
    Vector[bool] out = Vector[bool]()
    int i = 0
    while i < v.len():
        out.push(v.get(i).unwrap())
        i = i + 1
    return out

# ── D8: Type Casting and Clipping ────────────────────────────

# Internal: return a fresh DataFrame with the same schema and data as df.
# Necessary because returning a Move parameter directly aliases the caller's local.
DataFrame df_copy(DataFrame df):
    Vector[Column] cols = Vector[Column]()
    int i = 0
    while i < df.col_names.len():
        str name = df.col_names.get(i).unwrap()
        cols.push(df.get_column(name))
        i = i + 1
    return df_from_columns(df.col_names, cols)

# Internal: rebuild df with col_name replaced by new_col.
# new_col is a parameter so no `!` operator is needed at call sites.
DataFrame df_replace_col(DataFrame df, str col_name, Column new_col):
    Vector[Column] new_cols = Vector[Column]()
    int i = 0
    while i < df.col_names.len():
        str name = df.col_names.get(i).unwrap()
        if name == col_name:
            new_cols.push(new_col)
        else:
            new_cols.push(df.get_column(name))
        i = i + 1
    return df_from_columns(df.col_names, new_cols)

# Per-source-type cast helpers. Each takes the inner column struct by parameter
# (so it is exempt from the `!` operator requirement) and the target type name.
# Target type has already been validated by the caller. Nulls propagate;
# str→int/float that fails to parse becomes null.

Column cast_int_col(TypedColumn[int] c, str target_type):
    int n = c.data.len()
    if target_type == "float":
        Vector[float] d = Vector[float]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                d.push(int_to_float(c.data.get(j).unwrap()))
                m.push(true)
            else:
                d.push(0.0)
                m.push(false)
            j = j + 1
        return FloatCol(TypedColumn[float](d, m))
    elif target_type == "str":
        Vector[str] d = Vector[str]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                d.push(int_to_str(c.data.get(j).unwrap()))
                m.push(true)
            else:
                d.push("")
                m.push(false)
            j = j + 1
        return StrCol(TypedColumn[str](d, m))
    elif target_type == "bool":
        Vector[bool] d = Vector[bool]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                d.push(c.data.get(j).unwrap() != 0)
                m.push(true)
            else:
                d.push(false)
                m.push(false)
            j = j + 1
        return BoolCol(TypedColumn[bool](d, m))
    return IntCol(c)

Column cast_float_col(TypedColumn[float] c, str target_type):
    int n = c.data.len()
    if target_type == "int":
        # Truncate toward zero: floor for positives, -floor(-x) for negatives
        Vector[int] d = Vector[int]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                float fval = c.data.get(j).unwrap()
                float ftrunc = fval
                if fval >= 0.0:
                    ftrunc = floor(fval)
                else:
                    ftrunc = -floor(-fval)
                d.push(parse_int(float_to_str(ftrunc)).unwrap_or(0))
                m.push(true)
            else:
                d.push(0)
                m.push(false)
            j = j + 1
        return IntCol(TypedColumn[int](d, m))
    elif target_type == "str":
        Vector[str] d = Vector[str]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                d.push(float_to_str(c.data.get(j).unwrap()))
                m.push(true)
            else:
                d.push("")
                m.push(false)
            j = j + 1
        return StrCol(TypedColumn[str](d, m))
    elif target_type == "bool":
        Vector[bool] d = Vector[bool]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                float fval = c.data.get(j).unwrap()
                d.push(fval != 0.0)
                m.push(true)
            else:
                d.push(false)
                m.push(false)
            j = j + 1
        return BoolCol(TypedColumn[bool](d, m))
    return FloatCol(c)

Column cast_str_col(TypedColumn[str] c, str target_type):
    int n = c.data.len()
    if target_type == "int":
        Vector[int] d = Vector[int]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                Result[int, str] ri = parse_int(c.data.get(j).unwrap())
                if ri.is_ok():
                    d.push(ri.unwrap())
                    m.push(true)
                else:
                    d.push(0)
                    m.push(false)
            else:
                d.push(0)
                m.push(false)
            j = j + 1
        return IntCol(TypedColumn[int](d, m))
    elif target_type == "float":
        Vector[float] d = Vector[float]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                Result[float, str] rf = parse_float(c.data.get(j).unwrap())
                if rf.is_ok():
                    d.push(rf.unwrap())
                    m.push(true)
                else:
                    d.push(0.0)
                    m.push(false)
            else:
                d.push(0.0)
                m.push(false)
            j = j + 1
        return FloatCol(TypedColumn[float](d, m))
    elif target_type == "bool":
        Vector[bool] d = Vector[bool]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                str sv = c.data.get(j).unwrap()
                d.push(sv == "true" or sv == "1")
                m.push(true)
            else:
                d.push(false)
                m.push(false)
            j = j + 1
        return BoolCol(TypedColumn[bool](d, m))
    return StrCol(c)

Column cast_bool_col(TypedColumn[bool] c, str target_type):
    int n = c.data.len()
    if target_type == "int":
        Vector[int] d = Vector[int]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                if c.data.get(j).unwrap():
                    d.push(1)
                else:
                    d.push(0)
                m.push(true)
            else:
                d.push(0)
                m.push(false)
            j = j + 1
        return IntCol(TypedColumn[int](d, m))
    elif target_type == "float":
        Vector[float] d = Vector[float]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                if c.data.get(j).unwrap():
                    d.push(1.0)
                else:
                    d.push(0.0)
                m.push(true)
            else:
                d.push(0.0)
                m.push(false)
            j = j + 1
        return FloatCol(TypedColumn[float](d, m))
    elif target_type == "str":
        Vector[str] d = Vector[str]()
        Vector[bool] m = Vector[bool]()
        int j = 0
        while j < n:
            if c.mask.get(j).unwrap():
                d.push(bool_to_str(c.data.get(j).unwrap()))
                m.push(true)
            else:
                d.push("")
                m.push(false)
            j = j + 1
        return StrCol(TypedColumn[str](d, m))
    return BoolCol(c)

# df_cast: convert a column to target_type ("int", "float", "str", "bool").
# Nulls propagate; str→int/float that fails to parse becomes null.
# Returns Error if column not found or cast is unsupported.
Result[DataFrame, str] df_cast(DataFrame df, str col_name, str target_type):
    if not df.has_column(col_name):
        return Error("df_cast: column '" + col_name + "' not found")
    str src_type = df.get_column(col_name).dtype_name()
    if src_type == target_type:
        return Ok(df)
    if not (target_type == "int" or target_type == "float" or target_type == "str" or target_type == "bool"):
        return Error("df_cast: unsupported cast from '" + src_type + "' to '" + target_type + "'")
    # Each match arm has a single direct return at its top level (workaround for a
    # compiler limitation where return inside if-inside-match-arm is incorrectly lowered).
    # The per-type cast helpers handle the target_type dispatch at their own top level.
    match df.get_column(col_name):
        case IntCol(c):
            return Ok(df_replace_col(df, col_name, cast_int_col(c, target_type)))
        case FloatCol(c):
            return Ok(df_replace_col(df, col_name, cast_float_col(c, target_type)))
        case StrCol(c):
            return Ok(df_replace_col(df, col_name, cast_str_col(c, target_type)))
        case BoolCol(c):
            return Ok(df_replace_col(df, col_name, cast_bool_col(c, target_type)))
    return Error("df_cast: unsupported cast from '" + src_type + "' to '" + target_type + "'")

# df_clip: clamp non-null values in a numeric column to [lo, hi].
# Non-numeric columns are returned unchanged. Nulls are preserved.
# For int columns: lo rounds up (ceil) and hi rounds down (floor) to nearest integer.
DataFrame df_clip(DataFrame df, str col_name, float lo, float hi):
    if not df.has_column(col_name):
        return df_copy(df)
    str dt = df.get_column(col_name).dtype_name()
    if dt != "int" and dt != "float":
        return df_copy(df)
    match df.get_column(col_name):
        case IntCol(c):
            int n = c.data.len()
            int lo_int = parse_int(float_to_str(ceil(lo))).unwrap_or(0)
            int hi_int = parse_int(float_to_str(floor(hi))).unwrap_or(0)
            Vector[int] d = Vector[int]()
            Vector[bool] m = Vector[bool]()
            int j = 0
            while j < n:
                if c.mask.get(j).unwrap():
                    int val = c.data.get(j).unwrap()
                    if val < lo_int:
                        val = lo_int
                    elif val > hi_int:
                        val = hi_int
                    d.push(val)
                    m.push(true)
                else:
                    d.push(0)
                    m.push(false)
                j = j + 1
            return df_replace_col(df, col_name, IntCol(TypedColumn[int](d, m)))
        case FloatCol(c):
            int n = c.data.len()
            Vector[float] d = Vector[float]()
            Vector[bool] m = Vector[bool]()
            int j = 0
            while j < n:
                if c.mask.get(j).unwrap():
                    float val = c.data.get(j).unwrap()
                    if val < lo:
                        val = lo
                    elif val > hi:
                        val = hi
                    d.push(val)
                    m.push(true)
                else:
                    d.push(0.0)
                    m.push(false)
                j = j + 1
            return df_replace_col(df, col_name, FloatCol(TypedColumn[float](d, m)))
        else:
            return df_copy(df)
