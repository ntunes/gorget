# xtd.httpserver — HTTP/1.1 server (V2: concurrent connections, keep-alive)
#
# Quick start:
#
#   from xtd.httpserver import HttpServer, HttpRequest, HttpServerResponse
#
#   HttpServerResponse handle(HttpRequest req):
#       if req.method == "GET" and req.path == "/hello":
#           return HttpServerResponse.ok("Hello, World!")
#       return HttpServerResponse.not_found()
#
#   async void main():
#       HttpServer server = HttpServer.new("0.0.0.0", 8080)
#       server.serve(handle).await()
#

from std.net.socket import ServerSocket, Socket, server_socket_bind
from std.net.tls import TlsSocket, TlsServerSocket, tls_server_bind
from std.collections import Vector, Dict
from std.conv import int_to_str
from std.bytes import bytes_to_str, bytes_concat, bytes_from_str, bytes_to_hex
from std.io import IoError
from std.fs import read_file, file_exists, is_dir
from std.path import path_join, path_extension
from std.encoding import url_decode, form_decode
from std.conv import ParseError
from xtd.crypto import crypto_sha1
from xtd.json import Json, json_parse, json_stringify

# ── Request and response types ────────────────────────────────

struct HttpRequest:
    String method          # "GET", "POST", ...
    String path            # "/api/users"
    String query_string    # raw query string without leading "?"
    String http_version    # "HTTP/1.1"
    Dict[String, String] headers   # lowercase header names
    String body
    Dict[String, String] params    # URL path parameters (populated by Router)

struct HttpServerResponse:
    int status_code
    String body
    String content_type
    Dict[String, String] headers   # additional response headers (e.g. Set-Cookie, CORS)

equip HttpServerResponse:
    HttpServerResponse ok(String body): HttpServerResponse(200, body, "text/plain", Dict[String, String]())
    HttpServerResponse html(String body): HttpServerResponse(200, body, "text/html", Dict[String, String]())
    HttpServerResponse json(String body): HttpServerResponse(200, body, "application/json", Dict[String, String]())
    # Build a 200 application/json response by serializing a Json value.
    HttpServerResponse of_json(Json val):
        String body = json_stringify(val)
        return HttpServerResponse(200, !body, "application/json", Dict[String, String]())
    HttpServerResponse not_found(): HttpServerResponse(404, "Not Found", "text/plain", Dict[String, String]())
    HttpServerResponse bad_request(String msg): HttpServerResponse(400, msg, "text/plain", Dict[String, String]())
    HttpServerResponse internal_error(String msg): HttpServerResponse(500, msg, "text/plain", Dict[String, String]())

    HttpServerResponse with_header(self, String name, String value):
        Dict[String, String] new_headers = self.headers
        new_headers.put(name, value)
        return HttpServerResponse(self.status_code, self.body, self.content_type, new_headers)

    HttpServerResponse redirect(String location):
        Dict[String, String] hdrs = Dict[String, String]()
        hdrs.put("Location", location)
        return HttpServerResponse(302, "", "text/plain", hdrs)

    String status_text(self):
        int sc = self.status_code
        if sc == 200:
            return "OK"
        elif sc == 201:
            return "Created"
        elif sc == 204:
            return "No Content"
        elif sc == 301:
            return "Moved Permanently"
        elif sc == 302:
            return "Found"
        elif sc == 400:
            return "Bad Request"
        elif sc == 401:
            return "Unauthorized"
        elif sc == 403:
            return "Forbidden"
        elif sc == 404:
            return "Not Found"
        elif sc == 405:
            return "Method Not Allowed"
        elif sc == 500:
            return "Internal Server Error"
        elif sc == 502:
            return "Bad Gateway"
        elif sc == 503:
            return "Service Unavailable"
        return "Unknown"

# ── Chunked body helpers ──────────────────────────────────────

int http_server_parse_hex(String s):
    int val = 0
    int i = 0
    while i < s.byte_len():
        byte c = s.byte_at(i)
        int v = 0
        if c >= b'0' and c <= b'9':
            v = c as int - b'0'
        elif c >= b'a' and c <= b'f':
            v = c as int - b'a' + 10
        elif c >= b'A' and c <= b'F':
            v = c as int - b'A' + 10
        else:
            return val
        val = val * 16 + v
        i = i + 1
    return val

String http_server_read_body_chunked(Socket &conn):
    Vector[uint8] buf = Vector[uint8]()
    bool reading = true
    while reading:
        Result[String, String] sl_r = conn.read_line()
        String size_line = ""
        if sl_r.is_ok():
            size_line = sl_r.unwrap()
        else:
            reading = false
            continue
        Option[int] semi = size_line.index_of(";")
        if semi.is_some():
            size_line = size_line.byte_slice(0, semi.unwrap()).trim().clone()
        else:
            size_line = size_line.trim().clone()
        int chunk_sz = http_server_parse_hex(size_line)
        if chunk_sz == 0:
            reading = false
        else:
            Vector[uint8] chunk = conn.read_exact(chunk_sz)
            buf = bytes_concat(buf, chunk)
            Result[String, String] crlf_r = conn.read_line()
    Result[String, String] trl_r = conn.read_line()
    String trailer = ""
    if trl_r.is_ok():
        trailer = trl_r.unwrap()
    while trailer != "":
        Result[String, String] next_r = conn.read_line()
        if next_r.is_ok():
            trailer = next_r.unwrap()
        else:
            trailer = ""
    return bytes_to_str(buf).unwrap()

String http_server_read_body_chunked_tls(TlsSocket &conn):
    Vector[uint8] buf = Vector[uint8]()
    bool reading = true
    while reading:
        Result[String, String] sl_r = conn.read_line()
        String size_line = ""
        if sl_r.is_ok():
            size_line = sl_r.unwrap()
        else:
            reading = false
            continue
        Option[int] semi = size_line.index_of(";")
        if semi.is_some():
            size_line = size_line.byte_slice(0, semi.unwrap()).trim().clone()
        else:
            size_line = size_line.trim().clone()
        int chunk_sz = http_server_parse_hex(size_line)
        if chunk_sz == 0:
            reading = false
        else:
            Vector[uint8] chunk = conn.read_exact(chunk_sz)
            buf = bytes_concat(buf, chunk)
            Result[String, String] crlf_r = conn.read_line()
    Result[String, String] trl_r2 = conn.read_line()
    String trailer2 = ""
    if trl_r2.is_ok():
        trailer2 = trl_r2.unwrap()
    while trailer2 != "":
        Result[String, String] next_r2 = conn.read_line()
        if next_r2.is_ok():
            trailer2 = next_r2.unwrap()
        else:
            trailer2 = ""
    return bytes_to_str(buf).unwrap()

# ── Request parser ────────────────────────────────────────────

Result[HttpRequest, String] http_server_parse_request(Socket &conn, int max_body_bytes = 16777216):
    # Request line: "METHOD /path?query HTTP/1.1"
    String req_line = conn.read_line()

    Option[int] sp1_opt = req_line.index_of(" ")
    if sp1_opt.is_none():
        return Error("malformed request line")
    int sp1 = sp1_opt.unwrap()
    String req_method = req_line.byte_slice(0, sp1).clone()
    String req_rest = req_line.byte_slice(sp1 + 1, req_line.byte_len()).clone()

    Option[int] sp2_opt = req_rest.index_of(" ")
    if sp2_opt.is_none():
        return Error("malformed request line")
    int sp2 = sp2_opt.unwrap()
    String raw_path = req_rest.byte_slice(0, sp2).clone()
    String req_version = req_rest.byte_slice(sp2 + 1, req_rest.byte_len()).clone()

    # Split path at "?" then percent-decode both parts
    String req_path = raw_path
    String req_query = ""
    Option[int] qm_opt = raw_path.index_of("?")
    if qm_opt.is_some():
        int qm = qm_opt.unwrap()
        req_path = raw_path.byte_slice(0, qm).clone()
        req_query = raw_path.byte_slice(qm + 1, raw_path.byte_len()).clone()
    Result[String, ParseError] pd = url_decode(req_path)
    if pd.is_ok():
        req_path = pd.unwrap()
    Result[String, ParseError] qd = url_decode(req_query)
    if qd.is_ok():
        req_query = qd.unwrap()

    # Headers (read until blank line)
    Dict[String, String] req_headers = Dict[String, String]()
    bool reading_headers = true
    while reading_headers:
        String hdr_line = conn.read_line()
        if hdr_line == "":
            reading_headers = false
        else:
            Option[int] colon_opt = hdr_line.index_of(":")
            if colon_opt.is_some():
                int colon = colon_opt.unwrap()
                String hdr_name = hdr_line.byte_slice(0, colon).trim().to_lower()
                String hdr_val = hdr_line.byte_slice(colon + 1, hdr_line.byte_len()).trim().clone()
                req_headers.put(hdr_name, hdr_val)

    # Body: chunked transfer-encoding takes priority over content-length
    String req_body = ""
    if req_headers.contains("transfer-encoding"):
        String te = req_headers["transfer-encoding"]
        if te.to_lower().contains("chunked"):
            req_body = http_server_read_body_chunked(&conn)
    elif req_headers.contains("content-length"):
        String cl_str = req_headers["content-length"]
        Option[int] cl_opt = int.parse(cl_str)
        if cl_opt is Some(cl_v):
            if cl_v > max_body_bytes:
                return Error("request body too large")
            if cl_v > 0:
                Vector[uint8] body_bytes = conn.read_exact(cl_v)
                Result[String, IoError] body_r = bytes_to_str(body_bytes)
                if body_r.is_ok():
                    req_body = body_r.unwrap()

    return Ok(HttpRequest(req_method, req_path, req_query, req_version, req_headers, req_body, Dict[String, String]()))

# ── Response writers ──────────────────────────────────────────

# Write response with "Connection: close" (legacy/single-request).
void http_server_write_response(Socket &conn, HttpServerResponse resp):
    String status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    String body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    # Emit any custom headers
    Vector[String] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        String hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# Write response with Connection header based on keep_alive flag.
void http_server_write_response_ka(Socket &conn, HttpServerResponse resp, bool keep_alive):
    String status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    String body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    # Emit any custom headers
    Vector[String] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        String hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    if keep_alive:
        conn.write_str("Connection: keep-alive\r\n\r\n")
    else:
        conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# ── Connection handlers ───────────────────────────────────────

# Legacy single-request handler (kept for backward compat — httpserver_basic uses it directly).
void http_server_handle_conn(Socket !conn, Callable[HttpServerResponse(HttpRequest)] handler):
    Result[HttpRequest, String] r = http_server_parse_request(&conn)
    match r:
        case Ok(req):
            HttpServerResponse resp = handler(req)
            http_server_write_response(&conn, resp)
        case Error(e):
            http_server_write_response(&conn, HttpServerResponse.bad_request(e))
    conn.close()

# Keep-alive connection handler: loop parse→handle→write on the same socket.
# Exits when:
#   - client sends "Connection: close"
#   - read times out (SO_RCVTIMEO set via timeout_ms)
#   - parse error (malformed request, EOF)
async void http_server_handle_conn_ka(Socket !conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms):
    conn.set_timeout(timeout_ms)
    bool alive = true
    while alive:
        Result[HttpRequest, String] r = http_server_parse_request(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                http_server_write_response_ka(&conn, resp, not client_wants_close)
                if client_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# Like http_server_handle_conn_ka but enforces a per-connection request limit.
# max_requests = 0 means unlimited (same as http_server_handle_conn_ka).
async void http_server_handle_conn_ka_limited(Socket !conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms, int max_requests):
    conn.set_timeout(timeout_ms)
    bool alive = true
    int req_count = 0
    while alive:
        Result[HttpRequest, String] r = http_server_parse_request(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                req_count = req_count + 1
                bool server_wants_close = max_requests > 0 and req_count >= max_requests
                http_server_write_response_ka(&conn, resp, not client_wants_close and not server_wants_close)
                if client_wants_close or server_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# ── TLS connection handlers ───────────────────────────────────

# Parse an HTTP/1.1 request from a TLS socket (identical logic to plain-TCP version).
Result[HttpRequest, String] http_server_parse_request_tls(TlsSocket &conn, int max_body_bytes = 16777216):
    String req_line = conn.read_line()

    Option[int] sp1_opt = req_line.index_of(" ")
    if sp1_opt.is_none():
        return Error("malformed request line")
    int sp1 = sp1_opt.unwrap()
    String req_method = req_line.byte_slice(0, sp1).clone()
    String req_rest = req_line.byte_slice(sp1 + 1, req_line.byte_len()).clone()

    Option[int] sp2_opt = req_rest.index_of(" ")
    if sp2_opt.is_none():
        return Error("malformed request line")
    int sp2 = sp2_opt.unwrap()
    String raw_path = req_rest.byte_slice(0, sp2).clone()
    String req_version = req_rest.byte_slice(sp2 + 1, req_rest.byte_len()).clone()

    String req_path = raw_path
    String req_query = ""
    Option[int] qm_opt = raw_path.index_of("?")
    if qm_opt.is_some():
        int qm = qm_opt.unwrap()
        req_path = raw_path.byte_slice(0, qm).clone()
        req_query = raw_path.byte_slice(qm + 1, raw_path.byte_len()).clone()
    Result[String, ParseError] tls_pd = url_decode(req_path)
    if tls_pd.is_ok():
        req_path = tls_pd.unwrap()
    Result[String, ParseError] tls_qd = url_decode(req_query)
    if tls_qd.is_ok():
        req_query = tls_qd.unwrap()

    Dict[String, String] req_headers = Dict[String, String]()
    bool reading_headers = true
    while reading_headers:
        String hdr_line = conn.read_line()
        if hdr_line == "":
            reading_headers = false
        else:
            Option[int] colon_opt = hdr_line.index_of(":")
            if colon_opt.is_some():
                int colon = colon_opt.unwrap()
                String hdr_name = hdr_line.byte_slice(0, colon).trim().to_lower()
                String hdr_val = hdr_line.byte_slice(colon + 1, hdr_line.byte_len()).trim().clone()
                req_headers.put(hdr_name, hdr_val)

    String req_body = ""
    if req_headers.contains("transfer-encoding"):
        String te = req_headers["transfer-encoding"]
        if te.to_lower().contains("chunked"):
            req_body = http_server_read_body_chunked_tls(&conn)
    elif req_headers.contains("content-length"):
        String cl_str = req_headers["content-length"]
        Option[int] cl_opt = int.parse(cl_str)
        if cl_opt is Some(cl_v):
            if cl_v > max_body_bytes:
                return Error("request body too large")
            if cl_v > 0:
                Vector[uint8] body_bytes = conn.read_exact(cl_v)
                Result[String, IoError] body_r = bytes_to_str(body_bytes)
                if body_r.is_ok():
                    req_body = body_r.unwrap()

    return Ok(HttpRequest(req_method, req_path, req_query, req_version, req_headers, req_body, Dict[String, String]()))

# Write a keep-alive HTTP response over a TLS socket.
void http_server_write_response_tls_ka(TlsSocket &conn, HttpServerResponse resp, bool keep_alive):
    String status_line = "HTTP/1.1 " + int_to_str(resp.status_code) + " " + resp.status_text() + "\r\n"
    String body_len = int_to_str(resp.body.byte_len())
    conn.write_str(status_line)
    conn.write_str("Content-Type: " + resp.content_type + "\r\n")
    conn.write_str("Content-Length: " + body_len + "\r\n")
    Vector[String] hdr_keys = resp.headers.keys()
    int hi = 0
    while hi < hdr_keys.len():
        String hk = hdr_keys[hi]
        conn.write_str(hk + ": " + resp.headers[hk] + "\r\n")
        hi = hi + 1
    if keep_alive:
        conn.write_str("Connection: keep-alive\r\n\r\n")
    else:
        conn.write_str("Connection: close\r\n\r\n")
    conn.write_str(resp.body)

# Keep-alive connection handler for TLS sockets.
async void http_server_handle_conn_tls_ka(TlsSocket !conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms):
    conn.set_timeout(timeout_ms)
    bool alive = true
    while alive:
        Result[HttpRequest, String] r = http_server_parse_request_tls(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                http_server_write_response_tls_ka(&conn, resp, not client_wants_close)
                if client_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# Like http_server_handle_conn_tls_ka but enforces a per-connection request limit.
# max_requests = 0 means unlimited.
async void http_server_handle_conn_tls_ka_limited(TlsSocket !conn, Callable[HttpServerResponse(HttpRequest)] handler, int timeout_ms, int max_requests):
    conn.set_timeout(timeout_ms)
    bool alive = true
    int req_count = 0
    while alive:
        Result[HttpRequest, String] r = http_server_parse_request_tls(&conn)
        match r:
            case Ok(req):
                bool client_wants_close = false
                if req.headers.contains("connection"):
                    if req.headers["connection"].to_lower() == "close":
                        client_wants_close = true
                HttpServerResponse resp = handler(req)
                req_count = req_count + 1
                bool server_wants_close = max_requests > 0 and req_count >= max_requests
                http_server_write_response_tls_ka(&conn, resp, not client_wants_close and not server_wants_close)
                if client_wants_close or server_wants_close:
                    alive = false
            case Error(e):
                alive = false
    conn.close()

# ── HttpServer ────────────────────────────────────────────────

struct HttpServer:
    String host
    int port
    int keep_alive_timeout_ms
    bool use_tls
    String cert_path
    String key_path
    int max_body_bytes
    # Maximum number of requests per keep-alive connection (0 = unlimited).
    int max_requests_per_conn

equip HttpServer:
    HttpServer new(String host, int port): HttpServer(host, port, 5000, false, "", "", 16777216, 0)
    HttpServer with_timeout(String host, int port, int timeout_ms): HttpServer(host, port, timeout_ms, false, "", "", 16777216, 0)
    HttpServer with_max_body(String host, int port, int max_bytes): HttpServer(host, port, 5000, false, "", "", max_bytes, 0)
    # Limit the number of requests served per keep-alive connection.
    HttpServer with_max_requests(String host, int port, int max_req): HttpServer(host, port, 5000, false, "", "", 16777216, max_req)

    # Construct a TLS-enabled server that will use the given PEM cert and key files.
    HttpServer new_tls(String host, int port, String cert_path, String key_path):
        return HttpServer(host, port, 5000, true, cert_path, key_path, 16777216, 0)

    # Bind and accept connections in a loop, calling handler for each.
    # Dispatches to serve_plain or serve_tls based on the use_tls flag.
    async void serve(self, Callable[HttpServerResponse(HttpRequest)] handler):
        if self.use_tls:
            self.serve_tls(handler).await()
        else:
            self.serve_plain(handler).await()

    # Plain TCP accept loop with per-connection keep-alive.
    async void serve_plain(self, Callable[HttpServerResponse(HttpRequest)] handler):
        Result[ServerSocket, String] bind_r = server_socket_bind(self.host, self.port)
        if bind_r.is_error():
            return
        ServerSocket srv = bind_r.unwrap()
        TaskGroup group = TaskGroup()
        loop:
            Result[Socket, String] ar = srv.accept()
            if ar.is_ok():
                Socket client = ar.unwrap()
                group.spawn(spawn http_server_handle_conn_ka_limited(!client, handler, self.keep_alive_timeout_ms, self.max_requests_per_conn))

    # TLS accept loop with per-connection keep-alive.
    async void serve_tls(self, Callable[HttpServerResponse(HttpRequest)] handler):
        Result[TlsServerSocket, String] bind_r = tls_server_bind(self.host, self.port, self.cert_path, self.key_path)
        if bind_r.is_error():
            return
        TlsServerSocket srv = bind_r.unwrap()
        TaskGroup group = TaskGroup()
        loop:
            Result[TlsSocket, String] ar = srv.accept()
            if ar.is_ok():
                TlsSocket client = ar.unwrap()
                group.spawn(spawn http_server_handle_conn_tls_ka_limited(!client, handler, self.keep_alive_timeout_ms, self.max_requests_per_conn))

    # Bind and accept exactly n connections, then close the socket and return.
    # Useful for testing and graceful shutdown scenarios.
    async void accept_n(self, Callable[HttpServerResponse(HttpRequest)] handler, int n):
        Result[ServerSocket, String] bind_r = server_socket_bind(self.host, self.port)
        if bind_r.is_error():
            return
        ServerSocket srv = bind_r.unwrap()
        TaskGroup group = TaskGroup()
        int i = 0
        while i < n:
            Result[Socket, String] ar = srv.accept()
            if ar.is_ok():
                Socket client = ar.unwrap()
                group.spawn(spawn http_server_handle_conn_ka_limited(!client, handler, self.keep_alive_timeout_ms, self.max_requests_per_conn))
                i = i + 1
        group.join()
        srv.close()

# ── Query string parser ───────────────────────────────────────

Dict[String, String] parse_query_string(String qs):
    Dict[String, String] params = Dict[String, String]()
    if qs == "":
        return params
    Vector[String] pairs = qs.split("&")
    int i = 0
    while i < pairs.len():
        String pair = pairs[i]
        Option[int] eq_opt = pair.index_of("=")
        if eq_opt.is_some():
            int eq = eq_opt.unwrap()
            String raw_key = pair.byte_slice(0, eq).clone()
            String raw_val = pair.byte_slice(eq + 1, pair.byte_len()).clone()
            Result[String, ParseError] dk = url_decode(raw_key)
            Result[String, ParseError] dv = url_decode(raw_val)
            params.put(dk.unwrap_or(raw_key), dv.unwrap_or(raw_val))
        else:
            Result[String, ParseError] dk2 = url_decode(pair)
            params.put(dk2.unwrap_or(pair), "")
        i = i + 1
    return params

# Parse an application/x-www-form-urlencoded body into a key→value dict.
# Keys and values are decoded using form_decode (+ → space, %XX → byte).
Dict[String, String] parse_form_body(String body):
    Dict[String, String] params = Dict[String, String]()
    if body == "":
        return params
    Vector[String] pairs = body.split("&")
    int i = 0
    while i < pairs.len():
        String pair = pairs[i]
        Option[int] eq_opt = pair.index_of("=")
        if eq_opt.is_some():
            int eq = eq_opt.unwrap()
            String raw_key = pair.byte_slice(0, eq).clone()
            String raw_val = pair.byte_slice(eq + 1, pair.byte_len()).clone()
            Result[String, ParseError] dk = form_decode(raw_key)
            Result[String, ParseError] dv = form_decode(raw_val)
            params.put(dk.unwrap_or(raw_key), dv.unwrap_or(raw_val))
        else:
            Result[String, ParseError] dk2 = form_decode(pair)
            params.put(dk2.unwrap_or(pair), "")
        i = i + 1
    return params

# Parse a Cookie header value into a name→value dict.
# Cookies are split by ";", trimmed, and split at the first "=".
# No decoding is applied (cookie values are raw).
Dict[String, String] parse_cookies(String header):
    Dict[String, String] cookies = Dict[String, String]()
    if header == "":
        return cookies
    Vector[String] parts = header.split(";")
    int i = 0
    while i < parts.len():
        String part = parts[i].trim().clone()
        Option[int] eq_opt = part.index_of("=")
        if eq_opt.is_some():
            int eq = eq_opt.unwrap()
            String name = part.byte_slice(0, eq).trim().clone()
            String value = part.byte_slice(eq + 1, part.byte_len()).trim().clone()
            if name != "":
                cookies.put(name, value)
        i = i + 1
    return cookies

equip HttpRequest:
    Dict[String, String] query_params(self):
        return parse_query_string(self.query_string)

    # Parse the request body as application/x-www-form-urlencoded.
    # Returns empty dict if body is empty or has no = pairs.
    Dict[String, String] form_params(self):
        return parse_form_body(self.body)

    # Parse the Cookie header into a name→value dict.
    # Returns empty dict if no Cookie header is present.
    Dict[String, String] cookies(self):
        if self.headers.contains("cookie"):
            return parse_cookies(self.headers["cookie"])
        return Dict[String, String]()

    # Parse the request body as JSON.
    # Returns Ok(Json) on success or Err(ParseError) on parse failure.
    Result[Json, ParseError] json(self):
        return json_parse(self.body)

# ── Router ────────────────────────────────────────────────────
#
# Registers handlers by "METHOD /path" key. Supports:
#  - Exact paths: "/api/users"
#  - Parameterized paths: "/users/:id" (colon-prefix denotes capture groups)
#
# Usage:
#   Router router = Router.new()
#   router.get("/hello", handle_hello)
#   router.get("/users/:id", handle_user)
#   server.serve((req): router.dispatch(req)).await()

# ── Path-parameter matching helper ────────────────────────────

# Match a URL path against a route pattern.
# Returns Ok(params_dict) on match, Error("") on miss.
# Pattern segments starting with ":" (e.g. ":id") capture the path segment.
Result[Dict[String, String], String] http_router_match_pattern(Vector[String] pattern, Vector[String] parts):
    if pattern.len() != parts.len():
        return Error("")
    Dict[String, String] params = Dict[String, String]()
    int i = 0
    while i < pattern.len():
        String seg = pattern[i]
        String part = parts[i]
        if seg.starts_with(":"):
            String param_name = seg.byte_slice(1, seg.byte_len()).clone()
            params.put(param_name, part)
        elif seg != part:
            return Error("")
        i = i + 1
    return Ok(params)

# Match a URL path against a wildcard route pattern.
# A segment starting with "*" captures all remaining path segments (joined by "/").
# Example: pattern "/files/*rest" matches "/files/img/logo.png" → params["rest"] = "img/logo.png"
# Returns Ok(params_dict) on match, Error("") on miss.
Result[Dict[String, String], String] http_router_match_wildcard(Vector[String] pattern, Vector[String] parts):
    # Find the wildcard segment index
    int wc_idx = -1
    String wc_name = ""
    int pi = 0
    while pi < pattern.len():
        String seg = pattern[pi]
        if seg.starts_with("*"):
            wc_idx = pi
            wc_name = seg.byte_slice(1, seg.byte_len()).clone()
        pi = pi + 1
    if wc_idx < 0:
        return Error("")
    # Path must have at least wc_idx segments before the wildcard
    if parts.len() < wc_idx:
        return Error("")
    # Match all segments before the wildcard exactly
    Dict[String, String] params = Dict[String, String]()
    int si = 0
    while si < wc_idx:
        if si >= pattern.len() or si >= parts.len():
            return Error("")
        String pseg = pattern[si]
        String ppart = parts[si]
        if pseg.starts_with(":"):
            String pname = pseg.byte_slice(1, pseg.byte_len()).clone()
            params.put(pname, ppart)
        elif pseg != ppart:
            return Error("")
        si = si + 1
    # Capture remaining parts into the wildcard param
    String captured = ""
    int ri = wc_idx
    while ri < parts.len():
        if ri > wc_idx:
            captured = captured + "/"
        captured = captured + parts[ri]
        ri = ri + 1
    params.put(wc_name, captured)
    return Ok(params)

struct Router:
    Dict[String, Callable[HttpServerResponse(HttpRequest)]] exact_routes
    # Parameterized routes: key = "METHOD|/path/:param" (method + "|" + original path).
    # Segments are re-derived from the key at dispatch time by splitting on "/".
    # This avoids storing Vector[String] inside a Dict (which causes use-after-free when
    # the shallow-copied vector is freed while the dict still owns the data).
    Dict[String, Callable[HttpServerResponse(HttpRequest)]] param_routes
    # Wildcard routes: key = "METHOD|/prefix/*name". The *name segment captures all
    # remaining path segments (including slashes) into params["name"].
    Dict[String, Callable[HttpServerResponse(HttpRequest)]] wildcard_routes
    # Post-dispatch middleware: called after handler, receives (req, resp) → resp.
    # Use cases: add CORS headers, inject X-headers, log status codes, etc.
    Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]] middlewares
    # Pre-dispatch middleware: called before handler, receives (req) → Option[HttpServerResponse].
    # Return Some(resp) to short-circuit (handler is not called).
    # Return None() to pass through to the next hook or the handler.
    # Post-dispatch middlewares still run on short-circuit responses.
    Vector[Callable[Option[HttpServerResponse](HttpRequest)]] pre_middlewares

equip Router:
    Router new():
        Dict[String, Callable[HttpServerResponse(HttpRequest)]] ex = Dict[String, Callable[HttpServerResponse(HttpRequest)]]()
        Dict[String, Callable[HttpServerResponse(HttpRequest)]] pr = Dict[String, Callable[HttpServerResponse(HttpRequest)]]()
        Dict[String, Callable[HttpServerResponse(HttpRequest)]] wr = Dict[String, Callable[HttpServerResponse(HttpRequest)]]()
        Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]] mw = Vector[Callable[HttpServerResponse(HttpRequest, HttpServerResponse)]]()
        Vector[Callable[Option[HttpServerResponse](HttpRequest)]] pre = Vector[Callable[Option[HttpServerResponse](HttpRequest)]]()
        return Router(ex, pr, wr, mw, pre)

    void route(&self, String method, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        Callable[HttpServerResponse(HttpRequest)] h = handler
        if path.contains("*"):
            String wkey = method + "|" + path
            self.wildcard_routes.put(wkey, h)
        elif path.contains(":"):
            String pkey = method + "|" + path
            self.param_routes.put(pkey, h)
        else:
            String key = method + " " + path
            self.exact_routes.put(key, h)

    void get(&self, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("GET", path, handler)

    void post(&self, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("POST", path, handler)

    void put(&self, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("PUT", path, handler)

    void delete(&self, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("DELETE", path, handler)

    void patch(&self, String path, Callable[HttpServerResponse(HttpRequest)] handler):
        self.route("PATCH", path, handler)

    # Register a post-dispatch middleware hook. Called after the handler, can modify response.
    # Typical uses: CORS headers, security headers, logging.
    void use(&self, Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] hook):
        Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] h = hook
        self.middlewares.push(h)

    # Register a pre-dispatch middleware hook. Called before the handler.
    # Return Some(resp) to short-circuit (skip handler). Return None() to continue.
    # Post-dispatch middlewares still run on short-circuit responses.
    # Typical uses: authentication, rate limiting, CORS preflight.
    void before(&self, Callable[Option[HttpServerResponse](HttpRequest)] hook):
        Callable[Option[HttpServerResponse](HttpRequest)] h = hook
        self.pre_middlewares.push(h)

    # Mount all routes from a sub-router under a path prefix.
    # Routes from sub are copied into self with `prefix` prepended.
    # Middlewares from sub are NOT copied (parent controls the pipeline).
    void prefix_mount(&self, String prefix, Router sub):
        Vector[String] ex_keys = sub.exact_routes.keys()
        int ei = 0
        while ei < ex_keys.len():
            String k = ex_keys[ei]
            Option[int] sp = k.index_of(" ")
            if sp.is_some():
                String mth = k.byte_slice(0, sp.unwrap()).clone()
                String pth = k.byte_slice(sp.unwrap() + 1, k.byte_len()).clone()
                Callable[HttpServerResponse(HttpRequest)] h = sub.exact_routes[k]
                self.exact_routes.put(mth + " " + prefix + pth, h)
            ei = ei + 1
        Vector[String] pr_keys = sub.param_routes.keys()
        int pri = 0
        while pri < pr_keys.len():
            String k = pr_keys[pri]
            Option[int] sp2 = k.index_of("|")
            if sp2.is_some():
                String mth = k.byte_slice(0, sp2.unwrap()).clone()
                String pth = k.byte_slice(sp2.unwrap() + 1, k.byte_len()).clone()
                Callable[HttpServerResponse(HttpRequest)] h = sub.param_routes[k]
                self.param_routes.put(mth + "|" + prefix + pth, h)
            pri = pri + 1
        Vector[String] wr_keys = sub.wildcard_routes.keys()
        int wri = 0
        while wri < wr_keys.len():
            String k = wr_keys[wri]
            Option[int] sp3 = k.index_of("|")
            if sp3.is_some():
                String mth = k.byte_slice(0, sp3.unwrap()).clone()
                String pth = k.byte_slice(sp3.unwrap() + 1, k.byte_len()).clone()
                Callable[HttpServerResponse(HttpRequest)] h = sub.wildcard_routes[k]
                self.wildcard_routes.put(mth + "|" + prefix + pth, h)
            wri = wri + 1

    # Collect all HTTP methods registered for a given path (exact or matching param pattern).
    # Used by HEAD and OPTIONS auto-handling.
    Vector[String] allowed_methods(&self, String path):
        Vector[String] all_methods = Vector[String]()
        all_methods.push("GET")
        all_methods.push("POST")
        all_methods.push("PUT")
        all_methods.push("DELETE")
        all_methods.push("PATCH")
        Vector[String] found = Vector[String]()
        Vector[String] path_parts = path.split("/")
        int ai = 0
        while ai < all_methods.len():
            String m = all_methods[ai]
            String exact_key = m + " " + path
            if self.exact_routes.contains(exact_key):
                found.push(m)
                ai = ai + 1
                continue
            String mpfx = m + "|"
            int mpfx_len = m.byte_len() + 1
            Vector[String] pkeys = self.param_routes.keys()
            int pi = 0
            bool matched = false
            while pi < pkeys.len():
                String pkey = pkeys[pi]
                if pkey.starts_with(mpfx):
                    String route_path = pkey.byte_slice(mpfx_len, pkey.byte_len()).clone()
                    Vector[String] pattern = route_path.split("/")
                    Result[Dict[String, String], String] mr = http_router_match_pattern(pattern, path_parts)
                    if mr.is_ok():
                        matched = true
                pi = pi + 1
            if not matched:
                Vector[String] wkeys = self.wildcard_routes.keys()
                int wi = 0
                while wi < wkeys.len():
                    String wkey = wkeys[wi]
                    if wkey.starts_with(mpfx):
                        String wpath = wkey.byte_slice(mpfx_len, wkey.byte_len()).clone()
                        Vector[String] wpat = wpath.split("/")
                        Result[Dict[String, String], String] wmr = http_router_match_wildcard(wpat, path_parts)
                        if wmr.is_ok():
                            matched = true
                    wi = wi + 1
            if matched:
                found.push(m)
            ai = ai + 1
        return found

    # Inner dispatch: exact match → param match → HEAD/OPTIONS auto → 404. No middleware applied.
    HttpServerResponse dispatch_inner(&self, HttpRequest req):
        # 1. Exact-match first (O(1))
        String key = req.method + " " + req.path
        if self.exact_routes.contains(key):
            Callable[HttpServerResponse(HttpRequest)] h = self.exact_routes[key]
            return h(req)
        # 2. Parameterized match (linear scan over param_routes)
        Vector[String] path_parts = req.path.split("/")
        Vector[String] pkeys = self.param_routes.keys()
        String method_prefix = req.method + "|"
        int method_prefix_len = req.method.byte_len() + 1
        int pi = 0
        while pi < pkeys.len():
            String pkey = pkeys[pi]
            if pkey.starts_with(method_prefix):
                String route_path = pkey.byte_slice(method_prefix_len, pkey.byte_len()).clone()
                Vector[String] pattern = route_path.split("/")
                Result[Dict[String, String], String] m = http_router_match_pattern(pattern, path_parts)
                if m.is_ok():
                    Dict[String, String] extracted = m.unwrap()
                    HttpRequest matched_req = HttpRequest(req.method, req.path, req.query_string, req.http_version, req.headers, req.body, extracted)
                    Callable[HttpServerResponse(HttpRequest)] h = self.param_routes[pkey]
                    return h(matched_req)
            pi = pi + 1
        # 2b. Wildcard match (linear scan over wildcard_routes)
        Vector[String] wkeys = self.wildcard_routes.keys()
        String wpfx = req.method + "|"
        int wpfx_len = req.method.byte_len() + 1
        int wi = 0
        while wi < wkeys.len():
            String wkey = wkeys[wi]
            if wkey.starts_with(wpfx):
                String wpath = wkey.byte_slice(wpfx_len, wkey.byte_len()).clone()
                Vector[String] wpat = wpath.split("/")
                Result[Dict[String, String], String] wm = http_router_match_wildcard(wpat, path_parts)
                if wm.is_ok():
                    Dict[String, String] wextracted = wm.unwrap()
                    HttpRequest wmatched_req = HttpRequest(req.method, req.path, req.query_string, req.http_version, req.headers, req.body, wextracted)
                    Callable[HttpServerResponse(HttpRequest)] wh = self.wildcard_routes[wkey]
                    return wh(wmatched_req)
            wi = wi + 1
        # 3. HEAD auto-handling: run the GET handler and strip the body.
        if req.method == "HEAD":
            HttpRequest get_req = HttpRequest("GET", req.path, req.query_string, req.http_version, req.headers, req.body, req.params)
            HttpServerResponse get_resp = self.dispatch_inner(get_req)
            return HttpServerResponse(get_resp.status_code, "", get_resp.content_type, get_resp.headers)
        # 4. OPTIONS auto-handling: respond with allowed methods for this path.
        if req.method == "OPTIONS":
            Vector[String] allowed = self.allowed_methods(req.path)
            if allowed.len() == 0:
                return HttpServerResponse.not_found()
            # Always include HEAD and OPTIONS in Allow header
            String allow_str = "OPTIONS, HEAD"
            int oi = 0
            while oi < allowed.len():
                allow_str = allow_str + ", " + allowed[oi]
                oi = oi + 1
            Dict[String, String] opts_hdrs = Dict[String, String]()
            opts_hdrs.put("Allow", allow_str)
            opts_hdrs.put("Content-Length", "0")
            return HttpServerResponse(200, "", "text/plain", opts_hdrs)
        # 5. Fallback: check if path exists under a different method → 405, else 404
        Vector[String] am = self.allowed_methods(req.path)
        if am.len() > 0:
            String allow_str_405 = "OPTIONS, HEAD"
            int oi405 = 0
            while oi405 < am.len():
                allow_str_405 = allow_str_405 + ", " + am[oi405]
                oi405 = oi405 + 1
            Dict[String, String] m405_hdrs = Dict[String, String]()
            m405_hdrs.put("Allow", allow_str_405)
            return HttpServerResponse(405, "Method Not Allowed", "text/plain", m405_hdrs)
        return HttpServerResponse.not_found()

    # Run post-dispatch middlewares on a response.
    HttpServerResponse run_post_middlewares(&self, HttpRequest req, HttpServerResponse !resp):
        int mi = 0
        while mi < self.middlewares.len():
            Callable[HttpServerResponse(HttpRequest, HttpServerResponse)] mw = self.middlewares[mi]
            resp = mw(req, resp)
            mi = mi + 1
        return resp

    # Dispatch a request through the router:
    #   1. Pre-dispatch hooks (before): first Some() short-circuits.
    #   2. Handler dispatch (dispatch_inner).
    #   3. Post-dispatch hooks (use): always run, even on short-circuit.
    HttpServerResponse dispatch(&self, HttpRequest req):
        # Pre-dispatch: first hook returning Some() short-circuits
        int pi = 0
        while pi < self.pre_middlewares.len():
            Callable[Option[HttpServerResponse](HttpRequest)] pre = self.pre_middlewares[pi]
            Option[HttpServerResponse] early = pre(req)
            if early is Some(short_resp):
                return self.run_post_middlewares(req, !short_resp)
            pi = pi + 1
        # Normal handler dispatch
        HttpServerResponse resp = self.dispatch_inner(req)
        return self.run_post_middlewares(req, !resp)

# ── Static file serving ───────────────────────────────────────

# Return the MIME type string for a file path based on its extension.
String http_mime_type(String path):
    String ext = path_extension(path)
    if ext == "html":
        return "text/html"
    elif ext == "htm":
        return "text/html"
    elif ext == "css":
        return "text/css"
    elif ext == "js":
        return "application/javascript"
    elif ext == "json":
        return "application/json"
    elif ext == "xml":
        return "text/xml"
    elif ext == "png":
        return "image/png"
    elif ext == "jpg":
        return "image/jpeg"
    elif ext == "jpeg":
        return "image/jpeg"
    elif ext == "gif":
        return "image/gif"
    elif ext == "svg":
        return "image/svg+xml"
    elif ext == "ico":
        return "image/x-icon"
    elif ext == "woff":
        return "font/woff"
    elif ext == "woff2":
        return "font/woff2"
    elif ext == "txt":
        return "text/plain"
    elif ext == "pdf":
        return "application/pdf"
    elif ext == "webp":
        return "image/webp"
    elif ext == "mp4":
        return "video/mp4"
    elif ext == "mp3":
        return "audio/mpeg"
    return "application/octet-stream"

# Compute an ETag value for file content (SHA-1 hex, double-quoted per RFC 7232).
String http_etag(String content):
    Vector[uint8] sha = crypto_sha1(bytes_from_str(content))
    return "\"" + bytes_to_hex(sha) + "\""

# Serve a file from base_dir for the request path.
# - Rejects paths containing ".." (directory traversal protection).
# - Automatically serves index.html when the resolved path is a directory.
# - Returns 200 with file content + correct MIME type on success.
# - Returns 304 Not Modified when If-None-Match header matches the ETag.
# - Returns 206 Partial Content for Range requests (bytes=start-end or bytes=start-).
# - Returns 404 for missing files, 400 for invalid paths.
HttpServerResponse http_serve_file(String base_dir, HttpRequest req):
    if req.path.contains(".."):
        return HttpServerResponse.bad_request("invalid path")
    String file_path = path_join(base_dir, req.path)
    if is_dir(file_path):
        file_path = path_join(file_path, "index.html")
    if not file_exists(file_path):
        return HttpServerResponse.not_found()
    String content = read_file(file_path)
    String mime = http_mime_type(file_path)
    String etag = http_etag(content)
    # 304 Not Modified: check If-None-Match
    if req.headers.contains("if-none-match"):
        String inm = req.headers["if-none-match"]
        if inm == etag:
            Dict[String, String] nm_hdrs = Dict[String, String]()
            nm_hdrs.put("ETag", etag)
            return HttpServerResponse(304, "", mime, nm_hdrs)
    # 206 Partial Content: handle Range header
    if req.headers.contains("range"):
        String range_hdr = req.headers["range"]
        if range_hdr.starts_with("bytes="):
            String spec = range_hdr.byte_slice(6, range_hdr.byte_len()).clone()
            int total = content.byte_len()
            Option[int] dash_opt = spec.index_of("-")
            if dash_opt.is_some():
                int dash = dash_opt.unwrap()
                String start_s = spec.byte_slice(0, dash).trim().clone()
                String end_s = spec.byte_slice(dash + 1, spec.byte_len()).trim().clone()
                Option[int] start_opt = int.parse(start_s)
                if start_opt.is_some():
                    int start = start_opt.unwrap()
                    int end_exclusive = total
                    if end_s != "":
                        Option[int] end_opt = int.parse(end_s)
                        if end_opt.is_some():
                            end_exclusive = end_opt.unwrap() + 1
                    if start < total and start < end_exclusive:
                        String partial = content.byte_slice(start, end_exclusive).clone()
                        Dict[String, String] rhdrs = Dict[String, String]()
                        rhdrs.put("Content-Range", "bytes " + int_to_str(start) + "-" + int_to_str(end_exclusive - 1) + "/" + int_to_str(total))
                        rhdrs.put("ETag", etag)
                        return HttpServerResponse(206, partial, mime, rhdrs)
    # 200 OK
    Dict[String, String] ok_hdrs = Dict[String, String]()
    ok_hdrs.put("ETag", etag)
    return HttpServerResponse(200, content, mime, ok_hdrs)
