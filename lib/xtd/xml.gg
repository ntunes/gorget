# std.xml — Pure Gorget XML parser
#
# Provides a recursive-descent XML parser, serializer, and accessor methods.
# No C dependencies — uses only Gorget standard library.
#
# Scope: elements, attributes, text content, entity refs, self-closing tags,
# comment skipping. No namespaces, DTD, CDATA, or processing instructions.

from std.collections import Vector, Dict
from std.conv import int_to_str, parse_int, chr, ParseError

# ── XML node types ─────────────────────────────────────────
# Element(tag_name, attributes, child_nodes) | Text(content)

enum XmlNode:
    Element(String, Dict[String, String], Vector[XmlNode])
    Text(String)

# ── Hex parsing helper ────────────────────────────────────

private int hex_to_int(String hex_str):
    if hex_str.byte_len() == 0:
        return -1
    int result = 0
    int hi = 0
    while hi < hex_str.byte_len():
        byte hc = hex_str.byte_at(hi)
        int digit = -1
        if hc >= b'0' and hc <= b'9':
            digit = hc as int - b'0'
        elif hc >= b'a' and hc <= b'f':
            digit = hc as int - b'a' + 10
        elif hc >= b'A' and hc <= b'F':
            digit = hc as int - b'A' + 10
        if digit < 0:
            return -1
        result = result * 16 + digit
        hi = hi + 1
    return result

# ── Entity decoding / encoding ─────────────────────────────

private String decode_entities(String raw_text):
    String decoded = ""
    int ei = 0
    while ei < raw_text.byte_len():
        String ec = raw_text.char_at(ei)
        if ec == '&':
            int semi_pos = ei + 1
            while semi_pos < raw_text.byte_len() and raw_text.char_at(semi_pos) != ';':
                semi_pos = semi_pos + 1
            if semi_pos < raw_text.byte_len():
                String entity_name = raw_text.byte_slice(ei + 1, semi_pos)
                if entity_name == "amp":
                    decoded = decoded + "&"
                    ei = semi_pos + 1
                elif entity_name == "lt":
                    decoded = decoded + "<"
                    ei = semi_pos + 1
                elif entity_name == "gt":
                    decoded = decoded + ">"
                    ei = semi_pos + 1
                elif entity_name == "quot":
                    decoded = decoded + "\""
                    ei = semi_pos + 1
                elif entity_name == "apos":
                    decoded = decoded + "'"
                    ei = semi_pos + 1
                else:
                    int nc_code = -1
                    if entity_name.byte_len() > 1:
                        String en_first = entity_name.char_at(0)
                        if en_first == '#':
                            String ref_body = entity_name.byte_slice(1, entity_name.byte_len())
                            if ref_body.byte_len() > 1:
                                String rb_first = ref_body.char_at(0)
                                if rb_first == 'x' or rb_first == 'X':
                                    nc_code = hex_to_int(ref_body.byte_slice(1, ref_body.byte_len()))
                            if nc_code < 0 and ref_body.byte_len() > 0:
                                bool all_digits = true
                                int di = 0
                                while di < ref_body.byte_len():
                                    String dc = ref_body.char_at(di)
                                    if dc < '0' or dc > '9':
                                        all_digits = false
                                    di = di + 1
                                if all_digits:
                                    nc_code = parse_int(ref_body).unwrap_or(0)
                    if nc_code > 0:
                        decoded = decoded + chr(nc_code)
                        ei = semi_pos + 1
                    else:
                        decoded = decoded + "&"
                        ei = ei + 1
            else:
                decoded = decoded + "&"
                ei = ei + 1
        else:
            decoded = decoded + ec
            ei = ei + 1
    return decoded

private String encode_text(String raw_text):
    String encoded = ""
    int ti = 0
    while ti < raw_text.byte_len():
        String tc = raw_text.char_at(ti)
        if tc == '&':
            encoded = encoded + "&amp;"
        elif tc == '<':
            encoded = encoded + "&lt;"
        elif tc == '>':
            encoded = encoded + "&gt;"
        else:
            encoded = encoded + tc
        ti = ti + 1
    return encoded

private String encode_attr(String raw_attr):
    String encoded = ""
    int ai = 0
    while ai < raw_attr.byte_len():
        String ac = raw_attr.char_at(ai)
        if ac == '&':
            encoded = encoded + "&amp;"
        elif ac == '<':
            encoded = encoded + "&lt;"
        elif ac == '>':
            encoded = encoded + "&gt;"
        elif ac == '"':
            encoded = encoded + "&quot;"
        elif ac == '\'':
            encoded = encoded + "&apos;"
        else:
            encoded = encoded + ac
        ai = ai + 1
    return encoded

# ── Internal parser ────────────────────────────────────────

struct XmlParser:
    String xml_input
    int pos
    String err

equip XmlParser:
    bool failed(self): self.err != ""

    void fail(&self, String msg):
        if self.err == "":
            self.err = !msg

    String peek(self):
        if self.pos < self.xml_input.byte_len():
            return self.xml_input.char_at(self.pos)
        return '\0'

    void advance(&self):
        if self.pos < self.xml_input.byte_len():
            self.pos = self.pos + 1

    void skip_ws(&self):
        while self.pos < self.xml_input.byte_len():
            String wc = self.xml_input.char_at(self.pos)
            if wc == ' ' or wc == '\t' or wc == '\n' or wc == '\r':
                self.pos = self.pos + 1
            else:
                return

    bool starts_with_at(self, String prefix):
        int plen = prefix.byte_len()
        if self.pos + plen > self.xml_input.byte_len():
            return false
        return self.xml_input.byte_slice(self.pos, self.pos + plen) == prefix

    void consume_str(&self, String expected):
        int elen = expected.byte_len()
        if self.pos + elen > self.xml_input.byte_len():
            String cs_err = "expected {expected}"
            self.fail(cs_err)
            return
        if self.xml_input.byte_slice(self.pos, self.pos + elen) != expected:
            String cs_err = "expected {expected}"
            self.fail(cs_err)
            return
        self.pos = self.pos + elen

    # ── Tag name parsing ────────────────────────────────────

    String parse_tag_name(&self):
        int start = self.pos
        while self.pos < self.xml_input.byte_len():
            String tc = self.xml_input.char_at(self.pos)
            if tc >= 'a' and tc <= 'z':
                self.pos = self.pos + 1
            elif tc >= 'A' and tc <= 'Z':
                self.pos = self.pos + 1
            elif tc >= '0' and tc <= '9':
                self.pos = self.pos + 1
            elif tc == '_' or tc == ':' or tc == '.' or tc == '-':
                self.pos = self.pos + 1
            else:
                break
        if self.pos == start:
            self.fail("expected tag name")
            return ""
        return self.xml_input.byte_slice(start, self.pos)

    # ── Attribute parsing ───────────────────────────────────

    String parse_attr_value(&self):
        if self.pos >= self.xml_input.byte_len():
            self.fail("expected attribute value")
            return ""
        String quote_ch = self.xml_input.char_at(self.pos)
        if quote_ch != '"' and quote_ch != '\'':
            self.fail("expected quote in attribute value")
            return ""
        self.pos = self.pos + 1
        String attr_val = ""
        while self.pos < self.xml_input.byte_len():
            String vc = self.xml_input.char_at(self.pos)
            if vc == quote_ch:
                self.pos = self.pos + 1
                return decode_entities(attr_val)
            attr_val = attr_val + vc
            self.pos = self.pos + 1
        self.fail("unterminated attribute value")
        return ""

    Dict[String, String] parse_attributes(&self):
        Dict[String, String] attr_map = Dict[String, String]()
        while self.pos < self.xml_input.byte_len():
            self.skip_ws()
            if self.pos >= self.xml_input.byte_len():
                break
            String ac = self.xml_input.char_at(self.pos)
            if ac == '>' or ac == '/' or ac == '?':
                break
            String attr_key = self.parse_tag_name()
            if self.failed():
                return attr_map
            self.skip_ws()
            self.consume_str("=")
            if self.failed():
                return attr_map
            self.skip_ws()
            String attr_value = self.parse_attr_value()
            if self.failed():
                return attr_map
            attr_map.put(attr_key, attr_value)
        return attr_map

    # ── Comment handling ────────────────────────────────────

    void skip_comment(&self):
        while self.pos < self.xml_input.byte_len():
            if self.starts_with_at("-->"):
                self.pos = self.pos + 3
                return
            self.pos = self.pos + 1
        self.fail("unterminated comment")

    # ── Node parsing ────────────────────────────────────────

    XmlNode parse_text(&self):
        String text_val = ""
        while self.pos < self.xml_input.byte_len():
            String xc = self.xml_input.char_at(self.pos)
            if xc == '<':
                break
            text_val = text_val + xc
            self.pos = self.pos + 1
        return Text(decode_entities(text_val))

    XmlNode parse_element(&self):
        # Consume '<'
        self.pos = self.pos + 1
        String elem_tag = self.parse_tag_name()
        if self.failed():
            return Text("")
        Dict[String, String] elem_attrs = self.parse_attributes()
        if self.failed():
            return Text("")
        self.skip_ws()
        # Self-closing tag?
        if self.starts_with_at("/>"):
            self.pos = self.pos + 2
            return Element(elem_tag, elem_attrs, Vector[XmlNode]())
        # Consume '>'
        if self.pos >= self.xml_input.byte_len() or self.xml_input.char_at(self.pos) != '>':
            self.fail("expected >")
            return Text("")
        self.pos = self.pos + 1
        # Parse children
        Vector[XmlNode] child_list = Vector[XmlNode]()
        while self.pos < self.xml_input.byte_len():
            if self.starts_with_at("</"):
                break
            XmlNode child_nd = self.parse_node()
            if self.failed():
                return Text("")
            match child_nd:
                case Text(xtv):
                    if xtv != "":
                        child_list.push(child_nd)
                case Element(xtag, xattr_dict, xkids):
                    child_list.push(child_nd)
        # Consume closing tag </tag_name>
        self.consume_str("</")
        if self.failed():
            return Text("")
        String close_tag = self.parse_tag_name()
        if self.failed():
            return Text("")
        if close_tag != elem_tag:
            String tag_err = "mismatched closing tag: expected {elem_tag} got {close_tag}"
            self.fail(tag_err)
            return Text("")
        self.skip_ws()
        if self.pos >= self.xml_input.byte_len() or self.xml_input.char_at(self.pos) != '>':
            self.fail("expected > in closing tag")
            return Text("")
        self.pos = self.pos + 1
        return Element(elem_tag, elem_attrs, child_list)

    XmlNode parse_node(&self):
        if self.failed():
            return Text("")
        if self.pos >= self.xml_input.byte_len():
            return Text("")
        if self.xml_input.char_at(self.pos) != '<':
            return self.parse_text()
        # Check for comment <!--
        if self.starts_with_at("<!--"):
            self.pos = self.pos + 4
            self.skip_comment()
            return self.parse_node()
        # Check for XML declaration <?xml ... ?>
        if self.starts_with_at("<?"):
            self.pos = self.pos + 2
            while self.pos < self.xml_input.byte_len():
                if self.starts_with_at("?>"):
                    self.pos = self.pos + 2
                    break
                self.pos = self.pos + 1
            return self.parse_node()
        # Regular element
        return self.parse_element()

# ── Public API ─────────────────────────────────────────────

Result[XmlNode, ParseError] xml_parse(String xml_src):
    XmlParser xp = XmlParser(xml_src, 0, "")
    xp.skip_ws()
    XmlNode root_node = xp.parse_node()
    if xp.failed():
        return Error(ParseError.InvalidSyntax(xp.pos, xp.err))
    return Ok(!root_node)

# ── Serialization ──────────────────────────────────────────

String xml_stringify_node(XmlNode nd, Dict[String, String] nd_attrs, Vector[XmlNode] nd_kids, String nd_tag):
    String buf = String()
    buf.push("<")
    buf.push(nd_tag)
    Vector[String] attr_keys = nd_attrs.keys()
    int ki = 0
    while ki < attr_keys.len():
        String akey = attr_keys.get(ki).unwrap()
        buf.push(" ")
        buf.push(akey)
        buf.push("=\"")
        buf.push(encode_attr(nd_attrs[akey]))
        buf.push("\"")
        ki = ki + 1
    if nd_kids.len() == 0:
        buf.push("/>")
        return buf
    buf.push(">")
    int ci = 0
    while ci < nd_kids.len():
        XmlNode xml_child = nd_kids.get(ci).unwrap()
        buf.push(xml_stringify(xml_child))
        ci = ci + 1
    buf.push("</")
    buf.push(nd_tag)
    buf.push(">")
    return buf

String xml_stringify(XmlNode nd):
    match nd:
        case Text(xtv):
            return encode_text(xtv)
        case Element(xtag, xattr_dict, xkids):
            return xml_stringify_node(nd, xattr_dict, xkids, xtag)

# ── Accessor methods ───────────────────────────────────────

equip XmlNode:
    String tag(self):
        match self:
            case Element(xtag, xattr_dict, xkids):
                return xtag
            else:
                return ""

    String attr(self, String key):
        match self:
            case Element(xtag, xattr_dict, xkids):
                if xattr_dict.contains(key):
                    return xattr_dict[key]
                return ""
            else:
                return ""

    Vector[XmlNode] children(self):
        match self:
            case Element(xtag, xattr_dict, xkids):
                return xkids.clone()
            else:
                return Vector[XmlNode]()

    String text(self):
        match self:
            case Text(xtv):
                return xtv
            case Element(xtag, xattr_dict, xkids):
                String combined = ""
                int ti = 0
                while ti < xkids.len():
                    XmlNode child_nd = xkids.get(ti).unwrap()
                    combined = combined + child_nd.text()
                    ti = ti + 1
                return combined

    XmlNode find(self, String find_tag):
        match self:
            case Element(xtag, xattr_dict, xkids):
                int fi = 0
                while fi < xkids.len():
                    XmlNode found_nd = xkids.get(fi).unwrap()
                    if found_nd.tag() == find_tag:
                        return found_nd
                    fi = fi + 1
                return Text("")
            else:
                return Text("")

    Vector[XmlNode] find_all(self, String find_tag):
        Vector[XmlNode] xml_matches = Vector[XmlNode]()
        match self:
            case Element(xtag, xattr_dict, xkids):
                int fi = 0
                while fi < xkids.len():
                    XmlNode found_nd = xkids.get(fi).unwrap()
                    if found_nd.tag() == find_tag:
                        xml_matches.push(found_nd)
                    fi = fi + 1
            else:
                pass
        return xml_matches
