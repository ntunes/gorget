# xtd.metal -- Apple Metal bindings (Metal 1 through Metal 3)
#
# Covers: device/queue/command buffer lifecycle, buffers, textures, samplers,
# shaders, render/compute/blit encoders, synchronization (events/fences/semaphores),
# ray tracing, mesh shaders, argument buffers, indirect drawing, and more.
#
# All functions delegate to gorget_metal_* C runtime wrappers.
# All handles are opaque int (pointer-sized).

from std.collections import Vector

