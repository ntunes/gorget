    extern int metal_create_library(int device, String source) = "gorget_metal_create_library"
    extern int metal_create_library_from_data(int device, Vector[uint8] data) = "gorget_metal_create_library_from_data"
    extern int metal_library_function(int library, String name) = "gorget_metal_library_function"

