    extern void metal_vertex_desc_set_layout(int desc, int index, int stride, int step_function) = "gorget_metal_vertex_desc_set_layout"

    # ── Render Pipeline ────────────────────────────────────
    extern int metal_create_render_pipeline(int device, int vertex_fn, int fragment_fn, int vertex_desc, int color_format, int depth_format) = "gorget_metal_create_render_pipeline"
    extern int metal_create_render_pipeline_blended(int device, int vertex_fn, int fragment_fn, int vertex_desc, int color_format, int depth_format, int blend_src_rgb, int blend_dst_rgb, int blend_src_a, int blend_dst_a) = "gorget_metal_create_render_pipeline_blended"

    # ── Depth/Stencil State ────────────────────────────────
