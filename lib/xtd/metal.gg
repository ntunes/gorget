extern "C":
    # ── Device ─────────────────────────────────────────────
    extern int metal_create_device() = "gorget_metal_create_device"
    extern String metal_device_name(int device) = "gorget_metal_device_name"
    extern bool metal_device_supports_family(int device, int family) = "gorget_metal_device_supports_family"

    # ── Command Queue ──────────────────────────────────────
    extern int metal_create_command_queue(int device) = "gorget_metal_create_command_queue"

    # ── Command Buffer ─────────────────────────────────────
    extern int metal_create_command_buffer(int queue) = "gorget_metal_create_command_buffer"
    extern void metal_command_buffer_present(int cmd_buf, int drawable) = "gorget_metal_command_buffer_present"
    extern void metal_command_buffer_commit(int cmd_buf) = "gorget_metal_command_buffer_commit"
    extern void metal_command_buffer_wait(int cmd_buf) = "gorget_metal_command_buffer_wait"

    # ── Buffers ────────────────────────────────────────────
    extern int metal_create_buffer(int device, int length, int storage_mode) = "gorget_metal_create_buffer"
