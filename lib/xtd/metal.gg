    extern void metal_buffer_did_modify_range(int buffer, int offset, int length) = "gorget_metal_buffer_did_modify_range"

    # ── Textures ───────────────────────────────────────────
    extern int metal_create_texture_2d(int device, int width, int height, int format, int usage, int storage_mode) = "gorget_metal_create_texture_2d"
    extern int metal_create_texture_2d_mipmapped(int device, int width, int height, int format, int mip_levels, int usage, int storage_mode) = "gorget_metal_create_texture_2d_mipmapped"
    extern void metal_texture_upload(int texture, int x, int y, int width, int height, Vector[uint8] data, int bytes_per_row) = "gorget_metal_texture_upload"
    extern void metal_texture_upload_mip(int texture, int mip_level, int x, int y, int width, int height, Vector[uint8] data, int bytes_per_row) = "gorget_metal_texture_upload_mip"
    extern int metal_texture_width(int texture) = "gorget_metal_texture_width"
    extern int metal_texture_height(int texture) = "gorget_metal_texture_height"

    # ── Samplers ───────────────────────────────────────────
    extern int metal_create_sampler(int device, int min_filter, int mag_filter, int mip_filter, int address_s, int address_t) = "gorget_metal_create_sampler"

