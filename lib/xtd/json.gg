# gg.json — Pure Gorget JSON parser
#
# Provides a recursive-descent JSON parser, serializer, and accessor methods.
# No C dependencies — uses only Gorget standard library.

from std.collections import Vector, Dict, Box
from std.conv import parse_int, parse_float, int_to_str, float_to_str, bool_to_str, codepoint_to_str, ParseError

# ── JSON value type ──────────────────────────────────────────

enum Json:
    Null
    Bool(bool)
    Int(int)
    Float(float)
    Str(String)
    Arr(Vector[Json])
    Obj(Dict[String, Json])

# ── Serialization traits ────────────────────────────────────

trait Serializer:
    void write_bool(&self, bool v)
    void write_int(&self, int v)
    void write_float(&self, float v)
    void write_str(&self, String v)
    void write_null(&self)
    void begin_struct(&self, String name, int field_count)
    void field(&self, String name, int index)
    void end_struct(&self)
    void begin_seq(&self, int len)
    void elem(&self, int index)
    void end_seq(&self)
    String result(self)

trait Serializable:
    void serialize(self, Box[Serializer] ser)

# ── Deserialization traits ─────────────────────────────────

trait Deserializer:
    bool read_bool(&self)
    int read_int(&self)
    float read_float(&self)
    String read_str(&self)
    bool is_null(self)
    bool is_string(self)
    bool is_struct(self)
    bool is_seq(self)
    void begin_struct(&self)
    bool has_field(self, String name)
    void field(&self, String name)
    void end_struct(&self)
    int begin_seq(&self)
    void elem(&self, int index)
    void end_seq(&self)
    Vector[String] keys(self)
    bool has_error(self)
    String error(self)

struct JsonDeserializer:
    Json de_current
    Vector[Json] de_stack
    String de_err

equip JsonDeserializer with Deserializer:
    bool read_bool(&self):
        if self.de_err != "":
            return false
        match self.de_current:
            case Bool(de_bval):
                return de_bval
            else:
                self.de_err = "expected bool"
                return false

    int read_int(&self):
        if self.de_err != "":
            return 0
        match self.de_current:
            case Int(de_ival):
                return de_ival
            else:
                self.de_err = "expected int"
                return 0

    float read_float(&self):
        if self.de_err != "":
            return 0.0
        match self.de_current:
            case Float(de_fval):
                return de_fval
            case Int(de_ival2):
                return de_ival2 as float
            else:
                self.de_err = "expected float"
                return 0.0

    String read_str(&self):
        if self.de_err != "":
            return ""
        match self.de_current:
            case Str(de_sval):
                return de_sval
            else:
                self.de_err = "expected string"
                return ""

    bool is_null(self):
        match self.de_current:
            case Null():
                return true
            else:
                return false

    bool is_string(self):
        match self.de_current:
            case Str(de_sv):
                return true
            else:
                return false

    bool is_struct(self):
        match self.de_current:
            case Obj(de_ov):
                return true
            else:
                return false

    bool is_seq(self):
        match self.de_current:
            case Arr(de_av):
                return true
            else:
                return false

    void begin_struct(&self):
        if self.de_err != "":
            return
        if self.de_current.is_object():
            self.de_stack.push(self.de_current.clone())
        else:
            self.de_err = "expected object"

    bool has_field(self, String name):
        if self.de_stack.len() == 0:
            return false
        Json de_top = self.de_stack.get(self.de_stack.len() - 1).unwrap()
        return de_top.has(name)

    void field(&self, String name):
        if self.de_err != "":
            return
        if self.de_stack.len() == 0:
            self.de_err = "no struct context"
            return
        Json de_top = self.de_stack.get(self.de_stack.len() - 1).unwrap()
        self.de_current = de_top.get(name).unwrap_or(Null())

    void end_struct(&self):
        if self.de_err != "":
            return
        if self.de_stack.len() == 0:
            self.de_err = "no struct context to end"
            return
        self.de_current = self.de_stack.pop().unwrap()

    int begin_seq(&self):
        if self.de_err != "":
            return 0
        if self.de_current.is_array():
            int de_seq_len = self.de_current.len()
            self.de_stack.push(self.de_current.clone())
            return de_seq_len
        self.de_err = "expected array"
        return 0

    void elem(&self, int index):
        if self.de_err != "":
            return
        if self.de_stack.len() == 0:
            self.de_err = "no seq context"
            return
        Json de_top = self.de_stack.get(self.de_stack.len() - 1).unwrap()
        self.de_current = de_top.at(index).unwrap_or(Null())

    void end_seq(&self):
        if self.de_err != "":
            return
        if self.de_stack.len() == 0:
            self.de_err = "no seq context to end"
            return
        self.de_current = self.de_stack.pop().unwrap()

    Vector[String] keys(self):
        if self.de_stack.len() == 0:
            return Vector[String]()
        Json de_top = self.de_stack.get(self.de_stack.len() - 1).unwrap()
        return de_top.keys()

    bool has_error(self):
        return self.de_err != ""

    String error(self):
        return self.de_err

# ── Internal parser ──────────────────────────────────────────

struct JsonParser:
    String input
    int pos
    int depth
    String err

equip JsonParser:
    bool failed(self): self.err != ""

    void fail(&self, String msg):
        if self.err == "":
            self.err = !msg

    void skip_whitespace(&self):
        while self.pos < self.input.byte_len():
            String c = self.input.char_at(self.pos)
            if c == ' ' or c == '\t' or c == '\n' or c == '\r':
                self.pos = self.pos + 1
            else:
                return

    Json parse_value(&self):
        if self.failed():
            return Null()
        self.skip_whitespace()
        if self.pos >= self.input.byte_len():
            self.fail("unexpected end of input")
            return Null()
        String c = self.input.char_at(self.pos)
        if c == '"':
            return self.parse_string_value()
        if c == '{':
            if self.depth >= 1000:
                self.fail("max nesting depth exceeded")
                return Null()
            self.depth = self.depth + 1
            Json obj_val = self.parse_object()
            self.depth = self.depth - 1
            return obj_val
        if c == '[':
            if self.depth >= 1000:
                self.fail("max nesting depth exceeded")
                return Null()
            self.depth = self.depth + 1
            Json arr_val = self.parse_array()
            self.depth = self.depth - 1
            return arr_val
        if c == 't' or c == 'f' or c == 'n':
            return self.parse_keyword()
        if c == '-' or c >= '0' and c <= '9':
            return self.parse_number()
        self.fail("unexpected character")
        return Null()

    Json parse_string_value(&self):
        String s = self.parse_string()
        if self.failed():
            return Null()
        return Str(s)

    String parse_string(&self):
        # Skip opening quote
        self.pos = self.pos + 1
        String result = ""
        while self.pos < self.input.byte_len():
            # Reject raw control bytes (< 0x20) per RFC 8259 \xa77:
            # unescaped = %x20-21 / %x23-5B / %x5D-10FFFF
            byte raw_b = self.input.byte_at(self.pos)
            if raw_b < 0x20 as uint8:
                self.fail("unescaped control character in string")
                return ""
            String c = self.input.char_at(self.pos)
            if c == '"':
                self.pos = self.pos + 1
                return result
            if c == '\\':
                self.pos = self.pos + 1
                if self.pos >= self.input.byte_len():
                    self.fail("unterminated string escape")
                    return ""
                String esc = self.input.char_at(self.pos)
                self.pos = self.pos + 1
                if esc == '"':
                    result = result + "\""
                elif esc == '\\':
                    result = result + "\\"
                elif esc == 'n':
                    result = result + "\n"
                elif esc == 't':
                    result = result + "\t"
                elif esc == 'r':
                    result = result + "\r"
                elif esc == 'b':
                    result = result + codepoint_to_str(0x08)
                elif esc == 'f':
                    result = result + codepoint_to_str(0x0C)
                elif esc == '/':
                    result = result + "/"
                elif esc == 'u':
                    int uni_cp = 0
                    int uni_cnt = 0
                    while uni_cnt < 4 and self.pos < self.input.byte_len():
                        byte uni_hc = self.input.byte_at(self.pos)
                        int uni_hv = -1
                        if uni_hc >= b'0' and uni_hc <= b'9':
                            uni_hv = uni_hc as int - b'0'
                        elif uni_hc >= b'a' and uni_hc <= b'f':
                            uni_hv = uni_hc as int - b'a' + 10
                        elif uni_hc >= b'A' and uni_hc <= b'F':
                            uni_hv = uni_hc as int - b'A' + 10
                        if uni_hv < 0:
                            self.fail("invalid hex digit in unicode escape")
                            return ""
                        uni_cp = uni_cp * 16 + uni_hv
                        self.pos = self.pos + 1
                        uni_cnt = uni_cnt + 1
                    if uni_cnt < 4:
                        self.fail("truncated unicode escape")
                        return ""
                    # Handle UTF-16 surrogate pairs for codepoints > U+FFFF
                    if uni_cp >= 55296 and uni_cp <= 56319:
                        if self.pos + 1 < self.input.byte_len() and self.input.char_at(self.pos) == '\\' and self.input.char_at(self.pos + 1) == 'u':
                            self.pos = self.pos + 2
                            int uni_low = 0
                            int uni_lcnt = 0
                            while uni_lcnt < 4 and self.pos < self.input.byte_len():
                                byte uni_lhc = self.input.byte_at(self.pos)
                                int uni_lhv = -1
                                if uni_lhc >= b'0' and uni_lhc <= b'9':
                                    uni_lhv = uni_lhc as int - b'0'
                                elif uni_lhc >= b'a' and uni_lhc <= b'f':
                                    uni_lhv = uni_lhc as int - b'a' + 10
                                elif uni_lhc >= b'A' and uni_lhc <= b'F':
                                    uni_lhv = uni_lhc as int - b'A' + 10
                                if uni_lhv < 0:
                                    self.fail("invalid hex digit in surrogate pair")
                                    return ""
                                uni_low = uni_low * 16 + uni_lhv
                                self.pos = self.pos + 1
                                uni_lcnt = uni_lcnt + 1
                            if uni_low >= 56320 and uni_low <= 57343:
                                uni_cp = 65536 + (uni_cp - 55296) * 1024 + (uni_low - 56320)
                            else:
                                self.fail("invalid low surrogate in unicode escape pair")
                                return ""
                        else:
                            self.fail("missing low surrogate after high surrogate")
                            return ""
                    elif uni_cp >= 56320 and uni_cp <= 57343:
                        self.fail("unexpected low surrogate")
                        return ""
                    result = result + codepoint_to_str(uni_cp)
                else:
                    # RFC 8259 \xa77: only " \ / b f n r t u may follow '\'.
                    self.fail("invalid escape character")
                    return ""
            else:
                result = result + c
                self.pos = self.pos + 1
        self.fail("unterminated string")
        return ""

    Json parse_number(&self):
        int start = self.pos
        bool is_float = false
        # Optional minus
        if self.pos < self.input.byte_len() and self.input.char_at(self.pos) == '-':
            self.pos = self.pos + 1
        # Integer part — RFC 8259: int = zero / ( digit1-9 *DIGIT )
        # At least one int digit is required (a bare '-' or empty is invalid).
        if self.pos >= self.input.byte_len() or self.input.char_at(self.pos) < '0' or self.input.char_at(self.pos) > '9':
            self.fail("invalid number: missing integer part")
            return Null()
        if self.input.char_at(self.pos) == '0':
            # A leading '0' must not be followed by another digit.
            self.pos = self.pos + 1
            if self.pos < self.input.byte_len() and self.input.char_at(self.pos) >= '0' and self.input.char_at(self.pos) <= '9':
                self.fail("invalid number: leading zero followed by digit")
                return Null()
        else:
            # digit1-9 followed by *DIGIT
            while self.pos < self.input.byte_len() and self.input.char_at(self.pos) >= '0' and self.input.char_at(self.pos) <= '9':
                self.pos = self.pos + 1
        # Fractional part — RFC 8259: frac = '.' 1*DIGIT
        if self.pos < self.input.byte_len() and self.input.char_at(self.pos) == '.':
            is_float = true
            self.pos = self.pos + 1
            # At least one digit required after '.'
            if self.pos >= self.input.byte_len() or self.input.char_at(self.pos) < '0' or self.input.char_at(self.pos) > '9':
                self.fail("invalid number: trailing decimal point")
                return Null()
            while self.pos < self.input.byte_len() and self.input.char_at(self.pos) >= '0' and self.input.char_at(self.pos) <= '9':
                self.pos = self.pos + 1
        # Exponent — RFC 8259: exp = ('e' / 'E') ['+' / '-'] 1*DIGIT
        bool at_e = false
        if self.pos < self.input.byte_len():
            String e_char = self.input.char_at(self.pos)
            if e_char == 'e' or e_char == 'E':
                at_e = true
        if at_e:
            is_float = true
            self.pos = self.pos + 1
            if self.pos < self.input.byte_len():
                String sign_char = self.input.char_at(self.pos)
                if sign_char == '+' or sign_char == '-':
                    self.pos = self.pos + 1
            # At least one digit required after exponent marker.
            if self.pos >= self.input.byte_len() or self.input.char_at(self.pos) < '0' or self.input.char_at(self.pos) > '9':
                self.fail("invalid number: missing exponent digits")
                return Null()
            while self.pos < self.input.byte_len() and self.input.char_at(self.pos) >= '0' and self.input.char_at(self.pos) <= '9':
                self.pos = self.pos + 1
        String num_str = self.input.byte_slice(start, self.pos)
        if is_float:
            float f = parse_float(num_str).unwrap_or(0.0)
            return Float(f)
        int n = parse_int(num_str).unwrap_or(0)
        return Int(n)

    Json parse_array(&self):
        # Skip '['
        self.pos = self.pos + 1
        self.skip_whitespace()
        Vector[Json] items = Vector[Json]()
        if self.pos < self.input.byte_len() and self.input.char_at(self.pos) == ']':
            self.pos = self.pos + 1
            return Arr(items)
        while self.pos < self.input.byte_len():
            Json val = self.parse_value()
            if self.failed():
                return Null()
            items.push(val)
            self.skip_whitespace()
            if self.pos >= self.input.byte_len():
                self.fail("unterminated array")
                return Null()
            if self.input.char_at(self.pos) == ',':
                self.pos = self.pos + 1
            elif self.input.char_at(self.pos) == ']':
                self.pos = self.pos + 1
                return Arr(items)
            else:
                self.fail("expected ',' or ']' in array")
                return Null()
        self.fail("unterminated array")
        return Null()

    Json parse_object(&self):
        # Skip '{'
        self.pos = self.pos + 1
        self.skip_whitespace()
        Dict[String, Json] obj = Dict[String, Json]()
        if self.pos < self.input.byte_len() and self.input.char_at(self.pos) == '}':
            self.pos = self.pos + 1
            return Obj(obj)
        while self.pos < self.input.byte_len():
            self.skip_whitespace()
            if self.pos >= self.input.byte_len() or self.input.char_at(self.pos) != '"':
                self.fail("expected string key in object")
                return Null()
            String key = self.parse_string()
            if self.failed():
                return Null()
            self.skip_whitespace()
            if self.pos >= self.input.byte_len() or self.input.char_at(self.pos) != ':':
                self.fail("expected ':' after key")
                return Null()
            self.pos = self.pos + 1
            Json val = self.parse_value()
            if self.failed():
                return Null()
            obj.put(key, val)
            self.skip_whitespace()
            if self.pos >= self.input.byte_len():
                self.fail("unterminated object")
                return Null()
            if self.input.char_at(self.pos) == ',':
                self.pos = self.pos + 1
            elif self.input.char_at(self.pos) == '}':
                self.pos = self.pos + 1
                return Obj(obj)
            else:
                self.fail("expected ',' or '}' in object")
                return Null()
        self.fail("unterminated object")
        return Null()

    Json parse_keyword(&self):
        if self.pos + 4 <= self.input.byte_len() and self.input.byte_slice(self.pos, self.pos + 4) == "true":
            self.pos = self.pos + 4
            return Bool(true)
        if self.pos + 5 <= self.input.byte_len() and self.input.byte_slice(self.pos, self.pos + 5) == "false":
            self.pos = self.pos + 5
            return Bool(false)
        if self.pos + 4 <= self.input.byte_len() and self.input.byte_slice(self.pos, self.pos + 4) == "null":
            self.pos = self.pos + 4
            return Null()
        self.fail("unexpected keyword")
        return Null()

# ── Public API ───────────────────────────────────────────────

Result[Json, ParseError] json_parse(String input):
    JsonParser p = JsonParser(input, 0, 0, "")
    Json value = p.parse_value()
    if p.failed():
        return Error(ParseError.InvalidSyntax(p.pos, p.err))
    p.skip_whitespace()
    if p.pos < p.input.byte_len():
        return Error(ParseError.InvalidSyntax(p.pos, "unexpected trailing content"))
    return Ok(!value)

# ── Serialization ────────────────────────────────────────────

private String escape_string(String s):
    String result = "\""
    int i = 0
    while i < s.byte_len():
        String c = s.char_at(i)
        if c == '"':
            result = result + "\\\""
        elif c == '\\':
            result = result + "\\\\"
        elif c == '\n':
            result = result + "\\n"
        elif c == '\t':
            result = result + "\\t"
        elif c == '\r':
            result = result + "\\r"
        else:
            result = result + c
        i = i + 1
    return result + "\""

private String make_indent(int depth):
    String result = ""
    int i = 0
    while i < depth:
        result = result + "  "
        i = i + 1
    return result

String json_stringify_internal(Json value, bool pretty, int depth):
    match value:
        case Null():
            return "null"
        case Bool(b):
            if b:
                return "true"
            return "false"
        case Int(n):
            return int_to_str(n)
        case Float(f):
            return float_to_str(f)
        case Str(s):
            return escape_string(s)
        case Arr(items):
            if items.len() == 0:
                return "[]"
            String buf = String()
            buf.push("[")
            if pretty:
                buf.push("\n")
            int idx = 0
            while idx < items.len():
                if idx > 0:
                    buf.push(",")
                    if pretty:
                        buf.push("\n")
                if pretty:
                    buf.push(make_indent(depth + 1))
                buf.push(json_stringify_internal(items.get(idx).unwrap(), pretty, depth + 1))
                idx = idx + 1
            if pretty:
                buf.push("\n")
                buf.push(make_indent(depth))
            buf.push("]")
            return buf
        case Obj(obj_map):
            if obj_map.len() == 0:
                return "\{\}"
            Vector[String] key_list = obj_map.keys()
            String buf = String()
            buf.push("\{")
            if pretty:
                buf.push("\n")
            int idx = 0
            while idx < key_list.len():
                if idx > 0:
                    buf.push(",")
                    if pretty:
                        buf.push("\n")
                if pretty:
                    buf.push(make_indent(depth + 1))
                String key_str = key_list.get(idx).unwrap()
                buf.push(escape_string(key_str))
                if pretty:
                    buf.push(": ")
                else:
                    buf.push(":")
                buf.push(json_stringify_internal(obj_map[key_str], pretty, depth + 1))
                idx = idx + 1
            if pretty:
                buf.push("\n")
                buf.push(make_indent(depth))
            buf.push("\}")
            return buf

String json_stringify(Json value):
    return json_stringify_internal(value, false, 0)

String json_pretty(Json value):
    return json_stringify_internal(value, true, 0)

# ── Accessor methods ─────────────────────────────────────────

equip Json:
    bool has(self, String key):
        match self:
            case Obj(d):
                return d.contains(key)
            else:
                return false

    bool has_index(self, int index):
        match self:
            case Arr(arr):
                return index >= 0 and index < arr.len()
            else:
                return false

    Option[Json] get(&self, String key):
        match self:
            case Obj(d):
                if d.contains(key):
                    return Some(d.get(key).unwrap())
                return None
            else:
                return None

    Option[Json] at(&self, int index):
        match self:
            case Arr(arr):
                if index >= 0 and index < arr.len():
                    return Some(arr.get(index).unwrap())
                return None
            else:
                return None

    String as_str(self):
        match self:
            case Str(s):
                return s
            else:
                return ""

    int as_int(self):
        match self:
            case Int(n):
                return n
            else:
                return 0

    float as_float(self):
        match self:
            case Float(f):
                return f
            case Int(n):
                return n as float
            else:
                return 0.0

    bool as_bool(self):
        match self:
            case Bool(b):
                return b
            else:
                return false

    bool is_null(self):
        match self:
            case Null():
                return true
            else:
                return false

    bool is_object(self):
        match self:
            case Obj(d):
                return true
            else:
                return false

    bool is_array(self):
        match self:
            case Arr(a):
                return true
            else:
                return false

    bool is_string(self):
        match self:
            case Str(s):
                return true
            else:
                return false

    bool is_number(self):
        match self:
            case Int(n):
                return true
            case Float(f):
                return true
            else:
                return false

    bool is_bool(self):
        match self:
            case Bool(b):
                return true
            else:
                return false

    int len(self):
        match self:
            case Arr(arr):
                return arr.len()
            case Obj(d):
                return d.len()
            else:
                return 0

    Vector[String] keys(self):
        match self:
            case Obj(d):
                return d.keys()
            else:
                return Vector[String]()

# ── JSON serializer ─────────────────────────────────────────

struct JsonSerializer:
    String ser_out

equip JsonSerializer with Serializer:
    void write_bool(&self, bool v):
        if v:
            self.ser_out = self.ser_out + "true"
        else:
            self.ser_out = self.ser_out + "false"
    void write_int(&self, int v):
        self.ser_out = self.ser_out + int_to_str(v)
    void write_float(&self, float v):
        self.ser_out = self.ser_out + float_to_str(v)
    void write_str(&self, String v):
        self.ser_out = self.ser_out + escape_string(v)
    void write_null(&self):
        self.ser_out = self.ser_out + "null"
    void begin_struct(&self, String name, int field_count):
        self.ser_out = self.ser_out + "\{"
    void field(&self, String name, int index):
        if index > 0:
            self.ser_out = self.ser_out + ","
        self.ser_out = self.ser_out + escape_string(name) + ":"
    void end_struct(&self):
        self.ser_out = self.ser_out + "\}"
    void begin_seq(&self, int len):
        self.ser_out = self.ser_out + "["
    void elem(&self, int index):
        if index > 0:
            self.ser_out = self.ser_out + ","
    void end_seq(&self):
        self.ser_out = self.ser_out + "]"
    String result(self):
        return self.ser_out
