# gg.p2p — Peer-to-peer networking over UDP
#
# Provides identity (Ed25519), binary wire protocol, peer management,
# and a poll-based event model for P2P communication.
# Supports multicast-based LAN discovery, bootstrap nodes, and DHT.

from std.net.udp import UdpSocket, UdpAddr, UdpPacket, udp_bind
from xtd.crypto import crypto_sha256, crypto_ed25519_keygen, Ed25519KeyPair
from xtd.crypto import crypto_ed25519_sign, crypto_ed25519_verify
from xtd.crypto import crypto_x25519_keygen, crypto_x25519_shared_secret, crypto_x25519_dh, X25519KeyPair
from xtd.crypto import crypto_hkdf_sha256, crypto_aes_gcm_encrypt, crypto_aes_gcm_decrypt
from std.bytes import bytes_from_str, bytes_to_str, bytes_to_hex, bytes_concat, bytes_slice
from std.bytes import bytes_write_u32_be, bytes_read_u32_be, bytes_from_hex
from std.bytes import bytes_write_u16_be, bytes_read_u16_be
from std.collections import Vector
from std.time import time_ms

# ── Peer Identity ────────────────────────────────────────────

struct PeerId:
    Vector[uint8] bytes

struct KeyPair:
    Vector[uint8] public_key
    Vector[uint8] private_key
    PeerId peer_id

String p2p_peer_id_hex(PeerId pid):
    return bytes_to_hex(pid.bytes)

KeyPair p2p_generate_identity():
    Ed25519KeyPair kp = crypto_ed25519_keygen().unwrap()
    Vector[uint8] pub_key = kp.public_key()
    Vector[uint8] priv_key = kp.private_key()
    Vector[uint8] id_hash = crypto_sha256(pub_key)
    return KeyPair(pub_key, priv_key, PeerId(id_hash))

# ── Wire Protocol ────────────────────────────────────────────
# [4B magic "GG01"] [4B total_len] [1B msg_type] [4B nonce] [32B sender_id] [payload...]
# Header = 45 bytes
# msg_type: 1=PING, 2=PONG, 3=DATA, 10=ANNOUNCE,
#           20=FIND_NODE, 21=FIND_NODE_REPLY, 22=STORE,
#           23=FIND_VALUE, 24=FIND_VALUE_REPLY,
#           30=GOSSIP, 31=SUBSCRIBE, 32=UNSUBSCRIBE,
#           40=ADDR_PROBE, 41=ADDR_REPLY,
#           42=HOLE_PUNCH_REQ, 43=HOLE_PUNCH_NOTIFY,
#           44=RELAY_REQUEST, 45=RELAY_DATA,
#           50=RELIABLE_DATA, 51=RELIABLE_ACK,
#           52=RELIABLE_SYN, 53=RELIABLE_SYN_ACK,
#           54=RELIABLE_FIN, 55=RELIABLE_FIN_ACK,
#           56=RELIABLE_KEEPALIVE

struct Message:
    int msg_type
    int nonce
    PeerId sender
    Vector[uint8] payload

# ── Byte helpers ─────────────────────────────────────────────

Vector[uint8] p2p_make_byte(int val):
    Vector[uint8] tmp = bytes_from_hex("00000000")
    bytes_write_u32_be(&tmp, 0, val)
    return bytes_slice(tmp, 3, 4)

Vector[uint8] p2p_make_u32(int val):
    Vector[uint8] buf = bytes_from_hex("00000000")
    bytes_write_u32_be(&buf, 0, val)
    return buf

Vector[uint8] p2p_make_u16(int val):
    Vector[uint8] buf = bytes_from_hex("0000")
    bytes_write_u16_be(&buf, 0, val)
    return buf

# ── Message Encoding ─────────────────────────────────────────

Vector[uint8] p2p_encode_message(int msg_type, int nonce, PeerId self_id, Vector[uint8] payload):
    int total_len = 45 + payload.len()
    Vector[uint8] buf = bytes_from_str("GG01")
    buf = bytes_concat(buf, p2p_make_u32(total_len))
    buf = bytes_concat(buf, p2p_make_byte(msg_type))
    buf = bytes_concat(buf, p2p_make_u32(nonce))
    buf = bytes_concat(buf, self_id.bytes.clone())
    if payload.len() > 0:
        buf = bytes_concat(buf, payload)
    return buf

# ── Announce payload: [2B host_len] [host_bytes] [2B port] ──

Vector[uint8] p2p_encode_announce_payload(String host, int port):
    Vector[uint8] host_bytes = bytes_from_str(host)
    Vector[uint8] buf = p2p_make_u16(host_bytes.len())
    buf = bytes_concat(buf, host_bytes)
    buf = bytes_concat(buf, p2p_make_u16(port))
    return buf

struct AnnounceInfo:
    String host
    int port

Result[AnnounceInfo, String] p2p_decode_announce_payload(Vector[uint8] payload):
    if payload.len() < 4:
        return Error("announce too short")
    int host_len = bytes_read_u16_be(payload, 0)
    if payload.len() < 2 + host_len + 2:
        return Error("announce truncated")
    Vector[uint8] host_bytes = bytes_slice(payload, 2, 2 + host_len)
    String host = bytes_to_str(host_bytes).unwrap()
    int port = bytes_read_u16_be(payload, 2 + host_len)
    return Ok(AnnounceInfo(host.clone(), port))

# ── Message Decoding ─────────────────────────────────────────

Result[Message, String] p2p_decode_message(Vector[uint8] data):
    if data.len() < 45:
        return Error("packet too short")

    # Check magic
    Vector[uint8] magic = bytes_slice(data, 0, 4)
    String magic_str = bytes_to_str(magic).unwrap()
    if magic_str != "GG01":
        return Error("invalid magic")

    int total_len = bytes_read_u32_be(data, 4)
    if data.len() < total_len:
        return Error("truncated packet")

    # msg_type: single byte at offset 8
    uint8 type_byte = data.get(8).unwrap()
    int msg_type = type_byte as int

    int nonce = bytes_read_u32_be(data, 9)
    Vector[uint8] sender_bytes = bytes_slice(data, 13, 45)

    Vector[uint8] payload = Vector[uint8]()
    if total_len > 45:
        payload = bytes_slice(data, 45, total_len)

    return Ok(Message(msg_type, nonce, PeerId(sender_bytes), payload))

# ── Events ───────────────────────────────────────────────────
# event_type: 0=NONE, 1=MESSAGE, 2=PEER_DISCOVERED, 3=PEER_LOST,
#             4=DHT_RESULT, 5=ADDR_DISCOVERED, 6=RELAY_RECEIVED,
#             7=GOSSIP, 8=STREAM_SYN, 9=STREAM_CONNECTED,
#             10=STREAM_DATA, 11=STREAM_CLOSED

struct P2PEvent:
    int event_type
    PeerId peer_id
    Vector[uint8] data
    String topic

P2PEvent p2p_no_event():
    return P2PEvent(0, PeerId(Vector[uint8]()), Vector[uint8](), "")

# ── Peer Info ────────────────────────────────────────────────

struct PeerInfo:
    String peer_hex
    String host
    int port
    int last_seen

# ── DHT Types ───────────────────────────────────────────────

struct DHTEntry:
    String key_hex
    Vector[uint8] value

# ── Gossip Types ────────────────────────────────────────────

struct GossipSeen:
    String msg_id

# ── Reliable Stream Types ───────────────────────────────────

struct SACKBlock:
    int left
    int right

struct SendSegment:
    int seq_num
    Vector[uint8] data
    int send_time_ms
    int retransmit_count
    bool acked

struct RecvSegment:
    int seq_num
    Vector[uint8] data

struct RpcMessage:
    int msg_type           # 1=REQUEST, 2=RESPONSE, 0=none available
    int correlation_id
    Vector[uint8] payload

struct ReliableStream:
    int stream_id
    int remote_stream_id    # peer's local stream ID (0 until SYN-ACK)
    String peer_hex
    int state              # 0=CLOSED, 1=SYN_SENT, 2=SYN_RECEIVED, 3=ESTABLISHED, 4=FIN_WAIT, 5=CLOSE_WAIT, 6=FIN_PENDING, 7=DEAD
    int local_seq
    int local_initial_seq
    int remote_initial_seq
    int remote_seq_acked
    Vector[SendSegment] send_buffer
    Vector[uint8] send_queue
    Vector[RecvSegment] recv_ooo
    Vector[uint8] recv_ready
    int srtt_ms
    int rttvar_ms
    int rto_ms
    int cwnd
    int ssthresh
    int flight_size
    int remote_recv_window
    int local_recv_buf_max
    int last_send_ms
    int syn_send_ms
    int fin_send_ms
    int dup_ack_count
    int last_ack_num
    # Encryption fields (Phase 8)
    bool encrypted
    Vector[uint8] tx_key           # 32-byte AES-256-GCM key (send direction)
    Vector[uint8] rx_key           # 32-byte AES-256-GCM key (recv direction)
    int tx_nonce_counter           # monotonic nonce counter for sending
    int rx_nonce_counter           # expected nonce counter for receiving
    Vector[uint8] local_ephemeral_pub   # our X25519 public key (32 bytes)
    Vector[uint8] local_ephemeral_priv  # our X25519 raw private key (32 bytes, for initiator)
    Vector[uint8] remote_ephemeral_pub  # peer's X25519 public key (32 bytes)
    # Authentication fields (Phase 9)
    bool authenticated
    # Stream maturity fields (Phase 11)
    int keepalive_interval_ms      # send keepalive after this idle time (default 30000)
    int keepalive_timeout_ms       # declare dead after silence this long (default 120000)
    int last_recv_ms               # timestamp of last received packet (0 until first recv)
    Vector[uint8] frame_buf        # accumulated bytes for frame reassembly
    int ca_ack_count               # congestion avoidance: ACKs since last cwnd bump
    # Phase 12: Protocol tags + RPC
    String protocol                   # protocol tag from SYN ("echo/1.0"), "" if none
    int rpc_next_id                # monotonic correlation ID counter (starts at 1)

# ── Discovery Config ─────────────────────────────────────────

struct DiscoveryConfig:
    String multicast_group
    int multicast_port
    int announce_interval_ms

DiscoveryConfig p2p_default_discovery_config():
    return DiscoveryConfig("239.42.0.1", 5354, 5000)

# ── Node ─────────────────────────────────────────────────────

struct Node:
    UdpSocket socket
    KeyPair identity
    Vector[PeerInfo] peers
    int next_nonce
    UdpSocket disc_socket
    bool disc_enabled
    int last_announce
    int announce_interval
    String disc_group
    int disc_port
    Vector[DHTEntry] dht_store
    Vector[String] subscriptions
    Vector[GossipSeen] seen_msgs
    Vector[ReliableStream] streams
    int next_stream_id

Result[Node, String] p2p_create_node(String bind_addr, int bind_port):
    Result[UdpSocket, String] sock_result = udp_bind(bind_addr, bind_port)
    if sock_result.is_error():
        return Error(sock_result.unwrap_error())
    UdpSocket sock = sock_result.unwrap()
    KeyPair ident = p2p_generate_identity()
    Vector[PeerInfo] peers = Vector[PeerInfo]()
    Vector[DHTEntry] store = Vector[DHTEntry]()
    Vector[String] subs = Vector[String]()
    Vector[GossipSeen] seen = Vector[GossipSeen]()
    # Create a placeholder discovery socket (unused until discovery enabled)
    UdpSocket disc_sock = udp_bind("0.0.0.0", 0).unwrap()
    Vector[ReliableStream] streams = Vector[ReliableStream]()
    return Ok(Node(sock, ident, peers, 0, disc_sock, false, 0, 5000, "", 0, store, subs, seen, streams, 0))

# ── Peer lookup helpers ──────────────────────────────────────

int p2p_find_peer(Node node, String hex):
    int i = 0
    while i < node.peers.len():
        auto pi = node.peers.get(i).unwrap()
        if pi.peer_hex == hex:
            return i
        i = i + 1
    return -1

# ── Send ─────────────────────────────────────────────────────

Result[bool, String] p2p_send_raw(Node &node, String host, int port, int msg_type, Vector[uint8] payload):
    int nonce = node.next_nonce
    node.next_nonce = node.next_nonce + 1
    Vector[uint8] packet = p2p_encode_message(msg_type, nonce, node.identity.peer_id, payload)
    Result[int, String] send_result = node.socket.sendto(packet, host, port)
    if send_result.is_error():
        return Error(send_result.unwrap_error())
    return Ok(true)

Result[bool, String] p2p_send_to_peer(Node &node, PeerId target, int msg_type, Vector[uint8] payload):
    String target_hex = p2p_peer_id_hex(target)
    int idx = p2p_find_peer(node, target_hex)
    if idx < 0:
        return Error("unknown peer")
    auto found = node.peers.get(idx).unwrap()
    return p2p_send_raw(&node, found.host, found.port, msg_type, payload)

Result[bool, String] p2p_send(Node &node, PeerId target, Vector[uint8] data):
    return p2p_send_to_peer(&node, target, 3, data)

# ── Add Peer ─────────────────────────────────────────────────

Result[bool, String] p2p_add_peer(Node &node, String host, int port):
    return p2p_send_raw(&node, host, port, 1, Vector[uint8]())

# ── Update peer table ────────────────────────────────────────

void p2p_update_peer(Node &node, String hex, String host, int port):
    int idx = p2p_find_peer(node, hex)
    if idx < 0:
        int now = time_ms()
        PeerInfo new_pi = PeerInfo(hex, host, port, now)
        node.peers.push(!new_pi)

# ── Discovery ────────────────────────────────────────────────

void p2p_send_announce(Node &node):
    UdpAddr addr = node.socket.local_addr()
    Vector[uint8] payload = p2p_encode_announce_payload(addr.host, addr.port)
    int nonce = node.next_nonce
    node.next_nonce = node.next_nonce + 1
    Vector[uint8] packet = p2p_encode_message(10, nonce, node.identity.peer_id, payload)
    node.disc_socket.sendto(packet, node.disc_group, node.disc_port)
    node.last_announce = time_ms()

Result[bool, String] p2p_enable_discovery(Node &node, DiscoveryConfig config):
    # Close the placeholder discovery socket
    node.disc_socket.close()
    # Create a new one bound to the multicast port
    auto ds = udp_bind("0.0.0.0", config.multicast_port)
    if ds.is_error():
        return Error(ds.unwrap_error())
    node.disc_socket = ds.unwrap()
    node.disc_socket.set_multicast_loopback(true)
    auto join = node.disc_socket.join_multicast(config.multicast_group)
    if join.is_error():
        return Error(join.unwrap_error().clone())
    node.disc_enabled = true
    node.disc_group = config.multicast_group
    node.disc_port = config.multicast_port
    node.announce_interval = config.announce_interval_ms
    # Send initial announcement
    p2p_send_announce(&node)
    return Ok(true)

Result[bool, String] p2p_bootstrap(Node &node, Vector[String] addrs):
    int i = 0
    while i < addrs.len():
        String addr_str = addrs.get(i).unwrap()
        # Parse "host:port" — find last colon
        int colon = -1
        int j = 0
        while j < addr_str.byte_len():
            if addr_str.char_at(j) == ':':
                colon = j
            j = j + 1
        if colon > 0:
            String host = addr_str.byte_slice(0, colon)
            String port_str = addr_str.byte_slice(colon + 1, addr_str.byte_len())
            int port = 0
            int k = 0
            while k < port_str.byte_len():
                int d = port_str.byte_at(k) as int - 48
                port = port * 10 + d
                k = k + 1
            p2p_send_raw(&node, host, port, 1, Vector[uint8]())
        i = i + 1
    return Ok(true)

# ── Evict stale peers ────────────────────────────────────────

void p2p_evict_stale(Node &node, int max_age_ms):
    int now = time_ms()
    int i = node.peers.len() - 1
    while i >= 0:
        auto pi = node.peers.get(i).unwrap()
        int age = now - pi.last_seen
        if age > max_age_ms:
            node.peers.remove(i)
        i = i - 1

# ── DHT: XOR Distance ──────────────────────────────────────

Vector[uint8] p2p_xor_distance(PeerId a, PeerId b):
    int alen = a.bytes.len()
    int blen = b.bytes.len()
    int dlen = alen
    if blen < dlen:
        dlen = blen
    Vector[uint8] result = Vector[uint8]()
    int i = 0
    while i < dlen:
        uint8 ab = a.bytes.get(i).unwrap()
        uint8 bb = b.bytes.get(i).unwrap()
        int xval = ab as int ^ bb as int
        result.push(xval as uint8)
        i = i + 1
    return result

int p2p_xor_compare(Vector[uint8] d1, Vector[uint8] d2):
    int i = 0
    while i < d1.len():
        uint8 a = d1.get(i).unwrap()
        uint8 b = d2.get(i).unwrap()
        if a as int < b as int:
            return -1
        if a as int > b as int:
            return 1
        i = i + 1
    return 0

# ── DHT: Local Store ──────────────────────────────────────

int p2p_dht_find_local(Node node, String key_hex):
    int i = 0
    while i < node.dht_store.len():
        auto entry = node.dht_store.get(i).unwrap()
        if entry.key_hex == key_hex:
            return i
        i = i + 1
    return -1

void p2p_dht_put_local(Node &node, String key_hex, Vector[uint8] value):
    int idx = p2p_dht_find_local(node, key_hex)
    if idx >= 0:
        node.dht_store.remove(idx)
    # Make an independent copy so the caller's free doesn't corrupt our entry
    Vector[uint8] val_copy = bytes_slice(value, 0, value.len())
    DHTEntry entry = DHTEntry(key_hex, val_copy)
    node.dht_store.push(!entry)

Result[Vector[uint8], String] p2p_dht_local_get(Node node, String key_hex):
    int idx = p2p_dht_find_local(node, key_hex)
    if idx < 0:
        return Error("not found")
    auto entry = node.dht_store.get(idx).unwrap()
    # Return an independent copy to avoid aliasing the stored entry
    return Ok(bytes_slice(entry.value, 0, entry.value.len()))

# ── DHT: Store & Get ──────────────────────────────────────

# STORE payload: [32B key_hash] [value_bytes]
Vector[uint8] p2p_encode_store_payload(Vector[uint8] key, Vector[uint8] value):
    return bytes_concat(key, value)

# FIND_VALUE payload: [32B key_hash]
# FIND_VALUE_REPLY payload: [1B found] [value_bytes if found=1]

void p2p_dht_store(Node &node, Vector[uint8] key, Vector[uint8] value):
    String key_hex = bytes_to_hex(key)
    p2p_dht_put_local(&node, key_hex, value)
    # Broadcast STORE to all known peers
    Vector[uint8] payload = p2p_encode_store_payload(key, value)
    int i = 0
    while i < node.peers.len():
        auto pi = node.peers.get(i).unwrap()
        p2p_send_raw(&node, pi.host, pi.port, 22, payload)
        i = i + 1

Result[Vector[uint8], String] p2p_dht_get(Node &node, Vector[uint8] key, int timeout_ms):
    # Check local store first
    String key_hex = bytes_to_hex(key)
    int local_idx = p2p_dht_find_local(node, key_hex)
    if local_idx >= 0:
        auto entry = node.dht_store.get(local_idx).unwrap()
        return Ok(entry.value.clone())
    # Send FIND_VALUE to all known peers
    int i = 0
    while i < node.peers.len():
        auto pi = node.peers.get(i).unwrap()
        p2p_send_raw(&node, pi.host, pi.port, 23, key)
        i = i + 1
    # Poll until we get a FIND_VALUE_REPLY or timeout
    int start = time_ms()
    while time_ms() - start < timeout_ms:
        int remaining = timeout_ms - time_ms() + start
        if remaining < 1:
            remaining = 1
        P2PEvent ev = p2p_poll(&node, remaining)
        # event_type 4 = DHT_RESULT
        if ev.event_type == 4:
            return Ok(ev.data)
    return Error("dht get timeout")

# ── NAT Hole Punching ─────────────────────────────────────

struct ExternalAddr:
    String host
    int port

# ADDR_PROBE (40): ask a peer to reflect our external address
# ADDR_REPLY (41): payload = [2B host_len] [host_bytes] [2B port]
# HOLE_PUNCH_REQ (42): ask rendezvous to introduce us to a target
#   payload = [32B target_peer_id] [2B our_ext_host_len] [our_ext_host] [2B our_ext_port]
# HOLE_PUNCH_NOTIFY (43): rendezvous tells target to punch toward initiator
#   payload = [32B initiator_peer_id] [2B ext_host_len] [ext_host] [2B ext_port]
# RELAY_REQUEST (44): ask a peer to relay data to a target
#   payload = [32B target_peer_id] [relay_data]
# RELAY_DATA (45): relayed data arriving
#   payload = [32B original_sender_peer_id] [data]

Result[ExternalAddr, String] p2p_discover_external_addr(Node &node, String probe_host, int probe_port, int timeout_ms):
    # Send ADDR_PROBE to the specified peer
    p2p_send_raw(&node, probe_host, probe_port, 40, Vector[uint8]())
    # Poll until we get an ADDR_REPLY
    int start = time_ms()
    while time_ms() - start < timeout_ms:
        int remaining = timeout_ms - time_ms() + start
        if remaining < 1:
            remaining = 1
        P2PEvent ev = p2p_poll(&node, remaining)
        # event_type 5 = ADDR_DISCOVERED
        if ev.event_type == 5:
            String addr_str = bytes_to_str(ev.data).unwrap()
            # Parse "host:port"
            int colon = -1
            int j = 0
            while j < addr_str.byte_len():
                if addr_str.char_at(j) == ':':
                    colon = j
                j = j + 1
            if colon > 0:
                String ext_host = addr_str.byte_slice(0, colon)
                String port_str = addr_str.byte_slice(colon + 1, addr_str.byte_len())
                int ext_port = 0
                int k = 0
                while k < port_str.byte_len():
                    int d = port_str.byte_at(k) as int - 48
                    ext_port = ext_port * 10 + d
                    k = k + 1
                return Ok(ExternalAddr(ext_host, ext_port))
    return Error("addr probe timeout")

Result[bool, String] p2p_hole_punch(Node &node, PeerId target, PeerId rendezvous, ExternalAddr our_ext):
    # Ask rendezvous to notify target about us
    # payload: [32B target_id] [2B host_len] [host_bytes] [2B port]
    Vector[uint8] payload = target.bytes
    Vector[uint8] addr_payload = p2p_encode_announce_payload(our_ext.host, our_ext.port)
    payload = bytes_concat(payload, addr_payload)
    p2p_send_to_peer(&node, rendezvous, 42, payload)
    # Also start sending probes directly to target's known address
    # (if we know it from the peer table)
    return Ok(true)

Result[bool, String] p2p_request_relay(Node &node, PeerId relay_peer, PeerId target, Vector[uint8] data):
    # payload: [32B target_peer_id] [data]
    Vector[uint8] payload = bytes_concat(target.bytes, data)
    return p2p_send_to_peer(&node, relay_peer, 44, payload)

# ── Gossip / PubSub ───────────────────────────────────────

bool p2p_is_subscribed(Node node, String topic):
    int i = 0
    while i < node.subscriptions.len():
        String sub = node.subscriptions.get(i).unwrap()
        if sub == topic:
            return true
        i = i + 1
    return false

void p2p_subscribe(Node &node, String topic):
    if not p2p_is_subscribed(node, topic):
        node.subscriptions.push(topic)

void p2p_unsubscribe(Node &node, String topic):
    int i = node.subscriptions.len() - 1
    while i >= 0:
        String sub = node.subscriptions.get(i).unwrap()
        if sub == topic:
            node.subscriptions.remove(i)
            return
        i = i - 1

bool p2p_has_seen(Node node, String msg_id):
    int i = 0
    while i < node.seen_msgs.len():
        auto gs = node.seen_msgs.get(i).unwrap()
        if gs.msg_id == msg_id:
            return true
        i = i + 1
    return false

void p2p_mark_seen(Node &node, String msg_id):
    GossipSeen gs = GossipSeen(msg_id)
    node.seen_msgs.push(!gs)

# GOSSIP payload: [1B ttl] [2B topic_len] [topic_bytes] [32B msg_id_hash] [data]

Vector[uint8] p2p_encode_gossip(int ttl, String topic, Vector[uint8] msg_id, Vector[uint8] data):
    Vector[uint8] buf = p2p_make_byte(ttl)
    Vector[uint8] topic_bytes = bytes_from_str(topic)
    buf = bytes_concat(buf, p2p_make_u16(topic_bytes.len()))
    buf = bytes_concat(buf, topic_bytes)
    buf = bytes_concat(buf, msg_id)
    buf = bytes_concat(buf, data)
    return buf

void p2p_publish(Node &node, String topic, Vector[uint8] data):
    # Generate a unique message ID from sender + nonce hash
    Vector[uint8] id_seed = bytes_concat(node.identity.peer_id.bytes, p2p_make_u32(node.next_nonce))
    Vector[uint8] msg_id = crypto_sha256(id_seed)
    String msg_id_hex = bytes_to_hex(msg_id)
    p2p_mark_seen(&node, msg_id_hex)
    # Encode gossip payload with TTL=7
    Vector[uint8] payload = p2p_encode_gossip(7, topic, msg_id, data)
    # Send to all known peers
    int i = 0
    while i < node.peers.len():
        auto pi = node.peers.get(i).unwrap()
        p2p_send_raw(&node, pi.host, pi.port, 30, payload)
        i = i + 1

# ── Reliable Streams ────────────────────────────────────────
# Each stream is identified by a (local_id, remote_id) pair.
# After handshake, all packets carry (receiver_sid, sender_sid).
# MSS = 1196 bytes plain, 1168 encrypted (fits in IPv6 min MTU with GG01 header + dual IDs)
# msg_type 50=RELIABLE_DATA, 51=RELIABLE_ACK, 52=RELIABLE_SYN,
#          53=RELIABLE_SYN_ACK, 54=RELIABLE_FIN, 55=RELIABLE_FIN_ACK

ReliableStream p2p_new_stream(int stream_id, int remote_stream_id, String peer_hex, int initial_state):
    int now = time_ms()
    return ReliableStream(
        stream_id, remote_stream_id, peer_hex.clone(), initial_state,
        0, 0, 0, 0,
        Vector[SendSegment](), Vector[uint8](), Vector[RecvSegment](), Vector[uint8](),
        0, 0, 1000,
        1, 64, 0,
        262144, 262144,
        now, 0, 0, 0, 0,
        false, Vector[uint8](), Vector[uint8](), 0, 0,
        Vector[uint8](), Vector[uint8](), Vector[uint8](),
        false,
        30000, 120000, 0, Vector[uint8](), 0,
        "", 1
    )

int p2p_find_stream(Node &node, int stream_id):
    int i = 0
    while i < node.streams.len():
        auto s = node.streams.get(i).unwrap()
        if s.stream_id == stream_id:
            return i
        i = i + 1
    return -1

# ── Payload encode/decode ──────────────────────────────────

# RELIABLE_SYN (52): [4B initiator_sid] [4B initial_seq] [1B flags] [32B pubkey if flags & 0x01]
Vector[uint8] p2p_encode_syn_payload(int stream_id, int initial_seq):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(0))
    return buf

Vector[uint8] p2p_encode_syn_encrypted_payload(int stream_id, int initial_seq, Vector[uint8] pubkey):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(1))
    buf = bytes_concat(buf, pubkey)
    return buf

# Authenticated SYN: [4B stream_id] [4B initial_seq] [1B flags=0x03] [32B X25519] [32B Ed25519] [64B sig]
Vector[uint8] p2p_encode_syn_auth_payload(int stream_id, int initial_seq, Vector[uint8] ephemeral_pub, Vector[uint8] ed25519_pub, Vector[uint8] signature):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(3))
    buf = bytes_concat(buf, ephemeral_pub)
    buf = bytes_concat(buf, ed25519_pub)
    buf = bytes_concat(buf, signature)
    return buf

# Protocol-tagged SYN encoders: append [2B proto_len][proto_bytes] after base payload
# Flags 0x04 = protocol tag present
Vector[uint8] p2p_encode_syn_protocol_payload(int stream_id, int initial_seq, String protocol):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(4))
    Vector[uint8] proto_bytes = bytes_from_str(protocol)
    buf = bytes_concat(buf, p2p_make_u16(proto_bytes.len()))
    buf = bytes_concat(buf, proto_bytes)
    return buf

Vector[uint8] p2p_encode_syn_encrypted_protocol_payload(int stream_id, int initial_seq, Vector[uint8] pubkey, String protocol):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(5))
    buf = bytes_concat(buf, pubkey)
    Vector[uint8] proto_bytes = bytes_from_str(protocol)
    buf = bytes_concat(buf, p2p_make_u16(proto_bytes.len()))
    buf = bytes_concat(buf, proto_bytes)
    return buf

Vector[uint8] p2p_encode_syn_auth_protocol_payload(int stream_id, int initial_seq, Vector[uint8] ephemeral_pub, Vector[uint8] ed25519_pub, Vector[uint8] signature, String protocol):
    Vector[uint8] buf = p2p_make_u32(stream_id)
    buf = bytes_concat(buf, p2p_make_u32(initial_seq))
    buf = bytes_concat(buf, p2p_make_byte(7))
    buf = bytes_concat(buf, ephemeral_pub)
    buf = bytes_concat(buf, ed25519_pub)
    buf = bytes_concat(buf, signature)
    Vector[uint8] proto_bytes = bytes_from_str(protocol)
    buf = bytes_concat(buf, p2p_make_u16(proto_bytes.len()))
    buf = bytes_concat(buf, proto_bytes)
    return buf

# RELIABLE_SYN_ACK (53): [4B responder_sid] [4B initiator_sid] [4B responder_isn] [4B ack_isn] [1B flags] [32B pubkey if flags & 0x01]
Vector[uint8] p2p_encode_syn_ack_payload(int responder_sid, int initiator_sid, int responder_isn, int ack_isn):
    Vector[uint8] buf = p2p_make_u32(responder_sid)
    buf = bytes_concat(buf, p2p_make_u32(initiator_sid))
    buf = bytes_concat(buf, p2p_make_u32(responder_isn))
    buf = bytes_concat(buf, p2p_make_u32(ack_isn))
    buf = bytes_concat(buf, p2p_make_byte(0))
    return buf

Vector[uint8] p2p_encode_syn_ack_encrypted_payload(int responder_sid, int initiator_sid, int responder_isn, int ack_isn, Vector[uint8] pubkey):
    Vector[uint8] buf = p2p_make_u32(responder_sid)
    buf = bytes_concat(buf, p2p_make_u32(initiator_sid))
    buf = bytes_concat(buf, p2p_make_u32(responder_isn))
    buf = bytes_concat(buf, p2p_make_u32(ack_isn))
    buf = bytes_concat(buf, p2p_make_byte(1))
    buf = bytes_concat(buf, pubkey)
    return buf

# Authenticated SYN-ACK: [4B responder_sid] [4B initiator_sid] [4B responder_isn] [4B ack_isn] [1B flags=0x03] [32B X25519] [32B Ed25519] [64B sig]
Vector[uint8] p2p_encode_syn_ack_auth_payload(int responder_sid, int initiator_sid, int responder_isn, int ack_isn, Vector[uint8] ephemeral_pub, Vector[uint8] ed25519_pub, Vector[uint8] signature):
    Vector[uint8] buf = p2p_make_u32(responder_sid)
    buf = bytes_concat(buf, p2p_make_u32(initiator_sid))
    buf = bytes_concat(buf, p2p_make_u32(responder_isn))
    buf = bytes_concat(buf, p2p_make_u32(ack_isn))
    buf = bytes_concat(buf, p2p_make_byte(3))
    buf = bytes_concat(buf, ephemeral_pub)
    buf = bytes_concat(buf, ed25519_pub)
    buf = bytes_concat(buf, signature)
    return buf

# RELIABLE_DATA (50): [4B receiver_sid] [4B sender_sid] [4B seq_num] [data...]
Vector[uint8] p2p_encode_data_payload(int receiver_sid, int sender_sid, int seq_num, Vector[uint8] data):
    Vector[uint8] buf = p2p_make_u32(receiver_sid)
    buf = bytes_concat(buf, p2p_make_u32(sender_sid))
    buf = bytes_concat(buf, p2p_make_u32(seq_num))
    buf = bytes_concat(buf, data)
    return buf

# RELIABLE_ACK (51): [4B receiver_sid] [4B sender_sid] [4B cum_ack] [4B recv_window] [1B num_sacks] [8B*N sack_blocks]
Vector[uint8] p2p_encode_ack_payload(int receiver_sid, int sender_sid, int cum_ack, int recv_window, Vector[SACKBlock] sacks):
    Vector[uint8] buf = p2p_make_u32(receiver_sid)
    buf = bytes_concat(buf, p2p_make_u32(sender_sid))
    buf = bytes_concat(buf, p2p_make_u32(cum_ack))
    buf = bytes_concat(buf, p2p_make_u32(recv_window))
    int num_sacks = sacks.len()
    if num_sacks > 4:
        num_sacks = 4
    buf = bytes_concat(buf, p2p_make_byte(num_sacks))
    int i = 0
    while i < num_sacks:
        SACKBlock sb = sacks.get(i).unwrap()
        buf = bytes_concat(buf, p2p_make_u32(sb.left))
        buf = bytes_concat(buf, p2p_make_u32(sb.right))
        i = i + 1
    return buf

# RELIABLE_FIN (54): [4B receiver_sid] [4B sender_sid] [4B final_seq]
Vector[uint8] p2p_encode_fin_payload(int receiver_sid, int sender_sid, int final_seq):
    Vector[uint8] buf = p2p_make_u32(receiver_sid)
    buf = bytes_concat(buf, p2p_make_u32(sender_sid))
    buf = bytes_concat(buf, p2p_make_u32(final_seq))
    return buf

# RELIABLE_FIN_ACK (55): [4B receiver_sid] [4B sender_sid] [4B ack_seq]
Vector[uint8] p2p_encode_fin_ack_payload(int receiver_sid, int sender_sid, int ack_seq):
    Vector[uint8] buf = p2p_make_u32(receiver_sid)
    buf = bytes_concat(buf, p2p_make_u32(sender_sid))
    buf = bytes_concat(buf, p2p_make_u32(ack_seq))
    return buf

# RELIABLE_KEEPALIVE (56): [4B receiver_sid] [4B sender_sid]
Vector[uint8] p2p_encode_keepalive_payload(int receiver_sid, int sender_sid):
    Vector[uint8] buf = p2p_make_u32(receiver_sid)
    buf = bytes_concat(buf, p2p_make_u32(sender_sid))
    return buf

void p2p_handle_keepalive(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 8:
        return
    int receiver_sid = bytes_read_u32_be(payload, 0)
    int sidx = p2p_find_stream(&node, receiver_sid)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    s.last_recv_ms = time_ms()
    node.streams.push(!s)

# Decode stream_id from any reliable payload (first 4 bytes)
int p2p_decode_stream_id(Vector[uint8] payload):
    return bytes_read_u32_be(payload, 0)

# ── Encryption helpers ─────────────────────────────────────

# Build a 12-byte nonce: [8 zero bytes] [4-byte big-endian counter]
Vector[uint8] p2p_make_nonce(int counter):
    Vector[uint8] n = Vector[uint8]()
    int i = 0
    while i < 8:
        n.push(0 as uint8)
        i = i + 1
    n = bytes_concat(n, p2p_make_u32(counter))
    return n

# Derive tx/rx keys from X25519 shared secret
# is_initiator: true for the side that called p2p_stream_open_encrypted
# Returns (tx_key, rx_key) packed as a 64-byte vector: first 32 = tx, last 32 = rx
Vector[uint8] p2p_derive_stream_keys(Vector[uint8] shared_secret, bool is_initiator):
    Vector[uint8] salt = bytes_from_str("gorget-p2p-v1")
    Vector[uint8] info = bytes_from_str("gorget-p2p-stream")
    Vector[uint8] key_material = crypto_hkdf_sha256(salt, shared_secret, info, 64).unwrap()
    # First 32 bytes = initiator→responder key
    # Last 32 bytes = responder→initiator key
    if is_initiator:
        return key_material
    # Responder: swap halves (tx = second half, rx = first half)
    Vector[uint8] swapped = bytes_slice(key_material, 32, 64)
    swapped = bytes_concat(swapped, bytes_slice(key_material, 0, 32))
    return swapped

# ── Stream send helper ─────────────────────────────────────

void p2p_stream_send_raw(Node &node, String peer_hex, int msg_type, Vector[uint8] payload):
    int idx = p2p_find_peer(node, peer_hex)
    if idx >= 0:
        auto pi = node.peers.get(idx).unwrap()
        p2p_send_raw(&node, pi.host, pi.port, msg_type, payload)

# ── Handshake ──────────────────────────────────────────────

Result[int, String] p2p_stream_open(Node &node, String peer_hex):
    int idx = p2p_find_peer(node, peer_hex)
    if idx < 0:
        return Error("unknown peer")
    int sid = node.next_stream_id
    node.next_stream_id = node.next_stream_id + 1
    ReliableStream s = p2p_new_stream(sid, 0, peer_hex, 1)
    s.local_seq = 1
    s.local_initial_seq = 0
    s.syn_send_ms = time_ms()
    node.streams.push(!s)
    # Send SYN
    Vector[uint8] payload = p2p_encode_syn_payload(sid, 0)
    auto pi = node.peers.get(idx).unwrap()
    p2p_send_raw(&node, pi.host, pi.port, 52, payload)
    return Ok(sid)

Result[int, String] p2p_stream_open_encrypted(Node &node, String peer_hex):
    int idx = p2p_find_peer(node, peer_hex)
    if idx < 0:
        return Error("unknown peer")
    int sid = node.next_stream_id
    node.next_stream_id = node.next_stream_id + 1
    # Generate ephemeral X25519 keypair for this stream
    X25519KeyPair ekp = crypto_x25519_keygen().unwrap()
    Vector[uint8] epub = ekp.public_key()
    Vector[uint8] epriv = ekp.private_key()
    ReliableStream s = p2p_new_stream(sid, 0, peer_hex, 1)
    s.local_seq = 1
    s.local_initial_seq = 0
    s.syn_send_ms = time_ms()
    s.encrypted = true
    s.authenticated = true
    s.local_ephemeral_pub = bytes_slice(epub, 0, epub.len())
    s.local_ephemeral_priv = bytes_slice(epriv, 0, epriv.len())
    node.streams.push(!s)
    # Sign ephemeral X25519 public key with our Ed25519 identity key
    Vector[uint8] sig = crypto_ed25519_sign(node.identity.private_key, epub).unwrap()
    # Send authenticated SYN (flags=0x03): ephemeral + Ed25519 pubkey + signature
    Vector[uint8] payload = p2p_encode_syn_auth_payload(sid, 0, epub, node.identity.public_key, sig)
    auto pi = node.peers.get(idx).unwrap()
    p2p_send_raw(&node, pi.host, pi.port, 52, payload)
    return Ok(sid)

# ── Protocol-tagged stream open ──────────────────────────

Result[int, String] p2p_stream_open_protocol(Node &node, String peer_hex, String protocol):
    int idx = p2p_find_peer(node, peer_hex)
    if idx < 0:
        return Error("unknown peer")
    int sid = node.next_stream_id
    node.next_stream_id = node.next_stream_id + 1
    ReliableStream s = p2p_new_stream(sid, 0, peer_hex, 1)
    s.local_seq = 1
    s.local_initial_seq = 0
    s.syn_send_ms = time_ms()
    s.protocol = protocol.clone()
    node.streams.push(!s)
    # Send SYN with protocol tag
    Vector[uint8] payload = p2p_encode_syn_protocol_payload(sid, 0, protocol)
    auto pi = node.peers.get(idx).unwrap()
    p2p_send_raw(&node, pi.host, pi.port, 52, payload)
    return Ok(sid)

Result[int, String] p2p_stream_open_encrypted_protocol(Node &node, String peer_hex, String protocol):
    int idx = p2p_find_peer(node, peer_hex)
    if idx < 0:
        return Error("unknown peer")
    int sid = node.next_stream_id
    node.next_stream_id = node.next_stream_id + 1
    X25519KeyPair ekp = crypto_x25519_keygen().unwrap()
    Vector[uint8] epub = ekp.public_key()
    Vector[uint8] epriv = ekp.private_key()
    ReliableStream s = p2p_new_stream(sid, 0, peer_hex, 1)
    s.local_seq = 1
    s.local_initial_seq = 0
    s.syn_send_ms = time_ms()
    s.encrypted = true
    s.authenticated = true
    s.local_ephemeral_pub = bytes_slice(epub, 0, epub.len())
    s.local_ephemeral_priv = bytes_slice(epriv, 0, epriv.len())
    s.protocol = protocol.clone()
    node.streams.push(!s)
    Vector[uint8] sig = crypto_ed25519_sign(node.identity.private_key, epub).unwrap()
    Vector[uint8] payload = p2p_encode_syn_auth_protocol_payload(sid, 0, epub, node.identity.public_key, sig, protocol)
    auto pi = node.peers.get(idx).unwrap()
    p2p_send_raw(&node, pi.host, pi.port, 52, payload)
    return Ok(sid)

String p2p_stream_protocol(Node node, int stream_id):
    int i = 0
    while i < node.streams.len():
        auto s = node.streams.get(i).unwrap()
        if s.stream_id == stream_id:
            return s.protocol.clone()
        i = i + 1
    return ""

bool p2p_stream_is_encrypted(Node node, int stream_id):
    int i = 0
    while i < node.streams.len():
        auto s = node.streams.get(i).unwrap()
        if s.stream_id == stream_id:
            return s.encrypted
        i = i + 1
    return false

bool p2p_stream_is_authenticated(Node node, int stream_id):
    int i = 0
    while i < node.streams.len():
        auto s = node.streams.get(i).unwrap()
        if s.stream_id == stream_id:
            return s.authenticated
        i = i + 1
    return false

void p2p_stream_accept(Node &node, int stream_id):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 2:
        node.streams.push(!s)
        return
    s.state = 3
    s.last_recv_ms = time_ms()
    s.local_seq = 1
    s.local_initial_seq = 0
    auto peer = s.peer_hex
    int remote_isn = s.remote_initial_seq
    int sid = s.stream_id
    int remote_sid = s.remote_stream_id
    bool is_enc = s.encrypted
    bool is_auth = s.authenticated
    Vector[uint8] our_pub = bytes_slice(s.local_ephemeral_pub, 0, s.local_ephemeral_pub.len())
    # Send SYN-ACK with both IDs: (our sid, initiator's remote_sid)
    if is_auth:
        # Authenticated: sign our ephemeral key and include Ed25519 pubkey
        Vector[uint8] sig = crypto_ed25519_sign(node.identity.private_key, our_pub).unwrap()
        Vector[uint8] payload = p2p_encode_syn_ack_auth_payload(sid, remote_sid, 0, remote_isn + 1, our_pub, node.identity.public_key, sig)
        p2p_stream_send_raw(&node, peer.clone(), 53, payload)
    elif is_enc:
        # Encrypted only (no auth)
        Vector[uint8] payload = p2p_encode_syn_ack_encrypted_payload(sid, remote_sid, 0, remote_isn + 1, our_pub)
        p2p_stream_send_raw(&node, peer.clone(), 53, payload)
    else:
        Vector[uint8] payload = p2p_encode_syn_ack_payload(sid, remote_sid, 0, remote_isn + 1)
        p2p_stream_send_raw(&node, peer.clone(), 53, payload)
    node.streams.push(!s)

void p2p_stream_close(Node &node, int stream_id):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 3:
        node.streams.push(!s)
        return
    if s.send_queue.len() == 0:
        # All data segmented — send FIN immediately (in-flight data will be retransmitted normally)
        s.state = 4
        s.fin_send_ms = time_ms()
        auto peer = s.peer_hex
        int final_seq = s.local_seq
        int sid = s.stream_id
        int remote_sid = s.remote_stream_id
        Vector[uint8] payload = p2p_encode_fin_payload(remote_sid, sid, final_seq)
        p2p_stream_send_raw(&node, peer.clone(), 54, payload)
        node.streams.push(!s)
    else:
        # Unsegmented data remains — defer FIN until send_queue drained
        s.state = 6
        node.streams.push(!s)

# ── Handle incoming SYN (52) ──────────────────────────────

P2PEvent p2p_handle_syn(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 8:
        return p2p_no_event()
    int initiator_sid = bytes_read_u32_be(payload, 0)
    int initial_seq = bytes_read_u32_be(payload, 4)
    # Duplicate SYN detection: same (peer_hex, remote_stream_id) pair
    int di = 0
    while di < node.streams.len():
        auto ds = node.streams.get(di).unwrap()
        if ds.peer_hex == sender_hex and ds.remote_stream_id == initiator_sid:
            return p2p_no_event()
        di = di + 1
    # Assign our own local stream ID (independent from initiator's)
    int local_sid = node.next_stream_id
    node.next_stream_id = node.next_stream_id + 1
    # Create stream with our local ID, store initiator's as remote_stream_id
    ReliableStream s = p2p_new_stream(local_sid, initiator_sid, sender_hex, 2)
    s.remote_initial_seq = initial_seq
    s.remote_seq_acked = initial_seq + 1
    # Check flags byte at offset 8
    if payload.len() >= 9:
        uint8 flags = payload.get(8).unwrap()
        int flags_int = flags as int
        int enc_bit = flags_int & 1
        int auth_bit = flags_int & 2
        if enc_bit == 1 and auth_bit == 2 and payload.len() >= 137:
            # Authenticated + encrypted: [9..41] X25519, [41..73] Ed25519, [73..137] signature
            Vector[uint8] ephemeral_pub = bytes_slice(payload, 9, 41)
            Vector[uint8] ed25519_pub = bytes_slice(payload, 41, 73)
            Vector[uint8] signature = bytes_slice(payload, 73, 137)
            # Identity check: SHA256(ed25519_pub) must match sender's PeerId
            String computed_hex = bytes_to_hex(crypto_sha256(ed25519_pub))
            if computed_hex != sender_hex:
                return p2p_no_event()
            # Signature check: verify that sender signed their ephemeral key
            if not crypto_ed25519_verify(ed25519_pub, ephemeral_pub, signature):
                return p2p_no_event()
            s.encrypted = true
            s.authenticated = true
            s.remote_ephemeral_pub = !ephemeral_pub
            # Generate our own ephemeral keypair
            X25519KeyPair ekp = crypto_x25519_keygen().unwrap()
            Vector[uint8] epub = ekp.public_key()
            s.local_ephemeral_pub = bytes_slice(epub, 0, epub.len())
            # Compute shared secret and derive keys (we are responder)
            Vector[uint8] dh_secret = crypto_x25519_shared_secret(ekp, s.remote_ephemeral_pub).unwrap()
            Vector[uint8] keys = p2p_derive_stream_keys(dh_secret, false)
            s.tx_key = bytes_slice(keys, 0, 32)
            s.rx_key = bytes_slice(keys, 32, 64)
        elif enc_bit == 1 and payload.len() >= 41:
            # Encrypted only (Phase 8 backward compat)
            s.encrypted = true
            s.remote_ephemeral_pub = bytes_slice(payload, 9, 41)
            # Generate our own ephemeral keypair
            X25519KeyPair ekp = crypto_x25519_keygen().unwrap()
            Vector[uint8] epub = ekp.public_key()
            s.local_ephemeral_pub = bytes_slice(epub, 0, epub.len())
            # Compute shared secret and derive keys (we are responder)
            Vector[uint8] dh_secret = crypto_x25519_shared_secret(ekp, s.remote_ephemeral_pub).unwrap()
            Vector[uint8] keys = p2p_derive_stream_keys(dh_secret, false)
            s.tx_key = bytes_slice(keys, 0, 32)
            s.rx_key = bytes_slice(keys, 32, 64)
    # Extract protocol tag if flags & 0x04
    String syn_protocol = ""
    if payload.len() >= 9:
        uint8 pflags = payload.get(8).unwrap()
        int pflags_int = pflags as int
        int proto_bit = pflags_int & 4
        if proto_bit == 4:
            # Compute base offset past enc/auth fields
            int base_off = 9
            int penc = pflags_int & 1
            int pauth = pflags_int & 2
            if penc == 1 and pauth == 2:
                base_off = 137
            elif penc == 1:
                base_off = 41
            if payload.len() >= base_off + 2:
                int proto_len = bytes_read_u16_be(payload, base_off)
                if payload.len() >= base_off + 2 + proto_len:
                    Vector[uint8] proto_bytes = bytes_slice(payload, base_off + 2, base_off + 2 + proto_len)
                    syn_protocol = bytes_to_str(proto_bytes).unwrap()
    s.protocol = syn_protocol.clone()
    node.streams.push(!s)
    # Return STREAM_SYN event with our local stream_id in data, protocol in topic
    Vector[uint8] ev_data = p2p_make_u32(local_sid)
    return P2PEvent(8, PeerId(Vector[uint8]()), ev_data, syn_protocol)

# ── Handle incoming SYN-ACK (53) ──────────────────────────

P2PEvent p2p_handle_syn_ack(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 16:
        return p2p_no_event()
    int responder_sid = bytes_read_u32_be(payload, 0)
    int initiator_sid = bytes_read_u32_be(payload, 4)
    int responder_isn = bytes_read_u32_be(payload, 8)
    int ack_isn = bytes_read_u32_be(payload, 12)
    # Look up by OUR local ID (initiator_sid is ours)
    int sidx = p2p_find_stream(&node, initiator_sid)
    if sidx < 0:
        return p2p_no_event()
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 1:
        node.streams.push(!s)
        return p2p_no_event()
    s.state = 3
    s.last_recv_ms = time_ms()
    s.remote_initial_seq = responder_isn
    s.remote_seq_acked = responder_isn + 1
    # Store the responder's stream ID
    s.remote_stream_id = responder_sid
    # Check flags byte at offset 16 (was 12)
    if s.encrypted and payload.len() >= 17:
        uint8 flags = payload.get(16).unwrap()
        int flags_int = flags as int
        int auth_bit = flags_int & 2
        int enc_bit = flags_int & 1
        if auth_bit == 2 and s.authenticated and payload.len() >= 145:
            # Authenticated SYN-ACK: [17..49] X25519, [49..81] Ed25519, [81..145] signature
            Vector[uint8] responder_pub = bytes_slice(payload, 17, 49)
            Vector[uint8] ed25519_pub = bytes_slice(payload, 49, 81)
            Vector[uint8] signature = bytes_slice(payload, 81, 145)
            # Identity check: SHA256(ed25519_pub) must match the peer we intended to connect to
            String computed_hex = bytes_to_hex(crypto_sha256(ed25519_pub))
            if computed_hex != s.peer_hex:
                s.state = 0
                node.streams.push(!s)
                return p2p_no_event()
            # Signature check: verify responder signed their ephemeral key
            if not crypto_ed25519_verify(ed25519_pub, responder_pub, signature):
                s.state = 0
                node.streams.push(!s)
                return p2p_no_event()
            # Derive keys from shared secret
            Vector[uint8] dh_secret = crypto_x25519_dh(s.local_ephemeral_priv, responder_pub).unwrap()
            Vector[uint8] keys = p2p_derive_stream_keys(dh_secret, true)
            s.tx_key = bytes_slice(keys, 0, 32)
            s.rx_key = bytes_slice(keys, 32, 64)
        elif enc_bit == 1 and payload.len() >= 49:
            # Encrypted only: [17..49] X25519 pubkey
            Vector[uint8] responder_pub = bytes_slice(payload, 17, 49)
            Vector[uint8] dh_secret = crypto_x25519_dh(s.local_ephemeral_priv, responder_pub).unwrap()
            Vector[uint8] keys = p2p_derive_stream_keys(dh_secret, true)
            s.tx_key = bytes_slice(keys, 0, 32)
            s.rx_key = bytes_slice(keys, 32, 64)
    # Compute RTT from SYN
    if s.syn_send_ms > 0:
        int rtt_sample = time_ms() - s.syn_send_ms
        s.srtt_ms = rtt_sample
        s.rttvar_ms = rtt_sample / 2
        s.rto_ms = rtt_sample + 4 * s.rttvar_ms
        if s.rto_ms < 200:
            s.rto_ms = 200
        if s.rto_ms > 60000:
            s.rto_ms = 60000
    node.streams.push(!s)
    # Return STREAM_CONNECTED event with our local stream_id
    Vector[uint8] ev_data = p2p_make_u32(initiator_sid)
    return P2PEvent(9, PeerId(Vector[uint8]()), ev_data, "")

# ── Handle incoming FIN (54) ──────────────────────────────

P2PEvent p2p_handle_fin(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 12:
        return p2p_no_event()
    int receiver_sid = bytes_read_u32_be(payload, 0)
    int sender_sid = bytes_read_u32_be(payload, 4)
    int final_seq = bytes_read_u32_be(payload, 8)
    int sidx = p2p_find_stream(&node, receiver_sid)
    if sidx < 0:
        return p2p_no_event()
    ReliableStream s = node.streams.remove(sidx).unwrap()
    s.last_recv_ms = time_ms()
    s.state = 0
    auto peer = s.peer_hex
    int sid = s.stream_id
    int remote_sid = s.remote_stream_id
    # Send FIN-ACK: swap IDs (our local → receiver, their local → sender)
    Vector[uint8] ack_payload = p2p_encode_fin_ack_payload(remote_sid, sid, final_seq)
    p2p_stream_send_raw(&node, peer.clone(), 55, ack_payload)
    node.streams.push(!s)
    # Return STREAM_CLOSED event
    Vector[uint8] ev_data = p2p_make_u32(receiver_sid)
    return P2PEvent(11, PeerId(Vector[uint8]()), ev_data, "")

# ── Handle incoming FIN-ACK (55) ──────────────────────────

P2PEvent p2p_handle_fin_ack(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 12:
        return p2p_no_event()
    int receiver_sid = bytes_read_u32_be(payload, 0)
    int sidx = p2p_find_stream(&node, receiver_sid)
    if sidx < 0:
        return p2p_no_event()
    ReliableStream s = node.streams.remove(sidx).unwrap()
    s.state = 0
    node.streams.push(!s)
    # Return STREAM_CLOSED event
    Vector[uint8] ev_data = p2p_make_u32(receiver_sid)
    return P2PEvent(11, PeerId(Vector[uint8]()), ev_data, "")

# ── Data transfer ──────────────────────────────────────────

Result[int, String] p2p_stream_send(Node &node, int stream_id, Vector[uint8] data):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return Error("stream not found")
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 3:
        node.streams.push(!s)
        return Error("stream not established")
    int data_len = data.len()
    # Append data to send_queue
    if data_len > 0:
        Vector[uint8] data_copy = bytes_slice(data, 0, data_len)
        s.send_queue = bytes_concat(s.send_queue, data_copy)
    node.streams.push(!s)
    return Ok(data_len)

void p2p_stream_flush_send(Node &node, int stream_id):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 3 and s.state != 6:
        node.streams.push(!s)
        return
    auto peer = s.peer_hex
    int sid = s.stream_id
    int remote_sid = s.remote_stream_id
    int now = time_ms()
    bool is_enc = s.encrypted
    # Segment and send up to cwnd - flight_size segments
    # Encrypted streams use smaller chunks to account for 28-byte AEAD overhead
    int mss = 1196
    if is_enc:
        mss = 1168
    int can_send = s.cwnd - s.flight_size
    # Cap by remote peer's advertised receive window
    int remote_window_segs = s.remote_recv_window / mss
    if remote_window_segs < can_send:
        can_send = remote_window_segs
    if can_send < 0:
        can_send = 0
    while s.send_queue.len() > 0 and can_send > 0:
        int chunk_size = mss
        if s.send_queue.len() < chunk_size:
            chunk_size = s.send_queue.len()
        Vector[uint8] chunk = bytes_slice(s.send_queue, 0, chunk_size)
        # Remove consumed bytes from send_queue
        if chunk_size < s.send_queue.len():
            s.send_queue = bytes_slice(s.send_queue, chunk_size, s.send_queue.len())
        else:
            s.send_queue = Vector[uint8]()
        # Create segment
        int seq = s.local_seq
        SendSegment seg = SendSegment(seq, chunk, now, 0, false)
        Vector[uint8] seg_data = bytes_slice(seg.data, 0, seg.data.len())
        s.send_buffer.push(!seg)
        s.local_seq = s.local_seq + 1
        s.flight_size = s.flight_size + 1
        can_send = can_send - 1
        # Encrypt segment data if stream is encrypted
        if is_enc:
            Vector[uint8] nonce = p2p_make_nonce(s.tx_nonce_counter)
            s.tx_nonce_counter = s.tx_nonce_counter + 1
            seg_data = crypto_aes_gcm_encrypt(s.tx_key, nonce, seg_data).unwrap()
        # Send the segment with dual IDs
        Vector[uint8] payload = p2p_encode_data_payload(remote_sid, sid, seq, seg_data)
        p2p_stream_send_raw(&node, peer.clone(), 50, payload)
    s.last_send_ms = now
    node.streams.push(!s)

Vector[uint8] p2p_stream_recv(Node &node, int stream_id):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return Vector[uint8]()
    ReliableStream s = node.streams.remove(sidx).unwrap()
    Vector[uint8] data = s.recv_ready
    s.recv_ready = Vector[uint8]()
    node.streams.push(!s)
    return data

# ── Message Framing ───────────────────────────────────────
# Prepends a 4-byte big-endian length header to each message.
# Do not mix raw recv() and recv_frame() on the same stream.

Result[int, String] p2p_stream_send_frame(Node &node, int stream_id, Vector[uint8] data):
    int data_len = data.len()
    Vector[uint8] header = p2p_make_u32(data_len)
    Vector[uint8] framed = bytes_concat(header, data)
    return p2p_stream_send(&node, stream_id, framed)

Vector[uint8] p2p_stream_recv_frame(Node &node, int stream_id):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return Vector[uint8]()
    ReliableStream s = node.streams.remove(sidx).unwrap()
    # Move new data into frame_buf
    if s.recv_ready.len() > 0:
        s.frame_buf = bytes_concat(s.frame_buf, s.recv_ready)
        s.recv_ready = Vector[uint8]()
    # Need 4-byte length header
    if s.frame_buf.len() < 4:
        node.streams.push(!s)
        return Vector[uint8]()
    int frame_len = bytes_read_u32_be(s.frame_buf, 0)
    int total = 4 + frame_len
    if s.frame_buf.len() < total:
        node.streams.push(!s)
        return Vector[uint8]()
    # Extract complete frame
    Vector[uint8] frame = bytes_slice(s.frame_buf, 4, total)
    if s.frame_buf.len() > total:
        s.frame_buf = bytes_slice(s.frame_buf, total, s.frame_buf.len())
    else:
        s.frame_buf = Vector[uint8]()
    node.streams.push(!s)
    return frame.clone()

# ── RPC (Request/Response) ─────────────────────────────────
# RPC frame format (inside a stream frame):
#   [1B rpc_type] [4B correlation_id] [payload...]
# rpc_type 1 = REQUEST, rpc_type 2 = RESPONSE
# Do not mix raw frames and RPC on the same stream.

Result[int, String] p2p_rpc_send_request(Node &node, int stream_id, Vector[uint8] data):
    int sidx = p2p_find_stream(&node, stream_id)
    if sidx < 0:
        return Error("stream not found")
    ReliableStream s = node.streams.remove(sidx).unwrap()
    int cid = s.rpc_next_id
    s.rpc_next_id = s.rpc_next_id + 1
    node.streams.push(!s)
    # Build RPC frame: [1B type=1] [4B cid] [payload]
    Vector[uint8] rpc_buf = p2p_make_byte(1)
    rpc_buf = bytes_concat(rpc_buf, p2p_make_u32(cid))
    rpc_buf = bytes_concat(rpc_buf, data)
    Result[int, String] send_res = p2p_stream_send_frame(&node, stream_id, rpc_buf)
    if send_res.is_error():
        return Error(send_res.unwrap_error())
    return Ok(cid)

Result[int, String] p2p_rpc_send_response(Node &node, int stream_id, int correlation_id, Vector[uint8] data):
    # Build RPC frame: [1B type=2] [4B cid] [payload]
    Vector[uint8] rpc_buf = p2p_make_byte(2)
    rpc_buf = bytes_concat(rpc_buf, p2p_make_u32(correlation_id))
    rpc_buf = bytes_concat(rpc_buf, data)
    Result[int, String] send_res = p2p_stream_send_frame(&node, stream_id, rpc_buf)
    if send_res.is_error():
        return Error(send_res.unwrap_error())
    return Ok(correlation_id)

RpcMessage p2p_rpc_recv(Node &node, int stream_id):
    Vector[uint8] frame = p2p_stream_recv_frame(&node, stream_id)
    if frame.len() < 5:
        return RpcMessage(0, 0, Vector[uint8]())
    uint8 rpc_type_byte = frame.get(0).unwrap()
    int rpc_type = rpc_type_byte as int
    int cid = bytes_read_u32_be(frame, 1)
    Vector[uint8] payload = Vector[uint8]()
    if frame.len() > 5:
        payload = bytes_slice(frame, 5, frame.len())
    return RpcMessage(rpc_type, cid, payload)

RpcMessage p2p_rpc_recv_request(Node &node, int stream_id):
    RpcMessage msg = p2p_rpc_recv(&node, stream_id)
    if msg.msg_type == 1:
        return msg
    return RpcMessage(0, 0, Vector[uint8]())

RpcMessage p2p_rpc_recv_response(Node &node, int stream_id):
    RpcMessage msg = p2p_rpc_recv(&node, stream_id)
    if msg.msg_type == 2:
        return msg
    return RpcMessage(0, 0, Vector[uint8]())

# ── Handle incoming DATA (50) ─────────────────────────────

void p2p_stream_handle_data(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 12:
        return
    int receiver_sid = bytes_read_u32_be(payload, 0)
    int sender_sid = bytes_read_u32_be(payload, 4)
    int seq_num = bytes_read_u32_be(payload, 8)
    int sidx = p2p_find_stream(&node, receiver_sid)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 3 and s.state != 6:
        node.streams.push(!s)
        return
    s.last_recv_ms = time_ms()
    Vector[uint8] seg_data = Vector[uint8]()
    if payload.len() > 12:
        seg_data = bytes_slice(payload, 12, payload.len())
    # Decrypt if encrypted
    if s.encrypted and seg_data.len() > 0:
        seg_data = crypto_aes_gcm_decrypt(s.rx_key, seg_data).unwrap()
    # In-order delivery
    if seq_num == s.remote_seq_acked:
        # Append directly to recv_ready
        s.recv_ready = bytes_concat(s.recv_ready, seg_data)
        s.remote_seq_acked = s.remote_seq_acked + 1
        # Check if any OOO segments are now contiguous
        bool found = true
        while found:
            found = false
            int oi = 0
            while oi < s.recv_ooo.len():
                auto ooo = s.recv_ooo.get(oi).unwrap()
                if ooo.seq_num == s.remote_seq_acked:
                    Vector[uint8] ooo_data = bytes_slice(ooo.data, 0, ooo.data.len())
                    s.recv_ready = bytes_concat(s.recv_ready, ooo_data)
                    s.recv_ooo.remove(oi)
                    s.remote_seq_acked = s.remote_seq_acked + 1
                    found = true
                else:
                    oi = oi + 1
    elif seq_num > s.remote_seq_acked:
        # Out of order — buffer it
        bool dup = false
        int oi = 0
        while oi < s.recv_ooo.len():
            auto ooo = s.recv_ooo.get(oi).unwrap()
            if ooo.seq_num == seq_num:
                dup = true
            oi = oi + 1
        if not dup:
            Vector[uint8] ooo_copy = bytes_slice(seg_data, 0, seg_data.len())
            RecvSegment rs = RecvSegment(seq_num, ooo_copy)
            s.recv_ooo.push(!rs)
    # Compute available recv window
    int recv_used = s.recv_ready.len()
    int recv_window = s.local_recv_buf_max - recv_used
    if recv_window < 0:
        recv_window = 0
    # Compute SACKs
    Vector[SACKBlock] sacks = Vector[SACKBlock]()
    # Sort OOO by seq_num and build contiguous blocks
    int si = 0
    while si < s.recv_ooo.len():
        auto ooo = s.recv_ooo.get(si).unwrap()
        int sn = ooo.seq_num
        # Check if this seq extends an existing sack block
        bool merged = false
        int bi = 0
        while bi < sacks.len():
            SACKBlock sb = sacks.get(bi).unwrap()
            if sn == sb.right:
                SACKBlock new_sb = SACKBlock(sb.left, sb.right + 1)
                sacks.set(bi, !new_sb)
                merged = true
            elif sn == sb.left - 1:
                SACKBlock new_sb = SACKBlock(sb.left - 1, sb.right)
                sacks.set(bi, !new_sb)
                merged = true
            bi = bi + 1
        if not merged:
            SACKBlock new_sb = SACKBlock(sn, sn + 1)
            sacks.push(!new_sb)
        si = si + 1
    auto peer = s.peer_hex
    int sid = s.stream_id
    int remote_sid = s.remote_stream_id
    int cum_ack = s.remote_seq_acked
    # Send ACK with dual IDs (receiver_sid = peer's local ID, sender_sid = our ID)
    Vector[uint8] ack_payload = p2p_encode_ack_payload(remote_sid, sid, cum_ack, recv_window, sacks)
    p2p_stream_send_raw(&node, peer.clone(), 51, ack_payload)
    node.streams.push(!s)

# ── Handle incoming ACK (51) ──────────────────────────────

void p2p_stream_handle_ack(Node &node, String sender_hex, Vector[uint8] payload):
    if payload.len() < 17:
        return
    int receiver_sid = bytes_read_u32_be(payload, 0)
    int sender_sid = bytes_read_u32_be(payload, 4)
    int cum_ack = bytes_read_u32_be(payload, 8)
    int recv_window = bytes_read_u32_be(payload, 12)
    uint8 num_sacks_byte = payload.get(16).unwrap()
    int num_sacks = num_sacks_byte as int
    # Parse SACK blocks
    Vector[SACKBlock] sacks = Vector[SACKBlock]()
    int si = 0
    while si < num_sacks and si < 4:
        int sack_off = 17 + si * 8
        if payload.len() >= sack_off + 8:
            int sack_left = bytes_read_u32_be(payload, sack_off)
            int sack_right = bytes_read_u32_be(payload, sack_off + 4)
            SACKBlock sb = SACKBlock(sack_left, sack_right)
            sacks.push(!sb)
        si = si + 1
    int sidx = p2p_find_stream(&node, receiver_sid)
    if sidx < 0:
        return
    ReliableStream s = node.streams.remove(sidx).unwrap()
    if s.state != 3 and s.state != 4 and s.state != 6:
        node.streams.push(!s)
        return
    s.remote_recv_window = recv_window
    int now = time_ms()
    s.last_recv_ms = now
    # Mark cumulative acked segments
    int new_acks = 0
    int bi = 0
    while bi < s.send_buffer.len():
        auto seg = s.send_buffer.get(bi).unwrap()
        if seg.seq_num < cum_ack and not seg.acked:
            Vector[uint8] ack_data = seg.data.clone()
            SendSegment acked_seg = SendSegment(seg.seq_num, ack_data, seg.send_time_ms, seg.retransmit_count, true)
            s.send_buffer.set(bi, !acked_seg)
            new_acks = new_acks + 1
            # RTT sample (only from non-retransmitted segments)
            if seg.retransmit_count == 0:
                int rtt_sample = now - seg.send_time_ms
                if s.srtt_ms == 0:
                    s.srtt_ms = rtt_sample
                    s.rttvar_ms = rtt_sample / 2
                else:
                    int diff = rtt_sample - s.srtt_ms
                    if diff < 0:
                        diff = 0 - diff
                    s.rttvar_ms = 3 * s.rttvar_ms / 4 + diff / 4
                    s.srtt_ms = 7 * s.srtt_ms / 8 + rtt_sample / 8
                s.rto_ms = s.srtt_ms + 4 * s.rttvar_ms
                if s.rto_ms < 200:
                    s.rto_ms = 200
                if s.rto_ms > 60000:
                    s.rto_ms = 60000
        bi = bi + 1
    # Mark SACK-acked segments
    int ski = 0
    while ski < sacks.len():
        auto sb = sacks.get(ski).unwrap()
        int sbi = 0
        while sbi < s.send_buffer.len():
            auto seg = s.send_buffer.get(sbi).unwrap()
            if seg.seq_num >= sb.left and seg.seq_num < sb.right and not seg.acked:
                Vector[uint8] sack_data = seg.data.clone()
                SendSegment acked_seg = SendSegment(seg.seq_num, sack_data, seg.send_time_ms, seg.retransmit_count, true)
                s.send_buffer.set(sbi, !acked_seg)
                new_acks = new_acks + 1
            sbi = sbi + 1
        ski = ski + 1
    # Update flight_size
    s.flight_size = 0
    int fi = 0
    while fi < s.send_buffer.len():
        auto seg = s.send_buffer.get(fi).unwrap()
        if not seg.acked:
            s.flight_size = s.flight_size + 1
        fi = fi + 1
    # Purge fully acked segments from front of send_buffer
    while s.send_buffer.len() > 0:
        auto front = s.send_buffer.get(0).unwrap()
        if front.acked:
            s.send_buffer.remove(0)
        else:
            # stop at first unacked
            break
    # Congestion control: AIMD
    if new_acks > 0:
        if cum_ack == s.last_ack_num:
            # Duplicate ACK
            s.dup_ack_count = s.dup_ack_count + 1
            if s.dup_ack_count == 3:
                # Fast retransmit: retransmit first unacked
                s.ssthresh = s.cwnd / 2
                if s.ssthresh < 1:
                    s.ssthresh = 1
                s.cwnd = s.ssthresh + 3
                s.ca_ack_count = 0
                # Retransmit first unacked segment
                int ri = 0
                while ri < s.send_buffer.len():
                    auto seg = s.send_buffer.get(ri).unwrap()
                    if not seg.acked:
                        auto peer = s.peer_hex
                        int sid = s.stream_id
                        int remote_sid = s.remote_stream_id
                        Vector[uint8] seg_data = bytes_slice(seg.data, 0, seg.data.len())
                        if s.encrypted:
                            Vector[uint8] nonce = p2p_make_nonce(s.tx_nonce_counter)
                            s.tx_nonce_counter = s.tx_nonce_counter + 1
                            seg_data = crypto_aes_gcm_encrypt(s.tx_key, nonce, seg_data).unwrap()
                        Vector[uint8] pld = p2p_encode_data_payload(remote_sid, sid, seg.seq_num, seg_data)
                        p2p_stream_send_raw(&node, peer.clone(), 50, pld)
                        Vector[uint8] resent_data = seg.data.clone()
                        SendSegment resent = SendSegment(seg.seq_num, resent_data, now, seg.retransmit_count + 1, false)
                        s.send_buffer.set(ri, !resent)
                        ri = s.send_buffer.len()
                    ri = ri + 1
        else:
            s.dup_ack_count = 0
            s.last_ack_num = cum_ack
            # Increase cwnd
            if s.cwnd < s.ssthresh:
                # Slow start: +1 per ACK (exponential growth)
                s.cwnd = s.cwnd + 1
            else:
                # Congestion avoidance: +1 per full window (AIMD)
                s.ca_ack_count = s.ca_ack_count + 1
                if s.ca_ack_count >= s.cwnd:
                    s.cwnd = s.cwnd + 1
                    s.ca_ack_count = 0
    node.streams.push(!s)

# ── Retransmission tick ────────────────────────────────────

void p2p_stream_tick(Node &node):
    int now = time_ms()
    int count = node.streams.len()
    int i = 0
    while i < count:
        # Always remove index 0: each iteration rotates the front to the back
        ReliableStream s = node.streams.remove(0).unwrap()
        if s.state == 3 or s.state == 4 or s.state == 6:
            auto peer = s.peer_hex
            int sid = s.stream_id
            int remote_sid = s.remote_stream_id
            bool is_enc = s.encrypted
            bool retransmitted = false
            int ri = 0
            while ri < s.send_buffer.len():
                auto seg = s.send_buffer.get(ri).unwrap()
                if not seg.acked:
                    int elapsed = now - seg.send_time_ms
                    if elapsed >= s.rto_ms:
                        # Timeout retransmit
                        Vector[uint8] seg_data = bytes_slice(seg.data, 0, seg.data.len())
                        if is_enc:
                            Vector[uint8] nonce = p2p_make_nonce(s.tx_nonce_counter)
                            s.tx_nonce_counter = s.tx_nonce_counter + 1
                            seg_data = crypto_aes_gcm_encrypt(s.tx_key, nonce, seg_data).unwrap()
                        Vector[uint8] pld = p2p_encode_data_payload(remote_sid, sid, seg.seq_num, seg_data)
                        p2p_stream_send_raw(&node, peer.clone(), 50, pld)
                        Vector[uint8] resent_data = seg.data.clone()
                        SendSegment resent = SendSegment(seg.seq_num, resent_data, now, seg.retransmit_count + 1, false)
                        s.send_buffer.set(ri, !resent)
                        retransmitted = true
                ri = ri + 1
            if retransmitted:
                # Multiplicative decrease
                s.ssthresh = s.cwnd / 2
                if s.ssthresh < 1:
                    s.ssthresh = 1
                s.cwnd = 1
                s.ca_ack_count = 0
                # Exponential backoff on RTO
                s.rto_ms = s.rto_ms * 2
                if s.rto_ms > 60000:
                    s.rto_ms = 60000
            # Zero-window probe: when remote window is 0 and data is queued
            if s.remote_recv_window == 0 and s.send_queue.len() > 0:
                int probe_elapsed = now - s.last_send_ms
                if probe_elapsed >= s.rto_ms:
                    int mss = 1196
                    if is_enc:
                        mss = 1168
                    int probe_size = 1
                    if s.send_queue.len() < probe_size:
                        probe_size = s.send_queue.len()
                    Vector[uint8] probe_chunk = bytes_slice(s.send_queue, 0, probe_size)
                    if probe_size < s.send_queue.len():
                        s.send_queue = bytes_slice(s.send_queue, probe_size, s.send_queue.len())
                    else:
                        s.send_queue = Vector[uint8]()
                    int probe_seq = s.local_seq
                    SendSegment probe_seg = SendSegment(probe_seq, probe_chunk, now, 0, false)
                    Vector[uint8] probe_seg_data = bytes_slice(probe_seg.data, 0, probe_seg.data.len())
                    s.send_buffer.push(!probe_seg)
                    s.local_seq = s.local_seq + 1
                    s.flight_size = s.flight_size + 1
                    if is_enc:
                        Vector[uint8] nonce = p2p_make_nonce(s.tx_nonce_counter)
                        s.tx_nonce_counter = s.tx_nonce_counter + 1
                        probe_seg_data = crypto_aes_gcm_encrypt(s.tx_key, nonce, probe_seg_data).unwrap()
                    Vector[uint8] probe_pld = p2p_encode_data_payload(remote_sid, sid, probe_seq, probe_seg_data)
                    p2p_stream_send_raw(&node, peer.clone(), 50, probe_pld)
                    s.last_send_ms = now
            # Keepalive: send if idle and established
            if s.state == 3 and s.last_recv_ms > 0:
                int idle = now - s.last_send_ms
                if idle >= s.keepalive_interval_ms and s.send_queue.len() == 0 and s.flight_size == 0:
                    Vector[uint8] ka = p2p_encode_keepalive_payload(remote_sid, sid)
                    p2p_stream_send_raw(&node, peer.clone(), 56, ka)
                    s.last_send_ms = now
            # Dead peer detection
            if s.last_recv_ms > 0:
                int silence = now - s.last_recv_ms
                if silence >= s.keepalive_timeout_ms:
                    s.state = 7
            # FIN_PENDING: send FIN when send_queue fully segmented
            if s.state == 6:
                if s.send_queue.len() == 0:
                    s.state = 4
                    s.fin_send_ms = now
                    Vector[uint8] fin_payload = p2p_encode_fin_payload(remote_sid, sid, s.local_seq)
                    p2p_stream_send_raw(&node, peer.clone(), 54, fin_payload)
        # SYN timeout: resend after rto_ms
        if s.state == 1 and s.syn_send_ms > 0:
            int syn_elapsed = now - s.syn_send_ms
            if syn_elapsed >= s.rto_ms:
                auto peer = s.peer_hex
                int sid = s.stream_id
                bool has_proto = s.protocol != ""
                if s.authenticated:
                    # Re-sign ephemeral key for retransmit
                    Vector[uint8] sig = crypto_ed25519_sign(node.identity.private_key.clone(), s.local_ephemeral_pub.clone()).unwrap()
                    if has_proto:
                        auto syn_payload = p2p_encode_syn_auth_protocol_payload(sid, s.local_initial_seq, s.local_ephemeral_pub.clone(), node.identity.public_key.clone(), sig, s.protocol.clone())
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                    else:
                        auto syn_payload = p2p_encode_syn_auth_payload(sid, s.local_initial_seq, s.local_ephemeral_pub.clone(), node.identity.public_key.clone(), sig)
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                elif s.encrypted:
                    if has_proto:
                        auto syn_payload = p2p_encode_syn_encrypted_protocol_payload(sid, s.local_initial_seq, s.local_ephemeral_pub.clone(), s.protocol.clone())
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                    else:
                        auto syn_payload = p2p_encode_syn_encrypted_payload(sid, s.local_initial_seq, s.local_ephemeral_pub.clone())
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                else:
                    if has_proto:
                        auto syn_payload = p2p_encode_syn_protocol_payload(sid, s.local_initial_seq, s.protocol.clone())
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                    else:
                        auto syn_payload = p2p_encode_syn_payload(sid, s.local_initial_seq)
                        p2p_stream_send_raw(&node, peer.clone(), 52, syn_payload)
                s.syn_send_ms = now
                s.rto_ms = s.rto_ms * 2
                if s.rto_ms > 60000:
                    s.rto_ms = 60000
        # Flush pending send_queue data
        node.streams.push(!s)
        # Flush after re-inserting
        int last_idx = node.streams.len() - 1
        auto last_s = node.streams.get(last_idx).unwrap()
        int sid_tmp = last_s.stream_id
        p2p_stream_flush_send(&node, sid_tmp)
        i = i + 1

# ── Poll ─────────────────────────────────────────────────────

# Receive a datagram from the selected socket. `use_disc` picks the
# discovery (multicast) socket, otherwise the main unicast socket. The
# socket is always a field of `node`, so selecting it INTERNALLY (rather
# than taking a separate `UdpSocket &sock` arg that always aliases a `node`
# field) keeps the borrow single-rooted: recvfrom mutates `node.<socket>`
# and the later `p2p_update_peer`/`p2p_send_raw` calls mutate other `node`
# fields.
Result[UdpPacket, String] p2p_recvfrom_selected(Node &node, bool use_disc):
    if use_disc:
        return node.disc_socket.recvfrom(65536)
    return node.socket.recvfrom(65536)

P2PEvent p2p_poll_socket(Node &node, bool use_disc):
    Result[UdpPacket, String] recv_result = p2p_recvfrom_selected(&node, use_disc)
    if recv_result.is_error():
        return p2p_no_event()

    UdpPacket pkt = recv_result.unwrap()

    Result[Message, String] decode_result = p2p_decode_message(pkt.data)
    if decode_result.is_error():
        return p2p_no_event()

    Message msg = decode_result.unwrap()

    # Update peer table (skip for ANNOUNCE — handled separately)
    String sender_hex = p2p_peer_id_hex(msg.sender)

    # ANNOUNCE (10) -> discovered via multicast
    if msg.msg_type == 10:
        # Skip our own announcements
        String our_hex = p2p_peer_id_hex(node.identity.peer_id)
        if sender_hex == our_hex:
            return p2p_no_event()
        auto ann = p2p_decode_announce_payload(msg.payload)
        if ann.is_ok():
            auto info = ann.unwrap()
            p2p_update_peer(&node, sender_hex, info.host, info.port)
            # Send PING to their unicast address for mutual introduction
            p2p_send_raw(&node, info.host, info.port, 1, Vector[uint8]())
            return P2PEvent(2, msg.sender, Vector[uint8](), "")
        return p2p_no_event()

    p2p_update_peer(&node, sender_hex, pkt.sender.host, pkt.sender.port)

    # PING (1) -> auto-reply with PONG (2)
    if msg.msg_type == 1:
        p2p_send_raw(&node, pkt.sender.host, pkt.sender.port, 2, Vector[uint8]())
        return P2PEvent(2, msg.sender, Vector[uint8](), "")

    # PONG (2) -> peer discovered
    if msg.msg_type == 2:
        return P2PEvent(2, msg.sender, Vector[uint8](), "")

    # DATA (3) -> message event
    if msg.msg_type == 3:
        return P2PEvent(1, msg.sender, msg.payload, "")

    # STORE (22) -> store locally
    if msg.msg_type == 22:
        if msg.payload.len() >= 32:
            Vector[uint8] store_key = bytes_slice(msg.payload, 0, 32)
            Vector[uint8] store_val = Vector[uint8]()
            if msg.payload.len() > 32:
                store_val = bytes_slice(msg.payload, 32, msg.payload.len())
            String store_hex = bytes_to_hex(store_key)
            p2p_dht_put_local(&node, store_hex, store_val)
        return p2p_no_event()

    # FIND_VALUE (23) -> look up and reply
    if msg.msg_type == 23:
        if msg.payload.len() >= 32:
            Vector[uint8] fv_key = bytes_slice(msg.payload, 0, 32)
            String fv_hex = bytes_to_hex(fv_key)
            int fv_idx = p2p_dht_find_local(node, fv_hex)
            if fv_idx >= 0:
                auto fv_entry = node.dht_store.get(fv_idx).unwrap()
                # Reply: [1B found=1] [value]
                Vector[uint8] reply = p2p_make_byte(1)
                Vector[uint8] fv_val_copy = bytes_slice(fv_entry.value, 0, fv_entry.value.len())
                reply = bytes_concat(reply, fv_val_copy)
                p2p_send_raw(&node, pkt.sender.host, pkt.sender.port, 24, reply)
            elif fv_idx < 0:
                # Reply: [1B found=0]
                Vector[uint8] reply = p2p_make_byte(0)
                p2p_send_raw(&node, pkt.sender.host, pkt.sender.port, 24, reply)
        return p2p_no_event()

    # FIND_VALUE_REPLY (24) -> return as DHT_RESULT event
    if msg.msg_type == 24:
        if msg.payload.len() >= 1:
            uint8 found_flag = msg.payload.get(0).unwrap()
            if found_flag as int == 1:
                Vector[uint8] fvr_data = Vector[uint8]()
                if msg.payload.len() > 1:
                    fvr_data = bytes_slice(msg.payload, 1, msg.payload.len())
                return P2PEvent(4, msg.sender, fvr_data, "")
        return p2p_no_event()

    # ADDR_PROBE (40) -> reply with sender's external address
    if msg.msg_type == 40:
        Vector[uint8] addr_reply = p2p_encode_announce_payload(pkt.sender.host, pkt.sender.port)
        p2p_send_raw(&node, pkt.sender.host, pkt.sender.port, 41, addr_reply)
        return p2p_no_event()

    # ADDR_REPLY (41) -> return as ADDR_DISCOVERED event
    if msg.msg_type == 41:
        auto addr_info = p2p_decode_announce_payload(msg.payload)
        if addr_info.is_ok():
            auto ai = addr_info.unwrap()
            # Encode as "host:port" string for the event data
            auto addr_str = ai.host
            Vector[uint8] addr_data = bytes_from_str(addr_str.clone())
            Vector[uint8] colon_bytes = bytes_from_str(":")
            addr_data = bytes_concat(addr_data, colon_bytes)
            # Convert port to string bytes
            int port_val = ai.port
            Vector[uint8] port_buf = Vector[uint8]()
            if port_val == 0:
                port_buf = bytes_from_str("0")
            while port_val > 0:
                int digit = port_val % 10
                Vector[uint8] digit_byte = p2p_make_byte(digit + 48)
                port_buf = bytes_concat(digit_byte, port_buf)
                port_val = port_val / 10
            addr_data = bytes_concat(addr_data, port_buf)
            return P2PEvent(5, msg.sender, addr_data, "")
        return p2p_no_event()

    # HOLE_PUNCH_REQ (42) -> rendezvous forwards as NOTIFY to target
    if msg.msg_type == 42:
        if msg.payload.len() >= 32:
            Vector[uint8] target_id_bytes = bytes_slice(msg.payload, 0, 32)
            String target_hex = bytes_to_hex(target_id_bytes)
            int target_idx = p2p_find_peer(node, target_hex)
            if target_idx >= 0:
                auto target_pi = node.peers.get(target_idx).unwrap()
                # Forward as NOTIFY: [32B initiator_id] [addr_payload]
                Vector[uint8] notify_payload = msg.sender.bytes
                if msg.payload.len() > 32:
                    Vector[uint8] addr_part = bytes_slice(msg.payload, 32, msg.payload.len())
                    notify_payload = bytes_concat(notify_payload, addr_part)
                p2p_send_raw(&node, target_pi.host, target_pi.port, 43, notify_payload)
        return p2p_no_event()

    # HOLE_PUNCH_NOTIFY (43) -> target learns initiator's address, sends probe
    if msg.msg_type == 43:
        if msg.payload.len() >= 32:
            Vector[uint8] init_id_bytes = bytes_slice(msg.payload, 0, 32)
            if msg.payload.len() > 32:
                Vector[uint8] addr_part = bytes_slice(msg.payload, 32, msg.payload.len())
                Result[AnnounceInfo, String] hp_info = p2p_decode_announce_payload(addr_part)
                if hp_info.is_ok():
                    AnnounceInfo hp_addr = hp_info.unwrap()
                    String init_hex = bytes_to_hex(init_id_bytes)
                    p2p_update_peer(&node, init_hex, hp_addr.host, hp_addr.port)
                    # Send PING to initiator to complete hole punch
                    p2p_send_raw(&node, hp_addr.host, hp_addr.port, 1, Vector[uint8]())
                    return P2PEvent(2, PeerId(init_id_bytes), Vector[uint8](), "")
        return p2p_no_event()

    # RELAY_REQUEST (44) -> relay peer forwards data to target
    if msg.msg_type == 44:
        if msg.payload.len() >= 32:
            Vector[uint8] relay_target_bytes = bytes_slice(msg.payload, 0, 32)
            String relay_target_hex = bytes_to_hex(relay_target_bytes)
            int relay_idx = p2p_find_peer(node, relay_target_hex)
            if relay_idx >= 0:
                auto relay_pi = node.peers.get(relay_idx).unwrap()
                # Forward as RELAY_DATA: [32B original_sender] [data]
                Vector[uint8] relay_fwd = msg.sender.bytes
                if msg.payload.len() > 32:
                    Vector[uint8] relay_data_part = bytes_slice(msg.payload, 32, msg.payload.len())
                    relay_fwd = bytes_concat(relay_fwd, relay_data_part)
                p2p_send_raw(&node, relay_pi.host, relay_pi.port, 45, relay_fwd)
        return p2p_no_event()

    # RELAY_DATA (45) -> relayed data arriving
    if msg.msg_type == 45:
        if msg.payload.len() >= 32:
            Vector[uint8] orig_sender_bytes = bytes_slice(msg.payload, 0, 32)
            Vector[uint8] relay_payload = Vector[uint8]()
            if msg.payload.len() > 32:
                relay_payload = bytes_slice(msg.payload, 32, msg.payload.len())
            return P2PEvent(6, PeerId(orig_sender_bytes), relay_payload, "")
        return p2p_no_event()

    # GOSSIP (30) -> decode, dedup, forward, deliver
    if msg.msg_type == 30:
        # payload: [1B ttl] [2B topic_len] [topic_bytes] [32B msg_id] [data]
        if msg.payload.len() >= 35:
            uint8 ttl_byte = msg.payload.get(0).unwrap()
            int ttl = ttl_byte as int
            int topic_len = bytes_read_u16_be(msg.payload, 1)
            if msg.payload.len() >= 3 + topic_len + 32:
                Vector[uint8] topic_bytes = bytes_slice(msg.payload, 3, 3 + topic_len)
                String topic = bytes_to_str(topic_bytes).unwrap()
                Vector[uint8] gossip_msg_id = bytes_slice(msg.payload, 3 + topic_len, 3 + topic_len + 32)
                String msg_id_hex = bytes_to_hex(gossip_msg_id)
                # Dedup: skip if already seen
                if p2p_has_seen(node, msg_id_hex):
                    return p2p_no_event()
                p2p_mark_seen(&node, msg_id_hex)
                # Extract data
                Vector[uint8] gossip_data = Vector[uint8]()
                int data_start = 3 + topic_len + 32
                if msg.payload.len() > data_start:
                    gossip_data = bytes_slice(msg.payload, data_start, msg.payload.len())
                # Forward to all peers (except sender) if TTL > 0
                if ttl > 0:
                    int new_ttl = ttl - 1
                    Vector[uint8] fwd_payload = p2p_encode_gossip(new_ttl, topic, gossip_msg_id, gossip_data)
                    int fi = 0
                    while fi < node.peers.len():
                        auto fpi = node.peers.get(fi).unwrap()
                        if fpi.peer_hex != sender_hex:
                            p2p_send_raw(&node, fpi.host, fpi.port, 30, fwd_payload)
                        fi = fi + 1
                # Deliver to application if subscribed
                if p2p_is_subscribed(node, topic):
                    Vector[uint8] event_data = bytes_slice(gossip_data, 0, gossip_data.len())
                    return P2PEvent(7, msg.sender, event_data, topic)
        return p2p_no_event()

    # RELIABLE_SYN (52)
    if msg.msg_type == 52:
        return p2p_handle_syn(&node, sender_hex, msg.payload)

    # RELIABLE_SYN_ACK (53)
    if msg.msg_type == 53:
        return p2p_handle_syn_ack(&node, sender_hex, msg.payload)

    # RELIABLE_DATA (50)
    if msg.msg_type == 50:
        p2p_stream_handle_data(&node, sender_hex, msg.payload)
        # Check if any stream has data ready
        int si = 0
        while si < node.streams.len():
            auto st = node.streams.get(si).unwrap()
            if st.recv_ready.len() > 0:
                Vector[uint8] ev_data = p2p_make_u32(st.stream_id)
                return P2PEvent(10, msg.sender, ev_data, "")
            si = si + 1
        return p2p_no_event()

    # RELIABLE_ACK (51)
    if msg.msg_type == 51:
        p2p_stream_handle_ack(&node, sender_hex, msg.payload)
        return p2p_no_event()

    # RELIABLE_FIN (54)
    if msg.msg_type == 54:
        return p2p_handle_fin(&node, sender_hex, msg.payload)

    # RELIABLE_FIN_ACK (55)
    if msg.msg_type == 55:
        return p2p_handle_fin_ack(&node, sender_hex, msg.payload)

    # RELIABLE_KEEPALIVE (56)
    if msg.msg_type == 56:
        p2p_handle_keepalive(&node, sender_hex, msg.payload)
        return p2p_no_event()

    return p2p_no_event()

P2PEvent p2p_poll(Node &node, int timeout_ms):
    # Drive reliable stream retransmission and flush
    p2p_stream_tick(&node)

    # Scan for dead streams (state 7) and emit STREAM_CLOSED
    int di = 0
    while di < node.streams.len():
        auto ds = node.streams.get(di).unwrap()
        if ds.state == 7:
            ReliableStream ds2 = node.streams.remove(di).unwrap()
            ds2.state = 0
            int dead_sid = ds2.stream_id
            node.streams.push(!ds2)
            Vector[uint8] ev_data = p2p_make_u32(dead_sid)
            return P2PEvent(11, PeerId(Vector[uint8]()), ev_data, "")
        di = di + 1

    # Check discovery socket first (non-blocking)
    if node.disc_enabled:
        # Re-announce periodically
        int now = time_ms()
        int since_announce = now - node.last_announce
        if since_announce > node.announce_interval:
            p2p_send_announce(&node)

        # Drain all queued discovery messages (non-blocking)
        bool disc_ready = node.disc_socket.poll(0)
        while disc_ready:
            P2PEvent ev = p2p_poll_socket(&node, true)
            if ev.event_type != 0:
                return ev
            disc_ready = node.disc_socket.poll(0)

    # Check main socket
    bool ready = node.socket.poll(timeout_ms)
    if not ready:
        return p2p_no_event()

    return p2p_poll_socket(&node, false)
