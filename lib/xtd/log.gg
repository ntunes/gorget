# gg.log — Structured leveled logging
#
# Provides Logger struct with Debug/Info/Warn/Error levels
# and module-level convenience functions for quick use.

from std.time import time, format_time

# ── Log level ────────────────────────────────────────────────

enum LogLevel:
    Debug
    Info
    Warn
    Err

# ── Level helpers ────────────────────────────────────────────

private int level_int(LogLevel log_l):
    match log_l:
        case Debug():
            return 0
        case Info():
            return 1
        case Warn():
            return 2
        case Err():
            return 3

private String level_name(LogLevel log_l):
    match log_l:
        case Debug():
            return "DEBUG"
        case Info():
            return "INFO"
        case Warn():
            return "WARN"
        case Err():
            return "ERROR"

# ── Logger struct ────────────────────────────────────────────

struct Logger:
    LogLevel log_min_level
    bool log_show_timestamp
    String log_prefix

equip Logger:
    Logger new(LogLevel !log_level):
        return Logger(log_level, false, "")

    Logger with_prefix(LogLevel !log_level, String log_pfx):
        return Logger(log_level, false, log_pfx)

    Logger with_timestamps(LogLevel !log_level):
        return Logger(log_level, true, "")

    void set_level(&self, LogLevel log_l):
        self.log_min_level = log_l

    void log_msg(&self, LogLevel log_l, String log_msg):
        if level_int(log_l) < level_int(self.log_min_level):
            return
        String log_out = ""
        if self.log_show_timestamp:
            int log_ts = time()
            log_out = log_out + "[" + format_time(log_ts, "%Y-%m-%d %H:%M:%S") + "] "
        log_out = log_out + "[" + level_name(log_l) + "]"
        if self.log_prefix != "":
            log_out = log_out + " " + self.log_prefix + ":"
        log_out = log_out + " " + log_msg
        print(log_out)

    void debug(&self, String log_msg):
        self.log_msg(Debug(), log_msg)

    void info(&self, String log_msg):
        self.log_msg(Info(), log_msg)

    void warn(&self, String log_msg):
        self.log_msg(Warn(), log_msg)

    void error(&self, String log_msg):
        self.log_msg(Err(), log_msg)

# ── Module-level convenience functions ───────────────────────
# These use a fixed Info-level logger — for configurable logging
# use Logger.new() directly.

void log_debug(String log_msg):
    print("[DEBUG] " + log_msg)

void log_info(String log_msg):
    print("[INFO] " + log_msg)

void log_warn(String log_msg):
    print("[WARN] " + log_msg)

void log_error(String log_msg):
    print("[ERROR] " + log_msg)
