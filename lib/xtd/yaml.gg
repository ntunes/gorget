# std.yaml — Pure Gorget YAML 1.2 parser
#
# Provides a recursive-descent YAML parser, serializer, and accessor methods.
# Block and flow collections, quoted and plain scalars, comments, document markers.
# No C dependencies — uses only Gorget standard library.

from std.collections import Vector, Dict
from std.conv import parse_int, parse_float, int_to_str, float_to_str, ParseError
from std.math import INFINITY, NAN

# ── YAML value type ──────────────────────────────────────────

enum Yaml:
    Null
    Bool(bool)
    Int(int)
    Float(float)
    Str(String)
    Seq(Vector[Yaml])
    Map(Dict[String, Yaml])

# ── Internal parser ──────────────────────────────────────────

struct YamlParser:
    String yaml_input
    int yaml_pos
    String yaml_err
    Vector[String] yaml_anc_names
    Vector[Yaml] yaml_anc_vals

equip YamlParser:
    bool failed(self): self.yaml_err != ""

    void fail(&self, String msg):
        if self.yaml_err == "":
            self.yaml_err = !msg

    bool at_end(self): self.yaml_pos >= self.yaml_input.byte_len()

    String peek(self):
        if self.yaml_pos < self.yaml_input.byte_len():
            return self.yaml_input.char_at(self.yaml_pos)
        return '\0'

    String peek_at(self, int offset):
        int yaml_idx = self.yaml_pos + offset
        if yaml_idx >= 0 and yaml_idx < self.yaml_input.byte_len():
            return self.yaml_input.char_at(yaml_idx)
        return '\0'

    void advance(&self):
        if self.yaml_pos < self.yaml_input.byte_len():
            self.yaml_pos = self.yaml_pos + 1

    # Skip spaces only (not newlines — they're significant in YAML)
    void skip_spaces(&self):
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_ch = self.yaml_input.char_at(self.yaml_pos)
            if yaml_ch == ' ' or yaml_ch == '\t':
                self.yaml_pos = self.yaml_pos + 1
            else:
                return

    # Skip spaces and comments to end of line
    void skip_to_eol(&self):
        self.skip_spaces()
        if self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) == '#':
            while self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) != '\n':
                self.yaml_pos = self.yaml_pos + 1

    # Skip blank lines (empty or comment-only) and consume their newlines
    void skip_blank_lines(&self):
        while self.yaml_pos < self.yaml_input.byte_len():
            int yaml_saved = self.yaml_pos
            self.skip_spaces()
            if self.yaml_pos >= self.yaml_input.byte_len():
                return
            String yaml_ch = self.yaml_input.char_at(self.yaml_pos)
            if yaml_ch == '\n':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ch == '\r':
                self.yaml_pos = self.yaml_pos + 1
                if self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) == '\n':
                    self.yaml_pos = self.yaml_pos + 1
            elif yaml_ch == '#':
                while self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) != '\n':
                    self.yaml_pos = self.yaml_pos + 1
                if self.yaml_pos < self.yaml_input.byte_len():
                    self.yaml_pos = self.yaml_pos + 1
            else:
                self.yaml_pos = yaml_saved
                return

    # Count leading spaces at the current line position
    int current_indent(self):
        int yaml_cnt = 0
        int yaml_idx = self.yaml_pos
        while yaml_idx < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_idx) == ' ':
            yaml_cnt = yaml_cnt + 1
            yaml_idx = yaml_idx + 1
        return yaml_cnt

    # Consume a newline (CR, LF, or CRLF)
    void consume_newline(&self):
        if self.yaml_pos < self.yaml_input.byte_len():
            if self.yaml_input.char_at(self.yaml_pos) == '\n':
                self.yaml_pos = self.yaml_pos + 1
            elif self.yaml_input.char_at(self.yaml_pos) == '\r':
                self.yaml_pos = self.yaml_pos + 1
                if self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) == '\n':
                    self.yaml_pos = self.yaml_pos + 1

    bool is_newline(self):
        if self.yaml_pos >= self.yaml_input.byte_len():
            return true
        String yaml_ch = self.yaml_input.char_at(self.yaml_pos)
        return yaml_ch == '\n' or yaml_ch == '\r'

    # Check if current position is at a document marker (--- or ...)
    bool is_doc_marker(self):
        if self.yaml_pos + 2 >= self.yaml_input.byte_len():
            return false
        String yaml_m0 = self.yaml_input.char_at(self.yaml_pos)
        String yaml_m1 = self.yaml_input.char_at(self.yaml_pos + 1)
        String yaml_m2 = self.yaml_input.char_at(self.yaml_pos + 2)
        bool yaml_is_three = false
        if yaml_m0 == '-' and yaml_m1 == '-' and yaml_m2 == '-':
            yaml_is_three = true
        if yaml_m0 == '.' and yaml_m1 == '.' and yaml_m2 == '.':
            yaml_is_three = true
        if not yaml_is_three:
            return false
        # Must be followed by whitespace, newline, or EOF
        if self.yaml_pos + 3 >= self.yaml_input.byte_len():
            return true
        String yaml_after = self.yaml_input.char_at(self.yaml_pos + 3)
        return yaml_after == ' ' or yaml_after == '\t' or yaml_after == '\n' or yaml_after == '\r'

    # ── Anchor/alias helpers ─────────────────────────────────

    # Read anchor name after '&' — alphanumeric, '-', '_'
    String parse_anchor_name(&self):
        int yaml_astart = self.yaml_pos
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_ac = self.yaml_input.char_at(self.yaml_pos)
            if yaml_ac >= 'a' and yaml_ac <= 'z':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac >= 'A' and yaml_ac <= 'Z':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac >= '0' and yaml_ac <= '9':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac == '-' or yaml_ac == '_':
                self.yaml_pos = self.yaml_pos + 1
            else:
                break
        if self.yaml_pos == yaml_astart:
            self.fail("empty anchor name")
            return ""
        String yaml_aname = self.yaml_input.byte_slice(yaml_astart, self.yaml_pos)
        self.skip_spaces()
        return yaml_aname

    # Read alias name after '*' — same char set as anchors
    String parse_alias_name(&self):
        int yaml_astart = self.yaml_pos
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_ac = self.yaml_input.char_at(self.yaml_pos)
            if yaml_ac >= 'a' and yaml_ac <= 'z':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac >= 'A' and yaml_ac <= 'Z':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac >= '0' and yaml_ac <= '9':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_ac == '-' or yaml_ac == '_':
                self.yaml_pos = self.yaml_pos + 1
            else:
                break
        if self.yaml_pos == yaml_astart:
            self.fail("empty alias name")
            return ""
        return self.yaml_input.byte_slice(yaml_astart, self.yaml_pos)

    # Store an anchor value
    void anchor_put(&self, String yaml_aname, Yaml !yaml_aval):
        # Overwrite if already exists
        int yaml_ai = 0
        while yaml_ai < self.yaml_anc_names.len():
            if self.yaml_anc_names.get(yaml_ai).unwrap() == yaml_aname:
                self.yaml_anc_vals.set(yaml_ai, yaml_aval)
                return
            yaml_ai = yaml_ai + 1
        self.yaml_anc_names.push(yaml_aname)
        self.yaml_anc_vals.push(yaml_aval)

    # Retrieve an anchor value, or Null if not found
    Yaml anchor_get(self, String yaml_aname):
        int yaml_ai = 0
        while yaml_ai < self.yaml_anc_names.len():
            if self.yaml_anc_names.get(yaml_ai).unwrap() == yaml_aname:
                return self.yaml_anc_vals.get(yaml_ai).unwrap()
            yaml_ai = yaml_ai + 1
        return Null()

    # Check if an anchor exists
    bool anchor_has(self, String yaml_aname):
        int yaml_ai = 0
        while yaml_ai < self.yaml_anc_names.len():
            if self.yaml_anc_names.get(yaml_ai).unwrap() == yaml_aname:
                return true
            yaml_ai = yaml_ai + 1
        return false

    # Clear all anchors (per-document)
    void anchor_clear(&self):
        self.yaml_anc_names.clear()
        self.yaml_anc_vals.clear()

    # ── Document parsing ─────────────────────────────────────

    Yaml parse_document(&self):
        self.anchor_clear()
        self.skip_blank_lines()
        # Skip optional --- marker
        if self.yaml_pos + 2 < self.yaml_input.byte_len():
            if self.yaml_input.char_at(self.yaml_pos) == '-' and self.yaml_input.char_at(self.yaml_pos + 1) == '-' and self.yaml_input.char_at(self.yaml_pos + 2) == '-':
                self.yaml_pos = self.yaml_pos + 3
                self.skip_to_eol()
                if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                    self.consume_newline()
        self.skip_blank_lines()
        if self.at_end():
            return Null()
        # Check for document end/start markers before parsing content
        if self.is_doc_marker():
            return Null()
        Yaml yaml_doc = self.parse_block_value(0)
        # Skip optional ... marker
        self.skip_blank_lines()
        if self.yaml_pos + 2 < self.yaml_input.byte_len():
            if self.yaml_input.char_at(self.yaml_pos) == '.' and self.yaml_input.char_at(self.yaml_pos + 1) == '.' and self.yaml_input.char_at(self.yaml_pos + 2) == '.':
                self.yaml_pos = self.yaml_pos + 3
                self.skip_to_eol()
                if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                    self.consume_newline()
        return yaml_doc

    Vector[Yaml] parse_all_documents(&self):
        Vector[Yaml] yaml_docs = Vector[Yaml]()
        while not self.at_end() and not self.failed():
            self.skip_blank_lines()
            if self.at_end():
                break
            int yaml_saved = self.yaml_pos
            Yaml yaml_doc = self.parse_document()
            if self.failed():
                break
            yaml_docs.push(!yaml_doc)
            # Safety: break if no progress to avoid infinite loop
            if self.yaml_pos <= yaml_saved:
                break
        return yaml_docs

    # ── Block value dispatch ─────────────────────────────────

    Yaml parse_block_value(&self, int min_indent):
        self.skip_blank_lines()
        if self.at_end() or self.failed():
            return Null()
        int yaml_indent = self.current_indent()
        if yaml_indent < min_indent:
            return Null()
        # Check first significant character
        int yaml_sig = self.yaml_pos + yaml_indent
        if yaml_sig >= self.yaml_input.byte_len():
            return Null()
        String yaml_fc = self.yaml_input.char_at(yaml_sig)
        # Alias (*name) — resolve from stored anchors
        if yaml_fc == '*':
            self.yaml_pos = yaml_sig + 1
            String yaml_alias = self.parse_alias_name()
            if self.failed():
                return Null()
            self.skip_to_eol()
            if not self.at_end() and self.is_newline():
                self.consume_newline()
            if not self.anchor_has(yaml_alias):
                self.fail("undefined alias")
                return Null()
            return self.anchor_get(yaml_alias)
        # Anchor (&name) — parse tagged value and store
        if yaml_fc == '&':
            self.yaml_pos = yaml_sig + 1
            String yaml_anchor = self.parse_anchor_name()
            if self.failed():
                return Null()
            Yaml yaml_aval = self.parse_block_value(min_indent)
            self.anchor_put(yaml_anchor, !yaml_aval)
            return self.anchor_get(yaml_anchor)
        # Flow collections
        if yaml_fc == '{':
            self.yaml_pos = yaml_sig
            return self.parse_flow_mapping()
        if yaml_fc == '[':
            self.yaml_pos = yaml_sig
            return self.parse_flow_sequence()
        # Try block mapping: look for a key: pattern (check before quoted scalars
        # so that quoted keys like "key": value are parsed as mappings)
        if self.looks_like_mapping(yaml_sig):
            return self.parse_block_mapping(min_indent)
        # Quoted scalars at block level
        if yaml_fc == '"':
            self.yaml_pos = yaml_sig
            String yaml_dq = self.parse_double_quoted()
            self.skip_to_eol()
            if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                self.consume_newline()
            return Str(yaml_dq)
        if yaml_fc == '\'':
            self.yaml_pos = yaml_sig
            String yaml_sq = self.parse_single_quoted()
            self.skip_to_eol()
            if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                self.consume_newline()
            return Str(yaml_sq)
        # Block sequence (starts with -)
        if yaml_fc == '-' and yaml_sig + 1 < self.yaml_input.byte_len():
            String yaml_after_dash = self.yaml_input.char_at(yaml_sig + 1)
            if yaml_after_dash == ' ' or yaml_after_dash == '\n' or yaml_after_dash == '\r':
                return self.parse_block_sequence(min_indent)
        # Block scalars
        if yaml_fc == '|':
            self.yaml_pos = yaml_sig + 1
            return self.parse_block_scalar(true)
        if yaml_fc == '>':
            self.yaml_pos = yaml_sig + 1
            return self.parse_block_scalar(false)
        # Plain scalar
        self.yaml_pos = yaml_sig
        return self.parse_plain_scalar(min_indent)

    # Check if position looks like a mapping key (scan for unquoted colon followed by space/eol)
    bool looks_like_mapping(self, int yaml_from):
        int yaml_scan = yaml_from
        # Check for quoted key
        if yaml_scan < self.yaml_input.byte_len():
            String yaml_qc = self.yaml_input.char_at(yaml_scan)
            if yaml_qc == '"' or yaml_qc == '\'':
                # Skip quoted string to find colon after it
                String yaml_quote = yaml_qc
                yaml_scan = yaml_scan + 1
                while yaml_scan < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_scan) != yaml_quote:
                    if self.yaml_input.char_at(yaml_scan) == '\\' and yaml_quote == '"':
                        yaml_scan = yaml_scan + 1
                    yaml_scan = yaml_scan + 1
                if yaml_scan < self.yaml_input.byte_len():
                    yaml_scan = yaml_scan + 1
                # Skip spaces after quoted key
                while yaml_scan < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_scan) == ' ':
                    yaml_scan = yaml_scan + 1
                if yaml_scan < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_scan) == ':':
                    if yaml_scan + 1 >= self.yaml_input.byte_len():
                        return true
                    String yaml_ac = self.yaml_input.char_at(yaml_scan + 1)
                    if yaml_ac == ' ' or yaml_ac == '\n' or yaml_ac == '\r':
                        return true
                return false
        while yaml_scan < self.yaml_input.byte_len():
            String yaml_sc = self.yaml_input.char_at(yaml_scan)
            if yaml_sc == ':':
                if yaml_scan + 1 >= self.yaml_input.byte_len():
                    return true
                String yaml_ac = self.yaml_input.char_at(yaml_scan + 1)
                if yaml_ac == ' ' or yaml_ac == '\n' or yaml_ac == '\r':
                    return true
            if yaml_sc == '\n' or yaml_sc == '\r' or yaml_sc == '#':
                return false
            yaml_scan = yaml_scan + 1
        return false

    # ── Block mapping ────────────────────────────────────────

    Yaml parse_block_mapping(&self, int min_indent):
        Dict[String, Yaml] yaml_map = Dict[String, Yaml]()
        self.skip_blank_lines()
        int yaml_map_indent = self.current_indent()
        if yaml_map_indent < min_indent:
            return Map(yaml_map)
        while not self.at_end() and not self.failed():
            self.skip_blank_lines()
            if self.at_end():
                break
            int yaml_line_indent = self.current_indent()
            if yaml_line_indent < yaml_map_indent:
                break
            if yaml_line_indent > yaml_map_indent:
                break
            # Check for document markers (--- or ...) at column 0
            if yaml_line_indent == 0 and self.is_doc_marker():
                break
            self.yaml_pos = self.yaml_pos + yaml_line_indent
            # Parse the key
            String yaml_key = self.parse_key()
            if self.failed():
                return Null()
            # Expect colon
            if self.yaml_pos >= self.yaml_input.byte_len() or self.yaml_input.char_at(self.yaml_pos) != ':':
                self.fail("expected ':' after mapping key")
                return Null()
            self.yaml_pos = self.yaml_pos + 1
            # Value: inline or next-line
            self.skip_spaces()
            Yaml yaml_val = Null()
            if self.at_end() or self.is_newline():
                # Value on next line, indented deeper
                if not self.at_end():
                    self.consume_newline()
                yaml_val = self.parse_block_value(yaml_map_indent + 1)
            elif self.yaml_input.char_at(self.yaml_pos) == '#':
                # Comment after colon — value on next line
                self.skip_to_eol()
                if not self.at_end():
                    self.consume_newline()
                yaml_val = self.parse_block_value(yaml_map_indent + 1)
            else:
                # Inline value
                yaml_val = self.parse_inline_value(yaml_map_indent)
            if yaml_key == "<<":
                merge_into(&yaml_map, !yaml_val)
            else:
                yaml_map.put(yaml_key, !yaml_val)
        return Map(yaml_map)

    # Parse a mapping key (bare, double-quoted, or single-quoted)
    String parse_key(&self):
        if self.yaml_pos >= self.yaml_input.byte_len():
            self.fail("expected key")
            return ""
        String yaml_kc = self.yaml_input.char_at(self.yaml_pos)
        if yaml_kc == '"':
            return self.parse_double_quoted()
        if yaml_kc == '\'':
            return self.parse_single_quoted()
        # Bare key: read until colon-space or colon-eol
        int yaml_start = self.yaml_pos
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_bc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_bc == ':':
                # Check if followed by space, eol, or end
                if self.yaml_pos + 1 >= self.yaml_input.byte_len():
                    break
                String yaml_after = self.yaml_input.char_at(self.yaml_pos + 1)
                if yaml_after == ' ' or yaml_after == '\n' or yaml_after == '\r':
                    break
            if yaml_bc == '\n' or yaml_bc == '\r':
                break
            self.yaml_pos = self.yaml_pos + 1
        # Trim trailing spaces from key
        int yaml_end = self.yaml_pos
        while yaml_end > yaml_start and self.yaml_input.char_at(yaml_end - 1) == ' ':
            yaml_end = yaml_end - 1
        if yaml_end <= yaml_start:
            self.fail("empty key")
            return ""
        return self.yaml_input.byte_slice(yaml_start, yaml_end)

    # ── Block sequence ───────────────────────────────────────

    Yaml parse_block_sequence(&self, int min_indent):
        Vector[Yaml] yaml_items = Vector[Yaml]()
        self.skip_blank_lines()
        int yaml_seq_indent = self.current_indent()
        if yaml_seq_indent < min_indent:
            return Seq(yaml_items)
        while not self.at_end() and not self.failed():
            self.skip_blank_lines()
            if self.at_end():
                break
            int yaml_line_indent = self.current_indent()
            if yaml_line_indent < yaml_seq_indent:
                break
            if yaml_line_indent > yaml_seq_indent:
                break
            # Check for document markers (--- or ...) at column 0
            if yaml_line_indent == 0 and self.is_doc_marker():
                break
            # Must see '- ' at this indent level
            int yaml_dash_pos = self.yaml_pos + yaml_seq_indent
            if yaml_dash_pos >= self.yaml_input.byte_len() or self.yaml_input.char_at(yaml_dash_pos) != '-':
                break
            if yaml_dash_pos + 1 < self.yaml_input.byte_len():
                String yaml_after_d = self.yaml_input.char_at(yaml_dash_pos + 1)
                if yaml_after_d != ' ' and yaml_after_d != '\n' and yaml_after_d != '\r':
                    break
            # Skip "- "
            self.yaml_pos = yaml_dash_pos + 1
            if self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) == ' ':
                self.yaml_pos = self.yaml_pos + 1
            # Parse item value
            if self.at_end() or self.is_newline():
                if not self.at_end():
                    self.consume_newline()
                Yaml yaml_item_val = self.parse_block_value(yaml_seq_indent + 1)
                yaml_items.push(!yaml_item_val)
            else:
                Yaml yaml_item_val = self.parse_inline_value(yaml_seq_indent)
                yaml_items.push(!yaml_item_val)
        return Seq(yaml_items)

    # ── Inline value (after ': ' or '- ' on same line) ───────

    Yaml parse_inline_value(&self, int yaml_ctx_indent):
        if self.at_end() or self.failed():
            return Null()
        String yaml_ic = self.yaml_input.char_at(self.yaml_pos)
        # Alias (*name)
        if yaml_ic == '*':
            self.yaml_pos = self.yaml_pos + 1
            String yaml_alias = self.parse_alias_name()
            if self.failed():
                return Null()
            self.skip_to_eol()
            if not self.at_end() and self.is_newline():
                self.consume_newline()
            if not self.anchor_has(yaml_alias):
                self.fail("undefined alias")
                return Null()
            return self.anchor_get(yaml_alias)
        # Anchor (&name)
        if yaml_ic == '&':
            self.yaml_pos = self.yaml_pos + 1
            String yaml_anchor = self.parse_anchor_name()
            if self.failed():
                return Null()
            # If at end of line, the anchored value is a block value on the next line
            if self.at_end() or self.is_newline():
                if not self.at_end():
                    self.consume_newline()
                Yaml yaml_aval = self.parse_block_value(yaml_ctx_indent + 1)
                self.anchor_put(yaml_anchor, !yaml_aval)
                return self.anchor_get(yaml_anchor)
            Yaml yaml_aval = self.parse_inline_value(yaml_ctx_indent)
            self.anchor_put(yaml_anchor, !yaml_aval)
            return self.anchor_get(yaml_anchor)
        if yaml_ic == '{':
            return self.parse_flow_mapping()
        if yaml_ic == '[':
            return self.parse_flow_sequence()
        if yaml_ic == '"':
            String yaml_dq = self.parse_double_quoted()
            self.skip_to_eol()
            if not self.at_end() and self.is_newline():
                self.consume_newline()
            return Str(yaml_dq)
        if yaml_ic == '\'':
            String yaml_sq = self.parse_single_quoted()
            self.skip_to_eol()
            if not self.at_end() and self.is_newline():
                self.consume_newline()
            return Str(yaml_sq)
        # Block scalars
        if yaml_ic == '|':
            self.yaml_pos = self.yaml_pos + 1
            return self.parse_block_scalar(true)
        if yaml_ic == '>':
            self.yaml_pos = self.yaml_pos + 1
            return self.parse_block_scalar(false)
        # Plain scalar
        return self.parse_plain_scalar(yaml_ctx_indent)

    # ── Flow mapping {key: value, ...} ──────────────────────

    Yaml parse_flow_mapping(&self):
        self.yaml_pos = self.yaml_pos + 1
        self.skip_flow_ws()
        Dict[String, Yaml] yaml_fmap = Dict[String, Yaml]()
        if not self.at_end() and self.yaml_input.char_at(self.yaml_pos) == '}':
            self.yaml_pos = self.yaml_pos + 1
            return Map(yaml_fmap)
        while not self.at_end() and not self.failed():
            self.skip_flow_ws()
            # Parse key
            String yaml_fkey = self.parse_flow_key()
            if self.failed():
                return Null()
            self.skip_flow_ws()
            if self.at_end() or self.yaml_input.char_at(self.yaml_pos) != ':':
                self.fail("expected ':' in flow mapping")
                return Null()
            self.yaml_pos = self.yaml_pos + 1
            self.skip_flow_ws()
            # Parse value
            Yaml yaml_fval = self.parse_flow_value()
            if self.failed():
                return Null()
            if yaml_fkey == "<<":
                merge_into(&yaml_fmap, !yaml_fval)
            else:
                yaml_fmap.put(yaml_fkey, !yaml_fval)
            self.skip_flow_ws()
            if self.at_end():
                self.fail("unterminated flow mapping")
                return Null()
            if self.yaml_input.char_at(self.yaml_pos) == ',':
                self.yaml_pos = self.yaml_pos + 1
            elif self.yaml_input.char_at(self.yaml_pos) == '}':
                self.yaml_pos = self.yaml_pos + 1
                return Map(yaml_fmap)
            else:
                self.fail("expected ',' or '}' in flow mapping")
                return Null()
        self.fail("unterminated flow mapping")
        return Null()

    # ── Flow sequence [item, ...] ────────────────────────────

    Yaml parse_flow_sequence(&self):
        self.yaml_pos = self.yaml_pos + 1
        self.skip_flow_ws()
        Vector[Yaml] yaml_fitems = Vector[Yaml]()
        if not self.at_end() and self.yaml_input.char_at(self.yaml_pos) == ']':
            self.yaml_pos = self.yaml_pos + 1
            return Seq(yaml_fitems)
        while not self.at_end() and not self.failed():
            self.skip_flow_ws()
            Yaml yaml_fitem = self.parse_flow_value()
            if self.failed():
                return Null()
            yaml_fitems.push(!yaml_fitem)
            self.skip_flow_ws()
            if self.at_end():
                self.fail("unterminated flow sequence")
                return Null()
            if self.yaml_input.char_at(self.yaml_pos) == ',':
                self.yaml_pos = self.yaml_pos + 1
            elif self.yaml_input.char_at(self.yaml_pos) == ']':
                self.yaml_pos = self.yaml_pos + 1
                return Seq(yaml_fitems)
            else:
                self.fail("expected ',' or ']' in flow sequence")
                return Null()
        self.fail("unterminated flow sequence")
        return Null()

    # Skip whitespace in flow context (spaces, tabs, newlines)
    void skip_flow_ws(&self):
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_fc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_fc == ' ' or yaml_fc == '\t' or yaml_fc == '\n' or yaml_fc == '\r':
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_fc == '#':
                while self.yaml_pos < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos) != '\n':
                    self.yaml_pos = self.yaml_pos + 1
            else:
                return

    # Parse a key in flow context
    String parse_flow_key(&self):
        if self.at_end():
            self.fail("expected flow key")
            return ""
        String yaml_fkc = self.yaml_input.char_at(self.yaml_pos)
        if yaml_fkc == '"':
            return self.parse_double_quoted()
        if yaml_fkc == '\'':
            return self.parse_single_quoted()
        # Bare flow key: read until : , } ] or newline
        int yaml_start = self.yaml_pos
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_bc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_bc == ':' or yaml_bc == ',' or yaml_bc == '}' or yaml_bc == ']':
                break
            if yaml_bc == '\n' or yaml_bc == '\r':
                break
            self.yaml_pos = self.yaml_pos + 1
        int yaml_end = self.yaml_pos
        while yaml_end > yaml_start and self.yaml_input.char_at(yaml_end - 1) == ' ':
            yaml_end = yaml_end - 1
        return self.yaml_input.byte_slice(yaml_start, yaml_end)

    # Parse a value in flow context
    Yaml parse_flow_value(&self):
        if self.at_end() or self.failed():
            return Null()
        String yaml_fvc = self.yaml_input.char_at(self.yaml_pos)
        # Alias (*name) in flow context
        if yaml_fvc == '*':
            self.yaml_pos = self.yaml_pos + 1
            String yaml_alias = self.parse_alias_name()
            if self.failed():
                return Null()
            if not self.anchor_has(yaml_alias):
                self.fail("undefined alias")
                return Null()
            return self.anchor_get(yaml_alias)
        # Anchor (&name) in flow context
        if yaml_fvc == '&':
            self.yaml_pos = self.yaml_pos + 1
            String yaml_anchor = self.parse_anchor_name()
            if self.failed():
                return Null()
            Yaml yaml_aval = self.parse_flow_value()
            self.anchor_put(yaml_anchor, !yaml_aval)
            return self.anchor_get(yaml_anchor)
        if yaml_fvc == '{':
            return self.parse_flow_mapping()
        if yaml_fvc == '[':
            return self.parse_flow_sequence()
        if yaml_fvc == '"':
            String yaml_dq = self.parse_double_quoted()
            return Str(yaml_dq)
        if yaml_fvc == '\'':
            String yaml_sq = self.parse_single_quoted()
            return Str(yaml_sq)
        # Plain scalar in flow context (stops at , } ] : )
        int yaml_start = self.yaml_pos
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_pc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_pc == ',' or yaml_pc == '}' or yaml_pc == ']':
                break
            if yaml_pc == ':':
                if self.yaml_pos + 1 < self.yaml_input.byte_len():
                    String yaml_nxt = self.yaml_input.char_at(self.yaml_pos + 1)
                    if yaml_nxt == ' ' or yaml_nxt == ',' or yaml_nxt == '}' or yaml_nxt == ']':
                        break
                else:
                    break
            if yaml_pc == '\n' or yaml_pc == '\r':
                break
            if yaml_pc == '#':
                # Only a comment if preceded by space
                if self.yaml_pos > yaml_start and self.yaml_input.char_at(self.yaml_pos - 1) == ' ':
                    break
            self.yaml_pos = self.yaml_pos + 1
        int yaml_end = self.yaml_pos
        while yaml_end > yaml_start and self.yaml_input.char_at(yaml_end - 1) == ' ':
            yaml_end = yaml_end - 1
        String yaml_text = self.yaml_input.byte_slice(yaml_start, yaml_end)
        return resolve_scalar(yaml_text)

    # ── Double-quoted string ─────────────────────────────────

    String parse_double_quoted(&self):
        self.yaml_pos = self.yaml_pos + 1
        String yaml_dq_result = ""
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_dc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_dc == '"':
                self.yaml_pos = self.yaml_pos + 1
                return yaml_dq_result
            if yaml_dc == '\\':
                self.yaml_pos = self.yaml_pos + 1
                if self.yaml_pos >= self.yaml_input.byte_len():
                    self.fail("unterminated string escape")
                    return ""
                String yaml_esc = self.yaml_input.char_at(self.yaml_pos)
                self.yaml_pos = self.yaml_pos + 1
                if yaml_esc == '"':
                    yaml_dq_result = yaml_dq_result + "\""
                elif yaml_esc == '\\':
                    yaml_dq_result = yaml_dq_result + "\\"
                elif yaml_esc == 'n':
                    yaml_dq_result = yaml_dq_result + "\n"
                elif yaml_esc == 't':
                    yaml_dq_result = yaml_dq_result + "\t"
                elif yaml_esc == 'r':
                    yaml_dq_result = yaml_dq_result + "\r"
                elif yaml_esc == '/':
                    yaml_dq_result = yaml_dq_result + "/"
                elif yaml_esc == '0':
                    yaml_dq_result = yaml_dq_result + "\0"
                elif yaml_esc == ' ':
                    yaml_dq_result = yaml_dq_result + " "
                else:
                    self.fail("unknown escape sequence")
                    return ""
            else:
                yaml_dq_result = yaml_dq_result + yaml_dc
                self.yaml_pos = self.yaml_pos + 1
        self.fail("unterminated double-quoted string")
        return ""

    # ── Single-quoted string ─────────────────────────────────

    String parse_single_quoted(&self):
        self.yaml_pos = self.yaml_pos + 1
        String yaml_sq_result = ""
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_sc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_sc == '\'':
                # '' is an escaped single quote
                if self.yaml_pos + 1 < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos + 1) == '\'':
                    yaml_sq_result = yaml_sq_result + "'"
                    self.yaml_pos = self.yaml_pos + 2
                else:
                    self.yaml_pos = self.yaml_pos + 1
                    return yaml_sq_result
            else:
                yaml_sq_result = yaml_sq_result + yaml_sc
                self.yaml_pos = self.yaml_pos + 1
        self.fail("unterminated single-quoted string")
        return ""

    # ── Plain scalar ─────────────────────────────────────────

    Yaml parse_plain_scalar(&self, int min_indent):
        int yaml_start = self.yaml_pos
        # Read until end of line, comment, or flow indicators
        while self.yaml_pos < self.yaml_input.byte_len():
            String yaml_pc = self.yaml_input.char_at(self.yaml_pos)
            if yaml_pc == '\n' or yaml_pc == '\r':
                break
            if yaml_pc == ':':
                if self.yaml_pos + 1 < self.yaml_input.byte_len():
                    String yaml_nxt = self.yaml_input.char_at(self.yaml_pos + 1)
                    if yaml_nxt == ' ' or yaml_nxt == '\n' or yaml_nxt == '\r':
                        break
                else:
                    break
            if yaml_pc == '#':
                if self.yaml_pos > yaml_start and self.yaml_input.char_at(self.yaml_pos - 1) == ' ':
                    break
            self.yaml_pos = self.yaml_pos + 1
        int yaml_end = self.yaml_pos
        while yaml_end > yaml_start and self.yaml_input.char_at(yaml_end - 1) == ' ':
            yaml_end = yaml_end - 1
        String yaml_first_line = self.yaml_input.byte_slice(yaml_start, yaml_end)
        # Consume newline
        if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
            self.consume_newline()
        # Check for multi-line continuation
        String yaml_text = yaml_first_line
        bool yaml_has_continuation = false
        while not self.at_end():
            # Peek at next line indent
            int yaml_next_indent = self.current_indent()
            if yaml_next_indent <= min_indent:
                break
            # Check if it's a blank line
            int yaml_peek_pos = self.yaml_pos + yaml_next_indent
            if yaml_peek_pos >= self.yaml_input.byte_len():
                break
            String yaml_next_ch = self.yaml_input.char_at(yaml_peek_pos)
            if yaml_next_ch == '\n' or yaml_next_ch == '\r':
                # Blank continuation line — preserve as paragraph break
                yaml_text = yaml_text + "\n"
                self.yaml_pos = yaml_peek_pos
                self.consume_newline()
                yaml_has_continuation = true
            else:
                # Check if it looks like a mapping key or sequence item
                if yaml_next_ch == '-':
                    if yaml_peek_pos + 1 < self.yaml_input.byte_len():
                        String yaml_ad = self.yaml_input.char_at(yaml_peek_pos + 1)
                        if yaml_ad == ' ' or yaml_ad == '\n' or yaml_ad == '\r':
                            break
                if self.looks_like_mapping(yaml_peek_pos):
                    break
                # Check for document markers
                if yaml_next_indent == 0 and self.is_doc_marker():
                    break
                # It's a continuation line — fold with space
                self.yaml_pos = yaml_peek_pos
                int yaml_cont_start = self.yaml_pos
                while self.yaml_pos < self.yaml_input.byte_len():
                    String yaml_cc = self.yaml_input.char_at(self.yaml_pos)
                    if yaml_cc == '\n' or yaml_cc == '\r':
                        break
                    if yaml_cc == ':':
                        if self.yaml_pos + 1 < self.yaml_input.byte_len():
                            String yaml_cn = self.yaml_input.char_at(self.yaml_pos + 1)
                            if yaml_cn == ' ' or yaml_cn == '\n' or yaml_cn == '\r':
                                break
                        else:
                            break
                    if yaml_cc == '#':
                        if self.yaml_pos > yaml_cont_start and self.yaml_input.char_at(self.yaml_pos - 1) == ' ':
                            break
                    self.yaml_pos = self.yaml_pos + 1
                int yaml_cont_end = self.yaml_pos
                while yaml_cont_end > yaml_cont_start and self.yaml_input.char_at(yaml_cont_end - 1) == ' ':
                    yaml_cont_end = yaml_cont_end - 1
                String yaml_cont_line = self.yaml_input.byte_slice(yaml_cont_start, yaml_cont_end)
                yaml_text = yaml_text + " " + yaml_cont_line
                yaml_has_continuation = true
                if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                    self.consume_newline()
        # Multi-line plain scalars are always strings (never resolved to int/bool/null)
        if yaml_has_continuation:
            return Str(yaml_text)
        return resolve_scalar(yaml_text)

    # ── Block scalar (literal | and folded >) ─────────────────

    Yaml parse_block_scalar(&self, bool yaml_is_literal):
        # Parse header: optional chomping indicator and explicit indent
        # chomping: 0 = clip (default), 1 = strip (-), 2 = keep (+)
        int yaml_chomp = 0
        int yaml_explicit_indent = 0
        # Read optional chomping and indent indicators (order flexible)
        while self.yaml_pos < self.yaml_input.byte_len():
            byte yaml_hc = self.yaml_input.byte_at(self.yaml_pos)
            if yaml_hc == b'+':
                yaml_chomp = 2
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_hc == b'-':
                yaml_chomp = 1
                self.yaml_pos = self.yaml_pos + 1
            elif yaml_hc >= b'1' and yaml_hc <= b'9':
                yaml_explicit_indent = yaml_hc as int - b'0'
                self.yaml_pos = self.yaml_pos + 1
            else:
                break
        # Skip to end of line (remaining chars incl. comments)
        self.skip_to_eol()
        # Consume newline after header
        if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
            self.consume_newline()
        # Determine content indent from first non-empty line (if not explicit)
        int yaml_content_indent = yaml_explicit_indent
        if yaml_content_indent == 0:
            # Find first non-empty line to determine indent
            int yaml_probe = self.yaml_pos
            while yaml_probe < self.yaml_input.byte_len():
                # Count spaces at this line
                int yaml_sp = 0
                while yaml_probe + yaml_sp < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_probe + yaml_sp) == ' ':
                    yaml_sp = yaml_sp + 1
                if yaml_probe + yaml_sp < self.yaml_input.byte_len():
                    String yaml_lc = self.yaml_input.char_at(yaml_probe + yaml_sp)
                    if yaml_lc != '\n' and yaml_lc != '\r':
                        # Found non-empty line
                        yaml_content_indent = yaml_sp
                        break
                # Skip this empty line
                while yaml_probe < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_probe) != '\n':
                    yaml_probe = yaml_probe + 1
                if yaml_probe < self.yaml_input.byte_len():
                    yaml_probe = yaml_probe + 1
        if yaml_content_indent == 0:
            # No content lines found
            return Str("")
        # Collect content lines
        Vector[String] yaml_lines = Vector[String]()
        while self.yaml_pos < self.yaml_input.byte_len():
            # Count leading spaces
            int yaml_sp = 0
            while self.yaml_pos + yaml_sp < self.yaml_input.byte_len() and self.yaml_input.char_at(self.yaml_pos + yaml_sp) == ' ':
                yaml_sp = yaml_sp + 1
            # Check if this is an empty/blank line
            if self.yaml_pos + yaml_sp >= self.yaml_input.byte_len():
                # EOF after spaces — treat as empty line
                yaml_lines.push("")
                self.yaml_pos = self.yaml_pos + yaml_sp
                break
            String yaml_lc = self.yaml_input.char_at(self.yaml_pos + yaml_sp)
            if yaml_lc == '\n' or yaml_lc == '\r':
                # Empty line — preserve it
                yaml_lines.push("")
                self.yaml_pos = self.yaml_pos + yaml_sp
                self.consume_newline()
            elif yaml_sp < yaml_content_indent:
                # Non-empty line with less indent — end of block scalar
                break
            else:
                # Content line — strip content_indent leading spaces
                int yaml_line_start = self.yaml_pos + yaml_content_indent
                int yaml_line_end = yaml_line_start
                while yaml_line_end < self.yaml_input.byte_len() and self.yaml_input.char_at(yaml_line_end) != '\n' and self.yaml_input.char_at(yaml_line_end) != '\r':
                    yaml_line_end = yaml_line_end + 1
                String yaml_line = self.yaml_input.byte_slice(yaml_line_start, yaml_line_end)
                yaml_lines.push(yaml_line)
                self.yaml_pos = yaml_line_end
                if self.yaml_pos < self.yaml_input.byte_len() and self.is_newline():
                    self.consume_newline()
        # Strip trailing empty lines and count them
        int yaml_trailing = 0
        while yaml_lines.len() > 0:
            String yaml_last = yaml_lines.get(yaml_lines.len() - 1).unwrap()
            if yaml_last == "":
                yaml_trailing = yaml_trailing + 1
                yaml_lines.pop()
            else:
                break
        # Assemble result based on literal vs folded
        String yaml_result = ""
        if yaml_is_literal:
            # Literal: join lines with newlines, preserving everything
            int yaml_li = 0
            while yaml_li < yaml_lines.len():
                if yaml_li > 0:
                    yaml_result = yaml_result + "\n"
                yaml_result = yaml_result + yaml_lines.get(yaml_li).unwrap()
                yaml_li = yaml_li + 1
        else:
            # Folded: fold consecutive non-blank lines at content indent
            # More-indented lines preserved literally
            # Blank lines = paragraph breaks
            int yaml_li = 0
            while yaml_li < yaml_lines.len():
                String yaml_fl = yaml_lines.get(yaml_li).unwrap()
                if yaml_fl == "":
                    # Blank line — paragraph break
                    yaml_result = yaml_result + "\n"
                elif yaml_fl.byte_len() > 0 and yaml_fl.char_at(0) == ' ':
                    # More-indented line — preserve literally
                    if yaml_li > 0:
                        yaml_result = yaml_result + "\n"
                    yaml_result = yaml_result + yaml_fl
                else:
                    # Normal line — fold with previous normal line
                    if yaml_li > 0:
                        String yaml_prev = yaml_lines.get(yaml_li - 1).unwrap()
                        if yaml_prev == "":
                            # After blank line
                            yaml_result = yaml_result + "\n"
                        elif yaml_prev.byte_len() > 0 and yaml_prev.char_at(0) == ' ':
                            # After more-indented line
                            yaml_result = yaml_result + "\n"
                        else:
                            # After normal line — fold
                            yaml_result = yaml_result + " "
                    yaml_result = yaml_result + yaml_fl
                yaml_li = yaml_li + 1
        # Apply chomping
        if yaml_chomp == 0:
            # Clip — exactly one trailing newline
            yaml_result = yaml_result + "\n"
        elif yaml_chomp == 1:
            # Strip — no trailing newlines
            pass
        elif yaml_chomp == 2:
            # Keep — all trailing newlines preserved
            yaml_result = yaml_result + "\n"
            int yaml_ti = 0
            while yaml_ti < yaml_trailing:
                yaml_result = yaml_result + "\n"
                yaml_ti = yaml_ti + 1
        return Str(yaml_result)

# ── Merge key helper ─────────────────────────────────────────

private void merge_into(Dict[String, Yaml] &yaml_target, Yaml !yaml_source):
    match yaml_source:
        case Map(yaml_merge_map):
            Vector[String] yaml_mkeys = yaml_merge_map.keys()
            int yaml_mi = 0
            while yaml_mi < yaml_mkeys.len():
                String yaml_mk = yaml_mkeys.get(yaml_mi).unwrap()
                if not yaml_target.contains(yaml_mk):
                    yaml_target.put(yaml_mk, yaml_merge_map[yaml_mk])
                yaml_mi = yaml_mi + 1
        case Seq(yaml_merge_seq):
            int yaml_mi = 0
            while yaml_mi < yaml_merge_seq.len():
                Yaml yaml_merge_item = yaml_merge_seq.get(yaml_mi).unwrap()
                match yaml_merge_item:
                    case Map(yaml_item_map):
                        Vector[String] yaml_mkeys = yaml_item_map.keys()
                        int yaml_mj = 0
                        while yaml_mj < yaml_mkeys.len():
                            String yaml_mk = yaml_mkeys.get(yaml_mj).unwrap()
                            if not yaml_target.contains(yaml_mk):
                                yaml_target.put(yaml_mk, yaml_item_map[yaml_mk])
                            yaml_mj = yaml_mj + 1
                    else:
                        pass
                yaml_mi = yaml_mi + 1
        else:
            pass

# ── Scalar resolution ────────────────────────────────────────

private Yaml resolve_scalar(String yaml_text):
    if yaml_text == "" or yaml_text == "null" or yaml_text == "Null" or yaml_text == "NULL" or yaml_text == "~":
        return Null()
    if yaml_text == "true" or yaml_text == "True" or yaml_text == "TRUE":
        return Bool(true)
    if yaml_text == "false" or yaml_text == "False" or yaml_text == "FALSE":
        return Bool(false)
    # .inf / -.inf / .nan
    if yaml_text == ".inf" or yaml_text == ".Inf" or yaml_text == ".INF":
        return Float(INFINITY)
    if yaml_text == "-.inf" or yaml_text == "-.Inf" or yaml_text == "-.INF":
        return Float(-INFINITY)
    if yaml_text == ".nan" or yaml_text == ".NaN" or yaml_text == ".NAN":
        return Float(NAN)
    # Try integer (decimal, hex, octal, binary)
    if is_int(yaml_text):
        int yaml_ival = parse_int_value(yaml_text)
        return Int(yaml_ival)
    # Try float
    if is_float(yaml_text):
        float yaml_fval = parse_float(yaml_text).unwrap_or(0.0)
        return Float(yaml_fval)
    return Str(yaml_text)

private bool is_int(String yaml_text):
    int yaml_len = yaml_text.byte_len()
    if yaml_len == 0:
        return false
    int yaml_idx = 0
    if yaml_text.char_at(0) == '-' or yaml_text.char_at(0) == '+':
        yaml_idx = 1
    if yaml_idx >= yaml_len:
        return false
    # Hex: 0x...
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'x':
        yaml_idx = yaml_idx + 2
        if yaml_idx >= yaml_len:
            return false
        if yaml_text.char_at(yaml_idx) == '_':
            return false
        while yaml_idx < yaml_len:
            String yaml_hc = yaml_text.char_at(yaml_idx)
            if yaml_hc >= '0' and yaml_hc <= '9':
                yaml_idx = yaml_idx + 1
            elif yaml_hc >= 'a' and yaml_hc <= 'f':
                yaml_idx = yaml_idx + 1
            elif yaml_hc >= 'A' and yaml_hc <= 'F':
                yaml_idx = yaml_idx + 1
            elif yaml_hc == '_':
                yaml_idx = yaml_idx + 1
            else:
                return false
        return true
    # Octal: 0o...
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'o':
        yaml_idx = yaml_idx + 2
        if yaml_idx >= yaml_len:
            return false
        if yaml_text.char_at(yaml_idx) == '_':
            return false
        while yaml_idx < yaml_len:
            String yaml_oc = yaml_text.char_at(yaml_idx)
            if yaml_oc >= '0' and yaml_oc <= '7':
                yaml_idx = yaml_idx + 1
            elif yaml_oc == '_':
                yaml_idx = yaml_idx + 1
            else:
                return false
        return true
    # Binary: 0b...
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'b':
        yaml_idx = yaml_idx + 2
        if yaml_idx >= yaml_len:
            return false
        if yaml_text.char_at(yaml_idx) == '_':
            return false
        while yaml_idx < yaml_len:
            String yaml_bc = yaml_text.char_at(yaml_idx)
            if yaml_bc == '0' or yaml_bc == '1':
                yaml_idx = yaml_idx + 1
            elif yaml_bc == '_':
                yaml_idx = yaml_idx + 1
            else:
                return false
        return true
    # Decimal — first char must be a digit (reject leading underscore)
    if yaml_text.char_at(yaml_idx) < '0' or yaml_text.char_at(yaml_idx) > '9':
        return false
    while yaml_idx < yaml_len:
        String yaml_dc = yaml_text.char_at(yaml_idx)
        if yaml_dc >= '0' and yaml_dc <= '9':
            yaml_idx = yaml_idx + 1
        elif yaml_dc == '_':
            yaml_idx = yaml_idx + 1
        else:
            return false
    return yaml_idx > 0

private int parse_int_value(String yaml_text):
    int yaml_len = yaml_text.byte_len()
    int yaml_idx = 0
    int yaml_sign = 1
    if yaml_text.char_at(0) == '-':
        yaml_sign = -1
        yaml_idx = 1
    elif yaml_text.char_at(0) == '+':
        yaml_idx = 1
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'x':
        # Hex
        yaml_idx = yaml_idx + 2
        int yaml_hval = 0
        while yaml_idx < yaml_len:
            byte yaml_hc = yaml_text.byte_at(yaml_idx)
            if yaml_hc >= b'0' and yaml_hc <= b'9':
                yaml_hval = yaml_hval * 16 + yaml_hc as int - b'0'
            elif yaml_hc >= b'a' and yaml_hc <= b'f':
                yaml_hval = yaml_hval * 16 + yaml_hc as int - b'a' + 10
            elif yaml_hc >= b'A' and yaml_hc <= b'F':
                yaml_hval = yaml_hval * 16 + yaml_hc as int - b'A' + 10
            yaml_idx = yaml_idx + 1
        return yaml_sign * yaml_hval
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'o':
        # Octal
        yaml_idx = yaml_idx + 2
        int yaml_oval = 0
        while yaml_idx < yaml_len:
            byte yaml_oc = yaml_text.byte_at(yaml_idx)
            if yaml_oc >= b'0' and yaml_oc <= b'7':
                yaml_oval = yaml_oval * 8 + yaml_oc as int - b'0'
            yaml_idx = yaml_idx + 1
        return yaml_sign * yaml_oval
    if yaml_idx + 1 < yaml_len and yaml_text.char_at(yaml_idx) == '0' and yaml_text.char_at(yaml_idx + 1) == 'b':
        # Binary
        yaml_idx = yaml_idx + 2
        int yaml_bval = 0
        while yaml_idx < yaml_len:
            String yaml_bc = yaml_text.char_at(yaml_idx)
            if yaml_bc == '1':
                yaml_bval = yaml_bval * 2 + 1
            elif yaml_bc == '0':
                yaml_bval = yaml_bval * 2
            yaml_idx = yaml_idx + 1
        return yaml_sign * yaml_bval
    # Decimal (may have underscores)
    int yaml_dval = 0
    while yaml_idx < yaml_len:
        byte yaml_dc = yaml_text.byte_at(yaml_idx)
        if yaml_dc >= b'0' and yaml_dc <= b'9':
            yaml_dval = yaml_dval * 10 + yaml_dc as int - b'0'
        yaml_idx = yaml_idx + 1
    return yaml_sign * yaml_dval

private bool is_float(String yaml_text):
    int yaml_len = yaml_text.byte_len()
    if yaml_len == 0:
        return false
    int yaml_idx = 0
    if yaml_text.char_at(0) == '-' or yaml_text.char_at(0) == '+':
        yaml_idx = 1
    if yaml_idx >= yaml_len:
        return false
    if yaml_text.char_at(yaml_idx) == '_':
        return false
    bool yaml_has_dot = false
    bool yaml_has_e = false
    bool yaml_has_digit = false
    while yaml_idx < yaml_len:
        String yaml_fc = yaml_text.char_at(yaml_idx)
        if yaml_fc >= '0' and yaml_fc <= '9':
            yaml_has_digit = true
            yaml_idx = yaml_idx + 1
        elif yaml_fc == '.':
            if yaml_has_dot or yaml_has_e:
                return false
            yaml_has_dot = true
            yaml_idx = yaml_idx + 1
        elif yaml_fc == 'e' or yaml_fc == 'E':
            if yaml_has_e or not yaml_has_digit:
                return false
            yaml_has_e = true
            yaml_idx = yaml_idx + 1
            if yaml_idx < yaml_len:
                if yaml_text.char_at(yaml_idx) == '+' or yaml_text.char_at(yaml_idx) == '-':
                    yaml_idx = yaml_idx + 1
        elif yaml_fc == '_':
            yaml_idx = yaml_idx + 1
        else:
            return false
    return yaml_has_digit and yaml_has_dot or yaml_has_e

# ── Public API ───────────────────────────────────────────────

Result[Yaml, ParseError] parse(String yaml_input):
    YamlParser yaml_p = YamlParser(yaml_input, 0, "", Vector[String](), Vector[Yaml]())
    Yaml yaml_doc = yaml_p.parse_document()
    if yaml_p.failed():
        return Error(ParseError.InvalidSyntax(yaml_p.yaml_pos, yaml_p.yaml_err))
    return Ok(!yaml_doc)

Result[Vector[Yaml], ParseError] parse_all(String yaml_input):
    YamlParser yaml_p = YamlParser(yaml_input, 0, "", Vector[String](), Vector[Yaml]())
    Vector[Yaml] yaml_docs = yaml_p.parse_all_documents()
    if yaml_p.failed():
        return Error(ParseError.InvalidSyntax(yaml_p.yaml_pos, yaml_p.yaml_err))
    return Ok(!yaml_docs)

# ── Serialization (compact flow-style) ──────────────────────

private String escape_str(String yaml_s):
    String yaml_out = "\""
    int yaml_idx = 0
    while yaml_idx < yaml_s.byte_len():
        String yaml_ec = yaml_s.char_at(yaml_idx)
        if yaml_ec == '"':
            yaml_out = yaml_out + "\\\""
        elif yaml_ec == '\\':
            yaml_out = yaml_out + "\\\\"
        elif yaml_ec == '\n':
            yaml_out = yaml_out + "\\n"
        elif yaml_ec == '\t':
            yaml_out = yaml_out + "\\t"
        elif yaml_ec == '\r':
            yaml_out = yaml_out + "\\r"
        else:
            yaml_out = yaml_out + yaml_ec
        yaml_idx = yaml_idx + 1
    return yaml_out + "\""

private bool needs_quoting(String yaml_s):
    if yaml_s.byte_len() == 0:
        return true
    # Check if it could be confused with a special value
    if yaml_s == "null" or yaml_s == "Null" or yaml_s == "NULL" or yaml_s == "~":
        return true
    if yaml_s == "true" or yaml_s == "True" or yaml_s == "TRUE":
        return true
    if yaml_s == "false" or yaml_s == "False" or yaml_s == "FALSE":
        return true
    if yaml_s == ".inf" or yaml_s == ".Inf" or yaml_s == ".INF":
        return true
    if yaml_s == "-.inf" or yaml_s == "-.Inf" or yaml_s == "-.INF":
        return true
    if yaml_s == ".nan" or yaml_s == ".NaN" or yaml_s == ".NAN":
        return true
    # Check for characters that need quoting
    int yaml_idx = 0
    while yaml_idx < yaml_s.byte_len():
        String yaml_qc = yaml_s.char_at(yaml_idx)
        if yaml_qc == ':' or yaml_qc == '#' or yaml_qc == '[' or yaml_qc == ']':
            return true
        if yaml_qc == '{' or yaml_qc == '}' or yaml_qc == ',' or yaml_qc == '"' or yaml_qc == '\'':
            return true
        if yaml_qc == '\n' or yaml_qc == '\r' or yaml_qc == '\t':
            return true
        yaml_idx = yaml_idx + 1
    # Check first character for special meaning
    String yaml_first = yaml_s.char_at(0)
    if yaml_first == '-' or yaml_first == '?' or yaml_first == '&' or yaml_first == '*' or yaml_first == '!':
        return true
    if yaml_first == '|' or yaml_first == '>' or yaml_first == '%' or yaml_first == '@' or yaml_first == '`':
        return true
    # Check if it looks like a number
    if is_int(yaml_s) or is_float(yaml_s):
        return true
    return false

private String format_scalar(String yaml_s):
    if needs_quoting(yaml_s):
        return escape_str(yaml_s)
    return yaml_s

String stringify(Yaml yaml_val):
    match yaml_val:
        case Null():
            return "null"
        case Bool(yaml_bv):
            if yaml_bv:
                return "true"
            return "false"
        case Int(yaml_iv):
            return int_to_str(yaml_iv)
        case Float(yaml_fv):
            return float_to_str(yaml_fv)
        case Str(yaml_sv):
            return format_scalar(yaml_sv)
        case Seq(yaml_items):
            if yaml_items.len() == 0:
                return "[]"
            String yaml_out = "["
            int yaml_idx = 0
            while yaml_idx < yaml_items.len():
                if yaml_idx > 0:
                    yaml_out = yaml_out + ", "
                yaml_out = yaml_out + stringify(yaml_items.get(yaml_idx).unwrap())
                yaml_idx = yaml_idx + 1
            return yaml_out + "]"
        case Map(yaml_map):
            if yaml_map.len() == 0:
                return "\{\}"
            Vector[String] yaml_keys = yaml_map.keys()
            String yaml_out = "\{"
            int yaml_idx = 0
            while yaml_idx < yaml_keys.len():
                if yaml_idx > 0:
                    yaml_out = yaml_out + ", "
                String yaml_k = yaml_keys.get(yaml_idx).unwrap()
                yaml_out = yaml_out + format_scalar(yaml_k) + ": " + stringify(yaml_map[yaml_k])
                yaml_idx = yaml_idx + 1
            return yaml_out + "\}"

String stringify_all(Vector[Yaml] yaml_docs):
    if yaml_docs.len() == 0:
        return ""
    if yaml_docs.len() == 1:
        return stringify(yaml_docs.get(0).unwrap())
    String yaml_out = ""
    int yaml_idx = 0
    while yaml_idx < yaml_docs.len():
        if yaml_idx > 0:
            yaml_out = yaml_out + "\n"
        yaml_out = yaml_out + "--- " + stringify(yaml_docs.get(yaml_idx).unwrap())
        yaml_idx = yaml_idx + 1
    return yaml_out

# ── Helpers ───────────────────────────────────────────────────

private bool str_contains_newline(String yaml_s):
    int yaml_idx = 0
    while yaml_idx < yaml_s.byte_len():
        if yaml_s.char_at(yaml_idx) == '\n':
            return true
        yaml_idx = yaml_idx + 1
    return false

# ── Pretty printing (block-style) ───────────────────────────

private String make_indent(int yaml_depth):
    String yaml_out = ""
    int yaml_idx = 0
    while yaml_idx < yaml_depth:
        yaml_out = yaml_out + "  "
        yaml_idx = yaml_idx + 1
    return yaml_out

private String pretty_internal(Yaml yaml_val, int yaml_depth):
    String yaml_ind = make_indent(yaml_depth)
    match yaml_val:
        case Null():
            return "null"
        case Bool(yaml_bv):
            if yaml_bv:
                return "true"
            return "false"
        case Int(yaml_iv):
            return int_to_str(yaml_iv)
        case Float(yaml_fv):
            return float_to_str(yaml_fv)
        case Str(yaml_sv):
            if str_contains_newline(yaml_sv):
                # Emit as literal block scalar
                String yaml_block_ind = make_indent(yaml_depth)
                String yaml_out = "|\n"
                int yaml_bi = 0
                int yaml_line_start = 0
                while yaml_bi < yaml_sv.byte_len():
                    if yaml_sv.char_at(yaml_bi) == '\n':
                        String yaml_bline = yaml_sv.byte_slice(yaml_line_start, yaml_bi)
                        if yaml_bline == "":
                            yaml_out = yaml_out + "\n"
                        else:
                            yaml_out = yaml_out + yaml_block_ind + yaml_bline + "\n"
                        yaml_line_start = yaml_bi + 1
                    yaml_bi = yaml_bi + 1
                # Handle any remaining text after the last newline
                if yaml_line_start < yaml_sv.byte_len():
                    String yaml_bline = yaml_sv.byte_slice(yaml_line_start, yaml_sv.byte_len())
                    yaml_out = yaml_out + yaml_block_ind + yaml_bline + "\n"
                return yaml_out
            return format_scalar(yaml_sv)
        case Seq(yaml_items):
            if yaml_items.len() == 0:
                return "[]"
            String yaml_out = ""
            int yaml_idx = 0
            while yaml_idx < yaml_items.len():
                if yaml_idx > 0:
                    yaml_out = yaml_out + "\n"
                yaml_out = yaml_out + yaml_ind + "- " + pretty_internal(yaml_items.get(yaml_idx).unwrap(), yaml_depth + 1)
                yaml_idx = yaml_idx + 1
            return yaml_out
        case Map(yaml_map):
            if yaml_map.len() == 0:
                return "\{\}"
            Vector[String] yaml_keys = yaml_map.keys()
            String yaml_out = ""
            int yaml_idx = 0
            while yaml_idx < yaml_keys.len():
                if yaml_idx > 0:
                    yaml_out = yaml_out + "\n"
                String yaml_k = yaml_keys.get(yaml_idx).unwrap()
                Yaml yaml_v = yaml_map[yaml_k]
                String yaml_formatted_key = format_scalar(yaml_k)
                # Check if value is a collection
                bool yaml_is_collection = false
                match yaml_v:
                    case Seq(yaml_sv):
                        if yaml_sv.len() > 0:
                            yaml_is_collection = true
                    case Map(yaml_mv):
                        if yaml_mv.len() > 0:
                            yaml_is_collection = true
                    else:
                        yaml_is_collection = false
                if yaml_is_collection:
                    yaml_out = yaml_out + yaml_ind + yaml_formatted_key + ":\n" + pretty_internal(yaml_v, yaml_depth + 1)
                else:
                    yaml_out = yaml_out + yaml_ind + yaml_formatted_key + ": " + pretty_internal(yaml_v, yaml_depth + 1)
                yaml_idx = yaml_idx + 1
            return yaml_out

String pretty(Yaml yaml_val):
    return pretty_internal(yaml_val, 0)

String pretty_all(Vector[Yaml] yaml_docs):
    if yaml_docs.len() == 0:
        return ""
    if yaml_docs.len() == 1:
        return pretty(yaml_docs.get(0).unwrap())
    String yaml_out = ""
    int yaml_idx = 0
    while yaml_idx < yaml_docs.len():
        if yaml_idx > 0:
            yaml_out = yaml_out + "\n"
        yaml_out = yaml_out + "---\n" + pretty(yaml_docs.get(yaml_idx).unwrap())
        yaml_idx = yaml_idx + 1
    return yaml_out

# ── Accessor methods ─────────────────────────────────────────

equip Yaml:
    Yaml get(self, String key):
        match self:
            case Map(yaml_d):
                if yaml_d.contains(key):
                    return yaml_d[key]
                return Null()
            else:
                return Null()

    Yaml at(self, int index):
        match self:
            case Seq(yaml_arr):
                if index >= 0 and index < yaml_arr.len():
                    return yaml_arr.get(index).unwrap()
                return Null()
            else:
                return Null()

    bool has(self, String key):
        match self:
            case Map(yaml_d):
                return yaml_d.contains(key)
            else:
                return false

    bool has_index(self, int index):
        match self:
            case Seq(yaml_arr):
                return index >= 0 and index < yaml_arr.len()
            else:
                return false

    String as_str(self):
        match self:
            case Str(yaml_sv):
                return yaml_sv
            else:
                return ""

    int as_int(self):
        match self:
            case Int(yaml_iv):
                return yaml_iv
            else:
                return 0

    float as_float(self):
        match self:
            case Float(yaml_fv):
                return yaml_fv
            case Int(yaml_iv):
                return yaml_iv as float
            else:
                return 0.0

    bool as_bool(self):
        match self:
            case Bool(yaml_bv):
                return yaml_bv
            else:
                return false

    bool is_null(self):
        match self:
            case Null():
                return true
            else:
                return false

    bool is_object(self):
        match self:
            case Map(yaml_d):
                return true
            else:
                return false

    bool is_array(self):
        match self:
            case Seq(yaml_a):
                return true
            else:
                return false

    bool is_string(self):
        match self:
            case Str(yaml_sv):
                return true
            else:
                return false

    bool is_number(self):
        match self:
            case Int(yaml_iv):
                return true
            case Float(yaml_fv):
                return true
            else:
                return false

    bool is_bool(self):
        match self:
            case Bool(yaml_bv):
                return true
            else:
                return false

    int len(self):
        match self:
            case Seq(yaml_arr):
                return yaml_arr.len()
            case Map(yaml_d):
                return yaml_d.len()
            else:
                return 0

    Vector[String] keys(self):
        match self:
            case Map(yaml_d):
                return yaml_d.keys()
            else:
                return Vector[String]()
