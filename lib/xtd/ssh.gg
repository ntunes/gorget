# gg.ssh — SSH2 protocol implementation in pure Gorget
#
# Implements RFC 4253 (SSH Transport), RFC 4252 (Authentication),
# RFC 4254 (Connection Protocol) on top of std.net.socket and gg.crypto.
#
# MVP scope:
#   - Key exchange: diffie-hellman-group14-sha256
#   - Cipher: aes128-ctr
#   - MAC: hmac-sha2-256
#   - Auth: password
#   - Channel: session (command execution)

from std.collections import Vector
from std.net.socket import Socket, socket_connect
from std.io import write_all
from std.bytes import bytes_from_str, bytes_to_str, bytes_from_hex
from std.bytes import bytes_write_u32_be, bytes_read_u32_be
from std.bytes import bytes_concat, bytes_slice, random_bytes
from xtd.crypto import crypto_sha256, crypto_hmac
from xtd.crypto import crypto_aes_ctr_new, CipherContext
from xtd.crypto import crypto_bn_from_bytes, crypto_bn_to_bytes, crypto_bn_mod_exp, BigNum
from std.fs import read_file, file_exists
from std.os import getenv, exit
from std.path import path_join
from std.conv import parse_int

# ── Public types ─────────────────────────────────────────────

struct CommandResult:
    String stdout
    String stderr
    int exit_code

struct Session:
    Socket sock
    Vector[uint8] session_id
    CipherContext enc_cipher
    CipherContext dec_cipher
    Vector[uint8] enc_mac_key
    Vector[uint8] dec_mac_key
    int send_seq
    int recv_seq
    bool encrypted
    int channel_id
    bool channel_open

# ── SSH config parsing ─────────────────────────────────────

struct SshConfig:
    String hostname
    int port
    String user

# Parse ~/.ssh/config and return resolved settings for the given host.
# Supports Host, HostName, Port, User directives.
# Wildcard Host * matches all hosts (used for defaults).
SshConfig parse_ssh_config(String host, int default_port, String default_user):
    String hostname = host
    int port = default_port
    String user = default_user

    String home = getenv("HOME")
    if home == "":
        return SshConfig(hostname, port, user)

    String config_path = path_join(home, ".ssh/config")
    if not file_exists(config_path):
        return SshConfig(hostname, port, user)

    String content = read_file(config_path)
    Vector[String] lines = content.split("\n")

    # Track whether the current Host block matches our target
    bool in_matching_block = false

    int i = 0
    while i < lines.len():
        String line = lines.get(i).unwrap()
        String trimmed = line.trim()

        # Skip empty lines and comments
        if trimmed == "":
            i = i + 1
            continue
        if trimmed.starts_with("#"):
            i = i + 1
            continue

        # Split on first whitespace (or =)
        String normalized = trimmed.replace("=", " ")
        Vector[String] parts = normalized.split(" ")
        if parts.len() < 2:
            i = i + 1
            continue

        String key = parts.get(0).unwrap()
        String value = parts.get(1).unwrap()

        if key == "Host":
            # Check if this Host block matches our target
            # Support exact match and wildcard "*"
            in_matching_block = false
            int j = 1
            while j < parts.len():
                String pattern = parts.get(j).unwrap()
                if pattern == "":
                    j = j + 1
                    continue
                if pattern == host:
                    in_matching_block = true
                if pattern == "*":
                    in_matching_block = true
                j = j + 1
        else:
            if in_matching_block:
                if key == "HostName":
                    hostname = value
                else:
                    if key == "Port":
                        port = parse_int(value).unwrap_or(0)
                    else:
                        if key == "User":
                            user = value

        i = i + 1

    return SshConfig(hostname, port, user)

# ── SSH message type constants ───────────────────────────────

const int SSH_MSG_DISCONNECT = 1
const int SSH_MSG_IGNORE = 2
const int SSH_MSG_KEXINIT = 20
const int SSH_MSG_NEWKEYS = 21
const int SSH_MSG_KEXDH_INIT = 30
const int SSH_MSG_KEXDH_REPLY = 31
const int SSH_MSG_USERAUTH_REQUEST = 50
const int SSH_MSG_USERAUTH_FAILURE = 51
const int SSH_MSG_USERAUTH_SUCCESS = 52
const int SSH_MSG_CHANNEL_OPEN = 90
const int SSH_MSG_CHANNEL_OPEN_CONFIRMATION = 91
const int SSH_MSG_CHANNEL_WINDOW_ADJUST = 93
const int SSH_MSG_CHANNEL_DATA = 94
const int SSH_MSG_CHANNEL_EOF = 96
const int SSH_MSG_CHANNEL_CLOSE = 97
const int SSH_MSG_CHANNEL_REQUEST = 98
const int SSH_MSG_CHANNEL_SUCCESS = 99
const int SSH_MSG_CHANNEL_FAILURE = 100

# ── Channel size constants ───────────────────────────────────
const int SSH_CHANNEL_WINDOW_SIZE = 2097152
const int SSH_MAX_PACKET_SIZE = 32768

# ── Bounds-check helper ─────────────────────────────────────

private void check_len(Vector[uint8] buf, int required, String context):
    if buf.len() < required:
        print("ssh: protocol error: buffer too short in " + context)
        exit(1)

# ── Helpers ──────────────────────────────────────────────────

# Build a name-list payload (comma-separated string as SSH binary)
Vector[uint8] make_name_list(String names):
    Vector[uint8] data = bytes_from_str(names)
    Vector[uint8] buf = bytes_from_hex("00000000")
    bytes_write_u32_be(&buf, 0, data.len())
    return bytes_concat(buf, data)

# Build a uint32 payload
Vector[uint8] make_u32(int value):
    Vector[uint8] buf = bytes_from_hex("00000000")
    bytes_write_u32_be(&buf, 0, value)
    return buf

# Build an SSH mpint from a BigNum (RFC 4251 section 5)
Vector[uint8] make_mpint(BigNum bn):
    Vector[uint8] data = crypto_bn_to_bytes(bn)
    # If high bit is set, prepend a zero byte
    if data.len() > 0:
        uint8 first = data.get(0).unwrap()
        if first >= 128:
            Vector[uint8] zero = bytes_from_hex("00")
            data = bytes_concat(zero, data)
    Vector[uint8] len_buf = make_u32(data.len())
    return bytes_concat(len_buf, data)

# Parse an mpint from a payload at an offset
BigNum parse_mpint(Vector[uint8] payload, int offset):
    check_len(payload, offset + 4, "parse_mpint length")
    int len = bytes_read_u32_be(payload, offset)
    check_len(payload, offset + 4 + len, "parse_mpint data")
    Vector[uint8] data = bytes_slice(payload, offset + 4, offset + 4 + len)
    return crypto_bn_from_bytes(data)

# Parse a string from payload at offset, return as Vector[uint8]
Vector[uint8] parse_string(Vector[uint8] payload, int offset):
    check_len(payload, offset + 4, "parse_string length")
    int len = bytes_read_u32_be(payload, offset)
    check_len(payload, offset + 4 + len, "parse_string data")
    return bytes_slice(payload, offset + 4, offset + 4 + len)

# Get the DH Group 14 prime (RFC 3526, 2048-bit MODP)
Vector[uint8] dh_group14_prime():
    return bytes_from_hex("")

# Helper to derive a key: HASH(K || H || letter || session_id)
Vector[uint8] derive_key(Vector[uint8] k_mpint, Vector[uint8] h, String letter, Vector[uint8] session_id):
    Vector[uint8] input = bytes_concat(k_mpint, h)
    input = bytes_concat(input, bytes_from_str(letter))
    input = bytes_concat(input, session_id)
    return crypto_sha256(input)

# ── Packet framing (RFC 4253 section 6) ─────────────────────

# Send a packet (handles padding, optional encryption + MAC)
void send_packet(Session &session, Vector[uint8] payload):
    int block_size = 16
    # packet_length(4) + padding_length(1) + payload + padding
    int min_packet = 5 + payload.len()
    int pad_len = block_size - (min_packet % block_size)
    if pad_len < 4:
        pad_len = pad_len + block_size
    int packet_len = 1 + payload.len() + pad_len

    Vector[uint8] packet = make_u32(packet_len)
    # Build 1-byte padding length
    Vector[uint8] pad_byte_buf = bytes_from_hex("00000000")
    bytes_write_u32_be(&pad_byte_buf, 0, pad_len)
    Vector[uint8] pad_len_byte = bytes_slice(pad_byte_buf, 3, 4)
    packet = bytes_concat(packet, pad_len_byte)
    packet = bytes_concat(packet, payload)
    Vector[uint8] padding = random_bytes(pad_len)
    packet = bytes_concat(packet, padding)

    if session.encrypted:
        # Compute MAC over sequence number + unencrypted packet
        Vector[uint8] seq_buf = make_u32(session.send_seq)
        Vector[uint8] mac_data = bytes_concat(seq_buf, packet)
        Vector[uint8] mac = crypto_hmac("sha256", session.enc_mac_key, mac_data)
        # Encrypt the packet (not the MAC)
        Vector[uint8] enc_data = session.enc_cipher.encrypt(packet)
        Vector[uint8] wire = bytes_concat(enc_data, mac)
        write_all[Socket](&session.sock, wire)! catch (e): 0
    else:
        write_all[Socket](&session.sock, packet)! catch (e): 0
    session.send_seq = session.send_seq + 1

# Read a packet (handles decryption + MAC verification)
Vector[uint8] read_packet(Session &session):
    if session.encrypted:
        # Read first block to get packet length
        Vector[uint8] first_block = session.sock.read_exact(16)
        Vector[uint8] decrypted_first = session.dec_cipher.decrypt(first_block)
        int packet_len = bytes_read_u32_be(decrypted_first, 0)

        # Read remaining encrypted data
        int remaining = packet_len - 12
        Vector[uint8] rest = bytes_from_hex("")
        if remaining > 0:
            Vector[uint8] enc_rest = session.sock.read_exact(remaining)
            rest = session.dec_cipher.decrypt(enc_rest)

        # Read MAC (32 bytes for hmac-sha2-256)
        Vector[uint8] mac_received = session.sock.read_exact(32)

        # Reconstruct unencrypted packet for MAC verification
        Vector[uint8] unenc_packet = bytes_concat(decrypted_first, rest)

        # Verify MAC
        Vector[uint8] seq_buf = make_u32(session.recv_seq)
        Vector[uint8] mac_data = bytes_concat(seq_buf, unenc_packet)
        Vector[uint8] mac_expected = crypto_hmac("sha256", session.dec_mac_key, mac_data)

        # Extract payload (skip packet_length(4) + padding_length(1), trim padding)
        check_len(unenc_packet, 5, "read_packet encrypted header")
        uint8 pad_len_val = unenc_packet.get(4).unwrap()
        int pad_len = pad_len_val
        int payload_len = packet_len - 1 - pad_len
        if payload_len < 0:
            print("ssh: protocol error: negative payload length in read_packet (encrypted)")
            exit(1)
        check_len(unenc_packet, 5 + payload_len, "read_packet encrypted payload")
        Vector[uint8] payload = bytes_slice(unenc_packet, 5, 5 + payload_len)
        session.recv_seq = session.recv_seq + 1
        return payload
    else:
        # Unencrypted: read 4-byte length, then rest
        Vector[uint8] len_buf = session.sock.read_exact(4)
        int packet_len = bytes_read_u32_be(len_buf, 0)
        Vector[uint8] packet_data = session.sock.read_exact(packet_len)
        check_len(packet_data, 1, "read_packet unencrypted header")
        uint8 pad_len_val = packet_data.get(0).unwrap()
        int pad_len = pad_len_val
        int payload_len = packet_len - 1 - pad_len
        if payload_len < 0:
            print("ssh: protocol error: negative payload length in read_packet (unencrypted)")
            exit(1)
        check_len(packet_data, 1 + payload_len, "read_packet unencrypted payload")
        Vector[uint8] payload = bytes_slice(packet_data, 1, 1 + payload_len)
        session.recv_seq = session.recv_seq + 1
        return payload

# ── Version exchange ─────────────────────────────────────────

String version_exchange(Socket &sock):
    sock.write_str("SSH-2.0-Gorget_1.0\r\n")
    String server_version = sock.read_line().unwrap()
    return server_version

# ── Key Exchange ─────────────────────────────────────────────

# Our KEX_INIT proposal
Vector[uint8] build_kexinit():
    # Message type byte (20 = KEXINIT)
    Vector[uint8] msg = bytes_from_hex("14")

    # 16 bytes of cookie
    Vector[uint8] cookie = random_bytes(16)
    msg = bytes_concat(msg, cookie)

    # Algorithm lists
    msg = bytes_concat(msg, make_name_list("diffie-hellman-group14-sha256"))
    msg = bytes_concat(msg, make_name_list("ssh-rsa"))
    msg = bytes_concat(msg, make_name_list("aes128-ctr"))
    msg = bytes_concat(msg, make_name_list("aes128-ctr"))
    msg = bytes_concat(msg, make_name_list("hmac-sha2-256"))
    msg = bytes_concat(msg, make_name_list("hmac-sha2-256"))
    msg = bytes_concat(msg, make_name_list("none"))
    msg = bytes_concat(msg, make_name_list("none"))
    msg = bytes_concat(msg, make_name_list(""))
    msg = bytes_concat(msg, make_name_list(""))
    # first_kex_packet_follows (false) + reserved
    msg = bytes_concat(msg, bytes_from_hex("0000000000"))

    return msg

void kex_dh_group14(Session &session, String client_version, String server_version, Vector[uint8] client_kexinit, Vector[uint8] server_kexinit):
    Vector[uint8] prime_bytes = dh_group14_prime()
    BigNum p = crypto_bn_from_bytes(prime_bytes)
    Vector[uint8] g_bytes = bytes_from_hex("02")
    BigNum g = crypto_bn_from_bytes(g_bytes)

    # Generate private key x (random 256 bits)
    Vector[uint8] x_bytes = random_bytes(32)
    BigNum x = crypto_bn_from_bytes(x_bytes)

    # Compute e = g^x mod p
    BigNum e = crypto_bn_mod_exp(g, x, p)

    # Send KEXDH_INIT with e
    Vector[uint8] dh_init = bytes_from_hex("1e")
    dh_init = bytes_concat(dh_init, make_mpint(e))
    send_packet(&session, dh_init)

    # Read KEXDH_REPLY
    Vector[uint8] reply = read_packet(&session)

    # Parse: K_S (host key), f (server public), signature
    int off = 1
    check_len(reply, off + 4, "kex_dh_group14 ks_len")
    int ks_len = bytes_read_u32_be(reply, off)
    check_len(reply, off + 4 + ks_len, "kex_dh_group14 K_S data")
    Vector[uint8] k_s = bytes_slice(reply, off, off + 4 + ks_len)
    off = off + 4 + ks_len

    BigNum f = parse_mpint(reply, off)
    int f_len = bytes_read_u32_be(reply, off)
    off = off + 4 + f_len

    check_len(reply, off + 4, "kex_dh_group14 sig_len")
    int sig_len = bytes_read_u32_be(reply, off)
    check_len(reply, off + 4 + sig_len, "kex_dh_group14 sig data")
    Vector[uint8] sig_blob = bytes_slice(reply, off + 4, off + 4 + sig_len)
    off = off + 4 + sig_len

    # Compute shared secret K = f^x mod p
    BigNum shared_k = crypto_bn_mod_exp(f, x, p)

    # Compute exchange hash H (RFC 4253 section 8)
    Vector[uint8] hash_input = bytes_from_hex("")
    # V_C (client version string)
    hash_input = bytes_concat(hash_input, make_name_list(client_version))
    # V_S (server version string)
    hash_input = bytes_concat(hash_input, make_name_list(server_version))
    # I_C (client KEXINIT payload)
    Vector[uint8] ci_len = make_u32(client_kexinit.len())
    hash_input = bytes_concat(hash_input, ci_len)
    hash_input = bytes_concat(hash_input, client_kexinit)
    # I_S (server KEXINIT payload)
    Vector[uint8] si_len = make_u32(server_kexinit.len())
    hash_input = bytes_concat(hash_input, si_len)
    hash_input = bytes_concat(hash_input, server_kexinit)
    # K_S (host key blob)
    hash_input = bytes_concat(hash_input, k_s)
    # e (client public)
    hash_input = bytes_concat(hash_input, make_mpint(e))
    # f (server public)
    hash_input = bytes_concat(hash_input, make_mpint(f))
    # K (shared secret as mpint)
    hash_input = bytes_concat(hash_input, make_mpint(shared_k))

    Vector[uint8] exchange_hash = crypto_sha256(hash_input)

    # Send NEWKEYS
    Vector[uint8] newkeys = bytes_from_hex("15")
    send_packet(&session, newkeys)

    # Read NEWKEYS from server
    Vector[uint8] server_newkeys = read_packet(&session)

    # Derive keys (RFC 4253 section 7.2)
    # Use exchange_hash as both H and session_id (they're the same for the first exchange)
    Vector[uint8] k_mpint = make_mpint(shared_k)

    Vector[uint8] iv_cs = derive_key(k_mpint, exchange_hash, "A", exchange_hash)
    Vector[uint8] iv_sc = derive_key(k_mpint, exchange_hash, "B", exchange_hash)
    Vector[uint8] enc_key_cs = derive_key(k_mpint, exchange_hash, "C", exchange_hash)
    Vector[uint8] enc_key_sc = derive_key(k_mpint, exchange_hash, "D", exchange_hash)
    Vector[uint8] mac_key_cs = derive_key(k_mpint, exchange_hash, "E", exchange_hash)
    Vector[uint8] mac_key_sc = derive_key(k_mpint, exchange_hash, "F", exchange_hash)

    # Session ID is the first exchange hash
    session.session_id = !exchange_hash

    # AES-128-CTR uses 16-byte keys and IVs
    Vector[uint8] enc_key_16 = bytes_slice(enc_key_cs, 0, 16)
    Vector[uint8] dec_key_16 = bytes_slice(enc_key_sc, 0, 16)
    Vector[uint8] enc_iv_16 = bytes_slice(iv_cs, 0, 16)
    Vector[uint8] dec_iv_16 = bytes_slice(iv_sc, 0, 16)

    session.enc_cipher = crypto_aes_ctr_new(enc_key_16, enc_iv_16)
    session.dec_cipher = crypto_aes_ctr_new(dec_key_16, dec_iv_16)
    session.enc_mac_key = !mac_key_cs
    session.dec_mac_key = !mac_key_sc
    session.encrypted = true

# ── Authentication ───────────────────────────────────────────

void auth_password(Session &session, String user, String password):
    # Service request: ssh-userauth
    Vector[uint8] svc = bytes_from_hex("05")
    svc = bytes_concat(svc, make_name_list("ssh-userauth"))
    send_packet(&session, svc)

    # Read service accept
    Vector[uint8] svc_reply = read_packet(&session)

    # Password auth request
    Vector[uint8] auth_msg = bytes_from_hex("32")
    auth_msg = bytes_concat(auth_msg, make_name_list(user))
    auth_msg = bytes_concat(auth_msg, make_name_list("ssh-connection"))
    auth_msg = bytes_concat(auth_msg, make_name_list("password"))
    auth_msg = bytes_concat(auth_msg, bytes_from_hex("00"))
    auth_msg = bytes_concat(auth_msg, make_name_list(password))
    send_packet(&session, auth_msg)

    # Read auth response
    Vector[uint8] auth_reply = read_packet(&session)
    check_len(auth_reply, 1, "auth_password reply")
    uint8 auth_type = auth_reply.get(0).unwrap()
    if auth_type == SSH_MSG_USERAUTH_FAILURE:
        print("SSH authentication failed")

# ── Channel operations ───────────────────────────────────────

CommandResult channel_exec(Session &session, String cmd):
    # Open a session channel
    Vector[uint8] open_msg = bytes_from_hex("5a")
    open_msg = bytes_concat(open_msg, make_name_list("session"))
    open_msg = bytes_concat(open_msg, make_u32(0))
    open_msg = bytes_concat(open_msg, make_u32(SSH_CHANNEL_WINDOW_SIZE))
    open_msg = bytes_concat(open_msg, make_u32(SSH_MAX_PACKET_SIZE))
    send_packet(&session, open_msg)

    # Read channel open confirmation
    Vector[uint8] confirm = read_packet(&session)
    check_len(confirm, 5, "channel_exec confirm")
    int remote_channel = bytes_read_u32_be(confirm, 1)

    # Send exec request
    Vector[uint8] exec_msg = bytes_from_hex("62")
    exec_msg = bytes_concat(exec_msg, make_u32(remote_channel))
    exec_msg = bytes_concat(exec_msg, make_name_list("exec"))
    exec_msg = bytes_concat(exec_msg, bytes_from_hex("01"))
    exec_msg = bytes_concat(exec_msg, make_name_list(cmd))
    send_packet(&session, exec_msg)

    # Read channel data until EOF/close
    Vector[uint8] stdout_data = bytes_from_hex("")
    int exit_code = -1
    bool done = false

    while not done:
        Vector[uint8] msg = read_packet(&session)
        if msg.len() == 0:
            done = true
        else:
            check_len(msg, 1, "channel_exec msg type")
            uint8 msg_type = msg.get(0).unwrap()
            if msg_type == SSH_MSG_CHANNEL_DATA:
                # channel_data: skip recipient(4) + string_length(4)
                check_len(msg, 9, "channel_exec data header")
                int data_len = bytes_read_u32_be(msg, 5)
                check_len(msg, 9 + data_len, "channel_exec data payload")
                Vector[uint8] chunk = bytes_slice(msg, 9, 9 + data_len)
                stdout_data = bytes_concat(stdout_data, chunk)
            else:
                if msg_type == SSH_MSG_CHANNEL_REQUEST:
                    # Check for exit-status
                    check_len(msg, 9, "channel_exec request header")
                    int req_name_len = bytes_read_u32_be(msg, 5)
                    check_len(msg, 9 + req_name_len, "channel_exec request name")
                    Vector[uint8] req_name = bytes_slice(msg, 9, 9 + req_name_len)
                    String req_str = bytes_to_str(req_name).unwrap()
                    if req_str == "exit-status":
                        check_len(msg, 9 + req_name_len + 1 + 4, "channel_exec exit-status")
                        exit_code = bytes_read_u32_be(msg, 9 + req_name_len + 1)
                else:
                    if msg_type == SSH_MSG_CHANNEL_EOF:
                        pass
                    else:
                        if msg_type == SSH_MSG_CHANNEL_CLOSE:
                            # Send channel close back
                            Vector[uint8] close_msg = bytes_from_hex("61")
                            close_msg = bytes_concat(close_msg, make_u32(remote_channel))
                            send_packet(&session, close_msg)
                            done = true

    String stdout_str = bytes_to_str(stdout_data).unwrap()
    return CommandResult(stdout_str, "", exit_code)

# ── Interactive channel operations ───────────────────────────

# Open a session channel and return the remote channel ID
int channel_open_session(Session &session):
    Vector[uint8] open_msg = bytes_from_hex("5a")
    open_msg = bytes_concat(open_msg, make_name_list("session"))
    open_msg = bytes_concat(open_msg, make_u32(0))
    open_msg = bytes_concat(open_msg, make_u32(SSH_CHANNEL_WINDOW_SIZE))
    open_msg = bytes_concat(open_msg, make_u32(SSH_MAX_PACKET_SIZE))
    send_packet(&session, open_msg)

    Vector[uint8] confirm = read_packet(&session)
    check_len(confirm, 5, "channel_open_session confirm")
    int remote_channel = bytes_read_u32_be(confirm, 1)
    return remote_channel

# Request a subsystem on an open channel
void channel_request_subsystem(Session &session, int remote_channel, String subsystem_name):
    Vector[uint8] msg = bytes_from_hex("62")
    msg = bytes_concat(msg, make_u32(remote_channel))
    msg = bytes_concat(msg, make_name_list("subsystem"))
    msg = bytes_concat(msg, bytes_from_hex("01"))
    msg = bytes_concat(msg, make_name_list(subsystem_name))
    send_packet(&session, msg)

# Send data over an open channel
void channel_write_data(Session &session, int remote_channel, String data):
    Vector[uint8] msg = bytes_from_hex("5e")
    msg = bytes_concat(msg, make_u32(remote_channel))
    msg = bytes_concat(msg, make_name_list(data))
    send_packet(&session, msg)

# Read from channel until delimiter found, return accumulated data including delimiter
String channel_read_until(Session &session, String delimiter):
    String buffer = ""
    bool done = false

    while not done:
        Vector[uint8] msg = read_packet(&session)
        if msg.len() == 0:
            done = true
        else:
            check_len(msg, 1, "channel_read_until msg type")
            uint8 msg_type = msg.get(0).unwrap()
            if msg_type == SSH_MSG_CHANNEL_DATA:
                check_len(msg, 9, "channel_read_until data header")
                int data_len = bytes_read_u32_be(msg, 5)
                check_len(msg, 9 + data_len, "channel_read_until data payload")
                Vector[uint8] chunk = bytes_slice(msg, 9, 9 + data_len)
                buffer = buffer + bytes_to_str(chunk).unwrap()
                # Send window adjust to keep receiving data
                Vector[uint8] adj = bytes_from_hex("5d")
                adj = bytes_concat(adj, make_u32(session.channel_id))
                adj = bytes_concat(adj, make_u32(data_len))
                send_packet(&session, adj)
                if buffer.contains(delimiter):
                    done = true
            else:
                if msg_type == SSH_MSG_CHANNEL_WINDOW_ADJUST:
                    pass
                else:
                    if msg_type == SSH_MSG_CHANNEL_EOF:
                        done = true
                    else:
                        if msg_type == SSH_MSG_CHANNEL_CLOSE:
                            done = true

    return buffer

# ── Public API ───────────────────────────────────────────────

equip Session:
    Result[Session, String] connect(String host, int port, String user, String password):
        return connect(host, port, user, password)

    CommandResult run(&self, String cmd):
        return channel_exec(&self, cmd)

    Result[bool, String] open_subsystem(&self, String name):
        int remote = channel_open_session(&self)
        self.channel_id = remote
        channel_request_subsystem(&self, remote, name)
        # Wait for CHANNEL_SUCCESS or CHANNEL_FAILURE (skip WINDOW_ADJUST)
        bool waiting = true
        while waiting:
            Vector[uint8] reply = read_packet(&self)
            check_len(reply, 1, "open_subsystem reply")
            uint8 reply_type = reply.get(0).unwrap()
            if reply_type == SSH_MSG_CHANNEL_SUCCESS:
                self.channel_open = true
                return Ok(true)
            else:
                if reply_type == SSH_MSG_CHANNEL_FAILURE:
                    return Error("subsystem request failed")
                else:
                    if reply_type == SSH_MSG_CHANNEL_WINDOW_ADJUST:
                        pass
        return Error("unexpected end of stream")

    void write_data(&self, String data):
        channel_write_data(&self, self.channel_id, data)

    String read_until(&self, String delimiter):
        return channel_read_until(&self, delimiter)

    void close_channel(&self):
        if self.channel_open:
            Vector[uint8] close_msg = bytes_from_hex("61")
            close_msg = bytes_concat(close_msg, make_u32(self.channel_id))
            send_packet(&self, close_msg)
            self.channel_open = false

    void close(&self):
        # Close any open channel first
        if self.channel_open:
            self.close_channel()
        # Send disconnect
        Vector[uint8] disc = bytes_from_hex("01")
        disc = bytes_concat(disc, make_u32(11))
        disc = bytes_concat(disc, make_name_list("bye"))
        disc = bytes_concat(disc, make_name_list(""))
        send_packet(&self, disc)
        self.sock.close()

Result[Session, String] connect(String host, int port, String user, String password):
    # Resolve connection parameters via ~/.ssh/config
    SshConfig config = parse_ssh_config(host, port, user)
    String resolved_host = config.hostname
    int resolved_port = config.port
    String resolved_user = config.user

    # Caller-provided user/port override config only if they differ from defaults
    # (port 22 and empty user are treated as "use config value")
    if port != 22:
        resolved_port = port
    if user != "":
        resolved_user = user

    Socket sock = socket_connect(resolved_host, resolved_port)

    # Dummy cipher/keys for pre-encryption phase
    Vector[uint8] dummy_key = bytes_from_hex("00000000000000000000000000000000")
    Vector[uint8] dummy_iv = bytes_from_hex("00000000000000000000000000000000")

    Session session = Session(sock, bytes_from_hex(""), crypto_aes_ctr_new(dummy_key, dummy_iv), crypto_aes_ctr_new(dummy_key, dummy_iv), bytes_from_hex(""), bytes_from_hex(""), 0, 0, false, 0, false)

    # Version exchange
    String server_version = version_exchange(&session.sock)
    String client_version = "SSH-2.0-Gorget_1.0"

    # Send our KEXINIT
    Vector[uint8] client_kexinit = build_kexinit()
    send_packet(&session, client_kexinit)

    # Read server KEXINIT
    Vector[uint8] server_kexinit = read_packet(&session)

    # Key exchange
    kex_dh_group14(&session, client_version, server_version, client_kexinit, server_kexinit)

    # Authenticate
    auth_password(&session, resolved_user, password)

    return Ok(session)
