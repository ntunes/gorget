# ── GL Functions (C ABI) ──────────────────────────────────

extern "C":
    # SDL-GL Context
    extern GLContext gl_create_context(int window) = "gorget_gl_create_context"
    extern void gl_destroy_context(GLContext ctx) = "gorget_gl_destroy_context"
    extern void gl_make_current(int window, GLContext ctx) = "gorget_gl_make_current"
    extern void gl_swap_window(int window) = "gorget_gl_swap_window"
    extern void gl_set_swap_interval(int interval) = "gorget_gl_set_swap_interval"
    extern void gl_set_attribute(int attr, int value) = "gorget_gl_set_attribute"

    # GL State
    extern void gl_enable(int cap) = "gorget_gl_enable"
    extern void gl_disable(int cap) = "gorget_gl_disable"
    extern void gl_blend_func(int sfactor, int dfactor) = "gorget_gl_blend_func"
    extern void gl_depth_func(int func) = "gorget_gl_depth_func"
    extern void gl_depth_mask(int flag) = "gorget_gl_depth_mask"
    extern void gl_cull_face(int mode) = "gorget_gl_cull_face"
    extern void gl_front_face(int mode) = "gorget_gl_front_face"
    extern void gl_viewport(int x, int y, int w, int h) = "gorget_gl_viewport"
    extern void gl_scissor(int x, int y, int w, int h) = "gorget_gl_scissor"
    extern void gl_clear(int mask) = "gorget_gl_clear"
    extern void gl_clear_color(float r, float g, float b, float a) = "gorget_gl_clear_color"
    extern void gl_polygon_offset(float factor, float units) = "gorget_gl_polygon_offset"
    extern void gl_color_mask(int r, int g, int b, int a) = "gorget_gl_color_mask"
    extern void gl_stencil_func(int func, int ref_val, int mask) = "gorget_gl_stencil_func"
    extern void gl_stencil_op(int sfail, int dpfail, int dppass) = "gorget_gl_stencil_op"
    extern void gl_stencil_mask(int mask) = "gorget_gl_stencil_mask"

    # Textures
    extern int gl_gen_texture() = "gorget_gl_gen_texture"
    extern void gl_delete_texture(int tex) = "gorget_gl_delete_texture"
    extern void gl_bind_texture(int target, int tex) = "gorget_gl_bind_texture"
    extern void gl_tex_image_2d(int target, int level, int internal_format, int width, int height, int format, int type_, Vector[uint8] data) = "gorget_gl_tex_image_2d"
    extern void gl_tex_parameter_i(int target, int pname, int param) = "gorget_gl_tex_parameter_i"
    extern void gl_generate_mipmap(int target) = "gorget_gl_generate_mipmap"
    extern void gl_active_texture(int unit) = "gorget_gl_active_texture"

    # VBO/Vertex Arrays
    extern int gl_gen_buffer() = "gorget_gl_gen_buffer"
    extern void gl_delete_buffer(int buf) = "gorget_gl_delete_buffer"
    extern void gl_bind_buffer(int target, int buf) = "gorget_gl_bind_buffer"
    extern void gl_buffer_data(int target, Vector[uint8] data, int usage) = "gorget_gl_buffer_data"
    extern void gl_buffer_sub_data(int target, int offset, Vector[uint8] data) = "gorget_gl_buffer_sub_data"
    extern void gl_draw_arrays(int mode, int first, int count) = "gorget_gl_draw_arrays"
    extern void gl_draw_elements(int mode, int count, int type_, int offset) = "gorget_gl_draw_elements"
    extern void gl_vertex_attrib_pointer(int index, int size, int type_, int normalized, int stride, int offset) = "gorget_gl_vertex_attrib_pointer"
    extern void gl_enable_vertex_attrib_array(int index) = "gorget_gl_enable_vertex_attrib_array"
    extern void gl_disable_vertex_attrib_array(int index) = "gorget_gl_disable_vertex_attrib_array"

    # Shaders
    extern int gl_create_shader(int type_) = "gorget_gl_create_shader"
    extern void gl_compile_shader(int shader) = "gorget_gl_compile_shader"
    extern int gl_create_program() = "gorget_gl_create_program"
    extern void gl_attach_shader(int program, int shader) = "gorget_gl_attach_shader"
    extern void gl_link_program(int program) = "gorget_gl_link_program"
    extern void gl_use_program(int program) = "gorget_gl_use_program"
    extern void gl_delete_shader(int shader) = "gorget_gl_delete_shader"
    extern void gl_delete_program(int program) = "gorget_gl_delete_program"
    extern String gl_get_shader_info_log(int shader) = "gorget_gl_get_shader_info_log"
    extern String gl_get_program_info_log(int program) = "gorget_gl_get_program_info_log"

    # Uniforms
    extern void gl_uniform_1i(int location, int v0) = "gorget_gl_uniform_1i"
    extern void gl_uniform_1f(int location, float v0) = "gorget_gl_uniform_1f"
    extern void gl_uniform_2f(int location, float v0, float v1) = "gorget_gl_uniform_2f"
    extern void gl_uniform_3f(int location, float v0, float v1, float v2) = "gorget_gl_uniform_3f"
    extern void gl_uniform_4f(int location, float v0, float v1, float v2, float v3) = "gorget_gl_uniform_4f"
    extern void gl_uniform_matrix4fv(int location, int transpose, Vector[uint8] value) = "gorget_gl_uniform_matrix4fv"

    # Fixed-function (Q3 compat)
    extern void gl_matrix_mode(int mode) = "gorget_gl_matrix_mode"
    extern void gl_load_identity() = "gorget_gl_load_identity"
    extern void gl_load_matrix(Vector[uint8] m) = "gorget_gl_load_matrix"
    extern void gl_push_matrix() = "gorget_gl_push_matrix"
    extern void gl_pop_matrix() = "gorget_gl_pop_matrix"
    extern void gl_begin(int mode) = "gorget_gl_begin"
    extern void gl_end() = "gorget_gl_end"
    extern void gl_vertex3f(float x, float y, float z) = "gorget_gl_vertex3f"
    extern void gl_tex_coord2f(float s, float t) = "gorget_gl_tex_coord2f"
    extern void gl_normal3f(float x, float y, float z) = "gorget_gl_normal3f"
    extern void gl_color4f(float r, float g, float b, float a) = "gorget_gl_color4f"
    extern void gl_color3f(float r, float g, float b) = "gorget_gl_color3f"

    # Client-side Vertex Arrays (Q3 renderergl1)
    extern void gl_vertex_pointer(int size, int type_, int stride, Vector[uint8] data) = "gorget_gl_vertex_pointer"
    extern void gl_tex_coord_pointer(int size, int type_, int stride, Vector[uint8] data) = "gorget_gl_tex_coord_pointer"
    extern void gl_color_pointer(int size, int type_, int stride, Vector[uint8] data) = "gorget_gl_color_pointer"
    extern void gl_normal_pointer(int type_, int stride, Vector[uint8] data) = "gorget_gl_normal_pointer"
    extern void gl_enable_client_state(int cap) = "gorget_gl_enable_client_state"
    extern void gl_disable_client_state(int cap) = "gorget_gl_disable_client_state"

    # Fixed-function State (Q3)
    extern void gl_alpha_func(int func, float ref_val) = "gorget_gl_alpha_func"
    extern void gl_shade_model(int mode) = "gorget_gl_shade_model"
    extern void gl_tex_env_f(int target, int pname, int param) = "gorget_gl_tex_env_f"
    extern void gl_depth_range(float near, float far) = "gorget_gl_depth_range"
    extern void gl_polygon_mode(int face, int mode) = "gorget_gl_polygon_mode"
    extern void gl_translate_f(float x, float y, float z) = "gorget_gl_translate_f"
    extern void gl_scale_f(float x, float y, float z) = "gorget_gl_scale_f"
    extern void gl_rotate_f(float angle, float x, float y, float z) = "gorget_gl_rotate_f"

    # Projection / Clipping
    extern void gl_ortho(float left, float right, float bottom, float top, float near, float far) = "gorget_gl_ortho"
    extern void gl_frustum(float left, float right, float bottom, float top, float near, float far) = "gorget_gl_frustum"
    extern void gl_clip_plane(int plane, Vector[uint8] equation) = "gorget_gl_clip_plane"

    # Draw Control
    extern void gl_draw_buffer(int mode) = "gorget_gl_draw_buffer"
    extern void gl_read_pixels(int x, int y, int w, int h, int format, int type_, Vector[uint8] data) = "gorget_gl_read_pixels"
    extern void gl_finish() = "gorget_gl_finish"
    extern void gl_flush() = "gorget_gl_flush"

    # Clear Control
    extern void gl_clear_depth(float depth) = "gorget_gl_clear_depth"
    extern void gl_clear_stencil(int s) = "gorget_gl_clear_stencil"

