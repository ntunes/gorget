# xtd.gl -- OpenGL bindings (GL 2.1 through GL 4.6)
#
# Covers: fixed-function pipeline (GL 1.x/2.x), modern programmable pipeline
# (shaders, VBOs, VAOs, FBOs), and advanced features (compute, tessellation,
# transform feedback, indirect draw, debug output).
#
# All functions delegate to gorget_gl_* C runtime wrappers.

from std.collections import Vector

