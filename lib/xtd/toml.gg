# std.toml — Pure Gorget TOML v1.0 parser
#
# Provides a recursive-descent TOML parser, serializer, and accessor methods.
# No C dependencies — uses only Gorget standard library.
#
# Architecture: two-phase parsing.
# Phase 1: Collect flat sections (path + key-value Dict per section).
# Phase 2: Assemble nested tree bottom-up via recursion.
# This avoids Gorget's value-type Dict aliasing (copying metadata on extract).

from std.collections import Vector, Dict
from std.conv import parse_int, parse_float, int_to_str, float_to_str, bool_to_str, codepoint_to_str, ParseError

# ── TOML value type ─────────────────────────────────────────

enum TomlValue:
    Str(String)
    Int(int)
    Float(float)
    Bool(bool)
    DateTime(String)
    Arr(Vector[TomlValue])
    Tbl(Dict[String, TomlValue])

# ── Section collection ──────────────────────────────────────
# Each [table] or [[array-of-tables]] header starts a new section.
# Root-level key-value pairs belong to section with empty path.

struct TomlSection:
    Vector[String] sec_path
    Dict[String, TomlValue] sec_data
    bool sec_is_aot

# ── Internal parser ─────────────────────────────────────────
#
# `defined` maps a dotted path to a definition kind. Used to enforce
# TOML 1.0 §6.1 / §8 (no key/table redefinition, inline tables are
# immutable, array-of-tables and tables can't share a path).
# Kinds (int code, with helper functions below):
#   0 = explicit table       — created by [t] header. Cannot be redefined
#                              by any later [t], [[t]], or dotted key.
#   1 = array of tables      — created by [[t]] header. Only [[t]] may
#                              extend it; later [t] is illegal.
#   2 = implicit table       — parent of a deeper [a.b.c] header. May be
#                              "upgraded" to explicit by a later [a] line.
#   3 = inline table         — created by `x = { ... }`. Closed at }; any
#                              later extension via [t.x] or t.x = v is illegal.
#   4 = scalar               — created by `k = v` for non-table v. Cannot
#                              be turned into a table later.
#   5 = dotted-key table     — created by `a.b.c = v` for the intermediate
#                              parents (a, a.b). Each parent may grow more
#                              dotted-key entries, but cannot be reopened as
#                              a header [a] or [a.b].

struct TomlParser:
    String source
    int pos
    String err
    Vector[TomlSection] sections
    int current_sec
    Dict[String, int] defined

equip TomlParser:
    bool failed(self): self.err != ""

    void fail(&self, String msg):
        if self.err == "":
            self.err = !msg

    String peek(self):
        if self.pos < self.source.byte_len():
            return self.source.char_at(self.pos)
        return '\0'

    bool at_end(self): self.pos >= self.source.byte_len()

    void skip_ws(&self):
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == ' ' or ch == '\t':
                self.pos = self.pos + 1
            else:
                return

    void skip_ws_and_newlines(&self):
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b' ' or b == b'\t' or b == b'\n':
                self.pos = self.pos + 1
            elif b == b'\r':
                # CR only valid as part of \r\n.
                if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                    self.pos = self.pos + 2
                else:
                    self.fail("bare carriage return not allowed")
                    return
            elif b == b'#':
                self.skip_comment()
            else:
                return

    void skip_comment(&self):
        # TOML 1.0 §3: comments forbid control chars (0x00-0x08, 0x0A-0x1F
        # except tab 0x09, and 0x7F).
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b'\n':
                return
            if b == b'\r':
                # CR ends the comment only when followed by LF.
                if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                    return
                self.fail("bare carriage return not allowed in comment")
                return
            if is_basic_string_control_byte(b):
                self.fail("control character not allowed in comment")
                return
            self.pos = self.pos + 1

    # After a value or table header, the only legal characters before the
    # next line are: whitespace, '#' (comment), '\n', or EOF. Anything else
    # (e.g. another bare-key starting a second key=value on the same line,
    # or stray characters) is invalid per TOML 1.0 §3.
    void expect_eol(&self, String msg):
        self.skip_ws()
        if self.pos >= self.source.byte_len():
            return
        byte b = self.source.byte_at(self.pos)
        if b == b'#':
            self.skip_comment()
            return
        if b == b'\n':
            self.pos = self.pos + 1
            return
        if b == b'\r':
            if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                self.pos = self.pos + 2
                return
            self.fail("bare carriage return not allowed")
            return
        self.fail(msg)

    void skip_to_newline(&self):
        self.skip_ws()
        if self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b'#':
                self.skip_comment()
                if self.failed():
                    return
                # After skip_comment, we land at \n or \r\n (or EOF).
                if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\r':
                    if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                        self.pos = self.pos + 2
                if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\n':
                    self.pos = self.pos + 1
                return
            if b == b'\n':
                self.pos = self.pos + 1
            elif b == b'\r':
                if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                    self.pos = self.pos + 2
                else:
                    self.fail("bare carriage return not allowed")

    # ── Key parsing ─────────────────────────────────────────

    String parse_bare_key(&self):
        int start = self.pos
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch >= 'a' and ch <= 'z':
                self.pos = self.pos + 1
            elif ch >= 'A' and ch <= 'Z':
                self.pos = self.pos + 1
            elif ch >= '0' and ch <= '9':
                self.pos = self.pos + 1
            elif ch == '-' or ch == '_':
                self.pos = self.pos + 1
            else:
                break
        if self.pos == start:
            self.fail("expected key")
            return ""
        return self.source.byte_slice(start, self.pos)

    String parse_key_part(&self):
        if self.pos >= self.source.byte_len():
            self.fail("expected key")
            return ""
        String ch = self.source.char_at(self.pos)
        if ch == '"':
            # Multi-line strings ("""...""") are NOT valid as keys per
            # TOML 1.0 §6.1.
            if self.pos + 2 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'"' and self.source.byte_at(self.pos + 2) == b'"':
                self.fail("multi-line string not allowed as key")
                return ""
            return self.parse_basic_string()
        elif ch == '\'':
            if self.pos + 2 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\'' and self.source.byte_at(self.pos + 2) == b'\'':
                self.fail("multi-line literal string not allowed as key")
                return ""
            return self.parse_literal_string()
        return self.parse_bare_key()

    Vector[String] parse_key(&self):
        Vector[String] parts = Vector[String]()
        String first_part = self.parse_key_part()
        if self.failed():
            return parts
        parts.push(!first_part)
        while true:
            # Allow whitespace around the dot: a . b = 1
            self.skip_ws()
            if self.pos >= self.source.byte_len() or self.source.byte_at(self.pos) != b'.':
                break
            self.pos = self.pos + 1
            self.skip_ws()
            String next_part = self.parse_key_part()
            if self.failed():
                return parts
            parts.push(!next_part)
        return parts

    # ── String parsing ──────────────────────────────────────

    String parse_basic_string(&self):
        # Skip opening "
        self.pos = self.pos + 1
        # Check for multi-line """
        if self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '"' and self.source.char_at(self.pos + 1) == '"':
            self.pos = self.pos + 2
            return self.parse_ml_basic_string()
        String toml_result = ""
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            # TOML 1.0 §5.1: basic strings disallow unescaped control chars
            # 0x00-0x08, 0x0A-0x1F, 0x7F. Tab (0x09) is permitted.
            if is_basic_string_control_byte(b):
                self.fail("control character not allowed in basic string")
                return ""
            String ch = self.source.char_at(self.pos)
            if ch == '"':
                self.pos = self.pos + 1
                return toml_result
            elif ch == '\\':
                toml_result = toml_result + self.parse_escape()
            else:
                toml_result = toml_result + ch
                self.pos = self.pos + 1
        self.fail("unterminated basic string")
        return ""

    String parse_ml_basic_string(&self):
        # Skip optional first newline after """
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
            self.pos = self.pos + 1
        elif self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\r' and self.source.char_at(self.pos + 1) == '\n':
            self.pos = self.pos + 2
        String toml_result = ""
        while self.pos < self.source.byte_len():
            if self.pos + 2 < self.source.byte_len() and self.source.char_at(self.pos) == '"' and self.source.char_at(self.pos + 1) == '"' and self.source.char_at(self.pos + 2) == '"':
                self.pos = self.pos + 3
                # Allow up to two trailing " to be consumed as content
                # (per spec, """""" closes after seeing the 3rd ").
                if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'"':
                    toml_result = toml_result + "\""
                    self.pos = self.pos + 1
                    if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'"':
                        toml_result = toml_result + "\""
                        self.pos = self.pos + 1
                return toml_result
            byte b = self.source.byte_at(self.pos)
            # Reject control chars except \t, \n, \r (which is only valid as
            # part of \r\n).
            if b == b'\r':
                if self.pos + 1 >= self.source.byte_len() or self.source.byte_at(self.pos + 1) != b'\n':
                    self.fail("bare carriage return not allowed in multi-line basic string")
                    return ""
            elif is_ml_basic_control_byte(b):
                self.fail("control character not allowed in multi-line basic string")
                return ""
            String ch = self.source.char_at(self.pos)
            if ch == '\\':
                # Line continuation: backslash followed by optional whitespace
                # then newline swallows the newline and subsequent leading
                # whitespace (TOML 1.0 §5.4).
                if self.is_line_continuation(self.pos):
                    self.pos = self.pos + 1  # consume backslash
                    self.skip_line_cont_ws()
                else:
                    toml_result = toml_result + self.parse_escape()
            else:
                toml_result = toml_result + ch
                self.pos = self.pos + 1
        self.fail("unterminated multi-line basic string")
        return ""

    # True iff source[p] is a '\\' followed (after only spaces/tabs) by a newline.
    bool is_line_continuation(self, int p):
        if p >= self.source.byte_len() or self.source.byte_at(p) != b'\\':
            return false
        int q = p + 1
        while q < self.source.byte_len():
            byte b = self.source.byte_at(q)
            if b == b' ' or b == b'\t':
                q = q + 1
            else:
                break
        if q >= self.source.byte_len():
            return false
        byte nb = self.source.byte_at(q)
        return nb == b'\n' or nb == b'\r'

    # Consume whitespace (spaces, tabs, newlines) after a \-line-continuation.
    # Skips one or more newlines and any subsequent leading whitespace.
    void skip_line_cont_ws(&self):
        # First skip up to the newline.
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b' ' or b == b'\t':
                self.pos = self.pos + 1
            else:
                break
        # Consume newline.
        if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\r':
            self.pos = self.pos + 1
        if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\n':
            self.pos = self.pos + 1
        # Then skip whitespace AND newlines until the next non-ws char.
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b' ' or b == b'\t' or b == b'\n' or b == b'\r':
                self.pos = self.pos + 1
            else:
                break

    String parse_escape(&self):
        self.pos = self.pos + 1
        if self.pos >= self.source.byte_len():
            self.fail("unterminated escape sequence")
            return ""
        String esc = self.source.char_at(self.pos)
        self.pos = self.pos + 1
        if esc == '"':
            return "\""
        elif esc == '\\':
            return "\\"
        elif esc == 'n':
            return "\n"
        elif esc == 't':
            return "\t"
        elif esc == 'r':
            return "\r"
        elif esc == 'b':
            return "\x08"
        elif esc == 'f':
            return "\x0c"
        elif esc == 'u' or esc == 'U':
            int toml_hex_len = 4
            if esc == 'U':
                toml_hex_len = 8
            int toml_uni_cp = 0
            int toml_uni_cnt = 0
            while toml_uni_cnt < toml_hex_len and self.pos < self.source.byte_len():
                byte toml_uhc = self.source.byte_at(self.pos)
                int toml_uhv = -1
                if toml_uhc >= b'0' and toml_uhc <= b'9':
                    toml_uhv = toml_uhc as int - b'0'
                elif toml_uhc >= b'a' and toml_uhc <= b'f':
                    toml_uhv = toml_uhc as int - b'a' + 10
                elif toml_uhc >= b'A' and toml_uhc <= b'F':
                    toml_uhv = toml_uhc as int - b'A' + 10
                if toml_uhv < 0:
                    self.fail("invalid hex digit in unicode escape")
                    return ""
                toml_uni_cp = toml_uni_cp * 16 + toml_uhv
                self.pos = self.pos + 1
                toml_uni_cnt = toml_uni_cnt + 1
            if toml_uni_cnt < toml_hex_len:
                self.fail("truncated unicode escape")
                return ""
            # TOML 1.0 §5: codepoint must be a valid Unicode scalar
            # value — i.e. in [U+0000, U+10FFFF] and NOT a surrogate
            # (U+D800..=U+DFFF).
            if toml_uni_cp > 0x10ffff:
                self.fail("unicode escape out of range")
                return ""
            if toml_uni_cp >= 0xd800 and toml_uni_cp <= 0xdfff:
                self.fail("unicode escape is a surrogate, not a scalar value")
                return ""
            return codepoint_to_str(toml_uni_cp)
        self.fail("invalid escape sequence")
        return ""

    String parse_literal_string(&self):
        self.pos = self.pos + 1
        if self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\'' and self.source.char_at(self.pos + 1) == '\'':
            self.pos = self.pos + 2
            return self.parse_ml_literal_string()
        String toml_result = ""
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            # TOML 1.0 §5.2: literal strings disallow unescaped control chars
            # 0x00-0x08, 0x0A-0x1F, 0x7F. Tab (0x09) is permitted.
            if is_basic_string_control_byte(b):
                self.fail("control character not allowed in literal string")
                return ""
            String ch = self.source.char_at(self.pos)
            if ch == '\'':
                self.pos = self.pos + 1
                return toml_result
            toml_result = toml_result + ch
            self.pos = self.pos + 1
        self.fail("unterminated literal string")
        return ""

    String parse_ml_literal_string(&self):
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
            self.pos = self.pos + 1
        elif self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\r' and self.source.char_at(self.pos + 1) == '\n':
            self.pos = self.pos + 2
        String toml_result = ""
        while self.pos < self.source.byte_len():
            if self.pos + 2 < self.source.byte_len() and self.source.char_at(self.pos) == '\'' and self.source.char_at(self.pos + 1) == '\'' and self.source.char_at(self.pos + 2) == '\'':
                self.pos = self.pos + 3
                # Allow up to two trailing ' as content (per spec, ''''''
                # closes after the 3rd ').
                if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\'':
                    toml_result = toml_result + "'"
                    self.pos = self.pos + 1
                    if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'\'':
                        toml_result = toml_result + "'"
                        self.pos = self.pos + 1
                return toml_result
            byte b = self.source.byte_at(self.pos)
            # Reject control chars except \t, \n, \r (which is only valid as
            # part of \r\n).
            if b == b'\r':
                if self.pos + 1 >= self.source.byte_len() or self.source.byte_at(self.pos + 1) != b'\n':
                    self.fail("bare carriage return not allowed in multi-line literal string")
                    return ""
            elif is_ml_basic_control_byte(b):
                self.fail("control character not allowed in multi-line literal string")
                return ""
            toml_result = toml_result + self.source.char_at(self.pos)
            self.pos = self.pos + 1
        self.fail("unterminated multi-line literal string")
        return ""

    # ── Value parsing ───────────────────────────────────────

    TomlValue parse_value(&self):
        if self.failed():
            return Str("")
        self.skip_ws()
        if self.at_end():
            self.fail("unexpected end of input")
            return Str("")
        String ch = self.peek()
        if ch == '"':
            String sv = self.parse_basic_string()
            return Str(sv)
        elif ch == '\'':
            String sv = self.parse_literal_string()
            return Str(sv)
        elif ch == 't' or ch == 'f':
            return self.parse_bool()
        elif ch == '[':
            return self.parse_array()
        elif ch == '{':
            return self.parse_inline_table()
        elif ch == 'i' or ch == 'n':
            return self.parse_special_float()
        return self.parse_number_or_date()

    TomlValue parse_bool(&self):
        if self.pos + 4 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 4) == "true":
            self.pos = self.pos + 4
            return Bool(true)
        if self.pos + 5 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 5) == "false":
            self.pos = self.pos + 5
            return Bool(false)
        self.fail("expected boolean")
        return Str("")

    TomlValue parse_special_float(&self):
        if self.pos + 3 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 3) == "inf":
            self.pos = self.pos + 3
            return Float(1.0 / 0.0)
        if self.pos + 3 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 3) == "nan":
            self.pos = self.pos + 3
            return Float(0.0 / 0.0)
        self.fail("unexpected keyword")
        return Str("")

    TomlValue parse_array(&self):
        self.pos = self.pos + 1
        Vector[TomlValue] elems = Vector[TomlValue]()
        self.skip_ws_and_newlines()
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == ']':
            self.pos = self.pos + 1
            return Arr(elems)
        while self.pos < self.source.byte_len():
            self.skip_ws_and_newlines()
            TomlValue elem = self.parse_value()
            if self.failed():
                return Str("")
            elems.push(!elem)
            self.skip_ws_and_newlines()
            if self.pos >= self.source.byte_len():
                self.fail("unterminated array")
                return Str("")
            if self.source.char_at(self.pos) == ',':
                self.pos = self.pos + 1
                self.skip_ws_and_newlines()
                if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == ']':
                    self.pos = self.pos + 1
                    return Arr(elems)
            elif self.source.char_at(self.pos) == ']':
                self.pos = self.pos + 1
                return Arr(elems)
            else:
                self.fail("expected ',' or ']' in array")
                return Str("")
        self.fail("unterminated array")
        return Str("")

    TomlValue parse_inline_table(&self):
        self.pos = self.pos + 1
        Dict[String, TomlValue] tbl = Dict[String, TomlValue]()
        # Track local defined-paths for THIS inline table. Joined dotted
        # path → 1 (closed leaf) | 2 (intermediate from dotted assignment).
        Dict[String, int] local_defs = Dict[String, int]()
        self.skip_ws_and_newlines_in_inline()
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '}':
            self.pos = self.pos + 1
            return Tbl(tbl)
        while self.pos < self.source.byte_len():
            self.skip_ws_and_newlines_in_inline()
            Vector[String] key_parts = self.parse_key()
            if self.failed():
                return Str("")
            self.skip_ws()
            if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != '=':
                self.fail("expected '=' after key in inline table")
                return Str("")
            self.pos = self.pos + 1
            self.skip_ws()
            TomlValue tbl_val = self.parse_value()
            if self.failed():
                return Str("")
            # Check for duplicate key inside this inline table. For a dotted
            # key, intermediate parts must be undefined or kind-2; final
            # part must be undefined.
            String joined = ""
            int kpi = 0
            while kpi < key_parts.len():
                joined = joined + "\x01" + key_parts.get(kpi).unwrap()
                if kpi < key_parts.len() - 1:
                    if local_defs.contains(joined):
                        int lk = local_defs.get(joined).unwrap()
                        if lk != 2:
                            self.fail("duplicate key in inline table")
                            return Str("")
                    else:
                        local_defs.put(joined.clone(), 2)
                kpi = kpi + 1
            if local_defs.contains(joined):
                self.fail("duplicate key in inline table")
                return Str("")
            local_defs.put(joined.clone(), 1)
            # For inline tables, dotted keys create nested tables inline
            if key_parts.len() == 1:
                tbl.put(key_parts.get(0).unwrap(), tbl_val)
            else:
                # Build nested structure for dotted key in inline table.
                # If the head key already exists in tbl, merge the new
                # nested structure into it.
                String top = key_parts.get(0).unwrap()
                TomlValue nested = wrap_dotted(key_parts, 1, !tbl_val)
                if tbl.contains(top):
                    Dict[String, TomlValue] existing = extract_tbl(tbl[top])
                    Dict[String, TomlValue] addition = extract_tbl(nested)
                    Dict[String, TomlValue] merged = merge_into(Tbl(existing), addition)
                    tbl.put(top, Tbl(merged))
                else:
                    tbl.put(top, nested)
            self.skip_ws()
            if self.pos >= self.source.byte_len():
                self.fail("unterminated inline table")
                return Str("")
            if self.source.char_at(self.pos) == ',':
                self.pos = self.pos + 1
                # TOML 1.0 forbids trailing comma in inline tables.
                self.skip_ws()
                if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '}':
                    self.fail("trailing comma not allowed in inline table")
                    return Str("")
            elif self.source.char_at(self.pos) == '}':
                self.pos = self.pos + 1
                return Tbl(tbl)
            else:
                self.fail("expected ',' or '}' in inline table")
                return Str("")
        self.fail("unterminated inline table")
        return Str("")

    # Inline tables forbid newlines unless following TOML 1.1 (which we
    # don't target). Skip spaces and tabs ONLY (no \n / \r).
    void skip_ws_and_newlines_in_inline(&self):
        self.skip_ws()

    # ── Number / date-time parsing ──────────────────────────

    TomlValue parse_number_or_date(&self):
        # Date prefix: YYYY-MM-DD at current position.
        if self.is_date_prefix(self.pos):
            return self.parse_datetime_value()
        # Time prefix: HH:MM:SS at current position.
        if self.is_time_prefix(self.pos):
            return self.parse_time_value()
        return self.parse_numeric_value()

    bool is_date_prefix(self, int p):
        if p + 10 > self.source.byte_len():
            return false
        if not (self.byte_is_digit(p) and self.byte_is_digit(p + 1) and self.byte_is_digit(p + 2) and self.byte_is_digit(p + 3)):
            return false
        if self.source.byte_at(p + 4) != b'-':
            return false
        if not (self.byte_is_digit(p + 5) and self.byte_is_digit(p + 6)):
            return false
        if self.source.byte_at(p + 7) != b'-':
            return false
        if not (self.byte_is_digit(p + 8) and self.byte_is_digit(p + 9)):
            return false
        return true

    bool is_time_prefix(self, int p):
        if p + 8 > self.source.byte_len():
            return false
        if not (self.byte_is_digit(p) and self.byte_is_digit(p + 1)):
            return false
        if self.source.byte_at(p + 2) != b':':
            return false
        if not (self.byte_is_digit(p + 3) and self.byte_is_digit(p + 4)):
            return false
        if self.source.byte_at(p + 5) != b':':
            return false
        if not (self.byte_is_digit(p + 6) and self.byte_is_digit(p + 7)):
            return false
        return true

    bool byte_is_digit(self, int p):
        if p >= self.source.byte_len():
            return false
        byte b = self.source.byte_at(p)
        return b >= b'0' and b <= b'9'

    # Parse YYYY-MM-DD optionally followed by [T|t| ] HH:MM:SS[.fff][Z|z|+HH:MM|-HH:MM].
    # Also validates ranges (month 1-12, day 1-31 per month, hour 0-23, etc).
    TomlValue parse_datetime_value(&self):
        int start = self.pos
        int year = self.read_n_digits(4)
        self.pos = self.pos + 1  # skip '-'
        int month = self.read_n_digits(2)
        self.pos = self.pos + 1  # skip '-'
        int day = self.read_n_digits(2)
        if not valid_date(year, month, day):
            self.fail("invalid date")
            return Str("")
        # Peek separator. If T/t/space-followed-by-digit, continue with time.
        bool has_time = false
        if self.pos < self.source.byte_len():
            byte sep = self.source.byte_at(self.pos)
            if sep == b'T' or sep == b't':
                has_time = true
                self.pos = self.pos + 1
            elif sep == b' ' and self.pos + 1 < self.source.byte_len() and self.byte_is_digit(self.pos + 1):
                has_time = true
                self.pos = self.pos + 1
        if not has_time:
            return DateTime(self.normalize_dt_text(start, self.pos))
        # Time portion: HH:MM:SS[.fff]
        if not self.is_time_prefix(self.pos):
            self.fail("invalid time after date")
            return Str("")
        int hour = self.read_n_digits(2)
        self.pos = self.pos + 1  # skip ':'
        int minute = self.read_n_digits(2)
        self.pos = self.pos + 1  # skip ':'
        int second = self.read_n_digits(2)
        if not valid_time(hour, minute, second):
            self.fail("invalid time")
            return Str("")
        # Optional fractional seconds.
        if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'.':
            self.pos = self.pos + 1
            int frac_count = 0
            while self.pos < self.source.byte_len() and self.byte_is_digit(self.pos):
                self.pos = self.pos + 1
                frac_count = frac_count + 1
            if frac_count == 0:
                self.fail("expected digits after '.' in fractional seconds")
                return Str("")
        # Optional offset: Z/z or +HH:MM/-HH:MM
        if self.pos < self.source.byte_len():
            byte ob = self.source.byte_at(self.pos)
            if ob == b'Z' or ob == b'z':
                self.pos = self.pos + 1
            elif ob == b'+' or ob == b'-':
                self.pos = self.pos + 1
                int off_h = self.read_n_digits(2)
                if self.pos >= self.source.byte_len() or self.source.byte_at(self.pos) != b':':
                    self.fail("expected ':' in datetime offset")
                    return Str("")
                self.pos = self.pos + 1
                int off_m = self.read_n_digits(2)
                if off_h > 23 or off_m > 59:
                    self.fail("invalid datetime offset")
                    return Str("")
        return DateTime(self.normalize_dt_text(start, self.pos))

    # Read exactly n digits and return their integer value. Fails parser on
    # non-digit / EOF. Position advances by n on success.
    int read_n_digits(&self, int n):
        int v = 0
        int i = 0
        while i < n:
            if self.pos >= self.source.byte_len() or not self.byte_is_digit(self.pos):
                self.fail("expected digit")
                return 0
            v = v * 10 + (self.source.byte_at(self.pos) as int - b'0')
            self.pos = self.pos + 1
            i = i + 1
        return v

    String normalize_dt_text(self, int s, int e):
        # Preserve the raw source slice. Runner normalises t/z/space when comparing.
        return self.source.byte_slice(s, e)

    TomlValue parse_time_value(&self):
        int start = self.pos
        int hour = self.read_n_digits(2)
        self.pos = self.pos + 1  # ':'
        int minute = self.read_n_digits(2)
        self.pos = self.pos + 1  # ':'
        int second = self.read_n_digits(2)
        if not valid_time(hour, minute, second):
            self.fail("invalid time")
            return Str("")
        if self.pos < self.source.byte_len() and self.source.byte_at(self.pos) == b'.':
            self.pos = self.pos + 1
            int frac_count = 0
            while self.pos < self.source.byte_len() and self.byte_is_digit(self.pos):
                self.pos = self.pos + 1
                frac_count = frac_count + 1
            if frac_count == 0:
                self.fail("expected digits after '.' in fractional seconds")
                return Str("")
        return DateTime(self.source.byte_slice(start, self.pos))

    # Numeric parsing with strict TOML grammar:
    #   - Sign optional (single +/- at start).
    #   - 0x/0o/0b prefixes for hex/oct/bin (lowercase only, no sign before prefix).
    #   - No leading zeros for decimal integers / float mantissas (except "0").
    #   - Underscores only between digits.
    #   - Float requires digits on both sides of '.', and digits after 'e'.
    TomlValue parse_numeric_value(&self):
        int start = self.pos
        bool is_negative = false
        bool has_sign = false
        if self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b'-':
                is_negative = true
                has_sign = true
                self.pos = self.pos + 1
            elif b == b'+':
                has_sign = true
                self.pos = self.pos + 1
        # inf / nan
        if self.pos + 3 <= self.source.byte_len():
            String num_special = self.source.byte_slice(self.pos, self.pos + 3)
            if num_special == "inf":
                self.pos = self.pos + 3
                if is_negative:
                    return Float(-1.0 / 0.0)
                return Float(1.0 / 0.0)
            if num_special == "nan":
                self.pos = self.pos + 3
                return Float(0.0 / 0.0)
        # Prefixed integer (no sign allowed before hex/oct/bin)
        if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos) == b'0':
            byte after = self.source.byte_at(self.pos + 1)
            if after == b'x' or after == b'o' or after == b'b':
                if has_sign:
                    self.fail("sign not allowed before hex/oct/bin prefix")
                    return Int(0)
                String pfx = ""
                if after == b'x':
                    pfx = "x"
                elif after == b'o':
                    pfx = "o"
                else:
                    pfx = "b"
                return self.parse_prefixed_int(start, false, pfx)
            # Uppercase prefix (0X, 0O, 0B) is invalid per TOML spec.
            if after == b'X' or after == b'O' or after == b'B':
                self.fail("hex/oct/bin prefix must be lowercase")
                return Int(0)
        # Decimal integer/float — must start with a digit.
        if self.pos >= self.source.byte_len() or not self.byte_is_digit(self.pos):
            self.fail("expected digit in number")
            return Int(0)
        # Track leading-zero state: if the first digit is '0' and the next char
        # is a digit, that's a leading-zero violation (e.g. "01", "0123").
        bool starts_with_zero = self.source.byte_at(self.pos) == b'0'
        bool int_part_has_more_than_one = false
        int int_start = self.pos
        self.pos = self.pos + 1
        # Continue scanning integer digits, with strict underscore rules:
        #   underscore must be sandwiched between digits.
        while self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if self.byte_is_digit(self.pos):
                int_part_has_more_than_one = true
                self.pos = self.pos + 1
            elif b == b'_':
                # Underscore requires digit on both sides.
                if self.pos + 1 >= self.source.byte_len() or not self.byte_is_digit(self.pos + 1):
                    self.fail("underscore must be surrounded by digits")
                    return Int(0)
                # The previous byte must be a digit too (always true here since
                # we just consumed one or the int_start digit).
                self.pos = self.pos + 1
            else:
                break
        if starts_with_zero and int_part_has_more_than_one:
            self.fail("leading zeros not allowed")
            return Int(0)
        # Look for '.' or 'e'/'E' to detect float.
        bool is_float = false
        if self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b'.':
                is_float = true
                self.pos = self.pos + 1
                # At least one digit required after dot.
                if self.pos >= self.source.byte_len() or not self.byte_is_digit(self.pos):
                    self.fail("expected digit after '.'")
                    return Float(0.0)
                self.pos = self.pos + 1
                while self.pos < self.source.byte_len():
                    byte b2 = self.source.byte_at(self.pos)
                    if self.byte_is_digit(self.pos):
                        self.pos = self.pos + 1
                    elif b2 == b'_':
                        if self.pos + 1 >= self.source.byte_len() or not self.byte_is_digit(self.pos + 1):
                            self.fail("underscore must be surrounded by digits")
                            return Float(0.0)
                        self.pos = self.pos + 1
                    else:
                        break
        if self.pos < self.source.byte_len():
            byte b = self.source.byte_at(self.pos)
            if b == b'e' or b == b'E':
                is_float = true
                self.pos = self.pos + 1
                if self.pos < self.source.byte_len():
                    byte sb = self.source.byte_at(self.pos)
                    if sb == b'+' or sb == b'-':
                        self.pos = self.pos + 1
                # At least one digit required in exponent.
                if self.pos >= self.source.byte_len() or not self.byte_is_digit(self.pos):
                    self.fail("expected digit in exponent")
                    return Float(0.0)
                # Exponent disallows leading zero in stricter grammars; TOML
                # actually permits leading zeros here ("1e01" is valid). So
                # consume digits with underscore rules.
                self.pos = self.pos + 1
                while self.pos < self.source.byte_len():
                    byte b2 = self.source.byte_at(self.pos)
                    if self.byte_is_digit(self.pos):
                        self.pos = self.pos + 1
                    elif b2 == b'_':
                        if self.pos + 1 >= self.source.byte_len() or not self.byte_is_digit(self.pos + 1):
                            self.fail("underscore must be surrounded by digits")
                            return Float(0.0)
                        self.pos = self.pos + 1
                    else:
                        break
        String num_text = self.source.byte_slice(start, self.pos)
        String cleaned = strip_underscores(num_text)
        if is_float:
            float fv = parse_float(cleaned).unwrap_or(0.0)
            return Float(fv)
        int iv = parse_int(cleaned).unwrap_or(0)
        return Int(iv)

    TomlValue parse_prefixed_int(&self, int start, bool is_negative, String num_prefix):
        self.pos = self.pos + 2
        int val = 0
        int base = 16
        if num_prefix == "o":
            base = 8
        elif num_prefix == "b":
            base = 2
        bool has_digits = false
        bool last_was_underscore = true  # treat start as "before any digit" so leading _ is rejected
        while self.pos < self.source.byte_len():
            byte ch = self.source.byte_at(self.pos)
            if ch == b'_':
                if last_was_underscore:
                    self.fail("underscore must be surrounded by digits")
                    return Int(0)
                self.pos = self.pos + 1
                last_was_underscore = true
            elif ch >= b'0' and ch <= b'9':
                int digit = ch as int - b'0'
                if digit >= base:
                    if base == 16:
                        # digit 0-9 is always valid in hex; this branch is dead. Kept for clarity.
                        pass
                    else:
                        self.fail("invalid digit for base")
                        return Int(0)
                val = val * base + digit
                self.pos = self.pos + 1
                has_digits = true
                last_was_underscore = false
            elif ch >= b'a' and ch <= b'f' and base == 16:
                val = val * 16 + (ch as int - b'a' + 10)
                self.pos = self.pos + 1
                has_digits = true
                last_was_underscore = false
            elif ch >= b'A' and ch <= b'F' and base == 16:
                val = val * 16 + (ch as int - b'A' + 10)
                self.pos = self.pos + 1
                has_digits = true
                last_was_underscore = false
            else:
                break
        if not has_digits:
            self.fail("expected digits after prefix")
            return Int(0)
        if last_was_underscore:
            self.fail("trailing underscore not allowed")
            return Int(0)
        if is_negative:
            val = 0 - val
        return Int(val)

    # ── Definition tracking (§6.1 / §8 redefinition rules) ──

    # Join a (current_section_path, additional_key_parts) into a single
    # canonical dotted path used as the key in `self.defined`.
    #
    # Each part is prefixed with a NUL-like separator so that empty key
    # parts (TOML allows '' / "" as a quoted key) don't collide with
    # adjacent parts. The encoding doesn't need to be human-readable; it
    # just needs to be injective.
    String make_path(self, Vector[String] base, Vector[String] extra):
        String s = ""
        int i = 0
        while i < base.len():
            s = s + "\x01" + base.get(i).unwrap()
            i = i + 1
        int j = 0
        while j < extra.len():
            s = s + "\x01" + extra.get(j).unwrap()
            j = j + 1
        return s

    # Header [t]: register every prefix as implicit (kind 2) if not yet
    # known, then the full path as explicit (kind 0). Returns false on
    # conflict (parser is failed).
    bool register_table_header(&self, Vector[String] path):
        # Prefixes: must be table-shaped (implicit / explicit / dotted-table
        # / array-of-tables for the parent — but NOT scalar / inline).
        Vector[String] empty = Vector[String]()
        int n = path.len()
        int i = 0
        while i < n - 1:
            Vector[String] prefix = Vector[String]()
            int k = 0
            while k <= i:
                prefix.push(path.get(k).unwrap().clone())
                k = k + 1
            String pp = self.make_path(empty, prefix)
            if self.defined.contains(pp):
                int kind = self.defined.get(pp).unwrap()
                if kind == 3 or kind == 4:
                    self.fail("cannot extend inline table or scalar via dotted header")
                    return false
                # Implicit, explicit, dotted-table, array-of-tables are all OK
                # as prefix containers.
            else:
                self.defined.put(pp, 2)  # implicit
            i = i + 1
        String fp = self.make_path(empty, path)
        if self.defined.contains(fp):
            int kind = self.defined.get(fp).unwrap()
            if kind == 2:
                # Implicit -> upgrade to explicit.
                self.defined.put(fp, 0)
                return true
            # Anything else (explicit, array, inline, scalar, dotted-table)
            # is a redefinition error.
            self.fail("table already defined")
            return false
        self.defined.put(fp, 0)
        return true

    # Header [[t]]: prefixes same rules; full path must be undefined or
    # already-an-array. Implicit upgrade NOT supported because [[t]] can
    # only extend an existing array, not turn an implicit table into one.
    bool register_aot_header(&self, Vector[String] path):
        Vector[String] empty = Vector[String]()
        int n = path.len()
        int i = 0
        while i < n - 1:
            Vector[String] prefix = Vector[String]()
            int k = 0
            while k <= i:
                prefix.push(path.get(k).unwrap().clone())
                k = k + 1
            String pp = self.make_path(empty, prefix)
            if self.defined.contains(pp):
                int kind = self.defined.get(pp).unwrap()
                if kind == 3 or kind == 4:
                    self.fail("cannot extend inline table or scalar via dotted aot header")
                    return false
                # Note: kind 1 (existing AoT) IS allowed as a prefix — see
                # `[[fruits]]\n[[fruits.varieties]]` in
                # valid/spec/array-of-tables-1. Each new [[t.x]] applies to
                # the most recent t element.
            else:
                self.defined.put(pp, 2)
            i = i + 1
        String fp = self.make_path(empty, path)
        if self.defined.contains(fp):
            int kind = self.defined.get(fp).unwrap()
            if kind == 1:
                # Existing AoT — push another element. The new element
                # opens a fresh scope: clear any sub-paths under fp so
                # k=v lines and sub-[t] headers in this element don't
                # collide with the previous element's keys.
                self.clear_sub_paths(fp)
                return true
            self.fail("array-of-tables conflicts with existing definition")
            return false
        self.defined.put(fp, 1)
        return true

    # Remove all entries whose key is strictly under `prefix` (so fresh
    # k=v assignments in a new [[t]] element don't collide). The internal
    # path encoding uses "\x01" as a part separator, so children of
    # `prefix` are those that begin with `prefix + "\x01"`.
    void clear_sub_paths(&self, String prefix):
        Vector[String] keys = self.defined.keys()
        Vector[String] to_remove = Vector[String]()
        String pdot = prefix + "\x01"
        int i = 0
        while i < keys.len():
            String k = keys.get(i).unwrap()
            if k.starts_with(pdot):
                to_remove.push(k.clone())
            i = i + 1
        int j = 0
        while j < to_remove.len():
            self.defined.remove(to_remove.get(j).unwrap())
            j = j + 1

    # Key = value assignment in a section. `base` is the section path
    # (from current_sec), `key_parts` is the (dotted) key.
    # Returns false on conflict; parser is failed.
    bool register_key_assignment(&self, Vector[String] key_parts, TomlValue val):
        TomlSection cur = self.sections.get(self.current_sec).unwrap()
        Vector[String] base = cur.sec_path
        # For dotted keys a.b.c = v inside section S, intermediate paths
        # S.a, S.a.b must be undefined or kind 5 (dotted-table). Final
        # path S.a.b.c must be undefined.
        int n = key_parts.len()
        int i = 0
        while i < n - 1:
            Vector[String] prefix = Vector[String]()
            int k = 0
            while k <= i:
                prefix.push(key_parts.get(k).unwrap().clone())
                k = k + 1
            String pp = self.make_path(base, prefix)
            if self.defined.contains(pp):
                int kind = self.defined.get(pp).unwrap()
                if kind != 5:
                    # 0 (explicit table) and 2 (implicit) cannot be extended
                    # via dotted keys from a later section — see
                    # invalid/table/append-with-dotted-keys-*. Same for 1
                    # (array), 3 (inline), 4 (scalar).
                    self.fail("cannot extend table via dotted key here")
                    return false
            else:
                self.defined.put(pp, 5)
            i = i + 1
        String fp = self.make_path(base, key_parts)
        if self.defined.contains(fp):
            self.fail("key already defined")
            return false
        # Walk the value: if it's an inline table, register sub-paths.
        self.register_value(fp, val)
        return true

    void register_value(&self, String path, TomlValue val):
        match val:
            case Tbl(inner):
                # Inline table — closed. Mark path as inline (3), then
                # recurse into entries.
                self.defined.put(path, 3)
                Vector[String] ks = inner.keys()
                int i = 0
                while i < ks.len():
                    String k = ks.get(i).unwrap()
                    String sub = path + "\x01" + k
                    self.register_value(sub, inner[k])
                    i = i + 1
            case Arr(items):
                # Arrays of inline tables: each element gets registered too,
                # but we don't index per-element. Treat as scalar for the
                # purposes of redefinition since you can't [t] into them
                # post-hoc.
                self.defined.put(path, 4)
            else:
                self.defined.put(path, 4)

    # ── Section-based key-value storage ─────────────────────

    void add_kv(&self, Vector[String] key_parts, TomlValue !toml_val):
        # For dotted keys like a.b.c = val, we store key "a" → wrap_dotted
        # For simple keys, store directly in current section
        TomlSection cur = self.sections.get(self.current_sec).unwrap()
        Dict[String, TomlValue] sd = cur.sec_data.clone()
        if key_parts.len() == 1:
            sd.put(key_parts.get(0).unwrap(), toml_val)
        else:
            # Build nested value for dotted key
            String top_key = key_parts.get(0).unwrap()
            TomlValue wrapped = wrap_dotted(key_parts, 1, !toml_val)
            if sd.contains(top_key):
                # Merge with existing table (e.g. name.first + name.last)
                Dict[String, TomlValue] wd = extract_tbl(wrapped)
                Dict[String, TomlValue] merged = merge_into(sd[top_key], wd)
                sd.put(top_key, Tbl(merged))
            else:
                sd.put(top_key, wrapped)
        TomlSection updated = TomlSection(cur.sec_path.clone(), sd, cur.sec_is_aot)
        self.sections.set(self.current_sec, !updated)

    void start_section(&self, Vector[String] !hdr_path, bool is_aot):
        Dict[String, TomlValue] new_data = Dict[String, TomlValue]()
        TomlSection new_sec = TomlSection(hdr_path, new_data, is_aot)
        self.sections.push(!new_sec)
        self.current_sec = self.sections.len() - 1

    # ── Top-level document parsing ──────────────────────────

    void parse_document(&self):
        self.skip_ws_and_newlines()
        while self.pos < self.source.byte_len() and not self.failed():
            String ch = self.source.char_at(self.pos)
            if ch == '#':
                self.skip_comment()
                self.skip_ws_and_newlines()
            elif ch == '[':
                self.parse_table_header()
                self.skip_ws_and_newlines()
            elif ch == '\n':
                self.pos = self.pos + 1
            elif ch == '\r':
                # Bare carriage return is forbidden at the document level —
                # CR is only legal as the first half of a \r\n pair.
                if self.pos + 1 < self.source.byte_len() and self.source.byte_at(self.pos + 1) == b'\n':
                    self.pos = self.pos + 2
                else:
                    self.fail("bare carriage return not allowed")
                    return
            else:
                Vector[String] kv_key = self.parse_key()
                if self.failed():
                    return
                self.skip_ws()
                if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != '=':
                    self.fail("expected '=' after key")
                    return
                self.pos = self.pos + 1
                self.skip_ws()
                TomlValue kv_val = self.parse_value()
                if self.failed():
                    return
                # Definition tracking — must check BEFORE add_kv so the
                # error wins over silent merge.
                if not self.register_key_assignment(kv_key, kv_val):
                    return
                self.add_kv(kv_key, !kv_val)
                # Per TOML §3 there must be a newline or comment+newline
                # after every value. "x = 1 y = 2" is invalid.
                self.expect_eol("expected newline after value")
                if self.failed():
                    return
                self.skip_ws_and_newlines()

    void parse_table_header(&self):
        self.pos = self.pos + 1
        bool is_array_table = false
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '[':
            is_array_table = true
            self.pos = self.pos + 1
        self.skip_ws()
        Vector[String] hdr_key = self.parse_key()
        if self.failed():
            return
        self.skip_ws()
        if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != ']':
            self.fail("expected ']' in table header")
            return
        self.pos = self.pos + 1
        if is_array_table:
            if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != ']':
                self.fail("expected ']]' in array-of-tables header")
                return
            self.pos = self.pos + 1
        # Definition tracking — must reject re-definition before we
        # start a new section, otherwise the assembled tree merges the
        # data silently.
        bool ok = false
        if is_array_table:
            ok = self.register_aot_header(hdr_key)
        else:
            ok = self.register_table_header(hdr_key)
        if not ok:
            return
        self.start_section(!hdr_key, is_array_table)
        # The line after the closing ] must be terminated by EOL / comment +
        # EOL. Anything else (e.g. "[t] x = 1") is invalid per TOML 1.0 §3.
        self.expect_eol("expected newline after table header")

# ── Helper free functions ───────────────────────────────────

private TomlValue wrap_dotted(Vector[String] key_parts, int from_idx, TomlValue !leaf_val):
    # Wraps a value in nested Tbl() wrappers for dotted key parts[from_idx..]
    if from_idx >= key_parts.len() - 1:
        # Last part — just wrap key → val
        Dict[String, TomlValue] leaf_tbl = Dict[String, TomlValue]()
        leaf_tbl.put(key_parts.get(key_parts.len() - 1).unwrap(), leaf_val)
        return Tbl(leaf_tbl)
    # Recurse: inner = wrap_dotted(parts, from_idx+1, val)
    TomlValue inner = wrap_dotted(key_parts, from_idx + 1, !leaf_val)
    Dict[String, TomlValue] outer = Dict[String, TomlValue]()
    outer.put(key_parts.get(from_idx).unwrap(), inner)
    return Tbl(outer)

# Control bytes forbidden in single-line basic / literal strings AND in
# comments: 0x00-0x08, 0x0B-0x1F, 0x7F. (Tab 0x09 is permitted; LF 0x0A
# ends the construct so its presence isn't a control-char issue per se.)
private bool is_basic_string_control_byte(byte b):
    if b == b'\t':
        return false
    if b <= 0x08 as byte:
        return true
    if b >= 0x0a as byte and b <= 0x1f as byte:
        return true
    if b == 0x7f as byte:
        return true
    return false

# Control bytes forbidden in multi-line basic / literal strings: same set
# as above, but LF (0x0A) is allowed (it's a literal newline in ML strings).
# CR (0x0D) is handled separately by the caller because it's allowed only
# as part of \r\n.
private bool is_ml_basic_control_byte(byte b):
    if b == b'\t' or b == b'\n':
        return false
    if b <= 0x08 as byte:
        return true
    if b >= 0x0b as byte and b <= 0x1f as byte:
        return true
    if b == 0x7f as byte:
        return true
    return false

private bool valid_date(int y, int m, int d):
    if y < 1 or y > 9999:
        return false
    if m < 1 or m > 12:
        return false
    if d < 1:
        return false
    # Days per month.
    int dim = 31
    if m == 4 or m == 6 or m == 9 or m == 11:
        dim = 30
    elif m == 2:
        bool is_leap = false
        if (y % 4) == 0 and ((y % 100) != 0 or (y % 400) == 0):
            is_leap = true
        if is_leap:
            dim = 29
        else:
            dim = 28
    return d <= dim

private bool valid_time(int h, int m, int s):
    if h < 0 or h > 23:
        return false
    if m < 0 or m > 59:
        return false
    # Allow leap second (60); TOML 1.0 permits seconds 00-60.
    if s < 0 or s > 60:
        return false
    return true

private String strip_underscores(String txt):
    String cleaned = ""
    int ti = 0
    while ti < txt.byte_len():
        String tc = txt.char_at(ti)
        if tc != '_':
            cleaned = cleaned + tc
        ti = ti + 1
    return cleaned

# ── Phase 2: Assemble tree from sections ────────────────────

private TomlValue assemble(Vector[TomlSection] secs):
    # Build nested Dict tree from flat sections.
    # Each section has a path (e.g. ["server", "tls"]) and a local Dict.
    # We assemble bottom-up: create the root Dict, then place each section's
    # entries at the correct path using recursive wrapping.
    Dict[String, TomlValue] root = Dict[String, TomlValue]()
    int si = 0
    while si < secs.len():
        auto sec = secs.get(si).unwrap()
        if sec.sec_path.len() == 0:
            # Root section — copy entries directly
            auto sd = sec.sec_data
            Vector[String] rk = sd.keys()
            int ri = 0
            while ri < rk.len():
                String rkey = rk.get(ri).unwrap()
                root.put(rkey, sd[rkey])
                ri = ri + 1
        else:
            if sec.sec_is_aot:
                # Array of tables — wrap entries in Tbl, collect into array
                place_aot(&root, sec.sec_path, !sec.sec_data.clone())
            else:
                # Regular table — wrap and place
                place_table(&root, sec.sec_path, 0, !sec.sec_data.clone())
        si = si + 1
    return Tbl(root)

private void place_table(Dict[String, TomlValue] &root, Vector[String] tpath, int idx, Dict[String, TomlValue] !sec_data):
    if idx == tpath.len() - 1:
        # Place at this level
        String final_key = tpath.get(idx).unwrap()
        if root.contains(final_key):
            # Merge into existing table — entries from sec_data into existing.
            # The borrow into `root` is confined to `merge_into`'s param so
            # `root` is no longer aliased by the time we re-`put`.
            Dict[String, TomlValue] merged = merge_into(root[final_key], sec_data)
            root.put(final_key, Tbl(merged))
        else:
            root.put(final_key, Tbl(sec_data))
        return
    # Need to navigate deeper — extract, recurse, put back. `extract_tbl`
    # returns an owned clone, so passing `root[nav_key]` inline keeps the
    # borrow short-lived; `root` is no longer aliased when we `put` below.
    String nav_key = tpath.get(idx).unwrap()
    if root.contains(nav_key):
        Dict[String, TomlValue] sub = extract_tbl(root[nav_key])
        place_table(&sub, tpath, idx + 1, !sec_data)
        root.put(nav_key, Tbl(sub))
    else:
        Dict[String, TomlValue] fresh = Dict[String, TomlValue]()
        place_table(&fresh, tpath, idx + 1, !sec_data)
        root.put(nav_key, Tbl(fresh))

private void place_aot(Dict[String, TomlValue] &root, Vector[String] tpath, Dict[String, TomlValue] !sec_data):
    if tpath.len() == 1:
        String aot_key = tpath.get(0).unwrap()
        if root.contains(aot_key):
            # Append to existing array. `extract_arr` returns an owned clone,
            # so the borrow of `root[aot_key]` dies at the call boundary —
            # `root` is no longer aliased when we re-`put` below.
            Vector[TomlValue] arr = extract_arr(root[aot_key])
            arr.push(Tbl(sec_data))
            root.put(aot_key, Arr(arr))
        else:
            Vector[TomlValue] new_arr = Vector[TomlValue]()
            new_arr.push(Tbl(sec_data))
            root.put(aot_key, Arr(new_arr))
        return
    # Navigate to parent, recurse. Same inline pattern: borrow into `root`
    # lives only across `extract_tbl`, leaving `root` un-aliased for `put`.
    String nav_key = tpath.get(0).unwrap()
    Vector[String] rest_path = subpath(tpath, 1)
    if root.contains(nav_key):
        Dict[String, TomlValue] sub = extract_tbl(root[nav_key])
        place_aot(&sub, rest_path, !sec_data)
        root.put(nav_key, Tbl(sub))
    else:
        Dict[String, TomlValue] fresh = Dict[String, TomlValue]()
        place_aot(&fresh, rest_path, !sec_data)
        root.put(nav_key, Tbl(fresh))

private Dict[String, TomlValue] extract_tbl(TomlValue tv):
    match tv:
        case Tbl(td):
            return td
        else:
            return Dict[String, TomlValue]()

private Vector[TomlValue] extract_arr(TomlValue tv):
    match tv:
        case Arr(ad):
            return ad
        else:
            return Vector[TomlValue]()

private Dict[String, TomlValue] merge_into(TomlValue existing, Dict[String, TomlValue] new_data):
    Dict[String, TomlValue] base = extract_tbl(existing)
    Vector[String] nk = new_data.keys()
    int ni = 0
    while ni < nk.len():
        String nkey = nk.get(ni).unwrap()
        base.put(nkey, new_data[nkey])
        ni = ni + 1
    return base

private Vector[String] subpath(Vector[String] full_path, int from_idx):
    Vector[String] sub = Vector[String]()
    int si = from_idx
    while si < full_path.len():
        sub.push(full_path.get(si).unwrap().clone())
        si = si + 1
    return sub

# ── UTF-8 source validation ─────────────────────────────────
# TOML 1.0 §2.1 mandates UTF-8 source encoding. Scan the input bytes
# once and reject any ill-formed sequence (invalid lead byte, truncated
# multi-byte form, bad continuation, overlong encoding, surrogate
# half U+D800..U+DFFF, codepoint > U+10FFFF). Returns the byte offset
# of the first error, or -1 if the whole input is valid UTF-8.
#
# Mirrors `gorget_utf8_decode` / `gorget_utf8_validate` in the C
# runtime so behavior is identical to `bytes_to_str` at the I/O
# boundary, but without taking a `std.bytes` dependency.
private int utf8_first_invalid(String input):
    int n = input.byte_len()
    int p = 0
    while p < n:
        int b0 = input.byte_at(p) as int
        if b0 < 0x80:
            p = p + 1
            continue
        int expected = 0
        int cp = 0
        if (b0 & 0xE0) == 0xC0:
            expected = 2
            cp = b0 & 0x1F
        elif (b0 & 0xF0) == 0xE0:
            expected = 3
            cp = b0 & 0x0F
        elif (b0 & 0xF8) == 0xF0:
            expected = 4
            cp = b0 & 0x07
        else:
            # Invalid lead byte (0x80-0xBF lone continuation,
            # or 0xF8-0xFF never-valid).
            return p
        if p + expected > n:
            # Truncated sequence at end of input.
            return p
        int i = 1
        while i < expected:
            int cb = input.byte_at(p + i) as int
            if (cb & 0xC0) != 0x80:
                return p
            cp = (cp << 6) | (cb & 0x3F)
            i = i + 1
        # Reject overlong encodings.
        if expected == 2 and cp < 0x80:
            return p
        if expected == 3 and cp < 0x800:
            return p
        if expected == 4 and cp < 0x10000:
            return p
        # Reject surrogate halves and out-of-range codepoints.
        if cp >= 0xD800 and cp <= 0xDFFF:
            return p
        if cp > 0x10FFFF:
            return p
        p = p + expected
    return -1

# ── Public API ──────────────────────────────────────────────

Result[TomlValue, ParseError] parse(String input):
    int bad = utf8_first_invalid(input)
    if bad >= 0:
        String msg = "invalid UTF-8 in TOML source"
        return Error(ParseError.InvalidSyntax(bad, !msg))
    Vector[TomlSection] secs = Vector[TomlSection]()
    Dict[String, TomlValue] root_data = Dict[String, TomlValue]()
    Vector[String] root_path = Vector[String]()
    TomlSection root_sec = TomlSection(!root_path, !root_data, false)
    secs.push(!root_sec)
    Dict[String, int] defined0 = Dict[String, int]()
    TomlParser tp = TomlParser(input, 0, "", !secs, 0, !defined0)
    tp.parse_document()
    if tp.failed():
        return Error(ParseError.InvalidSyntax(tp.pos, !tp.err))
    return Ok(assemble(tp.sections))

# ── Serialization ───────────────────────────────────────────

private String escape_string(String sv):
    String toml_out = "\""
    int si = 0
    while si < sv.byte_len():
        String sc = sv.char_at(si)
        if sc == '"':
            toml_out = toml_out + "\\\""
        elif sc == '\\':
            toml_out = toml_out + "\\\\"
        elif sc == '\n':
            toml_out = toml_out + "\\n"
        elif sc == '\t':
            toml_out = toml_out + "\\t"
        elif sc == '\r':
            toml_out = toml_out + "\\r"
        else:
            toml_out = toml_out + sc
        si = si + 1
    return toml_out + "\""

String stringify_value(TomlValue tv):
    match tv:
        case Str(sv):
            return escape_string(sv)
        case Int(iv):
            return int_to_str(iv)
        case Float(fv):
            return float_to_str(fv)
        case Bool(bv):
            if bv:
                return "true"
            return "false"
        case DateTime(dv):
            return dv
        case Arr(av):
            if av.len() == 0:
                return "[]"
            String arr_out = "["
            int ai = 0
            while ai < av.len():
                if ai > 0:
                    arr_out = arr_out + ", "
                arr_out = arr_out + stringify_value(av.get(ai).unwrap())
                ai = ai + 1
            return arr_out + "]"
        case Tbl(tv_tbl):
            if tv_tbl.len() == 0:
                return "\{\}"
            Vector[String] tbl_keys = tv_tbl.keys()
            String tbl_out = "\{"
            int ti = 0
            while ti < tbl_keys.len():
                if ti > 0:
                    tbl_out = tbl_out + ", "
                String tk = tbl_keys.get(ti).unwrap()
                tbl_out = tbl_out + tk + " = " + stringify_value(tv_tbl[tk])
                ti = ti + 1
            return tbl_out + "\}"

private String stringify_section(String sec_prefix, Dict[String, TomlValue] tbl):
    String sec_out = ""
    Vector[String] sec_keys = tbl.keys()
    # First pass: simple key-value pairs (not sub-tables or array-of-tables)
    int si = 0
    while si < sec_keys.len():
        String sk1 = sec_keys.get(si).unwrap()
        TomlValue sv1 = tbl[sk1]
        bool skip_val = is_subtable(sv1)
        if not skip_val:
            sec_out = sec_out + sk1 + " = " + stringify_value(sv1) + "\n"
        si = si + 1
    # Second pass: sub-tables and arrays-of-tables
    si = 0
    while si < sec_keys.len():
        String sk2 = sec_keys.get(si).unwrap()
        TomlValue sv2 = tbl[sk2]
        String child_prefix = sk2
        if sec_prefix != "":
            child_prefix = sec_prefix + "." + sk2
        match sv2:
            case Tbl(stbl2):
                sec_out = sec_out + "\n[" + child_prefix + "]\n"
                sec_out = sec_out + stringify_section(child_prefix, stbl2)
            case Arr(elems2):
                if is_aot_arr(elems2):
                    sec_out = sec_out + stringify_aot(child_prefix, elems2)
            else:
                pass
        si = si + 1
    return sec_out

private bool is_subtable(TomlValue tv):
    match tv:
        case Tbl(td):
            return true
        case Arr(ad):
            return is_aot_arr(ad)
        else:
            return false

private bool is_aot_arr(Vector[TomlValue] items):
    if items.len() == 0:
        return false
    TomlValue first = items.get(0).unwrap()
    match first:
        case Tbl(ft):
            return true
        else:
            return false

private String stringify_aot(String aot_prefix, Vector[TomlValue] aot_items):
    String aot_out = ""
    int aoti = 0
    while aoti < aot_items.len():
        TomlValue aot_elem = aot_items.get(aoti).unwrap()
        match aot_elem:
            case Tbl(aot_tbl):
                aot_out = aot_out + "\n[[" + aot_prefix + "]]\n"
                aot_out = aot_out + stringify_section(aot_prefix, aot_tbl)
            else:
                pass
        aoti = aoti + 1
    return aot_out

String stringify(TomlValue tv):
    match tv:
        case Tbl(root_tbl):
            return stringify_section("", root_tbl)
        else:
            return stringify_value(tv)

# ── Accessor methods ────────────────────────────────────────

equip TomlValue:
    bool has(self, String key):
        match self:
            case Tbl(tbl_data):
                return tbl_data.contains(key)
            else:
                return false

    bool has_index(self, int index):
        match self:
            case Arr(arr_data):
                return index >= 0 and index < arr_data.len()
            else:
                return false

    TomlValue get(self, String key):
        match self:
            case Tbl(tbl_data):
                if tbl_data.contains(key):
                    return tbl_data[key]
                return Str("")
            else:
                return Str("")

    TomlValue at(self, int index):
        match self:
            case Arr(arr_data):
                if index >= 0 and index < arr_data.len():
                    return arr_data.get(index).unwrap()
                return Str("")
            else:
                return Str("")

    String as_str(self):
        match self:
            case Str(sv):
                return sv
            case DateTime(dv):
                return dv
            else:
                return ""

    int as_int(self):
        match self:
            case Int(iv):
                return iv
            else:
                return 0

    float as_float(self):
        match self:
            case Float(fv):
                return fv
            case Int(iv):
                return iv as float
            else:
                return 0.0

    bool as_bool(self):
        match self:
            case Bool(bv):
                return bv
            else:
                return false

    bool is_table(self):
        match self:
            case Tbl(td):
                return true
            else:
                return false

    bool is_array(self):
        match self:
            case Arr(ad):
                return true
            else:
                return false

    bool is_string(self):
        match self:
            case Str(sv):
                return true
            else:
                return false

    bool is_int(self):
        match self:
            case Int(iv):
                return true
            else:
                return false

    bool is_float(self):
        match self:
            case Float(fv):
                return true
            else:
                return false

    bool is_bool(self):
        match self:
            case Bool(bv):
                return true
            else:
                return false

    bool is_datetime(self):
        match self:
            case DateTime(dv):
                return true
            else:
                return false

    int len(self):
        match self:
            case Arr(ad):
                return ad.len()
            case Tbl(td):
                return td.len()
            else:
                return 0

    Vector[String] keys(self):
        match self:
            case Tbl(td):
                return td.keys()
            else:
                return Vector[String]()
