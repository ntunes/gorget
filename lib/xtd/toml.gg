# std.toml — Pure Gorget TOML v1.0 parser
#
# Provides a recursive-descent TOML parser, serializer, and accessor methods.
# No C dependencies — uses only Gorget standard library.
#
# Architecture: two-phase parsing.
# Phase 1: Collect flat sections (path + key-value Dict per section).
# Phase 2: Assemble nested tree bottom-up via recursion.
# This avoids Gorget's value-type Dict aliasing (copying metadata on extract).

from std.collections import Vector, Dict
from std.conv import parse_int, parse_float, int_to_str, float_to_str, bool_to_str, codepoint_to_str

# ── TOML value type ─────────────────────────────────────────

enum TomlValue:
    Str(String)
    Int(int)
    Float(float)
    Bool(bool)
    DateTime(String)
    Arr(Vector[TomlValue])
    Tbl(Dict[String, TomlValue])

# ── Section collection ──────────────────────────────────────
# Each [table] or [[array-of-tables]] header starts a new section.
# Root-level key-value pairs belong to section with empty path.

struct TomlSection:
    Vector[String] sec_path
    Dict[String, TomlValue] sec_data
    bool sec_is_aot

# ── Internal parser ─────────────────────────────────────────

struct TomlParser:
    String source
    int pos
    String err
    Vector[TomlSection] sections
    int current_sec

equip TomlParser:
    bool failed(self): self.err != ""

    void fail(&self, String msg):
        if self.err == "":
            self.err = move msg

    String peek(self):
        if self.pos < self.source.byte_len():
            return self.source.char_at(self.pos)
        return '\0'

    bool at_end(self): self.pos >= self.source.byte_len()

    void skip_ws(&self):
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == ' ' or ch == '\t':
                self.pos = self.pos + 1
            else:
                return

    void skip_ws_and_newlines(&self):
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r':
                self.pos = self.pos + 1
            elif ch == '#':
                self.skip_comment()
            else:
                return

    void skip_comment(&self):
        while self.pos < self.source.byte_len() and self.source.char_at(self.pos) != '\n':
            self.pos = self.pos + 1

    void skip_to_newline(&self):
        self.skip_ws()
        if self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == '#':
                self.skip_comment()
            if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
                self.pos = self.pos + 1
            elif self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\r':
                self.pos = self.pos + 1
                if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
                    self.pos = self.pos + 1

    # ── Key parsing ─────────────────────────────────────────

    String parse_bare_key(&self):
        int start = self.pos
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch >= 'a' and ch <= 'z':
                self.pos = self.pos + 1
            elif ch >= 'A' and ch <= 'Z':
                self.pos = self.pos + 1
            elif ch >= '0' and ch <= '9':
                self.pos = self.pos + 1
            elif ch == '-' or ch == '_':
                self.pos = self.pos + 1
            else:
                break
        if self.pos == start:
            self.fail("expected key")
            return ""
        return self.source.byte_slice(start, self.pos)

    String parse_key_part(&self):
        if self.pos >= self.source.byte_len():
            self.fail("expected key")
            return ""
        String ch = self.source.char_at(self.pos)
        if ch == '"':
            return self.parse_basic_string()
        elif ch == '\'':
            return self.parse_literal_string()
        return self.parse_bare_key()

    Vector[String] parse_key(&self):
        Vector[String] parts = Vector[String]()
        String first_part = self.parse_key_part()
        if self.failed():
            return parts
        parts.push(first_part)
        while self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '.':
            self.pos = self.pos + 1
            String next_part = self.parse_key_part()
            if self.failed():
                return parts
            parts.push(next_part)
        return parts

    # ── String parsing ──────────────────────────────────────

    String parse_basic_string(&self):
        # Skip opening "
        self.pos = self.pos + 1
        # Check for multi-line """
        if self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '"' and self.source.char_at(self.pos + 1) == '"':
            self.pos = self.pos + 2
            return self.parse_ml_basic_string()
        String toml_result = ""
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == '"':
                self.pos = self.pos + 1
                return toml_result
            elif ch == '\\':
                toml_result = toml_result + self.parse_escape()
            else:
                toml_result = toml_result + ch
                self.pos = self.pos + 1
        self.fail("unterminated basic string")
        return ""

    String parse_ml_basic_string(&self):
        # Skip optional first newline after """
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
            self.pos = self.pos + 1
        elif self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\r' and self.source.char_at(self.pos + 1) == '\n':
            self.pos = self.pos + 2
        String toml_result = ""
        while self.pos < self.source.byte_len():
            if self.pos + 2 < self.source.byte_len() and self.source.char_at(self.pos) == '"' and self.source.char_at(self.pos + 1) == '"' and self.source.char_at(self.pos + 2) == '"':
                self.pos = self.pos + 3
                return toml_result
            String ch = self.source.char_at(self.pos)
            if ch == '\\':
                self.pos = self.pos + 1
                if self.pos < self.source.byte_len():
                    String next_ch = self.source.char_at(self.pos)
                    if next_ch == '\n' or next_ch == '\r':
                        self.skip_ws_and_newlines()
                    else:
                        self.pos = self.pos - 1
                        toml_result = toml_result + self.parse_escape()
                else:
                    self.fail("unterminated escape in multi-line string")
                    return ""
            else:
                toml_result = toml_result + ch
                self.pos = self.pos + 1
        self.fail("unterminated multi-line basic string")
        return ""

    String parse_escape(&self):
        self.pos = self.pos + 1
        if self.pos >= self.source.byte_len():
            self.fail("unterminated escape sequence")
            return ""
        String esc = self.source.char_at(self.pos)
        self.pos = self.pos + 1
        if esc == '"':
            return "\""
        elif esc == '\\':
            return "\\"
        elif esc == 'n':
            return "\n"
        elif esc == 't':
            return "\t"
        elif esc == 'r':
            return "\r"
        elif esc == 'b':
            return "\b"
        elif esc == 'f':
            return "\f"
        elif esc == 'u' or esc == 'U':
            int toml_hex_len = 4
            if esc == 'U':
                toml_hex_len = 8
            int toml_uni_cp = 0
            int toml_uni_cnt = 0
            while toml_uni_cnt < toml_hex_len and self.pos < self.source.byte_len():
                byte toml_uhc = self.source.byte_at(self.pos)
                int toml_uhv = -1
                if toml_uhc >= b'0' and toml_uhc <= b'9':
                    toml_uhv = toml_uhc as int - b'0'
                elif toml_uhc >= b'a' and toml_uhc <= b'f':
                    toml_uhv = toml_uhc as int - b'a' + 10
                elif toml_uhc >= b'A' and toml_uhc <= b'F':
                    toml_uhv = toml_uhc as int - b'A' + 10
                if toml_uhv < 0:
                    self.fail("invalid hex digit in unicode escape")
                    return ""
                toml_uni_cp = toml_uni_cp * 16 + toml_uhv
                self.pos = self.pos + 1
                toml_uni_cnt = toml_uni_cnt + 1
            if toml_uni_cnt < toml_hex_len:
                self.fail("truncated unicode escape")
                return ""
            return codepoint_to_str(toml_uni_cp)
        self.fail("invalid escape sequence")
        return ""

    String parse_literal_string(&self):
        self.pos = self.pos + 1
        if self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\'' and self.source.char_at(self.pos + 1) == '\'':
            self.pos = self.pos + 2
            return self.parse_ml_literal_string()
        String toml_result = ""
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch == '\'':
                self.pos = self.pos + 1
                return toml_result
            toml_result = toml_result + ch
            self.pos = self.pos + 1
        self.fail("unterminated literal string")
        return ""

    String parse_ml_literal_string(&self):
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '\n':
            self.pos = self.pos + 1
        elif self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '\r' and self.source.char_at(self.pos + 1) == '\n':
            self.pos = self.pos + 2
        String toml_result = ""
        while self.pos < self.source.byte_len():
            if self.pos + 2 < self.source.byte_len() and self.source.char_at(self.pos) == '\'' and self.source.char_at(self.pos + 1) == '\'' and self.source.char_at(self.pos + 2) == '\'':
                self.pos = self.pos + 3
                return toml_result
            toml_result = toml_result + self.source.char_at(self.pos)
            self.pos = self.pos + 1
        self.fail("unterminated multi-line literal string")
        return ""

    # ── Value parsing ───────────────────────────────────────

    TomlValue parse_value(&self):
        if self.failed():
            return Str("")
        self.skip_ws()
        if self.at_end():
            self.fail("unexpected end of input")
            return Str("")
        String ch = self.peek()
        if ch == '"':
            String sv = self.parse_basic_string()
            return Str(sv)
        elif ch == '\'':
            String sv = self.parse_literal_string()
            return Str(sv)
        elif ch == 't' or ch == 'f':
            return self.parse_bool()
        elif ch == '[':
            return self.parse_array()
        elif ch == '{':
            return self.parse_inline_table()
        elif ch == 'i' or ch == 'n':
            return self.parse_special_float()
        return self.parse_number_or_date()

    TomlValue parse_bool(&self):
        if self.pos + 4 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 4) == "true":
            self.pos = self.pos + 4
            return Bool(true)
        if self.pos + 5 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 5) == "false":
            self.pos = self.pos + 5
            return Bool(false)
        self.fail("expected boolean")
        return Str("")

    TomlValue parse_special_float(&self):
        if self.pos + 3 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 3) == "inf":
            self.pos = self.pos + 3
            return Float(1.0 / 0.0)
        if self.pos + 3 <= self.source.byte_len() and self.source.byte_slice(self.pos, self.pos + 3) == "nan":
            self.pos = self.pos + 3
            return Float(0.0 / 0.0)
        self.fail("unexpected keyword")
        return Str("")

    TomlValue parse_array(&self):
        self.pos = self.pos + 1
        Vector[TomlValue] elems = Vector[TomlValue]()
        self.skip_ws_and_newlines()
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == ']':
            self.pos = self.pos + 1
            return Arr(elems)
        while self.pos < self.source.byte_len():
            self.skip_ws_and_newlines()
            TomlValue elem = self.parse_value()
            if self.failed():
                return Str("")
            elems.push(elem)
            self.skip_ws_and_newlines()
            if self.pos >= self.source.byte_len():
                self.fail("unterminated array")
                return Str("")
            if self.source.char_at(self.pos) == ',':
                self.pos = self.pos + 1
                self.skip_ws_and_newlines()
                if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == ']':
                    self.pos = self.pos + 1
                    return Arr(elems)
            elif self.source.char_at(self.pos) == ']':
                self.pos = self.pos + 1
                return Arr(elems)
            else:
                self.fail("expected ',' or ']' in array")
                return Str("")
        self.fail("unterminated array")
        return Str("")

    TomlValue parse_inline_table(&self):
        self.pos = self.pos + 1
        Dict[String, TomlValue] tbl = Dict[String, TomlValue]()
        self.skip_ws()
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '}':
            self.pos = self.pos + 1
            return Tbl(tbl)
        while self.pos < self.source.byte_len():
            self.skip_ws()
            Vector[String] key_parts = self.parse_key()
            if self.failed():
                return Str("")
            self.skip_ws()
            if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != '=':
                self.fail("expected '=' after key in inline table")
                return Str("")
            self.pos = self.pos + 1
            self.skip_ws()
            TomlValue tbl_val = self.parse_value()
            if self.failed():
                return Str("")
            # For inline tables, dotted keys create nested tables inline
            if key_parts.len() == 1:
                tbl.put(key_parts.get(0).unwrap(), tbl_val)
            else:
                # Build nested structure for dotted key in inline table
                TomlValue nested = wrap_dotted(key_parts, 0, tbl_val)
                tbl.put(key_parts.get(0).unwrap(), nested)
            self.skip_ws()
            if self.pos >= self.source.byte_len():
                self.fail("unterminated inline table")
                return Str("")
            if self.source.char_at(self.pos) == ',':
                self.pos = self.pos + 1
            elif self.source.char_at(self.pos) == '}':
                self.pos = self.pos + 1
                return Tbl(tbl)
            else:
                self.fail("expected ',' or '}' in inline table")
                return Str("")
        self.fail("unterminated inline table")
        return Str("")

    # ── Number / date-time parsing ──────────────────────────

    TomlValue parse_number_or_date(&self):
        int start = self.pos
        bool is_negative = false
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '-':
            is_negative = true
            self.pos = self.pos + 1
        elif self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '+':
            self.pos = self.pos + 1
        # Handle signed special floats: -inf, +inf, -nan, +nan
        if self.pos + 3 <= self.source.byte_len():
            String num_special = self.source.byte_slice(self.pos, self.pos + 3)
            if num_special == "inf":
                self.pos = self.pos + 3
                if is_negative:
                    return Float(-1.0 / 0.0)
                return Float(1.0 / 0.0)
            if num_special == "nan":
                self.pos = self.pos + 3
                return Float(0.0 / 0.0)
        # Check for hex/oct/bin prefixes
        if self.pos + 1 < self.source.byte_len() and self.source.char_at(self.pos) == '0':
            String num_prefix = self.source.char_at(self.pos + 1)
            if num_prefix == 'x' or num_prefix == 'o' or num_prefix == 'b':
                return self.parse_prefixed_int(start, is_negative, num_prefix)
        # Scan digits
        bool has_dot = false
        bool has_exp = false
        bool could_be_date = false
        while self.pos < self.source.byte_len():
            String ch = self.source.char_at(self.pos)
            if ch >= '0' and ch <= '9':
                self.pos = self.pos + 1
            elif ch == '_':
                self.pos = self.pos + 1
            elif ch == '.':
                has_dot = true
                self.pos = self.pos + 1
            elif ch == 'e' or ch == 'E':
                has_exp = true
                self.pos = self.pos + 1
                if self.pos < self.source.byte_len():
                    String sign_ch = self.source.char_at(self.pos)
                    if sign_ch == '+' or sign_ch == '-':
                        self.pos = self.pos + 1
            elif ch == '-' or ch == ':' or ch == 'T' or ch == 'Z':
                could_be_date = true
                self.pos = self.pos + 1
            elif ch == '+':
                could_be_date = true
                self.pos = self.pos + 1
            else:
                break
        String num_text = self.source.byte_slice(start, self.pos)
        if could_be_date:
            return DateTime(num_text)
        String cleaned = strip_underscores(num_text)
        if has_dot or has_exp:
            float fv = parse_float(cleaned).unwrap_or(0.0)
            return Float(fv)
        int iv = parse_int(cleaned).unwrap_or(0)
        return Int(iv)

    TomlValue parse_prefixed_int(&self, int start, bool is_negative, String num_prefix):
        self.pos = self.pos + 2
        int val = 0
        int base = 16
        if num_prefix == 'o':
            base = 8
        elif num_prefix == 'b':
            base = 2
        bool has_digits = false
        while self.pos < self.source.byte_len():
            byte ch = self.source.byte_at(self.pos)
            if ch == b'_':
                self.pos = self.pos + 1
            elif ch >= b'0' and ch <= b'9':
                int digit = ch as int - b'0'
                if digit >= base:
                    break
                val = val * base + digit
                self.pos = self.pos + 1
                has_digits = true
            elif ch >= b'a' and ch <= b'f' and base == 16:
                val = val * 16 + (ch as int - b'a' + 10)
                self.pos = self.pos + 1
                has_digits = true
            elif ch >= b'A' and ch <= b'F' and base == 16:
                val = val * 16 + (ch as int - b'A' + 10)
                self.pos = self.pos + 1
                has_digits = true
            else:
                break
        if not has_digits:
            self.fail("expected digits after prefix")
            return Int(0)
        if is_negative:
            val = 0 - val
        return Int(val)

    # ── Section-based key-value storage ─────────────────────

    void add_kv(&self, Vector[String] key_parts, TomlValue toml_val):
        # For dotted keys like a.b.c = val, we store key "a" → wrap_dotted
        # For simple keys, store directly in current section
        TomlSection cur = self.sections.get(self.current_sec).unwrap()
        Dict[String, TomlValue] sd = cur.sec_data
        if key_parts.len() == 1:
            sd.put(key_parts.get(0).unwrap(), toml_val)
        else:
            # Build nested value for dotted key
            String top_key = key_parts.get(0).unwrap()
            TomlValue wrapped = wrap_dotted(key_parts, 1, toml_val)
            if sd.contains(top_key):
                # Merge with existing table (e.g. name.first + name.last)
                Dict[String, TomlValue] wd = extract_tbl(wrapped)
                Dict[String, TomlValue] merged = merge_into(sd[top_key], wd)
                sd.put(top_key, Tbl(merged))
            else:
                sd.put(top_key, wrapped)
        TomlSection updated = TomlSection(cur.sec_path, sd, cur.sec_is_aot)
        self.sections.set(self.current_sec, updated)

    void start_section(&self, Vector[String] hdr_path, bool is_aot):
        Dict[String, TomlValue] new_data = Dict[String, TomlValue]()
        TomlSection new_sec = TomlSection(hdr_path, new_data, is_aot)
        self.sections.push(new_sec)
        self.current_sec = self.sections.len() - 1

    # ── Top-level document parsing ──────────────────────────

    void parse_document(&self):
        self.skip_ws_and_newlines()
        while self.pos < self.source.byte_len() and not self.failed():
            String ch = self.source.char_at(self.pos)
            if ch == '#':
                self.skip_comment()
                self.skip_ws_and_newlines()
            elif ch == '[':
                self.parse_table_header()
                self.skip_ws_and_newlines()
            elif ch == '\n' or ch == '\r':
                self.pos = self.pos + 1
            else:
                Vector[String] kv_key = self.parse_key()
                if self.failed():
                    return
                self.skip_ws()
                if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != '=':
                    self.fail("expected '=' after key")
                    return
                self.pos = self.pos + 1
                self.skip_ws()
                TomlValue kv_val = self.parse_value()
                if self.failed():
                    return
                self.add_kv(kv_key, kv_val)
                self.skip_to_newline()
                self.skip_ws_and_newlines()

    void parse_table_header(&self):
        self.pos = self.pos + 1
        bool is_array_table = false
        if self.pos < self.source.byte_len() and self.source.char_at(self.pos) == '[':
            is_array_table = true
            self.pos = self.pos + 1
        self.skip_ws()
        Vector[String] hdr_key = self.parse_key()
        if self.failed():
            return
        self.skip_ws()
        if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != ']':
            self.fail("expected ']' in table header")
            return
        self.pos = self.pos + 1
        if is_array_table:
            if self.pos >= self.source.byte_len() or self.source.char_at(self.pos) != ']':
                self.fail("expected ']]' in array-of-tables header")
                return
            self.pos = self.pos + 1
        self.start_section(hdr_key, is_array_table)
        self.skip_to_newline()

# ── Helper free functions ───────────────────────────────────

private TomlValue wrap_dotted(Vector[String] key_parts, int from_idx, TomlValue leaf_val):
    # Wraps a value in nested Tbl() wrappers for dotted key parts[from_idx..]
    if from_idx >= key_parts.len() - 1:
        # Last part — just wrap key → val
        Dict[String, TomlValue] leaf_tbl = Dict[String, TomlValue]()
        leaf_tbl.put(key_parts.get(key_parts.len() - 1).unwrap(), leaf_val)
        return Tbl(leaf_tbl)
    # Recurse: inner = wrap_dotted(parts, from_idx+1, val)
    TomlValue inner = wrap_dotted(key_parts, from_idx + 1, leaf_val)
    Dict[String, TomlValue] outer = Dict[String, TomlValue]()
    outer.put(key_parts.get(from_idx).unwrap(), inner)
    return Tbl(outer)

private String strip_underscores(String txt):
    String cleaned = ""
    int ti = 0
    while ti < txt.byte_len():
        String tc = txt.char_at(ti)
        if tc != '_':
            cleaned = cleaned + tc
        ti = ti + 1
    return cleaned

# ── Phase 2: Assemble tree from sections ────────────────────

private TomlValue assemble(Vector[TomlSection] secs):
    # Build nested Dict tree from flat sections.
    # Each section has a path (e.g. ["server", "tls"]) and a local Dict.
    # We assemble bottom-up: create the root Dict, then place each section's
    # entries at the correct path using recursive wrapping.
    Dict[String, TomlValue] root = Dict[String, TomlValue]()
    int si = 0
    while si < secs.len():
        TomlSection sec = secs.get(si).unwrap()
        if sec.sec_path.len() == 0:
            # Root section — copy entries directly
            Dict[String, TomlValue] sd = sec.sec_data
            Vector[String] rk = sd.keys()
            int ri = 0
            while ri < rk.len():
                String rkey = rk.get(ri).unwrap()
                root.put(rkey, sd[rkey])
                ri = ri + 1
        else:
            if sec.sec_is_aot:
                # Array of tables — wrap entries in Tbl, collect into array
                place_aot(&root, sec.sec_path, sec.sec_data)
            else:
                # Regular table — wrap and place
                place_table(&root, sec.sec_path, 0, sec.sec_data)
        si = si + 1
    return Tbl(root)

private void place_table(Dict[String, TomlValue] &root, Vector[String] tpath, int idx, Dict[String, TomlValue] sec_data):
    if idx == tpath.len() - 1:
        # Place at this level
        String final_key = tpath.get(idx).unwrap()
        if root.contains(final_key):
            # Merge into existing table — entries from sec_data into existing
            # Since we can't modify nested Dict in-place, we rebuild
            TomlValue existing = root[final_key]
            Dict[String, TomlValue] merged = merge_into(existing, sec_data)
            root.put(final_key, Tbl(merged))
        else:
            root.put(final_key, Tbl(sec_data))
        return
    # Need to navigate deeper — extract, recurse, put back
    String nav_key = tpath.get(idx).unwrap()
    if root.contains(nav_key):
        TomlValue existing = root[nav_key]
        Dict[String, TomlValue] sub = extract_tbl(existing)
        place_table(&sub, tpath, idx + 1, sec_data)
        root.put(nav_key, Tbl(sub))
    else:
        Dict[String, TomlValue] fresh = Dict[String, TomlValue]()
        place_table(&fresh, tpath, idx + 1, sec_data)
        root.put(nav_key, Tbl(fresh))

private void place_aot(Dict[String, TomlValue] &root, Vector[String] tpath, Dict[String, TomlValue] sec_data):
    if tpath.len() == 1:
        String aot_key = tpath.get(0).unwrap()
        if root.contains(aot_key):
            # Append to existing array
            TomlValue existing = root[aot_key]
            Vector[TomlValue] arr = extract_arr(existing)
            arr.push(Tbl(sec_data))
            root.put(aot_key, Arr(arr))
        else:
            Vector[TomlValue] new_arr = Vector[TomlValue]()
            new_arr.push(Tbl(sec_data))
            root.put(aot_key, Arr(new_arr))
        return
    # Navigate to parent, recurse
    String nav_key = tpath.get(0).unwrap()
    Vector[String] rest_path = subpath(tpath, 1)
    if root.contains(nav_key):
        TomlValue existing = root[nav_key]
        Dict[String, TomlValue] sub = extract_tbl(existing)
        place_aot(&sub, rest_path, sec_data)
        root.put(nav_key, Tbl(sub))
    else:
        Dict[String, TomlValue] fresh = Dict[String, TomlValue]()
        place_aot(&fresh, rest_path, sec_data)
        root.put(nav_key, Tbl(fresh))

private Dict[String, TomlValue] extract_tbl(TomlValue tv):
    match tv:
        case Tbl(td):
            return td
        else:
            return Dict[String, TomlValue]()

private Vector[TomlValue] extract_arr(TomlValue tv):
    match tv:
        case Arr(ad):
            return ad
        else:
            return Vector[TomlValue]()

private Dict[String, TomlValue] merge_into(TomlValue existing, Dict[String, TomlValue] new_data):
    Dict[String, TomlValue] base = extract_tbl(existing)
    Vector[String] nk = new_data.keys()
    int ni = 0
    while ni < nk.len():
        String nkey = nk.get(ni).unwrap()
        base.put(nkey, new_data[nkey])
        ni = ni + 1
    return base

private Vector[String] subpath(Vector[String] full_path, int from_idx):
    Vector[String] sub = Vector[String]()
    int si = from_idx
    while si < full_path.len():
        sub.push(full_path.get(si).unwrap())
        si = si + 1
    return sub

# ── Public API ──────────────────────────────────────────────

Result[TomlValue, String] parse(String input):
    Vector[TomlSection] secs = Vector[TomlSection]()
    Dict[String, TomlValue] root_data = Dict[String, TomlValue]()
    Vector[String] root_path = Vector[String]()
    TomlSection root_sec = TomlSection(root_path, root_data, false)
    secs.push(root_sec)
    TomlParser tp = TomlParser(input, 0, "", secs, 0)
    tp.parse_document()
    if tp.failed():
        return Error(tp.err)
    return Ok(assemble(tp.sections))

# ── Serialization ───────────────────────────────────────────

private String escape_string(String sv):
    String toml_out = "\""
    int si = 0
    while si < sv.byte_len():
        String sc = sv.char_at(si)
        if sc == '"':
            toml_out = toml_out + "\\\""
        elif sc == '\\':
            toml_out = toml_out + "\\\\"
        elif sc == '\n':
            toml_out = toml_out + "\\n"
        elif sc == '\t':
            toml_out = toml_out + "\\t"
        elif sc == '\r':
            toml_out = toml_out + "\\r"
        else:
            toml_out = toml_out + sc
        si = si + 1
    return toml_out + "\""

String stringify_value(TomlValue tv):
    match tv:
        case Str(sv):
            return escape_string(sv)
        case Int(iv):
            return int_to_str(iv)
        case Float(fv):
            return float_to_str(fv)
        case Bool(bv):
            if bv:
                return "true"
            return "false"
        case DateTime(dv):
            return dv
        case Arr(av):
            if av.len() == 0:
                return "[]"
            String arr_out = "["
            int ai = 0
            while ai < av.len():
                if ai > 0:
                    arr_out = arr_out + ", "
                arr_out = arr_out + stringify_value(av.get(ai).unwrap())
                ai = ai + 1
            return arr_out + "]"
        case Tbl(tv_tbl):
            if tv_tbl.len() == 0:
                return "\{\}"
            Vector[String] tbl_keys = tv_tbl.keys()
            String tbl_out = "\{"
            int ti = 0
            while ti < tbl_keys.len():
                if ti > 0:
                    tbl_out = tbl_out + ", "
                String tk = tbl_keys.get(ti).unwrap()
                tbl_out = tbl_out + tk + " = " + stringify_value(tv_tbl[tk])
                ti = ti + 1
            return tbl_out + "\}"

private String stringify_section(String sec_prefix, Dict[String, TomlValue] tbl):
    String sec_out = ""
    Vector[String] sec_keys = tbl.keys()
    # First pass: simple key-value pairs (not sub-tables or array-of-tables)
    int si = 0
    while si < sec_keys.len():
        String sk1 = sec_keys.get(si).unwrap()
        TomlValue sv1 = tbl[sk1]
        bool skip_val = is_subtable(sv1)
        if not skip_val:
            sec_out = sec_out + sk1 + " = " + stringify_value(sv1) + "\n"
        si = si + 1
    # Second pass: sub-tables and arrays-of-tables
    si = 0
    while si < sec_keys.len():
        String sk2 = sec_keys.get(si).unwrap()
        TomlValue sv2 = tbl[sk2]
        String child_prefix = sk2
        if sec_prefix != "":
            child_prefix = sec_prefix + "." + sk2
        match sv2:
            case Tbl(stbl2):
                sec_out = sec_out + "\n[" + child_prefix + "]\n"
                sec_out = sec_out + stringify_section(child_prefix, stbl2)
            case Arr(elems2):
                if is_aot_arr(elems2):
                    sec_out = sec_out + stringify_aot(child_prefix, elems2)
            else:
                pass
        si = si + 1
    return sec_out

private bool is_subtable(TomlValue tv):
    match tv:
        case Tbl(td):
            return true
        case Arr(ad):
            return is_aot_arr(ad)
        else:
            return false

private bool is_aot_arr(Vector[TomlValue] items):
    if items.len() == 0:
        return false
    TomlValue first = items.get(0).unwrap()
    match first:
        case Tbl(ft):
            return true
        else:
            return false

private String stringify_aot(String aot_prefix, Vector[TomlValue] aot_items):
    String aot_out = ""
    int aoti = 0
    while aoti < aot_items.len():
        TomlValue aot_elem = aot_items.get(aoti).unwrap()
        match aot_elem:
            case Tbl(aot_tbl):
                aot_out = aot_out + "\n[[" + aot_prefix + "]]\n"
                aot_out = aot_out + stringify_section(aot_prefix, aot_tbl)
            else:
                pass
        aoti = aoti + 1
    return aot_out

String stringify(TomlValue tv):
    match tv:
        case Tbl(root_tbl):
            return stringify_section("", root_tbl)
        else:
            return stringify_value(tv)

# ── Accessor methods ────────────────────────────────────────

equip TomlValue:
    bool has(self, String key):
        match self:
            case Tbl(tbl_data):
                return tbl_data.contains(key)
            else:
                return false

    bool has_index(self, int index):
        match self:
            case Arr(arr_data):
                return index >= 0 and index < arr_data.len()
            else:
                return false

    TomlValue get(self, String key):
        match self:
            case Tbl(tbl_data):
                if tbl_data.contains(key):
                    return tbl_data[key]
                return Str("")
            else:
                return Str("")

    TomlValue at(self, int index):
        match self:
            case Arr(arr_data):
                if index >= 0 and index < arr_data.len():
                    return arr_data.get(index).unwrap()
                return Str("")
            else:
                return Str("")

    String as_str(self):
        match self:
            case Str(sv):
                return sv
            case DateTime(dv):
                return dv
            else:
                return ""

    int as_int(self):
        match self:
            case Int(iv):
                return iv
            else:
                return 0

    float as_float(self):
        match self:
            case Float(fv):
                return fv
            case Int(iv):
                return iv as float
            else:
                return 0.0

    bool as_bool(self):
        match self:
            case Bool(bv):
                return bv
            else:
                return false

    bool is_table(self):
        match self:
            case Tbl(td):
                return true
            else:
                return false

    bool is_array(self):
        match self:
            case Arr(ad):
                return true
            else:
                return false

    bool is_string(self):
        match self:
            case Str(sv):
                return true
            else:
                return false

    bool is_int(self):
        match self:
            case Int(iv):
                return true
            else:
                return false

    bool is_float(self):
        match self:
            case Float(fv):
                return true
            else:
                return false

    bool is_bool(self):
        match self:
            case Bool(bv):
                return true
            else:
                return false

    bool is_datetime(self):
        match self:
            case DateTime(dv):
                return true
            else:
                return false

    int len(self):
        match self:
            case Arr(ad):
                return ad.len()
            case Tbl(td):
                return td.len()
            else:
                return 0

    Vector[String] keys(self):
        match self:
            case Tbl(td):
                return td.keys()
            else:
                return Vector[String]()
