# std.iter — minimal lazy iterator support (Phase 2 placeholder)
#
# Provides `VectorIter[T]` and `Vector.iter()` so a Vector can be iterated
# lazily through the `Iterator[T]` protocol. This is the v0 cut — no
# adapter fusion, no chaining. Later phases add `.map()`, `.filter()`,
# `.take()`, etc. as concrete state-machine structs that return their
# own iterator types.

from std.collections import Vector

struct VectorIter[T]:
    Vector[T] source
    int idx

equip [T] VectorIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.idx >= self.source.len():
            return None
        int cur = self.idx
        self.idx = self.idx + 1
        return self.source.get(cur)

equip [T] Vector[T]:
    VectorIter[T] iter(self):
        return VectorIter[T](self, 0)
