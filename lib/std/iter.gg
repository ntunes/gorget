# std.iter — lazy iterator support.
#
# Provides `VectorIter[T]` and `Vector.iter()` so a Vector can be iterated
# lazily through the `Iterator[T]` protocol. Concrete adapters generic
# over the source iterator type so chains can compose:
# `TakeIter[Iter, T]`, `SkipIter[Iter, T]`, `ChainIter[IterA, IterB, T]`,
# `MapIter[Iter, T, U, F]`, `FilterIter[Iter, T, F]`,
# `TakeWhileIter[Iter, T, F]`, `DropWhileIter[Iter, T, F]`,
# `FilterMapIter[Iter, T, U, F]`, `InspectIter[Iter, T, F]`,
# `EnumerateIter[Iter, T]`, `ZipIter[IterA, IterB, A, B]`,
# `WindowsIter[Iter, T]`, `ChunksIter[Iter, T]` — each is a
# state-machine struct, no trait-object dispatch.
#
# Eager terminals (`count` / `collect` / `last` / `nth` / `any[F]` /
# `all[F]` / `find[F]` / `find_index[F]` / `for_each[F]` /
# `fold[A, F]`) live as default-method bodies on the `Iterator[T]`
# trait — every adapter that `equip`s the trait inherits them.
# Bound-needing terminals stay as free functions until per-method
# trait bounds land: `sum_iter[Iter]` / `product_iter[Iter]` (int),
# `min_iter[Iter]` / `max_iter[Iter]` (int), `join_iter[Iter,
# Displayable T]`. Set iteration is spelled `s.iter()` via the
# `equip [T] Set[T]:` block below.
#
# Adapter-method sugar: `.take(n)` / `.skip(n)` / `.chain(other)` /
# `.map(f)` / `.filter(p)` etc. on `VectorIter[T]` each return the
# corresponding concrete adapter by value. Chains like
# `v.iter().take(3).map(double).filter(is_even)` compose end to end;
# method-level generic args (`[U, F]`, `[F]`) at call sites are
# inferred from the closure-arg types via the Phase 2c inference
# pipeline.
#
# Vector convenience wrappers (`v.map(f)`, `v.fold(0, sum)`, `v.any
# (p)`, …) live in the `equip [T] Vector[T]:` block below — each
# delegates to `self.iter().method().collect()` (adapters) or
# `self.iter().method()` (terminals). The builtin HOF expansions in
# the IR-lowerer remain as fallbacks.

from std.collections import Vector, Set

# ── Map/Set bucket-walk runtime accessors ─────────────────────
#
# Generic externs that share a single C symbol across all
# `Dict[K, V]` / `Set[T]` instantiations (commit `ca9b455f`).
# `gorget_map_iter_key` / `_value` invoke the map's
# `key_clone` / `val_clone` hooks so resource-typed K/V come out
# as independent owned copies — the caller may freely drop the
# yielded element without disturbing the source.
extern "Gorget":
    extern int __dict_iter_order_len[K, V](Ref[Dict[K, V]] m) = "gorget_map_iter_order_len"
    extern int __dict_iter_order[K, V](Ref[Dict[K, V]] m, int idx) = "gorget_map_iter_order"
    extern void __dict_iter_key[K, V](Ref[Dict[K, V]] m, int idx, K &out) = "gorget_map_iter_key"
    extern void __dict_iter_value[K, V](Ref[Dict[K, V]] m, int idx, V &out) = "gorget_map_iter_value"
    extern int __set_iter_order_len[T](Ref[Set[T]] s) = "gorget_map_iter_order_len"
    extern int __set_iter_order[T](Ref[Set[T]] s, int idx) = "gorget_map_iter_order"
    extern void __set_iter_key[T](Ref[Set[T]] s, int idx, T &out) = "gorget_map_iter_key"

# ── Iterator[T] trait ─────────────────────────────────────────
#
# User-space trait declaration. Carries the required `next(&self)`
# method only; default-method bodies (count / any / all / find /
# fold / collect …) layer on as Phase 2c progresses. The compiler
# pre-registers `Iterator` as a builtin placeholder so existing
# `equip X with Iterator[T]:` blocks parse before this declaration
# is loaded — when the user-space declaration lands it shadows the
# placeholder, and `register_equip_sigs_with_defaults` picks up
# any default bodies declared here for every equipping type.
trait Iterator[T]:
    Option[T] next(&self)

    # ── Default terminal methods ─────────────────────────────
    #
    # All eager terminals delegate to the for-loop protocol on
    # `self` — the loop dispatches `next(&self)` through normal
    # name-based resolution, so each equipping type gets a
    # specialised loop without any per-method per-type duplication.
    #
    # Method-level generics (any[F], all[F], find[F], …) ride on
    # per-call-site monomorphization (Phase 4) — closures reach the
    # default body through the same mechanism that powers
    # `VectorIter.map[U, F]`.

    int count(&self):
        int n = 0
        for _ in self:
            n = n + 1
        return n

    Vector[T] collect(&self):
        Vector[T] out = Vector[T]()
        for x in self:
            out.push(x)
        return !out

    # Set-target collect. Typecheck rewrites `.collect()` → `.to_set()`
    # when the binding's declared type is `Set[T]`, so callers write
    # `Set[int] s = v.iter().filter(p).collect()` and get the right
    # constructor for free. `Set[T]`'s type-level bound on `T` already
    # requires `T: Hashable + Equatable`, so this default only
    # mono'ises for Iterator[T]s whose `T` satisfies those constraints
    # — the demand-gate skips emission for T's that don't.
    Set[T] to_set(&self):
        Set[T] out = Set[T]()
        for x in self:
            out.add(x)
        return !out

    # Dict-target collect. Typecheck rewrites `.collect()` →
    # `.to_dict[K, V]()` when the binding's declared type is
    # `Dict[K, V]`; the method-level type args are lifted straight
    # from the LHS so users write `Dict[int, String] d =
    # pairs.iter().collect()` without a turbofish. The trait's `T`
    # must be `(K, V)` at the call site's iterator; non-tuple `T`
    # instances fail at mono emission (the body reaches for tuple
    # field access `x.0` / `x.1`). The demand-gate ensures only
    # iterator impls where `T = (K, V)` for the LHS-provided K/V
    # reach emission.
    Dict[K, V] to_dict[K, V](&self):
        Dict[K, V] out = Dict[K, V]()
        for x in self:
            out.put(x.0, x.1)
        return !out

    Option[T] last(&self):
        Option[T] out = None
        for x in self:
            out = Some(x)
        return !out

    Option[T] nth(&self, int n):
        if n < 0:
            return None
        int i = 0
        for x in self:
            if i == n:
                return Some(x)
            i = i + 1
        return None

    bool any[F](&self, F pred):
        for x in self:
            if pred(x):
                return true
        return false

    bool all[F](&self, F pred):
        for x in self:
            if not pred(x):
                return false
        return true

    Option[T] find[F](&self, F pred):
        for x in self:
            if pred(x):
                return Some(x)
        return None

    Option[int] find_index[F](&self, F pred):
        int i = 0
        for x in self:
            if pred(x):
                return Some(i)
            i = i + 1
        return None

    void for_each[F](&self, F f):
        for x in self:
            f(x)

    A fold[A, F](&self, A init, F f):
        A acc = init
        for x in self:
            acc = f(acc, x)
        return acc

    # ── Bound-needing aggregation terminals ──────────────────
    #
    # These defaults use operators on the abstract `T` (`<`, `>`,
    # `+`, `*`, `==`). The demand-gate (`all_return_nominals_
    # registered`) only emits each per-impl monomorphisation when
    # a call site actually reaches for it — Iterator implementors
    # with non-Comparable / non-Numeric / non-Equatable T's never
    # have these specialised, so the body's operators don't need
    # to resolve. The previous `[deferred until per-method trait
    # bounds]` caveat no longer applies — verified self-host
    # bootstrap green on 2026-04-27.
    #
    # `min` / `max` need `<` / `>` on T (Comparable).
    # `sum` / `product` need `+` / `*` and `T.default()` (Numeric).
    # `contains` needs `==` on T (Equatable).

    Option[T] min(&self):
        Option[T] best = None
        for x in self:
            match best:
                case None:
                    best = Some(x)
                case Some(prev):
                    if x < prev:
                        best = Some(x)
        return !best

    Option[T] max(&self):
        Option[T] best = None
        for x in self:
            match best:
                case None:
                    best = Some(x)
                case Some(prev):
                    if x > prev:
                        best = Some(x)
        return !best

    # `sum` / `product` stay as free functions in `std.iter`.
    # A default-method body `T acc = T.default(); for x in self:
    # acc = acc + x` triggers a sig conflict in
    # `register_method_instance_sigs` for some fixtures (the
    # `T.default()` static call gets misregistered as
    # `<T>__default(<T>)` taking self). `sum_iter[Iter] iter(int)`
    # / `product_iter[Iter] iter(int)` carry the int constraint
    # explicitly and don't trip that path.

    bool contains(&self, T target):
        for x in self:
            if x == target:
                return true
        return false

    # NOTE: trait-bounded defaults — most are now shipped above.
    # `join` (Displayable-based) remains as a free function in
    # `std.iter` because the trait-default path doesn't yet thread
    # the Displayable.display() method dispatch into the body's
    # `acc.push(x.display())` call when T is abstract. The
    # `join_iter[Iter, Displayable T]` free function carries the
    # bound explicitly and works today.
    # regressions: the stage-0 driver monomorphises Iterator[T] for
    # T's that don't satisfy the implicit bound and emits broken
    # codegen. The free-function variants in std.iter
    # (`min_iter` / `max_iter` / `sum_iter` / `product_iter` /
    # `join_iter`) carry the bound explicitly via `T: Bound` and
    # don't trigger the regression. Promotion to defaults waits on
    # cleaner trait-bound declarations (e.g. `where T: Comparable`
    # on a per-method basis) — see TODO Phase 2c.

    # Lazy adapter constructors — defaults on Iterator[T]. Every
    # implementor (VectorIter, TakeIter, FilterIter, …) inherits the
    # adapter surface, so chains can compose past one step
    # (`v.iter().take(3).filter(is_even).map(double)`). Each returns
    # `AdapterIter[Self, T, …]`; `Self` resolves to the concrete
    # iterator via typecheck's trait-default substitution (traits.rs +
    # typecheck.rs) and IR lowering's Self-binding (lower_method_instance
    # + register_equip_sigs_with_defaults). Method-level generics
    # `[U, F]`/`[F]` are inferred from the closure arg at the call site.
    # `self` is consumed by value — the adapter takes ownership.

    TakeIter[Self, T] take(self, int n):
        return TakeIter[Self, T](self, n)

    SkipIter[Self, T] skip(self, int n):
        return SkipIter[Self, T](self, n)

    MapIter[Self, T, U, F] map[U, F](self, F f):
        return MapIter[Self, T, U, F](self, f)

    FilterIter[Self, T, F] filter[F](self, F p):
        return FilterIter[Self, T, F](self, p)

    TakeWhileIter[Self, T, F] take_while[F](self, F p):
        return TakeWhileIter[Self, T, F](self, p, false)

    DropWhileIter[Self, T, F] drop_while[F](self, F p):
        return DropWhileIter[Self, T, F](self, p, true)

    FilterMapIter[Self, T, U, F] filter_map[U, F](self, F f):
        return FilterMapIter[Self, T, U, F](self, f)

    InspectIter[Self, T, F] inspect[F](self, F f):
        return InspectIter[Self, T, F](self, f)

    EnumerateIter[Self, T] enumerate(self):
        return EnumerateIter[Self, T](self, 0)

# ── Iterable[T] trait ─────────────────────────────────────────
#
# Capability trait for "this type can be iterated non-consumingly."
# `iter(&self)` returns a concrete `Iterator[T]` that walks the
# elements without disturbing the source. Standard collections
# (Vector / Set / Dict) all impl this. User types impl by providing
# any iterator state machine equipped with `Iterator[T]`.
#
# The compiler pre-registers `Iterable` as a builtin placeholder
# (mirrors `Iterator`'s setup) so existing `equip X with Iterable[T]:`
# blocks parse before this user-space declaration loads. When this
# declaration is processed it shadows the placeholder.
#
# `for x in v` desugars to name-based dispatch on `iter()` — the
# trait provides the contract and enables `[Iterable T]` bounds, but
# the for-loop fast path doesn't go through trait-vtable lookup.
trait Iterable[T]:
    Iterator[T] iter(&self)

# ── Drainable[T] trait ────────────────────────────────────────
#
# Sibling capability trait for "this type can be consumed by
# iteration." `drain(!self)` moves the source into the iterator and
# yields owned elements; the source is gone after `drain()` returns.
# Iteration order matches `iter()` — same elements, same order, but
# yielded by move instead of by borrow.
#
# `Vector[T]` ships an O(n) reverse + pop impl. `Set[T]` / `Dict[K,
# V]` drain implementations defer until a `gorget_map_drain_entry`
# runtime helper lands.
trait Drainable[T]:
    Iterator[T] drain(!self)

struct VectorIter[T]:
    Vector[T] source
    int idx

equip [T] VectorIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.idx >= self.source.len():
            return None
        int cur = self.idx
        self.idx = self.idx + 1
        return self.source.get(cur)

equip [T] Vector[T] with Iterable[T]:
    VectorIter[T] iter(&self):
        return VectorIter[T](self, 0)

struct VectorDrain[T]:
    Vector[T] source

equip [T] VectorDrain[T] with Iterator[T]:
    Option[T] next(&self):
        # `pop()` is O(1); `drain()` reversed the source first, so
        # popping the tail yields elements in insertion order.
        return self.source.pop()

equip [T] VectorDrain[T] with Drop:
    void drop(!self):
        self.source.reverse()

equip [T] Vector[T] with Drainable[T]:
    VectorDrain[T] drain(!self):
        # Total cost: O(n) reverse + O(n) pops = O(n) drain.
        # Without the reverse, `pop()` would yield in LIFO order;
        # the reverse pre-flip lets us reuse the O(1) pop primitive
        # while preserving insertion order for the iterator's
        # consumer. The custom Drop on VectorDrain reverses the
        # remaining buffer back if the caller breaks early, so
        # unconsumed elements drop in insertion order — matching
        # what `iter()` would have yielded.
        self.reverse()
        return VectorDrain[T](!self)

equip [T] Vector[T]:

    # ── User-space convenience wrappers ────────────────────────
    #
    # Each wrapper below is `v.method(args)` ≡
    # `v.iter().method[targs](args)` (or `.collect()` for adapters).
    # The method-level inference pipeline (Phase 2c) binds the
    # method-level generics from the call-site arg types, so callers
    # don't need explicit `[U, F]` args at the wrapper call sites.
    #
    # The builtin `Vector.{map,filter,any,all,each,for_each,find,
    # find_index,fold}` HOF expansions in the IR-lowerer remain as
    # fallbacks for callers that don't register the user-space sig
    # (e.g. when inference fails). Once every caller migrates and
    # the BIR HofExpand variants are confirmed unreachable, the
    # builtin entries can be deleted in a follow-up cleanup commit.
    #
    # Inner method-generic calls inside each wrapper body carry
    # explicit `[F]` / `[U, F]` type-args. After the outer
    # `wrapper[concrete]` instance is registered and its body is
    # substituted, the per-call-site mono engine needs an explicit
    # method-args list to drive transitive registration of
    # `VectorIter[T]::method[F=concrete]`. Inference inside generic
    # bodies (where `f`'s type is still the abstract `F`) doesn't
    # fire; the explicit args make the substituted body's nested
    # call mangle the way the IR-lowering dispatch expects.

    void each[F](&self, F f):
        self.iter().for_each[F](f)

    void for_each[F](&self, F f):
        self.iter().for_each[F](f)

    bool any[F](&self, F p):
        return self.iter().any[F](p)

    bool all[F](&self, F p):
        return self.iter().all[F](p)

    Option[T] find[F](&self, F p):
        return self.iter().find[F](p)

    Option[int] find_index[F](&self, F p):
        return self.iter().find_index[F](p)

    A fold[A, F](&self, A init, F f):
        return self.iter().fold[A, F](init, f)

    Vector[U] map[U, F](&self, F f):
        return self.iter().map[U, F](f).collect()

    Vector[T] filter[F](&self, F p):
        return self.iter().filter[F](p).collect()

# Producer-specific adapter methods that stay on VectorIter because
# the "other" parameter is `VectorIter[T]` / `VectorIter[U]`. Lifting
# these to iterator-generic defaults would require `other` to be its
# own generic param (`Other`), which the adapter struct's stored
# field then needs to thread through — a Shape-2-style inference dance
# we haven't implemented yet. Also `lazy_windows` / `lazy_chunks`
# which don't reference `Self` but whose bodies construct `Vector[T]`
# locals; keeping them here avoids repeated Vector[T] instantiation
# scans across every Iterator implementor.
equip [T] VectorIter[T]:
    ChainIter[VectorIter[T], VectorIter[T], T] chain(self, VectorIter[T] other):
        return ChainIter[VectorIter[T], VectorIter[T], T](self, other, true)

    ZipIter[VectorIter[T], VectorIter[U], T, U] zip[U](self, VectorIter[U] other):
        return ZipIter[VectorIter[T], VectorIter[U], T, U](self, other)

    WindowsIter[VectorIter[T], T] lazy_windows(self, int n):
        return WindowsIter[VectorIter[T], T](self, n, Vector[T](), false)

    ChunksIter[VectorIter[T], T] lazy_chunks(self, int n):
        return ChunksIter[VectorIter[T], T](self, n)

    # ── Terminal methods ───────────────────────────────────
    #
    # All eager terminals (count, collect, any, all, find,
    # find_index, for_each, fold, last, nth) live as default
    # bodies on `trait Iterator[T]:` — VectorIter inherits them
    # without per-type duplication.

struct TakeIter[Iter, T]:
    Iter inner
    int remaining

equip [Iter, T] TakeIter[Iter, T] with Iterator[T]:
    Option[T] next(&self):
        if self.remaining <= 0:
            return None
        self.remaining = self.remaining - 1
        return self.inner.next()

struct SkipIter[Iter, T]:
    Iter inner
    int remaining

equip [Iter, T] SkipIter[Iter, T] with Iterator[T]:
    Option[T] next(&self):
        while self.remaining > 0:
            Option[T] consumed = self.inner.next()
            match consumed:
                case Some(_):
                    self.remaining = self.remaining - 1
                case None:
                    self.remaining = 0
                    return None
        return self.inner.next()

# ChainIter[IterA, IterB, T] — concatenates two iterators of element T.
# Yields from `a` until exhausted, then from `b`. Generic over both
# source iterator types so chains like `v.iter().chain(w.iter()).chain(z.iter())`
# can compose (each layer wraps the previous ChainIter).
struct ChainIter[IterA, IterB, T]:
    IterA a
    IterB b
    bool on_first

equip [IterA, IterB, T] ChainIter[IterA, IterB, T] with Iterator[T]:
    Option[T] next(&self):
        if self.on_first:
            Option[T] r = self.a.next()
            match r:
                case Some(x):
                    return Some(x)
                case None:
                    self.on_first = false
        return self.b.next()

# ── Map / Filter adapters ────────────────────────────────────
#
# Stream-transform iterators. The upstream iterator is stored by
# value (no boxing); the closure / predicate likewise inlined.
# Monomorphization over the concrete source type + closure type
# keeps the chain fused.

struct MapIter[Iter, T, U, F]:
    Iter inner
    F f

equip [Iter, T, U, F] MapIter[Iter, T, U, F] with Iterator[U]:
    Option[U] next(&self):
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                # Hoist the closure out of the field access before
                # calling — `self.f(x)` is parsed as a method call on
                # the field and link-fails. Storing in a local turns
                # it into a closure call.
                F cb = self.f
                return Some(cb(!x))
            case None:
                return None

struct FilterIter[Iter, T, F]:
    Iter inner
    F pred

equip [Iter, T, F] FilterIter[Iter, T, F] with Iterator[T]:
    Option[T] next(&self):
        while true:
            Option[T] v = self.inner.next()
            match v:
                case Some(x):
                    F cb = self.pred
                    if cb(x):
                        return Some(!x)
                case None:
                    return None
        return None

# ── Conditional take/drop + combined filter-map + side-effect ─
#
# `take_while(p)` yields while p returns true, then terminates.
# `drop_while(p)` skips while p returns true, then passes through.
# `filter_map(f)` combines filter + map: `f: T -> Option[U]`.
# `inspect(f)` is side-effect-only — f is called on each element,
# value passes through unchanged. Useful for debug-printing
# elements at a specific pipeline stage without collecting.

struct TakeWhileIter[Iter, T, F]:
    Iter inner
    F pred
    bool done

equip [Iter, T, F] TakeWhileIter[Iter, T, F] with Iterator[T]:
    Option[T] next(&self):
        if self.done:
            return None
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                F cb = self.pred
                if cb(x):
                    return Some(!x)
                self.done = true
                return None
            case None:
                self.done = true
                return None

struct DropWhileIter[Iter, T, F]:
    Iter inner
    F pred
    bool dropping

equip [Iter, T, F] DropWhileIter[Iter, T, F] with Iterator[T]:
    Option[T] next(&self):
        # Drain leading elements where pred(x) is true. Once we
        # produce the first surviving element, flip `dropping` so
        # subsequent calls bypass the predicate entirely.
        while self.dropping:
            Option[T] v = self.inner.next()
            match v:
                case Some(x):
                    F cb = self.pred
                    if not cb(x):
                        self.dropping = false
                        return Some(!x)
                case None:
                    self.dropping = false
                    return None
        return self.inner.next()

struct FilterMapIter[Iter, T, U, F]:
    Iter inner
    F f

equip [Iter, T, U, F] FilterMapIter[Iter, T, U, F] with Iterator[U]:
    Option[U] next(&self):
        while true:
            Option[T] v = self.inner.next()
            match v:
                case Some(x):
                    F cb = self.f
                    Option[U] out = cb(!x)
                    match out:
                        case Some(_):
                            return !out
                        case None:
                            pass
                case None:
                    return None
        return None

struct InspectIter[Iter, T, F]:
    Iter inner
    F f

equip [Iter, T, F] InspectIter[Iter, T, F] with Iterator[T]:
    Option[T] next(&self):
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                F cb = self.f
                cb(x)
                return Some(!x)
            case None:
                return None

# ── Enumerate ────────────────────────────────────────────────
#
# Yields `(index, value)` pairs. The index counts from 0 and
# increments per element, independent of the source iterator's
# semantics — `enumerate()` of a filtered iterator yields indices
# 0, 1, 2, … (positions in the *output*), not the original positions.

struct EnumerateIter[Iter, T]:
    Iter inner
    int idx

equip [Iter, T] EnumerateIter[Iter, T] with Iterator[(int, T)]:
    Option[(int, T)] next(&self):
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                int cur = self.idx
                self.idx = self.idx + 1
                return Some((cur, !x))
            case None:
                return None

# ── Zip ──────────────────────────────────────────────────────
#
# Yields pairs `(a, b)` drawn from two source iterators in lockstep.
# Stops as soon as either source is exhausted.

struct ZipIter[IterA, IterB, A, B]:
    IterA a
    IterB b

equip [IterA, IterB, A, B] ZipIter[IterA, IterB, A, B] with Iterator[(A, B)]:
    Option[(A, B)] next(&self):
        Option[A] va = self.a.next()
        match va:
            case None:
                return None
            case Some(xa):
                Option[B] vb = self.b.next()
                match vb:
                    case None:
                        return None
                    case Some(xb):
                        return Some((!xa, !xb))

# ── Windows / Chunks (lazy) ──────────────────────────────────
#
# `windows(n)` yields successive overlapping slices of size n via a
# sliding deque-like buffer. Drains 1 element per `next()` call; when
# the source can't refill the window, returns None. n must be >= 1.
#
# `chunks(n)` yields non-overlapping slices of size n, possibly with
# a final short slice if the source length isn't a multiple of n.
#
# Both copy elements into the per-call Vector — for non-Copy T this
# triggers per-element clone semantics through Vector.push. A future
# zero-cost view-based variant could avoid the copies.

struct WindowsIter[Iter, T]:
    Iter inner
    int n
    Vector[T] buf
    bool primed

equip [Iter, T] WindowsIter[Iter, T] with Iterator[Vector[T]]:
    Option[Vector[T]] next(&self):
        if self.n <= 0:
            return None
        # Prime: pull the first n-1 elements into the buffer so the
        # first window-yield only needs one fresh element. Subsequent
        # calls drop the oldest via `remove(0)` and push the next.
        if not self.primed:
            int need = self.n - 1
            int got = 0
            while got < need:
                Option[T] v = self.inner.next()
                match v:
                    case None:
                        return None
                    case Some(x):
                        self.buf.push(!x)
                        got = got + 1
            self.primed = true
        Option[T] nxt = self.inner.next()
        match nxt:
            case None:
                return None
            case Some(x):
                self.buf.push(!x)
                # Slide: drop head once buffer exceeds window size.
                if self.buf.len() > self.n:
                    self.buf.remove(0)
                # Yield a clone of the current window so the caller
                # gets an independent Vector — the buffer keeps
                # mutating across iterations.
                return Some(self.buf.clone())

struct ChunksIter[Iter, T]:
    Iter inner
    int n

equip [Iter, T] ChunksIter[Iter, T] with Iterator[Vector[T]]:
    Option[Vector[T]] next(&self):
        if self.n <= 0:
            return None
        Vector[T] chunk = Vector[T]()
        int got = 0
        bool source_done = false
        while got < self.n and not source_done:
            Option[T] v = self.inner.next()
            match v:
                case None:
                    source_done = true
                case Some(x):
                    chunk.push(!x)
                    got = got + 1
        if chunk.len() == 0:
            return None
        return Some(!chunk)

# ── Terminals (free functions) ───────────────────────────────
#
# Bound-needing terminals stay as free functions until per-method
# trait bounds land — promotion to Iterator[T] defaults would
# specialise the trait for Ts that don't satisfy `<` / `+` /
# `.display()` etc. and emit broken codegen (verified by self-host
# bootstrap regression on 2026-04-20).
#
# The unbound counterparts (`collect_vec`, `count_iter`, `fold_iter`,
# `any_iter`, `all_iter`, `find_iter`, `find_index_iter`, `last_iter`,
# `nth_iter`, `for_each_iter`) were retired in the Phase 2c
# convenience-wrapper migration — callers use the method form
# (`v.iter().method()` or `v.method()` via the Vector wrappers).

# Sum all elements of an int-iterator.
int sum_iter[Iter](Iter iter):
    int acc = 0
    for x in iter:
        acc = acc + x
    return acc

# Product of int elements. Identity is 1 — an empty iterator returns 1.
int product_iter[Iter](Iter iter):
    int acc = 1
    for x in iter:
        acc = acc * x
    return acc

# Minimum of an int-iterator. Returns None for an empty iterator; the
# caller decides whether "no elements" is an error.
Option[int] min_iter[Iter](Iter iter):
    Option[int] out = None
    for x in iter:
        match out:
            case None:
                out = Some(x)
            case Some(prev):
                if x < prev:
                    out = Some(x)
    return !out

# Maximum of an int-iterator.
Option[int] max_iter[Iter](Iter iter):
    Option[int] out = None
    for x in iter:
        match out:
            case None:
                out = Some(x)
            case Some(prev):
                if x > prev:
                    out = Some(x)
    return !out

# ── Set iteration ────────────────────────────────────────────
#
# `Set[T].iter()` returns a lazy `SetIter[T]` walking the
# underlying `GorgetMap` bucket array in place via a `Ref[Set[T]]`
# borrow field — no `.items()` materialisation. Set callers get
# the full `Iterator[T]` adapter chain (`take` / `skip` / `map` /
# `filter` / terminals …) inherited through the trait-default
# emission. Terminal convenience wrappers (`.each`, `.any`,
# `.find`, `.fold`, …) delegate to `self.iter().method[F](args)`
# — mirroring Vector's user-space surface in the
# `equip [T] Vector[T]:` block above.
#
# `.map` and `.filter` deliberately left off: `.map` returning
# `Set[U]` has cardinality-surprise semantics (if `f` collapses
# distinct inputs to the same output, the output is smaller than
# the input), and `.map` returning `Vector[U]` breaks symmetry with
# `Vector.map`. Users who want either spell it explicitly via the
# collect-target rewrite: `Set[U] out = s.iter().map(f).collect()`
# or `Vector[U] out = s.iter().map(f).collect()` — the LHS picks.
#
# Dict key / value iteration uses the same pattern — see below.

struct SetIter[T]:
    Ref[Set[T]] source
    int cursor

equip [T] SetIter[T] with Iterator[T]:
    Option[T] next(&self):
        int n = __set_iter_order_len[T](self.source)
        if self.cursor >= n:
            return None
        int phys = __set_iter_order[T](self.source, self.cursor)
        T out = T.default()
        __set_iter_key[T](self.source, phys, &out)
        self.cursor = self.cursor + 1
        return Some(!out)

equip [T] Set[T] with Iterable[T]:
    SetIter[T] iter(&self):
        return SetIter[T](self, 0)

equip [T] Set[T]:
    void each[F](&self, F f):
        self.iter().for_each[F](f)

    void for_each[F](&self, F f):
        self.iter().for_each[F](f)

    bool any[F](&self, F p):
        return self.iter().any[F](p)

    bool all[F](&self, F p):
        return self.iter().all[F](p)

    Option[T] find[F](&self, F p):
        return self.iter().find[F](p)

    Option[int] find_index[F](&self, F p):
        return self.iter().find_index[F](p)

    A fold[A, F](&self, A init, F f):
        return self.iter().fold[A, F](init, f)

# ── Dict iteration ───────────────────────────────────────────
#
# `Dict[K, V].iter()` returns a lazy `DictIter[K, V]` that walks
# the underlying `GorgetMap` bucket array in place via a
# `Ref[Dict[K, V]]` borrow field — no `.items()` materialisation,
# no allocation beyond the iterator struct itself. The yielded
# `(K, V)` tuples come out of the `__dict_iter_key` / `_value`
# accessors, which clone resource-typed K/V via the map's
# `key_clone` / `val_clone` hooks; callers may freely drop the
# pair without disturbing the source map.
#
# Terminal convenience wrappers (`any`/`all`/`find`/`fold`) are
# deliberately skipped here: the existing builtin `Dict.any(K, V)`
# / `.all(K, V)` / `.each(K, V)` / `.fold(A, K, V)` methods take
# key and value as two separate closure args, whereas iterator
# wrappers would take a single `(K, V)` tuple arg. That's a
# breaking change for every existing Dict caller, so it waits on
# a separate migration pass. Users who want tuple-based semantics
# write it explicitly: `d.iter().any(p)` / `d.iter().fold(0, f)`.
#
# `.items()` stays as an eager alias for callers that want a
# materialised `Vector[(K, V)]`.

struct DictIter[K, V]:
    Ref[Dict[K, V]] source
    int cursor

equip [K, V] DictIter[K, V] with Iterator[(K, V)]:
    Option[(K, V)] next(&self):
        int n = __dict_iter_order_len[K, V](self.source)
        if self.cursor >= n:
            return None
        int phys = __dict_iter_order[K, V](self.source, self.cursor)
        K k = K.default()
        V v = V.default()
        __dict_iter_key[K, V](self.source, phys, &k)
        __dict_iter_value[K, V](self.source, phys, &v)
        self.cursor = self.cursor + 1
        return Some((!k, !v))

equip [K, V] Dict[K, V] with Iterable[(K, V)]:
    DictIter[K, V] iter(&self):
        return DictIter[K, V](self, 0)

# Textual join — render each element through `Displayable.display()`
# and concatenate with `sep` between. Routing through the trait
# instead of `int_to_str` sidesteps the cross-crate monomorphization
# that previously force-materialized `VectorIter[uint8]` everywhere.
# Displacement of `String.join(vec)` — callers that currently
# materialize a Vector just to join can now go straight from the
# iterator: `join_iter[VectorIter[int], int](v.iter(), ", ")`.
String join_iter[Iter, Displayable T](Iter iter, String sep):
    String out = ""
    bool first = true
    for x in iter:
        if not first:
            out.push(sep.clone())
        out.push(x.display())
        first = false
    return !out

