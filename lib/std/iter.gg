# std.iter — lazy iterator support.
#
# Provides `VectorIter[T]` and `Vector.iter()` so a Vector can be iterated
# lazily through the `Iterator[T]` protocol. Concrete adapters:
# `TakeIter[T]`, `SkipIter[T]`, `ChainIter[T]`, `MapIter[T, U, F]`,
# `FilterIter[T, F]` — each is a state-machine struct, no trait-object
# dispatch. Terminals: `collect_vec`, `count_iter`, `sum_iter`,
# `any_iter`, `all_iter`, `fold_iter`.
#
# Adapter-method sugar: `.take(n)` / `.skip(n)` / `.chain(other)` and
# `.map[U, F](f)` / `.filter[F](p)` on `VectorIter[T]` construct the
# corresponding concrete adapter. Each returns a value — no boxing,
# no trait-object dispatch. Chains like `v.iter().take(3)` or
# `VectorIter[int] prefix = v.iter().take(3)` work end to end; the
# generic-on-generic closure cases (`map` / `filter`) need explicit
# type args at the call site until Gorget's inference propagates
# closure return types into method generics.

from std.collections import Vector, Set

struct VectorIter[T]:
    Vector[T] source
    int idx

equip [T] VectorIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.idx >= self.source.len():
            return None
        int cur = self.idx
        self.idx = self.idx + 1
        return self.source.get(cur)

equip [T] Vector[T]:
    VectorIter[T] iter(self):
        return VectorIter[T](self, 0)

# Method-style adapter sugar on VectorIter. Each method constructs the
# corresponding concrete adapter struct and returns it by value.
# Callers chain with `v.iter().take(n)` / `v.iter().skip(2).chain(w.iter())` etc.
#
# Note: `.map(f)` / `.filter(p)` — adapter methods with their own
# method-level generic params (`map[U, F]` / `filter[F]`) — are not
# wired here. They trip a monomorphization issue where the partially-
# substituted return type (`MapIter[int, U, F]` with T→int done but
# U / F still abstract) gets accidentally registered as a concrete
# type. Users construct these via `MapIter[T, U, F](v.iter(), f)` /
# `FilterIter[T, F](v.iter(), pred)` until that's resolved.
equip [T] VectorIter[T]:
    TakeIter[T] take(self, int n):
        return TakeIter[T](self, n)

    SkipIter[T] skip(self, int n):
        return SkipIter[T](self, n)

    ChainIter[T] chain(self, VectorIter[T] other):
        return ChainIter[T](self, other, true)

struct TakeIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] TakeIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.remaining <= 0:
            return None
        self.remaining = self.remaining - 1
        return self.inner.next()

struct SkipIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] SkipIter[T] with Iterator[T]:
    Option[T] next(&self):
        while self.remaining > 0:
            Option[T] consumed = self.inner.next()
            match consumed:
                case Some(_):
                    self.remaining = self.remaining - 1
                case None:
                    self.remaining = 0
                    return None
        return self.inner.next()

# ChainIter[T] — concatenates two VectorIter[T]. Yields from `a` until
# exhausted, then from `b`.
struct ChainIter[T]:
    VectorIter[T] a
    VectorIter[T] b
    bool on_first

equip [T] ChainIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.on_first:
            Option[T] r = self.a.next()
            match r:
                case Some(x):
                    return Some(x)
                case None:
                    self.on_first = false
        return self.b.next()

# ── Map / Filter adapters ────────────────────────────────────
#
# Stream-transform iterators. The upstream iterator is stored by
# value (no boxing); the closure / predicate likewise inlined.
# Monomorphization over the concrete source type + closure type
# keeps the chain fused.

struct MapIter[T, U, F]:
    VectorIter[T] inner
    F f

equip [T, U, F] MapIter[T, U, F] with Iterator[U]:
    Option[U] next(&self):
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                # Hoist the closure out of the field access before
                # calling — `self.f(x)` is parsed as a method call on
                # the field and link-fails. Storing in a local turns
                # it into a closure call.
                F cb = self.f
                return Some(cb(!x))
            case None:
                return None

struct FilterIter[T, F]:
    VectorIter[T] inner
    F pred

equip [T, F] FilterIter[T, F] with Iterator[T]:
    Option[T] next(&self):
        while true:
            Option[T] v = self.inner.next()
            match v:
                case Some(x):
                    F cb = self.pred
                    if cb(x):
                        return Some(!x)
                case None:
                    return None
        return None

# ── Terminals ────────────────────────────────────────────────
#
# All terminals take the concrete iterator type as a type param
# to avoid trait-object dispatch.

# Materialize any iterator of type Iter into a Vector[T] using the
# for-loop protocol. `Iter` must implement `Iterator[T]`.
Vector[T] collect_vec[T, Iter](Iter iter):
    Vector[T] out = Vector[T]()
    for x in iter:
        out.push(x)
    return !out

# Count the elements produced by any Iterator-shaped iter.
int count_iter[Iter](Iter iter):
    int n = 0
    for _ in iter:
        n = n + 1
    return n

# Sum all elements of an int-iterator.
int sum_iter[Iter](Iter iter):
    int acc = 0
    for x in iter:
        acc = acc + x
    return acc

# Left fold with an initial accumulator.
# `f` takes `(acc, element)` and returns the next acc.
A fold_iter[A, T, Iter, F](Iter iter, A init, F f):
    A acc = init
    for x in iter:
        acc = f(acc, x)
    return acc

# Short-circuiting terminals: return as soon as the predicate
# decides the result.
bool any_iter[T, Iter, F](Iter iter, F pred):
    for x in iter:
        if pred(x):
            return true
    return false

bool all_iter[T, Iter, F](Iter iter, F pred):
    for x in iter:
        if not pred(x):
            return false
    return true

# ── Set / Dict iteration ─────────────────────────────────────
#
# `SetIter[T]` and `DictKeyIter[K]` / `DictValueIter[V]` wrap a
# pre-materialized `Vector[T]` / `Vector[K]` / `Vector[V]` so the
# for-loop protocol and adapter chain reuse the `VectorIter` machinery.
# That's eager up-front but keeps the state machine trivial — the only
# runtime cost is the materialization call (`s.items()` / `d.keys()` /
# `d.values()`) at iterator-construction time.
#
# A fully lazy implementation (walking the underlying GorgetMap bucket
# array) is the proper Phase 2c goal; this shipping sugar covers the
# 90% case where users want to pipe a set/dict through `take` / `skip` /
# `chain` adapters or iterate by name.
#
# Constructors are free functions (`set_iter` / `dict_iter_keys` /
# `dict_iter_values`) rather than equip methods because Gorget's
# method-resolution picks up user equip blocks over the builtin
# collection protocol, and adding an `.iter()` method on `Set[T]`
# shadows the builtin `.items()` / `.map()` / `.filter()` surface.
# Free functions sidestep the shadowing. Once method-protocol merging
# lands, these convert to `s.iter()` / `d.iter_keys()` trivially.

struct SetIter[T]:
    VectorIter[T] inner

equip [T] SetIter[T] with Iterator[T]:
    Option[T] next(&self):
        return self.inner.next()

SetIter[T] set_iter[T](Set[T] s):
    return SetIter[T](VectorIter[T](s.items(), 0))

equip [T] SetIter[T]:
    TakeIter[T] take(self, int n):
        return TakeIter[T](self.inner, n)

    SkipIter[T] skip(self, int n):
        return SkipIter[T](self.inner, n)

    ChainIter[T] chain(self, SetIter[T] other):
        return ChainIter[T](self.inner, other.inner, true)

# Dict key/value iteration is deferred — a `DictKeyIter[K]` / `DictValueIter[V]`
# wrapping `VectorIter[K]` / `VectorIter[V]` trips the "Ptr ABI received
# scalar value" panic in `c_lir/emit_types.rs` when the user struct is
# constructed with a Vector field via a self-pointer access. Tracked in
# TODO.md (see "User DictIter[K, V] / DictKeyIter[K]"). Callers iterate
# through `d.keys()` / `d.values()` / `d.items()` until that's fixed.

# Textual join is deferred — the naive `int_to_str`-based version
# tripped a cross-crate import that force-monomorphized
# `VectorIter[uint8]` in modules that don't otherwise use it,
# causing a forward-reference during validation. Callers materialize
# to a Vector via `collect_vec` and join through `String.join` for
# now; a Displayable-bound `join_iter` lands when the generic-HOF
# closure propagation is sorted (tracked as Phase 2c follow-up).

