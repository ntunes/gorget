# std.iter — lazy iterator support.
#
# Provides `VectorIter[T]` and `Vector.iter()` so a Vector can be iterated
# lazily through the `Iterator[T]` protocol. Concrete adapters:
# `TakeIter[T]`, `SkipIter[T]`, `ChainIter[T]`, `MapIter[T, U, F]`,
# `FilterIter[T, F]` — each is a state-machine struct, no trait-object
# dispatch. Terminals: `collect_vec`, `count_iter`, `sum_iter`,
# `product_iter`, `any_iter`, `all_iter`, `fold_iter`, `find_iter`,
# `find_index_iter`, `for_each_iter`, `min_iter`, `max_iter`,
# `last_iter`, `nth_iter`, `join_iter`.
#
# Adapter-method sugar: `.take(n)` / `.skip(n)` / `.chain(other)` /
# `.map[U, F](f)` / `.filter[F](p)` on `VectorIter[T]` each return the
# corresponding concrete adapter by value. Chains like
# `v.iter().take(3).map[int, int(int)](double).filter[bool(int)](is_even)`
# compose end to end; method-level generics on `.map` / `.filter`
# currently need explicit type args at the call site until Gorget's
# inference propagates closure return types into method generics.

from std.collections import Vector, Set

struct VectorIter[T]:
    Vector[T] source
    int idx

equip [T] VectorIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.idx >= self.source.len():
            return None
        int cur = self.idx
        self.idx = self.idx + 1
        return self.source.get(cur)

equip [T] Vector[T]:
    VectorIter[T] iter(self):
        return VectorIter[T](self, 0)

# Method-style adapter sugar on VectorIter. Each method constructs the
# corresponding concrete adapter struct and returns it by value.
# Callers chain with `v.iter().take(n)` / `v.iter().skip(2).chain(w.iter())` etc.
#
# `.map[U, F]` / `.filter[F]` are method-level-generic — the compiler
# specialises each call site via per-call-site monomorphisation, so
# chains like `v.iter().map[int, int(int)](double)` fuse the adapter
# into a concrete state machine without boxing or trait-object
# dispatch.
equip [T] VectorIter[T]:
    TakeIter[T] take(self, int n):
        return TakeIter[T](self, n)

    SkipIter[T] skip(self, int n):
        return SkipIter[T](self, n)

    ChainIter[T] chain(self, VectorIter[T] other):
        return ChainIter[T](self, other, true)

    MapIter[T, U, F] map[U, F](self, F f):
        return MapIter[T, U, F](self, f)

    FilterIter[T, F] filter[F](self, F p):
        return FilterIter[T, F](self, p)

    # ── Terminal methods ───────────────────────────────────
    #
    # Bodies delegate to the free-function terminals defined below so
    # there's a single source of truth for loop semantics. Each method
    # has the concrete iterator type (VectorIter[T]) baked in, so the
    # per-call-site method-mono pipeline specialises these per call.

    int count(self):
        return count_iter[VectorIter[T]](self)

    Vector[T] collect(self):
        return collect_vec[T, VectorIter[T]](self)

    bool any[F](self, F pred):
        return any_iter[T, VectorIter[T], F](self, pred)

    bool all[F](self, F pred):
        return all_iter[T, VectorIter[T], F](self, pred)

    Option[T] find[F](self, F pred):
        return find_iter[T, VectorIter[T], F](self, pred)

    Option[int] find_index[F](self, F pred):
        return find_index_iter[T, VectorIter[T], F](self, pred)

    void for_each[F](self, F f):
        for_each_iter[T, VectorIter[T], F](self, f)

    A fold[A, F](self, A init, F f):
        return fold_iter[A, T, VectorIter[T], F](self, init, f)

    Option[T] last(self):
        return last_iter[T, VectorIter[T]](self)

    Option[T] nth(self, int n):
        return nth_iter[T, VectorIter[T]](self, n)

struct TakeIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] TakeIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.remaining <= 0:
            return None
        self.remaining = self.remaining - 1
        return self.inner.next()

struct SkipIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] SkipIter[T] with Iterator[T]:
    Option[T] next(&self):
        while self.remaining > 0:
            Option[T] consumed = self.inner.next()
            match consumed:
                case Some(_):
                    self.remaining = self.remaining - 1
                case None:
                    self.remaining = 0
                    return None
        return self.inner.next()

# ChainIter[T] — concatenates two VectorIter[T]. Yields from `a` until
# exhausted, then from `b`.
struct ChainIter[T]:
    VectorIter[T] a
    VectorIter[T] b
    bool on_first

equip [T] ChainIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.on_first:
            Option[T] r = self.a.next()
            match r:
                case Some(x):
                    return Some(x)
                case None:
                    self.on_first = false
        return self.b.next()

# ── Map / Filter adapters ────────────────────────────────────
#
# Stream-transform iterators. The upstream iterator is stored by
# value (no boxing); the closure / predicate likewise inlined.
# Monomorphization over the concrete source type + closure type
# keeps the chain fused.

struct MapIter[T, U, F]:
    VectorIter[T] inner
    F f

equip [T, U, F] MapIter[T, U, F] with Iterator[U]:
    Option[U] next(&self):
        Option[T] v = self.inner.next()
        match v:
            case Some(x):
                # Hoist the closure out of the field access before
                # calling — `self.f(x)` is parsed as a method call on
                # the field and link-fails. Storing in a local turns
                # it into a closure call.
                F cb = self.f
                return Some(cb(!x))
            case None:
                return None

struct FilterIter[T, F]:
    VectorIter[T] inner
    F pred

equip [T, F] FilterIter[T, F] with Iterator[T]:
    Option[T] next(&self):
        while true:
            Option[T] v = self.inner.next()
            match v:
                case Some(x):
                    F cb = self.pred
                    if cb(x):
                        return Some(!x)
                case None:
                    return None
        return None

# ── Terminals ────────────────────────────────────────────────
#
# All terminals take the concrete iterator type as a type param
# to avoid trait-object dispatch.

# Materialize any iterator of type Iter into a Vector[T] using the
# for-loop protocol. `Iter` must implement `Iterator[T]`.
Vector[T] collect_vec[T, Iter](Iter iter):
    Vector[T] out = Vector[T]()
    for x in iter:
        out.push(x)
    return !out

# Count the elements produced by any Iterator-shaped iter.
int count_iter[Iter](Iter iter):
    int n = 0
    for _ in iter:
        n = n + 1
    return n

# Sum all elements of an int-iterator.
int sum_iter[Iter](Iter iter):
    int acc = 0
    for x in iter:
        acc = acc + x
    return acc

# Left fold with an initial accumulator.
# `f` takes `(acc, element)` and returns the next acc.
A fold_iter[A, T, Iter, F](Iter iter, A init, F f):
    A acc = init
    for x in iter:
        acc = f(acc, x)
    return acc

# Short-circuiting terminals: return as soon as the predicate
# decides the result.
bool any_iter[T, Iter, F](Iter iter, F pred):
    for x in iter:
        if pred(x):
            return true
    return false

bool all_iter[T, Iter, F](Iter iter, F pred):
    for x in iter:
        if not pred(x):
            return false
    return true

# Find the first element matching `pred`. Returns None if the iterator
# is exhausted without a match. Short-circuiting.
Option[T] find_iter[T, Iter, F](Iter iter, F pred):
    for x in iter:
        if pred(x):
            return Some(x)
    return None

# Index of the first element matching `pred`. Returns None if no match.
# Short-circuiting. Mirror of `find_iter` for the case where you want
# positional info instead of the value.
Option[int] find_index_iter[T, Iter, F](Iter iter, F pred):
    int i = 0
    for x in iter:
        if pred(x):
            return Some(i)
        i = i + 1
    return None

# Last element of the iterator. Walks to exhaustion — O(n). For
# bounded iterators only; infinite iterators never terminate.
Option[T] last_iter[T, Iter](Iter iter):
    Option[T] out = None
    for x in iter:
        out = Some(x)
    return !out

# Element at position `n` (0-indexed). Consumes up to n+1 elements.
# Returns None if the iterator ends before reaching `n`. Negative `n`
# always returns None.
Option[T] nth_iter[T, Iter](Iter iter, int n):
    if n < 0:
        return None
    int i = 0
    for x in iter:
        if i == n:
            return Some(x)
        i = i + 1
    return None

# Run `f` on every element for side effects; no return value. Sibling of
# `fold_iter` for the case where the accumulator would be `void`.
void for_each_iter[T, Iter, F](Iter iter, F f):
    for x in iter:
        f(x)

# Product of int elements. Identity is 1 — an empty iterator returns 1.
int product_iter[Iter](Iter iter):
    int acc = 1
    for x in iter:
        acc = acc * x
    return acc

# Minimum of an int-iterator. Returns None for an empty iterator; the
# caller decides whether "no elements" is an error.
Option[int] min_iter[Iter](Iter iter):
    Option[int] out = None
    for x in iter:
        match out:
            case None:
                out = Some(x)
            case Some(prev):
                if x < prev:
                    out = Some(x)
    return !out

# Maximum of an int-iterator.
Option[int] max_iter[Iter](Iter iter):
    Option[int] out = None
    for x in iter:
        match out:
            case None:
                out = Some(x)
            case Some(prev):
                if x > prev:
                    out = Some(x)
    return !out

# ── Set / Dict iteration ─────────────────────────────────────
#
# `set_iter` returns a plain `VectorIter[T]` wrapping the materialized
# elements — Set callers get the full VectorIter adapter chain
# (`take` / `skip` / `chain` + anything we add later) for free.
#
# Eager up-front but keeps the state machine trivial — the only runtime
# cost is the materialization call (`s.items()`) at
# iterator-construction time. A fully lazy implementation (walking the
# underlying GorgetMap bucket array) remains the Phase 2c goal.
#
# Free function rather than an equip method because adding an `.iter()`
# method on `Set[T]` shadows the builtin collection protocol's
# `items()` / `map()` / `filter()` surface at method resolution. Once
# method-protocol merging lands this converts to `s.iter()` trivially.
#
# Dict key / value iteration is deferred — a naive
# `VectorIter[K](d.keys(), 0)` via a generic `dict_iter_keys[K, V]`
# wrapper trips the "Ptr ABI received scalar value" codegen panic in
# `c_lir/emit_types.rs` when K is a resource type (e.g. String). The
# issue is specific to how `d.keys()`'s return flows through the
# monomorphized `VectorIter[String]` constructor; `Dict[int, int]`
# works fine with the same shape. Tracked in TODO.md ("User DictIter").
# Callers iterate `d.keys()` / `d.values()` / `d.items()` directly for
# now — those return Vectors that accept all the usual adapters.

VectorIter[T] set_iter[T](Set[T] s):
    return VectorIter[T](s.items(), 0)

# Textual join — render each element through `Displayable.display()`
# and concatenate with `sep` between. Routing through the trait
# instead of `int_to_str` sidesteps the cross-crate monomorphization
# that previously force-materialized `VectorIter[uint8]` everywhere.
# Displacement of `String.join(vec)` — callers that currently
# materialize a Vector just to join can now go straight from the
# iterator: `join_iter[VectorIter[int], int](v.iter(), ", ")`.
String join_iter[Iter, Displayable T](Iter iter, String sep):
    String out = ""
    bool first = true
    for x in iter:
        if not first:
            out.push(sep.clone())
        out.push(x.display())
        first = false
    return !out

