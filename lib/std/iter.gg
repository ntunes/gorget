# std.iter — minimal lazy iterator support (Phase 2 placeholder)
#
# Provides `VectorIter[T]` and `Vector.iter()` so a Vector can be iterated
# lazily through the `Iterator[T]` protocol. Adapters: TakeIter[T],
# SkipIter[T]. Terminal: `collect_vec` materializes back to Vector.
#
# NOTE: Adapter-method sugar (`.take(n)` / `.skip(n)`) on VectorIter is
# not yet wired because it trips a monomorphization ordering bug —
# users construct adapters with `TakeIter[int](v.iter(), n)` for now.

from std.collections import Vector

struct VectorIter[T]:
    Vector[T] source
    int idx

equip [T] VectorIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.idx >= self.source.len():
            return None
        int cur = self.idx
        self.idx = self.idx + 1
        return self.source.get(cur)

equip [T] Vector[T]:
    VectorIter[T] iter(self):
        return VectorIter[T](self, 0)

struct TakeIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] TakeIter[T] with Iterator[T]:
    Option[T] next(&self):
        if self.remaining <= 0:
            return None
        self.remaining = self.remaining - 1
        return self.inner.next()

struct SkipIter[T]:
    VectorIter[T] inner
    int remaining

equip [T] SkipIter[T] with Iterator[T]:
    Option[T] next(&self):
        while self.remaining > 0:
            Option[T] consumed = self.inner.next()
            match consumed:
                case Some(_):
                    self.remaining = self.remaining - 1
                case None:
                    self.remaining = 0
                    return None
        return self.inner.next()

# Terminal — materialize any iterator of type Iter into a Vector[T] using
# the for-loop protocol. `Iter` must implement `Iterator[T]`.
Vector[T] collect_vec[T, Iter](Iter iter):
    Vector[T] out = Vector[T]()
    for x in iter:
        out.push(x)
    return !out

