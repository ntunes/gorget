# std.path — Path manipulation operations

extern "C":
    extern cstr path_join(cstr a, cstr b) = "gorget_path_join"
    extern cstr path_parent(cstr path) = "gorget_path_parent"
    extern cstr path_basename(cstr path) = "gorget_path_basename"
    extern cstr path_extension(cstr path) = "gorget_path_extension"
    extern cstr path_stem(cstr path) = "gorget_path_stem"
    extern cstr path_normalize(cstr path) = "gorget_path_normalize"
    extern cstr path_absolute(cstr path) = "gorget_path_absolute"
