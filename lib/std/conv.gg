# std.conv — Type conversion functions

# ── C extern bindings (const char* convention) ───────────────

extern "C":
    extern int _parse_int_raw(cstr s) = "gorget_parse_int"
    extern float _parse_float_raw(cstr s) = "gorget_parse_float"
    extern cstr _parse_last_error() = "gorget_parse_last_error"

# ── Gorget-aware extern bindings (Str by value) ─────────────

extern "Gorget":
    extern int ord(String s) = "gorget_str_ord"

# ── Gorget-aware externs (Str return — adopted by codegen) ───

extern "Gorget":
    extern String chr(int n) = "gorget_char_chr"
    extern String codepoint_to_str(int cp) = "gorget_codepoint_to_utf8"
    extern String int_to_str(int n) = "gorget_int_to_str"
    extern String float_to_str(float x) = "gorget_float_to_str"
    extern String bool_to_str(bool b) = "gorget_bool_to_str"

extern "C":
    extern float int_to_float(int n) = "gorget_int_to_float"

# ── Gorget wrappers for Result-returning functions ───────────

Result[int, String] parse_int(String s):
    int raw = _parse_int_raw(s)
    String err = _parse_last_error()
    if err.len() > 0:
        return Error(err)
    return Ok(raw)

Result[float, String] parse_float(String s):
    float raw = _parse_float_raw(s)
    String err = _parse_last_error()
    if err.len() > 0:
        return Error(err)
    return Ok(raw)
