# std.net.socket — TCP socket operations

from std.collections import Vector

# ── Opaque types ─────────────────────────────────────────────

struct Socket:
    int _handle

struct ServerSocket:
    int _handle

# ── Free functions ───────────────────────────────────────────

extern "C":
    extern blocking Result[Socket, String] socket_connect(cstr host, int port) = "gorget_socket_connect"
    extern blocking Result[ServerSocket, String] server_socket_bind(cstr host, int port) = "gorget_server_socket_bind"

# ── Socket methods ───────────────────────────────────────────

equip Socket:
    extern blocking Vector[uint8] read(int n) = "gorget_socket_read"
    extern blocking Vector[uint8] read_exact(int n) = "gorget_socket_read_exact"
    extern blocking int write(Vector[uint8] data) = "gorget_socket_write"
    extern blocking int write_str(String s) = "gorget_socket_write_str"
    extern blocking Result[String, String] read_line() = "gorget_socket_read_line"
    extern void set_timeout(int ms) = "gorget_socket_set_timeout"
    extern void close() = "gorget_socket_close"
    # Non-blocking socket methods — for use in spawned/coroutine context
    extern Vector[uint8] nb_read(int n) = "gorget_socket_async_read"
    extern int nb_write(Vector[uint8] data) = "gorget_socket_async_write"
    extern int nb_write_str(String s) = "gorget_socket_async_write_str"

# ── ServerSocket methods ─────────────────────────────────────

equip ServerSocket:
    extern blocking Result[Socket, String] accept() = "gorget_server_socket_accept"
    extern void close() = "gorget_server_socket_close"
    extern int local_port() = "gorget_server_socket_local_port"
    # Non-blocking accept — for use in spawned/coroutine context
    extern Result[Socket, String] nb_accept() = "gorget_socket_async_accept"
