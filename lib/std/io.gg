# std.io — byte-shaped I/O: Writer/Reader traits, IoError, stdin/stdout/stderr.
#
# Phase 3 of the stdlib narrow-waist redesign (docs/internals/stdlib-design.md §6).
#
# Conventions:
# - Writer.write_bytes returns `Result[int, IoError]` — the byte count actually
#   written may be less than the input for short-write destinations
#   (sockets, pipes). `write_all` is derived to guarantee full write.
# - Reader.read_bytes fills the caller's buffer through a mutable borrow.
#   Returning Ok(0) means EOF. `reader_drain` / `read_exact` derive on top.
# - Errors are typed via `IoError`; no stringly-typed `Result[T, String]`
#   at the I/O boundary.

from std.collections import Vector, File

# Byte type note: signatures use `Vector[byte]` rather than
# `Vector[byte]`. `byte` is a lexer-level alias for `uint8` — the
# same type at the AST level, zero cost, no alias-resolution issues
# across modules. `Vector[byte]` reads as what it is: a byte buffer
# with no UTF-8 contract.

# ── Standard file handles (codegen special-cases these) ───────

public static File stderr = File(0)
public static File stdout = File(0)

# ── Legacy cstr-based terminal / stdin helpers ────────────────
#
# These pre-date the Writer/Reader traits. Keep them around so existing
# callers of `getchar()` / `readline()` / `input(prompt)` don't break;
# the Phase 3 migration is Writer/Reader-based and layers on top.

extern "C":
    extern int getchar() = "gorget_getchar"
    extern int term_cols() = "gorget_term_cols"
    extern int term_rows() = "gorget_term_rows"
    extern blocking cstr input(cstr prompt) = "gorget_input"
    extern cstr readline() = "gorget_readline"
    extern bool stdin_eof() = "gorget_stdin_eof"

# ── IoError ───────────────────────────────────────────────────
#
# The narrow error channel for all I/O operations. Every Writer/Reader
# implementor and every derived helper (write_all, read_exact, …)
# reports failure through one of these variants.

enum IoError:
    NotFound
    PermissionDenied
    AlreadyExists
    BrokenPipe
    ConnectionRefused
    ConnectionReset
    ConnectionAborted
    NotConnected
    AddrInUse
    TimedOut
    WouldBlock
    Interrupted
    UnexpectedEof
    InvalidInput
    InvalidData
    # Byte offset of the first invalid UTF-8 sequence.
    Utf8Invalid(int)
    # Escape hatch for errors that don't fit any named variant.
    # Prefer a named variant when introducing a new category.
    Other(String)

equip IoError with Displayable:
    String display(self):
        match self:
            case IoError.NotFound():
                return "not found"
            case IoError.PermissionDenied():
                return "permission denied"
            case IoError.AlreadyExists():
                return "already exists"
            case IoError.BrokenPipe():
                return "broken pipe"
            case IoError.ConnectionRefused():
                return "connection refused"
            case IoError.ConnectionReset():
                return "connection reset"
            case IoError.ConnectionAborted():
                return "connection aborted"
            case IoError.NotConnected():
                return "not connected"
            case IoError.AddrInUse():
                return "address in use"
            case IoError.TimedOut():
                return "timed out"
            case IoError.WouldBlock():
                return "would block"
            case IoError.Interrupted():
                return "interrupted"
            case IoError.UnexpectedEof():
                return "unexpected eof"
            case IoError.InvalidInput():
                return "invalid input"
            case IoError.InvalidData():
                return "invalid data"
            case IoError.Utf8Invalid(offset):
                return f"invalid utf-8 at byte {offset}"
            case IoError.Other(msg):
                return f"io error: {msg}"

equip IoError with Debuggable:
    String debug(self):
        match self:
            case IoError.NotFound():
                return "IoError.NotFound"
            case IoError.PermissionDenied():
                return "IoError.PermissionDenied"
            case IoError.AlreadyExists():
                return "IoError.AlreadyExists"
            case IoError.BrokenPipe():
                return "IoError.BrokenPipe"
            case IoError.ConnectionRefused():
                return "IoError.ConnectionRefused"
            case IoError.ConnectionReset():
                return "IoError.ConnectionReset"
            case IoError.ConnectionAborted():
                return "IoError.ConnectionAborted"
            case IoError.NotConnected():
                return "IoError.NotConnected"
            case IoError.AddrInUse():
                return "IoError.AddrInUse"
            case IoError.TimedOut():
                return "IoError.TimedOut"
            case IoError.WouldBlock():
                return "IoError.WouldBlock"
            case IoError.Interrupted():
                return "IoError.Interrupted"
            case IoError.UnexpectedEof():
                return "IoError.UnexpectedEof"
            case IoError.InvalidInput():
                return "IoError.InvalidInput"
            case IoError.InvalidData():
                return "IoError.InvalidData"
            case IoError.Utf8Invalid(offset):
                return f"IoError.Utf8Invalid({offset})"
            case IoError.Other(msg):
                return f"IoError.Other({msg.debug()})"

# ── Error trait ───────────────────────────────────────────────
#
# The narrow contract for a well-behaved error type: it can display
# for humans, render for developers (Debuggable), and optionally
# surface a human-readable description of the underlying cause.
#
# Every stdlib error type (IoError, ParseError, future JsonError /
# HttpError / SqlError / …) should implement `Error` so generic
# error-handling helpers can take any error without caring which
# specific kind they're holding.
#
# Coexistence note: `Error` lives in the type namespace as this
# trait; the `Result.Error(x)` variant constructor lives in the
# value namespace. Use-site resolution picks the right one by
# context (trait bound / equip target → trait; call / pattern →
# variant). See `tests/fixtures/error_trait_namespace_split.gg`.
#
# Design note: `source()` returns `Option[String]` for now — the
# cause's own human-readable description. The design doc envisions
# `Option[Box[Error]]` (walkable trait-object chain), but boxed
# trait objects are only partially supported today. The String form
# is strictly less powerful but keeps the v1 stdlib callable; when
# boxed-trait support stabilises the signature upgrades purely
# additively.

trait Error extends Displayable & Debuggable:
    Option[String] source(&self)

# IoError is a leaf — no underlying cause chain.
equip IoError with Error:
    Option[String] source(&self):
        return None

# ── Writer ────────────────────────────────────────────────────
#
# `write_bytes` is the single required method — all higher-level output
# convenience is derived on top.
#
# Input is `Vector[byte]` — a raw byte buffer — **not** `String`/`Str`.
# Writer is byte-shaped: binary files, TLS, compressed streams all push
# arbitrary bytes that are not UTF-8. Callers with a `String` source go
# through `.bytes()` at the boundary.
#
# Naming note: the trait method is `write_bytes` (not `write`) to avoid
# colliding with the legacy `File.write` extern during the migration.
# Once the extern is retired, the trait method renames to `write`.

trait Writer:
    Result[int, IoError] write_bytes(&self, Vector[byte] buf)

# ── Reader ────────────────────────────────────────────────────
#
# `read_bytes` fills `buf` through a mutable borrow and returns the byte
# count actually read. `Ok(0)` means EOF.

trait Reader:
    Result[int, IoError] read_bytes(&self, Vector[byte] &buf)

# String implements Writer: the input buffer is appended to the
# String's builder. The String doesn't enforce UTF-8 at the byte level,
# so arbitrary bytes pass through. `__bytes_to_str_raw` reinterprets a
# `Vector[byte]` as a String without validation (it's a copy at the
# C-layer, same bytes).
extern "C" String __bytes_to_str_raw(Vector[uint8] data) = "gorget_bytes_to_str"

equip String with Writer:
    Result[int, IoError] write_bytes(&self, Vector[byte] buf):
        int n = buf.len()
        String chunk = __bytes_to_str_raw(buf.clone())
        self.push(chunk)
        return Ok(n)

# File / Socket / TlsSocket / stdout / stderr Writer impls land in a
# follow-up: they need a runtime `gorget_file_write_bytes_handle`-style
# function that takes a File handle + byte slice (the existing
# gorget_file_write takes a path+content pair). Scoped to the next
# stdlib pass, not this codegen-gap slice.

# ── Derived helpers (free functions, generic over the concrete Writer) ──

# Guarantee the entire byte slice gets written, or fail. Returns the
# total byte count written on success (always equal to `buf.len()`),
# or the first IoError produced by the underlying Writer.
#
# Note: generic over the concrete Writer type to avoid trait-object
# dispatch. Callers write `write_all[Sink](&w, buf)`.
#
# The inner slice allocates a fresh Vector on the short-write path;
# that's acceptable for the rare fragmented write. A future zero-cost
# byte-view type would make this O(1).
Result[int, IoError] write_all[W](W &w, Vector[byte] buf):
    int total = 0
    int len = buf.len()
    while total < len:
        Vector[byte] remaining = buf.slice(total, len)
        Result[int, IoError] r = w.write_bytes(remaining)
        match r:
            case Ok(0):
                return Error(IoError.BrokenPipe())
            case Ok(n):
                total = total + n
            case Error(e):
                return Error(e)
    return Ok(total)

# Text convenience — route a String through `.bytes()` then write_all.
Result[int, IoError] write_str[W](W &w, String s):
    return write_all[W](&w, s.bytes())

# Formatted write — render `v` through `Displayable` and push the
# resulting bytes through `write_all`.
Result[int, IoError] write_display[W, Displayable D](W &w, D v):
    return write_all[W](&w, v.display().bytes())

# Read all available bytes from `r` into a fresh buffer. Loops calling
# `read_bytes` until Ok(0) (EOF) or an error. Returns the final buffer
# on success; `buf` accumulates across reads.
Result[Vector[byte], IoError] reader_drain[R](R &reader):
    Vector[byte] buf = Vector[byte]()
    bool done = false
    while not done:
        int before = buf.len()
        Result[int, IoError] step = reader.read_bytes(&buf)
        match step:
            case Ok(0):
                done = true
            case Ok(_):
                # Defensive: if the reader returns Ok(n) but didn't
                # actually grow the buffer, treat as EOF to avoid a
                # busy loop.
                if buf.len() == before:
                    done = true
            case Error(e):
                return Error(!e)
    return Ok(!buf)

# Adapt a legacy `Result[T, String]` error into `Result[T, IoError]` by
# wrapping the message in `IoError.Other`. Bridge used during the stdlib
# migration from stringly-typed I/O errors to typed ones.
Result[T, IoError] from_string_error[T](Result[T, String] r):
    match r:
        case Ok(v):
            return Ok(!v)
        case Error(e):
            return Error(IoError.Other(!e))

# Read exactly `n` bytes or fail with UnexpectedEof. Short reads are
# re-issued until the total reaches `n`.
Result[Vector[byte], IoError] read_exact[R](R &reader, int n):
    Vector[byte] buf = Vector[byte]()
    bool failed = false
    IoError err_kind = IoError.UnexpectedEof()
    while buf.len() < n and not failed:
        int before = buf.len()
        Result[int, IoError] step = reader.read_bytes(&buf)
        match step:
            case Ok(0):
                failed = true
                err_kind = IoError.UnexpectedEof()
            case Ok(_):
                if buf.len() == before:
                    failed = true
                    err_kind = IoError.UnexpectedEof()
            case Error(e):
                failed = true
                err_kind = !e
    if failed:
        return Error(!err_kind)
    return Ok(!buf)
