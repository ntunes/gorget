# std.io — byte-shaped I/O: Writer/Reader traits, IoError, stdin/stdout/stderr.
#
# Phase 3 of the stdlib narrow-waist redesign (docs/devbook/23-stdlib.md, Writer/Reader).
#
# Conventions:
# - Writer.write returns `Result[int, IoError]` — the byte count actually
#   written may be less than the input for short-write destinations
#   (sockets, pipes). `write_all` is derived to guarantee full write.
# - Reader.read fills the caller's buffer through a mutable borrow.
#   Returning Ok(0) means EOF. `reader_drain` / `read_exact` derive on top.
# - Errors are typed via `IoError`; no stringly-typed `Result[T, String]`
#   at the I/O boundary.

from std.collections import Vector

# ── File handle ───────────────────────────────────────────────
#
# Thin wrapper around the C `GorgetFile` runtime type (16 bytes:
# `FILE* handle` + `bool owned`). The single Gorget-level field
# `_handle` covers both — the runtime constructors populate both
# slots; the `owned` flag is not surfaced at the Gorget level.

struct File:
    # Must be named `handle` — matches the C `GorgetFile.handle`
    # field at the layout level. The second-half `owned` byte of the
    # C struct is covered by the int's extra bytes (LSB on LE) so the
    # Gorget-visible 8-byte int spans both C fields. Treat this as
    # opaque; users never read it.
    int handle

equip File:
    extern Result[String, String] read_all() = "gorget_file_read_all"
    extern void close() = "gorget_file_close"
    # Byte-oriented primitives. These return the raw bytes-written /
    # bytes-read count (non-negative) or a negative errno that the
    # Writer/Reader equip below surfaces as an `IoError` variant.
    extern int _write_bytes_buf(Vector[byte] buf) = "gorget_file_write_bytes_buf"
    extern int _read_bytes_buf(Vector[byte] &buf, int max_bytes) = "gorget_file_read_bytes_buf"
    # Push any buffered output through the underlying stdio buffer.
    # Returns 0 on success, negative errno on failure. Named
    # `_flush_buffer` (leading underscore) to match the convention
    # used by `_write_bytes_buf` / `_read_bytes_buf` — self-host's
    # method-name resolution relies on the underscore prefix for
    # private extern methods.
    extern int _flush_buffer() = "gorget_file_flush"

# Byte type note: signatures use `Vector[byte]` rather than
# `Vector[byte]`. `byte` is a lexer-level alias for `uint8` — the
# same type at the AST level, zero cost, no alias-resolution issues
# across modules. `Vector[byte]` reads as what it is: a byte buffer
# with no UTF-8 contract.

# ── Standard-handle + open externs ────────────────────────────

extern "Gorget":
    extern File _stdin_handle() = "gorget_stdin_handle"
    extern File _stdout_handle() = "gorget_stdout_handle"
    extern File _stderr_handle() = "gorget_stderr_handle"

extern "C":
    extern int _file_open_try(cstr path, cstr mode, File &out) = "gorget_file_open_try"

# ── Standard file handles ─────────────────────────────────────
#
# Runtime-initialized File values wrapping the C `stdout`/`stderr`/
# `stdin` streams. The `_handle` field holds `FILE*` as a pointer-
# sized int; the `owned` flag (not visible at the Gorget level) is
# false so `close()` is a no-op.
#
# The codegen also recognises the identifiers `stdout`/`stderr` as
# a keyword routing hint for `print(x, file=stderr)`. That path is
# orthogonal to the Writer impl — `stderr.write(...)` goes
# through the runtime call below; `print(..., file=stderr)` stays
# on the fprintf fast path for now.

public static File stdin = _stdin_handle()
public static File stdout = _stdout_handle()
public static File stderr = _stderr_handle()

# ── Legacy cstr-based terminal / stdin helpers ────────────────
#
# These pre-date the Writer/Reader traits. Keep them around so existing
# callers of `getchar()` / `readline()` / `input(prompt)` don't break;
# the Phase 3 migration is Writer/Reader-based and layers on top.

extern "C":
    extern int getchar() = "gorget_getchar"
    extern int term_cols() = "gorget_term_cols"
    extern int term_rows() = "gorget_term_rows"
    extern blocking cstr input(cstr prompt) = "gorget_input"
    extern cstr readline() = "gorget_readline"
    extern bool stdin_eof() = "gorget_stdin_eof"

# ── IoError ───────────────────────────────────────────────────
#
# The narrow error channel for all I/O operations. Every Writer/Reader
# implementor and every derived helper (write_all, read_exact, …)
# reports failure through one of these variants.

enum IoError:
    NotFound
    PermissionDenied
    AlreadyExists
    BrokenPipe
    ConnectionRefused
    ConnectionReset
    ConnectionAborted
    NotConnected
    AddrInUse
    TimedOut
    WouldBlock
    Interrupted
    UnexpectedEof
    InvalidInput
    InvalidData
    # Byte offset of the first invalid UTF-8 sequence.
    Utf8Invalid(int)
    # Escape hatch for errors that don't fit any named variant.
    # Prefer a named variant when introducing a new category.
    Other(String)

equip IoError with Displayable:
    String display(self):
        match self:
            case IoError.NotFound():
                return "not found"
            case IoError.PermissionDenied():
                return "permission denied"
            case IoError.AlreadyExists():
                return "already exists"
            case IoError.BrokenPipe():
                return "broken pipe"
            case IoError.ConnectionRefused():
                return "connection refused"
            case IoError.ConnectionReset():
                return "connection reset"
            case IoError.ConnectionAborted():
                return "connection aborted"
            case IoError.NotConnected():
                return "not connected"
            case IoError.AddrInUse():
                return "address in use"
            case IoError.TimedOut():
                return "timed out"
            case IoError.WouldBlock():
                return "would block"
            case IoError.Interrupted():
                return "interrupted"
            case IoError.UnexpectedEof():
                return "unexpected eof"
            case IoError.InvalidInput():
                return "invalid input"
            case IoError.InvalidData():
                return "invalid data"
            case IoError.Utf8Invalid(offset):
                return f"invalid utf-8 at byte {offset}"
            case IoError.Other(msg):
                return f"io error: {msg}"

equip IoError with Debuggable:
    String debug(self):
        match self:
            case IoError.NotFound():
                return "IoError.NotFound"
            case IoError.PermissionDenied():
                return "IoError.PermissionDenied"
            case IoError.AlreadyExists():
                return "IoError.AlreadyExists"
            case IoError.BrokenPipe():
                return "IoError.BrokenPipe"
            case IoError.ConnectionRefused():
                return "IoError.ConnectionRefused"
            case IoError.ConnectionReset():
                return "IoError.ConnectionReset"
            case IoError.ConnectionAborted():
                return "IoError.ConnectionAborted"
            case IoError.NotConnected():
                return "IoError.NotConnected"
            case IoError.AddrInUse():
                return "IoError.AddrInUse"
            case IoError.TimedOut():
                return "IoError.TimedOut"
            case IoError.WouldBlock():
                return "IoError.WouldBlock"
            case IoError.Interrupted():
                return "IoError.Interrupted"
            case IoError.UnexpectedEof():
                return "IoError.UnexpectedEof"
            case IoError.InvalidInput():
                return "IoError.InvalidInput"
            case IoError.InvalidData():
                return "IoError.InvalidData"
            case IoError.Utf8Invalid(offset):
                return f"IoError.Utf8Invalid({offset})"
            case IoError.Other(msg):
                return f"IoError.Other({msg.debug()})"

# ── Error trait ───────────────────────────────────────────────
#
# The narrow contract for a well-behaved error type: it can display
# for humans, render for developers (Debuggable), and optionally
# surface a human-readable description of the underlying cause.
#
# Every stdlib error type (IoError, ParseError, future JsonError /
# HttpError / SqlError / …) should implement `Error` so generic
# error-handling helpers can take any error without caring which
# specific kind they're holding.
#
# Coexistence note: `Error` lives in the type namespace as this
# trait; the `Result.Error(x)` variant constructor lives in the
# value namespace. Use-site resolution picks the right one by
# context (trait bound / equip target → trait; call / pattern →
# variant). See `tests/fixtures/error_trait_namespace_split.gg`.
#
# Design note: `source()` returns `Option[String]` for now — the
# cause's own human-readable description. The design doc envisions
# `Option[Box[Error]]` (walkable trait-object chain), but boxed
# trait objects are only partially supported today. The String form
# is strictly less powerful but keeps the v1 stdlib callable; when
# boxed-trait support stabilises the signature upgrades purely
# additively.

trait Error extends Displayable & Debuggable:
    Option[String] source(&self)

# IoError is a leaf — no underlying cause chain.
equip IoError with Error:
    Option[String] source(&self):
        return None

# ── Writer ────────────────────────────────────────────────────
#
# `write` is the single required method — all higher-level output
# convenience is derived on top.
#
# Input is `Vector[byte]` — a raw byte buffer — **not** `String`/`Str`.
# Writer is byte-shaped: binary files, TLS, compressed streams all push
# arbitrary bytes that are not UTF-8. Callers with a `String` source go
# through `.bytes()` at the boundary.

trait Writer:
    Result[int, IoError] write(&self, Vector[byte] buf)
    # Force buffered output to commit. Default is no-op — for
    # in-memory writers (String) the bytes are already "committed"
    # the moment `write` returns. File / Socket / TlsSocket
    # override to push through stdio / TCP / SSL buffers. Callers:
    # progress bars, REPLs, interactive CLI prompts.
    Result[int, IoError] flush(&self):
        return Ok(0)

# ── Reader ────────────────────────────────────────────────────
#
# `read` fills `buf` through a mutable borrow and returns the byte
# count actually read. `Ok(0)` means EOF.

trait Reader:
    Result[int, IoError] read(&self, Vector[byte] &buf)

# String implements Writer: the input buffer is appended to the
# String's builder. The String doesn't enforce UTF-8 at the byte level,
# so arbitrary bytes pass through. `__bytes_to_str_raw` reinterprets a
# `Vector[byte]` as a String without validation (it's a copy at the
# C-layer, same bytes).
extern "C" String __bytes_to_str_raw(Vector[uint8] data) = "gorget_bytes_to_str"

equip String with Writer:
    Result[int, IoError] write(&self, Vector[byte] buf):
        int n = buf.len()
        String chunk = __bytes_to_str_raw(buf.clone())
        self.push(chunk)
        return Ok(n)

# ── errno → IoError mapping ───────────────────────────────────
#
# Linux errno values are stable enough for a mechanical mapping.
# Unknown values fall through to `IoError.Other` with the raw code.
# This is a private helper — File/Socket/TlsSocket Writer impls all
# funnel through here so the same errno gets the same variant.

IoError _errno_to_io_error(int code):
    # ENOENT / EACCES / EEXIST / EPIPE / ECONNREFUSED / ECONNRESET /
    # ECONNABORTED / ENOTCONN / EADDRINUSE / ETIMEDOUT / EAGAIN /
    # EINTR / EINVAL — otherwise fall through to Other(code).
    if code == 2:
        return IoError.NotFound()
    if code == 13:
        return IoError.PermissionDenied()
    if code == 17:
        return IoError.AlreadyExists()
    if code == 32:
        return IoError.BrokenPipe()
    if code == 111:
        return IoError.ConnectionRefused()
    if code == 104:
        return IoError.ConnectionReset()
    if code == 103:
        return IoError.ConnectionAborted()
    if code == 107:
        return IoError.NotConnected()
    if code == 98:
        return IoError.AddrInUse()
    if code == 110:
        return IoError.TimedOut()
    if code == 11:
        return IoError.WouldBlock()
    if code == 4:
        return IoError.Interrupted()
    if code == 22:
        return IoError.InvalidInput()
    return IoError.Other(f"errno {code}")

# ── File implements Writer / Reader ───────────────────────────
#
# The C runtime helpers return bytes-written (>= 0) on success and
# a negative errno on failure, so this wrapper is mostly arithmetic:
# negative → IoError variant, non-negative → Ok(n).

equip File with Writer:
    Result[int, IoError] write(&self, Vector[byte] buf):
        # `_write_bytes_buf` is a File-method extern — the compiler
        # threads `&self` into the C `GorgetFile*` param automatically.
        int n = self._write_bytes_buf(buf)
        if n < 0:
            return Error(_errno_to_io_error(-n))
        return Ok(n)

    Result[int, IoError] flush(&self):
        int rc = self._flush_buffer()
        if rc < 0:
            return Error(_errno_to_io_error(-rc))
        return Ok(0)

equip File with Reader:
    Result[int, IoError] read(&self, Vector[byte] &buf):
        # Read up to 4KB per call — callers typically loop via
        # `reader_drain` / `read_exact` so this chunk size just keeps
        # any individual call bounded.
        int n = self._read_bytes_buf(&buf, 4096)
        if n < 0:
            return Error(_errno_to_io_error(-n))
        return Ok(n)

# ── File.open — typed construction ────────────────────────────
#
# Path-based file open that returns `Result[File, IoError]`. The
# existing `read_file(path)` / `write_file(path, content)` free
# functions in `std.fs` remain as convenient shortcuts; this is the
# typed-error path for callers that need to handle file errors.

Result[File, IoError] file_open(String path, String mode):
    File out = File(0)
    # `extern "C"` takes `cstr` params; passing a `String` here relies
    # on the compiler's implicit Str→cstr coercion at the call site.
    int rc = _file_open_try(path, mode, &out)
    if rc < 0:
        return Error(_errno_to_io_error(-rc))
    return Ok(!out)

# ── Typed-error read/write convenience ────────────────────────
#
# Narrow-waist equivalents of `std.fs.read_file` / `write_file` that
# return a structured `IoError` instead of panicking on failure. The
# existing infallible shortcuts in `std.fs` stay for quick scripts;
# callers wanting error handling use these.

Result[Vector[byte], IoError] read_all_bytes(String path):
    Result[File, IoError] fr = file_open(path, "rb")
    match fr:
        case Error(e):
            return Error(!e)
        case Ok(f):
            File file = !f
            Result[Vector[byte], IoError] drained = reader_drain[File](&file)
            file.close()
            return drained

Result[String, IoError] read_to_string(String path):
    Result[Vector[byte], IoError] br = read_all_bytes(path)
    match br:
        case Error(e):
            return Error(!e)
        case Ok(bytes):
            return bytes_str_checked(bytes)

# Internal: bytes → String with UTF-8 validation, returning the
# same IoError.Utf8Invalid the std.bytes layer uses. Kept private
# so the std.io / std.bytes dependency stays one-way.
Result[String, IoError] bytes_str_checked(Vector[byte] buf):
    if not __bytes_utf8_valid_io(buf):
        return Error(IoError.Utf8Invalid(0))
    return Ok(__bytes_to_str_raw_io(buf))

# Local extern bindings that mirror std.bytes. Duplicated here to
# avoid a circular import between std.io and std.bytes (std.bytes
# already imports IoError from std.io).
extern "C":
    extern String __bytes_to_str_raw_io(Vector[uint8] buf) = "gorget_bytes_to_str"
    extern bool __bytes_utf8_valid_io(Vector[uint8] buf) = "gorget_bytes_utf8_valid"

# Write `buf` to `path`, creating the file if it doesn't exist and
# truncating if it does. Returns bytes written on success.
Result[int, IoError] write_all_bytes(String path, Vector[byte] buf):
    Result[File, IoError] fr = file_open(path, "wb")
    match fr:
        case Error(e):
            return Error(!e)
        case Ok(f):
            File file = !f
            Result[int, IoError] wrote = write_all[File](&file, buf)
            file.close()
            return wrote

Result[int, IoError] write_string(String path, String content):
    return write_all_bytes(path, content.bytes())

# ── Derived helpers (free functions, generic over the concrete Writer) ──

# Guarantee the entire byte slice gets written, or fail. Returns the
# total byte count written on success (always equal to `buf.len()`),
# or the first IoError produced by the underlying Writer.
#
# Note: generic over the concrete Writer type to avoid trait-object
# dispatch. Callers write `write_all[Sink](&w, buf)`.
#
# The inner slice allocates a fresh Vector on the short-write path;
# that's acceptable for the rare fragmented write. A future zero-cost
# byte-view type would make this O(1).
Result[int, IoError] write_all[W](W &w, Vector[byte] buf):
    int total = 0
    int len = buf.len()
    while total < len:
        Vector[byte] remaining = buf[total:len]
        Result[int, IoError] r = w.write(remaining)
        match r:
            case Ok(0):
                return Error(IoError.BrokenPipe())
            case Ok(n):
                total = total + n
            case Error(e):
                return Error(e)
    return Ok(total)

# Text convenience — route a String through `.bytes()` then write_all.
Result[int, IoError] write_str[W](W &w, String s):
    return write_all[W](&w, s.bytes())

# Formatted write — render `v` through `Displayable` and push the
# resulting bytes through `write_all`.
Result[int, IoError] write_display[W, Displayable D](W &w, D v):
    return write_all[W](&w, v.display().bytes())

# `println` / `writeln` / `println_str` retired 2026-04-19. Callers
# that want typed-error stdout use `write_display[File, D](&stdout, v)`
# (or `write_str` for raw text) and compose a trailing newline by
# rendering into a String and routing through `write_all`. The
# infallible `print(x, terminator=…)` builtin covers the script case;
# having both `print` and `println` added a parallel surface for no
# new semantics. See `docs/devbook/23-stdlib.md` (the narrow-waist
# principle) for the resolution.

# Read all available bytes from `r` into a fresh buffer. Loops calling
# `read` until Ok(0) (EOF) or an error. Returns the final buffer
# on success; `buf` accumulates across reads.
Result[Vector[byte], IoError] reader_drain[R](R &reader):
    Vector[byte] buf = Vector[byte]()
    bool done = false
    while not done:
        int before = buf.len()
        Result[int, IoError] step = reader.read(&buf)
        match step:
            case Ok(0):
                done = true
            case Ok(_):
                # Defensive: if the reader returns Ok(n) but didn't
                # actually grow the buffer, treat as EOF to avoid a
                # busy loop.
                if buf.len() == before:
                    done = true
            case Error(e):
                return Error(!e)
    return Ok(!buf)

# Adapt a legacy `Result[T, String]` error into `Result[T, IoError]` by
# wrapping the message in `IoError.Other`. Bridge used during the stdlib
# migration from stringly-typed I/O errors to typed ones.
Result[T, IoError] from_string_error[T](Result[T, String] r):
    match r:
        case Ok(v):
            return Ok(!v)
        case Error(e):
            return Error(IoError.Other(!e))

# Read exactly `n` bytes or fail with UnexpectedEof. Short reads are
# re-issued until the total reaches `n`.
Result[Vector[byte], IoError] read_exact[R](R &reader, int n):
    Vector[byte] buf = Vector[byte]()
    bool failed = false
    IoError err_kind = IoError.UnexpectedEof()
    while buf.len() < n and not failed:
        int before = buf.len()
        Result[int, IoError] step = reader.read(&buf)
        match step:
            case Ok(0):
                failed = true
                err_kind = IoError.UnexpectedEof()
            case Ok(_):
                if buf.len() == before:
                    failed = true
                    err_kind = IoError.UnexpectedEof()
            case Error(e):
                failed = true
                err_kind = !e
    if failed:
        return Error(!err_kind)
    return Ok(!buf)
