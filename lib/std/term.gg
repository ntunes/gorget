# std.term — Terminal color output and TTY detection
#
# ANSI escape codes for colored terminal output.
# Always check is_tty() before colorizing to avoid polluting pipes/files.

# ── TTY detection (C-backed) ─────────────────────────────────

extern bool is_tty() = "gorget_is_tty"

# ── ANSI reset ───────────────────────────────────────────────

String term_reset():
    return "\u{1b}[0m"

# ── Foreground colors ────────────────────────────────────────

String red(String term_text):
    return "\u{1b}[31m" + term_text + "\u{1b}[0m"

String green(String term_text):
    return "\u{1b}[32m" + term_text + "\u{1b}[0m"

String yellow(String term_text):
    return "\u{1b}[33m" + term_text + "\u{1b}[0m"

String blue(String term_text):
    return "\u{1b}[34m" + term_text + "\u{1b}[0m"

String magenta(String term_text):
    return "\u{1b}[35m" + term_text + "\u{1b}[0m"

String cyan(String term_text):
    return "\u{1b}[36m" + term_text + "\u{1b}[0m"

String white(String term_text):
    return "\u{1b}[37m" + term_text + "\u{1b}[0m"

# ── Text styles ──────────────────────────────────────────────

String bold(String term_text):
    return "\u{1b}[1m" + term_text + "\u{1b}[0m"

String dim(String term_text):
    return "\u{1b}[2m" + term_text + "\u{1b}[0m"

String underline(String term_text):
    return "\u{1b}[4m" + term_text + "\u{1b}[0m"

# ── ANSI strip ───────────────────────────────────────────────
# Remove ANSI escape sequences from a string (useful for log files).
# Handles: ESC [ ... m sequences (the common case).

String strip_ansi(String term_s):
    String term_out = ""
    int term_i = 0
    int term_len = term_s.byte_len()
    while term_i < term_len:
        byte term_c = term_s.byte_at(term_i)
        # ESC byte = \u{1b} = codepoint 27
        if term_c as int == 27 and term_i + 1 < term_len and term_s.byte_at(term_i + 1) == b'[':
            # Skip ESC [ ... until we hit a letter (the final byte of the sequence)
            term_i = term_i + 2
            while term_i < term_len:
                byte term_fc = term_s.byte_at(term_i)
                term_i = term_i + 1
                int term_fcode = term_fc as int
                # Final byte range: 0x40–0x7E (letters and some punctuation)
                if term_fcode >= 64 and term_fcode <= 126:
                    break
        else:
            term_out = term_out + term_s.byte_slice(term_i, term_i + 1)
            term_i = term_i + 1
    return term_out
