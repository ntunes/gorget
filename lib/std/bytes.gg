# std.bytes — Byte manipulation and Base64 codec
#
# Provides C-backed byte operations (hex, endian, concat, slice) and
# pure Gorget Base64 encoding/decoding (RFC 4648).

from std.collections import Vector

# ── C-backed extern functions ────────────────────────────────

extern Vector[uint8] bytes_from_str(String b64_src) = "gorget_bytes_from_str"
extern cstr __bytes_to_str_raw(Vector[uint8] b64_buf) = "gorget_bytes_to_str"
extern bool __bytes_utf8_valid(Vector[uint8] b64_buf) = "gorget_bytes_utf8_valid"

# Convert byte buffer to String with UTF-8 validation.
# Returns Error if the buffer contains invalid UTF-8 byte sequences.
Result[String, String] bytes_to_str(Vector[uint8] b64_buf):
    if not __bytes_utf8_valid(b64_buf):
        return Error("invalid UTF-8 in byte buffer")
    String raw_str = __bytes_to_str_raw(b64_buf)
    return Ok(raw_str)

extern Vector[uint8] bytes_from_hex(String b64_hex) = "gorget_bytes_from_hex"
extern cstr bytes_to_hex(Vector[uint8] b64_buf) = "gorget_bytes_to_hex"
extern void bytes_write_u32_be(Vector[uint8] &b64_buf, int b64_off, int b64_val) = "gorget_bytes_write_u32_be"
extern int bytes_read_u32_be(Vector[uint8] b64_buf, int b64_off) = "gorget_bytes_read_u32_be"
extern void bytes_write_u16_be(Vector[uint8] &b64_buf, int b64_off, int b64_val) = "gorget_bytes_write_u16_be"
extern int bytes_read_u16_be(Vector[uint8] b64_buf, int b64_off) = "gorget_bytes_read_u16_be"
extern void bytes_write_u32_le(Vector[uint8] &b64_buf, int b64_off, int b64_val) = "gorget_bytes_write_u32_le"
extern int bytes_read_u32_le(Vector[uint8] b64_buf, int b64_off) = "gorget_bytes_read_u32_le"
extern void bytes_write_u16_le(Vector[uint8] &b64_buf, int b64_off, int b64_val) = "gorget_bytes_write_u16_le"
extern int bytes_read_u16_le(Vector[uint8] b64_buf, int b64_off) = "gorget_bytes_read_u16_le"
extern Vector[uint8] bytes_concat(Vector[uint8] b64_a, Vector[uint8] b64_b) = "gorget_bytes_concat"
extern Vector[uint8] bytes_slice(Vector[uint8] b64_buf, int b64_start, int b64_end) = "gorget_bytes_slice"
extern Vector[uint8] random_bytes(int b64_n) = "gorget_random_bytes"

# ── Signed 32-bit read/write (little-endian) ─────────────────
# BSP, MD3, and other binary formats use signed 32-bit integers.
extern int bytes_read_i32_le(Vector[uint8] buf, int offset) = "gorget_bytes_read_i32_le"
extern void bytes_write_i32_le(Vector[uint8] &buf, int offset, int val) = "gorget_bytes_write_i32_le"

# ── Float/int 32/64-bit read/write ──────────────────────────
# IEEE 754 single-precision (f32) — for binary file parsing (BSP, MD3, etc.)
# and vertex buffer packing. Gorget float is f64; these convert.

extern void bytes_write_f32_le(Vector[uint8] &buf, int offset, float val) = "gorget_bytes_write_f32_le"
extern float bytes_read_f32_le(Vector[uint8] buf, int offset) = "gorget_bytes_read_f32_le"
extern void bytes_write_f64_le(Vector[uint8] &buf, int offset, float val) = "gorget_bytes_write_f64_le"
extern float bytes_read_f64_le(Vector[uint8] buf, int offset) = "gorget_bytes_read_f64_le"
extern void bytes_write_i64_le(Vector[uint8] &buf, int offset, int val) = "gorget_bytes_write_i64_le"
extern int bytes_read_i64_le(Vector[uint8] buf, int offset) = "gorget_bytes_read_i64_le"

# ── Base64 helpers ───────────────────────────────────────────

int b64_char_value(byte b64_ch):
    int b64_code = b64_ch as int
    # A-Z → 0-25
    if b64_code >= 65 and b64_code <= 90:
        return b64_code - 65
    # a-z → 26-51
    if b64_code >= 97 and b64_code <= 122:
        return b64_code - 71
    # 0-9 → 52-61
    if b64_code >= 48 and b64_code <= 57:
        return b64_code + 4
    # + → 62
    if b64_code == 43:
        return 62
    # / → 63
    if b64_code == 47:
        return 63
    return -1

# ── Base64 encode (RFC 4648) ────────────────────────────────

String base64_encode(Vector[uint8] b64_data):
    String b64_alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    String b64_out = ""
    int b64_len = b64_data.len()
    int b64_i = 0

    # Process complete 3-byte groups
    while b64_i + 2 < b64_len:
        int b64_c0 = b64_data.get(b64_i).unwrap() as int
        int b64_c1 = b64_data.get(b64_i + 1).unwrap() as int
        int b64_c2 = b64_data.get(b64_i + 2).unwrap() as int

        b64_out = b64_out + b64_alpha[b64_c0 >> 2]

        int b64_lo1 = b64_c0 & 3
        int b64_hi1 = b64_c1 >> 4
        b64_out = b64_out + b64_alpha[b64_lo1 << 4 | b64_hi1]

        int b64_lo2 = b64_c1 & 15
        int b64_hi2 = b64_c2 >> 6
        b64_out = b64_out + b64_alpha[b64_lo2 << 2 | b64_hi2]

        b64_out = b64_out + b64_alpha[b64_c2 & 63]

        b64_i = b64_i + 3

    # Handle 1- or 2-byte remainder
    int b64_rem = b64_len - b64_i
    if b64_rem == 1:
        int b64_c0 = b64_data.get(b64_i).unwrap() as int
        b64_out = b64_out + b64_alpha[b64_c0 >> 2]
        int b64_lo = b64_c0 & 3
        b64_out = b64_out + b64_alpha[b64_lo << 4]
        b64_out = b64_out + "=="
    elif b64_rem == 2:
        int b64_c0 = b64_data.get(b64_i).unwrap() as int
        int b64_c1 = b64_data.get(b64_i + 1).unwrap() as int
        b64_out = b64_out + b64_alpha[b64_c0 >> 2]
        int b64_lo1 = b64_c0 & 3
        int b64_hi1 = b64_c1 >> 4
        b64_out = b64_out + b64_alpha[b64_lo1 << 4 | b64_hi1]
        int b64_lo2 = b64_c1 & 15
        b64_out = b64_out + b64_alpha[b64_lo2 << 2]
        b64_out = b64_out + "="

    return b64_out

# ── Base64 decode (RFC 4648) ────────────────────────────────

Result[Vector[uint8], String] base64_decode(String b64_encoded):
    Vector[uint8] b64_out = Vector[uint8]()
    int b64_len = b64_encoded.byte_len()
    if b64_len == 0:
        return Ok(b64_out)
    if b64_len % 4 != 0:
        return Error("invalid base64 length")

    int b64_i = 0
    while b64_i < b64_len:
        int b64_v0 = b64_char_value(b64_encoded.byte_at(b64_i))
        int b64_v1 = b64_char_value(b64_encoded.byte_at(b64_i + 1))
        if b64_v0 < 0 or b64_v1 < 0:
            return Error("invalid base64 character")

        if b64_encoded[b64_i + 2] == "=" and b64_encoded[b64_i + 3] == "=":
            # 2 significant chars → 1 byte
            int b64_byte0 = b64_v0 << 2 | b64_v1 >> 4
            b64_out.push(b64_byte0 as uint8)
        elif b64_encoded[b64_i + 3] == "=":
            # 3 significant chars → 2 bytes
            int b64_v2 = b64_char_value(b64_encoded.byte_at(b64_i + 2))
            if b64_v2 < 0:
                return Error("invalid base64 character")
            int b64_byte0 = b64_v0 << 2 | b64_v1 >> 4
            b64_out.push(b64_byte0 as uint8)
            int b64_lo1 = b64_v1 & 15
            int b64_byte1 = b64_lo1 << 4 | b64_v2 >> 2
            b64_out.push(b64_byte1 as uint8)
        else:
            # 4 significant chars → 3 bytes
            int b64_v2 = b64_char_value(b64_encoded.byte_at(b64_i + 2))
            int b64_v3 = b64_char_value(b64_encoded.byte_at(b64_i + 3))
            if b64_v2 < 0 or b64_v3 < 0:
                return Error("invalid base64 character")
            int b64_byte0 = b64_v0 << 2 | b64_v1 >> 4
            b64_out.push(b64_byte0 as uint8)
            int b64_lo1 = b64_v1 & 15
            int b64_byte1 = b64_lo1 << 4 | b64_v2 >> 2
            b64_out.push(b64_byte1 as uint8)
            int b64_lo2 = b64_v2 & 3
            int b64_byte2 = b64_lo2 << 6 | b64_v3
            b64_out.push(b64_byte2 as uint8)

        b64_i = b64_i + 4

    return Ok(b64_out)
