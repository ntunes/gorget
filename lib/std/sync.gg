# std.sync — Synchronization primitives

struct AtomicInt:
    pass

equip AtomicInt:
    extern int load() = "gorget_atomic_int_load"
    extern void store(int val) = "gorget_atomic_int_store"
    extern int add(int val) = "gorget_atomic_int_add"
    extern int sub(int val) = "gorget_atomic_int_sub"
    extern bool compare_exchange(int expected, int desired) = "gorget_atomic_int_compare_exchange"

struct AtomicBool:
    pass

equip AtomicBool:
    extern bool load() = "gorget_atomic_bool_load"
    extern void store(bool val) = "gorget_atomic_bool_store"
    extern bool swap(bool val) = "gorget_atomic_bool_swap"
    extern bool compare_exchange(bool expected, bool desired) = "gorget_atomic_bool_compare_exchange"

struct Barrier:
    pass

equip Barrier:
    extern void wait() = "gorget_barrier_wait"

struct CondVar:
    pass

equip CondVar:
    extern void notify_one() = "gorget_condvar_notify_one"
    extern void notify_all() = "gorget_condvar_notify_all"
    extern void wait(Guard[bool] guard) = "gorget_condvar_wait_guard"

struct RWLock[T]:
    pass

equip RWLock:
    ReadGuard[T] read()
    WriteGuard[T] write()

struct ReadGuard[T]:
    pass

equip ReadGuard:
    T get()

struct WriteGuard[T]:
    pass

equip WriteGuard:
    T get()
    void set(T val)

struct WaitGroup:
    pass

equip WaitGroup:
    extern void add(int n) = "gorget_waitgroup_add"
    extern void done() = "gorget_waitgroup_done"
    extern void wait() = "gorget_waitgroup_wait"

struct Semaphore:
    pass

equip Semaphore:
    extern void acquire() = "gorget_semaphore_acquire"
    extern void release() = "gorget_semaphore_release"
    extern bool try_acquire() = "gorget_semaphore_try_acquire"

struct OnceFlag:
    pass

equip OnceFlag:
    extern bool do_once() = "gorget_onceflag_do_once"
    extern bool is_done() = "gorget_onceflag_is_done"
